/*
 **
 ** IM7777 - Integracao entre Importacao e Recebimento (EMS)
 **
 ** Objetivo: Criacao dos arquivos tt-docum-est e tt-item-doc-est para posterior
 **           geracao dos arquivos docum-est e item-doc-est ( EMS: reapi190.p / Magnus: re8888.p).
 **
  */
/******************************************** Defini‡äes ****************************************/
{imp/im7777.i} /* defini‡äes temp-tables/vari veis */
{cdp/cdapi1001.i} /* tt-sit-tribut */ 
{cxbo/bocx00512.i tt-decla-imp-adic-it-trib}

define temp-table tt-embarque-filho-aux no-undo
   field cod-estabel like embarque-imp.cod-estabel
   field embarque    like embarque-imp.embarque.
   
 /* ICMS Desonerado */
 DEF VAR h-bocx225na          AS HANDLE                    NO-UNDO.
 DEF VAR h-reapi428           AS HANDLE                    NO-UNDO.
 DEF VAR de-perc-desc-icms    AS DECIMAL                   NO-UNDO.                   
 DEF VAR l-aplica-desc-icms   AS LOGICAL                   NO-UNDO.
 DEF VAR de-qtd-aux           LIKE item-doc-est.quantidade NO-UNDO.     
 DEF VAR c-char-1             AS CHAR                      NO-UNDO.
 def var i-num-seq-duimp-it   like item-docto-estoq-nfe-imp.num-seq-import no-undo.
 def var i-num-adic           like item-docto-estoq-nfe-imp.num-adic no-undo.
 DEF VAR c-nbs                AS CHAR                      NO-UNDO.
 

 DEFINE TEMP-TABLE tt-desconto-icms NO-UNDO 
        FIELD numero-ordem       LIKE ordens-embarque.numero-ordem
        FIELD parcela            LIKE ordens-embarque.parcela
        FIELD de-perc-desc-icms  AS DECIMAL             
        FIELD l-aplica-desc-icms AS LOGICAL .
  
DEFINE BUFFER b-natur-oper-fiscal  FOR natur-oper. /* Buffer aux para buscar natureza fiscal do item ou a natureza de opera‡Æo da nota */

/******************************************** Execu‡Æo ******************************************/

/* Temp-table para execu‡Æo reapi190 */
create tt-versao-integr.
assign tt-versao-integr.cod-versao-integracao = 003.

/* procedure pi-busca-portador-modalidade */
{cdp/cd9900.i5}


def buffer b-tt-itens         for tt-itens.
def buffer bf-embarque-imp    for embarque-imp.
def buffer bf-ordens-embarque for ordens-embarque.

DEF TEMP-TABLE tt-ext-item-doc-est NO-UNDO LIKE ext-item-doc-est
    FIELD r-Rowid          AS ROWID.

DEF TEMP-TABLE tt-docum-est-aux    NO-UNDO LIKE docum-est.
DEF TEMP-TABLE tt-item-doc-est-aux NO-UNDO LIKE item-doc-est.
    
def var c-lb-remes           as   character            no-undo.
def var h-cdapi1001          as   handle               no-undo. /* SIT-TRIBUT */ 
def var h-bocx220a           as   handle               no-undo.
def var i-natureza-camb      as   integer              no-undo.
def var l-first-numero-ordem as   logical              no-undo.
def var l-gera-prim-remessa  as   logical              no-undo.
def var i-parcela-reajuste   like prazo-compra.parcela no-undo.
def new global shared var gl-de-desconto as dec no-undo.
                      
define variable i-cont             as integer  no-undo.
define variable c-return           as char     no-undo.

DEFINE VARIABLE h-cdapi1005-gov       AS HANDLE NO-UNDO.
DEFINE VARIABLE d-perc-red-gov-cbs    AS DECIMAL NO-UNDO. 
DEFINE VARIABLE d-perc-red-gov-ibsuf  AS DECIMAL NO-UNDO. 
DEFINE VARIABLE d-perc-red-gov-ibsmun AS DECIMAL NO-UNDO.
DEFINE VARIABLE h-bocx00512-gov       AS HANDLE NO-UNDO.

find first tt-nota no-error.

assign l-acomp = tt-nota.pl-acomp
       h-acomp = tt-nota.ph-acomp.

find first param-global no-lock no-error.

find first param-cq     no-lock no-error.

find emitente 
    where emitente.cod-emitente   = tt-nota.cod-emitente no-lock no-error.

find natur-oper
    where natur-oper.nat-operacao = tt-nota.nat-operacao no-lock no-error.
    
find estabelec
    where estabelec.cod-estabel = tt-nota.cod-estabel no-lock no-error.
 
find b-emit-estab
    where b-emit-estab.cod-emitente = estabelec.cod-emitente no-lock no-error.
    
find param-re
    where param-re.usuario = tt-nota.usuario no-lock no-error.

find serie
    where serie.serie = tt-nota.serie-docto no-lock no-error.

FIND param-imp
    WHERE param-imp.cod-estabel = tt-nota.cod-estabel NO-LOCK NO-ERROR.

/*
** Verifica se ‚ opera‡Æo de FUNDAP
*/
if emitente.pais = estabelec.pais then
    assign l-fornec-fundap = yes.

/* 
** Determina se o icms ser  calculado no IM7777. Quando a nota estiver sujeita ao tratamento do PIS e COFINS, o PIS e o COFINS estiver 
** parametrizado para incidir na base de calculo do ICMS e, nao for uma operacao de FUNDAP, 
** o calculo do ICMS ser  feito programa programa REAPI190
*/
/*
** Magnus
*/
IF  l-fornec-fundap THEN
    ASSIGN l-calcula-icms-im7777 = YES.

/*
** Inicia Acompanhamento
*/
&if defined(bf-mat-comex) &then
&else
if l-acomp then do:
    {utp/ut-liter.i Consiste_documento... * L}
    assign c-acomp = trim(return-value).
    run pi-acompanhar in h-acomp (input c-acomp).
end.
&endif

if not valid-handle(h-reapi190b) then 
 run rep/reapi190b.p persistent set h-reapi190b.

/* 
** Consiste se o documento ja existe no recebimento 
*/
find docum-est
    where docum-est.serie-docto  = tt-nota.serie-docto
      and docum-est.nro-docto    = tt-nota.nro-docto
      and docum-est.cod-emitente = tt-nota.cod-emitente
      and docum-est.nat-operacao = tt-nota.nat-operacao no-lock no-error.
if avail docum-est then do:
    assign i-msg  = 5569
           c-msg  = string(tt-nota.nro-docto)
           c-char = "".
    run pi-gera-erro.
end.

/* 
** Consiste numero da nota 
*/
if param-global.modulo-ft and natur-oper.imp-nota then
    run pi-consiste-numero.

/*Atualiza‡Æo da Condi‡Æo de Pagamento - FO 2005412 - INICIO*/
{include/i-epc200.i2 &CodEvent='"atualizaCondPagamento"'
                     &CodParameter='"handle-tt-nota"'
                     &ValueParameter="STRING(buffer tt-nota:HANDLE)"}

{include/i-epc200.i2 &codevent='"atualizaCondPagamento"'
                     &codparameter='"handle-tt-itens"'
                     &valueparameter="STRING(buffer tt-itens:HANDLE)"}                    
{include/i-epc201.i "atualizaCondPagamento"}

find first tt-epc where
           tt-epc.cod-event     = "atualizaCondPagamento" and
           tt-epc.cod-parameter = "Return" no-lock no-error.
if avail tt-epc then do:
    assign i-msg  = 15825
           c-msg  = tt-epc.val-parameter
           c-char = "".

    run pi-gera-erro.

    leave.
end.

find first tt-nota no-error. /* nao retirar - foi incluido em funcao da EPC da GRENDENE ACIMA */

/*Atualiza‡Æo da Condi‡Æo de Pagamento - FO 2005412 - FIM*/
/* 
** Cria temp-tables de cabecalho da nota 
*/
run pi-gera-docto.

/*
** Busca Embarques Relacionados ao Embarque que est  sendo nacionalizado
*/
if tt-nota.l-gera-prim-nf-remes-mae then 
   run piBuscaEmbarquesRelacionados (input tt-nota.cod-estabel,
                                     input tt-nota.embarque,
                                     output table tt-embarque-filho-aux).
/*
** ICMS Desonerado
*/
IF NOT VALID-HANDLE(h-bocx225na) THEN
   RUN cxbo/bocx225na.p PERSISTENT SET h-bocx225na. 
   
for each tt-itens
    break by numero-ordem:   
    
    FIND FIRST b-natur-oper-fiscal 
         WHERE b-natur-oper-fiscal.nat-operacao = tt-itens.nat-fiscal NO-LOCK NO-ERROR.
                                  
    RUN calculaDescontoICMS.   
    /* Quando tem percentual de desconto ICMS informado */        
    IF de-perc-desc-icms > 0 then do:    
       /* verificar se foi gravado no ordens-embarque o campo Aplica Desconto ICMS */                                                                                                                                    
       RUN FindOrdensEmbarque IN h-bocx225na (INPUT tt-itens.numero-ordem, INPUT tt-itens.parcela, OUTPUT c-return).   
       IF  c-return = "" THEN                                                                                                        
           RUN getLogField IN h-bocx225na ("log-aplica-desc-icms":U, OUTPUT l-aplica-desc-icms).                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
    END.                                          
                    
    /* Grava a informa‡Æo por item */
    CREATE tt-desconto-icms.
    ASSIGN tt-desconto-icms.numero-ordem       = tt-itens.numero-ordem 
           tt-desconto-icms.parcela            = tt-itens.parcela
           tt-desconto-icms.de-perc-desc-icms  = de-perc-desc-icms   
           tt-desconto-icms.l-aplica-desc-icms = l-aplica-desc-icms.
end. 
IF VALID-HANDLE(h-bocx225na) THEN DO:                                                                                         
   DELETE PROCEDURE h-bocx225na.                                                                                              
   ASSIGN h-bocx225na = ?.
END. 

/* 
** Cria temp-tables de despesas do embarque 
*/
run pi-gera-tt-despesas.

if can-find (first tt-erro) then
    return.

find first tt-docum-est no-error.

run pi-gera-docto-estoq-nfe-imp.

find first embarque-imp 
     where embarque-imp.cod-estabel = tt-docum-est.cod-estabel 
       and embarque-imp.embarque    = tt-docum-est.embarque no-lock no-error. 
   
&IF '{&bf_mat_versao_ems}' >= '2.09' &THEN 
    assign i-natureza-camb = embarque-imp.idi-natur-cambial.
&ELSE 
    assign i-natureza-camb = embarque-imp.int-1.
&ENDIF

/*
** Cria Itens do Documento
*/
for each tt-itens
    break by numero-ordem:

    assign l-first-numero-ordem = no.
    if first-of(tt-itens.numero-ordem) then
       assign l-first-numero-ordem = yes.

    &if defined(bf-mat-comex) &then
        /* 
        ** Tratamento FUNDAP 
        */
        IF l-fornec-fundap THEN DO:
            CREATE tt-itens-ext.
            ASSIGN tt-itens-ext.numero-ordem     = tt-itens.numero-ordem
                   tt-itens-ext.parcela          = tt-itens.parcela
                   tt-itens-ext.seq              = tt-itens.seq
                   tt-itens-ext.preco-total-orig = tt-itens.preco-total.
        END.
    &endif
    
    find item
        where item.it-codigo = tt-itens.it-codigo no-lock no-error.
        
    find ordem-compra
        where ordem-compra.numero-ordem = tt-itens.numero-ordem no-lock no-error.

    &IF "{&bf_mat_versao_ems}" >= "2.062" &THEN
    find ordens-embarque
        where ordens-embarque.cod-estabel = tt-nota.cod-estabel
          and ordens-embarque.embarque    = tt-nota.embarque
          no-lock no-error.
    &endif

    assign de-frete        = 0
           de-seguro       = 0
           de-embal        = 0
           de-outras       = 0
           de-base-ipi     = 0
           de-base-icm     = 0
           de-base-II      = 0
           de-tot-desp-adu = 0
           de-tot-desp-II  = 0.

    &if defined(bf-mat-comex) &then
    &else
        if l-acomp then do:
            {utp/ut-liter.i Consiste_itens... * L}
            assign c-acomp = trim(return-value).
            run pi-acompanhar in h-acomp (input c-acomp).
        end.
    
        &if '{&bf_mat_versao_ems}' >= '2.04' &then
              find item-uni-estab where
                   item-uni-estab.it-codigo   = ordem-compra.it-codigo and
                   item-uni-estab.cod-estabel = ordem-compra.cod-estabel no-lock no-error.
              if avail item-uni-estab then
                 assign l-loc-unica = item-uni-estab.loc-unica
                        c-cod-localiz = item-uni-estab.cod-localiz.
              else assign l-loc-unica = item.loc-unica
                          c-cod-localiz = item.cod-localiz.
        &else
            assign l-loc-unica = item.loc-unica
                   c-cod-localiz = item.cod-localiz.
        &endif
    &endif    
    
    FIND FIRST b-natur-oper-fiscal                                                      
         WHERE b-natur-oper-fiscal.nat-operacao = tt-itens.nat-fiscal NO-LOCK NO-ERROR.
    
    if i-seq-item-doc-est = 0 then
        assign i-seq-item-doc-est = param-re.seq-item-um.
    else
        assign i-seq-item-doc-est = i-seq-item-doc-est
                                  + param-re.inc-seq.

    create tt-item-doc-est.
    
    assign tt-itens.sequencia               = i-seq-item-doc-est.
         
    assign tt-item-doc-est.cod-emitente     = tt-docum-est.cod-emitente
           tt-item-doc-est.nat-operacao     = tt-docum-est.nat-operacao
           tt-item-doc-est.nro-docto        = tt-docum-est.nro-docto
           tt-item-doc-est.serie-docto      = tt-docum-est.serie-docto
           tt-item-doc-est.sequencia        = i-seq-item-doc-est
           tt-item-doc-est.quantidade       = tt-itens.quantidade
           tt-item-doc-est.lote             = tt-itens.lote
           tt-item-doc-est.dt-vali-lote     = tt-itens.dt-vali-lote
           tt-item-doc-est.cod-refer        = tt-itens.cod-refer
           tt-item-doc-est.encerra-pa       = tt-itens.encerra-pa
           tt-item-doc-est.parcela          = tt-itens.parcela
           tt-item-doc-est.cod-depos        = tt-itens.cod-depos
           tt-item-doc-est.it-codigo        = ordem-compra.it-codigo
           tt-item-doc-est.numero-ordem     = ordem-compra.numero-ordem
           
         &if defined(bf-mat-comex) &then
           tt-item-doc-est.narrativa[1]     = ordem-compra.narrativa[1]
         &else
           tt-item-doc-est.narrativa        = ordem-compra.narrativa
         &endif
           
           tt-item-doc-est.nr-ord-prod      = ordem-compra.ordem-servic
           
         &if defined(bf-mat-comex) &then
           tt-item-doc-est.ct-codigo        = if ordem-compra.ct-codigo = 0
                                                and (item.tipo-contr = "f":U or item.tipo-contr = "d":U) then
                                                item.ct-codigo 
                                              else
                                                ordem-compra.ct-codigo
           tt-item-doc-est.sc-codigo        = if  ordem-compra.ct-codigo = 0
                                                and (item.tipo-contr = "f":U or item.tipo-contr = "d":U) then
                                                  item.sc-codigo
                                              else
                                                  ordem-compra.sc-codigo
           tt-item-doc-est.localizacao      = item.localizacao
           tt-item-doc-est.nro-comp         = 0
         &else
           tt-item-doc-est.ct-codigo   = if  ordem-compra.ct-codigo = ""
                                                and (item.tipo-contr = 1 or item.tipo-contr = 4) then
                                                  item.ct-codigo
                                              else
                                                  ordem-compra.ct-codigo

           tt-item-doc-est.sc-codigo   = if ordem-compra.ct-codigo = ""
                                           and (item.tipo-contr = 1 or item.tipo-contr = 4) then
                                             item.sc-codigo
                                         else
                                             ordem-compra.sc-codigo
           tt-item-doc-est.cod-localiz      = c-cod-localiz
           tt-item-doc-est.nro-comp         = "0"
         &endif
           tt-item-doc-est.class-fiscal     = tt-itens.class-fiscal
           &IF "{&bf_mat_versao_ems}" >= "2.062" &THEN
               tt-item-doc-est.peso-liquido     = ITEM.peso-liquido
           &else
               tt-item-doc-est.peso-liquido     = ITEM.peso-liquido
                                                * tt-itens.quantidade
           &endif
           tt-item-doc-est.nr-proc-imp      = tt-itens.nr-proc-imp
           tt-item-doc-est.desconto         = 0
           tt-item-doc-est.baixa-ce         = yes 
           tt-item-doc-est.valor-iss        = 0
           tt-item-doc-est.valor-subs       = 0
           tt-item-doc-est.ind-icm-ret      = IF b-natur-oper-fiscal.subs-trib and not b-natur-oper-fiscal.log-icms-substto-antecip THEN yes else no
           
           &if '{&bf_lote_avancado_liberado}' = 'yes' &then /*Campos Projeto FDA*/
             tt-item-doc-est.cod-lote-fabrican       =  tt-itens.cod-lote-fabrican            
             tt-item-doc-est.dat-fabricc-lote        =  tt-itens.dat-fabricc-lote             
             tt-item-doc-est.dat-valid-lote-fabrican =  tt-itens.dat-valid-lote-fabrican      
             tt-item-doc-est.nom-fabrican            =  tt-itens.nom-fabrican                 
           &ENDIF           
           .
    ASSIGN gl-de-desconto = tt-itens.desconto.    
    
    IF tt-itens.l-ordens-embarque THEN
        if tt-itens.peso-liquido <> 0 then
           ASSIGN tt-item-doc-est.peso-liquido = tt-itens.peso-liquido.         
           
    /*Quando a release for igual ou superior ao EMS205, o peso liquido sempre ser  buscado das ordens-embarque, pois a grava‡Æo 
    do peso ‚ realizada no momento da vincula‡Æo da ordem ao embarque*/
    &if '{&bf_mat_versao_ems}':U >= '2.05':U &then
     ASSIGN tt-item-doc-est.peso-liquido = tt-itens.peso-liquido.
    &endif          
           
    if  tt-nota.l-nf-simples-remessa 
    and tt-nota.idi-nf-simples-remes = 1 then do: /** nota mae **/
        if tt-nota.l-gera-prim-nf-remes-mae then do:
           if not can-find(first tt-embarque-oc
                           where tt-embarque-oc.numero-ordem = tt-itens.numero-ordem
                             and tt-embarque-oc.parcela      = tt-itens.parcela
                             and tt-embarque-oc.sequencia    = tt-itens.sequencia) then do:

               create tt-embarque-oc.
               assign tt-embarque-oc.numero-ordem             = tt-itens.numero-ordem
                      tt-embarque-oc.parcela                  = tt-itens.parcela
                      tt-embarque-oc.sequencia                = tt-itens.sequencia
                      tt-embarque-oc.l-gera-prim-nf-remes-mae = tt-itens.l-gera-prim-nf-remes-mae.
           end.
           
           if not tt-itens.l-gera-prim-nf-remes-mae then
              assign tt-item-doc-est.ct-codigo = tt-nota.ct-codigo
                     tt-item-doc-est.sc-codigo = tt-nota.sc-codigo. 
        end.
        else 
           assign tt-item-doc-est.ct-codigo = tt-nota.ct-codigo
                  tt-item-doc-est.sc-codigo = tt-nota.sc-codigo. 
    end.
                 
    &if defined(bf-mat-comex) &then
        if b-natur-oper-fiscal.tipo = yes
    &else
        if b-natur-oper-fiscal.tipo = 1
    &endif
          and not b-natur-oper-fiscal.terceiros
          or ( b-natur-oper-fiscal.tp-oper-terc <> 1    /* Remessa Beneficiamento   */
          and  b-natur-oper-fiscal.tp-oper-terc <> 2    /* Retorno Beneficiamento   */
          and  b-natur-oper-fiscal.tp-oper-terc <> 8    /* Remessa Dep¢sito Fechado */
          and  b-natur-oper-fiscal.tp-oper-terc <> 9    /* Retorno Dep¢sito Fechado */
          and  b-natur-oper-fiscal.tp-oper-terc <> 10   /* Remessa Armaz‚m Geral    */
          and  b-natur-oper-fiscal.tp-oper-terc <> 11 ) /* Retorno Armaz‚m Geral    */ then do:
            if param-global.modulo-cq and 
             &if defined(bf-mat-comex) &then
               param-cq.tipo-cq > 0 and
             &else
               param-cq.tipo-cq > 1 and 
             &endif
               b-natur-oper-fiscal.transf = no and
               &if "{&bf_mat_versao_ems}" >= "2.04" &then
                    avail item-uni-estab and item-uni-estab.contr-qualid and
               &else     
                    item.contr-qualid and
               &endif
               item.it-codigo <> "" then
                run pi-skip-lote.
        end.
           
    find item-fornec
        where item-fornec.it-codigo    = tt-item-doc-est.it-codigo
          and item-fornec.cod-emitente = tt-item-doc-est.cod-emitente no-lock no-error.
    if avail item-fornec then
        assign tt-item-doc-est.qt-do-forn = tt-item-doc-est.quantidade
                                          * (item-fornec.fator-conver /
                                             if item-fornec.num-casa-dec = 0 then 1
                                             else exp(10,item-fornec.num-casa-dec)).
    else
        assign tt-item-doc-est.qt-do-forn = tt-item-doc-est.quantidade.
        
    if tt-item-doc-est.nr-ord-prod <> 0 then do:
        find first reservas
            where reservas.nr-ord-prod = tt-item-doc-est.nr-ord-prod
              and reservas.it-codigo   = tt-item-doc-est.it-codigo no-lock no-error.
        if not avail reservas then do:
            &if defined(bf-mat-comex) &then
            &else
            
                ASSIGN tt-item-doc-est.item-pai = "".
            
                /*
                ** NÆo exige reserva para ordens de produ‡Æo de itens de pol¡tica configurado e controlado por referˆncia
                */
                FIND ord-prod
                    WHERE ord-prod.nr-ord-prod = tt-item-doc-est.nr-ord-prod NO-LOCK NO-ERROR.
                IF AVAIL ord-prod THEN DO:
                    FIND b-item 
                        WHERE b-item.it-codigo = ord-prod.it-codigo NO-LOCK NO-ERROR.
                    IF AVAIL b-item then do:
                        if b-item.politica     = 5 AND /* configurado */
                           b-item.tipo-con-est = 4 THEN /* referˆncia  */
                           ASSIGN tt-item-doc-est.item-pai = "".
                        if b-item.tipo-contr = 4 then /* D‚bito Direto */
                            ASSIGN tt-item-doc-est.item-pai = "".
                    end.
                END.

                IF ITEM.tipo-contr = 4 THEN /* D‚bito Direto */
                    ASSIGN tt-item-doc-est.item-pai = "".
                
                assign tt-item-doc-est.cod-roteiro = ""
                       tt-item-doc-est.op-codigo   = 0.
            &endif
        end.
        else do:
            &if defined(bf-mat-comex) &then
            &else
                assign tt-item-doc-est.item-pai    = reservas.item-pai
                       tt-item-doc-est.cod-roteiro = reservas.cod-roteiro
                       tt-item-doc-est.op-codigo   = reservas.op-codigo.
            &endif
        end.
    end.

    /* 
    ** Cota‡Æo Item - NBS
    */
    IF CAN-FIND(FIRST natur-oper NO-LOCK
            WHERE natur-oper.nat-operacao = tt-item-doc-est.nat-operacao
            AND  (natur-oper.cod-model-nf-eletro = "56" OR natur-oper.log-nfse-nacional)) THEN DO:
                
        assign c-nbs = SUBSTRING(item.char-1,342,20).

        for first cotacao-item no-lock
            where cotacao-item.numero-ordem = tt-item-doc-est.numero-ordem
              and cotacao-item.cod-emitente = tt-item-doc-est.cod-emitente
              and cotacao-item.it-codigo    = tt-item-doc-est.it-codigo
              and cotacao-item.cot-aprovada = yes:
              IF SUBSTRING(cotacao-item.char-1,100,20) <> "" THEN 
                  assign c-nbs = SUBSTRING(cotacao-item.char-1,100,20).
        end.
        
        if  c-nbs <> "" then do:
            IF NOT CAN-FIND(FIRST tt-item-doc-est-aux
                            WHERE tt-item-doc-est-aux.cod-emitente = tt-item-doc-est.cod-emitente
                              AND tt-item-doc-est-aux.nro-docto    = tt-item-doc-est.nro-docto
                              AND tt-item-doc-est-aux.serie-docto  = tt-item-doc-est.serie-docto
                              AND tt-item-doc-est-aux.nat-operacao = tt-item-doc-est.nat-operacao
                              AND tt-item-doc-est-aux.sequencia    = tt-item-doc-est.sequencia) THEN DO:

                /* Temp-table enviada a reapi190b para popular o campo da item-doc-est */
                CREATE tt-item-doc-est-aux.
                ASSIGN tt-item-doc-est-aux.cod-emitente           = tt-item-doc-est.cod-emitente
                       tt-item-doc-est-aux.nro-docto              = tt-item-doc-est.nro-docto
                       tt-item-doc-est-aux.serie-docto            = tt-item-doc-est.serie-docto
                       tt-item-doc-est-aux.nat-operacao           = tt-item-doc-est.nat-operacao
                       tt-item-doc-est-aux.sequencia              = tt-item-doc-est.sequencia
                       OVERLAY(tt-item-doc-est-aux.char-2,956,20) = trim(c-nbs).
            END.
        end.
    end.

    /*
    ** Drawback - 2.03
    **/
    &if defined (bf_mat_versao_ems) &then
        &if "{&bf_mat_versao_ems}" >= "2.03" &then
            assign tt-item-doc-est.nr-ato-concessorio = tt-itens.nr-ato-concessorio.
        &endif
    &endif
    
    &if defined(bf_mat_nf_simp_remes_desp_imp) &then
        &if '{&bf_mat_versao_ems}':U >= '2.04':U &then
             if  tt-nota.l-nf-simples-remessa
             and tt-nota.idi-nf-simples-remes = 2 then  /** nf simples remessa filha **/   
                 assign tt-item-doc-est.nr-ato-concessorio = "":U.
        &endif
    &endif
    
    /* Compra Governamental: busca os percentuais no relacionamento Item x Tributo */
    RUN pi-busca-perc-red-gov-item (
        INPUT tt-docum-est.cod-estabel,
        INPUT tt-docum-est.embarque,
        INPUT tt-item-doc-est.numero-ordem,
        INPUT tt-item-doc-est.parcela,
        INPUT tt-item-doc-est.it-codigo,
        INPUT tt-itens.nat-fiscal,
        INPUT tt-item-doc-est.cod-emitente,
        INPUT tt-item-doc-est.class-fiscal,
        INPUT embarque-imp.data-di,
        OUTPUT d-perc-red-gov-cbs,
        OUTPUT d-perc-red-gov-ibsuf,
        OUTPUT d-perc-red-gov-ibsmun).
        
    FIND FIRST decla-import-adic-itens NO-LOCK
     WHERE decla-import-adic-itens.cod-embarq  = tt-nota.embarque
       AND decla-import-adic-itens.num-ordem   = tt-item-doc-est.numero-ordem
       AND decla-import-adic-itens.num-parcela = tt-item-doc-est.parcela
       AND decla-import-adic-itens.cod-estab   = tt-docum-est.cod-estabel
     NO-ERROR.

    IF AVAILABLE decla-import-adic-itens THEN DO:

        RUN pi-grava-perc-red-gov (
            INPUT decla-import-adic-itens.num-di-ems,
            INPUT decla-import-adic-itens.num-adic,
            INPUT decla-import-adic-itens.num-seq,
            INPUT decla-import-adic-itens.cdd-siscomex-dts,
            INPUT "CBS":U,
            INPUT d-perc-red-gov-cbs).

        RUN pi-grava-perc-red-gov (
            INPUT decla-import-adic-itens.num-di-ems,
            INPUT decla-import-adic-itens.num-adic,
            INPUT decla-import-adic-itens.num-seq,
            INPUT decla-import-adic-itens.cdd-siscomex-dts,
            INPUT "IBSUF":U,
            INPUT d-perc-red-gov-ibsuf).

        RUN pi-grava-perc-red-gov (
            INPUT decla-import-adic-itens.num-di-ems,
            INPUT decla-import-adic-itens.num-adic,
            INPUT decla-import-adic-itens.num-seq,
            INPUT decla-import-adic-itens.cdd-siscomex-dts,
            INPUT "IBSMUN":U,
            INPUT d-perc-red-gov-ibsmun).
    END.
    /*
    ** Codigo de tributacao e Aliquota do ICMS
    */
    run pi-cod-trib-icm.
    
    /*
    ** Codigo de tributacao e Aliquota do IPI
    */
    run pi-cod-trib-ipi.
    
    &if defined(bf-mat-comex) &then
    &else
        if l-acomp then do:
            {utp/ut-liter.i Despesas_dos_itens... * L}
            assign c-acomp = trim(return-value).
            run pi-acompanhar in h-acomp (input c-acomp).
        end.
    &endif
    
    /* 
    ** Despesas dos itens 
    */ 
    run pi-despesas.
    
    assign de-tot-seguro = de-tot-seguro
                         + de-seguro
           de-tot-embal  = de-tot-embal
                         + de-embal
           de-tot-outras = de-tot-outras
                         + de-outras.
    
    /*
    ** Gera tt-it-docto - utilizado p/ calcular os valores dos impostos
    */ 
    run pi-gera-tt-it-docto.
    
    /*
    ** Gera tt-it-imposto - utilizado p/ calcular os valores dos impostos
    */
    run pi-gera-tt-it-imposto.
    
    /* ICMS Desonerado */    
    FOR EACH tt-it-docto EXCLUSIVE-LOCK:
        FIND FIRST tt-item-doc-est NO-LOCK 
            {cdp/cd8900.i tt-docum-est tt-item-doc-est} AND
            tt-item-doc-est.sequencia = tt-it-docto.nr-sequencia NO-ERROR. 
        for first tt-desconto-icms
            where tt-desconto-icms.numero-ordem = tt-it-docto.numero-ordem  
            and   tt-desconto-icms.parcela      = tt-it-docto.parcela      : end.                     
        IF avail tt-desconto-icms then do:
           if tt-desconto-icms.de-perc-desc-icms > 0 AND tt-desconto-icms.l-aplica-desc-icms THEN DO:
                ASSIGN de-qtd-aux = IF tt-item-doc-est.qt-do-forn <> 0 THEN tt-item-doc-est.qt-do-forn ELSE 1
                       tt-it-docto.vl-merc-liq = tt-it-docto.vl-merc-liq - tt-item-doc-est.desconto - (tt-it-docto.vl-merc-liq * (tt-desconto-icms.de-perc-desc-icms / 100))
                       tt-it-docto.vl-preuni   = (tt-it-docto.vl-merc-liq / de-qtd-aux).    
           end.            
        END.                                      
    END.

    find last tt-it-docto   no-lock no-error.
    find last tt-it-imposto no-lock no-error.
    find last tt-docto      no-lock no-error.
    
    
    if l-acomp then do:
        {utp/ut-liter.i Calculo_IPI/ICMS... * L}
        assign c-acomp = trim(return-value).
        run pi-acompanhar in h-acomp (input c-acomp).
    end.
    
    
    /*
    ** FUNDAP - na opera‡Æo de FUNDAP o valor do ICMS ‚ calculado primeiro para que seu valor seja adicionado ao valor do material,
    ** o IPI ‚ calculado posteriormente.
    */ 
    if not l-fornec-fundap then do: 
    
        /* Calculo a base e o valor do IPI  */
        run cdp/cd4306.p ( tt-it-docto.seq-tt-it-docto,
                           1,                  /* Natureza Entrada */
                           b-natur-oper-fiscal.char-2,  /* Frete Base IPI   */
                           no,                 /* Nota Comercio    */
                           input        table tt-docto,
                           input        table tt-it-docto,
                           input-output table tt-it-imposto).
        
        find first tt-it-imposto 
             where tt-it-imposto.seq-tt-it-docto = tt-it-docto.seq-tt-it-docto no-error.
                               
        assign tt-item-doc-est.base-ipi    = tt-it-imposto.vl-bipi-it
               tt-item-doc-est.valor-ipi   = tt-it-imposto.vl-ipi-it           
               tt-item-doc-est.ipi-ntrib   = tt-it-imposto.vl-ipint-it
               tt-item-doc-est.ipi-outras  = tt-it-imposto.vl-ipiou-it.
        
        if tt-nota.l-gera-prim-nf-remes-mae then do:
            /* Acumula total dos itens calculados para posteriormente realizar comparacao*/
            find first tt-totais-remes-com-mae
                 where tt-totais-remes-com-mae.numero-ordem = tt-it-docto.numero-ordem 
                   and tt-totais-remes-com-mae.it-codigo    = tt-it-docto.it-codigo exclusive-lock no-error.

            if not avail tt-totais-remes-com-mae then do:

                create tt-totais-remes-com-mae.
                assign tt-totais-remes-com-mae.numero-ordem = tt-it-docto.numero-ordem
                       tt-totais-remes-com-mae.it-codigo    = tt-it-docto.it-codigo
                       tt-totais-remes-com-mae.base-ipi     = tt-it-imposto.vl-bipi-it 
                       tt-totais-remes-com-mae.valor-ipi    = tt-it-imposto.vl-ipi-it  
                       tt-totais-remes-com-mae.ipi-ntib     = tt-it-imposto.vl-ipint-it
                       tt-totais-remes-com-mae.ipi-outras   = tt-it-imposto.vl-ipiou-it.
            end.
            else
                assign tt-totais-remes-com-mae.base-ipi     = tt-totais-remes-com-mae.base-ipi   + tt-it-imposto.vl-bipi-it 
                       tt-totais-remes-com-mae.valor-ipi    = tt-totais-remes-com-mae.valor-ipi  + tt-it-imposto.vl-ipi-it  
                       tt-totais-remes-com-mae.ipi-ntib     = tt-totais-remes-com-mae.ipi-ntib   + tt-it-imposto.vl-ipint-it
                       tt-totais-remes-com-mae.ipi-outras   = tt-totais-remes-com-mae.ipi-outras + tt-it-imposto.vl-ipiou-it.
        end.

    end.
    
    assign tt-item-doc-est.preco-total = tt-it-docto.vl-merc-ori.
           
    /* ICMS Desonerado - Reduz base Imposto de Importa‡Æo */ 
    if de-perc-desc-icms > 0 then
       assign de-base-ii = de-base-ii  + tt-it-docto.vl-merc-liq.
    else
       assign de-base-ii = de-base-ii  + tt-item-doc-est.preco-total.
   
   find ordens-embarque no-lock
      where ordens-embarque.cod-estabel   = tt-nota.cod-estabel
        and ordens-embarque.embarque      = tt-nota.embarque
        and ordens-embarque.numero-ordem  = tt-item-doc-est.numero-ordem
        and ordens-embarque.parcela       = tt-item-doc-est.parcela no-error.     
        
   if avail ordens-embarque then do:
      &IF "{&bf_mat_versao_ems}" = "2.04" &THEN
           IF tt-itens.l-ordens-embarque and item.tipo-con-est = 2 THEN DO: 
                 assign tt-item-doc-est.peso-liquido = tt-item-doc-est.peso-liquido / ordens-embarque.quantidade.
           END.
       &endif.
    end.    
    
    run pi-gera-item-docto-estoq-nfe-imp.
    /* 
    ** Acumula totais 
    */
    assign tt-docum-est.tot-peso       = tt-docum-est.tot-peso     + tt-item-doc-est.peso-liquido
           tt-docum-est.valor-frete    = tt-docum-est.valor-frete  + tt-item-doc-est.vl-frete-cons
           tt-docum-est.valor-mercad   = tt-docum-est.valor-mercad + tt-itens.preco-total.
           
end. /* fim for each tt-itens */

/* Acerto diferencas de arredondamento, ocasionado pela quebra dos itens antes da nacionalizacao
** Comparar com nacionalizacao realizada sem a quebra (Nota Mae de Simples Remessa)
*/
if tt-nota.l-gera-prim-nf-remes-mae then do:

    /* Elimina e realiza backup das tt's originais para calculo de imposto no cd4306 pois sao definidas como shared */
    for each tt-it-docto no-lock:
        create tt-it-docto-bkp.
        buffer-copy tt-it-docto to tt-it-docto-bkp.
    end.
    for each tt-it-imposto no-lock:
        create tt-it-imposto-bkp.
        buffer-copy tt-it-imposto to tt-it-imposto-bkp.
    end.
    
    empty temp-table tt-it-docto.
    empty temp-table tt-it-imposto.

    /* Cria as temp-tables shared com os valores totais */
    for each tt-it-docto-remes-com-mae no-lock:
        create tt-it-docto.
        buffer-copy tt-it-docto-remes-com-mae to tt-it-docto.

        for first tt-it-imposto-remes-com-mae
            where tt-it-imposto-remes-com-mae.seq-tt-it-docto = tt-it-docto-remes-com-mae.seq-tt-it-docto no-lock:

            create tt-it-imposto.
            buffer-copy tt-it-imposto-remes-com-mae to tt-it-imposto.
        end.

        /* ICMS Desonerado */
        FOR EACH tt-it-docto EXCLUSIVE-LOCK:
            FIND FIRST tt-item-doc-est NO-LOCK 
                {cdp/cd8900.i tt-docum-est tt-item-doc-est} AND
                tt-item-doc-est.sequencia = tt-it-docto.nr-sequencia NO-ERROR. 
            for first tt-desconto-icms
                where tt-desconto-icms.numero-ordem = tt-it-docto.numero-ordem  
                and   tt-desconto-icms.parcela      = tt-it-docto.parcela : end.                     
            IF avail tt-desconto-icms then do:
               if tt-desconto-icms.de-perc-desc-icms > 0 AND tt-desconto-icms.l-aplica-desc-icms THEN DO:                                          
                  ASSIGN de-qtd-aux = IF tt-item-doc-est.qt-do-forn <> 0 THEN tt-item-doc-est.qt-do-forn ELSE 1
                         tt-it-docto.vl-merc-liq = tt-it-docto.vl-merc-liq - tt-item-doc-est.desconto - (tt-it-docto.vl-merc-liq * (tt-desconto-icms.de-perc-desc-icms / 100))
                         tt-it-docto.vl-preuni   = (tt-it-docto.vl-merc-liq / de-qtd-aux).
                end.
            END.
        END.

        find last tt-it-docto   no-lock no-error.
        find last tt-it-imposto no-lock no-error.
        find last tt-docto      no-lock no-error.

        /* Calculo a base e o valor do IPI com o valor total dos itens quebrados para geracao do documento (nota mae com primeira remessa) */
        run cdp/cd4306.p ( tt-it-docto.seq-tt-it-docto,
                           1,                  /* Natureza Entrada */
                           natur-oper.char-2,  /* Frete Base IPI   */
                           no,                 /* Nota Comercio    */
                           input        table tt-docto,
                           input        table tt-it-docto,
                           input-output table tt-it-imposto).

        find first tt-it-imposto 
             where tt-it-imposto.seq-tt-it-docto = tt-it-docto.seq-tt-it-docto no-lock no-error.

        find first tt-totais-remes-com-mae
             where tt-totais-remes-com-mae.numero-ordem = tt-it-docto.numero-ordem
               and tt-totais-remes-com-mae.it-codigo    = tt-it-docto.it-codigo no-lock no-error.

        find first tt-item-doc-est
             where tt-item-doc-est.serie-docto  = tt-docum-est.serie-docto
               and tt-item-doc-est.nro-docto    = tt-docum-est.nro-docto
               and tt-item-doc-est.cod-emitente = tt-docum-est.cod-emitente
               and tt-item-doc-est.nat-operacao = tt-docum-est.nat-operacao
               and tt-item-doc-est.numero-ordem = tt-it-docto.numero-ordem
               and tt-item-doc-est.it-codigo    = tt-it-docto.it-codigo exclusive-lock no-error.
        
        if avail tt-it-imposto and avail tt-totais-remes-com-mae and avail tt-item-doc-est then do:
             if tt-totais-remes-com-mae.base-ipi <> tt-it-imposto.vl-bipi-it 
            and (tt-it-imposto.vl-bipi-it - tt-totais-remes-com-mae.base-ipi) <=  0.05
            and (tt-it-imposto.vl-bipi-it - tt-totais-remes-com-mae.base-ipi) >= -0.05 then 
                assign tt-item-doc-est.base-ipi = tt-item-doc-est.base-ipi + (tt-it-imposto.vl-bipi-it - tt-totais-remes-com-mae.base-ipi).
        
            if tt-totais-remes-com-mae.valor-ipi <> tt-it-imposto.vl-ipi-it 
           and (tt-it-imposto.vl-ipi-it - tt-totais-remes-com-mae.valor-ipi) <=  0.05
           and (tt-it-imposto.vl-ipi-it - tt-totais-remes-com-mae.valor-ipi) >= -0.05 then
                assign tt-item-doc-est.valor-ipi = tt-item-doc-est.valor-ipi + (tt-it-imposto.vl-ipi-it - tt-totais-remes-com-mae.valor-ipi).

            if tt-totais-remes-com-mae.ipi-ntib  <> tt-it-imposto.vl-ipint 
           and (tt-it-imposto.vl-ipint - tt-totais-remes-com-mae.ipi-ntib) <=  0.05
           and (tt-it-imposto.vl-ipint - tt-totais-remes-com-mae.ipi-ntib) >= -0.05 then
                assign tt-item-doc-est.ipi-ntrib = tt-item-doc-est.ipi-ntrib + (tt-it-imposto.vl-ipint - tt-totais-remes-com-mae.ipi-ntib).

            if tt-totais-remes-com-mae.ipi-outras <> tt-it-imposto.vl-ipiou-it 
           and (tt-it-imposto.vl-ipiou-it - tt-totais-remes-com-mae.ipi-outras) <=  0.05
           and (tt-it-imposto.vl-ipiou-it - tt-totais-remes-com-mae.ipi-outras) >= -0.05 then
                assign tt-item-doc-est.ipi-outras = tt-item-doc-est.ipi-outras + (tt-it-imposto.vl-ipiou-it - tt-totais-remes-com-mae.ipi-outras).
        end.
    end.


    /* Volta backup das tabelas */
    empty temp-table tt-it-docto.  
    empty temp-table tt-it-imposto.
    
    for each tt-it-docto-bkp no-lock:
        create tt-it-docto.
        buffer-copy tt-it-docto-bkp to tt-it-docto.
    end.

    for each tt-it-imposto-bkp no-lock:
        create tt-it-imposto.
        buffer-copy tt-it-imposto-bkp to tt-it-imposto.
    end.
    
    empty temp-table tt-it-docto-bkp.
    empty temp-table tt-it-imposto-bkp.

end. /* Fim acerto */

for each docum-est-cex no-lock
   where docum-est-cex.serie        = tt-docum-est.serie-docto
     and docum-est-cex.nro-docto    = tt-docum-est.nro-docto
     and docum-est-cex.cod-emitente = tt-docum-est.cod-emitente
     and docum-est-cex.nat-operacao = tt-docum-est.nat-operacao:
  for first desp-imp fields(descricao log-1 char-1) no-lock 
      where desp-imp.cod-desp = docum-est-cex.cod-desp:
  end.
  
  find first tt-docto-estoq-nfe-imp exclusive-lock no-error.
  if avail tt-docto-estoq-nfe-imp then do:
     if avail embarque-imp then do:
        /*Atualiza‡Æo Via de Transporte*/
        CASE embarque-imp.cod-via-transp: 
             /* Rodovi rio */ 
             WHEN 1 THEN DO:
                  OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2) = "7".
             END.
             /* Aerovi rio */ 
             WHEN 2 THEN DO:
                  OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2) = "4".
             END.
                 /* Mar¡timo */ 
             WHEN 3 THEN DO:
                  OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2) = "1".
             END.
                 /* Ferrovi rio */ 
             WHEN 4 THEN DO:
                  OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2) = "6".
             END.
                 /* Rodoferrovi rio */ 
             WHEN 5 THEN DO:
                  OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2) = "6". 
             END.
                 /* Rodofluvial */ 
             WHEN 6 THEN DO:
                  OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2) = "2". 
             END.
                 /* Rodoaerovi rio */ 
             WHEN 7 THEN DO:
                  OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2) = "7". 
             END.
                 /* Outros */ 
             WHEN 8 THEN DO:
                  OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2) = "11". 
             END.   
        END CASE.     
     end.
  
     /*Sobrepoe via de transporte caso Despesa incida no AFRMM*/
     if avail desp-imp and substring(desp-imp.char-1,44,1) = "1":U then do: /*AFRMM*/
        assign overlay(tt-docto-estoq-nfe-imp.cod-livre-1,3,20) = string(docum-est-cex.val-desp).
               overlay(tt-docto-estoq-nfe-imp.cod-livre-1,1,2)  = "1". /*Atualiza‡Æo via de Transporte Mar¡tima*/
     end.
  end.
  
  for first desp-embarque fields(descricao) no-lock
      where desp-embarque.cod-estabel = tt-docum-est.cod-estab
        and desp-embarque.embarque    = tt-docum-est.embarque
        and desp-embarque.cod-desp    = docum-est-cex.cod-desp:
  end.
  
  /* Imprime Nota Fiscal */
  if desp-imp.log-1 then
     assign tt-docum-est.observacao = tt-docum-est.observacao  + " | "
                                      + string(docum-est-cex.cod-desp) + "-"
                                      + (if avail desp-embarque and desp-embarque.descricao <> "":U then desp-embarque.descricao else desp-imp.descricao) + " / "
                                      + trim(string(docum-est-cex.val-desp,">>>>>,>>>,>>9.99999")) + " ".
end. 

/* 
** Calcula a base e o valor do ICMS 
*/

IF l-calcula-icms-im7777 THEN
    RUN pi-calcula-icms.

if can-find (first tt-erro) then
    leave.
    
if not can-find (first tt-item-doc-est) then 
    leave.

/* 
** Arredondamento dos valores das despesas do item 
*/
run pi-arredondamento-itens.
        
/* 
** Arredondamento dos valores das despesas no documento 
*/
assign tt-docum-est.valor-seguro = de-tot-seguro + (de-tot-seguro-aux - de-tot-seguro)
       tt-docum-est.valor-embal  = de-tot-embal  + (de-tot-embal-aux  - de-tot-embal)
       tt-docum-est.valor-outras = de-tot-outras + (de-tot-outras-aux - de-tot-outras).

/*
** Verifica se ser  gerado duplicatas 
*/                                  
if natur-oper.emite-duplic then
    run pi-gera-duplicata.

/*
** Desconto informado no im0100
*/
RUN pi-set-desconto.
    
&if defined(bf-mat-comex) &then
&else
    if l-acomp then do:
       {utp/ut-liter.i Gerando_documento... * L}
       assign c-acomp = trim(return-value).
       run pi-acompanhar in h-acomp (input c-acomp).
    end.
&endif

/*
** Executa programa para a geracao do documento no recebimento
*/
&if defined(bf-mat-comex) &then    
    /*
    ** Magnus
    */
    run rep/re8888.p.
&else
    /*
    ** EMS
    */ 
    find first tt-versao-integr no-lock no-error.
        
    &if defined(bf_mat_versao_ems) &then
    
        if "{&bf_mat_versao_ems}":U >= "2.04":U then do:

            assign tt-versao-integr.cod-versao-integracao = 004.
            
            &if defined(bf_mat_unidade_negocio) &then
            
                find first param-mat no-lock no-error.
                if avail param-mat then
                    if param-mat.ind-unid-neg then
                        assign tt-docum-est.gera-unid-neg = 1.
                    else 
                        assign tt-docum-est.gera-unid-neg = 0.
                if tt-docum-est.gera-unid-neg = 1 then
                    run pi-gera-unid-negocio.

            &endif
            
            if  tt-nota.l-nf-simples-remessa 
            and tt-nota.idi-nf-simples-remes = 1 then do:  /** nf simples remessa e nf simples remessa mae **/ 
                for each  tt-item-doc-est
                    where tt-item-doc-est.serie-docto  = tt-docum-est.serie-docto
                    and   tt-item-doc-est.nro-docto    = tt-docum-est.nro-docto
                    and   tt-item-doc-est.cod-emitente = tt-docum-est.cod-emitente
                    and   tt-item-doc-est.nat-operacao = tt-docum-est.nat-operacao:
                    
                    if tt-nota.l-gera-prim-nf-remes-mae then do:
                       find first tt-itens
                            where tt-itens.numero-ordem = tt-item-doc-est.numero-ordem
                              and tt-itens.parcela      = tt-item-doc-est.parcela
                              and tt-itens.sequencia    = tt-itens.sequencia no-lock no-error.
                       if avail tt-itens then do:
                          if tt-itens.l-gera-prim-nf-remes-mae then
                             assign tt-item-doc-est.baixa-ce = yes.
                          else
                             assign tt-item-doc-est.baixa-ce = no.
                       end.
                    end.
                    else
                        assign tt-item-doc-est.baixa-ce = no.
                end.
            end.
            
            if valid-handle( h-reapi190b)  then do:
                IF CAN-FIND(FIRST tt-item-doc-est-aux) THEN
                    RUN setTT-item-doc-est-aux IN h-reapi190b (INPUT TABLE tt-item-doc-est-aux).
            
               &if "{&bf_mat_versao_ems}":U >= "2.062":U &then   
                    run pi-cria-tt-nova.    
                    run setNotaAjuste in h-reapi190b (input tt-nota.l-nf-ajuste,
                                                      input tt-nota.l-gera-prim-nf-remes-mae).
                    if tt-nota.l-gera-prim-nf-remes-mae then                                                       
                       run setGeraSimplesRemessaNFMae in h-reapi190b (input table tt-embarque-oc,
                                                                      input table tt-embarque-filho-aux).

                    run pi-execute2 in h-reapi190b (input  table tt-versao-integr,
                                                    input  table tt-docum-est-nova,
                                                    input  table tt-item-doc-est-nova,
                                                    input  table tt-dupli-apagar,
                                                    input  table tt-dupli-imp,
                                                    input  table tt-unid-neg-nota,
                                                    input  table tt-docto-estoq-nfe-imp,      
                                                    input  table tt-item-docto-estoq-nfe-imp,
                                                    output table tt-erro).
               &else
                   run pi-execute in h-reapi190b (input  table tt-versao-integr,
                                                   input  table tt-docum-est,
                                                   input  table tt-item-doc-est,
                                                   input  table tt-dupli-apagar,
                                                   input  table tt-dupli-imp,
                                                   input  table tt-unid-neg-nota,
                                                   input  table tt-docto-estoq-nfe-imp,      
                                                   input  table tt-item-docto-estoq-nfe-imp,
                                                   output table tt-erro).
               &endif
            end.
            &if defined(bf_mat_nf_simp_remes_desp_imp) &then
                run imp/im9049.p (input tt-docum-est.serie-docto,   
                                  input tt-docum-est.nro-docto,     
                                  input tt-docum-est.cod-emitente,  
                                  input tt-docum-est.nat-operacao,
                                  input tt-nota.l-nf-simples-remessa,
                                  input tt-nota.idi-nf-simples-remes). 

            &endif  
            
        end.

    &endif
    
    if tt-versao-integr.cod-versao-integracao = 3 then do:
    
       if valid-handle( h-reapi190b)  then do:
       
           IF CAN-FIND(FIRST tt-item-doc-est-aux) THEN
               RUN setTT-item-doc-est-aux IN h-reapi190b (INPUT TABLE tt-item-doc-est-aux).
       
          &if "{&bf_mat_versao_ems}":U >= "2.062":U &then   
              run pi-cria-tt-nova.
              run setNotaAjuste in h-reapi190b (input tt-nota.l-nf-ajuste,
                                                input tt-nota.l-gera-prim-nf-remes-mae).
              if tt-nota.l-gera-prim-nf-remes-mae then                                                       
                 run setGeraSimplesRemessaNFMae in h-reapi190b (input table tt-embarque-oc).                                                
              run pi-execute2 in h-reapi190b (input  table tt-versao-integr,
                                              input  table tt-docum-est-nova,
                                              input  table tt-item-doc-est-nova,
                                              input  table tt-dupli-apagar,
                                              input  table tt-dupli-imp,
                                              input  table tt-unid-neg-nota,
                                              input  table tt-docto-estoq-nfe-imp,      
                                              input  table tt-item-docto-estoq-nfe-imp,
                                              output table tt-erro).
          &else
              run pi-execute in h-reapi190b (input  table tt-versao-integr,
                                              input  table tt-docum-est,
                                              input  table tt-item-doc-est,
                                              input  table tt-dupli-apagar,
                                              input  table tt-dupli-imp,
                                              input  table tt-unid-neg-nota,
                                              input  table tt-docto-estoq-nfe-imp,      
                                              input  table tt-item-docto-estoq-nfe-imp,
                                              output table tt-erro).
          &endif
       end.
    end.
    
    FOR FIRST docum-est fields(serie-docto nro-docto cod-emitente pais
                               uf nat-operacao cod-estabel dt-emissao) exclusive-lock
        where docum-est.serie-docto  = tt-docum-est.serie-docto
          and docum-est.nro-docto    = tt-docum-est.nro-docto
          and docum-est.cod-emitente = tt-docum-est.cod-emitente
          and docum-est.nat-operacao = tt-docum-est.nat-operacao:
    
        for each item-doc-est
           where item-doc-est.serie-docto  = docum-est.serie-docto
             and item-doc-est.nro-docto    = docum-est.nro-docto
             and item-doc-est.cod-emitente = docum-est.cod-emitente
             and item-doc-est.nat-operacao = docum-est.nat-operacao exclusive-lock:
          
            
            FIND FIRST decla-import-adic-itens NO-LOCK
                 WHERE decla-import-adic-itens.cod-embarq  = tt-docum-est.embarque
                   AND decla-import-adic-itens.num-ordem   = item-doc-est.numero-ordem
                   AND decla-import-adic-itens.num-parcela = item-doc-est.parcela
                   AND decla-import-adic-itens.cod-estab   = tt-docum-est.cod-estabel
                 NO-ERROR.     

            ASSIGN d-perc-red-gov-cbs    = 0
                   d-perc-red-gov-ibsuf  = 0
                   d-perc-red-gov-ibsmun = 0.

            FIND FIRST tt-itens NO-LOCK
                 WHERE tt-itens.numero-ordem = item-doc-est.numero-ordem
                   AND tt-itens.parcela      = item-doc-est.parcela
                   AND tt-itens.sequencia    = item-doc-est.sequencia
                 NO-ERROR.
            IF AVAILABLE tt-itens THEN DO: 
                RUN pi-busca-perc-red-gov-item (
                    INPUT tt-docum-est.cod-estabel,
                    INPUT tt-docum-est.embarque,
                    INPUT item-doc-est.numero-ordem,
                    INPUT item-doc-est.parcela,
                    INPUT item-doc-est.it-codigo,
                    INPUT tt-itens.nat-fiscal,
                    INPUT item-doc-est.cod-emitente,
                    INPUT item-doc-est.class-fiscal,
                    INPUT embarque-imp.data-di,
                    OUTPUT d-perc-red-gov-cbs,
                    OUTPUT d-perc-red-gov-ibsuf,
                    OUTPUT d-perc-red-gov-ibsmun).  
            END.
            ELSE DO:                 
                RUN pi-busca-perc-red-gov-item (
                    INPUT tt-docum-est.cod-estabel,
                    INPUT tt-docum-est.embarque,
                    INPUT item-doc-est.numero-ordem,
                    INPUT item-doc-est.parcela,
                    INPUT item-doc-est.it-codigo,
                    INPUT item-doc-est.nat-operacao,
                    INPUT item-doc-est.cod-emitente,
                    INPUT item-doc-est.class-fiscal,
                    INPUT embarque-imp.data-di,
                    OUTPUT d-perc-red-gov-cbs,
                    OUTPUT d-perc-red-gov-ibsuf,
                    OUTPUT d-perc-red-gov-ibsmun).  
            END.
            
                RUN pi-grava-item-doc-est-tribut-gov (
                    BUFFER item-doc-est,
                    INPUT rep.imp.Imposto:CBS,
                    INPUT d-perc-red-gov-cbs).              
                RUN pi-grava-item-doc-est-tribut-gov (
                    BUFFER item-doc-est,
                    INPUT rep.imp.Imposto:IBS-UF,
                    INPUT d-perc-red-gov-ibsuf).           
                RUN pi-grava-item-doc-est-tribut-gov (
                    BUFFER item-doc-est,
                    INPUT rep.imp.Imposto:IBS-MUN,
                    INPUT d-perc-red-gov-ibsmun).  
                    
            IF SUBSTRING(item-doc-est.char-2,840,20) = "" THEN DO:
                
                IF NOT VALID-HANDLE( h-cdapi1001) THEN
                    RUN cdp/cdapi1001.p PERSISTENT SET h-cdapi1001.
                
                IF NOT AVAIL unid-feder THEN
                    FOR FIRST unid-feder NO-LOCK
                        WHERE unid-feder.pais   = docum-est.pais
                          AND unid-feder.estado = docum-est.uf:
                    END.
                
                EMPTY TEMP-TABLE tt-sit-tribut.
                
                RUN pi-seta-tributos IN h-cdapi1001 (input "11").
                RUN pi-retorna-sit-tribut IN h-cdapi1001 (INPUT  1, /* tipo-nota */
                                                          INPUT  docum-est.cod-estabel,
                                                          INPUT  item-doc-est.nat-operacao,
                                                          INPUT  item-doc-est.class-fiscal,
                                                          INPUT  item-doc-est.it-codigo,
                                                          INPUT  integer(unid-feder.cod-uf-ibge),
                                                          INPUT  docum-est.cod-emitente,
                                                          INPUT  docum-est.dt-emissao,
                                                          OUTPUT TABLE tt-sit-tribut).
                
                FOR FIRST tt-sit-tribut
                    WHERE tt-sit-tribut.cdn-tribut = 11:
                    IF  tt-sit-tribut.cdn-sit-tribut <> 0
                    AND tt-sit-tribut.seq-tab-comb   <> 0 THEN
                        overlay(item-doc-est.char-2,840,20) /** CEST **/ = STRING(tt-sit-tribut.cdn-sit-tribut,"9999999").
                    ELSE
                        overlay(item-doc-est.char-2,840,20) /** CEST **/ = "".            
                END.
            END.
        END. 
        RELEASE item-doc-est.
        
        if not valid-handle(h-reapi428) then do:
            RUN rep/reapi428.p PERSISTENT SET h-reapi428.
                
            RUN retornaMensagemNatur IN h-reapi428 (INPUT rowid(docum-est),
                                                    OUTPUT docum-est.obs-infcpl,
                                                    OUTPUT docum-est.obs-infadfisco).
        end.
    END.
    release docum-est.
    
    IF  VALID-HANDLE(h-reapi428) THEN DO:
        DELETE PROCEDURE h-reapi428 NO-ERROR.
        assign h-reapi428 = ?.
    END.

    IF  VALID-HANDLE(h-cdapi1001) THEN DO:
        DELETE PROCEDURE h-cdapi1001.
        ASSIGN h-cdapi1001 = ?.
    END.

    &if defined(bf_mat_versao_ems) &then
    
        if "{&bf_mat_versao_ems}" < "2.04" then do:

            /* Unidade de Neg¢cio */
            find first tt-erro no-error.
            if not avail tt-erro then
                run pi-gera-unid-negocio.

        end.

    &else
    
       /* Unidade de Neg¢cio */
       find first tt-erro no-error.
       if not avail tt-erro then
          run pi-gera-unid-negocio.

    &endif

&endif


/* Ajusta sequencia dos erros com origem na api */
for each tt-erro 
    where tt-erro.i-sequen = 0:
    if  i-seq-erro = 0 then
        assign i-seq-erro = 1.
    assign tt-erro.i-sequen = i-seq-erro
           i-seq-erro       = i-seq-erro + 1.
end.

/* Elimina as despesas do documento no Importacao quando houve problemas
na API e o documento nao foi criado no Recebimento */
if not can-find(docum-est 
                    where docum-est.serie-docto   = tt-docum-est.serie-docto
                      and docum-est.nro-docto     = tt-docum-est.nro-docto
                      and docum-est.cod-emitente  = tt-docum-est.cod-emitente
                      and docum-est.nat-operacao  = tt-docum-est.nat-operacao) then do:
    for each docum-est-cex
        where docum-est-cex.serie-docto   = tt-docum-est.serie-docto
        &if defined(bf-mat-comex) &then
          and docum-est-cex.nro-docto = string(tt-docum-est.nro-docto)
        &else
          and docum-est-cex.nro-docto = tt-docum-est.nro-docto
        &endif        
          and docum-est-cex.cod-emitente  = tt-docum-est.cod-emitente
          and docum-est-cex.nat-operacao  = tt-docum-est.nat-operacao exclusive-lock:
        for each item-doc-est-cex 
            where item-doc-est-cex.serie-docto       = docum-est-cex.serie-docto
              and item-doc-est-cex.nro-docto         = docum-est-cex.nro-docto
              and item-doc-est-cex.cod-emitente      = docum-est-cex.cod-emitente
              and item-doc-est-cex.nat-operacao      = docum-est-cex.nat-operacao
              and item-doc-est-cex.cod-emitente-desp = docum-est-cex.cod-emitente-desp
              and item-doc-est-cex.cod-desp          = docum-est-cex.cod-desp exclusive-lock:
            delete item-doc-est-cex.
        end.
        delete docum-est-cex.
    end.
    for each dupli-apagar-cex
        where dupli-apagar-cex.serie-docto  = tt-docum-est.serie-docto
        &if defined(bf-mat-comex) &then
          and dupli-apagar-cex.nro-docto    = string(tt-docum-est.nro-docto)
        &else
          and dupli-apagar-cex.nro-docto    = tt-docum-est.nro-docto
        &endif
          and dupli-apagar-cex.cod-emitente = tt-docum-est.cod-emitente
          and dupli-apagar-cex.nat-operacao = tt-docum-est.nat-operacao exclusive-lock:
        delete dupli-apagar-cex.          
    end.
end.

DEFINE BUFFER b-item-doc-est-tribut FOR item-doc-est-tribut.

/*Cria tt-retorno somente para retornar o numero do documento gerado no faturamento para a bocx220a*/
create tt-retorno.
assign tt-retorno.i-sequen = 1
       tt-retorno.cd-erro  = 17006
       tt-retorno.mensagem = tt-docum-est.nro-docto.

/****************************************** Procedures Internas **************************************************/


PROCEDURE pi-calcula-icms:

    {imp/im7777.i12}

END PROCEDURE.


procedure pi-consiste-numero:
    /*
    ** Consiste n£mero do documento de entrada
    */
    
    &if defined(bf-mat-comex) &then                  
        if serie.forma-emis = yes then do:
    &else
        if serie.forma-emis = 1   then do:
    &endif
            find ser-estab
                where ser-estab.serie       = tt-nota.serie-docto
                  and ser-estab.cod-estabel = tt-nota.cod-estabel no-lock no-error.        
            if not avail ser-estab then do:
                assign i-msg = 6514
                       c-msg = ""
                       c-char= "".
                run pi-gera-erro.
            end.
            else do:
                if  tt-nota.pais-impto-usuario = 1 then do:
                    
                    &if '{&bf_libera_15_posicoes}' = 'yes' &then
                        if length(string(dec(ser-estab.nr-ult-nota) + 1)) < 7 then
                            assign c-docto-aux = string(dec(ser-estab.nr-ult-nota) + 1,"9999999":U).
                        else
                            assign c-docto-aux = string(dec(ser-estab.nr-ult-nota) + 1).
                    &else
                        assign c-docto-aux = string(dec(ser-estab.nr-ult-nota) + 1,"9999999999":U).
                    &endif
                end.
                else 
                    assign c-docto-aux = string(dec(ser-estab.nr-ult-nota) + 1).                         
              
              
              if &if defined(bf-mat-comex) &then
                     tt-nota.nro-docto = "0"
                 &else
                     tt-nota.nro-docto = ""
                  OR DEC(tt-nota.nro-docto) = 0
                 &endif then do:
                 
                find docum-est             
                    where docum-est.serie-docto  = tt-nota.serie-docto 
                    &if defined(bf-mat-comex) &then                   
                      and docum-est.nro-docto    = c-docto-aux
                    &else
                      and docum-est.nro-docto    = c-docto-aux
                    &endif
                      and docum-est.cod-emitente = tt-nota.cod-emitente
                      and docum-est.nat-operacao = tt-nota.nat-operacao no-lock no-error.        
                if avail docum-est then do:
                    assign i-msg = 5569
                         &if defined(bf-mat-comex) &then                      
                           c-msg = string(c-docto-aux)
                         &else
                           c-msg = c-docto-aux                       
                         &endif
                           c-char= "".
                    run pi-gera-erro.
                end.
                else do:
                  &if defined(bf-mat-comex) &then                                  
                    assign tt-nota.nro-docto = c-docto-aux.    
                  &else
                    assign tt-nota.nro-docto = c-docto-aux.                     
                  &endif
                    run utp/ut-msgs.p (input "msg":U,
                                       input 52512, /*6511,*/
                                       input c-docto-aux).
                    create tt-retorno.
                    assign tt-retorno.i-sequen = 1
                           tt-retorno.cd-erro  = 52512 /*6511*/
                           tt-retorno.mensagem = return-value
                           &if '{&bf_mat_versao_ems}' >= '2.04' &then
                              tt-retorno.parametros = c-docto-aux /*utilizado para imprimir no relatorio de conferencia, nao retirar*/
                           &endif.            
                end.
              end. /*if nro-docto = ""*/
            end.
        end.
    
end procedure.

procedure pi-gera-docto:
    /* 
    ** Cabe‡alho para a API do Recebimento 
    */
    
    define variable c-ini-obs-nf               as character         no-undo.
    
    find embarque-imp where
         embarque-imp.cod-estabel = tt-nota.cod-estabel and
         embarque-imp.embarque    = tt-nota.embarque no-lock no-error.
    
    {utp/ut-liter.i Primeira_Remessa * r}
    assign c-lb-remes = trim(return-value).
    
    if LENGTH(embarque-imp.declaracao-import) < 15 then
        assign c-ini-obs-nf = "Conforme DI: ".
    else
        assign c-ini-obs-nf = "Conforme DUIMP: ".
    
    create tt-docum-est.
    assign tt-docum-est.cod-emitente   = tt-nota.cod-emitente
           tt-docum-est.uf             = emitente.estado
           tt-docum-est.nat-operacao   = tt-nota.nat-operacao       
           tt-docum-est.nro-docto      = tt-nota.nro-docto
           tt-docum-est.serie-docto    = tt-nota.serie-docto
           tt-docum-est.cod-estabel    = tt-nota.cod-estabel       
           tt-docum-est.dt-emissao     = tt-nota.dt-emissao
           tt-docum-est.dt-trans       = tt-nota.dt-trans
           tt-docum-est.dt-venc-icm    = tt-nota.dt-venc-icm       
           tt-docum-est.dt-venc-ipi    = tt-nota.dt-venc-ipi
           tt-docum-est.estab-fisc     = tt-nota.estab-fisc
           tt-docum-est.observacao     = c-ini-obs-nf    + embarque-imp.declaracao-import + 
                                         " Emitida em: " + string(embarque-imp.data-di) +
                                         " - Embarque: "   + tt-nota.embarque + 
                                         " - " + (if tt-nota.l-gera-prim-nf-remes-mae then (c-lb-remes + " - " + tt-nota.observ) else tt-nota.observ)
           tt-docum-est.usuario        = tt-nota.usuario           
         
           tt-docum-est.ct-transit     = tt-nota.ct-transit
           tt-docum-est.sc-transit     = tt-nota.sc-transit
           tt-docum-est.cod-tipo-ente-gov = tt-nota.cod-tipo-ente-gov
           tt-docum-est.cod-tipo-oper-gov = tt-nota.cod-tipo-oper-gov
           tt-docum-est.cod-observa    = 1 /* industria */
         
           tt-docum-est.embarque       = tt-nota.embarque
           tt-docum-est.nff            = no
           tt-docum-est.valor-embal    = 0
           tt-docum-est.pais-origem    = "RE1001":U
           tt-docum-est.efetua-calculo = 0
         &if defined(bf-mat-comex) &then
           tt-docum-est.esp-docto      = "NFE":U
         &else
           tt-docum-est.esp-docto      = 21
         &endif
           tt-docum-est.rec-fisico     = no
           tt-docum-est.origem         = "I":U
           tt-docum-est.via-transp     = tt-nota.via-transp           
         &if defined(bf-mat-comex) &then
           tt-docum-est.mod-frete      = yes.
         &else
           tt-docum-est.mod-frete      = 1
           tt-docum-est.cotacao-dia    = tt-nota.cotacao-dia.
         &endif
           tt-docum-est.tot-desconto   = tt-nota.tot-desconto. /*desconto informado no im0100*/

    /* 
    ** Cabecalho utilizado para calculos de impostos no Recebimento 
    */       
    create tt-docto.  
  &if defined(bf-mat-comex) &then           
    assign tt-docto.ind-tip-nota = "R":U
           tt-docto.cod-portador = emitente.portador   
           tt-docto.modalidade   = emitente.modalidade. 
  &else
    run pi-busca-portador-modalidade (buffer emitente,
                                      output i-portador-emit,
                                      output i-modalidade-emit).

    assign tt-docto.seq-tt-docto    = 1
           tt-docto.dt-trans        = tt-docum-est.dt-trans
           tt-docto.ind-tip-nota    = 8
           tt-docto.cod-portador    = i-portador-emit
           tt-docto.modalidade      = i-modalidade-emit.
  &endif
  
    assign tt-docto.cod-estabel     = tt-docum-est.cod-estabel
           tt-docto.serie           = tt-docum-est.serie-docto
           tt-docto.nr-nota         = tt-docum-est.nro-docto
           tt-docto.cod-emitente    = tt-docum-est.cod-emitente
           tt-docto.nat-operacao    = tt-docum-est.nat-operacao  
           tt-docto.dt-emis-nota    = tt-docum-est.dt-trans
           tt-docto.nome-abrev      = emitente.nome-abrev
           tt-docto.usuario         = tt-docum-est.usuario  
           tt-docto.inc-seq         = param-re.inc-seq
           tt-docto.seq-item-um     = param-re.seq-item-um
           tt-docto.estado          = estabelec.estado
           tt-docto.cidade          = estabelec.cidade
           tt-docto.pais            = estabelec.pais                                                                   
           tt-docto.cod-des-merc    = if natur-oper.consum-final then 2 /* Consumo */
                                                                 else 1 /* Industralizacao */
           tt-docto.esp-docto       = tt-docum-est.esp-docto
           tt-docto.cod-msg         = natur-oper.cod-mensagem
           tt-docto.ind-lib-nota    = yes
           tt-docto.perc-desco1     = if tt-docum-est.tot-desconto <> 0 then 1
                                                                        else 0.
    return "OK":U.    
end procedure.

procedure pi-gera-tt-despesas:
    /* 
    ** Criacao das temp-tables com as despesas e os valores calculados para rateio 
    */    
    def var h-im0091 as handle no-undo.
    
    /* Rateio das despesas informadas para o embarque */
    run imp/im0091.p persistent set h-im0091.
    run setaValorDescICMS in h-im0091 (input table tt-desconto-icms).
    run setaValorinicial in h-im0091 (input tt-nota.da-cotacao,
                                      input tt-nota.cod-estabel).
    if tt-nota.d-cotacao <> 0 then                                  
        run setaValorCotacao in h-im0091 (input tt-nota.d-cotacao).                                  
        
    RUN setNotaAjuste    IN h-im0091 (INPUT tt-nota.l-nf-ajuste,
                                      input tt-nota.l-gera-prim-nf-remes-mae).
    RUN setTTitens       IN h-im0091 (INPUT TABLE tt-itens).
    
    if tt-nota.l-gera-prim-nf-remes-mae then
       run setTTembarquesFilhos in h-im0091 (input table tt-embarque-filho-aux).
       
    run rateioEmbarque   in h-im0091 (input tt-nota.cod-estabel,
                                      input tt-nota.embarque,
                                      input tt-nota.nat-operacao,
                                      output table tt-desp-rateio).
                                      
    /*nova procedure*/                                      
    run geradiferencavalores in h-im0091 (output table tt-itens-rateio).
    
    run getTTdesp-totais   in h-im0091 (output table tt-desp-totais).
    run getTTordens-totais in h-im0091 (output table tt-ordens-totais).
    run getTTbo-erro       in h-im0091 (output table tt-bo-erro).
    delete procedure h-im0091.
    
    for each tt-bo-erro:
        assign i-msg = tt-bo-erro.cd-erro
               c-msg = tt-bo-erro.parametros
               c-char= "".
        run pi-gera-erro.     
    end.
    
end procedure.

procedure pi-skip-lote:
    /* 
    ** Atualiza o campo cod-depos se o item for controlado por CQ
    */
    def var l-sugere-cq as log no-undo.
    def var i-indice-cq   like param-estoq.ins-pref-x extent 0 no-undo.
    DEF VAR i-ind         AS INT NO-UNDO.
    def var l-leitura-item-fornec-estab as log no-undo. 
    DEF VAR i-tp-skip-lote-aux AS INT NO-UNDO.   
    

    assign l-sugere-cq = yes.
  &if defined(bf-mat-comex) &then
    if param-cq.tipo-cq = 2 then do: /* CQ Total */
  &else
    if param-cq.tipo-cq = 3 then do: /* CQ Total */
  &endif    
          
        ASSIGN l-leitura-item-fornec-estab = NO.

        &if "{&bf_mat_versao_ems}" >= "2.04" &then
            IF CAN-FIND(FIRST funcao
                        WHERE funcao.cd-funcao = "spp-cq-itfornest"
                        AND   funcao.ativo     = YES NO-LOCK) THEN DO:
                ASSIGN l-leitura-item-fornec-estab = YES.
            END.
            &if "{&bf_mat_versao_ems}" >= "2.062" &then
                ASSIGN l-leitura-item-fornec-estab = YES.
            &ENDIF

            IF l-leitura-item-fornec-estab THEN DO:                    
                find first item-fornec-estab 
                     where item-fornec-estab.it-codigo    = tt-item-doc-est.it-codigo 
                       and item-fornec-estab.cod-emitente = tt-item-doc-est.cod-emitente 
                       and item-fornec-estab.cod-estabel  = tt-nota.cod-estabel exclusive-lock no-error.
                if avail item-fornec-estab then do:
                    if  item-fornec-estab.tp-inspecao > 3 then do:
			ASSIGN i-ind = item-fornec-estab.tp-inspecao - 3.		
			&if '{&bf_lote_avancado_liberado}' = 'yes' &then
			    IF CAN-FIND(FIRST funcao 
			       	    WHERE funcao.cd-funcao = "lote-avancado" 
			                  AND funcao.ativo     = true NO-LOCK) THEN DO:
			       FIND fda-param-inspec-fornec WHERE fda-param-inspec-fornec.cdn-emit = tt-item-doc-est.cod-emitente NO-LOCK NO-ERROR.	
			       IF AVAIL fda-param-inspec-fornec THEN DO:
			       	CASE item.criticidade:
			       	&IF DEFINED(bf-mat-comex) &THEN
                                         WHEN "X" THEN do:
                                             CASE i-ind:
                                                 WHEN 1 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-x-1.
                                                 WHEN 2 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-x-2.
                                                 WHEN 3 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-x-3.
                                             END CASE.
                                             
                                         END.
                			 WHEN "Y" THEN do:
                                             CASE i-ind:
                                                 WHEN 1 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-y-1.
                                                 WHEN 2 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-y-2.
                                                 WHEN 3 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-y-3.
                                             END CASE.
                                         end. 
                			 WHEN "Z" THEN DO:
                                             CASE i-ind:
                                                 WHEN 1 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-z-1.
                                                 WHEN 2 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-z-2.
                                                 WHEN 3 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-z-3.
                                             END CASE.
                                         END.
			       	&ELSE
			       		 WHEN 1 THEN do:
                                             CASE i-ind:
                                                 WHEN 1 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-x-1.
                                                 WHEN 2 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-x-2.
                                                 WHEN 3 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-x-3.
                                             END CASE.
                                             
                                         END.
                			 WHEN 2 THEN do:
                                             CASE i-ind:
                                                 WHEN 1 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-y-1.
                                                 WHEN 2 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-y-2.
                                                 WHEN 3 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-y-3.
                                             END CASE.
                                         end. 
                			 WHEN 3 THEN DO:
                                             CASE i-ind:
                                                 WHEN 1 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-z-1.
                                                 WHEN 2 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-z-2.
                                                 WHEN 3 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-z-3.
                                             END CASE.
                                         END.
			       	&ENDIF
			       	END CASE.
			       	ASSIGN i-tp-skip-lote-aux = fda-param-inspec-fornec.idi-tip-skip-lote.
			       END.
			       ELSE DO:
			       	FIND emitente WHERE emitente.cod-emitente = tt-item-doc-est.cod-emitente NO-LOCK NO-ERROR.
			       	FIND fda-param-inspec WHERE fda-param-inspec.cdn-grp-emit = emitente.cod-gr-forn NO-LOCK NO-ERROR.
			       	IF AVAIL fda-param-inspec THEN DO:
			       		CASE item.criticidade:
			       		&IF DEFINED(bf-mat-comex) &THEN
			       			WHEN "X" THEN do:
                                                    CASE i-ind:
                                                        WHEN 1 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-x-1.
                                                        WHEN 2 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-x-2.
                                                        WHEN 3 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-x-3.
                                                    END CASE.
                                                END.
                    			        WHEN "Y" THEN do:
                                                    CASE i-ind:
                                                        WHEN 1 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-y-1.
                                                        WHEN 2 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-y-2.
                                                        WHEN 3 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-y-3.
                                                    END CASE.
                                                end. 
                    			        WHEN "Z" THEN DO:
                                                    CASE i-ind:
                                                        WHEN 1 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-z-1.
                                                        WHEN 2 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-z-2.
                                                        WHEN 3 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-z-3.
                                                    END CASE.
                                                END.
			       		&ELSE
			       			WHEN 1 THEN do:
                                                    CASE i-ind:
                                                        WHEN 1 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-x-1.
                                                        WHEN 2 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-x-2.
                                                        WHEN 3 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-x-3.
                                                    END CASE.
                                                END.
                    				WHEN 2 THEN do:
                                                    CASE i-ind:
                                                        WHEN 1 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-y-1.
                                                        WHEN 2 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-y-2.
                                                        WHEN 3 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-y-3.
                                                    END CASE.
                                                end. 
                    				WHEN 3 THEN DO:
                                                    CASE i-ind:
                                                        WHEN 1 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-z-1.
                                                        WHEN 2 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-z-2.
                                                        WHEN 3 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-z-3.
                                                    END CASE.
                                                END.
			       		&ENDIF
			       		END CASE.
			       		ASSIGN i-tp-skip-lote-aux = fda-param-inspec.idi-tip-skip-lote.
			       	END.
			       	ELSE DO:
			       		CASE item.criticidade:
			       		&IF DEFINED(bf-mat-comex) &THEN
			       			WHEN "X":U THEN assign i-indice-cq = param-cq.ins-pref-x[item-fornec-estab.tp-inspecao - 3].
			       			WHEN "Y":U THEN assign i-indice-cq = param-cq.ins-pref-y[item-fornec-estab.tp-inspecao - 3].
			       			WHEN "Z":U THEN assign i-indice-cq = param-cq.ins-pref-z[item-fornec-estab.tp-inspecao - 3].
			       		&ELSE
			       			WHEN 1 THEN assign i-indice-cq = param-cq.ins-pref-x[item-fornec-estab.tp-inspecao - 3].
			       			WHEN 2 THEN assign i-indice-cq = param-cq.ins-pref-y[item-fornec-estab.tp-inspecao - 3].
			       			WHEN 3 THEN assign i-indice-cq = param-cq.ins-pref-z[item-fornec-estab.tp-inspecao - 3].
			       		&ENDIF
			       		END CASE.
			       		ASSIGN i-tp-skip-lote-aux = param-cq.tp-skip-lot.
			       	END.
			       END.
			    END.
			    ELSE DO:
			    	CASE item.criticidade:
			    	&IF DEFINED(bf-mat-comex) &THEN
			    		WHEN "X":U THEN assign i-indice-cq = param-cq.ins-pref-x[item-fornec-estab.tp-inspecao - 3].
			    		WHEN "Y":U THEN assign i-indice-cq = param-cq.ins-pref-y[item-fornec-estab.tp-inspecao - 3].
			    		WHEN "Z":U THEN assign i-indice-cq = param-cq.ins-pref-z[item-fornec-estab.tp-inspecao - 3].
			    	&ELSE
			    		WHEN 1 THEN assign i-indice-cq = param-cq.ins-pref-x[item-fornec-estab.tp-inspecao - 3].
			    		WHEN 2 THEN assign i-indice-cq = param-cq.ins-pref-y[item-fornec-estab.tp-inspecao - 3].
			    		WHEN 3 THEN assign i-indice-cq = param-cq.ins-pref-z[item-fornec-estab.tp-inspecao - 3].
			    	&ENDIF
			    	END CASE.
			    	ASSIGN i-tp-skip-lote-aux = param-cq.tp-skip-lot.
			    END.
			&ELSE
				CASE item.criticidade:
				&IF DEFINED(bf-mat-comex) &THEN
					WHEN "X":U THEN assign i-indice-cq = param-cq.ins-pref-x[item-fornec-estab.tp-inspecao - 3].
					WHEN "Y":U THEN assign i-indice-cq = param-cq.ins-pref-y[item-fornec-estab.tp-inspecao - 3].
					WHEN "Z":U THEN assign i-indice-cq = param-cq.ins-pref-z[item-fornec-estab.tp-inspecao - 3].
				&ELSE
					WHEN 1 THEN assign i-indice-cq = param-cq.ins-pref-x[item-fornec-estab.tp-inspecao - 3].
					WHEN 2 THEN assign i-indice-cq = param-cq.ins-pref-y[item-fornec-estab.tp-inspecao - 3].
					WHEN 3 THEN assign i-indice-cq = param-cq.ins-pref-z[item-fornec-estab.tp-inspecao - 3].
				&ENDIF
				END CASE.
				ASSIGN i-tp-skip-lote-aux = param-cq.tp-skip-lot.
			&ENDIF
					
	                &if defined(bf-mat-comex) &then
	                    if  param-cq.log-1 = no then
	                &else
	                    if  i-tp-skip-lote-aux = 1 then
	                &endif
	                        assign l-sugere-cq = ( random(0,100) <= i-indice-cq ).
	                    else do:
	                         assign l-sugere-cq = no.
	                         if  i-indice-cq <= item-fornec-estab.niv-inspecao 
	                         then 
	                             assign l-sugere-cq = yes
	                                    item-fornec-estab.niv-inspecao = 0.
	                    end.
	                    if  l-sugere-cq = no then 
	                        assign item-fornec-estab.niv-inspecao =
	                               item-fornec-estab.niv-inspecao + 1.
                    end.
                    else assign l-sugere-cq = yes.
                end.          
                ELSE 
                    ASSIGN l-leitura-item-fornec-estab = NO.
            END.
            release item-fornec-estab no-error.
        &ENDIF
        
        IF NOT l-leitura-item-fornec-estab THEN DO:
            find item-fornec 
                 where item-fornec.it-codigo = tt-item-doc-est.it-codigo 
                   and item-fornec.cod-emite = tt-item-doc-est.cod-emitente exclusive-lock no-error.
            if  avail item-fornec then do:
                if  item-fornec.tp-inspecao > 3 then do:
                    ASSIGN i-ind = item-fornec.tp-inspecao - 3.
		    &if '{&bf_lote_avancado_liberado}' = 'yes' &then
		    	IF CAN-FIND(FIRST funcao 
		    	        WHERE funcao.cd-funcao = "lote-avancado" 
		    	          AND funcao.ativo     = true NO-LOCK) THEN DO:
		    	    FIND fda-param-inspec-fornec WHERE fda-param-inspec-fornec.cdn-emit = tt-item-doc-est.cod-emitente NO-LOCK NO-ERROR .			
		    	    IF AVAIL fda-param-inspec-fornec THEN DO:
		    	    	CASE item.criticidade:
		    	    	     WHEN 1 THEN do:
                                         CASE i-ind:
                                             WHEN 1 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-x-1.
                                             WHEN 2 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-x-2.
                                             WHEN 3 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-x-3.
                                         END CASE.
                                         
                                     END.
                                     WHEN 2 THEN do:
                                         CASE i-ind:
                                             WHEN 1 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-y-1.
                                             WHEN 2 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-y-2.
                                             WHEN 3 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-y-3.
                                         END CASE.
                                     end. 
                                     WHEN 3 THEN DO:
                                         CASE i-ind:
                                             WHEN 1 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-z-1.
                                             WHEN 2 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-z-2.
                                             WHEN 3 THEN assign i-indice-cq = fda-param-inspec-fornec.cdn-inspec-preferen-z-3.
                                         END CASE.
                                     END.
		    	    	END CASE.
		    	    	ASSIGN i-tp-skip-lote-aux = fda-param-inspec.idi-tip-skip-lote.
		    	    END.
		    	    ELSE DO:
		    	    	FIND emitente WHERE emitente.cod-emitente = tt-item-doc-est.cod-emitente NO-LOCK NO-ERROR.
		    	    	FIND fda-param-inspec WHERE fda-param-inspec.cdn-grp-emit = emitente.cod-gr-forn NO-LOCK NO-ERROR.
		    	    	IF AVAIL fda-param-inspec THEN DO:
		    	    		CASE item.criticidade:
		    	    		     WHEN 1 THEN do:
                                                 CASE i-ind:
                                                     WHEN 1 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-x-1.
                                                     WHEN 2 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-x-2.
                                                     WHEN 3 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-x-3.
                                                 END CASE.
                                                 
                                             END.
                                             WHEN 2 THEN do:
                                                 CASE i-ind:
                                                     WHEN 1 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-y-1.
                                                     WHEN 2 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-y-2.
                                                     WHEN 3 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-y-3.
                                                 END CASE.
                                             end. 
                                             WHEN 3 THEN DO:
                                                 CASE i-ind:
                                                     WHEN 1 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-z-1.
                                                     WHEN 2 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-z-2.
                                                     WHEN 3 THEN assign i-indice-cq = fda-param-inspec.cdn-inspec-preferen-z-3.
                                                 END CASE.
                                             END.
		    	    		END CASE.
		    	    		ASSIGN i-tp-skip-lote-aux = fda-param-inspec.idi-tip-skip-lote.
		    	    	END.
		    	    	ELSE DO:
		    	    		CASE item.criticidade:
		    	    			WHEN 1 THEN assign i-indice-cq = param-cq.ins-pref-x[item-fornec.tp-inspecao - 3].
		    	    			WHEN 2 THEN assign i-indice-cq = param-cq.ins-pref-y[item-fornec.tp-inspecao - 3].
		    	    			WHEN 3 THEN assign i-indice-cq = param-cq.ins-pref-z[item-fornec.tp-inspecao - 3].
		    	    		END CASE.
		    	    		ASSIGN i-tp-skip-lote-aux = param-cq.tp-skip-lot.
		    	    	END.
		    	    END.
		    	END.
		    	ELSE DO:
		    		CASE item.criticidade:
		    			WHEN 1 THEN assign i-indice-cq = param-cq.ins-pref-x[item-fornec.tp-inspecao - 3].
		    			WHEN 2 THEN assign i-indice-cq = param-cq.ins-pref-y[item-fornec.tp-inspecao - 3].
		    			WHEN 3 THEN assign i-indice-cq = param-cq.ins-pref-z[item-fornec.tp-inspecao - 3].
		    		END CASE.
		    		ASSIGN i-tp-skip-lote-aux = param-cq.tp-skip-lot.
		    	END.
		    &ELSE
		    	CASE item.criticidade:
		    		WHEN 1 THEN assign i-indice-cq = param-cq.ins-pref-x[item-fornec.tp-inspecao - 3].
		    		WHEN 2 THEN assign i-indice-cq = param-cq.ins-pref-y[item-fornec.tp-inspecao - 3].
		    		WHEN 3 THEN assign i-indice-cq = param-cq.ins-pref-z[item-fornec.tp-inspecao - 3].
		    	END CASE.
		    	ASSIGN i-tp-skip-lote-aux = param-cq.tp-skip-lot.
		    &ENDIF
                    
                    &if defined(bf-mat-comex) &then
                        if  param-cq.log-1 = no then
                    &else
                        if  i-tp-skip-lote-aux = 1 then
                    &endif
                            assign l-sugere-cq = ( random(0,100) <= i-indice-cq ).
                        else do:
                             assign l-sugere-cq = no.
                             if  i-indice-cq <= item-fornec.niv-inspecao 
                             then 
                                 assign l-sugere-cq = yes
                                        item-fornec.niv-inspecao = 0.
                        end.
                        if  l-sugere-cq = no then 
                            assign item-fornec.niv-inspecao =
                                   item-fornec.niv-inspecao + 1.
                end.
                else assign l-sugere-cq = yes.
            end.
            release item-fornec no-error.
        END.
    end.
    
    if  l-sugere-cq then do:
        assign c-cod-depos-cq = estabelec.deposito-cq.

        FIND CURRENT param-imp NO-LOCK NO-ERROR.
        if substring(param-imp.char-1,166,1) <> "S":U then do:
                &if defined(bf-mat-comex) &then        
                   if item.loc-unica = no then
                        assign tt-item-doc-est.localizacao = "".
                &else 
                   if  l-loc-unica = no then
                       assign tt-item-doc-est.cod-localiz = "".
                &endif
        end.
        &if '{&bf_lote_avancado_liberado}' = 'yes' &then
            IF not CAN-FIND (FIRST funcao WHERE funcao.cd-funcao = "LOTE-AVANCADO"
                                        AND funcao.ativo = YES) THEN
               assign tt-item-doc-est.cod-depos = c-cod-depos-cq.
        &else
            assign tt-item-doc-est.cod-depos = c-cod-depos-cq.
        &endif
    end.

end procedure.

procedure pi-cod-trib-icm:
    /* 
    ** Determina Codigo Tributacao ICMS 
    */
    def var c-trib-icm  like item-doc-est.cd-trib-icm  no-undo.
    def var de-aliq-icm like item-doc-est.aliquota-icm no-undo.
    def var c-estado    like estabelec.estado no-undo.

    /*
    ** Verifica se foi informada aliquota/tributacao na ordens-embarque
    */
    IF NOT tt-itens.l-ordens-embarque THEN DO:
    
        run cdp/cd4302.p ( item.cd-trib-icm,
                           b-natur-oper-fiscal.cd-trib-icm,
                           output c-trib-icm).
        
        /* 
        ** Determina Aliquota ICMS 
        */
        if l-fornec-fundap then
            assign c-estado = emitente.estado.
        else
            assign c-estado = estabelec.estado.
            
        &if defined(bf-mat-comex) &then               
            run cdp/cd4301.p ( (if  avail b-emit-estab then
                                    b-emit-estab.contrib-icms
                                else
                                    yes),
                               (if  avail b-emit-estab then
                                    b-emit-estab.natureza
                                else "J":U),
                                c-estado /*estabelec.estado*/ ,
                                estabelec.pais,
                                estabelec.estado,
                                tt-item-doc-est.it-codigo,
                                b-natur-oper-fiscal.aliquota-icm,
                                output de-aliq-icm ).
        &else
            run cdp/cd4301.p ( (if  avail b-emit-estab then
                                    b-emit-estab.contrib-icms
                                else
                                    yes),
                               (if  avail b-emit-estab then
                                    b-emit-estab.natureza
                                else 2 /*"J"*/),
                                c-estado /*estabelec.estado*/,
                                estabelec.pais,
                                estabelec.estado,
                                tt-item-doc-est.it-codigo,
                                b-natur-oper-fiscal.aliquota-icm,
                                output de-aliq-icm ).      
        &endif
                            
        assign tt-item-doc-est.cd-trib-icm  = c-trib-icm
               tt-item-doc-est.aliquota-icm = de-aliq-icm.
    

    END.
    ELSE DO:

        &IF DEFINED(bf-mat-comex) &THEN
            CASE tt-itens.cd-trib-icms:
                WHEN 1 THEN ASSIGN tt-item-doc-est.cd-trib-icm = "T".
                WHEN 2 THEN ASSIGN tt-item-doc-est.cd-trib-icm = "I".
                WHEN 3 THEN ASSIGN tt-item-doc-est.cd-trib-icm = "O".
                WHEN 4 THEN ASSIGN tt-item-doc-est.cd-trib-icm = "R".
                WHEN 5 THEN ASSIGN tt-item-doc-est.cd-trib-icm = "D".
            END CASE.
        &ELSE 
            ASSIGN tt-item-doc-est.cd-trib-icm  = tt-itens.cd-trib-icms.
        &ENDIF
        
        ASSIGN tt-item-doc-est.aliquota-icm = tt-itens.aliquota-icm.

    END.
           
    /*
    ** Verifica parÆmtro "Al¡quota 0 - ICMS Diferido 
    */
    if tt-nota.l-icms-diferido then
        assign tt-item-doc-est.aliquota-icm = 0.
end procedure.

procedure pi-cod-trib-ipi:
    /* 
    ** Determina Codigo Tributacao IPI 
    */
    def var c-trib-ipi  like item-doc-est.cd-trib-ipi  no-undo.
    def var de-aliq-ipi like item-doc-est.aliquota-ipi no-undo.

    /*
    ** Verifica se foi informada aliquota/tributacao na ordens-embarque
    */
    IF NOT tt-itens.l-ordens-embarque THEN DO:
    
        run cdp/cd4303.p ( item.cd-trib-ipi,
                           b-natur-oper-fiscal.cd-trib-ipi,
                           output c-trib-ipi ).
    
        /* Determina Aliquota IPI */   
        
        &if defined(bf-mat-comex) &then               
            if  param-re.orig-aliq-ip then do:
                find classif-fisc
                    where classif-fisc.class-fiscal = tt-itens.class-fiscal no-lock no-error.
                if avail classif-fisc then                                 
                    assign de-aliq-ipi = classif-fisc.aliquota-ipi.
            end.
            else
                assign de-aliq-ipi = item.aliquota-ipi.
        &else
            if  param-re.orig-aliq-ip = 1 then do:
                find classif-fisc
                    where classif-fisc.class-fiscal = tt-itens.class-fiscal no-lock no-error.
                if avail classif-fisc then
                    assign de-aliq-ipi = classif-fisc.aliquota-ipi.
            end.
            else
                assign de-aliq-ipi = item.aliquota-ipi.
        &endif
        
        assign tt-item-doc-est.cd-trib-ipi  = c-trib-ipi
               tt-item-doc-est.aliquota-ipi = de-aliq-ipi.
               
        /*
        ** Testa se foi informado regime de importa‡Æo na cota‡Æo da compra
        */
        if tt-itens.l-regime then do:
            assign tt-item-doc-est.aliquota-ipi = tt-itens.aliquota-ipi.
        end.

    END.
    ELSE DO:

        &IF DEFINED(bf-mat-comex) &THEN
            CASE tt-itens.cd-trib-ipi:
                WHEN 1 THEN ASSIGN tt-item-doc-est.cd-trib-ipi = "T".
                WHEN 2 THEN ASSIGN tt-item-doc-est.cd-trib-ipi = "I".
                WHEN 3 THEN ASSIGN tt-item-doc-est.cd-trib-ipi = "O".
                WHEN 4 THEN ASSIGN tt-item-doc-est.cd-trib-ipi = "R".
            END CASE.
        &ELSE 
            ASSIGN tt-item-doc-est.cd-trib-ipi  = tt-itens.cd-trib-ipi.
        &ENDIF

        ASSIGN tt-item-doc-est.aliquota-ipi = tt-itens.aliquota-ipi.

    END.

    /******************************************************
    * Engenharia IPI Suspensao Incorporar Base PIS COFINS *
    ******************************************************/
    &IF DEFINED(bf-mat-comex) &THEN
    &ELSE
        IF  tt-itens.suspensao-IPI THEN
            ASSIGN tt-item-doc-est.aliquota-ipi = 0.
    &ENDIF
    
end procedure.

procedure pi-despesas:
    /*
    ** Calcula despesas para os itens da nota
    */
    def var de-tot-despesa-aux like desp-embarque.val-desp  no-undo.
    def var de-tot-frete-aux   like desp-embarque.val-desp  no-undo.
    def var de-val-desp-inc    like desp-embarque.val-desp  no-undo.
    def var de-val-desp-fre    like desp-embarque.val-desp  no-undo.
    def var de-val-desp-rateio like desp-embarque.val-desp  no-undo.
    def var de-val-desp-rateio-dif like desp-embarque.val-desp  no-undo.
    def var de-val-maior           like prazo-compra.quantidade no-undo.
    def var i-numero-ordem         like prazo-compra.numero-ordem no-undo.
    def var i-parcela              like prazo-compra.parcela      no-undo.
    def var i-seq                  as int no-undo.
    def var i-cod-desp             like desp-embarque.cod-desp no-undo.
    
    for each tt-desp-rateio
        where tt-desp-rateio.numero-ordem = tt-item-doc-est.numero-ordem
          and tt-desp-rateio.parcela      = tt-item-doc-est.parcela
          break by cod-desp:
                
        find first tt-desp-totais
            where tt-desp-totais.cod-desp = tt-desp-rateio.cod-desp no-error.
            
        find tt-ordens-totais
            where tt-ordens-totais.numero-ordem = tt-item-doc-est.numero-ordem
              and tt-ordens-totais.parcela      = tt-item-doc-est.parcela no-error.
               
        
        if l-first-numero-ordem then do:
                for each   tt-itens-rateio where
                           tt-itens-rateio.numero-ordem = tt-desp-rateio.numero-ordem and
                           tt-itens-rateio.parcela      = tt-desp-rateio.parcela      and
                           /*tt-itens-rateio.seq          = tt-itens.seq          and*/
                           tt-itens-rateio.cod-desp     = tt-desp-rateio.cod-desp     no-lock:
                         
                          assign de-val-desp-rateio = de-val-desp-rateio + tt-itens-rateio.val-desp.
                end.
                
                if de-val-desp-rateio <> tt-desp-rateio.val-desp then do:
                
                        assign de-val-desp-rateio-dif = if (de-val-desp-rateio - tt-desp-rateio.val-desp) < 0 then
                                                        (de-val-desp-rateio - tt-desp-rateio.val-desp) * (-1) 
                                                        else (de-val-desp-rateio - tt-desp-rateio.val-desp).
                                                        
                        for each tt-itens-rateio  where
                                 tt-itens-rateio.numero-ordem = tt-desp-rateio.numero-ordem and      
                                 tt-itens-rateio.parcela      = tt-desp-rateio.parcela      and     
                                 /*tt-itens-rateio.seq        = tt-itens.seq                and*/       
                                 tt-itens-rateio.cod-desp     = tt-desp-rateio.cod-desp     no-lock:
                                 
                                 if tt-itens-rateio.quantidade > de-val-maior then
                                    assign i-numero-ordem = tt-itens-rateio.numero-ordem
                                           i-parcela      = tt-itens-rateio.parcela
                                           i-seq          = tt-itens-rateio.seq
                                           i-cod-desp     = tt-itens-rateio.cod-desp
                                           de-val-maior   = tt-itens-rateio.quantidade.
        
                        end.         
                        
                        find first tt-itens-rateio where                                                               
                                   tt-itens-rateio.numero-ordem = i-numero-ordem and      
                                   tt-itens-rateio.parcela      = i-parcela      and      
                                   tt-itens-rateio.seq          = i-seq                and
                                   tt-itens-rateio.cod-desp     = i-cod-desp     no-lock no-error. 
                        
                        assign tt-itens-rateio.val-desp = tt-itens-rateio.val-desp - de-val-desp-rateio-dif.
                        
                end.                 
        end.
        
        find first tt-itens-rateio where                                          
                   tt-itens-rateio.numero-ordem = tt-desp-rateio.numero-ordem and 
                   tt-itens-rateio.parcela      = tt-desp-rateio.parcela      and              
                   tt-itens-rateio.seq          = tt-itens.seq                and                
                   tt-itens-rateio.cod-desp     = tt-desp-rateio.cod-desp     no-lock no-error.
        
        assign de-val-desp-rateio = 0
               i-numero-ordem    = 0
               i-parcela         = 0
               i-seq             = 0
               i-cod-desp        = 0
               de-val-maior      = 0
               de-val-desp-rateio-dif = 0.
               
        find docum-est-cex
            where docum-est-cex.serie-docto       = tt-docum-est.serie-docto
            &if defined(bf-mat-comex) &then
              and docum-est-cex.nro-docto         = string(tt-docum-est.nro-docto)
            &else
              and docum-est-cex.nro-docto         = tt-docum-est.nro-docto
            &endif
              and docum-est-cex.cod-emitente      = tt-docum-est.cod-emitente
              and docum-est-cex.nat-operacao      = tt-docum-est.nat-operacao
              and docum-est-cex.cod-emitente-desp = tt-desp-totais.cod-emitente-desp
              and docum-est-cex.cod-desp          = tt-desp-rateio.cod-desp exclusive-lock no-error.              
        if not avail docum-est-cex then do:            
            create docum-est-cex.
            assign docum-est-cex.serie-docto       = tt-docum-est.serie-docto
                 &if defined(bf-mat-comex) &then           
                   docum-est-cex.nro-docto         = string(tt-docum-est.nro-docto)
                 &else
                   docum-est-cex.nro-docto         = tt-docum-est.nro-docto          
                 &endif
                   docum-est-cex.cod-emitente      = tt-docum-est.cod-emitente
                   docum-est-cex.nat-operacao      = tt-docum-est.nat-operacao
                   docum-est-cex.cod-emitente-desp = tt-desp-totais.cod-emitente-desp
                   docum-est-cex.cod-desp          = tt-desp-rateio.cod-desp
                   docum-est-cex.mo-codigo         = 0
                   docum-est-cex.cod-cond-pag      = tt-desp-totais.cod-cond-pag
                   docum-est-cex.cotacao           = 1.        
        end.            
            assign docum-est-cex.val-desp          = docum-est-cex.val-desp 
                                                   + tt-itens-rateio.val-desp /*round((tt-item-doc-est.quantidade 
                                                   * tt-desp-rateio.val-desp)
                                                   / tt-ordens-totais.quantidade,2)*/ .
            
        create item-doc-est-cex.
        assign item-doc-est-cex.serie-docto       = tt-docum-est.serie-docto
             &if defined(bf-mat-comex) &then
               item-doc-est-cex.nro-docto         = string(tt-docum-est.nro-docto)
             &else
               item-doc-est-cex.nro-docto         = tt-docum-est.nro-docto
             &endif
               item-doc-est-cex.cod-emitente      = tt-docum-est.cod-emitente
               item-doc-est-cex.nat-operacao      = tt-docum-est.nat-operacao
               item-doc-est-cex.sequencia         = tt-item-doc-est.sequencia
               item-doc-est-cex.cod-emitente-desp = tt-desp-totais.cod-emitente-desp
               item-doc-est-cex.cod-desp          = tt-desp-rateio.cod-desp
               item-doc-est-cex.mo-codigo         = 0
               item-doc-est-cex.cotacao           = 1
               item-doc-est-cex.val-desp          = tt-itens-rateio.val-desp /*(tt-item-doc-est.quantidade 
                                                  * tt-desp-rateio.val-desp)
                                                  / tt-ordens-totais.quantidade,2)*/ .

        
        
        run pi-rateio-item-desp (input tt-desp-rateio.cod-desp,
                                 input item-doc-est-cex.val-desp,
                                 output de-val-desp-inc,
                                 output de-val-desp-fre).

        FIND CURRENT param-imp NO-LOCK NO-ERROR.
             {cdp/cd4300.i4 "yes" param-imp.char-1}
	     {cxbo/bocx250.i51 "yes"}
             
        if item-doc-est-cex.cod-desp <> i-desp-ii-i50 then 
           assign de-tot-desp-adu =  de-tot-desp-adu + item-doc-est-cex.val-desp.
        else 
           assign de-tot-desp-II  = de-tot-desp-II + item-doc-est-cex.val-desp.
           
        assign de-tot-despesa-aux = de-tot-despesa-aux + de-val-desp-inc
               de-tot-frete-aux   = de-tot-frete-aux   + de-val-desp-fre.
    end.    
    assign de-tot-resto       = de-tot-resto       + (de-tot-despesa-aux - tt-item-doc-est.despesas)
           de-tot-resto-frete = de-tot-resto-frete + (de-tot-frete-aux   - tt-item-doc-est.vl-frete-cons).
end procedure.

procedure pi-rateio-item-desp:
    /*
    ** Rateia o valor da despesa para o item do documento
    */
    def input  parameter p-cod-desp     like desp-imp.cod-desp      no-undo.
    def input  parameter p-val-desp     like desp-embarque.val-desp no-undo.
    def output parameter p-val-desp-inc like desp-embarque.val-desp no-undo.
    def output parameter p-val-desp-fre like desp-embarque.val-desp no-undo.
    
    find desp-imp
        where desp-imp.cod-desp = p-cod-desp no-lock no-error.
    if avail desp-imp then do:
        if desp-imp.inc-val-frete or
           desp-imp.inc-val-seguro or 
           desp-imp.inc-val-embal or
           desp-imp.inc-val-outras-desp then do:
            assign tt-item-doc-est.despesas = tt-item-doc-est.despesas + p-val-desp
                   p-val-desp-inc           = p-val-desp.
            if desp-imp.inc-val-frete then
                assign tt-item-doc-est.vl-frete-cons = tt-item-doc-est.vl-frete-cons + p-val-desp
                       de-frete                      = de-frete                      + p-val-desp
                       p-val-desp-fre                = p-val-desp.
            if desp-imp.inc-val-seguro then
                assign de-seguro         = de-seguro         + p-val-desp
                       de-tot-seguro-aux = de-tot-seguro-aux + p-val-desp.
            if desp-imp.inc-val-embal then
                assign de-embal          = de-embal         + p-val-desp
                       de-tot-embal-aux  = de-tot-embal-aux + p-val-desp.
            if desp-imp.inc-val-outras-desp then
                assign de-outras         = de-outras         + p-val-desp
                       de-tot-outras-aux = de-tot-outras-aux + p-val-desp.
        end.
        if desp-imp.inc-base-ipi then
            assign de-base-ipi    = de-base-ipi + p-val-desp.
        if desp-imp.inc-base-icms then
            assign de-base-icm    = de-base-icm + p-val-desp.
        /* base ii */    
        IF  desp-imp.log-2 THEN 
            assign de-base-ii     = de-base-ii  + p-val-desp.
            
        if SUBSTR(desp-imp.char-1,30,1) = '1' then      /* Reduz base IPI */
            assign de-base-ipi    = de-base-ipi - p-val-desp.
            
        if de-base-ipi < 0 then do:
            assign i-msg       = 57608
                   c-msg       = "IPI~~" + string(de-base-ipi)
                   c-char      = ""
                   de-base-ipi = 0.
            run pi-gera-erro.
        end.
            
        IF SUBSTR(desp-imp.char-1,31,1) = '1' THEN      /* Reduz base II  */
            assign de-base-ii     = de-base-ii  - p-val-desp.
            
        if de-base-ii < 0 then do:
            assign i-msg       = 57608
                   c-msg       = "II~~" + string(de-base-ii)
                   c-char      = ""
                   de-base-ii = 0.
            run pi-gera-erro.
        end.

     end.
end procedure.

procedure pi-gera-tt-it-docto.
    /*
    ** Temp-table para c lculo do imposto 
    */

    create tt-it-docto.
  &if defined(bf-mat-comex) &then               
    assign tt-it-docto.ct-codigo = tt-item-doc-est.ct-codigo    
           tt-it-docto.sc-codigo = tt-item-doc-est.sc-codigo.           
  &else   
    assign tt-it-docto.seq-tt-it-docto = i-seq-aux
           tt-it-docto.ct-codigo  = tt-item-doc-est.ct-codigo.        
    &endif    
    assign tt-it-docto.cod-emitente    = tt-docum-est.cod-emitente           
           tt-it-docto.nr-nota         = tt-docum-est.nro-docto
           tt-it-docto.serie           = tt-docum-est.serie
           tt-it-docto.cod-estabel     = tt-docum-est.cod-estabel
           tt-it-docto.nat-operacao    = tt-docum-est.nat-operacao
           tt-it-docto.calcula         = yes
           i-seq-aux                   = i-seq-aux + 1   
           tt-it-docto.nr-sequencia    = tt-item-doc-est.sequencia
           tt-it-docto.quantidade      = tt-item-doc-est.quantidade
           tt-it-docto.vl-frete        = tt-item-doc-est.vl-frete-cons            
           tt-it-docto.vl-despes-it    = tt-item-doc-est.despesas
           tt-it-docto.vl-embalagem    = de-embal
           tt-it-docto.calcula         = yes                      
           tt-it-docto.it-codigo       = tt-item-doc-est.it-codigo
           tt-it-docto.nro-comp        = tt-item-doc-est.nro-comp
           tt-it-docto.serie-comp      = tt-item-doc-est.serie-comp
           tt-it-docto.nat-comp        = tt-item-doc-est.nat-comp
           tt-it-docto.seq-comp        = tt-item-doc-est.seq-comp
           tt-it-docto.class-fiscal    = tt-item-doc-est.class-fiscal
           tt-it-docto.data-comp       = tt-item-doc-est.data-comp
           tt-it-docto.nr-ord-prod     = tt-item-doc-est.nr-ord-prod
           tt-it-docto.numero-ordem    = tt-item-doc-est.numero-ordem
           tt-it-docto.parcela         = tt-item-doc-est.parcela
           tt-it-docto.cod-refer       = tt-item-doc-est.cod-refer
           tt-it-docto.encerra-pa      = tt-item-doc-est.encerra-pa 
           &if defined(bf-mat-comex) &then           
               tt-it-docto.narrativa[1] = tt-item-doc-est.narrativa[1]
           &else
               tt-it-docto.item-pai    = tt-item-doc-est.item-pai           
               tt-it-docto.cod-roteiro = tt-item-doc-est.cod-roteiro
               tt-it-docto.op-codigo   = tt-item-doc-est.op-codigo
               tt-it-docto.narrativa   = tt-item-doc-est.narrativa               
           &endif    
           tt-it-docto.desconto        = tt-item-doc-est.desconto
           tt-it-docto.per-des-item    = int(tt-item-doc-est.desconto > 0)
           tt-it-docto.vl-preuni       = tt-itens.preco-unit - tt-item-doc-est.desconto
           tt-it-docto.vl-preori       = tt-itens.preco-unit             
           tt-it-docto.vl-merc-liq     = tt-itens.preco-total - tt-item-doc-est.desconto
           tt-it-docto.vl-merc-ori     = tt-itens.preco-total
           tt-it-docto.vl-seguro       = de-seguro
           tt-it-docto.nat-of          = tt-docum-est.nat-operacao.
           
    /* 
    ** Char-1 utilizado apenas para que a integracao c/ importacao seja feita apenas
    ** quando no momento da geracao do documento atraves do programa 
    ** IM7777 - Desembarque/Geracao de Documentos
    */
    assign tt-it-docto.char-1          = "im7777":U.
           
    /*
    ** Tratamento Fundap
    */
    if l-fornec-fundap then do:
        create tt-it-docto-aux.
        buffer-copy tt-it-docto to tt-it-docto-aux.
    end.
           
    /*
    ** Tratamento nota Simples Remessa Mae com Primeira Remessa
    */
    

    
    if can-find (FIRST funcao WHERE funcao.cd-funcao = "USA-MULT-NAT-RECEB" 
                and funcao.ativo = yes) then do:
                
        assign tt-it-docto.nat-of          = tt-itens.nat-fiscal.
        
     end.
     
    
                
   
    if tt-nota.l-gera-prim-nf-remes-mae then do:
        find first tt-it-docto-remes-com-mae
             where tt-it-docto-remes-com-mae.numero-ordem = tt-it-docto.numero-ordem 
               and tt-it-docto-remes-com-mae.it-codigo    = tt-it-docto.it-codigo       exclusive-lock no-error.
        
        if not avail tt-it-docto-remes-com-mae then do:
            create tt-it-docto-remes-com-mae.
            buffer-copy tt-it-docto to tt-it-docto-remes-com-mae.
        end.
        else do: /* Acumula totais dos mesmos itens (quer foram quebrados) para calcular impostos de forma totalizada */
            assign tt-it-docto-remes-com-mae.vl-merc-liq   = tt-it-docto-remes-com-mae.vl-merc-liq   + tt-it-docto.vl-merc-liq
                   tt-it-docto-remes-com-mae.vl-merc-ori   = tt-it-docto-remes-com-mae.vl-merc-ori   + tt-it-docto.vl-merc-ori
                   tt-it-docto-remes-com-mae.vl-seguro     = tt-it-docto-remes-com-mae.vl-seguro     + tt-it-docto.vl-seguro
                   tt-it-docto-remes-com-mae.vl-embalagem  = tt-it-docto-remes-com-mae.vl-embalagem  + tt-it-docto.vl-embalagem
                   tt-it-docto-remes-com-mae.vl-frete      = tt-it-docto-remes-com-mae.vl-frete      + tt-it-docto.vl-frete
                   tt-it-docto-remes-com-mae.quantidade[1] = tt-it-docto-remes-com-mae.quantidade[1] + tt-it-docto.quantidade[1]
                   tt-it-docto-remes-com-mae.quantidade[2] = tt-it-docto-remes-com-mae.quantidade[2] + tt-it-docto.quantidade[2]
                   tt-it-docto-remes-com-mae.vl-despes-it  = tt-it-docto-remes-com-mae.vl-despes-it  + tt-it-docto.vl-despes-it
                   tt-it-docto-remes-com-mae.vl-preori     = tt-it-docto-remes-com-mae.vl-preori     + tt-it-docto.vl-preori
                   tt-it-docto-remes-com-mae.vl-preuni     = tt-it-docto-remes-com-mae.vl-preuni     + tt-it-docto.vl-preuni.
        end.
    end.
           
end procedure.

procedure pi-gera-tt-it-imposto:
    /*
    ** Temp-table para c lculo dos impostos
    */
    
    create tt-it-imposto.
    assign tt-it-imposto.seq-tt-it-docto = tt-it-docto.seq-tt-it-docto
           tt-it-imposto.ind-icm-ret     = IF b-natur-oper-fiscal.subs-trib and not b-natur-oper-fiscal.log-icms-substto-antecip THEN yes else no
           tt-it-imposto.cd-trib-icm     = tt-item-doc-est.cd-trib-icm
           tt-it-imposto.cd-trib-ipi     = tt-item-doc-est.cd-trib-ipi
           tt-it-imposto.aliquota-icm    = tt-item-doc-est.aliquota-icm
           tt-it-imposto.aliquota-ipi    = tt-item-doc-est.aliquota-ipi
           tt-it-imposto.perc-red-ipi    = b-natur-oper-fiscal.perc-red-ipi
           tt-it-imposto.perc-red-icm    = b-natur-oper-fiscal.perc-red-icm
           tt-it-imposto.vl-bipi-it      = de-base-ipi
           tt-it-imposto.vl-bicms-it     = de-base-icm.           
           
    /*
    ** Tratamento Fundap
    */
    if l-fornec-fundap then do:
        create tt-it-imposto-aux.
        buffer-copy tt-it-imposto to tt-it-imposto-aux.
    end.
           
    /*
    ** Tratamento nota Simples Remessa Mae com Primeira Remessa
    */
    if tt-nota.l-gera-prim-nf-remes-mae then do:
        find first tt-it-imposto-remes-com-mae
             where tt-it-imposto-remes-com-mae.seq-tt-it-docto = tt-it-docto-remes-com-mae.seq-tt-it-docto exclusive-lock no-error.
        if not avail tt-it-imposto-remes-com-mae then do:
            create tt-it-imposto-remes-com-mae.
            buffer-copy tt-it-imposto to tt-it-imposto-remes-com-mae.
        end.
        else /* Acumula totais dos mesmos itens (quer foram quebrados) para calcular impostos de forma totalizada */
            assign tt-it-imposto-remes-com-mae.vl-bipi-it      = tt-it-imposto-remes-com-mae.vl-bipi-it  + de-base-ipi
                   tt-it-imposto-remes-com-mae.vl-bicms-it     = tt-it-imposto-remes-com-mae.vl-bicms-it + de-base-icm.
    end.
           
end procedure.

procedure pi-arredondamento-itens:
/*
** Arredonda o valor das despesas dos itens para que o valor da despesa na nota fique correto
*/
def var i-maior-sequencia as   integer                  no-undo.
def var de-val-despesas   like tt-item-doc-est.despesas no-undo.

assign de-val-despesas = 0.
for each tt-item-doc-est:
    if de-val-despesas < tt-item-doc-est.despesas then
        assign de-val-despesas   = tt-item-doc-est.despesas
               i-maior-sequencia = tt-item-doc-est.sequencia.
end.

find tt-item-doc-est 
    where tt-item-doc-est.sequencia = i-maior-sequencia no-error.
if avail tt-item-doc-est then do:
    assign tt-item-doc-est.despesas      = tt-item-doc-est.despesas       + de-tot-resto 
           tt-item-doc-est.vl-frete-cons = tt-item-doc-est.vl-frete-cons  + de-tot-resto-frete.
end.               

end procedure.

procedure pi-gera-duplicata:
    /* 
    ** Gera duplicatas para o material 
    */
    
    def var de-tot-vl-docto         like dupli-apagar-cex.vl-a-pagar no-undo.
    def var de-tot-vl-docto-mo      like dupli-apagar-cex.vl-a-pagar no-undo.
    
    def var de-tot-vl-docto-aux     like dupli-apagar-cex.vl-a-pagar no-undo.
    def var de-tot-vl-docto-mo-aux  like dupli-apagar-cex.vl-a-pagar no-undo.
    def var r-cotacao-item          as rowid                         no-undo.
    
    def var de-total-dup      like dupli-apagar.vl-a-pagar no-undo.
    def var de-total-dup-mo   like dupli-apagar.vl-a-pagar no-undo.
    def var de-dup-tot        like dupli-apagar.vl-a-pagar no-undo.
    def var de-dup-tot-mo     like dupli-apagar.vl-a-pagar no-undo.    
    def var de-dup-tot-aux    like dupli-apagar.vl-a-pagar no-undo.
    def var de-dup-tot-mo-aux like dupli-apagar.vl-a-pagar no-undo.    
    def var de-vl-docto       like dupli-apagar.vl-a-pagar no-undo.
    def var de-vl-docto-mo    like dupli-apagar.vl-a-pagar no-undo.    
    def var da-data           as date                      no-undo extent 12.
    def var da-partida        as date                      no-undo.    

    &IF "{&bf_mat_versao_ems}" >= "2.062" &THEN
    DEF VAR i-cod-emitente-desp-ant LIKE emitente.cod-emitente NO-UNDO.
    DEF VAR da-dt-vencto-ant        AS   DATE                  NO-UNDO INIT ?.
    &ENDIF

    &if defined(bf-mat-comex) &then
    &else
        if l-acomp then do:
           {utp/ut-liter.i Gerando_duplicatas... * L}
           assign c-acomp = trim(return-value).
           run pi-acompanhar in h-acomp (input c-acomp).
        end.
    &endif
    
    for each tt-dupli:
        delete tt-dupli.
    end.
    
    for each tt-dupli-apagar:
        delete tt-dupli-apagar.
    end.

    FIND CURRENT param-imp NO-LOCK NO-ERROR.

	{cdp/cd4300.i4 "yes" param-imp.char-1}
	{cxbo/bocx250.i51 "yes"}
        
    find historico-embarque 
        where historico-embarque.cod-estabel   = tt-docum-est.cod-estabel
          and historico-embarque.embarque      = tt-docum-est.embarque
          and historico-embarque.cod-itiner    = tt-nota.cod-itiner
          and historico-embarque.cod-pto-contr = tt-nota.cod-pto-contr-base
          no-lock no-error.
          
    if avail embarque-imp and i-natureza-camb <> 2 then do:
        for each tt-item-doc-est
            where tt-item-doc-est.serie-docto  = tt-docum-est.serie-docto
              and tt-item-doc-est.nro-docto    = tt-docum-est.nro-docto
              and tt-item-doc-est.cod-emitente = tt-docum-est.cod-emitente
              and tt-item-doc-est.nat-operacao = tt-docum-est.nat-operacao:                    
              
            find tt-itens
                where tt-itens.numero-ordem = tt-item-doc-est.numero-ordem
                  and tt-itens.parcela      = tt-item-doc-est.parcela
                  and tt-itens.sequencia    = tt-item-doc-est.sequencia no-error.
                  
            assign de-vl-docto        = tt-itens.preco-total
                                      - tt-item-doc-est.desconto.
            &if defined(bf-mat-comex) &then
                    /* especifico FUNDAP ************************************************/
                    IF l-fornec-fundap THEN DO:
                        FIND tt-itens-ext
                            WHERE tt-itens-ext.numero-ordem = tt-itens.numero-ordem
                              AND tt-itens-ext.parcela      = tt-itens.parcela
                              AND tt-itens-ext.seq          = tt-itens.seq no-error.
                        ASSIGN de-vl-docto    = tt-itens-ext.preco-total-orig
                                              - tt-item-doc-est.desconto.
                    END.
                    /********************************************************************/
            &endif
            assign de-tot-vl-docto    = de-tot-vl-docto
                                      + de-vl-docto
                   de-vl-docto-mo     = 0
                   de-tot-vl-docto-mo = de-tot-vl-docto-mo 
                                      + tt-itens.preco-total-mo.
                                      
            find cond-pagto
                where cond-pagto.cod-cond-pag = tt-nota.cod-cond-pag no-lock no-error.
            if not avail cond-pagto then do:
            
                find cond-especif
                    where cond-especif.num-pedido = tt-itens.num-pedido no-lock no-error.
                if not avail cond-especif then 
                    next.
                else do:
                    do  i-ind = 1 to 6:
                        if  cond-especif.data-pagto[i-ind] <> ? then do:                        
                            create tt-dupli.
                            assign tt-dupli.dt-vencim    = cond-especif.data-pagto[i-ind]
                                   tt-dupli.tp-despesa   = emitente.tp-desp-padrao
                                   tt-dupli.vl-apagar    = de-vl-docto 
                                                         * cond-especif.perc-pagto[i-ind]
                                                         / 100
                                   &if '{&bf_mat_versao_ems}' >= '2.04' &then
                                         tt-dupli.mo-codigo    = tt-nota.mo-codigo
                                   &endif
                                   tt-dupli.vl-apagar-mo = tt-itens.preco-total-mo
                                                         * cond-especif.perc-pagto[i-ind]
                                                         / 100.
                        end.
                    end.
                end.
            end.
            else do:
       
                assign da-data = today.
                
                if not avail historico-embarque then
                    assign da-partida = tt-docum-est.dt-emissao.
                else
                    assign da-partida = if historico-embarque.dt-efetiva <> ? then historico-embarque.dt-efetiva
                                        else tt-docum-est.dt-emissao.
       
                {cdp/cd9020.i7 tt-docum-est.cod-estabel a} /* calculo data de vencimento */
                
                do  i-ind = 1 to cond-pagto.num-parcelas:
                
                    if da-data[i-ind] < today then 
                        assign da-data[i-ind] = tt-docum-est.dt-emissao.
                        
                    create tt-dupli.
                    assign tt-dupli.dt-vencim    = da-data[i-ind]
                           tt-dupli.tp-despesa   = tt-itens.tp-despesa
                           tt-dupli.vl-apagar    = de-vl-docto 
                                                 * cond-pagto.per-pg-dup[i-ind] / 100
                           &if '{&bf_mat_versao_ems}' >= '2.04' &then                    
                              tt-dupli.mo-codigo    = tt-nota.mo-codigo
                           &endif
                           tt-dupli.vl-apagar-mo = tt-itens.preco-total-mo
                                                 * cond-pagto.per-pg-dup[i-ind]
                                                 / 100.
                end.            
            end.
        end.
       
        if tt-nota.l-nf-ajuste then do:
           run imp/im9057.p (input tt-docum-est.cod-estabel, 
                             input tt-docum-est.cod-emitente,   
                             input param-imp.esp-tit-rec,      
                             input tt-docum-est.serie-docto,
                             input tt-docum-est.embarque,
                             output i-parcela-reajuste).
        end.
        
        if  (tt-nota.l-nf-simples-remessa and tt-nota.idi-nf-simples-remes = 2)
        or (not tt-nota.l-nf-simples-remessa and tt-nota.idi-nf-simples-remes = 1 and tt-nota.l-nf-ajuste) then do:
            for each embarq-import-docto 
               WHERE embarq-import-docto.cod-embarq = tt-docum-est.embarque
                 and embarq-import-docto.cod-estab  = tt-docum-est.cod-estabel no-lock:
            
               for each dupli-apagar fields(parcela) no-lock
                   where dupli-apagar.nro-docto    = embarq-import-docto.cod-docto 
                     and dupli-apagar.serie-docto  = embarq-import-docto.cod-ser-docto
                     and dupli-apagar.cod-emitente = embarq-import-docto.cdn-emitente 
                     and dupli-apagar.nat-operacao = embarq-import-docto.cod-natur-operac: 
                    if int(dupli-apagar.parcela) > i-parcela then
                        assign i-parcela = int(dupli-apagar.parcela).
               end. 
             
               for each dupli-apagar-cex fields(parcela) no-lock
                   where dupli-apagar-cex.nro-docto    = embarq-import-docto.cod-docto 
                     and dupli-apagar-cex.serie-docto  = embarq-import-docto.cod-ser-docto
                     and dupli-apagar-cex.cod-emitente = embarq-import-docto.cdn-emitente 
                     and dupli-apagar-cex.nat-operacao = embarq-import-docto.cod-natur-operac:             
                    if int(dupli-apagar-cex.parcela) > i-parcela then
                       assign i-parcela = int(dupli-apagar-cex.parcela).
               end.   
               
               for each rat-docum fields(serie-docto nro-docto cod-emitente nat-operacao)
                   where rat-docum.nf-serie    = embarq-import-docto.cod-ser-docto
                     and rat-docum.nf-nro      = embarq-import-docto.cod-docto
                     and rat-docum.nf-emitente = embarq-import-docto.cdn-emitente
                     and rat-docum.nf-nat-oper = embarq-import-docto.cod-natur-operac no-lock use-index nf-docto:
                   for each dupli-apagar fields(parcela) no-lock
                       where dupli-apagar.nro-docto    = rat-docum.nro-docto 
                         and dupli-apagar.serie-docto  = rat-docum.serie-docto
                         and dupli-apagar.cod-emitente = rat-docum.cod-emitente 
                         and dupli-apagar.nat-operacao = rat-docum.nat-operacao:              
                        if int(dupli-apagar.parcela) > i-parcela then
                           assign i-parcela = int(dupli-apagar.parcela).
                   end.      
               
                   for each dupli-apagar-cex  fields(parcela) no-lock
                       where dupli-apagar-cex.nro-docto    = rat-docum.nro-docto 
                         and dupli-apagar-cex.serie-docto  = rat-docum.serie-docto
                         and dupli-apagar-cex.cod-emitente = rat-docum.cod-emitente 
                         and dupli-apagar-cex.nat-operacao = rat-docum.nat-operacao :
                        if int(dupli-apagar-cex.parcela) > i-parcela then
                           assign i-parcela = int(dupli-apagar-cex.parcela).         
                   end.    
               end.
            end.
        end.
        
	if i-parcela > i-parcela-reajuste then
	   assign i-parcela-reajuste = i-parcela.

        for each tt-dupli 
            break &if '{&bf_mat_versao_ems}' >= '2.04' &then
                     by tt-dupli.mo-codigo
                  &endif   
                  by tt-dupli.dt-vencim:
        
            if  first-of(tt-dupli.dt-vencim) then do:
                assign de-total-dup    = 0
                       de-total-dup-mo = 0
                       i-parcela       = i-parcela + 1.
            end.
       
            assign de-total-dup    = de-total-dup    + tt-dupli.vl-apagar
                   de-total-dup-mo = de-total-dup-mo + tt-dupli.vl-apagar-mo.
       
            if  &if '{&bf_mat_versao_ems}' >= '2.04' &then
                   last-of(tt-dupli.mo-codigo) or
                &endif   
                last-of(tt-dupli.dt-vencim) then do:
                create tt-dupli-apagar.
                assign tt-dupli-apagar.cod-emitente  = tt-docum-est.cod-emitente
                       tt-dupli-apagar.dt-vencim     = tt-dupli.dt-vencim
                       tt-dupli-apagar.nat-operacao  = tt-docum-est.nat-operacao
                       tt-dupli-apagar.nro-docto     = tt-docum-est.nro-docto
                       tt-dupli-apagar.parcela       = string(i-parcela, "99")
                       tt-dupli-apagar.serie-docto   = tt-docum-est.serie-docto
                       tt-dupli-apagar.nr-duplic     = tt-docum-est.nro-docto
                       tt-dupli-apagar.tp-despesa    = tt-dupli.tp-despesa
                       tt-dupli-apagar.cod-esp       = param-imp.esp-tit-rec
                       tt-dupli-apagar.vl-a-pagar    = de-total-dup
                       tt-dupli-apagar.vl-a-pagar-mo = de-total-dup-mo
                       tt-dupli-apagar.mo-codigo     = tt-nota.mo-codigo.
                       
                assign i-moeda-material = tt-dupli-apagar.mo-codigo.
                       
            end.
            
        end.    
        
        /* Ajuste das diferen‡as do total das duplicatas com o valor do material */
        assign de-dup-tot    = 0
               de-dup-tot-mo = 0.
        for each tt-dupli-apagar:
            assign de-dup-tot    = de-dup-tot
                                 + tt-dupli-apagar.vl-a-pagar 
                   de-dup-tot-mo = de-dup-tot-mo 
                                 + tt-dupli-apagar.vl-a-pagar-mo.
        end.
        
        if  de-tot-vl-docto <> de-dup-tot then do:
            find last tt-dupli-apagar no-error.
            assign tt-dupli-apagar.vl-a-pagar = tt-dupli-apagar.vl-a-pagar
                                              + (de-tot-vl-docto - de-dup-tot).
        end.
        
        if de-tot-vl-docto-mo <> de-dup-tot-mo then do:
            find last tt-dupli-apagar no-error.
            assign tt-dupli-apagar.vl-a-pagar-mo = tt-dupli-apagar.vl-a-pagar-mo
                                                  + ( de-tot-vl-docto-mo - de-dup-tot-mo ).
        end.
    
    end. /* end if avail embarque-imp and i-natureza-camb <> 2 */

    {imp/im7777.i3 "tt-item-doc-est" "dupli-apagar-cex"} /* Duplicatas das despesas */
    
    &if '{&bf_mat_versao_ems}' >= '2.04' &then
       if tt-nota.l-nf-ajuste then 
          assign i-cont = i-parcela-reajuste.
       else   
          assign i-cont = 0.
       for each tt-dupli-apagar no-lock
                break by tt-dupli-apagar.dt-vencim:
                assign i-cont = i-cont + 1.
                assign tt-dupli-apagar.parcela = string(i-cont, "99").                
       end.
    &endif
       
end procedure.

PROCEDURE pi-gera-unid-negocio:
    /* 
    ** Gera Unidade de Neg¢cio
    */
    
  &if defined(bf_mat_unidade_negocio) &then
  
    find first param-mat no-lock no-error.
    if not avail param-mat then
        leave.
    else
        if not param-mat.ind-unid-neg then
            leave.  
  
    &if defined(bf_mat_versao_ems) &then
        if "{&bf_mat_versao_ems}" >= "2.04" then do:
            
            assign tt-versao-integr.cod-versao-integracao = 004.
            
            if avail param-mat then
                if param-mat.ind-unid-neg then
                    assign tt-docum-est.gera-unid-neg = 1.
                else
                    assign tt-docum-est.gera-unid-neg = 0.
                    
            for each tt-item-doc-est:
                for each unid-neg-ordem
                    where unid-neg-ordem.numero-ordem = tt-item-doc-est.numero-ordem no-lock:
                    create tt-unid-neg-nota.
                    assign tt-unid-neg-nota.registro       = 5
                           tt-unid-neg-nota.cod-emitente   = tt-item-doc-est.cod-emitente
                           tt-unid-neg-nota.serie-docto    = tt-item-doc-est.serie-docto
                           tt-unid-neg-nota.nro-docto      = tt-item-doc-est.nro-docto
                           tt-unid-neg-nota.nat-operacao   = tt-item-doc-est.nat-operacao
                           tt-unid-neg-nota.sequencia      = tt-item-doc-est.sequencia
                           tt-unid-neg-nota.cod_unid_negoc = unid-neg-ordem.cod_unid_negoc
                           tt-unid-neg-nota.perc-unid-neg  = unid-neg-ordem.perc-unid-neg.
                end.
            end.
                        
            leave.
            
        end.
    &endif
    
    def var l-erro-conexao as logical no-undo.    
            
    assign l-conecta-emsbas = no
           l-conecta-emsuni = no.
                 
    run pi-conecta-ems5 ( 1, output l-erro-conexao ).
    
    if not l-erro-conexao then
        for each tt-item-doc-est:
            find item-doc-est
                where item-doc-est.serie-docto  = tt-item-doc-est.serie-docto
                  and item-doc-est.nro-docto    = tt-item-doc-est.nro-docto
                  and item-doc-est.cod-emitente = tt-item-doc-est.cod-emitente
                  and item-doc-est.nat-operacao = tt-item-doc-est.nat-operacao
                  and item-doc-est.sequencia    = tt-item-doc-est.sequencia 
                  no-lock no-error.
            if avail item-doc-est then
                 run cdp/cd9760.p ( input 3,   /* Item-doc-est */
                                    input item-doc-est.it-codigo,
                                    input rowid(item-doc-est) ).
        end.
        
    run pi-conecta-ems5 ( 2, output l-erro-conexao).        
    
  &endif
  

END PROCEDURE.
procedure pi-gera-docto-estoq-nfe-imp:

        
    find first embarque-imp
         where embarque-imp.cod-estabel = tt-nota.cod-estabel 
         and   embarque-imp.embarque    = tt-nota.embarque no-lock no-error.
         
    create tt-docto-estoq-nfe-imp.
    assign tt-docto-estoq-nfe-imp.cdn-emitente               = tt-docum-est.cod-emitente 
           tt-docto-estoq-nfe-imp.cod-docto                  = tt-docum-est.nro-docto    
           tt-docto-estoq-nfe-imp.cod-natur-operac           = tt-docum-est.nat-operacao 
           tt-docto-estoq-nfe-imp.cod-ser-docto              = tt-docum-est.serie-docto  
           tt-docto-estoq-nfe-imp.cod-estab                  = tt-docum-est.cod-estabel
           tt-docto-estoq-nfe-imp.des-decla-import           = embarque-imp.declaracao-import
           tt-docto-estoq-nfe-imp.dat-decla-import           = embarque-imp.data-di
           tt-docto-estoq-nfe-imp.cdn-expdor                 = tt-docum-est.cod-emitente 
           overlay(tt-docto-estoq-nfe-imp.cod-livre-1,41,1)  = IF SUBSTRING(embarque-imp.char-1,91,1) = "" THEN "0" ELSE SUBSTRING(embarque-imp.char-1,91,1)
           overlay(tt-docto-estoq-nfe-imp.cod-livre-1,23,2)  = "1".

    FIND FIRST itinerario 
         WHERE itinerario.cod-itiner =  tt-nota.cod-itiner NO-LOCK NO-ERROR.
    IF AVAIL itinerario THEN DO:
    
       FIND FIRST historico-embarque 
            WHERE historico-embarque.cod-estabel   = tt-docum-est.cod-estabel
            AND   historico-embarque.embarque      = tt-docum-est.embarque
            AND   historico-embarque.cod-itiner    = itinerario.cod-itiner
            AND   historico-embarque.cod-pto-contr = embarque-imp.cdn-pto-desembar NO-LOCK NO-ERROR.          
       IF AVAIL historico-embarque THEN
          ASSIGN tt-docto-estoq-nfe-imp.dat-desembarac    =  historico-embarque.dt-efetiva.
                 
       find first pto-contr
            where pto-contr.cod-pto-contr =  historico-embarque.cod-pto-contr no-lock no-error.
       if avail pto-contr then do:
       
          assign tt-docto-estoq-nfe-imp.des-descr-gener   =  if historico-embarque.descricao <> "":U then historico-embarque.descricao else pto-contr.descricao
          &if "{&bf_dis_versao_ems}" >= "2.07" &then
                 tt-docto-estoq-nfe-imp.cod-uf  = pto-contr.cod-uf.
          &else
             &if "{&bf_dis_versao_ems}" >= "2.04" &THEN
                 tt-docto-estoq-nfe-imp.cod-uf  = SUBSTRING(pto-contr.char-1,1,2).
             &endif
          &endif
       end.

    END.      
        
end procedure.

procedure pi-gera-item-docto-estoq-nfe-imp:

    if not can-find (first tt-item-docto-estoq-nfe-imp 
                     where tt-item-docto-estoq-nfe-imp.cod-ser-docto    = tt-item-doc-est.serie-docto
                     and   tt-item-docto-estoq-nfe-imp.cod-docto        = tt-item-doc-est.nro-docto
                     and   tt-item-docto-estoq-nfe-imp.cdn-emitente     = tt-item-doc-est.cod-emitente
                     and   tt-item-docto-estoq-nfe-imp.cod-natur-operac = tt-item-doc-est.nat-operacao
                     and   tt-item-docto-estoq-nfe-imp.num-seq          = tt-item-doc-est.sequencia    ) then do:

        find first processo-imp
             where processo-imp.cod-estabel = tt-nota.cod-estabel
             and   processo-imp.nr-proc-imp = tt-item-doc-est.nr-proc-imp  no-lock no-error.
        
        assign l-gera-prim-remessa = tt-nota.l-nf-simples-remessa and tt-nota.idi-nf-simples-remes = 1.
        
                
        if  l-gera-prim-remessa 
        and not avail ordens-embarque then 
           for first bf-ordens-embarque fields (char-1 &IF "{&bf_mat_versao_ems}" >= "2.07" &THEN num-adic &ENDIF )
               where bf-ordens-embarque.numero-ordem = tt-item-doc-est.numero-ordem
                 and bf-ordens-embarque.parcela      = tt-item-doc-est.parcela no-lock:
           end.
                       
        create tt-item-docto-estoq-nfe-imp.
        assign tt-item-docto-estoq-nfe-imp.cod-ser-docto     = tt-item-doc-est.serie-docto 
               tt-item-docto-estoq-nfe-imp.cod-docto         = tt-item-doc-est.nro-docto   
               tt-item-docto-estoq-nfe-imp.cdn-emitente      = tt-item-doc-est.cod-emitente
               tt-item-docto-estoq-nfe-imp.cod-natur-operac  = tt-item-doc-est.nat-operacao
               tt-item-docto-estoq-nfe-imp.num-seq           = tt-item-doc-est.sequencia   
               tt-item-docto-estoq-nfe-imp.cdn-expdor        = if avail processo-imp then processo-imp.cod-fabricante else 0
               tt-item-docto-estoq-nfe-imp.cod-item          = tt-item-doc-est.it-codigo   
               tt-item-docto-estoq-nfe-imp.val-base          = de-base-ii
               tt-item-docto-estoq-nfe-imp.val-desc          = 0
               tt-item-docto-estoq-nfe-imp.val-iof           = 0
               tt-item-docto-estoq-nfe-imp.des-decla-import  = if avail embarque-imp then string(embarque-imp.declaracao-import) else ""
               tt-item-docto-estoq-nfe-imp.val-despesa       =  de-tot-desp-adu 
               tt-item-docto-estoq-nfe-imp.val-impto-import  =  de-tot-desp-II.
               
               /*Verfica se o embarque esta vinculado com a DUIMP*/
               for first duimp-item 
                   where duimp-item.numero-ordem = ordens-embarque.numero-ordem no-lock:
               end.
               if avail duimp-item then 
                  assign i-num-adic         = 1
                         i-num-seq-duimp-it = duimp-item.seq-item.
               else
                  assign i-num-adic         = &IF "{&bf_mat_versao_ems}" < "2.07" &THEN
                                                   if (l-gera-prim-remessa and avail bf-ordens-embarque) then int(SUBSTR(bf-ordens-embarque.char-1, 60, 4))
                                                   else if avail ordens-embarque then int(SUBSTR(ordens-embarque.char-1, 60, 4)) else 0
                                              &ELSE
                                                   if (l-gera-prim-remessa and avail bf-ordens-embarque) then bf-ordens-embarque.num-adic 
                                                   else if avail ordens-embarque then ordens-embarque.num-adic else 0
                                              &ENDIF 
                                              
                         i-num-seq-duimp-it = if l-gera-prim-remessa and avail bf-ordens-embarque then INT(SUBSTR(bf-ordens-embarque.char-1, 80, 4))
                                              else if avail ordens-embarque then INT(SUBSTR(ordens-embarque.char-1, 80, 4)) else 0.
                                              
               assign tt-item-docto-estoq-nfe-imp.num-seq-import   = i-num-seq-duimp-it
                      tt-item-docto-estoq-nfe-imp.num-adic         = i-num-adic.

	               /*NF-e - cEAN/cEANTrib*/
        &if "{&bf_dis_versao_ems}" >= "2.062" &then /*Pa¡s Origem s¢ existe a partir da 2.06B na Cota‡Æo Item*/
            for first cotacao-item no-lock
                where cotacao-item.numero-ordem = ordem-compra.numero-ordem
                  and cotacao-item.cod-emitente = ordem-compra.cod-emitente
                  and cotacao-item.it-codigo    = ordem-compra.it-codigo
                  and cotacao-item.cot-aprovada = yes :
                assign tt-item-docto-estoq-nfe-imp.num-livre-1 = cotacao-item.cdn-pais-orig.
            end.
        &else
            for first emitente fields(pais) no-lock  /*Buscar Pa¡s Origem do pr¢prio Pa¡s do Fornecedor - se o cliente precisar alterar o pais, fazer manualmente via RE1001A3*/
                where emitente.cod-emitente = tt-item-docto-estoq-nfe-imp.cdn-emitente,
                first pais no-lock
                where pais.nome-pais = emitente.pais:

                assign tt-item-docto-estoq-nfe-imp.num-livre-1 = pais.cod-pais.
            end.
        &endif
        /*NF-e - cEAN/cEANTrib*/
    end.
end procedure.

&if defined(bf_mat_unidade_negocio) &then

    PROCEDURE pi-conecta-ems5:
        /*
        ** Conecta/Disconecta Bancos EMS 5
        */
        def input param p-conexao as integer no-undo.
        def output param l-erro   as logical no-undo.    
        
        DEF VAR h-btb009za AS HANDLE NO-UNDO.
        
        if not avail param-global then
            find first param-global no-lock no-error.
        
        RUN btb/btb009za.p PERSISTENT SET h-btb009za.    
        run pi-conecta-bco IN h-btb009za (Input 1,
                                          Input p-conexao,
                                          Input param-global.empresa-prin,
                                          Input "all":U,
                                          Output Table tt_erros_conexao).    
        if return-value <> "OK":U then do:
            for each tt_erros_conexao:
                if tt_erros_conexao.cd-erro = 25821 or
                   tt_erros_conexao.cd-erro = 25822 then 
                    next.
                assign i-msg         = tt_erros_conexao.cd-erro
                       c-msg         = tt_erros_conexao.param-1
                       c-char        = ""
                       l-erro        = yes.
                run pi-gera-erro.
            end.
        end.
        DELETE PROCEDURE h-btb009za.
        
    END PROCEDURE.

&endif


procedure pi-gera-erro:
    assign i-seq-erro = i-seq-erro + 1.
    run utp/ut-msgs.p (input "msg":U,
                       input i-msg,
                       input c-msg).
    do transaction:
        create tt-erro.
        assign tt-erro.i-sequen = i-seq-erro
               tt-erro.cd-erro  = i-msg
               tt-erro.mensagem = return-value + c-char.
    end.
end procedure.

procedure pi-cria-tt-nova:
  &if "{&bf_mat_versao_ems}":U >= "2.062":U &then   
      empty temp-table tt-docum-est-nova.
  
      find first tt-docum-est no-error.
          create tt-docum-est-nova.
          buffer-copy tt-docum-est to tt-docum-est-nova.
      
  
      empty temp-table tt-item-doc-est-nova.
      
      for each tt-item-doc-est:
          create tt-item-doc-est-nova.
          buffer-copy tt-item-doc-est to tt-item-doc-est-nova.
         
                   
           find first tt-itens
            where tt-itens.numero-ordem = tt-item-doc-est.numero-ordem
              and tt-itens.parcela      = tt-item-doc-est.parcela
              and tt-itens.sequencia    = tt-item-doc-est.sequencia no-lock no-error.
              
           if (avail tt-itens) and 
              (can-find (FIRST funcao WHERE funcao.cd-funcao = "USA-MULT-NAT-RECEB" 
                and funcao.ativo = yes)) then do:
                  assign tt-item-doc-est-nova.nat-of = tt-itens.nat-fiscal.
          end.
          else do:
                assign tt-item-doc-est-nova.nat-of = tt-item-doc-est-nova.nat-operacao.
          end.
          
          if avail tt-itens then
              assign tt-item-doc-est-nova.preco-unit-me = tt-itens.preco-unit.
          
          /* grava o valor do seguro no campo desconto-me. No reapi190b grava na tt-it-docto.vl-seguro que ser  utilizado no configurador de tributos */
          find first tt-it-docto no-lock
               where tt-it-docto.cod-emitente = tt-item-doc-est.cod-emitente
                 and tt-it-docto.nr-nota      = tt-item-doc-est.nro-docto                  
                 and tt-it-docto.serie        = tt-item-doc-est.serie-docto    
                 and tt-it-docto.nat-operacao = tt-item-doc-est.nat-operacao 
                 and tt-it-docto.nr-sequencia = tt-item-doc-est.sequencia no-error.
        
          if avail tt-it-docto then
              assign tt-item-doc-est-nova.desconto-me = tt-it-docto.vl-seguro.

      end.
  &endif
end procedure.

if valid-handle(h-reapi190b) then do:
   delete procedure h-reapi190b.
   assign h-reapi190b = ?.
end.

PROCEDURE pi-set-desconto:

    IF tt-docum-est.tot-desconto <> 0 THEN DO:
        for each tt-item-doc-est:
            ASSIGN tt-item-doc-est.desconto = ((tt-docum-est.tot-desconto * tt-item-doc-est.preco-total) / tt-docum-est.valor-mercad).
        END.
    END.

END PROCEDURE.

procedure piBuscaEmbarquesRelacionados:
   /* Respons vel por buscar os embarques filhos do embarque mÆe */
   define input parameter pc-cod-estabel like embarque-imp.cod-estabel no-undo.
   define input parameter pc-embarque    like embarque-imp.embarque    no-undo.
   define output parameter table for tt-embarque-filho-aux.
   
   define variable vlExisteFilho         as logical    initial yes     no-undo.
   define variable vcEmbarque            as character                  no-undo.
   
   assign vcEmbarque = pc-embarque.
        
   repeat while vlExisteFilho:
       run piBuscaEmbarquesFilho(input pc-cod-estabel,
                                 input vcEmbarque).
       if return-value = "NOK" then
           assign vlExisteFilho = no.
       else
           assign vcEmbarque = return-value.
   end.
   
   return "OK":U.
end procedure.

procedure piBuscaEmbarquesFilho:
    DEFINE INPUT  PARAMETER vpCodEstabel  LIKE embarque-imp.cod-estabel NO-UNDO.
    DEFINE INPUT  PARAMETER vpEmbarque    LIKE embarque-imp.embarque    NO-UNDO.
    
    define variable vcRetorno             as character  initial "NOK"   no-undo.
    
    /* Cria registro para os outros filhos*/
    FOR EACH bf-embarque-imp WHERE bf-embarque-imp.cod-estabel                   = vpCodEstabel
                             AND   TRIM(substring(bf-embarque-imp.char-1,21,20)) = vpEmbarque
                             NO-LOCK:
        FIND FIRST tt-embarque-filho-aux WHERE tt-embarque-filho-aux.embarque    = bf-embarque-imp.embarque
                                         AND   tt-embarque-filho-aux.cod-estabel = bf-embarque-imp.cod-estabel
                                         NO-ERROR.
        IF NOT AVAIL tt-embarque-filho-aux THEN DO:
            CREATE tt-embarque-filho-aux.
            ASSIGN tt-embarque-filho-aux.embarque     = bf-embarque-imp.embarque
                   tt-embarque-filho-aux.cod-estabel  = bf-embarque-imp.cod-estabel
                   vcRetorno                          = bf-embarque-imp.embarque.
        end.
    END.
    
    return vcRetorno.
END.

PROCEDURE pi-busca-perc-red-gov-item :

    DEFINE INPUT PARAMETER p-cod-estabel  LIKE estabelec.cod-estabel NO-UNDO.
    DEFINE INPUT PARAMETER p-embarque     LIKE embarque-imp.embarque NO-UNDO.
    DEFINE INPUT PARAMETER p-numero-ordem LIKE ordens-embarque.numero-ordem NO-UNDO.
    DEFINE INPUT PARAMETER p-parcela      LIKE ordens-embarque.parcela NO-UNDO.
    DEFINE INPUT PARAMETER p-it-codigo    LIKE item.it-codigo NO-UNDO.
    DEFINE INPUT PARAMETER p-nat-operacao LIKE natur-oper.nat-operacao NO-UNDO.
    DEFINE INPUT PARAMETER p-cod-emitente LIKE emitente.cod-emitente NO-UNDO.
    DEFINE INPUT PARAMETER p-class-fiscal LIKE classif-fisc.class-fiscal NO-UNDO.
    DEFINE INPUT PARAMETER p-data-operacao        AS DATE NO-UNDO.
    DEFINE OUTPUT PARAMETER p-perc-red-gov-cbs    AS DECIMAL NO-UNDO.
    DEFINE OUTPUT PARAMETER p-perc-red-gov-ibsuf  AS DECIMAL NO-UNDO.
    DEFINE OUTPUT PARAMETER p-perc-red-gov-ibsmun AS DECIMAL NO-UNDO.

    DEFINE VARIABLE h-cdapi1005         AS HANDLE NO-UNDO.
    DEFINE VARIABLE d-aliq              AS DECIMAL NO-UNDO.
    DEFINE VARIABLE d-perc-difer        AS DECIMAL NO-UNDO.
    DEFINE VARIABLE d-perc-red          AS DECIMAL NO-UNDO.
    DEFINE VARIABLE d-perc-cred-pres    AS DECIMAL NO-UNDO.
    DEFINE VARIABLE d-aliq-deson        AS DECIMAL NO-UNDO.
    DEFINE VARIABLE d-perc-red-aliq-gov AS DECIMAL NO-UNDO.
    DEFINE VARIABLE i-cod-gr-forn LIKE emitente.cod-gr-forn NO-UNDO.
    DEFINE VARIABLE c-cfop        LIKE natur-oper.cod-cfop NO-UNDO.
    DEFINE VARIABLE c-nbs               AS CHARACTER NO-UNDO.

    ASSIGN
        p-perc-red-gov-cbs    = 0
        p-perc-red-gov-ibsuf  = 0
        p-perc-red-gov-ibsmun = 0
        c-nbs                  = "".

    FIND FIRST item NO-LOCK
         WHERE item.it-codigo = p-it-codigo
         NO-ERROR.

    FIND FIRST emitente NO-LOCK
         WHERE emitente.cod-emitente = p-cod-emitente
         NO-ERROR.

    FIND FIRST natur-oper NO-LOCK
         WHERE natur-oper.nat-operacao = p-nat-operacao
         NO-ERROR.

    FIND FIRST estabelec NO-LOCK
         WHERE estabelec.cod-estabel = p-cod-estabel
         NO-ERROR.

    IF NOT AVAILABLE item
    OR NOT AVAILABLE estabelec THEN
        RETURN "OK":U.

    IF AVAILABLE emitente THEN ASSIGN i-cod-gr-forn = emitente.cod-gr-forn.

    IF AVAILABLE natur-oper THEN ASSIGN c-cfop = natur-oper.cod-cfop.

    ASSIGN c-nbs = SUBSTRING(item.char-1,342,20).

    RUN cdp/cdapi1005.p PERSISTENT SET h-cdapi1005.

    IF NOT VALID-HANDLE(h-cdapi1005) THEN
        RETURN "OK":U.

    RUN emptyTtRelactoTributo IN h-cdapi1005.

    RUN setDados IN h-cdapi1005 (
        INPUT 1,
        INPUT p-data-operacao,
        INPUT p-cod-estabel,
        INPUT p-nat-operacao,
        INPUT p-it-codigo,
        INPUT p-class-fiscal,
        INPUT i-cod-gr-forn,
        INPUT p-cod-emitente,
        INPUT c-cfop,
        INPUT c-nbs,
        INPUT estabelec.cidade,
        INPUT estabelec.estado).

    RUN setNbs IN h-cdapi1005 (INPUT c-nbs).

    RUN gerattcombinacao IN h-cdapi1005.

    /*
    ** CBS
    */
    RUN emptyTtRelactoTributo IN h-cdapi1005.

    RUN setIndTributo IN h-cdapi1005 (INPUT 1).

    RUN buscarRelactotributo IN h-cdapi1005.

    RUN getTributo IN h-cdapi1005 (
        OUTPUT d-aliq,
        OUTPUT d-perc-difer,
        OUTPUT d-perc-red,
        OUTPUT d-perc-cred-pres,
        OUTPUT d-aliq-deson,
        OUTPUT d-perc-red-aliq-gov).

    ASSIGN
        p-perc-red-gov-cbs = d-perc-red-aliq-gov.

    /*
    ** IBS UF
    */
    RUN emptyTtRelactoTributo IN h-cdapi1005.

    RUN setIndTributo IN h-cdapi1005 (INPUT 2).

    RUN buscarRelactotributo IN h-cdapi1005.

    RUN getTributo IN h-cdapi1005 (
        OUTPUT d-aliq,
        OUTPUT d-perc-difer,
        OUTPUT d-perc-red,
        OUTPUT d-perc-cred-pres,
        OUTPUT d-aliq-deson,
        OUTPUT d-perc-red-aliq-gov).

    ASSIGN
        p-perc-red-gov-ibsuf = d-perc-red-aliq-gov.

    /*
    ** IBS Município
    */
    RUN emptyTtRelactoTributo IN h-cdapi1005.

    RUN setIndTributo IN h-cdapi1005 (INPUT 3).

    RUN buscarRelactotributo IN h-cdapi1005.

    RUN getTributo IN h-cdapi1005 (
        OUTPUT d-aliq,
        OUTPUT d-perc-difer,
        OUTPUT d-perc-red,
        OUTPUT d-perc-cred-pres,
        OUTPUT d-aliq-deson,
        OUTPUT d-perc-red-aliq-gov).

    ASSIGN
        p-perc-red-gov-ibsmun = d-perc-red-aliq-gov.

    IF VALID-HANDLE(h-cdapi1005) THEN
        DELETE PROCEDURE h-cdapi1005 NO-ERROR.

    RETURN "OK":U.

END PROCEDURE.

PROCEDURE pi-grava-item-doc-est-tribut-gov :

    DEFINE PARAMETER BUFFER p-item-doc-est FOR item-doc-est.
    DEFINE INPUT PARAMETER p-nom-trib   AS CHARACTER NO-UNDO.
    DEFINE INPUT PARAMETER p-percentual AS DECIMAL NO-UNDO.

    IF p-percentual = 0 THEN RETURN "OK":U.

    FIND FIRST b-item-doc-est-tribut
         WHERE b-item-doc-est-tribut.cod-serie-docto  = p-item-doc-est.serie-docto
           AND b-item-doc-est-tribut.cod-num-docto    = p-item-doc-est.nro-docto
           AND b-item-doc-est-tribut.cdn-emitente     = p-item-doc-est.cod-emitente
           AND b-item-doc-est-tribut.cod-natur-operac = p-item-doc-est.nat-operacao
        AND b-item-doc-est-tribut.num-seq             = p-item-doc-est.sequencia
           AND b-item-doc-est-tribut.nom-trib         = p-nom-trib
           AND b-item-doc-est-tribut.cod-campo        = rep.imp.AtributoImposto:PERC-RED-GOV
         EXCLUSIVE-LOCK NO-ERROR.

    IF NOT AVAILABLE b-item-doc-est-tribut THEN DO:

        CREATE b-item-doc-est-tribut.

        ASSIGN
            b-item-doc-est-tribut.cod-serie-docto  = p-item-doc-est.serie-docto
            b-item-doc-est-tribut.cod-num-docto    = p-item-doc-est.nro-docto
            b-item-doc-est-tribut.cdn-emitente     = p-item-doc-est.cod-emitente
            b-item-doc-est-tribut.cod-natur-operac = p-item-doc-est.nat-operacao
            b-item-doc-est-tribut.num-seq          = p-item-doc-est.sequencia
            b-item-doc-est-tribut.nom-trib         = p-nom-trib
            b-item-doc-est-tribut.cod-campo        = rep.imp.AtributoImposto:PERC-RED-GOV.
    END.

    ASSIGN
        b-item-doc-est-tribut.cod-conteudo = STRING(p-percentual).

    RELEASE b-item-doc-est-tribut.

    RETURN "OK":U.

END PROCEDURE.

PROCEDURE calculaDescontoICMS:

 /* Retorna o percentual do desconto (de-perc-desc-icms) e se deve aplicar como desconto (l-aplica-desc-icms) */
    {rep/reapi190b.i4}
    
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


ASSIGN gl-de-desconto = 0.


/* IM7777.P */



