FOR EACH tt-ordens-desemb
   WHERE {1}
         tt-ordens-desemb.c-class-fiscal = tt-ordens-desemb-acum.c-class-fiscal
     AND tt-ordens-desemb.c-un           = tt-ordens-desemb-acum.c-un     
     AND tt-ordens-desemb.c-nat-fiscal   = tt-ordens-desemb-acum.c-nat-fiscal:

    ASSIGN tt-ordens-desemb.c-trib-ii       = tt-ordens-desemb-acum.c-trib-ii           
           tt-ordens-desemb.de-aliq-ii      = tt-ordens-desemb-acum.de-aliq-ii
           /******************************************************
           * Engenharia IPI Suspensao Incorporar Base PIS COFINS *
           ******************************************************/
           &IF DEFINED(bf-mat-comex) &THEN
           &ELSE
            tt-ordens-desemb.l-suspensao-II = tt-ordens-desemb-acum.l-suspensao-II
           &ENDIF
           tt-ordens-desemb.c-trib-ipi        = tt-ordens-desemb-acum.c-trib-ipi
           tt-ordens-desemb.de-aliq-ipi       = tt-ordens-desemb-acum.de-aliq-ipi
           /******************************************************
           * Engenharia IPI Suspensao Incorporar Base PIS COFINS *
           ******************************************************/
           &IF DEFINED(bf-mat-comex) &THEN
           &ELSE
            tt-ordens-desemb.l-suspensao-IPI = tt-ordens-desemb-acum.l-suspensao-IPI
           &ENDIF
           tt-ordens-desemb.c-trib-icms        = tt-ordens-desemb-acum.c-trib-icms
           tt-ordens-desemb.de-aliq-icms       = tt-ordens-desemb-acum.de-aliq-icms
           tt-ordens-desemb.l-aplica-desc-ICMS = tt-ordens-desemb-acum.l-aplica-desc-ICMS
           tt-ordens-desemb.c-trib-pis         = tt-ordens-desemb-acum.c-trib-pis
           tt-ordens-desemb.de-aliq-pis        = tt-ordens-desemb-acum.de-aliq-pis
           tt-ordens-desemb.c-trib-cofins      = tt-ordens-desemb-acum.c-trib-cofins
           tt-ordens-desemb.de-aliq-cofins     = tt-ordens-desemb-acum.de-aliq-cofins
           tt-ordens-desemb.cClassTrib-IBSUF     = tt-ordens-desemb-acum.cClassTrib-IBSUF
           tt-ordens-desemb.cCST-IBSUF           = tt-ordens-desemb-acum.cCST-IBSUF
           tt-ordens-desemb.c-trib-IBSUF         = tt-ordens-desemb-acum.c-trib-IBSUF
           tt-ordens-desemb.de-aliq-IBSUF        = tt-ordens-desemb-acum.de-aliq-IBSUF
           tt-ordens-desemb.perc-red-gov-ibsuf   = tt-ordens-desemb-acum.perc-red-gov-ibsuf
           tt-ordens-desemb.cClassTribReg-IBSUF  = tt-ordens-desemb-acum.cClassTribReg-IBSUF
           tt-ordens-desemb.cCSTReg-IBSUF        = tt-ordens-desemb-acum.cCSTReg-IBSUF
           tt-ordens-desemb.de-aliq-Reg-IBSUF    = tt-ordens-desemb-acum.de-aliq-Reg-IBSUF
           tt-ordens-desemb.cClassTrib-IBSMun    = tt-ordens-desemb-acum.cClassTrib-IBSMun
           tt-ordens-desemb.cCST-IBSMun          = tt-ordens-desemb-acum.cCST-IBSMun
           tt-ordens-desemb.c-trib-IBSMun        = tt-ordens-desemb-acum.c-trib-IBSMun
           tt-ordens-desemb.de-aliq-IBSMun       = tt-ordens-desemb-acum.de-aliq-IBSMun
           tt-ordens-desemb.perc-red-gov-ibsmun  = tt-ordens-desemb-acum.perc-red-gov-ibsmun
           tt-ordens-desemb.cClassTribReg-IBSMun = tt-ordens-desemb-acum.cClassTribReg-IBSMun
           tt-ordens-desemb.cCSTReg-IBSMun       = tt-ordens-desemb-acum.cCSTReg-IBSMun
           tt-ordens-desemb.de-aliq-Reg-IBSMun   = tt-ordens-desemb-acum.de-aliq-Reg-IBSMun
           tt-ordens-desemb.cClassTrib-CBS       = tt-ordens-desemb-acum.cClassTrib-CBS
           tt-ordens-desemb.cCST-CBS             = tt-ordens-desemb-acum.cCST-CBS
           tt-ordens-desemb.c-trib-CBS           = tt-ordens-desemb-acum.c-trib-CBS
           tt-ordens-desemb.de-aliq-CBS          = tt-ordens-desemb-acum.de-aliq-CBS
           tt-ordens-desemb.perc-red-gov-cbs     = tt-ordens-desemb-acum.perc-red-gov-cbs
           tt-ordens-desemb.cClassTribReg-CBS    = tt-ordens-desemb-acum.cClassTribReg-CBS
           tt-ordens-desemb.cCSTReg-CBS          = tt-ordens-desemb-acum.cCSTReg-CBS
           tt-ordens-desemb.de-aliq-Reg-CBS      = tt-ordens-desemb-acum.de-aliq-Reg-CBS
           tt-ordens-desemb.cClassTrib-IS        = tt-ordens-desemb-acum.cClassTrib-IS
           tt-ordens-desemb.cCST-IS              = tt-ordens-desemb-acum.cCST-IS
           tt-ordens-desemb.c-trib-IS            = tt-ordens-desemb-acum.c-trib-IS
           tt-ordens-desemb.de-aliq-IS           = tt-ordens-desemb-acum.de-aliq-IS
           tt-ordens-desemb.de-aliq-espec-IS     = tt-ordens-desemb-acum.de-aliq-espec-IS
           tt-ordens-desemb.de-qtde-trib-IS      = tt-ordens-desemb-acum.de-qtde-trib-IS
           tt-ordens-desemb.c-un-trib-IS         = tt-ordens-desemb-acum.c-un-trib-IS.
    
    if  p-cria-acum-aux then do:
        find first tt-ordens-desemb-acum-aux where tt-ordens-desemb-acum-aux.c-nat-fiscal = tt-ordens-desemb.c-nat-fiscal
                                             no-lock no-error.
        if not avail tt-ordens-desemb-acum-aux then do:
            CREATE tt-ordens-desemb-acum-aux.
            BUFFER-COPY tt-ordens-desemb TO tt-ordens-desemb-acum-aux.
        end.
    end.
END.
