/*:T------------------------------------------------------------------------------
  Purpose: Gera‡Æo documento - Nacionaliza‡Æo
    Notes:       
------------------------------------------------------------------------------*/
def input  parameter table for tt-nota.
def input  parameter table for tt-itens.
def output parameter table for tt-erro.
def output parameter table for tt-retorno.

define variable de-indice-conversao-fornec as decimal initial 1 no-undo.
define variable c-ini-obs-nf               as character         no-undo.
/*-----------------------------------------------[ L¢gica principal ]--------------------------------------------------------------*/
/* 
** PCREQ-9042 - Portador do Emitente 
** Salva na vari vel "l-fn-port-emitente" se a fun‡Æo relacionada ao Portador Financeiro do Emitente est  ativa 
*/
{cdp/cdapi3009.i2}

create tt-versao-integr.
assign tt-versao-integr.cod-versao-integracao = 003.

find first tt-nota no-error.

assign l-acomp = tt-nota.pl-acomp
       h-acomp = tt-nota.ph-acomp.

find first param-global no-lock no-error.
find first param-cq no-lock no-error.
find emitente       no-lock where emitente.cod-emitente     = tt-nota.cod-emitente   no-error.
find natur-oper     no-lock where natur-oper.nat-operacao   = tt-nota.nat-operacao   no-error.
find estabelec      no-lock where estabelec.cod-estabel     = tt-nota.cod-estabel    no-error.
find b-emit-estab   no-lock where b-emit-estab.cod-emitente = estabelec.cod-emitente no-error.
find param-re       no-lock where param-re.usuario          = tt-nota.usuario        no-error.
find serie          no-lock where serie.serie               = tt-nota.serie-docto    no-error.
find param-imp      no-lock where param-imp.cod-estabel     = tt-nota.cod-estabel    no-error.

/* PCREQ-9042 - Portador do Emitente */
ASSIGN i-port-emit = emitente.portador-ap
       i-modalid-emit = emitente.modalidade-ap.
IF l-fn-port-emitente THEN DO:
    run prgint/ufn/ufn008za.py persistent set h-api.
    if valid-handle(h-api) then do:
               run pi_busca_dados_portador_fin in h-api  (input "",
                                                      	  input i-port-emit,
           						  input i-modalid-emit,
           						  input emitente.cod-emitente,
           						  input "Fornecedor":U,
           		                                  input "",                                          
           						  output i-port-emit,
           						  output i-modalid-emit,
           						  output table tt_log_erro).
        delete procedure h-api.
    end.
    for each tt_log_erro:
       ASSIGN i-seq-erro = i-seq-erro + 1.
       CREATE tt-erro.
       ASSIGN tt-erro.i-sequen = i-seq-erro
              tt-erro.cd-erro  = tt_log_erro.ttv_num_cod_erro
              tt-erro.mensagem = tt_log_erro.ttv_des_msg_erro.
    end.
END.

/* Verifica se ‚ opera‡Æo de FUNDAP */
if emitente.pais = estabelec.pais then assign l-fornec-fundap = yes.

/* Inicia Acompanhamento */
if  l-acomp then do:
    {utp/ut-liter.i Consiste_documento... * L}
    assign c-acomp = trim(return-value).
    run pi-acompanhar in h-acomp (input c-acomp).
end. /* if  l-acomp then do: */

/* reapi190b.p - Valida e Gera documentos */

/* Consiste se o documento ja existe no recebimento */
find docum-est no-lock
    where docum-est.serie-docto  = tt-nota.serie-docto
    and   docum-est.nro-docto    = tt-nota.nro-docto
    and   docum-est.cod-emitente = tt-nota.cod-emitente
    and   docum-est.nat-operacao = tt-nota.nat-operacao no-error.
if  avail docum-est then do:

      {method/svc/errors/inserr.i
                 &errorNumber     = 5569
                 &errorType       = EMS
                 &errorSubType    = ERROR
                 &errorParameters = "tt-nota.nro-docto"}
                 
       
end. /* if  avail docum-est then do: */

/*---[ Consiste numero da nota ]----------------------------------------------*/
if  param-global.modulo-ft /* Faturamento habilitado */ and natur-oper.imp-nota /* Gera Nota Faturamento */ then do:
    if  serie.forma-emis = 1 /* Autom tica */ then do:
        find ser-estab
            where ser-estab.serie       = tt-nota.serie-docto
            and   ser-estab.cod-estabel = tt-nota.cod-estabel no-lock no-error.        
        if  not avail ser-estab then do:
                
          {method/svc/errors/inserr.i
                     &errorNumber     = 6514
                     &errorType       = EMS
                     &errorSubType    = ERROR
                     &errorParameters = "tt-nota.nro-docto"}
          
        end. /* if  not avail ser-estab */
        else do:
           /* busca do novo n£mero da nota.
            * Buscar o numero da nota no faturamento, ver se existe notas que ainda nÆo foram atualizadas (docum-est).
            */
           assign c-docto-aux = ser-estab.nr-ult-nota.
           /* buscar o proximo numero da sequencia */
           REPEAT:
               &if '{&bf_libera_15_posicoes}' = 'yes' &then
                    assign c-docto-aux = trim(string((dec(c-docto-aux) + 1),">>>>>>>>9999999":U)).
               &else
                    assign c-docto-aux = trim(string((dec(c-docto-aux) + 1),">>>9999999":U)). 
               &endif
               FIND FIRST docum-est
                   WHERE docum-est.serie-docto  = tt-nota.serie-docto
                   AND   docum-est.nro-docto    = c-docto-aux
                   AND   docum-est.cod-emitente = tt-nota.cod-emitente
                   AND   docum-est.nat-operacao = tt-nota.nat-operacao NO-LOCK NO-ERROR. 
               
               IF NOT AVAIL docum-est THEN
                   LEAVE.
           END.

           if  tt-nota.nro-docto = "" then do:
                find docum-est no-lock
                    where docum-est.serie-docto  = tt-nota.serie-docto 
                    and   docum-est.nro-docto    = c-docto-aux
                    and   docum-est.cod-emitente = tt-nota.cod-emitente
                    and   docum-est.nat-operacao = tt-nota.nat-operacao no-error.        

                if  avail docum-est then do:
                    find last docum-est no-lock
                        where docum-est.serie-docto  = tt-nota.serie-docto 
                        and   docum-est.nro-docto    = c-docto-aux
                        and   docum-est.cod-emitente = tt-nota.cod-emitente
                        and   docum-est.nat-operacao = tt-nota.nat-operacao no-error.                    
                    
                    &if '{&bf_libera_15_posicoes}' = 'yes' &then
                        assign tt-nota.nro-docto = trim(STRING(DEC(docum-est.nro-docto) + 1,">>>>>>>>9999999":U)).
                    &else
                        assign tt-nota.nro-docto = trim(STRING(DEC(docum-est.nro-docto) + 1,">>>9999999":U)).
                    &endif
                end. /* if  avail docum-est then do: */
                else do:
                    assign tt-nota.nro-docto = c-docto-aux.                     
                                       
                    run utp/ut-msgs.p (input "msg":U,
                                       input 52512,
                                       input c-docto-aux).                   

                    create tt-retorno.
                    assign tt-retorno.i-sequen   = 1
                           tt-retorno.cd-erro    = 52512
                           tt-retorno.mensagem   = return-value
                           &if '{&bf_mat_versao_ems}' >= '2.04' &then
                                tt-retorno.parametros = c-docto-aux /*utilizado para imprimir no relatorio de conferencia, nao retirar*/
                           &endif.

                    FIND LAST RowErrors NO-LOCK NO-ERROR.
                    IF AVAIL RowErrors THEN
                        ASSIGN iErro = RowErrors.errorSequence + 1.
                    ELSE 
                        ASSIGN iErro = 1.
                    
                    CREATE RowErrors.
                    ASSIGN RowErrors.ErrorNumber     = 52512
                           RowErrors.ErrorType       = "EMS"
                           RowErrors.ErrorParameters = c-docto-aux
                           RowErrors.errorSequence   = iErro. 
                    
                    RUN utp/ut-msgs.p (INPUT 'CodType', INPUT RowErrors.ErrorNumber, INPUT RowErrors.ErrorParameters).
                    
                    CASE return-value:
                            WHEN '1' THEN ASSIGN RowErrors.ErrorSubType = "ERROR".
                            WHEN '2' THEN ASSIGN RowErrors.ErrorSubType = "WARNING".
                            WHEN '3' THEN ASSIGN RowErrors.ErrorSubType = "QUESTION".
                            WHEN '4' THEN ASSIGN RowErrors.ErrorSubType = "INFORMATION".
                    END CASE.                                                 
                    
                    RUN utp/ut-msgs.p (INPUT 'help', INPUT RowErrors.ErrorNumber, INPUT RowErrors.ErrorParameters).    
                    ASSIGN RowErrors.ErrorHelp = return-value.
                    
                    RUN utp/ut-msgs.p (INPUT 'msg', INPUT RowErrors.ErrorNumber, INPUT RowErrors.ErrorParameters).        
                    ASSIGN RowErrors.ErrorDescription = return-value.
                    
                end. /* else do: */
            end. /*if nro-docto = ""*/
        end. /* else do: */
    END. /*if   serie.forma-emis = 1  */
END. /* Consiste numero da nota */

/*---[ Cria temp-tables de cabecalho da nota ]---------------------------------------------------------------------*/
/* tt-documEst-aux - Cabe‡alho para a API do Recebimento */

find first embarque-imp no-lock
    where embarque-imp.cod-estabel = tt-nota.cod-estabel 
    and   embarque-imp.embarque    = tt-nota.embarque no-error.
    
    
if LENGTH(embarque-imp.declaracao-import) < 15 then
    assign c-ini-obs-nf = "Conforme DI: ".
else
    assign c-ini-obs-nf = "Conforme DUIMP: ".

create tt-documEst-aux.
assign tt-documEst-aux.cod-emitente         = tt-nota.cod-emitente
       tt-documEst-aux.uf                   = emitente.estado
       tt-documEst-aux.nat-operacao         = tt-nota.nat-operacao       
       tt-documEst-aux.nro-docto            = tt-nota.nro-docto
       tt-documEst-aux.serie-docto          = tt-nota.serie-docto
       tt-documEst-aux.cod-estabel          = tt-nota.cod-estabel       
       tt-documEst-aux.dt-emissao           = tt-nota.dt-emissao
       tt-documEst-aux.dt-trans             = tt-nota.dt-trans
       tt-documEst-aux.dt-venc-icm          = tt-nota.dt-venc-icm       
       tt-documEst-aux.dt-venc-ipi          = tt-nota.dt-venc-ipi
       tt-documEst-aux.estab-fisc           = tt-nota.estab-fisc
       tt-documEst-aux.observacao           = c-ini-obs-nf    + embarque-imp.declaracao-import + 
                                              " Emitida em: " + string(embarque-imp.data-di)   + 
                                              " - Embarque: " + tt-nota.embarque + " - "       + tt-nota.observacao                     
       tt-documEst-aux.usuario              = tt-nota.usuario           
       tt-documEst-aux.ct-transit           = tt-nota.ct-transit
       tt-documEst-aux.sc-transit           = tt-nota.sc-transit
       tt-documEst-aux.cod-tipo-oper-gov    = tt-nota.cod-tipo-oper-gov
       tt-documEst-aux.cod-tipo-ente-gov    = tt-nota.cod-tipo-ente-gov
       tt-documEst-aux.cod-observa          = 1 /* industria */
       tt-documEst-aux.embarque             = tt-nota.embarque
       OVERLAY(tt-documEst-aux.char-1,1,20) = tt-nota.embarque
       tt-documEst-aux.nff                  = no
       tt-documEst-aux.valor-embal          = 0
       tt-documEst-aux.pais-origem          = "RE1001":U
       tt-documEst-aux.efetua-calculo       = 0
       tt-documEst-aux.esp-docto            = 21
       tt-documEst-aux.rec-fisico           = no
       tt-documEst-aux.origem               = "I":U
       tt-documEst-aux.via-transp           = tt-nota.via-transp           
       tt-documEst-aux.mod-frete            = 1
       tt-documEst-aux.cotacao-dia          = tt-nota.cotacao-dia
       tt-documEst-aux.declaracao-import    = embarque-imp.declaracao-import.

/*--- Peso Documento ------------------------------------------------------------------------*/
ASSIGN d-val-tot-liq-DI  = 0
       d-val-tot-brut-DI = 0.

FOR EACH  ordens-embarque NO-LOCK
    WHERE ordens-embarque.cod-estabel = embarque-imp.cod-estabel
    AND   ordens-embarque.embarque    = embarque-imp.embarque,
    EACH  decla-import-adic-itens NO-LOCK
    WHERE decla-import-adic-itens.cod-embarq  = ordens-embarque.embarque
    AND   decla-import-adic-itens.num-ordem   = ordens-embarque.numero-ordem
    AND   decla-import-adic-itens.num-parcela = ordens-embarque.parcela
    AND   decla-import-adic-itens.cod-estab   = ordens-embarque.cod-estabel:

    ASSIGN d-val-tot-liq-DI  = d-val-tot-liq-DI  + decla-import-adic-itens.val-peso-liq
           d-val-tot-brut-DI = d-val-tot-brut-DI + decla-import-adic-itens.val-peso-brut-merc.
END. /* FOR EACH  ordens-embarque NO-LOCK */

ASSIGN tt-documEst-aux.peso-bruto-tot   = d-val-tot-brut-DI
       tt-documEst-aux.peso-liquido-tot = d-val-tot-liq-DI.
/*--- Peso Documento ------------------------------------------------------------------------*/

/* TT-DOCTO - Cabecalho utilizado para calculos de impostos no Recebimento  */       
create tt-docto.  
assign tt-docto.seq-tt-docto    = 1
       tt-docto.dt-trans        = tt-documEst-aux.dt-trans
       tt-docto.ind-tip-nota    = 8
       tt-docto.cod-portador    = i-port-emit
       tt-docto.modalidade      = i-modalid-emit
       tt-docto.cod-estabel     = tt-documEst-aux.cod-estabel
       tt-docto.serie           = tt-documEst-aux.serie-docto
       tt-docto.nr-nota         = tt-documEst-aux.nro-docto
       tt-docto.cod-emitente    = tt-documEst-aux.cod-emitente
       tt-docto.nat-operacao    = tt-documEst-aux.nat-operacao  
       tt-docto.dt-emis-nota    = tt-documEst-aux.dt-trans
       tt-docto.nome-abrev      = emitente.nome-abrev
       tt-docto.usuario         = tt-documEst-aux.usuario  
       tt-docto.inc-seq         = param-re.inc-seq
       tt-docto.seq-item-um     = param-re.seq-item-um
       tt-docto.estado          = estabelec.estado
       tt-docto.cidade          = estabelec.cidade
       tt-docto.pais            = estabelec.pais                                                                   
       tt-docto.cod-des-merc    = if natur-oper.consum-final then 2 /* Consumo */ else 1 /* Industralizacao */
       tt-docto.esp-docto       = tt-documEst-aux.esp-docto
       tt-docto.cod-msg         = natur-oper.cod-mensagem
       tt-docto.ind-lib-nota    = yes
       tt-docto.perc-desco1     = if tt-documEst-aux.tot-desconto <> 0 then 1 else 0.

create tt-docto-estoq-nfe-imp.
assign tt-docto-estoq-nfe-imp.cdn-emitente               = tt-documEst-aux.cod-emitente 
       tt-docto-estoq-nfe-imp.cod-docto                  = tt-documEst-aux.nro-docto    
       tt-docto-estoq-nfe-imp.cod-natur-operac           = tt-documEst-aux.nat-operacao 
       tt-docto-estoq-nfe-imp.cod-ser-docto              = tt-documEst-aux.serie-docto  
       tt-docto-estoq-nfe-imp.cod-estab                  = tt-documEst-aux.cod-estabel
       tt-docto-estoq-nfe-imp.des-decla-import           = embarque-imp.declaracao-import
       tt-docto-estoq-nfe-imp.dat-decla-import           = embarque-imp.data-di
       tt-docto-estoq-nfe-imp.cdn-expdor                 = tt-documEst-aux.cod-emitente 
       OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,41,1)  = IF SUBSTRING(embarque-imp.char-1,91,1) = "" THEN "0" ELSE SUBSTRING(embarque-imp.char-1,91,1)
       OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,25,14) = string(emitente.cgc)   /*  cnpj */                                 
       OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,39,2)  = emitente.estado. /* UF */
           
FIND FIRST decla-import 
    WHERE decla-import.cod-di-siscomex = embarque-imp.declaracao-import NO-LOCK NO-ERROR.
IF AVAIL decla-import THEN DO:
    /* Forma de Importa‡Æo e Via de Transporte */
    ASSIGN OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2)  = STRING(decla-import.cdn-via-transp-di).
           OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,23,2) = STRING(decla-import.idi-caract-operac).              
    
    if TRIM(substring(tt-docto-estoq-nfe-imp.cod-livre-1,23,2)) = "2" /*2 - Por conta e ordem*/ 
    then do:
           FIND emitente WHERE emitente.cod-emitente = INT(decla-import.cdn-consign) NO-LOCK NO-ERROR.
           ASSIGN OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,25,14) =  string(emitente.cgc).
                  OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,39,2)  =  emitente.estado.
           FIND emitente WHERE emitente.cod-emitente = INT(tt-docto-estoq-nfe-imp.cdn-expdor) NO-LOCK NO-ERROR.
    end.
    
    /* DUIMP */
    if  decla-import.cdd-siscomex-dts <> 0 
    and can-find(first duimp-siscomex no-lock
                 where duimp-siscomex.cod-duimp-dts = decla-import.num-di-ems) then do:
        assign OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,41,1) = "2". /* Documento Importa‡Æo */
    end.    
END.
ELSE DO:    
    /* Forma de Importa‡Æo e Via de Transporte */
    assign overlay(tt-docto-estoq-nfe-imp.cod-livre-1,23,2)  = "1".  /* forma importa */
    CASE embarque-imp.cod-via-transp: 
        /* Rodovi rio */ 
        WHEN 1 THEN DO:
             OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2) = "7".
        END.
        /* Aerovi rio */ 
        WHEN 2 THEN DO:
             OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2) = "4".
        END.
            /* Mar¡timo */ 
        WHEN 3 THEN DO:
             OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2) = "1".
        END.
            /* Ferrovi rio */ 
        WHEN 4 THEN DO:
             OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2) = "6".
        END.
            /* Rodoferrovi rio */ 
        WHEN 5 THEN DO:
             OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2) = "6". 
        END.
            /* Rodofluvial */ 
        WHEN 6 THEN DO:
             OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2) = "2". 
        END.
            /* Rodoaerovi rio */ 
        WHEN 7 THEN DO:
             OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2) = "7". 
        END.
            /* Outros */ 
        WHEN 8 THEN DO:
             OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,1,2) = "11". 
        END.   
    END CASE.     
END. 

if TRIM(substring(tt-docto-estoq-nfe-imp.cod-livre-1,23,2)) = "1" /*1 - Por conta pr¢pria*/ 
then do:
      
       OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,25,14) = "":U.  /*cnpj*/                                 
       OVERLAY(tt-docto-estoq-nfe-imp.cod-livre-1,39,2)  = "":U.  /*UF  */ 
end.     

FIND FIRST historico-embarque NO-LOCK
    WHERE  historico-embarque.cod-estabel   = tt-documEst-aux.cod-estabel
    AND    historico-embarque.embarque      = tt-documEst-aux.embarque
    AND    historico-embarque.cod-itiner    = tt-nota.cod-itiner
    AND    historico-embarque.cod-pto-contr = embarque-imp.cdn-pto-desembar NO-ERROR.          
IF  AVAIL  historico-embarque THEN 
    ASSIGN tt-docto-estoq-nfe-imp.dat-desembarac = historico-embarque.dt-efetiva.
         
find first pto-contr NO-LOCK
    where  pto-contr.cod-pto-contr =  historico-embarque.cod-pto-contr no-error.
if  avail  pto-contr then do:
    assign tt-docto-estoq-nfe-imp.des-descr-gener   =  if historico-embarque.descricao <> "":U then historico-embarque.descricao else pto-contr.descricao
           &if "{&bf_dis_versao_ems}" >= "2.07" &then
           tt-docto-estoq-nfe-imp.cod-uf  = pto-contr.cod-uf.
           &else
                &if "{&bf_dis_versao_ems}" >= "2.04" &THEN
                tt-docto-estoq-nfe-imp.cod-uf  = SUBSTRING(pto-contr.char-1,1,2).
                &endif
           &endif
           
end. /* if  avail  pto-contr then do: */

/* Cria Itens do Documento */ 
for each tt-itens break by tt-itens.numero-ordem:

    assign l-first-numero-ordem = no.
    if first-of(tt-itens.numero-ordem) then assign l-first-numero-ordem = yes.

    find item no-lock where item.it-codigo = tt-itens.it-codigo no-error.
    find ordem-compra where ordem-compra.numero-ordem = tt-itens.numero-ordem no-lock no-error.

    find first ordens-embarque no-lock
        where  ordens-embarque.cod-estabel  = tt-nota.cod-estabel
        and    ordens-embarque.embarque     = tt-nota.embarque 
        and    ordens-embarque.numero-ordem = tt-itens.numero-ordem
        and    ordens-embarque.parcela      = tt-itens.parcela no-error.
    
    assign de-frete        = 0
           de-seguro       = 0
           de-embal        = 0
           de-outras       = 0
           de-base-ipi     = 0
           de-base-icm     = 0
           de-base-II      = 0
           de-tot-desp-adu = 0
           de-desp-II      = 0 .

    if  l-acomp then do:
        {utp/ut-liter.i Consiste_itens... * L}
        assign c-acomp = trim(return-value).
        run pi-acompanhar in h-acomp (input c-acomp).
    end. /* if  l-acomp then do: */
    
    &if '{&bf_mat_versao_ems}' >= '2.04' &then
        find item-uni-estab no-lock 
            where item-uni-estab.it-codigo   = ordem-compra.it-codigo 
            and   item-uni-estab.cod-estabel = ordem-compra.cod-estabel no-error.
        if  avail item-uni-estab 
        then assign l-loc-unica   = item-uni-estab.loc-unica
                    c-cod-localiz = item-uni-estab.cod-localiz.
        else assign l-loc-unica   = item.loc-unica
                    c-cod-localiz = item.cod-localiz.
    &else
        assign l-loc-unica  = item.loc-unica
               c-cod-localiz = item.cod-localiz.
    &endif    
    
    if i-seq-item-doc-est = 0 
    then assign i-seq-item-doc-est = param-re.seq-item-um.
    else assign i-seq-item-doc-est = i-seq-item-doc-est + param-re.inc-seq.

    create tt-itemDoc-est-aux.
    assign tt-itens.sequencia                  = i-seq-item-doc-est
           tt-itemDoc-est-aux.cod-emitente     = tt-documEst-aux.cod-emitente
           tt-itemDoc-est-aux.nat-operacao     = tt-documEst-aux.nat-operacao
           tt-itemDoc-est-aux.nro-docto        = tt-documEst-aux.nro-docto
           tt-itemDoc-est-aux.serie-docto      = tt-documEst-aux.serie-docto
           tt-itemDoc-est-aux.sequencia        = i-seq-item-doc-est
           tt-itemDoc-est-aux.quantidade       = tt-itens.quantidade
           tt-itemDoc-est-aux.lote             = tt-itens.lote
           tt-itemDoc-est-aux.dt-vali-lote     = tt-itens.dt-vali-lote
           tt-itemDoc-est-aux.cod-refer        = tt-itens.cod-refer
           tt-itemDoc-est-aux.encerra-pa       = tt-itens.encerra-pa
           tt-itemDoc-est-aux.parcela          = tt-itens.parcela
           tt-itemDoc-est-aux.cod-depos        = tt-itens.cod-depos
           tt-itemDoc-est-aux.it-codigo        = ordem-compra.it-codigo
           tt-itemDoc-est-aux.numero-ordem     = ordem-compra.numero-ordem
           tt-itemDoc-est-aux.narrativa        = ordem-compra.narrativa
           tt-itemDoc-est-aux.nr-ord-prod      = ordem-compra.ordem-servic
           tt-itemDoc-est-aux.ct-codigo        = if  ordem-compra.ct-codigo = ""
                                                 and (item.tipo-contr = 1 or item.tipo-contr = 4) 
                                                 then item.ct-codigo
                                                 else ordem-compra.ct-codigo
           tt-itemDoc-est-aux.sc-codigo        = if  ordem-compra.sc-codigo = ""
                                                 and (item.tipo-contr = 1 or item.tipo-contr = 4) 
                                                 then item.sc-codigo
                                                 else ordem-compra.sc-codigo                                                
           tt-itemDoc-est-aux.cod-localiz      = c-cod-localiz
           tt-itemDoc-est-aux.nro-comp         = "0"
           tt-itemDoc-est-aux.class-fiscal     = tt-itens.class-fiscal
           &IF "{&bf_mat_versao_ems}" >= "2.062" &THEN
               tt-itemDoc-est-aux.peso-liquido = ITEM.peso-liquido
           &else
               tt-itemDoc-est-aux.peso-liquido = ITEM.peso-liquido * tt-itens.quantidade
           &endif
           tt-itemDoc-est-aux.nr-proc-imp      = tt-itens.nr-proc-imp
           tt-itemDoc-est-aux.desconto         = 0
           tt-itemDoc-est-aux.baixa-ce         = yes 
           tt-itemDoc-est-aux.valor-iss        = 0
           tt-itemDoc-est-aux.valor-subs       = 0
           tt-itemDoc-est-aux.ind-icm-ret      = no
           
           &IF '{&bf_lote_avancado_liberado}' = 'yes' &THEN /*Campos Projeto FDA*/
             tt-itemDoc-est-aux.cod-lote-fabrican       =  tt-itens.cod-lote-fabrican            
             tt-itemDoc-est-aux.dat-fabricc-lote        =  tt-itens.dat-fabricc-lote             
             tt-itemDoc-est-aux.dat-valid-lote-fabrican =  tt-itens.dat-valid-lote-fabrican      
             tt-itemDoc-est-aux.nom-fabrican            =  tt-itens.nom-fabrican                 
           &ENDIF           
           .

    assign gl-de-desconto = tt-itens.desconto.
    
    /*--- PESO by DI --------------------------------------------------------------*/
    ASSIGN d-val-liq-DI  = 0
           d-val-brut-DI = 0
           d-val-mercad  = 0.

    IF  AVAIL ordens-embarque THEN
        FOR FIRST decla-import-adic-itens NO-LOCK
            WHERE decla-import-adic-itens.cod-embarq  = ordens-embarque.embarque
            AND   decla-import-adic-itens.num-ordem   = ordens-embarque.numero-ordem
            AND   decla-import-adic-itens.num-parcela = ordens-embarque.parcela
            AND   decla-import-adic-itens.cod-estab   = ordens-embarque.cod-estabel:
            ASSIGN d-val-liq-DI  = d-val-liq-DI  + decla-import-adic-itens.val-peso-liq
                   d-val-brut-DI = d-val-brut-DI + decla-import-adic-itens.val-peso-brut-merc
                   d-val-mercad  = d-val-mercad  + (DECIMAL(SUBSTRING(decla-import-adic-itens.cod-livre-1,4,20)) / 100000000).
        END. /* FOR FIRST decla-import-adic-itens NO-LOCK */

        FIND FIRST decla-import 
            WHERE decla-import.cod-di-siscomex = embarque-imp.declaracao-import NO-LOCK NO-ERROR.
        FOR FIRST decla-import-ord NO-LOCK
          WHERE decla-import-ord.num-di-ems = decla-import.num-di-ems
            AND decla-import-ord.num-ordem  = tt-itemDoc-est-aux.numero-ordem,
          FIRST cotacao-item
          WHERE cotacao-item.numero-ordem = decla-import-ord.num-ordem
            AND cotacao-item.it-codigo    = decla-import-ord.cod-item
            AND cotacao-item.cod-emitente = decla-import-ord.cdn-fornec
            AND cotacao-item.cot-aprovada NO-LOCK:
            IF cotacao-item.mo-codigo <> 0 THEN
                   /*Convertendo da moeda negociada para Real*/
                   RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                           INPUT decla-import.cdd-siscomex-dts,
                                           INPUT cotacao-item.mo-codigo,
                                           INPUT 0,
                                           INPUT d-val-mercad,
                                           INPUT decla-import.dat-di,
                                           OUTPUT d-val-mercad-aux).
            ELSE 
                ASSIGN d-val-mercad-aux = d-val-mercad.
                
            assign de-indice-conversao-fornec = fnGetItemVendorConversionFactor(tt-itemDoc-est-aux.it-codigo, 
                                                                                tt-itemDoc-est-aux.cod-emitente, 
                                                                                cotacao-item.un).
        END.

        ASSIGN tt-itemDoc-est-aux.qt-do-forn      = tt-itemDoc-est-aux.quantidade * de-indice-conversao-fornec
               tt-itemDoc-est-aux.peso-bruto-DI   = d-val-brut-DI 
               tt-itemDoc-est-aux.peso-liquido-DI = d-val-liq-DI
               tt-itemDoc-est-aux.preco-total     = d-val-mercad-aux * tt-itemDoc-est-aux.qt-do-forn
               tt-itens.preco-unit                = d-val-mercad-aux.

    
    /*--- PESO by DI --------------------------------------------------------------*/
    IF  tt-itens.l-ordens-embarque 
    THEN if tt-itens.peso-liquido <> 0 then ASSIGN tt-itemDoc-est-aux.peso-liquido = tt-itens.peso-liquido.

    /*Gera Despesas do documento e do item por DI*/
    RUN pi-gera-despesa-item.
    
    /* Quando a release for igual ou superior ao EMS205, o peso liquido sempre ser  buscado das ordens-embarque, 
       pois a grava‡Æo do peso ‚ realizada no momento da vincula‡Æo da ordem ao embarque */
    &if '{&bf_mat_versao_ems}':U >= '2.05':U &then
    ASSIGN tt-itemDoc-est-aux.peso-liquido = tt-itens.peso-liquido.
    &endif
           
    &if defined(bf_mat_nf_simp_remes_desp_imp) &then
        &if '{&bf_mat_versao_ems}':U >= '2.04':U &then
            if  tt-nota.l-nf-simples-remessa 
            and tt-nota.idi-nf-simples-remes = 1 then /** nota mae **/
                assign tt-itemDoc-est-aux.ct-codigo = tt-nota.ct-codigo.
        &endif
    &endif

    if  tt-itemDoc-est-aux.nr-ord-prod <> 0 then do:
        find first reservas no-lock
            where  reservas.nr-ord-produ = tt-itemDoc-est-aux.nr-ord-prod
            and    reservas.it-codigo    = tt-itemDoc-est-aux.it-codigo no-error.
        if  not avail reservas then do:
            ASSIGN tt-itemDoc-est-aux.item-pai = "".
            
            /* NÆo exige reserva para ordens de produ‡Æo de itens de pol¡tica configurado e controlado por referˆncia */
            FIND ord-prod NO-LOCK WHERE ord-prod.nr-ord-produ = tt-itemDoc-est-aux.nr-ord-prod NO-ERROR.
            IF  AVAIL ord-prod THEN DO:
                FIND b-item NO-LOCK WHERE b-item.it-codigo = ord-prod.it-codigo NO-ERROR.
                IF  AVAIL b-item then do:
                    IF  b-item.politica     = 5 /* configurado */
                    AND b-item.tipo-con-est = 4 /* referˆncia  */
                    THEN  ASSIGN tt-itemDoc-est-aux.item-pai = "".

                    if b-item.tipo-contr = 4 /* D‚bito Direto */ then ASSIGN tt-itemDoc-est-aux.item-pai = "".
                end. /* IF  AVAIL b-item then do: */
            END. /* IF  AVAIL ord-prod THEN DO: */

            IF  ITEM.tipo-contr = 4 /* D‚bito Direto */ THEN ASSIGN tt-itemDoc-est-aux.item-pai = "".
            
            assign tt-itemDoc-est-aux.cod-roteiro = ""
                   tt-itemDoc-est-aux.op-codigo   = 0.
        end. /* if  not avail reservas then do: */
        else do:
            assign tt-itemDoc-est-aux.item-pai    = reservas.item-pai
                   tt-itemDoc-est-aux.cod-roteiro = reservas.cod-roteiro
                   tt-itemDoc-est-aux.op-codigo   = reservas.op-codigo.
        end. /* else do: */
    end. /* if  tt-itemDoc-est-aux.nr-ord-prod <> 0 then do: */

    /* Drawback - 2.03 */
    &if defined (bf_mat_versao_ems) &then
        &if "{&bf_mat_versao_ems}" >= "2.03" &then
            assign tt-itemDoc-est-aux.nr-ato-concessorio = tt-itens.nr-ato-concessorio.
        &endif
    &endif
    
    &if defined(bf_mat_nf_simp_remes_desp_imp) &then
        &if '{&bf_mat_versao_ems}':U >= '2.04':U &then
            if  tt-nota.l-nf-simples-remessa
            and tt-nota.idi-nf-simples-remes = 2 /** nf simples remessa filha **/
            then assign tt-itemDoc-est-aux.nr-ato-concessorio = "":U.
        &endif
    &endif

    /* Codigo de tributacao e Aliquota do ICMS */
    /* Verifica se foi informada aliquota/tributacao na ordens-embarque */
    IF  NOT tt-itens.l-ordens-embarque THEN DO:
    
        run cdp/cd4302.p ( item.cd-trib-icm, natur-oper.cd-trib-icm, output c-trib-icm).
        
        /*  Determina Aliquota ICMS */
        if l-fornec-fundap 
        then assign c-estado = emitente.estado.
        else assign c-estado = estabelec.estado.
            
        run cdp/cd4301.p ( (if  avail b-emit-estab then b-emit-estab.contrib-icms
                                                   else yes),
                           (if  avail b-emit-estab then b-emit-estab.natureza
                                                   else 2 /*"J"*/),
                            c-estado /*estabelec.estado*/,
                            estabelec.pais,
                            estabelec.estado,
                            tt-itemDoc-est-aux.it-codigo,
                            natur-oper.aliquota-icm,
                            output de-aliq-icm ).      
        
        assign tt-itemDoc-est-aux.cd-trib-icm  = c-trib-icm
               tt-itemDoc-est-aux.aliquota-icm = de-aliq-icm.
    END. /* IF  NOT tt-itens.l-ordens-embarque THEN DO: */
    ELSE DO:
        ASSIGN tt-itemDoc-est-aux.cd-trib-icm  = tt-itens.cd-trib-icms
               tt-itemDoc-est-aux.aliquota-icm = tt-itens.aliquota-icms.
    END. /* ELSE DO: */

    /* Verifica parÆmtro "Al¡quota 0 - ICMS Diferido */
    if tt-nota.l-icms-diferido then assign tt-itemDoc-est-aux.aliquota-icm = 0.
    
    /* Codigo de tributacao e Aliquota do IPI */
    /* Verifica se foi informada aliquota/tributacao na ordens-embarque */
    IF  NOT tt-itens.l-ordens-embarque THEN DO:
        run cdp/cd4303.p ( item.cd-trib-ipi, natur-oper.cd-trib-ipi, output c-trib-ipi ).
    
        /* Determina Aliquota IPI */   
        if  param-re.orig-aliq-ip = 1 then do:
            find classif-fisc no-lock
                where classif-fisc.class-fiscal = tt-itens.class-fiscal no-error.
            if avail classif-fisc then assign de-aliq-ipi = classif-fisc.aliquota-ipi.
        end. /* if  param-re.orig-aliq-ip = 1 then do: */
        else assign de-aliq-ipi = item.aliquota-ipi.
        
        assign tt-itemDoc-est-aux.cd-trib-ipi  = c-trib-ipi
               tt-itemDoc-est-aux.aliquota-ipi = de-aliq-ipi.
               
        /* Testa se foi informado regime de importa‡Æo na cota‡Æo da compra */
        if tt-itens.l-regime then assign tt-itemDoc-est-aux.aliquota-ipi = tt-itens.aliquota-ipi.
    END. /* IF  NOT tt-itens.l-ordens-embarque THEN DO: */
    ELSE ASSIGN tt-itemDoc-est-aux.cd-trib-ipi  = tt-itens.cd-trib-ipi
                tt-itemDoc-est-aux.aliquota-ipi = tt-itens.aliquota-ipi.

    /******************************************************
    * Engenharia IPI Suspensao Incorporar Base PIS COFINS *
    ******************************************************/
    IF  tt-itens.suspensao-IPI THEN ASSIGN tt-itemDoc-est-aux.aliquota-ipi = 0.

    assign de-tot-resto       = de-tot-resto       + (de-tot-despesa-aux - tt-itemDoc-est-aux.despesas)
           de-tot-resto-frete = de-tot-resto-frete + (de-tot-frete-aux   - tt-itemDoc-est-aux.vl-frete-cons)
           de-tot-II          = de-tot-II          + de-desp-II
           de-tot-seguro      = de-tot-seguro      + de-seguro
           de-tot-embal       = de-tot-embal       + de-embal
           de-tot-outras      = de-tot-outras      + de-outras.
    
    /* Gera tt-it-docto - utilizado p/ calcular os valores dos impostos */ 
    create tt-it-docto.
    assign tt-it-docto.seq-tt-it-docto = i-seq-aux
           tt-it-docto.ct-codigo       = tt-itemDoc-est-aux.ct-codigo
           tt-it-docto.cod-emitente    = tt-documEst-aux.cod-emitente           
           tt-it-docto.nr-nota         = tt-documEst-aux.nro-docto
           tt-it-docto.serie           = tt-documEst-aux.serie-docto
           tt-it-docto.cod-estabel     = tt-documEst-aux.cod-estabel
           tt-it-docto.nat-operacao    = tt-documEst-aux.nat-operacao
           tt-it-docto.calcula         = yes
           i-seq-aux                   = i-seq-aux + 1   
           tt-it-docto.nr-sequencia    = tt-itemDoc-est-aux.sequencia
           tt-it-docto.quantidade      = tt-itemDoc-est-aux.quantidade
           tt-it-docto.vl-frete        = tt-itemDoc-est-aux.vl-frete-cons
           tt-it-docto.vl-despes-it    = tt-itemDoc-est-aux.despesas
           tt-it-docto.vl-embalagem    = de-embal
           tt-it-docto.calcula         = yes                      
           tt-it-docto.it-codigo       = tt-itemDoc-est-aux.it-codigo
           tt-it-docto.nro-comp        = tt-itemDoc-est-aux.nro-comp
           tt-it-docto.serie-comp      = tt-itemDoc-est-aux.serie-comp
           tt-it-docto.nat-comp        = tt-itemDoc-est-aux.nat-comp
           tt-it-docto.seq-comp        = tt-itemDoc-est-aux.seq-comp
           tt-it-docto.class-fiscal    = tt-itemDoc-est-aux.class-fiscal
           tt-it-docto.data-comp       = tt-itemDoc-est-aux.data-comp
           tt-it-docto.nr-ord-prod     = tt-itemDoc-est-aux.nr-ord-prod
           tt-it-docto.numero-ordem    = tt-itemDoc-est-aux.numero-ordem
           tt-it-docto.parcela         = tt-itemDoc-est-aux.parcela
           tt-it-docto.cod-refer       = tt-itemDoc-est-aux.cod-refer
           tt-it-docto.encerra-pa      = tt-itemDoc-est-aux.encerra-pa 
           tt-it-docto.item-pai        = tt-itemDoc-est-aux.item-pai           
           tt-it-docto.cod-roteiro     = tt-itemDoc-est-aux.cod-roteiro
           tt-it-docto.op-codigo       = tt-itemDoc-est-aux.op-codigo
           tt-it-docto.narrativa       = tt-itemDoc-est-aux.narrativa               
           tt-it-docto.desconto        = tt-itemDoc-est-aux.desconto
           tt-it-docto.per-des-item    = int(tt-itemDoc-est-aux.desconto > 0)
           tt-it-docto.vl-preuni       = tt-itens.preco-unit - tt-itemDoc-est-aux.desconto
           tt-it-docto.vl-preori       = tt-itens.preco-unit             
           tt-it-docto.vl-merc-liq     = tt-itemDoc-est-aux.preco-total - tt-itemDoc-est-aux.desconto /*dranka tt-itens*/
           tt-it-docto.vl-merc-ori     = tt-itemDoc-est-aux.preco-total                               /*dranka tt-itens*/
           tt-it-docto.vl-seguro       = de-seguro.
           
    /* Tratamento Fundap */
    if  l-fornec-fundap then do:
        create tt-it-docto-aux.
        buffer-copy tt-it-docto to tt-it-docto-aux.
    end. /* if  l-fornec-fundap then do: */

    /* Gera tt-it-imposto - utilizado p/ calcular os valores dos impostos */
    create tt-it-imposto.
    assign tt-it-imposto.seq-tt-it-docto = tt-it-docto.seq-tt-it-docto
           tt-it-imposto.ind-icm-ret     = no
           tt-it-imposto.cd-trib-icm     = tt-itemDoc-est-aux.cd-trib-icm
           tt-it-imposto.cd-trib-ipi     = tt-itemDoc-est-aux.cd-trib-ipi
           tt-it-imposto.aliquota-icm    = tt-itemDoc-est-aux.aliquota-icm
           tt-it-imposto.aliquota-ipi    = tt-itemDoc-est-aux.aliquota-ipi
           tt-it-imposto.perc-red-ipi    = natur-oper.perc-red-ipi
           tt-it-imposto.perc-red-icm    = natur-oper.perc-red-icm
           tt-it-imposto.vl-bipi-it      = de-base-ipi
           tt-it-imposto.vl-bicms-it     = de-base-icm.           

    /* Tratamento Fundap */
    if  l-fornec-fundap then do:
        create tt-it-imposto-aux.
        buffer-copy tt-it-imposto to tt-it-imposto-aux.
    end. /* if  l-fornec-fundap then do: */
    
    find last tt-it-docto   no-lock no-error.
    find last tt-it-imposto no-lock no-error.
    find last tt-docto      no-lock no-error.
    
    if  l-acomp then do:
        {utp/ut-liter.i Calculo_IPI/ICMS... * L}
        assign c-acomp = trim(return-value).
        run pi-acompanhar in h-acomp (input c-acomp).
    end. /* if  l-acomp then do: */
    
    /* FUNDAP - na opera‡Æo de FUNDAP o valor do ICMS ‚ calculado primeiro para que seu valor seja 
       adicionado ao valor do material, o IPI ‚ calculado posteriormente. */ 
    if  not l-fornec-fundap then do: 
        /*--- Calculo a base e o valor do IPI ---*/
        run cdp/cd4306.p ( input tt-it-docto.seq-tt-it-docto,
                           input 1, /* Natureza Entrada */
                           input natur-oper.char-2, /* Frete Base IPI   */
                           input no, /* Nota Comercio    */
                           input table tt-docto,
                           input table tt-it-docto,
                           input-output table tt-it-imposto).
        
        find tt-it-imposto 
            where tt-it-imposto.seq-tt-it-docto = tt-it-docto.seq-tt-it-docto no-error.
        assign tt-itemDoc-est-aux.base-ipi    = tt-it-imposto.vl-bipi-it
               tt-itemDoc-est-aux.valor-ipi   = tt-it-imposto.vl-ipi-it           
               tt-itemDoc-est-aux.ipi-ntrib   = tt-it-imposto.vl-ipint-it
               tt-itemDoc-est-aux.ipi-outras  = tt-it-imposto.vl-ipiou-it.
    end. /* if  not l-fornec-fundap then do: */
    
    assign de-base-ii = de-base-ii  + tt-itemDoc-est-aux.preco-total.
           
    find ordens-embarque no-lock
        where ordens-embarque.cod-estabel   = tt-nota.cod-estabel
        and   ordens-embarque.embarque      = tt-nota.embarque
        and   ordens-embarque.numero-ordem  = tt-itemDoc-est-aux.numero-ordem
        and   ordens-embarque.parcela       = tt-itemDoc-est-aux.parcela no-error.     
        

    FIND FIRST decla-import-adic-itens NO-LOCK
            WHERE decla-import-adic-itens.cod-embarq  = ordens-embarque.embarque
            AND   decla-import-adic-itens.num-ordem   = ordens-embarque.numero-ordem
            AND   decla-import-adic-itens.num-parcela = ordens-embarque.parcela
            AND   decla-import-adic-itens.cod-estab   = ordens-embarque.cod-estabel NO-ERROR.

    /* Acumula totais */
    assign tt-documEst-aux.tot-peso     = tt-documEst-aux.tot-peso     + tt-itemDoc-est-aux.peso-liquido
           tt-documEst-aux.valor-frete  = tt-documEst-aux.valor-frete  + tt-itemDoc-est-aux.vl-frete-cons
           gc-peso-bruto-tot            = string(tt-documEst-aux.tot-peso)
           d-val-mercad-aux             = (d-val-mercad-aux * decla-import-adic-itens.qtd-adic[2]).
           
    assign tt-documEst-aux.valor-mercad = tt-documEst-aux.valor-mercad + d-val-mercad-aux.
end. /* FIM do for each tt-itens break by numero-ordem: */

for each tt-docum-est-cex no-lock
   where tt-docum-est-cex.serie-docto  = tt-documEst-aux.serie-docto
     and tt-docum-est-cex.nro-docto    = tt-documEst-aux.nro-docto
     and tt-docum-est-cex.cod-emitente = tt-documEst-aux.cod-emitente
     and tt-docum-est-cex.nat-operacao = tt-documEst-aux.nat-operacao:

    find first desp-imp no-lock 
       where desp-imp.cod-desp = tt-docum-est-cex.cod-desp no-error.
       
    if avail decla-import then 
        for first despes-decla-import no-lock
            where despes-decla-import.num-di-ems = decla-import.num-di-ems 
              and despes-decla-import.cdn-despes = tt-docum-est-cex.cod-desp: end.
              
    if avail despes-decla-import and 
       desp-imp.inc-val-frete and desp-imp.cod-desp <> i-desp-ii-i50 and 
       tt-docum-est-cex.val-desp <> despes-decla-import.val-despes then
       assign de-dif-frete = despes-decla-import.val-despes - tt-docum-est-cex.val-desp.         
                 
    if (avail despes-decla-import and despes-decla-import.log-livre-1) or
       (avail desp-imp and substring(desp-imp.char-1,44,1) = "1") then do: /*AFRMM*/
       find first tt-docto-estoq-nfe-imp exclusive-lock no-error.
       if avail tt-docto-estoq-nfe-imp then
          assign overlay(tt-docto-estoq-nfe-imp.cod-livre-1,3,20) = string(tt-docum-est-cex.val-desp)
                 overlay(tt-docto-estoq-nfe-imp.cod-livre-1,1,2)  = "1". 
    end.
       
    for first desp-embarque fields(descricao) no-lock
        where desp-embarque.embarque = tt-documEst-aux.embarque
          and desp-embarque.cod-estabel = tt-documEst-aux.cod-estabel
          and desp-embarque.cod-desp = tt-docum-est-cex.cod-desp: 
    end.
  
/* Imprime Nota Fiscal */                
  if avail desp-embarque then do:
     if avail desp-imp and desp-imp.log-1 then 
        assign tt-documEst-aux.observacao = tt-documEst-aux.observacao  + " | "
                                            + string(desp-imp.cod-desp) + "-"
                                            + (if desp-embarque.descricao <> "":U then desp-embarque.descricao else desp-imp.descricao) + " / "
                                            + trim(string(tt-docum-est-cex.val-desp,">>>>>,>>>,>>9.99999")) + " ".
  end.                                            
  else 
     if avail desp-imp and desp-imp.log-1 then 
        assign tt-documEst-aux.observacao = tt-documEst-aux.observacao  + " | "
                                            + string(desp-imp.cod-desp) + "-"
                                            + desp-imp.descricao + " / "
                                            + trim(string(tt-docum-est-cex.val-desp,">>>>>,>>>,>>9.99999")) + " ".
end. 

/* Calcula a base e o valor do ICMS */

if can-find (first tt-erro) then leave.
if not can-find (first tt-itemDoc-est-aux) then leave.

/* Arredondamento dos valores das despesas do item */

assign de-val-despesas = 0.
for each tt-itemDoc-est-aux:
    if de-val-despesas < tt-itemDoc-est-aux.despesas
    then assign de-val-despesas   = tt-itemDoc-est-aux.despesas
                i-maior-sequencia = tt-itemDoc-est-aux.sequencia.
end. /* for each tt-itemDoc-est-aux: */

find tt-itemDoc-est-aux 
    where tt-itemDoc-est-aux.sequencia = i-maior-sequencia no-error.
if  avail tt-itemDoc-est-aux then do:
    assign tt-itemDoc-est-aux.despesas      = tt-itemDoc-est-aux.despesas      + de-tot-resto 
           tt-itemDoc-est-aux.vl-frete-cons = tt-itemDoc-est-aux.vl-frete-cons + de-tot-resto-frete.
    if de-dif-frete >= -0.5 and de-dif-frete <=  0.5 then do:               
       assign tt-itemDoc-est-aux.vl-frete-cons = tt-itemDoc-est-aux.vl-frete-cons + de-dif-frete.
       for first tt-item-doc-est-cex
           where tt-item-doc-est-cex.serie-docto  = tt-itemDoc-est-aux.serie-docto     
           and   tt-item-doc-est-cex.nro-docto    = tt-itemDoc-est-aux.nro-docto       
           and   tt-item-doc-est-cex.cod-emitente = tt-itemDoc-est-aux.cod-emitente    
           and   tt-item-doc-est-cex.nat-operacao = tt-itemDoc-est-aux.nat-operacao    
           and   tt-item-doc-est-cex.sequencia    = tt-itemDoc-est-aux.sequencia:                    
           find first desp-imp no-lock 
              where desp-imp.cod-desp = tt-item-doc-est-cex.cod-desp no-error.                
           if avail desp-imp and desp-imp.inc-val-frete and desp-imp.cod-desp <> i-desp-ii-i50 then do:
              assign tt-item-doc-est-cex.val-desp = tt-item-doc-est-cex.val-desp + de-dif-frete.                          
              for first tt-docum-est-cex
                  where tt-docum-est-cex.serie-docto       = tt-item-doc-est-cex.serie-docto              
                  and   tt-docum-est-cex.nro-docto         = tt-item-doc-est-cex.nro-docto                
                  and   tt-docum-est-cex.cod-emitente      = tt-item-doc-est-cex.cod-emitente             
                  and   tt-docum-est-cex.nat-operacao      = tt-item-doc-est-cex.nat-operacao
                  and   tt-docum-est-cex.cod-emitente-desp = tt-item-doc-est-cex.cod-emitente-desp
                  and   tt-docum-est-cex.cod-desp          = tt-item-doc-est-cex.cod-desp :                     
                  assign tt-docum-est-cex.val-desp = tt-docum-est-cex.val-desp + de-dif-frete.                       
              end.                     
           end.   
       end.   
    end.                            
end. /* if  avail tt-itemDoc-est-aux then do: */

/* Arredondamento dos valores das despesas no documento */
assign tt-documEst-aux.valor-frete  = tt-documEst-aux.valor-frete + de-tot-resto-frete
       tt-documEst-aux.valor-seguro = de-tot-seguro + (de-tot-seguro-aux - de-tot-seguro)
       tt-documEst-aux.valor-embal  = de-tot-embal  + (de-tot-embal-aux  - de-tot-embal)
       tt-documEst-aux.valor-outras = de-tot-outras + (de-tot-outras-aux - de-tot-outras)+ de-tot-II + (de-tot-II-aux  - de-tot-II).

if de-dif-frete >= -0.5 and de-dif-frete <=  0.5 then
   assign tt-documEst-aux.valor-frete  = tt-documEst-aux.valor-frete + de-dif-frete.    
              
/* Verifica se ser  gerado duplicatas */ 
if  natur-oper.emite-duplic then
    run pi-gera-duplicata.
    
if  l-acomp then do:
    {utp/ut-liter.i Gerando_documento... * L}
    assign c-acomp = trim(return-value).
    run pi-acompanhar in h-acomp (input c-acomp).
end. /* if  l-acomp then do: */

/* Executa programa para a geracao do documento no recebimento */
/* EMS */ 
find first tt-versao-integr no-lock no-error.
&if defined(bf_mat_versao_ems) &then
    if "{&bf_mat_versao_ems}":U >= "2.04":U then do:
        assign tt-versao-integr.cod-versao-integracao = 004.
        
        &if defined(bf_mat_unidade_negocio) &then
            find first param-mat no-lock no-error.
            if  avail param-mat 
            then if param-mat.ind-unid-neg 
                 then assign tt-documEst-aux.gera-unid-neg = 1.
                 else assign tt-documEst-aux.gera-unid-neg = 0.

            if  tt-documEst-aux.gera-unid-neg = 1 then do:
                run pi-gera-unid-negocio.
            end. /* if  tt-documEst-aux.gera-unid-neg = 1 then do: */
        &endif
        
        &if defined(bf_mat_nf_simp_remes_desp_imp) &then
            if  tt-nota.l-nf-simples-remessa and  tt-nota.idi-nf-simples-remes = 1 then do:  /** nf simples remessa e nf simples remessa mae **/ 
                for each  tt-itemDoc-est-aux
                    where tt-itemDoc-est-aux.serie-docto  = tt-documEst-aux.serie-docto
                    and   tt-itemDoc-est-aux.nro-docto    = tt-documEst-aux.nro-docto
                    and   tt-itemDoc-est-aux.cod-emitente = tt-documEst-aux.cod-emitente
                    and   tt-itemDoc-est-aux.nat-operacao = tt-documEst-aux.nat-operacao:
                    assign tt-itemDoc-est-aux.baixa-ce = no.
                end. /* for each  tt-itemDoc-est-aux */
            end. /* if  tt-nota.l-nf-simples-remessa ... */
        &endif
        
    end. /* if "{&bf_mat_versao_ems}":U >= "2.04":U then do: */
&endif
                     
/*---[ Gera‡Æo do documento com base nas temp-tables geradas anteriormente ]---*/
RUN pi-efetiva-docto.

IF  CAN-FIND(FIRST RowErrors 
             WHERE RowErrors.ErrorType <> "INTERNAL":U
             AND   RowErrors.ErrorSubType = "ERROR":U) THEN DO:
    /* Elimina as despesas do documento no Importacao quando houve problemas
       na API e o documento nao foi criado no Recebimento */
    FOR EACH  docum-est-cex exclusive-lock
        WHERE docum-est-cex.serie-docto  = tt-documEst-aux.serie-docto
        AND   docum-est-cex.nro-docto    = tt-documEst-aux.nro-docto
        AND   docum-est-cex.cod-emitente = tt-documEst-aux.cod-emitente
        AND   docum-est-cex.nat-operacao = tt-documEst-aux.nat-operacao :
        FOR EACH  item-doc-est-cex exclusive-lock
            WHERE item-doc-est-cex.serie-docto       = docum-est-cex.serie-docto
            AND   item-doc-est-cex.nro-docto         = docum-est-cex.nro-docto
            AND   item-doc-est-cex.cod-emitente      = docum-est-cex.cod-emitente
            AND   item-doc-est-cex.nat-operacao      = docum-est-cex.nat-operacao
            AND   item-doc-est-cex.cod-emitente-desp = docum-est-cex.cod-emitente-desp
            AND   item-doc-est-cex.cod-desp          = docum-est-cex.cod-desp:
            DELETE item-doc-est-cex.
        END. /* for each  item-doc-est-cex */

        DELETE docum-est-cex.
        END. /* for each  docum-est-cex */

        FOR EACH  dupli-apagar-cex EXCLUSIVE-LOCK
            WHERE dupli-apagar-cex.serie-docto  = tt-documEst-aux.serie-docto
            AND   dupli-apagar-cex.nro-docto    = tt-documEst-aux.nro-docto
            AND   dupli-apagar-cex.cod-emitente = tt-documEst-aux.cod-emitente
            AND   dupli-apagar-cex.nat-operacao = tt-documEst-aux.nat-operacao:
        DELETE dupli-apagar-cex.          
    END. /* for each  dupli-apagar-cex */
END.
IF  CAN-FIND(FIRST RowErrors) THEN DO:
    FOR EACH RowErrors:

        ASSIGN i-seq-erro = i-seq-erro + 1.

        CREATE tt-erro.
        ASSIGN tt-erro.i-sequen = i-seq-erro
               tt-erro.cd-erro  = RowErrors.ErrorNumber
               tt-erro.mensagem = RowErrors.ErrorDescription.
    END. /* FOR EACH RowErrors: */

    RETURN "NOK":U.
END. /* IF  CAN-FIND(FIRST RowErrors) */

&IF defined(bf_mat_nf_simp_remes_desp_imp) &THEN
    run imp/im9049.p (input tt-nota.serie-docto,   
                      input tt-nota.nro-docto,     
                      input tt-nota.cod-emitente,  
                      input tt-nota.nat-operacao,
                      input tt-nota.l-nf-simples-remessa,
                      input tt-nota.idi-nf-simples-remes).
&ENDIF

&if defined(bf_mat_versao_ems) &then
if  "{&bf_mat_versao_ems}" < "2.04" then do:
    /* Unidade de Neg¢cio */
    find first tt-erro no-error.
    if  not avail tt-erro then do:
        run pi-gera-unid-negocio.
    end. /* if  not avail tt-erro then do: */
end. /* if  "{&bf_mat_versao_ems}" < "2.04" then do: */
&else
/* Unidade de Neg¢cio */
find first tt-erro no-error.
if  not avail tt-erro then do:
    run pi-gera-unid-negocio.
end. /* if  not avail tt-erro then do: */
&endif

/* Ajusta sequencia dos erros com origem na api */
for each tt-erro where tt-erro.i-sequen = 0:
    if  i-seq-erro = 0 then assign i-seq-erro = 1.
    assign tt-erro.i-sequen = i-seq-erro
           i-seq-erro       = i-seq-erro + 1.
end. /* for each  tt-erro */


assign gl-de-desconto = 0.
