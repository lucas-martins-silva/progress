/**************************************************************************
**
**   aqapi004.i1 - Include de definicoes da temp-table tt-retorno-nota 
**                                                     tt-erro-imp 
**                                                     tt-fechto-docto
**
**                 da para gera‡Æo de notas no recebimento e v¡nculo MAQ
**
**************************************************************************/

DEFINE {1} SHARED TEMP-TABLE tt-retorno-nota NO-UNDO
    FIELD cod-emitente LIKE emitente.cod-emitente
    FIELD cod-propried LIKE propried-rural.cod-propried
    FIELD nome-abrev   LIKE emitente.nome-abrev
    FIELD nro-docto    LIKE docum-est.nro-docto
    FIELD nat-operacao LIKE docum-est.nat-operacao
    FIELD total-item   LIKE item-doc-est.preco-total[1]
    .

DEFINE {1} SHARED TEMP-TABLE tt-erro-imp NO-UNDO
    FIELD cdn-produt-rural AS INTEGER
    FIELD nom-produt-rural AS CHAR FORMAT "X(15)":U
    FIELD cd-erro          AS INTEGER
    FIELD desc-erro        AS CHAR FORMAT "x(80)":U
    .

DEFINE {1} SHARED TEMP-TABLE tt-fechto-docto NO-UNDO
    FIELD nro-docto    LIKE docum-est.nro-docto
    FIELD cod-emitente LIKE docum-est.cod-emitente
    FIELD serie-docto  LIKE docum-est.serie-docto
    FIELD nat-operacao LIKE docum-est.nat-operacao
    FIELD it-codigo    LIKE item.it-codigo
    FIELD cod-period   AS CHARACTER
    FIELD cod-propried LIKE fechto-produt-period.cod-propried
    FIELD qtd-period   LIKE fechto-produt-period.qtd-period
    FIELD nf-credito   AS CHARACTER
    FIELD cod-evento   AS CHARACTER
    FIELD rw-fechto    AS ROWID
    .
