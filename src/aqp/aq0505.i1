DEFINE VARIABLE h-acomp                 AS HANDLE              NO-UNDO.
DEFINE VARIABLE i                       AS INTEGER             NO-UNDO.

DEFINE VARIABLE c-titulo-coluna  AS CHARACTER EXTENT 23 NO-UNDO.
DEFINE VARIABLE c-campo          AS CHARACTER EXTENT 23 NO-UNDO.
DEFINE VARIABLE d-largura-coluna AS DECIMAL   EXTENT 23 NO-UNDO. 
DEFINE VARIABLE c-label-param    AS CHARACTER EXTENT 14 NO-UNDO.

{aqp/aq0505.i}
   
DEFINE TEMP-TABLE tt-nao-conform-carga NO-UNDO
    FIELD cod-estabel    LIKE naocfedade-carg.cod-estabel
    FIELD nc-carga       LIKE naocfedade-carg.cdn-naocfedade
    FIELD dt-trans       LIKE naocfedade-carg.dat-trans
    FIELD situacao       AS CHARACTER
    FIELD carga          LIKE naocfedade-carg.num-carg
    FIELD tipo-nc        AS CHARACTER
    FIELD item           LIKE carg-rural.it-codigo
    FIELD rota	         LIKE carg-rural.cod-rota
    FIELD cdn-compart    LIKE naocfedade-carg.cdn-compart
    FIELD pto-coleta     LIKE naocfedade-carg.cod-pto-coleta
    FIELD cod-transp     LIKE carg-rural.cod-transp
    FIELD nm-transport   LIKE transporte.nome
    FIELD placa          LIKE carg-rural.cod-placa
    FIELD nao-coleta     LIKE produt-carg.cdn-motiv-nao-coleta
    FIELD ds-nao-coleta  LIKE motiv-nao-coleta.des-motivo
    FIELD qtde-nc        LIKE carg-rural.qtd-coleta 
    FIELD qtde-coletada  LIKE carg-rural.qtd-coleta
    FIELD qtde-aferida   LIKE carg-rural.qtd-aferid    
    FIELD rejeicao       LIKE liber-carg.codigo-rejei
    FIELD ds-rejeicao    LIKE cod-rejeicao.descricao
    FIELD analise-nc     AS CHARACTER                  /* Percorrer a histor-naocfedade da NC. Se houver histor-naocfedade.idi-tip-histor = 2, exibir "Penaliza", se 3 exibir "NÆo penaliza", se nÆo houver nenhum dos dois exibir "Pendente".*/
    FIELD tot-penaliz    AS DECIMAL                    /* Somat¢rio das penaliza‡äes daquela NC: dest-cust-naocfedade.val-dest*/
    FIELD des-naocfedade AS CHARACTER
    .
        
DEFINE TEMP-TABLE tt-param-planilha NO-UNDO
    FIELD descricao AS CHARACTER
    FIELD valor     AS CHARACTER
    .

/** Titulo Colunas Planilha **/
