/*a partir das cargas e das regras, é formada a tt-fechto-com que será base para exibição
do relatório de simulação*/

CREATE BUFFER bh FOR TABLE "produt-carg":U.
CREATE QUERY qh.

qh:SET-BUFFERS(bh). 
qh:QUERY-PREPARE(cQuery).
qh:FORWARD-ONLY.  
qh:QUERY-OPEN().

REPEAT:   /*FOR EACH produt-carg*/
    qh:GET-NEXT().
    IF qh:QUERY-OFF-END THEN LEAVE.   

    IF  l-estab-security-active /*segurança por estabelecimento*/
    AND NOT CAN-FIND (FIRST {&ESTAB-SEC-TT} WHERE {&ESTAB-SEC-TT-FIELD} = bh:BUFFER-FIELD("cod-estabel":U):BUFFER-VALUE) THEN       
        NEXT.    

    ASSIGN c-cod-regiao      = ""
           c-cod-rota        = ""
           c-cod-propriedade = ""
           i-cdn-grp-produt  = 0
           i-num-regras      = 0
           l-achou           = false.

    FOR FIRST carg-rural FIELDS(cod-rota val-frete qtd-coleta) NO-LOCK 
        WHERE carg-rural.num-carg = int(bh:BUFFER-FIELD("num-carg":U):BUFFER-VALUE):
        
        ASSIGN c-cod-rota        = carg-rural.cod-rota
               de-val-frete-carg = carg-rural.val-frete / carg-rural.qtd-coleta. /*valor do frete na carga por litro*/

    END.

    FOR FIRST produt-rural FIELDS(cdn-grp-produt) NO-LOCK 
        WHERE produt-rural.cdn-produt-rural = int(bh:BUFFER-FIELD("cdn-produt-rural":U):BUFFER-VALUE):
        ASSIGN i-cdn-grp-produt = produt-rural.cdn-grp-produt.
    END.

    FOR FIRST pto-coleta FIELDS(cod-regiao cod-pto-coleta cod-propried) NO-LOCK 
        WHERE pto-coleta.cod-pto-coleta = bh:BUFFER-FIELD("cod-pto-coleta":U):BUFFER-VALUE:
        
        ASSIGN c-cod-regiao = pto-coleta.cod-regiao
               c-cod-propriedade = bh:BUFFER-FIELD("cod-propried":U):BUFFER-VALUE.

        FOR FIRST produt-pto-coleta FIELDS(cod-propried) NO-LOCK 
            WHERE produt-pto-coleta.cod-pto-coleta   = pto-coleta.cod-pto-coleta
              AND produt-pto-coleta.cdn-produt-rural = int(bh:BUFFER-FIELD("cdn-produt-rural":U):BUFFER-VALUE):
            
            IF c-cod-propriedade = "" THEN
                ASSIGN c-cod-propriedade = produt-pto-coleta.cod-propried.

        END.
        
        IF c-cod-propriedade = "" THEN 
            ASSIGN c-cod-propriedade = pto-coleta.cod-propried.

        FOR FIRST propried-rural FIELDS(cod-rota-princ) NO-LOCK
            WHERE propried-rural.cod-propried = c-cod-propriedade:

            ASSIGN c-cod-rota = propried-rural.cod-rota-princ.

        END.    

        IF c-cod-rota = "" AND AVAIL carg-rural THEN
            ASSIGN c-cod-rota = carg-rural.cod-rota.

    END.
    
    FOR FIRST tt-carg-produt-propried WHERE tt-carg-produt-propried.cod-propriedade  = c-cod-propriedade  /*se encontrar registro, sumariza*/
                                        AND tt-carg-produt-propried.cdn-produt-rural = INT(bh:BUFFER-FIELD("cdn-produt-rural":U):BUFFER-VALUE): END.

    IF NOT AVAIL tt-carg-produt-propried THEN DO: /*caso seja a primeira carga do produtor/propriedade*/
        CREATE tt-carg-produt-propried.    
        ASSIGN tt-carg-produt-propried.cdn-produt-rural  = INT(bh:BUFFER-FIELD("cdn-produt-rural":U):BUFFER-VALUE)
               tt-carg-produt-propried.cod-propriedade   = c-cod-propriedade
               tt-carg-produt-propried.cdn-grp-produt    = i-cdn-grp-produt
               tt-carg-produt-propried.pre-base-ok       = FALSE.
    
    END.
    
    FOR EACH tt-regra-form-preco WHERE tt-regra-form-preco.da-dia = date(bh:BUFFER-FIELD("dat-trans":U):BUFFER-VALUE)
        BREAK BY tt-regra-form-preco.cdn-abrangen:

        IF l-achou THEN 
            leave.
            
        case tt-regra-form-preco.cdn-abrangen:
            WHEN 1 THEN DO: /*Ponto Coleta*/
                IF bh:BUFFER-FIELD("cod-pto-coleta":U):BUFFER-VALUE <> tt-regra-form-preco.cod-pto-coleta THEN
                    NEXT.
                ASSIGN l-achou = TRUE.    
            END.
            WHEN 2 THEN DO: /*Propriedade*/
                IF c-cod-propriedade <> tt-regra-form-preco.cod-propried THEN
                    NEXT.
                ASSIGN l-achou = TRUE.    
            END.
            WHEN 3 THEN DO: /*Produtor*/
                IF INT(bh:BUFFER-FIELD("cdn-produt-rural":U):BUFFER-VALUE) <> tt-regra-form-preco.cdn-produt-rural THEN
                    NEXT.
                ASSIGN l-achou = TRUE.
            END.
            WHEN 4 THEN DO: /*Grupo*/
                IF i-cdn-grp-produt <> tt-regra-form-preco.cdn-grp-produt THEN
                    NEXT.
                ASSIGN l-achou = TRUE.
            END.
            WHEN 5 THEN DO: /*Rota*/
                IF c-cod-rota <> tt-regra-form-preco.cod-rota THEN
                    next.
                ASSIGN l-achou = TRUE.
            END.
            WHEN 6 THEN DO: /*Região*/
                IF c-cod-regiao <> tt-regra-form-preco.cod-regiao THEN
                    NEXT.
                ASSIGN l-achou = TRUE.
            END.
            WHEN 7 THEN DO: /*Estabelecimento*/
                IF bh:BUFFER-FIELD("cod-estabel":U):BUFFER-VALUE <> tt-regra-form-preco.cod-estabel THEN
                    NEXT.
                ASSIGN l-achou = TRUE.
            END.
            WHEN 8 THEN DO: /*Todos*/
                ASSIGN l-achou = TRUE.
            END.
        END CASE.
        
        i-num-regras = i-num-regras + 1.   
        IF i-num-regras <> 1 THEN DO: /*encontou nenhuma ou mais de uma regra*/
            /*Não encontrado Regra de Preço para Carga &1, Produtor: &2, Propriedade: &3 e Data: &4.*/
            RUN criaRowErrors IN THIS-PROCEDURE(INPUT 55213,
                                                INPUT "STRING((bh:BUFFER-FIELD('num-carg':U):BUFFER-VALUE))          + '~~~~' +
                                                       STRING((bh:BUFFER-FIELD('cdn-produt-rural':U):BUFFER-VALUE))  + '~~~~' +
                                                       STRING(c-cod-propriedade)                                     + '~~~~' +
                                                       STRING(date(bh:BUFFER-FIELD('dat-trans':U):BUFFER-VALUE))" ).

        END.
        ELSE DO: /*encontrou regra £nica*/
            
            {aqp/aqapi001.i5} /*cria‡Æo com sumariza‡Æo das cargas pelas regras*/

        END.    /*encontrou regra £nica*/

    END. /*FOR EACH tt-regra-form-preco*/
   
END. /*REPEAT*/

FOR EACH  tt-carg-produt-periodo 
    WHERE tt-carg-produt-periodo.cod-estabel       >= tt-param.cod-estabel-ini        
    AND   tt-carg-produt-periodo.cod-estabel       <= tt-param.cod-estabel-fim  
    AND   tt-carg-produt-periodo.cod-regiao        >= tt-param.cod-regiao-ini  
    AND   tt-carg-produt-periodo.cod-regiao        <= tt-param.cod-regiao-fim  
    AND   tt-carg-produt-periodo.cod-rota          >= tt-param.cod-rota-ini                                  
    AND   tt-carg-produt-periodo.cod-rota          <= tt-param.cod-rota-fim
    AND   tt-carg-produt-periodo.cdn-grp-produt    >= tt-param.cdn-grp-produt-ini
    AND   tt-carg-produt-periodo.cdn-grp-produt    <= tt-param.cdn-grp-produt-fim
    AND   tt-carg-produt-periodo.cdn-produt-rural  >= tt-param.cdn-produt-rural-ini    
    AND   tt-carg-produt-periodo.cdn-produt-rural  <= tt-param.cdn-produt-rural-fim  
    AND   tt-carg-produt-periodo.propriedade-rural >= tt-param.cod-propried-ini      
    AND   tt-carg-produt-periodo.propriedade-rural <= tt-param.cod-propried-fim
    BY tt-carg-produt-periodo.cdn-produt-rural  
    BY tt-carg-produt-periodo.propriedade-rural:     

    CREATE tt-fechto-com.
    ASSIGN tt-fechto-com.cod-period          = tt-param.cod-period
           tt-fechto-com.cdn-produt-rural    = tt-carg-produt-periodo.cdn-produt-rural
           tt-fechto-com.cod-propried        = tt-carg-produt-periodo.propriedade-rural
           tt-fechto-com.it-codigo           = tt-carg-produt-periodo.it-codigo
           tt-fechto-com.cod-estabel         = tt-carg-produt-periodo.cod-estabel.

    /* caso encontre tabela no sistema, prevalece a já calculada */
    FOR FIRST fechto-produt-period WHERE fechto-produt-period.cod-period       = tt-param.cod-period
                                     AND fechto-produt-period.cdn-produt-rural = tt-carg-produt-periodo.cdn-produt-rural
                                     AND fechto-produt-period.cod-propried     = tt-carg-produt-periodo.propriedade-rural
                                     AND fechto-produt-period.it-codigo        = tt-carg-produt-periodo.it-codigo
                                     AND fechto-produt-period.cod-estabel      = tt-carg-produt-periodo.cod-estabel NO-LOCK:

        ASSIGN tt-fechto-com.val-bonus-fix-inf   = fechto-produt-period.val-bonus-fix-inf
               tt-fechto-com.val-preco-final-inf = fechto-produt-period.val-preco-final-inf.

    END.

    ASSIGN tt-fechto-com.qtd-period          = tt-carg-produt-periodo.tot-qtd-coleta
           tt-fechto-com.val-preco-base      = tt-carg-produt-periodo.val-med-per
           tt-fechto-com.val-var-qualid      = 0
           tt-fechto-com.val-var-volum       = 0
           tt-fechto-com.val-bonus-fix       = 0
           tt-fechto-com.val-frete           = tt-carg-produt-periodo.val-frete
           tt-fechto-com.val-preco-final-inf = IF tt-fechto-com.val-preco-final-inf <> 0 THEN tt-fechto-com.val-preco-final-inf
                                                                                         ELSE 0.

    RUN pi-calculo-imposto-sanidade (INPUT  tt-fechto-com.cod-estabel,
                                     INPUT  tt-fechto-com.qtd-period, /* Volume do mes - variavel: VOLUME_MES */
                                     OUTPUT tt-fechto-com.val-impto).

    DELETE tt-carg-produt-periodo.

END.   
