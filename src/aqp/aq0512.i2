    IF tt-dados-ensaio-pagtoV2.cod-rota < tt-param.cod-rota-ini OR
       tt-dados-ensaio-pagtoV2.cod-rota > tt-param.cod-rota-fim THEN
        NEXT.

    IF tt-dados-ensaio-pagtoV2.cod-regiao < tt-param.cod-regiao-ini OR
       tt-dados-ensaio-pagtoV2.cod-regiao > tt-param.cod-regiao-fim THEN
        NEXT.

    IF tt-dados-ensaio-pagtoV2.cdn-grp-produt < tt-param.cdn-grp-produt-ini OR
       tt-dados-ensaio-pagtoV2.cdn-grp-produt > tt-param.cdn-grp-produt-fim THEN
        NEXT.

    RUN piNewLine IN h-utapi033.

    RUN piLine IN h-utapi033 (INPUT 01, INPUT tt-dados-ensaio-pagtoV2.cdn-produt-rural).
    RUN piLine IN h-utapi033 (INPUT 02, INPUT tt-dados-ensaio-pagtoV2.nome-emit).
    RUN piLine IN h-utapi033 (INPUT 03, INPUT tt-dados-ensaio-pagtoV2.cnpj).
    RUN piLine IN h-utapi033 (INPUT 04, INPUT tt-dados-ensaio-pagtoV2.ins-estadual).
    RUN piLine IN h-utapi033 (INPUT 05, INPUT tt-dados-ensaio-pagtoV2.cod-pto-coleta).
    RUN piLine IN h-utapi033 (INPUT 06, INPUT tt-dados-ensaio-pagtoV2.des-pto-coleta).
    RUN piLine IN h-utapi033 (INPUT 07, INPUT tt-dados-ensaio-pagtoV2.cod-propried).
    RUN piLine IN h-utapi033 (INPUT 08, INPUT tt-dados-ensaio-pagtoV2.des-propried).
    RUN piLine IN h-utapi033 (INPUT 09, INPUT tt-dados-ensaio-pagtoV2.cdn-grp-produt).
    RUN piLine IN h-utapi033 (INPUT 10, INPUT tt-dados-ensaio-pagtoV2.des-grp-produt).
    RUN piLine IN h-utapi033 (INPUT 11, INPUT tt-dados-ensaio-pagtoV2.cod-rota).
    RUN piLine IN h-utapi033 (INPUT 12, INPUT tt-dados-ensaio-pagtoV2.des-rota).
    RUN piLine IN h-utapi033 (INPUT 13, INPUT tt-dados-ensaio-pagtoV2.cod-regiao).
    RUN piLine IN h-utapi033 (INPUT 14, INPUT tt-dados-ensaio-pagtoV2.des-regiao).
    RUN piLine IN h-utapi033 (INPUT 15, INPUT tt-dados-ensaio-pagtoV2.cidade).
    RUN piLine IN h-utapi033 (INPUT 16, INPUT tt-dados-ensaio-pagtoV2.uf).

    IF tt-dados-ensaio-pagtoV2.qtd-period = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.qtd-period = 0.
    RUN piLine IN h-utapi033 (INPUT 17, INPUT tt-dados-ensaio-pagtoV2.qtd-period).
    
    IF tt-dados-ensaio-pagtoV2.val-preco-base = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-preco-base = 0.
    RUN piLine IN h-utapi033 (INPUT 18, INPUT tt-dados-ensaio-pagtoV2.val-preco-base).

    IF tt-dados-ensaio-pagtoV2.val-var-qualid = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-var-qualid = 0.
    RUN piLine IN h-utapi033 (INPUT 19, INPUT tt-dados-ensaio-pagtoV2.val-var-qualid).

    IF tt-dados-ensaio-pagtoV2.val-var-volum = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-var-volum = 0.
    RUN piLine IN h-utapi033 (INPUT 20, INPUT tt-dados-ensaio-pagtoV2.val-var-volum).
    
    IF tt-dados-ensaio-pagtoV2.val-bonus-fix = ? THEN 
        ASSIGN tt-dados-ensaio-pagtoV2.val-bonus-fix = 0.
    RUN piLine IN h-utapi033 (INPUT 21, INPUT tt-dados-ensaio-pagtoV2.val-bonus-fix).

    IF tt-dados-ensaio-pagtoV2.val-pre-unit = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-pre-unit = 0.
    RUN piLine IN h-utapi033 (INPUT 22, INPUT tt-dados-ensaio-pagtoV2.val-pre-unit).

    IF tt-dados-ensaio-pagtoV2.val-bonus-fix-inf = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-bonus-fix-inf = 0.
    RUN piLine IN h-utapi033 (INPUT 23, INPUT tt-dados-ensaio-pagtoV2.val-bonus-fix-inf).

    IF tt-dados-ensaio-pagtoV2.val-preco-final-inf = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-preco-final-inf = 0.
    RUN piLine IN h-utapi033 (INPUT 24, INPUT tt-dados-ensaio-pagtoV2.val-preco-final-inf).

    IF tt-dados-ensaio-pagtoV2.val-pre-liq-ant = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-pre-liq-ant = 0.
    RUN piLine IN h-utapi033 (INPUT 25, INPUT tt-dados-ensaio-pagtoV2.val-pre-liq-ant).

    IF tt-dados-ensaio-pagtoV2.val-ajuste = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-ajuste = 0.
    RUN piLine IN h-utapi033 (INPUT 26, INPUT tt-dados-ensaio-pagtoV2.val-ajuste).

    IF tt-dados-ensaio-pagtoV2.val-incentivo = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-incentivo = 0.
    RUN piLine IN h-utapi033 (INPUT 27, INPUT tt-dados-ensaio-pagtoV2.val-incentivo).

    IF tt-dados-ensaio-pagtoV2.val-pre-bruto = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-pre-bruto = 0.
    RUN piLine IN h-utapi033 (INPUT 28, INPUT tt-dados-ensaio-pagtoV2.val-pre-bruto).

    IF tt-dados-ensaio-pagtoV2.val-tot-prov = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-tot-prov = 0.
    RUN piLine IN h-utapi033 (INPUT 29, INPUT tt-dados-ensaio-pagtoV2.val-tot-prov).

    IF tt-dados-ensaio-pagtoV2.val-outr-cred = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-outr-cred = 0.
    RUN piLine IN h-utapi033 (INPUT 30, INPUT tt-dados-ensaio-pagtoV2.val-outr-cred).

    IF tt-dados-ensaio-pagtoV2.val-adiantamentos = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-adiantamentos = 0.
    RUN piLine IN h-utapi033 (INPUT 31, INPUT tt-dados-ensaio-pagtoV2.val-adiantamentos).

    IF tt-dados-ensaio-pagtoV2.val-emprestimos = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-emprestimos = 0.
    RUN piLine IN h-utapi033 (INPUT 32, INPUT tt-dados-ensaio-pagtoV2.val-emprestimos).

    IF tt-dados-ensaio-pagtoV2.val-convenios = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-convenios = 0.
    RUN piLine IN h-utapi033 (INPUT 33, INPUT tt-dados-ensaio-pagtoV2.val-convenios).

    IF tt-dados-ensaio-pagtoV2.val-outr-debitos = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-outr-debitos = 0.
    RUN piLine IN h-utapi033 (INPUT 34, INPUT tt-dados-ensaio-pagtoV2.val-outr-debitos).

    IF tt-dados-ensaio-pagtoV2.val-desconto-tot = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-desconto-tot = 0.
    RUN piLine IN h-utapi033 (INPUT 35, INPUT tt-dados-ensaio-pagtoV2.val-desconto-tot).

    IF tt-dados-ensaio-pagtoV2.val-imp-retido = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-imp-retido = 0.
    RUN piLine IN h-utapi033 (INPUT 36, INPUT tt-dados-ensaio-pagtoV2.val-imp-retido).
    
    IF tt-dados-ensaio-pagtoV2.val-impto = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-impto = 0.
    RUN piLine IN h-utapi033 (INPUT 37, INPUT tt-dados-ensaio-pagtoV2.val-impto).
    
    IF tt-dados-ensaio-pagtoV2.val-liq-receb-tot = ? THEN
        ASSIGN tt-dados-ensaio-pagtoV2.val-liq-receb-tot = 0.
    RUN piLine IN h-utapi033 (INPUT 38, INPUT tt-dados-ensaio-pagtoV2.val-liq-receb-tot).

    RUN piLine IN h-utapi033 (INPUT 39, INPUT tt-dados-ensaio-pagtoV2.banco).
    RUN piLine IN h-utapi033 (INPUT 40, INPUT tt-dados-ensaio-pagtoV2.agencia).
    RUN piLine IN h-utapi033 (INPUT 41, INPUT tt-dados-ensaio-pagtoV2.conta).
    RUN piLine IN h-utapi033 (INPUT 42, INPUT tt-dados-ensaio-pagtoV2.cod-correntista).
    RUN piLine IN h-utapi033 (INPUT 43, INPUT tt-dados-ensaio-pagtoV2.titular).
    RUN piLine IN h-utapi033 (INPUT 44, INPUT tt-dados-ensaio-pagtoV2.id-unico-emit).
    RUN piLine IN h-utapi033 (INPUT 45, INPUT SUBSTRING(tt-dados-ensaio-pagtoV2.cod-period,1,2) + "/" + SUBSTRING(tt-dados-ensaio-pagtoV2.cod-period,3,4)). 
    RUN piLine IN h-utapi033 (INPUT 46, INPUT tt-param.it-codigo).
    RUN piLine IN h-utapi033 (INPUT 47, INPUT tt-param.desc-item).
    RUN piLine IN h-utapi033 (INPUT 48, INPUT tt-dados-ensaio-pagtoV2.cod-estab).
    RUN piLine IN h-utapi033 (INPUT 49, INPUT tt-dados-ensaio-pagtoV2.nro-docto).
    RUN piLine IN h-utapi033 (INPUT 50, INPUT tt-dados-ensaio-pagtoV2.serie-docto).

