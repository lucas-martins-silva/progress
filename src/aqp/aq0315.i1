/* Query definitions                                                    */
&ANALYZE-SUSPEND
DEFINE QUERY brFechto FOR 
      tt-fechto-produt-period SCROLLING.
&ANALYZE-RESUME

/* Browse definitions                                                   */
DEFINE BROWSE brFechto
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _DISPLAY-FIELDS brFechto wMaintenance _STRUCTURED
  QUERY brFechto NO-LOCK DISPLAY
      tt-fechto-produt-period.checkSum COLUMN-LABEL "*" FORMAT "x(1)":U
            WIDTH 1.43
      tt-fechto-produt-period.cdn-produt-rural FORMAT ">>>,>>>,>>9":U
      tt-fechto-produt-period.nome-abrev COLUMN-LABEL "Produtor Rural" FORMAT "x(16)":U
            WIDTH 10.43
      tt-fechto-produt-period.grp-produt COLUMN-LABEL "Grupo" FORMAT "X(60)":U
            WIDTH 19.43
      tt-fechto-produt-period.cod-regiao FORMAT "x(12)":U
      tt-fechto-produt-period.cod-propried FORMAT "x(16)":U
      tt-fechto-produt-period.cod-rota FORMAT "x(12)":U
      tt-fechto-produt-period.cod-estabel FORMAT "x(5)":U WIDTH 5
      tt-fechto-produt-period.qtd-period COLUMN-LABEL "Qtd Per¡odo" FORMAT "->>>,>>>,>>9.9999":U
      tt-fechto-produt-period.val-preco-final-inf FORMAT ">>9.9999":U
            WIDTH 10.14 COLUMN-FONT 0
      tt-fechto-produt-period.val-var-qualid FORMAT "->>>,>>9.9999":U
            WIDTH 11.43
      tt-fechto-produt-period.val-var-volum FORMAT "->>>,>>9.9999":U
            WIDTH 9.43
      tt-fechto-produt-period.val-bonus-fix FORMAT "->>>,>>9.9999":U
            WIDTH 8.43
      tt-fechto-produt-period.val-preco-base FORMAT ">>>>>,>>>,>>9.9999":U
            WIDTH 11.43
      tt-fechto-produt-period.val-per-anterior COLUMN-LABEL "Final Anterior" FORMAT ">>>>>,>>>,>>9.9999":U
            WIDTH 9.86
      tt-fechto-produt-period.diferenca COLUMN-LABEL "Diferen‡a" FORMAT "->>>>>,>>>,>>9.9999":U
            WIDTH 8.43
      tt-fechto-produt-period.val-preco-base + tt-fechto-produt-period.val-var-qualid + tt-fechto-produt-period.val-var-volum + tt-fechto-produt-period.val-bonus-fix COLUMN-LABEL "Pre Unit" FORMAT ">>>>>,>>>,>>9.9999":U
            WIDTH 7.14
      tt-fechto-produt-period.val-bonus-fix-inf COLUMN-LABEL "B“nus Informado" FORMAT "->>>,>>9.9999":U
            WIDTH 10.86
      tt-fechto-produt-period.val-livre-1 COLUMN-LABEL "Ajuste" FORMAT "->>>>>>>>>>>9.9999":U
            WIDTH 10.43
      tt-fechto-produt-period.val-impto FORMAT ">>>,>>>,>>>,>>9.9999":U
      tt-fechto-produt-period.val-total COLUMN-LABEL "Total" FORMAT ">>>>>>>>,>>>,>>9.9999":U
            WIDTH 13.72
      tt-fechto-produt-period.val-frete FORMAT ">>>,>>>,>>>,>>9.9999":U
            WIDTH 5.72
      tt-fechto-produt-period.cidade FORMAT "x(20)":U
      fnSituacao(tt-fechto-produt-period.idi-situacao) COLUMN-LABEL "Situa‡Æo" FORMAT "x(15)":U
  ENABLE
      tt-fechto-produt-period.val-preco-final-inf
/* _UIB-CODE-BLOCK-END */
