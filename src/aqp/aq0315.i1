/* ************************  Control Triggers  ************************ */

&Scoped-define SELF-NAME wMaintenance
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL wMaintenance wMaintenance
ON END-ERROR OF wMaintenance
OR ENDKEY OF {&WINDOW-NAME} ANYWHERE DO:
  /* This case occurs when the user presses the "Esc" key.
     In a persistently run window, just ignore this.  If we did not, the
     application would exit. */
  IF THIS-PROCEDURE:PERSISTENT THEN RETURN NO-APPLY.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL wMaintenance wMaintenance
ON WINDOW-CLOSE OF wMaintenance
DO:
  /* This event will close the window and terminate the procedure.  */
  APPLY "CLOSE":U TO THIS-PROCEDURE.
  RETURN NO-APPLY.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define BROWSE-NAME brFechto
&Scoped-define FRAME-NAME fPage1
&Scoped-define SELF-NAME brFechto
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL brFechto wMaintenance
ON MOUSE-SELECT-DBLCLICK OF brFechto IN FRAME fPage1
DO:
  RUN piMarcarDesmarcar IN THIS-PROCEDURE.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL brFechto wMaintenance
ON ROW-DISPLAY OF brFechto IN FRAME fPage1
DO:
  ASSIGN tt-fechto-produt-period.val-preco-base:BGCOLOR IN BROWSE brFechto = IF tt-fechto-produt-period.val-preco-base > 0 THEN ?  ELSE 14.

  CASE tt-fechto-produt-period.idi-situacao:
    WHEN 1 THEN ASSIGN tt-fechto-produt-period.checkSum:BGCOLOR IN BROWSE brFechto = ?.
    WHEN 2 THEN ASSIGN tt-fechto-produt-period.checkSum:BGCOLOR IN BROWSE brFechto = 10.
    WHEN 3 THEN ASSIGN tt-fechto-produt-period.checkSum:BGCOLOR IN BROWSE brFechto = 11.
  END CASE.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL brFechto wMaintenance
ON VALUE-CHANGED OF brFechto IN FRAME fPage1
DO:
  RUN piHabilitarBotao IN THIS-PROCEDURE.

  /* Execu‡Æo de tela de Consulta */
  IF "{1}" = "AQ0415" THEN DO:
     ASSIGN tt-fechto-produt-period.val-preco-final-inf:READ-ONLY IN BROWSE brFechto = YES.
  END.
  ELSE DO:
    /*teste para situação da "linha" do período. caso já tenha gerado a NF, não será possível alterar os valores*/ 
    IF AVAIL tt-fechto-produt-period THEN DO:
      IF tt-fechto-produt-period.idi-situacao = 3 /*NF Gerada*/ THEN
        ASSIGN tt-fechto-produt-period.val-preco-final-inf:READ-ONLY IN BROWSE brFechto = YES.
      ELSE  
        ASSIGN tt-fechto-produt-period.val-preco-final-inf:READ-ONLY IN BROWSE brFechto = NO.
    END.
  END.


END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define FRAME-NAME fpage0
&Scoped-define SELF-NAME bt-cancel
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL bt-cancel wMaintenance
ON CHOOSE OF bt-cancel IN FRAME fpage0 /* Cancelar */
DO:
    APPLY "CLOSE":U TO THIS-PROCEDURE.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME bt-carregar-dados
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL bt-carregar-dados wMaintenance
ON CHOOSE OF bt-carregar-dados IN FRAME fpage0 /* Carregar Dados */
DO:

  RUN criaTTFiltro IN THIS-PROCEDURE. /*caso j  tenha sido criado a tt, utiliza como filtro*/
  RUN piOpenQuery  IN THIS-PROCEDURE. /*carrega o browse com base na tt-filto*/
    
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define FRAME-NAME fPage1
&Scoped-define SELF-NAME bt-observacao
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL bt-observacao wMaintenance
ON CHOOSE OF bt-observacao IN FRAME fPage1 /* Observa‡Æo */
DO:

    IF brFechto:NUM-SELECTED-ROWS = 1 THEN DO:

        ASSIGN c-observacao = tt-fechto-produt-period.cod-livre-2.  /* observacao gravado no cod-livre-2 */
        
        {&WINDOW-NAME}:SENSITIVE = NO.
        RUN aqp/aq0315b.w(INPUT-OUTPUT c-observacao,   
                          INPUT        IF "{1}" = "AQ0415" THEN 3 /*"Com NF gerada"*/                  /* Consulta somente ser  visualizada a observa‡Æo     */
                                                           ELSE tt-fechto-produt-period.idi-situacao). /* se situacao = "Com NF gerada", nÆo permite alterar */
        
        ASSIGN tt-fechto-produt-period.cod-livre-2 = c-observacao.  
        
        {&WINDOW-NAME}:SENSITIVE = YES.

    END.
    ELSE
        RUN utp/ut-msgs.p (INPUT "show":U,
                           INPUT 32002,
                           INPUT "":U).

END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define FRAME-NAME fpage0
&Scoped-define SELF-NAME bt-save
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL bt-save wMaintenance
ON CHOOSE OF bt-save IN FRAME fpage0 /* Confirmar */
DO:
    /*RUN saveRecord IN THIS-PROCEDURE.*/
    
    {utp/ut-liter.i "atualiza‡Æo_dos_valores_selecionados" *}
    RUN utp/ut-msgs.p (INPUT "show",
                       INPUT 701,
                       INPUT RETURN-VALUE).

    IF RETURN-VALUE = "YES":U THEN DO:
    
        RUN piVerificarRegistros IN THIS-PROCEDURE.
        
        IF RETURN-VALUE = "OK":U THEN 
            RUN piGravarRegistros IN THIS-PROCEDURE.

    END.
    ELSE
        RETURN "NOK":U.

    RUN piOpenQuery IN THIS-PROCEDURE.

    RETURN "OK":U.

END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME bt-selecao
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL bt-selecao wMaintenance
ON CHOOSE OF bt-selecao IN FRAME fpage0
DO:
    {&WINDOW-NAME}:SENSITIVE = NO.

    RUN criaTTFiltro IN THIS-PROCEDURE. /*caso nÆo tenha sido criado a tt, ir  criar*/
    
    RUN aqp/aq0315a.w(INPUT-OUTPUT TABLE tt-filtro).
    IF RETURN-VALUE = "OK" THEN
        RUN piOpenQuery IN THIS-PROCEDURE.

    {&WINDOW-NAME}:SENSITIVE = YES.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define FRAME-NAME fPage1
&Scoped-define SELF-NAME btDesmarcar
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btDesmarcar wMaintenance
ON CHOOSE OF btDesmarcar IN FRAME fPage1 /* Desmarcar */
DO:
  RUN piMarcarDesmarcar IN THIS-PROCEDURE.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define FRAME-NAME fpage0
&Scoped-define SELF-NAME btExit
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btExit wMaintenance
ON CHOOSE OF btExit IN FRAME fpage0 /* Exit */
OR CHOOSE OF MENU-ITEM miExit IN MENU mbMain DO:
    APPLY "CLOSE":U TO THIS-PROCEDURE.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME btHelp
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btHelp wMaintenance
ON CHOOSE OF btHelp IN FRAME fpage0 /* Help */
OR CHOOSE OF MENU-ITEM miContents IN MENU mbMain DO:
    {include/ajuda.i}
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define FRAME-NAME fPage1
&Scoped-define SELF-NAME btMarcar
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btMarcar wMaintenance
ON CHOOSE OF btMarcar IN FRAME fPage1 /* Marcar */
DO:
    RUN piMarcarDesmarcar IN THIS-PROCEDURE.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME btNenhum
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btNenhum wMaintenance
ON CHOOSE OF btNenhum IN FRAME fPage1 /* Nenhum */
DO:
    FOR EACH tt-fechto-produt-period:
        ASSIGN tt-fechto-produt-period.checkSum =  "".
    END.
   
   {&OPEN-QUERY-brFechto}

   RUN piHabilitarBotao IN THIS-PROCEDURE.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define FRAME-NAME fpage0
&Scoped-define SELF-NAME btQueryJoins
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btQueryJoins wMaintenance
ON CHOOSE OF btQueryJoins IN FRAME fpage0 /* Query Joins */
OR CHOOSE OF MENU-ITEM miQueryJoins IN MENU mbMain DO:
    RUN showQueryJoins IN THIS-PROCEDURE.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME btReportsJoins
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btReportsJoins wMaintenance
ON CHOOSE OF btReportsJoins IN FRAME fpage0 /* Reports Joins */
OR CHOOSE OF MENU-ITEM miReportsJoins IN MENU mbMain DO:
    RUN showReportsJoins IN THIS-PROCEDURE.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define FRAME-NAME fPage1
&Scoped-define SELF-NAME btTodos
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btTodos wMaintenance
ON CHOOSE OF btTodos IN FRAME fPage1 /* Todos */
DO:
    FOR EACH tt-fechto-produt-period
        WHERE tt-fechto-produt-period.idi-situacao <> 3:
        ASSIGN tt-fechto-produt-period.checkSum =  "*".
    END.
   
   {&OPEN-QUERY-brFechto}

   RUN piHabilitarBotao IN THIS-PROCEDURE.

END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define FRAME-NAME fpage0
&Scoped-define SELF-NAME cb-item
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL cb-item wMaintenance
ON VALUE-CHANGED OF cb-item IN FRAME fpage0 /* Item */
DO: 
    
    RUN goToKey IN h-boin172na (INPUT cb-item:SCREEN-VALUE IN FRAME fPage0) NO-ERROR.

    IF RETURN-VALUE = "OK":U THEN DO:
        RUN findDescItem IN h-boin00983 (INPUT SELF:SCREEN-VALUE IN FRAME fPage0, OUTPUT c-desc-item) NO-ERROR. 
        ASSIGN c-desc-item:SCREEN-VALUE IN FRAME fPage0 = c-desc-item.
    END.
    ELSE 
        ASSIGN c-desc-item:SCREEN-VALUE IN FRAME fPage0 = "".

    RUN criaTTFiltro IN THIS-PROCEDURE. /*caso nÆo tenha sido criado a tt, ir  criar*/

END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME tt-fechto-produt-period.cod-period
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL tt-fechto-produt-period.cod-period wMaintenance
ON LEAVE OF tt-fechto-produt-period.cod-period IN FRAME fpage0 /* Periodo */
DO:

    RUN criaTTFiltro IN THIS-PROCEDURE. /*caso nÆo tenha sido criado a tt, ir  criar*/
          
    RETURN "OK":U.

END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME miAbout
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL miAbout wMaintenance
ON CHOOSE OF MENU-ITEM miAbout /* Sobre... */
DO:
  {include/sobre.i}
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME m_Seleo
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL m_Seleo wMaintenance
ON CHOOSE OF MENU-ITEM m_Seleo /* Sele‡Æo */
DO:
  APPLY "CHOOSE":U TO bt-selecao IN FRAME fPage0.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&UNDEFINE SELF-NAME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _MAIN-BLOCK wMaintenance 


/*:T--- L¢gica para inicializa‡Æo do programam ---*/
{maintenance/mainblock.i}

ON 'LEAVE':U OF tt-fechto-produt-period.val-preco-final-inf IN BROWSE brFechto
DO:

    IF DEC(tt-fechto-produt-period.val-preco-final-inf:SCREEN-VALUE IN BROWSE brFechto) <= 0 THEN DO:
        ASSIGN tt-fechto-produt-period.val-preco-final-inf:SCREEN-VALUE IN BROWSE brFechto = STRING(tt-fechto-produt-period.val-preco-base 
                                                                                                  + tt-fechto-produt-period.val-var-qualid 
                                                                                                  + tt-fechto-produt-period.val-var-volum 
                                                                                                  + tt-fechto-produt-period.val-bonus-fix-inf).
        
        RUN utp/ut-msgs.p (INPUT "show",
                           INPUT 206,
                           INPUT "").

        APPLY "ENTRY":U TO tt-fechto-produt-period.val-preco-final-inf IN BROWSE brFechto.
       
    END.
    ELSE DO:
        ASSIGN de-tot-valor-old = tt-fechto-produt-period.val-preco-final-inf * tt-fechto-produt-period.qtd-period.
        
        ASSIGN tt-fechto-produt-period.val-preco-final-inf = DEC(tt-fechto-produt-period.val-preco-final-inf:SCREEN-VALUE IN BROWSE brFechto)
               tt-fechto-produt-period.val-bonus-fix-inf   = tt-fechto-produt-period.val-preco-final-inf  - ~
                                                                  (tt-fechto-produt-period.val-preco-base + ~
                                                                   tt-fechto-produt-period.val-var-qualid + ~
                                                                   tt-fechto-produt-period.val-var-volum)
               tt-fechto-produt-period.val-total           = tt-fechto-produt-period.qtd-period * tt-fechto-produt-period.val-preco-final-inf
               tt-fechto-produt-period.diferenca           = tt-fechto-produt-period.val-preco-final-inf - ~
                                                             tt-fechto-produt-period.val-per-anterior.
        
        ASSIGN de-tot-valor:SCREEN-VALUE IN FRAME fPage1 = STRING(DEC(de-tot-valor:SCREEN-VALUE IN FRAME fPage1) + tt-fechto-produt-period.val-total - de-tot-valor-old).
        
    END.

    IF VALID-HANDLE(h-boin00999) THEN DO:

        RUN retornaIncentivo IN h-boin00999(INPUT tt-fechto-produt-period.cod-period,
                                            INPUT tt-fechto-produt-period.cdn-produt-rural,
                                            INPUT tt-fechto-produt-period.it-codigo,
                                            INPUT tt-fechto-produt-period.cod-estabel,
                                            INPUT tt-fechto-produt-period.qtd-period,
                                            INPUT tt-fechto-produt-period.val-preco-base:SCREEN-VALUE IN BROWSE brFechto,
                                            INPUT tt-fechto-produt-period.val-var-volum,
                                            INPUT tt-fechto-produt-period.val-bonus-fix-inf:SCREEN-VALUE IN BROWSE brFechto,
                                            INPUT tt-fechto-produt-period.val-var-qualid,
                                            INPUT tt-fechto-produt-period.val-preco-final-inf:SCREEN-VALUE IN BROWSE brFechto,
                                            OUTPUT tt-fechto-produt-period.val-livre-1,
                                            OUTPUT i-val-incentivo,
                                            OUTPUT i-val-imp-retido).

    END.

    DISP tt-fechto-produt-period.diferenca
         tt-fechto-produt-period.val-preco-final-inf 
         tt-fechto-produt-period.val-bonus-fix-inf  
         tt-fechto-produt-period.val-total
         tt-fechto-produt-period.val-livre-1 WITH BROWSE brFechto NO-ERROR.
  
END.

ON 'RETURN':U OF tt-fechto-produt-period.val-preco-final-inf IN BROWSE brFechto
DO:
    APPLY 'LEAVE' TO tt-fechto-produt-period.val-preco-final-inf IN BROWSE brFechto.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


/* **********************  Internal Procedures  *********************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE afterDestroyInterface wMaintenance 
PROCEDURE afterDestroyInterface :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

IF VALID-HANDLE(h-boin172na) THEN DO:
    DELETE PROCEDURE h-boin172na.
    ASSIGN h-boin172na = ?.
END.

IF VALID-HANDLE(h-boin627) THEN DO:
    DELETE PROCEDURE h-boin627.
    ASSIGN h-boin627 = ?.
END.

IF VALID-HANDLE(h-boin00968) THEN DO:
    DELETE PROCEDURE h-boin00968.
    ASSIGN h-boin00968 = ?.
END.

IF VALID-HANDLE(h-boin00983) THEN DO:
    DELETE PROCEDURE h-boin00983.
    ASSIGN h-boin00983 = ?.
END.

IF VALID-HANDLE(h-boin627zm) THEN DO:
    DELETE PROCEDURE h-boin627zm.
    ASSIGN h-boin627zm = ?.
END.

IF VALID-HANDLE(h-boin00962) THEN DO:
    DELETE PROCEDURE h-boin00962.
    ASSIGN h-boin00962 = ?.
END.

IF VALID-HANDLE(h-boin00963) THEN DO:
    DELETE PROCEDURE h-boin00963.
    ASSIGN h-boin00963 = ?.
END.

RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE afterDisplayFields wMaintenance 
PROCEDURE afterDisplayFields :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
DEFINE VARIABLE c-list   AS CHARACTER NO-UNDO.

    DO WITH FRAME fPage0:

        RUN findUsuar_mater IN h-boin627 (INPUT c-seg-usuario, OUTPUT c-cod-estabel).

        IF c-cod-estabel = "" THEN DO:
            RUN getCharField IN h-boin627 (INPUT 'char-1', OUTPUT c-cod-estabel).
            ASSIGN c-cod-estabel = SUBSTR(c-cod-estabel,16,5). /* estab usuar */
        END.

        RUN getListItems IN h-boin00983(INPUT c-cod-estabel, OUTPUT c-list).

        IF c-list <> "" THEN DO:
            ASSIGN cb-item:LIST-ITEMS = c-list
                   cb-item:SCREEN-VALUE = ENTRY (1,c-list).

        END.
        
        APPLY 'VALUE-CHANGED':U TO cb-item.

        ASSIGN bt-selecao:SENSITIVE                                = YES
               tt-fechto-produt-period.cod-period:SENSITIVE        = YES
               cb-item:SENSITIVE                                   = YES
               bt-save:SENSITIVE                                   = YES
               bt-cancel:SENSITIVE                                 = YES
               bt-carregar-dados:SENSITIVE                         = YES
               btQueryJoins:SENSITIVE                              = YES
               btReportsJoins:SENSITIVE                            = YES.

    END.
    
    RUN piBuscarPeriodo IN THIS-PROCEDURE.

    DO WITH FRAME fPage1:
    
        ASSIGN btTodos:SENSITIVE       = YES
               btNenhum:SENSITIVE      = YES
               bt-observacao:SENSITIVE = YES.    

    END.
    

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE afterInitializeInterface wMaintenance 
PROCEDURE afterInitializeInterface :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  IF "{1}" = "AQ0415" THEN DO:
    btMarcar   :HIDDEN IN FRAME fPage1 = TRUE.
    btDesmarcar:HIDDEN IN FRAME fPage1 = TRUE.
    btTodos    :HIDDEN IN FRAME fPage1 = TRUE.
    btNenhum   :HIDDEN IN FRAME fPage1 = TRUE.
    bt-save    :HIDDEN IN FRAME fPage0 = TRUE.
    bt-cancel  :HIDDEN IN FRAME fPage0 = TRUE.
  END.

  RETURN 'OK':U.
    
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE criaTTFiltro wMaintenance 
PROCEDURE criaTTFiltro :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEF VAR c-char-1      AS CHAR NO-UNDO.
    DEF VAR c-cod-estabel AS CHAR NO-UNDO.

    FIND FIRST tt-filtro NO-ERROR.
    IF NOT AVAIL tt-filtro THEN DO:

        CREATE tt-filtro.
        ASSIGN tt-filtro.cod-period           = INPUT FRAME fPage0 tt-fechto-produt-period.cod-period
               tt-filtro.it-codigo            = INPUT FRAME fPage0 cb-item
               tt-filtro.cod-estabel-ini      = ""
               tt-filtro.cod-estabel-fim      = "ZZZZZ"
               tt-filtro.cod-regiao-ini       = ""
               tt-filtro.cod-regiao-fim       = "ZZZZZZZZZZZZ"
               tt-filtro.cod-rota-ini         = ""
               tt-filtro.cod-rota-fim         = "ZZZZZZZZZZZZ"
               tt-filtro.cdn-grp-produt-ini   = 0
               tt-filtro.cdn-grp-produt-fim   = 999999
               tt-filtro.cdn-produt-rural-ini = 0
               tt-filtro.cdn-produt-rural-fim = 999999999
               tt-filtro.cod-propried-ini     = ""
               tt-filtro.cod-propried-fim     = "ZZZZZZZZZZZZZZZZ" 
               tt-filtro.tg-sit-todos         = YES
               tt-filtro.tg-sit-pendente      = YES
               tt-filtro.tg-sit-confirmada    = YES
               tt-filtro.tg-sit-nf-gerada     = YES 
               tt-filtro.ordenacao            = "BY cod-estabel BY cod-regiao BY cod-rota BY cdn-produt-rural " NO-ERROR.

        IF VALID-HANDLE(h-boin627zm) THEN DO:
            RUN goTokey IN h-boin627zm(INPUT c-seg-usuario).
            IF RETURN-VALUE = "OK":U THEN DO:
                RUN getCharField IN h-boin627zm(INPUT "char-1":U, OUTPUT c-char-1).

                IF SUBSTRING(c-char-1,16,5) <> "" THEN
                    ASSIGN tt-filtro.cod-estabel-ini = SUBSTRING(c-char-1,16,5)      
                           tt-filtro.cod-estabel-fim = SUBSTRING(c-char-1,16,5).
            END.
        END.
    
    END.
    ELSE DO:
        ASSIGN tt-filtro.cod-period           = INPUT FRAME fPage0 tt-fechto-produt-period.cod-period
               tt-filtro.it-codigo            = INPUT FRAME fPage0 cb-item NO-ERROR.
    END.
    

    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE initializeDBOs wMaintenance 
PROCEDURE initializeDBOs :
/*:T------------------------------------------------------------------------------
  Purpose:     Inicializa DBOs
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/

    /*--- Verifica se o DBO j  est  inicializado ---*/
    IF NOT VALID-HANDLE({&hDBOTable}) OR
       {&hDBOTable}:TYPE <> "PROCEDURE":U OR
       {&hDBOTable}:FILE-NAME <> "inbo/boin00999.p":U THEN DO:
        {btb/btb008za.i1 inbo/boin00999.p YES}
        {btb/btb008za.i2 inbo/boin00999.p '' {&hDBOTable}}
    END.
    
    IF NOT VALID-HANDLE(h-boin172na) THEN DO: 
        {btb/btb008za.i1 inbo/boin172na.p}
        {btb/btb008za.i2 inbo/boin172na.p '' h-boin172na}
    END.
    RUN openQueryStatic IN h-boin172na (INPUT "Main":U).

    IF NOT VALID-HANDLE(h-boin627) THEN DO: /* item */
        {btb/btb008za.i1 inbo/boin627.p}
        {btb/btb008za.i2 inbo/boin627.p '' h-boin627}
    END.

    IF NOT VALID-HANDLE(h-boin00968) THEN DO:
        {btb/btb008za.i1 inbo/boin00968.p}
        {btb/btb008za.i2 inbo/boin00968.p '' h-boin00968}
    END.
    RUN openQueryStatic IN h-boin00968 (INPUT "Main":U).

    IF NOT VALID-HANDLE(h-boin00983) THEN DO:
        {btb/btb008za.i1 inbo/boin00983.p}
        {btb/btb008za.i2 inbo/boin00983.p '' h-boin00983}
    END.
    RUN openQueryStatic IN h-boin00983 (INPUT "Main":U).

    IF NOT VALID-HANDLE(h-boin627zm) THEN 
        RUN inbo/boin627zm.p PERSISTENT SET h-boin627zm.

    RUN OpenQueryStatic IN h-boin627zm (INPUT "Default":U) NO-ERROR.

    /*--- Verifica se o DBO j  est  inicializado ---*/
    IF NOT VALID-HANDLE(h-boin00962) THEN DO:
        {btb/btb008za.i1 inbo/boin00962.p}
        {btb/btb008za.i2 inbo/boin00962.p '' h-boin00962} 
    END.
    RUN openQueryStatic IN h-boin00962 (INPUT "Main":U).

    IF NOT VALID-HANDLE(h-boin00963) THEN DO:
        {btb/btb008za.i1 inbo/boin00963.p}
        {btb/btb008za.i2 inbo/boin00963.p '' h-boin00963} 
    END.
    RUN openQueryStatic IN h-boin00963 (INPUT "Main":U).

    RUN utp/ut-acomp.p PERSISTENT SET h-acomp.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE piBuscarPeriodo wMaintenance 
PROCEDURE piBuscarPeriodo :
/*------------------------------------------------------------------------------
  Purpose: Setar os valores iniciais para sele‡Æo.     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
DEFINE VARIABLE c-cod-period LIKE tt-fechto-produt-period.cod-period NO-UNDO.


    IF  VALID-HANDLE(h-boin00968) THEN DO:
        
        RUN goToKey IN h-boin00968 (INPUT c-cod-estabel).
        IF RETURN-VALUE = "OK":U THEN DO:
        
            RUN getCharField IN h-boin00968 (INPUT  "cod-periodo",
                                             OUTPUT c-cod-period).
           
                IF c-cod-period <> "" THEN DO:   /*ao fechar per¡odo, busca £ltimo per¡odo fechado, e ir  fechar o pr¢ximo*/
                    ASSIGN tt-fechto-produt-period.cod-period:SCREEN-VALUE IN FRAME fPage0 = IF INT(SUBSTRING(c-cod-period,1,2)) < 9
                                                                       THEN "0" + STRING(INT(SUBSTRING(c-cod-period,1,2)) + 1) + SUBSTRING(c-cod-period,3,4)
                                                                       ELSE IF INT(SUBSTRING(c-cod-period,1,2)) < 12 
                                                                       THEN STRING(INT(SUBSTRING(c-cod-period,1,2)) + 1) + SUBSTRING(c-cod-period,3,4)    
                                                                       ELSE "01" +  STRING(INT(SUBSTRING(c-cod-period,3,4)) + 1).
                END.
                ELSE DO: /*caso nÆo encontre (primeira execu‡Æo) ir  verificar a £ltima fechto*/

                    RUN setConstraintEstabel IN h-boin00999 (INPUT c-cod-estabel) NO-ERROR.
                    RUN openQueryStatic      IN h-boin00999 (INPUT "Estabel":U) NO-ERROR.    
                    RUN getLast              IN h-boin00999 NO-ERROR.
                    
                    IF RETURN-VALUE = "OK":U THEN DO:
                        
                        RUN getCharField IN h-boin00999 (INPUT  "cod-period",
                                                         OUTPUT c-cod-period).
                        ASSIGN tt-fechto-produt-period.cod-period:SCREEN-VALUE IN FRAME fPage0 = c-cod-period.

                    END.

                END.
            
        END.

    END.

RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE piGravarRegistros wMaintenance 
PROCEDURE piGravarRegistros :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE VARIABLE c-texto AS CHARACTER NO-UNDO.

    IF NOT VALID-HANDLE(h-acomp)THEN
        RUN utp/ut-acomp.p PERSISTENT SET h-acomp.
    {utp/ut-liter.i "Efetivando_Registros" * }
    RUN pi-inicializar IN h-acomp (RETURN-VALUE).

    RUN emptyRowErrors  IN h-boin00999.

    RUN setConstraintPeriodoItem IN h-boin00999 (INPUT tt-filtro.cod-period,
                                                 INPUT tt-filtro.it-codigo).
    RUN openQueryStatic IN h-boin00999 (INPUT "PeriodoItem":U).

    FOR EACH tt-fechto-produt-period WHERE tt-fechto-produt-period.checkSum = "*":
    
        {utp/ut-liter.i "Prod.: " * }
        ASSIGN c-texto = RETURN-VALUE + STRING(tt-fechto-produt-period.cdn-produt-rural).

        {utp/ut-liter.i "Prop.: " * }
        ASSIGN c-texto = c-texto + " " + RETURN-VALUE + " " + tt-fechto-produt-period.cod-propried.

        RUN pi-acompanhar  IN h-acomp (c-texto).

        RUN goToKey IN h-boin00999 (INPUT tt-fechto-produt-period.cod-period,
                                    INPUT tt-fechto-produt-period.cdn-produt-rural,
                                    INPUT tt-fechto-produt-period.cod-propried,
                                    INPUT tt-fechto-produt-period.it-codigo,
                                    INPUT tt-fechto-produt-period.cod-estabel).

        RUN updateRowObject IN h-boin00999 (INPUT tt-fechto-produt-period.val-bonus-fix-inf,
                                            INPUT tt-fechto-produt-period.val-preco-final-inf,
                                            INPUT tt-fechto-produt-period.cod-livre-2,
                                            INPUT tt-fechto-produt-period.val-livre-1).

        RUN updateRecord IN h-boin00999.

        IF RETURN-VALUE = "NOK":U THEN DO:

            RUN getRowErrors IN h-boin00999 (OUTPUT TABLE RowErrors).

            /*--- Inicializa tela de mensagens de erros ---*/
            {method/ShowMessage.i1}                  
            /*--- Transfere temp-table RowErrors para a tela de mensagens de erros ---*/
            {method/ShowMessage.i2 &Modal="YES"}
            {method/ShowMessage.i3}
            RETURN "OK":U.
            
        END.

    END.

    ASSIGN l-ja-confirmou = NO.  /*irá perguntar novamente caso tenha situação já confirmada*/

    RUN pi-finalizar IN h-acomp.

    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE piHabilitarBotao wMaintenance 
PROCEDURE piHabilitarBotao :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    IF AVAIL tt-fechto-produt-period THEN DO:
        ASSIGN btMarcar:SENSITIVE    IN FRAME fPage1 = tt-fechto-produt-period.checksum = ""  AND AVAIL tt-fechto-produt-period
               btDesmarcar:SENSITIVE IN FRAME fPage1 = tt-fechto-produt-period.checksum = "*" AND AVAIL tt-fechto-produt-period
               bt-save:SENSITIVE     IN FRAME fPage0 = CAN-FIND(FIRST tt-fechto-produt-period WHERE tt-fechto-produt-period.checksum = "*").
    END.

    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE piMarcarDesmarcar wMaintenance 
PROCEDURE piMarcarDesmarcar :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
  /* Execu‡Æo de tela de Consulta */
  IF "{1}" = "AQ0415" THEN
    ASSIGN tt-fechto-produt-period.checkSum = "".
  ELSE DO:
    IF AVAIL tt-fechto-produt-period 
         AND tt-fechto-produt-period.idi-situacao <> 3 THEN DO: /* nao atualiza NF gerada */
    
      ASSIGN tt-fechto-produt-period.checkSum = IF tt-fechto-produt-period.checksum = "" THEN "*" ELSE "".
    
      brFechto:SELECT-FOCUSED-ROW() IN FRAME fPage1.
    
      DISP tt-fechto-produt-period.checkSum WITH BROWSE brFechto.
    
    END.
    RUN piHabilitarBotao IN THIS-PROCEDURE.
  END.

  RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE piOpenQuery wMaintenance 
PROCEDURE piOpenQuery :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE VARIABLE iRowsReturned AS INTEGER NO-UNDO.
    
    DEFINE VARIABLE qh     AS HANDLE    NO-UNDO.
    DEFINE VARIABLE bh     AS HANDLE    NO-UNDO.
    DEFINE VARIABLE cQuery AS CHARACTER INITIAL "FOR EACH tt-fechto-produt-period-aux NO-LOCK " NO-UNDO.
    DEFINE VARIABLE iOrdem AS INTEGER     NO-UNDO.

    EMPTY TEMP-TABLE tt-fechto-produt-period-aux NO-ERROR.

    ASSIGN de-tot-qtd-period        = 0  /*totais*/
           de-tot-valor             = 0
           de-tot-frete             = 0
           de-impto-sanidade-animal = 0.
    
    IF NOT VALID-HANDLE(h-acomp)THEN
        RUN utp/ut-acomp.p PERSISTENT SET h-acomp.
    {utp/ut-liter.i "Buscando_Fechamentos" * }
    RUN pi-inicializar IN h-acomp (RETURN-VALUE).
    IF CAN-FIND (FIRST tt-filtro WHERE TRIM(tt-filtro.cod-period) <> "/") THEN DO:

        RUN getTTFechtoProdutPeriod IN {&hDBOTable} (INPUT  TABLE tt-filtro,
                                                     OUTPUT de-tot-qtd-period,
                                                     OUTPUT de-tot-valor,
                                                     OUTPUT de-tot-frete,
                                                     OUTPUT de-impto-sanidade-animal,
                                                     OUTPUT TABLE tt-fechto-produt-period-aux).

        CREATE BUFFER bh FOR TABLE "tt-fechto-produt-period-aux":U.
        CREATE QUERY qh.
 
        FIND FIRST tt-filtro NO-LOCK NO-ERROR.
        ASSIGN cQuery = cQuery + tt-filtro.ordenacao.

        qh:SET-BUFFERS(bh). 
        qh:QUERY-PREPARE(cQuery).
        qh:FORWARD-ONLY.  

        qh:QUERY-OPEN().

        EMPTY TEMP-TABLE tt-fechto-produt-period NO-ERROR.
        ASSIGN iOrdem = 0.

        REPEAT:   /*FOR EACH tt-fechto-produt-period-aux*/
            qh:GET-NEXT().
            IF qh:QUERY-OFF-END THEN LEAVE.
        
            ASSIGN iOrdem = iOrdem + 1.

            CREATE tt-fechto-produt-period.
            ASSIGN tt-fechto-produt-period.val-per-anterior    = DEC(bh:BUFFER-FIELD("val-per-anterior":U):BUFFER-VALUE)
                   tt-fechto-produt-period.cidade              = bh:BUFFER-FIELD("cidade":U):BUFFER-VALUE
                   tt-fechto-produt-period.nome-abrev          = bh:BUFFER-FIELD("nome-abrev":U):BUFFER-VALUE
                   tt-fechto-produt-period.grp-produt          = bh:BUFFER-FIELD("grp-produt":U):BUFFER-VALUE
                   tt-fechto-produt-period.cod-period          = bh:BUFFER-FIELD("cod-period":U):BUFFER-VALUE
                   tt-fechto-produt-period.it-codigo           = bh:BUFFER-FIELD("it-codigo":U):BUFFER-VALUE
                   tt-fechto-produt-period.cod-estabel         = bh:BUFFER-FIELD("cod-estabel":U):BUFFER-VALUE
                   tt-fechto-produt-period.cod-regiao          = bh:BUFFER-FIELD("cod-regiao":U):BUFFER-VALUE
                   tt-fechto-produt-period.cod-rota            = bh:BUFFER-FIELD("cod-rota":U):BUFFER-VALUE
                   tt-fechto-produt-period.cdn-produt-rural    = INT(bh:BUFFER-FIELD("cdn-produt-rural":U):BUFFER-VALUE)
                   tt-fechto-produt-period.cod-propried        = bh:BUFFER-FIELD("cod-propried":U):BUFFER-VALUE
                   tt-fechto-produt-period.qtd-period          = DEC(bh:BUFFER-FIELD("qtd-period":U):BUFFER-VALUE)
                   tt-fechto-produt-period.val-preco-base      = DEC(bh:BUFFER-FIELD("val-preco-base":U):BUFFER-VALUE)
                   tt-fechto-produt-period.val-var-qualid      = DEC(bh:BUFFER-FIELD("val-var-qualid":U):BUFFER-VALUE)
                   tt-fechto-produt-period.val-var-volum       = DEC(bh:BUFFER-FIELD("val-var-volum":U):BUFFER-VALUE)
                   tt-fechto-produt-period.val-bonus-fix       = DEC(bh:BUFFER-FIELD("val-bonus-fix":U):BUFFER-VALUE)
                   tt-fechto-produt-period.val-unit            = DEC(bh:BUFFER-FIELD("val-unit":U):BUFFER-VALUE)
                   tt-fechto-produt-period.val-bonus-fix-inf   = DEC(bh:BUFFER-FIELD("val-bonus-fix-inf":U):BUFFER-VALUE)
                   tt-fechto-produt-period.val-preco-final-inf = DEC(bh:BUFFER-FIELD("val-preco-final-inf":U):BUFFER-VALUE)
                   tt-fechto-produt-period.diferenca           = DEC(bh:BUFFER-FIELD("diferenca":U):BUFFER-VALUE)
                   tt-fechto-produt-period.val-total           = DEC(bh:BUFFER-FIELD("val-total":U):BUFFER-VALUE)
                   tt-fechto-produt-period.val-frete           = DEC(bh:BUFFER-FIELD("val-frete":U):BUFFER-VALUE)
                   tt-fechto-produt-period.cod-livre-2         = bh:BUFFER-FIELD("cod-livre-2":U):BUFFER-VALUE      /*controle reabertura carga*/
                   tt-fechto-produt-period.idi-situacao        = INT(bh:BUFFER-FIELD("idi-situacao":U):BUFFER-VALUE)
                   tt-fechto-produt-period.val-livre-1         = DEC(bh:BUFFER-FIELD("val-livre-1":U):BUFFER-VALUE) /*val-ajuste*/
                   tt-fechto-produt-period.val-impto           = DEC(bh:BUFFER-FIELD("val-impto":U):BUFFER-VALUE)   /*impto-sanidade*/
                   tt-fechto-produt-period.val-livre-6         = iOrdem. /*ordena‡Æo*/

        END.

        {&OPEN-QUERY-brFechto}

        ASSIGN de-tot-qtd-period:SCREEN-VALUE IN FRAME fPage1        = STRING(de-tot-qtd-period)
               de-tot-valor:SCREEN-VALUE IN FRAME fPage1             = STRING(de-tot-valor)
               de-tot-frete:SCREEN-VALUE IN FRAME fPage1             = STRING(de-tot-frete)
               de-impto-sanidade-animal:SCREEN-VALUE IN FRAME fPage1 = STRING(de-impto-sanidade-animal).

    END.
    ELSE DO:
        RUN utp/ut-msgs.p (INPUT "show",
                           INPUT 333,
                           INPUT "").
        APPLY "ENTRY":U TO tt-fechto-produt-period.cod-period IN FRAME fPage0.

    END.
    RUN pi-finalizar IN h-acomp.

    ASSIGN brFechto:SENSITIVE IN FRAME fPage1 = TRUE.

    APPLY "VALUE-CHANGED":U TO BROWSE brFechto.

    ASSIGN l-ja-confirmou = NO.  /*como carregou novamente, irá perguntar novamente caso tenha situação já confirmada*/

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE piVerificarRegistros wMaintenance 
PROCEDURE piVerificarRegistros :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE VARIABLE c-texto AS CHARACTER NO-UNDO. 
    RUN emptyRowErrors  IN h-boin00999.

    IF NOT VALID-HANDLE(h-acomp)THEN
        RUN utp/ut-acomp.p PERSISTENT SET h-acomp.
    {utp/ut-liter.i "Validando_Registros" * }
    RUN pi-inicializar IN h-acomp (RETURN-VALUE).

    FOR EACH tt-fechto-produt-period WHERE tt-fechto-produt-period.checkSum = "*":

        {utp/ut-liter.i "Prod.: " * }
        ASSIGN c-texto = RETURN-VALUE + STRING(tt-fechto-produt-period.cdn-produt-rural).

        {utp/ut-liter.i "Prop.: " * }
        ASSIGN c-texto = c-texto + " " + RETURN-VALUE + " " + tt-fechto-produt-period.cod-propried.

        RUN pi-acompanhar  IN h-acomp (c-texto).

        EMPTY TEMP-TABLE tt-fechto-produt-period-aux NO-ERROR.

        CREATE tt-fechto-produt-period-aux.
        BUFFER-COPY tt-fechto-produt-period TO tt-fechto-produt-period-aux.
    
        RUN verificaRegistro IN h-boin00999 (INPUT TABLE tt-fechto-produt-period-aux).

        IF RETURN-VALUE = "NOK":U THEN DO: 
               
            RUN getRowErrors IN h-boin00999 (OUTPUT TABLE RowErrors).
            
            /*--- Inicializa tela de mensagens de erros ---*/
            {method/ShowMessage.i1}                  
            /*--- Transfere temp-table RowErrors para a tela de mensagens de erros ---*/
            {method/ShowMessage.i2 &Modal="YES"}
            {method/ShowMessage.i3}

            RETURN "NOK":U.

        END.

    END.

    RUN pi-finalizar IN h-acomp.

    IF NOT l-ja-confirmou THEN DO: /*caso usuário já tenha respondido a pergunta, não executa novamente*/
        
        IF CAN-FIND(FIRST tt-fechto-produt-period WHERE tt-fechto-produt-period.checkSum     = "*"
                                                    AND tt-fechto-produt-period.idi-situacao = 2) THEN DO: /*confirmada*/

                RUN utp/ut-msgs.p (INPUT "show",
                                   INPUT 54802,
                                   INPUT "").
        
                IF RETURN-VALUE = "YES":U THEN /*caso usuário responda que não, cancela o processo*/
                    ASSIGN l-ja-confirmou = YES.
                ELSE    
                    RETURN "NOK":U.
        END.

    END.

    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

/* ************************  Function Implementations ***************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _FUNCTION fnSituacao wMaintenance 
FUNCTION fnSituacao RETURNS CHARACTER
  ( iSit as integer ) :
/*------------------------------------------------------------------------------
  Purpose:  
    Notes:  
------------------------------------------------------------------------------*/

  CASE iSit:
      WHEN 1 THEN DO:
          {utp/ut-liter.i "Pendente":U *}
          RETURN RETURN-VALUE.  
      END.
      WHEN 2 THEN DO:
          {utp/ut-liter.i "Confirmada":U *}
          RETURN RETURN-VALUE.  
      END.
      WHEN 3 THEN DO: 
          {utp/ut-liter.i "NF_Gerada":U *}
          RETURN RETURN-VALUE.  
      END.
  END CASE.

END FUNCTION.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

