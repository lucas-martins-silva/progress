/*tratativa da negociação coletiva para a simulação*/

IF AVAIL tt-regra-form-preco THEN DO:
    IF l-negoc-coletiv THEN DO:
        /* 1 - aplica ao total 2 - aplica ao excedente */
        ASSIGN d-qtd-aplicar-bonus = IF tt-regra-form-preco.cdn-aplic = 1 THEN tt-negoc-coletiv.grp-qtd-coleta
                                                                          ELSE tt-negoc-coletiv.grp-qtd-coleta - tt-regra-form-preco.val-faixa-inic.

        IF tt-regra-form-preco.val-faixa-inic <= tt-negoc-coletiv.grp-qtd-coleta AND      /*volume entregue encaixa na regra cadastrada*/
           tt-regra-form-preco.val-faixa-fim  >= tt-negoc-coletiv.grp-qtd-coleta THEN DO:
        
            ASSIGN tt-fechto-com.val-var-volum       = (tt-regra-form-preco.val-unit * d-qtd-aplicar-bonus) / tt-negoc-coletiv.grp-qtd-coleta
                   /*na aqapi001.i9 já é feito essa soma a partir da fechto */
                   /* com os dados informados no AQ0315 */  
                   /*tt-fechto-com.val-preco-final-inf = tt-fechto-com.val-preco-final-inf + tt-fechto-com.val-var-volum /*b"nus fixo sÆo somados posteriormente*/*/
                   l-achou = TRUE. 

        END.            
    END.
    ELSE DO:
        /* 1 - aplica ao total 2 - aplica ao excedente */
        ASSIGN d-qtd-aplicar-bonus = IF tt-regra-form-preco.cdn-aplic = 1 THEN tt-fechto-com.qtd-period
                                                                          ELSE tt-fechto-com.qtd-period - tt-regra-form-preco.val-faixa-inic.
    
        IF tt-regra-form-preco.val-faixa-inic <= tt-fechto-com.qtd-period AND      /*volume entregue encaixa na regra cadastrada*/
           tt-regra-form-preco.val-faixa-fim  >= tt-fechto-com.qtd-period THEN DO:
        
            ASSIGN tt-fechto-com.val-var-volum       = (tt-regra-form-preco.val-unit * d-qtd-aplicar-bonus) / tt-fechto-com.qtd-period
                   /*tt-fechto-com.val-preco-final-inf = tt-fechto-com.val-preco-final-inf + tt-fechto-com.val-var-volum /*b"nus fixo sÆo somados posteriormente*/*/
                   l-achou = TRUE.
        END.
    END.
    if l-achou then do:
        LOG-MANAGER:WRITE-MESSAGE ('###') NO-ERROR.
        LOG-MANAGER:WRITE-MESSAGE ('l-negoc-coletiv:                    ' + string(l-negoc-coletiv)) NO-ERROR.
        LOG-MANAGER:WRITE-MESSAGE ('tt-fechto-com.cdn-produt-rural:     ' + string(tt-fechto-com.cdn-produt-rural)) NO-ERROR.
        LOG-MANAGER:WRITE-MESSAGE ('tt-fechto-com.qtd-period:           ' + string(tt-fechto-com.qtd-period)) NO-ERROR.
        LOG-MANAGER:WRITE-MESSAGE ('tt-regra-form-preco.cdn-abrangen:   ' + string(tt-regra-form-preco.cdn-abrangen)) NO-ERROR.
        LOG-MANAGER:WRITE-MESSAGE ('tt-regra-form-preco.val-faixa-inic: ' + string(tt-regra-form-preco.val-faixa-inic)) NO-ERROR.
        LOG-MANAGER:WRITE-MESSAGE ('tt-regra-form-preco.val-faixa-fim:  ' + string(tt-regra-form-preco.val-faixa-fim )) NO-ERROR.
        LOG-MANAGER:WRITE-MESSAGE ('###') NO-ERROR.
    end.
END.