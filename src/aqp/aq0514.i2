    
    IF tt-dados-cargas-rurais.cdn-produt-rural < tt-param.cdn-produt-rural-ini OR
       tt-dados-cargas-rurais.cdn-produt-rural > tt-param.cdn-produt-rural-fim THEN
        NEXT.

    IF tt-dados-cargas-rurais.dat-trans < tt-param.d-data-ini OR
       tt-dados-cargas-rurais.dat-trans > tt-param.d-data-fim THEN
        NEXT.

    RUN piNewLine IN h-utapi033.

    RUN piLine IN h-utapi033 (INPUT 01, INPUT tt-dados-cargas-rurais.num-carg).
    RUN piLine IN h-utapi033 (INPUT 02, INPUT tt-dados-cargas-rurais.cdn-produt-rural).
    RUN piLine IN h-utapi033 (INPUT 03, INPUT tt-dados-cargas-rurais.nome-emitente).
    RUN piLine IN h-utapi033 (INPUT 04, INPUT tt-dados-cargas-rurais.cod-propried).
    RUN piLine IN h-utapi033 (INPUT 05, INPUT tt-dados-cargas-rurais.des-propried).
    RUN piLine IN h-utapi033 (INPUT 06, INPUT tt-dados-cargas-rurais.cod-pto-coleta).
    RUN piLine IN h-utapi033 (INPUT 07, INPUT tt-dados-cargas-rurais.des-pto-coleta).
    RUN piLine IN h-utapi033 (INPUT 08, INPUT tt-dados-cargas-rurais.dat-trans).
    RUN piLine IN h-utapi033 (INPUT 09, INPUT tt-dados-cargas-rurais.cod-estabel).

    IF tt-dados-cargas-rurais.cdn-produt-respons = ? THEN
        ASSIGN tt-dados-cargas-rurais.cdn-produt-respons = 0.
    RUN piLine IN h-utapi033 (INPUT 10, INPUT tt-dados-cargas-rurais.cdn-produt-respons).
    
    RUN piLine IN h-utapi033 (INPUT 11, INPUT tt-dados-cargas-rurais.qtd-coleta). 
    RUN piLine IN h-utapi033 (INPUT 12, INPUT tt-dados-cargas-rurais.cdn-compart).
    RUN piLine IN h-utapi033 (INPUT 13, INPUT tt-dados-cargas-rurais.val-temperat).
    RUN piLine IN h-utapi033 (INPUT 14, INPUT tt-dados-cargas-rurais.cod-amostra). 
    RUN piLine IN h-utapi033 (INPUT 15, INPUT tt-dados-cargas-rurais.cod-lacre).
    RUN piLine IN h-utapi033 (INPUT 16, INPUT tt-dados-cargas-rurais.cdn-repos).
    RUN piLine IN h-utapi033 (INPUT 17, INPUT tt-dados-cargas-rurais.dat-coleta).
    RUN piLine IN h-utapi033 (INPUT 18, INPUT tt-dados-cargas-rurais.hra-coleta).
    RUN piLine IN h-utapi033 (INPUT 19, INPUT tt-dados-cargas-rurais.des-motivo).
    

