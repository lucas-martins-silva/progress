DEFINE VARIABLE h-acomp                 AS HANDLE              NO-UNDO.
DEFINE VARIABLE i                       AS INTEGER             NO-UNDO.

DEFINE VARIABLE c-titulo-coluna  AS CHARACTER EXTENT 18 NO-UNDO.
DEFINE VARIABLE c-campo          AS CHARACTER EXTENT 18 NO-UNDO.
DEFINE VARIABLE d-largura-coluna AS DECIMAL   EXTENT 18 NO-UNDO. 
DEFINE VARIABLE c-label-param    AS CHARACTER EXTENT  8 NO-UNDO.

{aqp/aq0506.i}
   
DEFINE TEMP-TABLE tt-alter-carga NO-UNDO    
    FIELD cod-estabel      LIKE carg-rural.cod-estabel
    FIELD rota             LIKE carg-rural.cod-rota
    FIELD des-rota         LIKE rota-coleta.des-rota
    FIELD num-carga        LIKE produt-carg.num-carg
    FIELD cdn-compart      LIKE produt-carg.cdn-compart
    FIELD cod-pto-coleta   LIKE produt-carg.cod-pto-coleta
    FIELD des-pto-coleta   LIKE pto-coleta.des-pto-coleta
    FIELD cdn-reposit      LIKE produt-carg.cdn-repos
    FIELD dat-alter        LIKE alter-produt-carg.dat-alter
    FIELD hora-alter       LIKE alter-produt-carg.hora-alter
    FIELD cod-usuar        LIKE alter-produt-carg.cod-usuar
    FIELD acao             AS CHARACTER FORMAT "X(12)"
    FIELD cdn-produt-rural LIKE produt-carg.cdn-produt-rural
    FIELD nome-produtor    LIKE emitente.nome-emit
    FIELD campo	           LIKE alter-produt-carg.cod-campo /*Se alter-produt-carg.cod-campo diferente de "ADD" e "DEL": Com o c¢digo do campo buscar o Label e exibir*, se for ADD ou DEL n∆o exibir conte£do nesta coluna.*/
    FIELD conteudo-ant     LIKE alter-produt-carg.conteudo  /*Quebrar conte£do do campo alter-produt-carg.conteudo e exibir o conte£do anterior*/
    FIELD conteudo-novo    LIKE alter-produt-carg.conteudo  /*Quebrar conte£do do campo alter-produt-carg.conteudo e exibir o conte£do novo    */
    FIELD motivo           LIKE alter-produt-carg.des-motivo.

DEFINE TEMP-TABLE tt-param-planilha NO-UNDO
    FIELD descricao AS CHARACTER
    FIELD valor     AS CHARACTER.

/** Titulo Colunas Planilha **/

{utp/ut-liter.i Estab * r}               
ASSIGN c-titulo-coluna[1]  = RETURN-VALUE.
{utp/ut-liter.i Rota * r}               
ASSIGN c-titulo-coluna[2]  = RETURN-VALUE.
{utp/ut-liter.i Descriá∆o_Rota * r}          
ASSIGN c-titulo-coluna[3]  = RETURN-VALUE.
{utp/ut-liter.i Carga * r}                
ASSIGN c-titulo-coluna[4]  = RETURN-VALUE.
{utp/ut-liter.i Compartimento * r}                 
ASSIGN c-titulo-coluna[5]  = RETURN-VALUE.
{utp/ut-liter.i Ponto_Coleta * r}           
ASSIGN c-titulo-coluna[6]  = RETURN-VALUE.
{utp/ut-liter.i Descriá∆o_Ponto_Coleta * r}                
ASSIGN c-titulo-coluna[7]  = RETURN-VALUE.
{utp/ut-liter.i Reposit * r}                
ASSIGN c-titulo-coluna[8]  = RETURN-VALUE.
{utp/ut-liter.i Data_Alteraá∆o * r}         
ASSIGN c-titulo-coluna[9]  = RETURN-VALUE.
{utp/ut-liter.i Hora_Alteraá∆o * r}         
ASSIGN c-titulo-coluna[10]  = RETURN-VALUE.
{utp/ut-liter.i Usu†rio * r}                
ASSIGN c-titulo-coluna[11]  = RETURN-VALUE.
{utp/ut-liter.i Aá∆o * r}       
ASSIGN c-titulo-coluna[12]  = RETURN-VALUE.
{utp/ut-liter.i Produtor * r}           
ASSIGN c-titulo-coluna[13] = RETURN-VALUE.
{utp/ut-liter.i Nome_Produtor * r}        
ASSIGN c-titulo-coluna[14] = RETURN-VALUE.
{utp/ut-liter.i Campo_Alterado * r}        
ASSIGN c-titulo-coluna[15] = RETURN-VALUE.
{utp/ut-liter.i Conte£do_Antigo * r}      
ASSIGN c-titulo-coluna[16] = RETURN-VALUE.
{utp/ut-liter.i Conte£do_Novo * r}           
ASSIGN c-titulo-coluna[17] = RETURN-VALUE.
{utp/ut-liter.i Motivo * r}           
ASSIGN c-titulo-coluna[18] = RETURN-VALUE.

ASSIGN d-largura-coluna[1]  = 8
       d-largura-coluna[2]  = 15
       d-largura-coluna[3]  = 25
       d-largura-coluna[4]  = 10.43
       d-largura-coluna[5]  = 15
       d-largura-coluna[6]  = 22
       d-largura-coluna[7]  = 30
       d-largura-coluna[8]  = 8.14
       d-largura-coluna[9]  = 14
       d-largura-coluna[10] = 14   
       d-largura-coluna[11] = 14
       d-largura-coluna[12] = 11
       d-largura-coluna[13] = 9
       d-largura-coluna[14] = 50
       d-largura-coluna[15] = 18
       d-largura-coluna[16] = 18
       d-largura-coluna[17] = 18
       d-largura-coluna[18] = 100.
       
/** Nome dos campos da tabela **/ 
{utp/ut-liter.i cod-estabel * r}
ASSIGN c-campo[1]  = RETURN-VALUE.
{utp/ut-liter.i rota * r}
ASSIGN c-campo[2]  = RETURN-VALUE.
{utp/ut-liter.i des-rota * r}
ASSIGN c-campo[3]  = RETURN-VALUE.
{utp/ut-liter.i num-carga * r}   
ASSIGN c-campo[4]  = RETURN-VALUE.
{utp/ut-liter.i cdn-compart * r}
ASSIGN c-campo[5]  = RETURN-VALUE.
{utp/ut-liter.i cod-pto-coleta * r}
ASSIGN c-campo[6]  = RETURN-VALUE.
{utp/ut-liter.i des-pto-coleta * r}
ASSIGN c-campo[7]  = RETURN-VALUE.
{utp/ut-liter.i cdn-reposit * r}
ASSIGN c-campo[8]  = RETURN-VALUE.
{utp/ut-liter.i dat-alter * r}
ASSIGN c-campo[9]  = RETURN-VALUE.
{utp/ut-liter.i hora-alter * r}
ASSIGN c-campo[10]  = RETURN-VALUE.
{utp/ut-liter.i cod-usuar * r}
ASSIGN c-campo[11]  = RETURN-VALUE.
{utp/ut-liter.i acao * r}
ASSIGN c-campo[12]  = RETURN-VALUE.
{utp/ut-liter.i cdn-produt-rural * r}
ASSIGN c-campo[13]  = RETURN-VALUE.
{utp/ut-liter.i  nome-produtor * r}   
ASSIGN c-campo[14]  = RETURN-VALUE.
{utp/ut-liter.i campo * r}
ASSIGN c-campo[15]  = RETURN-VALUE.
{utp/ut-liter.i conteudo-ant * r} 
ASSIGN c-campo[16]  = RETURN-VALUE.
{utp/ut-liter.i conteudo-novo * r}
ASSIGN c-campo[17]  = RETURN-VALUE.
{utp/ut-liter.i motivo * r}
ASSIGN c-campo[18]  = RETURN-VALUE.


/** Aba de Seleá∆o **/
{utp/ut-liter.i Seleá∆o * r}               
ASSIGN c-label-param[1]  = RETURN-VALUE.
{utp/ut-liter.i Estabelecimento * r}          
ASSIGN c-label-param[2]  = RETURN-VALUE.
{utp/ut-liter.i Carga * r}                
ASSIGN c-label-param[3]  = RETURN-VALUE.
{utp/ut-liter.i Data_Alteraá∆o * r}                 
ASSIGN c-label-param[4]  = RETURN-VALUE.
{utp/ut-liter.i Data_Transaá∆o * r}           
ASSIGN c-label-param[5]  = RETURN-VALUE.
{utp/ut-liter.i Usu†rio * r}                
ASSIGN c-label-param[6]  = RETURN-VALUE.
{utp/ut-liter.i Arquivo * r}                
ASSIGN c-label-param[7]  = RETURN-VALUE.
{utp/ut-liter.i Impress∆o * r}                
ASSIGN c-label-param[8]  = RETURN-VALUE.

{utp/ut-liter.i Relat¢rio_Alteraá∆o_Produtores_Carga * r}
ASSIGN c-titulo-relat = TRIM(RETURN-VALUE).
