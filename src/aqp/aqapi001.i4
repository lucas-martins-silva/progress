/*a partir das cargas e das regras cadastradas, cria-se a fechto-produt-period com a informaÁ„o do preco-base*/

CREATE BUFFER bh FOR TABLE "produt-carg":U.
CREATE QUERY qh.

qh:SET-BUFFERS(bh). 
qh:QUERY-PREPARE(cQuery).
qh:FORWARD-ONLY.  
qh:QUERY-OPEN().

REPEAT:   /*FOR EACH produt-carg*/
    qh:GET-NEXT().
    IF qh:QUERY-OFF-END THEN LEAVE.   

    IF  l-estab-security-active /*seguranÁa por estabelecimento*/
    AND NOT CAN-FIND (FIRST {&ESTAB-SEC-TT} WHERE {&ESTAB-SEC-TT-FIELD} = bh:BUFFER-FIELD("cod-estabel":U):BUFFER-VALUE) THEN       
        NEXT.    

    ASSIGN c-cod-regiao      = ""
           c-cod-rota        = ""
           c-cod-propriedade = ""
           i-cdn-grp-produt  = 0
           i-num-regras      = 0
           l-achou           = false.

    FOR FIRST carg-rural FIELDS(cod-rota val-frete qtd-coleta cod-transp it-codigo cod-placa) NO-LOCK 
        WHERE carg-rural.num-carg = int(bh:BUFFER-FIELD("num-carg":U):BUFFER-VALUE):

        ASSIGN de-val-frete-carg = carg-rural.val-frete / carg-rural.qtd-coleta /*valor do frete na carga por litro*/
               c-cod-transp      = carg-rural.cod-transp
               c-cod-placa       = carg-rural.cod-placa
               c-it-codigo       = carg-rural.it-codigo.
    END.

    FOR FIRST produt-rural FIELDS(cdn-grp-produt) NO-LOCK 
        WHERE produt-rural.cdn-produt-rural = int(bh:BUFFER-FIELD("cdn-produt-rural":U):BUFFER-VALUE):

        ASSIGN i-cdn-grp-produt = produt-rural.cdn-grp-produt.
    END.

    FOR FIRST pto-coleta FIELDS(cod-regiao cod-pto-coleta cod-propried) NO-LOCK 
        WHERE pto-coleta.cod-pto-coleta = bh:BUFFER-FIELD("cod-pto-coleta":U):BUFFER-VALUE:

        ASSIGN c-cod-regiao      = pto-coleta.cod-regiao
               c-cod-propriedade = bh:BUFFER-FIELD("cod-propried":U):BUFFER-VALUE.
    
        FOR FIRST produt-pto-coleta FIELDS(cod-propried) NO-LOCK 
            WHERE produt-pto-coleta.cod-pto-coleta   = pto-coleta.cod-pto-coleta
              AND produt-pto-coleta.cdn-produt-rural = int(bh:BUFFER-FIELD("cdn-produt-rural":U):BUFFER-VALUE):

            IF c-cod-propriedade = "" THEN
                ASSIGN c-cod-propriedade = produt-pto-coleta.cod-propried.
        
        END.
        
        IF c-cod-propriedade = "" THEN 
            ASSIGN c-cod-propriedade = pto-coleta.cod-propried.

        FOR FIRST propried-rural FIELDS(cod-rota-princ) NO-LOCK
            WHERE propried-rural.cod-propried = c-cod-propriedade:

            ASSIGN c-cod-rota = propried-rural.cod-rota-princ.

        END.    

        IF c-cod-rota = "" AND AVAIL carg-rural THEN
            ASSIGN c-cod-rota = carg-rural.cod-rota.

    END.

    /*TT-DIGITA - FILTRA ROTAS*/
    IF CAN-FIND(FIRST tt-digita) THEN DO: /*caso tenha alguma tt-digita, o usu†rio informou rotas na tela*/
        IF NOT CAN-FIND(FIRST tt-digita WHERE tt-digita.cod-rota = c-cod-rota) THEN /* caso n∆o encontre a rota da carga na tt-digita */
            qh:GET-NEXT().                                                          /* n∆o usar† esta carga no fechamento             */ 
    END.


    FOR FIRST tt-carg-produt-propried WHERE tt-carg-produt-propried.cod-propriedade  = c-cod-propriedade  /*se encontrar registro, sumariza*/
                                        AND tt-carg-produt-propried.cdn-produt-rural = INT(bh:BUFFER-FIELD("cdn-produt-rural":U):BUFFER-VALUE): END.

    IF NOT AVAIL tt-carg-produt-propried THEN DO: /*caso seja a primeira carga do produtor/propriedade*/
        CREATE tt-carg-produt-propried.    
        ASSIGN tt-carg-produt-propried.cdn-produt-rural  = INT(bh:BUFFER-FIELD("cdn-produt-rural":U):BUFFER-VALUE)
               tt-carg-produt-propried.cod-propriedade   = c-cod-propriedade
               tt-carg-produt-propried.cdn-grp-produt    = i-cdn-grp-produt
               tt-carg-produt-propried.pre-base-ok       = FALSE.
    
    END.
    
    
    FOR EACH tt-regra-form-preco WHERE tt-regra-form-preco.da-dia = date(bh:BUFFER-FIELD("dat-trans":U):BUFFER-VALUE)
        BREAK BY tt-regra-form-preco.cdn-abrangen:
        
        IF l-achou THEN 
            leave.
            
        case tt-regra-form-preco.cdn-abrangen:
            WHEN 1 THEN DO: /*Ponto Coleta*/
                IF bh:BUFFER-FIELD("cod-pto-coleta":U):BUFFER-VALUE <> tt-regra-form-preco.cod-pto-coleta THEN
                    NEXT.
                ASSIGN l-achou = TRUE.    
            END.
            WHEN 2 THEN DO: /*Propriedade*/
                IF c-cod-propriedade <> tt-regra-form-preco.cod-propried THEN
                    NEXT.
                ASSIGN l-achou = TRUE.    
            END.
            WHEN 3 THEN DO: /*Produtor*/
                IF INT(bh:BUFFER-FIELD("cdn-produt-rural":U):BUFFER-VALUE) <> tt-regra-form-preco.cdn-produt-rural THEN
                    NEXT.
                ASSIGN l-achou = TRUE.
            END.
            WHEN 4 THEN DO: /*Grupo*/
                IF i-cdn-grp-produt <> tt-regra-form-preco.cdn-grp-produt THEN
                    NEXT.
                ASSIGN l-achou = TRUE.
            END.
            WHEN 5 THEN DO: /*Rota*/
                IF c-cod-rota <> tt-regra-form-preco.cod-rota THEN
                    next.
                ASSIGN l-achou = TRUE.
            END.
            WHEN 6 THEN DO: /*Regi„o*/
                IF c-cod-regiao <> tt-regra-form-preco.cod-regiao THEN
                    NEXT.
                ASSIGN l-achou = TRUE.
            END.
            WHEN 7 THEN DO: /*Estabelecimento*/
                IF bh:BUFFER-FIELD("cod-estabel":U):BUFFER-VALUE <> tt-regra-form-preco.cod-estabel THEN
                    NEXT.
                ASSIGN l-achou = TRUE.
            END.
            WHEN 8 THEN DO: /*Todos*/
                ASSIGN l-achou = TRUE.
            END.
        END CASE.
        
        i-num-regras = i-num-regras + 1.   
        IF i-num-regras <> 1 THEN DO: /*encontou nenhuma ou mais de uma regra*/
            RUN criaRowErrors IN THIS-PROCEDURE(INPUT 17006,
                                                INPUT "ENCONTRADO MAIS DE UMA REGRA PARA A CARGA: " + STRING((bh:BUFFER-FIELD("num-carg":U):BUFFER-VALUE)) +
                                                      " PRODUTOR: " + STRING((bh:BUFFER-FIELD("cdn-produt-rural":U):BUFFER-VALUE)) + 
                                                      " PROPRIEDADE: " + STRING(c-cod-propriedade)  +
                                                      " DATA: " + STRING(date(bh:BUFFER-FIELD("dat-trans":U):BUFFER-VALUE)) ).
        END.
        ELSE DO: /*encontrou regra £nica*/
            
            {aqp/aqapi001.i5} /*criaá∆o com sumarizaá∆o das cargas pelas regras*/

        END.    /*encontrou regra £nica*/
    
    END. /*FOR EACH tt-regra-form-preco*/
   
END. /*REPEAT*/


FOR EACH tt-carg-produt-propried:

    IF NOT CAN-FIND (FIRST tt-carg-produt-periodo WHERE  tt-carg-produt-periodo.cdn-produt-rural  = tt-carg-produt-propried.cdn-produt-rural 
                                                    AND  tt-carg-produt-periodo.propriedade-rural = tt-carg-produt-propried.cod-propriedade) THEN DO:
        RUN criaRowErrors IN THIS-PROCEDURE(INPUT 17006,
                                            INPUT "N«O ENCONTRADO PREÄO BASE PARA A PROPRIEDADE: '" + tt-carg-produt-propried.cod-propriedade +
                                                  "' PRODUTOR: '"   + string(tt-carg-produt-propried.cdn-produt-rural) + 
                                                  "' NO PER÷ODO: '" + string(tt-param.da-dat-ini) + "'" ).
    END.

END.

blk_fechto:
FOR EACH tt-carg-produt-periodo WHERE tt-carg-produt-periodo.cod-regiao        >= tt-param.cod-regiao-ini        /*  para cada carga sumarizada    */
                                  AND tt-carg-produt-periodo.cod-regiao        <= tt-param.cod-regiao-fim        /*   filtra os registros pelo     */
                                  AND tt-carg-produt-periodo.cod-rota          >= tt-param.cod-rota-ini          /*   que foi digitado na tela     */
                                  AND tt-carg-produt-periodo.cod-rota          <= tt-param.cod-rota-fim          /*  e cria a fechto-produt-period */
                                  AND tt-carg-produt-periodo.cdn-grp-produt    >= tt-param.cdn-grp-produt-ini    /*  estabel produtor e pto-coleta */
                                  AND tt-carg-produt-periodo.cdn-grp-produt    <= tt-param.cdn-grp-produt-fim    /*  filtrados na query din‚mica   */
                                  AND tt-carg-produt-periodo.cdn-produt-rural  >= tt-param.cdn-produt-rural-ini
                                  AND tt-carg-produt-periodo.cdn-produt-rural  <= tt-param.cdn-produt-rural-fim  
                                  AND tt-carg-produt-periodo.propriedade-rural >= tt-param.cod-propried-ini    
                                  AND tt-carg-produt-periodo.propriedade-rural <= tt-param.cod-propried-fim:

    /*repassar as cargas para setar o campo que diz que aquela carga foi calculada*/
    FOR EACH produt-carg EXCLUSIVE-LOCK
        WHERE produt-carg.cdn-produt-rural  = tt-carg-produt-periodo.cdn-produt-rural
          AND produt-carg.cod-estabel       = tt-carg-produt-periodo.cod-estabel
          AND produt-carg.it-codigo         = tt-carg-produt-periodo.it-codigo
          AND produt-carg.dat-trans        >= tt-param.da-dat-ini
          AND produt-carg.dat-trans        <= tt-param.da-dat-fim:

        ASSIGN produt-carg.log-livre-1 = TRUE. /*na reabertura da carga, È setado para false, para conferir 
                                                no fechamento se todas as produt-carg foram usadas no c·lculo*/

    END.

    /*para produtor/propriedade com coleta = 0, dever· excluir fechto caso tenha, e n„o criar*/
    IF tt-carg-produt-periodo.tot-qtd-coleta = 0 THEN DO:

        FOR FIRST fechto-produt-period EXCLUSIVE-LOCK
            WHERE fechto-produt-period.cod-period       = tt-param.cod-period
              AND fechto-produt-period.cdn-produt-rural = tt-carg-produt-periodo.cdn-produt-rural
              AND fechto-produt-period.cod-propried     = tt-carg-produt-periodo.propriedade-rural
              AND fechto-produt-period.cod-estabel      = tt-carg-produt-periodo.cod-estabel
              AND fechto-produt-period.it-codigo        = tt-carg-produt-periodo.it-codigo
              AND fechto-produt-period.idi-situacao    <> 3: /* NF gerada  */ 

            DELETE fechto-produt-period.

        END.

        NEXT blk_fechto.

    END. 

    IF NOT tt-param.sobrepoe-bon-fix-inf AND NOT tt-param.recalcula-sit-conf AND /*n„o deve recalcular nada*/
       CAN-FIND (FIRST fechto-produt-period
                 WHERE fechto-produt-period.cod-period       = tt-param.cod-period                      /*  e j·    */
                   AND fechto-produt-period.cdn-produt-rural = tt-carg-produt-periodo.cdn-produt-rural  /* existe   */
                   AND fechto-produt-period.cod-propried     = tt-carg-produt-periodo.propriedade-rural /* fectho   */
                   AND fechto-produt-period.cod-estabel      = tt-carg-produt-periodo.cod-estabel       /* para     */
                   AND fechto-produt-period.it-codigo        = tt-carg-produt-periodo.it-codigo         /* produt   */
                   AND (fechto-produt-period.idi-situacao     = 2        /* confirmada */               /* propried */
                   OR  fechto-produt-period.idi-situacao      = 3)) THEN /* NF gerada  */

        NEXT blk_fechto.


    CREATE tt-fechto-produt-period.
    ASSIGN tt-fechto-produt-period.cod-period          = tt-param.cod-period
           tt-fechto-produt-period.cdn-produt-rural    = tt-carg-produt-periodo.cdn-produt-rural
           tt-fechto-produt-period.cod-propried        = tt-carg-produt-periodo.propriedade-rural
           tt-fechto-produt-period.cod-estabel         = tt-carg-produt-periodo.cod-estabel
           tt-fechto-produt-period.cod-rota            = tt-carg-produt-periodo.cod-rota
           tt-fechto-produt-period.cod-regiao          = tt-carg-produt-periodo.cod-regiao
           tt-fechto-produt-period.it-codigo           = tt-param.it-codigo
           tt-fechto-produt-period.qtd-period          = tt-carg-produt-periodo.tot-qtd-coleta
           tt-fechto-produt-period.qtd-aferid          = tt-carg-produt-periodo.tot-qtd-aferid
           tt-fechto-produt-period.val-preco-base      = tt-carg-produt-periodo.val-med-per
           tt-fechto-produt-period.val-preco-final-inf = tt-carg-produt-periodo.val-med-per /*qualidade, volume e bìnus fixo s∆o somados posteriormente*/
           tt-fechto-produt-period.val-frete           = tt-carg-produt-periodo.val-frete
           tt-fechto-produt-period.idi-situacao        = 1. /*Pendente*/


    ASSIGN OVERLAY(tt-fechto-produt-period.cod-livre-1,1,12) = tt-carg-produt-periodo.cod-placa.

    RUN pi-calculo-imposto-sanidade (INPUT  tt-fechto-produt-period.cod-estabel,
                                     INPUT  tt-fechto-produt-period.qtd-period, /* Volume do mes - variavel: VOLUME_MES */
                                     OUTPUT tt-fechto-produt-period.val-impto).

    /* NOME TRANSPORTADOR */
    FOR FIRST transporte FIELDS (nome-abrev) NO-LOCK
        WHERE transporte.cod-transp = tt-carg-produt-periodo.cod-transp:
        ASSIGN tt-fechto-produt-period.nome-transp = transporte.nome-abrev.
    END.                               

    /*caso j· tenha fechto com situacao diferente de pendente, nao ira alterar*/
    /*   caso esteja pendente, ira recriar o registro com os novos valores    */
    FOR FIRST fechto-produt-period EXCLUSIVE-LOCK   
        WHERE fechto-produt-period.cod-period       = tt-fechto-produt-period.cod-period           
          AND fechto-produt-period.cdn-produt-rural = tt-fechto-produt-period.cdn-produt-rural    
          AND fechto-produt-period.cod-propried     = tt-fechto-produt-period.cod-propried        
          AND fechto-produt-period.cod-estabel      = tt-fechto-produt-period.cod-estabel         
          AND fechto-produt-period.it-codigo        = tt-fechto-produt-period.it-codigo:

        IF fechto-produt-period.idi-situacao <> 3 AND /*NF gerada*/
           (fechto-produt-period.idi-situacao = 1 OR  /*pendente*/
           tt-param.recalcula-sit-conf                /*param em tela para recalcular os ja confirmados*/
           OR CAN-FIND (FIRST produt-carg
                        WHERE produt-carg.cdn-produt-rural  = fechto-produt-period.cdn-produt-rural
                          AND produt-carg.cod-estabel       = fechto-produt-period.cod-estabel
                          AND produt-carg.it-codigo         = fechto-produt-period.it-codigo
                          AND produt-carg.dat-trans        >= tt-param.da-dat-ini
                          AND produt-carg.dat-trans        <= tt-param.da-dat-fim
                          AND produt-carg.log-livre-1       = FALSE))   THEN DO:

            IF tt-param.sobrepoe-bon-fix-inf THEN DO:   /*  se estiver selecionado o parametro, ir· zerar a fechto e criar nova      */
                DELETE fechto-produt-period.            /*  caso contr·rio, ser· feito um update do registro existente sem sobrepor  */
            END.                                        /*  o valor do bonus fixo informado (AQ0315)                                 */
            ELSE    
                ASSIGN tt-fechto-produt-period.val-bonus-fix-inf   = fechto-produt-period.val-bonus-fix-inf
                       tt-fechto-produt-period.val-preco-final-inf = fechto-produt-period.val-bonus-fix-inf + tt-fechto-produt-period.val-preco-base.
   
        END.
        ELSE    
            NEXT blk_fechto.

    END.
    
    RUN goToKey IN h-boin00999 (INPUT tt-fechto-produt-period.cod-period,
                                      tt-fechto-produt-period.cdn-produt-rural,
                                      tt-fechto-produt-period.cod-propried,
                                      tt-fechto-produt-period.it-codigo,
                                      tt-fechto-produt-period.cod-estabel).

    IF RETURN-VALUE = "OK":U THEN DO:    /*est· atualizando o registro*/

        RUN emptyRowErrors  IN h-boin00999.
        RUN setRecord       IN h-boin00999 (INPUT TABLE tt-fechto-produt-period).
        RUN updateRecord    IN h-boin00999.

    END.
    ELSE DO:    /*est· criando novo ou sobrescrevendo todos os c·lculos em registro j· existente*/

        RUN emptyRowObject  IN h-boin00999.
        RUN emptyRowErrors  IN h-boin00999.
        RUN setRecord       IN h-boin00999 (INPUT TABLE tt-fechto-produt-period).
        RUN createRecord    IN h-boin00999.

    END.

    RUN getRowid IN h-boin00999 (OUTPUT r-rd-fechto).

    IF NOT CAN-FIND (FIRST tt-rd-fechto WHERE tt-rd-fechto.r-rd-fechto = r-rd-fechto) THEN DO:
        CREATE tt-rd-fechto.
        ASSIGN tt-rd-fechto.r-rd-fechto = r-rd-fechto.
    END.
    
    DELETE tt-carg-produt-periodo.
    DELETE tt-fechto-produt-period.

END.   

/* buscar as fechto que n„o tenham mais cargas se n„o tiver, elimina */
FOR EACH fechto-produt-period FIELDS(cod-period cdn-produt-rural cod-propried it-codigo cod-estabel) NO-LOCK
    WHERE fechto-produt-period.cod-period    = tt-param.cod-period
      AND fechto-produt-period.it-codigo     = tt-param.it-codigo
      AND fechto-produt-period.cod-estabel   = tt-param.cod-estabel-ini
      AND fechto-produt-period.idi-situacao <> 3: /*NF gerada*/

    IF NOT CAN-FIND (FIRST produt-carg
                     WHERE produt-carg.cdn-produt-rural = fechto-produt-period.cdn-produt-rural
                       AND produt-carg.cod-propried     = fechto-produt-period.cod-propried
                       AND produt-carg.it-codigo        = fechto-produt-period.it-codigo
                       AND produt-carg.cod-estabel      = fechto-produt-period.cod-estabel
                       AND produt-carg.qtd-coleta       > 0
                       AND produt-carg.dat-trans       >= tt-param.da-dat-ini
                       AND produt-carg.dat-trans       <= tt-param.da-dat-fim) THEN DO:

        IF VALID-HANDLE(h-boin00999) THEN DO:

            RUN emptyRowErrors  IN h-boin00999.
            RUN goToKey IN h-boin00999 (INPUT fechto-produt-period.cod-period,
                                              fechto-produt-period.cdn-produt-rural,
                                              fechto-produt-period.cod-propried,
                                              fechto-produt-period.it-codigo,
                                              fechto-produt-period.cod-estabel).
            
            IF RETURN-VALUE = "OK":U THEN
                RUN deleteRecord IN h-boin00999.

        END.

    END.

END.
