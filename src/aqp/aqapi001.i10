/*soma de qualidade para simulação*/

DEFINE VARIABLE d-val-var-qualid AS DECIMAL NO-UNDO.
DEFINE VARIABLE d-result-pond     AS DECIMAL NO-UNDO.

FOR EACH analis-lab-period FIELDS(nr-ficha cdn-produt-rural cod-propried)  NO-LOCK 
   WHERE analis-lab-period.dat-analis   >= tt-param.da-dat-ini      /* faz a m‚dia dos resultados  */
     AND analis-lab-period.dat-analis   <= tt-param.da-dat-fim:     /* entres estas datas - re0501 */

    FOR EACH tt-fechto-com
       WHERE tt-fechto-com.cod-propried     = analis-lab-period.cod-propried 
         AND tt-fechto-com.cdn-produt-rural = analis-lab-period.cdn-produt-rural:

        FOR EACH res-fic-cq FIELDS(resultado it-codigo cod-exame cod-comp) NO-LOCK 
            WHERE res-fic-cq.nr-ficha  = analis-lab-period.nr-ficha:

            FOR FIRST tt-media
                WHERE tt-media.cod-period       = tt-fechto-com.cod-period
                  AND tt-media.cdn-produt-rural = analis-lab-period.cdn-produt-rural
                  AND tt-media.cod-propried     = tt-fechto-com.cod-propried
                  AND tt-media.cod-estabel      = tt-fechto-com.cod-estabel   
                  AND tt-media.it-codigo        = res-fic-cq.it-codigo    
                  AND tt-media.cod-exame        = res-fic-cq.cod-exame       
                  AND tt-media.cod-comp         = res-fic-cq.cod-comp:

                ASSIGN tt-media.resultado  = tt-media.resultado  + res-fic-cq.resultado
                       tt-media.num-result = tt-media.num-result + 1.

            END.
            
            IF NOT AVAIL tt-media THEN DO:

                CREATE tt-media.
                ASSIGN tt-media.cod-period       = tt-fechto-com.cod-period
                       tt-media.cod-estabel      = tt-fechto-com.cod-estabel 
                       tt-media.cdn-produt-rural = analis-lab-period.cdn-produt-rural
                       tt-media.cod-propried     = tt-fechto-com.cod-propried
                       tt-media.it-codigo        = res-fic-cq.it-codigo       
                       tt-media.cod-exame        = res-fic-cq.cod-exame       
                       tt-media.cod-comp         = res-fic-cq.cod-comp
                       tt-media.resultado        = res-fic-cq.resultado 
                       tt-media.num-result       = 1.
            END.
        END. /*FOR EACH res-fic-cq*/
    END. /*FOR EACH tt-fechto-com*/ 
END. /*FOR EACH analis-lab-period*/ 

FOR EACH tt-media:
    ASSIGN l-achou = FALSE
           d-val-var-qualid = 0
           d-result-pond    = 0.

    /*atribuição de peso aos resultados*/
    FOR FIRST config-peso-qualid NO-LOCK
        WHERE config-peso-qualid.cod-estabel = tt-media.cod-estabel
          AND config-peso-qualid.it-codigo   = tt-media.it-codigo
          AND config-peso-qualid.cod-exame   = tt-media.cod-exame
          AND config-peso-qualid.cod-comp    = tt-media.cod-comp
          AND config-peso-qualid.dat-inic    <= tt-param.da-dat-fim
          AND config-peso-qualid.dat-fim     >= tt-param.da-dat-ini:

        FOR EACH peso-period NO-LOCK
           WHERE peso-period.cod-estabel = config-peso-qualid.cod-estabel
             AND peso-period.it-codigo   = config-peso-qualid.it-codigo  
             AND peso-period.cod-exame   = config-peso-qualid.cod-exame  
             AND peso-period.cod-comp    = config-peso-qualid.cod-comp
             AND peso-period.cdn-seq     = config-peso-qualid.cdn-seq
            BREAK BY peso-period.cdn-seq:

            IF FIRST-OF(peso-period.cdn-seq) THEN DO: /*na primeira execução usa o período atual
                                                        nas seguintes o campo c-cod-period assume
                                                        o valor do periodo atual - 1 conforme
                                                        assign na c-cod-period abaixo*/

                ASSIGN c-cod-period  = tt-param.cod-period
                       d-result-pond = (tt-media.resultado / tt-media.num-result) * (peso-period.val-peso / 100).

            END.
            ELSE DO:

                FOR FIRST fechto-qualid NO-LOCK
                    WHERE fechto-qualid.cod-period       = c-cod-period
                      AND fechto-qualid.cdn-produt-rural = tt-media.cdn-produt-rural
                      AND fechto-qualid.cod-propried     = tt-media.cod-propried
                      AND fechto-qualid.it-codigo        = tt-media.it-codigo
                      AND fechto-qualid.cod-estabel      = tt-media.cod-estabel
                      AND fechto-qualid.cod-exame        = tt-media.cod-exame
                      AND fechto-qualid.cdn-comp         = tt-media.cod-comp:

                    IF fechto-qualid.resultado <> 0 THEN
                        ASSIGN d-result-pond = d-result-pond + (fechto-qualid.resultado)                  * (peso-period.val-peso / 100).
                    ELSE    
                        ASSIGN d-result-pond = d-result-pond + (tt-media.resultado / tt-media.num-result) * (peso-period.val-peso / 100).

                END.
                IF NOT AVAIL fechto-qualid THEN
                    ASSIGN d-result-pond = d-result-pond + ((tt-media.resultado / tt-media.num-result) * (peso-period.val-peso / 100)).
 
            END. /*NOT FIRST OF*/

            /*c-cod-period recebe o período anterior para usar na próxima iteração*/
            ASSIGN c-cod-period = IF INT(SUBSTRING(c-cod-period,1,2)) = 1  /*janeiro*/ 
                                      THEN "12" + STRING(INT(SUBSTRING(c-cod-period,3,4)) - 1)
                                  ELSE IF INT(SUBSTRING(c-cod-period,1,2)) <= 10
                                      THEN "0"  + STRING(INT(SUBSTRING(c-cod-period,1,2)) - 1) + SUBSTRING(c-cod-period,3,4)
                                  ELSE     
                                      STRING(INT(SUBSTRING(c-cod-period,1,2)) - 1) + SUBSTRING(c-cod-period,3,4).

        END. /*FOR EACH peso-period*/    

    END. /*FOR FIRST config-peso-qualid*/

    IF NOT AVAIL config-peso-qualid THEN
        ASSIGN d-result-pond = tt-media.resultado / tt-media.num-result.
    /***********************************/

    FOR EACH tt-regra-form-preco
        WHERE tt-regra-form-preco.cod-exame = tt-media.cod-exame
          AND tt-regra-form-preco.cod-comp  = tt-media.cod-comp
        BREAK BY tt-regra-form-preco.cdn-abrangen
              BY tt-regra-form-preco.dat-inic:

        FOR FIRST tt-fechto-com NO-LOCK
            WHERE tt-fechto-com.cdn-produt-rural = tt-media.cdn-produt-rural
              AND tt-fechto-com.cod-propried     = tt-media.cod-propried
              AND tt-fechto-com.cod-period       = tt-media.cod-period 
              AND tt-fechto-com.cod-estabel      = tt-media.cod-estabel
              AND tt-fechto-com.it-codigo        = tt-media.it-codigo:
            
            IF l-achou THEN
            LEAVE.
                
            CASE tt-regra-form-preco.cdn-abrangen:
                WHEN 1 THEN DO: /*Ponto Coleta*/
                    FOR FIRST produt-pto-coleta FIELDS(cod-pto-coleta) NO-LOCK 
                        WHERE produt-pto-coleta.cdn-produt-rural = tt-fechto-com.cdn-produt-rural
                          AND produt-pto-coleta.cod-propried     = tt-fechto-com.cod-propried:
                        IF produt-pto-coleta.cod-pto-coleta <> tt-regra-form-preco.cod-pto-coleta THEN
                        NEXT.
                        ASSIGN l-achou = TRUE.    
                    END.
                END.
                WHEN 2 THEN DO: /*Propriedade*/
                    IF tt-fechto-com.cod-propried <> tt-regra-form-preco.cod-propried THEN
                        NEXT.
                    ASSIGN l-achou = TRUE.    
                END.
                WHEN 3 THEN DO: /*Produtor*/
                    IF tt-fechto-com.cdn-produt-rural <> tt-regra-form-preco.cdn-produt-rural THEN
                        NEXT.
                    ASSIGN l-achou = TRUE.
                END.
                WHEN 4 THEN DO: /*Grupo*/
                    FOR FIRST produt-rural FIELDS(cdn-grp-produt) NO-LOCK 
                        WHERE produt-rural.cdn-produt-rural = tt-fechto-com.cdn-produt-rural:
                        IF produt-rural.cdn-grp-produt <> tt-regra-form-preco.cdn-grp-produt THEN
                            NEXT.
                        ASSIGN l-achou = TRUE.
                    END.
                END.
                WHEN 5 THEN DO: /*Rota*/
                    FOR FIRST produt-pto-coleta FIELDS(cod-pto-coleta) NO-LOCK 
                        WHERE produt-pto-coleta.cdn-produt-rural = tt-fechto-com.cdn-produt-rural
                          AND produt-pto-coleta.cod-propried     = tt-fechto-com.cod-propried:
                        FOR FIRST pto-rota-coleta FIELDS(cod-rota) NO-LOCK 
                            WHERE pto-rota-coleta.cod-pto-coleta = produt-pto-coleta.cod-pto-coleta:    
                            IF pto-rota-coleta.cod-rota <> tt-regra-form-preco.cod-rota THEN
                            NEXT.
                            ASSIGN l-achou = TRUE.
                        END.
                    END.
                END.
                WHEN 6 THEN DO: /*RegiÆo*/
                    FOR FIRST produt-pto-coleta FIELDS(cod-pto-coleta) NO-LOCK 
                        WHERE produt-pto-coleta.cdn-produt-rural = tt-fechto-com.cdn-produt-rural
                          AND produt-pto-coleta.cod-propried     = tt-fechto-com.cod-propried:
                        FOR FIRST pto-coleta FIELDS(cod-regiao) NO-LOCK 
                            WHERE pto-coleta.cod-pto-coleta = produt-pto-coleta.cod-pto-coleta:
                            IF pto-coleta.cod-regiao <> tt-regra-form-preco.cod-regiao THEN
                            NEXT.
                            ASSIGN l-achou = TRUE. 
                        END.
                    END.
                END.
                WHEN 7 THEN DO: /*Estabelecimento*/
                    IF tt-fechto-com.cod-estabel <> tt-regra-form-preco.cod-estabel THEN
                        NEXT.
                    ASSIGN l-achou = TRUE.
                END.
                WHEN 8 THEN DO: /*Todos*/
                    ASSIGN l-achou = TRUE.
                END.
            END CASE.
            IF  l-achou AND                                                  /*abrangência correta*/
                tt-regra-form-preco.val-faixa-inic <= d-result-pond AND      /*resultado encaixa na regra cadastrada*/
                tt-regra-form-preco.val-faixa-fim  >= d-result-pond THEN DO:
    
                ASSIGN d-val-var-qualid = d-val-var-qualid + tt-regra-form-preco.val-unit.

            END.
            ELSE
                ASSIGN l-achou = NO.
        END. /*for first tt-fechto-com*/
    END. /*FOR EACH tt-regra-form-preco*/

    IF l-achou THEN
        FOR FIRST tt-fechto-com EXCLUSIVE-LOCK
            WHERE tt-fechto-com.cdn-produt-rural = tt-media.cdn-produt-rural
              AND tt-fechto-com.cod-propried     = tt-media.cod-propried
              AND tt-fechto-com.cod-period       = tt-media.cod-period 
              AND tt-fechto-com.cod-estabel      = tt-media.cod-estabel
              AND tt-fechto-com.it-codigo        = tt-media.it-codigo:

            ASSIGN tt-fechto-com.val-var-qualid      = tt-fechto-com.val-var-qualid      + d-val-var-qualid.

        END.

END. /*FOR EACH tt-media*/
