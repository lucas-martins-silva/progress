/*criação da tt que servirá de base para criação da fechto-produt-period*/

DEFINE VARIABLE de-val-unit       LIKE fechto-produt-period.val-preco-base NO-UNDO.
DEFINE VARIABLE c-period-anterior LIKE fechto-produt-period.cod-period     NO-UNDO.

IF NOT AVAIL tt-regra-form-preco THEN DO: 
    /*   busca para período não fechado, caso não tenha regra cadastrada ainda.
         na apuração de valores sempre terá regra cadastrada      */

    /*buscando valor do período anterior*/
    ASSIGN c-period-anterior = IF INT(SUBSTRING(tt-param.cod-period,1,2)) = 1  /*janeiro*/
                                   THEN "12" + STRING(INT(SUBSTRING(tt-param.cod-period,3,4)) - 1)
                               ELSE IF INT(SUBSTRING(tt-param.cod-period,1,2)) <= 10
                                   THEN "0" + STRING(INT(SUBSTRING(tt-param.cod-period,1,2)) - 1) + SUBSTRING(tt-param.cod-period,3,4)
                               ELSE     
                                   STRING(INT(SUBSTRING(tt-param.cod-period,1,2)) - 1) + SUBSTRING(tt-param.cod-period,3,4).
    
    FIND FIRST fechto-produt-period WHERE fechto-produt-period.cod-period       = c-period-anterior
                                      AND fechto-produt-period.cod-propried     = c-cod-propriedade
                                      AND fechto-produt-period.cdn-produt-rural = INT(bh:BUFFER-FIELD("cdn-produt-rural":U):BUFFER-VALUE) NO-ERROR.
    
    IF AVAIL fechto-produt-period THEN
        ASSIGN de-val-unit = fechto-produt-period.val-preco-final-inf. /*Pre‡o Ant*/
    ELSE
        ASSIGN de-val-unit = 0. /*Pre‡o Ant*/
    /************************************/

END.
ELSE 
    ASSIGN de-val-unit = tt-regra-form-preco.val-unit. /*Assume o valor da regra*/

/*Cria a tt-carg-produt-periodo para o preço base, sumarizando por produtor/propriedade*/
FOR FIRST tt-carg-produt-periodo WHERE tt-carg-produt-periodo.propriedade-rural = c-cod-propriedade  /*se encontrar registro, sumariza*/
                                   AND tt-carg-produt-periodo.cdn-produt-rural  = INT(bh:BUFFER-FIELD("cdn-produt-rural":U):BUFFER-VALUE):

    /*soma os valores*/
    ASSIGN tt-carg-produt-periodo.tot-qtd-aferid = tt-carg-produt-periodo.tot-qtd-aferid + INT(bh:BUFFER-FIELD("qtd-aferid":U):BUFFER-VALUE)
           tt-carg-produt-periodo.tot-qtd-coleta = tt-carg-produt-periodo.tot-qtd-coleta + INT(bh:BUFFER-FIELD("qtd-coleta":U):BUFFER-VALUE)
           tt-carg-produt-periodo.tot-valor      = tt-carg-produt-periodo.tot-valor + (INT(bh:BUFFER-FIELD("qtd-coleta":U):BUFFER-VALUE) * de-val-unit)    
           tt-carg-produt-periodo.val-med-per    = tt-carg-produt-periodo.tot-valor / tt-carg-produt-periodo.tot-qtd-coleta
           tt-carg-produt-periodo.val-frete      = tt-carg-produt-periodo.val-frete + (de-val-frete-carg * INT(bh:BUFFER-FIELD("qtd-coleta":U):BUFFER-VALUE)).
       
END.

IF NOT AVAIL tt-carg-produt-periodo THEN DO: /*caso seja a primeira carga do produtor/propriedade*/
    CREATE tt-carg-produt-periodo.    
    ASSIGN tt-carg-produt-periodo.it-codigo         = bh:BUFFER-FIELD("it-codigo":U):BUFFER-VALUE
           tt-carg-produt-periodo.cod-estabel       = bh:BUFFER-FIELD("cod-estabel":U):BUFFER-VALUE
           tt-carg-produt-periodo.cod-regiao        = c-cod-regiao
           tt-carg-produt-periodo.cod-rota          = c-cod-rota
           tt-carg-produt-periodo.cdn-grp-produt    = i-cdn-grp-produt
           tt-carg-produt-periodo.cdn-produt-rural  = INT(bh:BUFFER-FIELD("cdn-produt-rural":U):BUFFER-VALUE)
           tt-carg-produt-periodo.propriedade-rural = c-cod-propriedade
           tt-carg-produt-periodo.cod-pto-coleta    = bh:BUFFER-FIELD("cod-pto-coleta":U):BUFFER-VALUE
           tt-carg-produt-periodo.val-unit          = de-val-unit
           tt-carg-produt-periodo.qtd-aferid        = INT(bh:BUFFER-FIELD("qtd-aferid":U):BUFFER-VALUE)
           tt-carg-produt-periodo.tot-qtd-aferid    = INT(bh:BUFFER-FIELD("qtd-aferid":U):BUFFER-VALUE)
           tt-carg-produt-periodo.qtd-coleta        = INT(bh:BUFFER-FIELD("qtd-coleta":U):BUFFER-VALUE)
           tt-carg-produt-periodo.valor-carga       = INT(bh:BUFFER-FIELD("qtd-coleta":U):BUFFER-VALUE) * tt-carg-produt-periodo.val-unit
           tt-carg-produt-periodo.tot-qtd-coleta    = INT(bh:BUFFER-FIELD("qtd-coleta":U):BUFFER-VALUE)
           tt-carg-produt-periodo.tot-valor         = tt-carg-produt-periodo.valor-carga
           tt-carg-produt-periodo.val-med-per       = tt-carg-produt-periodo.tot-valor / tt-carg-produt-periodo.tot-qtd-coleta
           tt-carg-produt-periodo.val-frete         = de-val-frete-carg * INT(bh:BUFFER-FIELD("qtd-coleta":U):BUFFER-VALUE)
           tt-carg-produt-periodo.cod-transp        = c-cod-transp
           tt-carg-produt-periodo.cod-placa         = c-cod-placa.

END.
