/*------------------------------------------------------------------------
File        : AXSMA003.i02
Description : Include para adapter de envio de itens (Manufatura)
CREATEd     : 22/01/2004 10:00
Notes       :
----------------------------------------------------------------------*/

/* **********************  Definitions  *********************** */

/* Defini‡Æo identificadores Manufatura */
DEF VAR iIdManufacture    AS INT NO-UNDO.
DEF VAR iIdTechInformation   AS INT NO-UNDO.
DEF VAR iIdWareHouse      AS INT NO-UNDO.
DEF VAR iIdSpecSheet      AS INT NO-UNDO.
DEF VAR iIdTargetList     AS INT NO-UNDO.
DEF VAR iIdListOfReference   AS INT NO-UNDO.
DEF VAR iIdReference   AS INT NO-UNDO.
DEF VAR iIdApLevel     AS INT NO-UNDO.
DEF VAR iIdProduction  AS INT NO-UNDO.
DEF VAR iIdReports     AS INT NO-UNDO.
DEF VAR iIdAllocation  AS INT NO-UNDO.
DEF VAR iIdLocation       AS INT NO-UNDO.
DEF VAR iIdCurr      AS INT NO-UNDO.
DEF VAR iIdReposition  AS INT NO-UNDO.
DEF VAR iIdCRP       AS INT NO-UNDO.
DEF VAR iIdScrapItem AS INT NO-UNDO.
DEF VAR iIdMRP       AS INT NO-UNDO.
DEF VAR iIdPlanner   AS INT NO-UNDO.
DEF VAR iIdUser      AS INT NO-UNDO.
DEF VAR iIdProdLine  AS INT NO-UNDO.
DEF VAR iIdAps       AS INT NO-UNDO.

    RUN addNode IN hGenXml (iFirstId, "Manufacture":U, "", OUTPUT iId).

    /* Codigo Origem - Valores validos conforme include ininc~\i18in122.i [Default 1]*/
    IF tt-item-eai.codigo-orig >= 1 AND tt-item-eai.codigo-orig <= 99 THEN
       RUN addNodeDec IN hGenXml (iId, "SourceID":U, tt-item-eai.codigo-orig, OUTPUT iIdManufacture).
       ELSE RUN addNodeDec IN hGenXml (iId, "SourceID":U, 1, OUTPUT iIdManufacture).
    RUN addNodeDec IN hGenXml (iId, "BougthOrManufacturedItem":U, tt-item-eai.compr-fabric, OUTPUT iIdManufacture).
    RUN addNodeDec IN hGenXml  (iId, "ConversionFactor":U, tt-item-eai.fator-conver, OUTPUT iIdManufacture).

    IF tt-item-eai.data-obsol <> ? THEN
       RUN addNodeDate IN hGenXml (iId, "ObsoletionDate":U, tt-item-eai.data-obsol, OUTPUT iIdManufacture).

    RUN addNodeLog IN hGenXml  (iId, "IsImportLicenseNeeded":U, tt-item-eai.log-necessita-li, OUTPUT iIdManufacture).
    RUN addNodeLog IN hGenXml  (iId, "IsUpdatedViaMultiPlant":U, tt-item-eai.log-atualiz-via-mmp, OUTPUT iIdManufacture).

    /* Adiciona informacoes do Deposito */
    RUN addNode IN hGenXml (iId, "WareHouse":U, " ", OUTPUT iIdManufacture).
    RUN addNode IN hGenXml (iIdManufacture, "WareHouseCode":U, tt-item-eai.deposito-pad, OUTPUT iIdWareHouse).
    FIND FIRST deposito WHERE deposito.cod-depos = tt-item-eai.deposito-pad  NO-LOCK NO-ERROR. 
    IF AVAIL deposito THEN
       RUN addNode IN hGenXml (iIdManufacture, "WareHouseDescription":U, SUBSTRING(deposito.nome,1,40), OUTPUT iIdWareHouse).

    /* Adiciona informacoes Tecnicas do Item */
    RUN addNode IN hGenXml (iId, "TechnicalInformation":U, " ", OUTPUT iIdManufacture).
    RUN addNode IN hGenXml (iIdManufacture, "SpecificationSheet":U, "", OUTPUT iIdTechInformation).
    RUN addNode IN hGenXml (iIdTechInformation, "SpecificationSheetCode":U, tt-item-eai.cd-folh-item, OUTPUT iIdSpecSheet).
    FIND FIRST folh-espec WHERE folh-espec.cd-folha = tt-item-eai.cd-folh-item  NO-LOCK NO-ERROR.
    IF AVAIL folh-espec THEN
       RUN addNode IN hGenXml (iIdTechInformation, "SpecificationSheetDescription":U, SUBSTRING(folh-espec.descricao,1,40), OUTPUT iIdSpecSheet).


    /* Adiciona informacoes da Lista Destino */
    if connected("mgmp") then 
        run adapters/xml/ma2/axsma003a.p (input table tt-item-eai,
                                          input-output hGenXml,
                                          input iIdManufacture,
                                          input iIdTechInformation).
        

    /* Adiciona informacoes da Lista de Referencia do Item */
    IF CAN-FIND(FIRST ref-item WHERE ref-item.it-codigo = tt-item-eai.it-codigo) THEN DO: 
       RUN addNode IN hGenXml (iIdManufacture, "ListOfReference":U, "", OUTPUT iIdTechInformation).
       FOR EACH ref-item WHERE ref-item.it-codigo = tt-item-eai.it-codigo NO-LOCK:
           RUN addNode IN hGenXml (iIdTechInformation, "Reference":U, "", OUTPUT iIdListOfReference). 
           RUN addNode IN hGenXml (iIdListOfReference, "ReferenceCode":U, ref-item.cod-refer, OUTPUT iIdReference).
           FIND FIRST referencia WHERE referencia.cod-refer = ref-item.cod-refer NO-LOCK NO-ERROR.
           IF AVAIL referencia THEN DO:
              RUN addNode IN hGenXml (iIdListOfReference, "ReferenceDescription":U, SUBSTRING(referencia.descricao, 1,32), OUTPUT iIdReference).
              RUN addNodeLog IN hGenXml (iIdListOfReference, "IsSubProduct":U, referencia.subproduto, OUTPUT iIdReference).
           END.
       END.
    END. /* can-find */

    RUN addNode IN hGenXml (iIdManufacture,    "SupplementaryInformation":U, SUBSTRING(tt-item-eai.inform-compl, 1,16), OUTPUT iIdTechInformation).
    RUN addNodeLog IN hGenXml (iIdManufacture, "IsUpdatedCharacteristic":U, tt-item-eai.log-carac-tec, OUTPUT iIdTechInformation).
    RUN addNode IN hGenXml (iIdManufacture,    "ImageCode":U, tt-item-eai.cod-imagem, OUTPUT iIdTechInformation).
    RUN addNodeDec IN hGenXml (iIdManufacture, "ItemDescType":U, tt-item-eai.ind-imp-desc, OUTPUT iIdTechInformation).
    RUN addNode IN hGenXml (iIdManufacture, "DomesticDescription":U, tt-item-eai.desc-nacional, OUTPUT iIdTechInformation).
    RUN addNode IN hGenXml (iIdManufacture, "InternationalDescription":U, tt-item-eai.desc-inter, OUTPUT iIdTechInformation).
    RUN addNode IN hGenXml (iIdManufacture, "NarrativeText":U, TRIM(SUBSTRING(tt-item-eai.narrativa, 1, 2000)), OUTPUT iIdTechInformation).
    RUN addNodeDec IN hGenXml (iIdManufacture, "GrossWeight":U, tt-item-eai.peso-bruto, OUTPUT iIdTechInformation).
    RUN addNodeDec IN hGenXml (iIdManufacture, "NetWeight":U, tt-item-eai.peso-liquido, OUTPUT iIdTechInformation).

    &IF DEFINED (bf_man_205) &THEN
        IF tt-item-eai.dec-1 = 0 THEN
          RUN addNodeDec IN hGenXml (iIdManufacture, "UnitOfWeight":U, 1, OUTPUT iIdTechInformation).  
        ELSE 
          RUN addNodeDec IN hGenXml (iIdManufacture, "UnitOfWeight":U, tt-item-eai.dec-1, OUTPUT iIdTechInformation).  
    &ENDIF
    RUN addNodeDec IN hGenXml (iIdManufacture, "Height":U, tt-item-eai.altura, OUTPUT iIdTechInformation).   
    RUN addNodeDec IN hGenXml (iIdManufacture, "Width":U, tt-item-eai.largura, OUTPUT iIdTechInformation).   
    RUN addNodeDec IN hGenXml (iIdManufacture, "Lenght":U, tt-item-eai.comprim, OUTPUT iIdTechInformation).   

    /* Adiciona informacoes do Nivel de Aprovacao */
    RUN addNode IN hGenXml (iId, "ApprovalLevel":U, "", OUTPUT iIdManufacture).
    RUN addNodeDec IN hGenXml (iIdManufacture, "EletronicApprovalRequisition":U, tt-item-eai.nivel-apr-requis, OUTPUT iIdApLevel).
    RUN addNodeDec IN hGenXml (iIdManufacture, "EletronicApprovalRequest":U, tt-item-eai.nivel-apr-solic, OUTPUT iIdApLevel). 
    RUN addNodeDec IN hGenXml (iIdManufacture, "MaintenanceEletronicApproval":U, tt-item-eai.nivel-apr-manut, OUTPUT iIdApLevel). 
    RUN addNodeDec IN hGenXml (iIdManufacture, "OrdersEletronicApproval":U, tt-item-eai.nivel-apr-compra, OUTPUT iIdApLevel). 

    /* Adiciona informacoes de Producao */
    RUN addNode IN hGenXml (iId, "Production", "", OUTPUT iIdManufacture).
    RUN addNodeDec IN hGenXml (iIdManufacture, "IssueType":U, tt-item-eai.tipo-requis, OUTPUT iIdProduction).
    RUN addNodeDec IN hGenXml (iIdManufacture, "HandlingScrap":U, tt-item-eai.ind-refugo, OUTPUT iIdProduction).
    RUN addNodeDec IN hGenXml (iIdManufacture, "ScrapFactor":U, tt-item-eai.fator-refugo, OUTPUT iIdProduction).
    RUN addNodeDec IN hGenXml (iIdManufacture, "PoliticsLotAdministration":U, tt-item-eai.tp-adm-lote, OUTPUT iIdProduction).

    /* Tipo Lote Economico - Valores validos conforme include ininc~\i03in122.i [Default 1] */
    IF tt-item-eai.tipo-lote-ec = 1 OR tt-item-eai.tipo-lote-ec = 2 THEN
       RUN addNodeDec IN hGenXml (iIdManufacture, "EconomicLotType":U, tt-item-eai.tipo-lote-ec, OUTPUT iIdProduction).
    ELSE RUN addNodeDec IN hGenXml (iIdManufacture, "EconomicLotType":U, 1, OUTPUT iIdProduction).

    RUN addNodeDec IN hGenXml (iIdManufacture, "EconomicLot":U, tt-item-eai.lote-economi, OUTPUT iIdProduction).
    RUN addNodeDec IN hGenXml (iIdManufacture, "MultipleBatch":U, tt-item-eai.lote-multipl, OUTPUT iIdProduction).
    RUN addNodeDec IN hGenXml (iIdManufacture, "MinimumLot":U, tt-item-eai.lote-minimo,     OUTPUT iIdProduction).

    /* Tipo de controle de estoque - Valores validos conforme include ininc~\i01in122.i [Default 1] */
    IF tt-item-eai.tipo-con-est >= 1 AND tt-item-eai.tipo-con-est <= 4 THEN
       RUN addNodeDec IN hGenXml (iIdManufacture, "InventoryControlType":U, tt-item-eai.tipo-con-est, OUTPUT iIdProduction).
    ELSE RUN addNodeDec IN hGenXml (iIdManufacture, "InventoryControlType":U, 1, OUTPUT iIdProduction).

    /* EmissÆo Ordem - Valores validos conforme include ininc~\i03in122.i [Default 1] */
    IF tt-item-eai.emissao-ord = 1 OR tt-item-eai.emissao-ord = 2 THEN
       RUN addNodeDec IN hGenXml (iIdManufacture, "OrderPrinting":U, tt-item-eai.emissao-ord, OUTPUT iIdProduction).
    ELSE RUN addNodeDec IN hGenXml (iIdManufacture, "OrderPrinting":U, 1, OUTPUT iIdProduction).

    RUN addNodeDec IN hGenXml (iIdManufacture, "OrderDivision":U, tt-item-eai.div-ordem, OUTPUT iIdProduction).

    /* Geracao de Ordem - Valores validos conforme include ininc~\i01in521.i */
    &IF DEFINED (bf_man_205) &THEN
        IF tt-item-eai.geracao-ordem >= 1 AND tt-item-eai.geracao-ordem <= 7 THEN
           RUN addNodeDec IN hGenXml (iIdManufacture, "OrderGeneration":U, tt-item-eai.geracao-ordem, OUTPUT iIdProduction).  
    &ELSE 
        IF INTEGER(SUBSTRING(tt-item-eai.char-1,62,1)) >= 1 AND INTEGER(SUBSTRING(tt-item-eai.char-1,62,1)) <= 7 THEN            
           RUN addNodeDec IN hGenXml (iIdManufacture, "OrderGeneration":U, INTEGER(SUBSTRING(tt-item-eai.char-1,62,1)), OUTPUT iIdProduction).  
    &ENDIF
    RUN addNodeLog IN hGenXml (iIdManufacture, "IsGeneratedBackorder":U, tt-item-eai.ind-backorder, OUTPUT iIdProduction).  

    /* Adiciona informacoes da Linha de Producao */
    RUN addNode IN hGenXml (iIdManufacture, "ProductionLine":U, "", OUTPUT iIdProduction).
    RUN addNodeDec IN hGenXml (iIdProduction, "ProductionLineCode":U, tt-item-eai.nr-linha, OUTPUT iIdProdLine).
    FIND FIRST lin-prod WHERE lin-prod.nr-linha = tt-item-eai.nr-linha  NO-LOCK NO-ERROR. 
    IF AVAIL lin-prod THEN
       RUN addNode IN hGenXml (iIdProduction, "ProductionLineDescription":U, SUBSTRING(lin-prod.descricao,1,30), OUTPUT iIdProdLine). 

    RUN addNodeDec IN hGenXml (iIdManufacture, "StandardBatchSize":U, tt-item-eai.qtd-batch-padrao, OUTPUT iIdProduction).  

    &IF DEFINED (bf_man_205) &THEN
        RUN addNodeDec IN hGenXml (iIdManufacture, "FixedMaximum":U, tt-item-eai.qtde-fixa, OUTPUT iIdProduction).  
    &ELSE RUN addNodeDec IN hGenXml (iIdManufacture, "FixedMaximum":U, DECIMAL(SUBSTRING(tt-item-eai.char-1,66,11)), OUTPUT iIdProduction).  
    &ENDIF

    &IF DEFINED (bf_man_205) &THEN
        RUN addNodeDec IN hGenXml (iIdManufacture, "QuantityMaximum":U, tt-item-eai.qtde-max, OUTPUT iIdProduction).  
    &ELSE RUN addNodeDec IN hGenXml (iIdManufacture, "QuantityMaximum":U, DECIMAL(SUBSTRING(tt-item-eai.char-1,117,11)), OUTPUT iIdProduction).  
    &ENDIF
    RUN addNodeDec IN hGenXml (iIdManufacture, "QuantityMaximumOrder":U, tt-item-eai.qt-max-ordem, OUTPUT iIdProduction).
    RUN addNodeDec IN hGenXml (iIdManufacture, "TypeConsumptionOverSalesForecasting":U, tt-item-eai.tp-cons-prev, OUTPUT iIdProduction).

    /* Adiciona informacoes Reportes */
    RUN addNode IN hGenXml    (iIdManufacture, "Reports":U, "", OUTPUT iIdProduction).
    RUN addNodeDec IN hGenXml (iIdProduction, "ReportLabor":U, tt-item-eai.reporte-mob, OUTPUT iIdReports).
    RUN addNodeDec IN hGenXml (iIdProduction, "MfactureGeneralExpensesReport":U, tt-item-eai.reporte-ggf, OUTPUT iIdReports).  
    RUN addNodeDec IN hGenXml (iIdProduction, "ProductionReport":U, tt-item-eai.rep-prod, OUTPUT iIdReports).
    RUN addNodeDec IN hGenXml (iIdProduction, "LaborVariationOver":U, tt-item-eai.var-mob-maior, OUTPUT iIdReports).
    RUN addNodeDec IN hGenXml (iIdProduction, "LaborVariationUnder":U, tt-item-eai.var-mob-menor, OUTPUT iIdReports).
    RUN addNodeDec IN hGenXml (iIdProduction, "VariationQuantityReport":U, tt-item-eai.var-rep, OUTPUT iIdReports).
    RUN addNodeDec IN hGenXml (iIdProduction, "VariationOfQuantityRequestLower":U, tt-item-eai.var-req-menor, OUTPUT iIdReports).
    RUN addNodeDec IN hGenXml (iIdProduction, "VariationOfQuantityRequestOver":U, tt-item-eai.var-req-maior, OUTPUT iIdReports).
    RUN addNodeDec IN hGenXml (iIdProduction, "VariationQuantityTransfered":U, tt-item-eai.var-transf, OUTPUT iIdReports).

    /* Adiciona informacoes Alocacao */
    RUN addNode IN hGenXml (iIdManufacture, "Allocation":U, "", OUTPUT iIdProduction).
    RUN addNodeDec IN hGenXml (iIdProduction,"TypeAllot":U, tt-item-eai.sit-aloc, OUTPUT iIdAllocation).
    RUN addNodeLog IN hGenXml (iIdProduction,"IsUniquePhysicalLocation":U, tt-item-eai.loc-unica, OUTPUT iIdAllocation).

    /* Adiciona informacoes da Localiza‡Æo */
    RUN addNode IN hGenXml (iIdProduction, "Location":U, "", OUTPUT iIdAllocation).
    RUN addNode IN hGenXml (iIdAllocation, "LocationCode":U, tt-item-eai.cod-localiz, OUTPUT iIdLocation).
    FIND FIRST localizacao WHERE localizacao.cod-localiz = tt-item-eai.cod-localiz NO-LOCK NO-ERROR.
    IF AVAIL localizacao THEN
       RUN addNode IN hGenXml (iIdAllocation, "LocationDescription":U, SUBSTRING(localizacao.descricao,1,30), OUTPUT iIdLocation).

    /* Adiciona informacoes da Reposicao */
    RUN addNode IN hGenXml (iIdManufacture, "Reposition":U, "", OUTPUT  iIdProduction).
    &IF DEFINED (bf_man_205) &THEN
        RUN addNodeDec IN hGenXml (iIdProduction, "ReorderPoint":U, tt-item-eai.pto-repos, OUTPUT iIdReposition).  
        RUN addNodeDec IN hGenXml (iIdProduction, "ReplacedLot":U, tt-item-eai.lote-repos, OUTPUT iIdReposition).  
    &ENDIF

    /* Adiciona informacoes da Moeda Padrao */
    RUN addNode IN hGenXml (iIdProduction, "StandardCurr":U, "", OUTPUT iIdReposition).
    RUN addNodeDec IN hGenXml (iIdReposition, "StandardCurrCode":U, tt-item-eai.moeda-padrao, OUTPUT iIdCurr).
    FIND FIRST moeda WHERE moeda.mo-codigo = tt-item-eai.moeda-padrao  NO-LOCK NO-ERROR. 
    IF AVAIL moeda THEN
       RUN addNode IN hGenXml (iIdReposition, "StandardCurrDescription":U, SUBSTRING(moeda.descricao,1,12), OUTPUT iIdCurr).

    /* Politica dos Itens - Valores validos conforme include ininc~\i04in122.i [Default 1]*/
    IF tt-item-eai.politica >= 1 AND tt-item-eai.politica <= 6 THEN
        RUN addNodeDec IN hGenXml (iIdProduction, "Policy":U, tt-item-eai.politica, OUTPUT iIdReposition).
    ELSE RUN addNodeDec IN hGenXml (iIdProduction, "Policy":U, 1, OUTPUT iIdReposition).

    IF SUBSTRING(tt-item-eai.char-1,132,1) = "1" THEN ASSIGN l-logical = YES. ELSE ASSIGN l-logical = NO.
    RUN addNodeLog IN hGenXml (iIdProduction, "IsItRepresentsDemand":U, l-logical, OUTPUT iIdReposition).  

    RUN addNodeDec IN hGenXml (iIdProduction, "ForecastDemand":U, tt-item-eai.ind-prev-demanda, OUTPUT iIdReposition).       

    IF tt-item-eai.periodo-fixo = 0 THEN             
       RUN addNodeDec IN hGenXml (iIdProduction, "FixedPeriod":U, 1,   OUTPUT iIdReposition).
    else    
       RUN addNodeDec IN hGenXml (iIdProduction, "FixedPeriod":U, tt-item-eai.periodo-fixo,   OUTPUT iIdReposition).

    IF substr(tt-item-eai.char-1,10,1) = "1" or substr(tt-item-eai.char-1,10,1) = "2" THEN
     RUN addNodeDec IN hGenXml (iIdProduction, "ManufactureReplenishmentType":U, dec(substr(tt-item-eai.char-1,10,1)), OUTPUT iIdReposition).
    ELSE
     RUN addNodeDec IN hGenXml (iIdProduction, "ManufactureReplenishmentType":U, 1, OUTPUT iIdReposition).
     

    FIND FIRST item-man WHERE item-man.it-codigo = tt-item-eai.it-codigo NO-LOCK NO-ERROR.
    IF AVAIL item-man THEN DO:
       RUN addNodeDec IN hGenXml (iIdProduction, "ManufactureFamilyBacklogPoint":U, item-man.ponto-encomenda, OUTPUT iIdReposition).
    END.
    &IF DEFINED (bf_man_205) &THEN
        RUN addNodeLog IN hGenXml (iIdProduction, "IsIncludeForecastUsage":U, tt-item-eai.cons-consumo, OUTPUT iIdReposition).  
    &ELSE 
        IF SUBSTRING(tt-item-eai.char-1,77,1) = "1" THEN ASSIGN l-logical = YES. ELSE ASSIGN l-logical = NO.
        RUN addNodeLog IN hGenXml (iIdProduction, "IsIncludeForecastUsage":U, l-logical, OUTPUT iIdReposition).  
    &ENDIF
    &IF DEFINED (bf_man_205) &THEN
        RUN addNodeLog IN hGenXml (iIdProduction, "IsUsageProduct":U, tt-item-eai.cons-produto, OUTPUT iIdReposition).  
        RUN addNodeLog IN hGenXml (iIdProduction, "IsIncludeOn-HandBalance":U, tt-item-eai.cons-saldo, OUTPUT iIdReposition).  
    &ENDIF
    RUN addNodeDec IN hGenXml (iIdProduction, "ABCAnalysis":U, tt-item-eai.classif-abc, OUTPUT iIdReposition).

    /* Adiciona informacoes do CRP */
    RUN addNode IN hGenXml (iId, "CapacityResourcePlanning":U, " ", OUTPUT iIdManufacture).
    
    /* Codigo Controle - Valores validos conforme include ininc~\i14in122.i [Default 1] */
    IF tt-item-eai.cd-origem >= 1 AND tt-item-eai.cd-origem <= 3 THEN 
     RUN addNodeDec IN hGenXml (iIdManufacture, "CodeSource":U, tt-item-eai.cd-origem, OUTPUT iIdCRP).
    ELSE
     RUN addNodeDec IN hGenXml (iIdManufacture, "CodeSource":U, 1, OUTPUT iIdCRP).
    
    RUN addNodeDec IN hGenXml (iIdManufacture, "ProductionTargetCalculateCriteria":U, tt-item-eai.ind-calc-meta, OUTPUT iIdCRP).  

    RUN addNodeDec IN hGenXml (iIdManufacture, "Priority":U, tt-item-eai.prioridade, OUTPUT iIdCRP).
    RUN addNodeDec IN hGenXml (iIdManufacture, "Scheduling":U, tt-item-eai.tipo-sched, OUTPUT iIdCRP).
    RUN addNodeDec IN hGenXml (iIdManufacture, "CostFactorDistribution":U, tt-item-eai.val-fator-custo-dis, OUTPUT iIdCRP).
    RUN addNodeLog IN hGenXml (iIdManufacture, "IsConfigUpdate":U, tt-item-eai.atu-conf, OUTPUT iIdCRP).
    RUN addNodeDec IN hGenXml (iIdManufacture, "CalculateLeadTime":U, tt-item-eai.calc-lead-time, OUTPUT iIdCRP).
    &IF DEFINED (bf_man_205) &THEN
        RUN addNodeDec IN hGenXml (iIdManufacture, "FormulationType":U, tt-item-eai.tipo-formula, OUTPUT iIdCRP).  
    &ENDIF
    RUN addNodeDec IN hGenXml (iIdManufacture, "FormulationCode":U, tt-item-eai.cd-formula, OUTPUT iIdCRP).
    &IF DEFINED (bf_man_205) &THEN
        RUN addNodeDec IN hGenXml (iIdManufacture, "PartsForMilion":U, tt-item-eai.per-ppm, OUTPUT iIdCRP).  
    &ENDIF

    /* Adiciona informacoes do Item Refugo */
     &IF DEFINED (bf_man_205) &THEN
        RUN addNode IN hGenXml (iIdManufacture, "ScrapItem":U, "", OUTPUT iIdCRP).
        RUN addNode IN hGenXml (iIdCRP, "ScrapItemCode":U, tt-item-eai.cod-item-refugo, OUTPUT iIdScrapItem).
        FIND FIRST ITEM WHERE ITEM.it-codigo = tt-item-eai.cod-item-refugo NO-LOCK NO-ERROR. 
        IF AVAIL ITEM THEN
           RUN addNode IN hGenXml (iIdCRP, "ScrapItemDescription":U, SUBSTRING(ITEM.desc-item,1,60), OUTPUT iIdScrapItem).
           RUN addNodeDec IN hGenXml (iIdCRP, "ScrapItemLink":U, tt-item-eai.val-relac-refugo-item, OUTPUT iIdScrapItem).
           RUN addNodeLog IN hGenXml (iIdCRP, "IsScrapFiscalPrice":U, tt-item-eai.log-refugo-preco-fisc, OUTPUT iIdScrapItem).
     &ENDIF

    RUN addNode IN hGenXml (iId, "MfgResourcePlanning":U, " ", OUTPUT iIdManufacture).
    RUN addNodeDec IN hGenXml (iIdManufacture, "MaxStorageCapacityPlant":U, tt-item-eai.cap-est-fabr, OUTPUT iIdMRP).

    /* Valores validos conforme include ininc~\i06in122.i [Default 1]*/
    IF tt-item-eai.classe-repro >= 1 AND tt-item-eai.classe-repro <= 6 THEN
       RUN addNodeDec IN hGenXml (iIdManufacture, "ReschedulingClass":U, tt-item-eai.classe-repro, OUTPUT iIdMRP).
    ELSE RUN addNodeDec IN hGenXml (iIdManufacture, "ReschedulingClass":U, 1, OUTPUT iIdMRP).
    RUN addNodeDec IN hGenXml (iIdManufacture, "FamilyPlanControled":U, tt-item-eai.contr-plan, OUTPUT iIdMRP).

    /* Adiciona informacoes do Planejador */
    RUN addNode IN hGenXml (iIdManufacture, "Planner":U, "", OUTPUT iIdMRP).
    RUN addNode IN hGenXml (iIdMRP, "PlannerCode":U, tt-item-eai.cd-planejado, OUTPUT iIdPlanner).
    FIND FIRST planejad WHERE planejad.cd-planejado = tt-item-eai.cd-planejado NO-LOCK NO-ERROR.
    IF AVAIL planejad THEN
       RUN addNode IN hGenXml (iIdMRP, "PlannerDescription":U, SUBSTRING(planejad.nome,1,12), OUTPUT iIdPlanner).

    IF AVAIL item-man THEN DO:
       RUN addNodeDec IN hGenXml (iIdManufacture, "ListForRequirementsScheduling":U, item-man.ind-lista-mrp, OUTPUT iIdMRP).  
       RUN addNodeDec IN hGenXml (iIdManufacture, "QuantityMinResuppliment":U, item-man.qt-min-res-fabr, OUTPUT iIdMRP).
       RUN addNodeDec IN hGenXml (iIdManufacture, "VariationTimeRessupliment":U, item-man.var-tempo-res-fabr, OUTPUT iIdMRP).
       RUN addNodeDec IN hGenXml (iIdManufacture, "RessuplimentQuantityVariance":U, item-man.var-qtd-res-fabr, OUTPUT iIdMRP).
       RUN addNodeDec IN hGenXml (iIdManufacture, "ProcessCost":U, item-man.ind-lista-csp, OUTPUT iIdMRP).
       RUN addNodeLog IN hGenXml (iIdManufacture, "IsEvaluateConsumeSwitch":U, item-man.log-ad-consumo, OUTPUT iIdMRP).
       RUN addNodeLog IN hGenXml (iIdManufacture, "IsAutomaticApproveStructut":U, item-man.log-aprov-estrut, OUTPUT iIdMRP).
       RUN addNodeLog IN hGenXml (iIdManufacture, "IsAutomaticApproveRoute":U, item-man.log-aprov-rot, OUTPUT iIdMRP).
       RUN addNodeLog IN hGenXml (iIdManufacture, "IsReportFinalizeOrder":U, item-man.log-finaliz-op, OUTPUT iIdMRP).
    END.
    RUN addNodeDec IN hGenXml (iIdManufacture, "FixedHorizon":U, tt-item-eai.horiz-fixo, OUTPUT iIdMRP).
    &IF DEFINED (bf_man_205) &THEN
         RUN addNode IN hGenXml (iIdManufacture, "ReleaseHorizon":U, SUBSTRING(tt-item-eai.char-1,129,3), OUTPUT iIdMRP).
    &ENDIF

    /* Adiciona informacoes de Usuario  */
    IF AVAIL item-man THEN DO:
        RUN addNode IN hGenXml (iId, "User", "", OUTPUT iIdManufacture).
        RUN addNode IN hGenXml (iIdManufacture, "ReleaseUser":U, item-man.user-lib, OUTPUT iIdUser).
        RUN addNode IN hGenXml (iIdManufacture, "UserReleaseStructure":U, item-man.user-lib-estrut, OUTPUT iIdUser).
        RUN addNode IN hGenXml (iIdManufacture, "UserReleaseRouting":U, item-man.user-lib-rot, OUTPUT iIdUser).
        RUN addNode IN hGenXml (iIdManufacture, "UserLastAlteration":U, tt-item-eai.usuario-alt, OUTPUT iIdUser).
        RUN addNode IN hGenXml (iIdManufacture, "UserMadeObsoletion":U, tt-item-eai.usuario-obsol, OUTPUT iIdUser).
    END.

    /* Adiciona informacoes do APS  */
    RUN addNode IN hGenXml (iId, "AdvancedPlanningSchedule":U, "", OUTPUT iIdManufacture).

    /* Politica APS - Valores validos conforme include ininc~\i21in122.i */
    &IF DEFINED (bf_man_205) &THEN
        IF tt-item-eai.politica-aps >= 1 AND tt-item-eai.politica-aps <= 9 THEN
           RUN addNodeDec IN hGenXml (iIdManufacture, "PolicyAdvancedPlanningSchedule":U, tt-item-eai.politica-aps, OUTPUT iIdAps).  

           RUN addNodeLog IN hGenXml (iIdManufacture, "IsMultiNetwork":U, tt-item-eai.log-multi-malha, OUTPUT iIdAps).
           RUN addNode IN hGenXml (iIdManufacture, "ProduceNetworkCode":U, tt-item-eai.cod-malha, OUTPUT iIdAps).  
           RUN addNode IN hGenXml (iIdManufacture, "BufferCode":U, tt-item-eai.cod-pulmao, OUTPUT iIdAps).  
    &ELSE 
        IF INTEGER(SUBSTRING(tt-item-eai.char-1,60,2)) >= 1 AND INTEGER(SUBSTRING(tt-item-eai.char-1,60,2)) <= 9 THEN
           RUN addNodeDec IN hGenXml (iIdManufacture, "PolicyAdvancedPlanningSchedule":U, INTEGER(SUBSTRING(tt-item-eai.char-1,60,2)), OUTPUT iIdAps).  

           RUN addNode IN hGenXml (iIdManufacture, "ProduceNetworkCode":U, SUBSTRING(tt-item-eai.char-1,78,5), OUTPUT iIdAps).  
           RUN addNode IN hGenXml (iIdManufacture, "BufferCode":U, SUBSTRING(tt-item-eai.char-1,83,5), OUTPUT iIdAps).  
    &ENDIF

/* fim do include */
