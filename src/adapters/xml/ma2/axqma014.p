     addStack(1).
          RUN searchTag IN hGenXml (INPUT "Filter", INPUT getStack(), OUTPUT iId).
          if (iId <> ?) THEN DO:
               addStack(iId).

                    RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ItemCode", OUTPUT ItemCode).
                    RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "CutOffDate", OUTPUT CutOffDate).
