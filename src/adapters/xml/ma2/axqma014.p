                    RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "Levels", OUTPUT Levels).
               delStack().
          END.

     delStack().
     /* ********* LEITURA DA MENSAGEM - END   ********* */


     /* ********* EFETIVAÄ«O - BEGIN ********* */
