    RETURN "NOK":U.
END.
IF NOT lCreateMsg THEN RETURN "OK":U.
/* PREENCHE O VALOR DO ELEM. Comment DE TransactionId */
RUN setTransInfoComment IN hMessageHandler ("Programa: " +  cProgName + " - "  +  "VersÆo: "     +  cProgVersion ). 
