 RUN addNode IN hGenXml (getStack(), "Upsert":U, "", OUTPUT iId).
     addStack(iId).

     RUN addNode IN hGenXml (getStack(), "ListOfSite":U, "":U, OUTPUT iId).
     addStack(iId).

         FOR EACH ttListOfSite:
              RUN addNode IN hGenXml (getStack(), "Site":U, "", OUTPUT iId).
              addStack(iId).
                   RUN addNode IN hGenXml (getStack(), "DefaultSiteCode":U, ttListOfSite.DefaultSiteCode, OUTPUT iId).
                   IF  ttListOfSite.DefaultSiteDescription <> ? THEN
                       RUN addNode IN hGenXml (getStack(), "DefaultSiteDescription":U, ttListOfSite.DefaultSiteDescription, OUTPUT iId).
              delStack().
         END.
     delStack().
     run addNodeDec in hGenXml (getStack(), "ReferenceValue":U, de-val-refer-atualiz, OUTPUT iId).


