          RUN addNodeLog IN hGenXml (getStack(), "IsWareHouseConsidered":U, IsWareHouseConsidered, OUTPUT iId).
          RUN addNodeLog IN hGenXml (getStack(), "IsVendorConsidered":U, IsVendorConsidered, OUTPUT iId).
          
          RUN addNodeLog IN hGenXml (getStack(), "IsXML":U, IsXML, OUTPUT iId).
          RUN addNodeLog IN hGenXml (getStack(), "IsItemSiteConsidered":U, IsItemSiteConsidered , OUTPUT iId).
          RUN addNodeDec IN hGenXml (getStack(), "ReferenceValue":U, de-val-refer-atualiz, OUTPUT iId).

     delStack().


