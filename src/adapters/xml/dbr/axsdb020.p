/* INFORMA A EMPRESA E O ESTABELECIMENTO */
RUN setCompanyId IN hMessageHandler (String(v_cdn_empres_usuar) , " " ).  

     /* RESETA OS VALORES */
     RUN reset IN hGenXml.

     /* SETA VALOR DE ENCODING */
     RUN setEncoding IN hGenXml ("UTF-8":U).

     RUN addNode IN hGenXml (getStack(), "Upsert":U, " ", OUTPUT iId).
     addStack(iId).

          RUN addNodeLog IN hGenXml (getStack(), "IsEstructConsidered":U, IsEstructConsidered, OUTPUT iId).
          RUN addNodeLog IN hGenXml (getStack(), "IsOperationConsidered":U, IsOperationConsidered, OUTPUT iId).
