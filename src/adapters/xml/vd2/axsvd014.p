          ttCustomerEvaluationRet.dataLimiteCreditoAdic = dtDataLimiteCreditoAdic 
          ttCustomerEvaluationRet.moedaLimiteCredito    = cMoedaLimiteCredito. 

   FOR FIRST emitente
       WHERE ROWID(emitente) = rw-emitente EXCLUSIVE-LOCK:

       IF ttCustomerEvaluationRet.LPT__sAcao = "Aprovado" THEN
       ASSIGN emitente.ind-cre-cli   = 1
              emitente.lim-credito   = ttCustomerEvaluationRet.limiteCredito 
              emitente.dt-lim-cred   = ttCustomerEvaluationRet.dataLimiteCredito
              emitente.lim-adicional = ttCustomerEvaluationRet.limiteCreditoAdic 
              emitente.dt-fim-cred   = ttCustomerEvaluationRet.dataLimiteCreditoAdic
              emitente.moeda-libcre  = INTEGER(ttCustomerEvaluationRet.moedaLimiteCredito).
       
       IF ttCustomerEvaluationRet.LPT__sAcao = "Negado" THEN
       ASSIGN emitente.ind-cre-cli   = 4
              emitente.lim-credito   = 0
              emitente.dt-lim-cred   = TODAY
              emitente.lim-adicional = 0
              emitente.dt-fim-cred   = TODAY
              emitente.moeda-libcre  = INTEGER(ttCustomerEvaluationRet.moedaLimiteCredito).    
