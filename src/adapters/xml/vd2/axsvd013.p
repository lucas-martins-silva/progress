/* VERIFICA SE A MENSAGEM FOI PROCESSADA COM SUCESSO */
RUN getReturnStatus IN hMessageHandler (OUTPUT pSendSuccess, OUTPUT pTotalErrors).

/* SE NAO ENVIO COM SUCESSO */
IF NOT pSendSuccess THEN DO:
     REPEAT iCount = 1 TO pTotalErrors:
          CREATE tt_log_erro.
          RUN getError IN hMessageHandler (iCount, OUTPUT tt_log_erro.ttv_num_cod_erro, OUTPUT pErrorType, OUTPUT tt_log_erro.ttv_des_msg_erro).

          ASSIGN tt_log_erro.ttv_num_cod_erro  = 17006
                 tt_log_erro.ttv_des_msg_ajuda = tt_log_erro.ttv_des_msg_erro.
     END.
     RETURN "NOK".
END.
ELSE DO:

   RUN getCompleteReturnHandle IN hMessageHandler (OUTPUT hOutputXML).
   RUN RESET                   IN hGenXml.
   RUN loadXml                 IN hGenXml (INPUT hOutputXML).
   RUN searchTag IN hGenXml ( INPUT "DatasulMessage":U, INPUT 0, OUTPUT iIdDatasulMessage ).
   IF  iIdDatasulMessage <> ? THEN DO:
       addStack(iIdDatasulMessage).

           RUN searchTag IN hGenXml (INPUT "ReturnContent":U, INPUT iIdDatasulMessage, OUTPUT iIdReturnContent).
           IF  iIdReturnContent <> ? THEN DO:
               addStack(iIdReturnContent).
          
                   RUN searchTag IN hGenXml (INPUT "ListOfExtraInformation":U, INPUT iIdReturnContent, OUTPUT iIdListOfExtraInformation).
                   IF  iIdListOfExtraInformation <> ? THEN DO:
                       addStack(iIdListOfExtraInformation).
                   
                          RUN getFirstSonId IN hGenXml (INPUT iIdListOfExtraInformation, OUTPUT iIdExtraInformation).
                          DO WHILE iIdExtraInformation <> ?: /* tags ExtraInformation */
                              addStack(iIdExtraInformation).
                                    
                                  RUN getSonVal  IN hGenXml (INPUT iIdExtraInformation, INPUT "Key":U, OUTPUT cKey).
                               
                                  CASE cKey:
                                      WHEN "LPT__iRetorno":U  
                                          THEN RUN getSonVal IN hGenXml (INPUT iIdExtraInformation, INPUT "Value":U, OUTPUT cRetorno).
                                      WHEN "LPT__sAcao":U           
                                          THEN RUN getSonVal IN hGenXml (INPUT iIdExtraInformation, INPUT "Value":U, OUTPUT cAcao).
                                      WHEN "LPT__sMsgErro":U        
                                          THEN RUN getSonVal IN hGenXml (INPUT iIdExtraInformation, INPUT "Value":U, OUTPUT cMsgErro).
                                      WHEN "LPT__sMsgErroCred":U    
                                          THEN RUN getSonVal IN hGenXml (INPUT iIdExtraInformation, INPUT "Value":U, OUTPUT cMsgErroCred).
                                      WHEN "MensagemRetorno":U 
                                          THEN RUN getSonVal IN hGenXml (INPUT iIdExtraInformation, INPUT "Value":U, OUTPUT cNumMsgRetorno).
                                  END CASE.
                                 
                                  ASSIGN iIdExtraInformation = getStack().
                            
                              delStack().
                   
                              RUN getNextSonId IN hGenXml (INPUT iIdListOfExtraInformation, INPUT iIdExtraInformation, OUTPUT iIdExtraInformation).
                   
                          END.
                       delStack().
                   END.
               delStack().
           END.
       delStack().
   END.

   IF cRetorno <> "0":U THEN DO: 
      CREATE tt_log_erro.
      ASSIGN tt_log_erro.ttv_num_cod_erro  = 17006
             tt_log_erro.ttv_des_msg_erro  = cMsgErro
             tt_log_erro.ttv_des_msg_ajuda = cMsgErro.
   END.

   EMPTY TEMP-TABLE ttCreditEvaluationRet.

   CREATE ttCreditEvaluationRet.
   ASSIGN ttCreditEvaluationRet.LPT__iRetorno     = cRetorno
          ttCreditEvaluationRet.LPT__sAcao        = cAcao
          ttCreditEvaluationRet.LPT__sMsgErro     = cMsgErro
          ttCreditEvaluationRet.LPT__sMsgErroCred = cMsgErroCred. 

   FIND FIRST tt-param-aval NO-ERROR.

   FOR FIRST ped-venda
       WHERE ped-venda.nome-abrev = p-nome-abrev
         AND ped-venda.nr-pedcli  = p-nr-pedcli EXCLUSIVE-LOCK:

      CASE ttCreditEvaluationRet.LPT__sAcao:
          WHEN "APROVADO" 
              THEN DO: /* era APROVA */
                  IF  tt-param-aval.embarque THEN DO:
                      IF  tt-param-aval.param-aval = 1 THEN 
                          ASSIGN ped-venda.cod-sit-aval = IF emitente.ind-aval-embarque = 3 THEN 2 ELSE 3.
                      ELSE 
                          ASSIGN ped-venda.cod-sit-aval = 3.
                  END.
                  ELSE DO:
                      IF  emitente.ind-aval-embarque = 1 THEN DO:
                          IF  tt-param-aval.param-aval = 1 THEN 
                              ASSIGN ped-venda.cod-sit-aval = IF emitente.ind-aval = 3 THEN 2 ELSE 3.
                          ELSE 
                              ASSIGN ped-venda.cod-sit-aval = 3.
                      END.
                      ELSE 
                          ASSIGN ped-venda.cod-sit-aval = 2.
                  END. 
                  IF cRetorno = "0":U THEN DO: 
                     CREATE tt_log_erro.
                     /* Inicio -- Projeto Internacional */
                     {utp/ut-liter.i "Avaliaá∆o_de_crÇdito_realizada_com_sucesso" *}
                     ASSIGN tt_log_erro.ttv_num_cod_erro  = 27979
                            tt_log_erro.ttv_des_msg_erro  = RETURN-VALUE
                            tt_log_erro.ttv_des_msg_ajuda = tt_log_erro.ttv_des_msg_erro.
                  END.
              END.
          WHEN "REPROVADO" /* ERA 'NEGA' */   
              THEN DO: 
                  ASSIGN ped-venda.cod-sit-aval = 4. /* n∆o aprovado */
                  IF cRetorno = "0":U THEN DO:
                    &IF '{&bf_dis_versao_ems}' <= '2.062' &THEN                                     
                    FIND FIRST cad-msgs
                        WHERE cad-msgs.cd-msg = INTEGER(cNumMsgRetorno) NO-LOCK NO-ERROR.
                    IF AVAIL cad-msgs THEN DO:
                        CREATE tt_log_erro.
                        ASSIGN tt_log_erro.ttv_num_cod_erro  = cad-msgs.cd-msg
                               tt_log_erro.ttv_des_msg_erro  = cad-msgs.texto-msg
                               tt_log_erro.ttv_des_msg_ajuda = cad-msgs.help-msg.

                        ASSIGN ped-venda.desc-bloq = cad-msgs.texto-msg.
                    END.
                    &ELSE                                                                           
                    FIND FIRST cadast_msg                                       
                        WHERE cadast_msg.cdn_msg = INTEGER(cNumMsgRetorno) NO-LOCK NO-ERROR.
                    IF AVAIL cadast_msg THEN DO:
                        CREATE tt_log_erro.
                        ASSIGN tt_log_erro.ttv_num_cod_erro  = cadast_msg.cdn_msg
                               tt_log_erro.ttv_des_msg_erro  = cadast_msg.des_text_msg
                               tt_log_erro.ttv_des_msg_ajuda = cadast_msg.dsl_help_msg.

                        ASSIGN ped-venda.desc-bloq = cadast_msg.des_text_msg.
                    END.
                    &ENDIF 
                  END.
              END.
          WHEN "NAO AVALIADO" /* ERA 'ANALISA' */
              THEN DO: 
                  ASSIGN ped-venda.cod-sit-aval = 5. /* pendente informaá∆o */
                  &IF '{&bf_dis_versao_ems}' <= '2.062' &THEN                                     
                  FIND FIRST cad-msgs
                      WHERE cad-msgs.cd-msg = 51281 NO-LOCK NO-ERROR.
                  IF AVAIL cad-msgs THEN DO:
                     CREATE tt_log_erro.
                     ASSIGN tt_log_erro.ttv_num_cod_erro  = cad-msgs.cd-msg
                            tt_log_erro.ttv_des_msg_erro  = cad-msgs.texto-msg
                            tt_log_erro.ttv_des_msg_ajuda = cad-msgs.help-msg.

                     ASSIGN ped-venda.desc-bloq = cad-msgs.texto-msg.
                  END.
                  &ELSE                                                                           
                  FIND FIRST cadast_msg 
                      WHERE cadast_msg.cdn_msg = 51281 NO-LOCK NO-ERROR.
                  IF AVAIL cadast_msg THEN DO:
                      CREATE tt_log_erro.
                      ASSIGN tt_log_erro.ttv_num_cod_erro  = cadast_msg.cdn_msg
                             tt_log_erro.ttv_des_msg_erro  = cadast_msg.des_text_msg
                             tt_log_erro.ttv_des_msg_ajuda = cadast_msg.dsl_help_msg.

                      ASSIGN ped-venda.desc-bloq = cadast_msg.des_text_msg.
                  END.
                  &ENDIF 
              END.
          OTHERWISE DO:
              ASSIGN ped-venda.cod-sit-aval = 1. /* n∆o avaliado */
              &IF '{&bf_dis_versao_ems}' <= '2.062' &THEN                                     
              FIND FIRST cad-msgs
                  WHERE cad-msgs.cd-msg = 51281 NO-LOCK NO-ERROR.
              IF AVAIL cad-msgs THEN DO:
                 CREATE tt_log_erro.
                 ASSIGN tt_log_erro.ttv_num_cod_erro  = cad-msgs.cd-msg
                        tt_log_erro.ttv_des_msg_erro  = cad-msgs.texto-msg
                        tt_log_erro.ttv_des_msg_ajuda = cad-msgs.help-msg.

                 ASSIGN ped-venda.desc-bloq = cad-msgs.texto-msg.
              END.
              &ELSE                                                                           
              FIND FIRST cadast_msg 
                  WHERE cadast_msg.cdn_msg = 51281 NO-LOCK NO-ERROR.
              IF AVAIL cadast_msg THEN DO:
                  CREATE tt_log_erro.
                  ASSIGN tt_log_erro.ttv_num_cod_erro  = cadast_msg.cdn_msg
                         tt_log_erro.ttv_des_msg_erro  = cadast_msg.des_text_msg
                         tt_log_erro.ttv_des_msg_ajuda = cadast_msg.dsl_help_msg.

                  ASSIGN ped-venda.desc-bloq = cadast_msg.des_text_msg.
              END.
              &ENDIF 
          END.
              
      END CASE.

      ASSIGN ped-venda.user-aprov   = "Intellector"
             ped-venda.quem-aprovou = "Intellector"
             ped-venda.dt-apr-cred  = TODAY.                                                                      

   END.
   
   RETURN "OK".

END.


/* Grava XML de retorno do intellector na fila do EAI */
RUN piFilaEAI(2,p-nr-pedcli + "," + p-nome-abrev).


