                         IF ttItemScheduling.MinimumLotQuantity = ? THEN ASSIGN ttItemScheduling.MinimumLotQuantity = 0.

                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "QuantityAccumNeed", OUTPUT ttItemScheduling.QuantityAccumNeed).
                         IF  ttItemScheduling.QuantityAccumNeed = ? THEN ASSIGN ttItemScheduling.QuantityAccumNeed = 0.

                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "DeliveryQuantityAccum", OUTPUT ttItemScheduling.DeliveryQuantityAccum).
                         IF ttItemScheduling.DeliveryQuantityAccum = ? THEN ASSIGN ttItemScheduling.DeliveryQuantityAccum = 0.

                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "LastDeliveryQuantity", OUTPUT ttItemScheduling.LastDeliveryQuantity).
                         IF ttItemScheduling.LastDeliveryQuantity = ? THEN ASSIGN ttItemScheduling.LastDeliveryQuantity = 0.

                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "DeliveryType", OUTPUT ttItemScheduling.DeliveryType).
                         IF  ttItemScheduling.DeliveryType = ? THEN ASSIGN ttItemScheduling.DeliveryType = 1.  /* Caso n∆o venha a tag, ser† assumido Entrega Firme */

                         RUN searchTag IN hGenXml (INPUT "ListofDeliveryScheduling", INPUT getStack(), OUTPUT iId).
                         if  (iId <> ?) THEN DO:
                             addStack(iId).

                             RUN getFirstSonId IN hGenXml (INPUT getStack(), OUTPUT iId).
