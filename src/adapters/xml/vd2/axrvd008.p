PROCEDURE PI-DELJIT:
DEF INPUT PARAM C-PONTO AS CHAR NO-UNDO.

DEF VAR i-nr-entrega   AS INT NO-UNDO.
DEF VAR i-num-ord-cham AS INT NO-UNDO.

find first emitente no-lock
    where  emitente.nome-abrev = tt-prog-cli.nome-abrev no-error.

if  (C-PONTO = 'PROG-CLI'
or   C-PONTO = 'PROG-ITEM' and ttItemScheduling.DeliveryType = 1 /* Entregas Firmes */)
or (avail emitente 
    and   &IF '{&BF_DIS_VERSAO_EMS}' < '2.09' &THEN
              substring(emitente.char-1, 101, 1) = 's'
          &ELSE
              emitente.log-gera-chamado
          &ENDIF
   ) then do:
    
    if  C-PONTO = "PROG-CLI" THEN DO:
        find last prog-cli
             where prog-cli.nome-abrev  = tt-prog-cli.nome-abrev
             and   prog-cli.nr-progcli  = tt-prog-cli.nr-progcli
             no-lock no-error.

        IF  AVAIL prog-cli THEN DO:
            ASSIGN tt-prog-cli.cd-origem        = prog-cli.cd-origem
                   tt-prog-cli.dt-implant       = prog-cli.dt-implant
                   tt-prog-cli.user-implant     = prog-cli.user-implant
                   tt-prog-cli.cod-emitente     = prog-cli.cod-emitente      
                   tt-prog-cli.nome-abrev       = prog-cli.nome-abrev        
                   tt-prog-cli.nr-progcli       = prog-cli.nr-progcli        
                   tt-prog-cli.dt-emissao       = prog-cli.dt-emissao        
                   tt-prog-cli.proc-edi         = prog-cli.proc-edi          
                   tt-prog-cli.observacoes      = prog-cli.observacoes       
                   tt-prog-cli.cd-situacao      = prog-cli.cd-situacao       
                   tt-prog-cli.tp-qt-prg        = prog-cli.tp-qt-prg         
                   tt-prog-cli.ind-orig-entrada = prog-cli.ind-orig-entrada  
                   tt-prog-cli.nro-proc-entrada = prog-cli.nro-proc-entrada.           
        END.

    END.

    if  C-PONTO = "PROG-ITEM" THEN DO:
        FIND LAST  prog-cli
             where prog-cli.nome-abrev  = tt-prog-cli.nome-abrev
             and   prog-cli.nr-progcli  = tt-prog-item.nr-progcli
             no-lock no-error.

        IF AVAIL prog-cli THEN DO:

            FIND prog-item
                 WHERE prog-item.nr-programa = prog-cli.nr-programa
                 AND   prog-item.it-codigo   = tt-prog-item.it-codigo
                 AND   prog-item.cod-refer   = tt-prog-item.cod-refer
                 AND   prog-item.cod-entrega = tt-prog-item.cod-entrega
                 AND   prog-item.nr-pedcli   = tt-prog-item.nr-pedcli
                 NO-LOCK NO-ERROR.

            IF  AVAIL prog-item THEN DO:

                assign  tt-prog-item.nome-abrev           =     prog-cli.nome-abrev
                        tt-prog-item.nr-progcli           =     prog-cli.nr-progcli                
                        tt-prog-item.nr-programa          =     prog-item.nr-programa
                        tt-prog-item.it-codigo            =     prog-item.it-codigo    
                        tt-prog-item.cod-refer            =     prog-item.cod-refer    
                        tt-prog-item.cd-freq              =     prog-item.cd-freq      
                        tt-prog-item.dt-ult-ent           =     prog-item.dt-ult-ent   
                        tt-prog-item.cod-estabel          =     prog-item.cod-estabel  
                        tt-prog-item.serie                =     prog-item.serie        
                        tt-prog-item.nr-nota-fis          =     prog-item.nr-nota-fis  
                        tt-prog-item.dt-ult-nf            =     prog-item.dt-ult-nf    
                        tt-prog-item.qt-ult-ent           =     prog-item.qt-ult-ent   
                        tt-prog-item.qt-ent-acum          =     prog-item.qt-ent-acum  
                        tt-prog-item.qt-nec-acum          =     prog-item.qt-nec-acum  
                        tt-prog-item.qt-atraso            =     prog-item.qt-atraso    
                        tt-prog-item.qt-lote-min          =     prog-item.qt-lote-min  
                        tt-prog-item.nr-pedcli            =     prog-item.nr-pedcli    
                        tt-prog-item.nr-sequencia         =     prog-item.nr-sequencia 
                        tt-prog-item.nr-pedido            =     prog-item.nr-pedido    
                        tt-prog-item.dt-atualiza          =     prog-item.dt-atualiza  
                        tt-prog-item.observacoes          =     prog-item.observacoes  
                        tt-prog-item.cod-entrega          =     prog-item.cod-entrega  
                        tt-prog-item.loc-descarga         =     prog-item.loc-descarga 
                        tt-prog-item.cd-origem            =     prog-item.cd-origem    
                        tt-prog-item.cd-situacao          =     prog-item.cd-situacao  
                        tt-prog-item.dt-implant           =     prog-item.dt-implant   
                        tt-prog-item.dt-cancel            =     prog-item.dt-cancel    
                        tt-prog-item.dt-alter             =     prog-item.dt-alter     
                        tt-prog-item.user-implant         =     prog-item.user-implant 
                        tt-prog-item.user-cancel          =     prog-item.user-cancel  
                        tt-prog-item.user-alter           =     prog-item.user-alter   
                        tt-prog-item.motivo-can           =     prog-item.motivo-can   
                        tt-prog-item.motivo-imp           =     prog-item.motivo-imp   
                        tt-prog-item.contato              =     prog-item.contato      
                        tt-prog-item.user-implant         =     prog-item.user-implant 

                        tt-prog-item.erro-consist         = no
                        SUBSTRING(tt-prog-item.char-1,100,1) = "1"  /* item */                                                     

                        tt-prog-item.qt-lote-min          =     prog-item.qt-lote-min
                        tt-prog-item.qt-nec-acum          =     prog-item.qt-nec-acum
                        tt-prog-item.qt-ent-acum          =     prog-item.qt-ent-acum
                        tt-prog-item.qt-ult-ent           =     prog-item.qt-ult-ent.
            END.
        END.
    END.

    if  C-PONTO = "RECRIAR-PROGRAMA" THEN DO:
        for each tt-prog-cli:

            FIND FIRST TT-PROG-ITEM
                 WHERE TT-PROG-ITEM.NOME-ABREV = tt-prog-cli.nome-abrev
                 AND   TT-PROG-ITEM.NR-PROGCLI = tt-prog-cli.nr-progcli
                 NO-LOCK NO-ERROR.

            if not avail tt-prog-item 
            then next.        

            FIND LAST  prog-cli
                 where prog-cli.nome-abrev  = tt-prog-cli.nome-abrev
                 and   prog-cli.nr-progcli  = tt-prog-cli.nr-progcli
                 no-lock no-error.

            IF NOT AVAIL PROG-CLI 
            THEN NEXT.

            for each prog-item
                WHERE prog-item.nr-programa = prog-cli.nr-programa no-lock:

                FIND first tt-prog-item
                     WHERE tt-prog-item.it-codigo   = prog-item.it-codigo
                     AND   tt-prog-item.cod-refer   = prog-item.cod-refer
                     AND   tt-prog-item.cod-entrega = prog-item.cod-entrega
                     AND   tt-prog-item.nr-pedcli   = prog-item.nr-pedcli
                     NO-LOCK NO-ERROR.

                if avail tt-prog-item
                then next.

                create  tt-prog-item.
                assign  tt-prog-item.nome-abrev           =     prog-cli.nome-abrev
                        tt-prog-item.nr-progcli           =     prog-cli.nr-progcli                
                        tt-prog-item.it-codigo            =     prog-item.it-codigo    
                        tt-prog-item.cod-refer            =     prog-item.cod-refer    
                        tt-prog-item.cd-freq              =     prog-item.cd-freq      
                        tt-prog-item.dt-ult-ent           =     prog-item.dt-ult-ent   
                        tt-prog-item.cod-estabel          =     prog-item.cod-estabel  
                        tt-prog-item.serie                =     prog-item.serie        
                        tt-prog-item.nr-nota-fis          =     prog-item.nr-nota-fis  
                        tt-prog-item.dt-ult-nf            =     prog-item.dt-ult-nf    
                        tt-prog-item.qt-ult-ent           =     prog-item.qt-ult-ent   
                        tt-prog-item.qt-ent-acum          =     prog-item.qt-ent-acum  
                        tt-prog-item.qt-nec-acum          =     prog-item.qt-nec-acum  
                        tt-prog-item.qt-atraso            =     prog-item.qt-atraso    
                        tt-prog-item.qt-lote-min          =     prog-item.qt-lote-min  
                        tt-prog-item.nr-pedcli            =     prog-item.nr-pedcli    
                        tt-prog-item.nr-sequencia         =     prog-item.nr-sequencia 
                        tt-prog-item.nr-pedido            =     prog-item.nr-pedido    
                        tt-prog-item.dt-atualiza          =     prog-item.dt-atualiza  
                        tt-prog-item.observacoes          =     prog-item.observacoes  
                        tt-prog-item.cod-entrega          =     prog-item.cod-entrega  
                        tt-prog-item.loc-descarga         =     prog-item.loc-descarga 
                        tt-prog-item.cd-origem            =     prog-item.cd-origem    
                        tt-prog-item.cd-situacao          =     prog-item.cd-situacao  
                        tt-prog-item.dt-implant           =     prog-item.dt-implant   
                        tt-prog-item.dt-cancel            =     prog-item.dt-cancel    
                        tt-prog-item.dt-alter             =     prog-item.dt-alter     
                        tt-prog-item.user-implant         =     prog-item.user-implant 
                        tt-prog-item.user-cancel          =     prog-item.user-cancel  
                        tt-prog-item.user-alter           =     prog-item.user-alter   
                        tt-prog-item.motivo-can           =     prog-item.motivo-can   
                        tt-prog-item.motivo-imp           =     prog-item.motivo-imp   
                        tt-prog-item.contato              =     prog-item.contato      
                        tt-prog-item.user-implant         =     prog-item.user-implant 
                        
                        tt-prog-item.erro-consist         = no
                        SUBSTRING(tt-prog-item.char-1,100,1) = "1"  /* item */                                                     

                        tt-prog-item.qt-lote-min          =     prog-item.qt-lote-min
                        tt-prog-item.qt-nec-acum          =     prog-item.qt-nec-acum
                        tt-prog-item.qt-ent-acum          =     prog-item.qt-ent-acum
                        tt-prog-item.qt-ult-ent           =     prog-item.qt-ult-ent
                        tt-prog-item.indicador            = 2.                    
            END.

            FOR EACH tt-prog-item:
                FOR EACH prog-ent 
                    where   prog-ent.nr-programa  = prog-cli.nr-programa
                      and   prog-ent.it-codigo    = tt-prog-item.it-codigo
                      and   prog-ent.cod-refer    = tt-prog-item.cod-refer
                      and   prog-ent.cod-entrega  = tt-prog-item.cod-entrega
                      and   prog-ent.nr-pedcli    = tt-prog-item.nr-pedcli NO-LOCK:

                    IF  tt-prog-item.indicador = 1 
                    AND prog-ent.dt-entrega < TODAY THEN NEXT.
                    FIND FIRST tt-prog-ent  
                        where  tt-prog-ent.nome-abrev  = prog-cli.nome-abrev
                          AND  tt-prog-ent.nr-progcli  = prog-cli.nr-progcli
                          AND  tt-prog-ent.it-codigo   = prog-ent.it-codigo
                          AND  tt-prog-ent.cod-refer   = prog-ent.cod-refer
                          AND  tt-prog-ent.cod-entrega = prog-ent.cod-entrega 
                          AND  tt-prog-ent.nr-pedcli   = prog-ent.nr-pedcli
                          AND  tt-prog-ent.dt-entrega  = prog-ent.dt-entrega
                          AND  tt-prog-ent.hr-entrega  = prog-ent.hr-entrega
                          EXCLUSIVE-LOCK NO-ERROR.             

                    IF AVAIL tt-prog-ent THEN DO:
                        &IF "{&bf_dis_versao_ems}" >= "2.02"  &THEN
                            IF  prog-ent.tp-entrega           = 1 AND       /* Entregas Firmes */ 
                                i-idi-confir-programac-entreg = 2 AND       /* Acumula Quantidades */
                                tt-prog-ent.qt-pedida        <> 0 THEN DO:   
                                FOR FIRST ped-ent USE-INDEX cd-sit-prog NO-LOCK
                                    WHERE ped-ent.nome-abrev   = prog-cli.nome-abrev
                                    AND   ped-ent.nr-pedcli    = prog-ent.nr-pedcli
                                    AND   ped-ent.nr-sequencia = tt-prog-item.nr-sequencia
                                    AND   ped-ent.it-codigo    = prog-ent.it-codigo
                                    AND   ped-ent.cod-refer    = prog-ent.cod-refer
                                    AND   ped-ent.nr-programa  = prog-cli.nr-programa
                                    AND   ped-ent.dt-entrega   = prog-ent.dt-entrega
                                    AND   ped-ent.hr-entrega   = prog-ent.hr-entrega:
                                    ASSIGN tt-prog-ent.qt-pedida = (prog-ent.qt-pedida - ped-ent.qt-atendida) + tt-prog-ent.qt-pedida.
                                END.
                                
                                for first emitente no-lock
                                    where emitente.nome-abrev = tt-prog-cli.nome-abrev:

                                    &IF '{&BF_DIS_VERSAO_EMS}' < '2.09' &THEN
                                        IF  substring(emitente.char-1, 101, 1) = 's' THEN DO:
                                    &ELSE
                                        IF  emitente.log-gera-chamado THEN DO:
                                    &ENDIF
                                            ASSIGN i-num-ord-cham = 0.
                                            FOR EACH tt-prog-entreg-cham-aux:
                                                DELETE tt-prog-entreg-cham-aux.
                                            END.
                                            &IF "{&bf_dis_versao_ems}" >= "2.06" &THEN
                                                FOR EACH  prog-entreg-cham NO-LOCK
                                                    WHERE prog-entreg-cham.nr-programa  = prog-cli.nr-programa
                                                    AND   prog-entreg-cham.it-codigo    = tt-prog-ent.it-codigo
                                                    AND   prog-entreg-cham.cod-refer    = tt-prog-ent.cod-refer
                                                    AND   prog-entreg-cham.cod-entrega  = tt-prog-ent.cod-entrega
                                                    AND   prog-entreg-cham.nr-pedcli    = tt-prog-ent.nr-pedcli
                                                    AND   prog-entreg-cham.nr-entrega   = tt-prog-ent.nr-entrega
                                                    AND   prog-entreg-cham.nr-nota-fis  = "" 
                                                    AND   prog-entreg-cham.cdd-embarq   = 0:
        
                                                    FIND FIRST tt-prog-entreg-cham OF prog-entreg-cham NO-LOCK NO-ERROR.
        
                                                    IF NOT AVAIL tt-prog-entreg-cham THEN DO:
                                                        CREATE tt-prog-entreg-cham-aux.
                                                        ASSIGN i-num-ord-cham = i-num-ord-cham + 10
                                                               tt-prog-entreg-cham-aux.nr-programa  = prog-entreg-cham.nr-programa 
                                                               tt-prog-entreg-cham-aux.it-codigo    = prog-entreg-cham.it-codigo   
                                                               tt-prog-entreg-cham-aux.cod-refer    = prog-entreg-cham.cod-refer   
                                                               tt-prog-entreg-cham-aux.cod-entrega  = prog-entreg-cham.cod-entrega 
                                                               tt-prog-entreg-cham-aux.nr-pedcli    = prog-entreg-cham.nr-pedcli   
                                                               tt-prog-entreg-cham-aux.nr-entrega   = prog-entreg-cham.nr-entrega  
                                                               tt-prog-entreg-cham-aux.cod-cham     = prog-entreg-cham.cod-cham    
                                                               tt-prog-entreg-cham-aux.num-ord-cham = i-num-ord-cham
                                                               tt-prog-entreg-cham-aux.qtd-cham     = prog-entreg-cham.qtd-cham.
                                                    END.  
                                                END.
                                            &ELSE
                                                FOR EACH  ped-curva NO-LOCK
                                                    WHERE ped-curva.vl-aberto              = 704
                                                    AND   ped-curva.codigo                 = prog-cli.nr-programa
                                                    AND   ped-curva.it-codigo              = tt-prog-ent.it-codigo
                                                    AND   SUBSTR(ped-curva.char-2,25,8)    = tt-prog-ent.cod-refer
                                                    AND   SUBSTR(ped-curva.char-2,13,12)   = tt-prog-ent.cod-entrega
                                                    AND   SUBSTR(ped-curva.char-2,01,12)   = tt-prog-ent.nr-pedcli
                                                    AND   ped-curva.int-2                  = tt-prog-ent.nr-entrega
                                                    AND   SUBSTR(ped-curva.nome,9,16)      = "" 
                                                    AND   ped-curva.dec-1                  = 0:
        
                                                    FIND FIRST tt-prog-entreg-cham NO-LOCK 
                                                         WHERE tt-prog-entreg-cham.nr-programa = ped-curva.codigo
                                                         AND   tt-prog-entreg-cham.it-codigo   = ped-curva.it-codigo
                                                         AND   tt-prog-entreg-cham.cod-refer   = SUBSTR(ped-curva.char-2,25,08)
                                                         AND   tt-prog-entreg-cham.cod-entrega = SUBSTR(ped-curva.char-2,13,12)
                                                         AND   tt-prog-entreg-cham.nr-pedcli   = SUBSTR(ped-curva.char-2,01,12)
                                                         AND   tt-prog-entreg-cham.nr-entrega  = ped-curva.int-2
                                                         AND   tt-prog-entreg-cham.cod-cham    = ped-curva.regiao
                                                        NO-ERROR.
        
                                                    IF NOT AVAIL tt-prog-entreg-cham THEN DO:
                                                        CREATE tt-prog-entreg-cham-aux.
                                                        ASSIGN i-num-ord-cham = i-num-ord-cham + 10
                                                               tt-prog-entreg-cham-aux.nr-programa  = ped-curva.codigo               
                                                               tt-prog-entreg-cham-aux.it-codigo    = ped-curva.it-codigo            
                                                               tt-prog-entreg-cham-aux.cod-refer    = SUBSTR(ped-curva.char-2,25,08)           
                                                               tt-prog-entreg-cham-aux.cod-entrega  = SUBSTR(ped-curva.char-2,13,12) 
                                                               tt-prog-entreg-cham-aux.nr-pedcli    = SUBSTR(ped-curva.char-2,01,12) 
                                                               tt-prog-entreg-cham-aux.nr-entrega   = ped-curva.int-2                
                                                               tt-prog-entreg-cham-aux.cod-cham     = ped-curva.regiao               
                                                               tt-prog-entreg-cham-aux.num-ord-cham = i-num-ord-cham
                                                               tt-prog-entreg-cham-aux.qtd-cham     = ped-curva.quantidade.
                                                    END.  
                                                END.
                                            &ENDIF
                                            IF i-num-ord-cham <> 0 THEN DO:
                                                FOR EACH  tt-prog-entreg-cham NO-LOCK
                                                    BY tt-prog-entreg-cham.num-ord-cham:
                                                    ASSIGN i-num-ord-cham = i-num-ord-cham + 10
                                                           tt-prog-entreg-cham.num-ord-cham = i-num-ord-cham.
                                                END.
                                                FOR EACH tt-prog-entreg-cham-aux:
                                                    CREATE tt-prog-entreg-cham.
                                                    BUFFER-COPY tt-prog-entreg-cham-aux TO tt-prog-entreg-cham.
                                                    ASSIGN tt-prog-entreg-cham.rowid-prog-ent = ROWID(tt-prog-ent).
                                                END.
                                            END.
                                        END.
                                END. /* for first emitente no-lock */
                            END.
                        &ENDIF
                        NEXT.
                    END.

                    create tt-prog-ent.
                    assign tt-prog-ent.nome-abrev  = prog-cli.nome-abrev
                           tt-prog-ent.nr-progcli  = prog-cli.nr-progcli
                           tt-prog-ent.it-codigo   = prog-ent.it-codigo
                           tt-prog-ent.cod-refer   = prog-ent.cod-refer
                           tt-prog-ent.cd-freq     = prog-ent.cd-freq
                           tt-prog-ent.nr-pedcli   = prog-ent.nr-pedcli
                           tt-prog-ent.cod-entrega = prog-ent.cod-entrega
                           tt-prog-ent.nr-entrega  = prog-ent.nr-entrega
                           tt-prog-ent.tp-entrega  = prog-ent.tp-entrega
                           tt-prog-ent.dt-entrega  = prog-ent.dt-entrega
                           tt-prog-ent.hr-entrega  = prog-ent.hr-entrega
                           tt-prog-ent.qt-pedida   = prog-ent.qt-pedida.

                    &IF "{&bf_dis_versao_ems}" >= "2.02" &THEN
                        &IF "{&bf_dis_versao_ems}" >= "2.06" &THEN
                            FOR EACH  prog-entreg-cham NO-LOCK
                                WHERE prog-entreg-cham.nr-programa = prog-cli.nr-programa
                                AND   prog-entreg-cham.it-codigo   = tt-prog-ent.it-codigo
                                AND   prog-entreg-cham.cod-refer   = tt-prog-ent.cod-refer
                                AND   prog-entreg-cham.cod-entrega = tt-prog-ent.cod-entrega
                                AND   prog-entreg-cham.nr-pedcli   = tt-prog-ent.nr-pedcli
                                AND   prog-entreg-cham.nr-entrega  = tt-prog-ent.nr-entrega:

                                CREATE tt-prog-entreg-cham.
                                ASSIGN tt-prog-entreg-cham.nr-programa  = prog-entreg-cham.nr-programa 
                                       tt-prog-entreg-cham.it-codigo    = prog-entreg-cham.it-codigo   
                                       tt-prog-entreg-cham.cod-refer    = prog-entreg-cham.cod-refer   
                                       tt-prog-entreg-cham.cod-entrega  = prog-entreg-cham.cod-entrega 
                                       tt-prog-entreg-cham.nr-pedcli    = prog-entreg-cham.nr-pedcli   
                                       tt-prog-entreg-cham.nr-entrega   = prog-entreg-cham.nr-entrega  
                                       tt-prog-entreg-cham.cod-cham     = prog-entreg-cham.cod-cham    
                                       tt-prog-entreg-cham.num-ord-cham = prog-entreg-cham.num-ord-cham
                                       tt-prog-entreg-cham.cod-estabel  = prog-entreg-cham.cod-estabel 
                                       tt-prog-entreg-cham.serie        = prog-entreg-cham.serie       
                                       tt-prog-entreg-cham.nr-nota-fis  = prog-entreg-cham.nr-nota-fis 
                                       tt-prog-entreg-cham.cdd-embarq   = prog-entreg-cham.cdd-embarq
                                       tt-prog-entreg-cham.nr-resumo    = prog-entreg-cham.nr-resumo   
                                       tt-prog-entreg-cham.qtd-cham     = prog-entreg-cham.qtd-cham
                                       tt-prog-entreg-cham.rowid-prog-ent = ROWID(tt-prog-ent).
                            END.
                        &ELSE
                            FOR EACH  ped-curva NO-LOCK             
                                WHERE ped-curva.vl-aberto            = 704         
                                AND   ped-curva.codigo               = prog-cli.nr-programa
                                AND   ped-curva.it-codigo            = tt-prog-ent.it-codigo
                                AND   SUBSTR(ped-curva.char-2,25,08) = tt-prog-ent.cod-refer
                                AND   SUBSTR(ped-curva.char-2,13,12) = tt-prog-ent.cod-entrega
                                AND   SUBSTR(ped-curva.char-2,01,12) = tt-prog-ent.nr-pedcli
                                AND   ped-curva.int-2                = tt-prog-ent.nr-entrega
                                AND   SUBSTR(ped-curva.nome,9,16)    = "" 
                                AND   ped-curva.dec-1                = 0:

                                CREATE tt-prog-entreg-cham.
                                ASSIGN tt-prog-entreg-cham.nr-programa  = ped-curva.codigo              
                                       tt-prog-entreg-cham.it-codigo    = ped-curva.it-codigo           
                                       tt-prog-entreg-cham.cod-refer    = SUBSTR(ped-curva.char-2,25,08)           
                                       tt-prog-entreg-cham.cod-entrega  = SUBSTR(ped-curva.char-2,13,12)
                                       tt-prog-entreg-cham.nr-pedcli    = SUBSTR(ped-curva.char-2,01,12)
                                       tt-prog-entreg-cham.nr-entrega   = ped-curva.int-2               
                                       tt-prog-entreg-cham.cod-cham     = ped-curva.regiao              
                                       tt-prog-entreg-cham.num-ord-cham = ped-curva.int-1                
                                       tt-prog-entreg-cham.cod-estabel  = SUBSTR(ped-curva.nome,1,3)
                                       tt-prog-entreg-cham.serie        = SUBSTR(ped-curva.nome,4,5)
                                       tt-prog-entreg-cham.nr-nota-fis  = SUBSTR(ped-curva.nome,9,16)
                                       tt-prog-entreg-cham.cdd-embarq   = ped-curva.dec-1
                                       tt-prog-entreg-cham.nr-resumo    = INT(SUBSTR(ped-curva.nome,32,7))
                                       tt-prog-entreg-cham.qtd-cham     = ped-curva.quantidade
                                       tt-prog-entreg-cham.rowid-prog-ent = ROWID(tt-prog-ent).
                            END.
                        &ENDIF
                    &ENDIF
                END.    
            END.

            /* recalcula o numero de entrega*/
            FOR EACH tt-prog-item:

                ASSIGN i-nr-entrega = 0.

                FOR EACH tt-prog-ent 
                    where   tt-prog-ent.nr-progcli  = prog-cli.nr-progcli
                      and   tt-prog-ent.it-codigo   = tt-prog-item.it-codigo
                      and   tt-prog-ent.cod-refer   = tt-prog-item.cod-refer
                      and   tt-prog-ent.cod-entrega = tt-prog-item.cod-entrega
                      and   tt-prog-ent.nr-pedcli   = tt-prog-item.nr-pedcli
                    NO-LOCK:

                    ASSIGN i-nr-entrega = i-nr-entrega + 10.

                    &IF "{&bf_dis_versao_ems}" >= "2.02" &THEN
                        FOR EACH  tt-prog-entreg-cham EXCLUSIVE-LOCK
                            WHERE tt-prog-entreg-cham.rowid-prog-ent = rowid(tt-prog-ent):
                            ASSIGN tt-prog-entreg-cham.nr-entrega = i-nr-entrega.
                        END.
                    &ENDIF

                    ASSIGN tt-prog-ent.nr-entrega = i-nr-entrega.
                END.
            END.
            /********************************/
        END.
    END.
END.

END PROCEDURE.

PROCEDURE PI-VERIFICA-DATAS-ESPECIAIS:
    /*---[ Par≥metros ]--------------------------------------------------*/
    def input-output param p-dt-entrega as char no-undo.

    /*---[ Variˇveis ]---------------------------------------------------*/
    def var v_dat_aux               as date no-undo.
    def var v_des_dat_conver        as character format "x(10)":U no-undo.
    def var v_des_flag_public_bloco as character format "x(15)":U extent 10 no-undo.

    if  p-dt-entrega  = '222222':U then assign p-dt-entrega = '01011980'.

    if  p-dt-entrega =  '333333':U then assign v_dat_aux        = today - 1
                                               v_des_dat_conver = replace(string(v_dat_aux,'99/99/9999'),'/','')
                                               p-dt-entrega     = v_des_dat_conver.

    if  p-dt-entrega = '444444':U then assign v_dat_aux        = today
                                              v_des_dat_conver = replace(string(v_dat_aux,'99/99/9999'),'/','')
                                              p-dt-entrega     = v_des_dat_conver.

    if  p-dt-entrega = '555555':U then assign v_des_flag_public_bloco[1] = '555555':U
                                              p-dt-entrega           = '01011980'.

END PROCEDURE. /* PROCEDURE PI-VERIFICA-DATAS-ESPECIAIS: */

PROCEDURE pi-programa:

/*Procedure desenvolvida para solucionar problemas de sobreposiá∆o de programaá‰es nos clientes Simoldes e Koyo*/

    DEF VAR i-nr-entrega-1 AS INT NO-UNDO.
    DEF VAR i-num-ord-cham AS INT NO-UNDO.
    DEF VAR da-dt-ult-entr LIKE prog-ent.dt-entrega NO-UNDO.
    DEF VAR c-hr-ult-entr  LIKE prog-ent.hr-entrega NO-UNDO.

    for each tt-prog-cli:
        FIND FIRST TT-PROG-ITEM
             WHERE TT-PROG-ITEM.NOME-ABREV = tt-prog-cli.nome-abrev
             AND   TT-PROG-ITEM.NR-PROGCLI = tt-prog-cli.nr-progcli NO-LOCK NO-ERROR.
        if not avail tt-prog-item then next.        
        
        FIND LAST  prog-cli
             where prog-cli.nome-abrev  = tt-prog-cli.nome-abrev
             and   prog-cli.nr-progcli  = tt-prog-cli.nr-progcli no-lock no-error.
        IF NOT AVAIL PROG-CLI THEN NEXT.
        
        for each prog-item
            WHERE prog-item.nr-programa = prog-cli.nr-programa no-lock:

            FIND first tt-prog-item
                 WHERE tt-prog-item.it-codigo   = prog-item.it-codigo  
                 AND   tt-prog-item.cod-refer   = prog-item.cod-refer  
                 AND   tt-prog-item.cod-entrega = prog-item.cod-entrega
                 AND   tt-prog-item.nr-pedcli   = prog-item.nr-pedcli NO-LOCK NO-ERROR.
            if avail tt-prog-item then next.
            
            create  tt-prog-item.
            assign  tt-prog-item.nome-abrev           =     prog-cli.nome-abrev
                    tt-prog-item.nr-progcli           =     prog-cli.nr-progcli                
                    tt-prog-item.it-codigo            =     prog-item.it-codigo    
                    tt-prog-item.cod-refer            =     prog-item.cod-refer    
                    tt-prog-item.cd-freq              =     prog-item.cd-freq      
                    tt-prog-item.dt-ult-ent           =     prog-item.dt-ult-ent   
                    tt-prog-item.cod-estabel          =     prog-item.cod-estabel  
                    tt-prog-item.serie                =     prog-item.serie        
                    tt-prog-item.nr-nota-fis          =     prog-item.nr-nota-fis  
                    tt-prog-item.dt-ult-nf            =     prog-item.dt-ult-nf    
                    tt-prog-item.qt-ult-ent           =     prog-item.qt-ult-ent   
                    tt-prog-item.qt-ent-acum          =     prog-item.qt-ent-acum  
                    tt-prog-item.qt-nec-acum          =     prog-item.qt-nec-acum  
                    tt-prog-item.qt-atraso            =     prog-item.qt-atraso    
                    tt-prog-item.qt-lote-min          =     prog-item.qt-lote-min  
                    tt-prog-item.nr-pedcli            =     prog-item.nr-pedcli    
                    tt-prog-item.nr-sequencia         =     prog-item.nr-sequencia 
                    tt-prog-item.nr-pedido            =     prog-item.nr-pedido    
                    tt-prog-item.dt-atualiza          =     prog-item.dt-atualiza  
                    tt-prog-item.observacoes          =     prog-item.observacoes  
                    tt-prog-item.cod-entrega          =     prog-item.cod-entrega  
                    tt-prog-item.loc-descarga         =     prog-item.loc-descarga 
                    tt-prog-item.cd-origem            =     prog-item.cd-origem    
                    tt-prog-item.cd-situacao          =     prog-item.cd-situacao  
                    tt-prog-item.dt-implant           =     prog-item.dt-implant   
                    tt-prog-item.dt-cancel            =     prog-item.dt-cancel    
                    tt-prog-item.dt-alter             =     prog-item.dt-alter     
                    tt-prog-item.user-implant         =     prog-item.user-implant 
                    tt-prog-item.user-cancel          =     prog-item.user-cancel  
                    tt-prog-item.user-alter           =     prog-item.user-alter   
                    tt-prog-item.motivo-can           =     prog-item.motivo-can   
                    tt-prog-item.motivo-imp           =     prog-item.motivo-imp   
                    tt-prog-item.contato              =     prog-item.contato      
                    tt-prog-item.user-implant         =     prog-item.user-implant 
                    
                    tt-prog-item.erro-consist         = no
                    SUBSTRING(tt-prog-item.char-1,100,1) = "1"  /* item */                                                     

                    tt-prog-item.qt-lote-min          =     prog-item.qt-lote-min
                    tt-prog-item.qt-nec-acum          =     prog-item.qt-nec-acum
                    tt-prog-item.qt-ent-acum          =     prog-item.qt-ent-acum
                    tt-prog-item.qt-ult-ent           =     prog-item.qt-ult-ent.                    
        END.
        
        &IF "{&bf_dis_versao_ems}" >= "2.02" &THEN
            ASSIGN da-dt-ult-entr = TODAY.
            FOR LAST  tt-prog-ent USE-INDEX codigo NO-LOCK
                WHERE tt-prog-ent.nome-abrev  = prog-cli.nome-abrev
                AND   tt-prog-ent.nr-progcli  = prog-cli.nr-progcli
                AND   tt-prog-ent.it-codigo   = tt-prog-item.it-codigo
                AND   tt-prog-ent.cod-refer   = tt-prog-item.cod-refer
                AND   tt-prog-ent.cod-entrega = tt-prog-item.cod-entrega 
                AND   tt-prog-ent.nr-pedcli   = tt-prog-item.nr-pedcli  
                AND   tt-prog-ent.tp-entrega  = 2  /** entregas estimadas**/:       
                ASSIGN da-dt-ult-entr = tt-prog-ent.dt-entrega                      
                       c-hr-ult-entr  = tt-prog-ent.hr-entrega.                     
            END.
        &ENDIF

        FOR EACH tt-prog-item:
            bloco-1:
            FOR EACH prog-ent USE-INDEX codigo
                where   prog-ent.nr-programa  = prog-cli.nr-programa
                  and   prog-ent.it-codigo    = tt-prog-item.it-codigo
                  and   prog-ent.cod-refer    = tt-prog-item.cod-refer
                  and   prog-ent.cod-entrega  = tt-prog-item.cod-entrega
                  and   prog-ent.nr-pedcli    = tt-prog-item.nr-pedcli
                  AND   prog-ent.dt-entrega  >= TODAY NO-LOCK:
                
                FIND FIRST tt-prog-ent  
                    where  tt-prog-ent.nome-abrev  = prog-cli.nome-abrev
                      AND  tt-prog-ent.nr-progcli  = prog-cli.nr-progcli
                      AND  tt-prog-ent.it-codigo   = prog-ent.it-codigo
                      AND  tt-prog-ent.cod-refer   = prog-ent.cod-refer
                      AND  tt-prog-ent.cod-entrega = prog-ent.cod-entrega 
                      AND  tt-prog-ent.nr-pedcli   = prog-ent.nr-pedcli
                      AND  tt-prog-ent.dt-entrega  = prog-ent.dt-entrega
                      AND  tt-prog-ent.hr-entrega  = prog-ent.hr-entrega
                      NO-LOCK NO-ERROR.                        
                if avail tt-prog-ent then LEAVE bloco-1.
                
                create tt-prog-ent.
                assign tt-prog-ent.nome-abrev  = prog-cli.nome-abrev
                       tt-prog-ent.nr-progcli  = prog-cli.nr-progcli
                       tt-prog-ent.it-codigo   = prog-ent.it-codigo
                       tt-prog-ent.cod-refer   = prog-ent.cod-refer
                       tt-prog-ent.cd-freq     = prog-ent.cd-freq
                       tt-prog-ent.nr-pedcli   = prog-ent.nr-pedcli
                       tt-prog-ent.cod-entrega = prog-ent.cod-entrega
                       tt-prog-ent.nr-entrega  = prog-ent.nr-entrega
                       tt-prog-ent.tp-entrega  = prog-ent.tp-entrega
                       tt-prog-ent.dt-entrega  = prog-ent.dt-entrega
                       tt-prog-ent.hr-entrega  = prog-ent.hr-entrega
                       tt-prog-ent.qt-pedida   = prog-ent.qt-pedida.
                
                &IF "{&bf_dis_versao_ems}" >= "2.02" &THEN
                    &IF "{&bf_dis_versao_ems}" >= "2.06" &THEN
                        FOR EACH  prog-entreg-cham NO-LOCK
                            WHERE prog-entreg-cham.nr-programa = prog-cli.nr-programa
                            AND   prog-entreg-cham.it-codigo   = tt-prog-ent.it-codigo
                            AND   prog-entreg-cham.cod-refer   = tt-prog-ent.cod-refer
                            AND   prog-entreg-cham.cod-entrega = tt-prog-ent.cod-entrega
                            AND   prog-entreg-cham.nr-pedcli   = tt-prog-ent.nr-pedcli
                            AND   prog-entreg-cham.nr-entrega  = tt-prog-ent.nr-entrega:
                            CREATE tt-prog-entreg-cham.
                            ASSIGN tt-prog-entreg-cham.nr-programa  = prog-entreg-cham.nr-programa 
                                   tt-prog-entreg-cham.it-codigo    = prog-entreg-cham.it-codigo   
                                   tt-prog-entreg-cham.cod-refer    = prog-entreg-cham.cod-refer   
                                   tt-prog-entreg-cham.cod-entrega  = prog-entreg-cham.cod-entrega 
                                   tt-prog-entreg-cham.nr-pedcli    = prog-entreg-cham.nr-pedcli   
                                   tt-prog-entreg-cham.nr-entrega   = prog-entreg-cham.nr-entrega  
                                   tt-prog-entreg-cham.cod-cham     = prog-entreg-cham.cod-cham    
                                   tt-prog-entreg-cham.num-ord-cham = prog-entreg-cham.num-ord-cham
                                   tt-prog-entreg-cham.cod-estabel  = prog-entreg-cham.cod-estabel 
                                   tt-prog-entreg-cham.serie        = prog-entreg-cham.serie       
                                   tt-prog-entreg-cham.nr-nota-fis  = prog-entreg-cham.nr-nota-fis 
                                   tt-prog-entreg-cham.cdd-embarq   = prog-entreg-cham.cdd-embarq
                                   tt-prog-entreg-cham.nr-resumo    = prog-entreg-cham.nr-resumo   
                                   tt-prog-entreg-cham.qtd-cham     = prog-entreg-cham.qtd-cham
                                   tt-prog-entreg-cham.rowid-prog-ent = ROWID(tt-prog-ent).
                        END.
                    &ELSE
                        FOR EACH  ped-curva NO-LOCK             
                            WHERE ped-curva.vl-aberto            = 704         
                            AND   ped-curva.codigo               = prog-cli.nr-programa
                            AND   ped-curva.it-codigo            = tt-prog-ent.it-codigo
                            AND   SUBSTR(ped-curva.char-2,25,08) = tt-prog-ent.cod-refer
                            AND   SUBSTR(ped-curva.char-2,13,12) = tt-prog-ent.cod-entrega
                            AND   SUBSTR(ped-curva.char-2,01,12) = tt-prog-ent.nr-pedcli
                            AND   ped-curva.int-2                = tt-prog-ent.nr-entrega
                            AND   SUBSTR(ped-curva.nome,9,16)    = "" 
                            AND   ped-curva.dec-1                = 0:
                            CREATE tt-prog-entreg-cham.
                            ASSIGN tt-prog-entreg-cham.nr-programa  = ped-curva.codigo              
                                   tt-prog-entreg-cham.it-codigo    = ped-curva.it-codigo           
                                   tt-prog-entreg-cham.cod-refer    = SUBSTR(ped-curva.char-2,25,08)           
                                   tt-prog-entreg-cham.cod-entrega  = SUBSTR(ped-curva.char-2,13,12)
                                   tt-prog-entreg-cham.nr-pedcli    = SUBSTR(ped-curva.char-2,01,12)
                                   tt-prog-entreg-cham.nr-entrega   = ped-curva.int-2               
                                   tt-prog-entreg-cham.cod-cham     = ped-curva.regiao              
                                   tt-prog-entreg-cham.num-ord-cham = ped-curva.int-1                
                                   tt-prog-entreg-cham.cod-estabel  = SUBSTR(ped-curva.nome,1,3)
                                   tt-prog-entreg-cham.serie        = SUBSTR(ped-curva.nome,4,5)
                                   tt-prog-entreg-cham.nr-nota-fis  = SUBSTR(ped-curva.nome,9,16)
                                   tt-prog-entreg-cham.cdd-embarq   = ped-curva.dec-1
                                   tt-prog-entreg-cham.nr-resumo    = INT(SUBSTR(ped-curva.nome,32,7))
                                   tt-prog-entreg-cham.qtd-cham     = ped-curva.quantidade
                                   tt-prog-entreg-cham.rowid-prog-ent = ROWID(tt-prog-ent).
                        END.
                    &ENDIF
                &ENDIF
            END.    
            
            &IF "{&bf_dis_versao_ems}" >= "2.02" &THEN
                FOR EACH  prog-ent USE-INDEX codigo
                    where prog-ent.nr-programa  = prog-cli.nr-programa
                    and   prog-ent.it-codigo    = tt-prog-item.it-codigo
                    and   prog-ent.cod-refer    = tt-prog-item.cod-refer
                    and   prog-ent.cod-entrega  = tt-prog-item.cod-entrega
                    and   prog-ent.nr-pedcli    = tt-prog-item.nr-pedcli
                    and   prog-ent.dt-entrega  >= da-dt-ult-entr
                    and   prog-ent.tp-entrega   = 2 /** entregas estimadas **/ NO-LOCK:

                    IF  prog-ent.dt-entrega  = da-dt-ult-entr 
                    AND prog-ent.hr-entrega <= c-hr-ult-entr THEN NEXT.

                    FIND FIRST tt-prog-ent NO-LOCK
                        where  tt-prog-ent.nome-abrev  = prog-cli.nome-abrev
                        and    tt-prog-ent.nr-progcli  = prog-cli.nr-progcli
                        and    tt-prog-ent.it-codigo   = prog-ent.it-codigo
                        and    tt-prog-ent.cod-refer   = prog-ent.cod-refer
                        and    tt-prog-ent.cod-entrega = prog-ent.cod-entrega 
                        and    tt-prog-ent.nr-pedcli   = prog-ent.nr-pedcli
                        and    tt-prog-ent.dt-entrega  = prog-ent.dt-entrega
                        and    tt-prog-ent.hr-entrega  = prog-ent.hr-entrega NO-ERROR.
                    if  avail  tt-prog-ent then NEXT.
                    
                    create tt-prog-ent.
                    assign tt-prog-ent.nome-abrev  = prog-cli.nome-abrev
                           tt-prog-ent.nr-progcli  = prog-cli.nr-progcli
                           tt-prog-ent.it-codigo   = prog-ent.it-codigo
                           tt-prog-ent.cod-refer   = prog-ent.cod-refer
                           tt-prog-ent.cd-freq     = prog-ent.cd-freq
                           tt-prog-ent.nr-pedcli   = prog-ent.nr-pedcli
                           tt-prog-ent.cod-entrega = prog-ent.cod-entrega
                           tt-prog-ent.nr-entrega  = prog-ent.nr-entrega
                           tt-prog-ent.tp-entrega  = prog-ent.tp-entrega
                           tt-prog-ent.dt-entrega  = prog-ent.dt-entrega
                           tt-prog-ent.hr-entrega  = prog-ent.hr-entrega
                           tt-prog-ent.qt-pedida   = prog-ent.qt-pedida. 
                END. /* FOR EACH prog-ent */
            &ENDIF
        END.
        
        /* recalcula o numero de entrega*/
        FOR EACH tt-prog-item:
            ASSIGN i-nr-entrega-1 = 0.

            FOR EACH tt-prog-ent 
                where   tt-prog-ent.nr-progcli  = prog-cli.nr-progcli
                  and   tt-prog-ent.it-codigo   = tt-prog-item.it-codigo
                  and   tt-prog-ent.cod-refer   = tt-prog-item.cod-refer
                  and   tt-prog-ent.cod-entrega = tt-prog-item.cod-entrega
                  and   tt-prog-ent.nr-pedcli   = tt-prog-item.nr-pedcli NO-LOCK:
                ASSIGN i-nr-entrega-1           = i-nr-entrega-1 + 10.
                
                &IF "{&bf_dis_versao_ems}" >= "2.02" &THEN
                    FOR EACH  tt-prog-entreg-cham EXCLUSIVE-LOCK
                        WHERE tt-prog-entreg-cham.rowid-prog-ent = rowid(tt-prog-ent):
                        ASSIGN tt-prog-entreg-cham.nr-entrega = i-nr-entrega-1.
                    END.
                &ENDIF
                ASSIGN tt-prog-ent.nr-entrega   = i-nr-entrega-1.
            END.
        END.
        /********************************/
    END.
END PROCEDURE. /* PROCEDURE pi-programa: */

/****** INTERNAL PROCEDURES - END*/


