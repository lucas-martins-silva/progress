                                   if (ttcont-tran.telefax <> ?) then
                                   DO: /*Test LOGIC*/
                                        RUN addNode IN hGenXml (getStack(), "FaxNumber":U, ttcont-tran.telefax, OUTPUT iId).
                                   END. /*Test LOGIC*/
                                   if (ttcont-tran.ramal-fax <> ?) then
                                   DO: /*Test LOGIC*/
                                        RUN addNode IN hGenXml (getStack(), "FaxExtention":U, ttcont-tran.ramal-fax, OUTPUT iId).
                                   END. /*Test LOGIC*/
                                   if (ttcont-tran.telef-modem <> ?) then
                                   DO: /*Test LOGIC*/
