                    RUN addNode IN hGenXml (getStack(), "ModemNumber":U, tttransporte.telef-modem, OUTPUT iId).
               END. /*Test LOGIC*/
               if (tttransporte.ramal-modem <> ?) then
               DO: /*Test LOGIC*/
