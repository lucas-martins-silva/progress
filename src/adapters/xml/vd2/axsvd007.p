               DO: /*Test LOGIC*/
                    RUN addNode IN hGenXml (getStack(), "CarrierEDIID":U, tttransporte.des-ident-transp, OUTPUT iId).
               END. /*Test LOGIC*/
          delStack().

          if ((tttransporte.via-transp >= 1) and (tttransporte.via-transp <= 8)) then
          DO: /*Test LOGIC*/
               RUN addNodeDec IN hGenXml (getStack(), "CarrierShippingMethod":U, tttransporte.via-transp, OUTPUT iId).
          END. /*Test LOGIC*/
          if ((tttransporte.ind-situacao >= 1) and (tttransporte.ind-situacao <= 2)) then
          DO: /*Test LOGIC*/
               RUN addNodeDec IN hGenXml (getStack(), "CarrierStatus":U, tttransporte.ind-situacao, OUTPUT iId).
          END. /*Test LOGIC*/
          RUN addNode IN hGenXml (getStack(), "CarrierContacts":U, "":U, OUTPUT iId).
          addStack(iId).

               if (tttransporte.contato <> ?) then
               DO: /*Test LOGIC*/
                    RUN addNode IN hGenXml (getStack(), "MainContactName":U, tttransporte.contato, OUTPUT iId).
               END. /*Test LOGIC*/
               if can-find (first ttcont-tran where ttcont-tran.cod-transp = tttransporte.cod-transp) then
               DO: /*Test LOGIC*/
                    RUN addNode IN hGenXml (getStack(), "ListOfCarrierContacts":U, "":U, OUTPUT iId).
                    addStack(iId).

                         FOR EACH ttcont-tran where ttcont-tran.cod-transp = tttransporte.cod-transp:
                              RUN addNode IN hGenXml (getStack(), "Contact":U, "":U, OUTPUT iId).
                              addStack(iId).

                                   RUN addNodeDec IN hGenXml (getStack(), "Sequence":U, ttcont-tran.sequencia, OUTPUT iId).
                                   RUN addNode IN hGenXml (getStack(), "Name":U, ttcont-tran.nome, OUTPUT iId).
