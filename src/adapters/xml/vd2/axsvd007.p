               if (tttransporte.e-mail <> ?) then
               DO: /*Test LOGIC*/
                    RUN addNode IN hGenXml (getStack(), "EMail":U, tttransporte.e-mail, OUTPUT iId).
               END. /*Test LOGIC*/
               if (tttransporte.home-page <> ?) then
               DO: /*Test LOGIC*/
                    RUN addNode IN hGenXml (getStack(), "HomePage":U, tttransporte.home-page, OUTPUT iId).
