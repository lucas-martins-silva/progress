RUN setCompanyId IN hMessageHandler (STRING(v_cdn_empres_usuar), "").



     /* RESETA OS VALORES */
     RUN reset IN hGenXml.

     /* SETA VALOR DE ENCODING */
     RUN setEncoding IN hGenXml ("UTF-8").

     RUN addNode IN hGenXml (getStack(), "Upsert":U, "":U, OUTPUT iId).
     addStack(iId).

          RUN addNode IN hGenXml (getStack(), "PriceTableNumber":U, PriceTableNumber, OUTPUT iId).
          IF PriceTableDescription <> ? THEN
          DO: /*Test LOGIC*/
               RUN addNode IN hGenXml (getStack(), "PriceTableDescription":U, PriceTableDescription, OUTPUT iId).
          END. /*Test LOGIC*/
          RUN addNodeDate IN hGenXml (getStack(), "InitialValidityDate":U, InitialValidityDate, OUTPUT iId).
          RUN addNodeDate IN hGenXml (getStack(), "ValidityDate":U, ValidityDate, OUTPUT iId).
          IF TableStatus >= 1 AND TableStatus <= 3 THEN
          DO: /*Test LOGIC*/
               RUN addNodeDec IN hGenXml (getStack(), "TableStatus":U, TableStatus, OUTPUT iId).
          END. /*Test LOGIC*/
          IF PriceGroupID <> ? AND PriceGroupID <> 0 THEN
          DO: /*Test LOGIC*/
               RUN addNode IN hGenXml (getStack(), "PriceGroup":U, "":U, OUTPUT iId).
               addStack(iId).

                    RUN addNodeDec IN hGenXml (getStack(), "PriceGroupID":U, PriceGroupID, OUTPUT iId).
                    IF PriceGroupDescription <> ? THEN
                    DO: /*Test LOGIC*/
                         RUN addNode IN hGenXml (getStack(), "PriceGroupDescription":U, PriceGroupDescription, OUTPUT iId).
                    END. /*Test LOGIC*/
               delStack().

          END. /*Test LOGIC*/
          IF CurrencyID <> ? THEN
          DO: /*Test LOGIC*/
               RUN addNode IN hGenXml (getStack(), "Currency":U, "":U, OUTPUT iId).
               addStack(iId).

                    RUN addNodeDec IN hGenXml (getStack(), "CurrencyID":U, CurrencyID, OUTPUT iId).
                    IF CurrencyDescription <> ? THEN
                    DO: /*Test LOGIC*/
                         RUN addNode IN hGenXml (getStack(), "CurrencyDescription":U, CurrencyDescription, OUTPUT iId).
                    END. /*Test LOGIC*/
                    IF CurrencySign <>? THEN
                    DO: /*Test LOGIC*/
                         RUN addNode IN hGenXml (getStack(), "CurrencySign":U, CurrencySign, OUTPUT iId).
                    END. /*Test LOGIC*/
               delStack().

          END. /*Test LOGIC*/
          RUN addNodeDec IN hGenXml (getStack(), "DiscountPercentage":U, DiscountPercentage, OUTPUT iId).
          IF Comments <> ? AND Comments <> "" THEN
          DO: /*Test LOGIC*/
               RUN addNode IN hGenXml (getStack(), "Comments":U, Comments, OUTPUT iId).
          END. /*Test LOGIC*/

          IF CAN-FIND (FIRST ttPriceTableItem NO-LOCK) THEN
          DO: /*Test LOGIC*/
               RUN addNode IN hGenXml (getStack(), "ListOfPriceTableItens":U, "":U, OUTPUT iId).
               addStack(iId).

                    FOR EACH ttPriceTableItem:
                         RUN addNode IN hGenXml (getStack(), "PriceTableItem":U, "":U, OUTPUT iId).
                         addStack(iId).

                              RUN addNodeDec IN hGenXml (getStack(), "Sequence":U, ttPriceTableItem.Sequence, OUTPUT iId).
                              RUN addNode IN hGenXml (getStack(), "Item":U, "":U, OUTPUT iId).
                              addStack(iId).

                                   RUN addNode IN hGenXml (getStack(), "ItemCode":U, ttPriceTableItem.ItemCode, OUTPUT iId).
                                   IF ItemDescription <> ? THEN
                                   DO: /*Test LOGIC*/
                                        RUN addNode IN hGenXml (getStack(), "ItemDescription":U, ttPriceTableItem.ItemDescription, OUTPUT iId).
                                   END. /*Test LOGIC*/
                                   IF ItemReferenceCode <> ? THEN
                                   DO: /*Test LOGIC*/
                                        RUN addNode IN hGenXml (getStack(), "ItemReferenceCode":U, ttPriceTableItem.ItemReferenceCode, OUTPUT iId).
                                   END. /*Test LOGIC*/
                              delStack().

                              IF UnitOfMeasureCode <> ? THEN
                              DO: /*Test LOGIC*/
                                   RUN addNode IN hGenXml (getStack(), "UnitOfMeasure":U, "":U, OUTPUT iId).
                                   addStack(iId).

                                        RUN addNode IN hGenXml (getStack(), "UnitOfMeasureCode":U, ttPriceTableItem.UnitOfMeasureCode, OUTPUT iId).
                                        IF UnitOfMeasureDescription <> ? THEN
                                        DO: /*Test LOGIC*/
                                             RUN addNode IN hGenXml (getStack(), "UnitOfMeasureDescription":U, ttPriceTableItem.UnitOfMeasureDescription, OUTPUT iId).
                                        END. /*Test LOGIC*/
                                   delStack().

                              END. /*Test LOGIC*/
                              IF ttPriceTableItem.InitialValidityDate <> ? AND STRING(ttPriceTableItem.InitialValidityDate) <> "" THEN
                              DO: /*Test LOGIC*/
                                   RUN addNodeDate IN hGenXml (getStack(), "InitialValidityDate":U, ttPriceTableItem.InitialValidityDate, OUTPUT iId).
                              END. /*Test LOGIC*/
                              IF ttPriceTableItem.LastUpdateDate <> ? AND STRING(ttPriceTableItem.LastUpdateDate) <> "" THEN
                              DO: /*Test LOGIC*/
                                   RUN addNodeDate IN hGenXml (getStack(), "LastUpdateDate":U, ttPriceTableItem.LastUpdateDate, OUTPUT iId).
                              END. /*Test LOGIC*/
                              IF ttPriceTableItem.MinimumQuantity <> ? THEN
                              DO: /*Test LOGIC*/
                                   RUN addNodeDec IN hGenXml (getStack(), "MinimumQuantity":U, ttPriceTableItem.MinimumQuantity, OUTPUT iId).
                              END. /*Test LOGIC*/
                              IF ttPriceTableItem.MarkupID <> ? THEN
                              DO: /*Test LOGIC*/
                                   RUN addNode IN hGenXml (getStack(), "PriceMarkup":U, "":U, OUTPUT iId).
                                   addStack(iId).

                                        RUN addNodeDec IN hGenXml (getStack(), "MarkupID":U, ttPriceTableItem.MarkupID, OUTPUT iId).
                                        IF ttPriceTableItem.MarkupDescription <> ? THEN
                                        DO: /*Test LOGIC*/
                                             RUN addNode IN hGenXml (getStack(), "MarkupDescription":U, ttPriceTableItem.MarkupDescription, OUTPUT iId).
                                        END. /*Test LOGIC*/
                                        IF ttPriceTableItem.FormulaID <> ? THEN
                                        DO: /*Test LOGIC*/
                                             RUN addNode IN hGenXml (getStack(), "Formula":U, "":U, OUTPUT iId).
                                             addStack(iId).

                                                  RUN addNodeDec IN hGenXml (getStack(), "FormulaID":U, ttPriceTableItem.FormulaID, OUTPUT iId).
                                                  IF ttPriceTableItem.FormulaDescription <> ? THEN
                                                  DO: /*Test LOGIC*/
                                                       RUN addNode IN hGenXml (getStack(), "FormulaDescription":U, ttPriceTableItem.FormulaDescription, OUTPUT iId).
                                                  END. /*Test LOGIC*/
                                                  IF ttPriceTableItem.InitialValidityDate_00  <> ? AND STRING(ttPriceTableItem.InitialValidityDate_00) <> ""  THEN
                                                  DO: /*Test LOGIC*/
                                                       RUN addNodeDate IN hGenXml (getStack(), "InitialValidityDate":U, ttPriceTableItem.InitialValidityDate_00, OUTPUT iId).
                                                  END. /*Test LOGIC*/
                                                  IF ttPriceTableItem.ValidityDate <> ? AND STRING(ttPriceTableItem.ValidityDate) <> ""   THEN
                                                  DO: /*Test LOGIC*/
                                                       RUN addNodeDate IN hGenXml (getStack(), "ValidityDate":U, ttPriceTableItem.ValidityDate, OUTPUT iId).
                                                  END. /*Test LOGIC*/
                                             delStack().

                                        END. /*Test LOGIC*/
                                   delStack().

                              END. /*Test LOGIC*/
                              IF ttPriceTableItem.PriceTableItemStatus = 1 OR ttPriceTableItem.PriceTableItemStatus = 2 THEN
                              DO: /*Test LOGIC*/
                                   RUN addNodeDec IN hGenXml (getStack(), "PriceTableItemStatus":U, ttPriceTableItem.PriceTableItemStatus, OUTPUT iId).
                              END. /*Test LOGIC*/
                              IF ttPriceTableItem.DiscountPercentageForQuantity <> ? THEN
                              DO: /*Test LOGIC*/
                                   RUN addNodeDec IN hGenXml (getStack(), "DiscountPercentageForQuantity":U, ttPriceTableItem.DiscountPercentageForQuantity, OUTPUT iId).
                              END. /*Test LOGIC*/
                              RUN addNodeDec IN hGenXml (getStack(), "CIFSalesPrice":U, ttPriceTableItem.CIFSalesPrice, OUTPUT iId).
                              RUN addNodeDec IN hGenXml (getStack(), "MinimumCIFPrice":U, ttPriceTableItem.MinimumCIFPrice, OUTPUT iId).
                              RUN addNodeDec IN hGenXml (getStack(), "FOBSalesPrice":U, ttPriceTableItem.FOBSalesPrice, OUTPUT iId).
                              RUN addNodeDec IN hGenXml (getStack(), "MinimumFOBPrice":U, ttPriceTableItem.MinimumFOBPrice, OUTPUT iId).
                              IF ttPriceTableItem.ProfitPercentage <> ? THEN
                              DO: /*Test LOGIC*/
                                   RUN addNodeDec IN hGenXml (getStack(), "ProfitPercentage":U, ttPriceTableItem.ProfitPercentage, OUTPUT iId).
                              END. /*Test LOGIC*/
                              IF ttPriceTableItem.ZeroProfitPrice <> ? THEN
                              DO: /*Test LOGIC*/
                                   RUN addNodeDec IN hGenXml (getStack(), "ZeroProfitPrice":U, ttPriceTableItem.ZeroProfitPrice, OUTPUT iId).
                              END. /*Test LOGIC*/
                              IF CAN-FIND (FIRST ttPriceUpdate OF ttPriceTableItem NO-LOCK) THEN
                              DO: /*Test LOGIC*/
                                   RUN addNode IN hGenXml (getStack(), "ListOfPriceUpdates":U, "":U, OUTPUT iId).
                                   addStack(iId).

                                        FOR EACH ttPriceUpdate OF ttPriceTableItem:
                                            
                                             RUN addNode IN hGenXml (getStack(), "PriceUpdate":U, "":U, OUTPUT iId).
                                             addStack(iId).

                                                  RUN addNodeDec IN hGenXml (getStack(), "Sequence":U, ttPriceUpdate.Sequence, OUTPUT iId).
                                                  RUN addNodeDate IN hGenXml (getStack(), "UpdateDate":U, ttPriceUpdate.UpdateDate, OUTPUT iId).
                                                  RUN addNode IN hGenXml (getStack(), "UpdateTime":U, ttPriceUpdate.UpdateTime, OUTPUT iId).
                                                  IF ttPriceUpdate.UpdateSource  >= 1 AND  UpdateSource  <= 3 THEN
                                                  DO: /*Test LOGIC*/
                                                       RUN addNodeDec IN hGenXml (getStack(), "UpdateSource":U, ttPriceUpdate.UpdateSource, OUTPUT iId).
                                                  END. /*Test LOGIC*/
                                                  IF ttPriceUpdate.UpdateUser <> ? THEN
                                                  DO: /*Test LOGIC*/
                                                       RUN addNode IN hGenXml (getStack(), "UpdateUser":U, ttPriceUpdate.UpdateUser, OUTPUT iId).
                                                  END. /*Test LOGIC*/
                                                  IF ttPriceUpdate.TableStatus <> ? THEN
                                                  DO: /*Test LOGIC*/
                                                       RUN addNodeDec IN hGenXml (getStack(), "TableStatus":U, ttPriceUpdate.TableStatus, OUTPUT iId).
                                                  END. /*Test LOGIC*/
                                                  IF ttPriceUpdate.PriceTableItemStatus >= 1 AND ttPriceUpdate.PriceTableItemStatus  <= 3 THEN
                                                  DO: /*Test LOGIC*/
                                                       RUN addNodeDec IN hGenXml (getStack(), "PriceTableItemStatus":U, ttPriceUpdate.PriceTableItemStatus, OUTPUT iId).
                                                  END. /*Test LOGIC*/
                                                  IF ttPriceUpdate.PriceGroupID <> ? AND ttPriceUpdate.PriceGroupID <> 0 THEN
                                                  DO: /*Test LOGIC*/
                                                       RUN addNode IN hGenXml (getStack(), "PriceGroup":U, "":U, OUTPUT iId).
                                                       addStack(iId).

                                                            RUN addNodeDec IN hGenXml (getStack(), "PriceGroupID":U, ttPriceUpdate.PriceGroupID, OUTPUT iId).
                                                            IF ttPriceUpdate.PriceGroupDescription <> ? THEN
                                                            DO: /*Test LOGIC*/
                                                                 RUN addNode IN hGenXml (getStack(), "PriceGroupDescription":U, ttPriceUpdate.PriceGroupDescription, OUTPUT iId).
                                                            END. /*Test LOGIC*/
                                                       delStack().

                                                  END. /*Test LOGIC*/
                                                  IF ttPriceUpdate.DiscountPercentageForQuantity <> ? THEN
                                                  DO: /*Test LOGIC*/
                                                       RUN addNodeDec IN hGenXml (getStack(), "DiscountPercentageForQuantity":U, ttPriceUpdate.DiscountPercentageForQuantity, OUTPUT iId).
                                                  END. /*Test LOGIC*/
                                                  RUN addNodeDec IN hGenXml (getStack(), "CIFSalesPrice":U, ttPriceUpdate.CIFSalesPrice, OUTPUT iId).
                                                  RUN addNodeDec IN hGenXml (getStack(), "MinimumCIFPrice":U, ttPriceUpdate.MinimumCIFPrice, OUTPUT iId).
                                                  RUN addNodeDec IN hGenXml (getStack(), "FOBSalesPrice":U, ttPriceUpdate.FOBSalesPrice, OUTPUT iId).
                                                  RUN addNodeDec IN hGenXml (getStack(), "MinimumFOBPrice":U, ttPriceUpdate.MinimumFOBPrice, OUTPUT iId).
                                                  IF ttPriceUpdate.ZeroProfitPrice <> ? THEN
                                                  DO: /*Test LOGIC*/
                                                       RUN addNodeDec IN hGenXml (getStack(), "ZeroProfitPrice":U, ttPriceUpdate.ZeroProfitPrice, OUTPUT iId).
                                                  END. /*Test LOGIC*/
                                             delStack().

                                        END.
                                   delStack().

                              END. /*Test LOGIC*/
                         delStack().

                    END.
               delStack().

          END. /*Test LOGIC*/

     delStack().


/* OBTEM O XML NUMA HANDLE */
RUN generateXML IN hGenXml (OUTPUT hBusinessContent).


/* DEFINE O CONTEÚDO DO ELEMENTO BusinessContent */
RUN setBusinessContent IN hMessageHandler (INPUT hBusinessContent).

/* LIBERA MEMÓRIA ALOCADA PARA O OBJETO */
DELETE OBJECT hBusinessContent NO-ERROR.

/*CONTRÓI A MENSAGEM XML E ENVIA PARA O ControlBroker */
RUN sendMessage IN hMessageHandler (INPUT "vd2/PriceTable_204_000.xsd":U). 

/* VERIFICA SE OCORREU ALGUM ERRO */
IF RETURN-VALUE <> "OK" THEN DO:
     CREATE TT_LOG_ERRO.
          ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 0.
          /* Inicio -- Projeto Internacional */
          DEFINE VARIABLE c-lbl-liter-4 AS CHARACTER NO-UNDO.
          ASSIGN c-lbl-liter-4 = TRIM(RETURN-VALUE).
          DEFINE VARIABLE c-lbl-liter-erro-no-envio-da-mensagem-2 AS CHARACTER NO-UNDO.
          {utp/ut-liter.i "Erro_no_envio_da_Mensagem" *}
          ASSIGN c-lbl-liter-erro-no-envio-da-mensagem-2 = TRIM(RETURN-VALUE).
          ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO = c-lbl-liter-erro-no-envio-da-mensagem-2 + ": "+ c-lbl-liter-4.
     RETURN RETURN-VALUE.
END.

/* VERIFICA SE A MENSAGEM FOI PROCESSADA COM SUCESSO */
RUN getReturnStatus IN hMessageHandler (OUTPUT pSendSuccess, OUTPUT pTotalErrors).

/* SE NAO ENVIO COM SUCESSO */
IF NOT pSendSuccess THEN DO:
     REPEAT iCount = 1 TO pTotalErrors:
          CREATE TT_LOG_ERRO.
          RUN getError IN hMessageHandler (iCount, OUTPUT TT_LOG_ERRO.TTV_NUM_COD_ERRO, OUTPUT pErrorType, OUTPUT TT_LOG_ERRO.TTV_DES_MSG_ERRO).
     END.
     RETURN "NOK".
END.
ELSE RETURN "OK".

