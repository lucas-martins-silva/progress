               RUN addNode IN hGenXml (getStack(), "PriceGroup":U, "":U, OUTPUT iId).
               addStack(iId).
                    RUN addNodeDec IN hGenXml (getStack(), "PriceGroupID":U, ttPriceTable.cd-gr-preco, OUTPUT iId).
                    RUN addNode IN hGenXml (getStack(), "PriceGroupDescription":U, ttPriceTable.descr, OUTPUT iId).
               delStack().
          END.
          
          RUN addNode IN hGenXml (getStack(), "Currency":U, "":U, OUTPUT iId).
          addStack(iId).

               RUN addNodeDec IN hGenXml (getStack(), "CurrencyID":U, ttPriceTable.mo-codigo, OUTPUT iId).
               RUN addNode IN hGenXml (getStack(), "CurrencyDescription":U, ttPriceTable.descr-moeda, OUTPUT iId).
               RUN addNode IN hGenXml (getStack(), "CurrencySign":U, ttPriceTable.sigla, OUTPUT iId).
          delStack().

          RUN addNodeDec IN hGenXml (getStack(), "DiscountPercentage":U, ttPriceTable.desconto, OUTPUT iId).

          IF ttPriceTable.observacoes <> "":U THEN
               RUN addNode IN hGenXml (getStack(), "Comments":U, ttPriceTable.observacoes, OUTPUT iId).

          RUN addNode IN hGenXml (getStack(), "ListOfPriceTableItens":U, "":U, OUTPUT iId).
          addStack(iId).

               FOR EACH ttPriceTableItem :
                    RUN addNode IN hGenXml (getStack(), "PriceTableItem":U, "":U, OUTPUT iId).
                    addStack(iId).

                         RUN addNodeDec IN hGenXml (getStack(), "Sequence":U, ttPriceTableItem.Sequence, OUTPUT iId).
                         RUN addNode IN hGenXml (getStack(), "Item":U, "":U, OUTPUT iId).
                         addStack(iId).

                              RUN addNode IN hGenXml (getStack(), "ItemCode":U, ttPriceTableItem.it-codigo, OUTPUT iId).
                              RUN addNode IN hGenXml (getStack(), "ItemDescription":U, ttPriceTableItem.desc-item, OUTPUT iId).
                              RUN addNode IN hGenXml (getStack(), "ItemReferenceCode":U, ttPriceTableItem.cod-refer, OUTPUT iId).
                         delStack().

                         RUN addNode IN hGenXml (getStack(), "UnitOfMeasure":U, "":U, OUTPUT iId).
                         addStack(iId).

                              RUN addNode IN hGenXml (getStack(), "UnitOfMeasureCode":U, ttPriceTableItem.cod-unid-med, OUTPUT iId).
                              RUN addNode IN hGenXml (getStack(), "UnitOfMeasureDescription":U, ttPriceTableItem.descricao, OUTPUT iId).
                         delStack().

                         RUN addNodeDate IN hGenXml (getStack(), "InitialValidityDate":U, ttPriceTableItem.dt-inival, OUTPUT iId).
                         RUN addNodeDate IN hGenXml (getStack(), "LastUpdateDate":U, ttPriceTableItem.dt-useralt, OUTPUT iId).
                         RUN addNodeDec IN hGenXml (getStack(), "MinimumQuantity":U, quant-min, OUTPUT iId).

                             RUN addNode IN hGenXml (getStack(), "PriceMarkup", "":U, OUTPUT iId).
                             addStack(iId).
    
                                  RUN addNodeDec IN hGenXml (getStack(), "MarkupID":U, ttPriceTableItem.cod-markup, OUTPUT iId).
                                  RUN addNode IN hGenXml (getStack(), "MarkupDescription":U, ttPriceTableItem.descr-markup, OUTPUT iId).
                                  
                                  IF ttPriceTableItem.cod-formula <> ? THEN DO:
                                      RUN addNode IN hGenXml (getStack(), "Formula":U, "":U, OUTPUT iId).
                                      addStack(iId).

                                           RUN addNodeDec IN hGenXml (getStack(), "FormulaID":U, ttPriceTableItem.cod-formula, OUTPUT iId).
                                           RUN addNode IN hGenXml (getStack(), "FormulaDescription":U, ttPriceTableItem.des-formula, OUTPUT iId).
                                           RUN addNodeDate IN hGenXml (getStack(), "InitialValidityDate":U, ttPriceTableItem.dt-inival, OUTPUT iId).
                                           RUN addNodeDate IN hGenXml (getStack(), "ValidityDate":U, ttPriceTableItem.dt-fimval, OUTPUT iId).
                                      delStack().
                                  END.
    
                             delStack().
                         
                         IF ttPriceTableItem.situacao >= 1 AND ttPriceTableItem.situacao <= 3 THEN
                            RUN addNodeDec IN hGenXml (getStack(), "PriceTableItemStatus":U, ttPriceTableItem.situacao, OUTPUT iId).
                         ELSE
                            RUN addNodeDec IN hGenXml (getStack(), "PriceTableItemStatus":U, 1, OUTPUT iId).

                         RUN addNodeDec IN hGenXml (getStack(), "DiscountPercentageForQuantity":U, ttPriceTableItem.desco-quant, OUTPUT iId).
                         RUN addNodeDec IN hGenXml (getStack(), "CIFSalesPrice":U, ttPriceTableItem.preco-venda, OUTPUT iId).
                         RUN addNodeDec IN hGenXml (getStack(), "MinimumCIFPrice":U, ttPriceTableItem.preco-min-cif, OUTPUT iId).
                         RUN addNodeDec IN hGenXml (getStack(), "FOBSalesPrice":U, ttPriceTableItem.preco-fob, OUTPUT iId).
                         RUN addNodeDec IN hGenXml (getStack(), "MinimumFOBPrice":U, ttPriceTableItem.preco-min-fob, OUTPUT iId).
                         RUN addNodeDec IN hGenXml (getStack(), "ProfitPercentage":U, ttPriceTableItem.val-pct-lucro, OUTPUT iId).
                         RUN addNodeDec IN hGenXml (getStack(), "ZeroProfitPrice":U, ttPriceTableItem.preco-lucro-zero, OUTPUT iId).

                         IF CAN-FIND(FIRST ttPriceUpdate WHERE
                                           ttPriceUpdate.nr-tabpre = ttPriceTableItem.nr-tabpre AND
                                           ttPriceUpdate.it-codigo = ttPriceTableItem.it-codigo AND
                                           ttPriceUpdate.cod-refer = ttPriceTableItem.cod-refer AND
                                           ttPriceUpdate.quant-min = ttPriceTableItem.quant-min AND
                                        &IF DEFINED(bf_dis_preco_un_med_mult) &THEN
                                           ttPriceUpdate.des-un-medida = ttPriceTableItem.cod-unid-med AND
                                        &ENDIF
                                           ttPriceUpdate.dt-inival = ttPriceTableItem.dt-inival) THEN DO:

                             RUN addNode IN hGenXml (getStack(), "ListOfPriceUpdates":U, "":U, OUTPUT iId).
                             addStack(iId).
    
                                  FOR EACH ttPriceUpdate WHERE
                                           ttPriceUpdate.nr-tabpre = ttPriceTableItem.nr-tabpre AND
                                           ttPriceUpdate.it-codigo = ttPriceTableItem.it-codigo AND
                                           ttPriceUpdate.cod-refer = ttPriceTableItem.cod-refer AND
                                           ttPriceUpdate.quant-min = ttPriceTableItem.quant-min AND
                                       &IF DEFINED(bf_dis_preco_un_med_mult) &THEN
                                           ttPriceUpdate.des-un-medida = ttPriceTableItem.cod-unid-med AND
                                       &ENDIF
                                           ttPriceUpdate.dt-inival = ttPriceTableItem.dt-inival:

                                       RUN addNode IN hGenXml (getStack(), "PriceUpdate":U, "":U, OUTPUT iId).
                                       addStack(iId).
    
                                            RUN addNodeDec IN hGenXml (getStack(), "Sequence":U, ttPriceUpdate.Sequence, OUTPUT iId).
                                            RUN addNodeDate IN hGenXml (getStack(), "UpdateDate":U, ttPriceUpdate.dt-movto, OUTPUT iId).
                                            RUN addNode IN hGenXml (getStack(), "UpdateTime":U, ttPriceUpdate.hr-movto, OUTPUT iId).

                                            IF ttPriceUpdate.cd-origem >= 1 AND ttPriceUpdate.cd-origem <= 3 THEN
                                                RUN addNodeDec IN hGenXml (getStack(), "UpdateSource":U, ttPriceUpdate.cd-origem, OUTPUT iId).
                                            ELSE
                                                RUN addNodeDec IN hGenXml (getStack(), "UpdateSource":U, 1, OUTPUT iId).

                                            RUN addNode IN hGenXml (getStack(), "UpdateUser":U, ttPriceUpdate.usuario-mov, OUTPUT iId).

                                            IF ttPriceUpdate.sit-tabpre >= 1 AND ttPriceUpdate.sit-tabpre <= 3 THEN
                                                RUN addNodeDec IN hGenXml (getStack(), "TableStatus":U, ttPriceUpdate.sit-tabpre, OUTPUT iId).
                                            ELSE
                                                RUN addNodeDec IN hGenXml (getStack(), "TableStatus":U, 1, OUTPUT iId).

                                            IF ttPriceUpdate.sit-hist = 1 OR ttPriceUpdate.sit-hist = 2 THEN
                                                RUN addNodeDec IN hGenXml (getStack(), "PriceTableItemStatus":U, ttPriceUpdate.sit-hist, OUTPUT iId).
                                            ELSE
                                                RUN addNodeDec IN hGenXml (getStack(), "PriceTableItemStatus":U, 1, OUTPUT iId).

                                            IF ttPriceUpdate.cd-gr-preco <> 0 THEN DO:
                                                RUN addNode IN hGenXml (getStack(), "PriceGroup":U, "":U, OUTPUT iId).
                                                addStack(iId).
        
                                                     RUN addNodeDec IN hGenXml (getStack(), "PriceGroupID":U, ttPriceUpdate.cd-gr-preco, OUTPUT iId).
                                                     RUN addNode IN hGenXml (getStack(), "PriceGroupDescription":U, ttPriceUpdate.descr, OUTPUT iId).
                                                delStack().
                                            END.
    
                                            RUN addNodeDec IN hGenXml (getStack(), "DiscountPercentageForQuantity":U, ttPriceUpdate.desco-quant, OUTPUT iId).
                                            RUN addNodeDec IN hGenXml (getStack(), "CIFSalesPrice":U, ttPriceUpdate.preco-venda, OUTPUT iId).
                                            RUN addNodeDec IN hGenXml (getStack(), "MinimumCIFPrice":U, ttPriceUpdate.preco-min-cif, OUTPUT iId).
                                            RUN addNodeDec IN hGenXml (getStack(), "FOBSalesPrice":U, ttPriceUpdate.preco-fob, OUTPUT iId).
                                            RUN addNodeDec IN hGenXml (getStack(), "MinimumFOBPrice":U, ttPriceUpdate.preco-min-fob, OUTPUT iId).
                                            RUN addNodeDec IN hGenXml (getStack(), "ZeroProfitPrice":U, ttPriceUpdate.preco-lucro-zero, OUTPUT iId).
                                       delStack().
    
                                  END.
                             delStack().
                         END. /* can-find */ 

                    delStack().

               END. /* each ttPriceItem */
          delStack().


     delStack().


/* OBTEM O XML NUMA HANDLE */
RUN generateXML IN hGenXml (OUTPUT hBusinessContent).


/* DEFINE O CONTEÚDO DO ELEMENTO BusinessContent */
RUN setBusinessContent IN hMessageHandler (INPUT hBusinessContent).

/* LIBERA MEMÓRIA ALOCADA PARA O OBJETO */
DELETE OBJECT hBusinessContent NO-ERROR.



/*CONTRÓI A MENSAGEM XML E ENVIA PARA O ControlBroker */
RUN sendMessage IN hMessageHandler (INPUT "vd2/PriceTable_204_000.xsd":U).

/* VERIFICA SE OCORREU ALGUM ERRO */
IF RETURN-VALUE <> "OK":U THEN DO:
     CREATE TT_LOG_ERRO.
          ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 17006.
          /* Inicio -- Projeto Internacional */
          DEFINE VARIABLE c-lbl-liter-4 AS CHARACTER NO-UNDO.
          ASSIGN c-lbl-liter-4 = TRIM(RETURN-VALUE).
          DEFINE VARIABLE c-lbl-liter-erro-no-envio-da-mensagem-2 AS CHARACTER NO-UNDO.
          {utp/ut-liter.i "Erro_no_envio_da_Mensagem" *}
          ASSIGN c-lbl-liter-erro-no-envio-da-mensagem-2 = TRIM(RETURN-VALUE).
          ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO = c-lbl-liter-erro-no-envio-da-mensagem-2 + ": "+ c-lbl-liter-4.
     RETURN RETURN-VALUE.
END.



/* VERIFICA SE A MENSAGEM FOI PROCESSADA COM SUCESSO */
RUN getReturnStatus IN hMessageHandler (OUTPUT pSendSuccess, OUTPUT pTotalErrors).

/* SE NAO ENVIO COM SUCESSO */
IF NOT pSendSuccess THEN DO:
     REPEAT iCount = 1 TO pTotalErrors:
          CREATE TT_LOG_ERRO.
          RUN getError IN hMessageHandler (iCount, OUTPUT TT_LOG_ERRO.TTV_NUM_COD_ERRO, OUTPUT pErrorType, OUTPUT TT_LOG_ERRO.TTV_DES_MSG_ERRO).
          ASSIGN tt_log_erro.ttv_num_cod_erro = 17006.
     END.

     RETURN "NOK":U.
END.
ELSE RETURN "OK":U.

               
/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.


/****** INTERNAL PROCEDURES - END*/




