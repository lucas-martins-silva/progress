                   IF INT(SUBSTRING(tt-repres.char-1,12,1)) >= 1 AND
                      INT(SUBSTRING(tt-repres.char-1,12,1)) <= 3 THEN
                       RUN addNodeDec IN hGenXml (getStack(), "AgentPaymentLiberation":U, SUBSTRING(tt-repres.char-1,12,1), OUTPUT iId).
                   ELSE
                       RUN addNodeDec IN hGenXml (getStack(), "AgentPaymentLiberation":U, 1, OUTPUT iId).
               &ELSE
                   IF tt-repres.idi-liber-pagto-comis-agent >= 1 AND
                      tt-repres.idi-liber-pagto-comis-agent <= 3 THEN
                       RUN addNodeDec IN hGenXml (getStack(), "AgentPaymentLiberation":U, tt-repres.idi-liber-pagto-comis-agent, OUTPUT iId).
                   ELSE
                       RUN addNodeDec IN hGenXml (getStack(), "AgentPaymentLiberation":U, 1, OUTPUT iId).
               &ENDIF
               RUN addNodeDec IN hGenXml (getStack(), "Currency":U, tt-repres.mo-codigo,                    OUTPUT iId).
               RUN addNodeLog IN hGenXml (getStack(), "IsProportionalCommission":U, tt-repres.comis-propor, OUTPUT iId).
          delStack().
          RUN addNodeDec IN hGenXml (getStack(), "IndirectRepresentativeCode":U, tt-repres.rep-indireto, OUTPUT iId).
          IF tt-repres.tipo-repres = 1 OR
             tt-repres.tipo-repres = 2 THEN
              RUN addNodeDec IN hGenXml (getStack(), "RepresentativeType":U, tt-repres.tipo-repres, OUTPUT iId).
          ELSE
              RUN addNodeDec IN hGenXml (getStack(), "RepresentativeType":U, 1, OUTPUT iId).

          IF tt-repres.ind-situacao = 1 OR
             tt-repres.ind-situacao = 2 THEN
              RUN addNodeDec IN hGenXml (getStack(), "RepresentativeStatus":U, tt-repres.ind-situacao, OUTPUT iId).
          ELSE
              RUN addNodeDec IN hGenXml (getStack(), "RepresentativeStatus":U, 1, OUTPUT iId).
          
          IF tt-repres.dt-deslig <> ? THEN
              RUN addNodeDate IN hGenXml (getStack(), "RepresentativeEndValidity":U, tt-repres.dt-deslig, OUTPUT iId).

          RUN addNodeDec  IN hGenXml (getStack(), "EmployeeEnrollment":U, tt-repres.fc-codigo,        OUTPUT iId).
          &IF "{&bf_dis_versao_ems}":U >= "2.05":U &THEN
              RUN addNode IN hGenXml (getStack(), "FormulaCode":U, tt-repres.cod-formula, OUTPUT iId).
          &ENDIF
          
          &IF "{&bf_dis_versao_ems}":U < "2.062":U &THEN
              IF SUBSTRING(tt-repres.char-1,1,1) = "Y":U THEN
                  RUN addNodeLog IN hGenXml (getStack(), "IncludeQuotaRepresentative":U, YES, OUTPUT iId).
              ELSE
                  RUN addNodeLog IN hGenXml (getStack(), "IncludeQuotaRepresentative":U, NO, OUTPUT iId).
          &ELSE
              RUN addNodeLog IN hGenXml (getStack(), "IncludeQuotaRepresentative":U, tt-repres.log-consid-repres-cotas, OUTPUT iId).
          &ENDIF
          RUN addNodeDec IN hGenXml (getStack(), "AdditionalPercentageOfIncomeStateTax":U, tt-repres.perc-aire, OUTPUT iId).
          RUN addNodeDec IN hGenXml (getStack(), "IndemnifyRetantionTaxCode":U, tt-repres.cod-retenc-indeniz,   OUTPUT iId).
          RUN addNodeDec IN hGenXml (getStack(), "IndemnifyTaxCode":U, tt-repres.cod-tax-indeniz,               OUTPUT iId).
          RUN addNodeDec IN hGenXml (getStack(), "IncomeRetantionTaxCode":U, tt-repres.cod-retencao,            OUTPUT iId).
          RUN addNodeDec IN hGenXml (getStack(), "TaxCode":U, tt-repres.cod-tax,                                OUTPUT iId).
          RUN addNodeLog IN hGenXml (getStack(), "IsPaymentOnHold":U, tt-repres.bloqueado-pagto,                OUTPUT iId).
          RUN addNode    IN hGenXml (getStack(), "PaymentSchedule":U, tt-repres.calendario-pagto,               OUTPUT iId).
          RUN addNode    IN hGenXml (getStack(), "RepresentativeUsersPermission":U, tt-repres.permissao,        OUTPUT iId).
     delStack().


/* OBTEM O XML NUMA HANDLE */
RUN generateXML IN hGenXml (OUTPUT hBusinessContent).


/* DEFINE O CONTEÚDO DO ELEMENTO BusinessContent */
RUN setBusinessContent IN hMessageHandler (INPUT hBusinessContent).

/* LIBERA MEMÓRIA ALOCADA PARA O OBJETO */
DELETE OBJECT hBusinessContent NO-ERROR.



/*CONTRÓI A MENSAGEM XML E ENVIA PARA O ControlBroker */
RUN sendMessage IN hMessageHandler (INPUT "vd2/Representative_204_000.xsd":U). 

/* VERIFICA SE OCORREU ALGUM ERRO */
IF RETURN-VALUE <> "OK":U THEN DO:
     CREATE TT_LOG_ERRO.
          ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 17006.
          /* Inicio -- Projeto Internacional */
          DEFINE VARIABLE c-lbl-liter-4 AS CHARACTER NO-UNDO.
          ASSIGN c-lbl-liter-4 = TRIM(RETURN-VALUE).
          DEFINE VARIABLE c-lbl-liter-erro-no-envio-da-mensagem-2 AS CHARACTER NO-UNDO.
          {utp/ut-liter.i "Erro_no_envio_da_Mensagem" *}
          ASSIGN c-lbl-liter-erro-no-envio-da-mensagem-2 = TRIM(RETURN-VALUE).
          ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO = c-lbl-liter-erro-no-envio-da-mensagem-2 + ": " + c-lbl-liter-4.
     RETURN RETURN-VALUE.
END.



/* VERIFICA SE A MENSAGEM FOI PROCESSADA COM SUCESSO */
RUN getReturnStatus IN hMessageHandler (OUTPUT pSendSuccess, OUTPUT pTotalErrors).



/* SE NAO ENVIO COM SUCESSO */
IF NOT pSendSuccess THEN DO:
     REPEAT iCount = 1 TO pTotalErrors:
          CREATE TT_LOG_ERRO.
          RUN getError IN hMessageHandler (iCount, OUTPUT TT_LOG_ERRO.TTV_NUM_COD_ERRO, OUTPUT pErrorType, OUTPUT TT_LOG_ERRO.TTV_DES_MSG_ERRO).
          ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 17006.
     END.
     RETURN "NOK":U.
END.
ELSE RETURN "OK":U.

/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.


/****** INTERNAL PROCEDURES - END*/




