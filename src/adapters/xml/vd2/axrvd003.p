                    RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "PrintingCommissionPercentage":U, OUTPUT tt-ped-repre.comis-emis).
                   /*******************************************************************************************  
                    **  Alteraá∆o efetuada durante implantaá∆o na RioPol:
                    **  Causa.......: O campo nr-pedrep n∆o estava sendo gravado
                    **  Soluá∆o.....: Incluido tratamento para o campo nr-pedrep
                    **  Respons†vel.: Denis ElotÇrio e M†rcio Lohmann
                    **  Data........: 22/02/2005 
                    *******************************************************************************************/
                    IF   tt-ped-repre.ind-repbase  <> ?
                    AND  tt-ped-repre.ind-repbase  =  YES THEN
                         RUN getSonVal  IN hGenXml (INPUT getStack(), INPUT "RepresentativeOrderNumber":U, OUTPUT tt-ped-venda.nr-pedrep).
                    ELSE IF  tt-ped-venda.nr-pedrep = ?
                         OR  tt-ped-venda.nr-pedrep = "" THEN
                         RUN getSonVal  IN hGenXml (INPUT getStack(), INPUT "RepresentativeOrderNumber":U, OUTPUT tt-ped-venda.nr-pedrep).
                    IF  tt-ped-venda.nr-pedrep = ? THEN
                        ASSIGN tt-ped-venda.nr-pedrep = "".
                   /******************************************************************************************
                    **  Fim do bloco alterado 
                    ******************************************************************************************/

                    ASSIGN iId = getStack().
                    delStack().
                    RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
               END.
          delStack().
          END.

          RUN searchTag IN hGenXml (INPUT "ListOfOrderItens":U, INPUT getStack(), OUTPUT iId).
          IF iId <> ? THEN DO:
          addStack(iId).

               RUN getFirstSonId IN hGenXml (INPUT getStack(), OUTPUT iId).
               /* Item do Pedido */
               DO WHILE iId <> ?:
                    addStack(iId).

                     RUN PI-tt-ped-item.
                     IF RETURN-VALUE = "NOK":U THEN UNDO, RETURN "NOK":U.  
                  
                    ASSIGN iId = getStack().
                    delStack().
                    RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
               END.

          delStack().
          END.

          RUN searchTag IN hGenXml (INPUT "Currency":U, INPUT getStack(), OUTPUT iId).
          IF iId <> ? THEN DO:
          addStack(iId).

               RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "CurrencyID":U, OUTPUT tt-ped-venda.mo-codigo).
          delStack().
          END.

          /* Vendor */

          RUN searchTag IN hGenXml (INPUT "VendorInformation":U, INPUT getStack(), OUTPUT iId).
          IF iId <> ? THEN DO:
          addStack(iId).

               /* Criacao de valores para manter as relacoes */
               CREATE tt-pd-vendor.

               RUN searchTag IN hGenXml (INPUT "FinancialRate":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? THEN
                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "FinancialRate", OUTPUT tt-pd-vendor.taxa-cliente).

               RUN searchTag IN hGenXml (INPUT "CustomerPaymentPlanCode":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? THEN
                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "CustomerPaymentPlanCode", OUTPUT tt-pd-vendor.cod-cond-pag).

               RUN searchTag IN hGenXml (INPUT "GraceDaysForVendorContractClosing":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? THEN
                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "GraceDaysForVendorContractClosing", OUTPUT tt-pd-vendor.dias-base).

               RUN searchTag IN hGenXml (INPUT "BaseDate":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? THEN
                  RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "BaseDate", OUTPUT tt-pd-vendor.data-base).

          delStack().
          END.

          RUN searchTag IN hGenXml (INPUT "Collection":U, INPUT getStack(), OUTPUT iId).
          IF iId <> ? THEN DO:
          addStack(iId).

               RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "CollectExpensesType":U, OUTPUT tt-ped-venda.tip-cob-desp).
               IF tt-ped-venda.tip-cob-desp = ? OR tt-ped-venda.tip-cob-desp < 1 OR tt-ped-venda.tip-cob-desp > 4 THEN
                 ASSIGN tt-ped-venda.tip-cob-desp = 0.

               RUN searchTag IN hGenXml (INPUT "CollectorID":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? THEN
                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "CollectorID":U, OUTPUT tt-ped-venda.cod-portador).

               RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "CollectionModality":U, OUTPUT tt-ped-venda.modalidade).
               IF tt-ped-venda.modalidade = ? OR tt-ped-venda.modalidade < 1 OR tt-ped-venda.modalidade > 9 THEN
                 ASSIGN tt-ped-venda.modalidade = 0.

          delStack().
          END.
          ELSE
              ASSIGN tt-ped-venda.tip-cob-desp = 0
                     tt-ped-venda.modalidade   = 0.

          RUN searchTag IN hGenXml (INPUT "PaymentPlan":U, INPUT getStack(), OUTPUT iId).
          IF iId <> ? THEN DO:
          addStack(iId).

               RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "PaymentPlanCode":U, OUTPUT tt-ped-venda.cod-cond-pag).

          END.
          /*---[ Integraá∆o EAI EMS x Wise Neogrid ]------------------------------------------------------------------*/
          if  can-find(first funcao
                       where funcao.cd-funcao = 'spp-neogrid':U
                         and funcao.ativo     = true) then do:
              IF tt-ped-venda.cod-cond-pag <> 0 THEN DO:
                 FOR FIRST emitente fields(cod-emitente cod-cond-pag) WHERE emitente.cod-emitente = int(i-cod-emitente) NO-LOCK:
                     ASSIGN tt-ped-venda.cod-cond-pag = emitente.cod-cond-pag.
                     IF CAN-FIND (FIRST natur-oper WHERE
                                        natur-oper.nat-operacao = tt-ped-venda.nat-operacao AND
                                        natur-oper.emite-duplic = NO) THEN
                        ASSIGN tt-ped-venda.cod-cond-pag = 0.
                     END.
              END.
          END.
          /*---[ Integraá∆o EAI EMS x Wise Neogrid ]------------------------------------------------------------------*/


               RUN searchTag IN hGenXml (INPUT "ListOfSpecialPaymentPlanTerms":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? AND tt-ped-venda.cod-cond-pag = 0 THEN DO:
               addStack(iId).

                    RUN getFirstSonId IN hGenXml (INPUT getStack(), OUTPUT iId).
                    /* Condiá∆o de Pagamento Especial */
                    DO WHILE iId <> ?:
                         addStack(iId).

                         ASSIGN i-nr-sequencia = 0.

                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "TermSequence":U, OUTPUT i-nr-sequencia).

                         IF CAN-FIND (FIRST tt-cond-ped WHERE tt-cond-ped.nr-sequencia = i-nr-sequencia NO-LOCK) THEN DO:
                              {utp/ut-liter.i Condiá∆o_Pagamento_Especial * r} 
                              RUN  piCriaErro (INPUT 8, INPUT "EMS":U, INPUT trim(return-value)). 
                              UNDO, RETURN "NOK":U.  
                         END.

                         CREATE tt-cond-ped.
                         ASSIGN tt-cond-ped.nr-sequencia = i-nr-sequencia.

                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "TermDueCode":U, OUTPUT tt-cond-ped.cod-vencto).
                         IF tt-cond-ped.cod-vencto = ? OR tt-cond-ped.cod-vencto < 1 OR tt-cond-ped.cod-vencto > 9 THEN
                            ASSIGN tt-cond-ped.cod-vencto = 1. /* default */

                         RUN searchTag IN hGenXml (INPUT "TermDueDate":U, INPUT getStack(), OUTPUT iId).
                         IF iId <> ? THEN
                            RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "TermDueDate":U, OUTPUT tt-cond-ped.data-pagto).

                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "TermDueDays":U, OUTPUT tt-cond-ped.nr-dias-venc).

                         RUN searchTag IN hGenXml (INPUT "TermComments":U, INPUT getStack(), OUTPUT iId).
                         IF iId <> ? THEN
                            RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "TermComments":U, OUTPUT tt-cond-ped.observacoes).

                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "TermPaymentPercentage":U, OUTPUT tt-cond-ped.perc-pagto).
                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "TermAmount":U, OUTPUT tt-cond-ped.vl-pagto).
                         ASSIGN iId = getStack().
                         delStack().
                         RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
                    END.

               delStack().
               END.

          delStack().

          /* Antecipaá∆o do Pedido */
          RUN searchTag IN hGenXml (INPUT "PrepaymentInformation":U, INPUT getStack(), OUTPUT iId).
          IF iId <> ? THEN DO:
          addStack(iId).

               /*Criacao de valores para manter as relacoes*/
               CREATE tt-ped-pag-antecipado.

               RUN getSonLog IN hGenXml (INPUT getStack(), INPUT "IsPrepaymentAvaiable":U, OUTPUT tt-ped-venda.ind-antecip).
               RUN searchTag IN hGenXml (INPUT "ListOfPrepayments":U, INPUT getStack(), OUTPUT iId).
               addStack(iId).

                    RUN getFirstSonId IN hGenXml (INPUT getStack(), OUTPUT iId). /* Prepayment */

                    DO WHILE iId <> ?:

                    addStack(iId).
                       RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "PrepaymentSequence":U, OUTPUT iCount).
                       RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "PrepaymentDate":U, OUTPUT tt-ped-pag-antecipado.data-antecip).
                       RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "PrepaymentAmount":U, OUTPUT tt-ped-pag-antecipado.valor-antecip).
                       ASSIGN iId = getStack().

                    delStack().
                        RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
                    END.

               delStack().

               RUN searchTag IN hGenXml (INPUT "PrepaymentComments":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? THEN 
                  RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "PrepaymentComments":U, OUTPUT tt-ped-pag-antecipado.observacoes).

          delStack().
          END.

          RUN searchTag IN hGenXml (INPUT "FinancialTable":U, INPUT getStack(), OUTPUT iId).
          IF iId <> ? THEN DO:
          addStack(iId).

               RUN searchTag IN hGenXml (INPUT "FinancialTableNumber":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? THEN 
                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "FinancialTableNumber":U, OUTPUT tt-ped-venda.nr-tab-finan).

               RUN searchTag IN hGenXml (INPUT "FinancialIndexNumber":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? THEN 
                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "FinancialIndexNumber":U, OUTPUT tt-ped-venda.nr-ind-finan).

               RUN searchTag IN hGenXml (INPUT "OrderTax":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? THEN 
                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "OrderTax":U, OUTPUT tt-ped-venda.tab-ind-fin).
          delStack().
          END.

          RUN searchTag IN hGenXml (INPUT "OrderValueInformation":U, INPUT getStack(), OUTPUT iId).
          IF iId <> ? THEN DO:
          addStack(iId).

               RUN searchTag IN hGenXml (INPUT "Discount":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? THEN DO:
               addStack(iId).

                    RUN searchTag IN hGenXml (INPUT "IsDiscountTableUsedInThisOrder":U, INPUT getStack(), OUTPUT iId).
                    IF iId <> ? THEN 
                       RUN getSonLog IN hGenXml (INPUT getStack(), INPUT "IsDiscountTableUsedInThisOrder":U, OUTPUT tt-ped-venda.log-usa-tabela-desconto).

                    RUN searchTag IN hGenXml (INPUT "EnteredDiscount":U, INPUT getStack(), OUTPUT iId).
                    IF iId <> ? THEN 
                       RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "EnteredDiscount":U, OUTPUT tt-ped-venda.des-pct-desconto-inform).

                    RUN searchTag IN hGenXml (INPUT "CustomerDiscount":U, INPUT getStack(), OUTPUT iId).
                    IF iId <> ? THEN 
                       RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "CustomerDiscount":U, OUTPUT tt-ped-venda.perc-desco1).

                    RUN searchTag IN hGenXml (INPUT "DiscountPercentage":U, INPUT getStack(), OUTPUT iId).
                    IF iId <> ? THEN 
                       RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "DiscountPercentage":U, OUTPUT tt-ped-venda.perc-desco2).

                    RUN searchTag IN hGenXml (INPUT "PriceTableDiscountPercentage":U, INPUT getStack(), OUTPUT iId).
                    IF iId <> ? THEN 
                       RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "PriceTableDiscountPercentage":U, OUTPUT tt-ped-venda.val-pct-desconto-tab-preco).

                    RUN searchTag IN hGenXml (INPUT "DiscountAmount":U, INPUT getStack(), OUTPUT iId).
                    IF iId <> ? THEN 
                       RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "DiscountAmount":U, OUTPUT tt-ped-venda.vl-desconto).

                    RUN searchTag IN hGenXml (INPUT "TotalDiscountAmount":U, INPUT getStack(), OUTPUT iId).
                    IF iId <> ? THEN 
                       RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "TotalDiscountAmount":U, OUTPUT tt-ped-venda.val-desconto-total).

                    RUN searchTag IN hGenXml (INPUT "TotalPercentageOfOrderDiscount":U, INPUT getStack(), OUTPUT iId).
                    IF iId <> ? THEN 
                       RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "TotalPercentageOfOrderDiscount":U, OUTPUT tt-ped-venda.val-pct-desconto-total).

                    RUN searchTag IN hGenXml (INPUT "OrderDiscountsDescription":U, INPUT getStack(), OUTPUT iId).
                    IF iId <> ? THEN 
                       RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "OrderDiscountsDescription":U, OUTPUT tt-ped-venda.desc-txt).

                    RUN searchTag IN hGenXml (INPUT "DiscountPerValuePercentage":U, INPUT getStack(), OUTPUT iId).
                    IF iId <> ? THEN 
                       RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "DiscountPerValuePercentage":U, OUTPUT tt-ped-venda.val-pct-desconto-valor).

                    &IF '{&bf_dis_versao_ems}' >= '2.05' &THEN  
                        RUN searchTag IN hGenXml (INPUT "DiscountPerValueGrantedOnInvoicingDocumentLevel":U, INPUT getStack(), OUTPUT iId).
                        IF iId <> ? THEN 
                           RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "DiscountPerValueGrantedOnInvoicingDocumentLevel":U, OUTPUT tt-ped-venda.desc-valor-ped).
                    &ENDIF

                    RUN searchTag IN hGenXml (INPUT "IsExtraDiscountAppliedOverSalesPrice":U, INPUT getStack(), OUTPUT iId).
                    IF iId <> ? THEN 
                       RUN getSonLog IN hGenXml (INPUT getStack(), INPUT "IsExtraDiscountAppliedOverSalesPrice":U, OUTPUT tt-ped-venda.inc-desc-txt).
               delStack().
               END.

               RUN searchTag IN hGenXml (INPUT "Taxes":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? THEN DO:
               addStack(iId).

                    RUN searchTag IN hGenXml (INPUT "SalesTax":U, INPUT getStack(), OUTPUT iId).
                    IF iId <> ? THEN DO:
                    addStack(iId).
                        RUN searchTag IN hGenXml (INPUT "DiscountPercentage":U, INPUT getStack(), OUTPUT iId).
                        IF iId <> ? THEN 
                           RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "DiscountPercentage":U, OUTPUT tt-ped-venda.per-des-icms).
                    delStack().
                    END.

               delStack().
               END.

               RUN searchTag IN hGenXml (INPUT "Price":U, INPUT getStack(), OUTPUT iId).
               addStack(iId).

                   RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "OrderPriceType":U, OUTPUT tt-ped-venda.tp-preco).
                   IF tt-ped-venda.tp-preco = ? OR tt-ped-venda.tp-preco < 1 OR tt-ped-venda.tp-preco > 4 THEN
                      ASSIGN tt-ped-venda.tp-preco = 0.

                   /*---[ Integraá∆o EAI EMS x Wise Neogrid ]------------------------------------------------------------------*/
                   if  can-find(first funcao
                                where funcao.cd-funcao = 'spp-neogrid':U
                                and   funcao.ativo     = true) then do:
                       if  tt-ped-venda.tp-preco <> 1 /* preáo informado */ then do:
                           find first para-ped no-lock no-error.
                           assign tt-ped-venda.tp-preco = para-ped.tp-preco. /* conforme feito no bodi159sd.p para o pd4000 */
                       end. /* if  tt-ped-venda.tp-preco <> 1 */
                   end. /* if  can-find(first funcao */
                   /*------------------------------------------------------------------[ Integraá∆o EAI EMS x Wise Neogrid ]---*/
                   
                   RUN searchTag IN hGenXml (INPUT "PriceTableNumber":U, INPUT getStack(), OUTPUT iId).
                   IF iId <> ? THEN 
                      RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "PriceTableNumber":U, OUTPUT tt-ped-venda.nr-tabpre).

                   RUN searchTag IN hGenXml (INPUT "ProfitMinimumPercentage":U, INPUT getStack(), OUTPUT iId).
                   IF iId <> ? THEN 
                      RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ProfitMinimumPercentage":U, OUTPUT tt-ped-venda.pct-min-rentab).

                   RUN searchTag IN hGenXml (INPUT "OpenedGoodsNetAmount":U, INPUT getStack(), OUTPUT iId).
                   IF iId <> ? THEN 
                      RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "OpenedGoodsNetAmount":U, OUTPUT tt-ped-venda.vl-mer-abe).

                   RUN searchTag IN hGenXml (INPUT "OrderItemOpenedAmount":U, INPUT getStack(), OUTPUT iId).
                   IF iId <> ? THEN 
                      RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "OrderItemOpenedAmount":U, OUTPUT tt-ped-venda.vl-liq-abe).

                    RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "OrderTotalAmount":U, OUTPUT tt-ped-venda.vl-tot-ped).

                    RUN searchTag IN hGenXml (INPUT "OrderTotalNerAmount":U, INPUT getStack(), OUTPUT iId).
                    IF iId <> ? THEN 
                       RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "OrderTotalNetAmount":U, OUTPUT tt-ped-venda.vl-liq-ped).
               delStack().

          delStack().
          END.

          /*---[ Informaá‰es Adicionais ]-----------------------------------------------------------------------------------------------*/
          RUN searchTag IN hGenXml (INPUT "ListofAdditionalInformation":U, INPUT getStack(), OUTPUT iId).
          IF iId <> ? THEN DO:
          addStack(iId).
              RUN getFirstSonId IN hGenXml (INPUT getStack(), OUTPUT iId).
              DO  WHILE iId <> ?:
                  addStack(iId).

                  create tt-inform-adicional.
                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "Sequence":U, OUTPUT tt-inform-adicional.seq).
                  RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "Information":U, OUTPUT tt-inform-adicional.inform).

                  ASSIGN iId = getStack().
                  delStack().
                  RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
              END.
          delStack().
          END.
          /*-----------------------------------------------------------------------------------------------[ Informaá‰es Adicionais ]---*/

        ASSIGN iId = getStack().
        delStack().   
        RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).

    END. /* Pedido de Venda */


     /* ********* LEITURA DA MENSAGEM - END   ********* */


     /* ********* EFETIVA«√O - BEGIN ********* */

{adapters/xml/vd2/axrvd003upsert.i}



     /* ********* EFETIVA«√O - END   ********* */

/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.

PROCEDURE PI-tt-ped-item:

    /*Criacao de valores para manter as relacoes*/
    ASSIGN c-cod-refer    = ""
           i-nr-sequencia = 0.

    RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "OrderLine":U, OUTPUT i-nr-sequencia).
    RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ItemCode":U, OUTPUT c-it-codigo).

    /*---[ EANCode ]-------------------------------------------------------------*/
    RUN searchTag IN hGenXml (INPUT "EanCode":U, INPUT getStack(), OUTPUT iId).
    IF iId <> ? THEN 
       RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "EanCode":U, OUTPUT c-eanCode).

    /*---[ CustomerItemCode ]----------------------------------------------------*/
    RUN searchTag IN hGenXml (INPUT "CustomerItemCode":U, INPUT getStack(), OUTPUT iId).
    IF iId <> ? THEN 
       RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "CustomerItemCode":U, OUTPUT c-customerItemCode).
    
    IF  c-eanCode <> "" THEN DO:
        &if '{&bf_dis_versao_ems}' >= '2.05' &then 
            FIND FIRST item-mat NO-LOCK
                WHERE  item-mat.cod-ean = c-eanCode NO-ERROR.
            IF  AVAIL  item-mat THEN ASSIGN c-it-codigo = item-mat.it-codigo.
        &endif
    END. /* IF  tt-ped-item.it-codigo = "" */
    IF  c-customerItemCode <> "" THEN DO:
        FIND FIRST item-cli NO-LOCK
            WHERE  item-cli.nome-abrev  = tt-ped-venda.nome-abrev
            AND    item-cli.item-do-cli = c-customerItemCode NO-ERROR.
        IF  AVAIL  item-cli THEN ASSIGN c-it-codigo = item-cli.it-codigo.
    END. /* IF  c-customerItemCode <> "" */
    RUN searchTag IN hGenXml (INPUT "ItemReferenceCode":U, INPUT getStack(), OUTPUT iId).
    IF iId <> ? THEN 
       RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ItemReferenceCode":U, OUTPUT c-cod-refer).

    IF CAN-FIND (FIRST tt-ped-item WHERE tt-ped-item.nr-pedcli    = tt-ped-venda.nr-pedcli
                                     AND tt-ped-item.nome-abrev   = tt-ped-venda.nome-abrev
                                     AND tt-ped-item.it-codigo    = c-it-codigo
                                     AND tt-ped-item.cod-refer    = c-cod-refer
                                     AND tt-ped-item.nr-sequencia = i-nr-sequencia NO-LOCK) THEN DO:

      {utp/ut-liter.i Item_Pedido * r} 
      RUN  piCriaErro (INPUT 8, INPUT "EMS":U, INPUT trim(return-value)). 
      UNDO, RETURN "NOK":U.  
    END.

    CREATE tt-ped-item.
    ASSIGN tt-ped-item.nr-pedcli    = tt-ped-venda.nr-pedcli
           tt-ped-item.nome-abrev   = tt-ped-venda.nome-abrev
           tt-ped-item.it-codigo    = c-it-codigo
           tt-ped-item.cod-refer    = c-cod-refer
           tt-ped-item.nr-sequencia = i-nr-sequencia
           overlay(tt-ped-item.char-1,1,2) = "16":U /* Origem ->> EAI */

           tt-ped-item.tp-preco                   = ? 
           tt-ped-item.dt-entrega                 = ?    
           tt-ped-item.dt-min-fat                 = ?
           tt-ped-item.dt-entorig                 = ?
           tt-ped-item.dt-userimp                 = ?
           tt-ped-item.user-impl                  = ? 
           tt-ped-item.log-usa-tabela-desconto    = ? 
           tt-ped-item.ind-fat-qtfam              = ?   
           tt-ped-item.ind-icm-ret                = ?    
           tt-ped-item.aliquota-ipi               = ?    
           tt-ped-item.dat-alter-sit              = ? 
           tt-ped-item.cod-usu-alt-sit            = ?
           tt-ped-item.per-des-icms               = ?
           tt-ped-item.dec-2                      = ?
           tt-ped-item.val-desconto[1]            = ? 
           tt-ped-item.val-desconto[2]            = ? 
           tt-ped-item.val-desconto[3]            = ? 
           tt-ped-item.val-desconto[4]            = ? 
           tt-ped-item.val-desconto[5]            = ? 
           tt-ped-item.val-pct-desconto-periodo   = ? 
           tt-ped-item.val-pct-desconto-prazo     = ? 
           tt-ped-item.log-concede-bonif-qtd      = ? 
           tt-ped-item.per-des-item               = ?
           tt-ped-item.vl-desconto                = ?
           tt-ped-item.val-desconto-inform        = ?
           tt-ped-item.val-desconto-total         = ?
           tt-ped-item.val-pct-desconto-total     = ?
           tt-ped-item.val-pct-desconto-tab-preco = ?
           tt-ped-item.des-pct-desconto-inform    = ?
           tt-ped-item.desc-txt                   = ?
           tt-ped-item.num-sequencia-bonif        = ?
           tt-ped-item.val-desconto-bonif         = ?
           tt-ped-item.val-pct-bonif              = ?
           tt-ped-item.vl-preori                  = ?
           tt-ped-item.val-pct-desconto-tab-preco = ?.


    /* Validaá∆o - Retem ICMS Fonte ********************************************/
    IF  tt-ped-venda.nat-operacao <> "" THEN DO:
        IF CAN-FIND(FIRST natur-oper
                    WHERE natur-oper.nat-operacao = tt-ped-venda.nat-operacao
                    AND   natur-oper.subs-trib NO-LOCK) THEN DO:
            IF CAN-FIND(FIRST funcao
                        WHERE funcao.cd-funcao = 'spp-sgt':U
                        AND   funcao.ativo     = TRUE NO-LOCK) THEN DO:
                ASSIGN tt-ped-item.ind-icm-ret = YES.
            END.
        END.
    END.
    /***************************************************************************/

    RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ComponentType":U, OUTPUT tt-ped-item.ind-componen).
    IF tt-ped-item.ind-componen =? OR tt-ped-item.ind-componen < 1 OR tt-ped-item.ind-componen > 3 THEN
       ASSIGN tt-ped-item.ind-componen = 1. /* default */

    RUN searchTag IN hGenXml (INPUT "Addition":U, INPUT getStack(), OUTPUT iId).
    IF iId <> ? THEN DO:
    addStack(iId).

