    RUN searchTag IN hGenXml (INPUT "OrderItemValueInformation":U, INPUT getStack(), OUTPUT iId).
    addStack(iId).

         RUN searchTag IN hGenXml (INPUT "DiscountsAndBonification":U, INPUT getStack(), OUTPUT iId).
         IF iId <> ? THEN DO:
         addStack(iId).

              RUN searchTag IN hGenXml (INPUT "EnteredDiscount":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "EnteredDiscount":U, OUTPUT tt-ped-item.des-pct-desconto-inform).

              RUN searchTag IN hGenXml (INPUT "DiscountValue":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "DiscountValue":U, OUTPUT tt-ped-item.val-desconto-inform).

              RUN searchTag IN hGenXml (INPUT "DiscountPercentage":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "DiscountPercentage":U, OUTPUT tt-ped-item.per-des-item).

              RUN searchTag IN hGenXml (INPUT "PriceTableDiscountPercentage":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "PriceTableDiscountPercentage":U, OUTPUT tt-ped-item.val-pct-desconto-tab-preco).

              RUN searchTag IN hGenXml (INPUT "DiscountAmount":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "DiscountAmount":U, OUTPUT tt-ped-item.vl-desconto).

              RUN searchTag IN hGenXml (INPUT "TotalDiscountAmount":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "TotalDiscountAmount":U, OUTPUT tt-ped-item.val-desconto-total).

              RUN searchTag IN hGenXml (INPUT "TotalPercentageOfOrderItemDiscount":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "TotalPercentageOfOrderItemDiscount":U, OUTPUT tt-ped-item.val-pct-desconto-total).

              RUN searchTag IN hGenXml (INPUT "OrderItemDiscountsDescription":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "OrderItemDiscountsDescription":U, OUTPUT tt-ped-item.desc-txt).

              RUN searchTag IN hGenXml (INPUT "PeriodDiscountPercentage":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "PeriodDiscountPercentage":U, OUTPUT tt-ped-item.val-pct-desconto-periodo).

              RUN searchTag IN hGenXml (INPUT "DiscountPercentageLinkedToPaymentTerm":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "DiscountPercentageLinkedToPaymentTerm":U, OUTPUT tt-ped-item.val-pct-desconto-prazo).

              RUN searchTag IN hGenXml (INPUT "DiscountTable":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN DO:
              addStack(iId).

                   RUN searchTag IN hGenXml (INPUT "IsDiscountTableUsedInThisItem":U, INPUT getStack(), OUTPUT iId).
                   IF iId <> ? THEN
                      RUN getSonLog IN hGenXml (INPUT getStack(), INPUT "IsDiscountTableUsedInThisItem":U, OUTPUT tt-ped-item.log-usa-tabela-desconto).

                   RUN searchTag IN hGenXml (INPUT "ListOfDiscountTableValues":U, INPUT getStack(), OUTPUT iId).
                   IF iId <> ? THEN DO:
                   addStack(iId).

                       RUN getChildrenList IN hGenXml (INPUT getStack(), OUTPUT cDiscount). 
                       RUN getFirstSonId IN hGenXml (INPUT getStack(), OUTPUT iId).
                       DO iCount = 1 TO num-entries(cDiscount): /* DiscountTableValue */

                          RUN getValue IN hGenXml (INPUT iId, OUTPUT c-val-desconto).
                          ASSIGN tt-ped-item.val-desconto[iCount] = dec(c-val-desconto).

                          RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
                       END.

                   delStack(). /* ListOfDiscountTableValues */
                   END.

                   /* tt-desc-ped-item */
                   RUN searchTag IN hGenXml (INPUT "ListOfDiscounts":U, INPUT getStack(), OUTPUT iId).
                   IF iId <> ? THEN DO:
                   addStack(iId).

                       RUN getFirstSonId IN hGenXml (INPUT getStack(), OUTPUT iId). /* Discount */
                       DO WHILE iId <> ?:
                           addStack(iId).

                           RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "DiscountNumber":U, OUTPUT i-num-desconto).

                           IF CAN-FIND (FIRST tt-desc-ped-item WHERE tt-desc-ped-item.nom-abrev-cliente  = tt-ped-venda.nome-abrev
                                                                 AND tt-desc-ped-item.cod-pedido-cliente = tt-ped-venda.nr-pedcli
                                                                 AND tt-desc-ped-item.num-sequencia      = tt-ped-item.nr-sequencia
                                                                 AND tt-desc-ped-item.cod-item           = tt-ped-item.it-codigo
                                                                 AND tt-desc-ped-item.cod-refer          = tt-ped-item.cod-refer
                                                                 AND tt-desc-ped-item.num-desconto       = i-num-desconto  NO-LOCK) THEN DO:
                                      {utp/ut-liter.i Desconto_Item_Pedido * r}
                                      RUN  piCriaErro (INPUT 8, INPUT "EMS":U, INPUT trim(return-value)). 
                                      UNDO, RETURN "NOK":U.  
                           END.

                           /* Criacao de valores para manter as relacoes */
                           CREATE tt-desc-ped-item.
                           ASSIGN tt-desc-ped-item.nom-abrev-cliente  = tt-ped-venda.nome-abrev
                                  tt-desc-ped-item.cod-pedido-cliente = tt-ped-venda.nr-pedcli
                                  tt-desc-ped-item.num-sequencia      = tt-ped-item.nr-sequencia
                                  tt-desc-ped-item.cod-item           = tt-ped-item.it-codigo
                                  tt-desc-ped-item.cod-refer          = tt-ped-item.cod-refer
                                  tt-desc-ped-item.num-desconto       = i-num-desconto.

                           RUN searchTag IN hGenXml (INPUT "PeriodDiscountPercentage":U, INPUT getStack(), OUTPUT iId).
                           IF iId <> ? THEN
                               RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "PeriodDiscountPercentage":U, OUTPUT tt-desc-ped-item.val-pct-desconto-periodo).

                           RUN searchTag IN hGenXml (INPUT "DiscountPercentageLinkedToPaymentTerm":U, INPUT getStack(), OUTPUT iId).
                           IF iId <> ? THEN
                               RUN getSonLog IN hGenXml (INPUT getStack(), INPUT "DiscountPercentageLinkedToPaymentTerm":U, OUTPUT tt-desc-ped-item.val-pct-desconto-prazo).

                           RUN searchTag IN hGenXml (INPUT "IsBonusGrantedOnQuantity":U, INPUT getStack(), OUTPUT iId).
                           IF iId <> ? THEN 
                              RUN getSonLog IN hGenXml (INPUT getStack(), INPUT "IsBonusGrantedOnQuantity":U, OUTPUT tt-desc-ped-item.log-concede-bonif-qtd).

                           RUN searchTag IN hGenXml (INPUT "ListOfDiscountTableValues":U, INPUT getStack(), OUTPUT iId).
                           IF iId <> ? THEN DO:
                           addStack(iId).

                               RUN getChildrenList IN hGenXml (INPUT getStack(), OUTPUT cDiscount). 
                               RUN getFirstSonId IN hGenXml (INPUT getStack(), OUTPUT iId).
                               DO iCount = 1 TO num-entries(cDiscount): /* DiscountTableValue */

                                  RUN getValue IN hGenXml (INPUT iId, OUTPUT c-val-desconto).
                                  ASSIGN tt-desc-ped-item.val-desconto[iCount] = dec(c-val-desconto).

                                  RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
                               END.

                           delStack(). /* ListOfDiscountTableValues */
                           END.

                           ASSIGN iId = getStack().

                           delStack().
                           RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
                       END. /*  Discount  */

                   delStack(). /* ListOfDiscounts */
                   END.

              delStack().  /* DiscountTable */
              END.

              RUN searchTag IN hGenXml (INPUT "Bonification":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN DO:
              addStack(iId).

                   RUN searchTag IN hGenXml (INPUT "IsBonusGrantedOnQuantity":U, INPUT getStack(), OUTPUT iId).
                   IF iId <> ? THEN
                      RUN getSonLog IN hGenXml (INPUT getStack(), INPUT "IsBonusGrantedOnQuantity":U, OUTPUT tt-ped-item.log-concede-bonif-qtd).

                   RUN searchTag IN hGenXml (INPUT "BonusSequence":U, INPUT getStack(), OUTPUT iId).
                   IF iId <> ? THEN
                      RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "BonusSequence":U, OUTPUT tt-ped-item.num-sequencia-bonif).

                   RUN searchTag IN hGenXml (INPUT "BonusDiscountValue":U, INPUT getStack(), OUTPUT iId).
                   IF iId <> ? THEN
                      RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "BonusDiscountValue":U, OUTPUT tt-ped-item.val-desconto-bonif).

                   RUN searchTag IN hGenXml (INPUT "BonusPercentage":U, INPUT getStack(), OUTPUT iId).
                   IF iId <> ? THEN
                      RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "BonusPercentage":U, OUTPUT tt-ped-item.val-pct-bonif).
              delStack().
              END.

         delStack().
         END.

         RUN searchTag IN hGenXml (INPUT "Taxes":U, INPUT getStack(), OUTPUT iId).
         IF iId <> ? THEN DO:
         addStack(iId).

              RUN searchTag IN hGenXml (INPUT "IndustrializedProductTaxPercentage":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "IndustrializedProductTaxPercentage":U, OUTPUT tt-ped-item.aliquota-ipi).

              RUN searchTag IN hGenXml (INPUT "ServiceTaxPercentage":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ServiceTaxPercentage":U, OUTPUT tt-ped-item.dec-2).

              RUN searchTag IN hGenXml (INPUT "SalesTax":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN DO:
              addStack(iId).

                   RUN searchTag IN hGenXml (INPUT "IsSalesTaxRestrainedOnSource":U, INPUT getStack(), OUTPUT iId).
                   IF iId <> ? THEN
                      RUN getSonLog IN hGenXml (INPUT getStack(), INPUT "IsSalesTaxRestrainedOnSource":U, OUTPUT tt-ped-item.ind-icm-ret).

                   RUN searchTag IN hGenXml (INPUT "DiscountPercentage":U, INPUT getStack(), OUTPUT iId).
                   IF iId <> ? THEN
                       RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "DiscountPercentage":U, OUTPUT tt-ped-item.per-des-icms).
              delStack().
              END.

         delStack().
         END.


         RUN searchTag IN hGenXml (INPUT "Price":U, INPUT getStack(), OUTPUT iId).
         addStack(iId).

              RUN searchTag IN hGenXml (INPUT "PriceTableNumber":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "PriceTableNumber":U, OUTPUT tt-ped-item.nr-tabpre).

              RUN searchTag IN hGenXml (INPUT "PriceTableValue":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "PriceTableValue":U, OUTPUT tt-ped-item.vl-pretab).

              RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "OriginalPrice":U, OUTPUT tt-ped-item.vl-preori).

              RUN searchTag IN hGenXml (INPUT "NetUnitaryPrice":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "NetUnitaryPrice":U, OUTPUT tt-ped-item.vl-preuni).

              RUN searchTag IN hGenXml (INPUT "OpenedGoodsNetAmount":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "OpenedGoodsNetAmount":U, OUTPUT tt-ped-item.vl-merc-abe).

              RUN searchTag IN hGenXml (INPUT "OrderItemOpenedAmount":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "OrderItemOpenedAmount":U, OUTPUT tt-ped-item.vl-liq-abe).

              RUN searchTag IN hGenXml (INPUT "OrderItemTotalAmount":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "OrderItemTotalAmount":U, OUTPUT tt-ped-item.vl-tot-it).

              RUN searchTag IN hGenXml (INPUT "OrderItemTotalNetAmount":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "OrderItemTotalNetAmount":U, OUTPUT tt-ped-item.vl-liq-it).

              RUN searchTag IN hGenXml (INPUT "PriceInOriginalInvoicingUnitOfMeasure":U, INPUT getStack(), OUTPUT iId).
              IF iId <> ? THEN
                 RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "PriceInOriginalInvoicingUnitOfMeasure":U, OUTPUT tt-ped-item.vl-preori-un-fat).
         delStack().

    delStack().

    RUN searchTag IN hGenXml (INPUT "Devolution":U, INPUT getStack(), OUTPUT iId).
    IF iId <> ? THEN DO:
    addStack(iId).

         RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "DevolutionReasonDescription":U, OUTPUT tt-ped-item.desc-devol).
         RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "DevolutionDate":U, OUTPUT tt-ped-item.dt-devolucao).
         RUN searchTag IN hGenXml (INPUT "DevolutionUser":U, INPUT getStack(), OUTPUT iId).
         addStack(iId).

              RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "UserID":U, OUTPUT tt-ped-item.user-devol).
         delStack().

         RUN searchTag IN hGenXml (INPUT "ReturnedAmount":U, INPUT getStack(), OUTPUT iId).
         IF iId <> ? THEN
            RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ReturnedAmount":U, OUTPUT tt-ped-item.qt-devolvida).
    delStack().
    END.

    RUN searchTag IN hGenXml (INPUT "ListOfBusinessUnits":U, INPUT getStack(), OUTPUT iId).
    IF iId <> ? THEN DO:
    addStack(iId).

           RUN getFirstSonId IN hGenXml (INPUT getStack(), OUTPUT iId).
           /* Unidade de Neg¢cio */
           DO WHILE iId <> ?:
                addStack(iId).

                RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "BusinessUnitID":U, OUTPUT i_cod_unid_negoc).

                IF CAN-FIND (FIRST tt-unid-neg-ped WHERE tt-unid-neg-ped.nome-abrev     = tt-ped-venda.nome-abrev
                                                     AND tt-unid-neg-ped.nr-pedcli      = tt-ped-venda.nr-pedcli
                                                     AND tt-unid-neg-ped.nr-sequencia   = tt-ped-item.nr-sequencia
                                                     &IF "{&ems_dbtype}" <> "PROGRESS":U &THEN 
                                                     AND tt-unid-neg-ped.char-1         = tt-ped-item.it-codigo
                                                     &ELSE
                                                     AND tt-unid-neg-ped.it-codigo      = tt-ped-item.it-codigo
                                                     &ENDIF
                                                     AND tt-unid-neg-ped.cod-refer      = tt-ped-item.cod-refer
                                                     AND tt-unid-neg-ped.cod_unid_negoc = i_cod_unid_negoc  NO-LOCK) THEN DO:
                                      {utp/ut-liter.i Unidade_Neg¢cio_Pedido * r}
                                      RUN  piCriaErro (INPUT 8, INPUT "EMS":U, INPUT trim(return-value)). 
                                      UNDO, RETURN "NOK":U.  
                END.

                /* Criacao de valores para manter as relacoes */
                CREATE tt-unid-neg-ped.
                ASSIGN tt-unid-neg-ped.nome-abrev     = tt-ped-venda.nome-abrev
                       tt-unid-neg-ped.nr-pedcli      = tt-ped-venda.nr-pedcli
                       tt-unid-neg-ped.nr-sequencia   = tt-ped-item.nr-sequencia
                       &IF "{&ems_dbtype}" <> "PROGRESS":U &THEN 
                       tt-unid-neg-ped.char-1         = tt-ped-item.it-codigo
                       &ELSE
                       tt-unid-neg-ped.it-codigo      = tt-ped-item.it-codigo
                       &ENDIF
                       tt-unid-neg-ped.cod-refer      = tt-ped-item.cod-refer
                       tt-unid-neg-ped.cod_unid_negoc = i_cod_unid_negoc.

                RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "BusinessUnitPercentage":U, OUTPUT tt-unid-neg-ped.perc-unid-neg).
                RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "BusinessUnitQuantity":U, OUTPUT tt-unid-neg-ped.qtd-unid-neg).
                RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "BusinessUnitValue":U, OUTPUT tt-unid-neg-ped.val-unid-neg).

                ASSIGN iId = getStack().
                delStack().
                RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
           END.

    delStack().
    END. 

    /*---[ integraá∆o EMSxNeogrid ]---------------------------------------------------------------------------------*/
    &IF '{&BF_DIS_VERSAO_EMS}' >= '2.062' &THEN
        FIND FIRST config-tip-operac NO-LOCK
            WHERE  config-tip-operac.cod-tip-operac = 'axrvd003' NO-ERROR.
        IF  AVAIL config-tip-operac THEN DO:
            EMPTY TEMP-TABLE tt-variavel.
        
            CREATE tt-variavel.
            ASSIGN tt-variavel.cod-var-oper = 'transaction'
                   tt-variavel.cod-val-var  = cTranAction.
        
            CREATE tt-variavel.
            ASSIGN tt-variavel.cod-var-oper = 'nome-abrev'
                   tt-variavel.cod-val-var  = tt-ped-item.nome-abrev.

            CREATE tt-variavel.
            ASSIGN tt-variavel.cod-var-oper = 'nr-pedcli'
                   tt-variavel.cod-val-var  = tt-ped-item.nr-pedcli.

            CREATE tt-variavel.
            ASSIGN tt-variavel.cod-var-oper = 'it-codigo'
                   tt-variavel.cod-val-var  = tt-ped-item.it-codigo.

            CREATE tt-variavel.
            ASSIGN tt-variavel.cod-var-oper = 'cod-ean'.

            FIND FIRST item-mat NO-LOCK
                WHERE  item-mat.it-codigo = ped-item.it-codigo NO-ERROR.
            IF  AVAIL item-mat THEN
                ASSIGN tt-variavel.cod-val-var  = item-mat.cod-ean.

            CREATE tt-variavel.
            ASSIGN tt-variavel.cod-var-oper = 'item-do-cli'.

            FIND FIRST item-cli NO-LOCK
                WHERE  item-cli.it-codigo  = ped-item.it-codigo 
                AND    item-cli.nome-abrev = ped-item.nome-abrev NO-ERROR.
            IF  AVAIL item-cli THEN
                ASSIGN tt-variavel.cod-val-var  = item-cli.item-do-cli.
        END. /* IF  AVAIL config-tip-operac THEN DO: */
        
        IF  c-nom-prog-dpc-mg97 <> "" 
        OR  c-nom-prog-appc-mg97 <> "" 
        OR  c-nom-prog-upc-mg97 <> "" THEN DO:
        
            FOR EACH tt-epc WHERE tt-epc.cod-event = "EngineRegras_ReceiverSalesOrder": DELETE tt-epc. END.
        
            CREATE tt-epc.
            ASSIGN tt-epc.cod-event     = "EngineRegras_ReceiverSalesOrder":U
                   tt-epc.cod-parameter = "tt-variavel":U
                   tt-epc.val-parameter = STRING(TEMP-TABLE tt-variavel:HANDLE).
        
            {include/i-epc201.i "EngineRegras_ReceiverSalesOrder"}
        
            FOR FIRST para-ped NO-LOCK. END.
        
            RUN cdp/cdapi034.p (INPUT i-ep-codigo-usuario,
                                INPUT tt-ped-venda.cod-estabel,
                                INPUT 'axrvd003',
                                INPUT TABLE tt-variavel,
                                OUTPUT i-cod-regra-utilizada,
                                OUTPUT TABLE tt-retorno,
                                OUTPUT TABLE RowErrors).
        
            IF  CAN-FIND(FIRST tt-retorno
                         WHERE tt-retorno.campo-retorno = 'axrvd003'
                         AND   tt-retorno.valor-retorno = 'no') THEN RETURN 'NOK'.
        
            for each tt-retorno:
                CASE tt-retorno.campo-retorno:
                    WHEN "nome-abrev"  THEN ASSIGN tt-ped-item.nome-abrev = tt-retorno.valor-retorno.
                    WHEN "nr-pedcli"   THEN ASSIGN tt-ped-item.nr-pedcli = tt-retorno.valor-retorno.
                    WHEN "it-codigo"   THEN ASSIGN tt-ped-item.it-codigo = tt-retorno.valor-retorno.
                    WHEN "cod-ean"     THEN ASSIGN c-eanCode = tt-retorno.valor-retorno.
                    WHEN "item-do-cli" THEN ASSIGN c-customerItemCode = tt-retorno.valor-retorno.
                END CASE.
            end. /* for each tt-retorno: */                    

            IF  CAN-FIND(FIRST RowErrors) THEN DO:
                FOR EACH RowErrors:
                    CREATE TT_LOG_ERRO.
                    ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = RowErrors.ErrorNumber
                           TT_LOG_ERRO.TTV_DES_MSG_ERRO = RowErrors.ErrorDescription.
                END.
                RETURN 'NOK'.
            END.
        END.
    &ENDIF
    /*---------------------------------------------------------------------------------[ integraá∆o EMSxNeogrid ]---*/


    RETURN "OK":U.

END PROCEDURE.

PROCEDURE receiveMessage:

/*PARAMETERS - BEGIN*/
DEFINE INPUT PARAM hInputXML AS HANDLE NO-UNDO.
DEFINE OUTPUT PARAM hOutputXML AS HANDLE NO-UNDO.
/*PARAMETERS - END*/

/*LOCAL VARIABLES - BEGIN*/
/*LOCAL VARIABLES - END*/


/* ******************************************* */
/* *************** BODY - BEGIN ************** */
/* ******************************************* */

     /* VERIFICA SE MessageHandler.p ESTA NA MEMORIA */
     {xmlinc/xmlloadmessagehandlerrec.i &MessageHandler="hMessageHandler" &MHReturnValue="cReturnValue" &MHReturnError="hOutputXML"}

     IF  cReturnValue <> "OK":U THEN
      IF cReturnValue <> ? AND cReturnValue <> "" THEN
        RUN setError IN hMessageHandler (INPUT 0,
                                         INPUT "enviroment_error":U,
                                         INPUT cReturnValue).

     /* INTERPRETA, ARMAZENA E VALIDA A MENSAGEM QUE RECEBE */
     RUN parseMessage IN hMessageHandler (
          INPUT  hInputXml, INPUT "{&XmlTranName}":U, 
          INPUT "{&XmlMaxTranVersion}":U, 
          INPUT "{&XmlMinTranVersion}":U, 
          INPUT "{&XmlListOfEvents}":U,
          OUTPUT lSuccessProcess,
          OUTPUT cTranAction, 
          OUTPUT cTranEvent,
          OUTPUT cTranVersion,
          OUTPUT hOutputXML ).

     /* SE N√O PROCESSOU CORRETAMENTE RETORNA ERRO */
     IF NOT lSuccessProcess OR RETURN-VALUE <> "OK" THEN
        IF cReturnValue <> ? AND cReturnValue <> " " THEN
          RUN setError IN hMessageHandler (INPUT 0,
                                           INPUT "enviroment_error":U,
                                           INPUT cReturnValue).

     /* VERIFICA SE APIXML ESTA NA MEMORIA */
     {xmlinc/xmlloadgenxmlrec.i &GenXml="hGenXml" &GXReturnValue="cReturnValue" &GXReturnError="hOutputXML"}

      /* VERIFICA SE O ut-genxml FOI INICIADO CORRETAMENTE */
      IF cReturnValue <> "OK":U THEN 
        IF cReturnValue <> ? AND cReturnValue <> "" THEN DO:

          /* ELIMINA A MENSAGEM OBTIDA NO MêTODO getBusinessContent */
          DELETE OBJECT hBusinessContent NO-ERROR.

          RUN setError IN hMessageHandler (INPUT 0,
                                           INPUT "enviroment_error":U,
                                           INPUT cReturnValue).
        END.


        
{adapters/xml/vd2/axrvd003versioncontrol.i}



/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.

/****** INTERNAL PROCEDURES - END*/




