            RUN addNode IN hGenXml (getStack(), "ProductLine":U, tt-gr-cli.linha-produt, OUTPUT iId).
            RUN addNode IN hGenXml (getStack(), "Category":U, tt-gr-cli.categoria, OUTPUT iId).
            RUN addNode IN hGenXml (getStack(), "PriceTable":U, "", OUTPUT iId).
            addStack(iId).

                RUN addNode IN hGenXml (getStack(), "PriceTableCode":U, tt-gr-cli.nr-tabpre, OUTPUT iId).
                if  avail tb-preco then
                    RUN addNode IN hGenXml (getStack(), "PriceTableDescription":U, tb-preco.descricao, OUTPUT iId).

            delStack().

            if  tt-gr-cli.ind-fat-par <> ? then
                RUN addNodeLog IN hGenXml (getStack(), "PartialInvoicing":U, tt-gr-cli.ind-fat-par, OUTPUT iId).

            if  tt-gr-cli.per-minfat <> ? then
