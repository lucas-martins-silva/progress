            RUN addNode IN hGenXml (getStack(), "ExpenseRevenue":U, "", OUTPUT iId).
            addStack(iId).

                RUN addNodeDec IN hGenXml (getStack(), "ExpenseRevenueCode":U, tt-gr-cli.tp-rec-desp, OUTPUT iId).
                if  avail tipo-rec-desp then
                    RUN addNode IN hGenXml (getStack(), "ExpenseRevenueDescription":U, tipo-rec-desp.descricao, OUTPUT iId).

                if  avail tipo-rec-desp then
                    RUN addNodeDec IN hGenXml (getStack(), "ExpenseRevenueType":U, tipo-rec-desp.tipo, OUTPUT iId).

            delStack().

            if  tt-gr-cli.bonificacao <> ? then
                RUN addNodeDec IN hGenXml (getStack(), "CustomerStdDiscount":U, tt-gr-cli.bonificacao, OUTPUT iId).

            RUN addNode IN hGenXml (getStack(), "CreditInformation":U, "", OUTPUT iId).
            addStack(iId).

                 if  tt-gr-cli.ind-aval[1] <> ? then
                     RUN addNodeDec IN hGenXml (getStack(), "CreditEvaluation":U, tt-gr-cli.ind-aval[1], OUTPUT iId).

