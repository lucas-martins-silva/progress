                     if  tt-gr-cli.log-consid-ap-lim-cr <> ? then
                         RUN addNodeLog IN hGenXml (getStack(), "IsCreditLimitIncluded":U, tt-gr-cli.log-consid-ap-lim-cr, OUTPUT iId).  

                 &ELSE

                     if  substr(tt-gr-cli.char-1,1,1) <> ? then do:

                         if  substr(tt-gr-cli.char-1,1,1) = "" then
                             RUN addNodeLog IN hGenXml (getStack(), "IsCreditLimitIncluded":U, yes, OUTPUT iId).  
                         else 
                             if  substr(tt-gr-cli.char-1,1,1) = "2" then
                                 RUN addNodeLog IN hGenXml (getStack(), "IsCreditLimitIncluded":U, no, OUTPUT iId).  
                     end.

                 &ENDIF

            delStack().

        delStack().

    delStack().

    /* OBTEM O XML NUMA HANDLE */
    RUN generateXML IN hGenXml (OUTPUT hBusinessContent).

    /* DEFINE O CONTEÚDO DO ELEMENTO BusinessContent */
    RUN setBusinessContent IN hMessageHandler (INPUT hBusinessContent).

    /* LIBERA MEMÓRIA ALOCADA PARA O OBJETO */
    DELETE OBJECT hBusinessContent NO-ERROR.

    /*CONTRÓI A MENSAGEM XML E ENVIA PARA O ControlBroker */
    RUN sendMessage IN hMessageHandler (INPUT "vd2/CustomerGroup_204_000.xsd":U). 

    /* VERIFICA SE OCORREU ALGUM ERRO */
    IF  RETURN-VALUE <> "OK" THEN DO:
        CREATE TT_LOG_ERRO.
        /* Inicio -- Projeto Internacional */
        DEFINE VARIABLE c-lbl-liter-4 AS CHARACTER NO-UNDO.
        ASSIGN c-lbl-liter-4 = TRIM(RETURN-VALUE).
