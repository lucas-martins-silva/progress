                RUN addNode IN hGenXml (getStack(), "RepresentativeName":U, repres.nome, OUTPUT iId).

        delStack().

        RUN addNode IN hGenXml (getStack(), "FinancialInformation":U, "", OUTPUT iId).
        addStack(iId).

            RUN addNode IN hGenXml (getStack(), "CollectorInformation":U, "", OUTPUT iId).
            addStack(iId).

                RUN addNode IN hGenXml (getStack(), "CollectorCode":U, tt-gr-cli.portador, OUTPUT iId).

                if  avail portador then
                    RUN addNode IN hGenXml (getStack(), "CollectorDescription":U, portador.nome, OUTPUT iId).

                if  tt-gr-cli.modalidade <> ? then
                    RUN addNode IN hGenXml (getStack(), "ModalityCode":U, tt-gr-cli.modalidade, OUTPUT iId).

                RUN addNode IN hGenXml (getStack(), "PortfolioInformation":U, "", OUTPUT iId).
                addStack(iId).

                    RUN addNode IN hGenXml (getStack(), "PortfolioCode":U, 0, OUTPUT iId). /*cod_cart_bcia*/

                    /*if  des_cart_bcia <> ? then*/
                        RUN addNode IN hGenXml (getStack(), "PortfolioDescription":U, "", OUTPUT iId). /*des_cart_bcia*/

                delStack().  

            delStack().

            RUN addNode IN hGenXml (getStack(), "PaymentInformation":U, "", OUTPUT iId).
            addStack(iId).

                RUN addNode IN hGenXml (getStack(), "PaymentTerms":U, tt-gr-cli.cod-cond-pag, OUTPUT iId).
                if  avail cond-pagto then
                    RUN addNode IN hGenXml (getStack(), "PaymentTermsDescription":U, cond-pagto.descricao, OUTPUT iId).

            delStack().

        delStack().

        RUN addNode IN hGenXml (getStack(), "LogisticsInformation":U, "", OUTPUT iId).
        addStack(iId).

            RUN addNode IN hGenXml (getStack(), "StandardCarrier":U, "", OUTPUT iId).
            addStack(iId).

