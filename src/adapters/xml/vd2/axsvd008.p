    /* PREENCHE O VALOR DO ELEM. Comment DE TransactionId */
    RUN setTransInfoComment IN hMessageHandler ("Comment").

    /* SETA SystemId */
    RUN setSystemId IN hMessageHandler ("{&XmlMod}":U,  "{&XmlProdVersion}":U).

    find first tt-gr-cli no-error.
    if  not avail tt-gr-cli then do:

        create TT_LOG_ERRO.
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "Registro_Grupo_Cliente_nÆo_est _dispon¡vel" *}
        assign TT_LOG_ERRO.TTV_NUM_COD_ERRO = 17006
               TT_LOG_ERRO.TTV_DES_MSG_ERRO = RETURN-VALUE.

        return "NOK":U.
    end.

    for first repres fields (nome)
            where repres.cod-rep = tt-gr-cli.cod-rep no-lock: end.

    for first portador fields (nome)
        where portador.cod-portador = tt-gr-cli.portador no-lock: end.

    for first cond-pagto fields (descricao)
        where cond-pagto.cod-cond-pag = tt-gr-cli.cod-cond-pag no-lock: end.

    for first transporte fields (nome-abrev nome)
        where transporte.cod-transp = tt-gr-cli.cod-transp no-lock: end.

    for first tb-preco fields (descricao)
        where tb-preco.nr-tabpre = tt-gr-cli.nr-tabpre no-lock: end.

