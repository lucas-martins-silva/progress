PROCEDURE pi-cria-ttPIS-NFCom:

    /*
    === ttPISNFCom ===
    CST            AS CHARACTER INITIAL ?  /*C¢digo de Situa‡Æo Tribut ria do PIS*/
    pPIS           AS DECIMAL   INITIAL ?  /*Al¡quota do PIS (em percentual)*/
    vBC            AS DECIMAL   INITIAL ?  /*Valor da BC do PIS*/
    vPIS           AS DECIMAL   INITIAL ?  /*Valor do PIS*/    
    */

    ASSIGN c-sit-trib-pis = &if '{&bf_dis_versao_ems}' >= '2.07':U 
                            &then string(it-nota-fisc.cod-sit-tributar-pis)
                            &else substring(it-nota-fisc.char-1,77,2) 
                            &endif.
    
    IF  c-sit-trib-pis = "49":U
    AND d-aliq-pis     = 0
    AND d-valor-pis    = 0 THEN
        ASSIGN d-base-pis = 0.

    CREATE ttPISNFCom.
    ASSIGN ttPISNFCom.CST  = c-sit-trib-pis
           ttPISNFCom.pPIS = d-aliq-pis 
           ttPISNFCom.vBC  = d-base-pis
           ttPISNFCom.vPIS = d-valor-pis.

    /* Chave EMS */
    ASSIGN ttPISNFCom.CodEstabelNF = nota-fiscal.cod-estabel
           ttPISNFCom.SerieNF      = nota-fiscal.serie
           ttPISNFCom.NrNotaFisNF  = nota-fiscal.nr-nota-fis
           ttPISNFCom.ItCodigoNF   = it-nota-fisc.it-codigo 
           ttPISNFCom.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.
                
    ASSIGN d-total-PIS = d-total-PIS + ttPISNFCom.vPIS.                    

END PROCEDURE.

