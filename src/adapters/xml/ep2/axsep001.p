PROCEDURE PIRedispatchCarrier:

    &IF "{&BF_DIS_VERSAO_EMS}" >= "2.08" &THEN
    RUN addNode IN hGenXml (getStack(), "ListOfRedispatchCarrier", "", OUTPUT iId).
    addStack(iId).
          FOR EACH ttRedispatchCarrier:
              DO i-contador = 1 TO 6:
                  IF ttRedispatchCarrier.RedispatchCarrierCode[i-contador] <> 0 THEN DO:
                      RUN addNode IN hGenXml (getStack(), "RedispatchCarrier", "", OUTPUT iId).
                      addStack(iId).
                         RUN addNode IN hGenXml (getStack(), "RedispatchSequence", (i-contador * 10), OUTPUT iId).
                         IF ttRedispatchCarrier.SiteID <> ? AND ttRedispatchCarrier.SiteID <> "" THEN
                         DO: /*Test LOGIC*/
                              RUN addNode IN hGenXml (getStack(), "SiteID", ttRedispatchCarrier.SiteID, OUTPUT iId).
                         END.
                         IF ttRedispatchCarrier.DocumentNumber <> ? AND ttRedispatchCarrier.DocumentNumber <> "" THEN
                         DO: /*Test LOGIC*/
                              RUN addNode IN hGenXml (getStack(), "DocumentNumber", ttRedispatchCarrier.DocumentNumber, OUTPUT iId).
                         END.
                         IF ttRedispatchCarrier.DocumentSeries <> ? AND ttRedispatchCarrier.DocumentSeries <> "" THEN
                         DO: /*Test LOGIC*/
                              RUN addNode IN hGenXml (getStack(), "DocumentSeries", ttRedispatchCarrier.DocumentSeries, OUTPUT iId).
                         END.
                         IF ttRedispatchCarrier.RedispatchCarrierCode[i-contador] <> ? THEN
                         DO: /*Test LOGIC*/
                              RUN addNodeDec IN hGenXml (getStack(), "RedispatchCarrierCode", ttRedispatchCarrier.RedispatchCarrierCode[i-contador], OUTPUT iId).
                         END.
                         IF ttRedispatchCarrier.RedispatchCarrierCity[i-contador] <> ? THEN
                         DO: /*Test LOGIC*/
                              RUN addNode IN hGenXml (getStack(), "RedispatchCarrierCity", ttRedispatchCarrier.RedispatchCarrierCity[i-contador], OUTPUT iId).
                         END.
                      delStack().
                  END.
              END.
          END.
    delStack().
    &ENDIF
   
END PROCEDURE.

