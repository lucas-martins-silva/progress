PROCEDURE PIDocumentBill:


   RUN addNode IN hGenXml (getStack(), "ListOfDocumentBills":U, "":U, OUTPUT iId).
   addStack(iId).

        FOR EACH ttDocumentBill :
             RUN addNode IN hGenXml (getStack(), "DocumentBill":U, "":U, OUTPUT iId).
             addStack(iId).

                  RUN addNode IN hGenXml (getStack(), "InstallmentNumber":U, ttDocumentBill.InstallmentNumber, OUTPUT iId).
                  RUN addNode IN hGenXml (getStack(), "BillNumber":U, ttDocumentBill.BillNumber, OUTPUT iId).
                  IF ttDocumentBill.DocumentClassID <> ? AND ttDocumentBill.DocumentClassID <> "" THEN
                  DO: /*Test LOGIC*/
                       RUN addNode IN hGenXml (getStack(), "DocumentClass":U, "":U, OUTPUT iId).
                       addStack(iId).

                            RUN addNode IN hGenXml (getStack(), "DocumentClassID":U, ttDocumentBill.DocumentClassID, OUTPUT iId).
                            IF ttDocumentBill.DocumentClassDescription <> ? THEN
                            DO: /*Test LOGIC*/
                                 RUN addNode IN hGenXml (getStack(), "DocumentClassDescription":U, ttDocumentBill.DocumentClassDescription, OUTPUT iId).
                            END. /*Test LOGIC*/
                       delStack().

                  END. /*Test LOGIC*/
                  IF ttDocumentBill.RevenueCode <> ?  THEN
                  DO: /*Test LOGIC*/
                       RUN addNode IN hGenXml (getStack(), "RevenueType":U, "":U, OUTPUT iId).
                       addStack(iId).

                            RUN addNodeDec IN hGenXml (getStack(), "RevenueCode":U, ttDocumentBill.RevenueCode, OUTPUT iId).
                            IF ttDocumentBill.RevenueDescription <> ? THEN
                            DO: /*Test LOGIC*/
                                 RUN addNode IN hGenXml (getStack(), "RevenueDescription":U, ttDocumentBill.RevenueDescription, OUTPUT iId).
                            END. /*Test LOGIC*/
                       delStack().

                  END. /*Test LOGIC*/
                  RUN addNodeDate IN hGenXml (getStack(), "PrintDate":U, ttDocumentBill.PrintDate, OUTPUT iId).
                  RUN addNodeDate IN hGenXml (getStack(), "DueDate":U, ttDocumentBill.DueDate, OUTPUT iId).
                  IF ttDocumentBill.DiscountValue <> ? THEN
                  DO: /*Test LOGIC*/
                       RUN addNodeDec IN hGenXml (getStack(), "DiscountValue":U, ttDocumentBill.DiscountValue, OUTPUT iId).
                  END. /*Test LOGIC*/
                  RUN addNodeDec IN hGenXml (getStack(), "InstallmentNetValue":U, ttDocumentBill.InstallmentNetValue, OUTPUT iId).
                  IF ttDocumentBill.CommissionValue <> ? THEN
                  DO: /*Test LOGIC*/
                       RUN addNodeDec IN hGenXml (getStack(), "CommissionValue":U, ttDocumentBill.CommissionValue, OUTPUT iId).
                  END. /*Test LOGIC*/

                /*** Itens da Nota Fiscal ***/
                IF CAN-FIND (FIRST ttDocumentBillItem WHERE 
                                   ttDocumentBillItem.SiteID            = ttDocumentBill.SiteID
                               AND ttDocumentBillItem.DocumentSeries    = ttDocumentBill.DocumentSeries
                               AND ttDocumentBillItem.BillNumber        = ttDocumentBill.BillNumber
                               AND ttDocumentBillItem.InstallmentNumber = ttDocumentBill.InstallmentNumber) THEN DO:
                    RUN addNode IN hGenXml (getStack(), "ListOfBillItems":U, "":U, OUTPUT iId).
                    addStack(iId).
                    FOR EACH ttDocumentBillItem WHERE ttDocumentBillItem.SiteID            = ttDocumentBill.SiteID
                                                  AND ttDocumentBillItem.DocumentSeries    = ttDocumentBill.DocumentSeries
                                                  AND ttDocumentBillItem.BillNumber        = ttDocumentBill.BillNumber
                                                  AND ttDocumentBillItem.InstallmentNumber = ttDocumentBill.InstallmentNumber:
                        RUN addNode IN hGenXml ( geTStack(), "BillItem":U, "":U, OUTPUT iId).
                        addStack(iId).

                            RUN addNodeDec IN hGenXml ( geTStack(), "Sequence":U, ttDocumentBillItem.Sequence, OUTPUT iId).
                            RUN addNode IN hGenXml ( geTStack(), "ItemCode":U, ttDocumentBillItem.ItemCode, OUTPUT iId).
                            RUN addNodeDec IN hGenXml ( geTStack(), "ItemValue":U, ttDocumentBillItem.ItemValue, OUTPUT iId).

                        delStack().
                    END.
                    delStack().
                END.
                /********/

             delStack().


        END.
   delStack().


END PROCEDURE.


