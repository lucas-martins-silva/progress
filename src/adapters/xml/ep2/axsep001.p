              RUN addNodeDec IN hGenXml (getStack(), "InvoicingType":U, ttInvoiceDocument.InvoicingType, OUTPUT iId).
          END.
          IF ttInvoiceDocumentAux.OverdueAverageTerm <> ?  THEN
          DO: /*Test LOGIC*/
               RUN addNodeDec IN hGenXml (getStack(), "OverdueAverageTerm":U, ttInvoiceDocumentAux.OverdueAverageTerm, OUTPUT iId).
          END. /*Test LOGIC*/
          IF ttInvoiceDocument.CollectorID <> ?  THEN
          DO: /*Test LOGIC*/
               RUN addNode IN hGenXml (getStack(), "Collection":U, "":U, OUTPUT iId).
               addStack(iId).

                    RUN addNodeDec IN hGenXml (getStack(), "CollectorID":U, ttInvoiceDocument.CollectorID, OUTPUT iId).
                    IF ttInvoiceDocument.CollectorName <> ?  THEN
                    DO: /*Test LOGIC*/
                         RUN addNode IN hGenXml (getStack(), "CollectorName":U, ttInvoiceDocument.CollectorName, OUTPUT iId).
                    END. /*Test LOGIC*/
                    IF ttInvoiceDocument.CollectionModality >= 1 AND ttInvoiceDocument.CollectionModality <= 9 THEN
                    DO: /*Test LOGIC*/
                       RUN addNodeDec IN hGenXml (getStack(), "CollectionModality":U, ttInvoiceDocument.CollectionModality, OUTPUT iId).
                    END. /*Test LOGIC*/
               delStack().

          END. /*Test LOGIC*/
          RUN addNode IN hGenXml (getStack(), "PaymentPlan":U, "":U, OUTPUT iId).
          addStack(iId).

               RUN addNodeDec IN hGenXml (getStack(), "PaymentPlanCode":U, ttInvoiceDocumentAux.PaymentPlanCode, OUTPUT iId).
               IF ttInvoiceDocumentAux.PaymentPlanDescription <> ?  THEN
               DO: /*Test LOGIC*/
                    RUN addNode IN hGenXml (getStack(), "PaymentPlanDescription":U, ttInvoiceDocumentAux.PaymentPlanDescription, OUTPUT iId).
               END. /*Test LOGIC*/

               IF ttInvoiceDocumentAux.PaymentPlanDueCode <> ?  THEN
                       DO: /*Test LOGIC*/
                    RUN addNodeDec IN hGenXml (getStack(), "PaymentPlanDueCode":U, ttInvoiceDocumentAux.PaymentPlanDueCode, OUTPUT iId).
                       END. /*Test LOGIC*/
               
               IF CAN-FIND (FIRST ttTerm)  THEN
               DO: /*Test LOGIC*/
                    RUN addNode IN hGenXml (getStack(), "ListOfSpecialPaymentPlanTerms":U, "":U, OUTPUT iId).
                    addStack(iId).

                        /* CondiáÑes de pagamento da nota fiscal - cond-ped */
                        RUN PITerm.

                    delStack().

               END. /*Test LOGIC*/
          delStack().

          IF ttInvoiceDocument.ExportProcessNumber <> ?  THEN
          DO: /*Test LOGIC*/
               RUN addNode IN hGenXml (getStack(), "ExportProcessNumber":U, ExportProcessNumber, OUTPUT iId).
          END. /*Test LOGIC*/
          IF ttInvoiceDocument.DocumentGrossWeight <> ?  THEN
          DO: /*Test LOGIC*/
               RUN addNodeDec IN hGenXml (getStack(), "DocumentGrossWeight":U, DocumentGrossWeight, OUTPUT iId).
          END. /*Test LOGIC*/
          IF ttInvoiceDocument.DocumentNetWeight <> ?  THEN
          DO: /*Test LOGIC*/
               RUN addNodeDec IN hGenXml (getStack(), "DocumentNetWeight":U, DocumentNetWeight, OUTPUT iId).
          END. /*Test LOGIC*/

          IF  ttInvoiceDocument.InsuranceValue          <> ? OR 
              ttInvoiceDocumentAux.TaxPercentage           <> ? OR
              ttInvoiceDocumentAux.TaxCalculationBasis     <> ? OR 
              ttInvoiceDocumentAux.TaxReductionPercentage  <> ? OR
              ttInvoiceDocumentAux.TaxValue                <> ? OR
              ttInvoiceDocument.FreightResponsible      <> ? OR 
              ttInvoiceDocument.MessageID_00            <> ? THEN DO:

              RUN addNode IN hGenXml (getStack(), "AutonomousTransportDocument":U, "":U, OUTPUT iId).
              addStack(iId).

               IF ttInvoiceDocument.InsuranceValue <> ?  THEN
               DO: /*Test LOGIC*/
                    RUN addNodeDec IN hGenXml (getStack(), "InsuranceValue":U, InsuranceValue, OUTPUT iId).
               END. /*Test LOGIC*/
               IF ttInvoiceDocumentAux.TaxPercentage <> ?  THEN
               DO: /*Test LOGIC*/
                    RUN addNodeDec IN hGenXml (getStack(), "TaxPercentage":U, TaxPercentage, OUTPUT iId).
               END. /*Test LOGIC*/
               IF ttInvoiceDocumentAux.TaxCalculationBasis <> ?  THEN
               DO: /*Test LOGIC*/
                    RUN addNodeDec IN hGenXml (getStack(), "TaxCalculationBasis":U, TaxCalculationBasis, OUTPUT iId).
               END. /*Test LOGIC*/
               IF ttInvoiceDocumentAux.TaxReductionPercentage <> ?  THEN
               DO: /*Test LOGIC*/
                    RUN addNodeDec IN hGenXml (getStack(), "TaxReductionPercentage":U, TaxReductionPercentage, OUTPUT iId).
               END. /*Test LOGIC*/
               IF ttInvoiceDocumentAux.TaxValue <> ?  THEN
               DO: /*Test LOGIC*/
                    RUN addNodeDec IN hGenXml (getStack(), "TaxValue":U, TaxValue, OUTPUT iId).
               END. /*Test LOGIC*/
               IF ttInvoiceDocument.MessageDescription_00 <> ?  AND ttInvoiceDocument.MessageDescription_00 <> "" THEN
               DO: /*Test LOGIC*/
                    RUN addNode IN hGenXml (getStack(), "Message":U, "":U, OUTPUT iId).
                    addStack(iId).

                         IF ttInvoiceDocument.MessageID_00 <> ?  THEN
                         DO: /*Test LOGIC*/
                              RUN addNodeDec IN hGenXml (getStack(), "MessageID":U, MessageID_00, OUTPUT iId).
                         END. /*Test LOGIC*/
                         RUN addNode IN hGenXml (getStack(), "MessageDescription":U, MessageDescription_00, OUTPUT iId).
                    delStack().

               END. /*Test LOGIC*/
               IF ttInvoiceDocument.FreightResponsible >= 1 AND ttInvoiceDocument.FreightResponsible <= 3  THEN
               DO: /*Test LOGIC*/
                    RUN addNodeDec IN hGenXml (getStack(), "FreightResponsible":U, FreightResponsible, OUTPUT iId).
               END. /*Test LOGIC*/

              delStack().
          END.

          /* Vendor */
          IF param-global.modulo-05 AND string(ttInvoiceDocument.BaseDate) <> "" AND ttInvoiceDocument.BaseDate <> ? THEN DO: /*Test LOGIC*/
               RUN addNode IN hGenXml (getStack(), "VendorInformation":U, "":U, OUTPUT iId).
               addStack(iId).

                    RUN addNodeDec IN hGenXml (getStack(), "CustomerPaymentPlanCode":U, ttInvoiceDocument.CustomerPaymentPlanCode, OUTPUT iId).
                    RUN addNodeDec IN hGenXml (getStack(), "GraceDaysForVendorContractClosing":U, ttInvoiceDocument.GraceDaysForVendorContractClo_00, OUTPUT iId).
                    RUN addNodeDate IN hGenXml (getStack(), "BaseDate":U, ttInvoiceDocument.BaseDate, OUTPUT iId).
                    RUN addNodeDec IN hGenXml (getStack(), "FinancialRate":U, ttInvoiceDocument.FinancialRate, OUTPUT iId).
               delStack().

          END. /*Test LOGIC*/

          FIND FIRST ttRepresentative NO-ERROR.
          IF AVAIL ttRepresentative THEN DO: /*Test LOGIC*/

              /* Representantes da nota fiscal - fat-repre */
              RUN PIRepresentative.

          END. /*Test LOGIC*/

          IF CAN-FIND(FIRST ttDocumentItem) THEN
          DO: /*Test LOGIC*/

              /* Itens da nota fiscal - it-nota-fisc */
              RUN PIDocumentItem (INPUT cTranAction, INPUT ttInvoiceDocument.SiteID).

          END. /*Test LOGIC*/

          IF CAN-FIND(FIRST ttDocumentBill) THEN
          DO: /*Test LOGIC*/

              /* Duplicatas da nota fiscal - fat-duplic */
              RUN PIDocumentBill.

          END. /*Test LOGIC*/

          IF CAN-FIND(FIRST ttPackaging) THEN
          DO: /*Test LOGIC*/

              /*  Embalagens da nota fiscal - nota-embal */
              RUN PIPackaging.

          END. /*Test LOGIC*/

          IF CAN-FIND(FIRST ttPackingSlip) THEN
          DO: /*Test LOGIC*/

              /*  Remitos da nota fiscal - remito */
              RUN PIPackingSlip.

          END. /*Test LOGIC*/

          IF CAN-FIND(FIRST ttDevolutionDocument) THEN
          DO: /*Test LOGIC*/

              /* DevoluáÑes da nota fiscal - devol-cli */
              RUN PIDevolutionDocument.

          END. /*Test LOGIC*/

          RUN addNode IN hGenXml (getStack(), "DocumentValuesAndTaxes":U, "":U, OUTPUT iId).
          addStack(iId).

               IF ttInvoiceDocument.CurrencyID <> ? THEN
               DO: /*Test LOGIC*/
                    RUN addNode IN hGenXml (getStack(), "Currency":U, "":U, OUTPUT iId).
                    addStack(iId).

                         RUN addNodeDec IN hGenXml (getStack(), "CurrencyID":U, ttInvoiceDocument.CurrencyID, OUTPUT iId).
                         IF ttInvoiceDocument.CurrencyDescription <> ? THEN
                         DO: /*Test LOGIC*/
                              RUN addNode IN hGenXml (getStack(), "CurrencyDescription":U, ttInvoiceDocument.CurrencyDescription, OUTPUT iId).
                         END. /*Test LOGIC*/
                         IF ttInvoiceDocument.CurrencySign <> ? THEN
                         DO: /*Test LOGIC*/
                              RUN addNode IN hGenXml (getStack(), "CurrencySign":U, ttInvoiceDocument.CurrencySign, OUTPUT iId).
                         END. /*Test LOGIC*/
                    delStack().

               END. /*Test LOGIC*/
               IF ttInvoiceDocumentAux.PriceTableNumber <> ? THEN
               DO: /*Test LOGIC*/
                    RUN addNode IN hGenXml (getStack(), "PriceTable":U, "":U, OUTPUT iId).
                    addStack(iId).

                         RUN addNode IN hGenXml (getStack(), "PriceTableNumber":U, ttInvoiceDocumentAux.PriceTableNumber, OUTPUT iId).
                         IF ttInvoiceDocumentAux.PriceTableDescription <> ? THEN
                         DO: /*Test LOGIC*/
                              RUN addNode IN hGenXml (getStack(), "PriceTableDescription":U, ttInvoiceDocumentAux.PriceTableDescription, OUTPUT iId).
                         END. /*Test LOGIC*/
                    delStack().

               END. /*Test LOGIC*/
               IF ttInvoiceDocument.FinancialTableNumber <> ? THEN
               DO: /*Test LOGIC*/
                    RUN addNode IN hGenXml (getStack(), "FinancialTable":U, "":U, OUTPUT iId).
                    addStack(iId).

                         RUN addNodeDec IN hGenXml (getStack(), "FinancialTableNumber":U, ttInvoiceDocument.FinancialTableNumber, OUTPUT iId).
                         RUN addNodeDec IN hGenXml (getStack(), "FinancialIndexNumber":U, ttInvoiceDocument.FinancialIndexNumber, OUTPUT iId).
                    delStack().

               END. /*Test LOGIC*/
               IF ttInvoiceDocumentAux.PriceType  >=1 AND  ttInvoiceDocumentAux.PriceType <= 3 THEN
               DO: /*Test LOGIC*/
                    RUN addNodeDec IN hGenXml (getStack(), "PriceType":U, ttInvoiceDocumentAux.PriceType, OUTPUT iId).
               END. /*Test LOGIC*/
               RUN addNode IN hGenXml (getStack(), "DiscountsAndBonifications":U, "":U, OUTPUT iId).
               addStack(iId).

                    IF ttInvoiceDocument.EnteredDiscounts <> ? THEN
                    DO: /*Test LOGIC*/
                         RUN addNode IN hGenXml (getStack(), "EnteredDiscounts":U, ttInvoiceDocument.EnteredDiscounts, OUTPUT iId).
                    END. /*Test LOGIC*/
                    IF ttInvoiceDocument.CustomerDiscountPercentage <> ? THEN
                    DO: /*Test LOGIC*/
                         RUN addNodeDec IN hGenXml (getStack(), "CustomerDiscountPercentage":U, ttInvoiceDocument.CustomerDiscountPercentage, OUTPUT iId).
                    END. /*Test LOGIC*/
                    IF ttInvoiceDocumentAux.PriceTableDiscountPercentage <> ? THEN
                    DO: /*Test LOGIC*/
                         RUN addNodeDec IN hGenXml (getStack(), "PriceTableDiscountPercentage":U, ttInvoiceDocumentAux.PriceTableDiscountPercentage, OUTPUT iId).
                    END. /*Test LOGIC*/
                    IF ttInvoiceDocument.DiscountAmount <> ? THEN
                    DO: /*Test LOGIC*/
                         RUN addNodeDec IN hGenXml (getStack(), "DiscountAmount":U, ttInvoiceDocument.DiscountAmount, OUTPUT iId).
                    END. /*Test LOGIC*/
                    IF ttInvoiceDocumentAux.TotalDiscountAmount <> ? THEN
                    DO: /*Test LOGIC*/
                         RUN addNodeDec IN hGenXml (getStack(), "TotalDiscountAmount":U, ttInvoiceDocumentAux.TotalDiscountAmount, OUTPUT iId).
                    END. /*Test LOGIC*/
                    IF ttInvoiceDocumentAux.TotalPercentageOfDocumentDisc_00 <> ? THEN
                    DO: /*Test LOGIC*/
                         RUN addNodeDec IN hGenXml (getStack(), "TotalPercentageOfDocumentDiscounts":U, ttInvoiceDocumentAux.TotalPercentageOfDocumentDisc_00, OUTPUT iId).
                    END. /*Test LOGIC*/
                    IF ttInvoiceDocument.DocumentDiscountPercentage <> ? THEN
                    DO: /*Test LOGIC*/
                         RUN addNodeDec IN hGenXml (getStack(), "DocumentDiscountPercentage":U, ttInvoiceDocument.DocumentDiscountPercentage, OUTPUT iId).
                    END. /*Test LOGIC*/
                    IF ttInvoiceDocument.DiscountPerValuePercentage <> ? THEN
                    DO: /*Test LOGIC*/
                         RUN addNodeDec IN hGenXml (getStack(), "DiscountPerValuePercentage":U, ttInvoiceDocument.DiscountPerValuePercentage, OUTPUT iId).
                    END. /*Test LOGIC*/
               delStack().

               IF ttInvoiceDocumentAux.PackagingValue <> ? THEN
               DO: /*Test LOGIC*/
                    RUN addNode IN hGenXml (getStack(), "Packaging":U, "":U, OUTPUT iId).
                    addStack(iId).

                         RUN addNodeDec IN hGenXml (getStack(), "PackagingValue":U, ttInvoiceDocumentAux.PackagingValue, OUTPUT iId).
                         RUN addNodeDec IN hGenXml (getStack(), "PackagingTaxPercentage":U, ttInvoiceDocumentAux.PackagingTaxPercentage, OUTPUT iId).
                         RUN addNodeDec IN hGenXml (getStack(), "PackagingTaxValue":U, ttInvoiceDocumentAux.PackagingTaxValue, OUTPUT iId).
                    delStack().

               END. /*Test LOGIC*/
               IF ttInvoiceDocument.FreightValue <> ? THEN
               DO: /*Test LOGIC*/
                    RUN addNode IN hGenXml (getStack(), "Freight":U, "":U, OUTPUT iId).
                    addStack(iId).

                         RUN addNodeDec IN hGenXml (getStack(), "FreightValue":U, ttInvoiceDocument.FreightValue, OUTPUT iId).
                         RUN addNodeDec IN hGenXml (getStack(), "FreightTaxPercentage":U, ttInvoiceDocument.FreightTaxPercentage, OUTPUT iId).
                         RUN addNodeDec IN hGenXml (getStack(), "FreightTaxValue":U, ttInvoiceDocument.FreightTaxValue, OUTPUT iId).
                    delStack().

               END. /*Test LOGIC*/
               IF ttInvoiceDocument.InsuranceValue_00 <> ? THEN
               DO: /*Test LOGIC*/
                    RUN addNode IN hGenXml (getStack(), "Insurance":U, "":U, OUTPUT iId).
                    addStack(iId).

                         RUN addNodeDec IN hGenXml (getStack(), "InsuranceValue":U, ttInvoiceDocument.InsuranceValue_00, OUTPUT iId).
                         RUN addNodeDec IN hGenXml (getStack(), "InsuranceTaxPercentage":U, ttInvoiceDocument.InsuranceTaxPercentage, OUTPUT iId).
                         RUN addNodeDec IN hGenXml (getStack(), "InsuranceTaxValue":U, ttInvoiceDocument.InsuranceTaxValue, OUTPUT iId).
                    delStack().

               END. /*Test LOGIC*/
               IF ttInvoiceDocument.CommissionValue <> ? THEN
               DO: /*Test LOGIC*/
                    RUN addNodeDec IN hGenXml (getStack(), "CommissionValue":U, ttInvoiceDocument.CommissionValue, OUTPUT iId).
               END. /*Test LOGIC*/
               IF ttInvoiceDocument.ExportTax <> ? THEN
               DO: /*Test LOGIC*/
                    RUN addNodeDec IN hGenXml (getStack(), "ExportTax":U, ttInvoiceDocument.ExportTax, OUTPUT iId).
               END. /*Test LOGIC*/

               IF CAN-FIND(FIRST ttDocumentTax) THEN
               DO: /*Test LOGIC*/

                   RUN addNode IN hGenXml (getStack(), "ListOfTaxes":U, "":U, OUTPUT iId).
                   addStack(iId).

                         FOR EACH ttDocumentTax:
                              RUN addNode IN hGenXml (getStack(), "DocumentTax":U, "":U, OUTPUT iId).
                              addStack(iId).

                                   RUN addNodeDec IN hGenXml (getStack(), "TaxCode":U, ttDocumentTax.TaxCode, OUTPUT iId).
                                   RUN addNode IN hGenXml (getStack(), "TaxDescription":U, ttDocumentTax.TaxDescription, OUTPUT iId).

                                   IF ttDocumentTax.TaxPercentage <> ? THEN
                                   DO: /*Test LOGIC*/
                                        RUN addNodeDec IN hGenXml (getStack(), "TaxPercentage":U, ttDocumentTax.TaxPercentage, OUTPUT iId).
                                   END. /*Test LOGIC*/
                                   IF ttDocumentTax.TaxCalculationBasis <> ? THEN
                                   DO: /*Test LOGIC*/
                                        RUN addNodeDec IN hGenXml (getStack(), "TaxCalculationBasis":U, ttDocumentTax.TaxCalculationBasis, OUTPUT iId).
                                   END. /*Test LOGIC*/
                                   IF ttDocumentTax.TributarySubstitutionBasis <> ? THEN
                                   DO: /*Test LOGIC*/
                                        RUN addNodeDec IN hGenXml (getStack(), "TributarySubstitutionBasis":U, ttDocumentTax.TributarySubstitutionBasis, OUTPUT iId).
                                   END. /*Test LOGIC*/
                                   IF ttDocumentTax.TaxDiscountPercentage <> ? THEN
                                   DO: /*Test LOGIC*/
                                        RUN addNodeDec IN hGenXml (getStack(), "TaxDiscountPercentage":U, ttDocumentTax.TaxDiscountPercentage, OUTPUT iId).
                                   END. /*Test LOGIC*/
                                   IF ttDocumentTax.TaxValue <> ? THEN
                                   DO: /*Test LOGIC*/
                                        RUN addNodeDec IN hGenXml (getStack(), "TaxValue":U, ttDocumentTax.TaxValue, OUTPUT iId).
                                   END. /*Test LOGIC*/
                                   IF ttDocumentTax.TaxRetentionValue <> ? THEN
                                   DO: /*Test LOGIC*/
                                        RUN addNodeDec IN hGenXml (getStack(), "TaxRetentionValue":U, ttDocumentTax.TaxRetentionValue, OUTPUT iId).
                                   END. /*Test LOGIC*/
                                   
                                   IF ttDocumentTax.TributarySubstitutionValue <> ? THEN
                                   DO: /*Test LOGIC*/
                                        RUN addNodeDec IN hGenXml (getStack(), "TributarySubstitutionValue":U, ttDocumentTax.TributarySubstitutionValue, OUTPUT iId).
                                   END. /*Test LOGIC*/

                              delStack().

                         END.
                   delStack().
               END.

               IF ttInvoiceDocument.AccumulatedBillsValue <> ? THEN
               DO: /*Test LOGIC*/
                    RUN addNodeDec IN hGenXml (getStack(), "AccumulatedBillsValue":U, ttInvoiceDocument.AccumulatedBillsValue, OUTPUT iId).
               END. /*Test LOGIC*/
               IF ttInvoiceDocument.InvoiceValue <> ? THEN
               DO: /*Test LOGIC*/
                    RUN addNodeDec IN hGenXml (getStack(), "InvoiceValue":U, ttInvoiceDocument.InvoiceValue, OUTPUT iId).
               END. /*Test LOGIC*/
               IF ttInvoiceDocument.InvoiceOriginalValue <> ? THEN 
               DO:  /*Test LOGIC*/
                    RUN addNodeDec IN hGenXml (getStack(), "InvoiceOriginalValue":U, ttInvoiceDocument.InvoiceOriginalValue, OUTPUT iId).
               END. /*Test LOGIC*/
               IF ttInvoiceDocument.GoodsValue <> ? THEN
               DO: /*Test LOGIC*/
                    RUN addNodeDec IN hGenXml (getStack(), "GoodsValue":U, ttInvoiceDocument.GoodsValue, OUTPUT iId).
               END. /*Test LOGIC*/
               IF ttInvoiceDocument.InvoicedGoodsValue <> ? THEN
               DO: /*Test LOGIC*/
                    RUN addNodeDec IN hGenXml (getStack(), "InvoicedGoodsValue":U, ttInvoiceDocument.InvoicedGoodsValue, OUTPUT iId).
               END. /*Test LOGIC*/
               IF ttInvoiceDocument.InvoicedItensValue <> ? THEN
               DO: /*Test LOGIC*/
                    RUN addNodeDec IN hGenXml (getStack(), "InvoicedItensValue":U, ttInvoiceDocument.InvoicedItensValue, OUTPUT iId).
               END. /*Test LOGIC*/

               RUN addNodeDec IN hGenXml (getStack(), "DocumentTotalPrice":U, ttInvoiceDocument.DocumentTotalPrice, OUTPUT iId).
           delStack().

               RUN addNode IN hGenXml (getStack(), "InvoiceEletronicDocument":U, "":U, OUTPUT iId).
               addStack(iId).
    
                   IF ttInvoiceDocumentAux.AcessKeyEletronicInvoice <> ?  THEN
                   DO: /*Test LOGIC*/
                        RUN addNode IN hGenXml (getStack(), "AcessKeyEletronicInvoice":U, ttInvoiceDocumentAux.AcessKeyEletronicInvoice, OUTPUT iId).
                   END. /*Test LOGIC*/
    
                   IF ttInvoiceDocumentAux.PatternInvoiceId <> ?  THEN
                   DO: /*Test LOGIC*/
                        RUN addNode IN hGenXml (getStack(), "PatternInvoiceId":U, ttInvoiceDocumentAux.PatternInvoiceId, OUTPUT iId).
                   END. /*Test LOGIC*/
    
                   IF ttInvoiceDocumentAux.KindPrinted <> ?  THEN
                   DO: /*Test LOGIC*/
                        RUN addNode IN hGenXml (getStack(), "KindPrinted":U, ttInvoiceDocumentAux.KindPrinted, OUTPUT iId).
                   END. /*Test LOGIC*/
    
                   IF ttInvoiceDocumentAux.PackageClassDescription <> ?  THEN
                   DO: /*Test LOGIC*/
                        RUN addNode IN hGenXml (getStack(), "PackageClassDescription":U, ttInvoiceDocumentAux.PackageClassDescription, OUTPUT iId).
                   END. /*Test LOGIC*/
                   IF ttInvoiceDocumentAux.EnvironmentID <> ? THEN 
                   DO:  /*Test LOGIC*/
                        RUN addNodeDec IN hGenXml (getStack(), "EnvironmentID":U, ttInvoiceDocumentAux.EnvironmentID, OUTPUT iId).
                   END. /*Test LOGIC*/
                   IF ttInvoiceDocumentAux.PurposeIssue <> ? THEN 
                   DO:  /*Test LOGIC*/
                        RUN addNodeDec IN hGenXml (getStack(), "PurposeIssue":U, ttInvoiceDocumentAux.PurposeIssue, OUTPUT iId).
                   END. /*Test LOGIC*/
                   IF ttInvoiceDocumentAux.ProcessIssue <> ? THEN 
                   DO:  /*Test LOGIC*/
                        RUN addNodeDec IN hGenXml (getStack(), "ProcessIssue":U, ttInvoiceDocumentAux.ProcessIssue, OUTPUT iId).
                   END. /*Test LOGIC*/
                   IF ttInvoiceDocumentAux.ProcessVersion <> ? AND ttInvoiceDocumentAux.ProcessVersion <> "" THEN 
                   DO: /*Test LOGIC*/
                        RUN addNode IN hGenXml (getStack(), "ProcessVersion":U, ttInvoiceDocumentAux.ProcessVersion, OUTPUT iId).
                   END. /*Test LOGIC*/
                   
                   IF CAN-FIND (FIRST ttInvoiceDocumentAddInformation)  THEN
                   DO: /*Test LOGIC*/
        
                       RUN PIDocumentAddInformation.
        
                   END. /*Test LOGIC*/
                   
               delStack().
               
               &IF "{&BF_DIS_VERSAO_EMS}" >= "2.08" &THEN
               FIND FIRST ttRedispatchCarrier NO-ERROR.
               IF AVAIL ttRedispatchCarrier THEN /*Test LOGIC*/

                   RUN PIRedispatchCarrier.
               /*Test LOGIC*/
               &ENDIF
               
               &IF "{&BF_DIS_VERSAO_EMS}" >= "2.08" &THEN
               IF CAN-FIND (FIRST ttFreightSimulation)  THEN
               DO: /*Test LOGIC*/
                   
                   RUN PIFreightSimulation.
                   
               END. /*Test LOGIC*/
               &ENDIF
           
               &IF "{&BF_DIS_VERSAO_EMS}" >= "2.08" &THEN
               IF CAN-FIND (FIRST ttFreightInformations)  THEN
               DO: /*Test LOGIC*/

                   RUN PIFreightInformations.
                   
               END. /*Test LOGIC*/
               &ENDIF
           /* Integraá∆o SGT */
           &IF '{&bf_dis_sgt}' = 'yes':U &THEN
                if  l-funcao-SGT then do:
                    run addNode in hGenXml (getStack(), "PickingListNumber":U, ttInvoiceDocumentAux.PickingListNumber, OUTPUT iId).
                end.
           &ENDIF     
     delStack().

/* OBTEM O XML NUMA HANDLE */
RUN generateXML IN hGenXml (OUTPUT hBusinessContent). 


/* DEFINE O CONTEÈDO DO ELEMENTO BusinessContent */
RUN setBusinessContent IN hMessageHandler (INPUT hBusinessContent).

/* LIBERA MEM‡RIA ALOCADA PARA O OBJETO */
DELETE OBJECT hBusinessContent NO-ERROR.



/*CONTR‡I A MENSAGEM XML E ENVIA PARA O ControlBroker */
&IF '{&BF_DIS_VERSAO_EMS}' >= '2.08' &THEN
    RUN sendMessage IN hMessageHandler (INPUT "ep2~\InvoiceDocument_208_000.xsd":U). 
&ELSE
&IF '{&BF_DIS_VERSAO_EMS}' >= '2.062' &THEN
    RUN sendMessage IN hMessageHandler (INPUT "ep2~\InvoiceDocument_206_000.xsd":U). 
&ELSE
    RUN sendMessage IN hMessageHandler (INPUT "ep2~\InvoiceDocument_204_000.xsd":U). 
&ENDIF
&ENDIF

/* VERIFICA SE OCORREU ALGUM ERRO */
IF RETURN-VALUE <> "OK" THEN DO:
     CREATE TT_LOG_ERRO.
          ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 17006.
          /* Inicio -- Projeto Internacional */
          DEFINE VARIABLE c-lbl-liter-4 AS CHARACTER NO-UNDO.
          ASSIGN c-lbl-liter-4 = TRIM(RETURN-VALUE).
          DEFINE VARIABLE c-lbl-liter-erro-no-envio-da-mensagem-2 AS CHARACTER NO-UNDO.
          {utp/ut-liter.i "Erro_no_envio_da_Mensagem" *}
          ASSIGN c-lbl-liter-erro-no-envio-da-mensagem-2 = TRIM(RETURN-VALUE).
          ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO = c-lbl-liter-erro-no-envio-da-mensagem-2 + ": "+ c-lbl-liter-4
                 tt_log_erro.ttv_des_msg_ajuda = tt_log_erro.ttv_des_msg_erro.
     RETURN RETURN-VALUE.
END.



/* VERIFICA SE A MENSAGEM FOI PROCESSADA COM SUCESSO */
RUN getReturnStatus IN hMessageHandler (OUTPUT pSendSuccess, OUTPUT pTotalErrors).



/* SE NAO ENVIO COM SUCESSO */
IF NOT pSendSuccess THEN DO:
     REPEAT iCount = 1 TO pTotalErrors:
          CREATE TT_LOG_ERRO.
          RUN getError IN hMessageHandler (iCount, OUTPUT TT_LOG_ERRO.TTV_NUM_COD_ERRO, OUTPUT pErrorType, OUTPUT TT_LOG_ERRO.TTV_DES_MSG_ERRO).
          ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO  = 17006
                 tt_log_erro.ttv_des_msg_ajuda = tt_log_erro.ttv_des_msg_erro.
     END.
     RETURN "NOK".
END.
ELSE RETURN "OK".

/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.


PROCEDURE PIDocumentItem:

    DEFINE INPUT PARAM pTranAction AS CHAR NO-UNDO.
    DEFINE INPUT PARAM pSiteID     AS CHAR NO-UNDO.

   RUN addNode IN hGenXml (getStack(), "ListOfDocumentItens":U, "":U, OUTPUT iId).
   addStack(iId).

        FOR EACH ttDocumentItem:

             RUN addNode IN hGenXml (getStack(), "DocumentItem":U, "":U, OUTPUT iId).
             addStack(iId).

                  RUN addNodeDec IN hGenXml (getStack(), "Sequence":U, ttDocumentItem.Sequence, OUTPUT iId).
                  RUN addNode IN hGenXml (getStack(), "Item":U, "":U, OUTPUT iId).
                  addStack(iId).

                       RUN addNode IN hGenXml (getStack(), "ItemCode":U, ttDocumentItem.ItemCode, OUTPUT iId).
                       IF ttDocumentItem.ItemDescription <> ? THEN
                       DO: /*Test LOGIC*/
                            RUN addNode IN hGenXml (getStack(), "ItemDescription":U, ttDocumentItem.ItemDescription, OUTPUT iId).
                       END. /*Test LOGIC*/
                       IF ttDocumentItem.ItemReferenceCode <> ? THEN
                       DO: /*Test LOGIC*/
