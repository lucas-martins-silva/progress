PROCEDURE PITerm:


    FOR EACH ttTerm:
          RUN addNode IN hGenXml (getStack(), "Term":U, "":U, OUTPUT iId).
          addStack(iId).

               RUN addNodeDec IN hGenXml (getStack(), "TermSequence":U, ttTerm.TermSequence, OUTPUT iId).
               IF ttTerm.TermDueCode >= 1 AND ttTerm.TermDueCode <= 9 THEN
               DO: /*Test LOGIC*/
                  RUN addNodeDec IN hGenXml (getStack(), "TermDueCode":U, ttTerm.TermDueCode, OUTPUT iId).
               END. /*Test LOGIC*/
               IF ttTerm.TermDueDate <> ?  AND string(ttTerm.TermDueDate) <> "" THEN
               DO: /*Test LOGIC*/
                    RUN addNodeDate IN hGenXml (getStack(), "TermDueDate":U, ttTerm.TermDueDate, OUTPUT iId).
               END. /*Test LOGIC*/
               RUN addNodeDec IN hGenXml (getStack(), "TermDueDays":U, ttTerm.TermDueDays, OUTPUT iId).
