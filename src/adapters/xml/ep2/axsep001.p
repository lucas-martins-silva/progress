PROCEDURE PIEngineRegras:

DEFINE INPUT  PARAM pTranAction AS CHAR NO-UNDO.
/*DEFINE OUTPUT PARAM TABLE FOR tt_log_erro.*/

/*---[ integraá∆o EMSxNeogrid ]---------------------------------------------------------------------------------*/
FIND FIRST config-tip-operac NO-LOCK
    WHERE  config-tip-operac.cod-tip-operac = 'axsep001' OR 
           config-tip-operac.cod-tip-operac = 'GFE-NFS'  NO-ERROR.
IF  AVAIL  config-tip-operac THEN DO:
    EMPTY TEMP-TABLE tt-variavel.

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper = 'ctransaction'
           tt-variavel.cod-val-var  = pTranAction.

    /*---[ PAI ]------------------------------------------------------------------------------*/
    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper = 'cod-estabel'
           tt-variavel.cod-val-var  = ttInvoiceDocument.SiteID.

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper = 'serie'
           tt-variavel.cod-val-var  = ttInvoiceDocument.DocumentSeries.

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper = 'nome-ab-cli'
           tt-variavel.cod-val-var  = ttInvoiceDocument.CustomerShortName.

    create tt-variavel.
    assign tt-variavel.cod-var-oper = 'cod-emitente'
           tt-variavel.cod-val-var  = string(ttInvoiceDocument.CustomerID).

    for first nota-fiscal no-lock
        where nota-fiscal.cod-estabel = ttInvoiceDocument.SiteID
        and   nota-fiscal.serie       = ttInvoiceDocument.DocumentSeries
        and   nota-fiscal.nr-nota-fis = ttInvoiceDocument.DocumentNumber:
        create tt-variavel.
        assign tt-variavel.cod-var-oper = 'ind-sit-nota'
               tt-variavel.cod-val-var  = string(nota-fiscal.ind-sit-nota).
    end. /* for first nota-fiscal */

    create tt-variavel.
    assign tt-variavel.cod-var-oper = 'cod-cond-pag'
           tt-variavel.cod-val-var  = string(ttInvoiceDocumentAux.PaymentPlanCode).

    create tt-variavel.
    assign tt-variavel.cod-var-oper = 'cgc'
           tt-variavel.cod-val-var  = ttInvoiceDocument.CustomerTaxID.

    create tt-variavel.
    assign tt-variavel.cod-var-oper = 'nat-operacao'
           tt-variavel.cod-val-var  = ttInvoiceDocument.FiscalOperationCode.

    create tt-variavel.
    assign tt-variavel.cod-var-oper = 'ind-tip-nota'
           tt-variavel.cod-val-var  = string(ttInvoiceDocument.InvoiceDocumentType).

    create tt-variavel.
    assign tt-variavel.cod-var-oper = 'esp-docto'
           tt-variavel.cod-val-var  = string(ttInvoiceDocument.DocumentType).

    create tt-variavel.
    assign tt-variavel.cod-var-oper = 'ind-tp-frete'
           tt-variavel.cod-val-var  = string(ttInvoiceDocument.FreightType).

    create tt-variavel.
    assign tt-variavel.cod-var-oper = 'nome-transp'
           tt-variavel.cod-val-var  = string(ttInvoiceDocument.CarrierName).

    RUN cdp/cdapi034.p (INPUT i-ep-codigo-usuario,
                        INPUT ttInvoiceDocument.SiteID,
                        INPUT config-tip-operac.cod-tip-operac,
                        INPUT TABLE tt-variavel,
                        OUTPUT i-cod-regra-utilizada,
                        OUTPUT TABLE tt-retorno,
                        OUTPUT TABLE RowErrors).

    IF  CAN-FIND(FIRST tt-retorno
                 WHERE tt-retorno.campo-retorno = config-tip-operac.cod-tip-operac
                 AND   tt-retorno.valor-retorno = 'no') THEN RETURN 'NOK'.


    /*---[ FILHO it-nota-fisc ]----------------------------------------------------------------------------*/
    IF CAN-FIND (FIRST ttDocumentItem)  THEN
    DO:

     EMPTY TEMP-TABLE tt-retorno.

     FOR EACH ttDocumentItem:

        FIND FIRST tt-variavel WHERE 
                   tt-variavel.cod-var-oper = 'it-codigo' EXCLUSIVE-LOCK NO-ERROR.
        IF NOT AVAIL tt-variavel THEN DO:
           CREATE tt-variavel.
           ASSIGN tt-variavel.cod-var-oper = 'it-codigo'.
        END.
        ASSIGN tt-variavel.cod-val-var  = ttDocumentItem.ItemCode.
    
        CREATE tt-variavel.
        ASSIGN tt-variavel.cod-var-oper = 'cod-ean'
               tt-variavel.cod-val-var  = ttDocumentItem.EANCode.
        
        create tt-variavel.
        assign tt-variavel.cod-var-oper = 'nat-operacaoitem'
               tt-variavel.cod-val-var  = ttDocumentItem.FiscalOperationCode.
    
        RUN cdp/cdapi034.p (INPUT i-ep-codigo-usuario,
                            INPUT ttInvoiceDocument.SiteID, 
                            INPUT config-tip-operac.cod-tip-operac,
                            INPUT TABLE tt-variavel,
                            OUTPUT i-cod-regra-utilizada,
                            OUTPUT TABLE tt-retorno,
                            OUTPUT TABLE RowErrors).

        IF  CAN-FIND(FIRST tt-retorno
                     WHERE tt-retorno.campo-retorno = config-tip-operac.cod-tip-operac
                     AND   tt-retorno.valor-retorno = 'no') THEN RETURN 'NOK'.

        for each tt-retorno:
            IF  tt-retorno.campo-retorno = "it-codigo" THEN ASSIGN ttDocumentItem.ItemCode = tt-retorno.valor-retorno.
            IF  tt-retorno.campo-retorno = "cod-ean"   THEN ASSIGN ttDocumentItem.EANCode  = tt-retorno.valor-retorno.
            IF  tt-retorno.campo-retorno = "nat-operacaoitem" THEN ASSIGN ttDocumentItem.FiscalOperationCode  = tt-retorno.valor-retorno.
        end. /* for each tt-retorno: */

     END. /*  for each ttDocumentItem */
    END. /* do first */
    for each tt-retorno:
            IF  tt-retorno.campo-retorno = "cod-estabel"    THEN ASSIGN ttInvoiceDocument.SiteID                 = tt-retorno.valor-retorno.
            IF  tt-retorno.campo-retorno = "serie"          THEN ASSIGN ttInvoiceDocument.DocumentSeries         = tt-retorno.valor-retorno.
            IF  tt-retorno.campo-retorno = "nome-ab-cli"    THEN ASSIGN ttInvoiceDocument.CustomerShortName      = tt-retorno.valor-retorno.
            IF  tt-retorno.campo-retorno = "cod-emitente"   THEN ASSIGN ttInvoiceDocument.CustomerID             = int(tt-retorno.valor-retorno).
            IF  tt-retorno.campo-retorno = "cod-cond-pag"    THEN ASSIGN ttInvoiceDocumentAux.PaymentPlanCode    = int(tt-retorno.valor-retorno).
            IF  tt-retorno.campo-retorno = "nome-transp"    THEN ASSIGN ttInvoiceDocument.CarrierName         = tt-retorno.valor-retorno.
            IF  tt-retorno.campo-retorno = "nat-operacao"   THEN ASSIGN ttInvoiceDocument.FiscalOperationCode    = tt-retorno.valor-retorno.
            IF  tt-retorno.campo-retorno = "ind-tip-nota"   THEN ASSIGN ttInvoiceDocument.InvoiceDocumentType    = int(tt-retorno.valor-retorno). 
            IF  tt-retorno.campo-retorno = "esp-docto"      THEN ASSIGN ttInvoiceDocument.DocumentType           = int(tt-retorno.valor-retorno). 
    end. /* for each tt-retorno: */

    IF  CAN-FIND(FIRST RowErrors) THEN DO:
        FOR EACH RowErrors:
            CREATE TT_LOG_ERRO.
                 ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO  = RowErrors.ErrorNumber.
                 ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO  = RowErrors.ErrorDescription
                        TT_LOG_ERRO.TTV_DES_MSG_AJUDA = RowErrors.ErrorHelp.
        END. /* FOR EACH RowErrors: */
        RETURN 'NOK'.
    END. /* IF  CAN-FIND(FIRST RowErrors) */
END. /* IF  AVAIL  config-tip-operac */
/*---------------------------------------------------------------------------------[ integraá∆o EMSxNeogrid ]---*/

RETURN 'OK'.

END PROCEDURE.
/****** INTERNAL PROCEDURES - END*/

