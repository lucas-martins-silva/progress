PROCEDURE pi-grava-ttICMSSN201:

    /*
    === ttICMSSN201 ===
    Orig           AS CHARACTER INITIAL ?                                      /*Origem da mercadoria*/
    CSOSN          AS CHARACTER INITIAL ?                                      /*C¢digo de Situa‡Æo da Opera‡Æo - Simples Nacional*/
    modBCST        AS CHARACTER INITIAL ?                                      /*Modalidade de determina‡Æo da BC do ICMS ST*/
    pMVAST         AS DECIMAL   INITIAL ? FORMAT ">>9.99" DECIMALS 2           /*Percentual da margem de valor Adicionado do ICMS ST*/
    pRedBCST       AS DECIMAL   INITIAL ? FORMAT ">>9.99" DECIMALS 2           /*Percentual da Redu‡Æo de BC do ICMS ST vBCST Valor da BC do ICMS ST*/
    vBCST          AS DECIMAL   INITIAL ? FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2 /*Valor da BC do ICMS ST*/
    pICMSST        AS DECIMAL   INITIAL ? FORMAT ">>9.99" DECIMALS 2           /*Al¡quota do imposto do ICMS ST*/
    vICMSST        AS DECIMAL   INITIAL ?                                      /*Valor do ICMS ST*/
    pCredSN        AS DECIMAL   INITIAL ? FORMAT ">>9.99" DECIMALS 2           /*Al¡quota aplic vel de c lculo do cr‚dito (SIMPLES NACIONAL).*/
    vCredICMSSN    AS DECIMAL   INITIAL ? FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2 /*Valor cr‚dito do ICMS que pode ser aproveitado nos termos do art. 23 da LC 123 (SIMPLES NACIONAL)*/
    */

    FOR FIRST item-nf-adc NO-LOCK
        WHERE item-nf-adc.cod-estab        = it-nota-fisc.cod-estabel
        AND   item-nf-adc.cod-serie        = it-nota-fisc.serie
        AND   item-nf-adc.cod-nota-fisc    = it-nota-fisc.nr-nota-fis
        AND   item-nf-adc.cdn-emitente     = nota-fiscal.cod-emitente
        AND   item-nf-adc.cod-natur-operac = it-nota-fisc.nat-operacao
        AND   item-nf-adc.idi-tip-dado     = 1
        AND   item-nf-adc.num-seq          = 1
        AND   item-nf-adc.num-seq-item-nf  = it-nota-fisc.nr-seq-fat
        AND   item-nf-adc.cod-item         = it-nota-fisc.it-codigo:
    END.   
    
    CREATE ttICMSSN201.
    ASSIGN ttICMSSN201.orig        = STRING(i-codigo-orig)
           ttICMSSN201.CSOSN       = c-cod-csosn
           ttICMSSN201.modBCST     = (IF c-mod-base-icms-st = "2"
                                      THEN "1"
                                      ELSE IF c-mod-base-icms-st = "3"
                                           THEN "2"
                                           ELSE IF c-mod-base-icms-st = "4"
                                                THEN "3"
                                                ELSE IF c-mod-base-icms-st = "5"
                                                     THEN "4"
                                                     ELSE IF c-mod-base-icms-st = "6"
                                                          THEN "5"
                                                          ELSE "0")
           ttICMSSN201.pMVAST      = IF  AVAIL item-nf-adc AND item-nf-adc.val-livre-1 > 0 THEN item-nf-adc.val-livre-1 ELSE DEC(SUBSTR(it-nota-fisc.char-2,338,8))
           ttICMSSN201.pRedBCST    = IF  AVAIL item-nf-adc AND item-nf-adc.val-livre-2 > 0 THEN item-nf-adc.val-livre-2 ELSE DEC(SUBSTR(it-nota-fisc.char-2,346,8))
           ttICMSSN201.vBCST       = it-nota-fisc.vl-bsubs-it
           ttICMSSN201.pICMSST     = IF  AVAIL item-nf-adc THEN item-nf-adc.val-aliq-icms-st ELSE 0
           ttICMSSN201.vICMSST     = it-nota-fisc.vl-icmsub-it.

    &if "{&bf_dis_versao_ems}" >= "2.09" &then
          ASSIGN ttICMSSN201.pCredSN     = (IF it-nota-fisc.VAL-CR-ICMS-SIMPLES-NAC > 0
                                            THEN nota-fiscal.VAL-PERC-ICMS-SIMPLES-NAC
                                            ELSE 0)
                 ttICMSSN201.vCredICMSSN = it-nota-fisc.VAL-CR-ICMS-SIMPLES-NAC.
    &ELSE 
          ASSIGN ttICMSSN201.pCredSN     = (IF DEC(substring(it-nota-fisc.CHAR-1,207,20)) > 0
                                            THEN DEC(substring( nota-fiscal.CHAR-1,238,10))
                                            ELSE 0)
                 ttICMSSN201.vCredICMSSN = DEC(substring(it-nota-fisc.CHAR-1,207,20)).
    &ENDIF

    /* Chave EMS */
    ASSIGN ttICMSSN201.CodEstabelNF = nota-fiscal.cod-estabel
           ttICMSSN201.SerieNF      = nota-fiscal.serie
           ttICMSSN201.NrNotaFisNF  = nota-fiscal.nr-nota-fis
           ttICMSSN201.ItCodigoNF   = it-nota-fisc.it-codigo
           ttICMSSN201.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.

END.