PROCEDURE pi-grava-temp-tables:

    DEF VAR c-serie         LIKE nota-fiscal.serie        NO-UNDO.       
    DEF VAR c-nr-nota       LIKE nota-fiscal.nr-nota-fis  NO-UNDO.       
    DEF VAR i-cod-emitente  LIKE nota-fiscal.cod-emitente NO-UNDO.       
    DEF VAR c-nat-operacao  LIKE nota-fiscal.nat-operacao NO-UNDO.       

    DEF VAR l-iss      AS LOG NO-UNDO.

    &IF '{&bf_dis_versao_ems}' >= '2.04' 
    AND '{&bf_dis_versao_ems}' < '2.08' &THEN
        &GLOBAL-DEFINE log-icms-substto-antecip SUBSTRING(bf-natur-oper-it.char-1,147,1) = "1"
    &ENDIF
    
    &IF '{&bf_dis_versao_ems}' >= '2.08' &THEN
        &GLOBAL-DEFINE log-icms-substto-antecip bf-natur-oper-it.log-icms-substto-antecip
    &ENDIF
    
    &GLOBAL-DEFINE log-devol-icms-st-contrib-subs (TRIM(SUBSTRING(bf-natur-oper-it.char-1,163,1)) = "S" AND bf-natur-oper-it.especie-doc = "NFD")

    ASSIGN l-retira-out-desp-obs  = CAN-FIND(FIRST funcao
                                             WHERE funcao.cd-funcao = "SPP-RETIRA-OUT-DESP-OBS"
                                             AND   funcao.ativo).

    RUN pi-cria-ttNFe.
    RUN pi-cria-ttIde.
    /*RUN pi-cria-ttrefNF.*/
    RUN pi-cria-ttRefNFP. /*Produtor Rural*/
    RUN pi-cria-ttEmit.
    RUN pi-cria-ttDest.
                      
    /* Somente criar ttEntrega se endereáo de entrega for diferente do endereáo do cliente */

    IF AVAIL emitente
    AND emitente.natureza      > 1 /* Pessoa Fisica */
    AND (emitente.cgc          <> nota-fiscal.cgc          OR
         emitente.ins-estadual <> nota-fiscal.ins-estadual OR
         emitente.endereco     <> nota-fiscal.endereco     OR
         emitente.bairro       <> nota-fiscal.bairro       OR
         emitente.cidade       <> nota-fiscal.cidade       OR
         emitente.estado       <> nota-fiscal.estado       OR
         emitente.pais         <> nota-fiscal.pais         OR
         emitente.cep          <> nota-fiscal.cep          )  THEN
        RUN pi-cria-ttEntrega.

    RUN pi-cria-ttExporta.


    ASSIGN c-serie        = nota-fiscal.serie       
           c-nr-nota      = nota-fiscal.nr-nota-ant 
           i-cod-emitente = nota-fiscal.cod-emitente
           c-nat-operacao = nota-fiscal.nat-operacao.

    IF  l-nota-compl-imp THEN
        FOR FIRST nota-fisc-adc NO-LOCK
            WHERE nota-fisc-adc.cod-estab               = nota-fiscal.cod-estabel
             AND   nota-fisc-adc.cod-serie              = nota-fiscal.serie
             AND   nota-fisc-adc.cod-nota-fisc          = nota-fiscal.nr-nota-fis
             AND   nota-fisc-adc.cdn-emitente           = nota-fiscal.cod-emitente
             AND   nota-fisc-adc.cod-natur-operac       = nota-fiscal.nat-operacao
             AND   nota-fisc-adc.idi-tip-dado           = 3
             AND (   nota-fisc-adc.idi-tip-docto-referado = 2 
                  OR (    nota-fiscal.ind-tip-nota = 8 /* Entrada */
                      AND nota-fisc-adc.idi-tip-docto-referado = 1))
             AND  STRING(INT(nota-fisc-adc.cod-model-docto-referado),"99") <> "04": /*Desconsiderar notas de modelo 04, que Ç modelo para Produtor Rural*/

            FOR FIRST b-nota-fiscal NO-LOCK
                WHERE b-nota-fiscal.cod-estabel  = nota-fiscal.cod-estabel
                  AND b-nota-fiscal.serie        = nota-fisc-adc.cod-ser-docto-referado
                  AND b-nota-fiscal.nr-nota-fis  = nota-fisc-adc.cod-docto-referado
                  AND b-nota-fiscal.cod-emitente = nota-fisc-adc.cdn-emit-docto-referado:

                ASSIGN c-serie        = b-nota-fiscal.serie
                       c-nr-nota      = b-nota-fiscal.nr-nota-fis
                       i-cod-emitente = b-nota-fiscal.cod-emitente
                       c-nat-operacao = b-nota-fiscal.nat-operacao.
            END.
        END.

    RUN pi-cria-ttDI (INPUT c-serie,
                      INPUT c-nr-nota,
                      INPUT i-cod-emitente,
                      INPUT c-nat-operacao).

    FOR EACH it-nota-fisc OF nota-fiscal NO-LOCK:

        ASSIGN l-pis-cofins-st-total = NO
               l-ipi-outras-total    = NO
               l-funcao-DESCONTO-NFE = NO.

        FOR FIRST item NO-LOCK
            WHERE item.it-codigo = it-nota-fisc.it-codigo:
            
            ASSIGN l-pis-cofins-st-total = TRIM(SUBSTR(item.char-1,50,5)) = "Sim":U OR
                                           TRIM(SUBSTR(item.char-1,50,5)) = "":U. /* bodi317im1br.m36*/
        END.
        
        
        ASSIGN l-sem-iss = NO.
        /*-------------------UPC Retira tags ISSQN XML -------------------*/
        IF  c-nom-prog-dpc-mg97  <> "" OR  
            c-nom-prog-appc-mg97 <> "" OR  
            c-nom-prog-upc-mg97  <> "" THEN DO:

            FOR EACH  tt-epc
                WHERE tt-epc.cod-event     = "before-cria-imposto":U :
                DELETE tt-epc.
            END.
    
            CREATE tt-epc.
            ASSIGN tt-epc.cod-event     = "before-cria-imposto":U
                   tt-epc.cod-parameter = "rowid-itnotafisc":U
                   tt-epc.val-parameter = STRING(ROWID(it-nota-fisc)).
            
            {include/i-epc201.i "before-cria-imposto"}
            
            FOR FIRST tt-epc WHERE
                tt-epc.cod-event     = "before-cria-imposto":U AND
                tt-epc.cod-parameter = "sem-iss":U:
            
                ASSIGN l-sem-iss = IF tt-epc.val-parameter = "yes" THEN YES ELSE NO.
            END.
        END.
        /*-------------------UPC Retira tags ISSQN XML -------------------*/

        RUN pi-cria-ttDet. 
    	RUN pi-cria-ttrefNF.
	RUN pi-cria-ttAdi.
	
        /* O grupo ISSQN Ç mutuamente exclusivo com os grupos ICMS,      */
        /* IPI e II, isto Ç se ISSQN for informado os grupos ICMS, IPI e */
        /* II n∆o ser∆o informados e viceversa (v2.0).                   */
    	IF  (nota-fiscal.ind-tip-nota  = 8    /*no recebimento verificar apenas it-nota-fisc, para nao dar problema em notas de devolucao*/
        AND  it-nota-fisc.cod-servico <> 0)
        OR  (nota-fiscal.ind-tip-nota <> 8 AND it-nota-fisc.cod-servico <> 0 AND NOT l-sem-iss) THEN DO:
        
            ASSIGN l-iss = YES.

            RUN pi-cria-ISS.
        END.
        ELSE DO:

            RUN pi-informacoes-item.

            IF (ttEmit.CRT = "1":U OR ttEmit.CRT = "2":U) AND nota-fiscal.ind-tip-nota <> 8 THEN /*Gerar nota de Simples Nacional com CSOSN somente para notas de sa°da*/
                RUN pi-cria-ICMSSN. /*Simples Nacional*/
            ELSE
                RUN pi-cria-ICMS.
    
            RUN pi-cria-ttIPI.
    
            RUN pi-cria-ttII.

        END.

        RUN ftp/ftapi510.p (INPUT  ROWID(nota-fiscal),
                            INPUT  ROWID(it-nota-fisc),
                            OUTPUT d-aliq-pis,
                            OUTPUT d-base-pis,
                            OUTPUT d-valor-pis,
                            OUTPUT d-aliq-cofins,
                            OUTPUT d-base-cofins,
                            OUTPUT d-valor-cofins).

        RUN pi-cria-ttPIS.

        RUN pi-cria-ttCOFINS.

        RUN pi-cria-ttComb. /*Informaá‰es de Combust°veis*/

        /*--- TOTAIS ---*/
        ASSIGN d-total-base-icms     = d-total-base-icms    + 
                                      (IF  ({&log-icms-substto-antecip} OR   
                                            (it-nota-fisc.cd-trib-icm = 5 AND 
                                             SUBSTRING(c-niv-trib-icms,2,2) = "51":U ) /* ALTERAÄ«O PARA GERAR VALOR ZERO NA BASE QUANDO CST 51 E TRIBUTAÄ«O DIFERIDO - NOTA DO RECEBIMENTO */
                                             OR 
                                             (nota-fiscal.ind-tip-nota = 8 and 
                                              it-nota-fisc.cd-trib-icm = 3 and 
                                              SUBSTRING(c-niv-trib-icms,2,2) = "51":U
                                              )
                                      ) THEN 0
                                       ELSE (IF (it-nota-fisc.cd-trib-icm = 3 AND 
                                                 l-icms-outras-it AND 
                                                 SUBSTRING(c-niv-trib-icms,2,2) <> "51":U )  /*Outras e Considera Tributos Outras na NF-e */  /*CST = 51 (DIFERIDO) N∆o deve ser considerado nos totais da Base de C†lculo*/
                                                 THEN it-nota-fisc.vl-icmsou-it
                                                 ELSE it-nota-fisc.vl-bicms-it
                                            )
                                       )									  
               d-total-icms          = d-total-icms         + (IF  {&log-icms-substto-antecip} 
                                                               THEN 0
                                                               ELSE (IF (it-nota-fisc.cd-trib-icm = 1                                                                     /*Tributado*/
                                                                     OR (it-nota-fisc.cd-trib-icm = 3 AND l-icms-outras-it AND SUBSTRING(c-niv-trib-icms,2,2) <> "51":U)  /*Outras e Considera Tributos Outras na NF-e */  /*CST = 51 (DIFERIDO) N∆o deve ser considerado nos totais da Base de C†lculo*/
                                                                     OR  it-nota-fisc.cd-trib-icm = 4)
                                                                     THEN it-nota-fisc.vl-icms-it
                                                                     ELSE 0))
               d-total-base-iss      = d-total-base-iss     + it-nota-fisc.vl-biss-it
               d-total-iss           = d-total-iss          + (IF it-nota-fisc.cd-trib-iss = 1 /*Tributado*/
                                                               OR it-nota-fisc.cd-trib-iss = 4 /*Reduzido  */
                                                               THEN it-nota-fisc.vl-iss-it
                                                               ELSE 0)
               d-total-serv          = d-total-serv         + IF it-nota-fisc.cod-servico <> 0
                                                              THEN (IF CAN-FIND (funcao WHERE funcao.cd-funcao = "SPP-DESCONTO-NFE":U AND funcao.ativo) 
                                                                    THEN it-nota-fisc.vl-merc-liq 
                                                                    ELSE it-nota-fisc.vl-merc-ori)
                                                              ELSE 0
               d-total-base-icms-st  = d-total-base-icms-st + (IF  {&log-icms-substto-antecip} 
                                                               THEN 0
                                                               ELSE it-nota-fisc.vl-bsubs-it)
               d-total-icms-st       = d-total-icms-st      + (IF  {&log-icms-substto-antecip}
                                                               THEN 0
                                                               ELSE it-nota-fisc.vl-icmsub-it)
               d-total-pis           = d-total-pis          + (IF it-nota-fisc.cod-servico <> 0
                                                               THEN 0
                                                               ELSE d-valor-pis)
               d-total-cofins        = d-total-cofins       + (IF it-nota-fisc.cod-servico <> 0
                                                              THEN 0
                                                              ELSE d-valor-cofins)
               /*Totais PIS COFINS para Itens de Serviáo*/
               d-total-pis-serv      = d-total-pis-serv     + (IF it-nota-fisc.cod-servico <> 0
                                                               THEN d-valor-pis
                                                               ELSE 0)
               d-total-cofins-serv   = d-total-cofins-serv  + (IF it-nota-fisc.cod-servico <> 0
                                                               THEN d-valor-cofins
                                                               ELSE 0)
               d-total-outras-desp   = d-total-outras-desp  + it-nota-fisc.vl-despes-it
               d-total-ret-irf       = d-total-ret-irf      + it-nota-fisc.vl-irf-it

        &if "{&bf_dis_versao_ems}" >= "2.06" &then
               d-total-ret-pis       = d-total-ret-pis      + it-nota-fisc.val-retenc-pis
               d-total-ret-cofins    = d-total-ret-cofins   + it-nota-fisc.val-retenc-cofins
               d-total-ret-csll      = d-total-ret-csll     + it-nota-fisc.val-retenc-csll
        &else                       
               d-total-ret-pis       = d-total-ret-pis      + decimal(substring(it-nota-fisc.char-2,112,14))
               d-total-ret-cofins    = d-total-ret-cofins   + decimal(substring(it-nota-fisc.char-2,126,14))
               d-total-ret-csll      = d-total-ret-csll     + decimal(substring(it-nota-fisc.char-2,98,14))    
        &endif                      
               d-total-icms-STA      = d-total-icms-STA     + ( it-nota-fisc.vl-icmsub-it * INT({&log-icms-substto-antecip}))
               d-total-IPI-espec     = d-total-IPI-espec    + ( it-nota-fisc.vl-ipiit-e[3] * INT(it-nota-fisc.vl-bipiit-e[3] > 0 OR TRIM(SUBSTRING(bf-natur-oper-it.char-2,16,1)) = "1"))  /* valor do ipi para notas de entrega futura / consig*/
               d-total-icms-ST-espec = d-total-icms-ST-espec + (it-nota-fisc.vl-icmsubit-e[3] /* st consig */ 
                                                             +  it-nota-fisc.vl-icmsit-e[2])  /* st entfut */
               d-total-desp-n-destaq = d-total-desp-n-destaq + ( it-nota-fisc.vl-despesit-e[3] * INT(it-nota-fisc.vl-despesit-e[3] > 0) )
               d-total-icms-ST-devol = d-total-icms-ST-devol + ( it-nota-fisc.vl-icmsubit-e[2] * INT({&log-devol-icms-st-contrib-subs}) ) /*somar somente se o parametro est† marcado e especie NFD*/
        .

        /*Inclusao do valor de PISST e COFINSST no total da nota (Dafra) - campo vOutro*/
        IF  l-pis-cofins-st-total THEN 
            ASSIGN d-total-pis-st    = d-total-pis-st    + it-nota-fisc.vl-pis
                   d-total-cofins-st = d-total-cofins-st + it-nota-fisc.vl-finsocial.

        /*Tratamento para Incluir no vNF o IPI quando for N∆o Tributado - Obs.: ser† levado para o campo vIPI do ICMSTot como vOutros*/
        IF  l-ipi-outras-total THEN
            ASSIGN d-total-ipi-out-tot = d-total-ipi-out-tot + it-nota-fisc.vl-ipi-it.

        /* Calcula base IRF: conforme dibo~\bodi317im1br.m25 */
        IF it-nota-fisc.vl-irf-it > 0  THEN DO:

          ASSIGN d-total-base-ret-irf = d-total-base-ret-irf + it-nota-fisc.vl-merc-liq .
                              
          if  it-nota-fisc.cd-trib-ipi <> 3
          &if '{&bf_dis_versao_ems}':U = '2.042':U &then  
          and substr(bf-natur-oper-nf.char-1,100,1) = "S":U then       
          &else        
              &if '{&bf_dis_versao_ems}':U >= '2.062':U &then
              and bf-natur-oper-nf.log-ipi-contrib-retid THEN
              &else
              and substr(bf-natur-oper-nf.char-1,105,1) = "S":U then 
              &endif
          &endif
              assign d-total-base-ret-irf = d-total-base-ret-irf + it-nota-fisc.vl-ipi-it.

          if  it-nota-fisc.cd-trib-ipi = 3
           and substring(bf-natur-oper-nf.char-2,16,1) = "1":U
           &if '{&bf_dis_versao_ems}':U = '2.042':U &then
           and substr(bf-natur-oper-nf.char-1,101,1) = "S":U then 
           &else
                &if '{&bf_dis_versao_ems}':U >= '2.062':U &then
                and bf-natur-oper-nf.log-ipi-outras-contrib-retid then
                &else
                and substr(bf-natur-oper-nf.char-1,106,1) = "S":U then 
                &endif
           &endif
               assign d-total-base-ret-irf = d-total-base-ret-irf + it-nota-fisc.vl-ipi-it.
                                        
          &if '{&bf_dis_versao_ems}':U >= '2.04':U AND  '{&bf_dis_versao_ems}':U < '2.07':U  &then
              IF substr(bf-natur-oper-nf.char-1,139,1) = "1"  then
                  assign d-total-base-ret-irf = d-total-base-ret-irf + it-nota-fisc.vl-icmsub-it.
          &endif
          &if '{&bf_dis_versao_ems}':U >= '2.07':U  &then
               IF bf-natur-oper-nf.log-icms-substto-base-irf-retid = yes  then
                  assign d-total-base-ret-irf = d-total-base-ret-irf + it-nota-fisc.vl-icmsub-it.
          &endif                                 
        END.
        
        /*--- FIM TOTAIS ---*/

    END.

    IF  l-iss THEN
        RUN pi-cria-ttISSQNTot.
    ELSE
		IF NOT l-iss THEN
			ASSIGN ttEmit.IM   = ""
				   ttEmit.CNAE = "".

    IF  d-total-icms-st = 0 THEN
        ASSIGN ttEmit.IEST = "".

    RUN pi-cria-ttICMSTot.

    RUN pi-cria-ttRetTrib.

    RUN pi-cria-ttTransp.

    RUN pi-cria-ttCobr.

    RUN pi-cria-ttInfAdic.

    RUN pi-cria-ttCana.

    RUN pi-cria-ttCompra.  /* VER MAPA NEOGRID - Lµ CONSTA INFORMAÄÂES DE COMPRA, E N«O DO PEDIDO */

    RUN pi-enviaEmailDestTransp. /* para o envio do e-mail do destinat†rio e transportador ao Neogrid/TSS */

    /*--- CHAMADAS UPC PARA TODOS OS CAMPOS DE TODAS AS TABELAS NF-e --*/
    RUN pi-executa-upc.
    /*-----*/

END PROCEDURE.