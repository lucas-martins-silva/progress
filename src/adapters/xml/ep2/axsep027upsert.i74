PROCEDURE pi-Ajuste-SINIEF-13-2013:

    DEF BUFFER bf-nota-fiscal   FOR nota-fiscal.
    DEF BUFFER bf-nota-fisc-adc FOR nota-fisc-adc.

    /* 
    === AJUSTE SINIEF 13/2013 ===
    Estabelece procedimentos relacionados com a entrega de bens e mercadorias a terceiros, adquiridos por ¢rg∆os ou entidades da 
    Administraá∆o Publica Direta da Uni∆o, dos Estados, do Distrito Federal e dos Munic°pios, bem como suas autarquias e fundaá‰es p£blicas.
    
    O fornecedor dever† emitir a Nota Fiscal Eletrìnica - NF-e, modelo 55, relativamente:
    
    I - ao faturamento, com destaque do imposto, se devido, contendo, alÇm das informaá‰es previstas na legislaá∆o:

    a) como destinat†rio, o ¢rg∆o ou entidade da Administraá∆o P£blica Direta ou Indireta adquirente;
    b) no grupo de campos ÀIdentificaá∆o do Local de EntregaÃ, o nome, o CNPJ e o endereáo do destinat†rio efetivo;
    c) no campo ÀNota de EmpenhoÃ , o n£mero da respectiva nota.
    
    II - a cada remessa das mercadorias, sem destaque do imposto, contendo alÇm das informaá‰es previstas na legislaá∆o:
    
    a) como destinat†rio, aquele determinado pelo adquirente;
    b) como natureza da operaá∆o, a express∆o ÀRemessa por conta e ordem de terceirosÃ;
    c) no campo ÀChave de Acesso da NF-e ReferenciadaÃ, a chave de acesso da NF-e relativa ao faturamento, emitida de acordo com o disposto no inciso I;
    d) no campo ÀInformaá‰es ComplementaresÃ, a express∆o ÀNF-e emitida nos termos do Ajuste XX/13Ã.
    
    Fonte: https://www1.fazenda.gov.br/confaz/confaz/Ajustes/2013/AJ_013_13.htm
    */


    /* 1) Nota de Faturamento - buscar informaá‰es da nota de empenho [Informaá‰es gravadas por nota fiscal - CD4035 - opá∆o "NF-e - Grupo de Compra"] */

    FOR FIRST nota-fisc-adc NO-LOCK
        WHERE nota-fisc-adc.cod-estab        = nota-fiscal.cod-estabel
          AND nota-fisc-adc.cod-serie        = nota-fiscal.serie
          AND nota-fisc-adc.cod-nota-fisc    = nota-fiscal.nr-nota-fis
          AND nota-fisc-adc.cdn-emitente     = nota-fiscal.cod-emitente
          AND nota-fisc-adc.cod-natur-operac = nota-fiscal.nat-operacao
          AND nota-fisc-adc.idi-tip-dado     = 18:  /*identificador para as informaá‰es inseridas no CD4035 se s∆o de Grupo de Compra da NF-e*/

        ASSIGN ttCompra.xNEmp = IF TRIM(nota-fisc-adc.cod-livre-1) = "" THEN ? ELSE TRIM(nota-fisc-adc.cod-livre-1)
               ttCompra.xPed  = IF TRIM(nota-fisc-adc.cod-livre-2) = "" THEN ? ELSE TRIM(nota-fisc-adc.cod-livre-2)
               ttCompra.xCont = IF TRIM(nota-fisc-adc.cod-livre-3) = "" THEN ? ELSE TRIM(nota-fisc-adc.cod-livre-3).
    END.

    /* 2) Nota de Remessa - buscar informaá‰es da nota referenciada no cd4035 e tambÇm buscar se a nota que foi referenciada possui a informacao de nota de empenho */
    
    FOR EACH nota-fisc-adc NO-LOCK
       WHERE nota-fisc-adc.cod-estab              = nota-fiscal.cod-estabel
       AND   nota-fisc-adc.cod-serie              = nota-fiscal.serie
       AND   nota-fisc-adc.cod-nota-fisc          = nota-fiscal.nr-nota-fis
       AND   nota-fisc-adc.cdn-emitente           = nota-fiscal.cod-emitente
       AND   nota-fisc-adc.cod-natur-operac       = nota-fiscal.nat-operacao
       AND   nota-fisc-adc.idi-tip-dado           = 3
       AND   nota-fisc-adc.idi-tip-docto-referado = 2 /*1 - Entrada/aquisiá∆o | 2 - Sa°da/prestaá∆o*/
       AND   STRING(INT(nota-fisc-adc.cod-model-docto-referado),"99") = "55": /*Ajuste considera somente notas modelo 55*/

        FOR FIRST bf-nota-fiscal NO-LOCK
            WHERE bf-nota-fiscal.cod-estabel  = nota-fiscal.cod-estabel
              AND bf-nota-fiscal.serie        = nota-fisc-adc.cod-ser-docto-referado
              AND bf-nota-fiscal.nr-nota-fis  = nota-fisc-adc.cod-docto-referado
              AND bf-nota-fiscal.cod-emitente = nota-fisc-adc.cdn-emit-docto-referado:
        END.
        
        IF  CAN-FIND (FIRST bf-nota-fisc-adc NO-LOCK /*leitura da informacao da nota de empenho */
                      WHERE bf-nota-fisc-adc.cod-estab          = bf-nota-fiscal.cod-estabel
                        AND bf-nota-fisc-adc.cod-serie          = bf-nota-fiscal.serie      
                        AND bf-nota-fisc-adc.cod-nota-fisc      = bf-nota-fiscal.nr-nota-fis
                        AND bf-nota-fisc-adc.cdn-emitente       = bf-nota-fiscal.cod-emitente
                        AND bf-nota-fisc-adc.cod-natur-operac   = bf-nota-fiscal.nat-operacao
                        AND bf-nota-fisc-adc.idi-tip-dado       = 18
                        AND (TRIM(bf-nota-fisc-adc.cod-livre-1) <> "":U            /*foi informada nota de empenho na nota de faturamento*/
                        OR   TRIM(bf-nota-fisc-adc.cod-livre-2) <> "":U            /*foi informado pedido na nota de faturamento*/ 
                        OR   TRIM(bf-nota-fisc-adc.cod-livre-3) <> "":U)) THEN DO: /*foi informado contrato na nota de faturamento*/ 


            RUN pi-ttNRef-docum-NF (INPUT IF  AVAIL bf-nota-fiscal THEN 
                                          &IF '{&bf_dis_versao_ems}' >= '2.07':U &THEN bf-nota-fiscal.cod-chave-aces-nf-eletro 
                                          &ELSE SUBSTRING(bf-nota-fiscal.char-2,3,60) &ENDIF
                                          ELSE "" ,
                                    INPUT nota-fiscal.cod-estabel,
                                    INPUT nota-fisc-adc.cod-ser-docto-referado,
                                    INPUT nota-fisc-adc.dat-docto-referado,
                                    INPUT nota-fisc-adc.cod-docto-referado,
                                    INPUT nota-fisc-adc.cdn-emit-docto-referado,
                                    INPUT nota-fisc-adc.cod-model-docto-referado,
                                    INPUT "estab":U).

            IF  NOT AVAIL ttInfAdic THEN
                FIND FIRST ttInfAdic NO-ERROR.

            ASSIGN ttInfAdic.infCpl = ttInfAdic.infCpl + ". NF-e emitida nos termos do Ajuste 13/13".
        END.
    END.

END PROCEDURE.