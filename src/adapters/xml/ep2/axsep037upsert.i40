PROCEDURE pi-grava-ttICMS00:

    /*
    === ttICMS00 ===
    CST            AS CHARACTER INITIAL ?  /*Tribut‡Æo pelo ICMS 00 - Tributada integralmente*/
    modBC          AS CHARACTER INITIAL ?  /*Modalidade de determina‡Æo da BC do ICMS: 0 - Margem Valor Agregado (%); 1 - Pauta (valor); 2 - Pre‡o Tabelado M ximo (valor); 3 - Valor da Opera‡Æo.*/
    orig           AS CHARACTER INITIAL ?  /*origem da mercadoria: 0 - Nacional 1 - Estrangeira - Importa‡Æo direta 2 - Estrangeira - Adquirida no mercado interno */
    pICMS          AS DECIMAL   INITIAL ?  /*Al¡quota do ICMS*/
    vBC            AS DECIMAL   INITIAL ?  /*Valor da BC do ICMS*/
    vICMS          AS DECIMAL   INITIAL ?  /*Valor do ICMS*/
    pFCP           AS DECIMAL   INITIAL ?  /*Al¡quota do FCP*/
    vFCP           AS DECIMAL   INITIAL ?  /*Valor do FCP*/       
    */

    CREATE ttICMS00.
    ASSIGN ttICMS00.CST   = (IF LENGTH(c-niv-trib-icms) = 3
                             THEN SUBSTRING(c-niv-trib-icms,2,2)
                             ELSE "00")
           ttICMS00.modBC = (IF c-mod-base-icms = "2"
                             THEN "1"
                             ELSE IF c-mod-base-icms = "3"
                                  THEN "2"
                                  ELSE IF c-mod-base-icms = "4"
                                       THEN "3"
                                       ELSE "0")
           ttICMS00.orig  = SUBSTRING(c-niv-trib-icms,1,1)
           ttICMS00.pICMS = (IF it-nota-fisc.cd-trib-icm <> 3
                             THEN d-aliquota-icms
                             ELSE 0)
           ttICMS00.vBC   = d-vl-bicms-it
           ttICMS00.vICMS = (IF it-nota-fisc.cd-trib-icm <> 3
                             THEN d-vl-imp-icms
                             ELSE 0)
           .  
    
    /*--- Valores FCP ---*/
    FOR FIRST item-nf-adc NO-LOCK
        WHERE item-nf-adc.cod-estab         = nota-fiscal.cod-estabel
        AND   item-nf-adc.cod-serie         = nota-fiscal.serie
        AND   item-nf-adc.cod-nota-fisc     = (if nota-fiscal.ind-tip-nota <> 8 then nota-fiscal.nr-nota-fis else nota-fiscal.nr-nota-ant)
        AND   item-nf-adc.idi-tip-dado      = 25
        AND   item-nf-adc.cdn-emitente      = nota-fiscal.cod-emitente
        AND   item-nf-adc.cod-natur-operac  = it-nota-fisc.nat-operacao
        AND   item-nf-adc.num-seq-item-nf   = (if nota-fiscal.ind-tip-nota <> 8 then it-nota-fisc.nr-seq-fat else it-nota-fisc.nr-seq-ped)
        AND   item-nf-adc.cod-item          = it-nota-fisc.it-codigo:
         
        IF (item-nf-adc.log-livre-2 = ?  /* Nova gera‡Æo de FCP -> FCP e FCP ST juntos no mesmo item da nota */
        AND (item-nf-adc.val-livre-4      > 0 OR /* Valores de FCP */
             DEC(item-nf-adc.cod-livre-3) > 0))
        THEN
            ASSIGN ttICMS00.pFCP     = item-nf-adc.val-livre-4
                   ttICMS00.vFCP     = DEC(item-nf-adc.cod-livre-3)
                   d-total-vFCP      = d-total-vFCP + ttICMS00.vFCP.
        ELSE IF item-nf-adc.log-livre-1 = NO  /* NO = FCP Normal | YES = FCP ST */ /* Gera‡Æo de dados antiga FCP ou FCP ST */
        THEN
            ASSIGN ttICMS00.pFCP     = item-nf-adc.val-livre-2
                   ttICMS00.vFCP     = DEC(item-nf-adc.cod-livre-4)
                   d-total-vFCP      = d-total-vFCP + ttICMS00.vFCP.
    END.
    /*---*/

    /* Chave EMS */
    ASSIGN ttICMS00.CodEstabelNF = nota-fiscal.cod-estabel
           ttICMS00.SerieNF      = nota-fiscal.serie
           ttICMS00.NrNotaFisNF  = nota-fiscal.nr-nota-fis
           ttICMS00.ItCodigoNF   = it-nota-fisc.it-codigo
           ttICMS00.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.

END PROCEDURE.
