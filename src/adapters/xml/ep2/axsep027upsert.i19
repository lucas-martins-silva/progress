PROCEDURE pi-cria-ttAutXML:

    /*
    === ttAutXML ===
    CNPJ           AS CHARACTER INITIAL ? /*CNPJ Autorizado*/
    CPF            AS CHARACTER INITIAL ? /*CPF Autorizado*/
    */

    /* CNPJ's ou CPF's autorizados a realizar o Download do XML da NF-e no Portal */

    /*Contatos do Cliente/Fornecedore da Nota - CD0704B/CD0401B*/
    FOR EACH cont-emit NO-LOCK
       WHERE cont-emit.cod-emitente                  = emitente.cod-emitente
       AND   TRIM(SUBSTRING(cont-emit.char-2,1,20)) <> "":U
       AND   &IF '{&bf_dis_versao_ems}' >= '2.09':U
             &THEN cont-emit.cdn-aplic-contat
             &ELSE cont-emit.int-1
             &ENDIF = 4: /*4 - Download XML NF-e*/
             
        IF  NOT CAN-FIND (FIRST ttAutXML 
                          WHERE ttAutXML.CNPJ = TRIM(SUBSTRING(cont-emit.char-2,1,20))) THEN DO:
        
            CREATE ttAutXML.
            ASSIGN ttAutXML.CNPJ  = TRIM(SUBSTRING(cont-emit.char-2,1,20))
                   ttAutXML.CNPJ  = REPLACE(ttAutXML.CNPJ,"-","")
                   ttAutXML.CNPJ  = REPLACE(ttAutXML.CNPJ,".","")
                   ttAutXML.CNPJ  = REPLACE(ttAutXML.CNPJ,"/","")
                   ttAutXML.CNPJ  = REPLACE(ttAutXML.CNPJ,"~\","")
                   ttAutXML.CNPJ  = REPLACE(ttAutXML.CNPJ,",","")
                   ttAutXML.CNPJ  = (IF ttAutXML.CNPJ <> ?
                                     THEN ttAutXML.CNPJ
                                     ELSE "")
    
                   ttAutXML.CPF   = (IF LENGTH(ttAutXML.CNPJ) > 11
                                     THEN ""
                                     ELSE ttAutXML.CNPJ) /* Pessoa Fisica - Joga o conteudo no campo CPF, caso tenha mais de 11 digitos (caracteriza CNPJ) */
                   .
    
            /* Chave EMS */
            ASSIGN ttAutXML.CodEstabelNF = nota-fiscal.cod-estabel
                   ttAutXML.SerieNF      = nota-fiscal.serie
                   ttAutXML.NrNotaFisNF  = nota-fiscal.nr-nota-fis.
        END.
    END.

    /*Contatos do emitente vinculado ao estabelecimento (estabelec.cod-emitente do CD0602 - onde o codigo aparece no CD0704) - CD0704B/CD0401B*/
    FOR EACH cont-emit NO-LOCK
       WHERE cont-emit.cod-emitente                  = estabelec.cod-emitente
       AND   TRIM(SUBSTRING(cont-emit.char-2,1,20)) <> "":U
       AND   &IF '{&bf_dis_versao_ems}' >= '2.09':U
             &THEN cont-emit.cdn-aplic-contat
             &ELSE cont-emit.int-1
             &ENDIF = 4: /*4 - Download XML NF-e*/

        IF  NOT CAN-FIND (FIRST ttAutXML
                          WHERE ttAutXML.CNPJ = TRIM(SUBSTRING(cont-emit.char-2,1,20))) THEN DO:

            CREATE ttAutXML.
            ASSIGN ttAutXML.CNPJ  = TRIM(SUBSTRING(cont-emit.char-2,1,20))
                   ttAutXML.CNPJ  = REPLACE(ttAutXML.CNPJ,"-","")
                   ttAutXML.CNPJ  = REPLACE(ttAutXML.CNPJ,".","")
                   ttAutXML.CNPJ  = REPLACE(ttAutXML.CNPJ,"/","")
                   ttAutXML.CNPJ  = REPLACE(ttAutXML.CNPJ,"~\","")
                   ttAutXML.CNPJ  = REPLACE(ttAutXML.CNPJ,",","")
                   ttAutXML.CNPJ  = (IF ttAutXML.CNPJ <> ?
                                     THEN ttAutXML.CNPJ
                                     ELSE "")

                   ttAutXML.CPF   = (IF LENGTH(ttAutXML.CNPJ) > 11
                                     THEN ""
                                     ELSE ttAutXML.CNPJ) /* Pessoa Fisica - Joga o conteudo no campo CPF, caso tenha mais de 11 digitos (caracteriza CNPJ) */
                   .

            /* Chave EMS */
            ASSIGN ttAutXML.CodEstabelNF = nota-fiscal.cod-estabel
                   ttAutXML.SerieNF      = nota-fiscal.serie
                   ttAutXML.NrNotaFisNF  = nota-fiscal.nr-nota-fis.
        END.
    END.

    /*Contatos do Transportador da Nota - CD0402A*/
    FOR FIRST transporte NO-LOCK
        WHERE transporte.nome-abrev = nota-fiscal.nome-transp,
         EACH cont-tran NO-LOCK
        WHERE cont-tran.cod-transp                    = transporte.cod-transp
          AND TRIM(SUBSTRING(cont-tran.char-1,1,20)) <> "":U
          AND &IF '{&bf_dis_versao_ems}' >= '2.09':U 
              &THEN cont-tran.cdn-aplic-contat
              &ELSE cont-tran.int-1 
              &ENDIF = 3: /*3 - Download XML NF-e*/
                 
        IF  NOT CAN-FIND (FIRST ttAutXML 
                          WHERE ttAutXML.CNPJ = TRIM(SUBSTRING(cont-tran.char-1,1,20))) THEN DO:
        
            CREATE ttAutXML.
            ASSIGN ttAutXML.CNPJ  = TRIM(SUBSTRING(cont-tran.char-1,1,20))
                   ttAutXML.CNPJ  = REPLACE(ttAutXML.CNPJ,"-","")
                   ttAutXML.CNPJ  = REPLACE(ttAutXML.CNPJ,".","")
                   ttAutXML.CNPJ  = REPLACE(ttAutXML.CNPJ,"/","")
                   ttAutXML.CNPJ  = REPLACE(ttAutXML.CNPJ,"~\","")
                   ttAutXML.CNPJ  = REPLACE(ttAutXML.CNPJ,",","")
                   ttAutXML.CNPJ  = (IF ttAutXML.CNPJ <> ?
                                     THEN ttAutXML.CNPJ
                                     ELSE "")
        
                   ttAutXML.CPF   = (IF LENGTH(ttAutXML.CNPJ) > 11
                                     THEN ""
                                     ELSE ttAutXML.CNPJ) /* Pessoa Fisica - Joga o conteudo no campo CPF, caso tenha mais de 11 digitos (caracteriza CNPJ) */
                   .
        
            /* Chave EMS */
            ASSIGN ttAutXML.CodEstabelNF = nota-fiscal.cod-estabel
                   ttAutXML.SerieNF      = nota-fiscal.serie
                   ttAutXML.NrNotaFisNF  = nota-fiscal.nr-nota-fis.
        END.
    END.

END PROCEDURE.