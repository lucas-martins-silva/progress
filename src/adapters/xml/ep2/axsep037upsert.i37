PROCEDURE pi-grava-ttICMS60:

    DEF VAR de-fcp-efet-aliq    AS DECIMAL      NO-UNDO.
    DEF VAR de-fcp-efet-base    AS DECIMAL      NO-UNDO.
    DEF VAR de-fcp-efet-valor   AS DECIMAL      NO-UNDO.
    DEF VAR h-reapi412          AS HANDLE       NO-UNDO.    

    /*
    === ttICMS60 ===
    CST            AS CHARACTER INITIAL ?  /*Tributa‡Æo pelo ICMS 60 - ICMS cobrado anteriormente por substitui‡Æo tribut ria */
    orig           AS CHARACTER INITIAL ?  /*origem da mercadoria: 0 - Nacional 1 - Estrangeira - Importa‡Æo direta 2 - Estrangeira - Adquirida no mercado interno */
    vBCSTRet       AS DECIMAL   INITIAL ?  /*Valor da BC do ICMS ST retido anteriormente*/
    pST            AS DECIMAL   INITIAL ?  /*Aliquota suportada pelo Consumidor Final*/
    vICMSSTRet     AS DECIMAL   INITIAL ?  /*Valor do ICMS ST retido anteriormente*/
    vBCFCPSTRet    AS DECIMAL   INITIAL ?  /*Valor da BC do FCP ST*/ 
    pFCPSTRet      AS DECIMAL   INITIAL ?  /*Al¡quota do FCP ST*/
    vFCPSTRet      AS DECIMAL   INITIAL ?  /*Valor do FCP ST*/       
    */

    CREATE ttICMS60.
    ASSIGN ttICMS60.CST        = SUBSTRING(c-niv-trib-icms,2,2)
           ttICMS60.orig       = SUBSTRING(c-niv-trib-icms,1,1).

    ASSIGN ttICMS60.pRedBCEfet      = ?
           ttICMS60.vBCEfet         = ?
           ttICMS60.pICMSEfet       = ?
           ttICMS60.vICMSEfet       = ?
           ttICMS60.vBCSTRet        = 0
           ttICMS60.pST             = 0
           ttICMS60.vICMSSubstituto = 0
           ttICMS60.vICMSSTRet      = 0
           ttICMS60.pFCPSTRet       = 0 
           ttICMS60.vFCPSTRet       = 0
           ttICMS60.vBCFCPSTRet     = 0.

    /* tratamento especial para RS nas opera‡äes com CST 60 destinadas a consumidor final */
    /* adicionado o tratamento tamb‚m para o estado do RJ - Portaria SUCIEF 131/2023, que altera a Portaria SUCIEF n§ 69/2019 */
    IF  (estabelec.estado = "RS" OR estabelec.estado = "RJ")
    AND nota-fiscal.cod-des-merc = 2 
    AND ( cfop-natur.cod-cfop BEGINS "5" OR 
         (cfop-natur.cod-cfop BEGINS "1" AND nota-fiscal.esp-docto = 20 AND nota-fiscal.ind-tip-nota = 8)) /*Devol Cliente*/
    AND it-nota-fisc.cd-trib-icm = 3 THEN DO:

        ASSIGN de-fcp-efet-aliq  = 0
               de-fcp-efet-base  = 0
               de-fcp-efet-valor = 0.
        
        IF (cfop-natur.cod-cfop BEGINS "1" AND nota-fiscal.esp-docto = 20 AND nota-fiscal.ind-tip-nota = 8) THEN DO: /*Devol Cliente*/
            /* Leitura item-doc-est partindo do item da nota no FT */
            FOR FIRST item-doc-est NO-LOCK
                WHERE item-doc-est.serie-docto  = it-nota-fisc.serie
                  AND item-doc-est.nro-docto    = nota-fiscal.nr-nota-ant 
                  AND item-doc-est.cod-emitente = nota-fiscal.cod-emitente
                  AND item-doc-est.nat-operacao = it-nota-fisc.nat-operacao
                  AND item-doc-est.sequencia    = it-nota-fisc.nr-seq-ped:
                {dibo/bodi629.i1 item-doc-est "FCP EFETIVO" de-fcp-efet-aliq de-fcp-efet-base de-fcp-efet-valor}  
            END.
        END.
        ELSE DO:
            {dibo/bodi630.i4 "FCP EFETIVO" de-fcp-efet-aliq de-fcp-efet-base de-fcp-efet-valor it-nota-fisc}.
        END.
        
        ASSIGN ttICMS60.pRedBCEfet = it-nota-fisc.perc-red-icm
               ttICMS60.vBCEfet    = it-nota-fisc.vl-icmsou-it 
               ttICMS60.pICMSEfet  = it-nota-fisc.aliquota-icm + de-fcp-efet-aliq
               ttICMS60.vICMSEfet  = it-nota-fisc.vl-icms-it + de-fcp-efet-valor.
    END.
    ELSE DO:

        /* tratamento para os demais estados */

        /* Implementa‡Æo Provis¢ria para nÆo ocorrer rejei‡Æo at‚ que se saiba quais valores devem ir nestas tag's [04/07/2018] */
        /* Rejei‡Æo 906 - Se Informado CST = 60 ou CSOSN=500 e indFinal=1 (id:B25a), preenchimento obrigat¢rio dos campos do grupo opcional para informa‡äes do ICMS Efetivo (N33) Observa‡Æo: Implementa‡Æo opcional a crit‚rio da UF. */

        IF  nota-fiscal.cod-des-merc = 1 THEN 
            ASSIGN ttICMS60.pRedBCEfet = 0
                   ttICMS60.vBCEfet    = 0
                   ttICMS60.pICMSEfet  = 0
                   ttICMS60.vICMSEfet  = 0.

        /* Al¡quota ICMS ST */
        if  nota-fiscal.ind-tip-nota = 8 then do: /* Entrada */

            IF NOT VALID-HANDLE (h-reapi412) THEN
                RUN rep/reapi412.p PERSISTENT SET h-reapi412.
            RUN inicializaAtributos    IN h-reapi412.
            RUN setRowidItemNotaFiscal IN h-reapi412 (INPUT ROWID(it-nota-fisc)).
            
            RUN buscaICMS60XML         IN h-reapi412.
            IF RETURN-VALUE = "OK" THEN DO:
                RUN getValBaseSubs       IN h-reapi412 (OUTPUT ttICMS60.vBCSTRet).
                RUN getValSubs           IN h-reapi412 (OUTPUT ttICMS60.vICMSSTRet).
                RUN getAliqST            IN h-reapi412 (OUTPUT ttICMS60.pST).
                RUN getAliqFCPST         IN h-reapi412 (OUTPUT ttICMS60.pFCPSTRet).
                RUN getValBaseFCPSubs    IN h-reapi412 (OUTPUT ttICMS60.vBCFCPSTRet).
                RUN getValFCPSubs        IN h-reapi412 (OUTPUT ttICMS60.vFCPSTRet).
                RUN getValICMSProprioSTA IN h-reapi412 (OUTPUT ttICMS60.vICMSSubstituto).
            END.

            IF VALID-HANDLE(h-reapi412) THEN DO:
                DELETE PROCEDURE h-reapi412 NO-ERROR.
                ASSIGN h-reapi412 = ?.
            END.
            
            ASSIGN d-total-vFCPSTRet = d-total-vFCPSTRet + ttICMS60.vFCPSTRet.
            
        end. /*if  nota-fiscal.ind-tip-nota = 8 then*/
        ELSE DO:
        
            ASSIGN ttICMS60.vBCSTRet   = it-nota-fisc.vl-bsubs-it  + it-nota-fisc.vl-bsubsit-e[1]
                   ttICMS60.vICMSSTRet = it-nota-fisc.vl-icmsub-it + it-nota-fisc.vl-icmsubit-e[1].

            FOR FIRST item-nfs-st NO-LOCK
                WHERE item-nfs-st.cod-estab-nfs = it-nota-fisc.cod-estabel
                AND   item-nfs-st.cod-ser-nfs   = it-nota-fisc.serie
                AND   item-nfs-st.cod-docto-nfs = it-nota-fisc.nr-nota-fis
                AND   item-nfs-st.cod-item      = it-nota-fisc.it-codigo
                AND   item-nfs-st.num-seq-nfs   = it-nota-fisc.nr-seq-fat:
                
                ASSIGN ttICMS60.pST       = DEC(TRIM(SUBSTRING(item-nfs-st.cod-livre-1,1,8)))
                       ttICMS60.pFCPSTRet = DEC(TRIM(SUBSTRING(item-nfs-st.cod-livre-1,29,8))).
            END.

            IF  NOT CAN-FIND(FIRST item-nf-adc NO-LOCK
                             WHERE item-nf-adc.cod-estab         = nota-fiscal.cod-estabel
                             AND   item-nf-adc.cod-serie         = nota-fiscal.serie
                             AND   item-nf-adc.cod-nota-fisc     = (if nota-fiscal.ind-tip-nota <> 8 then nota-fiscal.nr-nota-fis else nota-fiscal.nr-nota-ant)
                             AND   item-nf-adc.idi-tip-dado      = 25
                             AND   item-nf-adc.cdn-emitente      = nota-fiscal.cod-emitente
                             AND   item-nf-adc.cod-natur-operac  = it-nota-fisc.nat-operacao
                             AND   item-nf-adc.num-seq-item-nf   = (if nota-fiscal.ind-tip-nota <> 8 then it-nota-fisc.nr-seq-fat else it-nota-fisc.nr-seq-ped)
                             AND   item-nf-adc.cod-item          = it-nota-fisc.it-codigo) THEN
                FOR EACH  item-nfs-st NO-LOCK
                    WHERE item-nfs-st.cod-estab-nfs = it-nota-fisc.cod-estabel
                    AND   item-nfs-st.cod-ser-nfs   = it-nota-fisc.serie
                    AND   item-nfs-st.cod-docto-nfs = it-nota-fisc.nr-nota-fis
                    AND   item-nfs-st.cod-item      = it-nota-fisc.it-codigo
                    AND   item-nfs-st.num-seq-nfs   = it-nota-fisc.nr-seq-fat:
                    
                    ASSIGN ttICMS60.vBCFCPSTRet     = ttICMS60.vBCFCPSTRet     + dec(substring(item-nfs-st.cod-livre-1,9,20)) 
                           ttICMS60.vFCPSTRet       = ttICMS60.vFCPSTRet       + dec(substring(item-nfs-st.cod-livre-1,37,20))
                           ttICMS60.vICMSSubstituto = ttICMS60.vICMSSubstituto + dec(substring(item-nfs-st.cod-livre-1,57,16))
                           d-total-vFCPSTRet        = d-total-vFCPSTRet        + dec(substring(item-nfs-st.cod-livre-1,37,20)).
                    
                    IF ttICMS60.pFCPSTRet = 0 THEN
                        ASSIGN ttICMS60.pFCPSTRet = DEC(TRIM(SUBSTRING(item-nfs-st.cod-livre-1,29,8))).
                END.
        
            /*--- Valores FCP ---*/
            FOR FIRST item-nf-adc NO-LOCK
                WHERE item-nf-adc.cod-estab         = nota-fiscal.cod-estabel
                AND   item-nf-adc.cod-serie         = nota-fiscal.serie
                AND   item-nf-adc.cod-nota-fisc     = (if nota-fiscal.ind-tip-nota <> 8 then nota-fiscal.nr-nota-fis else nota-fiscal.nr-nota-ant)
                AND   item-nf-adc.idi-tip-dado      = 25
                AND   item-nf-adc.cdn-emitente      = nota-fiscal.cod-emitente
                AND   item-nf-adc.cod-natur-operac  = it-nota-fisc.nat-operacao
                AND   item-nf-adc.num-seq-item-nf   = (if nota-fiscal.ind-tip-nota <> 8 then it-nota-fisc.nr-seq-fat else it-nota-fisc.nr-seq-ped)
                AND   item-nf-adc.cod-item          = it-nota-fisc.it-codigo:
            
                IF (item-nf-adc.log-livre-2 = ? /* Nova gera‡Æo de FCP -> FCP e FCP ST juntos no mesmo item da nota */
                AND (item-nf-adc.val-livre-1      > 0 OR /* Valores de FCP ST */
                     item-nf-adc.val-livre-2      > 0 OR
                     DEC(item-nf-adc.cod-livre-4) > 0))
                OR  item-nf-adc.log-livre-1 = YES  /* NO = FCP Normal | YES = FCP ST */ /* Gera‡Æo de dados antiga FCP ou FCP ST */
                THEN
                    ASSIGN ttICMS60.vBCFCPSTRet = item-nf-adc.val-livre-1
                           ttICMS60.pFCPSTRet   = item-nf-adc.val-livre-2
                           ttICMS60.vFCPSTRet   = DEC(item-nf-adc.cod-livre-4)
                           d-total-vFCPSTRet    = d-total-vFCPSTRet + ttICMS60.vFCPSTRet.
            END.
            
            /*--- Valor do ICMS pr¢prio do Substituto */
            ASSIGN ttICMS60.vICMSSubstituto = IF  ttICMS60.vICMSSubstituto = 0 OR ttICMS60.vICMSSubstituto = ? THEN DEC(TRIM(SUBSTRING(it-nota-fisc.char-2,354,16))) ELSE ttICMS60.vICMSSubstituto.
        END.
    END.    
    /* Majora ICMS ST com FCP ST fun‡Æo por estado - EX: MT */ 
    IF  l-Majora-FCP = YES
    AND ttICMS60.vFCPSTRet <> ? THEN DO:
        ASSIGN ttICMS60.pST         = ttICMS60.pST        + ttICMS60.pFCPSTRet
               ttICMS60.vICMSSTRet  = ttICMS60.vICMSSTRet + ttICMS60.vFCPSTRet
               ttICMS60.vBCFCPSTRet = ?
               ttICMS60.pFCPSTRet   = ?
               ttICMS60.vFCPSTRet   = ?.
    END.

    /* Chave EMS */
    ASSIGN ttICMS60.CodEstabelNF = nota-fiscal.cod-estabel
           ttICMS60.SerieNF      = nota-fiscal.serie
           ttICMS60.NrNotaFisNF  = nota-fiscal.nr-nota-fis
           ttICMS60.ItCodigoNF   = it-nota-fisc.it-codigo
           ttICMS60.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.

END PROCEDURE.
