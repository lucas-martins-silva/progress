PROCEDURE pi-cria-ttRetTrib:
        
    IF it-nota-fisc.val-retenc-pis    > 0
    OR it-nota-fisc.val-retenc-cofins > 0
    OR it-nota-fisc.val-retenc-csll   > 0
    OR it-nota-fisc.vl-irf-it         > 0 THEN DO:        
        CREATE ttRetTrib.         
        ASSIGN ttRetTrib.CodEstabelNFCom = nota-fiscal.cod-estabel
               ttRetTrib.SerieNFCom      = nota-fiscal.serie
               ttRetTrib.NrNotaFisNFCom  = nota-fiscal.nr-nota-fis
               ttRetTrib.ItCodigoNFCom   = it-nota-fisc.it-codigo
               ttRetTrib.NrSeqFatNFCom   = it-nota-fisc.nr-seq-fat
               ttRetTrib.vRetPIS         = it-nota-fisc.val-retenc-pis
               ttRetTrib.vRetCOFINS      = it-nota-fisc.val-retenc-cofins
               ttRetTrib.vRetCSLL        = it-nota-fisc.val-retenc-csll
               ttRetTrib.vIRRF           = it-nota-fisc.vl-irf-it.
               
        IF ttRetTrib.vIRRF > 0 THEN DO:
            ASSIGN ttRetTrib.vBCIRRF = it-nota-fisc.vl-merc-liq .        
            
            IF  it-nota-fisc.cd-trib-ipi <> 3
            AND bf-natur-oper-it.log-ipi-contrib-retid THEN
                ASSIGN ttRetTrib.vBCIRRF = ttRetTrib.vBCIRRF + it-nota-fisc.vl-ipi-it.

              IF  it-nota-fisc.cd-trib-ipi = 3
              AND SUBSTRING(bf-natur-oper-it.char-2,16,1) = "1":U
              AND bf-natur-oper-it.log-ipi-outras-contrib-retid THEN
                  ASSIGN ttRetTrib.vBCIRRF = ttRetTrib.vBCIRRF + it-nota-fisc.vl-ipi-it.
                                            
              IF bf-natur-oper-it.log-icms-substto-base-irf-retid = YES  THEN
                  ASSIGN ttRetTrib.vBCIRRF = ttRetTrib.vBCIRRF + it-nota-fisc.vl-icmsub-it.                    
        END.    
        
        ASSIGN d-total-ret-pis    = d-total-ret-pis       + ttRetTrib.vRetPIS
               d-total-ret-cofins = d-total-ret-cofins    + ttRetTrib.vRetCOFINS
               d-total-ret-csll   = d-total-ret-csll      + ttRetTrib.vRetCSLL
               d-total-ret-irf    = d-total-ret-irf       + ttRetTrib.vIRRF.
    END.        
	    
END PROCEDURE.
