PROCEDURE pi-cria-ttCOFINS-NFCom:

    /*
    === ttCOFINSNFCom ===
    CST            AS CHARACTER INITIAL ?  /*C¢digo de Situa‡Æo Tribut ria do COFINS*/
    pCOFINS        AS DECIMAL   INITIAL ?  /*Al¡quota do COFINS (em percentual)*/
    vBC            AS DECIMAL   INITIAL ?  /*Valor da BC do COFINS*/
    vCOFINS        AS DECIMAL   INITIAL ?  /*Valor do COFINS*/
    */

    ASSIGN c-sit-trib-cofins = &if '{&bf_dis_versao_ems}' >= '2.07':U 
                               &then string(it-nota-fisc.cod-sit-tributar-cofins)
                               &else substring(it-nota-fisc.char-1,79,2) &endif.
                               
    IF  c-sit-trib-cofins = "49":U
    AND d-aliq-cofins     = 0
    AND d-valor-cofins    = 0 THEN
        ASSIGN d-base-cofins = 0.

    CREATE ttCOFINSNFCom.
    ASSIGN ttCOFINSNFCom.CST     = c-sit-trib-cofins
           ttCOFINSNFCom.pCOFINS = d-aliq-cofins /*dec(substring(it-nota-fisc.char-2,81,5))*/
           ttCOFINSNFCom.vBC     = d-base-cofins
           ttCOFINSNFCom.vCOFINS = d-valor-cofins.
   
    /* Chave EMS */
    ASSIGN ttCOFINSNFCom.CodEstabelNF = nota-fiscal.cod-estabel
           ttCOFINSNFCom.SerieNF      = nota-fiscal.serie
           ttCOFINSNFCom.NrNotaFisNF  = nota-fiscal.nr-nota-fis
           ttCOFINSNFCom.ItCodigoNF   = it-nota-fisc.it-codigo
           ttCOFINSNFCom.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.
                   
    ASSIGN d-total-COFINS = d-total-COFINS + ttCOFINSNFCom.vCOFINS.                               
    
END PROCEDURE.

