PROCEDURE pi-cria-ttgCompraGov:
   /*
   === ttgCompraGov ===
   FIELD tpEnteGov      AS CHARACTER INITIAL ?                                         /*Tipo de compra governamenta: 1=UniÆo; 2=Estado; 3=Distrito Federal; 4=Munic¡pio*/
   FIELD pRedutor       AS DECIMAL   INITIAL ?  FORMAT ">>9.9999"         DECIMALS 4   /*Percentual de redu‡Æo de al¡quota em compra governamental. Conforme o art. 473 da LC 214/2024. */
   FIELD tpOperGov      AS CHARACTER INITIAL ?                                         /* Tipo de opera‡Æo com o ente governamental. 1=Fornecimento. 2=Recebimento do pagamento, conforme fato gerador do IBS/CBS definido no Art. 10 õ 2§. */
   FIELD refDFeAnt      AS CHARACTER INITIAL ?                                         /*Chave de acesso do documento fiscal anterior*/ 
   */

   IF NOT CAN-FIND(FIRST ttgCompraGov
                   WHERE ttgCompraGov.CodEstabelNF = it-nota-fisc-trib.cod-estabel
                     AND ttgCompraGov.SerieNF      = it-nota-fisc-trib.serie
                     AND ttgCompraGov.NrNotaFisNF  = it-nota-fisc-trib.nr-nota-fis) THEN DO:

      CREATE ttgCompraGov.
      ASSIGN ttgCompraGov.pRedutor     = it-nota-fisc-trib.perc-red-aliq-gov
             /* Chave EMS */
             ttgCompraGov.CodEstabelNF = it-nota-fisc-trib.cod-estabel
             ttgCompraGov.SerieNF      = it-nota-fisc-trib.serie
             ttgCompraGov.NrNotaFisNF  = it-nota-fisc-trib.nr-nota-fis.
   END.

   IF NOT AVAIL ttgCompraGov THEN
      FIND FIRST ttgCompraGov
           WHERE ttgCompraGov.CodEstabelNF = it-nota-fisc-trib.cod-estabel
             AND ttgCompraGov.SerieNF      = it-nota-fisc-trib.serie
             AND ttgCompraGov.NrNotaFisNF  = it-nota-fisc-trib.nr-nota-fis NO-ERROR.

   FOR EACH nota-fisc-gener NO-LOCK
      WHERE nota-fisc-gener.cod-estabel  = it-nota-fisc-trib.cod-estabel
        AND nota-fisc-gener.serie        = it-nota-fisc-trib.serie
        AND nota-fisc-gener.nr-nota-fis  = it-nota-fisc-trib.nr-nota-fis:

      CASE nota-fisc-gener.cod-param:
         WHEN "tip-ente-gov":U THEN
            ASSIGN ttgCompraGov.tpEnteGov = IF nota-fisc-gener.cod-valor[1] = "0":U
                                            THEN ? ELSE nota-fisc-gener.cod-valor[1].
         WHEN "tip-oper-ente-gov":U THEN
            ASSIGN ttgCompraGov.tpOperGov = IF nota-fisc-gener.cod-valor[1] = "0":U
                                            THEN ? ELSE nota-fisc-gener.cod-valor[1].
      END CASE.
   END. 

END PROCEDURE.

PROCEDURE pi-cria-ttgTribCompraGov:
   
   /*
   === ttgTribCompraGov ===
     FIELD pAliqIBSUF           AS DECIMAL   INITIAL ?  FORMAT ">>9.9999"         DECIMALS 4   /*Al¡quota do IBS de competˆncia do Estado*/
     FIELD vTribIBSUF           AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor que seria devido a UF, sem aplica‡Æo do Art. 473. da LC 214/2025*/
     FIELD pAliqIBSMun          AS DECIMAL   INITIAL ?  FORMAT ">>9.9999"         DECIMALS 4   /*Al¡quota do IBS de competˆncia do Estado*/
     FIELD vTribIBSMun          AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor que seria devido a UF, sem aplica‡Æo do Art. 473. da LC 214/2025*/     
     FIELD pAliqCBS             AS DECIMAL   INITIAL ?  FORMAT ">>9.9999"         DECIMALS 4   /*Al¡quota do IBS de competˆncia do Estado*/
     FIELD vTribCBS             AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor que seria devido a UF, sem aplica‡Æo do Art. 473. da LC 214/2025*/
     /*Chave EMS*/
     FIELD CodEstabelNF        AS CHARACTER INITIAL ?
     FIELD SerieNF             AS CHARACTER INITIAL ?
     FIELD NrNotaFisNF         AS CHARACTER INITIAL ?
     FIELD ItCodigoNF          AS CHARACTER INITIAL ?
     FIELD NrSeqFatNF          AS INTEGER   INITIAL ?
     FIELD TipTributo          AS INTEGER   INITIAL ?
     INDEX ch-ttTribCompraGov CodEstabelNF SerieNF NrNotaFisNF NrSeqFatNF ItCodigoNF.
   */

   IF NOT CAN-FIND(FIRST ttgTribCompraGov
                   WHERE ttgTribCompraGov.CodEstabelNF = it-nota-fisc-trib.cod-estabel
                     AND ttgTribCompraGov.SerieNF      = it-nota-fisc-trib.serie
                     AND ttgTribCompraGov.NrNotaFisNF  = it-nota-fisc-trib.nr-nota-fis
                     AND ttgTribCompraGov.NrSeqFatNF   = it-nota-fisc-trib.nr-seq-fat
                     AND ttgTribCompraGov.ItCodigoNF   = it-nota-fisc-trib.it-codigo) THEN DO:

      CREATE ttgTribCompraGov.
      /* Chave EMS */
      ASSIGN ttgTribCompraGov.CodEstabelNF = it-nota-fisc-trib.cod-estabel
             ttgTribCompraGov.SerieNF      = it-nota-fisc-trib.serie
             ttgTribCompraGov.NrNotaFisNF  = it-nota-fisc-trib.nr-nota-fis
             ttgTribCompraGov.NrSeqFatNF   = it-nota-fisc-trib.nr-seq-fat
             ttgTribCompraGov.ItCodigoNF   = it-nota-fisc-trib.it-codigo.
   END.

   IF NOT AVAIL ttgTribCompraGov THEN
      FIND FIRST ttgTribCompraGov
           WHERE ttgTribCompraGov.CodEstabelNF = it-nota-fisc-trib.cod-estabel
             AND ttgTribCompraGov.SerieNF      = it-nota-fisc-trib.serie
             AND ttgTribCompraGov.NrNotaFisNF  = it-nota-fisc-trib.nr-nota-fis
             AND ttgTribCompraGov.NrSeqFatNF   = it-nota-fisc-trib.nr-seq-fat
             AND ttgTribCompraGov.ItCodigoNF   = it-nota-fisc-trib.it-codigo NO-ERROR.

   IF AVAIL ttgTribCompraGov THEN DO:
      CASE it-nota-fisc-trib.tip-tributo:
         WHEN 1 THEN
            ASSIGN ttgTribCompraGov.pAliqCBS = it-nota-fisc-trib.aliq-regul
                   ttgTribCompraGov.vTribCBS = it-nota-fisc-trib.valor-regul.
         WHEN 2 THEN
            ASSIGN ttgTribCompraGov.pAliqIBSUF = it-nota-fisc-trib.aliq-regul
                   ttgTribCompraGov.vTribIBSUF = it-nota-fisc-trib.valor-regul.
         WHEN 3 THEN
            ASSIGN ttgTribCompraGov.pAliqIBSMun = it-nota-fisc-trib.aliq-regul
                   ttgTribCompraGov.vTribIBSMun = it-nota-fisc-trib.valor-regul.
      END CASE.
   END.
END PROCEDURE.





