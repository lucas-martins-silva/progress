PROCEDURE salvaMensagemSEFAZ:

    &SCOPED-DEFINE TAG_NFE  NFe
    &SCOPED-DEFINE TAG_PROT protNFe
    
    &SCOPED-DEFINE NAMESPACE_NFE http://www.portalfiscal.inf.br/nfe
    &SCOPED-DEFINE NAMESPACE_DS  http://www.w3.org/2000/09/xmldsig#
    &SCOPED-DEFINE NAMESPACE_XSI http://www.w3.org/2001/XMLSchema-instance
    &SCOPED-DEFINE VERSAO_NFE    1.10
    
    DEFINE INPUT  PARAMETER destino      AS CHARACTER   NO-UNDO.
    DEFINE INPUT  PARAMETER cancelamento AS LOGICAL     NO-UNDO.
    
    &IF int(entry(1,proversion,".")) > 9 &THEN
    DEFINE VARIABLE lcXmlNfe         AS LONGCHAR CASE-SENSITIVE  NO-UNDO.
    DEFINE VARIABLE lcXmlProt        AS LONGCHAR CASE-SENSITIVE  NO-UNDO.
    &ELSE
    DEFINE VARIABLE lcXmlNfe         AS CHAR CASE-SENSITIVE  NO-UNDO.
    DEFINE VARIABLE lcXmlProt        AS CHAR CASE-SENSITIVE  NO-UNDO.
    &ENDIF
    DEFINE VARIABLE xmlNfe           AS HANDLE                   NO-UNDO.
    DEFINE VARIABLE xmlProt          AS HANDLE                   NO-UNDO.
    DEFINE VARIABLE xmlFinal         AS HANDLE                   NO-UNDO.
    DEFINE VARIABLE xmlNodeRef       AS HANDLE  EXTENT 2         NO-UNDO.
    DEFINE VARIABLE i                AS INTEGER                  NO-UNDO.
    DEFINE VARIABLE nomeElementoRaiz AS CHARACTER                NO-UNDO.
    DEFINE VARIABLE iTpAmb           AS INTEGER                  NO-UNDO.
    DEFINE VARIABLE cdhRecbto        AS CHARACTER                NO-UNDO.
    
    &IF int(entry(1,proversion,".")) > 9 &THEN
    COPY-LOB m-retmsg TO lcXmlNfe NO-CONVERT.
    &ENDIF
    
    SET-SIZE (m-retmsg) = 0. /*ATENCAOO: se o MEMPTR passado como parametro for usado depois dessa procedure, zerar apos o ultimo uso dele e nao aqui*/
    
    RUN extraiXML (lcXmlNFe,
                   "{&TAG_NFE}",
                   OUTPUT xmlNfe).
    
    IF  ERROR-STATUS:ERROR THEN
        RETURN.
    
    RUN extraiXML (lcXmlNFe,
                   "{&TAG_PROT}",
                   OUTPUT xmlProt).

    ASSIGN lcXmlNFe = ?.

    IF  ERROR-STATUS:ERROR THEN
        RETURN.
    
    /** GRAVA O TIPO DO AMBIENTE (1-PRODUÄ«O/2-HOMOLOGAÄ«O) NA NOTA-FISCAL **/
    xmlProt:SAVE ("LONGCHAR", lcXmlProt) NO-ERROR.

    RUN buscaTipEmisAmbSEFAZNotaFiscal (INPUT STRING(lcXmlProt), OUTPUT iTpAmb, OUTPUT cdhRecbto).

    ASSIGN lcXmlProt = ?.

    FIND CURRENT nota-fiscal EXCLUSIVE-LOCK NO-ERROR.

    IF  AVAIL nota-fiscal THEN
        ASSIGN  &IF '{&bf_dis_versao_ems}' >= '2.09':U 
                &THEN nota-fiscal.idi-tip-emis-amb-sefaz = INT(iTpAmb)
                &ELSE OVERLAY(nota-fiscal.char-2,200,1)  = STRING(iTpAmb)
                &ENDIF
                .
    
    FIND CURRENT nota-fiscal NO-LOCK NO-ERROR.
    /** FIM - GRAVA O TIPO DO AMBIENTE (1-PRODUÄ«O/2-HOMOLOGAÄ«O) NA NOTA-FISCAL **/

    IF  NUM-ENTRIES(cdhRecbto,"T") = 2 THEN
        FOR LAST ret-nf-eletro EXCLUSIVE-LOCK
           WHERE ret-nf-eletro.cod-estabel = nota-fiscal.cod-estabel
             AND ret-nf-eletro.cod-serie   = nota-fiscal.serie      
             AND ret-nf-eletro.nr-nota-fis = nota-fiscal.nr-nota-fis
             AND ret-nf-eletro.cod-msg     = "100" /* Autorizaá∆o */ :
             ASSIGN ret-nf-eletro.dat-ret     = DATE ( INT(ENTRY(2,ENTRY(1,cdhRecbto,"T"),"-")) , 
                                                       INT(ENTRY(3,ENTRY(1,cdhRecbto,"T"),"-")) , 
                                                       INT(ENTRY(1,ENTRY(1,cdhRecbto,"T"),"-")) )
                    ret-nf-eletro.hra-ret     = replace(ENTRY(2,cdhRecbto,"T"),":","") NO-ERROR.
        END.

    CREATE X-DOCUMENT xmlFinal.
    xmlFinal:ENCODING = "UTF-8".
    
    DO i = 1 TO EXTENT (xmlNodeRef):
        CREATE X-NODEREF xmlNodeRef[i].
    END.
    
    nomeElementoRaiz = (IF cancelamento THEN "procCancNfe"
                        ELSE "nfeProc").
    
    xmlFinal:CREATE-NODE (xmlNodeRef[1], nomeElementoRaiz, "ELEMENT").
    xmlNodeRef[1]:SET-ATTRIBUTE ("xmlns", "{&NAMESPACE_NFE}").
    xmlNodeRef[1]:SET-ATTRIBUTE ("xmlns:ds", "{&NAMESPACE_DS}").
    xmlNodeRef[1]:SET-ATTRIBUTE ("xmlns:xsi", "{&NAMESPACE_XSI}").
    xmlNodeRef[1]:SET-ATTRIBUTE ("versao", "{&VERSAO_NFE}").
    xmlFinal:APPEND-CHILD (xmlNodeRef[1]).
    
    RUN copiaXml (INPUT-OUTPUT xmlFinal,
                  xmlNfe).
    
    RUN copiaXml (INPUT-OUTPUT xmlFinal,
                  xmlProt).
    
    xmlFinal:SAVE ("FILE", destino) NO-ERROR.
    
    IF VALID-HANDLE (xmlNfe) THEN DELETE OBJECT xmlNfe.
    IF VALID-HANDLE (xmlFinal) THEN DELETE OBJECT xmlFinal.
    DO i = 1 TO EXTENT (xmlNodeRef):
        IF VALID-HANDLE (xmlNodeRef[i]) THEN DELETE OBJECT xmlNodeRef[i].
    END.
    
    IF ERROR-STATUS:ERROR THEN
        /* n„o foi possÌvel gravar o xml - retorne o erro Progress
         * ou trate de outra maneira, ex. gravar no diretÛrio tempor·rio*/
        RETURN .
    
    RETURN "OK".

END PROCEDURE.

PROCEDURE extraiXML:

    &IF int(entry(1,proversion,".")) > 9 &THEN
    DEFINE INPUT  PARAMETER xml          AS LONGCHAR CASE-SENSITIVE NO-UNDO.
    &ELSE
    DEFINE INPUT  PARAMETER xml          AS CHAR CASE-SENSITIVE NO-UNDO.
    &ENDIF
    DEFINE INPUT  PARAMETER nomeElemento AS CHARACTER               NO-UNDO.
    DEFINE OUTPUT PARAMETER doc          AS HANDLE                  NO-UNDO.

    DEFINE VARIABLE tagInicio   AS CHARACTER   NO-UNDO.
    DEFINE VARIABLE tagFim      AS CHARACTER   NO-UNDO.
    DEFINE VARIABLE idxInicio   AS INTEGER     NO-UNDO.
    DEFINE VARIABLE idxFim      AS INTEGER     NO-UNDO.

    ASSIGN tagInicio = SUBSTITUTE ("<&1", nomeElemento)
           tagFim    = SUBSTITUTE ("</&1>", nomeElemento)
           xml       = REPLACE (xml,"&lt;","<")
           xml       = REPLACE (xml,"&gt;",">")
           xml       = REPLACE (xml,"&quot;","~"")
           xml       = REPLACE (xml,"&amp;","&")
           xml       = REPLACE (xml,"&apos;","'")
           idxInicio = INDEX (xml, tagInicio + " ")
           /*idxFim    = R-INDEX (xml, tagFim) + LENGTH (tagFim).*/ /* No 10.1A n„o funciona */
           idxFim    = INDEX (xml, tagFim, idxInicio).        

    xml = SUBSTRING (xml, idxInicio, idxFim).

    CREATE X-DOCUMENT doc.

    doc:LOAD ('LONGCHAR', xml, NO) NO-ERROR.

END PROCEDURE.

PROCEDURE copiaXml:
    DEFINE INPUT-OUTPUT  PARAMETER xmlDestino   AS HANDLE      NO-UNDO.
    DEFINE INPUT  PARAMETER xmlFonte            AS HANDLE      NO-UNDO.

    DEFINE VARIABLE raizFonte   AS HANDLE NO-UNDO.
    DEFINE VARIABLE raizDestino AS HANDLE NO-UNDO.
    DEFINE VARIABLE nodeRef     AS HANDLE NO-UNDO.

    CREATE X-NODEREF raizFonte.
    CREATE X-NODEREF raizDestino.
    CREATE X-NODEREF nodeRef.

    xmlDestino:GET-CHILD (raizDestino, 1).
    xmlFonte:GET-DOCUMENT-ELEMENT (raizFonte).
    
    xmlDestino:CREATE-NODE (nodeRef, raizFonte:NAME, "ELEMENT").
    xmlDestino:IMPORT-NODE (nodeRef, raizFonte, YES).
    raizDestino:APPEND-CHILD (nodeRef).

    IF VALID-HANDLE (raizFonte)     THEN DELETE OBJECT raizFonte.
    IF VALID-HANDLE (raizDestino)   THEN DELETE OBJECT raizDestino.
    IF VALID-HANDLE (nodeRef)       THEN DELETE OBJECT nodeRef.

END PROCEDURE.

