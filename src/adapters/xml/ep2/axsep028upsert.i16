PROCEDURE pi-cria-ttTotal-NFCom: 
    
    CREATE ttTotal.       
    ASSIGN ttTotal.vProd           = d-total-vProd
           ttTotal.vCOFINS         = d-total-COFINS
           ttTotal.vPIS            = d-total-PIS
           ttTotal.vFUNTTEL        = d-total-vFUNTTEL
           ttTotal.vFUST           = d-total-vFUST               
           ttTotal.vDesc           = d-desconto-total
           ttTotal.vOutro          = nota-fiscal.vl-embalagem 
           ttTotal.vNF             = d-total-vProd - d-total-ret-pis - d-total-ret-cofins - d-total-ret-csll - d-total-ret-irf
           ttTotal.CodEstabelNFCom = nota-fiscal.cod-estabel
           ttTotal.SerieNFCom      = nota-fiscal.serie
           ttTotal.NrNotaFisNFCom  = nota-fiscal.nr-nota-fis.   
   
END PROCEDURE.