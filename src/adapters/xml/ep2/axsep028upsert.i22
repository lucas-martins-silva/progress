PROCEDURE pi-cria-ttFUST:

    FIND FIRST item-nf-adc USE-INDEX itmnfdc-id
         WHERE item-nf-adc.cod-estab         = nota-fiscal.cod-estabel
         AND   item-nf-adc.cod-serie         = nota-fiscal.serie
         AND   item-nf-adc.cod-nota-fisc     = nota-fiscal.nr-nota-fis
         AND   item-nf-adc.cdn-emitente      = nota-fiscal.cod-emitente
         AND   item-nf-adc.cod-natur-operac  = nota-fiscal.nat-operacao
         AND   item-nf-adc.idi-tip-dado      = 39
         AND   item-nf-adc.num-seq-item-nf   = it-nota-fisc.nr-seq-fat
         AND   item-nf-adc.cod-item          = it-nota-fisc.it-codigo
         AND   item-nf-adc.cod-livre-1       = "FUST"  no-LOCK NO-ERROR.                      
                   
    IF AVAIL item-nf-adc THEN DO:
        CREATE ttFUST.         
        ASSIGN ttFUST.CodEstabelNFCom = nota-fiscal.cod-estabel
               ttFUST.SerieNFCom      = nota-fiscal.serie
               ttFUST.NrNotaFisNFCom  = nota-fiscal.nr-nota-fis
               ttFUST.ItCodigoNFCom   = it-nota-fisc.it-codigo
               ttFUST.NrSeqFatNFCom   = it-nota-fisc.nr-seq-fat
               ttFUST.vBC             = item-nf-adc.val-livre-1     
               ttFUST.pFUST           = item-nf-adc.val-livre-2  
               ttFUST.vFUST           = item-nf-adc.val-livre-3
               d-total-vFUST          = d-total-vFUST + item-nf-adc.val-livre-3.  
    END.           
               
END PROCEDURE.
