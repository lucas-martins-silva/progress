PROCEDURE pi-calcula-valor-vOutro-por-item:

    DEFINE VARIABLE v-tot-vl-rateio-vOutro LIKE nota-fiscal.vl-embalagem NO-UNDO.
    DEFINE VARIABLE v-tot-vl-vOutro        LIKE nota-fiscal.vl-embalagem NO-UNDO.
    DEFINE VARIABLE h-bocx359              AS   HANDLE                   NO-UNDO.
    DEFINE VARIABLE l-fn-desp-exp-xml      AS   LOGICAL                  NO-UNDO.
    
    /*------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
    RATEIO VALOR OUTRAS DESPESAS
    No EMS tem-se o valor total gravado na nota. ê necess†rio enviar o valor por item. Calcula-se ent∆o um rateio com base no percentual do valor do item em relaá∆o ao total da nota.
    ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------*/

    EMPTY TEMP-TABLE tt-rateio-vOutro.

    ASSIGN v-tot-vl-rateio-vOutro = 0
           d-total-ii             = 0
           l-fn-desp-exp-xml      = CAN-FIND(FIRST funcao 
                                             WHERE funcao.cd-funcao = "spp-desp-export-xml":U 
                                               AND funcao.ativo).
           

    IF  NOT AVAIL param-global THEN
        FIND FIRST param-global NO-LOCK NO-ERROR.

    
    /*--- OBTER VALOR TOTAL DE II ---*/
    FOR FIRST docto-estoq-nfe-imp NO-LOCK
        WHERE docto-estoq-nfe-imp.cod-ser-docto    = nota-fiscal.serie 
        AND   docto-estoq-nfe-imp.cod-docto        = nota-fiscal.nr-nota-ant 
        AND   docto-estoq-nfe-imp.cdn-emitente     = nota-fiscal.cod-emitente
        AND   docto-estoq-nfe-imp.cod-natur-operac = nota-fiscal.nat-operacao :
    
        FOR EACH  item-docto-estoq-nfe-imp NO-LOCK 
            WHERE item-docto-estoq-nfe-imp.cdn-emitente     = docto-estoq-nfe-imp.cdn-emitente     
            AND   item-docto-estoq-nfe-imp.cod-docto        = docto-estoq-nfe-imp.cod-docto        
            AND   item-docto-estoq-nfe-imp.cod-ser-docto    = docto-estoq-nfe-imp.cod-ser-docto    
            AND   item-docto-estoq-nfe-imp.cod-natur-operac = docto-estoq-nfe-imp.cod-natur-operac:
            
            ASSIGN d-total-ii = d-total-ii + round(item-docto-estoq-nfe-imp.val-impto-import,2).
        END.
    END.
    /*---*/

    ASSIGN v-tot-vl-vOutro = (nota-fiscal.vl-embalagem - d-total-ii  /* retira valor do II */). /*como Ç feito p/ ttICMSTot.vOutro*/
    
    IF v-tot-vl-vOutro < 0 THEN
       ASSIGN v-tot-vl-vOutro = 0. /* correcao para nao ficar valor negativo */
    
    FIND FIRST natur-oper NO-LOCK 
         WHERE natur-oper.nat-operacao = nota-fiscal.nat-operacao NO-ERROR.
    IF AVAIL natur-oper AND SUBSTRING(natur-oper.char-1,171,1) = "1" THEN DO:
        FOR FIRST docto-estoq-nfe-imp NO-LOCK
            WHERE docto-estoq-nfe-imp.cod-ser-docto    = nota-fiscal.serie         
              AND docto-estoq-nfe-imp.cod-docto        = nota-fiscal.nr-nota-ant   
              AND docto-estoq-nfe-imp.cdn-emitente     = nota-fiscal.cod-emitente  
              AND docto-estoq-nfe-imp.cod-natur-operac = nota-fiscal.nat-operacao:
              
            ASSIGN v-tot-vl-vOutro = v-tot-vl-vOutro - DEC(TRIM(SUBSTRING(docto-estoq-nfe-imp.cod-livre-1,3,20))). /* deduz valor do AFRMM */
        END.
    END.  
    
    IF v-tot-vl-vOutro < 0 THEN
       ASSIGN v-tot-vl-vOutro = 0.  
    
    FOR EACH bf-it-nota-fisc-rat NO-LOCK
       WHERE bf-it-nota-fisc-rat.cod-estabel = nota-fiscal.cod-estabel
         AND bf-it-nota-fisc-rat.serie       = nota-fiscal.serie
         AND bf-it-nota-fisc-rat.nr-nota-fis = nota-fiscal.nr-nota-fis
        BREAK BY bf-it-nota-fisc-rat.cod-estabel
              BY bf-it-nota-fisc-rat.serie
              BY bf-it-nota-fisc-rat.nr-nota-fis
              BY bf-it-nota-fisc-rat.nr-seq-fat
              BY bf-it-nota-fisc-rat.vl-tot-item /*AAAN90*/:
    
         CREATE tt-rateio-vOutro.
         ASSIGN tt-rateio-vOutro.nr-seq-fat = bf-it-nota-fisc-rat.nr-seq-fat
                tt-rateio-vOutro.it-codigo  = bf-it-nota-fisc-rat.it-codigo
                tt-rateio-vOutro.percentual = ((bf-it-nota-fisc-rat.vl-tot-item * 100) / nota-fiscal.vl-tot-nota)
                tt-rateio-vOutro.valor      = IF bf-it-nota-fisc-rat.vl-merc-liq > 0
                                              THEN trunc(bf-it-nota-fisc-rat.vl-merc-liq / nota-fiscal.vl-mercad   * v-tot-vl-vOutro, 2)  
                                              ELSE trunc(bf-it-nota-fisc-rat.vl-tot-item / nota-fiscal.vl-tot-nota * v-tot-vl-vOutro, 2)  
                v-tot-vl-rateio-vOutro      = v-tot-vl-rateio-vOutro + tt-rateio-vOutro.valor.
    
         IF  LAST-OF (bf-it-nota-fisc-rat.cod-estabel) THEN DO:
             IF  v-tot-vl-rateio-vOutro <> v-tot-vl-vOutro THEN
                 ASSIGN tt-rateio-vOutro.valor = tt-rateio-vOutro.valor + (v-tot-vl-vOutro - v-tot-vl-rateio-vOutro).
         END.
    END.
   
    /* MODULO DE EXPORTAÄ«O IMPLANTADO */
    IF  l-fn-desp-exp-xml
    AND CONNECTED("mgcex":U)
    AND param-global.modulo-ex THEN DO:

        IF  nota-fiscal.nat-operacao BEGINS "7" 
        AND nota-fiscal.nr-proc-exp <> "" 
        AND (    AVAIL emitente 
             AND (emitente.natureza = 3 OR emitente.natureza = 4)) THEN DO:
        
            IF NOT VALID-HANDLE(h-bocx359) THEN 
                RUN cxbo/bocx359.p PERSISTENT SET h-bocx359.
                
            /* Para notas avulsas entrava na procedure e como n∆o h† tabela proc-it-nota-desp o temporaria do rateio ficava zerada, ocasionando erros nas tags vSeg */
            IF CAN-FIND(FIRST proc-it-nota-desp NO-LOCK
                        WHERE proc-it-nota-desp.cod-estab-faturam = nota-fiscal.cod-estabel
                        AND   proc-it-nota-desp.serie             = nota-fiscal.serie
                        AND   proc-it-nota-desp.nr-nota-fis       = nota-fiscal.nr-nota-fis) THEN DO:
                        
                RUN piRateioDespesasExportacaoXML IN h-bocx359 (INPUT rowid(nota-fiscal),
                                                                INPUT 4, /*despesas do tipo Embalagem*/
                                                                OUTPUT TABLE tt-rateio-vOutro).
            END.
             
            IF VALID-HANDLE(h-bocx359) THEN DO:
                DELETE PROCEDURE h-bocx359.
                ASSIGN h-bocx359 = ?.
            END.
        END.
    END.
      
    ASSIGN v-tot-vl-rateio-vOutro = 0
           d-total-ii             = 0.

END PROCEDURE.
