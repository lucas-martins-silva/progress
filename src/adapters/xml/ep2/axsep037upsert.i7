PROCEDURE pi-grava-temp-tables:

    DEF VAR c-serie               LIKE nota-fiscal.serie        NO-UNDO.
    DEF VAR c-nr-nota             LIKE nota-fiscal.nr-nota-fis  NO-UNDO.
    DEF VAR i-cod-emitente        LIKE nota-fiscal.cod-emitente NO-UNDO.
    DEF VAR c-nat-operacao        LIKE nota-fiscal.nat-operacao NO-UNDO.
    DEF VAR c-endereco            AS   CHAR FORMAT "x(200)":U   NO-UNDO.

    DEF VAR l-iss                 AS LOG                        NO-UNDO.
    DEF VAR l-calc-config         AS LOG                        NO-UNDO.
    DEF VAR l-funcao-end-completo AS LOG                        NO-UNDO.
    DEF VAR l-trunca              AS LOG                        NO-UNDO.

    DEF VAR de-embal-it           LIKE wt-docto.vl-embalagem    NO-UNDO.
    DEF VAR de-seguro-it          LIKE wt-docto.vl-seguro       NO-UNDO.

    {cdp/cd4300.i3}  /* include tratamento atributo livre */
    {cxbo/bocx250.i50} /* include tratamento atributo livre param-imp.char-1 */

    FIND FIRST para-fat NO-LOCK NO-ERROR.

    ASSIGN l-trunca  = IF nota-fiscal.mo-codigo = "0"
                          THEN (para-fat.arre-calc-int-p = 1)  /* Calculos intermediarios - Padrao */
                          ELSE (para-fat.arre-calc-int-f = 1). /* Calculos intermediarios - Forte  */

    &GLOBAL-DEFINE log-icms-substto-antecip bf-natur-oper-it.log-icms-substto-antecip
    &GLOBAL-DEFINE log-devol-icms-st-contrib-subs TRIM(SUBSTRING(bf-natur-oper-it.char-1,163,1)) = "S"

    ASSIGN l-retira-out-desp-obs  = CAN-FIND(FIRST funcao
                                             WHERE funcao.cd-funcao = "SPP-RETIRA-OUT-DESP-OBS"
                                             AND   funcao.ativo).

    /* ICMS ST ANTECIP - Substitu°do Tribut†rio */
    ASSIGN l-substituido-st-ant  = CAN-FIND(FIRST funcao
                                            WHERE funcao.cd-funcao = "SPP-FIS|Substitu°do-ST-ANT|01"
                                            AND   funcao.ativo).

    /* Majora ICMS ST com FCP ST funá∆o por estado - EX: MT */
    ASSIGN l-Majora-FCP = CAN-FIND(FIRST funcao NO-LOCK
                                   WHERE funcao.cd-funcao = ("spp-majora-fcp-" + nota-fiscal.estado)
                                     AND funcao.ativo = YES).

    ASSIGN  l-funcao-end-completo = CAN-FIND(FIRST funcao
                                             WHERE funcao.cd-funcao = 'spp-nfe-end-completo':U
                                               AND funcao.ativo = YES).

    RUN pi-cria-ttNFe.
    RUN pi-cria-ttIde.
    RUN pi-cria-ttrefECF.
    RUN pi-cria-ttEmit.
    RUN pi-cria-ttDest.
    RUN pi-cria-ttRetirada.

    /* Somente criar ttEntrega se endereáo de entrega for diferente do endereáo do cliente */
    IF l-funcao-end-completo AND fn-trata-caracteres(emitente.endereco_text) > "" THEN
       ASSIGN c-endereco = fn-trata-caracteres(TRIM(emitente.endereco_text)).
    ELSE
       ASSIGN c-endereco = TRIM(emitente.endereco).

    {ftp/ft0114.i1 nota-fiscal.cod-estabel nota-fiscal.serie l-simplificadoTipo2}   
       
    /* Pedido de origem e-commerce */
    IF AVAIL nota-fiscal AND
       CAN-FIND(FIRST ped-venda
                WHERE ped-venda.nome-abrev = nota-fiscal.nome-ab-cli
                  AND ped-venda.nr-pedcli  = nota-fiscal.nr-pedcli
                  AND ped-venda.origem     = 22 NO-LOCK) THEN
       ASSIGN c-endereco = STRING(c-endereco,"x(40)").


    IF AVAIL emitente
    AND ( (i-natureza > 1 AND emitente.natureza = i-natureza) OR /* Pessoa Fisica */
          (i-natureza = 1 AND l-prod-rural = NO) OR
          (i-natureza = 1 AND l-prod-rural       AND
          LENGTH(REPLACE(REPLACE(REPLACE(REPLACE(nota-fiscal.cgc, ".":U, "":U), "/":U, "":U), "\":U, "":U), "-":U, "":U)) > 11  ) )
    AND ( REPLACE(REPLACE(REPLACE(emitente.cgc,"-",""),".",""),"/","") <> REPLACE(REPLACE(REPLACE(nota-fiscal.cgc,"-",""),".",""),"/","")  OR
         (( fn-ajusta-campo-IE(emitente.ins-estadual)                  <> fn-ajusta-campo-IE(nota-fiscal.ins-estadual) ) AND
          ((nota-fiscal.ins-estadual <> "ISENTO" AND
            nota-fiscal.ins-estadual <> "ISENTA" AND
            nota-fiscal.ins-estadual <> "")      OR
           (emitente.ins-estadual <> "ISENTO"    AND
            emitente.ins-estadual <> "ISENTA"    AND
            emitente.ins-estadual <> "")))       OR
          (IF  l-funcao-end-completo
           AND fn-trata-caracteres(trim(nota-fiscal.endereco_text)) <> "" then
               c-endereco <> fn-trata-caracteres(trim(nota-fiscal.endereco_text))
           else
               c-endereco          <> nota-fiscal.endereco)  OR
          emitente.bairro          <> nota-fiscal.bairro     OR
          emitente.cidade          <> nota-fiscal.cidade     OR
          emitente.estado          <> nota-fiscal.estado     OR
          emitente.pais            <> nota-fiscal.pais       OR
          emitente.cep             <> nota-fiscal.cep )      THEN
        RUN pi-cria-ttEntrega.

    RUN pi-cria-ttAutXML.

    IF  AVAIL emitente
    AND emitente.natureza = 3 /* Estrangeiro */  THEN
        RUN pi-cria-ttExporta.

    ASSIGN c-serie        = nota-fiscal.serie
           c-nr-nota      = nota-fiscal.nr-nota-ant
           i-cod-emitente = nota-fiscal.cod-emitente
           c-nat-operacao = nota-fiscal.nat-operacao.

    IF  l-nota-compl-imp OR l-nota-cred-deb-import 
    OR  l-nota-ajuste-import THEN 
        FOR FIRST nota-fisc-adc NO-LOCK
            WHERE nota-fisc-adc.cod-estab               = nota-fiscal.cod-estabel
             AND   nota-fisc-adc.cod-serie              = nota-fiscal.serie
             AND   nota-fisc-adc.cod-nota-fisc          = nota-fiscal.nr-nota-fis
             AND   nota-fisc-adc.cdn-emitente           = nota-fiscal.cod-emitente
             AND   nota-fisc-adc.cod-natur-operac       = nota-fiscal.nat-operacao
             AND   nota-fisc-adc.idi-tip-dado           = 3
             AND (   nota-fisc-adc.idi-tip-docto-referado = 2
                  OR (    nota-fiscal.ind-tip-nota = 8 /* Entrada */
                      AND nota-fisc-adc.idi-tip-docto-referado = 1))
             AND  STRING(INT(nota-fisc-adc.cod-model-docto-referado),"99") <> "04": /*Desconsiderar notas de modelo 04, que Ç modelo para Produtor Rural*/

            FOR FIRST b-nota-fiscal NO-LOCK
                WHERE b-nota-fiscal.cod-estabel  = nota-fiscal.cod-estabel
                  AND b-nota-fiscal.serie        = nota-fisc-adc.cod-ser-docto-referado
                  AND b-nota-fiscal.nr-nota-fis  = nota-fisc-adc.cod-docto-referado
                  AND b-nota-fiscal.cod-emitente = nota-fisc-adc.cdn-emit-docto-referado:

                ASSIGN c-serie        = b-nota-fiscal.serie
                       c-nr-nota      = b-nota-fiscal.nr-nota-fis
                       i-cod-emitente = b-nota-fiscal.cod-emitente
                       c-nat-operacao = b-nota-fiscal.nat-operacao.
            END.
        END.

    RUN pi-cria-ttDI (INPUT c-serie,
                      INPUT c-nr-nota,
                      INPUT i-cod-emitente,
                      INPUT c-nat-operacao).

    FOR EACH it-nota-fisc OF nota-fiscal NO-LOCK:

	    ASSIGN l-gEstornoCred = can-find(first it-nota-fisc-trib where
										 it-nota-fisc-trib.cod-estabel   = it-nota-fisc.cod-estabel and
										 it-nota-fisc-trib.serie         = it-nota-fisc.serie       and
										 it-nota-fisc-trib.nr-nota-fis   = it-nota-fisc.nr-nota-fis and
										 it-nota-fisc-trib.nr-seq-fat    = it-nota-fisc.nr-seq-fat  and
										 it-nota-fisc-trib.it-codigo     = it-nota-fisc.it-codigo   and
										 it-nota-fisc-trib.estorno-cred  = YES no-lock) .

        FOR FIRST bf-natur-oper-it NO-LOCK
            WHERE bf-natur-oper-it.nat-operacao = it-nota-fisc.nat-operacao:
        END.

        /* Variavel que define se os valores de STA ser∆o somados no total da nota ou n∆o.                     */
        /* YES = ser∆o apresentados o ICMS STA e FCP STA na tag vOutro e somados no total da nota              */
        /* NO  = ser∆o apresentados o ICMS STA e FCP STA no grupo ICMS60 somente, e n∆o somam no total da nota */
        IF  it-nota-fisc.ind-icm-ret THEN
            ASSIGN l-soma-icms-st-antecip = NO.
        ELSE
            ASSIGN l-soma-icms-st-antecip =  (        l-substituido-st-ant                      /* Funá∆o SPP-FIS|Substitu°do-ST-ANT|01                                                   */
                                              AND     bf-natur-oper-it.log-icms-substto-antecip /* ParÉmetro ICMS Subs Trib Antecip que define se a operaá∆o Ç de STA                */
                                              AND NOT bf-natur-oper-it.log-contrib-st-antec)    /* ParÉmetro Contrib Substitu°do Antecip que define se deve somar no total da nota ou n∆o */
                                             OR (     NOT l-substituido-st-ant
                                                 AND  bf-natur-oper-it.log-icms-substto-antecip ).

        ASSIGN l-pis-cofins-st-total         = NO
               l-ipi-outras-total            = NO
               l-funcao-DESCONTO-NFE         = NO
               l-omite-val-totais-sn-icms    = NO
               l-omite-val-totais-sn-icms-st = NO.

        IF  nota-fiscal.ind-tip-nota <> 8 OR /*n∆o Ç recebimento*/
           (nota-fiscal.ind-tip-nota = 8 AND nota-fiscal.esp-docto = 20) THEN DO: /*devol cli*/
            FOR FIRST ITEM NO-LOCK
                WHERE ITEM.it-codigo = it-nota-fisc.it-codigo:

                ASSIGN l-pis-cofins-st-total = TRIM(SUBSTR(ITEM.char-1,50,5)) = "Sim":U OR
                                               TRIM(SUBSTR(ITEM.char-1,50,5)) = "":U. /* bodi317im1br.m36*/
            END.
        END.
        ELSE DO:
            IF nota-fiscal.ind-tip-nota = 8 THEN
                ASSIGN l-pis-cofins-st-total = YES.

            FOR FIRST ITEM NO-LOCK
                WHERE ITEM.it-codigo = it-nota-fisc.it-codigo: END.
        END.

        /* Tabela Extens∆o da it-nota-fisc - informaá‰es extras */
        FOR FIRST ext-it-nota-fisc NO-LOCK
            WHERE ext-it-nota-fisc.cod-estabel = it-nota-fisc.cod-estabel
              AND ext-it-nota-fisc.serie       = it-nota-fisc.serie
              AND ext-it-nota-fisc.nr-nota-fis = it-nota-fisc.nr-nota-fis
              AND ext-it-nota-fisc.nr-seq-fat  = it-nota-fisc.nr-seq-fat
              AND ext-it-nota-fisc.it-codigo   = it-nota-fisc.it-codigo
              AND ext-it-nota-fisc.cod-param   = "inf-NFe":U:
        END.

        ASSIGN l-sem-iss = NO.
        /*-------------------UPC Retira tags ISSQN XML -------------------*/
        IF  c-nom-prog-dpc-mg97  <> "" OR
            c-nom-prog-appc-mg97 <> "" OR
            c-nom-prog-upc-mg97  <> "" THEN DO:

            FOR EACH  tt-epc
                WHERE tt-epc.cod-event     = "before-cria-imposto":U :
                DELETE tt-epc.
            END.

            CREATE tt-epc.
            ASSIGN tt-epc.cod-event     = "before-cria-imposto":U
                   tt-epc.cod-parameter = "rowid-itnotafisc":U
                   tt-epc.val-parameter = STRING(ROWID(it-nota-fisc)).

            {include/i-epc201.i "before-cria-imposto"}

            FOR FIRST tt-epc WHERE
                tt-epc.cod-event     = "before-cria-imposto":U AND
                tt-epc.cod-parameter = "sem-iss":U:

                ASSIGN l-sem-iss = IF tt-epc.val-parameter = "yes" THEN YES ELSE NO.
            END.
        END.
        /*-------------------UPC Retira tags ISSQN XML -------------------*/

        RUN pi-cria-ttDet.
        RUN pi-cria-ttRefNFP. /*Produtor Rural*/
        IF  NOT CAN-FIND (FIRST ttDFeReferenciado
                          WHERE ttDFeReferenciado.CodEstabelNF = nota-fiscal.cod-estabel
                          AND   ttDFeReferenciado.SerieNF      = nota-fiscal.serie
                          AND   ttDFeReferenciado.NrNotaFisNF  = nota-fiscal.nr-nota-fis) THEN
             RUN pi-cria-ttrefNF.
        RUN pi-cria-ttAdi.

        IF  AVAIL emitente
        AND emitente.natureza = 3 /* Estrangeiro */  THEN
            RUN pi-cria-ttDetExport.

        RUN pi-cria-ttmed.
        RUN pi-cria-ttrastro.

        RUN pi-cria-ttComb. /*Informaá‰es de Combust°veis*/

        IF l-simplificadoTipo2 = "NO" then
        RUN pi-cria-ttIPI. /*NF-e 3.10 - permite IPI e ISSQN no mesmo item*/

        /* A leitura do configurador precisa ficar nesse ponto devido as funá‰es que impactam no valor da nota */
        /* Pega o valor do ICMS Desonerado salvo no item da nota que veio do configurador */

	    ASSIGN l-calc-config   = NO
                   l-indDeduzDeson = YES. /* Deduz ICMS Desonerado */

        FOR FIRST ct-trib-item-nota-fisc NO-LOCK
            WHERE ct-trib-item-nota-fisc.cod-estab     = it-nota-fisc.cod-estabel
              AND ct-trib-item-nota-fisc.cod-serie     = it-nota-fisc.serie
              AND ct-trib-item-nota-fisc.cod-nota-fisc = it-nota-fisc.nr-nota-fis
              AND ct-trib-item-nota-fisc.num-seq       = it-nota-fisc.nr-seq-fat
              AND ct-trib-item-nota-fisc.cod-item      = it-nota-fisc.it-codigo
              AND ct-trib-item-nota-fisc.cod-tip-trib  = "ICMS Desonerado":

            ASSIGN d-vl-desc-icms  = ct-trib-item-nota-fisc.val-trib
                   l-calc-config   = yes
                   l-indDeduzDeson = ct-trib-item-nota-fisc.log-livre-4.

        END.

        FOR FIRST estabelec
            WHERE estabelec.cod-estabel = nota-fiscal.cod-estabel NO-LOCK:
        END.

        /* Funá∆o para gerar as tags do FCP diferido CT 51 com base no estado do estabelecimento */
        ASSIGN l-FCP-Diferido = CAN-FIND(FIRST funcao NO-LOCK
                                     WHERE funcao.cd-funcao = ("spp-fcp-diferido-" + estabelec.estado)
                                     AND   funcao.ativo     = YES).

        IF CAN-FIND(FIRST funcao
                    WHERE funcao.cd-funcao = "spp-deson-simbol-" + estabelec.estado
                      AND funcao.ativo = YES)
                      AND d-vl-desc-icms = 0
                      AND (it-nota-fisc.per-des-icms > 0 OR l-calc-config) /* Para indicar que houve c·lculo do ICMS Desonerado */
                      AND TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2)) <> ""
                      AND TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2)) <> "0" THEN
                      ASSIGN d-vl-desc-icms = 0.01.

        IF TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2)) <> ""  AND
           TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2)) <> "0" AND
           nota-fiscal.ind-tip-nota  = 8 THEN DO: /*Origem Recebimento*/
            FOR FIRST ext-item-doc-est NO-LOCK
                WHERE ext-item-doc-est.serie-docto  = nota-fiscal.serie
                  AND ext-item-doc-est.nro-docto    = nota-fiscal.nr-nota-ant
                  AND ext-item-doc-est.cod-emitente = nota-fiscal.cod-emitente
                  AND ext-item-doc-est.nat-operacao = nota-fiscal.nat-operacao
                  AND ext-item-doc-est.sequencia    = it-nota-fisc.nr-seq-ped
                  AND ext-item-doc-est.cod-param    = "icms-deson":U:
                ASSIGN d-vl-desc-icms  = ROUND(ext-item-doc-est.val-livre-2, 2) /*valor desconto icms*/
                       l-indDeduzDeson = ext-item-doc-est.log-livre-1.          /*Indica se Deduz Desonerado*/

            END.
        END.
        /* Caso n∆o tenha mensagem do ICMS Desonerado e tenha valor retornado pelo configurador cria a mensagem */
        IF nota-fiscal.ind-tip-nota <> 8
        AND d-vl-desc-icms > 0 THEN DO:
            IF NOT ttDet.infAdProd MATCHES "*Valor do ICMS deson*" THEN DO:
                ASSIGN ttDet.infAdProd = ttDet.infAdProd +
                                         " | Valor do ICMS desonerado: R$ " + STRING(d-vl-desc-icms,">>>,>>>,>>9.99") + ".".
            END.
        END.

        /* O grupo ISSQN Ç mutuamente exclusivo com os grupos ICMS */
        /* e II, isto Ç se ISSQN for informado os grupos ICMS e    */
        /* II n∆o ser∆o informados e viceversa (v2.0).             */
    	IF  (nota-fiscal.ind-tip-nota  = 8    /*no recebimento verificar apenas it-nota-fisc, para nao dar problema em notas de devolucao*/
        AND  it-nota-fisc.cod-servico <> 0)
        OR  (nota-fiscal.ind-tip-nota <> 8 AND it-nota-fisc.cod-servico <> 0 AND NOT l-sem-iss) THEN DO:

            ASSIGN l-iss = YES.

            RUN pi-cria-ISS.
        END.
        ELSE DO:

            RUN pi-informacoes-item.

            IF NOT AVAIL ttEmit THEN
               FIND FIRST ttEmit NO-ERROR.

            IF AVAIL ttEmit AND (ttEmit.IEST = ? OR ttEmit.IEST = "") THEN DO:
                  ASSIGN ttEmit.IEST = TRIM(estab-uf.ins-estadual) WHEN AVAIL estab-uf
                         ttEmit.IEST = fn-ajusta-campo-IE(ttEmit.IEST)
                         ttEmit.IEST = fn-ajusta-tamanho-campo(ttEmit.IEST,14) NO-ERROR.

            END.

            IF (ttEmit.CRT = "1":U OR ttEmit.CRT = "4":U)
	           &if "{&bf_dis_versao_ems}" >= "2.09" &then
               AND ( ( nota-fiscal.VAL-PERC-ICMS-SIMPLES-NAC <> 0
               AND nota-fiscal.ind-tip-nota = 8 )
               OR nota-fiscal.ind-tip-nota <> 8 )
               &ELSE
               AND ( ( DEC(SUBSTRING(nota-fiscal.char-1,238,10)) <> 0
               AND nota-fiscal.ind-tip-nota = 8 )
               OR nota-fiscal.ind-tip-nota <> 8 )
               &ENDIF THEN   /*Gerar nota de Simples Nacional com CSOSN somente para notas de sa°da*/
                   RUN pi-cria-ICMSSN. /*Simples Nacional*/
               ELSE
                   RUN pi-cria-ICMS.

            FOR FIRST item
                WHERE item.it-codigo = it-nota-fisc.it-codigo no-lock:
            END.
            FIND FIRST param-gener NO-LOCK
                WHERE  param-gener.cod-chave-1 = TRIM(SUBSTRING(item.char-1,268,20)) /* ANP */
                AND    param-gener.cod-param   = "infANP-CD0618":U NO-ERROR.

                IF AVAIL param-gener
                AND param-gener.log-livre-4 = YES THEN DO:
                    IF SUBSTRING(c-niv-trib-icms,2,2) = "53"
                    OR SUBSTRING(c-niv-trib-icms,2,2) = "61" THEN
                        FOR FIRST ct-trib-item-nota-fisc NO-LOCK
                            WHERE ct-trib-item-nota-fisc.cod-estab         = it-nota-fisc.cod-estabel
                            AND   ct-trib-item-nota-fisc.cod-serie         = it-nota-fisc.serie
                            AND   ct-trib-item-nota-fisc.cod-nota-fisc     = it-nota-fisc.nr-nota-fis
                            AND   ct-trib-item-nota-fisc.num-seq           = it-nota-fisc.nr-seq-fat
                            AND   ct-trib-item-nota-fisc.cod-item          = it-nota-fisc.it-codigo
                            AND   ct-trib-item-nota-fisc.num-livre-2       <> 0:

                            FIND FIRST mensagem
                                WHERE  mensagem.cod-mensagem = ct-trib-item-nota-fisc.num-livre-2 NO-LOCK NO-ERROR.
                            IF AVAIL   mensagem THEN
                                ASSIGN ttDet.infAdProd = ttDet.infAdProd + " | " + mensagem.texto-mensag.
                    END.
                END.
                ELSE DO:
                    IF SUBSTRING(c-niv-trib-icms,2,2) = "53" THEN
                        ASSIGN ttDet.infAdProd = ttDet.infAdProd + " | ICMS monof†sico sobre combust°veis diferido conforme Convànio ICMS 199/2022;".
                    IF SUBSTRING(c-niv-trib-icms,2,2) = "61" THEN
                        ASSIGN ttDet.infAdProd = ttDet.infAdProd + " | ICMS monof†sico sobre combust°veis cobrado anteriormente conforme Convànio ICMS 199/2022;".   .
                END.

            /* Informaá‰es complementares no Danfe */
            IF SUBSTRING(c-niv-trib-icms,2,2) = "02" THEN
                ASSIGN ttDet.infAdProd = ttDet.infAdProd + " | ICMS monof†sico pr¢prio: BC " + TRIM(STRING(ttICMS02.qBCMono,">>>>>>>>>>>>9.9999")) + ";" + " Al°quota: R$" + TRIM(STRING(ttICMS02.adRemICMS, ">>9.9999")) + ";" + " ICMS mono: R$" + TRIM(STRING(ttICMS02.vICMSMono,">>>>>>>>>>>>9.99")) + ";".
            IF SUBSTRING(c-niv-trib-icms,2,2) = "15" THEN
                ASSIGN ttDet.infAdProd = ttDet.infAdProd + " | ICMS monof†sico pr¢prio: BC " + TRIM(STRING(ttICMS15.qBCMono,">>>>>>>>>>>>9.9999")) + ";" + " Al°quota: R$" + TRIM(STRING(ttICMS15.adRemICMS, ">>9.9999")) + ";" + " ICMS mono: R$" + TRIM(STRING(ttICMS15.vICMSMono,">>>>>>>>>>>>9.99"))
                                                         + " | ICMS monof†sico sujeito a retená∆o: BC " + TRIM(STRING(ttICMS15.qBCMonoReten,">>>>>>>>>>>>9.9999")) + ";" + " Al°quota: R$" + TRIM(STRING(ttICMS15.adRemICMSReten, ">>9.9999")) + ";" + " ICMS mono: R$" + TRIM(STRING(ttICMS15.vICMSMonoReten,">>>>>>>>>>>>9.99")) + ";".

            RUN pi-cria-ttII.

        END.

        RUN ftp/ftapi510.p (INPUT  ROWID(nota-fiscal),
                            INPUT  ROWID(it-nota-fisc),
                            OUTPUT d-aliq-pis,
                            OUTPUT d-base-pis,
                            OUTPUT d-valor-pis,
                            OUTPUT d-aliq-cofins,
                            OUTPUT d-base-cofins,
                            OUTPUT d-valor-cofins).

        RUN pi-cria-ttPIS.

        RUN pi-cria-ttCOFINS.

        RUN pi-cria-ttICMSUFDest. /* NT2015.003 - Emenda Constitucional 87/2015 */

        IF  (ttIde.finNFe = "4":U OR /* 4 - Devolucao */
             ttIde.finNFe = "5":U)   /* 5 - Nota de CrÇdito */
        AND nota-fiscal.esp-docto = 20 THEN
            RUN pi-cria-ttImpostoDevol.

        assign l-transf-cred = no.
        if ttIde.finNFe = "6" // DÇbito
        and (tpNFDebito = "01" OR tpNFDebito = "05") // Transferància para Cooperativa ou Sucess∆o
        or (nota-fiscal.ind-tip-nota = 8 /*Nota de entrada*/
        and ttIde.finNFe = "5" and  /*Nota de CrÇdito*/
            tpNFCredito = "05") /*Transferància de crÇdito na sucess∆o*/
        THEN
          assign l-transf-cred = yes.

        /** Inicio Impostos da Reforma Tribut†ria **/
        if  l-NT2024002 THEN DO:
            ASSIGN l-estorno-cred = NO.
           if ttIde.finNFe = "6" then do: // DÇbito

              assign l-transf-cred  = no
                     l-ajust-compet = no.

              // Os Tipos de Notas de Debito abaixo n∆o geram o grupo gIBSCBS
              case tpNFDebito:
                when "01" then assign l-transf-cred  = yes. // Transferància de crÇditos para Cooperativas
                when "02" then assign l-ajust-compet = yes. // Anulaá∆o de CrÇdito por Sa°das Imunes/Isentas
                when "03" then assign l-ajust-compet = yes. // DÇbitos de notas fiscais n∆o processadas na apuraá∆o
                when "05" then assign l-transf-cred  = yes. // Transferància de crÇdito na sucess∆o
                when "07" then assign l-estorno-cred = yes. // Perda em estoque
                when "08" then assign l-ajust-compet = yes. // Desenquadramento do SN
              end case.
           end.

           if  l-gEstornoCred THEN
               assign l-transf-cred  = no
                      l-ajust-compet = no
                      l-estorno-cred = YES.

           assign d-total-vItem = ttDet.vprod - ttDet.vDesc.

           if l-indDeduzDeson = yes then
               assign d-total-vItem = d-total-vItem - it-nota-fisc.dec-1 -  d-vl-desc-icms. //ICMS Desonerado

           for each it-nota-fisc-trib where
               it-nota-fisc-trib.cod-estabel   = it-nota-fisc.cod-estabel and
               it-nota-fisc-trib.serie         = it-nota-fisc.serie       and
               it-nota-fisc-trib.nr-nota-fis   = it-nota-fisc.nr-nota-fis and
               it-nota-fisc-trib.nr-seq-fat    = it-nota-fisc.nr-seq-fat  and
               it-nota-fisc-trib.it-codigo     = it-nota-fisc.it-codigo   no-lock
               break by it-nota-fisc-trib.nr-seq-fat:

               ASSIGN l-DeduzCredPres-ibs-uf = NO.
               IF  it-nota-fisc-trib.tip-tributo = 2
               AND CAN-FIND(FIRST cred-pres NO-LOCK
                            WHERE cred-pres.cod-cred-pres   = it-nota-fisc-trib.cod-clas-cred-presum
                            AND   cred-pres.deduz-cred-pres = 1) THEN
                   ASSIGN l-DeduzCredPres-ibs-uf = YES.

               run pi-cria-ttIBSCBS.
                              
               IF it-nota-fisc-trib.tip-tributo = 1       AND /* CBS */
                  it-nota-fisc-trib.valor-efet-alczfm > 0 THEN DO: 
                  run pi-cria-ttgALCZFMCBS.
               END.                  

               if it-nota-fisc-trib.log-compra-gov = yes then do: // Compra Governamental
                  run pi-cria-ttgCompraGov.
                  run pi-cria-ttgTribCompraGov.
               end.

               if not (l-transf-cred) and not(l-ajust-compet) and
                  not (l-estorno-cred) then do:

                  if it-nota-fisc-trib.log-mono = yes then // Monof†sico
                     run pi-cria-ttgIBSCBSMono.
                  else
                     run pi-cria-ttTribRT.
               end.

               /* CrÇdito Presumido apenas para 1-CBS ou 2 IBS UF */
               if it-nota-fisc-trib.tip-tributo = 1 or it-nota-fisc-trib.tip-tributo = 2 then
                  run pi-cria-ttPresumido.

               /* vIBS = vIBSUF + vIBSMun - vCredPres (se indDeduzCredPres=1) */
               IF l-DeduzCredPres-ibs-uf THEN
                  ASSIGN d-total-vIBS  = d-total-vIBS  - it-nota-fisc-trib.valor-cred-presum.

               case it-nota-fisc-trib.tip-tributo:
                  when 1 then do:
                     assign d-total-nf-deb-cred-vCBS = it-nota-fisc-trib.valor-tributo.
                  end.
                  when 2 then do:
                     assign d-total-nf-deb-cred-vIBS = d-total-nf-deb-cred-vIBS + it-nota-fisc-trib.valor-tributo.
                  end.
                  when 3 then do:
                     assign d-total-nf-deb-cred-vIBS = d-total-nf-deb-cred-vIBS + it-nota-fisc-trib.valor-tributo.
                  end.
               end case.

               if not it-nota-fisc-trib.log-compra-gov 
               and it-nota-fisc-trib.cod-cst-regul        <> ""
               and it-nota-fisc-trib.cod-class-trib-regul <> "" then do:

                   assign c-cst-reg        = it-nota-fisc-trib.cod-cst-regul
                          c-class-trib-reg = it-nota-fisc-trib.cod-class-trib-regul.

                   case it-nota-fisc-trib.tip-tributo:
                      when 1 then do:
                         assign d-aliq-efet-reg-cbs      = it-nota-fisc-trib.aliq-regul
                                d-trib-reg-cbs           = it-nota-fisc-trib.valor-regul.
                      end.
                      when 2 then do:
                         assign d-aliq-efet-reg-ibs-uf   = it-nota-fisc-trib.aliq-regul
                                d-trib-reg-ibs-uf        = it-nota-fisc-trib.valor-regul.
                      end.
                      when 3 then do:
                         assign d-aliq-efet-reg-ibs-mun  = it-nota-fisc-trib.aliq-regul
                                d-trib-reg-ibs-mun       = it-nota-fisc-trib.valor-regul.
                      end.
                   end case.

               end.

               if last-of(it-nota-fisc-trib.nr-seq-fat) then do:

                  if  it-nota-fisc-trib.cod-cst-regul        <> ""
                  and it-nota-fisc-trib.cod-class-trib-regul <> "" then
                     run pi-cria-ttgTribRegular.

                  if l-transf-cred or l-ajust-compet or
                     l-estorno-cred then do:

                     IF  l-transf-cred or l-ajust-compet THEN
                         assign d-total-vIBSUF = d-total-vIBSUF + d-total-nf-deb-cred-vIBS
                                d-total-vIBS   = d-total-vIBS   + d-total-nf-deb-cred-vIBS
                                d-total-vCBS   = d-total-vCBS   + d-total-nf-deb-cred-vCBS.

                     if l-ajust-compet then
                        run pi-cria-ttgAjusteCompet.
                     else
                        if l-estorno-cred then
                           run pi-cria-ttgEstornoCred.
                        else
                           run pi-cria-ttgTransfCred.
                  end.

                  assign c-cst-reg                = ""
                         c-class-trib-reg         = ""
                         d-aliq-efet-reg-cbs      = 0
                         d-trib-reg-cbs           = 0
                         d-aliq-efet-reg-ibs-uf   = 0
                         d-trib-reg-ibs-uf        = 0
                         d-aliq-efet-reg-ibs-mun  = 0
                         d-trib-reg-ibs-mun       = 0
                         d-total-nf-deb-cred-vCBS = 0
                         d-total-nf-deb-cred-vIBS = 0.
               END.
           END.

           ASSIGN de-embal-it   = IF l-trunca
                                  THEN TRUNC(it-nota-fisc.vl-merc-liq  / nota-fiscal.vl-mercad * nota-fiscal.vl-embalagem, 2)
                                  ELSE ROUND(it-nota-fisc.vl-merc-liq  / nota-fiscal.vl-mercad * nota-fiscal.vl-embalagem, 2)
                  de-seguro-it  = IF l-trunca
                                  THEN TRUNC(it-nota-fisc.vl-merc-liq  / nota-fiscal.vl-mercad * nota-fiscal.vl-seguro, 2)
                                  ELSE ROUND(it-nota-fisc.vl-merc-liq  / nota-fiscal.vl-mercad * nota-fiscal.vl-seguro, 2).

           ASSIGN d-total-vItem = d-total-vItem             +
                                  it-nota-fisc.vl-frete-it  +
                                  it-nota-fisc.vl-icmsub-it + /* ICMS ST */
                                  de-seguro-it              +
                                  de-embal-it.

           IF it-nota-fisc.cd-trib-ipi = 1 THEN
               ASSIGN d-total-vItem = d-total-vItem + it-nota-fisc.vl-ipi-it.

           /* FCP ST tambÇm precisa somar */
           FOR FIRST item-nf-adc NO-LOCK
               WHERE item-nf-adc.cod-estab         = it-nota-fisc.cod-estabel
               AND   item-nf-adc.cod-serie         = it-nota-fisc.serie
               AND   item-nf-adc.cod-nota-fisc     = it-nota-fisc.nr-nota-fis
               AND   item-nf-adc.idi-tip-dado      = 25
               AND   item-nf-adc.cdn-emitente      = it-nota-fisc.cd-emitente
               AND   item-nf-adc.cod-natur-operac  = it-nota-fisc.nat-operacao
               AND   item-nf-adc.num-seq-item-nf   = it-nota-fisc.nr-seq-fat
               AND   item-nf-adc.cod-item          = it-nota-fisc.it-codigo:

               IF (item-nf-adc.log-livre-2 = ? /* Nova geracao de FCP -> FCP e FCP ST juntos no mesmo item da nota */
               AND (   item-nf-adc.val-livre-1      > 0  /* Valores de FCP ST */
                    OR item-nf-adc.val-livre-2      > 0
                    OR DEC(item-nf-adc.cod-livre-4) > 0))
               OR  item-nf-adc.log-livre-1 = YES  /* NO = FCP Normal | YES = FCP ST */ /* Geraªío de dados antiga FCP ou FCP ST */  THEN
                   ASSIGN d-total-vItem = d-total-vItem + DEC(item-nf-adc.cod-livre-4).
           END.

           IF NOT AVAIL param-imp THEN
               FIND FIRST param-imp
                    WHERE param-imp.cod-estabel = it-nota-fisc.cod-estabel NO-LOCK NO-ERROR.

           IF AVAIL param-imp THEN DO:
               {cdp/cd4300.i4 "yes" param-imp.char-1}
               {cxbo/bocx250.i51 "yes"} /* Include que alimenta o i-desp-ii-i50 e o i-emitente-ii-i50 com o cΩdigo da despesa de II e seu emitente*/
           END.

           IF CAN-FIND (FIRST ttII
                        WHERE ttII.CodEstabelNF = ttDet.CodEstabelNF AND
                              ttII.SerieNF = ttDet.SerieNF AND
                              ttII.NrNotaFisNF = ttDet.NrNotaFisNF AND
                              ttII.NrSeqFatNF = ttDet.NrSeqFatNF AND
                              ttII.ItCodigoNF = ttDet.ItCodigoNF) THEN DO:
                /* Verifica se II n∆o est† parametrizado como Outras Despesas CD2565. Se sim o valor j† est† gravado na embalagem*/
                IF CAN-FIND(FIRST item-doc-est-cex
                            WHERE item-doc-est-cex.serie-docto       = nota-fiscal.serie
                            AND   item-doc-est-cex.nro-docto         = nota-fiscal.nr-nota-fis
                            AND   item-doc-est-cex.cod-emitente      = nota-fiscal.cod-emitente
                            AND   item-doc-est-cex.nat-operacao      = nota-fiscal.nat-operacao
                            AND   item-doc-est-cex.sequencia         = it-nota-fisc.nr-seq-fat
                            AND   item-doc-est-cex.cod-desp          = i-desp-ii-i50) THEN DO:
                    FIND FIRST desp-imp NO-LOCK
                         WHERE desp-imp.cod-desp = i-desp-ii-i50 NO-ERROR.
                    IF AVAIL desp-imp AND desp-imp.inc-val-outras-desp = NO THEN
                        ASSIGN d-total-vItem = d-total-vItem + ttII.vII.
                END.
           END.

           IF CAN-FIND (FIRST ttICMS15
                        WHERE ttICMS15.CodEstabelNF = ttDet.CodEstabelNF
                          AND ttICMS15.SerieNF      = ttDet.SerieNF
                          AND ttICMS15.NrNotaFisNF  = ttDet.NrNotaFisNF
                          AND ttICMS15.NrSeqFatNF   = ttDet.NrSeqFatNF
                          AND ttICMS15.ItCodigoNF   = ttDet.ItCodigoNF) THEN DO:
               ASSIGN d-total-vItem = d-total-vItem + ttICMS15.vICMSMonoReten. // (+) vICMSMonoReten
           END.

            RUN pi-cria-ttVB.

        END.

        /** Fim Impostos da Reforma Tribut†ria **/

        /*--- TOTAIS ---*/
        ASSIGN d-total-base-icms     = d-total-base-icms    +
                                       IF  (    {&log-icms-substto-antecip}
                                            AND NOT it-nota-fisc.ind-icm-ret)
                                       OR  (    it-nota-fisc.cd-trib-icm = 5
                                            AND SUBSTRING(c-niv-trib-icms,2,2) = "51":U  /* ALTERAÄ«O PARA GERAR VALOR ZERO NA BASE QUANDO CST 51 E TRIBUTAÄ«O DIFERIDO - NOTA DO RECEBIMENTO */)
                                       OR l-omite-val-totais-sn-icms
                                       OR SUBSTRING(c-niv-trib-icms,2,2) = "02":U
                                       OR SUBSTRING(c-niv-trib-icms,2,2) = "15":U
                                       OR SUBSTRING(c-niv-trib-icms,2,2) = "53":U
                                       OR SUBSTRING(c-niv-trib-icms,2,2) = "61":U
                                       THEN 0
                                       ELSE IF  it-nota-fisc.cd-trib-icm = 3
                                            AND l-icms-outras-it
                                            THEN it-nota-fisc.vl-icmsou-it
                                            ELSE it-nota-fisc.vl-bicms-it

               d-total-icms          = d-total-icms         + IF  (    {&log-icms-substto-antecip}
                                                                   AND NOT it-nota-fisc.ind-icm-ret)
                                                              OR  l-omite-val-totais-sn-icms
                                                              OR SUBSTRING(c-niv-trib-icms,2,2) = "02":U
                                                              OR SUBSTRING(c-niv-trib-icms,2,2) = "15":U
                                                              OR SUBSTRING(c-niv-trib-icms,2,2) = "53":U
                                                              OR SUBSTRING(c-niv-trib-icms,2,2) = "61":U
                                                              THEN 0
                                                              ELSE IF it-nota-fisc.cd-trib-icm = 1                                                                     /*Tributado*/
                                                                   OR (    it-nota-fisc.cd-trib-icm = 3
                                                                       AND l-icms-outras-it
                                                                       AND SUBSTRING(c-niv-trib-icms,2,2) <> "51":U)  /*Outras e Considera Tributos Outras na NF-e */  /*CST = 51 (DIFERIDO) N∆o deve ser considerado nos totais da Base de C†lculo*/
                                                                   OR  it-nota-fisc.cd-trib-icm = 4
                                                                   THEN it-nota-fisc.vl-icms-it
                                                                   ELSE 0
               d-total-base-iss      = d-total-base-iss     + it-nota-fisc.vl-biss-it

               d-total-iss           = d-total-iss          + (IF it-nota-fisc.cd-trib-iss = 1 /*Tributado*/
                                                               OR it-nota-fisc.cd-trib-iss = 4 /*Reduzido  */
                                                               THEN it-nota-fisc.vl-iss-it
                                                               ELSE 0)

               d-total-serv          = d-total-serv          + (IF it-nota-fisc.cod-servico <> 0
                                                               THEN it-nota-fisc.vl-merc-liq
                                                               ELSE 0)

               d-total-base-icms-st  = d-total-base-icms-st + IF   l-omite-val-totais-sn-icms-st
                                                               OR  SUBSTRING(c-niv-trib-icms,2,2) = "60":U
                                                               OR  (    {&log-icms-substto-antecip}
                                                                    AND NOT it-nota-fisc.ind-icm-ret)
                                                               OR SUBSTRING(c-niv-trib-icms,2,2) = "15":U
                                                               THEN 0
                                                               ELSE it-nota-fisc.vl-bsubs-it

               d-total-icms-st       = d-total-icms-st      + IF  l-omite-val-totais-sn-icms-st
                                                               OR  SUBSTRING(c-niv-trib-icms,2,2) = "60":U
                                                               OR  (  {&log-icms-substto-antecip}
                                                                    AND NOT it-nota-fisc.ind-icm-ret)
                                                               OR SUBSTRING(c-niv-trib-icms,2,2) = "15":U
                                                               THEN 0
                                                               ELSE it-nota-fisc.vl-icmsub-it

               d-total-pis           = d-total-pis          + (IF it-nota-fisc.cod-servico <> 0
                                                               THEN 0
                                                               ELSE d-valor-pis)

               d-total-cofins        = d-total-cofins       + (IF it-nota-fisc.cod-servico <> 0
                                                               THEN 0
                                                               ELSE d-valor-cofins)

               /*Totais PIS COFINS para Itens de Serviáo*/
               d-total-pis-serv      = d-total-pis-serv     + (IF it-nota-fisc.cod-servico <> 0
                                                               THEN d-valor-pis
                                                               ELSE 0)

               d-total-cofins-serv   = d-total-cofins-serv  + (IF it-nota-fisc.cod-servico <> 0
                                                               THEN d-valor-cofins
                                                               ELSE 0)

               d-total-outras-desp   = d-total-outras-desp  + it-nota-fisc.vl-despes-it

               d-total-ret-irf       = d-total-ret-irf      + it-nota-fisc.vl-irf-it

        &if "{&bf_dis_versao_ems}" >= "2.06" &then
               d-total-ret-pis       = d-total-ret-pis      + it-nota-fisc.val-retenc-pis
               d-total-ret-cofins    = d-total-ret-cofins   + it-nota-fisc.val-retenc-cofins
               d-total-ret-csll      = d-total-ret-csll     + it-nota-fisc.val-retenc-csll
        &else
               d-total-ret-pis       = d-total-ret-pis      + DECIMAL(SUBSTRING(it-nota-fisc.char-2,112,14))
               d-total-ret-cofins    = d-total-ret-cofins   + DECIMAL(SUBSTRING(it-nota-fisc.char-2,126,14))
               d-total-ret-csll      = d-total-ret-csll     + DECIMAL(SUBSTRING(it-nota-fisc.char-2,98,14))
        &endif

               d-total-IPI-espec     = d-total-IPI-espec    + ( it-nota-fisc.vl-ipiit-e[3] * INT(it-nota-fisc.vl-bipiit-e[3] > 0 OR TRIM(SUBSTRING(bf-natur-oper-it.char-2,16,1)) = "1"))  /* valor do ipi para notas de entrega futura / consig*/

               d-total-icms-ST-espec = d-total-icms-ST-espec + (it-nota-fisc.vl-icmsubit-e[3] /* st consig */
                                                             +  it-nota-fisc.vl-icmsit-e[2])  /* st entfut */

               d-total-desp-n-destaq = d-total-desp-n-destaq + ( it-nota-fisc.vl-despesit-e[3] * INT(it-nota-fisc.vl-despesit-e[3] > 0) )

               d-total-icms-ST-devol = d-total-icms-ST-devol + ( it-nota-fisc.vl-icmsubit-e[2] * INT({&log-devol-icms-st-contrib-subs}) ) /*somar somente se o parametro est† marcado e especie NFD*/

               d-total-vl-desc-icms  = d-total-vl-desc-icms + (IF  (r-cidade-zf <> ? or (avail loc-entr and loc-entr.log-1)) AND it-nota-fisc.dec-1 > 0
                                                               THEN it-nota-fisc.dec-1 /*Desconto ICMS ZONA FRANCA*/
                                                               ELSE d-vl-desc-icms)    /*Desconto ICMS*/

               d-total-vl-iss-ret    = d-total-vl-iss-ret + (IF (it-nota-fisc.cd-trib-iss = 1   /* ISS Tributado */
                                                             OR  it-nota-fisc.cd-trib-iss = 4)  /* ISS Reduzido  */
                                                             THEN DEC(TRIM(SUBSTRING(it-nota-fisc.char-2,218,14)))
                                                             ELSE ?)
        .


        IF  {&log-icms-substto-antecip}
        AND NOT it-nota-fisc.ind-icm-ret THEN
            ASSIGN d-total-icms-STA      = d-total-icms-STA + it-nota-fisc.vl-icmsub-it.
        ELSE IF nota-fiscal.ind-tip-nota = 8 AND
                bf-natur-oper-it.log-contrib-st-antec THEN
            ASSIGN d-total-icms-STA      = d-total-icms-STA + it-nota-fisc.vl-icmsub-it.

        /*Inclusao do valor de PISST e COFINSST no total da nota (Dafra) - campo vOutro*/
        IF  l-pis-cofins-st-total THEN
            ASSIGN d-total-pis-st    = d-total-pis-st    + it-nota-fisc.vl-pis
                   d-total-cofins-st = d-total-cofins-st + it-nota-fisc.vl-finsocial.

        /*Tratamento para Incluir no vNF o IPI quando for N∆o Tributado - Obs.: ser† levado para o campo vIPI do ICMSTot como vOutros*/
        IF  l-ipi-outras-total THEN
            ASSIGN d-total-ipi-out-tot = d-total-ipi-out-tot + it-nota-fisc.vl-ipi-it.

        /* Calcula base IRF: conforme dibo~\bodi317im1br.m25 */
        IF it-nota-fisc.vl-irf-it > 0  THEN DO:

          ASSIGN d-total-base-ret-irf = d-total-base-ret-irf + it-nota-fisc.vl-merc-liq .

          IF  it-nota-fisc.cd-trib-ipi <> 3
          &if '{&bf_dis_versao_ems}':U = '2.042':U &then
          AND SUBSTR(bf-natur-oper-nf.char-1,100,1) = "S":U THEN
          &else
              &if '{&bf_dis_versao_ems}':U >= '2.062':U &then
              AND bf-natur-oper-nf.log-ipi-contrib-retid THEN
              &else
              AND SUBSTR(bf-natur-oper-nf.char-1,105,1) = "S":U THEN
              &endif
          &endif
              ASSIGN d-total-base-ret-irf = d-total-base-ret-irf + it-nota-fisc.vl-ipi-it.

          IF  it-nota-fisc.cd-trib-ipi = 3
           AND SUBSTRING(bf-natur-oper-nf.char-2,16,1) = "1":U
           &if '{&bf_dis_versao_ems}':U = '2.042':U &then
           AND SUBSTR(bf-natur-oper-nf.char-1,101,1) = "S":U THEN
           &else
                &if '{&bf_dis_versao_ems}':U >= '2.062':U &then
                AND bf-natur-oper-nf.log-ipi-outras-contrib-retid THEN
                &else
                AND SUBSTR(bf-natur-oper-nf.char-1,106,1) = "S":U THEN
                &endif
           &endif
               ASSIGN d-total-base-ret-irf = d-total-base-ret-irf + it-nota-fisc.vl-ipi-it.

          &if '{&bf_dis_versao_ems}':U >= '2.04':U AND  '{&bf_dis_versao_ems}':U < '2.07':U  &then
              IF SUBSTR(bf-natur-oper-nf.char-1,139,1) = "1"  THEN
                  ASSIGN d-total-base-ret-irf = d-total-base-ret-irf + it-nota-fisc.vl-icmsub-it.
          &endif
          &if '{&bf_dis_versao_ems}':U >= '2.07':U  &then
               IF bf-natur-oper-nf.log-icms-substto-base-irf-retid = YES  THEN
                  ASSIGN d-total-base-ret-irf = d-total-base-ret-irf + it-nota-fisc.vl-icmsub-it.
          &endif
        END.

        /*--- FIM TOTAIS ---*/

    END.

    IF  l-iss THEN
        RUN pi-cria-ttISSQNTot.
    ELSE
	IF NOT l-iss THEN
	    ASSIGN ttEmit.IM   = ""
	           ttEmit.CNAE = "".

    /**** IEST ****
    FT0310 - Utilizaá∆o Inscriá∆o Estadual - estab-uf.int-1
    1 - ICMS ST/DIFAL ICMS Destino
    2 - Somente ICMS ST
    3 - Somente DIFAL ICMS Destino

    estab-uf.log-1 - sempre gerar IE mesmo qdo nao tem ICMS ST na nota
    */
    IF  AVAIL estab-uf THEN
        CASE estab-uf.int-1:
            WHEN 0 OR WHEN 1 THEN DO: /*1 - ICMS ST/DIFAL ICMS Destino*/

                IF ((d-total-icms-st = 0 AND (NOT AVAIL estab-uf OR (AVAIL estab-uf AND NOT estab-uf.log-1)))
                AND NOT CAN-FIND (FIRST item-nf-adc NO-LOCK /* ICMS Destino DIFAL EC 87/15 */
                                  WHERE item-nf-adc.cod-estab             = nota-fiscal.cod-estabel
                                  AND   item-nf-adc.cod-serie             = nota-fiscal.serie
                                  AND   item-nf-adc.cod-nota-fisc         = (if nota-fiscal.ind-tip-nota <> 8 then nota-fiscal.nr-nota-fis else nota-fiscal.nr-nota-ant)
                                  AND   item-nf-adc.idi-tip-dado          = 24))
                THEN
                    ASSIGN ttEmit.IEST = "".

            END.
            WHEN 2 THEN DO: /*2 - Somente ICMS ST*/

                IF ((d-total-icms-st = 0 AND (NOT AVAIL estab-uf OR (AVAIL estab-uf AND NOT estab-uf.log-1)))
                OR CAN-FIND (FIRST item-nf-adc NO-LOCK /* ICMS Destino DIFAL EC 87/15 */
                             WHERE item-nf-adc.cod-estab             = nota-fiscal.cod-estabel
                             AND   item-nf-adc.cod-serie             = nota-fiscal.serie
                             AND   item-nf-adc.cod-nota-fisc         = (if nota-fiscal.ind-tip-nota <> 8 then nota-fiscal.nr-nota-fis else nota-fiscal.nr-nota-ant)
                             AND   item-nf-adc.idi-tip-dado          = 24))
                 THEN
                    ASSIGN ttEmit.IEST = "".

            END.
            WHEN 3 THEN DO: /*3 - Somente DIFAL ICMS Destino*/

                IF NOT CAN-FIND (FIRST item-nf-adc NO-LOCK /* ICMS Destino DIFAL EC 87/15 */
                                 WHERE item-nf-adc.cod-estab             = nota-fiscal.cod-estabel
                                 AND   item-nf-adc.cod-serie             = nota-fiscal.serie
                                 AND   item-nf-adc.cod-nota-fisc         = (if nota-fiscal.ind-tip-nota <> 8 then nota-fiscal.nr-nota-fis else nota-fiscal.nr-nota-ant)
                                 AND   item-nf-adc.idi-tip-dado          = 24) THEN
                    ASSIGN ttEmit.IEST = "".
            END.
        END CASE.
    /**** IEST ****/

    RUN pi-cria-ttICMSTot.

    RUN pi-cria-ttRetTrib.

    RUN pi-cria-ttTotIBSCBSIS.

    RUN pi-cria-ttTransp.

    RUN pi-cria-ttCobr.

    RUN pi-cria-ttPag.

    RUN pi-cria-ttInfIntermed.

    RUN pi-cria-ttInfAdic.

    RUN pi-cria-ttProcRef.

    RUN pi-cria-ttCana.

    RUN pi-cria-ttCompra.  /* VER MAPA NEOGRID - Lµ CONSTA INFORMAÄÂES DE COMPRA, E N«O DO PEDIDO */

    RUN pi-enviaEmailDestTransp. /* para o envio do e-mail do destinat†rio e transportador ao Neogrid/TSS */

    RUN pi-cria-dados-agropecuario.

    /*--- CHAMADAS UPC PARA TODOS OS CAMPOS DE TODAS AS TABELAS NF-e --*/
    RUN pi-executa-upc.
    /*-----*/

END PROCEDURE.

