PROCEDURE PIUpsert:
    
    DEFINE VAR iretConsReciNFe AS INTEGER INITIAL ? NO-UNDO.
    DEFINE VAR iinfProt        AS INTEGER INITIAL ? NO-UNDO.
    DEFINE VAR iprotNFe        AS INTEGER INITIAL ? NO-UNDO.  
    DEFINE VAR iNFe            AS INTEGER INITIAL ? NO-UNDO.
    DEFINE VAR iinfNFe         AS INTEGER INITIAL ? NO-UNDO.
    DEFINE VAR iide            AS INTEGER INITIAL ? NO-UNDO.
    DEFINE VAR iinfAdic        AS INTEGER INITIAL ? NO-UNDO.
    DEFINE VAR cDanfe          AS CHAR              NO-UNDO.

    RUN getBusinessContent IN hMessageHandler (OUTPUT hBusinessContent).
    RUN reset              IN hGenXml.
    RUN loadXml            IN hGenXml (hBusinessContent).


    DELETE OBJECT hBusinessContent NO-ERROR.

    /* ********* LEITURA DA MENSAGEM - BEGIN ********* */
    addStack(1).

    EMPTY TEMP-TABLE ttReturnInvoiceDocument NO-ERROR.
    CREATE ttReturnInvoiceDocument.

    RUN searchTag IN hGenXml (INPUT "retConsReciNFe":U, INPUT getStack(), OUTPUT iretConsReciNFe).

    IF iretConsReciNFe <> ? THEN DO:
        addStack(iretConsReciNFe).

        RUN getSonVal IN hGenXml (INPUT iretConsReciNFe, INPUT "versao":U, OUTPUT ttReturnInvoiceDocument.versao).

        RUN searchTag IN hGenXml (INPUT "protNFe":U, INPUT iretConsReciNFe, OUTPUT iprotNFe).
  
        IF iprotNFe <> ? THEN DO:
            addStack(iprotNFe).

                RUN searchTag IN hGenXml (INPUT "infProt":U, INPUT iprotNFe, OUTPUT iinfProt).
          
                IF iinfProt <> ? THEN DO:
                    addStack(iinfProt).
        
                    RUN getSonVal IN hGenXml (INPUT iinfProt, INPUT "id":U, OUTPUT ttReturnInvoiceDocument.id).
                    RUN getSonVal IN hGenXml (INPUT iinfProt, INPUT "tpAmb":U, OUTPUT ttReturnInvoiceDocument.tpAmb).
                    RUN getSonVal IN hGenXml (INPUT iinfProt, INPUT "verAplic":U, OUTPUT ttReturnInvoiceDocument.verAplic).
                    RUN getSonVal IN hGenXml (INPUT iinfProt, INPUT "chNFe":U, OUTPUT ttReturnInvoiceDocument.chNFe).
                    RUN getSonVal IN hGenXml (INPUT iinfProt, INPUT "dhRecbto":U, OUTPUT ttReturnInvoiceDocument.dhRecbto).
                    RUN getSonVal IN hGenXml (INPUT iinfProt, INPUT "nProt":U, OUTPUT ttReturnInvoiceDocument.nProt).
                    IF ttReturnInvoiceDocument.nProt = ? THEN ASSIGN ttReturnInvoiceDocument.nProt = "". 
                    RUN getSonVal IN hGenXml (INPUT iinfProt, INPUT "digVal":U, OUTPUT ttReturnInvoiceDocument.digVal).
                    RUN getSonVal IN hGenXml (INPUT iinfProt, INPUT "cStat":U, OUTPUT ttReturnInvoiceDocument.cStat).
                    RUN getSonVal IN hGenXml (INPUT iinfProt, INPUT "xMotivo":U, OUTPUT ttReturnInvoiceDocument.xMotivo).

                    delStack().
                END.
                delStack().
        END.

        delStack().
    END.

    RUN searchTag IN hGenXml (INPUT "NFe":U, INPUT getStack(), OUTPUT iNFe).

    IF iNFe <> ? THEN DO:
        addStack(iNFe).

        RUN searchTag IN hGenXml (INPUT "infNFe":U, INPUT iNFe, OUTPUT iinfNFe).
  
        IF iinfNFe <> ? THEN DO:
            addStack(iinfNFe).

                /* Busca Tipo Emissao: 1- Normal, 2- Contingencia SCAN, 3- Contingencia Off-line */
                RUN searchTag IN hGenXml (INPUT "ide":U, INPUT iinfNFe, OUTPUT iide).
                IF iide <> ? THEN DO:
                    addStack(iide).
                    RUN getSonVal IN hGenXml (INPUT iide, INPUT "tpEmis":U, OUTPUT ttReturnInvoiceDocument.tpEmis).
                    delStack().
                END.

                /* Busca tag DANFEIMp: informa se o Danfe ja foi impresso pelo aplicativo de transmissao 
                                       NO - N∆o Impresso na Aplicaá∆o de Transmiss∆o" e YES - "Impress0 na Aplicaá∆o de Transmiss∆o" */
                RUN searchTag IN hGenXml (INPUT "infAdic":U, INPUT iinfNFe, OUTPUT iinfAdic).
                IF iinfAdic <> ? THEN DO:
                    addStack(iinfAdic).
                    RUN getSonVal IN hGenXml (INPUT iinfAdic, INPUT "DANFEImp":U, OUTPUT cDanfe).
                    ASSIGN ttReturnInvoiceDocument.lDanfe = cDanfe = "YES".
                    delStack().
                END.
            
            delStack().
        END.

        delStack().
    END.

    /* ********* LEITURA DA MENSAGEM - END   ********* */

    /* ********* EFETIVAÄ«O - BEGIN ********* */
    {adapters/xml/ep2/axrep001upsert.i}
    /* ********* EFETIVAÄ«O - END   ********* */
END PROCEDURE.


