PROCEDURE pi-cria-ttFUNTTEL:
    
    FIND FIRST item-nf-adc USE-INDEX itmnfdc-id
         WHERE item-nf-adc.cod-estab         = nota-fiscal.cod-estabel
         AND   item-nf-adc.cod-serie         = nota-fiscal.serie
         AND   item-nf-adc.cod-nota-fisc     = nota-fiscal.nr-nota-fis
         AND   item-nf-adc.cdn-emitente      = nota-fiscal.cod-emitente
         AND   item-nf-adc.cod-natur-operac  = nota-fiscal.nat-operacao
         AND   item-nf-adc.idi-tip-dado      = 39
         AND   item-nf-adc.num-seq-item-nf   = it-nota-fisc.nr-seq-fat
         AND   item-nf-adc.cod-item          = it-nota-fisc.it-codigo
         AND   item-nf-adc.cod-livre-1       = "FUNTTEL"  NO-LOCK NO-ERROR.
      
    IF AVAIL item-nf-adc THEN DO:
        CREATE ttFunttel.        
        ASSIGN ttFunttel.CodEstabelNFCom = nota-fiscal.cod-estabel
               ttFunttel.SerieNFCom      = nota-fiscal.serie
               ttFunttel.NrNotaFisNFCom  = nota-fiscal.nr-nota-fis
               ttFunttel.ItCodigoNFCom   = it-nota-fisc.it-codigo
               ttFunttel.NrSeqFatNFCom   = it-nota-fisc.nr-seq-fat
               ttFunttel.vBC             = item-nf-adc.val-livre-1     
               ttFunttel.pFUNTTEL        = item-nf-adc.val-livre-2  
               ttFunttel.vFUNTTEL        = item-nf-adc.val-livre-3
               d-total-vFunttel          = d-total-vFunttel + item-nf-adc.val-livre-3.    
    END.
END PROCEDURE.
