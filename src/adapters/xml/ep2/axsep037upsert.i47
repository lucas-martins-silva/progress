PROCEDURE pi-grava-ttICMSSN900:

    /*
    === ttICMSSN900 ===
    Orig           AS CHARACTER INITIAL ?                                      /*Origem da mercadoria*/
    CSOSN          AS CHARACTER INITIAL ?                                      /*C¢digo de Situa‡Æo da Opera‡Æo - SIMPLES NACIONAL*/
    modBC          AS CHARACTER INITIAL ?                                      /*Modalidade de determina‡Æo da BC do ICMS*/
    vBC            AS DECIMAL   INITIAL ? FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2 /*Valor da BC do ICMS*/
    pRedBC         AS DECIMAL   INITIAL ? FORMAT ">>9.99" DECIMALS 2           /*Percentual da Redu‡Æo de BC*/
    pICMS          AS DECIMAL   INITIAL ? FORMAT ">>9.99" DECIMALS 2           /*Al¡quota do imposto*/
    vICMS          AS DECIMAL   INITIAL ? FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2 /*Valor do ICMS*/
    modBCST        AS CHARACTER INITIAL ?                                      /*Modalidade de determina‡Æo da BC do ICMS ST*/
    pMVAST         AS DECIMAL   INITIAL ? FORMAT ">>9.99" DECIMALS 2           /*Percentual da margem de valor Adicionado do ICMS ST*/
    pRedBCST       AS DECIMAL   INITIAL ? FORMAT ">>9.99" DECIMALS 2           /*Percentual da Redu‡Æo de BC do ICMS ST*/
    vBCST          AS DECIMAL   INITIAL ? FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2 /*Valor da BC do ICMS ST*/
    pICMSST        AS DECIMAL   INITIAL ? FORMAT ">>9.99" DECIMALS 2           /*Al¡quota do imposto do ICMS ST*/
    vICMSST        AS DECIMAL   INITIAL ? FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2 /*Valor do ICMS ST*/
    pCredSN        AS DECIMAL   INITIAL ? FORMAT ">>9.99" DECIMALS 2           /*Al¡quota aplic vel de c lculo do cr‚dito (SIMPLES NACIONAL).*/
    vCredICMSSN    AS DECIMAL   INITIAL ?                                      /*Valor cr‚dito do ICMS que pode ser aproveitado nos termos do art. 23 da LC 123 (SIMPLES NACIONAL)*/
    vBCFCPST       AS DECIMAL   INITIAL ? FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2 /*Valor da BC do FCP ST*/ 
    pFCPST         AS DECIMAL   INITIAL ? FORMAT ">>9.9999"         DECIMALS 4 /*Al¡quota do FCP ST*/
    vFCPST         AS DECIMAL   INITIAL ? FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2 /*Valor do FCP ST*/       
    */

    FOR FIRST item-nf-adc NO-LOCK
        WHERE item-nf-adc.cod-estab             = it-nota-fisc.cod-estabel
        AND   item-nf-adc.cod-serie             = it-nota-fisc.serie
        AND   item-nf-adc.cod-nota-fisc         = it-nota-fisc.nr-nota-fis
        AND   item-nf-adc.cdn-emitente          = nota-fiscal.cod-emitente
        AND   item-nf-adc.cod-natur-operac      = it-nota-fisc.nat-operacao
        AND   item-nf-adc.idi-tip-dado          = 1
        AND   item-nf-adc.num-seq               = 1
        AND   item-nf-adc.num-seq-item-nf       = it-nota-fisc.nr-seq-fat
        AND   item-nf-adc.cod-item              = it-nota-fisc.it-codigo:
    END.  

    CREATE ttICMSSN900.
    ASSIGN ttICMSSN900.orig        = STRING(i-codigo-orig)
           ttICMSSN900.CSOSN       = c-cod-csosn
           ttICMSSN900.modBC       = (IF c-mod-base-icms = "2"
                                      THEN "1"
                                      ELSE IF c-mod-base-icms = "3"
                                           THEN "2"
                                           ELSE IF c-mod-base-icms = "4"
                                                THEN "3"
                                                ELSE "0")
           ttICMSSN900.vBC         = (IF (it-nota-fisc.cd-trib-icm  = 3 AND l-icms-outras-it)
                                      THEN d-vl-imp-icmsou
                                      ELSE d-vl-bicms-it)
           ttICMSSN900.pRedBC      = IF d-perc-redimp > 0 THEN d-perc-redimp  ELSE ?  
           ttICMSSN900.pICMS       = (IF (it-nota-fisc.cd-trib-icm <> 3
                                      OR (it-nota-fisc.cd-trib-icm  = 3 AND l-icms-outras-it))
                                      THEN d-aliquota-icms
                                      ELSE 0)
           ttICMSSN900.vICMS       = (IF  it-nota-fisc.cd-trib-icm <> 3
                                      OR (it-nota-fisc.cd-trib-icm  = 3 AND l-icms-outras-it)
                                      THEN d-vl-imp-icms
                                      ELSE 0)
           ttICMSSN900.modBCST     = (IF c-mod-base-icms-st = "2"
                                      THEN "1"
                                      ELSE IF c-mod-base-icms-st = "3"
                                           THEN "2"
                                           ELSE IF c-mod-base-icms-st = "4"
                                                THEN "3"
                                                ELSE IF c-mod-base-icms-st = "5"
                                                     THEN "4"
                                                     ELSE IF c-mod-base-icms-st = "6"
                                                          THEN "5"
                                                          ELSE IF c-mod-base-icms-st = "7"
                                                               THEN "6"
                                                               ELSE "0")   
           ttICMSSN900.pMVAST      = IF  AVAIL item-nf-adc AND item-nf-adc.val-livre-1 > 0 THEN item-nf-adc.val-livre-1 ELSE DEC(SUBSTR(it-nota-fisc.char-2,338,8))
           ttICMSSN900.pRedBCST    = IF  AVAIL item-nf-adc AND item-nf-adc.val-livre-2 > 0 THEN item-nf-adc.val-livre-2 ELSE DEC(SUBSTR(it-nota-fisc.char-2,346,8))
           ttICMSSN900.vBCST       = it-nota-fisc.vl-bsubs-it
           ttICMSSN900.pICMSST     = IF AVAIL item-nf-adc THEN item-nf-adc.val-aliq-icms-st ELSE 0  
           ttICMSSN900.vICMSST     = it-nota-fisc.vl-icmsub-it.

    &if "{&bf_dis_versao_ems}" >= "2.09" &then
          ASSIGN ttICMSSN900.pCredSN     = (IF it-nota-fisc.VAL-CR-ICMS-SIMPLES-NAC > 0
                                            THEN nota-fiscal.VAL-PERC-ICMS-SIMPLES-NAC
                                            ELSE 0)
                 ttICMSSN900.vCredICMSSN = it-nota-fisc.VAL-CR-ICMS-SIMPLES-NAC.
    &ELSE 
          ASSIGN ttICMSSN900.pCredSN     = (IF DEC(substring(it-nota-fisc.CHAR-1,207,20)) > 0
                                            THEN DEC(substring( nota-fiscal.CHAR-1,238,10))
                                            ELSE 0)
                 ttICMSSN900.vCredICMSSN = DEC(substring(it-nota-fisc.CHAR-1,207,20)).
    &ENDIF
    
  
    /*--- Valores FCP ---*/
    FOR FIRST item-nf-adc NO-LOCK
        WHERE item-nf-adc.cod-estab         = nota-fiscal.cod-estabel
        AND   item-nf-adc.cod-serie         = nota-fiscal.serie
        AND   item-nf-adc.cod-nota-fisc     = (if nota-fiscal.ind-tip-nota <> 8 then nota-fiscal.nr-nota-fis else nota-fiscal.nr-nota-ant)
        AND   item-nf-adc.idi-tip-dado      = 25
        AND   item-nf-adc.cdn-emitente      = nota-fiscal.cod-emitente
        AND   item-nf-adc.cod-natur-operac  = it-nota-fisc.nat-operacao
        AND   item-nf-adc.num-seq-item-nf   = (if nota-fiscal.ind-tip-nota <> 8 then it-nota-fisc.nr-seq-fat else it-nota-fisc.nr-seq-ped)
        AND   item-nf-adc.cod-item          = it-nota-fisc.it-codigo:

        IF (item-nf-adc.log-livre-2 = ? /* Nova gera‡Æo de FCP -> FCP e FCP ST juntos no mesmo item da nota */
        AND (item-nf-adc.val-livre-1      > 0 OR /* Valores de FCP ST */
             item-nf-adc.val-livre-2      > 0 OR
             DEC(item-nf-adc.cod-livre-4) > 0))
        OR  item-nf-adc.log-livre-1 = YES  /* NO = FCP Normal | YES = FCP ST */ /* Gera‡Æo de dados antiga FCP ou FCP ST */
        THEN
            ASSIGN ttICMSSN900.vBCFCPST = item-nf-adc.val-livre-1
                   ttICMSSN900.pFCPST   = item-nf-adc.val-livre-2
                   ttICMSSN900.vFCPST   = DEC(item-nf-adc.cod-livre-4)
                   d-total-vFCPST       = d-total-vFCPST + ttICMSSN900.vFCPST.
    END.
    /*---*/
    /* Majora ICMS ST com FCP ST fun‡Æo por estado - EX: MT */ 
    IF  l-Majora-FCP = YES
    AND ttICMSSN900.vFCPST <> ? THEN DO:
        ASSIGN ttICMSSN900.pICMSST  = ttICMSSN900.pICMSST + ttICMSSN900.pFCPST
               ttICMSSN900.vICMSST  = ttICMSSN900.vICMSST + ttICMSSN900.vFCPST
               ttICMSSN900.vBCFCPST = ?
               ttICMSSN900.pFCPST   = ?
               ttICMSSN900.vFCPST   = ?.
    END.

    /*Chave EMS*/
    ASSIGN ttICMSSN900.CodEstabelNF = nota-fiscal.cod-estabel
           ttICMSSN900.SerieNF      = nota-fiscal.serie
           ttICMSSN900.NrNotaFisNF  = nota-fiscal.nr-nota-fis
           ttICMSSN900.ItCodigoNF   = it-nota-fisc.it-codigo
           ttICMSSN900.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.

END PROCEDURE.
