/* PROCEDURE piEnviaEmail : */
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pc-destino   AS CHARACTER FORMAT "x(1000)":U NO-UNDO.
    DEFINE INPUT PARAMETER pc-remetente AS CHARACTER FORMAT "x(1000)":U NO-UNDO.
    DEFINE INPUT PARAMETER pc-assunto   AS CHARACTER FORMAT "x(200)":U  NO-UNDO.
    DEFINE INPUT PARAMETER pc-anexo     AS CHARACTER FORMAT "x(100)":U  NO-UNDO.

    DEFINE VARIABLE h-utapi019  AS HANDLE      NO-UNDO.
    DEFINE VARIABLE lExchange   AS LOGICAL     NO-UNDO.
    DEFINE VARIABLE cServEmail  AS CHARACTER   NO-UNDO.
    DEFINE VARIABLE iPortaEmail AS INTEGER     NO-UNDO.

    EMPTY TEMP-TABLE tt-envio2.
    EMPTY TEMP-TABLE tt-mensagem.
    EMPTY TEMP-TABLE tt-erros.

    IF  pc-destino   <> "" AND 
        pc-assunto   <> "" AND 
        pc-remetente <> "" THEN DO: 

        IF  NOT VALID-HANDLE(h-utapi019) THEN
            RUN utp/utapi019.p PERSISTENT SET h-utapi019.

        FOR FIRST param-global NO-LOCK:

            ASSIGN lExchange   = param-global.log-1
                   cServEmail  = param-global.serv-mail
                   iPortaEmail = param-global.porta-mail.
        END.
    
        CREATE tt-envio2.

        IF  lExchange THEN
            ASSIGN tt-envio2.exchange = YES.
        ELSE IF  cServEmail  <> "" 
             AND IPortaEmail <> 0 THEN
            ASSIGN tt-envio2.servidor = cServEmail
                   tt-envio2.porta    = iPortaEmail.

        /******** Inicio ponto epc ***************************************/  
        IF  c-nom-prog-dpc-mg97  <> "" OR  
            c-nom-prog-appc-mg97 <> "" OR  
            c-nom-prog-upc-mg97  <> "" THEN DO:
            FOR EACH tt-epc WHERE tt-epc.cod-event = "e-mail_destino_NF-e":
              DELETE tt-epc.
            END.
            
            FIND CURRENT emitente NO-LOCK NO-ERROR.
            CREATE tt-epc.
            ASSIGN tt-epc.cod-event     = "e-mail_destino_NF-e"
                   tt-epc.cod-parameter = "cod-emitente"
                   tt-epc.val-parameter = string(emitente.cod-emitente).
    
            {include/i-epc201.i "e-mail_destino_NF-e"}
    
            FOR FIRST tt-epc WHERE tt-epc.cod-event     = "e-mail_destino_NF-e"
                               AND tt-epc.cod-parameter = "e-mail_destino":
    
                IF tt-epc.val-parameter <> "" AND
                   tt-epc.val-parameter <> ? THEN
                    ASSIGN pc-destino = tt-epc.val-parameter.
            END.
        END. /* IF  c-nom-prog-dpc-mg97  <> "" OR */
        /******** Fim ponto epc ******************************************/  


        ASSIGN tt-envio2.versao-integracao = 1
               tt-envio2.remetente         = pc-remetente
               tt-envio2.destino           = pc-destino
               tt-envio2.assunto           = pc-assunto
               tt-envio2.importancia       = 2
               tt-envio2.log-enviada       = NO 
               tt-envio2.log-lida          = NO
               tt-envio2.acomp             = NO
               tt-envio2.arq-anexo         = pc-anexo
               tt-envio2.formato           = "HTML":U.

        RUN pi-monta-HTML.

        IF  RETURN-VALUE <> "OK" THEN
            RETURN.
        /******** Inicio ponto epc ***************************************/  
        IF  c-nom-prog-dpc-mg97  <> "" OR  
            c-nom-prog-appc-mg97 <> "" OR  
            c-nom-prog-upc-mg97  <> "" THEN DO:
            FOR EACH   tt-epc
                WHERE  tt-epc.cod-event = "AlteraEMail":U:
                DELETE tt-epc.
            END.

            CREATE tt-epc.
            ASSIGN tt-epc.cod-event     = "AlteraEMail":U
                   tt-epc.cod-parameter = "tt-envio2:buffer":U
                   tt-epc.val-parameter = string(temp-table tt-envio2:default-buffer-handle).

            CREATE tt-epc.
            ASSIGN tt-epc.cod-event     = "AlteraEMail":U
                   tt-epc.cod-parameter = "tt-mensagem:buffer":U
                   tt-epc.val-parameter = string(temp-table tt-mensagem:default-buffer-handle).

            CREATE tt-epc.
            ASSIGN tt-epc.cod-event     = "AlteraEMail":U
                   tt-epc.cod-parameter = "rowid-nota-fiscal":U
                   tt-epc.val-parameter = string(rowid(nota-fiscal)).

            {include/i-epc201.i "AlteraEMail"}
        END. /* IF  c-nom-prog-dpc-mg97  <> "" OR */
        /******** Fim ponto epc ******************************************/  

        OUTPUT TO VALUE(SESSION:TEMP-DIRECTORY + "envemail.txt":U).
        RUN pi-execute2 IN h-utapi019 (INPUT  TABLE tt-envio2,
                                       INPUT  TABLE tt-mensagem,    
                                       OUTPUT TABLE tt-erros).
        OUTPUT CLOSE.

        IF  RETURN-VALUE = "NOK":U THEN
            FOR EACH tt-erros:
                CREATE RowErrors.
                ASSIGN RowErrors.ErrorNumber      = tt-erros.cod-erro
                       RowErrors.ErrorDescription = tt-erros.desc-erro.
            END.
        
        DELETE PROCEDURE h-utapi019.
        ASSIGN h-utapi019 = ?.
    END.

/* END PROCEDURE. */

