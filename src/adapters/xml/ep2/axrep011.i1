/* PROCEDURE pi-criaTtReturnInvoiceDocument */  

    DEFINE VARIABLE lExecutadoPeloAXREP011 AS LOGICAL                 NO-UNDO.
    DEFINE VARIABLE i-cont-progs           AS INTEGER                 NO-UNDO.
    DEFINE VARIABLE c-serie                AS CHARACTER               NO-UNDO.
    DEFINE VARIABLE dt-data-aux            AS DATETIME                NO-UNDO.
    DEFINE VARIABLE dt-dat-ret             AS DATE                    NO-UNDO.
    DEFINE VARIABLE c-hra-ret              AS CHARACTER               NO-UNDO.
    
    IF  NOT AVAIL ttMONITORNFE THEN
        FIND FIRST ttMONITORNFE NO-LOCK NO-ERROR.

    IF  NOT AVAIL ttLOTENFE THEN
        FIND FIRST ttLOTENFE NO-LOCK NO-ERROR.


    ASSIGN c-serie = (IF SUBSTR(TRIM(ttMONITORNFE.ID),23,3) <> "000":U
                      THEN STRING(INT(SUBSTR(TRIM(ttMONITORNFE.ID),23,3)))
                      ELSE "":U).
    
    IF  NOT AVAIL nota-fiscal THEN
         FOR EACH estabelec NO-LOCK 
            WHERE estabelec.cgc = SUBSTR(TRIM(ttMONITORNFE.ID),7,14)
              AND (&if "{&BF_DIS_VERSAO_EMS}" >= "2.07" &then
                    estabelec.idi-tip-emis-nf-eletro    > 1
                   &else
                    INT(SUBSTR(estabelec.char-1,168,1)) > 1
                   &endif):
       
            FOR FIRST nota-fiscal NO-LOCK
                WHERE nota-fiscal.cod-estabel = estabelec.cod-estabel
                  AND nota-fiscal.serie       = c-serie
                  AND nota-fiscal.nr-nota-fis = TRIM(STRING(INTEGER(SUBSTR(ttMONITORNFE.ID,26,9)),">>9999999")):
            END.

            IF  AVAIL nota-fiscal THEN LEAVE. /*para sair do for each estabelec*/
        END.

    IF  NOT AVAIL nota-fiscal THEN
        RETURN "NOK":U.

    /* Considerar somente as notas que ainda est∆o pendentes como:
    1  - NF-e n∆o gerada
    2  - Em processamento no EAI
    8  - Em processamento no Aplicativo de Transmiss∆o
    12 - Em processo de Cancelamento 
    13 - Em processo de Inutilizaá∆o
    14 - NFe Pendente de Retorno
    15 - EPEC Recebido pelo SCE
    */
    &if "{&bf_dis_versao_ems}":U < "2.07":U &then
    /*IF  NOT AVAIL bf-sit-nf-eletro THEN      foi retirado pois nao tava atualizando o BUFFER bf-sit-nf-eletro com o situaá∆o da nfe atualizado*/
        FOR FIRST bf-sit-nf-eletro NO-LOCK
            WHERE bf-sit-nf-eletro.cod-estabel       = nota-fiscal.cod-estabel
              AND bf-sit-nf-eletro.cod-serie         = nota-fiscal.serie
              AND bf-sit-nf-eletro.cod-nota-fisc     = nota-fiscal.nr-nota-fis:
       
            IF (bf-sit-nf-eletro.idi-sit-nf-eletro <> 1
            AND bf-sit-nf-eletro.idi-sit-nf-eletro <> 2
            AND bf-sit-nf-eletro.idi-sit-nf-eletro <> 8
            AND bf-sit-nf-eletro.idi-sit-nf-eletro <> 12
            AND bf-sit-nf-eletro.idi-sit-nf-eletro <> 13
            AND bf-sit-nf-eletro.idi-sit-nf-eletro <> 14
            AND bf-sit-nf-eletro.idi-sit-nf-eletro <> 15)
            THEN RETURN "NOK":U.
        END.
    &else
        IF (nota-fiscal.idi-sit-nf-eletro   <> 1
        AND nota-fiscal.idi-sit-nf-eletro   <> 2
        AND nota-fiscal.idi-sit-nf-eletro   <> 8
        AND nota-fiscal.idi-sit-nf-eletro   <> 12
        AND nota-fiscal.idi-sit-nf-eletro   <> 13
        AND nota-fiscal.idi-sit-nf-eletro   <> 14
        AND nota-fiscal.idi-sit-nf-eletro   <> 15)
        THEN RETURN "NOK":U.
    &endif
    
    /*Rejeiá∆o [SEM conte£do na tag CODRETNFE e COM conte£do na tag CODRETRECIBO]*/
    IF  TRIM(ttLOTENFE.CODRETNFE) = ""
    AND (ttLOTENFE.CODRETRECIBO >= "200":U  AND
         ttLOTENFE.CODRETRECIBO <= "999":U) THEN
        ASSIGN ttLOTENFE.CODRETNFE = ttLOTENFE.CODRETRECIBO.
        
    /*Tratamento para quando houve integraá∆o com a SEFAZ, ou seja, conteudo CODENVLOTE diferente de vazio, porÇm os outros campos n∆o vieram com conteudo*/
    IF    TRIM(ttLOTENFE.CODENVLOTE) <> ""
    AND ( TRIM(ttLOTENFE.CODRETNFE)    = ""
    AND   TRIM(ttLOTENFE.CODRETRECIBO) = "" ) THEN
        ASSIGN ttLOTENFE.CODRETNFE = TRIM(ttLOTENFE.CODENVLOTE).
        
    /*----
    TRATAMENTO RETORNO REJEIÄAO QUANDO NOTA AINDA ESTµ EM PROCESSAMENTO
    No EMS a nota est† com status Em processamento no EAI/Aplic Trasmiss∆o, mas o TSS retorno no campo CODRETRECIBO Ç msg de rejeiá∆o, 
    e no campo RECOMENDACAO Ç de que a NF-e ainda n∆o foi assinada ou ent∆o que o Lote ainda n∆o foi trasmitido.
    ----*/
    IF  ttLOTENFE.CODRETNFE <> ""
    AND &if "{&bf_dis_versao_ems}":U < "2.07":U &then
        (bf-sit-nf-eletro.idi-sit-nf-eletro = 2 OR bf-sit-nf-eletro.idi-sit-nf-eletro = 8)
        &else
        (nota-fiscal.idi-sit-nf-eletro      = 2 OR nota-fiscal.idi-sit-nf-eletro      = 8)
        &endif
    AND (INDEX(TRIM(ttMONITORNFE.RECOMENDACAO),"003 - A Nfe ainda n∆o foi assinada - aguarde a assinatura":U)     > 0 OR
         INDEX(TRIM(ttMONITORNFE.RECOMENDACAO),"004 - Lote ainda n∆o transmitido, verifique o status da SEFAZ":U) > 0)
    THEN DO:
        ASSIGN ttLOTENFE.CODRETNFE = "".
    END.

    /* N∆o veio erro tratado pela Sefaz (ttLOTENFE.CODRETNFE), mas erros vindos do TSS (ttMONITORNFE.RECOMENDACAO), ent∆o gravar ret-nf-eletro, e tipo */
    IF  TRIM(ttLOTENFE.CODRETNFE) = "" THEN DO:

        IF  TRIM(ttMONITORNFE.RECOMENDACAO) <> "" THEN DO:
            DO  i-cont-progs = 1 TO 10:
                IF  PROGRAM-NAME(i-cont-progs) MATCHES "*axrep011*" THEN DO:
                    ASSIGN lExecutadoPeloAXREP011 = YES.
                    LEAVE.
                END.
            END.
            
            IF  lExecutadoPeloAXREP011 THEN
                PAUSE(1).

            /*Gravar na ret-nf-eletro*/
            ASSIGN dt-data-aux = DATETIME(TODAY, MTIME)                                               //Grava a data/hora corrente
                   dt-dat-ret  = DATE(dt-data-aux)                                                    //Grava a data corrente
                   c-hra-ret   = STRING(INTEGER(TRUNCATE(MTIME(dt-data-aux) / 1000, 0)), "HH:MM:SS")  //Grava a hora corrente
                   c-hra-ret   = REPLACE(c-hra-ret,":","").                                           //Retira o : da hora para manter da mesma forma que j† era gravado antes desse ajuste
            
            //Enquanto existir, vai gerar nova data/hora 
            DO WHILE CAN-FIND(FIRST ret-nf-eletro NO-LOCK
                              WHERE ret-nf-eletro.cod-estabel = nota-fiscal.cod-estabel
                              AND   ret-nf-eletro.cod-serie   = nota-fiscal.serie
                              AND   ret-nf-eletro.nr-nota-fis = nota-fiscal.nr-nota-fis
                              AND   ret-nf-eletro.cod-msg     = "0":U
                              AND   ret-nf-eletro.dat-ret     = dt-dat-ret
                              AND   ret-nf-eletro.hra-ret     = c-hra-ret):
                              
                ASSIGN dt-data-aux = ADD-INTERVAL(dt-data-aux,5,"seconds")                                //Adiciona 5 segundos na data/hora anterior
                       dt-dat-ret  = DATE(dt-data-aux)                                                    //Grava a nova data
                       c-hra-ret   = STRING(INTEGER(TRUNCATE(MTIME(dt-data-aux) / 1000, 0)), "HH:MM:SS")  //Grava a nova hora
                       c-hra-ret   = REPLACE(c-hra-ret,":","").                                           //Retira o : da hora para manter da mesma forma que j† era gravado antes desse ajuste
            END.
            
            //Cria registro de retorno
            CREATE ret-nf-eletro.
            ASSIGN ret-nf-eletro.cod-estabel = nota-fiscal.cod-estabel
                   ret-nf-eletro.cod-serie   = nota-fiscal.serie
                   ret-nf-eletro.nr-nota-fis = nota-fiscal.nr-nota-fis
                   ret-nf-eletro.cod-msg     = "0":U
                   ret-nf-eletro.dat-ret     = dt-dat-ret
                   ret-nf-eletro.hra-ret     = c-hra-ret
                   ret-nf-eletro.log-ativo   = YES
                   ret-nf-eletro.cod-livre-2 = "[Msg TSS] ":U + TRIM(ttMONITORNFE.RECOMENDACAO).
        END.

        RETURN "NOK":U.
    END.

    CREATE ttReturnInvoiceDocument.
    ASSIGN ttReturnInvoiceDocument.chNFe     = TRIM(ttMONITORNFE.ID)
           ttReturnInvoiceDocument.cStat     = TRIM(ttLOTENFE.CODRETNFE)
           ttReturnInvoiceDocument.nProt     = TRIM(ttMONITORNFE.PROTOCOLO)
           ttReturnInvoiceDocument.xMotivo   = TRIM(ttLOTENFE.MSGRETNFE)
           ttReturnInvoiceDocument.tpEmis    = (&if '{&bf_dis_versao_ems}' >= '2.07':U &then
                                                   STRING(nota-fiscal.idi-forma-emis-nf-eletro) /* 1 Normal | 2 Contingància Off-line | 3 Contingància SCAN */
                                                &else
                                                   SUBSTRING(nota-fiscal.char-2,65,2)
                                                &endif)
           ttReturnInvoiceDocument.lDanfe    = NO. /*Danfe Impresso no EMS*/

    /*----
    TRATAMENTO RETORNO DE CANCELAMENTO/INUTILIZAÄ«O
    NF-e est† como 12 - Em Processo de Cancelamento ou 13 - Em Processo de Inutilizaá∆o, e retorna recomentaá∆o = <RECOMENDACAO>015 - Cancelamento autorizado</RECOMENDACAO> 
    Ent∆o, cStat assinar como 101 (Cancelamento de NF-e Homologado) ou 102 (Inutilizaá∆o de n£mero homologado) para que o produto padr∆o trate (axrep001).
    ----*/
    /* Por alguma instabilidade do TSS pode n∆o retornar o cStat */
    IF (  nota-fiscal.idi-sit-nf-eletro = 12 
       OR nota-fiscal.idi-sit-nf-eletro = 13)
    AND TRIM(ttReturnInvoiceDocument.cStat)  = "":U
    AND (    INDEX(TRIM(ttMONITORNFE.RECOMENDACAO),"Cancelamento autorizado":U) > 0
         OR  INDEX(TRIM(ttMONITORNFE.RECOMENDACAO),"015 - Cancelamento":U)      > 0)  THEN
        ASSIGN ttReturnInvoiceDocument.cStat = (IF nota-fiscal.idi-sit-nf-eletro = 12
                                                THEN "101":U
                                                ELSE "102":U).
    
    /*----
    TRATAMENTO REJEIÄ«O DE CANCELAMENTO/INUTILIZAÄ«O
    NF-e est† como 12 - Em Processo de Cancelamento ou 13 - Em Processo de Inutilizaá∆o, e retorna recomentaá∆o = <RECOMENDACAO>025 - Cancelamento n∆o transmitido</RECOMENDACAO> 
    Ent∆o, e permanecer com situaá∆o atual, 12 ou 13.
    ----*/
    IF  (nota-fiscal.idi-sit-nf-eletro      = 12 OR nota-fiscal.idi-sit-nf-eletro      = 13)
    AND (INDEX(TRIM(ttMONITORNFE.RECOMENDACAO),"Cancelamento n∆o transmitido":U) > 0
    OR   INDEX(TRIM(ttMONITORNFE.RECOMENDACAO),"Cancelamento nao transmitido":U) > 0
    OR   INDEX(TRIM(ttMONITORNFE.RECOMENDACAO),"025 - Cancelamento n":U)        > 0)
    AND (ttReturnInvoiceDocument.cStat <> "101"
    AND  ttReturnInvoiceDocument.cStat <> "151"
    AND  ttReturnInvoiceDocument.cStat <> "155")
    THEN
        RETURN "NOK":U.

    /*----
    TRATAMENTO REJEIÄ«O DE CANCELAMENTO/INUTILIZAÄ«O
    NF-e est† como 12 - Em Processo de Cancelamento ou 13 - Em Processo de Inutilizaá∆o, e retorna recomentaá∆o = <RECOMENDACAO>017 - Cancelamento n∆o autorizado</RECOMENDACAO> 
    Ent∆o, gravar ret-nf-eletro com o motivo, e voltar situaá∆o anterior.
    ----*/
    IF  (nota-fiscal.idi-sit-nf-eletro      = 12 OR nota-fiscal.idi-sit-nf-eletro      = 13)
    AND (INDEX(TRIM(ttMONITORNFE.RECOMENDACAO),"Cancelamento n∆o autorizado":U) > 0
    OR   INDEX(TRIM(ttMONITORNFE.RECOMENDACAO),"Cancelamento nao autorizado":U) > 0
    OR   INDEX(TRIM(ttMONITORNFE.RECOMENDACAO),"017 - Cancelamento n":U)        > 0
    OR   (ttReturnInvoiceDocument.cStat >= "200":U AND
          ttReturnInvoiceDocument.cStat <= "999":U))
    THEN DO:

        /*Gravar na ret-nf-eletro*/
        ASSIGN dt-data-aux = DATETIME(TODAY, MTIME)                                               //Grava a data/hora corrente
               dt-dat-ret  = DATE(dt-data-aux)                                                    //Grava a data corrente
               c-hra-ret   = STRING(INTEGER(TRUNCATE(MTIME(dt-data-aux) / 1000, 0)), "HH:MM:SS")  //Grava a hora corrente
               c-hra-ret   = REPLACE(c-hra-ret,":","").                                           //Retira o : da hora para manter da mesma forma que j† era gravado antes desse ajuste
               
        //Enquanto existir, vai gerar nova data/hora 
        DO WHILE CAN-FIND(FIRST ret-nf-eletro NO-LOCK
                          WHERE ret-nf-eletro.cod-estabel = nota-fiscal.cod-estabel
                          AND   ret-nf-eletro.cod-serie   = nota-fiscal.serie
                          AND   ret-nf-eletro.nr-nota-fis = nota-fiscal.nr-nota-fis
                          AND   ret-nf-eletro.cod-msg     = "0":U
                          AND   ret-nf-eletro.dat-ret     = dt-dat-ret
                          AND   ret-nf-eletro.hra-ret     = c-hra-ret):
                          
            ASSIGN dt-data-aux = ADD-INTERVAL(dt-data-aux,5,"seconds")                                //Adiciona 5 segundos na data/hora anterior
                   dt-dat-ret  = DATE(dt-data-aux)                                                    //Grava a nova data
                   c-hra-ret   = STRING(INTEGER(TRUNCATE(MTIME(dt-data-aux) / 1000, 0)), "HH:MM:SS")  //Grava a nova hora
                   c-hra-ret   = REPLACE(c-hra-ret,":","").                                           //Retira o : da hora para manter da mesma forma que j† era gravado antes desse ajuste
        END.
        
        //Cria registro de retorno
        CREATE ret-nf-eletro.
        ASSIGN ret-nf-eletro.cod-estabel = nota-fiscal.cod-estabel
               ret-nf-eletro.cod-serie   = nota-fiscal.serie
               ret-nf-eletro.nr-nota-fis = nota-fiscal.nr-nota-fis
               ret-nf-eletro.cod-msg     = "0":U
               ret-nf-eletro.dat-ret     = dt-dat-ret
               ret-nf-eletro.hra-ret     = c-hra-ret
               ret-nf-eletro.log-ativo   = YES
               ret-nf-eletro.cod-livre-2 = "[Msg TSS] ":U + TRIM(ttMONITORNFE.RECOMENDACAO).

        /*
        Se n∆o foi poss°vel o Cancelamento/Inutilizaá∆o, retornar para a situaá∆o anterior:
        12 NF-e em Processo de Cancelamento, volta para 3 Uso Autorizado
        13 NF-e em Processo de Inutilizaá∆o, volta para 5 Documento Rejeitado
        */
        &if "{&bf_dis_versao_ems}":U >= "2.07":U &then
        
            FIND CURRENT nota-fiscal EXCLUSIVE-LOCK NO-ERROR.                                               
                   
            ASSIGN nota-fiscal.idi-sit-nf-eletro = (IF   nota-fiscal.idi-sit-nf-eletro  = 12 
                                                    THEN IF  substring(nota-fiscal.char-2,373,2) <> ""
                                                         THEN int(substring(nota-fiscal.char-2,373,2)) /* Situaá∆o anterior ao cancelamento */
                                                         ELSE IF  ttReturnInvoiceDocument.cStat >= "200" 
                                                              AND ttReturnInvoiceDocument.cStat <= "999"
                                                              AND ttReturnInvoiceDocument.cStat <> "501"  //Pedido de cancelamento intempestivo 
                                                              THEN 5
                                                              ELSE 3
                                                    ELSE IF nota-fiscal.idi-sit-nf-eletro = 13
                                                         THEN 5
                                                         ELSE nota-fiscal.idi-sit-nf-eletro).
            FIND CURRENT nota-fiscal NO-LOCK NO-ERROR.

        &else
        
            FIND CURRENT bf-sit-nf-eletro EXCLUSIVE-LOCK NO-ERROR.

            ASSIGN bf-sit-nf-eletro.idi-sit-nf-eletro = (IF bf-sit-nf-eletro.idi-sit-nf-eletro = 12
                                                         THEN 3
                                                         ELSE IF bf-sit-nf-eletro.idi-sit-nf-eletro = 13
                                                              THEN 5
                                                              ELSE bf-sit-nf-eletro.idi-sit-nf-eletro).
            
            FIND CURRENT bf-sit-nf-eletro NO-LOCK NO-ERROR.
            
        &endif
        
        /*Gravar na ret-nf-eletro - possivel de rejeicao de pq nao foi possivel o cancelamento*/
        ASSIGN dt-data-aux = DATETIME(TODAY, MTIME)                                               //Grava a data/hora corrente
               dt-dat-ret  = DATE(dt-data-aux)                                                    //Grava a data corrente
               c-hra-ret   = STRING(INTEGER(TRUNCATE(MTIME(dt-data-aux) / 1000, 0)), "HH:MM:SS")  //Grava a hora corrente
               c-hra-ret   = REPLACE(c-hra-ret,":","").                                           //Retira o : da hora para manter da mesma forma que j† era gravado antes desse ajuste
        
        //Enquanto existir, vai gerar nova data/hora 
        DO WHILE CAN-FIND(FIRST ret-nf-eletro NO-LOCK
                          WHERE ret-nf-eletro.cod-estabel = nota-fiscal.cod-estabel
                          AND   ret-nf-eletro.cod-serie   = nota-fiscal.serie
                          AND   ret-nf-eletro.nr-nota-fis = nota-fiscal.nr-nota-fis
                          AND   ret-nf-eletro.cod-msg     = TRIM(ttLOTENFE.CODRETNFE)
                          AND   ret-nf-eletro.dat-ret     = dt-dat-ret
                          AND   ret-nf-eletro.hra-ret     = c-hra-ret):
            
            ASSIGN dt-data-aux = ADD-INTERVAL(dt-data-aux,5,"seconds")                                //Adiciona 5 segundos na data/hora anterior
                   dt-dat-ret  = DATE(dt-data-aux)                                                    //Grava a nova data
                   c-hra-ret   = STRING(INTEGER(TRUNCATE(MTIME(dt-data-aux) / 1000, 0)), "HH:MM:SS")  //Grava a nova hora
                   c-hra-ret   = REPLACE(c-hra-ret,":","").                                           //Retira o : da hora para manter da mesma forma que j† era gravado antes desse ajuste
        END.
        
        //Cria registro de retorno
        CREATE ret-nf-eletro.
        ASSIGN ret-nf-eletro.cod-estabel = nota-fiscal.cod-estabel
               ret-nf-eletro.cod-serie   = nota-fiscal.serie
               ret-nf-eletro.nr-nota-fis = nota-fiscal.nr-nota-fis
               ret-nf-eletro.cod-msg     = TRIM(ttLOTENFE.CODRETNFE)
               ret-nf-eletro.dat-ret     = dt-dat-ret
               ret-nf-eletro.hra-ret     = c-hra-ret
               ret-nf-eletro.log-ativo   = YES
               ret-nf-eletro.cod-livre-2 = "[Msg TSS] ":U + TRIM(ttLOTENFE.MSGRETNFE).

        RETURN "NOK":U.
    END.

    /*----
    TRATAMENTO PARA QUANDO RETORNAR MONITORFAIXA ANTES DO CANCELAMENTO/INUTILIZAÄ«O
    NF-e est† como: 
    12 - Em Processo de Cancelamento, e retorna novamente como Uso Autorizado, n∆o continuar processamento, e deixar situaá∆o como 12.
    13 - Em Processo de Inutilizaá∆o, e retorna novamente como Rejeiá∆o, n∆o continuar processamento, e deixar situaá∆o como 13.
    ----*/
    &if "{&bf_dis_versao_ems}":U < "2.07":U &then
    
      IF   (bf-sit-nf-eletro.idi-sit-nf-eletro = 12
      AND (ttReturnInvoiceDocument.cStat = "100":U OR  /*100 Uso Autorizado*/              
           ttReturnInvoiceDocument.cStat = "150":U))   /*150 Uso Autorizado fora de prazo*/

      OR  (bf-sit-nf-eletro.idi-sit-nf-eletro = 13
      AND (ttReturnInvoiceDocument.cStat >= "200":U AND
           ttReturnInvoiceDocument.cStat <= "999":U))

    &else
    
      IF   (nota-fiscal.idi-sit-nf-eletro = 12
      AND (ttReturnInvoiceDocument.cStat = "100":U OR  /*100 Uso Autorizado*/              
           ttReturnInvoiceDocument.cStat = "150":U))   /*150 Uso Autorizado fora de prazo*/

      OR  (nota-fiscal.idi-sit-nf-eletro = 13
      AND (ttReturnInvoiceDocument.cStat >= "200":U AND
           ttReturnInvoiceDocument.cStat <= "999":U))
    
    &endif
    THEN
        RETURN "NOK:U".

    /*Problema Eletrocal*/
    IF
      &if "{&bf_dis_versao_ems}":U < "2.07":U &then
        bf-sit-nf-eletro.idi-sit-nf-eletro = 8 /*ê retorno de Envio de NF-e*/
      &else
        nota-fiscal.idi-sit-nf-eletro      = 8
      &endif
    AND TRIM(ttMONITORNFE.PROTOCOLO) = ""
    AND TRIM(ttLOTENFE.RECIBOSEFAZ) <> ""
    AND (TRIM(ttLOTENFE.CODRETNFE)    = "100":U  /*100 Uso Autorizado*/              
    OR   TRIM(ttLOTENFE.CODRETNFE)    = "150":U) /*150 Uso Autorizado fora de prazo*/
    THEN
        ASSIGN ttReturnInvoiceDocument.nProt = TRIM(ttLOTENFE.RECIBOSEFAZ).
                                                
    /* Verificar se retornou Uso Autorizado, Canc Homologado ou Inut Homologado, se retornou nro de protocolo */
    IF ((ttReturnInvoiceDocument.cStat = "100":U OR /*100 Uso Autorizado*/              
         ttReturnInvoiceDocument.cStat = "150":U)   /*150 Uso Autorizado fora de prazo*/
    OR (ttReturnInvoiceDocument.cStat = "101":U OR  /*101 Cancelamento de NF-e homologado*/                                                
        ttReturnInvoiceDocument.cStat = "151":U OR  /*151 Cancelamento de NF-e homologado fora de prazo*/                                  
        ttReturnInvoiceDocument.cStat = "155":U)    /*155 Cancelamento homologado fora de prazo (para Evento de Cancelamento [NT2011.006]*/
    OR  ttReturnInvoiceDocument.cStat = "102":U)
    AND (ttReturnInvoiceDocument.nProt = ""
    OR   ttReturnInvoiceDocument.nProt = ?) THEN
        RETURN "NOK:U".
        
    /*Documentos com a msg de rejeicao "Limite m†ximo de consultas atingido" n∆o devem ser rejeitadas, pois n∆o est∆o com erros*/
    IF  ttLOTENFE.CODRETRECIBO = "999":U
    AND (   ttMONITORNFE.RECOMENDACAO MATCHES "*Limite m†ximo de consultas atingido, verificar retorno do ID*":U
         or ttMONITORNFE.RECOMENDACAO MATCHES "*Limite maximo de consultas atingido, verificar retorno do ID*":U)
    THEN DO:
        ASSIGN ttLOTENFE.CODRETNFE = "".
        RETURN "NOK:U".
    END. 

    RETURN "OK":U.
    
/* END PROCEDURE */


