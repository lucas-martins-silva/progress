PROCEDURE pi-grava-ttICMS53:

   /*
   === ttICMS53 ===
   orig           AS CHARACTER INITIAL ?                                           
   CST            AS CHARACTER INITIAL ?                                         
   qBCMonoDif     AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>9.9999" DECIMALS 4   
   adRemICMSDif   AS DECIMAL   INITIAL ?  FORMAT ">>9.9999"         DECIMALS 4   
   vICMSMonoDif   AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2                                           

   */   
   
   IF nota-fiscal.ind-tip-nota = 8 THEN DO:
       FOR FIRST item-doc-est NO-LOCK
           WHERE item-doc-est.serie-docto  = it-nota-fisc.serie
             AND item-doc-est.nro-docto    = nota-fiscal.nr-nota-ant 
             AND item-doc-est.cod-emitente = nota-fiscal.cod-emitente
             AND item-doc-est.nat-operacao = it-nota-fisc.nat-operacao
             AND item-doc-est.sequencia    = it-nota-fisc.nr-seq-ped:
           {dibo/bodi629.i1 item-doc-est "ICMS" d-aliquota-icms d-vl-bicms-it d-vl-imp-icms}  
       END.
   END.
   ELSE DO:
       {dibo/bodi630.i4 "ICMS" d-aliquota-icms d-vl-bicms-it d-vl-imp-icms it-nota-fisc}.
   end. 

   CREATE ttICMS53.
   ASSIGN ttICMS53.orig         = SUBSTRING(c-niv-trib-icms,1,1)        
          ttICMS53.CST          = SUBSTRING(c-niv-trib-icms,2,2)          
          ttICMS53.qBCMono      = d-vl-bicms-it   
          ttICMS53.adRemICMS    = d-aliquota-icms 
          ttICMS53.vICMSMono    = d-vl-imp-icms   .
          

           /*DIFERIMENTO - SOMENTE PARA DATASUL 11*/
           
    IF  DEC(TRIM(SUBSTRING(it-nota-fisc.char-1,308,6 ))) > 0 THEN 
        ASSIGN ttICMS53.pDif     = DEC(TRIM(SUBSTRING(it-nota-fisc.char-1,308,6 ))). /*val-perc-icms-diferim*/
        
    IF  DEC(TRIM(SUBSTRING(it-nota-fisc.char-1,314,17))) > 0 OR ttICMS53.vICMSMono > 0 THEN        
        ASSIGN ttICMS53.vICMSMonoDif = DEC(TRIM(SUBSTRING(it-nota-fisc.char-1,314,17))) /*val-diferim-icms-item*/
               ttICMS53.vICMSMonoOp  = ttICMS53.vICMSMono + ttICMS53.vICMSMonoDif.
              
   IF it-nota-fisc.cd-trib-icm  = 3  AND
      ttICMS53.pDif             = ? or ttICMS53.pDif   = 0 THEN DO:

         ASSIGN ttICMS53.pDif          = 100
                ttICMS53.qBCMono       = d-vl-imp-icmsou
                ttICMS53.adRemICms     = d-aliquota-icms
                ttICMS53.vICMSMonoDif  = d-vl-imp-icms
                ttICMS53.vICMSMonoOp   = ttICMS53.vICMSMonoDif
                ttICMS53.vICMSMono     = 0.

//        IF NOT l-icms-outras-it THEN
//            ASSIGN d-total-base-icms  = d-total-base-icms + ttICMS51.vBC.
                                    
    END.              
                 
    ASSIGN d-total-qBCMono        = d-total-qBCMono        + ttICMS53.qBCMono
           d-total-vICMSMono      = d-total-vICMSMono      + ttICMS53.vICMSMono .
                  
    /* Chave EMS */
    ASSIGN ttICMS53.CodEstabelNF = nota-fiscal.cod-estabel
           ttICMS53.SerieNF      = nota-fiscal.serie
           ttICMS53.NrNotaFisNF  = nota-fiscal.nr-nota-fis
           ttICMS53.ItCodigoNF   = it-nota-fisc.it-codigo
           ttICMS53.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.

END PROCEDURE.
