PROCEDURE pi-grava-ttICMS15:

   /*
   === ttICMS15 ===   
   orig           AS CHARACTER INITIAL ?                                          /*Origem da Mercadoria */                                                                        
   CST            AS CHARACTER INITIAL ?                                          /*15 - Tributação monofásica própria e com responsabilidade pela retenção sobre combustíveis; */ 
   qBCMono        AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>9.9999" DECIMALS 4                                                                                                     
   adRemICMS      AS DECIMAL   INITIAL ?  FORMAT ">>9.9999"         DECIMALS 4    /* Alíquota ad rem do imposto*/                                                                  
   vICMSMono      AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2    /*Valor do ICMS próprio */                                                                       
   qBCMonoReten   AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>9.9999" DECIMALS 4                                                                                                     
   adRemICMSReten AS DECIMAL   INITIAL ?  FORMAT ">>9.9999"         DECIMALS 4    /*Alíquota ad rem do imposto com retenção*/                                                      
   vICMSMonoReten AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2    /*Valor do ICMS com retenção*/        
   */   
   
   DEFINE VARIABLE d-aliquota-icms-st    AS DECIMAL    NO-UNDO.
   DEFINE VARIABLE d-vl-bicms-it-st      AS DECIMAL    NO-UNDO.
   DEFINE VARIABLE d-vl-imp-icms-st      AS DECIMAL    NO-UNDO.
   
   ASSIGN d-aliquota-icms-st  = 0
          d-vl-bicms-it-st    = 0
          d-vl-imp-icms-st    = 0.
  
   IF nota-fiscal.ind-tip-nota = 8 THEN DO:
       FOR FIRST item-doc-est NO-LOCK
           WHERE item-doc-est.serie-docto  = it-nota-fisc.serie
             AND item-doc-est.nro-docto    = nota-fiscal.nr-nota-ant 
             AND item-doc-est.cod-emitente = nota-fiscal.cod-emitente
             AND item-doc-est.nat-operacao = it-nota-fisc.nat-operacao
             AND item-doc-est.sequencia    = it-nota-fisc.nr-seq-ped:
           {dibo/bodi629.i1 item-doc-est "ICMS" d-aliquota-icms d-vl-bicms-it d-vl-imp-icms}  
           {dibo/bodi629.i1 item-doc-est "ICMS ST" d-aliquota-icms-st d-vl-bicms-it-st d-vl-imp-icms-st}  
       END.
   END.
   ELSE DO:
           {dibo/bodi630.i4 "ICMS"    d-aliquota-icms    d-vl-bicms-it    d-vl-imp-icms    it-nota-fisc}.
           {dibo/bodi630.i4 "ICMS ST" d-aliquota-icms-st d-vl-bicms-it-st d-vl-imp-icms-st it-nota-fisc}.  
   end. 

             
  
   CREATE ttICMS15.
   ASSIGN ttICMS15.orig           = SUBSTRING(c-niv-trib-icms,1,1)
          ttICMS15.CST            = SUBSTRING(c-niv-trib-icms,2,2)
          ttICMS15.qBCMono        = it-nota-fisc.vl-bicms-it
          ttICMS15.adRemICMS      = (IF it-nota-fisc.cd-trib-icm <> 3
                                     THEN d-aliquota-icms
                                     ELSE 0)          
          ttICMS15.vICMSMono      = (IF it-nota-fisc.cd-trib-icm <> 3
                                     THEN d-vl-imp-icms
                                     ELSE 0)         
          ttICMS15.qBCMonoReten   = d-vl-bicms-it-st
          ttICMS15.adRemICMSReten = d-aliquota-icms-st
          ttICMS15.vICMSMonoReten = d-vl-imp-icms-st.
          

    ASSIGN d-total-qBCMono        = d-total-qBCMono        + ttICMS15.qBCMono
           d-total-vICMSMono      = d-total-vICMSMono      + ttICMS15.vICMSMono
           d-total-qBCMonoReten   = d-total-qBCMonoReten   + ttICMS15.qBCMonoReten
           d-total-vICMSMonoReten = d-total-vICMSMonoReten + ttICMS15.vICMSMonoReten.
   

    /* Chave EMS */
    ASSIGN ttICMS15.CodEstabelNF = nota-fiscal.cod-estabel
           ttICMS15.SerieNF      = nota-fiscal.serie
           ttICMS15.NrNotaFisNF  = nota-fiscal.nr-nota-fis
           ttICMS15.ItCodigoNF   = it-nota-fisc.it-codigo
           ttICMS15.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.

END PROCEDURE.
