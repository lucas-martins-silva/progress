PROCEDURE pi-cria-ISS:
    /*
    cListServ      AS CHARACTER INITIAL ?                                         /*C¢digo da lista de serviáos da LC 116/03 em que se classifica o seriváo, campo de interesse da Prefeitura, devendo ser informado nas NFe conjugadas, onde h† a prestaá∆o de serviáos sujeitos ao ISSQN e fornecimento de peáas sujeitas ao ICMS*/
    cMunFG         AS CHARACTER INITIAL ?                                         /*C¢digo do Munic°pio de Ocorrància do Fato Gerador (utilizar a tabela do IBGE)*/
    vAliq          AS DECIMAL   INITIAL ?  FORMAT ">>9.99"           DECIMALS 2   /*Al°quota do ISSQN*/    
    vBC            AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor da BC do ISSQN*/ 
    vISSQN         AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor da do ISSQN*/  
    vDeducao       AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor deduá∆o para reduá∆o da base de c†lculo*/
    vOutro         AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor outras retená‰es*/
    vDescIncond    AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor desconto incondicionado*/
    vDescCond      AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor desconto condicionado*/
    vISSRet        AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor Retená∆o ISS*/
    indISS         AS CHARACTER INITIAL ?                                         /*Exibilidade do ISS:1-Exig°vel;2-N∆o incidente;3-Isená∆o;4-Exportaá∆o;5-Imunidade;6-Exig.Susp. Judicial;7-Exig.Susp. ADM*/
    cServico       AS CHARACTER INITIAL ?                                         /*C¢digo do serviáo prestado dentro do munic°pio*/
    cMun           AS CHARACTER INITIAL ?                                         /*C¢digo do Munic°pio de Incidància do Imposto*/
    cPais          AS CHARACTER INITIAL ?                                         /*C¢digo do pa°s onde o serviáo foi prestado*/
    nProcesso      AS CHARACTER INITIAL ?                                         /*N£mero do Processo administrativo ou judicial de suspená∆o do processo*/
    indIncentivo   AS CHARACTER INITIAL ?                                         /*Indicador de Incentivo Fiscal. 1=Sim; 2=N∆o*/
    */

    DEFINE VARIABLE c-cMunFG                AS CHARACTER   NO-UNDO.
    DEFINE VARIABLE c-cod-servico           AS CHARACTER   NO-UNDO.
    DEFINE VARIABLE c-cod-item-lista-serv   AS CHARACTER   NO-UNDO.
    DEFINE VARIABLE c-cod-tributac-munpio   AS CHARACTER   NO-UNDO.
    DEFINE VARIABLE c-cod-atividade-rps     AS CHARACTER   NO-UNDO.
    DEFINE VARIABLE c-cidade-prestacao-serv AS CHARACTER   NO-UNDO.

    ASSIGN c-cod-servico = STRING(it-nota-fisc.cod-servico).
    
    /* Carrega Cidade Prestaá∆o Serviáo - c-cMunFG */
    FOR FIRST reg-inf-compl NO-LOCK
        WHERE reg-inf-compl.cod-tab-inform   = "tab-codser":U
        AND   reg-inf-compl.cod-campo-inform = "idi-orig-cidad-prestac-serv":U,
    
        FIRST inf-compl NO-LOCK
        WHERE inf-compl.cdn-identif = reg-inf-compl.cdn-identif
        AND   inf-compl.cod-indice = c-cod-servico:

    END.

    IF  AVAIL reg-inf-compl
    AND AVAIL inf-compl
    AND inf-compl.num-campo = 2 THEN /* Origem Cidade = Estabelecimento */
        ASSIGN c-cMunFG                = STRING(IF AVAIL bf-cidade-est AND bf-cidade-est.pais = "Brasil":U 
                                                THEN (&if '{&BF_DIS_VERSAO_EMS}' >= "2.07":U
                                                      &then IF AVAIL bf-cidade-est THEN bf-cidade-est.cdn-munpio-ibge ELSE 99
                                                      &else IF AVAIL bf-cidade-est THEN bf-cidade-est.int-2           ELSE 99 &endif)
                                                ELSE 9999999)
               c-cidade-prestacao-serv = bf-cidade-est.cidade WHEN AVAIL bf-cidade-est.
    ELSE /* Origem Cidade = Local de Entrega */
        ASSIGN c-cMunFG                = STRING(IF avail bf-cidade-entrega AND bf-cidade-entrega.pais = "Brasil":U 
                                                THEN (&if '{&BF_DIS_VERSAO_EMS}' >= "2.07":U
                                                      &then IF AVAIL bf-cidade-entrega THEN bf-cidade-entrega.cdn-munpio-ibge ELSE 99
                                                      &else IF AVAIL bf-cidade-entrega THEN bf-cidade-entrega.int-2           ELSE 99 &endif)
                                                ELSE 9999999)
               c-cidade-prestacao-serv = bf-cidade-entrega.cidade WHEN AVAIL bf-cidade-entrega.
    /* Fim - Carrega Cidade Prestaá∆o Serviáo - c-cMunFG*/

    FOR FIRST tab-codser NO-LOCK
        WHERE tab-codser.cod-servico = it-nota-fisc.cod-servico:

        ASSIGN c-cod-item-lista-serv = &IF '{&bf_dis_versao_ems}' >= '2.09':U 
                                       &THEN tab-codser.cod-item-lista-serv
                                       &ELSE TRIM(SUBSTR(tab-codser.char-1,1,5))
                                       &ENDIF 
               c-cod-tributac-munpio = &IF '{&bf_dis_versao_ems}' >= '2.09':U 
                                       &THEN tab-codser.cod-tributac-munpio
                                       &ELSE TRIM(SUBSTR(tab-codser.char-1,6,20))
                                       &ENDIF
               c-cod-atividade-rps   = &IF '{&bf_dis_versao_ems}' >= '2.09':U 
                                       &THEN tab-codser.cod-ativid-rps
                                       &ELSE TRIM(SUBSTR(tab-codser.char-1,26,15))
                                       &ENDIF
                                       .
    END.

    CREATE ttISSQN.  /* ISS */
    ASSIGN ttISSQN.cListServ    = c-cod-item-lista-serv
           ttISSQN.cMunFG       = c-cMunFG
           ttISSQN.vAliq        = it-nota-fisc.aliquota-iss
           ttISSQN.vBC          = it-nota-fisc.vl-biss-it
           ttISSQN.vISSQN       = it-nota-fisc.vl-iss-it
           
           ttISSQN.vDeducao     = ?
           ttISSQN.vOutro       = ?
           ttISSQN.vDescIncond  = ?
           ttISSQN.vDescCond    = ?
           ttISSQN.vISSRet      = (IF (it-nota-fisc.cd-trib-iss = 1   /* ISS Tributado */
                                   OR  it-nota-fisc.cd-trib-iss = 4)  /* ISS Reduzido  */
                                   THEN DEC(TRIM(SUBSTRING(it-nota-fisc.char-2,218,14)))
                                   ELSE ?)
           ttISSQN.indISS       = (IF  it-nota-fisc.cd-trib-iss = 1 /*ISS Tributado*/
                                   OR  it-nota-fisc.cd-trib-iss = 4 /*ISS Reduzido*/
                                   THEN IF c-cidade-prestacao-serv = estabelec.cidade
                                        THEN "1":U /*1 - Exigivel*/
                                        ELSE "2":U /*2 - Nao incidencia*/
                                   ELSE "3":U) /*3 - Isencao*/ /*buscar do ft0308 - somente no 11*/
           ttISSQN.cServico     = ?
           ttISSQN.cMun         = STRING(IF avail bf-cidade-est and bf-cidade-est.pais = "Brasil":U  /*Municipio do Estabelecimento da Nota*/
                                         THEN (&if '{&BF_DIS_VERSAO_EMS}' >= "2.07":U
                                               &then IF AVAIL bf-cidade-est THEN bf-cidade-est.cdn-munpio-ibge ELSE 99
                                               &else IF AVAIL bf-cidade-est THEN bf-cidade-est.int-2           ELSE 99 &endif)
                                         ELSE 9999999)
           ttISSQN.cPais        = STRING(&if '{&bf_dis_versao_ems}' >= "2.06" /*Pais do Estabelecimento da Nota*/
                                         &then pais.cod-pais-siscomex
                                         &else substring(pais.char-1,1,5) &endif)
           ttISSQN.nProcesso    = ?
           ttISSQN.indIncentivo = (IF AVAIL param-nf-estab
                                   THEN IF &IF '{&bf_dis_versao_ems}' >= '2.09':U &THEN
                                              param-nf-estab.log-incevdor-cultural
                                           &ELSE
                                              SUBSTR(param-nf-estab.cod-livre-4,266,1) = "S"
                                           &ENDIF
                                        THEN "1"   /* 1 - Sim */
                                        ELSE "2"   /* 2 - Nao */
                                   ELSE "2")
           .

        
   /* Chave EMS */
   ASSIGN ttISSQN.CodEstabelNF = nota-fiscal.cod-estabel
          ttISSQN.SerieNF      = nota-fiscal.serie
          ttISSQN.NrNotaFisNF  = nota-fiscal.nr-nota-fis
          ttISSQN.ItCodigoNF   = it-nota-fisc.it-codigo
          ttISSQN.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.

   /*Item de Serviáo n∆o deve compor o total da nota */
   FOR FIRST ttDet
       WHERE ttDet.CodEstabelNF = ttISSQN.CodEstabelNF
         AND ttDet.SerieNF      = ttISSQN.SerieNF     
         AND ttDet.NrNotaFisNF  = ttISSQN.NrNotaFisNF 
         AND ttDet.ItCodigoNF   = ttISSQN.ItCodigoNF  
         AND ttDet.NrSeqFatNF   = ttISSQN.NrSeqFatNF :

       ASSIGN ttDet.indTot  = "0". /*0 Œ o valor do item (vProd) n∆o comp‰e o valor total da NF-e (vProd)*/
   END.

END PROCEDURE.