PROCEDURE pi-calcula-valor-vOutro-por-item-NFCom:

    DEFINE VARIABLE v-tot-vl-rateio-vOutro LIKE nota-fiscal.vl-embalagem NO-UNDO.
    
    EMPTY TEMP-TABLE tt-rateio-vOutro-NFcom.

    ASSIGN v-tot-vl-rateio-vOutro = 0.
    
    FOR EACH bf-it-nota-fisc-rat NO-LOCK
       WHERE bf-it-nota-fisc-rat.cod-estabel = nota-fiscal.cod-estabel
         AND bf-it-nota-fisc-rat.serie       = nota-fiscal.serie
         AND bf-it-nota-fisc-rat.nr-nota-fis = nota-fiscal.nr-nota-fis
        BREAK BY bf-it-nota-fisc-rat.cod-estabel
              BY bf-it-nota-fisc-rat.serie
              BY bf-it-nota-fisc-rat.nr-nota-fis
              BY bf-it-nota-fisc-rat.nr-seq-fat
              BY bf-it-nota-fisc-rat.vl-tot-item:
    
         CREATE tt-rateio-vOutro-NFcom.
         ASSIGN tt-rateio-vOutro-NFcom.nr-seq-fat = bf-it-nota-fisc-rat.nr-seq-fat
                tt-rateio-vOutro-NFcom.it-codigo  = bf-it-nota-fisc-rat.it-codigo
                tt-rateio-vOutro-NFcom.percentual = ((bf-it-nota-fisc-rat.vl-tot-item * 100) / nota-fiscal.vl-tot-nota)
                tt-rateio-vOutro-NFcom.valor      = IF bf-it-nota-fisc-rat.vl-merc-liq > 0
                                                    THEN trunc(bf-it-nota-fisc-rat.vl-merc-liq / nota-fiscal.vl-mercad   * nota-fiscal.vl-embalagem, 2)  
                                                    ELSE trunc(bf-it-nota-fisc-rat.vl-tot-item / nota-fiscal.vl-tot-nota * nota-fiscal.vl-embalagem, 2)  
                v-tot-vl-rateio-vOutro            = v-tot-vl-rateio-vOutro + tt-rateio-vOutro-NFCom.valor.
    
         IF  LAST-OF (bf-it-nota-fisc-rat.cod-estabel) THEN DO:
             IF  v-tot-vl-rateio-vOutro <> nota-fiscal.vl-embalagem THEN
                 ASSIGN tt-rateio-vOutro-NFcom.valor = tt-rateio-vOutro-NFcom.valor + (nota-fiscal.vl-embalagem - v-tot-vl-rateio-vOutro).
         END.
    END.

END PROCEDURE.
