PROCEDURE pi-cria-ttRetTribTot-NFCom:

    /*
    === ttRetTribTotNFCom ===
     vIRRF          AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor Retido de IRRF*/    
     vRetCOFINS     AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor Retido de COFINS*/  
     vRetCSLL       AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor Retido de CSLL*/    
     vRetPIS        AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor Retido de PIS*/     
    */                
      CREATE ttRetTribTotNFCom.
      ASSIGN ttRetTribTotNFCom.vRetPIS    = d-total-ret-pis     
             ttRetTribTotNFCom.vRetCOFINS = d-total-ret-cofins 
	     ttRetTribTotNFCom.vRetCSLL   = d-total-ret-csll
             ttRetTribTotNFCom.vIRRF      = d-total-ret-irf .

      /* Chave EMS */
      ASSIGN ttRetTribTotNFCom.CodEstabelNF = nota-fiscal.cod-estabel
             ttRetTribTotNFCom.SerieNF      = nota-fiscal.serie
             ttRetTribTotNFCom.NrNotaFisNF  = nota-fiscal.nr-nota-fis.
             
END PROCEDURE.
