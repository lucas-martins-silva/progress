PROCEDURE pi-prepara-dados-nfcom:

    RUN cdp/cdapi704.p PERSISTENT SET h-cdapi704.

    RUN pi-limpa-temp-tables.

    RUN pi-localiza-tabelas.
    
    IF  nota-fiscal.vl-embalagem <> 0 THEN
        RUN pi-calcula-valor-vOutro-por-item-NFCom.
    
    ASSIGN lLayoutXML     = (IF  tp-integ <> "Manual":U 
                             AND tp-integ <> "Nenhum":U
                             THEN YES /* Aplicativo de Transmissão */
                             ELSE NO).

    ASSIGN c-serie = nota-fiscal.serie.     
    ASSIGN c-serie = IF  c-serie = ""
                     THEN "0"
                     ELSE c-serie.                         
                         
    RUN pi-grava-temp-tables.

    ASSIGN d-total-base-icms           = 0
           d-total-icms                = 0
           d-total-vl-desc-icms        = 0
           d-total-vFCP                = 0            
           d-total-vProd               = 0
           d-total-vFUST               = 0
           d-total-vFUNTTEL            = 0
           d-total-pis                 = 0
           d-total-cofins              = 0
           d-desconto-total            = 0 
           d-total-ret-pis             = 0
           d-total-ret-cofins          = 0
	   d-total-ret-csll            = 0
           d-total-ret-irf             = 0            .
                                                                                
    IF  VALID-HANDLE(h-cdapi704) THEN DO:
        DELETE PROCEDURE h-cdapi704.
        ASSIGN h-cdapi704 = ?.
    END.
END PROCEDURE.