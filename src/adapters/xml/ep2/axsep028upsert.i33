PROCEDURE pi-cria-ttICMSSN:
        
    CREATE ttICMSSN.         
    ASSIGN ttICMSSN.CodEstabelNFCom = nota-fiscal.cod-estabel
           ttICMSSN.SerieNFCom      = nota-fiscal.serie
           ttICMSSN.NrNotaFisNFCom  = nota-fiscal.nr-nota-fis
           ttICMSSN.CST             = "90"
           ttICMSSN.indSN           = "1".
            
	    
END PROCEDURE.
