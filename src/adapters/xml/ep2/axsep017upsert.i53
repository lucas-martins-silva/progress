PROCEDURE pi-cria-ttInfAdic:

    DEFINE VARIABLE c-observacao AS CHARACTER   NO-UNDO.

    /*
    === ttInfAdic ===
    infAdFisco     AS CHARACTER INITIAL ?  /*Informa‡äes adicionais de interesse do Fisco*/
    infCpl         AS CHARACTER INITIAL ?  /*Informa‡äes complementares de interesse do Contribuinte*/
    */
    
    IF  AVAIL nota-fiscal AND (AVAIL ttIde AND ttIde.tpemis <> "1") THEN DO: /* TODOS QUE SÇO DIFERENTE DE 1 SÇO CONTIGENCIA */
        FIND b-nota-fiscal EXCLUSIVE-LOCK WHERE ROWID(b-nota-fiscal) = ROWID(nota-fiscal) NO-ERROR.
        IF  AVAIL b-nota-fiscal THEN DO:

            IF  INDEX(b-nota-fiscal.observ-nota,"Data/Hora entrada em contingencia":U) = 0 THEN /* ainda nÆo gravou msg de contingencia na observa‡Æo */
                ASSIGN b-nota-fiscal.observ-nota = b-nota-fiscal.observ-nota 
                                                 + " " 
                                                 + ttIde.xJust  /* carregado na pi-cria-ttDet - mensagem.texto-mensag */
                                                 + " Data/Hora entrada em contingencia: ":U
                                                 + STRING(DAY(b-nota-fiscal.dt-emis-nota),"99")    + "/"
                                                 + STRING(MONTH(b-nota-fiscal.dt-emis-nota),"99")  + "/"
                                                 + STRING(YEAR(b-nota-fiscal.dt-emis-nota),"9999") + " " 
                                                 + cHoraContingencia       /* Formato DD/MM/YYYY HH:MM:SS */
                                                 + " |". /* separador observa‡Æo de msgs diferentes */

        END.
    END.

    ASSIGN c-observacao = nota-fiscal.observ-nota.

    IF NOT l-retira-out-desp-obs THEN
        ASSIGN c-observacao = c-observacao + IF d-total-pis-st        > 0 THEN ("   " + "VL PIS-ST (Outras Despesas): "                           + TRIM(STRING(d-total-pis-st       ,">,>>>,>>>,>>9.99"))) ELSE ""
               c-observacao = c-observacao + IF d-total-cofins-st     > 0 THEN (" | " + "VL COFINS-ST (Outras Despesas): "                        + TRIM(STRING(d-total-cofins-st    ,">,>>>,>>>,>>9.99"))) ELSE ""
               c-observacao = c-observacao + IF d-total-IPI-espec     > 0 THEN (" | " + "VL IPI (Outras Despesas): "                              + TRIM(STRING(d-total-IPI-espec    ,">,>>>,>>>,>>9.99"))) ELSE ""
               c-observacao = c-observacao + IF d-total-icms-ST-espec > 0 THEN (" | " + "VL ICMS-ST (Outras Despesas): "                          + TRIM(STRING(d-total-icms-ST-espec,">,>>>,>>>,>>9.99"))) ELSE ""
               c-observacao = c-observacao + IF d-total-ipi-out-tot   > 0 THEN (" | " + "VL IPI Outros (Outras Despesas): "                       + TRIM(STRING(d-total-ipi-out-tot  ,">,>>>,>>>,>>9.99"))) ELSE ""
               c-observacao = c-observacao + IF d-total-desp-n-destaq > 0 THEN (" | " + "VL Despesas Frete/Seguro/Embalagem (Outras Despesas): "  + TRIM(STRING(d-total-desp-n-destaq,">,>>>,>>>,>>9.99"))) ELSE ""
               .

    CREATE ttInfAdic.
    ASSIGN /*ttInfAdic.infAdFisco   = ""*/
           ttInfAdic.infCpl       = REPLACE(c-observacao,CHR(10), " ")
           ttInfAdic.infCpl       = REPLACE(ttInfAdic.infCpl,       CHR(13), " ")
           ttInfAdic.infCpl       = REPLACE(ttInfAdic.infCpl,       CHR(9), " ")
           ttInfAdic.infCpl       = IF  lLayoutTXT THEN REPLACE(ttInfAdic.infCpl, "|", "/") ELSE ttInfAdic.infCpl
           ttInfAdic.infCpl       = fn-ajusta-espacos-branco(ttInfAdic.infCpl)
           ttInfAdic.infCpl       = fn-ajusta-tamanho-campo(ttInfAdic.infCpl ,5000).

    /* Chave EMS */
    ASSIGN ttInfAdic.CodEstabelNF = nota-fiscal.cod-estabel
           ttInfAdic.SerieNF      = nota-fiscal.serie
           ttInfAdic.NrNotaFisNF  = nota-fiscal.nr-nota-fis.


END PROCEDURE.