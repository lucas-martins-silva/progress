                    IF ttEmpresa.cnpj <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "NIRE":U, SUBSTR(ttEmpresa.cnpj,1,11), OUTPUT iId).

                    /* IF ttEmpresa.nire <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "NIRE":U, ttEmpresa.nire, OUTPUT iId). */

