                    IF ttEmpresa.uf <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "UF":U, ttEmpresa.uf, OUTPUT iId).
               delStack().

          END.

          IF CAN-FIND(FIRST ttInscricao) THEN DO:
             
             RUN addNode IN hGenXml (getStack(), "OUTRASINSCRICOES":U, "":U, OUTPUT iId).
             addStack(iId).
        
                  FOR EACH ttInscricao:
