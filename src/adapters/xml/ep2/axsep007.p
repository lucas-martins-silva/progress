RUN setKeyFields IN hMessageHandler ("Codigo Estabelecimento":U, ttEmpresa.cod-estabel).



/* INFORMA A EMPRESA E O ESTABELECIMENTO */
RUN setCompanyId IN hMessageHandler (STRING(v_cdn_empres_usuar), "").


     /* RESETA OS VALORES */
