/* Grava XML enviado ao TSS na fila do EAI */
/* Com o TSS Sincrono n∆o ser† mais utilizado a Fila EAI */
/*RUN piFilaEAI(1,c-cod-estabel).*/

/* VERIFICA SE A MENSAGEM FOI PROCESSADA COM SUCESSO */
RUN getReturnStatus IN hMessageHandler (OUTPUT pSendSuccess, OUTPUT pTotalErrors).

/* SE NAO ENVIO COM SUCESSO */
IF NOT pSendSuccess THEN DO:
     REPEAT iCount = 1 TO pTotalErrors:
          CREATE TT_LOG_ERRO.
          RUN getError IN hMessageHandler (iCount, OUTPUT TT_LOG_ERRO.TTV_NUM_COD_ERRO, OUTPUT pErrorType, OUTPUT TT_LOG_ERRO.TTV_DES_MSG_ERRO).
          ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 17567.
     END.
     RETURN "NOK".
END.
ELSE DO: 
         
         /* Là mensagem de retorno e verifica se a NF-e tem uso autorizado */
         RUN getCompleteReturnHandle IN hMessageHandler (OUTPUT hOutputXML).

         RUN reset              IN hGenXml.
         RUN loadXml            IN hGenXml (INPUT hOutputXML).
        
         RUN searchTag IN hGenXML ( INPUT "DatasulMessage":U, INPUT 0,  OUTPUT iIdDatasulMessage).
         IF iIdDatasulMessage <> ? THEN DO:
             addStack(iIdDatasulMessage). 
                 RUN searchTag IN hGenXml (INPUT "ReturnContent":U, INPUT iIdDatasulMessage, OUTPUT iIdReturnContent). 
                 IF iIdReturnContent <> ? THEN DO:
                     addStack(iIdReturnContent). 
        
                        RUN searchTag IN hGenXml (INPUT "ListOfExtraInformation":U, INPUT iIdReturnContent, OUTPUT iIdListOfExtraInformation). 
                        IF iIdListOfExtraInformation <> ? THEN DO:
                            addStack(iIdListOfExtraInformation). 
            
                                RUN getFirstSonId IN hGenXml (INPUT iIdListOfExtraInformation, OUTPUT iIdExtraInformation). 

                                DO WHILE (NOT l-id AND iIdExtraInformation <> ?): /* tags ExtraInformation */
                                addStack(iIdExtraInformation).

                                    RUN getSonVal  IN hGenXml (INPUT iIdExtraInformation, INPUT "Key":U, OUTPUT cKey).
                                    IF cKey = "ID_ENT":U  THEN DO:
                                       RUN getSonVal IN hGenXml (INPUT iIdExtraInformation, INPUT "Value":U, OUTPUT cIdEnt).
                                       ASSIGN l-id = YES.
                                    END.

                                delStack().  
                                END.
                            delStack().  
                        END.
        
                     delStack().
                 END.
             delStack().
         END.

         /* Grava ID da empresa gerado pelo TSS */
         IF l-id THEN DO:  
                                                                                                                    
            FOR FIRST b-estabelec FIELDS(cod-estabel) 
                WHERE b-estabelec.cod-estabel = c-cod-estabel NO-LOCK:
                
                FOR FIRST param-nf-estab FIELDS(ind-empresa) 
                    WHERE param-nf-estab.cod-estabel = b-estabelec.cod-estabel EXCLUSIVE-LOCK:
                END.

                IF NOT AVAIL param-nf-estab THEN DO:
                   CREATE param-nf-estab.
                   ASSIGN param-nf-estab.cod-estabel = b-estabelec.cod-estabel.
                END.
                ASSIGN param-nf-estab.ind-empresa = cIdEnt.
            
            END.
         END.
END.

/* Grava XML de retorno na fila do EAI */
/* Com o TSS Sincrono n∆o ser† mais utilizado a Fila EAI */
/* RUN piFilaEAI(2,c-cod-estabel). */

RETURN "OK":U.

