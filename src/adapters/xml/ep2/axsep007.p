     RUN setEncoding IN hGenXml ("UTF-8").


     RUN addNode IN hGenXml (getStack(), "Upsert":U, "":U, OUTPUT iId).
     addStack(iId).

          FOR EACH ttEmpresa:
               RUN addNode IN hGenXml (getStack(), "EMPRESA":U, "":U, OUTPUT iId).
               addStack(iId).

                    IF ttEmpresa.bairro <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "BAIRRO":U, ttEmpresa.bairro, OUTPUT iId).

                    IF ttEmpresa.cep <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "CEP":U, ttEmpresa.cep, OUTPUT iId).

                    IF ttEmpresa.cep-cp <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "CEP_CP":U, ttEmpresa.cep-cp, OUTPUT iId).

                    IF ttEmpresa.cnpj <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "CNPJ":U, ttEmpresa.cnpj, OUTPUT iId).

                    IF ttEmpresa.cod-mun <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "COD_MUN":U, ttEmpresa.cod-mun, OUTPUT iId).

                    IF ttEmpresa.cod-pais <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "COD_PAIS":U, ttEmpresa.cod-pais, OUTPUT iId).

                    IF ttEmpresa.complemento <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "COMPL":U, ttEmpresa.complemento, OUTPUT iId).

                    IF ttEmpresa.cp <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "CP":U, ttEmpresa.cp, OUTPUT iId).

                    IF ttEmpresa.cpf <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "CPF":U, ttEmpresa.cpf, OUTPUT iId).

                    IF ttEmpresa.ddd <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "DDD":U, ttEmpresa.ddd, OUTPUT iId).

                    IF ttEmpresa.email <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "EMAIL":U, ttEmpresa.email, OUTPUT iId).

                    IF ttEmpresa.endereco <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "ENDERECO":U, ttEmpresa.endereco, OUTPUT iId).

                    IF ttEmpresa.nome-fantasia <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "FANTASIA":U, ttEmpresa.nome-fantasia, OUTPUT iId).

                    IF ttEmpresa.fax <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "FAX":U, ttEmpresa.fax, OUTPUT iId).

                    IF ttEmpresa.fone <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "FONE":U, ttEmpresa.fone, OUTPUT iId).

                    IF ttEmpresa.id-matriz <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "ID_MATRIZ":U, ttEmpresa.id-matriz, OUTPUT iId).

                    IF ttEmpresa.insc-estadual <> ? THEN
                        RUN addNode IN hGenXml (getStack(), "IE":U, ttEmpresa.insc-estadual, OUTPUT iId).

                    IF ttEmpresa.insc-municipal <> ? THEN
