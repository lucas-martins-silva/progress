          FOR EACH ttLotSerieInvoice:
               RUN addNode IN hGenXml (getStack(), "LotSerieInvoice", "", OUTPUT iId).
               addStack(iId).

                    RUN addNode IN hGenXml (getStack(), "Site", ttLotSerieInvoice.Site, OUTPUT iId).
                    RUN addNode IN hGenXml (getStack(), "Serie", ttLotSerieInvoice.Serie, OUTPUT iId).
                    RUN addNode IN hGenXml (getStack(), "DocumentNumber", ttLotSerieInvoice.DocumentNumber, OUTPUT iId).
                    RUN addNodeDec IN hGenXml (getStack(), "Sequence", ttLotSerieInvoice.Sequence, OUTPUT iId).
                    RUN addNode IN hGenXml (getStack(), "ItemCode", ttLotSerieInvoice.ItemCode, OUTPUT iId).
                    RUN addNode IN hGenXml (getStack(), "Warehouse", ttLotSerieInvoice.Warehouse, OUTPUT iId).
                    RUN addNode IN hGenXml (getStack(), "BinLocation", ttLotSerieInvoice.BinLocation, OUTPUT iId).
                    RUN addNode IN hGenXml (getStack(), "LotSerie", ttLotSerieInvoice.LotSerie, OUTPUT iId).
                    RUN addNodeDate IN hGenXml (getStack(), "LotValidityDate", ttLotSerieInvoice.LotValidityDate, OUTPUT iId).
                    RUN addNodeDec IN hGenXml (getStack(), "Quantity1", ttLotSerieInvoice.Quantity1, OUTPUT iId).
                    RUN addNodeDec IN hGenXml (getStack(), "Quantity2", ttLotSerieInvoice.Quantity2, OUTPUT iId).
               delStack().

          END.

     delStack().


/* OBTEM O XML NUMA HANDLE */
RUN generateXML IN hGenXml (OUTPUT hBusinessContent).


/* DEFINE O CONTE‚DO DO ELEMENTO BusinessContent */
RUN setBusinessContent IN hMessageHandler (INPUT hBusinessContent).

/* LIBERA MEM…RIA ALOCADA PARA O OBJETO */
DELETE OBJECT hBusinessContent NO-ERROR.



/*CONTR…I A MENSAGEM XML E ENVIA PARA O ControlBroker */
RUN sendMessage IN hMessageHandler (INPUT "xmlschema/ep2/consultinvoiceitemdocument_206_000.xsd"). 

/* VERIFICA SE OCORREU ALGUM ERRO */
IF RETURN-VALUE <> "OK" THEN DO:
     CREATE TT_LOG_ERRO.
          ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 0.
          /* Inicio -- Projeto Internacional */
          DEFINE VARIABLE c-lbl-liter-4 AS CHARACTER NO-UNDO.
          ASSIGN c-lbl-liter-4 = TRIM(RETURN-VALUE).
          DEFINE VARIABLE c-lbl-liter-erro-no-envio-da-mensagem-2 AS CHARACTER NO-UNDO.
          {utp/ut-liter.i "Erro_no_envio_da_Mensagem" *}
          ASSIGN c-lbl-liter-erro-no-envio-da-mensagem-2 = TRIM(RETURN-VALUE).
          ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO = c-lbl-liter-erro-no-envio-da-mensagem-2 + ": "+ c-lbl-liter-4.
     RETURN RETURN-VALUE.
END.



/* VERIFICA SE A MENSAGEM FOI PROCESSADA COM SUCESSO */
RUN getReturnStatus IN hMessageHandler (OUTPUT pSendSuccess, OUTPUT pTotalErrors).



/* SE NAO ENVIO COM SUCESSO */
IF NOT pSendSuccess THEN DO:
     REPEAT iCount = 1 TO pTotalErrors:
          CREATE TT_LOG_ERRO.
          RUN getError IN hMessageHandler (iCount, OUTPUT TT_LOG_ERRO.TTV_NUM_COD_ERRO, OUTPUT pErrorType, OUTPUT TT_LOG_ERRO.TTV_DES_MSG_ERRO).
     END.
     RETURN "NOK".
END.
ELSE RETURN "OK".

/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.


