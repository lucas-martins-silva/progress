PROCEDURE pi-cria-ttInfDCeSupl: 

    /*
    === ttInfDCeSupl===
     FIELD qrCode            AS CHARACTER INITIAL ? //Texto com o QR-Code impresso no DACE
     FIELD urlChave          AS CHARACTER INITIAL ? //URL para consulta da Chave de Acesso
    */
    
    CREATE ttInfDCeSupl.       
    ASSIGN /* Chave EMS */ 
           ttInfDCeSupl.CodEstabelDCe = dce-documento.cod-estabel
           ttInfDCeSupl.SerieDCe      = dce-documento.serie
           ttInfDCeSupl.NrDCe         = dce-documento.nr-dce
           /* Chave EMS */ 
           
           ttInfDCeSupl.qrCode       = dce-documento.qr-code
           ttInfDCeSupl.urlChave     = dce-documento.url-chave.
           
    /* Ajusta Formatacao dos Campos */
    IF  AVAIL ttInfDCeSupl THEN DO:
        ASSIGN ttInfDCeSupl.qrCode   = REPLACE(ttInfDCeSupl.qrCode, CHR(10), " ")
               ttInfDCeSupl.qrCode   = REPLACE(ttInfDCeSupl.qrCode, CHR(13), " ")
               ttInfDCeSupl.qrCode   = REPLACE(ttInfDCeSupl.qrCode, CHR(9),  " ")
               ttInfDCeSupl.qrCode   = fn-ajusta-espacos-branco(ttInfDCeSupl.qrCode)
               ttInfDCeSupl.qrCode   = fn-ajusta-tamanho-campo(ttInfDCeSupl.qrCode ,600)
               ttInfDCeSupl.urlChave = REPLACE(ttInfDCeSupl.urlChave, CHR(10), " ")
               ttInfDCeSupl.urlChave = REPLACE(ttInfDCeSupl.urlChave, CHR(13), " ")
               ttInfDCeSupl.urlChave = REPLACE(ttInfDCeSupl.urlChave, CHR(9),  " ")
               ttInfDCeSupl.urlChave = fn-ajusta-espacos-branco(ttInfDCeSupl.urlChave)
               ttInfDCeSupl.urlChave = fn-ajusta-tamanho-campo(ttInfDCeSupl.urlChave ,85).
    END.
END PROCEDURE.
