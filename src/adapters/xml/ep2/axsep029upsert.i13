PROCEDURE pi-cria-ttTransp: 

    /*
    === ttTransp===
    modTrans      AS CHARACTER INITIAL ?  //Modalidade do transporte 0=Transporte pelos correios; 1=Transporte por contra pr¢pria; 2=Transporte por empresa transportadora
    CNPJTransp    AS CHARACTER INITIAL ?  //CNPJ da Transportadora
    */
    
    CREATE ttTransp.       
    ASSIGN /* Chave EMS */ 
           ttTransp.CodEstabelDCe = dce-documento.cod-estabel
           ttTransp.SerieDCe      = dce-documento.serie
           ttTransp.NrDCe         = dce-documento.nr-dce
           /* Chave EMS */ 
           
           ttTransp.modTrans      = dce-documento.cod-modalid-frete
           ttTransp.CNPJTransp    = dce-documento.cnpj-transp.
           
           
    /* Ajusta Formatacao dos Campos */
    IF  AVAIL ttTransp THEN DO:
        ASSIGN ttTransp.modTrans   = fn-ajusta-tamanho-campo(ttTransp.modTrans,1)   
               ttTransp.CNPJTransp = fn-ajusta-tamanho-campo(ttTransp.CNPJTransp,14).
               
    END.
           
   
END PROCEDURE.