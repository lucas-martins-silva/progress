PROCEDURE pi-cria-ttICMSTot:

    FIND FIRST param-global NO-LOCK NO-ERROR.

    /*
    === ttICMSTot ===
    vBC            AS DECIMAL   INITIAL ?  /*BC do ICMS*/
    vBCST          AS DECIMAL   INITIAL ?  /*BC do ICMS ST*/
    vCOFINS        AS DECIMAL   INITIAL ?  /*Valor do COFINS*/
    vDesc          AS DECIMAL   INITIAL ?  /*Valor Total do Desconto*/
    vFrete         AS DECIMAL   INITIAL ?  /*Valor Total do Frete*/
    vICMS          AS DECIMAL   INITIAL ?  /*Valor Total do ICMS*/
    vII            AS DECIMAL   INITIAL ?  /*Valor Total do II*/
    vIPI           AS DECIMAL   INITIAL ?  /*Valor Total do IPI*/
    vNF            AS DECIMAL   INITIAL ?  /*Valor Total da NF-e*/
    vOutro         AS DECIMAL   INITIAL ?  /*Outras Despesas acess¢rias*/
    vPIS           AS DECIMAL   INITIAL ?  /*Valor do PIS*/
    vProd          AS DECIMAL   INITIAL ?  /*Valor Total dos produtos e servi‡os*/
    vSeg           AS DECIMAL   INITIAL ?  /*Valor Total do Seguro*/
    vST            AS DECIMAL   INITIAL ?  /*Valor Total do ICMS ST*/
    vTotTrib       AS DECIMAL   INITIAL 0  /*Valor aproximado total de tributos federais, estaduais e municipais - NT2013.003*/
    vICMSDeson     AS DECIMAL   INITIAL ?  /*Valor Total do ICMS desonerado*/
    */


    CREATE ttICMSTot.
    ASSIGN ttICMSTot.vBC                = d-total-base-icms
           ttICMSTot.vBCST              = d-total-base-icms-st
           ttICMSTot.vCOFINS            = d-total-cofins
           ttICMSTot.vFrete             = nota-fiscal.vl-frete
           ttICMSTot.vICMS              = d-total-icms
           ttICMSTot.vII                = d-total-ii
           ttICMSTot.vIPI               = d-total-ipi
           ttICMSTot.vNF                = nota-fiscal.vl-tot-nota
           ttICMSTot.vOutro             = nota-fiscal.vl-embalagem /*d-total-outras-desp*/
           ttICMSTot.vOutro             = (ttICMSTot.vOutro - ttICMSTot.vII  /* retira valor do II */ )
           ttICMSTot.vOutro             = (if ttICMSTot.vOutro < 0 
                                           then 0
                                           else ttICMSTot.vOutro) /* correcao valor negativo quando nÆo h  valor em vOutro mas possui vII */
           ttICMSTot.vOutro             = (ttICMSTot.vOutro + d-total-pis-st + d-total-cofins-st) WHEN NOT l-nt2020005
           ttICMSTot.vPIS               = d-total-pis
           ttICMSTot.vProd              = de-vProdTotal         /* valor total produtos bruto   */
           ttICMSTot.vSeg               = nota-fiscal.vl-seguro
           ttICMSTot.vST                = d-total-icms-st
           ttICMSTot.vICMSDeson         = d-total-vl-desc-icms
           ttICMSTot.vFCPUFDest         = d-total-vFCPUFDest  
           ttICMSTot.vICMSUFDest        = d-total-vICMSUFDest 
           ttICMSTot.vICMSUFRemet       = d-total-vICMSUFRemet           
           ttICMSTot.vFCP               = d-total-vFCP     
           ttICMSTot.vFCPST             = d-total-vFCPST   
           ttICMSTot.vFCPSTRet          = d-total-vFCPSTRet
           ttICMSTot.vIPIDevol          = d-total-vIPIDevol
           ttICMSTot.qBCMono            = d-total-qBCMono
           ttICMSTot.vICMSMono          = d-total-vICMSMono
           ttICMSTot.qBCMonoReten       = d-total-qBCMonoReten  
           ttICMSTot.vICMSMonoReten     = d-total-vICMSMonoReten
           ttICMSTot.qBCMonoRet         = d-total-qBCMonoRet    
           ttICMSTot.vICMSMonoRet       = d-total-vICMSMonoRet  
           .                                     

    ASSIGN ttICMSTot.vOutro = (ttICMSTot.vOutro + d-total-icms-STA + de-tot-FCPSTA + d-total-IPI-espec + d-total-icms-ST-espec + d-total-ipi-out-tot + d-total-desp-n-destaq + d-total-icms-ST-devol + d-total-vIPIDevol-vOutro).
    
    find first natur-oper no-lock 
         where natur-oper.nat-operacao = nota-fiscal.nat-operacao no-error.
    if avail natur-oper and substring(natur-oper.char-1,171,1) = "1" then do:
        for first ttDI no-lock: end.
        if avail ttDI then
           assign ttICMSTot.vOutro = ttICMSTot.vOutro - ttDI.vAFRMM. /* deduz valor do AFRMM */
    end.   
    
    IF ttICMSTot.vOutro < 0 THEN
       ASSIGN ttICMSTot.vOutro = 0.

    
    /*Descontos*/
    ASSIGN ttICMSTot.vDesc = 0.
    
    //Evitar falha de Schema - NF de devolução - CST 51 - DMANFATMANUT-6949
    IF ttICMSTot.vFCP < 0 OR ttICMSTot.vFCP = ? THEN
        ASSIGN ttICMSTot.vFCP = 0.

    /*FOR EACH ttDet
       WHERE ttDet.vDesc > 0:
        
    END. */

    ASSIGN ttICMSTot.vDesc = d-desconto-total.

    /*--- NT2013.003 | Lei 12.741/12 - Valor aproximado total de tributos federais, estaduais e municipais --*/
    ASSIGN ttICMSTot.vTotTrib  = (&IF '{&BF_DIS_VERSAO_EMS}' >= '2.09'
                                  &THEN nota-fiscal.val-tot-impto
                                  &ELSE DEC(SUBSTRING(nota-fiscal.char-1,248,17)) &ENDIF).
    /*---*/
    /* Majora ICMS ST com FCP ST fun‡Æo por estado - EX: MT */ 
    IF l-Majora-FCP = YES THEN DO:
        ASSIGN ttICMSTot.vST       = ttICMSTot.vST + ttICMSTot.vFCPST + ttICMSTot.vFCPSTRet
               ttICMSTot.vFCPST    = 0
               ttICMSTot.vFCPSTRet = 0.
    END. 
/*     ************************************************************************************************************************   */
/*     COMENTADO E AGUARDANDO DEFINI€ÇO DA REJEI€ÇO 610                                                                           */
/*     ************************************************************************************************************************   */
/*     /*--- NT2011.004 ---*/                                                                                                     */
/*     /*                                                                                                                         */
/*     Rejei‡Æo 610 - Rejei‡Æo: Total da NF difere do somat¢rio dos Valores compäe o valor Total da NF.                           */
/*     Total do vNF (id:W16) difere do somat¢rio de:                                                                              */
/*     (+) vProd  (id:W07)                                                                                                        */
/*     (-) vDesc  (id:W10)                                                                                                        */
/*     (+) vST    (id:W06)                                                                                                        */
/*     (+) vFrete (id:W08)                                                                                                        */
/*     (+) vSeg   (id:W09)                                                                                                        */
/*     (+) vOutro (id:W15)                                                                                                        */
/*     (+) vII    (id:W11)                                                                                                        */
/*     (+) vIPI   (id:W12)                                                                                                        */
/*     (+) vServ  (id:W18) [ISSQNTot]                                                                                             */
/*     */                                                                                                                         */
/*                                                                                                                                */
/*     FIND FIRST ttISSQNTot NO-LOCK NO-ERROR.                                                                                    */
/*                                                                                                                                */
/*     ASSIGN ttICMSTot.vNF = ( ttICMSTot.vProd                                                                                   */
/*                            - ttICMSTot.vDesc                                                                                   */
/*                            + ttICMSTot.vST                                                                                     */
/*                            + ttICMSTot.vFrete                                                                                  */
/*                            + ttICMSTot.vSeg                                                                                    */
/*                            + ttICMSTot.vOutro                                                                                  */
/*                            + ttICMSTot.vII                                                                                     */
/*                            + ttICMSTot.vIPI                                                                                    */
/*                            + (IF AVAIL ttISSQNTot                                                                              */
/*                               THEN ttISSQNTot.vServ                                                                            */
/*                               ELSE 0) ).                                                                                       */
/*     /*--- FIM NT2011.004 ---*/                                                                                                 */
/*                                                                                                                                */

    /* Chave EMS */
    ASSIGN ttICMSTot.CodEstabelNF = nota-fiscal.cod-estabel
           ttICMSTot.SerieNF      = nota-fiscal.serie
           ttICMSTot.NrNotaFisNF  = nota-fiscal.nr-nota-fis.

END PROCEDURE.
