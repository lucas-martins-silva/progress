PROCEDURE pi-cria-ttrastro:

DEF BUFFER bf-nota-fiscal  FOR nota-fiscal.
DEF BUFFER bf-it-nota-fisc FOR it-nota-fisc.
DEF BUFFER bf-fat-ser-lote FOR fat-ser-lote.
DEF BUFFER brat-componente FOR rat-componente.

    
    /*
    === ttrastro ===
     nLote          AS CHARACTER INITIAL ?                                   /*Número do Lote do produto*/
     qLote          AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>9.999" DECIMALS 3 /*Quantidade de produto no Lote*/
     dFab           AS DATE      INITIAL ?                                   /*Data de fabricaªío/ Produªío*/
     dVal           AS DATE      INITIAL ?                                   /*Data de validade*/
     cAgreg         AS CHARACTER INITIAL ?                                   /*CΩdigo de Agregaªío*/
     /*Chave EMS*/
      CodEstabelNF   AS CHARACTER INITIAL ?
      SerieNF        AS CHARACTER INITIAL ?
      NrNotaFisNF    AS CHARACTER INITIAL ?
      ItCodigoNF     AS CHARACTER INITIAL ?
      NrSeqFatNF     AS INTEGER   INITIAL ?

    */

     IF  NOT AVAIL para-fat THEN
        FIND FIRST para-fat NO-LOCK NO-ERROR.
        
      if nota-fiscal.esp-docto <> 20 /*n∆o gera para devoluá∆o*/ AND 
         (can-find(FIRST ttmed                                                  //Gera quando item for Medicamento
                  WHERE ttmed.CodEstabelNF    = it-nota-fisc.cod-estabel   
                  AND   ttmed.SerieNF         = it-nota-fisc.serie         
                  AND   ttmed.NrNotaFisNF     = it-nota-fisc.nr-nota-fis   
                  AND   ttmed.ItCodigoNF      = it-nota-fisc.it-codigo     
                  AND   ttmed.NrSeqFatNF      = it-nota-fisc.nr-seq-fat) OR    //ou quando item controle por lote e Parametro ft0301: Gera grupo rastro est† marcado
          (it-nota-fisc.tipo-con-est = 3 AND substr(para-fat.char-1,108,1) = "S"))
          THEN DO: 

          /*Qualquer tipo de nota que baixou estoque */
          FOR EACH  fat-ser-lote no-lock 
              WHERE fat-ser-lote.cod-estabel = it-nota-fisc.cod-estabel 
              and   fat-ser-lote.serie       = it-nota-fisc.serie       
              and   fat-ser-lote.nr-nota-fis = it-nota-fisc.nr-nota-fis 
              and   fat-ser-lote.nr-seq-fat  = it-nota-fisc.nr-seq-fat  
              and   fat-ser-lote.it-codigo   = it-nota-fisc.it-codigo,
              LAST  saldo-estoq no-lock 
              where saldo-estoq.cod-estabel = fat-ser-lote.cod-estabel 
              and   saldo-estoq.cod-depos   = fat-ser-lote.cod-depos   
              and   saldo-estoq.cod-localiz = fat-ser-lote.cod-localiz 
              and   saldo-estoq.lote        = fat-ser-lote.nr-serlote  
              and   saldo-estoq.it-codigo   = fat-ser-lote.it-codigo   
              and   saldo-estoq.cod-refer   = fat-ser-lote.cod-refer:
                   

                  RUN PI-CRIATTRASTRO (input fat-ser-lote.nr-serlote, 
                                       input fat-ser-lote.qt-baixada[1],
                                       input saldo-estoq.dt-fabric,
                                       input saldo-estoq.dt-vali-lote). 
          END. 
          
          /* notas que n∆o baixaram estoque, precisa ser buscado o lote da nota origem */
         if not can-find(FIRST ttRASTRO  
                         WHERE ttRASTRO.CodEstabelNF = it-nota-fisc.cod-estabel   
                         AND   ttRASTRO.SerieNF      = it-nota-fisc.serie         
                         AND   ttRASTRO.NrNotaFisNF  = it-nota-fisc.nr-nota-fis   
                         AND   ttRASTRO.ItCodigoNF   = it-nota-fisc.it-codigo     
                         AND   ttRASTRO.NrSeqFatNF   = it-nota-fisc.nr-seq-fat) THEN 
                            /*TERCEIROS QUE N«O BAIXAM ESTOQUE QUE GERAM A RAT-COMPONENTE*/
               FOR EACH  rat-componente 
                   WHERE rat-componente.cod-emitente   = nota-fiscal.cod-emitente 
                     AND rat-componente.serie-docto    = nota-fiscal.serie
                     AND rat-componente.nro-docto      = nota-fiscal.nr-nota-fis
                     AND rat-componente.nat-operacao   = it-nota-fisc.nat-operacao 
                     AND rat-componente.it-codigo      = it-nota-fisc.it-codigo  
                     AND rat-componente.cod-refer      = it-nota-fisc.cod-refer  
                     AND rat-componente.sequencia      = it-nota-fisc.nr-seq-fat NO-LOCK:
                             
                   FIND FIRST saldo-estoq no-lock 
                       where  saldo-estoq.cod-estabel = nota-fiscal.cod-estabel   
                       and    saldo-estoq.cod-depos   = rat-componente.cod-depos 
                       and    saldo-estoq.cod-localiz = rat-componente.cod-localiz   
                       and    saldo-estoq.lote        = rat-componente.lote
                       and    saldo-estoq.it-codigo   = rat-componente.it-codigo     
                       and    saldo-estoq.cod-refer   = rat-componente.cod-refer NO-ERROR. 
                   IF AVAIL saldo-estoq THEN 
                       run PI-CRIATTRASTRO (input rat-componente.lote     , 
                                            input rat-componente.quantidade  ,
                                            input saldo-estoq.dt-fabric,
                                            input saldo-estoq.dt-vali-lote).
                   ELSE  // implantou saldo manual de terceiros via re0407 e n∆o tem saldo-estoq
                       FIND FIRST brat-componente 
                           WHERE  brat-componente.serie-docto  = rat-componente.serie-comp  
                              AND brat-componente.nro-docto    = rat-componente.nro-comp    
                              AND brat-componente.nat-operacao = rat-componente.nat-comp   
                              AND brat-componente.cod-emitente = rat-componente.cod-emitente
                              AND brat-componente.it-codigo    = rat-componente.it-codigo   
                              AND brat-componente.lote         = rat-componente.lote       
                              AND brat-componente.cod-refer    = rat-componente.cod-refer  
                              AND brat-componente.sequencia    = rat-componente.seq-comp
                              AND brat-componente.lote         = rat-componente.lote NO-LOCK NO-ERROR.
                       
                       IF AVAIL brat-componente THEN 
                           run PI-CRIATTRASTRO (input rat-componente.lote, 
                                              input rat-componente.quantidade,
                                              input brat-componente.dt-retorno,
                                              input brat-componente.dt-vali-lote).
               END. 
              
          /*DIFERENÄA DE PREÄO */
         if not can-find(FIRST ttRASTRO  
                         WHERE ttRASTRO.CodEstabelNF = it-nota-fisc.cod-estabel   
                         AND   ttRASTRO.SerieNF      = it-nota-fisc.serie         
                         AND   ttRASTRO.NrNotaFisNF  = it-nota-fisc.nr-nota-fis   
                         AND   ttRASTRO.ItCodigoNF   = it-nota-fisc.it-codigo     
                         AND   ttRASTRO.NrSeqFatNF   = it-nota-fisc.nr-seq-fat) THEN 
               
               FOR FIRST   bf-nota-fiscal NO-LOCK 
                   WHERE   bf-nota-fiscal.cod-estabel = nota-fiscal.cod-estabel
                     AND   bf-nota-fiscal.serie       = nota-fiscal.serie-orig
                     AND   bf-nota-fiscal.nr-nota-fis = nota-fiscal.nro-nota-orig,
                     each  bf-it-nota-fisc of bf-nota-fiscal  no-lock,
                     each  bf-fat-ser-lote of bf-it-nota-fisc no-lock,
                     LAST  saldo-estoq no-lock 
                     where saldo-estoq.cod-estabel = bf-fat-ser-lote.cod-estabel  
                     and   saldo-estoq.cod-depos   = bf-fat-ser-lote.cod-depos    
                     and   saldo-estoq.cod-localiz = bf-fat-ser-lote.cod-localiz  
                     and   saldo-estoq.lote        = bf-fat-ser-lote.nr-serlote   
                     and   saldo-estoq.it-codigo   = bf-fat-ser-lote.it-codigo    
                     and   saldo-estoq.cod-refer   = bf-fat-ser-lote.cod-refer:   
                     
                     run PI-CRIATTRASTRO (input bf-fat-ser-lote.nr-serlote, 
                                          input bf-fat-ser-lote.qt-baixada[1],
                                          input saldo-estoq.dt-fabric,
                                          input saldo-estoq.dt-vali-lote).
               end.
         
         if not can-find(FIRST ttRASTRO  
                         WHERE ttRASTRO.CodEstabelNF = it-nota-fisc.cod-estabel   
                         AND   ttRASTRO.SerieNF      = it-nota-fisc.serie         
                         AND   ttRASTRO.NrNotaFisNF  = it-nota-fisc.nr-nota-fis   
                         AND   ttRASTRO.ItCodigoNF   = it-nota-fisc.it-codigo     
                         AND   ttRASTRO.NrSeqFatNF   = it-nota-fisc.nr-seq-fat) THEN 
                            
               FOR FIRST   bf-nota-fiscal NO-LOCK 
                   WHERE   bf-nota-fiscal.cod-estabel  = nota-fiscal.cod-estabel
                     AND   bf-nota-fiscal.serie        = it-nota-fisc.serie-docum
                     AND   bf-nota-fiscal.nr-nota-fis  = it-nota-fisc.nr-docum
                     AND   bf-nota-fiscal.cod-emitente = nota-fiscal.cod-emitente
                     AND   bf-nota-fiscal.nat-operacao = it-nota-fisc.nat-docum,
                     EACH  bf-it-nota-fisc of bf-nota-fiscal no-lock 
                     WHERE bf-it-nota-fisc.nr-seq-fat  = it-nota-fisc.int-1
                     and   bf-it-nota-fisc.it-codigo   = it-nota-fisc.it-codigo,
                     EACH  bf-fat-ser-lote of bf-it-nota-fisc no-lock,
                     LAST  saldo-estoq no-lock 
                     where saldo-estoq.cod-estabel     = bf-fat-ser-lote.cod-estabel  
                     and   saldo-estoq.cod-depos       = bf-fat-ser-lote.cod-depos    
                     and   saldo-estoq.cod-localiz     = bf-fat-ser-lote.cod-localiz  
                     and   saldo-estoq.lote            = bf-fat-ser-lote.nr-serlote   
                     and   saldo-estoq.it-codigo       = bf-fat-ser-lote.it-codigo    
                     and   saldo-estoq.cod-refer       = bf-fat-ser-lote.cod-refer: 
                     
                     run PI-CRIATTRASTRO (input bf-fat-ser-lote.nr-serlote, 
                                          input bf-fat-ser-lote.qt-baixada[1],
                                          input saldo-estoq.dt-fabric,
                                          input saldo-estoq.dt-vali-lote).
               end.
                  
         if not can-find(FIRST ttRASTRO  
                         WHERE ttRASTRO.CodEstabelNF = it-nota-fisc.cod-estabel   
                         AND   ttRASTRO.SerieNF      = it-nota-fisc.serie         
                         AND   ttRASTRO.NrNotaFisNF  = it-nota-fisc.nr-nota-fis   
                         AND   ttRASTRO.ItCodigoNF   = it-nota-fisc.it-codigo     
                         AND   ttRASTRO.NrSeqFatNF   = it-nota-fisc.nr-seq-fat) THEN                   

                FOR FIRST bf-nota-fiscal NO-LOCK 
                    WHERE bf-nota-fiscal.cod-estabel  = nota-fiscal.cod-estabel
                    AND   bf-nota-fiscal.serie        = it-nota-fisc.serie-docum
                    AND   bf-nota-fiscal.nr-nota-fis  = it-nota-fisc.nr-docum
                    AND   bf-nota-fiscal.nat-operacao = it-nota-fisc.nat-docum,
                    EACH  bf-it-nota-fisc of bf-nota-fiscal no-lock 
                    WHERE bf-it-nota-fisc.nr-seq-fat  = it-nota-fisc.int-1
                    AND   bf-it-nota-fisc.it-codigo   = it-nota-fisc.it-codigo,
                    EACH  bf-fat-ser-lote of bf-it-nota-fisc no-lock,
                    LAST  saldo-estoq no-lock 
                    where saldo-estoq.cod-estabel = bf-fat-ser-lote.cod-estabel  
                    and   saldo-estoq.cod-depos   = bf-fat-ser-lote.cod-depos    
                    and   saldo-estoq.cod-localiz = bf-fat-ser-lote.cod-localiz  
                    and   saldo-estoq.lote        = bf-fat-ser-lote.nr-serlote   
                    and   saldo-estoq.it-codigo   = bf-fat-ser-lote.it-codigo    
                    and   saldo-estoq.cod-refer   = bf-fat-ser-lote.cod-refer: 
                    
                    run PI-CRIATTRASTRO (input bf-fat-ser-lote.nr-serlote, 
                                         input bf-fat-ser-lote.qt-baixada[1],
                                         input saldo-estoq.dt-fabric,
                                         input saldo-estoq.dt-vali-lote).
                end.
                
        if not can-find(FIRST ttRASTRO  
                         WHERE ttRASTRO.CodEstabelNF = it-nota-fisc.cod-estabel   
                         AND   ttRASTRO.SerieNF      = it-nota-fisc.serie         
                         AND   ttRASTRO.NrNotaFisNF  = it-nota-fisc.nr-nota-fis   
                         AND   ttRASTRO.ItCodigoNF   = it-nota-fisc.it-codigo     
                         AND   ttRASTRO.NrSeqFatNF   = it-nota-fisc.nr-seq-fat) THEN          
                /*Nota de compra que gerou nota no faturamento*/
                
              FOR FIRST item-doc-est NO-LOCK
              WHERE item-doc-est.serie-docto  = nota-fiscal.serie
                AND item-doc-est.nro-docto    = nota-fiscal.nr-nota-ant
                AND item-doc-est.cod-emitente = nota-fiscal.cod-emitente
                AND item-doc-est.nat-of       = nota-fiscal.nat-operacao
                AND item-doc-est.sequencia    = it-nota-fisc.nr-seq-ped,
                EACH rat-lote {cdp/cd8900.i rat-lote item-doc-est}
                   and rat-lote.sequencia = item-doc-est.sequencia no-lock:
                                      
                        run PI-CRIATTRASTRO (input rat-lote.lote     , 
                                             input rat-lote.quantidade  ,
                                             input rat-lote.dat-fabricc-lote,  
                                             input rat-lote.dt-vali-lote).                                      
                                      
                                  
                end.                               

          
      end.  /*TTMED*/
    
END PROCEDURE.

PROCEDURE PI-CRIATTRASTRO.

DEF INPUT PARAM P-lote          like fat-ser-lote.nr-serlote          .
DEF INPUT PARAM P-qt-lote       like fat-ser-lote.qt-baixada[1]       .
DEF INPUT PARAM P-dt-fabric     like saldo-estoq.dt-fabric            .
DEF INPUT PARAM P-dt-val-lote   like saldo-estoq.dt-vali-lote         .

    CREATE ttrastro.                                      
    /* Chave EMS */                                            
    ASSIGN  ttrastro.CodEstabelNF  = it-nota-fisc.cod-estabel      
            ttrastro.SerieNF       = it-nota-fisc.serie       
            ttrastro.NrNotaFisNF   = it-nota-fisc.nr-nota-fis 
            ttrastro.ItCodigoNF    = it-nota-fisc.it-codigo   
            ttrastro.NrSeqFatNF    = it-nota-fisc.nr-seq-fat          .    
                                                               
    Assign ttrastro.nLote  =   P-lote        
          ttrastro.qLote   =   P-qt-lote     
          ttrastro.dFab    =   P-dt-fabric   
          ttrastro.dVal    =   P-dt-val-lote.
                               
END PROCEDURE. 

