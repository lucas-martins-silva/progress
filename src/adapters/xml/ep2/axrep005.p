PROCEDURE PIDelete:

    DEFINE VARIABLE c-cgc AS CHARACTER   NO-UNDO.

    /* OBTEM A PARTE DA MENSAGEM QUE ESTµ ABAIXO DO ELEMENTO BusinessContent */
    RUN getBusinessContent IN hMessageHandler (OUTPUT hBusinessContent).

    /* LIMPA AS TEMP-TABLES INTERNAS DA API XML */
    RUN reset IN hGenXml.

    /* CARREGA A ESTRUTURA FILHA DE BusinessContent */
    RUN loadXml IN hGenXml (hBusinessContent).

    /* ELIMINA A MENSAGEM OBTIDA NO M…TODO getBusinessContent */
    DELETE OBJECT hBusinessContent NO-ERROR.

    addStack(1).

        RUN getFirstSonId IN hGenXml (INPUT 1, OUTPUT iId).
    
        CREATE tt-docto-adapter.
        
        RUN searchTag IN hGenXml (INPUT "DocumentSeries":U, INPUT getStack(), OUTPUT iId).
    
        ASSIGN tt-docto-adapter.serie = "".
        IF iId <> ? THEN
           RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "DocumentSeries":U, OUTPUT tt-docto-adapter.serie).
        
        RUN searchTag IN hGenXml (INPUT "DocumentNumber":U, INPUT getStack(), OUTPUT iId).
        IF iId <> ? THEN
           RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "DocumentNumber":U, OUTPUT tt-docto-adapter.nr-nota-fis).
        
        
        RUN searchTag IN hGenXml (INPUT "Site":U, INPUT getStack(), OUTPUT iId).
        DO  WHILE iId <> ?:
            addStack(iId).      
    
            RUN searchTag IN hGenXml (INPUT "SiteShortName":U, INPUT getStack(), OUTPUT iId).
            IF iId <> ? THEN
               RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "SiteShortName":U, OUTPUT tt-docto-adapter.estab-nome-abrev).
    
            RUN searchTag IN hGenXml (INPUT "SiteTaxID":U, INPUT getStack(), OUTPUT iId).
            IF iId <> ? THEN DO:
                 RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "SiteTaxID":U, OUTPUT c-cgc).
                 tt-docto-adapter.estab-cgc = REPLACE(REPLACE(REPLACE(c-cgc,"/",""),".",""),"-","").
            END.
    
            RUN searchTag IN hGenXml (INPUT "SiteID":U, INPUT getStack(), OUTPUT iId).
            IF iId <> ? THEN
               RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "SiteID":U, OUTPUT tt-docto-adapter.cod-estabel).
    
            delStack().
        END.
    
        RUN searchTag IN hGenXml (INPUT "TransactionType":U, INPUT getStack(), OUTPUT iId).
        IF iId <> ? THEN
           RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "TransactionType":U, OUTPUT cTransactionType). /*ELIMINAR OU CANCELAR NOTA FISCAL*/

    delStack().


    /* ********* LEITURA DA MENSAGEM - END   ********* */

    /* ********* EFETIVACAO - BEGIN ********* */

    {adapters/xml/ep2/axrep005delete.i}

    /* ********* EFETIVACAO - END   ********* */

/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.

procedure pi-insurance:

    run searchTag in hGenXml (input "Insurance":u, input getStack(), output iId).
    do while iId <> ?:
        addStack(iId). 
    
        run searchTag in hGenXml (input "InsuranceValue":u, input getStack(), output iId).
        if iId <> ? then
            run getSonDec in hGenXml (input getStack(), input "InsuranceValue":U, output tt-docto-adapter.vl-seguro).
    
        run searchTag in hGenXml (input "InsuranceTaxPercentage":u, input getStack(), output iId).
        if iId <> ? then
            run getSonDec in hGenXml (input getStack(), input "InsuranceTaxPercentage":U, output tt-docto-adapter.perc-tax-seg).
    
        run searchTag in hGenXml (input "InsuranceTaxValue":u, input getStack(), output iId).
        if iId <> ? then
            run getSonDec in hGenXml (input getStack(), input "InsuranceTaxValue":U, output tt-docto-adapter.tax-seg).
    
        delStack().
    end.

    return "ok":u.
end procedure.


PROCEDURE receiveMessage:

/*PARAMETERS - BEGIN*/
DEFINE INPUT  PARAM hINPUTXML  AS HANDLE NO-UNDO.
DEFINE OUTPUT PARAM hOutputXML AS HANDLE NO-UNDO.
/*PARAMETERS - END*/


/* ******************************************* */
/* *************** BODY - BEGIN ************** */
/* ******************************************* */

     /* VERIFICA SE MessageHandler.p ESTA NA MEMORIA */
     {xmlinc/xmlloadmessagehandlerrec.i &MessageHandler="hMessageHandler" &MHReturnValue="cReturnValue" &MHReturnError="hOutputXML"}

     IF cReturnValue <> "OK":U THEN DO:
          RETURN cReturnValue.
     END.

     /* INTERPRETA, ARMAZENA E VALIDA A MENSAGEM QUE RECEBE */
     RUN parseMessage IN hMessageHandler (
          INPUT  hINPUTXml, INPUT "{&XmlTranName}":U, 
          INPUT "{&XmlMaxTranVersion}":U, 
          INPUT "{&XmlMinTranVersion}":U, 
          INPUT "{&XmlListOfEvents}":U,
          OUTPUT lSuccessProcess,
          OUTPUT cTranAction, 
          OUTPUT cTranEvent,
          OUTPUT cTranVersion,
          OUTPUT hOutputXML ).

     /* SE N√O PROCESSOU CORRETAMENTE RETORNA ERRO */
     IF NOT lSuccessProcess OR RETURN-VALUE <> "OK":U THEN 
     /* DAR TRATAMENTO CONVENIENTE ANTES DE RETORNAR */
          RETURN RETURN-VALUE.

     /* VERIFICA SE APIXML ESTA NA MEMORIA */
     {xmlinc/xmlloadgenxmlrec.i &GenXml="hGenXml" &GXReturnValue="cReturnValue" &GXReturnError="hOutputXML"}

     /* VERIFICA SE O ut-genxml FOI INICIADO CORRETAMENTE */
     IF cReturnValue <> "OK":U
     THEN DO:
          /* ELIMINA A MENSAGEM OBTIDA NO MêTODO getBusinessContent */
          DELETE OBJECT hBusinessContent NO-ERROR.

          RETURN cReturnValue.
     END.



{adapters/xml/ep2/axrep005versioncontrol.i}



/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.


