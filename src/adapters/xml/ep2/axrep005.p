                    ASSIGN tt-item-embal-adapter.sigla-emb = tt-nota-embal-adapter.sigla-emb.

                    run searchTag in hGenXml (input "Sequence":u, input getStack(), output iId).
                    if iId <> ? then
                        run getSonVal in hGenXml (input getStack(), input "Sequence":U, output tt-item-embal-adapter.nr-seq-fat).
        
                    run searchTag in hGenXml (input "ItemCode":u, input getStack(), output iId).
                    if iId <> ? then
                        run getSonVal in hGenXml (input getStack(), input "ItemCode":U, output tt-item-embal-adapter.it-codigo).
                    
                    run searchTag in hGenXml (input "QuantityPackaged":u, input getStack(), output iId).
                    if iId <> ? then
                        run getSonDec in hGenXml (input getStack(), input "QuantityPackaged":U, output tt-item-embal-adapter.qt-embalada).
                    
                    run searchTag in hGenXml (input "Volume":u, input getStack(), output iId).
                    if iId <> ? then
                        run getSonVal in hGenXml (input getStack(), input "Volume":U, output tt-item-embal-adapter.volume).
                    
                    ASSIGN iId = getStack().                               
                    delStack().
                    RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).


                end.
                delStack().

            end.
            ASSIGN iId = getStack().
            delStack().
            RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
            
        END.
        delStack().
    end.

    run searchTag in hGenXml (input "DocumentValuesAndTaxes":u, input getStack(), output iId).
    do  while iId <> ?:

        addStack(iId). 

        run searchTag in hGenXml (input "Currency":u, input getStack(), output iId).
        do while iId <> ?:
            addStack(iId). 

            run searchTag in hGenXml (input "CurrencyID":u, input getStack(), output iId).
            if iId <> ? then
                run getSonVal in hGenXml (input getStack(), input "CurrencyID":U, output tt-docto-adapter.mo-codigo).
            
            delStack().
        end.

        run searchTag in hGenXml (input "PriceTable":u, input getStack(), output iId).
        do while iId <> ?:
            addStack(iId). 

            run searchTag in hGenXml (input "PriceTableNumber":u, input getStack(), output iId).
            if iId <> ? then
                run getSonVal in hGenXml (input getStack(), input "PriceTableNumber":U, output tt-docto-adapter.nr-tabpre).

            delStack().
        end.

        run searchTag in hGenXml (input "FinancialTable":u, input getStack(), output iId).
        do while iId <> ?:
            addStack(iId). 

            run searchTag in hGenXml (input "FinancialTableNumber":u, input getStack(), output iId).
            if iId <> ? then
                run getSonVal in hGenXml (input getStack(), input "FinancialTableNumber":U, output tt-docto-adapter.nr-tab-finan).

            run searchTag in hGenXml (input "FinancialIndexNumber":u, input getStack(), output iId).
            if iId <> ? then
                run getSonVal in hGenXml (input getStack(), input "FinancialIndexNumber":U, output tt-docto-adapter.nr-ind-finan).

            delStack().
        end.

        run searchTag in hGenXml (input "PriceType":u, input getStack(), output iId).
        if iId <> ? then
            run getSonVal in hGenXml (input getStack(), input "PriceType":U, output tt-docto-adapter.tp-preco).
        
        run searchTag in hGenXml (input "DiscountsAndBonifications":u, input getStack(), output iId).
        do while iId <> ?:
            addStack(iId). 

            run searchTag in hGenXml (input "EnteredDiscounts":u, input getStack(), output iId).
            if iId <> ? then
                run getSonVal in hGenXml (input getStack(), input "EnteredDiscounts":U, output tt-docto-adapter.des-pct-desconto-inform).

            run searchTag in hGenXml (input "CustomerDiscountPercentage":u, input getStack(), output iId).
            if iId <> ? then
                run getSonDec in hGenXml (input getStack(), input "CustomerDiscountPercentage":U, output tt-docto-adapter.perc-desco1).

            run searchTag in hGenXml (input "PriceTableDiscountPercentage":u, input getStack(), output iId).
            if iId <> ? then
                run getSonDec in hGenXml (input getStack(), input "PriceTableDiscountPercentage":U, output tt-docto-adapter.val-pct-desconto-tab-preco).

            run searchTag in hGenXml (input "DiscountAmount":u, input getStack(), output iId).
            if iId <> ? then
                run getSonDec in hGenXml (input getStack(), input "DiscountAmount":U, output tt-docto-adapter.vl-desconto).

            run searchTag in hGenXml (input "TotalDiscountAmount":u, input getStack(), output iId).
            if iId <> ? then
                run getSonDec in hGenXml (input getStack(), input "TotalDiscountAmount":U, output tt-docto-adapter.val-desconto-total).

            run searchTag in hGenXml (input "TotalPercentageOfDocumentDiscounts":u, input getStack(), output iId).
            if iId <> ? then
                run getSonDec in hGenXml (input getStack(), input "TotalPercentageOfDocumentDiscounts":U, output tt-docto-adapter.val-pct-desconto-total).

            run searchTag in hGenXml (input "DocumentDiscountPercentage":u, input getStack(), output iId).
            if iId <> ? then
                run getSonDec in hGenXml (input getStack(), input "DocumentDiscountPercentage":U, output tt-docto-adapter.perc-desco2).

            run searchTag in hGenXml (input "DiscountPerValuePercentage":u, input getStack(), output iId).
            if iId <> ? then
                run getSonDec in hGenXml (input getStack(), input "DiscountPerValuePercentage":U, output tt-docto-adapter.val-pct-desconto-valor).
            
            delStack().
        end.

        run searchTag in hGenXml (input "Packaging":u, input getStack(), output iId).
        do while iId <> ?:
            addStack(iId). 

            run searchTag in hGenXml (input "PackagingValue":u, input getStack(), output iId).
            if iId <> ? then
                run getSonDec in hGenXml (input getStack(), input "PackagingValue":U, output tt-docto-adapter.vl-embalagem).

            run searchTag in hGenXml (input "PackagingTaxPercentage":u, input getStack(), output iId).
            if iId <> ? then
                run getSonDec in hGenXml (input getStack(), input "PackagingTaxPercentage":U, output tt-docto-adapter.perc-tax-emb).

            run searchTag in hGenXml (input "PackagingTaxValue":u, input getStack(), output iId).
            if iId <> ? then
                run getSonDec in hGenXml (input getStack(), input "PackagingTaxValue":U, output tt-docto-adapter.tax-emb).

            delStack().
        end.    

        run searchTag in hGenXml (input "Freight":u, input getStack(), output iId).
        do while iId <> ?:
            addStack(iId). 

            run searchTag in hGenXml (input "FreightValue":u, input getStack(), output iId).
            if iId <> ? then
                run getSonDec in hGenXml (input getStack(), input "FreightValue":U, output tt-docto-adapter.vl-frete).

            run searchTag in hGenXml (input "FreightTaxPercentage":u, input getStack(), output iId).
            if iId <> ? then
                run getSonDec in hGenXml (input getStack(), input "FreightTaxPercentage":U, output tt-docto-adapter.perc-tax-fre).

            run searchTag in hGenXml (input "FreightTaxValue":u, input getStack(), output iId).
            if iId <> ? then
                run getSonDec in hGenXml (input getStack(), input "FreightTaxValue":U, output tt-docto-adapter.tax-frete).

            delStack().
        end.

        run pi-Insurance.
           
        run searchTag in hGenXml (input "CommissionValue":u, input getStack(), output iId).
        if iId <> ? then
            run getSonDec in hGenXml (input getStack(), input "CommissionValue":U, output tt-docto-adapter.vl-comis-nota).

        run searchTag in hGenXml (input "ExportTax":u, input getStack(), output iId).
        if iId <> ? then
            run getSonDec in hGenXml (input getStack(), input "ExportTax":U, output tt-docto-adapter.vl-taxa-exp).

        run searchTag in hGenXml (input "AccumulatedBillsValue":u, input getStack(), output iId).
        if iId <> ? then
            run getSonDec in hGenXml (input getStack(), input "AccumulatedBillsValue":U, output tt-docto-adapter.vl-acum-dump).

        run searchTag in hGenXml (input "InvoiceValue":u, input getStack(), output iId).
        if iId <> ? then
            run getSonDec in hGenXml (input getStack(), input "InvoiceValue":U, output tt-docto-adapter.vl-fatura).

        run searchTag in hGenXml (input "GoodsValue":u, input getStack(), output iId).
        if iId <> ? then
            run getSonDec in hGenXml (input getStack(), input "GoodsValue":U, output tt-docto-adapter.vl-mercad).

        run searchTag in hGenXml (input "InvoicedGoodsValue":u, input getStack(), output iId).
        if iId <> ? then
            run getSonDec in hGenXml (input getStack(), input "InvoicedGoodsValue":U, output tt-docto-adapter.vl-merc-tot-fat).

        run searchTag in hGenXml (input "InvoicedItensValue":u, input getStack(), output iId).
        if iId <> ? then
            run getSonDec in hGenXml (input getStack(), input "InvoicedItensValue":U, output tt-docto-adapter.vl-tot-itens-fat).

        run searchTag in hGenXml (input "DocumentTotalPrice":u, input getStack(), output iId).
        if iId <> ? then
            run getSonDec in hGenXml (input getStack(), input "DocumentTotalPrice":U, output tt-docto-adapter.vl-tot-nota).
        
        delStack().
    end.

    delStack().


END PROCEDURE.

