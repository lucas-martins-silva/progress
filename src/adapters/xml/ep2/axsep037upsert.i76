PROCEDURE pi-cria-ttrefECF:
    
    /* Cupom Fiscal Referenciado */
    FOR EACH nota-fisc-adc NO-LOCK
       WHERE nota-fisc-adc.cod-estab         = nota-fiscal.cod-estabel
       AND   nota-fisc-adc.cod-serie         = nota-fiscal.serie
       AND   nota-fisc-adc.cod-nota-fisc     = nota-fiscal.nr-nota-fis
       AND   nota-fisc-adc.cdn-emitente      = nota-fiscal.cod-emitente
       AND   nota-fisc-adc.cod-natur-operac  = nota-fiscal.nat-operacao
       AND   nota-fisc-adc.idi-tip-dado      = 4:

        IF  NOT CAN-FIND (FIRST ttrefECF
                          WHERE ttrefECF.CodEstabelNF = nota-fiscal.cod-estabel
                          AND   ttrefECF.SerieNF      = (IF nota-fiscal.serie = "" THEN "0" ELSE nota-fiscal.serie)
                          AND   ttrefECF.NrNotaFisNF  = nota-fiscal.nr-nota-fis) THEN DO:

            CREATE ttrefECF.
            ASSIGN ttrefECF.mod          = nota-fisc-adc.cod-model-ecf
                   ttrefECF.nECF         = string(nota-fisc-adc.cod-cx-ecf, "999")
                   ttrefECF.nCOO         = nota-fisc-adc.cod-docto-referado-ecf
                   ttrefECF.CodEstabelNF = nota-fisc-adc.cod-estab
                   ttrefECF.SerieNF      = IF nota-fisc-adc.cod-serie = "" THEN "0" ELSE nota-fisc-adc.cod-serie
                   ttrefECF.NrNotaFisNF  = nota-fisc-adc.cod-nota-fisc.
        END.
    END.

END PROCEDURE.
