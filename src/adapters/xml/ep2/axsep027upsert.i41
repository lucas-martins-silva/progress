/*Simples Nacional*/
PROCEDURE pi-cria-ICMSSN:

    /*
    Campos Simples Nacional na Tabela NOTA-FISCAL
    
    Al¡q. Simples Nac.	    VAL-ALIQ-SIMPLES-NAC	CHAR-1(178,10)
    % IRPJ	            VAL-PERC-IRPJ-SIMPLES-NAC	CHAR-1(188,10)
    % CSLL	            VAL-PERC-CSLL-SIMPLES-NAC	CHAR-1(198,10)
    % COFINS	            VAL-PERC-COFINS-SIMPLES-NAC	CHAR-1(208,10)
    % PIS/PASEP	            VAL-PERC-PIS-SIMPLES-NAC	CHAR-1(218,10)
    % CPP	            VAL-PERC-CPP-SIMPLES-NAC	CHAR-1(228,10)
    % ICMS (pCredSN)        VAL-PERC-ICMS-SIMPLES-NAC	CHAR-1(238,10)
    % IPI                   VAL-PERC-IPI-SIMPLES-NAC    CHAR-1(307,10)
    
    Campos ICMSSN na Tabela IT-NOTA-FISC
    
    CSOSN	            COD-CSOSN	                CHAR-1(227,10)
    Base ICMS SN	    VAL-BASE-ICMS-SIMPLES-NAC	CHAR-1(187,20)
    vCredICMSSN	            VAL-CR-ICMS-SIMPLES-NAC	CHAR-1(207,20)
    */


    IF CAN-FIND (FIRST param-simples-nac NO-LOCK
                 WHERE param-simples-nac.cod-estab = it-nota-fisc.cod-estabel)
    THEN DO:

        &IF "{&bf_dis_versao_ems}" >= "2.09" &THEN
              ASSIGN c-cod-csosn = TRIM(it-nota-fisc.cod-csosn).
        &ELSE ASSIGN c-cod-csosn = TRIM(SUBSTRING(it-nota-fisc.char-1,227,10)).
        &ENDIF
        
        CASE c-cod-csosn:
            WHEN "101" THEN
                RUN pi-grava-ttICMSSN101.    
            
            WHEN "102" OR
            WHEN "103" OR
            WHEN "300" OR
            WHEN "400" THEN
                RUN pi-grava-ttICMSSN102.    
            
            WHEN "201" THEN
                RUN pi-grava-ttICMSSN201.

            WHEN "202" OR 
            WHEN "203" THEN
                RUN pi-grava-ttICMSSN202.

            WHEN "500" THEN
                RUN pi-grava-ttICMSSN500.

            WHEN "900" THEN
                RUN pi-grava-ttICMSSN900.

            OTHERWISE
                RUN pi-grava-ttICMSSN900.

        END CASE.

        ASSIGN l-omite-val-totais-sn-icms    = (c-cod-csosn = "101" OR
                                                c-cod-csosn = "102" OR
                                                c-cod-csosn = "103" OR
                                                c-cod-csosn = "300" OR
                                                c-cod-csosn = "400" OR
                                                c-cod-csosn = "201" OR
                                                c-cod-csosn = "202" OR
                                                c-cod-csosn = "203" OR
                                                c-cod-csosn = "500")
               l-omite-val-totais-sn-icms-st = (c-cod-csosn = "101" OR
                                                c-cod-csosn = "102" OR
                                                c-cod-csosn = "103" OR
                                                c-cod-csosn = "300" OR
                                                c-cod-csosn = "400" OR
                                                c-cod-csosn = "500").

    END.

END PROCEDURE.
