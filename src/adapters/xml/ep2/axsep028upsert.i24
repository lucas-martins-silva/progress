PROCEDURE pi-grava-ttICMS20:

    def var d-descto-zfm-pis as dec no-undo.
    def var d-descto-zfm-cofins as dec no-undo.
    def var d-vl-desc-icms as dec no-undo.

    /*
    === ttICMS20 ===
    CST            AS CHARACTER INITIAL ?  /*Tribut‡Æo pelo ICMS 20 - Com redu‡Æo de base de c lculo*/
    vBC            AS DECIMAL   INITIAL ?  /*Valor da BC do ICMS*/
    pRedBC         AS DECIMAL   INITIAL ?  /*Percentual de redu‡Æo da BC*/
    pICMS          AS DECIMAL   INITIAL ?  /*Al¡quota do ICMS*/       
    vICMS          AS DECIMAL   INITIAL ?  /*Valor do ICMS*/
    vICMSDeson     AS DECIMAL   INITIAL ?  /*Valor do ICMS de desonera‡Æo*/ 
    cBebef         AS CHARACTER INITIAL ?  /*Benef*/       
    pFCP           AS DECIMAL   INITIAL ?  /*Valor do FCP*/
    vFCP           AS DECIMAL   INITIAL ?  /*Percentual do FCP*/         
    */
    
    ASSIGN d-aliquota-icms  = 0
           d-vl-imp-icms    = 0
           d-vl-imp-icmsou  = 0
           d-perc-redimp    = 0
           d-vl-bicms-it    = 0.
                                 
    IF  i-pais-impto-usuario <> 1 THEN DO: /* Internacional */    
        FOR EACH it-nota-imp NO-LOCK
           WHERE it-nota-imp.cod-estabel = it-nota-fisc.cod-estabel 
             AND it-nota-imp.serie       = it-nota-fisc.serie       
             AND it-nota-imp.nr-nota-fis = it-nota-fisc.nr-nota-fis 
             AND it-nota-imp.nr-seq-fat  = it-nota-fisc.nr-seq-fat
             AND it-nota-imp.it-codigo   = it-nota-fisc.it-codigo:     
            ASSIGN d-aliquota-icms = d-aliquota-icms + it-nota-imp.aliquota
                   d-vl-imp-icms   = d-vl-imp-icms   + it-nota-imp.vl-imposto
                   d-perc-redimp   = d-perc-redimp   + it-nota-imp.perc-redimp
                   d-vl-bicms-it   = d-vl-bicms-it   + it-nota-imp.vl-base-imp.
        END.
    END.
    ELSE
        ASSIGN d-aliquota-icms = it-nota-fisc.aliquota-icm
               d-vl-imp-icms   = it-nota-fisc.vl-icms-it
               d-vl-imp-icmsou = it-nota-fisc.vl-icmsou-it
               d-perc-redimp   = it-nota-fisc.perc-red-icm
               d-vl-bicms-it   = it-nota-fisc.vl-bicms-it.    
    
    CREATE ttICMS20.
    ASSIGN ttICMS20.CST    = (IF LENGTH(c-niv-trib-icms) = 3
                              THEN SUBSTRING(c-niv-trib-icms,2,2)
                              ELSE "00")
           ttICMS20.vBC    = d-vl-bicms-it
           ttICMS20.pRedBC = IF d-perc-redimp > 0 THEN d-perc-redimp  ELSE ? /*ELSE IF lLayoutXML THEN ? ELSE IF lLayoutTXT THEN 0 ELSE ?)*/
           ttICMS20.pICMS  = (IF it-nota-fisc.cd-trib-icm <> 3
                             THEN d-aliquota-icms
                             ELSE 0)
           
           ttICMS20.vICMS  = (IF it-nota-fisc.cd-trib-icm <> 3
                             THEN d-vl-imp-icms
                             ELSE 0).                                           
           
    //Valor desonerado       
    ASSIGN d-descto-zfm-pis    = 0
           d-descto-zfm-cofins = 0
           d-vl-desc-icms      = 0.      
    
    /*--- Calcula Valor Desconto ICMS ---*/ /*somente para quando NAO for Zona Franca, e sim Desconto de ICMS (com motivo de desonera»’o parametrizado)*/
    for first loc-entr no-lock
        where loc-entr.nome-abrev  = nota-fiscal.nome-ab-cli
        and   loc-entr.cod-entrega = nota-fiscal.cod-entrega:
    end.    
    FOR FIRST bf-natur-oper-it NO-LOCK
        WHERE bf-natur-oper-it.nat-operacao = it-nota-fisc.nat-operacao:
    END.    
    IF (it-nota-fisc.per-des-icms > 0 AND 
       (TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2)) <> "" AND 
        TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2)) <> "0")) AND 
       ((r-cidade-zf = ? AND
        (avail loc-entr and loc-entr.log-1 = no)) or
        (r-cidade-zf <> ? and
         TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2)) <> "7")) THEN DO:
        
        IF  bf-natur-oper-it.log-deduz-desc-zfm-tot-nf THEN
            ASSIGN d-descto-zfm-pis    = bf-natur-oper-it.val-perc-desc-pis-zfm
                   d-descto-zfm-cofins = bf-natur-oper-it.val-perc-desc-cofins-zfm.
        
        ASSIGN d-vl-desc-icms = (1 - ((IF trim(substr(it-nota-fisc.char-1,461,5)) <> ""
                                       THEN dec(substring(it-nota-fisc.char-1,461,5))
                                       ELSE dec(substring(bf-natur-oper-it.char-2,66,5))) + d-descto-zfm-pis + d-descto-zfm-cofins) / 100) * /* Totaliza Descontos Zona Franca */
                                (1 - it-nota-fisc.per-des-icms / 100)                                                                        /* Soma com o Desconto ICMS */
               d-vl-desc-icms = it-nota-fisc.vl-merc-liq / d-vl-desc-icms /*Valor Bruto sem os Descontos acima*/
               d-vl-desc-icms = d-vl-desc-icms * it-nota-fisc.per-des-icms / 100 /*Valor referente ao Desconto ICMS (somente este [it-nota-fisc.per-des-icms], sem considerar os ZFM)*/
               d-vl-desc-icms = (if d-vl-desc-icms < 0
                                 then 0
                                 else d-vl-desc-icms)
               d-vl-desc-icms = round(d-vl-desc-icms, 2) NO-ERROR.

        FOR FIRST ext-it-nota-fisc
			WHERE ext-it-nota-fisc.cod-estabel = it-nota-fisc.cod-estabel
			AND   ext-it-nota-fisc.serie       = it-nota-fisc.serie
			AND   ext-it-nota-fisc.nr-nota-fis = it-nota-fisc.nr-nota-fis
			AND   ext-it-nota-fisc.nr-seq-fat  = it-nota-fisc.nr-seq-fat
			AND   ext-it-nota-fisc.it-codigo   = it-nota-fisc.it-codigo
			AND   ext-it-nota-fisc.cod-param   = "Val-Desc-ICMS"
            AND   NOT ext-it-nota-fisc.log-livre-1  NO-LOCK:
			ASSIGN d-vl-desc-icms = ext-it-nota-fisc.val-livre-1.
		END.    
    END.                         
    
    ttICMS20.vICMSDeson = d-vl-desc-icms.
    if ttICMS20.vICMSDeson = ? then ttICMS20.vICMSDeson = 0.
                      
    /*--- Valores FCP ---*/
    FOR FIRST item-nf-adc NO-LOCK
        WHERE item-nf-adc.cod-estab         = nota-fiscal.cod-estabel
        AND   item-nf-adc.cod-serie         = nota-fiscal.serie
        AND   item-nf-adc.cod-nota-fisc     = nota-fiscal.nr-nota-fis
        AND   item-nf-adc.idi-tip-dado      = 25
        AND   item-nf-adc.cdn-emitente      = nota-fiscal.cod-emitente
        AND   item-nf-adc.cod-natur-operac  = it-nota-fisc.nat-operacao
        AND   item-nf-adc.num-seq-item-nf   = it-nota-fisc.nr-seq-fat
        AND   item-nf-adc.cod-item          = it-nota-fisc.it-codigo:
       
        IF (item-nf-adc.log-livre-2 = ?  /* Nova gera‡Æo de FCP -> FCP e FCP ST juntos no mesmo item da nota */
        AND (item-nf-adc.val-livre-3      > 0 OR /* Valores de FCP */
             item-nf-adc.val-livre-4      > 0 OR
             DEC(item-nf-adc.cod-livre-3) > 0))
        THEN     
            ASSIGN ttICMS20.pFCP     = item-nf-adc.val-livre-4
                   ttICMS20.vFCP     = DEC(item-nf-adc.cod-livre-3).
        ELSE IF item-nf-adc.log-livre-1 = NO  /* NO = FCP Normal | YES = FCP ST */ /* Gera‡Æo de dados antiga FCP ou FCP ST */
        THEN
            ASSIGN ttICMS20.pFCP     = item-nf-adc.val-livre-2
                   ttICMS20.vFCP     = DEC(item-nf-adc.cod-livre-4).
    END.
    /*---*/ 
    
    if ttICMS20.pFCP = ? then ttICMS20.pFCP = 0.
    if ttICMS20.vFCP = ? then ttICMS20.vFCP = 0.
    
    FOR FIRST item-nf-adc NO-LOCK
        WHERE item-nf-adc.cod-estab         = nota-fiscal.cod-estabel
        AND   item-nf-adc.cod-serie         = nota-fiscal.serie
        AND   item-nf-adc.cod-nota-fisc     = nota-fiscal.nr-nota-fis
        AND   item-nf-adc.idi-tip-dado      = 29
        AND   item-nf-adc.cdn-emitente      = nota-fiscal.cod-emitente
        AND   item-nf-adc.cod-natur-operac  = it-nota-fisc.nat-operacao
        AND   item-nf-adc.num-seq-item-nf   = it-nota-fisc.nr-seq-fat
        AND   item-nf-adc.cod-livre-1      <> "":
        
        /* Cr²dito Presumido n’o gera a tag cBenef */
        IF not item-nf-adc.log-livre-3 THEN
            ASSIGN ttICMS20.cBenef = TRIM(item-nf-adc.cod-livre-1).                    
    END.    
                     
    /* Chave EMS */
    ASSIGN ttICMS20.CodEstabelNF = nota-fiscal.cod-estabel
           ttICMS20.SerieNF      = nota-fiscal.serie
           ttICMS20.NrNotaFisNF  = nota-fiscal.nr-nota-fis
           ttICMS20.ItCodigoNF   = it-nota-fisc.it-codigo
           ttICMS20.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.
           
    if trim(substring(it-nota-fisc.char-2,393,1)) <> "1" then
        assign d-total-base-icms          = d-total-base-icms + ttICMS20.vBC
               d-total-icms               = d-total-icms + ttICMS20.vICMS
               d-total-vl-desc-icms       = d-total-vl-desc-icms + ttICMS20.vICMSDeson
               d-total-vFCP               = d-total-vFCP + ttICMS20.vFCP.             
           

END PROCEDURE.
