PROCEDURE pi-cria-ttIde:


    DEFINE VARIABLE cIndPag        AS CHARACTER  NO-UNDO.
    DEFINE VARIABLE p-dh-formatada AS CHARACTER  NO-UNDO.
    
    /*
    === ttIde ===
    cDV            AS CHARACTER INITIAL ?  /*Digito Verificador da Chave de Acesso da NF-e*/
    cMunFG         AS INT       INITIAL ?  /*C¢digo do Munic°pio de Ocorrància do Fato Gerador (utilizar a tabela do IBGE)*/
    cNF            AS CHARACTER INITIAL ?  /*C¢digo numÇrico que comp‰e a Chave de Acesso. N£mero aleat¢rio gerado pelo emitente para cada NF-e.*/
    cUF            AS INT       INITIAL ?  /*C¢digo da UF do emitente do Documento Fiscal. Utilizar a Tabela do IBGE.*/
    dhEmi          AS CHARACTER INITIAL ?  /*Data e Hora de emiss∆o do Documento Fiscal (Formato AAAA-MM-DDThh:mm:ssTZD (UTC - Universal Coordinated Time))*/
    dhSaiEnt       AS CHARACTER INITIAL ?  /*Data e Hora de Sa°da da Mercadoria/Produto. No caso da NF de entrada, esta Ç a Data e Hora de entrada. (Formato AAAA-MM-DDThh:mm:ssTZD (UTC - Universal Coordinated Time))*/
    finNFe         AS CHARACTER INITIAL ?  /*Finalidade da emiss∆o da NF-e: 1 - NFe normal 2 - NFe complementar 3 - NFe de ajuste*/
    indPag         AS CHARACTER INITIAL ?  /*Indicador da forma de pagamento: 0 - pagamento Ö vista; 1 - pagamento ‡ prazo; 2 - outros.*/
    mod            AS CHARACTER INITIAL ?  /*C¢digo do modelo do Documento Fiscal. Utilizar 55 para identificaá∆o da NF-e, emitida em substituiá∆o ao modelo 1 e 1A.*/
    natOp          AS CHARACTER INITIAL ?  /*Descriá∆o da Natureza da Operaá∆o*/
    nNF            AS CHARACTER INITIAL ?  /*N£mero do Documento Fiscal*/
    procEmi        AS CHARACTER INITIAL ?  /*Processo de emiss∆o utilizado com a seguinte codificaá∆o: 0 - emiss∆o de NF-e com aplicativo do contribuinte; 1 - emiss∆o de NF-e avulsa pelo Fisco; 2 - emiss∆o de NF-e avulsa, pelo contribuinte com seu certificado digital, atravÈs do site do Fisco; 3- emiss∆o de NF-e pelo contribuinte com aplicativo fornecido pelo Fisco.*/
    serie          AS CHARACTER INITIAL ?  /*SÇrie do Documento Fiscal*/
    tpAmb          AS CHARACTER INITIAL ?  /*Identificaá∆o do Ambiente: 1 - Produá∆o 2 - Homologaá∆o*/
    tpEmis         AS CHARACTER INITIAL ?  /*Forma de emiss∆o da NF-e (1=Emiss∆o normal (n∆o em contingància); 2=Contingància FS-IA, com impress∆o do DANFE em formul†rio de seguranáa; 3=Contingància SCAN (Sistema de Contingància  do Ambiente Nacional); 4=Contingància EPEC (Declaraá∆o PrÇvia da Emiss∆o em Contingància); 5=Contingància FS-DA, com impress∆o do DANFE em formul†rio de seguranáa; 6=Contingància SVC-AN (SEFAZ Virtual de Contingància do AN); 7=Contingància SVC-RS (SEFAZ Virtual de Contingància do RS); 9=Contingància off-line da NFC-e)*/
    tpImp          AS CHARACTER INITIAL ?  /*Formato do DANFE (0=Sem geraá∆o de DANFE; 1=DANFE normal, Retrato; 2=DANFE normal, Paisagem; 3=DANFE Simplificado; 4=DANFE NFC-e; 5=DANFE NFC-e em mensagem eletrìnica. */                                                                                                                                                                                                                                                                                                                                                
    tpNF           AS CHARACTER INITIAL ?  /*Tipo do Documento Fiscal (0 - entrada; 1 - sa°da)*/
    verProc        AS CHARACTER INITIAL ?  /*vers∆o do aplicativo utilizado no processo de emiss∆o*/
    dhCont         AS CHARACTER INITIAL ?  /*Data/hora entrada em contingencia (Formato AAAA-MM-DDThh:mm:ssTZD (UTC - Universal Coordinated Time))*/
    xJust          AS CHARACTER INITIAL ?  /*Justificada entrada em contingencia*/
    idDest         AS CHARACTER INITIAL ?  /*Identificador de Local de destino da operaá∆o (1=Operaá∆o interna; 2=Operaá∆o interestadual; 3=Operaá∆o com exterior.)*/
    indFinal       AS CHARACTER INITIAL ?  /*Indica operaá∆o com Consumidor final (0=N∆o; 1=Consumidor final;)*/
    indPres        AS CHARACTER INITIAL ?  /*Indicador de presenáa do comprador no estabelecimento comercial no momento da oepraá∆o (0-N∆o se aplica (ex.: Nota Fiscal complementar ou de ajuste;1-Operaá∆o presencial;2-N∆o presencial, internet;3-N∆o presencial, teleatendimento;4-NFC-e entrega em domic°lio;9-N∆o presencial, outros)*/
    */

    FOR FIRST param-nf-estab NO-LOCK
        WHERE param-nf-estab.cod-estabel = nota-fiscal.cod-estabel: END.

    IF  nota-fiscal.ind-tip-nota <> 8 THEN
        RUN cdp/cd2712.p (INPUT  ROWID(nota-fiscal),
                          OUTPUT cIndPag).

    ELSE 
        IF  AVAIL cond-pagto
        AND nota-fiscal.cod-cond-pag <> 0 THEN /* nao e condicao especial */
            ASSIGN cIndPag = (IF cond-pagto.cod-vencto = 2
                              THEN "0"
                              ELSE IF cond-pagto.cod-vencto = 3
                                   THEN "2"
                                   ELSE "1").
        ELSE
            ASSIGN cIndPag = "2". /* Outros */

    ASSIGN l-nota-compl-imp = NO.

   /* IF  i-natureza > 1 THEN*/   /*alteraá∆o referente ao chamado AAGEVO*/
        IF  nota-fiscal.ind-tip-nota = 4 
        OR  (nota-fiscal.ind-tip-nota = 8 /* Nota Entrada */
        AND  nota-fiscal.int-2        = 4003) THEN DO: /*Nota Complementar de Imposto de Importacao gerada exclusivamente com a funcao especial e via FT4003*/
            FIND it-nota-fisc WHERE /*nao use find first*/
                 it-nota-fisc.cod-estabel = nota-fiscal.cod-estabel AND
                 it-nota-fisc.serie       = nota-fiscal.serie AND
                 it-nota-fisc.nr-nota-fis = nota-fiscal.nr-nota-fis NO-LOCK NO-ERROR.
            IF  AVAIL it-nota-fisc              
            AND (it-nota-fisc.qt-faturada[1] = 1 OR it-nota-fisc.qt-faturada[1] = 0)
            AND it-nota-fisc.vl-merc-liq    = 0 
            AND it-nota-fisc.vl-merc-tab    = 0
            AND it-nota-fisc.tipo-contr     = 4 /*debito direto*/ THEN
                ASSIGN l-nota-compl-imp = YES.
        END.


    CREATE ttIde.
    ASSIGN ttIde.cDV      = (&if '{&bf_dis_versao_ems}' >= '2.07':U
                             &then SUBSTRING( STRING   (nota-fiscal.cod-chave-aces-nf-eletro),44,1)
                             &else SUBSTRING( SUBSTRING(nota-fiscal.char-2,3,60)             ,44,1) &endif)
           ttIde.cMunFG   = STRING(IF  estabelec.pais = "Brasil":U
                                   THEN (&if '{&bf_dis_versao_ems}' >= '2.07':U
                                         &then IF AVAIL bf-cidade-est THEN bf-cidade-est.cdn-munpio-ibge ELSE 0
                                         &else IF AVAIL bf-cidade-est THEN bf-cidade-est.int-2           ELSE 0 &endif)
                                   ELSE 9999999)
           ttIde.cNF      = (&if '{&bf_dis_versao_ems}' >= '2.07':U
                             &then SUBSTRING ( STRING   (nota-fiscal.cod-chave-aces-nf-eletro),36,8)
                             &else SUBSTRING ( SUBSTRING(nota-fiscal.char-2,3,60)             ,36,8) &endif)
           ttIde.cUF      = STRING(IF  estabelec.pais = "Brasil":U
                                   THEN (&if '{&bf_dis_versao_ems}' >= '2.07':U
                                         &then IF AVAIL bf-unid-feder-est THEN INT(bf-unid-feder-est.cod-uf-ibge)           ELSE 0
                                         &else IF AVAIL bf-unid-feder-est THEN INT(SUBSTRING(bf-unid-feder-est.char-1,1,2)) ELSE 0 &endif)
                                   ELSE 99).

    IF (TRIM(SUBSTRING(nota-fiscal.char-1,282,25)) <> "") THEN
        ASSIGN ttIde.dhEmi = TRIM(SUBSTRING(nota-fiscal.char-1,282,25)).
    ELSE DO:
        RUN cdp/cd0591.p (INPUT nota-fiscal.cod-estabel,
                          INPUT nota-fiscal.dt-emis-nota,
                          INPUT nota-fiscal.hr-atualiza + ":00",
                          INPUT NO, /* formatar hora sem aplicar o fuso */
                          OUTPUT p-dh-formatada).
    
        ASSIGN ttIde.dhEmi = p-dh-formatada.
    END.

    /* L¢gica para verificar se a hora de missao Ç posterior a hora de envio e neste caso trocar pela hora de envio */
    IF  DATE( int(SUBSTR(ttIde.dhEmi,6,2)), int(SUBSTR(ttIde.dhEmi,9,2)), int(SUBSTR(ttIde.dhEmi,1,4))) = TODAY
    AND SUBSTR(ttIde.dhEmi,12,8) > STRING(TIME,"HH:MM:SS") THEN 
        OVERLAY(ttIde.dhEmi,12,8) = STRING(TIME,"HH:MM:SS").

    ASSIGN p-dh-formatada = "".
    IF (AVAIL bf-nota-fisc-adc-nfe AND bf-nota-fisc-adc-nfe.cod-livre-3 <> "") THEN
        ASSIGN p-dh-formatada = bf-nota-fisc-adc-nfe.cod-livre-3.
    ELSE IF (AVAIL bf-nota-fisc-adc-nfe AND bf-nota-fisc-adc-nfe.dat-livre-1 <> ? AND bf-nota-fisc-adc-nfe.hra-saida <> "") THEN /*Foi informado no CD4035*/
        RUN cdp/cd0591.p (INPUT bf-nota-fisc-adc-nfe.cod-estab,
                          INPUT bf-nota-fisc-adc-nfe.dat-livre-1,
                          INPUT STRING(bf-nota-fisc-adc-nfe.hra-saida,"99:99:99"),
                          INPUT NO, /* formatar hora sem aplicar o fuso */
                          OUTPUT p-dh-formatada).
    ELSE IF nota-fiscal.dt-saida <> ? THEN /*Nao foi informado do CD4035, buscar do dt-saida, quando este possuir conteudo valido*/
        RUN cdp/cd0591.p (INPUT nota-fiscal.cod-estabel,
                          INPUT nota-fiscal.dt-saida,
                          INPUT STRING(TIME,"HH:MM:SS"),
                          INPUT NO, /* formatar hora sem aplicar o fuso */
                          OUTPUT p-dh-formatada).

    ASSIGN ttIde.dhSaiEnt = p-dh-formatada WHEN p-dh-formatada <> "".

    ASSIGN ttIde.finNFe   = IF TRIM(SUBSTRING(nota-fiscal.char-2,211,2)) <> "" AND TRIM(SUBSTRING(nota-fiscal.char-2,211,2)) <> "0" THEN
                               TRIM(SUBSTRING(nota-fiscal.char-2,211,2)) /*Finalidade NF-e*/
                            ELSE
                            (IF (bf-natur-oper-nf.cod-cfop = "5601"
                             OR  bf-natur-oper-nf.cod-cfop = "5602"
                             OR  bf-natur-oper-nf.cod-cfop = "5603"
			     OR  bf-natur-oper-nf.cod-cfop = "5605"
                             OR  bf-natur-oper-nf.cod-cfop = "6603") 
                             THEN "3"
                             ELSE IF  nota-fiscal.ind-tip-nota = 3  /*3 Diferenca de Preco*/ 
                                  OR  l-nota-compl-imp              /*2 Complementar de Imposto*/
                                  THEN "2"
                                  ELSE IF  nota-fiscal.esp-docto = 20 
                                       THEN "4" /*4 Devolucao*/
                                       ELSE "1")
           ttIde.indPag   = cIndPag
           ttIde.mod      = &if '{&bf_dis_versao_ems}' >= '2.07' &THEN
                            bf-natur-oper-nf.cod-model-nf-eletro WHEN AVAIL bf-natur-oper-nf
                            &ELSE
                            SUBSTRING(bf-natur-oper-nf.char-2,120,2) WHEN AVAIL bf-natur-oper-nf
                            &endif
           ttIde.natOp    = (&if '{&bf_dis_versao_ems}' >= '2.05':U &then 
                                 IF SUBSTRING(bf-natur-oper-nf.char-1,166,1) = "1":U THEN bf-natur-oper-nf.denominacao 
                                ELSE IF AVAIL cfop-natur THEN cfop-natur.des-cfop
                                    ELSE ""
                             &else
                                 IF AVAIL ped-curva
                                 THEN ped-curva.nome 
                                 ELSE IF AVAIL bf-natur-oper-nf THEN bf-natur-oper-nf.denominacao ELSE ""
                             &endif)
           ttIde.nNF      = STRING( DEC(nota-fiscal.nr-nota-fis) )  /* Para retirar zeros Ö esquerda */
           ttIde.procEmi  = (IF lLayoutTXT
                             THEN "3"  /*3 - emiss∆o de NF-e pelo contribuinte com aplicativo fornecido pelo FISCO*/
                             ELSE "0") /*0 - emiss∆o de NF-e com aplicativo do contribuinte*/
           ttIde.serie    = c-serie.


    IF  LOOKUP(tp-integ, "TSS,TC,TC2":U) > 0 THEN DO:
        ASSIGN ttIde.tpAmb   = IF  AVAIL param-nf-estab AND 
                                   tp-integ <> "TC2":U THEN 
                                   &if "{&BF_DIS_VERSAO_EMS}" >= "2.08" &then
                                   STRING(param-nf-estab.idi-tip-emis-amb-sefaz)
                                   &else
                                   STRING(param-nf-estab.num-livre-1)
                                   &endif
                               ELSE 
                                   (IF &if "{&BF_DIS_VERSAO_EMS}" >= "2.07" &then
                                       estabelec.idi-tip-emis-nf-eletro    = 3
                                       &else
                                       INT(SUBSTR(estabelec.char-1,168,1)) = 3  /* Processo Emiss∆o NF-e - CD0403 */
                                       &endif
                                    THEN "1"  /* Produá∆o    */
                                    ELSE "2") /* Homologaá∆o */. 
    END.
    ELSE DO:
        ASSIGN ttIde.tpAmb   = (IF &if "{&BF_DIS_VERSAO_EMS}" >= "2.07" &then
                                   estabelec.idi-tip-emis-nf-eletro    = 3
                                   &else
                                   INT(SUBSTR(estabelec.char-1,168,1)) = 3  /* Processo Emiss∆o NF-e - CD0403 */
                                   &endif
                                THEN "1"  /* Produá∆o    */
                                ELSE "2") /* Homologaá∆o */
                                .
    END.

    ASSIGN ttIde.tpEmis   =  (&if '{&bf_dis_versao_ems}' >= '2.07':U
                              &then STRING   (nota-fiscal.idi-forma-emis-nf-eletro)
                              &else SUBSTRING(nota-fiscal.char-2,65,2) &endif)
           ttIde.tpImp    = (&if '{&bf_dis_versao_ems}' >= '2.07':U
                             &then STRING   (ser-estab.idi-format-emis-danfe)
                             &else SUBSTRING(ser-estab.char-1,4,1) &endif) WHEN AVAIL ser-estab
           ttIde.tpImp    = (IF  ttIde.tpImp = "3" THEN "1" ELSE 
                             IF  ttIde.tpImp = "4" THEN "2"
                                                   ELSE ttIde.tpImp)
           ttIde.tpNF     = (IF c-cod-cfop = "" OR c-cod-cfop = ?
                             THEN "" /* nao enviar 0 ou 1 quando CFOP = "" ou ? */
                             ELSE IF SUBSTRING(c-cod-cfop,1,1) = "1" OR 
                                     SUBSTRING(c-cod-cfop,1,1) = "2" OR 
                                     SUBSTRING(c-cod-cfop,1,1) = "3"
                                  THEN "0"  /*Entrada*/
                                  ELSE "1") /*Sa°da  */
           ttIde.verProc  = (IF lLayoutTXT
                             THEN (IF &if  "{&bf_dis_versao_ems}" >= "2.09" &then 
                                        estabelec.des-vers-software-emissor
                                      &else 
                                        TRIM(SUBSTRING(estabelec.char-1,251,10)) &endif
                                   <> "":U
                                   THEN &if  "{&bf_dis_versao_ems}" >= "2.09"
                                        &then estabelec.des-vers-software-emissor
                                        &else TRIM(SUBSTRING(estabelec.char-1,251,10)) &endif
                                   ELSE "2.0.2")
                             ELSE "5.0")
           ttIde.indFinal = (IF nota-fiscal.cod-des-merc = 2 /* 1 Comercio/Industria / 2 Consumo Proprio/Ativo */
                             THEN "1"  /*1=Consumidor final*/
                             ELSE "0") /*0=N∆o*/

           ttIde.indPres  = (IF AVAIL bf-nota-fisc-adc-nfe AND bf-nota-fisc-adc-nfe.cod-livre-1 <> "":U /* 0=N∆o se aplica (por exemplo, Nota Fiscal complementar ou de ajuste); */
                             THEN TRIM(bf-nota-fisc-adc-nfe.cod-livre-1)                                /* 1=Operaá∆o presencial;                                                */
                             ELSE "9":U)                                                                /* 2=Operaá∆o n∆o presencial, pela Internet;                             */
                                                                                                        /* 3=Operaá∆o n∆o presencial, Teleatendimento;                           */
                                                                                                        /* 4=NFC-e em operaá∆o com entrega a domic°lio;                          */
                                                                                                        /* 9=Operaá∆o n∆o presencial, outros.                                    */

           ttIde.tpImp    = (IF AVAIL bf-nota-fisc-adc-nfe AND bf-nota-fisc-adc-nfe.cod-livre-2 <> "":U /* 0=Sem geraá∆o de DANFE;   */ 
                             THEN TRIM(bf-nota-fisc-adc-nfe.cod-livre-2)                                /* 1=DANFE normal, Retrato;  */
                             ELSE ttIde.tpImp)                                                          /* 2=DANFE normal, Paisagem; */ 
           .

    IF  ttIde.tpEmis <> "1" THEN DO:
        FOR FIRST reg-inf-compl NO-LOCK
            WHERE reg-inf-compl.cod-tab-inform   = "estabelec"
            AND   reg-inf-compl.cod-campo-inform = "cdn-msg-contingen",
            FIRST inf-compl NO-LOCK
            WHERE inf-compl.cdn-identif = reg-inf-compl.cdn-identif
            AND   inf-compl.cod-indice  = nota-fiscal.cod-estabel:
            FIND FIRST mensagem NO-LOCK WHERE mensagem.cod-mensagem = inf-compl.num-campo NO-ERROR.
            IF  AVAIL mensagem THEN DO:

                IF  INDEX(nota-fiscal.observ-nota,"Data/Hora entrada em contingencia":U) = 0 THEN /* ainda n∆o gravou msg de contingencia na observaá∆o */
                    ASSIGN cHoraContingencia = STRING(TIME,"HH:MM:SS"). /* pega hora do sistema */
                ELSE
                    ASSIGN cHoraContingencia = SUBSTR(nota-fiscal.observ-nota, INDEX(nota-fiscal.observ-nota,"Data/Hora entrada em contingencia":U) + 46, 8).
                                               /* pega hora j† gravada na observaá∆o da nota */

                RUN cdp/cd0591.p (INPUT nota-fiscal.cod-estabel,
                                  INPUT nota-fiscal.dt-emis-nota,
                                  INPUT cHoraContingencia,
                                  INPUT NO, /* formatar hora sem aplicar o fuso */
                                  OUTPUT p-dh-formatada).

                ASSIGN ttIde.dhCont = p-dh-formatada
                       ttIde.xJust  = "Justificativa entrada em contingencia: " + mensagem.texto-mensag.

            END.
        END.
    END.
    ELSE
        ASSIGN ttIde.dhCont      = ""
               ttIde.xJust       = "".

    /*---- NOTA DE CRêDITO DE ATIVO ---*/
    IF TRIM(SUBSTRING(nota-fiscal.char-2,211,2)) <> "" AND TRIM(SUBSTRING(nota-fiscal.char-2,211,2)) <> "0" THEN
        ASSIGN ttIde.finNFe = TRIM(SUBSTRING(nota-fiscal.char-2,211,2)). /*Finalidade NF-e*/
    ELSE
        IF (nota-fiscal.ind-tip-nota = 8
        AND nota-fiscal.int-2        = 4003  /*GERADA VIA FT4003 COM NATUREZA DE ENTRADA E FUNCAO ESPECIAL "NFEFT4003"*/
        AND CAN-FIND (FIRST funcao
                      WHERE funcao.cd-funcao = "spp-NFEFT4003":U
                        AND funcao.ativo))
        OR (nota-fiscal.ind-tip-nota = 4
        AND nota-fiscal.int-2        = 207)  /*GERADA VIA MRI - RI0207*/
        THEN
            ASSIGN ttIde.finNFe = "3". /*Para o Fisco este tipo de nota de ser gerado como 3 Œ NF-e de Ajuste*/
    /*---*/

    /* Chave EMS */
    ASSIGN ttIde.CodEstabelNF = nota-fiscal.cod-estabel
           ttIde.SerieNF      = nota-fiscal.serie
           ttIde.NrNotaFisNF  = nota-fiscal.nr-nota-fis.

    /* Ajusta Formatacao dos Campos */
    IF  AVAIL ttIde THEN
        ASSIGN ttIde.cDV         = fn-ajusta-tamanho-campo(ttIde.cDV    , 1)
               ttIde.cMunFG      = fn-ajusta-tamanho-campo(ttIde.cMunFG , 7)
               ttIde.cNF         = fn-ajusta-tamanho-campo(ttIde.cNF    , 8)
               ttIde.cUF         = fn-ajusta-tamanho-campo(ttIde.cUF    , 2)
               ttIde.finNFe      = fn-ajusta-tamanho-campo(ttIde.finNFe , 1)
               ttIde.indPag      = fn-ajusta-tamanho-campo(ttIde.indPag , 1)
               ttIde.mod         = fn-ajusta-tamanho-campo(ttIde.mod    , 2)
               ttIde.natOp       = fn-ajusta-tamanho-campo(ttIde.natOp  ,60)
               ttIde.nNF         = fn-ajusta-tamanho-campo(ttIde.nNF    , 9)
               ttIde.procEmi     = fn-ajusta-tamanho-campo(ttIde.procEmi, 1)
               ttIde.serie       = fn-ajusta-tamanho-campo(ttIde.serie  , 3)
               ttIde.tpAmb       = fn-ajusta-tamanho-campo(ttIde.tpAmb  , 1)
               ttIde.tpEmis      = fn-ajusta-tamanho-campo(ttIde.tpEmis , 1)
               ttIde.tpImp       = fn-ajusta-tamanho-campo(ttIde.tpImp  , 1)
               ttIde.tpNF        = fn-ajusta-tamanho-campo(ttIde.tpNF   , 1)
               ttIde.xJust       = fn-ajusta-tamanho-campo(ttIde.xJust  ,256)
               ttIde.verProc     = fn-ajusta-tamanho-campo(ttIde.verProc,20).

END PROCEDURE.
