PROCEDURE pi-grava-ttICMS70:

    /*
    === ttICMS70 ===
    CST            AS CHARACTER INITIAL ?  /*Tributá∆o pelo ICMS 70 - Com reduá∆o de base de c†lculo e cobranáa do ICMS por substituiá∆o tribut†ria */
    modBC          AS CHARACTER INITIAL ?  /*Modalidade de determinaá∆o da BC do ICMS: 0 - Margem Valor Agregado (%); 1 - Pauta (valor); 2 - Preáo Tabelado M†ximo (valor); 3 - Valor da Operaá∆o.*/
    modBCST        AS CHARACTER INITIAL ?  /*Modalidade de determinaá∆o da BC do ICMS ST: 0 - Preáo tabelado ou m†ximo  sugerido; 1 - Lista Negativa (valor); 2 - Lista Positiva (valor); 3 - Lista Neutra (valor); 4 - Margem Valor Agregado (%); 5 - Pauta (valor).*/
    orig           AS CHARACTER INITIAL ?  /*origem da mercadoria: 0 - Nacional 1 - Estrangeira - Importaá∆o direta 2 - Estrangeira - Adquirida no mercado interno */
    pICMS          AS DECIMAL   INITIAL ?  /*Al°quota do ICMS*/
    pICMSST        AS DECIMAL   INITIAL ?  /*Al°quota do ICMS ST*/
    pMVAST         AS DECIMAL   INITIAL ?  /*Percentual da Margem de Valor Adicionado ICMS ST*/
    pRedBC         AS DECIMAL   INITIAL ?  /*Percentual de reduá∆o da BC*/
    pRedBCST       AS DECIMAL   INITIAL ?  /*Percentual de reduá∆o da BC ICMS ST */
    vBC            AS DECIMAL   INITIAL ?  /*Valor da BC do ICMS*/
    vBCST          AS DECIMAL   INITIAL ?  /*Valor da BC do ICMS ST*/
    vICMS          AS DECIMAL   INITIAL ?  /*Valor do ICMS*/
    vICMSST        AS DECIMAL   INITIAL ?  /*Valor do ICMS ST*/
    vICMSDeson     AS DECIMAL   INITIAL ?  /*Valor do ICMS de desoneraá∆o*/ 
    motDesICMS     AS CHARACTER INITIAL ?  /*Motivo da desoneraá∆o do ICMS:3-Uso na agropecu†ria;9-Outros;12-Fomento agropecu†rio*/
    vBCFCP         AS DECIMAL   INITIAL ?  /*Valor da BC do FCP*/ 
    pFCP           AS DECIMAL   INITIAL ?  /*Al°quota do FCP*/
    vFCP           AS DECIMAL   INITIAL ?  /*Valor do FCP*/       
    vBCFCPST       AS DECIMAL   INITIAL ?  /*Valor da BC do FCP ST*/ 
    pFCPST         AS DECIMAL   INITIAL ?  /*Al°quota do FCP ST*/
    vFCPST         AS DECIMAL   INITIAL ?  /*Valor do FCP ST*/       
    */

    FOR FIRST item-nf-adc NO-LOCK
        WHERE item-nf-adc.cod-estab             = it-nota-fisc.cod-estabel
        AND   item-nf-adc.cod-serie             = it-nota-fisc.serie
        AND   item-nf-adc.cod-nota-fisc         = it-nota-fisc.nr-nota-fis
        AND   item-nf-adc.cdn-emitente          = nota-fiscal.cod-emitente
        AND   item-nf-adc.cod-natur-operac      = it-nota-fisc.nat-operacao
        AND   item-nf-adc.idi-tip-dado          = 1
        AND   item-nf-adc.num-seq               = 1
        AND   item-nf-adc.num-seq-item-nf       = it-nota-fisc.nr-seq-fat
        AND   item-nf-adc.cod-item              = it-nota-fisc.it-codigo:
    END.  

    CREATE ttICMS70.
    ASSIGN ttICMS70.CST        = SUBSTRING(c-niv-trib-icms,2,2)
           ttICMS70.modBC      = (IF c-mod-base-icms = "2"
                                  THEN "1"
                                  ELSE IF c-mod-base-icms = "3"
                                       THEN "2"
                                       ELSE IF c-mod-base-icms = "4"
                                            THEN "3"
                                            ELSE "0")
           ttICMS70.modBCST    = (IF c-mod-base-icms-st = "2"
                                  THEN "1"
                                  ELSE IF c-mod-base-icms-st = "3"
                                       THEN "2"
                                       ELSE IF c-mod-base-icms-st = "4"
                                            THEN "3"
                                            ELSE IF c-mod-base-icms-st = "5"
                                                 THEN "4"
                                                 ELSE IF c-mod-base-icms-st = "6"
                                                      THEN "5"
                                                      ELSE IF c-mod-base-icms-st = "7"
                                                           THEN "6"
                                                           ELSE "0")                                                         
           ttICMS70.orig       = SUBSTRING(c-niv-trib-icms,1,1)
           ttICMS70.pICMS      = (IF it-nota-fisc.cd-trib-icm <> 3
                                  THEN d-aliquota-icms
                                  ELSE 0)
           ttICMS70.pICMSST    = IF  AVAIL item-nf-adc THEN item-nf-adc.val-aliq-icms-st ELSE 0
           ttICMS70.pMVAST     = IF  AVAIL item-nf-adc AND item-nf-adc.val-livre-1 > 0 THEN item-nf-adc.val-livre-1 ELSE DEC(SUBSTR(it-nota-fisc.char-2,338,8))
           ttICMS70.pRedBC     = IF d-perc-redimp > 0 THEN d-perc-redimp  ELSE ? /*ELSE IF lLayoutXML THEN ? ELSE IF lLayoutTXT THEN 0 ELSE ?)*/
           ttICMS70.pRedBCST   = IF  AVAIL item-nf-adc AND item-nf-adc.val-livre-2 > 0 THEN item-nf-adc.val-livre-2 ELSE DEC(SUBSTR(it-nota-fisc.char-2,346,8))
           ttICMS70.vBC        = d-vl-bicms-it
           ttICMS70.vBCST      = it-nota-fisc.vl-bsubs-it
           ttICMS70.vICMS      = (IF it-nota-fisc.cd-trib-icm <> 3
                                  THEN d-vl-imp-icms
                                  ELSE 0)
           ttICMS70.vICMSST    = it-nota-fisc.vl-icmsub-it
           ttICMS70.vICMSDeson = d-vl-desc-icms
           ttICMS70.motDesICMS = TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2))
           ttICMS70.indDeduzDeson = IF l-indDeduzDeson = YES THEN "1" ELSE "0".
           /*OBS.:
           O CST 70 aceita os motivos de desoneraá∆o
           3=Uso na agropecu†ria;
           9=Outros;
           12=‡rg∆o de fomento e desenvolvimento agropecu†rio.
           */

   /*--- Valores FCP ---*/
    FOR FIRST item-nf-adc NO-LOCK
        WHERE item-nf-adc.cod-estab         = nota-fiscal.cod-estabel
        AND   item-nf-adc.cod-serie         = nota-fiscal.serie
        AND   item-nf-adc.cod-nota-fisc     = (if nota-fiscal.ind-tip-nota <> 8 then nota-fiscal.nr-nota-fis else nota-fiscal.nr-nota-ant)
        AND   item-nf-adc.idi-tip-dado      = 25
        AND   item-nf-adc.cdn-emitente      = nota-fiscal.cod-emitente
        AND   item-nf-adc.cod-natur-operac  = it-nota-fisc.nat-operacao
        AND   item-nf-adc.num-seq-item-nf   = (if nota-fiscal.ind-tip-nota <> 8 then it-nota-fisc.nr-seq-fat else it-nota-fisc.nr-seq-ped)
        AND   item-nf-adc.cod-item          = it-nota-fisc.it-codigo:
       
        IF  item-nf-adc.log-livre-2 = ? THEN DO: /* Nova geraá∆o de FCP -> FCP e FCP ST juntos no mesmo item da nota */

            IF (item-nf-adc.val-livre-1      > 0 OR /* Valores de FCP ST */
                item-nf-adc.val-livre-2      > 0 OR
                DEC(item-nf-adc.cod-livre-4) > 0)
            THEN
                ASSIGN ttICMS70.vBCFCPST = item-nf-adc.val-livre-1
                       ttICMS70.pFCPST   = item-nf-adc.val-livre-2
                       ttICMS70.vFCPST   = DEC(item-nf-adc.cod-livre-4)
                       d-total-vFCPST    = d-total-vFCPST + ttICMS70.vFCPST.

            IF (item-nf-adc.val-livre-3      > 0 OR /* Valores de FCP */
                item-nf-adc.val-livre-4      > 0 OR
                DEC(item-nf-adc.cod-livre-3) > 0)
            THEN
                ASSIGN ttICMS70.vBCFCP   = item-nf-adc.val-livre-3
                       ttICMS70.pFCP     = item-nf-adc.val-livre-4
                       ttICMS70.vFCP     = DEC(item-nf-adc.cod-livre-3)
                       d-total-vFCP      = d-total-vFCP + ttICMS70.vFCP.
        END.
        /* Geraá∆o de dados antiga FCP ou FCP ST */
        ELSE IF item-nf-adc.log-livre-1 = NO  /* NO = FCP Normal | YES = FCP ST */
        THEN
            ASSIGN ttICMS70.vBCFCP   = item-nf-adc.val-livre-1
                   ttICMS70.pFCP     = item-nf-adc.val-livre-2
                   ttICMS70.vFCP     = DEC(item-nf-adc.cod-livre-4)
                   d-total-vFCP      = d-total-vFCP + ttICMS70.vFCP.
        ELSE
            ASSIGN ttICMS70.vBCFCPST = item-nf-adc.val-livre-1
                   ttICMS70.pFCPST   = item-nf-adc.val-livre-2
                   ttICMS70.vFCPST   = DEC(item-nf-adc.cod-livre-4)
                   d-total-vFCPST    = d-total-vFCPST + ttICMS70.vFCPST.
    END.
    /*---*/
    /* Majora ICMS ST com FCP ST funá∆o por estado - EX: MT */ 
    IF  l-Majora-FCP = YES
    AND ttICMS70.vFCPST <> ? THEN DO:
        ASSIGN ttICMS70.pICMSST  = ttICMS70.pICMSST + ttICMS70.pFCPST
               ttICMS70.vICMSST  = ttICMS70.vICMSST + ttICMS70.vFCPST
               ttICMS70.vBCFCPST = ?
               ttICMS70.pFCPST   = ?
               ttICMS70.vFCPST   = ?.
    END.
    
    /* Chave EMS */
    ASSIGN ttICMS70.CodEstabelNF = nota-fiscal.cod-estabel
           ttICMS70.SerieNF      = nota-fiscal.serie
           ttICMS70.NrNotaFisNF  = nota-fiscal.nr-nota-fis
           ttICMS70.ItCodigoNF   = it-nota-fisc.it-codigo.
           ttICMS70.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.

END PROCEDURE.
