PROCEDURE pi-cria-ttrefNFP:

    DEF BUFFER bf2-emitente       FOR emitente.
    DEF BUFFER bf2-unid-feder-est FOR unid-feder.
    DEF BUFFER bf2-nota-fisc-adc  FOR nota-fisc-adc.
    DEF BUFFER bf2-natur-oper     FOR natur-oper.
    DEF BUFFER bf2-nota-fiscal    FOR nota-fiscal.
        
    
    DEF VAR c-ins-estadual        LIKE nota-fiscal.ins-estadual NO-UNDO.
    DEF VAR c-cnpj-cpf            LIKE nota-fiscal.cgc          NO-UNDO.

    FOR EACH nota-fisc-adc NO-LOCK
       WHERE nota-fisc-adc.cod-estab              = nota-fiscal.cod-estabel
       AND   nota-fisc-adc.cod-serie              = nota-fiscal.serie
       AND   nota-fisc-adc.cod-nota-fisc          = nota-fiscal.nr-nota-fis
       AND   nota-fisc-adc.cdn-emitente           = nota-fiscal.cod-emitente
       AND   nota-fisc-adc.cod-natur-operac       = nota-fiscal.nat-operacao
       AND   nota-fisc-adc.idi-tip-dado           = 3
       AND ( nota-fisc-adc.idi-tip-docto-referado = 2
        OR  (nota-fiscal.esp-docto                = 20 OR nota-fiscal.esp-docto = 22)
        OR  (nota-fiscal.ind-tip-nota             = 8 /* Entrada */ AND
             nota-fisc-adc.idi-tip-docto-referado = 1)
        OR  (nota-fiscal.pais <> "Brasil" AND 
             nota-fisc-adc.idi-tip-docto-referado = 1) )
       AND  (    STRING(INT(nota-fisc-adc.cod-model-docto-referado),"99") = "04"
             OR  STRING(INT(nota-fisc-adc.cod-model-docto-referado),"99") = "01"), /*Considerar somente notas de modelo 04, que Ç modelo para Produtor Rural [04 - Nota Fiscal de Produtor, modelo 4]*/
       FIRST bf2-emitente NO-LOCK
       WHERE bf2-emitente.cod-emitente = nota-fisc-adc.cdn-emit-docto-referado
       AND   bf2-emitente.atividade    = "Rural":U : /*Se o emitente da nota Ç Produtor Rural*/

        IF  NOT CAN-FIND (FIRST ttrefNFP
                          WHERE ttrefNFP.CodEstabelNF = nota-fiscal.cod-estabel
                          AND   ttrefNFP.SerieNF      = (IF nota-fiscal.serie = "" THEN "0" ELSE nota-fiscal.serie)
                          AND   ttrefNFP.NrNotaFisNF  = nota-fiscal.nr-nota-fis
                          AND   ttrefNFP.nNF          = STRING(INT(nota-fisc-adc.cod-docto-referado))
                          AND 	ttrefNFP.CodEmitNF    = nota-fisc-adc.cdn-emit-docto-referado ) THEN DO:
						  
            IF (nota-fiscal.pais <> "Brasil" AND nota-fisc-adc.idi-tip-docto-referado = 1) THEN DO:

                ASSIGN c-ins-estadual = ""
                       c-cnpj-cpf     = "".

                FOR FIRST docum-est NO-LOCK
                    WHERE docum-est.serie-docto  = nota-fisc-adc.cod-ser-docto-referado
                      AND docum-est.nro-docto    = nota-fisc-adc.cod-docto-referado
                      AND docum-est.cod-emitente = nota-fisc-adc.cdn-emit-docto-referado
                      AND docum-est.dt-emissao   = nota-fisc-adc.dat-docto-referado:
                
                    FOR FIRST bf2-unid-feder-est NO-LOCK
                        WHERE bf2-unid-feder-est.pais   = docum-est.pais
                          AND bf2-unid-feder-est.estado = docum-est.uf:
                    END.
                    
                    FOR FIRST loc-entr NO-LOCK
                        WHERE loc-entr.nome-abrev  = bf2-emitente.nome-abrev
                          AND loc-entr.cod-entrega = docum-est.cod-entrega:
                       
                        ASSIGN c-ins-estadual = loc-entr.ins-estadual
                               c-cnpj-cpf     = loc-entr.cgc.
                    END.
                END.

                /* se n∆o encontrou dados pelo docum-est, buscar na nota fiscal referenciada para achar a contra-nota (modelo 55) */
                IF (c-ins-estadual = "":U
                OR  c-cnpj-cpf     = "":U) THEN DO:
                   FOR EACH bf2-nota-fisc-adc NO-LOCK
                      WHERE  bf2-nota-fisc-adc.cod-estab                = nota-fisc-adc.cod-estab
                      AND    bf2-nota-fisc-adc.cod-ser-docto-referado   = nota-fisc-adc.cod-ser-docto-referado
                      AND    bf2-nota-fisc-adc.cod-docto-referado       = nota-fisc-adc.cod-docto-referado
                      AND    bf2-nota-fisc-adc.cdn-emit-docto-referado  = nota-fisc-adc.cdn-emit-docto-referado
                      AND    STRING(INT(bf2-nota-fisc-adc.cod-model-docto-referado),"99") = STRING(INT(nota-fisc-adc.cod-model-docto-referado),"99")
                      AND    bf2-nota-fisc-adc.dat-docto-referado       = nota-fisc-adc.dat-docto-referado
                      AND    bf2-nota-fisc-adc.idi-tip-dado             = 3
                      AND    bf2-nota-fisc-adc.idi-tip-docto-referado   = 1 
                      AND    rowid(bf2-nota-fisc-adc) <> rowid(nota-fisc-adc),
                      FIRST  bf2-nota-fiscal NO-LOCK
                      WHERE  bf2-nota-fiscal.cod-estabel                = bf2-nota-fisc-adc.cod-estab
                      AND    bf2-nota-fiscal.serie                      = bf2-nota-fisc-adc.cod-serie
                      AND    bf2-nota-fiscal.nr-nota-fis                = bf2-nota-fisc-adc.cod-nota-fisc
                      AND    bf2-nota-fiscal.dt-cancela                 = ? ,
                      FIRST  bf2-natur-oper NO-LOCK
                      WHERE  bf2-natur-oper.nat-operacao                = bf2-nota-fiscal.nat-operacao
                      AND    bf2-natur-oper.tipo                        = 1 : 
                         
                      ASSIGN c-ins-estadual = bf2-nota-fiscal.ins-estadual
                             c-cnpj-cpf     = bf2-nota-fiscal.cgc.
                   END.
                END.

                /* se n∆o encontrou dados pelo docum-est, buscar do emitente (cadastro fornec do prod rural) */
                IF (c-ins-estadual = "":U
                OR  c-cnpj-cpf     = "":U) THEN
                    ASSIGN c-ins-estadual = bf2-emitente.ins-estadual
                           c-cnpj-cpf     = bf2-emitente.cgc.

                IF  NOT AVAIL bf2-unid-feder-est THEN
                    FOR FIRST bf2-unid-feder-est NO-LOCK
                        WHERE bf2-unid-feder-est.pais   = bf2-emitente.pais
                          AND bf2-unid-feder-est.estado = bf2-emitente.estado:
                    END.

                /* se n∆o encontrou dados pelo docum-est, buscar como era antes, com os dados da nota fiscal */
                IF (c-ins-estadual = "":U
                OR  c-cnpj-cpf     = "":U) THEN
                    ASSIGN c-ins-estadual = nota-fiscal.ins-estadual
                           c-cnpj-cpf     = nota-fiscal.cgc.
            END.
            ELSE DO:
                FOR FIRST bf2-unid-feder-est NO-LOCK
                    WHERE bf2-unid-feder-est.pais   = nota-fiscal.pais
                      AND bf2-unid-feder-est.estado = nota-fiscal.estado:
                END.
                
                ASSIGN c-ins-estadual = nota-fiscal.ins-estadual
                       c-cnpj-cpf     = nota-fiscal.cgc.
            END.

            CREATE ttrefNFP.
            /*Chave EMS*/
            ASSIGN ttrefNFP.CodEstabelNF = nota-fiscal.cod-estabel                                  
                   ttrefNFP.SerieNF      = IF nota-fiscal.serie = "" THEN "0" ELSE nota-fiscal.serie
                   ttrefNFP.NrNotaFisNF  = nota-fiscal.nr-nota-fis
		   ttrefNFP.CodEmitNF    = bf2-emitente.cod-emitente.                                  
        
            ASSIGN ttrefNFP.cUF   = TRIM(STRING(IF  bf2-emitente.pais = "Brasil":U
                                                THEN (IF AVAIL bf2-unid-feder-est THEN INT(bf2-unid-feder-est.cod-uf-ibge) ELSE 0)
                                                ELSE 99))
                   ttrefNFP.AAMM  = TRIM(SUBSTRING(STRING(YEAR(nota-fisc-adc.dat-docto-referado),"9999"),3,2) + STRING(MONTH(nota-fisc-adc.dat-docto-referado),"99"))
                                  
                   ttrefNFP.CNPJ  = TRIM(c-cnpj-cpf) /*Gravado na nota fiscal, que herda do local de entrega selecionado*/
                   ttrefNFP.CNPJ  = REPLACE(ttrefNFP.CNPJ,"-","")
                   ttrefNFP.CNPJ  = REPLACE(ttrefNFP.CNPJ,".","")
                   ttrefNFP.CNPJ  = REPLACE(ttrefNFP.CNPJ,"/","")
                   ttrefNFP.CNPJ  = REPLACE(ttrefNFP.CNPJ,"~\","")
                   ttrefNFP.CNPJ  = REPLACE(ttrefNFP.CNPJ,",","")
                   ttrefNFP.CNPJ  = (IF ttrefNFP.CNPJ <> ?
                                     THEN ttrefNFP.CNPJ
                                     ELSE "")
                                
                   ttrefNFP.CPF   = (IF LENGTH(ttrefNFP.CNPJ) > 11
                                     THEN ""
                                     ELSE ttrefNFP.CNPJ) /* Pessoa Fisica - Joga o conteudo no campo CPF, caso tenha mais de 11 digitos (caracteriza CNPJ) */
                                
                   ttrefNFP.IE    = TRIM(c-ins-estadual) /*Gravado na nota fiscal, que herda do local de entrega selecionado*/
                   ttrefNFP.IE    = fn-ajusta-campo-IE(ttrefNFP.IE)
                   ttrefNFP.mod   = STRING(INT(nota-fisc-adc.cod-model-docto-referado),"99")
                   ttrefNFP.serie = IF nota-fisc-adc.cod-ser-docto-referado = "" THEN "0" ELSE nota-fisc-adc.cod-ser-docto-referado
                   ttrefNFP.nNF   = STRING(INT(nota-fisc-adc.cod-docto-referado)) NO-ERROR.

        END.
    END.
    
    VALIDATE ttrefNFP.

END PROCEDURE.
