    DEFINE VARIABLE cConteudoNFe AS CHARACTER NO-UNDO. /* Conte£do principal referente Ö nota fiscal eletrìnica <NF-e> atÇ </NFe>, sem cabeáalho EAI */

    /* TrataNFeEspec: EPC para tratamento espec°fico - vai chamar novo adapter na upc [SHV] */
    FOR EACH tt-epc
       WHERE tt-epc.cod-event = "TrataNFeEspec":U:
        DELETE tt-epc.
    END.

    FOR FIRST ttNFe NO-LOCK,
        FIRST nota-fiscal NO-LOCK
        WHERE nota-fiscal.cod-estabel = ttNFe.CodEstabelNF
          AND nota-fiscal.serie       = ttNFe.SerieNF     
          AND nota-fiscal.nr-nota-fis = ttNFe.NrNotaFisNF:
    END.

    &IF INTEGER(ENTRY(1,PROVERSION,".":U)) >= 10 &THEN
        /* Tratamento para Progress 10 utiilzando LONGCHAR na UPC-NFE.P customizada, 
           e aqui Ç quebrado o XML em partes para envio deste na tt-epc */

        DEFINE VARIABLE iPosicao      AS INTEGER   NO-UNDO INITIAL 1.
        DEFINE VARIABLE inPtr         AS MEMPTR    NO-UNDO.
        DEFINE VARIABLE lcConteudo    AS LONGCHAR  NO-UNDO.
        DEFINE VARIABLE iContConteudo AS INTEGER   NO-UNDO INITIAL 0.
        
        /* OBTEM O XML NUM PONTEIRO DE MEM‡RIA */
        RUN generateXMLToMemptr IN hGenXml (OUTPUT inPtr) NO-ERROR.

        /* COPIAR O PONTEIRO DE MEMORIA PARA UM LONGCHAR */
        COPY-LOB inPtr TO lcConteudo.
        
        /* LIMPAR MEMORIA */
        SET-SIZE(inPtr) = 0.
        
        /* QUEBRAR O XML DE 30.000 EM 30.000 CARACTERES E GRAVAR NA TT-EPC */
        DO iPosicao = 1 TO LENGTH(lcConteudo) BY 30000:
            ASSIGN iContConteudo = iContConteudo + 1.

            CREATE tt-epc.
            ASSIGN tt-epc.cod-event     = "TrataNFeEspec":U
                   tt-epc.cod-parameter = "ConteudoNFe" + STRING(iContConteudo, "99")
                   tt-epc.val-parameter = SUBSTRING(lcConteudo, iPosicao, 30000).
        END.

        /* Retira o lixo que fica no final */
        FOR  LAST tt-epc EXCLUSIVE-LOCK
            WHERE tt-epc.cod-event     = "TrataNFeEspec"
              AND tt-epc.cod-parameter BEGINS "ConteudoNFe"
               BY tt-epc.cod-parameter:
            ASSIGN tt-epc.val-parameter = SUBSTRING(tt-epc.val-parameter, 1, R-INDEX(tt-epc.val-parameter, ">")) NO-ERROR.
        END.

    &ELSE
        /* OBTEM O XML NUMA STRING */
        RUN generateXMLToString IN hGenXml (OUTPUT cConteudoNFe) NO-ERROR.

        CREATE tt-epc.
        ASSIGN tt-epc.cod-event     = "TrataNFeEspec":U
               tt-epc.cod-parameter = "ConteudoNFe":U
               tt-epc.val-parameter = cConteudoNFe.
    &ENDIF

    CREATE tt-epc.
    ASSIGN tt-epc.cod-event     = "TrataNFeEspec":U
           tt-epc.cod-parameter = "RowidNFe":U
           tt-epc.val-parameter = STRING(ROWID(nota-fiscal)) WHEN AVAIL nota-fiscal.

    CREATE tt-epc.
    ASSIGN tt-epc.cod-event     = "TrataNFeEspec":U
           tt-epc.cod-parameter = "Origem":U
           tt-epc.val-parameter = "ENVIO":U.

    {include/i-epc201.i "TrataNFeEspec"}

    FOR FIRST tt-epc NO-LOCK
        WHERE tt-epc.cod-event     = "TrataNFeEspec":U
          AND tt-epc.cod-parameter = "GeraTT_LOG_ERRO":U :

        CREATE TT_LOG_ERRO.
        ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO  = 15825.
        ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO  = tt-epc.val-parameter
               TT_LOG_ERRO.TTV_DES_MSG_AJUDA = TT_LOG_ERRO.TTV_DES_MSG_ERRO.
    END.

    IF  CAN-FIND (FIRST tt-epc
                  WHERE tt-epc.cod-event     = "TrataNFeEspec":U
                    AND tt-epc.cod-parameter = "XMLEspec":U) THEN DO:

        RETURN "OK":U. /*chamou novo adapter na UPC, ent∆o n∆o gera XML padr∆o, e retorna */
    END.
END.
