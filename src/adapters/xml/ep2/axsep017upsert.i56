PROCEDURE pi-calc-zona-franca.

    DEFINE INPUT PARAM de-vlPrecoUnitario LIKE it-nota-fisc.vl-preuni NO-UNDO. 

    DEFINE VARIABLE de-vl-preuni-aux   LIKE it-nota-fisc.vl-preuni NO-UNDO.
    
    ASSIGN  de-qt-fatur = if   it-nota-fisc.ind-fat-qtfam = no 
                          then it-nota-fisc.qt-faturada[1]
                          else it-nota-fisc.qt-faturada[2]
            r-cidade-zf = ?.

    find first cidade-zf where cidade-zf.cidade = nota-fiscal.cidade
         and   cidade-zf.estado = nota-fiscal.estado no-lock no-error.

    FIND FIRST natur-oper WHERE natur-oper.nat-operacao = nota-fiscal.nat-operacao NO-LOCK NO-ERROR.

    IF AVAIL cidade-zf AND AVAIL natur-oper THEN DO:
     
        ASSIGN r-cidade-zf = ROWID(cidade-zf).
        
        IF dec(substr(natur-oper.char-2,66,5)) > 0 then
           ASSIGN de-conv = (100 - dec(substr(natur-oper.char-2,66,5))) / 100.
    END.
    
    ASSIGN de-descto-icms = 1.

    IF AVAIL natur-oper THEN DO:
         &IF "{&bf_dis_versao_ems}" >= "2.062" &THEN
             
                     if  avail cidade-zf 
                      and (dec(substr(natur-oper.char-2,66,5)) > 0 OR 
                          natur-oper.val-perc-desc-pis-zfm    > 0 OR
                          natur-oper.val-perc-desc-cofins-zfm > 0) THEN
                         
                          assign de-conv-total = (100 - (dec(substr(natur-oper.char-2,66,5)) +
                                                        natur-oper.val-perc-desc-pis-zfm    +
                                                        natur-oper.val-perc-desc-cofins-zfm)) / 100
                                 de-descto-icms = (100 - (dec(substr(natur-oper.char-2,66,5)))) / 100.
         &ELSE
                      
                     if  avail cidade-zf 
                     and (dec(substr(natur-oper.char-2,66,5)) > 0 OR 
                          dec(substr(natur-oper.char-1,110,8)) > 0 OR
                          dec(substr(natur-oper.char-1,118,8)) > 0) THEN
                         
                          assign de-conv-total = (100 - (dec(substr(natur-oper.char-2,66,5))  + 
                                                        dec(substr(natur-oper.char-1,110,8)) + 
                                                        dec(substr(natur-oper.char-1,118,8)))) / 100
                                 de-descto-icms = (100 - (dec(substr(natur-oper.char-2,66,5)))) / 100.
         &ENDIF
    END.


    ASSIGN de-vl-preuni-aux = IF it-nota-fisc.ind-fat-qtfam = NO 
                              THEN de-vlPrecoUnitario /*it-nota-fisc.vl-preuni*/
                              ELSE IF it-nota-fisc.qt-faturada[2] = 0 
                                   THEN it-nota-fisc.vl-merc-liq 
                                   ELSE (it-nota-fisc.vl-merc-liq / it-nota-fisc.qt-faturada[2]).
    /*inicio zfm*/    
    IF  r-cidade-zf <> ? THEN DO: 

           &IF "{&bf_dis_versao_ems}" >= "2.062" &THEN
               IF  natur-oper.log-deduz-desc-zfm-tot-nf THEN
           &ELSE
               IF  SUBSTRING(natur-oper.char-1,109,1) = "S" THEN
           &ENDIF
                   ASSIGN de-vl-unit  = ( IF it-nota-fisc.ind-fat-qtfam = NO
                                          THEN ( de-vlPrecoUnitario )
                                          &IF "{&bf_dis_versao_ems}" >= "2.062" &THEN
                                          ELSE ( ( de-vlPrecoUnitario * it-nota-fisc.qt-faturada[2] ) / it-nota-fisc.qt-faturada[1] ) )
                                          &ELSE
                                          ELSE ( ( de-vlPrecoUnitario * it-nota-fisc.qt-faturada[1] ) / it-nota-fisc.qt-faturada[2] ) )
                                          &ENDIF
                          de-vl-total = ROUND(IF CAN-FIND (funcao WHERE funcao.cd-funcao = "SPP-DESCONTO-NFE":U AND funcao.ativo)
                                              THEN ( (de-vlPrecoUnitario * de-qt-fatur ) / de-conv-total)
                                              ELSE (de-vl-unit * de-qt-fatur ), 2).
               ELSE
                   ASSIGN de-vl-unit  = ( IF it-nota-fisc.ind-fat-qtfam = NO
                                          THEN ( de-vlPrecoUnitario )
                                          &IF "{&bf_dis_versao_ems}" >= "2.062" &THEN
                                          ELSE ( ( de-vlPrecoUnitario * it-nota-fisc.qt-faturada[2] ) / it-nota-fisc.qt-faturada[1] ) )
                                          &ELSE
                                          ELSE ( ( de-vlPrecoUnitario * it-nota-fisc.qt-faturada[1] ) / it-nota-fisc.qt-faturada[2] ) )
                                          &ENDIF
                          de-vl-total = ROUND(IF CAN-FIND (funcao WHERE funcao.cd-funcao = "SPP-DESCONTO-NFE":U AND funcao.ativo)
                                              THEN ( (de-vlPrecoUnitario * de-qt-fatur ) / de-conv)
                                              ELSE (de-vl-unit *  de-qt-fatur ), 2).
           
           &IF "{&bf_dis_versao_ems}" >= "2.062" &THEN
               IF  natur-oper.log-deduz-desc-zfm-tot-nf THEN
           &ELSE
               IF  SUBSTRING(natur-oper.char-1,109,1) = "S" THEN
           &ENDIF
                   ASSIGN de-vl-unit-trib  = de-vlPrecoUnitario.
               ELSE
                   ASSIGN de-vl-unit-trib  = de-vlPrecoUnitario.


           IF  de-vl-unit = ? THEN
                ASSIGN de-vl-unit = 0.

            IF  de-vl-total = ? THEN
                ASSIGN de-vl-total = 0.

            IF  de-vl-unit-trib  = ? THEN
                ASSIGN de-vl-unit-trib  = 0.

            IF  it-nota-fisc.aliquota-ipi <> 0  OR it-nota-fisc.vl-ipi-it    <> 0  OR  nota-fiscal.esp-docto     <> 20 THEN
                IF  it-nota-fisc.vl-despes-it > 0 AND 
                    it-nota-fisc.vl-ipi-it    > 0 AND 
                    it-nota-fisc.cd-trib-ipi <> 3 THEN DO:

                    {ftp/ft0513.i1}  /* Determina valor do IPI */

                    &IF "{&bf_dis_versao_ems}" >= "2.062" &THEN
                         
                          IF  natur-oper.log-deduz-desc-zfm-tot-nf THEN
                              ASSIGN de-vl-ipi-it = de-vl-ipi-it / de-conv-total.
                          ELSE
                              ASSIGN de-vl-ipi-it = de-vl-ipi-it / de-conv.

                    &ELSE
                          IF  SUBSTRING(natur-oper.char-1,109,1) = "S" THEN
                              ASSIGN de-vl-ipi-it = de-vl-ipi-it / de-conv-total.
                          ELSE
                              ASSIGN de-vl-ipi-it = de-vl-ipi-it / de-conv.
                    &ENDIF
                END.
                ELSE
                    IF it-nota-fisc.cd-trib-ipi <> 3 THEN DO:
                       &IF "{&bf_dis_versao_ems}" >= "2.062" &THEN
                       
                             IF  natur-oper.log-deduz-desc-zfm-tot-nf THEN
                                 ASSIGN de-vl-ipi-it = it-nota-fisc.vl-ipi-it / de-conv-total.
                             ELSE
                                 ASSIGN de-vl-ipi-it = it-nota-fisc.vl-ipi-it / de-conv.
                       &ELSE
                             IF  SUBSTRING(natur-oper.char-1,109,1) = "S" THEN
                                 ASSIGN de-vl-ipi-it = it-nota-fisc.vl-ipi-it / de-conv-total.
                             ELSE
                                 ASSIGN de-vl-ipi-it = it-nota-fisc.vl-ipi-it / de-conv.
                       &ENDIF
            END.

    END. /*Fim ZFM*/

END PROCEDURE.