PROCEDURE pi-cria-ttInfIntermed:

    DEFINE VARIABLE cIndPag    AS CHARACTER   NO-UNDO.
    DEFINE VARIABLE v-tot-vPag AS DECIMAL     NO-UNDO.
    
    /*
    === ttPag ===
    CNPJ                  AS CHARACTER   INITIAL ? /* CNPJ do Intermediador */
    idCadIntTran          AS CHARACTER   INITIAL ? /* Identificador do Intermediador */
    */

    
    CREATE ttInfIntermed.

    ASSIGN ttInfIntermed.CodEstabelNF = nota-fiscal.cod-estabel
           ttInfIntermed.SerieNF      = nota-fiscal.serie      
           ttInfIntermed.NrNotaFisNF  = nota-fiscal.nr-nota-fis
           
           ttInfIntermed.cnpjIntermed = (IF AVAIL bf-nota-fisc-adc-nfe AND SUBSTRING(bf-nota-fisc-adc-nfe.cod-livre-4,4,20) <> "":U /* Grava o CNPJ do intermediador quando informado */
                                  THEN SUBSTRING(bf-nota-fisc-adc-nfe.cod-livre-4,4,20)
                                  ELSE "":U)
           ttInfIntermed.idCadIntTran = (IF AVAIL bf-nota-fisc-adc-nfe AND SUBSTRING(bf-nota-fisc-adc-nfe.cod-livre-4,25,100) <> "":U /* Gravar o nome do intermediador quando informado*/
                                  THEN SUBSTRING(bf-nota-fisc-adc-nfe.cod-livre-4,25,60)
                                  ELSE "":U)
           .

END PROCEDURE.
