PROCEDURE pi-calcula-valor-seguro-por-item:

    DEFINE VARIABLE v-tot-vl-rateio-seg LIKE nota-fiscal.vl-seguro.

    /*------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
    RATEIO VALOR SEGURO
    No EMS tem-se o valor total do seguro gravado na nota. ê necess†rio enviar o valor por item. Calcula-se ent∆o um rateio com base no percentual do valor do item em relaá∆o ao total da nota.
    ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------*/

    EMPTY TEMP-TABLE tt-rateio-seguro.

    ASSIGN v-tot-vl-rateio-seg = 0.
        
    FOR EACH bf-it-nota-fisc-rat NO-LOCK
       WHERE bf-it-nota-fisc-rat.cod-estabel = nota-fiscal.cod-estabel
         AND bf-it-nota-fisc-rat.serie       = nota-fiscal.serie
         AND bf-it-nota-fisc-rat.nr-nota-fis = nota-fiscal.nr-nota-fis
        BREAK BY bf-it-nota-fisc-rat.cod-estabel
              BY bf-it-nota-fisc-rat.serie
              BY bf-it-nota-fisc-rat.nr-nota-fis
              BY bf-it-nota-fisc-rat.vl-tot-item /*AAAN90*/:

         CREATE tt-rateio-seguro.
         ASSIGN tt-rateio-seguro.nr-seq-fat = bf-it-nota-fisc-rat.nr-seq-fat
                tt-rateio-seguro.it-codigo  = bf-it-nota-fisc-rat.it-codigo
                tt-rateio-seguro.percentual = ((bf-it-nota-fisc-rat.vl-tot-item * 100) / nota-fiscal.vl-tot-nota)
                tt-rateio-seguro.valor      = nota-fiscal.vl-seguro * (tt-rateio-seguro.percentual / 100)
                v-tot-vl-rateio-seg         = v-tot-vl-rateio-seg + tt-rateio-seguro.valor.

         IF  LAST-OF (bf-it-nota-fisc-rat.cod-estabel) THEN DO:

             IF  v-tot-vl-rateio-seg <> nota-fiscal.vl-seguro THEN
                 ASSIGN tt-rateio-seguro.valor = tt-rateio-seguro.valor + (nota-fiscal.vl-seguro - v-tot-vl-rateio-seg).

         END.
    END.

END PROCEDURE.