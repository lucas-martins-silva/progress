FUNCTION fn-ajusta-tamanho-campo RETURNS CHAR (INPUT cCampo         AS CHAR,
                                               INPUT iTamanhoCampo  AS INT).

    /* Restringe tamanhos de campos, conforme layout definido pela Sefaz */

    DEFINE VARIABLE cCampoAjustado AS CHARACTER  NO-UNDO.

    IF  LENGTH(TRIM(cCampo)) > iTamanhoCampo THEN
        ASSIGN cCampoAjustado = SUBSTRING(TRIM(cCampo),1,iTamanhoCampo).
    ELSE
        ASSIGN cCampoAjustado = TRIM(cCampo).

    RETURN TRIM(cCampoAjustado).

END FUNCTION.

FUNCTION fn-ajusta-espacos-branco RETURNS CHAR (INPUT cCampo AS CHAR).

    /*--- Em uma string, retirar os espacos em branco a mais entre as palavras [mais de 2 espacos] ---*/
    DEFINE VARIABLE cRetiraEspacos AS CHARACTER  NO-UNDO.

    ASSIGN cRetiraEspacos = cCampo.
    DO  WHILE INDEX(cRetiraEspacos, "  ") > 0.
        ASSIGN cRetiraEspacos = REPLACE(cRetiraEspacos, "  ", " ").
    END.
    
    RETURN TRIM(cRetiraEspacos).

END FUNCTION.

FUNCTION fn-trata-caracteres RETURNS CHAR (INPUT p-string AS CHAR ).
    DEFINE VARIABLE c-trata-caracteres     AS CHAR CASE-SENSITIVE NO-UNDO.
    DEFINE VARIABLE c-trata-caracteres-aux AS CHAR CASE-SENSITIVE NO-UNDO.
    DEFINE VARIABLE i-posicao              AS INTEGER     NO-UNDO.
    DEFINE VARIABLE i-codigo-asc           AS INTEGER     NO-UNDO.
    DEFINE VARIABLE c-caracter             AS CHAR CASE-SENSITIVE NO-UNDO.
    
    ASSIGN c-trata-caracteres = p-string
           c-trata-caracteres = replace(c-trata-caracteres, 'û', '1')
           c-trata-caracteres = replace(c-trata-caracteres, 'ý', '2')
           c-trata-caracteres = replace(c-trata-caracteres, 'ü', '3')
           c-trata-caracteres = replace(c-trata-caracteres, 'Ê', '')
           c-trata-caracteres = replace(c-trata-caracteres, "'~'", '')
           c-trata-caracteres = replace(c-trata-caracteres, '^', '')  
           c-trata-caracteres = replace(c-trata-caracteres, '’', '')
           c-trata-caracteres = replace(c-trata-caracteres, 'ù', '')  
           c-trata-caracteres = replace(c-trata-caracteres, 'á', 'b')
           c-trata-caracteres = replace(c-trata-caracteres, '¸', 'c')   
           c-trata-caracteres = replace(c-trata-caracteres, '½', 'c')
           c-trata-caracteres = replace(c-trata-caracteres, 'ô', 'c')
           c-trata-caracteres = replace(c-trata-caracteres, 'œ', 'e')
           c-trata-caracteres = replace(c-trata-caracteres, '³', 'f')
           c-trata-caracteres = replace(c-trata-caracteres, 'ø', 'o')
	       c-trata-caracteres = replace(c-trata-caracteres, '', 'o')
           c-trata-caracteres = replace(c-trata-caracteres, 'æ', 'm')
           c-trata-caracteres = replace(c-trata-caracteres, '©', 'r')
           c-trata-caracteres = replace(c-trata-caracteres, 'õ', 's')
           c-trata-caracteres = replace(c-trata-caracteres, '¦', 'a')
           c-trata-caracteres = replace(c-trata-caracteres, '§', 'o').
           
        ASSIGN c-trata-caracteres = replace(c-trata-caracteres, '&', 'E').
        
        DO  i-posicao = 1 TO LENGTH(c-trata-caracteres):
            ASSIGN  c-caracter   = SUBSTR(c-trata-caracteres,i-posicao,1)
                    i-codigo-asc = ASC(c-caracter).
            
            IF  i-codigo-asc >= 1  AND
                i-codigo-asc <= 31 THEN DO:
            
                CASE i-codigo-asc:
                
                    WHEN 1 THEN ASSIGN c-caracter = "":U.
                    WHEN 2 THEN ASSIGN c-caracter = "":U.
                    WHEN 3 THEN ASSIGN c-caracter = "":U.
                    WHEN 4 THEN ASSIGN c-caracter = "":U.
                    WHEN 5 THEN ASSIGN c-caracter = "":U.
                    WHEN 6 THEN ASSIGN c-caracter = "":U.
                    WHEN 7 THEN ASSIGN c-caracter = "":U.
                    WHEN 8 THEN ASSIGN c-caracter = "":U.
                    WHEN 9 THEN ASSIGN c-caracter = "":U.
                    WHEN 10 THEN ASSIGN c-caracter = "":U.
                    WHEN 11 THEN ASSIGN c-caracter = "":U.
                    WHEN 12 THEN ASSIGN c-caracter = "":U.
                    WHEN 13 THEN ASSIGN c-caracter = "":U.
                    WHEN 14 THEN ASSIGN c-caracter = "":U.
                    WHEN 15 THEN ASSIGN c-caracter = "":U.
                    WHEN 16 THEN ASSIGN c-caracter = "":U.
                    WHEN 17 THEN ASSIGN c-caracter = "":U.
                    WHEN 18 THEN ASSIGN c-caracter = "":U.
                    WHEN 19 THEN ASSIGN c-caracter = "":U.
                    WHEN 20 THEN ASSIGN c-caracter = "":U.
                    WHEN 21 THEN ASSIGN c-caracter = "":U.
                    WHEN 22 THEN ASSIGN c-caracter = "":U.
                    WHEN 23 THEN ASSIGN c-caracter = "":U.
                    WHEN 24 THEN ASSIGN c-caracter = "":U.
                    WHEN 25 THEN ASSIGN c-caracter = "":U.
                    WHEN 26 THEN ASSIGN c-caracter = "":U.
                    WHEN 27 THEN ASSIGN c-caracter = "":U.
                    WHEN 28 THEN ASSIGN c-caracter = "":U.
                    WHEN 29 THEN ASSIGN c-caracter = "":U.
                    WHEN 30 THEN ASSIGN c-caracter = "":U.
                    WHEN 31 THEN ASSIGN c-caracter = "":U.
                    
                END CASE.

                ASSIGN c-trata-caracteres-aux = c-trata-caracteres-aux + c-caracter.

            END.

        END.
       
    
    RETURN c-trata-caracteres.
END FUNCTION.

