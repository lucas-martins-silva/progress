PROCEDURE pi-grava-ttICMS40:

    /*
    === ttICMS40 ===
    CST            AS CHARACTER INITIAL ?  /*Tributaá∆o pelo ICMS 40 - Isenta 41 - N∆o tributada 50 - Suspens∆o 51 - Diferimento */
    orig           AS CHARACTER INITIAL ?  /*origem da mercadoria: 0 - Nacional 1 - Estrangeira - Importaá∆o direta 2 - Estrangeira - Adquirida no mercado interno */
    vICMSDeson     AS DECIMAL   INITIAL ?  /*Valor do ICMS de desoneraá∆o*/ 
    motDesICMS     AS CHARACTER INITIAL ?  /*Motivo da desoneraá∆o do ICMS: 1 Œ T†xi; 3 Œ Produtor Agropecu†rio; 4 Œ Frotista/Locadora; 5 Œ Diplom†tico/Consular; 6 Œ Utilit†rios e Motocicletas da Amazìnia Ocidental e µreas de Livre ComÇrcio (Resoluá∆o 714/88 e 790/94 Œ CONTRAN e suas alteraá‰es); 7 Œ SUFRAMA; 8 - Venda a ¢rg∆o P£blico; 9 Œ Outros 10- Deficiente Condutor 11- Deficiente n∆o condutor*/
    */

    CREATE ttICMS40.
    ASSIGN ttICMS40.CST        = SUBSTRING(c-niv-trib-icms,2,2)
           ttICMS40.orig       = SUBSTRING(c-niv-trib-icms,1,1).
           
    /* Venda para ZF - Nota Tecnica 2011/004*/
    IF  r-cidade-zf <> ? AND it-nota-fisc.dec-1 > 0 THEN DO:  /* it-nota-fisc.dec-1 - Desoneracao ICMS*/
        ASSIGN ttICMS40.vICMSDeson = it-nota-fisc.dec-1
               ttICMS40.motDesICMS = (IF TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2)) <> "":U
                                      THEN TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2))
                                      ELSE "7":U). /* 7 - SUFRAMA */

    END.
    ELSE DO:

        ASSIGN ttICMS40.vICMSDeson = d-vl-desc-icms
               ttICMS40.motDesICMS = TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2)).
               /*OBS.:
               O CST 40 aceita os motivos de desoneraá∆o
               1=T†xi;
               3=Produtor Agropecu†rio;
               4=Frotista/Locadora;
               5=Diplom†tico/Consular;
               6=Utilit†rios e Motocicletas da Amazìnia Ocidental e µreas de Livre ComÇrcio (Resoluá∆o 714/88 e 790/94 Œ CONTRAN e suas alteraá‰es);
               7=SUFRAMA;
               8=Venda a ‡rg∆o P£blico;
               9=Outros. (NT 2011/004);
               10=Deficiente Condutor (Convànio ICMS 38/12);
               11=Deficiente N∆o Condutor (Convànio ICMS 38/12).
               */
    END.

    /* Chave EMS */
    ASSIGN ttICMS40.CodEstabelNF = nota-fiscal.cod-estabel
           ttICMS40.SerieNF      = nota-fiscal.serie
           ttICMS40.NrNotaFisNF  = nota-fiscal.nr-nota-fis
           ttICMS40.ItCodigoNF   = it-nota-fisc.it-codigo
           ttICMS40.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.

END PROCEDURE.
