/* PROCEDURE pi-monta-HTML: */

    /*----------------------------------------------------------------------
    Conforme layout definido adapters/xml/ep2/modelo_email_nf-e.htm ou 
                                              modelo_email_nf-e_cancel.htm
    ----------------------------------------------------------------------*/

    DEFINE VARIABLE i-seq-msg       AS INTEGER     NO-UNDO.
    DEFINE VARIABLE c-linha         AS CHARACTER   NO-UNDO.
    DEFINE VARIABLE cArqModeloEmail AS CHARACTER   NO-UNDO.
    DEFINE VARIABLE c-cnpj          AS CHARACTER   NO-UNDO.

    /*Verifica se est† como Uso Autorizado[3] ou Documento Cancelado[6] para enviar XML correspondente*/
    IF &if "{&bf_dis_versao_ems}":U >= "2.07":U &then
        nota-fiscal.idi-sit-nf-eletro   = 3
       &else
        CAN-FIND (FIRST sit-nf-eletro NO-LOCK
                  WHERE sit-nf-eletro.cod-estabel  = nota-fiscal.cod-estabel
                    AND sit-nf-eletro.cod-serie    = nota-fiscal.serie
                    AND sit-nf-eletro.cod-nota-fis = nota-fiscal.nr-nota-fis
                    AND sit-nf-eletro.idi-sit-nf-eletro = 3)
       &endif
    THEN 
        ASSIGN cArqModeloEmail = SEARCH("adapters/xml/ep2/modelo_email_nf-e.htm":U). /*Envio de Autorizaá∆o de Uso*/
    ELSE IF &if "{&bf_dis_versao_ems}":U >= "2.07":U &then
             nota-fiscal.idi-sit-nf-eletro   = 6
            &else
             CAN-FIND (FIRST sit-nf-eletro NO-LOCK
                       WHERE sit-nf-eletro.cod-estabel  = nota-fiscal.cod-estabel
                         AND sit-nf-eletro.cod-serie    = nota-fiscal.serie
                         AND sit-nf-eletro.cod-nota-fis = nota-fiscal.nr-nota-fis
                         AND sit-nf-eletro.idi-sit-nf-eletro = 6)
            &endif
         THEN
             ASSIGN cArqModeloEmail = SEARCH("adapters/xml/ep2/modelo_email_nf-e_cancel.htm":U). /*Envio de Cancelamento de NF-e Homologado*/


    IF  cArqModeloEmail = ? THEN
        RETURN "NOK":U.
    
    INPUT STREAM s-arq-entr FROM VALUE(cArqModeloEmail).

    IF  NOT AVAIL param-global THEN
        FIND FIRST param-global NO-LOCK NO-ERROR.
    
    REPEAT ON ERROR UNDO, LEAVE
           ON STOP  UNDO, LEAVE TRANSACTION:
    
        IMPORT STREAM s-arq-entr UNFORMATTED c-linha.
    
        IF  c-linha = "" THEN
            LEAVE.

        IF  INDEX(c-linha,"Layout Version":U) > 0 THEN /*n∆o considerar linha inclusa pelo RoundTable*/
            NEXT.
    
        ASSIGN i-seq-msg = i-seq-msg + 1.
    
        CREATE tt-mensagem.
        ASSIGN tt-mensagem.seq-mensagem = i-seq-msg
               tt-mensagem.mensagem     = TRIM(c-linha).
        
        IF  NOT AVAIL estabelec THEN
            FOR FIRST estabelec NO-LOCK
                WHERE estabelec.cod-estabel = nota-fiscal.cod-estabel: END.

        ASSIGN c-cnpj = (IF param-global.formato-id-federal <> "":U
                         THEN STRING(estabelec.cgc, param-global.formato-id-federal)
                         ELSE estabelec.cgc).


        /* Trocar as informaá‰es do modelo, por seus respectivos campos #NUMERO_NFE#; #SERIE_NFE# e #EMISSOR_NFE#. */
    
        IF  INDEX(tt-mensagem.mensagem,"#NUMERO_NFE#":U)  > 0 THEN DO:
            &if '{&bf_libera_15_posicoes}' = 'yes' &then
                ASSIGN tt-mensagem.mensagem = REPLACE(tt-mensagem.mensagem, "#NUMERO_NFE#":U,  STRING(DEC(nota-fiscal.nr-nota-fis),">>>>>>>>9999999":U)).
            &else
                ASSIGN tt-mensagem.mensagem = REPLACE(tt-mensagem.mensagem, "#NUMERO_NFE#":U,  STRING(DEC(nota-fiscal.nr-nota-fis),">>>9999999":U)).
            &endif
        END.

        IF  INDEX(tt-mensagem.mensagem,"#SERIE_NFE#":U)   > 0 THEN
            ASSIGN tt-mensagem.mensagem = REPLACE(tt-mensagem.mensagem, "#SERIE_NFE#":U,   STRING(INT(nota-fiscal.serie),"999")).

        IF  INDEX(tt-mensagem.mensagem,"#EMISSOR_NFE#":U) > 0 THEN
            ASSIGN tt-mensagem.mensagem = REPLACE(tt-mensagem.mensagem, "#EMISSOR_NFE#":U, STRING(estabelec.nome)).

        IF  INDEX(tt-mensagem.mensagem,"#CNPJ_NFE#":U) > 0 THEN
            ASSIGN tt-mensagem.mensagem = REPLACE(tt-mensagem.mensagem, "#CNPJ_NFE#":U,    STRING(c-cnpj)).

        IF  INDEX(tt-mensagem.mensagem,"#PROTOCOLO#":U) > 0 THEN
            ASSIGN tt-mensagem.mensagem = REPLACE(tt-mensagem.mensagem, "#PROTOCOLO#":U,   STRING(&if "{&bf_dis_versao_ems}":U < "2.07":U &then SUBSTRING(nota-fiscal.char-1,97,15) &else nota-fiscal.cod-protoc &endif)).
    
    END.

    RETURN "OK":U.

/* END PROCEDURE. */
