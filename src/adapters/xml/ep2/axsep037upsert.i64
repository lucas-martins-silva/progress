PROCEDURE pi-enviaEmailDestTransp:

    /* Integraá∆o TSS */
    IF  tp-integ = "TSS":U THEN DO:
        
        IF  NOT AVAIL ttInfAdic THEN
            FIND FIRST ttInfAdic NO-ERROR.

        IF  cEmailDestTransp <> ""  THEN
            ASSIGN ttInfAdic.infCpl = ttInfAdic.infCpl. /*  + "[EMAIL=":U + TRIM(cEmailDestTransp) + "]":U */

    END. /* Fim - Integraá∆o TSS Sincrono */
    ELSE DO:  /* Integraá∆o Neogrid */

        IF     (tp-integ = "TC2":U or tp-integ = "TPF":U) 
           AND AVAIL param-global 
           AND SUBSTRING(param-global.char-2,46,1) <> "2" /* Layout NeoGridFiscalDoc p/ TC2 n∆o precisa enviar as tags obsCont */
        THEN DO:
            IF  cEmailDest <> "" THEN DO:
                CREATE ttObsCont.
                ASSIGN ttObsCont.xCampo       = "mailDest":U
                       ttObsCont.xTexto       = fn-ajusta-tamanho-campo(cEmailDest, 60)
                       /* Chave EMS */
                       ttObsCont.CodEstabelNF = nota-fiscal.cod-estabel  
                       ttObsCont.SerieNF      = nota-fiscal.serie        
                       ttObsCont.NrNotaFisNF  = nota-fiscal.nr-nota-fis.
            END.
            
            IF  cEmailTransp <> "" THEN DO:
                CREATE ttObsCont.
                ASSIGN ttObsCont.xCampo       = "mailTransp":U
                       ttObsCont.xTexto       = fn-ajusta-tamanho-campo(cEmailTransp, 60)
                       /* Chave EMS */
                       ttObsCont.CodEstabelNF = nota-fiscal.cod-estabel  
                       ttObsCont.SerieNF      = nota-fiscal.serie        
                       ttObsCont.NrNotaFisNF  = nota-fiscal.nr-nota-fis.
            END.
        END.
        
    END.

END PROCEDURE.
