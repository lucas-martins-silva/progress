PROCEDURE pi-cria-ttInfAdic: 

    /*
    === ttInfAdic===
    infAdFisco         AS CHARACTER INITIAL ? //Informa‡äes Adicionais de Interesse do Fisco
    infCpl             AS CHARACTER INITIAL ? //Informa‡äes Complementares de interesse do usu rio emitente
    infAdTransp        AS CHARACTER INITIAL ? //Informa‡äes Adicionais da Transportadora
    */
    
    CREATE ttInfAdic.       
    ASSIGN /* Chave EMS */ 
           ttInfAdic.CodEstabelDCe = dce-documento.cod-estabel
           ttInfAdic.SerieDCe      = dce-documento.serie
           ttInfAdic.NrDCe         = dce-documento.nr-dce
           /* Chave EMS */ 
           
           ttInfAdic.infAdFisco   = dce-documento.inf-ad-fisco
           ttInfAdic.infCpl       = dce-documento.inf-cpl
           ttInfAdic.infAdTransp  = dce-documento.inf-transp.
           
           
    /* Ajusta Formatacao dos Campos */
    IF  AVAIL ttInfAdic THEN DO:
        ASSIGN ttInfAdic.infAdFisco  = REPLACE(ttInfAdic.infAdFisco, CHR(10), " ")
               ttInfAdic.infAdFisco  = REPLACE(ttInfAdic.infAdFisco, CHR(13), " ")
               ttInfAdic.infAdFisco  = REPLACE(ttInfAdic.infAdFisco, CHR(9),  " ")
               ttInfAdic.infAdFisco  = fn-ajusta-espacos-branco(ttInfAdic.infAdFisco)
               ttInfAdic.infAdFisco  = fn-ajusta-tamanho-campo(ttInfAdic.infAdFisco ,2000)
               ttInfAdic.infCpl      = REPLACE(ttInfAdic.infCpl, CHR(10), " ")
               ttInfAdic.infCpl      = REPLACE(ttInfAdic.infCpl, CHR(13), " ")
               ttInfAdic.infCpl      = REPLACE(ttInfAdic.infCpl, CHR(9),  " ")
               ttInfAdic.infCpl      = fn-ajusta-espacos-branco(ttInfAdic.infCpl)
               ttInfAdic.infCpl      = fn-ajusta-tamanho-campo(ttInfAdic.infCpl ,2000)
               ttInfAdic.infAdTransp = REPLACE(ttInfAdic.infAdTransp, CHR(10), " ")
               ttInfAdic.infAdTransp = REPLACE(ttInfAdic.infAdTransp, CHR(13), " ")
               ttInfAdic.infAdTransp = REPLACE(ttInfAdic.infAdTransp, CHR(9),  " ")
               ttInfAdic.infAdTransp = fn-ajusta-espacos-branco(ttInfAdic.infAdTransp)
               ttInfAdic.infAdTransp = fn-ajusta-tamanho-campo(ttInfAdic.infAdTransp ,2000).
    END.
END PROCEDURE.