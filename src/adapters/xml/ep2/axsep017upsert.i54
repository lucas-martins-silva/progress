PROCEDURE pi-cria-ttCompra:

    /*
    === ttCompra ===
    xCont          AS CHARACTER INITIAL ?  /*Informa‡Æo do contrato*/
    xNEmp          AS CHARACTER INITIAL ?  /*Informa‡Æo da Nota de Empenho de compras p£blicas*/
    xPed           AS CHARACTER INITIAL ?  /*Informa‡Æo do pedido*/
    */

    CREATE ttCompra.
    ASSIGN /*ttCompra.xCont =*/
           /*ttCompra.xNEmp =*/
           ttCompra.xPed  = nota-fiscal.nr-pedcli
           .

    RUN pi-Ajuste-SINIEF-13-2013.

    /*Chave EMS*/
    ASSIGN ttCompra.CodEstabelNF = nota-fiscal.cod-estabel
           ttCompra.SerieNF      = nota-fiscal.serie
           ttCompra.NrNotaFisNF  = nota-fiscal.nr-nota-fis.

END PROCEDURE.