PROCEDURE pi-cria-ttICMSTot-NFCom:

    /*
    === ttICMSTotNFCom ===
    vBC            AS DECIMAL   INITIAL ?  /*BC do ICMS*/
    vICMS          AS DECIMAL   INITIAL ?  /*Valor Total do ICMS*/
    vICMSDeson     AS DECIMAL   INITIAL ?  /*Valor Total do ICMS desonerado*/
    vFCP           AS DECIMAL   INITIAL ?  /*Valor do FCP */
    */

    CREATE ttICMSTotNFCom.
    ASSIGN ttICMSTotNFCom.vBC           = d-total-base-icms
           ttICMSTotNFCom.vICMS         = d-total-icms
           ttICMSTotNFCom.vICMSDeson    = d-total-vl-desc-icms
           ttICMSTotNFCom.vFCP          = d-total-vFCP.     


    /* Chave EMS */
    ASSIGN ttICMSTotNFCom.CodEstabelNFCom = nota-fiscal.cod-estabel
           ttICMSTotNFCom.SerieNFCom      = nota-fiscal.serie
           ttICMSTotNFCom.NrNotaFisNFCom  = nota-fiscal.nr-nota-fis.

END PROCEDURE.
