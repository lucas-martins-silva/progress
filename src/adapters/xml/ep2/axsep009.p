PROCEDURE buscaDataHoraCancSEFAZ:
    DEFINE INPUT  PARAMETER cXmlCanc_Ret AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER cdhRecbto    AS CHARACTER NO-UNDO.

    IF  INDEX(cXmlCanc_Ret , "<dhRegEvento>":U) > 0 THEN
        ASSIGN cdhRecbto = SUBSTR(cXmlCanc_Ret, INDEX(cXmlCanc_Ret, "<dhRegEvento>":U) + 13, 19) NO-ERROR.
    
END PROCEDURE.

PROCEDURE buscaValorTagSEFAZ:

    DEFINE INPUT  PARAMETER cXmlProt    AS CHARACTER NO-UNDO.
    DEFINE INPUT  PARAMETER cTagNameIni AS CHARACTER NO-UNDO.
    DEFINE INPUT  PARAMETER cTagNameFim AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER cTagValue   AS CHARACTER NO-UNDO.
     
    IF  INDEX(cXmlProt, cTagNameIni) > 0 THEN
        ASSIGN cTagValue = SUBSTR(
                               cXmlProt, 
                               INDEX(cXmlProt, cTagNameIni) + LENGTH(cTagNameIni), 
                               INDEX(cXmlProt, cTagNameFim) - INDEX(cXmlProt, cTagNameIni) - LENGTH(cTagNameIni)
                           ) NO-ERROR.
END PROCEDURE.

