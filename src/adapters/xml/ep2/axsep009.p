PROCEDURE PIUpsert:

    /*PARAMETERS - BEGIN*/
    DEFINE INPUT  PARAM cTranAction       AS CHARACTER INITIAL ? NO-UNDO.
    DEFINE INPUT  PARAM cEvent            AS CHARACTER INITIAL ? NO-UNDO.
    DEFINE INPUT  PARAM TABLE FOR ttRetornaNotas_ENV.
    DEFINE OUTPUT PARAM TABLE FOR tt_log_erro.
    /*PARAMETERS - END*/

    /*LOCAL VARIABLES - BEGIN*/
    DEFINE VAR iCount       AS INTEGER   INITIAL ? NO-UNDO.
    DEFINE VAR iId          AS INTEGER   INITIAL ? NO-UNDO.
    DEFINE VAR pErrorId     AS INTEGER   INITIAL ? NO-UNDO.
    DEFINE VAR pErrorType   AS CHARACTER INITIAL ? NO-UNDO.
    DEFINE VAR pTotalErrors AS INTEGER   INITIAL ? NO-UNDO.
    DEFINE VAR cTpTrans     AS CHARACTER           NO-UNDO.
    /*LOCAL VARIABLES - END*/
    
    FIND FIRST ttRetornaNotas_ENV NO-LOCK NO-ERROR.

    RUN cdp/cd0360b.p (INPUT ttRetornaNotas_ENV.CodEstabel,
                       INPUT "NF-e":U,
                       OUTPUT cTpTrans).


    IF  LOOKUP(cTpTrans, "TSS,TC":U) > 0 THEN  DO:
        RUN pi-Retorna-Notas-TSS-Sincrono.

        RETURN "OK".
    END.
    
    /* ******************************************* */
    /* *************** BODY - BEGIN ************** */
    /* ******************************************* */
    
    /* VERIFICA SE MessageHandler.p ESTA NA MEMORIA */
    {xmlinc/xmlloadmessagehandler.i &MessageHandler="hMessageHandler" &MHReturnValue="cReturnValue"}

    IF cReturnValue <> "OK" THEN DO:
        {utp/ut-liter.i "Erro ao executar"}
         CREATE TT_LOG_ERRO.
              ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO  = 17006.
              /* Inicio -- Projeto Internacional */
              DEFINE VARIABLE c-lbl-liter-3 AS CHARACTER NO-UNDO.
              ASSIGN c-lbl-liter-3 = TRIM(RETURN-VALUE).
              DEFINE VARIABLE c-lbl-liter-messagehandle-2 AS CHARACTER NO-UNDO.
              {utp/ut-liter.i "MessageHandle" *}
              ASSIGN c-lbl-liter-messagehandle-2 = TRIM(RETURN-VALUE).
              ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO  = trim(c-lbl-liter-3) + " " + c-lbl-liter-messagehandle-2 + ": "+ cReturnValue
                     tt_log_erro.ttv_des_msg_ajuda = tt_log_erro.ttv_des_msg_erro.
         RETURN cReturnValue.
    END.
    
    RUN isSubscribed IN hMessageHandler ("{&XmlProdName}", 
         "{&XmlApp}", 
         "{&XmlTranName}", 
         "{&XmlTranVersion}", 
         cEvent, 
         cTranAction, 
         OUTPUT lCreateMsg)
    .
    
    IF RETURN-VALUE <> "OK" THEN DO:
        ASSIGN cReturnValue = RETURN-VALUE.
        {utp/ut-liter.i "Erro ao executar"}
         CREATE TT_LOG_ERRO.
              ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO  = 17006.
              /* Inicio -- Projeto Internacional */
              DEFINE VARIABLE c-lbl-liter-4 AS CHARACTER NO-UNDO.
              ASSIGN c-lbl-liter-4 = TRIM(RETURN-VALUE).
              DEFINE VARIABLE c-lbl-liter-messagehandle AS CHARACTER NO-UNDO.
              {utp/ut-liter.i "isSubscribed_no_MessageHandle" *}
              ASSIGN c-lbl-liter-messagehandle = TRIM(RETURN-VALUE).
              ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO  = trim(c-lbl-liter-4) + c-lbl-liter-messagehandle + ": "+ cReturnValue
                     tt_log_erro.ttv_des_msg_ajuda = tt_log_erro.ttv_des_msg_erro.
         RETURN cReturnValue.
    END.
    
    IF NOT lCreateMsg THEN DO:
         {utp/ut-liter.i "A Transacao"}
         ASSIGN cLiteral = TRIM(RETURN-VALUE).
         {utp/ut-liter.i " nao e assinada."}
         CREATE TT_LOG_ERRO.
              ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO  = 17006.
              /* Inicio -- Projeto Internacional */
              DEFINE VARIABLE c-lbl-liter-5 AS CHARACTER NO-UNDO.
              ASSIGN c-lbl-liter-5 = TRIM(RETURN-VALUE).
              DEFINE VARIABLE c-lbl-liter-xmltranname AS CHARACTER NO-UNDO.
              {utp/ut-liter.i "'{&XmlTranName}'" *}
              ASSIGN c-lbl-liter-xmltranname = TRIM(RETURN-VALUE).
              ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO  = cLiteral + ' ' + c-lbl-liter-xmltranname + ' ' + TRIM(c-lbl-liter-5)
                     tt_log_erro.ttv_des_msg_ajuda = tt_log_erro.ttv_des_msg_erro.
         RETURN "OK".
    END.
    
    
    
    /* PREENCHE O VALOR DO ELEM. Comment DE TransactionId */
    RUN setTransInfoComment IN hMessageHandler ("Comentario do desenvolvedor").
    
    
    
    /* SETA SystemId */
    RUN setSystemId IN hMessageHandler ("{&XmlMod}",  "{&XmlProdVersion}").
    
    FIND FIRST ttRetornaNotas_ENV NO-LOCK NO-ERROR.

    RUN setKeyFields IN hMessageHandler ("Estabel", ttRetornaNotas_ENV.CodEstabel).
    RUN setKeyFields IN hMessageHandler ("Serie",   STRING(INT(SUBSTR(TRIM(ttRetornaNotas_ENV.ChaveNFe),23,3)))).
    RUN setKeyFields IN hMessageHandler ("NF",      TRIM(STRING(INTEGER(SUBSTR(ttRetornaNotas_ENV.ChaveNFe,26,9)),">>9999999"))).
    RUN setKeyFields IN hMessageHandler ("ID_ENT", ttRetornaNotas_ENV.ID_ENT).
    
    
    
    /* INFORMA A EMPRESA E O ESTABELECIMENTO */
    RUN setCompanyId IN hMessageHandler (STRING(v_cdn_empres_usuar), "").
    
    
    
         /* RESETA OS VALORES */
         RUN reset IN hGenXml.
    
         /* SETA VALOR DE ENCODING */
         RUN setEncoding IN hGenXml ("UTF-8").
    
    
         RUN addNode IN hGenXml (getStack(), "Upsert", "", OUTPUT iId).
         addStack(iId).

              RUN addNode IN hGenXml (getStack(), "USERTOKEN", "",                        OUTPUT iId).
              RUN addNode IN hGenXml (getStack(), "ID_ENT",    ttRetornaNotas_ENV.ID_ENT, OUTPUT iId).
              RUN addNode IN hGenXml (getStack(), "NFEID",     "",                        OUTPUT iId).
              addStack(iId).
    
                   RUN addNode IN hGenXml (getStack(), "NOTAS", "", OUTPUT iId).
                   addStack(iId).
    
                        FOR EACH ttRetornaNotas_ENV:

                             RUN addNode IN hGenXml (getStack(), "NFESID2", "", OUTPUT iId).

                             addStack(iId).
    
                                  RUN addNode IN hGenXml (getStack(), "ID", ttRetornaNotas_ENV.ChaveNFe, OUTPUT iId).

                             delStack().
    
                        END.
                   delStack().
    
              delStack().
    
              RUN addNode IN hGenXml (getStack(), "DIASPARAEXCLUSAO", "0", OUTPUT iId).
    
         delStack().
    
    
    /* OBTEM O XML NUMA HANDLE */
    RUN generateXML IN hGenXml (OUTPUT hBusinessContent).
    
    
    /* DEFINE O CONTEÈDO DO ELEMENTO BusinessContent */
    RUN setBusinessContent IN hMessageHandler (INPUT hBusinessContent).
    
    /* LIBERA MEM‡RIA ALOCADA PARA O OBJETO */
    DELETE OBJECT hBusinessContent NO-ERROR.
    
    
    
    /*CONTR‡I A MENSAGEM XML E ENVIA PARA O ControlBroker */
    RUN sendMessage IN hMessageHandler (INPUT "ep2/TSSRetornaNotasEnv_204_000.xsd"). 

    /* VERIFICA SE OCORREU ALGUM ERRO */
    IF RETURN-VALUE <> "OK" THEN DO:
         CREATE TT_LOG_ERRO.
         ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO  = 17006.
         /* Inicio -- Projeto Internacional */
         DEFINE VARIABLE c-lbl-liter-2 AS CHARACTER NO-UNDO.
         ASSIGN c-lbl-liter-2 = TRIM(RETURN-VALUE).
         DEFINE VARIABLE c-lbl-liter-erro-no-envio-da-mensagem AS CHARACTER NO-UNDO.
         {utp/ut-liter.i "Erro_no_envio_da_Mensagem" *}
         ASSIGN c-lbl-liter-erro-no-envio-da-mensagem = TRIM(RETURN-VALUE).
         ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO  = c-lbl-liter-erro-no-envio-da-mensagem + ": "+ c-lbl-liter-2
                TT_LOG_ERRO.TTV_DES_MSG_AJUDA = TT_LOG_ERRO.TTV_DES_MSG_ERRO.
         RETURN RETURN-VALUE.
    END.
    
    
    
    /* VERIFICA SE A MENSAGEM FOI PROCESSADA COM SUCESSO */
    RUN getReturnStatus IN hMessageHandler (OUTPUT pSendSuccess, OUTPUT pTotalErrors).
    
    
    /* SE NAO ENVIO COM SUCESSO */
    IF NOT pSendSuccess THEN DO:
         REPEAT iCount = 1 TO pTotalErrors:
              CREATE TT_LOG_ERRO.
              RUN getError IN hMessageHandler (iCount, OUTPUT TT_LOG_ERRO.TTV_NUM_COD_ERRO, OUTPUT pErrorType, OUTPUT TT_LOG_ERRO.TTV_DES_MSG_ERRO).
              ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO  = 17006
                     TT_LOG_ERRO.TTV_DES_MSG_AJUDA = TT_LOG_ERRO.TTV_DES_MSG_ERRO.
         END.
         RETURN "NOK".
    END.
    ELSE RETURN "OK".
    
    /* ******************************************* */
    /* *************** BODY - END   ************** */
    /* ******************************************* */

END PROCEDURE.

