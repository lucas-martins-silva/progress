PROCEDURE pi-ttNRef-docum-NF: 
    DEFINE INPUT PARAMETER p-cod-chave-aces-nf-eletro AS CHARACTER NO-UNDO.
    DEFINE INPUT PARAMETER p-cod-estabel              AS CHARACTER NO-UNDO.
    DEFINE INPUT PARAMETER p-serie                    AS CHARACTER NO-UNDO.
    DEFINE INPUT PARAMETER p-dt-emis-nota             AS DATE      NO-UNDO.
    DEFINE INPUT PARAMETER p-nr-nota-fis              AS CHARACTER NO-UNDO.
    DEFINE INPUT PARAMETER p-cod-emitente             AS INTEGER   NO-UNDO.
    DEFINE INPUT PARAMETER p-mod                      AS CHARACTER NO-UNDO.
    DEFINE INPUT PARAMETER p-emi-nota                 AS CHARACTER NO-UNDO.

    /*--- Geraá∆o de Devoluá∆o do CT-e do Recebimento - quando h† nota referenciada e esta nota Ç um CT-e com modelo 57 [Chamados TGNHZF / THRJD4] ---*/
    IF  (TRIM(p-cod-chave-aces-nf-eletro) <> ?
    AND  TRIM(p-cod-chave-aces-nf-eletro) <> ""
    AND  SUBSTRING(TRIM(p-cod-chave-aces-nf-eletro),21,2) = "57") THEN DO: /*Modelo = 57 - gerar CTe*/
        RUN pi-cria-ttrefCTe (INPUT p-cod-chave-aces-nf-eletro).
        RETURN "OK":U.
    END.
    /*---*/
	
	DEFINE VARIABLE i-serie-aux AS INTEGER NO-UNDO.
	
    DEF BUFFER bf2-estabelec      FOR estabelec.
    DEF BUFFER bf2-emitente       FOR emitente.
    DEF BUFFER bf2-unid-feder-est FOR unid-feder.
    DEF BUFFER bf2-natur-oper-nf  FOR natur-oper.


    IF p-emi-nota = "estab":U THEN DO:
        FOR FIRST bf2-estabelec NO-LOCK
            WHERE bf2-estabelec.cod-estabel = p-cod-estabel:
        END.
    
        IF  NOT AVAIL bf2-unid-feder-est THEN
        FOR FIRST bf2-unid-feder-est FIELDS (&if '{&bf_dis_versao_ems}' >= '2.07':U &then cod-uf-ibge &else char-1 &endif) NO-LOCK
            WHERE bf2-unid-feder-est.pais   = bf2-estabelec.pais   
              AND bf2-unid-feder-est.estado = bf2-estabelec.estado:
        END.
    END.
    ELSE IF p-emi-nota = "emit":U THEN DO:
        FOR FIRST bf2-emitente NO-LOCK
            WHERE bf2-emitente.cod-emitente = p-cod-emitente:
        END.
    
        IF  NOT AVAIL bf2-unid-feder-est THEN
        FOR FIRST bf2-unid-feder-est FIELDS (&if '{&bf_dis_versao_ems}' >= '2.07':U &then cod-uf-ibge &else char-1 &endif) NO-LOCK
            WHERE bf2-unid-feder-est.pais   = bf2-emitente.pais
              AND bf2-unid-feder-est.estado = bf2-emitente.estado:
        END.
    END.

       
       /* Nota Eletronica, envia somente tag <refNFe> */
       &IF '{&bf_dis_versao_ems}' >= '2.07':U &THEN
            IF  ((TRIM(p-cod-chave-aces-nf-eletro) <> ?
            AND TRIM(p-cod-chave-aces-nf-eletro) <> "")
            AND (estabelec.idi-tip-emis-nf-eletro    = 2  /* Processo Emiss∆o NF-e - CD0403 [Homologaá∆o] */
            OR  (estabelec.idi-tip-emis-nf-eletro    = 3  /* Processo Emiss∆o NF-e - CD0403 [Produá∆o] - Para verificar a sÇrie, Ç necess†rio verificar se o estabelecimento est† em Produá∆o */
            AND (CAN-FIND (FIRST ser-estab /* Verifica se a nota vinculada e' mesmo eletronica */
                           WHERE ser-estab.cod-estabel = p-cod-estabel
                             AND ser-estab.serie       = p-serie
                             AND ser-estab.log-nf-eletro)))
            OR p-emi-nota = "emit" )) THEN DO:
       &ELSE
            IF  ((TRIM(p-cod-chave-aces-nf-eletro) <> ?
            AND TRIM(p-cod-chave-aces-nf-eletro) <> "")
            AND (INT(SUBSTR(estabelec.char-1,168,1)) = 2  /* Processo Emiss∆o NF-e - CD0403 [Homologaá∆o] */
            OR  (INT(SUBSTR(estabelec.char-1,168,1)) = 3  /* Processo Emiss∆o NF-e - CD0403 [Produá∆o] - Para verificar a sÇrie, Ç necess†rio verificar se o estabelecimento est† em Produá∆o */
            AND (CAN-FIND (FIRST ser-estab /* Verifica se a nota vinculada e' mesmo eletronica */
                           WHERE ser-estab.cod-estabel = p-cod-estabel
                             AND ser-estab.serie       = p-serie
                             AND SUBSTR(ser-estab.char-1,1,03) = "yes":U)))
            OR p-emi-nota = "emit")) THEN DO:

       &ENDIF   
                FIND FIRST ttrefNF WHERE ttrefNF.refNFe = TRIM(p-cod-chave-aces-nf-eletro) NO-ERROR.
                IF NOT AVAIL ttrefNF THEN DO:

                      CREATE ttrefNF.
                      ASSIGN ttrefNF.refNFe       = ""
                             /* Chave EMS */
                             ttrefNF.CodEstabelNF = nota-fiscal.cod-estabel
                             ttrefNF.SerieNF      = IF nota-fiscal.serie = "" THEN "0" ELSE nota-fiscal.serie
                             ttrefNF.NrNotaFisNF  = nota-fiscal.nr-nota-fis
                             ttrefNF.ItCodigoNF   = it-nota-fisc.it-codigo  WHEN AVAIL it-nota-fisc
                             ttrefNF.NrSeqFatNF   = it-nota-fisc.nr-seq-fat WHEN AVAIL it-nota-fisc.
                
                      /* NFe: enviar somente chave de acesso */
                      ASSIGN ttrefNF.refNFe     = TRIM(p-cod-chave-aces-nf-eletro).
                
                END.

            END.
            ELSE IF i-natureza > 1 or 
                    p-emi-nota = "estab":U  THEN DO: /* Nao e' Nota Eletronica, enviar colecao <refNF> */ /* somente se for CNPJ, pois a RefNF s¢ permite nota com CNPJ*/
                 FIND FIRST ttrefNF NO-LOCK
                     WHERE ttrefNF.CodEstabelNF = nota-fiscal.cod-estabel
                     AND   ttrefNF.SerieNF      = (IF nota-fiscal.serie = "" THEN "0" ELSE nota-fiscal.serie)
                     AND   ttrefNF.NrNotaFisNF  = nota-fiscal.nr-nota-fis
                     AND   ttrefNF.nNF          = STRING(INT(p-nr-nota-fis)) NO-ERROR.

                 IF NOT AVAIL ttrefNF THEN DO:

				    CREATE ttrefNF.
                    ASSIGN ttrefNF.refNFe       = ""
                           /* Chave EMS */
                           ttrefNF.CodEstabelNF = nota-fiscal.cod-estabel
                           ttrefNF.SerieNF      = IF nota-fiscal.serie = "" THEN "0" ELSE nota-fiscal.serie
                           ttrefNF.NrNotaFisNF  = nota-fiscal.nr-nota-fis
                           ttrefNF.ItCodigoNF   = it-nota-fisc.it-codigo  WHEN AVAIL it-nota-fisc
                           ttrefNF.NrSeqFatNF   = it-nota-fisc.nr-seq-fat WHEN AVAIL it-nota-fisc.
						   
					ASSIGN i-serie-aux = INT(p-serie) NO-ERROR.	   
        
                    ASSIGN ttrefNF.cUF          = IF p-emi-nota = "estab":U THEN 
                                                         STRING(IF  bf2-estabelec.pais = "Brasil":U
                                                                 THEN (&if '{&bf_dis_versao_ems}' >= '2.07':U
                                                                       &then IF AVAIL bf2-unid-feder-est THEN INT(bf2-unid-feder-est.cod-uf-ibge) ELSE 0
                                                                       &else IF AVAIL bf2-unid-feder-est THEN INT(SUBSTRING(bf2-unid-feder-est.char-1,1,2)) ELSE 0 &endif)
                                                                 ELSE 99)
                                                  ELSE 
                                                          STRING(IF  bf2-emitente.pais = "Brasil":U
                                                                 THEN (&if '{&bf_dis_versao_ems}' >= '2.07':U
                                                                       &then IF AVAIL bf2-unid-feder-est THEN INT(bf2-unid-feder-est.cod-uf-ibge) ELSE 0
                                                                       &else IF AVAIL bf2-unid-feder-est THEN INT(SUBSTRING(bf2-unid-feder-est.char-1,1,2)) ELSE 0 &endif)
                                                                 ELSE 99)
                           ttrefNF.AAMM         = TRIM(SUBSTRING(STRING(YEAR(p-dt-emis-nota),"9999"),3,2) + STRING(MONTH(p-dt-emis-nota),"99"))
                           ttrefNF.CNPJ         = IF p-emi-nota = "estab":U THEN bf2-estabelec.cgc ELSE 
                                                  IF p-emi-nota = "emit":U  THEN bf2-emitente.cgc  ELSE estabelec.cgc
                           ttrefNF.mod          = STRING(INT(p-mod),"99")
                           ttrefNF.serie        = STRING(i-serie-aux)
                           ttrefNF.nNF          = STRING(INT(p-nr-nota-fis)).

                    
                 END.
                 
           END.

END PROCEDURE.