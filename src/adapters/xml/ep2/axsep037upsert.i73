PROCEDURE pi-FCI-Item:

    DEFINE VARIABLE h-bodi538               AS HANDLE                   NO-UNDO.
    DEFINE VARIABLE c-nro-FCI               AS CHARACTER FORMAT "x(36)" NO-UNDO.

    RUN dibo/bodi538.p PERSISTENT SET h-bodi538.

    /*Gravar na it-nota-fisc as informacoes da FCI utilizada no calculo do Item*/
    IF nota-fiscal.ind-tip-nota <> 8 /* Nota Entrada */ then
            RUN pi-buscaFCI-ItNotaFisc-NFe IN h-bodi538 (INPUT  ROWID(it-nota-fisc)   ,
                                                         OUTPUT c-nro-FCI).
    else do:
        find FIRST item-doc-est NO-LOCK
            WHERE item-doc-est.serie-docto  = nota-fiscal.serie
              AND item-doc-est.nro-docto    = nota-fiscal.nr-nota-fis 
              AND item-doc-est.cod-emitente = nota-fiscal.cod-emitente
              AND item-doc-est.nat-operacao = nota-fiscal.nat-operacao
              AND item-doc-est.sequencia    = it-nota-fisc.nr-seq-ped no-error.
        if available item-doc-est then
            RUN pi-buscaFCI-ItemDocEst-NFe IN h-bodi538 (INPUT  ROWID(item-doc-est),
                                                         OUTPUT c-nro-FCI).
    end.
                                                     
    IF  VALID-HANDLE(h-bodi538) THEN DO:
        DELETE PROCEDURE h-bodi538.
        ASSIGN h-bodi538 = ?.
    END.

    IF  TRIM(c-nro-FCI) <> "":U THEN
        ASSIGN ttDet.nFCI = TRIM(c-nro-FCI).

END PROCEDURE.
