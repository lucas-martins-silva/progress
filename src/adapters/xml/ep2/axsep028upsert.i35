PROCEDURE pi-cria-ttgFatNFCom:

    DEFINE BUFFER bf-nota-fiscal  FOR nota-fiscal.
    DEFINE VARIABLE h-bodi135nfcom AS HANDLE      NO-UNDO.
    DEFINE VARIABLE c-cod-barras   AS CHARACTER   NO-UNDO.

    RUN dibo/bodi135nfcom.p PERSISTENT SET h-bodi135nfcom.

    FIND FIRST fat-duplic NO-LOCK
        WHERE  fat-duplic.cod-estabel = nota-fiscal.cod-estabel 
          AND  fat-duplic.serie       = nota-fiscal.serie       
          AND  fat-duplic.nr-fatura   = nota-fiscal.nr-fatura no-error.
          
    IF AVAIL fat-duplic THEN DO:
        CREATE ttgFatNFCom.
        ASSIGN ttgFatNFCom.CodEstabel  = nota-fiscal.cod-estabel
               ttgFatNFCom.SerieNFCom  = nota-fiscal.serie
               ttgFatNFCom.NrNotaFis   = nota-fiscal.nr-nota-fis.

        ASSIGN ttgFatNFCom.dVencFat    = fat-duplic.dt-venciment
               ttgFatNFCom.CompetFat   = replace(SUBSTRING(ttIdeNFCom.dhEmi,1,7),"-","").
                              
        RUN geraCodBarrasNFCom IN h-bodi135nfcom (INPUT ROWID(nota-fiscal),
                                                  OUTPUT c-cod-barras).
            
        ASSIGN ttgFatNFCom.codBarras   = IF c-cod-barras <> "" THEN c-cod-barras else '9'.                    
    END.
    ELSE DO:
        IF ttIdeNFCom.finNFCom = "3" THEN DO:
            FIND FIRST nota-fisc-adc
                 WHERE nota-fisc-adc.cod-estab        = nota-fiscal.cod-estabel
                   AND nota-fisc-adc.cod-serie        = nota-fiscal.serie
                   AND nota-fisc-adc.cod-nota-fisc    = nota-fiscal.nr-nota-fis
                   AND nota-fisc-adc.cdn-emitente     = nota-fiscal.cod-emitente
                   AND nota-fisc-adc.cod-natur-operac = nota-fiscal.nat-operacao
                   AND nota-fisc-adc.idi-tip-dado     = 3 NO-LOCK NO-ERROR.

            IF AVAIL nota-fisc-adc THEN
                FIND FIRST fat-duplic
                     WHERE fat-duplic.cod-estabel = nota-fisc-adc.cod-estab
                       AND fat-duplic.serie       = nota-fisc-adc.cod-ser-docto-referado
                       AND fat-duplic.nr-fatura   = nota-fisc-adc.cod-docto-referado NO-LOCK NO-ERROR.

                IF AVAIL fat-duplic THEN DO:
                    CREATE ttgFatNFCom.
                    ASSIGN ttgFatNFCom.CodEstabel = nota-fiscal.cod-estabel 
                           ttgFatNFCom.SerieNFCom = nota-fiscal.serie
                           ttgFatNFCom.NrNotaFis  = nota-fiscal.nr-nota-fis.

                    ASSIGN ttgFatNFCom.dVencFat   = fat-duplic.dt-venciment.

                    FIND FIRST bf-nota-fiscal
                        WHERE  bf-nota-fiscal.cod-estabel   = nota-fisc-adc.cod-estab
                        AND    bf-nota-fiscal.serie         = nota-fisc-adc.cod-ser-docto-referado 
                        AND    bf-nota-fiscal.nr-nota-fis   = nota-fisc-adc.cod-docto-referado
                        AND    bf-nota-fiscal.cod-emitente  = nota-fisc-adc.cdn-emit-docto-referado 
                        AND    bf-nota-fiscal.nat-operacao  = nota-fisc-adc.cod-natur-operac no-lock no-error.
                    IF AVAIL bf-nota-fiscal THEN DO:                      
                        RUN geraCodBarrasNFCom IN h-bodi135nfcom (INPUT ROWID(bf-nota-fiscal),
                                                                  OUTPUT c-cod-barras).
                                                                    
                        ASSIGN ttgFatNFCom.codBarras = IF c-cod-barras <> "" THEN c-cod-barras else '9' 
                               ttgFatNFCom.CompetFat = replace(SUBSTRING(string(substring(bf-nota-fiscal.char-1,282,25)),1,7),"-","").
                    END.
                END.
        END.
    END.

    DELETE PROCEDURE h-bodi135nfcom.
    ASSIGN h-bodi135nfcom = ?.
      
END PROCEDURE.
