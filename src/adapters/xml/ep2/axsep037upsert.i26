PROCEDURE pi-cria-ttAdi:

    /*
    === ttAdi ===
    nDI            AS CHARACTER INITIAL ?  /*campo para ligaá∆o com a ttDI*/
    cFabricante    AS CHARACTER INITIAL ?  /*C¢digo do fabricante estrangeiro (usado nos sistemas internos de informaá∆o do emitente da NF-e)*/
    nAdicao        AS CHARACTER INITIAL ?  /*N£mero da Adiá∆o*/
    nSeqAdic       AS CHARACTER INITIAL ?  /*N£mero seqÅencial do item dentro da Adiá∆o*/
    vDescDI        AS DECIMAL   INITIAL ?  /*Valor do desconto do item da DI - adiá∆o*/
    nDraw          AS CHARACTER INITIAL ?  /*N£mero do ato concess¢rio de Drawback*/
    */

    /*
    PENDENCIA COMEX - CAMPO item-docto-estoq-nfe-imp.cod-livre-1 NAO E ALIMENTADO NO IM7777 QDO A NOTA DE IMPORTAÄ«O E PROVENIENTE DO MODULO DE IMPORTACAO
    */

    DEFINE BUFFER b-nota-fiscal FOR nota-fiscal.

    DEF VAR c-nr-nota-orig  LIKE nota-fiscal.nr-nota-fis  NO-UNDO.
    DEF VAR c-nat-oper-orig LIKE nota-fiscal.nat-operacao NO-UNDO.
    DEF VAR i-cod-emit-orig LIKE nota-fiscal.cod-emitente NO-UNDO.
    DEF VAR c-serie-orig    LIKE nota-fiscal.serie        NO-UNDO.

    ASSIGN c-serie-orig    = nota-fiscal.serie
           c-nr-nota-orig  = nota-fiscal.nr-nota-ant
           i-cod-emit-orig = nota-fiscal.cod-emitente
           c-nat-oper-orig = nota-fiscal.nat-operacao.

        /* busca o documento referenciado na nota-fisc-adc e usa o buffer b-nota-fiscal para resgatar a chave da nota original (incluindo a natureza de operacao). */
        IF l-nota-ajuste-import THEN DO: 
        FOR FIRST nota-fisc-adc NO-LOCK
            WHERE nota-fisc-adc.cod-estab               = nota-fiscal.cod-estabel
             AND  nota-fisc-adc.cod-serie               = nota-fiscal.serie
             AND  nota-fisc-adc.cod-nota-fisc           = nota-fiscal.nr-nota-fis
             AND  nota-fisc-adc.cdn-emitente            = nota-fiscal.cod-emitente
             AND  nota-fisc-adc.cod-natur-operac        = nota-fiscal.nat-operacao
             AND  nota-fisc-adc.idi-tip-dado            = 3
             AND (nota-fisc-adc.idi-tip-docto-referado  = 2
               OR (nota-fiscal.ind-tip-nota = 8 AND nota-fisc-adc.idi-tip-docto-referado = 1))
             AND  STRING(INT(nota-fisc-adc.cod-model-docto-referado),"99") <> "04":

            FOR FIRST b-nota-fiscal NO-LOCK
                WHERE b-nota-fiscal.cod-estabel  = nota-fiscal.cod-estabel
                  AND b-nota-fiscal.serie        = nota-fisc-adc.cod-ser-docto-referado
                  AND b-nota-fiscal.nr-nota-fis  = nota-fisc-adc.cod-docto-referado
                  AND b-nota-fiscal.cod-emitente = nota-fisc-adc.cdn-emit-docto-referado:

                ASSIGN c-serie-orig    = b-nota-fiscal.serie
                       c-nr-nota-orig  = b-nota-fiscal.nr-nota-fis
                       i-cod-emit-orig = b-nota-fiscal.cod-emitente
                       c-nat-oper-orig = b-nota-fiscal.nat-operacao.
            END.
        END.
    END.

    FOR FIRST docto-estoq-nfe-imp NO-LOCK
        WHERE docto-estoq-nfe-imp.cod-ser-docto    = c-serie-orig
        AND   docto-estoq-nfe-imp.cod-docto        = c-nr-nota-orig
        AND   docto-estoq-nfe-imp.cdn-emitente     = i-cod-emit-orig
        AND   docto-estoq-nfe-imp.cod-natur-operac = c-nat-oper-orig:

        FOR EACH ttAdi EXCLUSIVE-LOCK
            WHERE ttAdi.CodEstabelNF = nota-fiscal.cod-estabel
            AND   ttAdi.SerieNF      = nota-fiscal.serie
            AND   ttAdi.NrNotaFisNF  = nota-fiscal.nr-nota-fis
            AND   ttAdi.ItCodigoNF   = it-nota-fisc.it-codigo
            AND   ttAdi.NrSeqFatNF   = it-nota-fisc.nr-seq-fat:
            
            DELETE ttAdi.
        END.

        FOR EACH  item-docto-estoq-nfe-imp NO-LOCK 
            WHERE item-docto-estoq-nfe-imp.cdn-emitente     = docto-estoq-nfe-imp.cdn-emitente     
            AND   item-docto-estoq-nfe-imp.cod-docto        = docto-estoq-nfe-imp.cod-docto        
            AND   item-docto-estoq-nfe-imp.cod-ser-docto    = docto-estoq-nfe-imp.cod-ser-docto    
            AND   item-docto-estoq-nfe-imp.cod-natur-operac = docto-estoq-nfe-imp.cod-natur-operac
            /* Usa seq-ped pois o recebimento pode pular de 1 em 1. Se vier zerado (notas de ajuste), 
               faz o fallback para seq-fat para garantir o v°nculo correto da adiá∆o. */
            AND   ((it-nota-fisc.nr-seq-ped <> 0 AND item-docto-estoq-nfe-imp.num-seq   = it-nota-fisc.nr-seq-ped) 
                OR (it-nota-fisc.nr-seq-ped =  0 AND item-docto-estoq-nfe-imp.num-seq   = it-nota-fisc.nr-seq-fat)):
            
            /* Chave EMS */
            CREATE ttAdi.
            ASSIGN ttAdi.CodEstabelNF = nota-fiscal.cod-estabel
                   ttAdi.SerieNF      = nota-fiscal.serie
                   ttAdi.NrNotaFisNF  = nota-fiscal.nr-nota-fis
                   ttAdi.ItCodigoNF   = it-nota-fisc.it-codigo    
                   ttAdi.NrSeqFatNF   = it-nota-fisc.nr-seq-fat /*para criar a ttII ele deve usar o seq-fat */ .              
    
           
            /* Chave para a ttDI */
            ASSIGN ttAdi.nDI          = docto-estoq-nfe-imp.des-decla-import.
    
            ASSIGN ttAdi.nAdicao      = string(item-docto-estoq-nfe-imp.num-adic)
                   ttAdi.nSeqAdic     = string(item-docto-estoq-nfe-imp.num-seq-import)
                   ttAdi.cFabricante  = string(item-docto-estoq-nfe-imp.cdn-expdor)
                   ttAdi.vDescDI      = item-docto-estoq-nfe-imp.val-desc
                   ttAdi.nDraw        = TRIM(item-docto-estoq-nfe-imp.cod-livre-1).

            ASSIGN ttAdi.nDI = REPLACE(ttAdi.nDI,"-","")
                   ttAdi.nDI = REPLACE(ttAdi.nDI,".","")
                   ttAdi.nDI = REPLACE(ttAdi.nDI,"/","")
                   ttAdi.nDI = REPLACE(ttAdi.nDI,"~\","")
                   ttAdi.nDI = REPLACE(ttAdi.nDI,",","").

            RUN pi-cria-NVE. /*por DI e adicao*/

        END. /* fim FOR EACH  item-docto-estoq-nfe-imp */
    END.
    
END PROCEDURE.