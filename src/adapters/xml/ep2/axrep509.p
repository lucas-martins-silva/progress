PROCEDURE PIUpsert:

/*PARAMETERS - BEGIN*/
/*PARAMETERS - END*/


/*LOCAL VARIABLES - BEGIN*/
DEFINE VAR iId AS INTEGER INITIAL ? NO-UNDO.
/*LOCAL VARIABLES - END*/


/* ******************************************* */
/* *************** BODY - BEGIN ************** */
/* ******************************************* */


     /* OBTEM A PARTE DA MENSAGEM QUE ESTÊ ABAIXO DO ELEMENTO BusinessContent */
     RUN getBusinessContent IN hMessageHandler (OUTPUT hBusinessContent).

     /* LIMPA AS TEMP-TABLES INTERNAS DA API XML */
     RUN reset IN hGenXml.

     /* CARREGA A ESTRUTURA FILHA DE BusinessContent */
     RUN loadXml IN hGenXml (hBusinessContent).

     /* ELIMINA A MENSAGEM OBTIDA NO MêTODO getBusinessContent */
     DELETE OBJECT hBusinessContent NO-ERROR.

     /* ********* LEITURA DA MENSAGEM - BEGIN ********* */
     addStack(1).
          /*--- ROMANEIO ---*/
          CREATE tt-roman-faturam.

          RUN getSonDec  IN hGenXml (INPUT getStack(), INPUT "PickingListNumber", OUTPUT tt-roman-faturam.num-romaneio).
          RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "PickingListDate", OUTPUT tt-roman-faturam.dt-emissao).
          RUN getSonVal  IN hGenXml (INPUT getStack(), INPUT "CustomerShortName", OUTPUT tt-roman-faturam.nome-abrev).
          RUN getSonVal  IN hGenXml (INPUT getStack(), INPUT "CustomerOrderNumber", OUTPUT tt-roman-faturam.nr-pedcli).
          RUN getSonDec  IN hGenXml (INPUT getStack(), INPUT "PickingListStatus", OUTPUT tt-roman-faturam.idi-sit-roman).
          RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "CancelDate", OUTPUT tt-roman-faturam.dt-cancela).
          RUN getSonVal  IN hGenXml (INPUT getStack(), INPUT "CancelReason", OUTPUT tt-roman-faturam.dsl-motiv-cancel).
          RUN getSonVal  IN hGenXml (INPUT getStack(), INPUT "CancelUserCode", OUTPUT tt-roman-faturam.cod-usuar-cancel).
          RUN getSonDec  IN hGenXml (INPUT getStack(), INPUT "PackagingQuantity", OUTPUT tt-roman-faturam.num-livre-1).
          RUN getSonVal  IN hGenXml (INPUT getStack(), INPUT "PackagingDescription", OUTPUT tt-roman-faturam.cod-livre-1).
          
          /* --- Campo necess†rio para a nova engenharia do projeto --- */ 
          RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "PickingListType", OUTPUT tt-roman-faturam.idi-tip-roman).
          
          /*--- Referente FO 2002.721 ------------------------------------------------------------------------------*/
          if  tt-roman-faturam.idi-tip-roman = 4 /* Devoluá∆o */ then do:

              if  tt-roman-faturam.cod-estabel = "" then
                  RUN getSonVal IN hGenXml  (INPUT getStack(), INPUT "MainSiteID", OUTPUT tt-roman-faturam.cod-estabel).

              assign tt-roman-faturam.cod-estabel = "90" + tt-roman-faturam.cod-estabel.
              
              if  tt-roman-faturam.nr-pedcli <> "" then assign tt-roman-faturam.nr-pedcli = "".
          end. /* if  tt-roman-faturam.idi-tip-roman = 4 /* Devoluá∆o */  */
          /*--------------------------------------------------------------------------------------------------------*/

          if  tt-roman-faturam.idi-tip-roman <> 4 /* Devoluá∆o */ then RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "OrderNumber", OUTPUT tt-roman-faturam.nr-pedido).

          ASSIGN tt-roman-faturam.ep-codigo     = i-ep-codigo-usuario
                 tt-roman-faturam.idi-sit-roman = 1 /* N∆o Faturado */.

          FOR FIRST ped-venda FIELDS(cod-estabel nr-pedido) NO-LOCK
              where ped-venda.nome-abrev = tt-roman-faturam.nome-abrev
              and   ped-venda.nr-pedcli  = tt-roman-faturam.nr-pedcli:

              ASSIGN tt-roman-faturam.cod-estabel = ped-venda.cod-estabel
                     tt-roman-faturam.nr-pedido   = ped-venda.nr-pedido.
          END. /* FOR FIRST ped-venda */

          RUN searchTag IN hGenXml (INPUT "ListOfPickingItens", INPUT getStack(), OUTPUT iId).
          if (iId <> ?) THEN DO:
               addStack(iId).

                    RUN getFirstSonId IN hGenXml (INPUT getStack(), OUTPUT iId).

                    DO WHILE iId <> ?:
                    addStack(iId).

                         /*--- ITEM ROMANEIO ---*/
                         CREATE tt-item-roman-faturam.
                         ASSIGN tt-item-roman-faturam.num-romaneio = tt-roman-faturam.num-romaneio.
                         
                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "PickingListLine", OUTPUT tt-item-roman-faturam.nr-sequencia).
                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "OrderLine", OUTPUT tt-item-roman-faturam.nr-seq-ped).
                         RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ItemCode", OUTPUT tt-item-roman-faturam.it-codigo).
                         RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ItemReferenceCode", OUTPUT tt-item-roman-faturam.cod-refer).
                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "Quantity1", OUTPUT tt-item-roman-faturam.qtd-romaneio[1]).
                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "Quantity2", OUTPUT tt-item-roman-faturam.qtd-romaneio[2]).
                         RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ItemUnitOfMeasure1", OUTPUT tt-item-roman-faturam.cod-unid-item-roman[1]).
                         RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ItemUnitOfMeasure2", OUTPUT tt-item-roman-faturam.cod-unid-item-roman[2]).
                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "QuantityPad", OUTPUT tt-item-roman-faturam.num-livre-1).
                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "PickingListNetWeight", OUTPUT tt-item-roman-faturam.val-livre-1).
                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "PickingGrossWeight", OUTPUT tt-item-roman-faturam.val-livre-2).
                         RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "QuantityMetre", OUTPUT tt-item-roman-faturam.cod-livre-1).

                         /*--- Referente FO 2002.721 ------------------------------------------------------------------------------*/
                         if  tt-roman-faturam.idi-tip-roman = 4 /* Devoluá∆o */ then do:
                             &if '{&BF_DIS_VERSAO_EMS}' < '2.08' &then
                                 RUN getSonVal IN hGenXml  (INPUT getStack(), INPUT "DocumentSeries", OUTPUT vDocumentSeries).
                                 assign overlay(tt-item-roman-faturam.cod-livre-2,1,3) = vDocumentSeries.
                                 
                                 RUN getSonVal IN hGenXml  (INPUT getStack(), INPUT "DocumentNumber", OUTPUT vDocumentNumber).

                                 assign iDocumentNumber                                 = int(vDocumentNumber)
                                        overlay(tt-item-roman-faturam.cod-livre-2,4,16) = trim(string(iDocumentNumber, '>>>>>>>>9999999')).

                                 RUN getSonVal IN hGenXml  (INPUT getStack(), INPUT "FiscalOperationCode1", OUTPUT vFiscalOperationCode1).
                                 assign overlay(tt-item-roman-faturam.cod-livre-2,20,6) = vFiscalOperationCode1.
                             &else
                                 RUN getSonVal IN hGenXml  (INPUT getStack(), INPUT "DocumentSeries", OUTPUT tt-item-roman-faturam.cod-ser-docto-orig).

                                 RUN getSonVal IN hGenXml  (INPUT getStack(), INPUT "DocumentNumber", OUTPUT vDocumentNumber).
                                 assign iDocumentNumber                      = int(vDocumentNumber)
                                        tt-item-roman-faturam.cod-docto-orig = string(iDocumentNumber).

                                 RUN getSonVal IN hGenXml  (INPUT getStack(), INPUT "FiscalOperationCode1", OUTPUT tt-item-roman-faturam.cod-natur-operac-orig).
                             &endif
                         end. /* if  tt-roman-faturam.idi-tip-roman = 4 /* Devoluá∆o */ */
                         /*--------------------------------------------------------------------------------------------------------*/

                         RUN searchTag IN hGenXml (INPUT "ListOfPDepositItens", INPUT getStack(), OUTPUT iId).

                         if (iId <> ?) THEN DO:
                              addStack(iId).

                                   /*--- DEP‡SITO ITEM ---*/
                                   CREATE tt-item-depos-roman.      
                                   ASSIGN tt-item-depos-roman.num-romaneio = tt-item-roman-faturam.num-romaneio
                                          tt-item-depos-roman.nr-sequencia = tt-item-roman-faturam.nr-sequencia
                                          tt-item-depos-roman.it-codigo    = tt-item-roman-faturam.it-codigo
                                          tt-item-depos-roman.cod-refer    = tt-item-roman-faturam.cod-refer.
                                    
                                   RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "DepositCode", OUTPUT tt-item-depos-roman.cod-depos).
                                   RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "LocationCode", OUTPUT tt-item-depos-roman.cod-localiz).
                                   RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "SerialLoteNumber", OUTPUT tt-item-depos-roman.nr-serlote).
                                   RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "AllLocatedQuantity", OUTPUT tt-item-depos-roman.qt-alocada).

                                   for first localizacao no-lock 
                                       where localizacao.cod-estabel = tt-roman-faturam.cod-estabel
                                       and   localizacao.cod-depos   = tt-item-depos-roman.cod-depos:
                                       assign tt-item-depos-roman.cod-localiz = localizacao.cod-localiz.
                                   end. /* FOR FIRST ITEM */

                                   IF  tt-item-depos-roman.cod-localiz = ? THEN ASSIGN tt-item-depos-roman.cod-localiz = "".
                                   IF  tt-item-depos-roman.nr-serlote  = ? THEN ASSIGN tt-item-depos-roman.nr-serlote  = "".
                                 
                              delStack().
                         END.

                         ASSIGN iId = getStack().
                         delStack().
                         RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
                    END.

               delStack().
          END.

     delStack().
     /* ********* LEITURA DA MENSAGEM - END   ********* */


     /* ********* EFETIVAÄ«O - BEGIN ********* */



{adapters/xml/ep2/axrep509upsert.i}


     /* ********* EFETIVAÄ«O - END   ********* */

/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.


PROCEDURE receiveMessage:

