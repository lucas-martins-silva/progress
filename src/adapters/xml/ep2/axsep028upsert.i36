PROCEDURE pi-cria-ttInfAdicNFCom:

    DEFINE VARIABLE c-infCpl     AS CHARACTER   NO-UNDO.
    DEFINE VARIABLE c-infAdFisco AS CHARACTER   NO-UNDO.

    /*
    === ttInfAdic ===
    infAdFisco     AS CHARACTER INITIAL ?  /*Informa»„es adicionais de interesse do Fisco*/
    infCpl         AS CHARACTER INITIAL ?  /*Informa»„es complementares de interesse do Contribuinte*/
    */
    

    IF INDEX(nota-fiscal.observ-nota,"INFADFISCO") > 0 THEN
        ASSIGN c-infCpl     = TRIM(SUBSTRING(nota-fiscal.observ-nota,1,INDEX(nota-fiscal.observ-nota,"INFADFISCO") - 1))
               c-infAdFisco = REPLACE(TRIM(SUBSTRING(nota-fiscal.observ-nota,INDEX(nota-fiscal.observ-nota,"INFADFISCO"),LENGTH(nota-fiscal.observ-nota))),"INFADFISCO","").
    ELSE 
        ASSIGN c-infCpl     = nota-fiscal.observ-nota
               c-infAdFisco = "".    
               
    CREATE ttInfAdicNFCom.
    ASSIGN ttInfAdicNFCom.infAdFisco   = c-infAdFisco
           ttInfAdicNFCom.infCpl       = REPLACE(c-infCpl,CHR(10), " ")
           ttInfAdicNFCom.infCpl       = REPLACE(ttInfAdicNFCom.infCpl, CHR(13), " ")
           ttInfAdicNFCom.infCpl       = REPLACE(ttInfAdicNFCom.infCpl, CHR(9), " ")
           ttInfAdicNFCom.infCpl       = fn-ajusta-espacos-branco(ttInfAdicNFCom.infCpl)
           ttInfAdicNFCom.infCpl       = fn-ajusta-tamanho-campo(ttInfAdicNFCom.infCpl ,5000)
           ttInfAdicNFCom.infAdFisco   = fn-ajusta-espacos-branco(ttInfAdicNFCom.infAdFisco)
           ttInfAdicNFCom.infAdFisco   = fn-ajusta-tamanho-campo(ttInfAdicNFCom.infAdFisco ,2000).

    /* Chave EMS */
    ASSIGN ttInfAdicNFCom.CodEstabelNFCom = nota-fiscal.cod-estabel
           ttInfAdicNFCom.SerieNFCom      = nota-fiscal.serie
           ttInfAdicNFCom.NrNotaFisNFCom  = nota-fiscal.nr-nota-fis.           
               
END PROCEDURE.
