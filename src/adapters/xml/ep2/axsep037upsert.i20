PROCEDURE pi-cria-ttExporta:

    /*
    === ttExporta ===
    UFSaidaPais    AS CHARACTER INITIAL ? /*Sigla da UF de Embarque ou de transposiá∆o de fronteira*/
    xLocExporta    AS CHARACTER INITIAL ? /*Local de Embarque ou de transposiá∆o de fronteira*/
    xLocDespacho   AS CHARACTER INITIAL ? /*Descriá∆o do local de despacho [Descriá∆o do Recinto Alfandegado ou do local onde foi efetivado o despacho para a exportaá∆o, conforme padronizaá∆o da RFB]*/
    */

    FIND FIRST param-global NO-LOCK NO-ERROR.

    /* MODULO DE EXPORTAÄ«O IMPLANTADO */
    IF  CONNECTED("mgcex":U)
    AND param-global.modulo-ex THEN DO:

        IF  nota-fiscal.nat-operacao BEGINS "7" 
        AND nota-fiscal.cod-rota <> "" THEN DO:
            FOR FIRST rota NO-LOCK
                WHERE rota.cod-rota = nota-fiscal.cod-rota:
            END.
            
            CREATE ttExporta.
            ASSIGN ttExporta.CodEstabelNF  = nota-fiscal.cod-estabel
                   ttExporta.SerieNF       = nota-fiscal.serie
                   ttExporta.NrNotaFisNF   = nota-fiscal.nr-nota-fis
                   ttExporta.UFSaidaPais   = TRIM(SUBSTRING(rota.roteiro,1,2))
                   ttExporta.xLocExporta   = rota.descricao.

        END.
        
        FOR FIRST proc-nota-fiscal NO-LOCK
            WHERE proc-nota-fiscal.cod-estabel = nota-fiscal.cod-estab-proces-export
              AND proc-nota-fiscal.nr-nota-fis = nota-fiscal.nr-nota-fis
              AND proc-nota-fiscal.nr-proc-exp = nota-fiscal.nr-proc-exp
              and proc-nota-fiscal.cod-estab-faturam = nota-fiscal.cod-estabel
              AND proc-nota-fiscal.serie = nota-fiscal.serie,
            FIRST processo-exp NO-LOCK
            WHERE processo-exp.cod-estabel = proc-nota-fiscal.cod-estabel
              AND processo-exp.nr-proc-exp = proc-nota-fiscal.nr-proc-exp:
            
            /*Ponto Embarque*/
            FOR FIRST pto-contr FIELDS(descricao char-1 &if '{&bf_dis_versao_ems}' >= '2.07':U &then cod-uf &ENDIF) NO-LOCK
                WHERE pto-contr.cod-pto-contr = processo-exp.pto-embarque:
                
                IF NOT CAN-FIND(FIRST ttExporta
                                WHERE ttExporta.CodEstabelNF  = nota-fiscal.cod-estabel
                                  AND ttExporta.SerieNF       = nota-fiscal.serie
                                  AND ttExporta.NrNotaFisNF   = nota-fiscal.nr-nota-fis) THEN DO:
                    CREATE ttExporta.
                    ASSIGN ttExporta.CodEstabelNF  = nota-fiscal.cod-estabel
                           ttExporta.SerieNF       = nota-fiscal.serie
                           ttExporta.NrNotaFisNF   = nota-fiscal.nr-nota-fis.
                END.
                FOR FIRST historico-proc-exp FIELDS (descricao cod-uf)
                    WHERE historico-proc-exp.nr-proc-exp = processo-exp.nr-proc-exp
                      AND historico-proc-exp.cod-estabel = processo-exp.cod-estabel
                      AND historico-proc-exp.cod-itiner  = processo-exp.cod-itiner
                      AND historico-proc-exp.cod-pto-contr = processo-exp.pto-embarque NO-LOCK: END.
                
                ASSIGN ttExporta.UFSaidaPais = IF AVAIL historico-proc-exp AND historico-proc-exp.cod-uf <> "":U THEN historico-proc-exp.cod-uf 
                                                                                                              ELSE string(pto-contr.cod-uf)
                       ttExporta.xLocExporta = IF AVAIL historico-proc-exp AND historico-proc-exp.descricao <> "":U THEN historico-proc-exp.descricao
                                                                                                                    ELSE pto-contr.descricao.
            END.
            
            /*Ponto Despacho*/
            FOR FIRST pto-contr FIELDS(descricao char-1 &if '{&bf_dis_versao_ems}' >= '2.07':U &then cod-uf &ENDIF) NO-LOCK
                WHERE pto-contr.cod-pto-contr = processo-exp.pto-despacho:
                
                IF NOT CAN-FIND(FIRST ttExporta
                                WHERE ttExporta.CodEstabelNF  = nota-fiscal.cod-estabel
                                  AND ttExporta.SerieNF       = nota-fiscal.serie
                                  AND ttExporta.NrNotaFisNF   = nota-fiscal.nr-nota-fis) THEN DO:
                    CREATE ttExporta.
                    ASSIGN ttExporta.CodEstabelNF  = nota-fiscal.cod-estabel
                           ttExporta.SerieNF       = nota-fiscal.serie
                           ttExporta.NrNotaFisNF   = nota-fiscal.nr-nota-fis.
                END.
                
                FOR FIRST historico-proc-exp FIELDS (descricao cod-uf)
                    WHERE historico-proc-exp.nr-proc-exp = processo-exp.nr-proc-exp
                      AND historico-proc-exp.cod-estabel = processo-exp.cod-estabel
                      AND historico-proc-exp.cod-itiner  = processo-exp.cod-itiner
                      AND historico-proc-exp.cod-pto-contr = processo-exp.pto-despacho NO-LOCK: END.
                ASSIGN ttExporta.xLocDespacho   = IF AVAIL historico-proc-exp AND historico-proc-exp.descricao <> "":U THEN historico-proc-exp.descricao 
                                                                                                                       ELSE pto-contr.descricao.
            END.
        END.
    END.
    ELSE DO:

        /* MODULO DE EXPORTAÄ«O N«O IMPLANTADO E FUNCAO ATIVA */
        IF  CAN-FIND(FIRST funcao 
                     WHERE funcao.cd-funcao = "spp-NFE-sem-modulo-MEX"
                     AND   funcao.ativo = YES) THEN DO:
    
            IF  nota-fiscal.nat-operacao BEGINS "7" 
            AND nota-fiscal.cod-rota <> "" THEN DO:
    
                FOR FIRST emitente NO-LOCK 
                    WHERE emitente.nome-abrev = nota-fiscal.nome-ab-cli
                    AND   (   i-natureza = 3
                           OR i-natureza = 4):
    


                    FOR FIRST rota NO-LOCK /*CD0706*/
                        WHERE rota.cod-rota = nota-fiscal.cod-rota:
    
                        CREATE ttExporta.
                        ASSIGN ttExporta.CodEstabelNF  = nota-fiscal.cod-estabel
                               ttExporta.SerieNF       = nota-fiscal.serie
                               ttExporta.NrNotaFisNF   = nota-fiscal.nr-nota-fis
                               ttExporta.UFSaidaPais   = substring(rota.roteiro,1,2)
                               ttExporta.xLocExporta    = rota.descricao.

                        /*campo xLocDespacho n∆o alimentado quando n∆o h† os m¢dulos COMEX - campo n∆o obrigatorio*/
                    END.
                END.
            END.
        END.
    END.

    /* Ajusta Formatacao dos Campos */
    IF  AVAIL ttExporta THEN
        ASSIGN ttExporta.UFSaidaPais  = fn-ajusta-tamanho-campo(ttExporta.UFSaidaPais , 2)
               ttExporta.xLocExporta  = fn-ajusta-tamanho-campo(ttExporta.xLocExporta ,60)
               ttExporta.xLocDespacho = fn-ajusta-tamanho-campo(ttExporta.xLocDespacho,60).

END PROCEDURE.
