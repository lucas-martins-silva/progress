PROCEDURE pi-grava-ttICMSSN101:

    /* === ttICMSSN101 ===
    Orig           AS CHARACTER INITIAL ?                                      /*Origem da mercadoria*/
    CSOSN          AS CHARACTER INITIAL ?                                      /*C¢digo de Situa‡Æo da Opera‡Æo - Simples Nacional*/
    pCredSN        AS DECIMAL   INITIAL ? FORMAT ">>9.99" DECIMALS 2           /*Al¡quota aplic vel de c lculo do cr‚dito (Simples Nacional)*/
    vCredICMSSN    AS DECIMAL   INITIAL ? FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2 /*Valor cr‚dito do ICMS que pode ser aproveitado nos termos do art. 23 da LC 123 (Simples Nacional)*/
    */

    CREATE ttICMSSN101.
    ASSIGN ttICMSSN101.orig        = STRING(i-codigo-orig)
           ttICMSSN101.CSOSN       = c-cod-csosn.

    &if "{&bf_dis_versao_ems}" >= "2.09" &then
          ASSIGN ttICMSSN101.pCredSN     = (IF it-nota-fisc.VAL-CR-ICMS-SIMPLES-NAC > 0
                                            THEN nota-fiscal.VAL-PERC-ICMS-SIMPLES-NAC
                                            ELSE 0)
                 ttICMSSN101.vCredICMSSN = it-nota-fisc.VAL-CR-ICMS-SIMPLES-NAC.
    &ELSE 
          ASSIGN ttICMSSN101.pCredSN     = (IF DEC(substring(it-nota-fisc.CHAR-1,207,20)) > 0
                                            THEN DEC(substring( nota-fiscal.CHAR-1,238,10))
                                            ELSE 0)
                 ttICMSSN101.vCredICMSSN = DEC(substring(it-nota-fisc.CHAR-1,207,20)).
    &ENDIF

    /* Chave EMS */
    ASSIGN ttICMSSN101.CodEstabelNF = nota-fiscal.cod-estabel
           ttICMSSN101.SerieNF      = nota-fiscal.serie
           ttICMSSN101.NrNotaFisNF  = nota-fiscal.nr-nota-fis
           ttICMSSN101.ItCodigoNF   = it-nota-fisc.it-codigo
           ttICMSSN101.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.

END PROCEDURE.