    DEFINE OUTPUT PARAM TABLE FOR ttConsStatServ_RET.
    DEFINE OUTPUT PARAM TABLE FOR tt_log_erro.
    
    /*PARAMETERS - END*/
    
    
    /*LOCAL VARIABLES - BEGIN*/
    DEFINE VAR iCount                    AS INTEGER   INITIAL ? NO-UNDO.
    DEFINE VAR iId                       AS INTEGER   INITIAL ? NO-UNDO.
    DEFINE VAR pErrorId                  AS INTEGER   INITIAL ? NO-UNDO.
    DEFINE VAR pErrorType                AS CHARACTER INITIAL ? NO-UNDO.
    DEFINE VAR pTotalErrors              AS INTEGER   INITIAL ? NO-UNDO.
                                         
    DEFINE VAR hOutputXML                AS HANDLE              NO-UNDO.
    DEFINE VAR iIdDatasulMessage         AS INTEGER   INITIAL ? NO-UNDO.
    DEFINE VAR iIdReturnContent          AS INTEGER   INITIAL ? NO-UNDO.
    DEFINE VAR iIdListOfExtraInformation AS INTEGER   INITIAL ? NO-UNDO.
    DEFINE VAR iIdExtraInformation       AS INTEGER   INITIAL ? NO-UNDO.
    DEFINE VAR cKey                      AS CHARACTER INITIAL ? NO-UNDO.
    DEFINE VAR cTpTrans                  AS CHARACTER           NO-UNDO.
    /*LOCAL VARIABLES - END*/
    
    
    /* ******************************************* */
    /* *************** BODY - BEGIN ************** */
    /* ******************************************* */
    
    /* VERIFICA SE MessageHandler.p ESTA NA MEMORIA */
    {xmlinc/xmlloadmessagehandler.i &MessageHandler="hMessageHandler" &MHReturnValue="cReturnValue"}
    
    IF cReturnValue <> "OK" THEN DO:
         CREATE TT_LOG_ERRO.
         ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO  = 17006.
         /* Inicio -- Projeto Internacional */
         {utp/ut-liter.i "Erro_ao_executar_MessageHandle" *}
         ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO  = RETURN-VALUE + ": "+ cReturnValue
                TT_LOG_ERRO.TTV_DES_MSG_AJUDA = TT_LOG_ERRO.TTV_DES_MSG_ERRO.
         RETURN cReturnValue.
    END.
    
    RUN isSubscribed IN hMessageHandler ("{&XmlProdName}", 
         "{&XmlApp}", 
         "{&XmlTranName}", 
         "{&XmlTranVersion}", 
         cEvent, 
         cTranAction, 
         OUTPUT lCreateMsg)
    .
    
    IF RETURN-VALUE <> "OK" THEN DO:
         CREATE TT_LOG_ERRO.
         ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO  = 17006.
         /* Inicio -- Projeto Internacional */
         DEFINE VARIABLE c-lbl-liter AS CHARACTER NO-UNDO.
         ASSIGN c-lbl-liter = TRIM(RETURN-VALUE).
         DEFINE VARIABLE c-lbl-liter-erro-ao-executar-issubscribed AS CHARACTER NO-UNDO.
         {utp/ut-liter.i "Erro_ao_executar_isSubscribed_no_MessageHandle" *}
         ASSIGN c-lbl-liter-erro-ao-executar-issubscribed = TRIM(RETURN-VALUE).
         ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO  = c-lbl-liter-erro-ao-executar-issubscribed + ": "+ c-lbl-liter
                TT_LOG_ERRO.TTV_DES_MSG_AJUDA = TT_LOG_ERRO.TTV_DES_MSG_ERRO.
         RETURN RETURN-VALUE.
    END.
    
    IF NOT lCreateMsg THEN DO:
         CREATE TT_LOG_ERRO.
         ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO  = 17006.
         /* Inicio -- Projeto Internacional */
         {utp/ut-liter.i "A_Transacao_'{&XmlTranName}'_nao_e_assinada" *}
         ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO  = RETURN-VALUE + '.'
                TT_LOG_ERRO.TTV_DES_MSG_AJUDA = TT_LOG_ERRO.TTV_DES_MSG_ERRO.
         RETURN "OK".
    END.

    
    
    /* PREENCHE O VALOR DO ELEM. Comment DE TransactionId */
    RUN setTransInfoComment IN hMessageHandler ("Comentario do desenvolvedor").
    
    
    
    /* SETA SystemId */
    RUN setSystemId IN hMessageHandler ("{&XmlMod}",  "{&XmlProdVersion}").
    
    
    FIND FIRST ttConsStatServ_ENV NO-LOCK NO-ERROR.
    
    
    RUN setKeyFields IN hMessageHandler ("CodEstabel", ttConsStatServ_ENV.CodEstabel).


    RUN cdp/cd0360b.p (INPUT ttConsStatServ_ENV.CodEstabel,
                       INPUT "NF-e":U,
                       OUTPUT cTpTrans).

    /*------------------------- INTEGRAÄ«O TSS [TOTVS] -------------------------*/
    IF  LOOKUP(cTpTrans, "TSS,TC":U) > 0 THEN DO:

        FOR FIRST param-nf-estab NO-LOCK
            WHERE param-nf-estab.cod-estabel = ttConsStatServ_ENV.CodEstabel
              AND (param-nf-estab.ind-empresa <> ""
              AND  param-nf-estab.ind-empresa <> ?) :

            RUN setKeyFields IN hMessageHandler ("ID_ENT", param-nf-estab.ind-empresa).
        END.

        IF  NOT AVAIL param-nf-estab THEN
            RETURN "OK":U. /*Se o TSS n∆o estiver configurado para este estabelec, n∆o enviar solicitaá∆o, pois d† erro.*/
        
    END.
    /*--------------------------------------------------------------------------*/
    
    
    /* INFORMA A EMPRESA E O ESTABELECIMENTO */
    RUN setCompanyId IN hMessageHandler (STRING(v_cdn_empres_usuar), "").
    
    
         /* RESETA OS VALORES */
         RUN reset IN hGenXml.
    
         /* SETA VALOR DE ENCODING */
         RUN setEncoding IN hGenXml ("UTF-8").
    
    
         RUN addNode IN hGenXml (getStack(), "Upsert", "", OUTPUT iId).
         addStack(iId).
    
              RUN addNode IN hGenXml (getStack(), "ConsStatServ", "", OUTPUT iId).
              addStack(iId).
    
                   RUN addNode IN hGenXml (getStack(), "tpAmb", ttConsStatServ_ENV.tpAmb, OUTPUT iId).
                   RUN addNode IN hGenXml (getStack(), "cUF",   ttConsStatServ_ENV.cUF,   OUTPUT iId).
                   RUN addNode IN hGenXml (getStack(), "xServ", ttConsStatServ_ENV.xServ, OUTPUT iId).

              delStack().
    
         delStack().
    
    
    /* OBTEM O XML NUMA HANDLE */
    RUN generateXML IN hGenXml (OUTPUT hBusinessContent).
    
    
    /* DEFINE O CONTEÈDO DO ELEMENTO BusinessContent */
    RUN setBusinessContent IN hMessageHandler (INPUT hBusinessContent).
    
    /* LIBERA MEM‡RIA ALOCADA PARA O OBJETO */
    DELETE OBJECT hBusinessContent NO-ERROR.
    
    
    
    /*CONTR‡I A MENSAGEM XML E ENVIA PARA O ControlBroker */
    RUN sendMessage IN hMessageHandler (INPUT "ep2/ConsStatServEnv_204_000_v1.07.xsd"). 
    
    /* VERIFICA SE OCORREU ALGUM ERRO */
    IF RETURN-VALUE <> "OK" THEN DO:
         CREATE TT_LOG_ERRO.
         ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO  = 17006.
         /* Inicio -- Projeto Internacional */
         DEFINE VARIABLE c-lbl-liter-2 AS CHARACTER NO-UNDO.
         ASSIGN c-lbl-liter-2 = TRIM(RETURN-VALUE).
         DEFINE VARIABLE c-lbl-liter-erro-no-envio-da-mensagem AS CHARACTER NO-UNDO.
         {utp/ut-liter.i "Erro_no_envio_da_Mensagem" *}
         ASSIGN c-lbl-liter-erro-no-envio-da-mensagem = TRIM(RETURN-VALUE).
         ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO  = c-lbl-liter-erro-no-envio-da-mensagem + ": "+ c-lbl-liter-2
                TT_LOG_ERRO.TTV_DES_MSG_AJUDA = TT_LOG_ERRO.TTV_DES_MSG_ERRO.
         RETURN RETURN-VALUE.
    END.
    
    
    /* Grava XML enviado ao integrador na fila do EAI [/* 1- Envio (SendXML.xml)  2- Retorno (ReturnXML.xml) */] */
    /* Com o TSS Sincrono n∆o ser† mais utilizado a Fila EAI */
    /*RUN piFilaEAI (INPUT 1,
                   INPUT "Estabel: ":U + ttConsStatServ_ENV.CodEstabel).*/

    
    /* VERIFICA SE A MENSAGEM FOI PROCESSADA COM SUCESSO */
    RUN getReturnStatus IN hMessageHandler (OUTPUT pSendSuccess, OUTPUT pTotalErrors).
    
    
    
    /* SE NAO ENVIO COM SUCESSO */
    IF NOT pSendSuccess THEN DO:
         REPEAT iCount = 1 TO pTotalErrors:
              CREATE TT_LOG_ERRO.
              RUN getError IN hMessageHandler (iCount, OUTPUT TT_LOG_ERRO.TTV_NUM_COD_ERRO, OUTPUT pErrorType, OUTPUT TT_LOG_ERRO.TTV_DES_MSG_ERRO).
              ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO  = 17006
                     TT_LOG_ERRO.TTV_DES_MSG_AJUDA = TT_LOG_ERRO.TTV_DES_MSG_ERRO.
         END.
         RETURN "NOK".
    END.
    ELSE DO: /* Là mensagem de retorno "ExtraInformation" */

        RUN getCompleteReturnHandle IN hMessageHandler (OUTPUT hOutputXML).

        RUN reset              IN hGenXml.
        RUN loadXml            IN hGenXml (INPUT hOutputXML).

        RUN searchTag IN hGenXML ( INPUT "DatasulMessage":U, INPUT 0,  OUTPUT iIdDatasulMessage).
        IF  iIdDatasulMessage <> ? THEN DO:
            addStack(iIdDatasulMessage).
                RUN searchTag IN hGenXml (INPUT "ReturnContent":U, INPUT iIdDatasulMessage, OUTPUT iIdReturnContent).
                IF iIdReturnContent <> ? THEN DO:
                    addStack(iIdReturnContent).

                       RUN searchTag IN hGenXml (INPUT "ListOfExtraInformation":U, INPUT iIdReturnContent, OUTPUT iIdListOfExtraInformation).
                       IF iIdListOfExtraInformation <> ? THEN DO:
                           addStack(iIdListOfExtraInformation).

                               RUN getFirstSonId IN hGenXml (INPUT iIdListOfExtraInformation, OUTPUT iIdExtraInformation).

                               EMPTY TEMP-TABLE ttConsStatServ_RET.

                               CREATE ttConsStatServ_RET.
                               ASSIGN ttConsStatServ_RET.CodEstabel = ttConsStatServ_ENV.CodEstabel
                                      ttConsStatServ_RET.UF         = ttConsStatServ_ENV.UF.

                               DO WHILE iIdExtraInformation <> ?: /* tags ExtraInformation */
                                   addStack(iIdExtraInformation).

                                       RUN getSonVal  IN hGenXml (INPUT iIdExtraInformation, INPUT "Key":U, OUTPUT cKey).

                                       CASE cKey:
                                           WHEN "tpAmb":U THEN
                                               RUN getSonVal IN hGenXml (INPUT iIdExtraInformation, INPUT "Value":U, OUTPUT ttConsStatServ_RET.tpAmb).
                                           WHEN "verAplic":U THEN
                                               RUN getSonVal IN hGenXml (INPUT iIdExtraInformation, INPUT "Value":U, OUTPUT ttConsStatServ_RET.verAplic).
                                           WHEN "cStat":U THEN
                                               RUN getSonVal IN hGenXml (INPUT iIdExtraInformation, INPUT "Value":U, OUTPUT ttConsStatServ_RET.cStat).
                                           WHEN "xMotivo":U THEN
                                               RUN getSonVal IN hGenXml (INPUT iIdExtraInformation, INPUT "Value":U, OUTPUT ttConsStatServ_RET.xMotivo).
                                           WHEN "cUF":U THEN
                                               RUN getSonVal IN hGenXml (INPUT iIdExtraInformation, INPUT "Value":U, OUTPUT ttConsStatServ_RET.cUF).
                                           WHEN "dhRecbto":U THEN
                                               RUN getSonVal IN hGenXml (INPUT iIdExtraInformation, INPUT "Value":U, OUTPUT ttConsStatServ_RET.dhRecbto).
                                           WHEN "tMed":U THEN
                                               RUN getSonVal IN hGenXml (INPUT iIdExtraInformation, INPUT "Value":U, OUTPUT ttConsStatServ_RET.tMed).
                                           WHEN "dhRetorno":U THEN
                                               RUN getSonVal IN hGenXml (INPUT iIdExtraInformation, INPUT "Value":U, OUTPUT ttConsStatServ_RET.dhRetorno).
                                           WHEN "xObs":U THEN
                                               RUN getSonVal IN hGenXml (INPUT iIdExtraInformation, INPUT "Value":U, OUTPUT ttConsStatServ_RET.xObs).
                                       END CASE.
                                       
                                       ASSIGN iIdExtraInformation = getStack().
                                   
                                   delStack().
    
                                   RUN getNextSonId IN hGenXml (INPUT iIdListOfExtraInformation, INPUT iIdExtraInformation, OUTPUT iIdExtraInformation).

                               END.
                           delStack().
                       END.

                    delStack().
                END.
            delStack().
        END.

        IF NOT AVAIL ttConsStatServ_RET THEN
            FIND FIRST ttConsStatServ_RET NO-LOCK NO-ERROR.

    END.

    /* Grava XML de retorno na fila do EAI [/* 1- Envio (SendXML.xml)  2- Retorno (ReturnXML.xml) */] */
    /* Com o TSS Sincrono n∆o ser† mais utilizado a Fila EAI */
    /*RUN piFilaEAI (INPUT 2,
                   INPUT "Estabel: ":U + ttConsStatServ_ENV.CodEstabel).*/


    RETURN "OK":U.

    /* ******************************************* */
    /* *************** BODY - END   ************** */
    /* ******************************************* */

END PROCEDURE.


