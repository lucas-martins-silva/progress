PROCEDURE pi-cria-ttICMSTot:

    FIND FIRST param-global NO-LOCK NO-ERROR.

    /*
    === ttICMSTot ===
    vBC            AS DECIMAL   INITIAL ?  /*BC do ICMS*/
    vBCST          AS DECIMAL   INITIAL ?  /*BC do ICMS ST*/
    vCOFINS        AS DECIMAL   INITIAL ?  /*Valor do COFINS*/
    vDesc          AS DECIMAL   INITIAL ?  /*Valor Total do Desconto*/
    vFrete         AS DECIMAL   INITIAL ?  /*Valor Total do Frete*/
    vICMS          AS DECIMAL   INITIAL ?  /*Valor Total do ICMS*/
    vII            AS DECIMAL   INITIAL ?  /*Valor Total do II*/
    vIPI           AS DECIMAL   INITIAL ?  /*Valor Total do IPI*/
    vNF            AS DECIMAL   INITIAL ?  /*Valor Total da NF-e*/
    vOutro         AS DECIMAL   INITIAL ?  /*Outras Despesas acess¢rias*/
    vPIS           AS DECIMAL   INITIAL ?  /*Valor do PIS*/
    vProd          AS DECIMAL   INITIAL ?  /*Valor Total dos produtos e servi‡os*/
    vSeg           AS DECIMAL   INITIAL ?  /*Valor Total do Seguro*/
    vST            AS DECIMAL   INITIAL ?  /*Valor Total do ICMS ST*/
    */

    CREATE ttICMSTot.
    ASSIGN ttICMSTot.vBC     = d-total-base-icms
           ttICMSTot.vBCST   = d-total-base-icms-st
           ttICMSTot.vCOFINS = d-total-cofins
           ttICMSTot.vFrete  = nota-fiscal.vl-frete
           ttICMSTot.vICMS   = d-total-icms
           ttICMSTot.vII     = d-total-ii
           ttICMSTot.vIPI    = d-total-ipi
           ttICMSTot.vNF     = nota-fiscal.vl-tot-nota
           ttICMSTot.vOutro  = nota-fiscal.vl-embalagem /*d-total-outras-desp*/
           ttICMSTot.vOutro  = (ttICMSTot.vOutro - ttICMSTot.vII  /* retira valor do II */ )
           ttICMSTot.vOutro  = ttICMSTot.vOutro + d-total-pis-st + d-total-cofins-st 
           ttICMSTot.vOutro  = ttICMSTot.vOutro + d-total-icms-STA + d-total-IPI-espec + d-total-icms-ST-espec + d-total-ipi-out-tot + d-total-desp-n-destaq + d-total-icms-ST-devol
           ttICMSTot.vPIS    = d-total-pis
           ttICMSTot.vProd   = de-vProdTotal         /* valor total produtos bruto   */
           ttICMSTot.vSeg    = nota-fiscal.vl-seguro
           ttICMSTot.vST     = d-total-icms-st
           .
    
    IF ttICMSTot.vOutro < 0 THEN
       ASSIGN ttICMSTot.vOutro = 0.

    
    /*Descontos*/
    ASSIGN ttICMSTot.vDesc = 0.

    FOR EACH ttDet
       WHERE ttDet.vDesc > 0:
        ASSIGN ttICMSTot.vDesc = ttICMSTot.vDesc + ttDet.vDesc.
    END.

    /*--- NT2013.003 | Lei 12.741/12 - Valor aproximado total de tributos federais, estaduais e municipais --*/
    ASSIGN ttICMSTot.vTotTrib  = (&IF '{&BF_DIS_VERSAO_EMS}' >= '2.09'
                                  &THEN nota-fiscal.val-tot-impto
                                  &ELSE DEC(SUBSTRING(nota-fiscal.char-1,248,17)) &ENDIF).
    /*---*/
    

/*     ************************************************************************************************************************   */
/*     COMENTADO E AGUARDANDO DEFINI€ÇO DA REJEI€ÇO 610                                                                           */
/*     ************************************************************************************************************************   */
/*     /*--- NT2011.004 ---*/                                                                                                     */
/*     /*                                                                                                                         */
/*     Rejei‡Æo 610 - Rejei‡Æo: Total da NF difere do somat¢rio dos Valores compäe o valor Total da NF.                           */
/*     Total do vNF (id:W16) difere do somat¢rio de:                                                                              */
/*     (+) vProd  (id:W07)                                                                                                        */
/*     (-) vDesc  (id:W10)                                                                                                        */
/*     (+) vST    (id:W06)                                                                                                        */
/*     (+) vFrete (id:W08)                                                                                                        */
/*     (+) vSeg   (id:W09)                                                                                                        */
/*     (+) vOutro (id:W15)                                                                                                        */
/*     (+) vII    (id:W11)                                                                                                        */
/*     (+) vIPI   (id:W12)                                                                                                        */
/*     (+) vServ  (id:W18) [ISSQNTot]                                                                                             */
/*     */                                                                                                                         */
/*                                                                                                                                */
/*     FIND FIRST ttISSQNTot NO-LOCK NO-ERROR.                                                                                    */
/*                                                                                                                                */
/*     ASSIGN ttICMSTot.vNF = ( ttICMSTot.vProd                                                                                   */
/*                            - ttICMSTot.vDesc                                                                                   */
/*                            + ttICMSTot.vST                                                                                     */
/*                            + ttICMSTot.vFrete                                                                                  */
/*                            + ttICMSTot.vSeg                                                                                    */
/*                            + ttICMSTot.vOutro                                                                                  */
/*                            + ttICMSTot.vII                                                                                     */
/*                            + ttICMSTot.vIPI                                                                                    */
/*                            + (IF AVAIL ttISSQNTot                                                                              */
/*                               THEN ttISSQNTot.vServ                                                                            */
/*                               ELSE 0) ).                                                                                       */
/*     /*--- FIM NT2011.004 ---*/                                                                                                 */
/*                                                                                                                                */

    /* Chave EMS */
    ASSIGN ttICMSTot.CodEstabelNF = nota-fiscal.cod-estabel
           ttICMSTot.SerieNF      = nota-fiscal.serie
           ttICMSTot.NrNotaFisNF  = nota-fiscal.nr-nota-fis.

END PROCEDURE.