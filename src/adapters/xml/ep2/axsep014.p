                                       RUN getSonVal IN hGenXml (INPUT iIdExtraInformation, INPUT "Value":U, OUTPUT cIdEnt).
                                       ASSIGN l-tempoespera = YES.
                                    END.

                                delStack().  
                                END.
                            delStack().  
                        END.
        
                     delStack().
                 END.
             delStack().
         END.

         
         IF l-tempoespera THEN DO:  /* Trata retorno mensagens/erros */
                                                                                                                    
            
         END.
