PROCEDURE pi-cria-ttComb:

    /*
    === ttComb ===
    cProdANP       AS CHARACTER INITIAL ?                                         /*C¢digo de produto da ANP Informar apenas quando se tratar de produtos regulados pela ANP - Agˆncia Nacional do Petr¢leo. Utilizar a codifica‡Æo de produtos do Sistema de Informa‡äes de Movimenta‡Æo de produtos - SIMP (http://www.anp.gov.br/simp/index.htm)*/
    CODIF          AS CHARACTER INITIAL ?                                         /*C¢digo de autoriza‡Æo / registro do CODIF. Informar apenas quando a UF utilizar o CODIF (Sistema de Controle do Diferimento do Imposto nas Opera‡äes com AEAC - µlcool Et¡lico Anidro Combust¡vel).*/
    qTemp          AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>9.9999"  DECIMALS 4 /*Quantidade de combust¡vel faturada - temperatura ambiente. Informar quando a quantidade faturada informada no campo qCom (I10) tiver sido ajustada para uma temperatura diferente da ambiente.*/ 
    UFCons         AS CHARACTER INITIAL ?                                         /*Sigla da UF Dest*/
    qBCProd        AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>9.9999"  DECIMALS 4 /*BC do CIDE ( Quantidade comercializada) */  
    vAliqProd      AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>9.9999"   DECIMALS 4 /*Al¡quota do CIDE  (em reais)*/ 
    vCIDE          AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.9999" DECIMALS 4 /*Valor do CIDE*/ 
    */

    IF  NOT AVAIL item
    OR (AVAIL item
    AND item.it-codigo <> it-nota-fisc.it-codigo) THEN
        FOR FIRST item NO-LOCK
            WHERE item.it-codigo = it-nota-fisc.it-codigo:
        END.

    IF  AVAIL item
    AND (TRIM(&if '{&BF_DIS_VERSAO_EMS}' >= "2.09":U &then
                item.cod-produt-anp
              &else
                SUBSTR(item.char-1,268,20)
              &endif) <> "":U
    AND  TRIM(&if '{&BF_DIS_VERSAO_EMS}' >= "2.09":U &then
                item.cod-produt-anp
              &else
                SUBSTR(item.char-1,268,20)
              &endif) <> "0":U) THEN DO:
             
        IF  NOT AVAIL ttDest THEN
            FIND FIRST ttDest NO-LOCK NO-ERROR.
             
        CREATE ttComb.
        ASSIGN ttComb.cProdANP     = TRIM(&if '{&BF_DIS_VERSAO_EMS}' >= "2.09":U &then
                                            item.cod-produt-anp
                                          &else
                                            SUBSTR(item.char-1,268,20)
                                          &endif)
               /*ttComb.CODIF        = */
               /*ttComb.qTemp        = */
               ttComb.UFCons       = ttDest.UF
               /*ttComb.qBCProd      = */
               /*ttComb.vAliqProd    = */
               /*ttComb.vCIDE        = */ .

        /* Chave EMS */
        ASSIGN ttComb.CodEstabelNF = it-nota-fisc.cod-estabel
               ttComb.SerieNF      = it-nota-fisc.serie
               ttComb.NrNotaFisNF  = it-nota-fisc.nr-nota-fis
               ttComb.ItCodigoNF   = it-nota-fisc.it-codigo
               ttComb.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.
    END.

END PROCEDURE.