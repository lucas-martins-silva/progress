PROCEDURE pi-cria-ttProcRef:

    DEFINE VARIABLE i-ind-proc AS INTEGER                 NO-UNDO.
    DEFINE VARIABLE c-tp-ato   AS CHARACTER FORMAT 'x(2)' NO-UNDO .
    
    /***
        Op‡äes na Tela:        
        1 - "Sefaz"
        2 - "Justi‡a Federal"
        3 - "Justi‡a Estadual"
        4 - "Secex/SRF"
        5 - "CONFAZ"
        6 - "Outros"
        
        Op‡äes NF-e:
        0 - "SEFAZ"
        1 - "Justi‡a Federal"
        2 - "Justi‡a Estadual"
        3 - "Secex/RFB"
        4 - "CONFAZ"
        9 - "Outros"
        
        Campo TpAto:        
        Valores XML : 08=Termo de Acordo; 10=Regime Especial; 12=Autorização específica;
    ***/

    FOR EACH nota-fisc-adc NO-LOCK
       WHERE nota-fisc-adc.cod-estab        = nota-fiscal.cod-estabel
         AND nota-fisc-adc.cod-serie        = nota-fiscal.serie
         AND nota-fisc-adc.cod-nota-fisc    = nota-fiscal.nr-nota-fis
         AND nota-fisc-adc.cdn-emitente     = nota-fiscal.cod-emitente
         AND nota-fisc-adc.cod-natur-operac = nota-fiscal.nat-operacao
         AND nota-fisc-adc.idi-tip-dado     = 1:  /*identificador para as informacoes inseridas no CD4035*/ 
      
        CASE nota-fisc-adc.idi-orig-proces:
            WHEN 1 THEN ASSIGN i-ind-proc = 0.
            WHEN 2 THEN ASSIGN i-ind-proc = 1.
            WHEN 3 THEN ASSIGN i-ind-proc = 2.
            WHEN 4 THEN ASSIGN i-ind-proc = 3.
            WHEN 5 THEN ASSIGN i-ind-proc = 4.
            WHEN 6 THEN ASSIGN i-ind-proc = 9.
        END CASE.
        
        CASE nota-fisc-adc.num-livre-1:
            WHEN 8 THEN ASSIGN c-tp-ato = "08".
            OTHERWISE   ASSIGN c-tp-ato = STRING(nota-fisc-adc.num-livre-1).
        END CASE.

        CREATE ttProcRef.
        ASSIGN ttProcRef.CodEstabelNF = nota-fisc-adc.cod-estab
               ttProcRef.SerieNF      = nota-fisc-adc.cod-serie
               ttProcRef.NrNotaFisNF  = nota-fisc-adc.cod-nota-fisc
               ttProcRef.nProc        = TRIM(nota-fisc-adc.cod-proces)
               ttProcRef.indProc      = STRING(i-ind-proc).

        IF l-NT2021004 AND ttProcRef.indProc = "0" /*Sefaz*/ THEN 
            ASSIGN ttProcRef.tpAto = c-tp-ato.

    END.

END PROCEDURE.

