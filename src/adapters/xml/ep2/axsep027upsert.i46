PROCEDURE pi-grava-ttICMSSN500:

    /*
    === ttICMSSN500 === 
    Orig           AS CHARACTER INITIAL ?                                      /*Origem da mercadoria*/
    CSOSN          AS CHARACTER INITIAL ?                                      /*C¢digo de Situa‡Æo da Opera‡Æo - Simples Nacional*/
    vBCSTRet       AS DECIMAL   INITIAL ? FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2 /*Valor da BC do ICMS ST retido*/
    vICMSSTRet     AS DECIMAL   INITIAL ? FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2 /*Valor do ICMS ST retido*/
    */
    
    CREATE ttICMSSN500.
    ASSIGN ttICMSSN500.orig       = STRING(i-codigo-orig)
           ttICMSSN500.CSOSN      = c-cod-csosn
           ttICMSSN500.vBCSTRet   = it-nota-fisc.vl-bsubs-it       /*Valor da BC do ICMS ST retido*/
           ttICMSSN500.vICMSSTRet = it-nota-fisc.vl-icmsub-it      /*Valor do ICMS ST retido*/
           .

     /*Chave EMS*/
    ASSIGN ttICMSSN500.CodEstabelNF = nota-fiscal.cod-estabel
           ttICMSSN500.SerieNF      = nota-fiscal.serie
           ttICMSSN500.NrNotaFisNF  = nota-fiscal.nr-nota-fis
           ttICMSSN500.ItCodigoNF   = it-nota-fisc.it-codigo
           ttICMSSN500.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.
     
END PROCEDURE.