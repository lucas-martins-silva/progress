PROCEDURE pi-grava-ttICMS51:

    def var d-descto-zfm-pis as dec no-undo.
    def var d-descto-zfm-cofins as dec no-undo.
    def var d-vl-desc-icms as dec no-undo.

    /*
    === ttICMS51 ===
    CST            AS CHARACTER INITIAL ?  /*Tributa‡Æo pelo ICMS 51 - Isenta 41 - NÆo tributada 50 - SuspensÆo 51 - Diferimento */
    vICMSDeson     AS DECIMAL   INITIAL ?  /*Valor do ICMS de desonera‡Æo*/ 
    cBenef         AS CHARACTER INITIAL ?  /*Motivo da desonera‡Æo do ICMS: 1 Î T xi; 3 Î Produtor Agropecu rio; 4 Î Frotista/Locadora; 5 Î Diplom tico/Consular; 6 Î Utilit rios e Motocicletas da Amaz“nia Ocidental e µreas de Livre Com‚rcio (Resolu‡Æo 714/88 e 790/94 Î CONTRAN e suas altera‡äes); 7 Î SUFRAMA; 8 - Venda a ¢rgÆo P£blico; 9 Î Outros 10- Deficiente Condutor 11- Deficiente nÆo condutor*/
    */

    CREATE ttICMS51.
    ASSIGN ttICMS51.CST        = SUBSTRING(c-niv-trib-icms,2,2).
    
    //Valor desonerado       
    ASSIGN d-descto-zfm-pis    = 0
           d-descto-zfm-cofins = 0
           d-vl-desc-icms      = 0.      
    
    /*--- Calcula Valor Desconto ICMS ---*/ /*somente para quando NAO for Zona Franca, e sim Desconto de ICMS (com motivo de desonera»’o parametrizado)*/
    for first loc-entr no-lock
        where loc-entr.nome-abrev  = nota-fiscal.nome-ab-cli
        and   loc-entr.cod-entrega = nota-fiscal.cod-entrega:
    end.    
    FOR FIRST bf-natur-oper-it NO-LOCK
        WHERE bf-natur-oper-it.nat-operacao = it-nota-fisc.nat-operacao:
    END.    
    IF (it-nota-fisc.per-des-icms > 0 AND 
       (TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2)) <> "" AND 
        TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2)) <> "0")) AND 
       ((r-cidade-zf = ? AND
        (avail loc-entr and loc-entr.log-1 = no)) or
        (r-cidade-zf <> ? and
         TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2)) <> "7")) THEN DO:
        
        IF  bf-natur-oper-it.log-deduz-desc-zfm-tot-nf THEN
            ASSIGN d-descto-zfm-pis    = bf-natur-oper-it.val-perc-desc-pis-zfm
                   d-descto-zfm-cofins = bf-natur-oper-it.val-perc-desc-cofins-zfm.
        
        ASSIGN d-vl-desc-icms = (1 - ((IF trim(substr(it-nota-fisc.char-1,461,5)) <> ""
                                       THEN dec(substring(it-nota-fisc.char-1,461,5))
                                       ELSE dec(substring(bf-natur-oper-it.char-2,66,5))) + d-descto-zfm-pis + d-descto-zfm-cofins) / 100) * /* Totaliza Descontos Zona Franca */
                                (1 - it-nota-fisc.per-des-icms / 100)                                                                        /* Soma com o Desconto ICMS */
               d-vl-desc-icms = it-nota-fisc.vl-merc-liq / d-vl-desc-icms /*Valor Bruto sem os Descontos acima*/
               d-vl-desc-icms = d-vl-desc-icms * it-nota-fisc.per-des-icms / 100 /*Valor referente ao Desconto ICMS (somente este [it-nota-fisc.per-des-icms], sem considerar os ZFM)*/
               d-vl-desc-icms = (if d-vl-desc-icms < 0
                                 then 0
                                 else d-vl-desc-icms)
               d-vl-desc-icms = round(d-vl-desc-icms, 2) NO-ERROR.

        FOR FIRST ext-it-nota-fisc
			WHERE ext-it-nota-fisc.cod-estabel = it-nota-fisc.cod-estabel
			AND   ext-it-nota-fisc.serie       = it-nota-fisc.serie
			AND   ext-it-nota-fisc.nr-nota-fis = it-nota-fisc.nr-nota-fis
			AND   ext-it-nota-fisc.nr-seq-fat  = it-nota-fisc.nr-seq-fat
			AND   ext-it-nota-fisc.it-codigo   = it-nota-fisc.it-codigo
			AND   ext-it-nota-fisc.cod-param   = "Val-Desc-ICMS"
            AND   NOT ext-it-nota-fisc.log-livre-1  NO-LOCK:
			ASSIGN d-vl-desc-icms = ext-it-nota-fisc.val-livre-1.
		END.    
    END.                         
    
    ttICMS51.vICMSDeson = d-vl-desc-icms.
    if ttICMS51.vICMSDeson = ? then ttICMS51.vICMSDeson = 0.
           
    FOR FIRST item-nf-adc NO-LOCK
        WHERE item-nf-adc.cod-estab         = nota-fiscal.cod-estabel
        AND   item-nf-adc.cod-serie         = nota-fiscal.serie
        AND   item-nf-adc.cod-nota-fisc     = nota-fiscal.nr-nota-fis
        AND   item-nf-adc.idi-tip-dado      = 29
        AND   item-nf-adc.cdn-emitente      = nota-fiscal.cod-emitente
        AND   item-nf-adc.cod-natur-operac  = it-nota-fisc.nat-operacao
        AND   item-nf-adc.num-seq-item-nf   = it-nota-fisc.nr-seq-fat
        AND   item-nf-adc.cod-livre-1      <> "":
        
        /* Cr²dito Presumido n’o gera a tag cBenef */
        IF not item-nf-adc.log-livre-3 THEN
            ASSIGN ttICMS51.cBenef = TRIM(item-nf-adc.cod-livre-1).                    
    END.            

    /* Chave EMS */
    ASSIGN ttICMS51.CodEstabelNF = nota-fiscal.cod-estabel
           ttICMS51.SerieNF      = nota-fiscal.serie
           ttICMS51.NrNotaFisNF  = nota-fiscal.nr-nota-fis
           ttICMS51.ItCodigoNF   = it-nota-fisc.it-codigo
           ttICMS51.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.
           
    if trim(substring(it-nota-fisc.char-2,393,1)) <> "1" then
        assign d-total-vl-desc-icms       = d-total-vl-desc-icms + ttICMS51.vICMSDeson.            

END PROCEDURE.
