PROCEDURE pi-cria-ttgTribRegular:
  
   /*
   === ttgTribRegular ===
   FIELD CSTReg              AS CHARACTER INITIAL ?                                         /*C¢digo de Situa‡Æo Tribut ria do IBS e CBS*/
   FIELD cClassTribReg       AS CHARACTER INITIAL ?                                         /*C¢digo de Classifica‡Æo Tribut ria do IBS e CBS*/
   FIELD pAliqEfet           AS DECIMAL   INITIAL ?  FORMAT ">>9.9999"         DECIMALS 4   /*valor da al¡quota do IBS da UF*/
   FIELD vTribRegIBSUF       AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor do Tributo do IBS da UF*/
   FIELD pAliqEfetRegIBSMun  AS DECIMAL   INITIAL ?  FORMAT ">>9.9999"         DECIMALS 4   /*Valor da al¡quota do IBS do Munic¡pio*/
   FIELD vTribRegIBSMun      AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*VValor do Tributo do IBS do Munic¡pio*/
   FIELD pAliqEfetRegCBS     AS DECIMAL   INITIAL ?  FORMAT ">>9.9999"         DECIMALS 4   /*Valor da al¡quota da CBS */
   FIELD vTribRegCBS         AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor do Tributo da CBS */
   */
   
   CREATE ttgTribRegular.              
   ASSIGN ttgTribRegular.CSTReg             = c-cst-reg
          ttgTribRegular.cClassTribReg      = c-class-trib-reg
          ttgTribRegular.pAliqEfetRegIBSUF  = d-aliq-efet-reg-ibs-uf 
          ttgTribRegular.vTribRegIBSUF      = d-trib-reg-ibs-uf
          ttgTribRegular.pAliqEfetRegIBSMun = d-aliq-efet-reg-ibs-mun
          ttgTribRegular.vTribRegIBSMun     = d-trib-reg-ibs-mun 
          ttgTribRegular.pAliqEfetRegCBS    = d-aliq-efet-reg-cbs
          ttgTribRegular.vTribRegCBS        = d-trib-reg-cbs
          /* Chave EMS */
          ttgTribRegular.CodEstabelNF  = it-nota-fisc-trib.cod-estabel
          ttgTribRegular.SerieNF       = it-nota-fisc-trib.serie   
          ttgTribRegular.NrNotaFisNF   = it-nota-fisc-trib.nr-nota-fis
          ttgTribRegular.ItCodigoNF    = it-nota-fisc-trib.it-codigo
          ttgTribRegular.NrSeqFatNF    = it-nota-fisc-trib.nr-seq-fat.
        
END PROCEDURE.

PROCEDURE pi-cria-ttTotIBSCBSIS:
   
   /*
   === ttTotIBSCBSIS ===
   FIELD vIS                   AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Total do imposto seletivo*/ 
   FIELD vBCIBSCBS             AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor total da BC do IBS e da CBS*/
   FIELD vDifIBSUF             AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor total do diferimento do IBS da UF*/
   FIELD vDevTribIBSUF         AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor total de devolu‡Æo de tributos do IBS da UF*/
   FIELD vIBSUF                AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor total do IBS da UF*/
   FIELD vDifIBSMun            AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor total do diferimento do IBS Mun*/
   FIELD vDevTribIBSMun        AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor total de devolu‡Æo de tributos do IBS Mun*/
   FIELD vIBSMun               AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor total do IBS do Mun*/
   FIELD vIBS                  AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor total do IBS*/
   FIELD vCredPresIBS          AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor total do cr‚dito presumido do IBS*/
   FIELD vCredPresCondSusIBS   AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor total do cr‚dito presumido em condi‡Æo suspensiva do IBS*/
   FIELD vCredPresCBS          AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor total do cr‚dito presumido da CBS*/
   FIELD vCredPresCondSusCBS   AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor total do cr‚dito presumido em condi‡Æo suspensiva da CBS*/
   FIELD vDifCBS               AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor total do diferimento da CBS*/
   FIELD vDevTribCBS           AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor total de devolu‡Æo de tributos da CBS*/
   FIELD vCBS                  AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor total da CBS*/
   FIELD vIBSMono              AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Total do IBS monof sico*/
   FIELD vCBSMono              AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Total da CBS monof sica*/
   FIELD vIBSMonoReten         AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Total do IBS monof sico sujeito a reten‡Æo*/
   FIELD vCBSMonoReten         AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Total da CBS monof sica sujeita a reten‡Æo*/
   FIELD vIBSMonoRet           AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Total do IBS monof sico retido anteriormente*/
   FIELD vCBSMonoRet           AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Total da CBS monof sica retida anteriormente*/
   FIELD vNFTot                AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Valor total da NF-e com IBS / CBS / IS*/
   */

   DEF VAR l-nao-soma-trib as log init no.
   
   assign l-nao-soma-trib = if l-transf-cred or l-ajust-compet /*or l-estorno-cred  */
                               then yes 
                               else no.
   
   IF (    TRIM(SUBSTRING(nota-fiscal.char-2,211,2)) <> "5" //Finalidade da Nota - Cr‚dito
       AND TRIM(SUBSTRING(nota-fiscal.char-2,211,2)) <> "6" //Finalidade da Nota - D‚bito
       AND CAN-FIND(FIRST ttIBSCBS
                    WHERE ttIBSCBS.CST <> "410"
                    AND   ttIBSCBS.CST <> "620"
                    AND   ttIBSCBS.CST <> ""))
   OR d-total-vIS           > 0
   OR d-total-vBCIBSCBS     > 0 
   OR d-total-vCBSMono      > 0
   OR d-total-vIBSMono      > 0
   OR d-total-vIBSMonoReten > 0
   OR d-total-vCBSMonoReten > 0
   OR d-total-vIBSMonoRet   > 0
   OR d-total-vCBSMonoRet   > 0
   OR l-transf-cred
   OR l-imunidade
   OR l-monofasico
   OR l-ajust-compet
   OR l-estorno-cred    THEN DO:

      CREATE ttTotIBSCBSIS.
      ASSIGN ttTotIBSCBSIS.vIS                  = d-total-vIS
             ttTotIBSCBSIS.vBCIBSCBS            = d-total-vBCIBSCBS
             ttTotIBSCBSIS.vDifIBSUF            = d-total-vDifIBSUF
             ttTotIBSCBSIS.vDevTribIBSUF        = d-total-vDevTribIBSUF
             ttTotIBSCBSIS.vIBSUF               = if l-nao-soma-trib then 0 else d-total-vIBSUF
             ttTotIBSCBSIS.vDifIBSMun           = d-total-vDifIBSMun
             ttTotIBSCBSIS.vDevTribIBSMun       = d-total-vDevTribIBSMun
             ttTotIBSCBSIS.vIBSMun              = if l-nao-soma-trib then 0 else d-total-vIBSMun
             ttTotIBSCBSIS.vIBS                 = if l-nao-soma-trib then 0 else d-total-vIBS
             ttTotIBSCBSIS.vCredPresIBS         = d-total-vCredPresIBS
             ttTotIBSCBSIS.vCredPresCondSusIBS  = d-total-vCredPresCondSusIBS
             ttTotIBSCBSIS.vCredPresCBS         = d-total-vCredPresCBS
             ttTotIBSCBSIS.vCredPresCondSusCBS  = d-total-vCredPresCondSusCBS
             ttTotIBSCBSIS.vDifCBS              = d-total-vDifCBS
             ttTotIBSCBSIS.vDevTribCBS          = d-total-vDevTribCBS
             ttTotIBSCBSIS.vCBS                 = if l-nao-soma-trib then 0 else d-total-vCBS
             ttTotIBSCBSIS.vIBSMono             = d-total-vIBSMono
             ttTotIBSCBSIS.vCBSMono             = d-total-vCBSMono
             ttTotIBSCBSIS.vIBSMonoReten        = d-total-vIBSMonoReten
             ttTotIBSCBSIS.vCBSMonoReten        = d-total-vCBSMonoReten
             ttTotIBSCBSIS.vIBSMonoRet          = d-total-vIBSMonoRet
             ttTotIBSCBSIS.vCBSMonoRet          = d-total-vCBSMonoRet
             ttTotIBSCBSIS.vNFTot               = d-total-vNFTot
             ttTotIBSCBSIS.vCBSEstCred          = d-total-vCBSEstCred
             ttTotIBSCBSIS.vIBSEstCred          = d-total-vIBSEstCred
      /* Chave EMS */
             ttTotIBSCBSIS.CodEstabelNF = nota-fiscal.cod-estabel
             ttTotIBSCBSIS.SerieNF      = nota-fiscal.serie
             ttTotIBSCBSIS.NrNotaFisNF  = nota-fiscal.nr-nota-fis.
   END.
       
END PROCEDURE.





