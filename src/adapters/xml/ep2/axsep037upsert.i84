PROCEDURE pi-cria-ttmed:

    /*
    === ttMed ===
     FIELD cProdANVISA    AS CHARACTER INITIAL ?                                         /*C½digo de Produto da ANVISA. Utilizar o nœmero do registro do produto da C³mara de Regula»’o do Mercado de Medicamento × CMED*/
     FIELD xMotivoIsencao AS CHARACTER INITIAL ?
     FIELD vPMC           AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99" DECIMALS 2   /*Pre»o Mÿximo ao Consumidor*/   
         */

    IF  NOT AVAIL item
    OR (AVAIL item
    AND item.it-codigo <> it-nota-fisc.it-codigo) THEN
        FOR FIRST item NO-LOCK
            WHERE item.it-codigo = it-nota-fisc.it-codigo:
        END.
    
    IF  NOT AVAIL item-dist THEN
        FOR FIRST item-dist NO-LOCK
            WHERE item-dist.it-codigo = item.it-codigo:
        END.


    IF  AVAIL item-dist
        AND (TRIM(SUBSTR(item-dist.char-2,33,13)) <> "":U) 
    THEN DO:

        CREATE ttmed.
        ASSIGN ttmed.cProdANVISA    = TRIM(SUBSTR(item-dist.char-2,33,13))
               ttmed.xMotivoIsencao = TRIM(SUBSTR(item-dist.char-2,46,55)) 
               ttmed.vPMC           = if dec(substr(it-nota-fisc.char-1,468,16)) <> 0 then dec(substr(it-nota-fisc.char-1,468,16)) else  it-nota-fisc.vl-pretab . 

        /* Chave EMS */
        ASSIGN ttmed.CodEstabelNF = it-nota-fisc.cod-estabel
               ttmed.SerieNF      = it-nota-fisc.serie
               ttmed.NrNotaFisNF  = it-nota-fisc.nr-nota-fis
               ttmed.ItCodigoNF   = it-nota-fisc.it-codigo
               ttmed.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.
     END.

END PROCEDURE.
