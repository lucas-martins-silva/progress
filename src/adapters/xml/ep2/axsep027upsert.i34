PROCEDURE pi-grava-ttICMS30:

    /*
    === ttICMS30 ===
    CST            AS CHARACTER INITIAL ?  /*Tribut‡Æo pelo ICMS 30 - Isenta ou nÆo tributada e com cobran‡a do ICMS por substitui‡Æo tribut ria */
    modBCST        AS CHARACTER INITIAL ?  /*Modalidade de determina‡Æo da BC do ICMS ST: 0 - Pre‡o tabelado ou m ximo  sugerido; 1 - Lista Negativa (valor); 2 - Lista Positiva (valor); 3 - Lista Neutra (valor); 4 - Margem Valor Agregado (%); 5 - Pauta (valor).*/
    orig           AS CHARACTER INITIAL ?  /*origem da mercadoria: 0 - Nacional 1 - Estrangeira - Importa‡Æo direta 2 - Estrangeira - Adquirida no mercado interno */
    pICMSST        AS DECIMAL   INITIAL ?  /*Al¡quota do ICMS ST*/
    pMVAST         AS DECIMAL   INITIAL ?  /*Percentual da Margem de Valor Adicionado ICMS ST*/
    pRedBCST       AS DECIMAL   INITIAL ?  /*Percentual de redu‡Æo da BC ICMS ST */
    vBCST          AS DECIMAL   INITIAL ?  /*Valor da BC do ICMS ST*/
    vICMSST        AS DECIMAL   INITIAL ?  /*Valor do ICMS ST*/
    vICMSDeson     AS DECIMAL   INITIAL ?  /*Valor do ICMS de desonera‡Æo*/ 
    motDesICMS     AS CHARACTER INITIAL ?  /*Motivo da desonera‡Æo do ICMS:6-Utilit rios Motocicleta Aµrea Livre;7-SUFRAMA;9-Outros*/
    */

    FOR FIRST item-nf-adc NO-LOCK
        WHERE item-nf-adc.cod-estab             = it-nota-fisc.cod-estabel
        AND   item-nf-adc.cod-serie             = it-nota-fisc.serie
        AND   item-nf-adc.cod-nota-fisc         = it-nota-fisc.nr-nota-fis
        AND   item-nf-adc.cdn-emitente          = nota-fiscal.cod-emitente
        AND   item-nf-adc.cod-natur-operac      = it-nota-fisc.nat-operacao
        AND   item-nf-adc.idi-tip-dado          = 1
        AND   item-nf-adc.num-seq               = 1
        AND   item-nf-adc.num-seq-item-nf       = it-nota-fisc.nr-seq-fat
        AND   item-nf-adc.cod-item              = it-nota-fisc.it-codigo:
    END.                   

    CREATE ttICMS30.
    ASSIGN ttICMS30.CST        = SUBSTRING(c-niv-trib-icms,2,2)
           ttICMS30.modBCST    = (IF c-mod-base-icms-st = "2"
                                  THEN "1"
                                  ELSE IF c-mod-base-icms-st = "3"
                                       THEN "2"
                                       ELSE IF c-mod-base-icms-st = "4"
                                            THEN "3"
                                            ELSE IF c-mod-base-icms-st = "5"
                                                 THEN "4"
                                                 ELSE IF c-mod-base-icms-st = "6"
                                                      THEN "5"
                                                      ELSE "0")
           ttICMS30.orig       = SUBSTRING(c-niv-trib-icms,1,1)
           ttICMS30.pICMSST    = IF  AVAIL item-nf-adc THEN item-nf-adc.val-aliq-icms-st ELSE 0
           ttICMS30.pMVAST     = IF  AVAIL item-nf-adc AND item-nf-adc.val-livre-1 > 0 THEN item-nf-adc.val-livre-1 ELSE DEC(SUBSTR(it-nota-fisc.char-2,338,8))
           ttICMS30.pRedBCST   = IF  AVAIL item-nf-adc AND item-nf-adc.val-livre-2 > 0 THEN item-nf-adc.val-livre-2 ELSE DEC(SUBSTR(it-nota-fisc.char-2,346,8))
           ttICMS30.vBCST      = it-nota-fisc.vl-bsubs-it
           ttICMS30.vICMSST    = it-nota-fisc.vl-icmsub-it
           ttICMS30.motDesICMS = TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2)).
		   
	   IF  r-cidade-zf <> ? AND it-nota-fisc.dec-1 > 0 THEN
		   ASSIGN ttICMS30.vICMSDeson = it-nota-fisc.dec-1
                          ttICMS30.motDesICMS = (IF TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2)) <> "":U
                                                 THEN TRIM(SUBSTRING(bf-natur-oper-it.char-1,164,2))
                                                 ELSE "7":U). /* 7 - SUFRAMA */
	   ELSE 	   
		   ASSIGN ttICMS30.vICMSDeson = d-vl-desc-icms. 
			   
           /*OBS.:
           O CST 30 s¢ aceita os motivos de desonera‡Æo
           6=Utilit rios e Motocicletas da Amaz“nia Ocidental e µreas de Livre Com‚rcio (Resolu‡Æo 714/88 e 790/94 Î CONTRAN e suas altera‡äes);
           7=SUFRAMA;
           9=Outros;
           */

    /* Chave EMS */
    ASSIGN ttICMS30.CodEstabelNF = nota-fiscal.cod-estabel
           ttICMS30.SerieNF      = nota-fiscal.serie
           ttICMS30.NrNotaFisNF  = nota-fiscal.nr-nota-fis
           ttICMS30.ItCodigoNF   = it-nota-fisc.it-codigo
           ttICMS30.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.

END PROCEDURE.
