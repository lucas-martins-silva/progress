PROCEDURE pi-retornaXMLNFe :
    &IF INTEGER(ENTRY(1,PROVERSION,".")) >= 10 &THEN
        DEFINE OUTPUT PARAMETER plcXMLNFe AS LONGCHAR NO-UNDO.
    
        ASSIGN plcXMLNFe = lcXMLNFe.
    &ELSE
        DEFINE OUTPUT PARAMETER plcXMLNFe AS CHAR NO-UNDO.

        ASSIGN plcXMLNFe = "".
    &ENDIF
END PROCEDURE.