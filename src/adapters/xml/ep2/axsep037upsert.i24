PROCEDURE pi-narrativa-item:

    /*------  PESQUISA A DESCRICAO DO PRODUTO  ------ */

    DEF VAR c-info-onu   AS CHARACTER FORMAT "X(256)" NO-UNDO.
    DEF VAR l-quant-ltda AS LOGICAL                   NO-UNDO.
              
    if item.ind-imp-desc = 1 then /* Descri‡Æo */
        assign c-desc-prod = item.desc-item.
    
    if  item.ind-imp-desc = 2           /* Descri‡Æo + Narrativa */
    or  item.ind-imp-desc = 5           /* Narrativa Item */
    or  item.ind-imp-desc = 6           /* Uma Linha Narrativa */
    or  item.ind-imp-desc = 10 then do: /* Descri‡Æo + 24 Narrativa Item */
    
        if  item.ind-imp-desc = 2
        or  item.ind-imp-desc = 10 then
            assign c-desc-prod = item.desc-item + " ".
        else 
            assign c-desc-prod = "".
    
        find narrativa of item no-lock no-error.
    
        if avail narrativa then 
           assign c-desc-prod = c-desc-prod +
                                if  item.ind-imp-desc = 6 then
                                    trim(entry(1,substring(narrativa.descricao,1,76),chr(10)))
                                else if item.ind-imp-desc = 10 then
                                    trim(entry(1,substring(narrativa.descricao,1,24),chr(10)))
                                else                        
                                    narrativa.descricao.
    end.
    
    if  item.ind-imp-desc = 3          /* Descri‡Æo + Narrativa Item/Cliente */
    or  item.ind-imp-desc = 8 then do: /* Descri‡Æo + 24 Narrativa Item/Cliente */
        
		find first item-cli
             where item-cli.nome-abrev   = nota-fiscal.nome-ab-cli
               and item-cli.it-codigo    = it-nota-fisc.it-codigo
			   and item-cli.unid-med-cli = it-nota-fisc.un-fatur[2] no-lock no-error.
    
        assign c-desc-prod = item.desc-item + " ".
    
        if  avail item-cli then
            assign c-desc-prod = c-desc-prod +
                                 if item.ind-imp-desc = 3 then          
                                    item-cli.narrativa
                                 else
                                    trim(entry(1,substring(item-cli.narrativa,1,24),chr(10))).
    end.
    
    if  item.ind-imp-desc = 4            /* Descri‡Æo + Narrativa Informada */
    or  item.ind-imp-desc = 7            /* Narrativa Informada */
    or  item.ind-imp-desc = 9 then do:   /* Descri‡Æo + 24 Narrativa Informada */
    
        if  item.ind-imp-desc = 4
        or  item.ind-imp-desc = 9 then
            assign c-desc-prod = item.desc-item + " ".
        else 
            assign c-desc-prod = "".
    
        find nar-it-nota
             where nar-it-nota.cod-estabel  = it-nota-fisc.cod-estabel
             and   nar-it-nota.serie        = it-nota-fisc.serie
             and   nar-it-nota.nr-nota-fis  = it-nota-fisc.nr-nota-fis
             and   nar-it-nota.nr-sequencia = it-nota-fisc.nr-seq-fat
             and   nar-it-nota.it-codigo    = it-nota-fisc.it-codigo
             no-lock no-error.
    
        if avail nar-it-nota then 
           assign c-desc-prod = c-desc-prod +
                                if item.ind-imp-desc = 9 then
                                   trim(entry(1,substring(nar-it-nota.narrativa,1,24),chr(10)))
                                else
                                   nar-it-nota.narrativa.
    end.

    ASSIGN l-quant-ltda = NO.
    FOR FIRST item-dist                                                                                                       
        WHERE item-dist.it-codigo = item.it-codigo NO-LOCK:                                                                                                                                                                                                           
        IF item-dist.cdn-onu <> 0 THEN                                                                                        
            ASSIGN c-info-onu = c-info-onu + " ONU " + STRING(item-dist.cdn-onu,"9999").
            
        IF item-dist.nom-apropdo-embal <> "" THEN
            ASSIGN c-info-onu = c-info-onu + " " + item-dist.nom-apropdo-embal.
            
        /*** Regulamenta‡Æo ANTT 5332 ***/

        FOR FIRST reg-inf-compl NO-LOCK
            WHERE reg-inf-compl.cod-tab-inform   = "item-dist"
              AND reg-inf-compl.cod-campo-inform = "tb-quant-ltda",
            FIRST inf-compl NO-LOCK
            WHERE inf-compl.cdn-identif = reg-inf-compl.cdn-identif
              AND inf-compl.cod-indice  = item-dist.it-codigo:
    
            IF inf-compl.des-campo = "S" THEN
                ASSIGN l-quant-ltda = YES.
        END.

        IF NOT l-quant-ltda THEN DO:
            FOR FIRST reg-inf-compl NO-LOCK
                WHERE reg-inf-compl.cod-tab-inform   = "item-dist"
                  AND reg-inf-compl.cod-campo-inform = "d-peso-quant-ltda",
                FIRST inf-compl NO-LOCK
                WHERE inf-compl.cdn-identif = reg-inf-compl.cdn-identif
                  AND inf-compl.cod-indice  = item-dist.it-codigo:
        
                IF it-nota-fisc.peso-bruto < dec(inf-compl.des-campo) THEN
                    ASSIGN l-quant-ltda = YES. 
            END.
        END.

        IF l-quant-ltda THEN
           ASSIGN c-info-onu = c-info-onu + " QUANT. LTDA ".
           
        IF item-dist.cod-class-risco <> "" THEN
            ASSIGN c-info-onu = c-info-onu + " " + item-dist.cod-class-risco.
        IF item-dist.cod-grp-embal <> "" THEN
            ASSIGN c-info-onu = c-info-onu + " " + item-dist.cod-grp-embal.
            
        IF l-quant-ltda AND (it-nota-fisc.peso-bruto > 0 and it-nota-fisc.peso-bruto <> ?) AND it-nota-fisc.un-fatur[2] <> "kg" THEN /* Imprimir somente quando a UM nÆo for kilo. Quando for, j  tem campo pr¢prio no XML da NF-e */
           ASSIGN c-info-onu = c-info-onu + " " + trim(string(it-nota-fisc.peso-bruto,">>>>>>>>>>>>>>9.99<<<<<<<<")) + " KG".

        IF item-dist.des-pto-fulgor <> "" THEN
           ASSIGN c-info-onu = c-info-onu + " " + item-dist.des-pto-fulgor.
            
    END.
    
    IF c-info-onu <> "" THEN                                                                                   
        ASSIGN c-desc-prod = (c-info-onu + "." + chr(197)) + " " + c-desc-prod .       
    
    /* Novo Ponto EPC Vipal */
   
    IF c-nom-prog-dpc-mg97  <> "" OR 
       c-nom-prog-appc-mg97 <> "" OR
       c-nom-prog-upc-mg97  <> "" THEN DO:

        FOR EACH tt-epc 
           WHERE tt-epc.cod-event = "AtualizaDadosXProd":U :
            DELETE tt-epc.
        END.
               
        CREATE tt-epc.
        ASSIGN tt-epc.cod-event     = "AtualizaDadosXProd":U
               tt-epc.cod-parameter = "rowid-it-nota-fisc":U
               tt-epc.val-parameter = string(rowid(it-nota-fisc)).
            	   
        CREATE tt-epc.
        ASSIGN tt-epc.cod-event     = "AtualizaDadosXProd":U
               tt-epc.cod-parameter = "c-desc-prod":U
               tt-epc.val-parameter = c-desc-prod.
            	   
        {include/i-epc201.i "AtualizaDadosXProd"}
               
        find first tt-epc no-lock
             where tt-epc.cod-event     = "AtualizaDadosXProd":U
               and tt-epc.cod-parameter = "c-desc-prod":U no-error.
        if avail tt-epc then do:
            assign c-desc-prod = tt-epc.val-parameter.
        end.
    END.	
    /* Novo Ponto EPC Vipal */	
END PROCEDURE.


