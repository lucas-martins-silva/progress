PROCEDURE pi-cria-ttComb:

    /*
    === ttComb ===
    cProdANP       AS CHARACTER INITIAL ?                                         /*C¢digo de produto da ANP Informar apenas quando se tratar de produtos regulados pela ANP - Agˆncia Nacional do Petr¢leo. Utilizar a codifica‡Æo de produtos do Sistema de Informa‡äes de Movimenta‡Æo de produtos - SIMP (http://www.anp.gov.br/simp/index.htm)*/
    descANP        AS CHARACTER INITIAL ?                                         /*Descri‡Æo do produto conforme ANP. Utilizar a descri‡Æo de produtos do Sistema de Informa‡äes de Movimenta‡Æo de Produtos - SIMP (http://www.anp.gov.br/simp/)*/
    pGLP           AS DECIMAL   INITIAL ?  FORMAT ">.9999"             DECIMALS 4 /*Percentual do GLP derivado do petr¢leo no produto GLP*/ 
    pGNn           AS DECIMAL   INITIAL ?  FORMAT ">.9999"             DECIMALS 4 /*Percentual de G s Natural Nacional Î GLGNn para o produto GLP*/ 
    pGNi           AS DECIMAL   INITIAL ?  FORMAT ">.9999"             DECIMALS 4 /*Percentual de G s Natural Importado Î GLGNi para o produto GLP*/ 
    vPart          AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99"   DECIMALS 2 /*Valor de partida. Deve ser informado neste campo o valor por quilograma sem ICMS*/
    CODIF          AS CHARACTER INITIAL ?                                         /*C¢digo de autoriza‡Æo / registro do CODIF. Informar apenas quando a UF utilizar o CODIF (Sistema de Controle do Diferimento do Imposto nas Opera‡äes com AEAC - µlcool Et¡lico Anidro Combust¡vel).*/
    qTemp          AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>9.9999"  DECIMALS 4 /*Quantidade de combust¡vel faturada - temperatura ambiente. Informar quando a quantidade faturada informada no campo qCom (I10) tiver sido ajustada para uma temperatura diferente da ambiente.*/ 
    UFCons         AS CHARACTER INITIAL ?                                         /*Sigla da UF Dest*/
    /*CIDE*/
    qBCProd        AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>9.9999"  DECIMALS 4 /*BC do CIDE ( Quantidade comercializada) */  
    vAliqProd      AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>9.9999"   DECIMALS 4 /*Al¡quota do CIDE  (em reais)*/ 
    vCIDE          AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>>9.99"   DECIMALS 2 /*Valor do CIDE*/ 
    /*encerrante*/
    nBico          AS CHARACTER INITIAL ?                                         /*N£mero do bico utilizado no abastecimento*/
    nBomba         AS CHARACTER INITIAL ?                                         /*Caso exista, informar o n£mero da bomba utilizada*/
    nTanque        AS CHARACTER INITIAL ?                                         /*N£mero do tanque utilizado*/
    vEncIni        AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>9.999"   DECIMALS 3 /*Valor da leitura do contador (Encerrante) no in¡cio do abastecimento*/
    vEncFin        AS DECIMAL   INITIAL ?  FORMAT ">>>>>>>>>>>9.999"   DECIMALS 3 /*Valor da leitura do contador (Encerrante) no t‚rmino do abastecimento*/
    */
    DEF BUFFER bf-unid-feder FOR unid-feder.

    IF  NOT AVAIL item
    OR (AVAIL item
    AND item.it-codigo <> it-nota-fisc.it-codigo) THEN
        FOR FIRST item NO-LOCK
            WHERE item.it-codigo = it-nota-fisc.it-codigo:
        END.
        
    IF  AVAIL item
    AND (TRIM(SUBSTR(item.char-1,268,20)) <> "":U
    AND  TRIM(SUBSTR(item.char-1,268,20)) <> "0":U) THEN DO:
             
        IF  NOT AVAIL ttDest THEN
            FIND FIRST ttDest NO-LOCK NO-ERROR.
             
        IF  NOT AVAIL ttEntrega THEN
            FIND FIRST ttEntrega NO-LOCK NO-ERROR.

        FOR FIRST param-gener NO-LOCK
            WHERE param-gener.cod-chave-1 = TRIM(SUBSTRING(item.char-1,268,20))
              AND param-gener.cod-param   = "infANP-CD0618":U:
        END.        
        
        FOR FIRST param-monofasico NO-LOCK
            WHERE param-monofasico.cod-anp = TRIM(SUBSTRING(item.char-1,268,20)):
        END.        

        IF  NOT AVAIL item-dist THEN
            FOR FIRST item-dist NO-LOCK
                WHERE item-dist.it-codigo = item.it-codigo:
            END.             


        CREATE ttComb.
        ASSIGN ttComb.cProdANP      = TRIM(SUBSTR(item.char-1,268,20))
               ttComb.descANP       = (IF AVAIL param-gener AND TRIM(param-gener.cod-livre-1) <> "":U
                                       THEN TRIM(param-gener.cod-livre-1)
                                       ELSE "":U)
               ttComb.pGLP          = (IF AVAIL item-dist
                                       THEN DEC(TRIM(SUBSTRING(item-dist.char-1,31,8)))
                                       ELSE 0)
               ttComb.pGNn          = (IF AVAIL item-dist
                                       THEN DEC(TRIM(SUBSTRING(item-dist.char-1,39,8)))
                                       ELSE 0)
               ttComb.pGNi          = (IF AVAIL item-dist
                                       THEN DEC(TRIM(SUBSTRING(item-dist.char-1,47,8)))
                                       ELSE 0)
               ttComb.vPart         = (IF AVAIL item-dist
                                       THEN DEC(TRIM(SUBSTRING(item-dist.char-1,55,16)))
                                       ELSE 0)
               ttComb.UFCons        = IF AVAIL ttEntrega AND ttEntrega.UF <> ttDest.UF
                                      THEN ttEntrega.UF
                				      ELSE ttDest.UF
               ttComb.pBio          = if avail param-monofasico then param-monofasico.perc-pbio else 0
               .

        FOR EACH item-nf-adc NO-LOCK
           WHERE item-nf-adc.cod-estab               = it-nota-fisc.cod-estabel
             AND item-nf-adc.cod-serie               = it-nota-fisc.serie             
             AND item-nf-adc.cod-nota-fisc           = it-nota-fisc.nr-nota-fis              
             AND item-nf-adc.cdn-emitente            = nota-fiscal.cod-emitente              
             AND item-nf-adc.cod-natur-operac        = it-nota-fisc.nat-operacao              
             AND item-nf-adc.idi-tip-dado            = 37                                  
             AND item-nf-adc.num-seq-item-nf         = (if it-nota-fisc.nr-seq-ped > 0 then it-nota-fisc.nr-seq-ped 
                                                       else it-nota-fisc.nr-seq-fat)           
             AND item-nf-adc.cod-item                = it-nota-fisc.it-codigo:
              
                FOR FIRST bf-unid-feder
                    WHERE bf-unid-feder.pais   = "Brasil"
                      AND bf-unid-feder.estado = item-nf-adc.cod-livre-1:
                END.               
                
                CREATE ttOrigComb.
                ASSIGN ttOrigComb.indimport   = STRING(item-nf-adc.num-livre-1)  
                       ttOrigComb.cUFOrig     = bf-unid-feder.cod-uf-ibge when avail bf-unid-feder
                       ttOrigComb.pOrig       = DEC(item-nf-adc.val-livre-1). 
                       
                 ASSIGN ttOrigComb.CodEstabelNF = item-nf-adc.cod-estab 
                        ttOrigComb.SerieNF      = item-nf-adc.cod-serie        
                        ttOrigComb.NrNotaFisNF  = item-nf-adc.cod-nota-fisc  
                        ttOrigComb.ItCodigoNF   = item-nf-adc.cod-item    
                        ttOrigComb.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.        
                                        
        END.       
        
        /* Chave EMS */
        ASSIGN ttComb.CodEstabelNF = it-nota-fisc.cod-estabel
               ttComb.SerieNF      = it-nota-fisc.serie
               ttComb.NrNotaFisNF  = it-nota-fisc.nr-nota-fis
               ttComb.ItCodigoNF   = it-nota-fisc.it-codigo
               ttComb.NrSeqFatNF   = it-nota-fisc.nr-seq-fat.
    END.

END PROCEDURE.
