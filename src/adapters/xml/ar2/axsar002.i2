PROCEDURE SendMessageByItemRowid:

    /*--- Procedimento respons†vel por gerar os dados necess†rios do item (a partir do rowid do item enviado pelo programa executor) 
          para a criaá∆o/efetivaá∆o do envio da mensagem (ao final desta procedure Ç chamada a SendMessage) --*/

    DEFINE INPUT PARAM pr-item AS ROWID NO-UNDO.

    FOR EACH tt-item:
        DELETE tt-item.
    END.
    FOR EACH tt-item-estab:
        DELETE tt-item-estab.
    END.
    FOR EACH tt-saldo-custo:
        DELETE tt-saldo-custo.
    END.

    IF  NOT AVAIL param-estoq THEN
        FIND FIRST param-estoq NO-LOCK NO-ERROR.

    FOR FIRST item FIELDS(it-codigo desc-item data-base preco-base dt-pr-fisc preco-fiscal data-ult-rep preco-repos data-ult-ent preco-ul-ent)
        WHERE ROWID(item) = pr-item NO-LOCK:

        CREATE tt-item.
        ASSIGN tt-item.it-codigo	= item.it-codigo
               tt-item.desc-item	= item.desc-item
               tt-item.data-base	= if item.data-base = ?
                                      then today
                                      else item.data-base
               tt-item.preco-base	= item.preco-base
               tt-item.dt-pr-fisc	= if item.dt-pr-fisc = ?
                                      then today
                                      else item.dt-pr-fisc
               tt-item.preco-fiscal	= item.preco-fiscal
               tt-item.data-ult-rep	= if item.data-ult-rep = ?
                                      then today
                                      else item.data-ult-rep
               tt-item.preco-repos	= item.preco-repos
               tt-item.data-ult-ent	= if item.data-ult-ent = ?
                                      then today
                                      else item.data-ult-ent
               tt-item.preco-ul-ent	= item.preco-ul-ent
               tt-item.mo-codigo[1]	= 0 /* moeda padr∆o do sistema */
               tt-item.mo-codigo[2] = if param-estoq.tem-moeda1
                                      then param-estoq.moeda1
                                      else 0
               tt-item.mo-codigo[3] = if param-estoq.tem-moeda2
                                      then param-estoq.moeda2
                                      else 0
               tt-item.tem-moeda1	= param-estoq.tem-moeda1
               tt-item.tem-moeda2	= param-estoq.tem-moeda2.

        FOR FIRST moeda FIELDS(descricao sigla)
            WHERE moeda.mo-codigo = tt-item.mo-codigo[1] NO-LOCK:
            ASSIGN tt-item.mo-desc[1]  = moeda.descricao
                   tt-item.mo-sigla[1] = moeda.sigla.
        END.
        FOR FIRST moeda FIELDS(descricao sigla)
            WHERE moeda.mo-codigo = tt-item.mo-codigo[2]
            AND   param-estoq.tem-moeda1 NO-LOCK:
            ASSIGN tt-item.mo-desc[2]  = moeda.descricao
                   tt-item.mo-sigla[2] = moeda.sigla.
        END.
        FOR FIRST moeda FIELDS(descricao sigla)
            WHERE moeda.mo-codigo = tt-item.mo-codigo[3]
            AND   param-estoq.tem-moeda2 NO-LOCK:
            ASSIGN tt-item.mo-desc[3]  = moeda.descricao
                   tt-item.mo-sigla[3] = moeda.sigla.
        END.

        /* Informaá‰es Item-Estab */
        FOR EACH item-uni-estab FIELDS(cod-estabel data-base preco-base dt-pr-fisc preco-fiscal 
                                       data-ult-rep preco-repos data-ult-ent preco-ul-ent
                                       &if '{&BF_MAT_VERSAO_EMS}' <= '2.04' &then
                                       &else 
                                           metodo-custeio
                                       &endif)
           WHERE item-uni-estab.it-codigo = item.it-codigo NO-LOCK:

            FOR FIRST estabelec FIELDS(nome custo-contab usa-mensal usa-padrao usa-on-line)
                WHERE estabelec.cod-estabel = item-uni-estab.cod-estabel NO-LOCK:
            END.
            IF  NOT AVAIL estabelec THEN
                NEXT.

            CREATE tt-item-estab.
            ASSIGN tt-item-estab.it-codigo	  = item.it-codigo
                   tt-item-estab.cod-estabel  = item-uni-estab.cod-estabel
                   tt-item-estab.data-base	  = if item-uni-estab.data-base = ?
                                                then today
                                                else item-uni-estab.data-base
                   tt-item-estab.preco-base	  = item-uni-estab.preco-base
                   tt-item-estab.dt-pr-fisc	  = if item-uni-estab.dt-pr-fisc = ?
                                                then today
                                                else item-uni-estab.dt-pr-fisc
                   tt-item-estab.preco-fiscal = item-uni-estab.preco-fiscal
                   tt-item-estab.data-ult-rep = if item-uni-estab.data-ult-rep = ?
                                                then today
                                                else item-uni-estab.data-ult-rep
                   tt-item-estab.preco-repos  = item-uni-estab.preco-repos
                   tt-item-estab.data-ult-ent = if item-uni-estab.data-ult-ent = ?
                                                then today
                                                else item-uni-estab.data-ult-ent
                   tt-item-estab.preco-ul-ent = item-uni-estab.preco-ul-ent
                   tt-item-estab.usa-mensal   = estabelec.usa-mensal
                   tt-item-estab.desc-estabel = estabelec.nome
                   tt-item-estab.usa-padrao   = estabelec.usa-padrao
                   tt-item-estab.usa-on-line  = estabelec.usa-on-line.

            FOR FIRST item-estab FIELDS(mensal-ate val-unit-mat-m val-unit-mob-m val-unit-ggf-m on-line-ate val-unit-mat-o 
                                        val-unit-mob-o val-unit-ggf-o padrao-ate val-unit-mat-p val-unit-mob-p val-unit-ggf-p)
                WHERE item-estab.it-codigo   = item.it-codigo
                AND   item-estab.cod-estabel = item-uni-estab.cod-estabel NO-LOCK:
            END.
            IF  AVAIL item-estab THEN
                ASSIGN tt-item-estab.mensal-ate	       = if item-estab.mensal-ate = ?
                                                         then today
                                                         else item-estab.mensal-ate
                       tt-item-estab.val-unit-mat-m[1] = item-estab.val-unit-mat-m[1]
                       tt-item-estab.val-unit-mat-m[2] = item-estab.val-unit-mat-m[2]
                       tt-item-estab.val-unit-mat-m[3] = item-estab.val-unit-mat-m[3]
                       tt-item-estab.val-unit-mob-m[1] = item-estab.val-unit-mob-m[1]
                       tt-item-estab.val-unit-mob-m[2] = item-estab.val-unit-mob-m[2]
                       tt-item-estab.val-unit-mob-m[3] = item-estab.val-unit-mob-m[3]
                       tt-item-estab.val-unit-ggf-m[1] = item-estab.val-unit-ggf-m[1]
                       tt-item-estab.val-unit-ggf-m[2] = item-estab.val-unit-ggf-m[2]
                       tt-item-estab.val-unit-ggf-m[3] = item-estab.val-unit-ggf-m[3]
                       tt-item-estab.on-line-ate	   = if item-estab.on-line-ate = ?
                                                         then today
                                                         else item-estab.on-line-ate
                       tt-item-estab.val-unit-mat-o[1] = item-estab.val-unit-mat-o[1]
                       tt-item-estab.val-unit-mat-o[2] = item-estab.val-unit-mat-o[2]
                       tt-item-estab.val-unit-mat-o[3] = item-estab.val-unit-mat-o[3]
                       tt-item-estab.val-unit-mob-o[1] = item-estab.val-unit-mob-o[1]
                       tt-item-estab.val-unit-mob-o[2] = item-estab.val-unit-mob-o[2]
                       tt-item-estab.val-unit-mob-o[3] = item-estab.val-unit-mob-o[3]
                       tt-item-estab.val-unit-ggf-o[1] = item-estab.val-unit-ggf-o[1]
                       tt-item-estab.val-unit-ggf-o[2] = item-estab.val-unit-ggf-o[2]
                       tt-item-estab.val-unit-ggf-o[3] = item-estab.val-unit-ggf-o[3]
                       tt-item-estab.padrao-ate	       = if item-estab.padrao-ate = ?
                                                         then today
                                                         else item-estab.padrao-ate
                       tt-item-estab.val-unit-mat-p[1] = item-estab.val-unit-mat-p[1]
                       tt-item-estab.val-unit-mat-p[2] = item-estab.val-unit-mat-p[2]
                       tt-item-estab.val-unit-mat-p[3] = item-estab.val-unit-mat-p[3]
                       tt-item-estab.val-unit-mob-p[1] = item-estab.val-unit-mob-p[1]
                       tt-item-estab.val-unit-mob-p[2] = item-estab.val-unit-mob-p[2]
                       tt-item-estab.val-unit-mob-p[3] = item-estab.val-unit-mob-p[3]
                       tt-item-estab.val-unit-ggf-p[1] = item-estab.val-unit-ggf-p[1]
                       tt-item-estab.val-unit-ggf-p[2] = item-estab.val-unit-ggf-p[2]
                       tt-item-estab.val-unit-ggf-p[3] = item-estab.val-unit-ggf-p[3].

            &if '{&BF_MAT_VERSAO_EMS}' <= '2.04' &then
                ASSIGN tt-item-estab.custo-contab = if estabelec.custo-contab = 0
                                                    then 1
                                                    else estabelec.custo-contab
                       tt-item-estab.tipo-pr-med  = param-estoq.tipo-pr-med.
            &else /* Somente a partir da 2.04B */
                FOR FIRST estab-mat FIELDS(custo-contab tipo-pr-med)
                    WHERE estab-mat.cod-estabel = item-uni-estab.cod-estabel NO-LOCK:
                    ASSIGN tt-item-estab.custo-contab   = estab-mat.custo-contab
                           tt-item-estab.tipo-pr-med    = estab-mat.tipo-pr-med.
                END.
                ASSIGN tt-item-estab.metodo-custeio = if item-uni-estab.metodo-custeio = 0
                                                      then 1
                                                      else item-uni-estab.metodo-custeio.
            &endif

            /*--- Conforme RE-Homologaá∆o da engenharia em 08/03/2004, n∆o ser∆o tratados os dados do custo ---

            /* Informaá‰es Saldo-Custo (Somente a partir da 2.04B) */
            &if '{&BF_MAT_VERSAO_EMS}' <= '2.04' &then
            &else
                FOR EACH saldo-custo FIELDS(seq-custeio cod-refer lote qt-original qt-saldo valor-ori-mat 
                                            valor-ori-mob valor-ori-ggf saldo-mat saldo-mob saldo-ggf)
                   WHERE saldo-custo.it-codigo   = item-uni-estab.it-codigo
                   AND   saldo-custo.cod-estabel = item-uni-estab.cod-estabel NO-LOCK:

                    CREATE tt-saldo-custo.
                    ASSIGN tt-saldo-custo.it-codigo	       = item.it-codigo
                           tt-saldo-custo.cod-estabel	   = item-uni-estab.cod-estabel
                           tt-saldo-custo.seq-custeio	   = saldo-custo.seq-custeio
                           tt-saldo-custo.cod-refer	       = saldo-custo.cod-refer  
                           tt-saldo-custo.lote	           = saldo-custo.lote                
                           tt-saldo-custo.qt-original	   = saldo-custo.qt-original         
                           tt-saldo-custo.qt-saldo	       = saldo-custo.qt-saldo            
                           tt-saldo-custo.valor-ori-mat[1] = saldo-custo.valor-ori-mat[1]
                           tt-saldo-custo.valor-ori-mob[1] = saldo-custo.valor-ori-mob[1]
                           tt-saldo-custo.valor-ori-ggf[1] = saldo-custo.valor-ori-ggf[1]
                           tt-saldo-custo.valor-ori-mat[2] = saldo-custo.valor-ori-mat[2]
                           tt-saldo-custo.valor-ori-mob[2] = saldo-custo.valor-ori-mob[2]
                           tt-saldo-custo.valor-ori-ggf[2] = saldo-custo.valor-ori-ggf[2]
                           tt-saldo-custo.valor-ori-mat[3] = saldo-custo.valor-ori-mat[3]
                           tt-saldo-custo.valor-ori-mob[3] = saldo-custo.valor-ori-mob[3]
                           tt-saldo-custo.valor-ori-ggf[3] = saldo-custo.valor-ori-ggf[3]
                           tt-saldo-custo.saldo-mat[1]	   = saldo-custo.saldo-mat[1]
                           tt-saldo-custo.saldo-mob[1]	   = saldo-custo.saldo-mob[1]
                           tt-saldo-custo.saldo-ggf[1]	   = saldo-custo.valor-ori-ggf[1]
                           tt-saldo-custo.saldo-mat[2]	   = saldo-custo.saldo-mat[2]
                           tt-saldo-custo.saldo-mob[2]	   = saldo-custo.saldo-mob[2]
                           tt-saldo-custo.saldo-ggf[2]	   = saldo-custo.valor-ori-ggf[2]
                           tt-saldo-custo.saldo-mat[3]	   = saldo-custo.saldo-mat[3]
                           tt-saldo-custo.saldo-mob[3]	   = saldo-custo.saldo-mob[3]
                           tt-saldo-custo.saldo-ggf[3]	   = saldo-custo.valor-ori-ggf[3].

                    FOR FIRST referencia FIELDS(descricao)
                        WHERE referencia.cod-refer = saldo-custo.cod-refer NO-LOCK:
                        ASSIGN tt-saldo-custo.desc-refer = referencia.descricao.
                    END.
                END.
            &endif
            ----*/
        END. /* FIM for each item-uni-estab */
    END. /* FIM for first item */

    RUN SendMessage IN THIS-PROCEDURE (INPUT TABLE tt-item,
                                       INPUT TABLE tt-item-estab,
                                       INPUT TABLE tt-saldo-custo).

    RETURN return-value.

END PROCEDURE.
