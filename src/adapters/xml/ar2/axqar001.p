                                       delStack().

                                       RUN addNode    IN hGenXml (getStack(), "BalanceCosting":U,"":U, OUTPUT iId).
                                       addStack(iId).
                                       DO  iCont = 1 TO 3:
                                           /* Cria a cole‡Æo das moedas alternativas somente quando estiver parametrizado (param-estoq.tem-moeda1, param-estoq.tem-moeda2) */
                                           if  (iCont = 2 and not tt-item.tem-moeda1) or  (iCont = 3 and not tt-item.tem-moeda2) THEN next.
                                           RUN addNode    IN hGenXml (getStack(), "UnitValues":U,"":U, OUTPUT iId).
                                           addStack(iId).
                                             RUN addNodeDec  IN hGenXml (getStack(), "Sequence":U,iCont,                                OUTPUT iId).
                                             RUN addNodeDec  IN hGenXml (getStack(), "MaterialValue":U,tt-saldo-custo.saldo-mat[iCont], OUTPUT iId).
                                             RUN addNodeDec  IN hGenXml (getStack(), "LaborValue":U,tt-saldo-custo.saldo-mob[iCont],    OUTPUT iId).
                                             RUN addNodeDec  IN hGenXml (getStack(), "OverHeadValue":U,tt-saldo-custo.saldo-ggf[iCont], OUTPUT iId).

                                             RUN addNode     IN hGenXml (getStack(),"Currency":U,"":U, OUTPUT iId).
                                             addStack(iId).
                                               RUN addNodeDec  IN hGenXml (getStack(),"CurrencyID":U,          tt-item.mo-codigo[iCont],        OUTPUT iId).
                                               RUN addNode     IN hGenXml (getStack(),"CurrencyDescription":U, tt-item.mo-desc[iCont],          OUTPUT iId).
                                               RUN addNode     IN hGenXml (getStack(),"CurrencySign":U,        string(tt-item.mo-sigla[iCont]), OUTPUT iId).
                                               RUN addNodeLog  IN hGenXml (getStack(),"IsDefaultCurrency":U,   if   iCont = 1 then 
                                                                                                                    TRUE
                                                                                                               else FALSE, OUTPUT iId).
                                             delStack().
                                           delStack().
                                       END.
                                       delStack().

                                     delStack().
                                 END. /* fim for each tt-saldo-custo */
                                 delStack().
                             END. /* if avail tt-saldo-custo */
                       delStack().
                   END. /* fim for each tt-item-estab */ 
                   delStack().
               END. /* if avail tt-item-uni-estab */
             delStack().
        END. /* FIM for each tt-item */
     delStack().
      /* OBTEM O XML NUMA HANDLE */
     RUN generateXML IN hGenXml (OUTPUT hQueryReturnContent). /* gera XML */
     
/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.


PROCEDURE receiveMessage:

/*PARAMETERS - BEGIN*/
DEFINE INPUT PARAM hInputXML AS HANDLE NO-UNDO.
DEFINE OUTPUT PARAM hOutputXML AS HANDLE NO-UNDO.
/*PARAMETERS - END*/

/*LOCAL VARIABLES - BEGIN*/
/*LOCAL VARIABLES - END*/


