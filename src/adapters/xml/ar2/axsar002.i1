{include/i_dbvers.i}

PROCEDURE SendMessage:

    /*--- Procedimento respons vel por receber os dados necess rios do item (temp-tables enviadas)
          para a cria‡Æo/efetiva‡Æo do envio da mensagem --*/

    DEFINE INPUT PARAM TABLE FOR tt-item.
    DEFINE INPUT PARAM TABLE FOR tt-item-estab.
    DEFINE INPUT PARAM TABLE FOR tt-saldo-custo.

    /* Verifica se MessageHandler.p est  na mem¢ria */
    {xmlinc/xmlloadmessagehandler.i &MessageHandler="hMessageHandler" &MHReturnValue="cMHReturnValue"}

    FOR EACH rowErrors:
        DELETE rowErrors.
    END.

    /* Verifica se h  registros na temp-table */
    IF  NOT CAN-FIND(FIRST tt-item) THEN DO:
        RUN piCriaErro (5561,
                        'EMS':U, 
                        'de item' + '~~~~' + 'O adapter sender EAI AXSAR002 nÆo recebeu nenhum item como parƒmetro de envio. A execu‡Æo da integra‡Æo foi abortada').
        RETURN "NOK":U.
        LEAVE.
    END.

    /* Verifica se o MessageHandler foi executado corretamente */
    IF  cMHReturnValue <> "OK":U THEN DO:
        IF  cMHReturnValue <> ? AND cMHReturnValue <> " " THEN DO:
            RUN piCriaErro (17006,
                            'EMS':U, 
                            cMHReturnValue).
            RETURN "NOK":U.
            LEAVE.
        END.
    END.

    /* Verifica se h  programas inscritos */
    RUN isSubscribed IN hMessageHandler (INPUT "{&XmlProdName}",
                                         INPUT "{&XmlApp}",
                                         INPUT "{&XmlTranName}",
                                         INPUT "{&XmlTranVersion}",
                                         INPUT "",
                                         INPUT "upd", /* Valor fixo "UPD". Caso em particular de mensagem de atualiza‡Æo */
                                         OUTPUT lCREATEMsg).

    /* Verifica se a transa‡Æo ‚ assinada */
    IF  NOT lCREATEMsg THEN
        RETURN "OK":U.

    /* Preenche o valor do elemento Comment de TransactionId */
    RUN setTransInfoComment IN hMessageHandler ("Program:" + pProgName + "-" +
                                                "Version:" + pProgVersion). 

    /* Seta SystemID */
    RUN setSystemId IN hMessageHandler ("{&pXmlMod}" ,        /* Nome do modulo     */
                                        "{&XmlProdVersion}"). /* Versao do Programa */

    /* Seta a empresa e o estabelecimento */
    RUN setCompanyId IN hMessageHandler (STRING(v_cdn_empres_usuar), ""). 

    /* Verifica se o ut-genxml foi executado corretamente */
    IF  cGXReturnValue <> "OK":U THEN DO:
        IF  cGXReturnValue <> ? AND cGXReturnValue <> "" THEN DO:
            RUN piCriaErro (17006,
                            'EMS':U, 
                            cGXReturnValue).
            RETURN "NOK":U.
            LEAVE.
        END.
    END.

    FOR EACH tt-item NO-LOCK:

        /* Indica valor da chave prim ria da transa‡Æo */
        RUN setKeyFields IN hMessageHandler ("item.it-codigo",
                                             STRING(tt-item.it-codigo)). 

        /* Cria mensagem do BusinessContent atrav‚s da API*/
        CREATE-BUSINESS-XML:
        DO:
            /* RESETA OS VALORES */
            RUN reset IN hGenXml.

            /* SETA VALOR DE ENCODING */
            RUN setEncoding IN hGenXml ("UTF-8").

            /* Nà PRINCIPAL UPSERT */
            RUN addNode IN hGenXml (0,
                                    "Upsert",
                                    "",
                                    OUTPUT iFirstId).

            /* Cria‡Æo da Mensagem */
            RUN addNode     IN hGenXml (iFirstId,"Item":U, "":U, OUTPUT iId).
              RUN addNode     IN hGenXml (iId,"ItemCode":U,tt-item.it-codigo, OUTPUT iIdItem).
              RUN addNode     IN hGenXml (iId,"ItemDescription":U,tt-item.desc-item, OUTPUT iIdItem).

            RUN addNode     IN hGenXml (iFirstId,"Currency":U, "":U, OUTPUT iId).
              RUN addNodeDec  IN hGenXml (iId,"CurrencyID":U,tt-item.mo-codigo[1], OUTPUT iIdCurrency).
              RUN addNode     IN hGenXml (iId,"CurrencyDescription":U,tt-item.mo-desc[1], OUTPUT iIdCurrency).
              RUN addNode     IN hGenXml (iId,"CurrencySign":U,string(tt-item.mo-sigla[1]), OUTPUT iIdCurrency).

            IF  tt-item.preco-base <> ? THEN DO:
                RUN addNode     IN hGenXml (iFirstId,"BasePrice":U, "":U, OUTPUT iId).
                  RUN addNodeDate IN hGenXml (iId,"Date":U,tt-item.data-base, OUTPUT iIdBasePrice).
                  RUN addNodeDec  IN hGenXml (iId,"Price":U,tt-item.preco-base, OUTPUT iIdBasePrice).
            END.

            IF  tt-item.preco-fiscal <> ? THEN DO:
                RUN addNode     IN hGenXml (iFirstId,"FiscalPrice":U, "":U, OUTPUT iId).
                  RUN addNodeDate IN hGenXml (iId,"Date":U,tt-item.dt-pr-fisc, OUTPUT iIdFiscalPrice).
                  RUN addNodeDec  IN hGenXml (iId,"Price":U,tt-item.preco-fiscal, OUTPUT iIdFiscalPrice).
            END.

            IF  tt-item.preco-repos <> ? THEN DO:
                RUN addNode     IN hGenXml (iFirstId,"LastRepositionPrice":U, "":U, OUTPUT iId).
                  RUN addNodeDate IN hGenXml (iId,"Date":U,tt-item.data-ult-rep, OUTPUT iIdLastRepositionPrice).
                  RUN addNodeDec  IN hGenXml (iId,"Price":U,tt-item.preco-repos, OUTPUT iIdLastRepositionPrice).
            END.

            IF  tt-item.preco-ul-ent <> ? THEN DO:
                RUN addNode     IN hGenXml (iFirstId,"LastReceivingPrice":U, "":U, OUTPUT iId).
                  RUN addNodeDate IN hGenXml (iId,"Date":U,tt-item.data-ult-ent, OUTPUT iIdLastReceivingPrice).
                  RUN addNodeDec  IN hGenXml (iId,"Price":U,tt-item.preco-ul-ent, OUTPUT iIdLastReceivingPrice).
            END.

            /* Cole‡Æo de Estabelecimentos que possuam relacionamento com o item */
            FIND FIRST tt-item-estab WHERE tt-item-estab.it-codigo = tt-item.it-codigo NO-ERROR.
            IF  AVAIL tt-item-estab THEN DO:
                RUN addNode     IN hGenXml (iFirstId, "ListOfSites":U, "":U, OUTPUT iId).
                FOR EACH tt-item-estab WHERE tt-item-estab.it-codigo = tt-item.it-codigo:
                    RUN addNode     IN hGenXml (iId,"SiteItemCosting":U,"":U, OUTPUT iIdListOfSites).

                      RUN addNode     IN hGenXml (iIdListOfSites,"Site":U,"":U, OUTPUT iIdSiteItemCosting).
                        RUN addNode     IN hGenXml (iIdSiteItemCosting,"SiteID":U,tt-item-estab.cod-estabel, OUTPUT iIdSite).
                        RUN addNode     IN hGenXml (iIdSiteItemCosting,"SiteDescription":U,tt-item-estab.desc-estabel, OUTPUT iIdSite).

                      IF  tt-item-estab.preco-base <> ? THEN DO:
                          RUN addNode     IN hGenXml (iIdListOfSites,"BasePrice":U,"":U, OUTPUT iIdSiteItemCosting).
                            RUN addNodeDate IN hGenXml (iIdSiteItemCosting,"Date":U,tt-item-estab.data-base, OUTPUT iIdBasePrice).
                            RUN addNodeDec  IN hGenXml (iIdSiteItemCosting,"Price":U,tt-item-estab.preco-base, OUTPUT iIdBasePrice).
                      END.

                      IF  tt-item-estab.preco-fiscal <> ? THEN DO:
                          RUN addNode     IN hGenXml (iIdListOfSites,"FiscalPrice":U,"":U, OUTPUT iIdSiteItemCosting).
                            RUN addNodeDate IN hGenXml (iIdSiteItemCosting,"Date":U,tt-item-estab.dt-pr-fisc, OUTPUT iIdFiscalPrice).
                            RUN addNodeDec  IN hGenXml (iIdSiteItemCosting,"Price":U,tt-item-estab.preco-fiscal, OUTPUT iIdFiscalPrice).
                      END.

                      IF  tt-item-estab.preco-repos <> ? THEN DO:
                          RUN addNode     IN hGenXml (iIdListOfSites,"LastRepositionPrice":U,"":U, OUTPUT iIdSiteItemCosting).
                            RUN addNodeDate IN hGenXml (iIdSiteItemCosting,"Date":U,tt-item-estab.data-ult-rep, OUTPUT iIdLastRepositionPrice).
                            RUN addNodeDec  IN hGenXml (iIdSiteItemCosting,"Price":U,tt-item-estab.preco-repos, OUTPUT iIdLastRepositionPrice).
                      END.

                      IF  tt-item-estab.preco-ul-ent <> ? THEN DO:
                          RUN addNode     IN hGenXml (iIdListOfSites,"LastReceivingPrice":U,"":U, OUTPUT iIdSiteItemCosting).
                            RUN addNodeDate IN hGenXml (iIdSiteItemCosting,"Date":U,tt-item-estab.data-ult-ent, OUTPUT iIdLastReceivingPrice).
                            RUN addNodeDec  IN hGenXml (iIdSiteItemCosting,"Price":U,tt-item-estab.preco-ul-ent, OUTPUT iIdLastReceivingPrice).
                      END.

                      RUN addNodeDec  IN hGenXml (iIdListOfSites,"GeneralLedgerCostType":U,tt-item-estab.custo-contab, OUTPUT iIdSiteItemCosting).

                      IF  tt-item-estab.usa-mensal
                      AND tt-item-estab.val-unit-mat-m[1] <> ? THEN DO:
                          RUN addNode     IN hGenXml (iIdListOfSites,"BatchAverageCosting":U,"":U, OUTPUT iIdSiteItemCosting).
                            RUN addNodeDec  IN hGenXml (iIdSiteItemCosting,"BatchCostingMethod":U,tt-item-estab.tipo-pr-med, OUTPUT iIdBatchAverageCosting).
                            RUN addNodeDate IN hGenXml (iIdSiteItemCosting,"LastUpdate":U,tt-item-estab.mensal-ate, OUTPUT iIdBatchAverageCosting).
                            RUN addNode     IN hGenXml (iIdSiteItemCosting,"ListOfBatchAverageCosts":U,"":U, OUTPUT iIdBatchAverageCosting).
                            DO  iCont = 1 TO 3:
                              RUN addNode     IN hGenXml (iIdBatchAverageCosting,"UnitValues":U,"":U, OUTPUT iIdListOfBatchAverageCosts).
                                RUN addNodeDec  IN hGenXml (iIdListOfBatchAverageCosts,"Sequence":U,iCont, OUTPUT iIdUnitValues).
                                RUN addNodeDec  IN hGenXml (iIdListOfBatchAverageCosts,"MaterialValue":U,tt-item-estab.val-unit-mat-m[iCont], OUTPUT iIdUnitValues).
                                RUN addNodeDec  IN hGenXml (iIdListOfBatchAverageCosts,"LaborValue":U,tt-item-estab.val-unit-mob-m[iCont], OUTPUT iIdUnitValues).
                                RUN addNodeDec  IN hGenXml (iIdListOfBatchAverageCosts,"OverHeadValue":U,tt-item-estab.val-unit-ggf-m[iCont], OUTPUT iIdUnitValues).
                                /* Cria a cole‡Æo das moedas alternativas somente quando estiver parametrizado (param-estoq.tem-moeda1, param-estoq.tem-moeda2) */
                                if  (iCont = 2 and not tt-item.tem-moeda1)
                                or  (iCont = 3 and not tt-item.tem-moeda2) then
                                    next.
                                RUN addNode     IN hGenXml (iIdListOfBatchAverageCosts,"Currency":U,"":U, OUTPUT iIdUnitValues).
                                  RUN addNodeDec  IN hGenXml (iIdUnitValues,"CurrencyID":U,tt-item.mo-codigo[iCont], OUTPUT iIdCurrency).
                                  RUN addNode     IN hGenXml (iIdUnitValues,"CurrencyDescription":U,tt-item.mo-desc[iCont], OUTPUT iIdCurrency).
                                  RUN addNode     IN hGenXml (iIdUnitValues,"CurrencySign":U,string(tt-item.mo-sigla[iCont]), OUTPUT iIdCurrency).
                                  RUN addNodeLog  IN hGenXml (iIdUnitValues,"IsDefaultCurrency":U, if  iCont = 1 
                                                                                                   then TRUE
                                                                                                   else FALSE, OUTPUT iIdCurrency).
                            END.
                      END.

                      IF  tt-item-estab.usa-on-line
                      AND tt-item-estab.val-unit-mat-o[1] <> ? THEN DO:
                          RUN addNode     IN hGenXml (iIdListOfSites,"OnLineCosting":U,"":U, OUTPUT iIdSiteItemCosting).
                            RUN addNodeDec  IN hGenXml (iIdSiteItemCosting,"OnLineCostingMethod":U,tt-item-estab.metodo-custeio, OUTPUT iIdOnLineCosting).
                            RUN addNodeDate IN hGenXml (iIdSiteItemCosting,"LastUpdate":U,tt-item-estab.on-line-ate, OUTPUT iIdOnLineCosting).
                            RUN addNodeDate IN hGenXml (iIdSiteItemCosting,"ListOfOnLineAverageCosts":U,"":U, OUTPUT iIdOnLineCosting).
                            DO  iCont = 1 TO 3:
                                RUN addNode     IN hGenXml (iIdOnLineCosting,"UnitValues":U,"":U, OUTPUT iIdListOfOnLineAverageCosts).
                                  RUN addNodeDec  IN hGenXml (iIdListOfOnLineAverageCosts,"Sequence":U,iCont, OUTPUT iIdUnitValues).
                                  RUN addNodeDec  IN hGenXml (iIdListOfOnLineAverageCosts,"MaterialValue":U,tt-item-estab.val-unit-mat-o[iCont], OUTPUT iIdUnitValues).
                                  RUN addNodeDec  IN hGenXml (iIdListOfOnLineAverageCosts,"LaborValue":U,tt-item-estab.val-unit-mob-o[iCont], OUTPUT iIdUnitValues).
                                  RUN addNodeDec  IN hGenXml (iIdListOfOnLineAverageCosts,"OverHeadValue":U,tt-item-estab.val-unit-ggf-o[iCont], OUTPUT iIdUnitValues).
                                  /* Cria a cole‡Æo das moedas alternativas somente quando estiver parametrizado (param-estoq.tem-moeda1, param-estoq.tem-moeda2) */
                                  if  (iCont = 2 and not tt-item.tem-moeda1)
                                  or  (iCont = 3 and not tt-item.tem-moeda2) then
                                      next.
                                  RUN addNode     IN hGenXml (iIdListOfOnLineAverageCosts,"Currency":U,"":U, OUTPUT iIdUnitValues).
                                    RUN addNodeDec  IN hGenXml (iIdUnitValues,"CurrencyID":U,tt-item.mo-codigo[iCont], OUTPUT iIdCurrency).
                                    RUN addNode     IN hGenXml (iIdUnitValues,"CurrencyDescription":U,tt-item.mo-desc[iCont], OUTPUT iIdCurrency).
                                    RUN addNode     IN hGenXml (iIdUnitValues,"CurrencySign":U,string(tt-item.mo-sigla[iCont]), OUTPUT iIdCurrency).
                                    RUN addNodeLog  IN hGenXml (iIdUnitValues,"IsDefaultCurrency":U, if  iCont = 1 
                                                                                                         then TRUE
                                                                                                         else FALSE, OUTPUT iIdCurrency).
                            END.
                      END.

                      IF  tt-item-estab.usa-padrao
                      AND tt-item-estab.val-unit-mat-p[1] <> ? THEN DO:
                          RUN addNode     IN hGenXml (iIdListOfSites,"StandardCosting":U,"":U, OUTPUT iIdSiteItemCosting).
                            RUN addNodeDate IN hGenXml (iIdSiteItemCosting,"LastUpdate":U,tt-item-estab.padrao-ate, OUTPUT iIdStandardCosting).
                            RUN addNode     IN hGenXml (iIdSiteItemCosting,"ListOfStandardCosts":U,"":U, OUTPUT iIdStandardCosting).
                            DO  iCont = 1 TO 3:
                                RUN addNode     IN hGenXml (iIdStandardCosting,"UnitValues":U,"":U, OUTPUT iIdListOfStandardCosts).
                                  RUN addNodeDec  IN hGenXml (iIdListOfStandardCosts,"Sequence":U,iCont, OUTPUT iIdUnitValues).
                                  RUN addNodeDec  IN hGenXml (iIdListOfStandardCosts,"MaterialValue":U,tt-item-estab.val-unit-mat-p[iCont], OUTPUT iIdUnitValues).
                                  RUN addNodeDec  IN hGenXml (iIdListOfStandardCosts,"LaborValue":U,tt-item-estab.val-unit-mob-p[iCont], OUTPUT iIdUnitValues).
                                  RUN addNodeDec  IN hGenXml (iIdListOfStandardCosts,"OverHeadValue":U,tt-item-estab.val-unit-ggf-p[iCont], OUTPUT iIdUnitValues).
                                  /* Cria a cole‡Æo das moedas alternativas somente quando estiver parametrizado (param-estoq.tem-moeda1, param-estoq.tem-moeda2) */
                                  if  (iCont = 2 and not tt-item.tem-moeda1)
                                  or  (iCont = 3 and not tt-item.tem-moeda2) then
                                      next.
                                  RUN addNode     IN hGenXml (iIdListOfStandardCosts,"Currency":U,"":U, OUTPUT iIdUnitValues).
                                    RUN addNodeDec  IN hGenXml (iIdUnitValues,"CurrencyID":U,tt-item.mo-codigo[iCont], OUTPUT iIdCurrency).
                                    RUN addNode     IN hGenXml (iIdUnitValues,"CurrencyDescription":U,tt-item.mo-desc[iCont], OUTPUT iIdCurrency).
                                    RUN addNode     IN hGenXml (iIdUnitValues,"CurrencySign":U,string(tt-item.mo-sigla[iCont]), OUTPUT iIdCurrency).
                                    RUN addNodeLog  IN hGenXml (iIdUnitValues,"IsDefaultCurrency":U, if  iCont = 1 
                                                                                                         then TRUE
                                                                                                         else FALSE, OUTPUT iIdCurrency).
                            END.
                      END.

                      FIND FIRST tt-saldo-custo WHERE tt-saldo-custo.it-codigo   = tt-item.it-codigo
                                                AND   tt-saldo-custo.cod-estabel = tt-item-estab.cod-estabel NO-ERROR.
                      IF  AVAIL tt-saldo-custo THEN DO:
                          RUN addNode     IN hGenXml (iIdListOfSites,"ListOfCostingSequences":U,"":U, OUTPUT iIdSiteItemCosting).
                          FOR EACH tt-saldo-custo WHERE tt-saldo-custo.it-codigo   = tt-item.it-codigo
                                                  AND   tt-saldo-custo.cod-estabel = tt-item-estab.cod-estabel:
                              RUN addNode     IN hGenXml (iIdSiteItemCosting,"CostSequence":U,"":U, OUTPUT iIdListOfCostingSequences).
                                RUN addNodeDec  IN hGenXml (iIdListOfCostingSequences,"CostSequenceNumber":U,tt-saldo-custo.seq-custeio, OUTPUT iIdCostSequence).
                                RUN addNode     IN hGenXml (iIdListOfCostingSequences,"ItemRefence":U,"":U, OUTPUT iIdCostSequence).
                                  RUN addNode     IN hGenXml (iIdCostSequence,"ReferenceCode":U,tt-saldo-custo.cod-refer, OUTPUT iIdItemRefence).
                                  RUN addNode     IN hGenXml (iIdCostSequence,"ReferenceDescription":U,tt-saldo-custo.desc-refer, OUTPUT iIdItemRefence).
                                RUN addNode    IN hGenXml (iIdListOfCostingSequences,"LotOrSerialNumber":U,tt-saldo-custo.lote, OUTPUT iIdCostSequence).
                                RUN addNodeDec IN hGenXml (iIdListOfCostingSequences,"OriginalQuantity":U,tt-saldo-custo.qt-original, OUTPUT iIdCostSequence).
                                RUN addNodeDec IN hGenXml (iIdListOfCostingSequences,"BalanceQuantity":U,tt-saldo-custo.qt-saldo, OUTPUT iIdCostSequence).
                                RUN addNode    IN hGenXml (iIdListOfCostingSequences,"OriginalCosting":U,"":U, OUTPUT iIdCostSequence).
                                DO  iCont = 1 TO 3:
                                    RUN addNode    IN hGenXml (iIdCostSequence,"UnitValues":U,"":U, OUTPUT iIdOriginalCosting).
                                      RUN addNodeDec  IN hGenXml (iIdOriginalCosting,"Sequence":U,iCont, OUTPUT iIdUnitValues).
                                      RUN addNodeDec  IN hGenXml (iIdOriginalCosting,"MaterialValue":U,tt-saldo-custo.valor-ori-mat[iCont], OUTPUT iIdUnitValues).
                                      RUN addNodeDec  IN hGenXml (iIdOriginalCosting,"LaborValue":U,tt-saldo-custo.valor-ori-mob[iCont], OUTPUT iIdUnitValues).
                                      RUN addNodeDec  IN hGenXml (iIdOriginalCosting,"OverHeadValue":U,tt-saldo-custo.valor-ori-ggf[iCont], OUTPUT iIdUnitValues).
                                      /* Cria a cole‡Æo das moedas alternativas somente quando estiver parametrizado (param-estoq.tem-moeda1, param-estoq.tem-moeda2) */
                                      if  (iCont = 2 and not tt-item.tem-moeda1)
                                      or  (iCont = 3 and not tt-item.tem-moeda2) then
                                          next.
                                      RUN addNode     IN hGenXml (iIdOriginalCosting,"Currency":U,"":U, OUTPUT iIdUnitValues).
                                        RUN addNodeDec  IN hGenXml (iIdUnitValues,"CurrencyID":U,tt-item.mo-codigo[iCont], OUTPUT iIdCurrency).
                                        RUN addNode     IN hGenXml (iIdUnitValues,"CurrencyDescription":U,tt-item.mo-desc[iCont], OUTPUT iIdCurrency).
                                        RUN addNode     IN hGenXml (iIdUnitValues,"CurrencySign":U,string(tt-item.mo-sigla[iCont]), OUTPUT iIdCurrency).
                                        RUN addNodeLog  IN hGenXml (iIdUnitValues,"IsDefaultCurrency":U, if  iCont = 1 
                                                                                                         then TRUE
                                                                                                         else FALSE, OUTPUT iIdCurrency).
                                END.
                                RUN addNode    IN hGenXml (iIdListOfCostingSequences,"BalanceCosting":U,"":U, OUTPUT iIdCostSequence).
                                DO  iCont = 1 TO 3:
                                    RUN addNode    IN hGenXml (iIdCostSequence,"UnitValues":U,"":U, OUTPUT iIdBalanceCosting).
                                      RUN addNodeDec  IN hGenXml (iIdBalanceCosting,"Sequence":U,iCont, OUTPUT iIdUnitValues).
                                      RUN addNodeDec  IN hGenXml (iIdBalanceCosting,"MaterialValue":U,tt-saldo-custo.saldo-mat[iCont], OUTPUT iIdUnitValues).
                                      RUN addNodeDec  IN hGenXml (iIdBalanceCosting,"LaborValue":U,tt-saldo-custo.saldo-mob[iCont], OUTPUT iIdUnitValues).
                                      RUN addNodeDec  IN hGenXml (iIdBalanceCosting,"OverHeadValue":U,tt-saldo-custo.saldo-ggf[iCont], OUTPUT iIdUnitValues).
                                      /* Cria a cole‡Æo das moedas alternativas somente quando estiver parametrizado (param-estoq.tem-moeda1, param-estoq.tem-moeda2) */
                                      if  (iCont = 2 and not tt-item.tem-moeda1)
                                      or  (iCont = 3 and not tt-item.tem-moeda2) then
                                          next.
                                      RUN addNode     IN hGenXml (iIdBalanceCosting,"Currency":U,"":U, OUTPUT iIdUnitValues).
                                        RUN addNodeDec  IN hGenXml (iIdUnitValues,"CurrencyID":U,tt-item.mo-codigo[iCont], OUTPUT iIdCurrency).
                                        RUN addNode     IN hGenXml (iIdUnitValues,"CurrencyDescription":U,tt-item.mo-desc[iCont], OUTPUT iIdCurrency).
                                        RUN addNode     IN hGenXml (iIdUnitValues,"CurrencySign":U,string(tt-item.mo-sigla[iCont]), OUTPUT iIdCurrency).
                                        RUN addNodeLog  IN hGenXml (iIdUnitValues,"IsDefaultCurrency":U, if  iCont = 1 
                                                                                                         then TRUE
                                                                                                         else FALSE, OUTPUT iIdCurrency).
                                END.
                          END. /* fim for each tt-saldo-custo */
                      END. /* if avail tt-saldo-custo */
                END. /* fim for each tt-item-estab */
            END. /* if avail tt-item-estab */
        END.

        /* Obt‚m XMl na variavel handle */
        RUN generateXML IN hGenXml (OUTPUT hBusinessContent).
        /*hBusinessContent:SAVE("FILE", "C:~\Item.xml").*/

        /* Passa handle do BusinessContent */
        RUN setBusinessContent IN hMessageHandler (INPUT hBusinessContent).

        /* Elimina handle */
        DELETE OBJECT hBusinessContent NO-ERROR.

        /* Envia XML para ControlBroker */
        &IF "{&mguni_version}" >= "2.071" &THEN
                RUN sendMessage IN hMessageHandler (INPUT "ar2/ItemCosting_204_001.xsd").        
        &ELSE
                RUN sendMessage IN hMessageHandler (INPUT "ar2/ItemCosting_204_000.xsd").        
        &ENDIF

        /* Verifica se a mensagem foi enviada com sucesso */
        RUN getReturnStatus IN hMessageHandler (OUTPUT pSendSuccess,
                                                OUTPUT pTotalErrors).
        IF  NOT pSendSuccess THEN DO:
            REPEAT iCount = 1 TO pTotalErrors:
               RUN getError IN hMessageHandler (iCount,
                                                OUTPUT pErrorNumber,
                                                OUTPUT pErrorType,
                                                OUTPUT pErrorDesc ).
               RUN piCriaErro (17006,
                               pErrorType,
                               pErrorDesc).

            END.
            RETURN "NOK":U.
            LEAVE.
        END.
    END. /* FIM for each tt-item */

    RETURN "OK":U.
END PROCEDURE.
