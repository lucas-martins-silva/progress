PROCEDURE PIUpsert:


    DEFINE VAR iId AS INTEGER INITIAL ? NO-UNDO.

     RUN getBusinessContent IN hMessageHandler (OUTPUT hBusinessContent).
     RUN reset              IN hGenXml.
     RUN loadXml            IN hGenXml (hBusinessContent).


     DELETE OBJECT hBusinessContent NO-ERROR.

     /* ********* LEITURA DA MENSAGEM - BEGIN ********* */
     addStack(1).

          EMPTY TEMP-TABLE tt-classif-fisc NO-ERROR.
          CREATE tt-classif-fisc.

          RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "FiscalClassificationID":U, OUTPUT tt-classif-fisc.class-fiscal).

          FOR FIRST classif-fisc FIELDS(class-fiscal)
              WHERE classif-fisc.class-fiscal = tt-classif-fisc.class-fiscal NO-LOCK: END.

          IF NOT AVAIL classif-fisc THEN   /* Redefine transação para "add" (inclusão), nos casos em que foi enviada  */
             ASSIGN cTranAction = "add":U. /* a transação "upd", porém o registro será criado pois não existe na base */

          /* Atribui valor nulo para que os valores da base nÆo sejam sobrepostos */
          IF cTranAction = "upd":U THEN DO:
             RUN piValoresNulos (INPUT BUFFER tt-classif-fisc:HANDLE).
             ASSIGN tt-classif-fisc.class-fiscal = classif-fisc.class-fiscal.
          END.

          RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "FiscalClassificationDescription":U, OUTPUT tt-classif-fisc.descricao).
          ASSIGN tt-classif-fisc.descricao = SUBSTR(tt-classif-fisc.descricao,1,35).

          RUN searchTag IN hGenXml (INPUT "IndustrializedProductTax":U, INPUT getStack(), OUTPUT iId).
          IF iId <> ? THEN DO:
          addStack(iId).

               RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "TaxPercentage":U, OUTPUT tt-classif-fisc.aliquota-ipi).

               RUN searchTag IN hGenXml (INPUT "TaxVerificationType":U, INPUT getStack(), OUTPUT iId).
                 IF iId <> ? THEN DO:
                     RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "TaxVerificationType":U, OUTPUT d-idi-tip-apurac-ipi).
                     IF d-idi-tip-apurac-ipi = 1 OR d-idi-tip-apurac-ipi = 2 THEN
                      &IF '{&bf_mat_versao_ems}' < '2.06':U &THEN 
                         ASSIGN overlay(tt-classif-fisc.char-2,1,1) = STRING(d-idi-tip-apurac-ipi).
                      &ELSE
                         ASSIGN tt-classif-fisc.idi-tip-apurac-ipi = d-idi-tip-apurac-ipi.
                      &ENDIF
                 END.
                 ELSE 
                     &IF '{&bf_mat_versao_ems}' < '2.06':U &THEN 
                          ASSIGN overlay(tt-classif-fisc.char-2,1,1) = IF cTranAction = "add":U THEN "1" ELSE "?".
                     &ELSE
                          ASSIGN tt-classif-fisc.idi-tip-apurac-ipi  = IF cTranAction = "add":U THEN 1 ELSE ?.   /* 1 - default */
                     &ENDIF

               RUN searchTag IN hGenXml (INPUT "IsTaxSuspended":U, INPUT getStack(), OUTPUT iId).
                 IF iId <> ? THEN RUN getSonLog IN hGenXml (INPUT getStack(), INPUT "IsTaxSuspended":U, OUTPUT tt-classif-fisc.log-1).
                 ELSE IF cTranAction = "upd":U THEN ASSIGN tt-classif-fisc.log-1 = ?.
          delStack().
          END.
          ELSE DO:
             IF cTranAction = "upd":U THEN DO:
                ASSIGN tt-classif-fisc.aliquota-ipi = ?
                       tt-classif-fisc.log-1        = ?.

                &IF '{&bf_mat_versao_ems}' < '2.06':U &THEN 
                     ASSIGN overlay(tt-classif-fisc.char-2,1,1) = "?".
                &ELSE
                     ASSIGN tt-classif-fisc.idi-tip-apurac-ipi  = ?.
                &ENDIF
             END.
             ELSE ASSIGN tt-classif-fisc.aliquota-ipi = 0 . /* valor inicial do dicionario é 10 */
          END.

          RUN searchTag IN hGenXml (INPUT "SocialIntegrationProgramTax":U, INPUT getStack(), OUTPUT iId).
          IF iId <> ? THEN DO:
          addStack(iId).

               RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "TaxPercentage":U, OUTPUT tt-classif-fisc.dec-1).
               
               ASSIGN de-aliq-pis    = tt-classif-fisc.dec-1.

               RUN searchTag IN hGenXml (INPUT "TaxReductionPercentage":U, INPUT getStack(), OUTPUT iId).
                 IF iId <> ? THEN DO:
                      RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "TaxReductionPercentage":U, OUTPUT d-red-pis).
                      ASSIGN tt-classif-fisc.int-1 =  TRUNC(d-red-pis * 100,0).
                 END.
                 ELSE IF cTranAction = "upd":U THEN ASSIGN tt-classif-fisc.int-1 = ?.

               RUN searchTag IN hGenXml (INPUT "ExternalPercentage":U, INPUT getStack(), OUTPUT iId).
                 IF iId <> ? THEN DO:
                    RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ExternalPercentage":U, OUTPUT d-val-aliq-ext-pis).
                    &IF '{&bf_mat_versao_ems}' < '2.06':U &THEN 
                        ASSIGN overlay(tt-classif-fisc.char-1,31,6) = STRING(d-val-aliq-ext-pis).
                    &ELSE
                         ASSIGN tt-classif-fisc.val-aliq-ext-pis = d-val-aliq-ext-pis.
                    &ENDIF

                 END.
                 ELSE IF cTranAction = "upd":U THEN
                     &IF '{&bf_mat_versao_ems}' < '2.06':U &THEN 
                        ASSIGN overlay(tt-classif-fisc.char-1,31,6) = "?".
                    &ELSE
                         ASSIGN tt-classif-fisc.val-aliq-ext-pis = ?.
                    &ENDIF

          delStack().
          END.
          ELSE IF cTranAction = "upd":U THEN DO:
               ASSIGN tt-classif-fisc.dec-1 = ?
                      tt-classif-fisc.int-1 = ?.

               &IF '{&bf_mat_versao_ems}' < '2.06':U &THEN 
                     ASSIGN overlay(tt-classif-fisc.char-1,31,6) = "?".
               &ELSE
                     ASSIGN tt-classif-fisc.val-aliq-ext-pis  = ?.
               &ENDIF
          END.


          RUN searchTag IN hGenXml (INPUT "SocialSecurityContributionTax":U, INPUT getStack(), OUTPUT iId).
          IF iId <> ? THEN DO:
          addStack(iId).

               RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "TaxPercentage":U, OUTPUT tt-classif-fisc.dec-2).

               ASSIGN de-aliq-cofins = tt-classif-fisc.dec-2.

               RUN searchTag IN hGenXml (INPUT "TaxReductionPercentage":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? THEN DO:
                      RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "TaxReductionPercentage":U, OUTPUT d-red-cofins).
                      ASSIGN tt-classif-fisc.int-2 =  TRUNC(d-red-cofins * 100,0).
               END.
               ELSE IF cTranAction = "upd":U THEN ASSIGN tt-classif-fisc.int-2 = ?.

               RUN searchTag IN hGenXml (INPUT "ExternalPercentage":U, INPUT getStack(), OUTPUT iId).
                 IF iId <> ? THEN DO:
                     RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ExternalPercentage":U, OUTPUT d-val-aliq-ext-cofins).
                     &IF '{&bf_mat_versao_ems}' < '2.06':U &THEN 
                         ASSIGN overlay(tt-classif-fisc.char-1,37,6) = STRING(d-val-aliq-ext-cofins).
                     &ELSE
                         ASSIGN tt-classif-fisc.val-aliq-ext-cofins = d-val-aliq-ext-cofins.
                     &ENDIF
                 END.
                 ELSE IF cTranAction = "upd":U THEN
                      &IF '{&bf_mat_versao_ems}' < '2.06':U &THEN 
                         ASSIGN overlay(tt-classif-fisc.char-1,37,6) = "?".
                      &ELSE
                         ASSIGN tt-classif-fisc.val-aliq-ext-cofins  = ?.
                      &ENDIF

          delStack().
          END.
          ELSE IF cTranAction = "upd":U THEN DO:
               ASSIGN tt-classif-fisc.dec-2 = ?
                      tt-classif-fisc.int-2 = ?.

                &IF '{&bf_mat_versao_ems}' < '2.06':U &THEN 
                     ASSIGN overlay(tt-classif-fisc.char-1,37,6) = "?".
                &ELSE
                     ASSIGN tt-classif-fisc.val-aliq-ext-cofins  = ?.
                &ENDIF
          END.


          /* Importa‡Æo */
          FIND FIRST param-global NO-LOCK NO-ERROR.

          RUN searchTag IN hGenXml (INPUT "ImportationTax":U, INPUT getStack(), OUTPUT iId).
          IF iId <> ? AND
             param-global.modulo-07 AND CONNECTED("mgcex":U) THEN DO:
          addStack(iId).
              RUN searchTag IN hGenXml (INPUT "TaxPercentage":U, INPUT getStack(), OUTPUT iId).
                IF iId <> ? THEN DO:
                   RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "TaxPercentage":U, OUTPUT d-tax-perc).
                   /* Al¡quota-II: conforme v10in046 */
                   ASSIGN de-aliq-ii-i50 = d-tax-perc.
                   {cdp/cd0603.i51 "no"}
                   {cdp/cd4300.i4  "no" tt-classif-fisc.char-1}    

                END.
          delStack().
          END.
          ELSE IF cTranAction = "upd":U THEN DO:
               ASSIGN de-aliq-ii-i50 = ?.
               {cdp/cd0603.i51 "no"}
               {cdp/cd4300.i4  "no" tt-classif-fisc.char-1}   
          END.

          RUN searchTag IN hGenXml (INPUT "UnitOfMeasure":U, INPUT getStack(), OUTPUT iId).
          IF iId <> ? THEN DO:
          addStack(iId).

               RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "UnitOfMeasureCode":U, OUTPUT tt-classif-fisc.unidade).
          delStack().
          END.
          ELSE IF cTranAction = "upd":U THEN ASSIGN tt-classif-fisc.unidade = ?.

          RUN searchTag IN hGenXml (INPUT "FiscalUnitOfMeasureCode":U, INPUT getStack(), OUTPUT iId).
            IF iId <> ? THEN RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "FiscalUnitOfMeasureCode":U, OUTPUT tt-classif-fisc.cod-unidade).
              ELSE IF cTranAction = "upd":U THEN ASSIGN tt-classif-fisc.cod-unidade = ?.

          RUN searchTag IN hGenXml (INPUT "GoodsPurpose":U, INPUT getStack(), OUTPUT iId).
            IF iId <> ? THEN DO:
               RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "GoodsPurpose":U, OUTPUT i-finalidade).
                  IF i-finalidade = 100 OR i-finalidade = 310 OR i-finalidade = 329 THEN
                     ASSIGN tt-classif-fisc.finalidade = i-finalidade.
            END.
            ELSE ASSIGN tt-classif-fisc.finalidade = IF cTranAction = "add":U THEN 329 ELSE ?. /* 329 ->> default */

          RUN searchTag IN hGenXml (INPUT "IBGEUnitOfMeasureCode":U, INPUT getStack(), OUTPUT iId).
            IF iId <> ? THEN RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "IBGEUnitOfMeasureCode":U, OUTPUT tt-classif-fisc.cod-un-ibge).
             ELSE IF cTranAction = "upd":U THEN ASSIGN tt-classif-fisc.cod-un-ibge = ?.

          RUN searchTag IN hGenXml (INPUT "IBGEUnitOfMeasureShortDescription":U, INPUT getStack(), OUTPUT iId).
            IF iId <> ? THEN RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "IBGEUnitOfMeasureShortDescription":U, OUTPUT tt-classif-fisc.un-abr-ibge).
             ELSE IF cTranAction = "upd":U THEN ASSIGN tt-classif-fisc.un-abr-ibge = ?.

          RUN searchTag IN hGenXml (INPUT "NALADICode":U, INPUT getStack(), OUTPUT iId).
            IF iId <> ? THEN RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "NALADICode":U, OUTPUT tt-classif-fisc.cod-naladi).
             ELSE IF cTranAction = "upd":U THEN ASSIGN tt-classif-fisc.cod-naladi = ?.

          RUN searchTag IN hGenXml (INPUT "NALADISHCode":U, INPUT getStack(), OUTPUT iId).
            IF iId <> ? THEN RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "NALADISHCode":U, OUTPUT tt-classif-fisc.cod-naladi-sh).
             ELSE IF cTranAction = "upd":U THEN ASSIGN tt-classif-fisc.cod-naladi-sh = ?.

          RUN searchTag IN hGenXml (INPUT "MercosulCode":U, INPUT getStack(), OUTPUT iId).
            IF iId <> ? THEN RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "MercosulCode":U, OUTPUT tt-classif-fisc.cod-mercosul).
             ELSE IF cTranAction = "upd":U THEN ASSIGN tt-classif-fisc.cod-mercosul = ?.

          RUN searchTag IN hGenXml (INPUT "NCMCode":U, INPUT getStack(), OUTPUT iId).
            IF iId <> ? THEN RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "NCMCode":U, OUTPUT tt-classif-fisc.cod-ncm).
             ELSE IF cTranAction = "upd":U THEN ASSIGN tt-classif-fisc.cod-ncm = ?.

          /* Os campo abaixo não são enviados pelo XML, 
             mas estão sendo setados para que seus valores default(NO) não sejam gravados na API */
          &IF '{&bf_mat_versao_ems}' >= '2.06':U &THEN 
             IF cTranAction = "upd":U THEN
                ASSIGN tt-classif-fisc.log-suspens-impto-import = ?
                       tt-classif-fisc.log-suspens-ipi-import   = ?.
          &ENDIF

     delStack().
     /* ********* LEITURA DA MENSAGEM - END   ********* */

     /* ********* EFETIVA€ÇO - BEGIN ********* */
     {adapters/xml/of2/axrof001upsert.i}
     /* ********* EFETIVA€ÇO - END   ********* */

     IF NOT ERROR-STATUS:ERROR  THEN DO:
         IF de-aliq-pis    <> 0 OR
            de-aliq-cofins <> 0 THEN DO:
             IF NOT VALID-HANDLE(h-cdapi995) THEN
                 RUN cdp/cdapi995.p PERSISTENT SET h-cdapi995.
    
             RUN grava-aliquotas IN h-cdapi995 (INPUT "classif-fisc",
                                               INPUT tt-classif-fisc.class-fiscal,
                                               INPUT de-aliq-pis,
                                               INPUT de-aliq-cofins).
    
         END.
    
         IF VALID-HANDLE(h-cdapi995) THEN DO:
             RUN pi-finalizar in h-cdapi995.
             ASSIGN h-cdapi995 = ?.
         END.
     END.
     

END PROCEDURE.


PROCEDURE receiveMessage:

    /*PARAMETERS - BEGIN*/
    DEFINE INPUT  PARAM hInputXML  AS HANDLE NO-UNDO.
    DEFINE OUTPUT PARAM hOutputXML AS HANDLE NO-UNDO.
    /*PARAMETERS - END*/


/* ******************************************* */
/* *************** BODY - BEGIN ************** */
/* ******************************************* */

     EMPTY TEMP-TABLE RowErrors NO-ERROR.

     {xmlinc/xmlloadmessagehandlerrec.i &MessageHandler="hMessageHandler" &MHReturnValue="cReturnValue" &MHReturnError="hOutputXML"}

     IF  cReturnValue <> "OK":U THEN 
      IF cReturnValue <> ? AND cReturnValue <> "" THEN 
         RUN setError IN hMessageHandler (INPUT 17006,
                                          INPUT "enviroment_error":U,
                                          INPUT cReturnValue).

     RUN parseMessage IN hMessageHandler (INPUT  hInputXml,
                                          INPUT "{&XmlTranName}", 
                                          INPUT "{&XmlMaxTranVersion}", 
                                          INPUT "{&XmlMinTranVersion}", 
                                          INPUT "{&XmlListOfEvents}",
                                          OUTPUT lSuccessProcess,
                                          OUTPUT cTranAction, 
                                          OUTPUT cTranEvent,
                                          OUTPUT cTranVersion,
                                          OUTPUT hOutputXML ).

     IF NOT lSuccessProcess OR RETURN-VALUE <> "OK":U THEN
        RUN setError IN hMessageHandler (INPUT 17006,
                                         INPUT "enviroment_error":U,
                                         INPUT RETURN-VALUE).

     {xmlinc/xmlloadgenxmlrec.i &GenXml="hGenXml" &GXReturnValue="cReturnValue" &GXReturnError="hOutputXML"}

     IF cReturnValue <> "OK":U THEN DO:

        DELETE OBJECT hBusinessContent NO-ERROR.
        RUN setError IN hMessageHandler (INPUT 17006,
                                         INPUT "enviroment_error":U,
                                         INPUT cReturnValue).
        RETURN cReturnValue.
     END.

    {adapters/xml/of2/axrof001versioncontrol.i}

/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.

PROCEDURE piValoresNulos:

    DEFINE INPUT PARAMETER ttHandle1 AS HANDLE NO-UNDO.  

    DEFINE VARIABLE cont AS INTEGER NO-UNDO.

    DO  cont = 1 TO ttHandle1:NUM-FIELDS:
        RUN piGravaValorNulo (INPUT ttHandle1:BUFFER-FIELD(cont)).
    END.

END PROCEDURE.

PROCEDURE piGravaValorNulo:

    DEFINE INPUT PARAMETER fieldhandle1 AS HANDLE NO-UNDO. 

    DEFINE VARIABLE i-cont  AS INTEGER NO-UNDO.

    IF  fieldhandle1:EXTENT > 0 THEN DO:
        DO  i-cont = 1 TO fieldhandle1:EXTENT:
            IF LOOKUP(fieldHandle1:NAME,"char-1,char-2,dec-1,dec-2,int-1,int-2,log-1,log-2") = 0 THEN
               ASSIGN fieldHandle1:BUFFER-VALUE(i-cont) = ? NO-ERROR.
        END.
    END.
    ELSE 
        IF LOOKUP(fieldHandle1:NAME,"char-1,char-2,dec-1,dec-2,int-1,int-2,log-1,log-2") = 0 THEN
           ASSIGN fieldHandle1:BUFFER-VALUE() = ? NO-ERROR.

END PROCEDURE.


