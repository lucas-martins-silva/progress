                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "ExternalPercentage":U, SUBSTRING(classif-fisc.char-1,31,06), OUTPUT iId).
                        END. /*Test LOGIC*/
                    &ENDIF
               delStack().
          END. /*Test LOGIC*/

          IF (tt-classif-fisc.dec-2 <> ?) THEN
          DO: /*Test LOGIC*/
               RUN addNode IN hGenXml (getStack(), "SocialSecurityContributionTax":U, "":U, OUTPUT iId).
               addStack(iId).

                    RUN addNodeDec IN hGenXml (getStack(), "TaxPercentage":U, de-ali-cofins, OUTPUT iId).
