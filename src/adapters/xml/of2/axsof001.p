                    END. /*Test LOGIC*/

                    &IF "{&bf_dis_versao_ems}" >= "2.06":U &THEN
                        IF (tt-classif-fisc.val-aliq-ext-cofins <> ?) THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "ExternalPercentage":U, tt-classif-fisc.val-aliq-ext-cofins, OUTPUT iId).
                        END. /*Test LOGIC*/
                    &ELSE
                        IF (SUBSTRING(classif-fisc.char-1,37,06) <> ?) THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "ExternalPercentage":U, SUBSTRING(classif-fisc.char-1,37,06), OUTPUT iId).
                        END. /*Test LOGIC*/
                    &ENDIF
               delStack().
          END. /*Test LOGIC*/

          IF SUBSTR(tt-classif-fisc.char-1,1,20) <> ? THEN
          DO: /*Test LOGIC*/
               RUN addNode IN hGenXml (getStack(), "ImportationTax":U, "":U, OUTPUT iId).
               addStack(iId).

                    IF (SUBSTR(tt-classif-fisc.char-1,1,20 ) <> ?) THEN
                    DO: /*Test LOGIC*/
                         RUN addNodeDec IN hGenXml (getStack(), "TaxPercentage":U, SUBSTR(tt-classif-fisc.char-1,1,20), OUTPUT iId).
                    END. /*Test LOGIC*/
               delStack().
          END. /*Test LOGIC*/

          IF (tt-classif-fisc.unidade <> ?) THEN
          DO: /*Test LOGIC*/
               RUN addNode IN hGenXml (getStack(), "UnitOfMeasure":U, "":U, OUTPUT iId).
               addStack(iId).

                    RUN addNode IN hGenXml (getStack(), "UnitOfMeasureCode":U, tt-classif-fisc.unidade, OUTPUT iId).

                    FOR FIRST tab-unidade FIELDS ( descricao )
                        WHERE tab-unidade.un = tt-classif-fisc.unidade NO-LOCK: END.
                     IF AVAIL tab-unidade THEN 
