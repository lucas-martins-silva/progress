                      RUN cdp\cdapi995.p PERSISTENT SET h-cdapi995.

          RUN recupera-aliquotas IN h-cdapi995 (INPUT  "classif-fisc",
                                                INPUT  tt-classif-fisc.class-fiscal,
                                                OUTPUT de-ali-pis,
                                                OUTPUT de-ali-cofins).

          IF de-ali-pis    = 0 THEN ASSIGN de-ali-pis    = tt-classif-fisc.dec-1.
          IF de-ali-cofins = 0 THEN ASSIGN de-ali-cofins = tt-classif-fisc.dec-2.

          IF (tt-classif-fisc.dec-1 <> ?) THEN
          DO: /*Test LOGIC*/
               RUN addNode IN hGenXml (getStack(), "SocialIntegrationProgramTax":U, "":U, OUTPUT iId).
               addStack(iId).

                    RUN addNodeDec IN hGenXml (getStack(), "TaxPercentage":U, de-ali-pis, OUTPUT iId).
                    IF (tt-classif-fisc.int-1 <> ?) THEN
                    DO: /*Test LOGIC*/
                         RUN addNode IN hGenXml (getStack(), "TaxReductionPercentage":U, REPLACE(STRING(tt-classif-fisc.int-1 / 100, ">9.99":U),",","."), OUTPUT iId).
                    END. /*Test LOGIC*/

                    &IF "{&bf_dis_versao_ems}" >= "2.06":U &THEN
                        IF (tt-classif-fisc.val-aliq-ext-pis <> ?) THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "ExternalPercentage":U, tt-classif-fisc.val-aliq-ext-pis, OUTPUT iId).
                        END. /*Test LOGIC*/
                    &ELSE
