     RETURN RETURN-VALUE.
END.

IF NOT lCreateMsg THEN RETURN "OK":U.

/* PREENCHE O VALOR DO ELEM. Comment DE TransactionId */
RUN setTransInfoComment IN hMessageHandler ("Comment").

/* SETA SystemId */
RUN setSystemId IN hMessageHandler ("{&XmlMod}":U,  "{&XmlProdVersion}").

/* SETA Chave Primaria */
FOR FIRST tt-classif-fisc: END.

RUN setKeyFields IN hMessageHandler ("classif-fisc.class-fiscal":U, STRING(tt-classif-fisc.class-fiscal)).

/* INFORMA A EMPRESA E O ESTABELECIMENTO */
RUN setCompanyId IN hMessageHandler (STRING(v_cdn_empres_usuar), ""). 


     /* RESETA OS VALORES */
     RUN reset IN hGenXml.

     /* SETA VALOR DE ENCODING */
     RUN setEncoding IN hGenXml ("UTF-8":U).

     RUN addNode IN hGenXml (getStack(), "Upsert":U, "":U, OUTPUT iId).
     addStack(iId).

          RUN addNode IN hGenXml (getStack(), "FiscalClassificationID":U, tt-classif-fisc.class-fiscal, OUTPUT iId).
          RUN addNode IN hGenXml (getStack(), "FiscalClassificationDescription":U, tt-classif-fisc.descricao, OUTPUT iId).

