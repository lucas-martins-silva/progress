          DO: /*Test LOGIC*/
               RUN addNode IN hGenXml (getStack(), "IndustrializedProductTax":U, "":U, OUTPUT iId).
               addStack(iId).

                    RUN addNodeDec IN hGenXml (getStack(), "TaxPercentage":U, tt-classif-fisc.aliquota-ipi, OUTPUT iId).

                    &IF "{&bf_dis_versao_ems}" >= "2.06":U &THEN
                        IF (tt-classif-fisc.idi-tip-apurac-ipi = 1 OR tt-classif-fisc.idi-tip-apurac-ipi = 2) THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "TaxVerificationType":U, tt-classif-fisc.idi-tip-apurac-ipi, OUTPUT iId).
                        END. /*Test LOGIC*/
                    &ELSE
                        IF (SUBSTR(tt-classif-fisc.char-2,1,1) = "1" OR SUBSTR(tt-classif-fisc.char-2,1,1) = "2") THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "TaxVerificationType":U, SUBSTR(tt-classif-fisc.char-2,1,1), OUTPUT iId).
