RUN sendMessage IN hMessageHandler (INPUT "of2/FiscalClassification_204_000.xsd":U). 

/* VERIFICA SE OCORREU ALGUM ERRO */
IF RETURN-VALUE <> "OK":U THEN DO:
     CREATE TT_LOG_ERRO.
