        RUN getSonDec  IN hGenXml (INPUT getStack(), INPUT "PriceWithoutICMS",               OUTPUT ttDocumentItemsType.PriceWithoutICMS).
        RUN getSonDec  IN hGenXml (INPUT getStack(), INPUT "PISPercentage",                  OUTPUT ttDocumentItemsType.PISPercentage).        
        RUN getSonDec  IN hGenXml (INPUT getStack(), INPUT "COFINSPercentage",               OUTPUT ttDocumentItemsType.COFINSPercentage). 
        
    delStack().

    RETURN "OK":U.

END PROCEDURE.

PROCEDURE PI_gera_tt_log_erro:

IF  CAN-FIND(FIRST RowErrors) THEN DO:
    FOR EACH RowErrors 
       WHERE RowErrors.ErrorNumber <> 10 AND
             RowErrors.ErrorType <> "INTERNAL":

        CREATE tt_log_erro. 
        ASSIGN tt_log_erro.ttv_num_cod_erro  = RowErrors.errorNumber    
               tt_log_erro.ttv_des_msg_ajuda = IF RowErrors.errorSubType = "ERROR":U THEN "business_error":U ELSE "business_information":U   
               tt_log_erro.ttv_des_msg_erro  = RowErrors.errorDescription.                                        
    END.
    RETURN 'NOK'.
END. /* IF  CAN-FIND(FIRST RowErrors) */

END PROCEDURE.

