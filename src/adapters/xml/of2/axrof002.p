PROCEDURE PIEngineRegras:

    DEFINE INPUT  PARAM pTranAction AS CHAR NO-UNDO.
    /*DEFINE OUTPUT PARAM TABLE FOR tt_log_erro.*/
    
    /*---[ integraá∆o EMSxNeogrid ]---------------------------------------------------------------------------------*/
    FIND FIRST config-tip-operac NO-LOCK
         WHERE config-tip-operac.cod-tip-operac = 'axrof002' NO-ERROR.
    IF  AVAIL config-tip-operac THEN
        EMPTY TEMP-TABLE tt-variavel.
    
    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper = 'transaction'
           tt-variavel.cod-val-var  = pTranAction.
    /*---[ PAI ]------------------------------------------------------------------------------*/
    
    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper = 'cod-estabel'
           tt-variavel.cod-val-var  = Site.
    
    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper = 'cod-emitente'
           tt-variavel.cod-val-var  = STRING(CustomerNumber).
    
    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper = 'cidade'
           tt-variavel.cod-val-var  = CityName.
    
    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper = 'estado'
           tt-variavel.cod-val-var  = StateCode.
    
    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper = 'nat-operacao'
           tt-variavel.cod-val-var  = FiscalOperationCode.
    
    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper = 'cod-acesso-cte'
           tt-variavel.cod-val-var  = NFEletroAcessKey.

    RUN cdp/cdapi034.p (INPUT i-ep-codigo-usuario,
                        INPUT Site,
                        INPUT 'axrof002',
                        INPUT TABLE tt-variavel,
                        OUTPUT i-cod-regra-utilizada,
                        OUTPUT TABLE tt-retorno,
                        OUTPUT TABLE RowErrors).
    
    IF  CAN-FIND(FIRST tt-retorno
                 WHERE tt-retorno.campo-retorno = 'axrof002'
                 AND   tt-retorno.valor-retorno = 'no') THEN DO:
        RUN PI_gera_tt_log_erro.
        RETURN 'NOK'. 
    END.  
    
    for each tt-retorno:
             CASE tt-retorno.campo-retorno:
                 WHEN "cod-estabel"  THEN ASSIGN Site                = tt-retorno.valor-retorno.
                 WHEN "cod-emitente" THEN ASSIGN CustomerNumber      = INT(tt-retorno.valor-retorno).
                 WHEN "cidade"       THEN ASSIGN CityName            = tt-retorno.valor-retorno.
                 WHEN "estado"       THEN ASSIGN StateCode           = tt-retorno.valor-retorno.
                 WHEN "nat-operacao" THEN ASSIGN FiscalOperationCode = tt-retorno.valor-retorno. 
             END CASE.
    end. /* for each tt-retorno: */    
    
    /*---[ FILHO it-nota-fisc ]----------------------------------------------------------------------------*/
    IF CAN-FIND (FIRST ttDocumentItemsType)  THEN
    DO:
        FOR EACH ttDocumentItemsType:
    
            CREATE tt-variavel.
            ASSIGN tt-variavel.cod-var-oper = 'it-cod-estabel'
                   tt-variavel.cod-val-var  = ttDocumentItemsType.Site.
            
            CREATE tt-variavel.
            ASSIGN tt-variavel.cod-var-oper = 'it-cod-emitente'
                   tt-variavel.cod-val-var  = STRING(ttDocumentItemsType.CustomerNumber).
            
            CREATE tt-variavel.
            ASSIGN tt-variavel.cod-var-oper = 'it-it-codigo'
                   tt-variavel.cod-val-var  = ttDocumentItemsType.Item.
            
            CREATE tt-variavel.
            ASSIGN tt-variavel.cod-var-oper = 'it-nat-operacao'
                   tt-variavel.cod-val-var  = ttDocumentItemsType.FiscalOperationCode.
            
            CREATE tt-variavel.
            ASSIGN tt-variavel.cod-var-oper = 'it-cd-trib-iss'
                   tt-variavel.cod-val-var  = STRING(ttDocumentItemsType.ISSTaxationCode).
            
            CREATE tt-variavel.
            ASSIGN tt-variavel.cod-var-oper = 'it-aliquota-ISS'
                   tt-variavel.cod-val-var  = STRING(ttDocumentItemsType.ISSPercentage).
            
            CREATE tt-variavel.
            ASSIGN tt-variavel.cod-var-oper = 'it-cd-trib-icm'
                   tt-variavel.cod-val-var  = STRING(ttDocumentItemsType.ICMSTaxationCode).
            
            CREATE tt-variavel.
            ASSIGN tt-variavel.cod-var-oper = 'it-aliquota-icm'
                   tt-variavel.cod-val-var  = STRING(ttDocumentItemsType.ICMSPercentage).
    
    
            RUN cdp/cdapi034.p (INPUT i-ep-codigo-usuario,
                                INPUT Site,
                                INPUT 'axrof002',
                                INPUT TABLE tt-variavel,
                                OUTPUT i-cod-regra-utilizada,
                                OUTPUT TABLE tt-retorno,
                                OUTPUT TABLE RowErrors).
            IF  CAN-FIND(FIRST tt-retorno
                         WHERE tt-retorno.campo-retorno = 'axrof002'
                         AND   tt-retorno.valor-retorno = 'no') THEN DO:
                RUN PI_gera_tt_log_erro.
                RETURN 'NOK'. 
            END.  
    
            for each tt-retorno:
                    CASE tt-retorno.campo-retorno:
                        WHEN "it-cod-estabel"  THEN ASSIGN ttDocumentItemsType.Site                = tt-retorno.valor-retorno.
                        WHEN "it-cod-emitente" THEN ASSIGN ttDocumentItemsType.CustomerNumber      = INT(tt-retorno.valor-retorno).
                        WHEN "it-it-codigo"    THEN ASSIGN ttDocumentItemsType.Item                = tt-retorno.valor-retorno.
                        WHEN "it-nat-operacao" THEN ASSIGN ttDocumentItemsType.FiscalOperationCode = tt-retorno.valor-retorno.
                        WHEN "it-cd-trib-iss"  THEN ASSIGN ttDocumentItemsType.ISSTaxationCode     = INT(tt-retorno.valor-retorno).
                        WHEN "it-aliquota-ISS" THEN ASSIGN ttDocumentItemsType.ISSPercentage       = INT(tt-retorno.valor-retorno).
                        WHEN "it-cd-trib-icm"  THEN ASSIGN ttDocumentItemsType.ICMSTaxationCode    = INT(tt-retorno.valor-retorno).
                        WHEN "it-aliquota-icm" THEN ASSIGN ttDocumentItemsType.ICMSPercentage      = INT(tt-retorno.valor-retorno).
                    END CASE.
            end. /* for each tt-retorno: */   

        end.
    END.
    

    RETURN "OK":U.

    /*---------------------------------------------------------------------------------[ integraá∆o EMSxNeogrid ]---*/


END PROCEDURE.
