DEFINE TEMP-TABLE ttStack NO-UNDO
     FIELD ttID AS INTEGER
     FIELD ttPos AS INTEGER
     INDEX tt_id IS PRIMARY UNIQUE
           ttID  ASCENDING.


FUNCTION addStack RETURN INTEGER (INPUT val AS INTEGER).
     DEFINE VAR id AS INTEGER INITIAL 1 NO-UNDO.
     FIND LAST ttStack NO-ERROR.
     IF AVAIL(ttStack) THEN
          id = ttStack.ttID + 1.

     CREATE ttStack.
     ASSIGN ttStack.ttID = id.
     ASSIGN ttStack.ttPos = val.
END FUNCTION.


FUNCTION delStack RETURN INTEGER.
     FIND LAST ttStack NO-ERROR.
     IF AVAIL(ttStack) THEN
          DELETE ttStack.

     FIND LAST ttStack NO-ERROR.
END FUNCTION.


FUNCTION getStack RETURN INTEGER.
     IF AVAIL(ttStack) THEN
          RETURN ttStack.ttPos.
     ELSE
          RETURN 0.
END FUNCTION.




/****** INTERNAL PROCEDURES - BEGIN*/
PROCEDURE PIDelete:

/*PARAMETERS - BEGIN*/
DEFINE INPUT PARAM cEvent AS CHARACTER INITIAL ? NO-UNDO.
DEFINE INPUT PARAM cTranAction AS CHARACTER INITIAL ? NO-UNDO.
DEFINE INPUT PARAM CustomerVendorCode_00 AS integer INITIAL ? NO-UNDO.  /*C¢digo do Emitente (Uso interno: campo=mgadm.emitente.cod-emitente ou emsuni.cliente.cdn_cliente ou emsuni.fornecedor.cdn_fornecedor)  */
DEFINE INPUT PARAM CustomerVendorIdentification_00 AS integer INITIAL ? NO-UNDO.  /*Tipo de Emitente (Cliente ou Fornecedor). (Uso interno: campo=mgadm.emitente.identific   Valores poss°veis= 1- Cliente  2- Fornecedor   3- Ambos)*/
DEFINE INPUT PARAM CustomerVendorName_00 AS CHARACTER INITIAL ? NO-UNDO.  /*Nome do Emitente (Uso Interno: campo=mgadm.emtiente.nome-emit ou emsuni.cliente.nom_pessoa ou emsuni.fornecedor.nom_pessoa)*/
DEFINE INPUT PARAM CustomerVendorShortName_00 AS CHARACTER INITIAL ? NO-UNDO.  /*Nome Abreviado do Emitente (Uso interno: campo=mgadm.emitente.nome-abrev ou emsuni.cliente.nom_abrev ou emsuni.fornecedor.nom_abrev)*/
DEFINE OUTPUT PARAM TABLE FOR tt_log_erro.
/*PARAMETERS - END*/


/*LOCAL VARIABLES - BEGIN*/
DEFINE VAR iCount AS INTEGER INITIAL ? NO-UNDO.
DEFINE VAR iId AS INTEGER INITIAL ? NO-UNDO.
DEFINE VAR pErrorId AS INTEGER INITIAL ? NO-UNDO.
DEFINE VAR pErrorType AS CHARACTER INITIAL ? NO-UNDO.
DEFINE VAR pTotalErrors AS INTEGER INITIAL ? NO-UNDO.
/*LOCAL VARIABLES - END*/


/* ******************************************* */
/* *************** BODY - BEGIN ************** */
/* ******************************************* */

/* VERIFICA SE MessageHandler.p ESTA NA MEMORIA */
{xmlinc/xmlloadmessagehandler.i &MessageHandler="hMessageHandler" &MHReturnValue="cReturnValue"}

IF cReturnValue <> "OK" THEN DO:
     CREATE TT_LOG_ERRO.
          ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 0.
          /* Inicio -- Projeto Internacional */
          {utp/ut-liter.i "Erro_ao_executar_MessageHandle" *}
          ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO = RETURN-VALUE + ": "+ cReturnValue.
     RETURN cReturnValue.
END.

RUN isSubscribed IN hMessageHandler ("{&XmlProdName}", 
     "{&XmlApp}", 
     "{&XmlTranName}", 
     "{&XmlTranVersion}", 
     cEvent, 
     cTranAction, 
     OUTPUT lCreateMsg)
.

IF RETURN-VALUE <> "OK" THEN DO:
     CREATE TT_LOG_ERRO.
          ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 0.
          /* Inicio -- Projeto Internacional */
          DEFINE VARIABLE c-lbl-liter AS CHARACTER NO-UNDO.
          ASSIGN c-lbl-liter = TRIM(RETURN-VALUE).
          DEFINE VARIABLE c-lbl-liter-erro-ao-executar-i AS CHARACTER NO-UNDO.
          {utp/ut-liter.i "Erro_ao_executar_isSubscribed_no_MessageHandle" *}
          ASSIGN c-lbl-liter-erro-ao-executar-i = TRIM(RETURN-VALUE).
          ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO = c-lbl-liter-erro-ao-executar-i + ": "+ c-lbl-liter.
     RETURN RETURN-VALUE.
END.

IF  NOT lCreateMsg THEN
    RETURN "OK".

/* PREENCHE O VALOR DO ELEM. Comment DE TransactionId */
RUN setTransInfoComment IN hMessageHandler ("Comentario do desenvolvedor").



/* SETA SystemId */
RUN setSystemId IN hMessageHandler ("{&XmlMod}",  "{&XmlProdVersion}").



/*INDICA O VALOR DA CHAVE PRIMµRIA DA TRANSAÄ«O */
RUN setKeyFields IN hMessageHandler ("CustomerVendorCode", String(CustomerVendorCode_00)).


/* INFORMA A EMPRESA E O ESTABELECIMENTO */
/*RUN setCompanyId IN hMessageHandler ("cCodEmp", "cCodEstab").*/



     /* RESETA OS VALORES */
     RUN reset IN hGenXml.

     /* SETA VALOR DE ENCODING */
     RUN setEncoding IN hGenXml ("UTF-8").


     RUN addNode IN hGenXml (getStack(), "Delete", "", OUTPUT iId).
     addStack(iId).

          RUN addNodeDec IN hGenXml (getStack(), "CustomerVendorIdentification", CustomerVendorIdentification_00, OUTPUT iId).
          RUN addNodeDec IN hGenXml (getStack(), "CustomerVendorCode", CustomerVendorCode_00, OUTPUT iId).
          RUN addNode IN hGenXml (getStack(), "CustomerVendorShortName", CustomerVendorShortName_00, OUTPUT iId).
          RUN addNode IN hGenXml (getStack(), "CustomerVendorName", CustomerVendorName_00, OUTPUT iId).

          /* ---   Operacional Textil - Exportacao Cliente ou fornecedor   --- */
          RUN addNodeDec IN hGenXml (getStack(), "IdentificationType", v-identific, OUTPUT iId).
          RUN addNodeDec IN hGenXml (getStack(), "IdentificationAction", v-acao, OUTPUT iId).

     delStack().


/* OBTEM O XML NUMA HANDLE */
RUN generateXML IN hGenXml (OUTPUT hBusinessContent).


/* DEFINE O CONTEÈDO DO ELEMENTO BusinessContent */
RUN setBusinessContent IN hMessageHandler (INPUT hBusinessContent).

/* LIBERA MEM‡RIA ALOCADA PARA O OBJETO */
DELETE OBJECT hBusinessContent NO-ERROR.



