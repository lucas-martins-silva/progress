BUFFER-COPY cotacao-item TO tt-cotacao-item.
ASSIGN 
    &IF "{&bf_mat_versao_ems}" >= "2.09" &THEN
        tt-cotacao-item.cod-respos-fornec     = IF ttQuotationLine.VendorResponseCode <> ? THEN ttQuotationLine.VendorResponseCode ELSE "":U 
        tt-cotacao-item.log-integr-portal     = YES 
        tt-cotacao-item.log-congela-cotac     = YES
        tt-cotacao-item.cod-cotac-portal      = IF ttQuotationLine.QuotationNumberPortal <> ? THEN ttQuotationLine.QuotationNumberPortal ELSE "":U
        tt-cotacao-item.cod-cotac-pai-portal  = IF ttQuotationLine.QuotationParentNumberPortal <> ? THEN ttQuotationLine.QuotationParentNumberPortal ELSE "":U 
        tt-cotacao-item.val-preco-liq-item    = ttQuotationLine.NetUnitaryPrice
    &ELSE
        tt-cotacao-item.char-2 = ""
        OVERLAY(tt-cotacao-item.char-2,121,18) = IF ttQuotationLine.VendorResponseCode <> ? THEN ttQuotationLine.VendorResponseCode ELSE "":U                    
        OVERLAY(tt-cotacao-item.char-2,101,1) = "S":U                                                                                                            
        OVERLAY(tt-cotacao-item.CHAR-2,102,1) = "S":U                                                                                                            
        OVERLAY(tt-cotacao-item.char-2,103,18) = IF ttQuotationLine.QuotationNumberPortal <> ? THEN ttQuotationLine.QuotationNumberPortal ELSE "":U              
        OVERLAY(tt-cotacao-item.char-2,139,18) = IF ttQuotationLine.QuotationParentNumberPortal <> ? THEN ttQuotationLine.QuotationParentNumberPortal ELSE "":U 
        overlay(tt-cotacao-item.char-2,157,17) = string(ttQuotationLine.NetUnitaryPrice)
    &ENDIF
        tt-cotacao-item.un               = ttQuotationLine.UnitOfMeasureCode 
        tt-cotacao-item.hora-atualiz     = STRING(TIME,"hh:mm:ss")
        tt-cotacao-item.data-atualiz     = TODAY
        tt-cotacao-item.data-cotacao     = TODAY
        tt-cotacao-item.mo-codigo        = ttPurchaseOrderLine.CurrencyId
        tt-ordem-compra.mo-codigo        = ttPurchaseOrderLine.CurrencyId  
        tt-cotacao-item.prazo-entreg     = ttQuotationLine.DeliveryDate - today
        tt-cotacao-item.cod-comprado     = ttQuotationLine.Buyer
        tt-cotacao-item.usuario          = ttQuotationLine.Buyer
        tt-ordem-compra.qt-solic         = ttQuotationLine.POLineQuantityRequested
        tt-cotacao-item.motivo-apr       = ttQuotationLine.ApprovalReason
        tt-cotacao-item.aprovador        = ttQuotationLine.ApproverID
        tt-cotacao-item.cot-aprovada     = ttQuotationLine.IsQuoteApproved
        tt-cotacao-item.preco-fornec     = ttQuotationLine.VendorPrice
        tt-cotacao-item.preco-unit       = ttQuotationLine.NetUnitaryPrice 
        tt-cotacao-item.cod-cond-pag     = ttQuotationLine.PaymentPlanCode
        tt-ordem-compra.cod-cond-pag     = ttQuotationLine.PaymentPlanCode
        tt-cotacao-item.cod-transp       = ttQuotationLine.CarrierID
        tt-cotacao-item.narrativa        = IF ttQuotationLine.QuoteText <> ? THEN ttQuotationLine.QuoteText ELSE "":U
        tt-cotacao-item.valor-taxa       = ttQuotationLine.FinancialRatePercentage
        tt-cotacao-item.nr-dias-taxa     = ttQuotationLine.FinancialRateDays         
        tt-cotacao-item.aliquota-ipi     = ttQuotationLine.IndustrializedProductTaxPerce_00
        tt-ordem-compra.aliquota-icm     = ttQuotationLine.ServicesAndProductsCirculatio_00
        tt-cotacao-item.aliquota-icm     = ttQuotationLine.ServicesAndProductsCirculatio_00
        tt-cotacao-item.codigo-icm       = ttQuotationLine.ServicesAndProductsCirculatio_01
        tt-cotacao-item.aliquota-iss     = ttQuotationLine.ServiceTaxPercentage
        tt-cotacao-item.perc-descto      = ttQuotationLine.DiscountPercentage
        tt-cotacao-item.frete            = IF ttQuotationLine.IsFreightIncluded THEN YES ELSE NO
        tt-cotacao-item.valor-frete      = ttQuotationLine.FreightValue
        i-cod-transp-aux                 = ttQuotationLine.CarrierID
        c-cod-comprador-aux              = ttQuotationLine.Buyer
        tt-cotacao-item.ind-tipo-movto   = 2.

        IF cTranAction = "add":U THEN DO:
            assign tt-cotacao-item.taxa-financ      = ttQuotationLine.IsFinancialRateIncluded 
                   tt-cotacao-item.codigo-ipi       = ttQuotationLine.IsIndustrializedProductTaxInc_00.
        END.
        
        assign l-preco-bruto = (param-compra.ipi-sobre-preco = 1).

        find item where item.it-codigo = tt-cotacao-item.it-codigo no-lock no-error.

        for first prazo-compra field (numero-ordem un) where
            prazo-compra.numero-ordem = tt-cotacao-item.numero-ordem no-lock:
            {cdp/cd9950.i prazo-compra.un
                          tt-cotacao-item.un
                          tt-cotacao-item.cod-emitente}
        end.

        /*Calcula o pre‡o com base no pre‡o unit rio para integra‡Æo do portal de compras WEBB*/
        {cdp/cd9301.i tt-cotacao-item} /** Calculo de Preco **/
        
        {cdp/cd9300.i tt-cotacao-item}

        ASSIGN tt-cotacao-item.preco-unit   = tt-cotacao-item.pre-unit-for * de-indice.
        
        /*Calculo Desconto */
        if  tt-cotacao-item.perc-descto <> 0 then 
             assign tt-cotacao-item.valor-descto = ((tt-cotacao-item.preco-fornec * tt-cotacao-item.perc-descto)/ 100 ).
