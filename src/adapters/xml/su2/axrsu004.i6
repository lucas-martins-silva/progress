/* Pre‡o forncedor */
IF LENGTH(string(TRUNCATE(ttQuotationLine.NetUnitaryPrice,0))) > 11   OR
   LENGTH(substring(string(ttQuotationLine.NetUnitaryPrice - TRUNCATE(ttQuotationLine.NetUnitaryPrice,0)),2,
          LENGTH(STRING(ttQuotationLine.NetUnitaryPrice - TRUNCATE(ttQuotationLine.NetUnitaryPrice,0))))) > 5 THEN DO:

    /* Inicio -- Projeto Internacional */
    {utp/ut-liter.i "Pre‡o_fornecedor" *}
    run utp/ut-msgs.p (INPUT 'msg',
                       INPUT 51338,
                       INPUT RETURN-VALUE + '~~' + string(ttQuotationLine.NetUnitaryPrice) + '~~99999,999,999.99999').

    CREATE tt_log_erro.                  
    ASSIGN tt_log_erro.ttv_num_cod_erro = 51338
           tt_log_erro.ttv_des_msg_erro = trim(RETURN-VALUE).

    RUN setError IN hMessageHandler (INPUT 51338,
                                     INPUT "business_error":U,
                                     INPUT trim(RETURN-VALUE)).

    RETURN "NOK":U.

END.

