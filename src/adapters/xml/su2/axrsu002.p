                 IF iIdSon <> ? THEN      
                    RUN getSonLog IN hGenXml (INPUT getStack(), INPUT "IsMasterProductionPlanConsidered":U, OUTPUT tt-ordem-compra.cons-pmp).


               RUN searchTag IN hGenXml (INPUT "ParentItem":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? THEN DO:
                   addStack(iId).
                        RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ParentItemCode":U, OUTPUT tt-ordem-compra.item-pai).
                   delStack().
               END.

               RUN searchTag IN hGenXml (INPUT "Requisition":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? THEN DO:
                   addStack(iId).
                        RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "RequisitionNumber":U, OUTPUT tt-ordem-compra.nr-requisicao).
                        RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "RequisitionLineSequence":U, OUTPUT tt-ordem-compra.sequencia).
                   delStack().
               END.

               RUN searchTag IN hGenXml (INPUT "PriceTable":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? THEN DO:
                   addStack(iId).
                        RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "PriceTableNumber":U, OUTPUT tt-ordem-compra.nr-tab).
                   delStack().
               END.

               RUN searchTag IN hGenXml (INPUT "CompanyID":U, INPUT getStack(), OUTPUT iIdSon).
                IF iIdSon <> ? THEN    
                   RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "CompanyID":U, OUTPUT tt-ordem-compra.ep-codigo).

               RUN searchTag IN hGenXml (INPUT "EventSequence":U, INPUT getStack(), OUTPUT iIdSon).
                IF iIdSon <> ? THEN   
                   RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "EventSequence":U, OUTPUT tt-ordem-compra.seq-evento).

               RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "POLinePendingApprovalCode":U, OUTPUT tt-ordem-compra.pend-aprov).
                IF tt-ordem-compra.pend-aprov <> 1 AND tt-ordem-compra.pend-aprov <> 2 THEN
                   ASSIGN tt-ordem-compra.pend-aprov = 1.

               RUN searchTag IN hGenXml (INPUT "CarrierInformation":U, INPUT getStack(), OUTPUT iId).
               IF iId <> ? THEN DO:
                   addStack(iId).
                        RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "CarrierID":U, OUTPUT tt-ordem-compra.cod-transp).
                   delStack().
               END.

               RUN searchTag IN hGenXml (INPUT "ImportLicenseNumber":U, INPUT getStack(), OUTPUT iIdSon).
                IF iIdSon <> ? THEN 
                    RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ImportLicenseNumber":U, OUTPUT tt-ordem-compra.licenca-import).

                /* -----   Infomracoes referentes a tabela Prazo Compra   ----- */
               EMPTY TEMP-TABLE tt-prazo-compra NO-ERROR.

               RUN searchTag IN hGenXml (INPUT "ListOfDeliverySchedule":U, INPUT getStack(), OUTPUT iId).
               addStack(iId).

                    ASSIGN i-parcela-ID = 0.

                    RUN getFirstSonId IN hGenXml (INPUT getStack(), OUTPUT iId).

                    DO WHILE iId <> ?:

                         addStack(iId).

                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "DeliveryScheduleID":U, OUTPUT i-parcela).
                         IF i-parcela = ? OR i-parcela = 0 THEN DO:
                             ASSIGN i-parcela-ID = i-parcela-ID + 1
                                    i-parcela    = i-parcela-ID.
                         END.

                         IF CAN-FIND (FIRST tt-prazo-compra WHERE tt-prazo-compra.parcela = i-parcela) THEN DO:
                             RUN  piCriaErro (INPUT 9005, INPUT "EMS":U, INPUT ""). /* Parcela j† informada */      
                             UNDO, RETURN "NOK":U.  
                         END.

                         /*Criacao de valores para manter as relacoes*/
                         CREATE tt-prazo-compra.
                         ASSIGN tt-prazo-compra.numero-ordem = tt-ordem-compra.numero-ordem
                                tt-prazo-compra.parcela      = i-parcela
                                tt-prazo-compra.it-codigo    = tt-ordem-compra.it-codigo.

                         IF cTranAction = "upd":U THEN DO: /* upd */

                            FOR FIRST prazo-compra WHERE 
                                      prazo-compra.numero-ordem = tt-prazo-compra.numero-ordem AND 
                                      prazo-compra.parcela      = tt-prazo-compra.parcela      NO-LOCK: 

                                BUFFER-COPY prazo-compra TO tt-prazo-compra.
                            END.
                         END.

                         RUN searchTag IN hGenXml (INPUT "QuantityInformation":U, INPUT getStack(), OUTPUT iId).
                         IF iId <> ? THEN DO:
                             addStack(iId).

                                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "Quantity":U, OUTPUT tt-prazo-compra.quantidade).

                                  RUN searchTag IN hGenXml (INPUT "OriginalQuantity":U, INPUT getStack(), OUTPUT iIdSon).
                                   IF iIdSon <> ? THEN    
                                      RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "OriginalQuantity":U, OUTPUT tt-prazo-compra.quantid-orig).

                                  RUN searchTag IN hGenXml (INPUT "BalenceQuantity":U, INPUT getStack(), OUTPUT iIdSon).
                                   IF iIdSon <> ? THEN   
                                      RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "BalenceQuantity":U, OUTPUT tt-prazo-compra.quant-saldo).

                                  RUN searchTag IN hGenXml (INPUT "ReturnedQuantity":U, INPUT getStack(), OUTPUT iIdSon).
                                   IF iIdSon <> ? THEN   
                                       RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ReturnedQuantity":U, OUTPUT tt-prazo-compra.quant-rejeit).

                                  RUN searchTag IN hGenXml (INPUT "ReceivedQuantity":U, INPUT getStack(), OUTPUT iIdSon).
                                   IF iIdSon <> ? THEN  
                                      RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ReceivedQuantity":U, OUTPUT tt-prazo-compra.quant-receb).

                                  RUN searchTag IN hGenXml (INPUT "VendorQuantity":U, INPUT getStack(), OUTPUT iIdSon).
                                   IF iIdSon <> ? THEN  
                                      RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "VendorQuantity":U, OUTPUT tt-prazo-compra.qtd-do-forn).

                                  RUN searchTag IN hGenXml (INPUT "VendorBalenceQuantity":U, INPUT getStack(), OUTPUT iIdSon).
                                   IF iIdSon <> ? THEN 
                                      RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "VendorBalenceQuantity":U, OUTPUT tt-prazo-compra.qtd-sal-forn).

                                  RUN searchTag IN hGenXml (INPUT "VendorReturnedQuantity":U, INPUT getStack(), OUTPUT iIdSon).
                                   IF iIdSon <> ? THEN 
                                      RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "VendorReturnedQuantity":U, OUTPUT tt-prazo-compra.qtd-rej-forn).

                                  RUN searchTag IN hGenXml (INPUT "VendorReceivedQuantity":U, INPUT getStack(), OUTPUT iIdSon).
                                   IF iIdSon <> ? THEN 
                                      RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "VendorReceivedQuantity":U, OUTPUT tt-prazo-compra.qtd-rec-forn).

                             delStack().
                         END.

                         RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "DeliveryDate":U, OUTPUT tt-prazo-compra.data-entrega).

                         RUN searchTag IN hGenXml (INPUT "Item":U, INPUT getStack(), OUTPUT iId).
                         IF iId <> ? THEN DO:
                             addStack(iId).

                                  RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ItemUnitOfMeasure":U, OUTPUT tt-prazo-compra.un).

                                  RUN searchTag IN hGenXml (INPUT "ItemReferenceCode":U, INPUT getStack(), OUTPUT iIdSon).
                                   IF iIdSon <> ? THEN 
                                      RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ItemReferenceCode":U, OUTPUT tt-prazo-compra.cod-refer).

                             delStack().
                         END.
                         IF tt-prazo-compra.cod-refer = "" THEN 
                             ASSIGN tt-prazo-compra.cod-refer = tt-ordem-compra.cod-refer.

                         RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "OriginalDeliveryDate":U, OUTPUT tt-prazo-compra.data-orig).
                          IF tt-prazo-compra.data-orig = ? OR string(tt-prazo-compra.data-orig) = "" THEN 
                             ASSIGN tt-prazo-compra.data-orig = TODAY. /* default */

                         RUN searchTag IN hGenXml (INPUT "SalesOrder":U, INPUT getStack(), OUTPUT iId).
                         IF iId <> ? THEN DO:
                             addStack(iId).

                                  RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "CustomerShortName":U, OUTPUT tt-prazo-compra.nome-abrev).
                                  RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "SalesOrderNumber":U, OUTPUT tt-prazo-compra.pedido-clien).
                                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "SalesOrderLineNumber":U, OUTPUT tt-prazo-compra.nr-sequencia).

                                  RUN searchTag IN hGenXml (INPUT "SalesOrderDeliverySequence":U, INPUT getStack(), OUTPUT iIdSon).
                                   IF iIdSon <> ? THEN 
                                      RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "SalesOrderDeliverySequence":U, OUTPUT tt-prazo-compra.nr-entrega).

                             delStack().
                         END.

                         RUN searchTag IN hGenXml (INPUT "UpdateDate":U, INPUT getStack(), OUTPUT iIdSon).
                          IF iIdSon <> ? THEN
                             RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "UpdateDate":U, OUTPUT tt-prazo-compra.data-alter).

                         RUN searchTag IN hGenXml (INPUT "LastUpdateUser":U, INPUT getStack(), OUTPUT iId).
                         IF iId <> ? THEN DO:
                             addStack(iId).
                                  RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "UserID":U, OUTPUT tt-prazo-compra.usuario-alt).
                             delStack().
                         END.

                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "Status":U, OUTPUT tt-prazo-compra.situacao).
                          IF tt-prazo-compra.situacao = ? OR tt-prazo-compra.situacao < 1 OR tt-prazo-compra.situacao > 6 THEN
                             ASSIGN tt-prazo-compra.situacao = 1.
                         RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "Type":U, OUTPUT tt-prazo-compra.natureza).
                          IF tt-prazo-compra.natureza = ? OR  tt-prazo-compra.natureza < 1 OR  tt-prazo-compra.natureza > 3 THEN
                             ASSIGN  tt-prazo-compra.natureza = 1.

                         RUN searchTag IN hGenXml (INPUT "DeliveryTime":U, INPUT getStack(), OUTPUT iIdSon).
                          IF iIdSon <> ? THEN
                             RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "DeliveryTime":U, OUTPUT tt-prazo-compra.hora).

                         RUN searchTag IN hGenXml (INPUT "Concentration":U, INPUT getStack(), OUTPUT iIdSon).
                          IF iIdSon <> ? THEN
                             RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "Concentration":U, OUTPUT tt-prazo-compra.concentracao).

                         RUN searchTag IN hGenXml (INPUT "Efficiency":U, INPUT getStack(), OUTPUT iIdSon).
                          IF iIdSon <> ? THEN
                             RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "Efficiency":U, OUTPUT tt-prazo-compra.rendimento).

                         RUN searchTag IN hGenXml (INPUT "IsPOLineIssued":U, INPUT getStack(), OUTPUT iIdSon).
                          IF iIdSon <> ? THEN
                             RUN getSonLog IN hGenXml (INPUT getStack(), INPUT "IsPOLineIssued":U, OUTPUT tt-prazo-compra.ordem-emitida).

                         RUN searchTag IN hGenXml (INPUT "StructureNumber":U, INPUT getStack(), OUTPUT iIdSon).
                          IF iIdSon <> ? THEN
                             RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "StructureNumber":U, OUTPUT tt-prazo-compra.nr-estrut).

                         RUN searchTag IN hGenXml (INPUT "ChildStructureNumber":U, INPUT getStack(), OUTPUT iIdSon).
                          IF iIdSon <> ? THEN
                             RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ChildStructureNumber":U, OUTPUT tt-prazo-compra.nr-estrut-filha).


                         RUN searchTag IN hGenXml (INPUT "QuotationItem":U, INPUT getStack(), OUTPUT iId).
                         IF iId <> ? THEN DO:
                             addStack(iId).
                                  RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ItemCode":U, OUTPUT tt-prazo-compra.item-cotacao).
                             delStack().
                         END.

                         RUN searchTag IN hGenXml (INPUT "Component":U, INPUT getStack(), OUTPUT iIdSon).
                          IF iIdSon <> ? THEN
                             RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "Component":U, OUTPUT tt-prazo-compra.es-codigo).

                         RUN searchTag IN hGenXml (INPUT "ComponentSequenceNumber":U, INPUT getStack(), OUTPUT iIdSon).
                          IF iIdSon <> ? THEN
                             RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ComponentSequenceNumber":U, OUTPUT tt-prazo-compra.sequencia).

                         ASSIGN iId = getStack().
                         delStack().
                         RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
                    END.

               delStack().

               
               /*Integraá∆o Portal Compra - Maylon*/
               IF l-integra-portal THEN DO:
                   &IF  "{&bf_mat_versao_ems}"  >=  "2.062"  &THEN
                       RUN searchTag IN hGenXml (INPUT "Freeze":U, INPUT getStack(), OUTPUT iIdSon).
                       IF iIdSon <> ? THEN DO:
                           RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "Freeze":U, OUTPUT c-freeze).
                       END.
    
                       RUN searchTag IN hGenXml (INPUT "PortalIntegration":U, INPUT getStack(), OUTPUT iIdSon).
                       IF iIdSon <> ? THEN DO:
                           RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "PortalIntegration":U, OUTPUT c-PortalIntegration).
                       END.
    
                       RUN searchTag IN hGenXml (INPUT "POLineNumberPortal":U, INPUT getStack(), OUTPUT iIdSon).
                       IF iIdSon <> ? THEN DO:
                           RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "POLineNumberPortal":U, OUTPUT c-POLineNumberPortal).
                       END.
    
                       RUN searchTag IN hGenXml (INPUT "DeliveryLoc":U, INPUT getStack(), OUTPUT iIdSon).
                       IF iIdSon <> ? THEN DO:
                           RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "DeliveryLoc":U, OUTPUT tt-ordem-compra.loc-entrega).
                       END.
    
                       RUN searchTag IN hGenXml (INPUT "DeliveryCod":U, INPUT getStack(), OUTPUT iIdSon).
                       IF iIdSon <> ? THEN DO:
                           RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "DeliveryCod":U, OUTPUT tt-ordem-compra.cod-entrega).
                       END.
    
                       RUN searchTag IN hGenXml (INPUT "DeliverySite":U, INPUT getStack(), OUTPUT iIdSon).
                       IF iIdSon <> ? THEN DO:
                           RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "DeliverySite":U, OUTPUT tt-ordem-compra.estab-entrega).
                       END.
    
                       RUN searchTag IN hGenXml (INPUT "DeliveryLoc2":U, INPUT getStack(), OUTPUT iIdSon).
                       IF iIdSon <> ? THEN DO:
                           RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "DeliveryLoc2":U, OUTPUT tt-ordem-compra.local-entrega).
                       END.
                       
                       RUN searchTag IN hGenXml (INPUT "ListOfDestinationPartner":U, INPUT getStack(), OUTPUT iId).
                       addStack(iId).
    
                        
                        RUN getFirstSonId IN hGenXml (INPUT getStack(), OUTPUT iId).
    
                        DO WHILE iId <> ?:
                             addStack(iId).
    
                              CREATE ttDestinationPartner.
                              RUN searchTag IN hGenXml (INPUT "Cod":U, INPUT getStack(), OUTPUT iIdSon).
                              IF iIdSon <> ? THEN
                                  RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "Cod":U, OUTPUT ttDestinationPartner.CodDestination).
    
                             delStack().
                             ASSIGN iId = getStack().
                             delStack().
                             RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
                        END.
                       delStack().
    
                       &IF  "{&bf_mat_versao_ems}"  <  "2.09"  &THEN
                          ASSIGN OVERLAY(tt-ordem-compra.char-1,90,1)  = c-freeze
                                 OVERLAY(tt-ordem-compra.CHAR-1,91,1)  = c-PortalIntegration
                                 OVERLAY(tt-ordem-compra.char-1,92,50) = c-POLineNumberPortal.
                       &ELSE
                          ASSIGN tt-ordem-compra.log-integr-portal = c-freeze            
                                 tt-ordem-compra.log-congela-ord   = c-PortalIntegration 
                                 tt-ordem-compra.cod-ord-portal    = c-POLineNumberPortal.
                       &ENDIF
                       
                   &ENDIF
                END.
               /*Maylon*/

     delStack().
     /* ********* LEITURA DA MENSAGEM - END   ********* */

    {adapters/xml/su2/axrsu002upsert.i}


/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.


PROCEDURE receiveMessage:

    
/*PARAMETERS - BEGIN*/
DEFINE INPUT PARAM hInputXML AS HANDLE NO-UNDO.
DEFINE OUTPUT PARAM hOutputXML AS HANDLE NO-UNDO.
/*PARAMETERS - END*/


/*LOCAL VARIABLES - BEGIN*/
/*LOCAL VARIABLES - END*/


/* ******************************************* */
/* *************** BODY - BEGIN ************** */
/* ******************************************* */

     /* VERIFICA SE MessageHandler.p ESTA NA MEMORIA */
     {xmlinc/xmlloadmessagehandlerrec.i &MessageHandler="hMessageHandler" &MHReturnValue="cReturnValue" &MHReturnError="hOutputXML"}
  
     IF  cReturnValue <> "OK":U THEN 
      IF cReturnValue <> ? AND cReturnValue <> "" THEN 
        RUN setError IN hMessageHandler (INPUT 0,
                                         INPUT "enviroment_error":U,
                                         INPUT cReturnValue).

     /* INTERPRETA, ARMAZENA E VALIDA A MENSAGEM QUE RECEBE */
     RUN parseMessage IN hMessageHandler (
          INPUT  hInputXml, INPUT "{&XmlTranName}", 
          INPUT "{&XmlMaxTranVersion}", 
          INPUT "{&XmlMinTranVersion}", 
          INPUT "{&XmlListOfEvents}",
          OUTPUT lSuccessProcess,
          OUTPUT cTranAction, 
          OUTPUT cTranEvent,
          OUTPUT cTranVersion,
          OUTPUT hOutputXML ).

     /* SE N√O PROCESSOU CORRETAMENTE RETORNA ERRO */
     IF NOT lSuccessProcess OR RETURN-VALUE <> "OK" THEN 
        IF cReturnValue <> ? AND cReturnValue <> " " THEN
          RUN setError IN hMessageHandler (INPUT 0,
                                           INPUT "enviroment_error":U,
                                           INPUT cReturnValue).

         /* VERIFICA SE APIXML ESTA NA MEMORIA */
         {xmlinc/xmlloadgenxmlrec.i &GenXml="hGenXml" &GXReturnValue="cReturnValue" &GXReturnError="hOutputXML"}

         /* VERIFICA SE O ut-genxml FOI INICIADO CORRETAMENTE */
         IF cReturnValue <> "OK" THEN 
            IF cReturnValue <> ? AND cReturnValue <> "" THEN DO:

              /* ELIMINA A MENSAGEM OBTIDA NO MêTODO getBusinessContent */
              DELETE OBJECT hBusinessContent NO-ERROR.

              RUN setError IN hMessageHandler (INPUT 0,
                                                    INPUT "enviroment_error":U,
                                                    INPUT cReturnValue).
              RETURN cReturnValue.
         END.


    {adapters/xml/su2/axrsu002versioncontrol.i}


/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.

/****** INTERNAL PROCEDURES - END*/





