                                                             WHEN "BBM-DT-CAD-INI" THEN DO:
                                                                 FIND FIRST bf-ttExtraInformation OF ttQuotationLine NO-LOCK 
                                                                      WHERE bf-ttExtraInformation.infoKey = "BBM-HR-CAD-INI" NO-ERROR.
                                                                 ASSIGN dtData = DATE(ttExtraInformation.InfoValue)
                                                                        ttExtraInformation.InfoValue = SUBSTRING(STRING(dtData,"99/99/9999"),7,4) + "-" + SUBSTRING(STRING(dtData,"99/99/9999"),4,2) + "-" + SUBSTRING(STRING(dtData,"99/99/9999"),1,2)
                                                                        ttExtraInformation.InfoValue = TRIM(ttExtraInformation.InfoValue) + "T" + TRIM(bf-ttExtraInformation.InfoValue).
                                                             END.

                                                             WHEN "BBM-DT-PREG-FIM" THEN DO:
                                                                 FIND FIRST bf-ttExtraInformation OF ttQuotationLine NO-LOCK 
                                                                      WHERE bf-ttExtraInformation.infoKey = "BBM-HR-PREG-FIM" NO-ERROR.
                                                                 ASSIGN dtData = DATE(ttExtraInformation.InfoValue)
                                                                        ttExtraInformation.InfoValue = SUBSTRING(STRING(dtData,"99/99/9999"),7,4) + "-" + SUBSTRING(STRING(dtData,"99/99/9999"),4,2) + "-" + SUBSTRING(STRING(dtData,"99/99/9999"),1,2)
                                                                        ttExtraInformation.InfoValue = TRIM(ttExtraInformation.InfoValue) + "T" + TRIM(bf-ttExtraInformation.InfoValue).
                                                             END.

                                                             WHEN "BBM-DT-PREG-INI" THEN DO:
                                                                 FIND FIRST bf-ttExtraInformation OF ttQuotationLine NO-LOCK 
                                                                      WHERE bf-ttExtraInformation.infoKey = "BBM-HR-PREG-INI" NO-ERROR.
                                                                 ASSIGN dtData = DATE(ttExtraInformation.InfoValue)
                                                                        ttExtraInformation.InfoValue = SUBSTRING(STRING(dtData,"99/99/9999"),7,4) + "-" + SUBSTRING(STRING(dtData,"99/99/9999"),4,2) + "-" + SUBSTRING(STRING(dtData,"99/99/9999"),1,2)
                                                                        ttExtraInformation.InfoValue = TRIM(ttExtraInformation.InfoValue) + "T" + TRIM(bf-ttExtraInformation.InfoValue).
                                                             END.

                                                         END CASE.

                                                         RUN addNode IN hGenXml (getStack(), "Value", ttExtraInformation.InfoValue, OUTPUT iId).
                                                     END.
                                                     WHEN 6 THEN DO: /* Binario */
                                                         RUN loadMemptrFromfile IN hGenXml (ttExtraInformation.InfoValue, OUTPUT mData).
                                                         RUN addNodeMemptr IN hGenXml (getStack(), "Value", mData, OUTPUT iId).
                                                     END.
                                                 END CASE.

                                             delStack().
                                       END.
                                       
                                   END.
                              delStack().

                         END. /*Test LOGIC*/
                    delStack().

               END.
          delStack().


     delStack().

/* OBTEM O XML NUMA HANDLE */
RUN generateXML IN hGenXml (OUTPUT hBusinessContent).

/* DEFINE O CONTEÈDO DO ELEMENTO BusinessContent */
RUN setBusinessContent IN hMessageHandler (INPUT hBusinessContent).

/* LIBERA MEM‡RIA ALOCADA PARA O OBJETO */
DELETE OBJECT hBusinessContent NO-ERROR.

/*CONTR‡I A MENSAGEM XML E ENVIA PARA O ControlBroker */
RUN sendMessage IN hMessageHandler (INPUT "su2/ProcessQuotations_207_000.xsd"). 

/* VERIFICA SE OCORREU ALGUM ERRO */
IF RETURN-VALUE <> "OK" THEN DO:
     CREATE TT_LOG_ERRO.
          ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 0.
          /* Inicio -- Projeto Internacional */
          DEFINE VARIABLE c-lbl-liter-4 AS CHARACTER NO-UNDO.
          ASSIGN c-lbl-liter-4 = TRIM(RETURN-VALUE).
          DEFINE VARIABLE c-lbl-liter-erro-no-envio-da-mensagem-2 AS CHARACTER NO-UNDO.
          {utp/ut-liter.i "Erro_no_envio_da_Mensagem" *}
          ASSIGN c-lbl-liter-erro-no-envio-da-mensagem-2 = TRIM(RETURN-VALUE).
          ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO = c-lbl-liter-erro-no-envio-da-mensagem-2 + ": "+ c-lbl-liter-4.
     RETURN RETURN-VALUE.
END.

/* VERIFICA SE A MENSAGEM FOI PROCESSADA COM SUCESSO */
RUN getReturnStatus IN hMessageHandler (OUTPUT pSendSuccess, OUTPUT pTotalErrors).

/* SE NAO ENVIO COM SUCESSO */
IF NOT pSendSuccess THEN DO:
     REPEAT iCount = 1 TO pTotalErrors:
          CREATE TT_LOG_ERRO.
          RUN getError IN hMessageHandler (iCount, OUTPUT TT_LOG_ERRO.TTV_NUM_COD_ERRO, OUTPUT pErrorType, OUTPUT TT_LOG_ERRO.TTV_DES_MSG_ERRO).
     END.
     RETURN "NOK".
END.
ELSE RETURN "OK".

/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.


