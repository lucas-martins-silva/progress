/*Maylon*/
IF l-integra-portal THEN DO:
    IF (ttPurchaseOrderLine.ItemComments <> ?) THEN
    DO: /*Test LOGIC*/
         RUN addNode IN hGenXml (getStack(), "ItemComments", ttPurchaseOrderLine.ItemComments, OUTPUT iId).
    END. /*Test LOGIC*/
    IF (ttPurchaseOrderLine.ItemFamily  <> ?) THEN
    DO: /*Test LOGIC*/
         RUN addNode IN hGenXml (getStack(), "ItemFamily ", ttPurchaseOrderLine.ItemFamily , OUTPUT iId).
    END. /*Test LOGIC*/
    IF (ttPurchaseOrderLine.ItemFamilyDescription <> ?) THEN
    DO: /*Test LOGIC*/
         RUN addNode IN hGenXml (getStack(), "ItemFamilyDescription", ttPurchaseOrderLine.ItemFamilyDescription, OUTPUT iId).
    END. /*Test LOGIC*/
END.
/*Maylon*/
