if can-find(first funcao where funcao.cd-funcao = "SPP-INTEGRA-PORTAL-COMPRA":u and
                               funcao.ativo) then do:

    find first param-compra no-lock no-error.
    if avail param-compra and
      &if '{&bf_mat_versao_ems}' < '2.09' &then
        substring(param-compra.char-2,102,1) = "S":U 
      &else
        param-compra.log-integr-portal
      &endif then do:
        assign l-portal = yes.

        find first param-aprov no-lock no-error.

        if param-compra.log-1 and 
           param-aprov.aprova-cotac then do:

            run utp/ut-msgs.p (input 'msg':u,
                               input 51179,
                               input '').

            RUN setError IN hMessageHandler (INPUT 51179,
                                             INPUT "business_error":U,
                                             INPUT return-value).
        end.
    end.
end. 
/* Verifica integraá∆o com a Paradigma */
ELSE if can-find(first funcao where funcao.cd-funcao = "SPP-PORTAL-PARADIGMA":u and
                                    funcao.ativo) then DO:

    find first param-compra no-lock no-error.

    if avail param-compra and
      &if '{&bf_mat_versao_ems}' < '2.09' &then
        substring(param-compra.char-2,103,1) = "S":U 
