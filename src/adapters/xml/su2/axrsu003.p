                                   RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "QuoteEntryProcessNumber", OUTPUT ttQuotationLine.QuoteEntryProcessNumber).
                                   RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "QuoteDispatchProcessNumber", OUTPUT ttQuotationLine.QuoteDispatchProcessNumber).
                              delStack().
                         END.

                         RUN searchTag IN hGenXml (INPUT "ListOfDeliverySchedules", INPUT getStack(), OUTPUT iId).
                         if (iId <> ?) THEN DO:
                              addStack(iId).

                                   RUN getFirstSonId IN hGenXml (INPUT getStack(), OUTPUT iId).

                                   DO WHILE iId <> ?:
                                   addStack(iId).

                                        /*Criacao de valores para manter as relacoes*/
                                        CREATE ttDeliveryScheduleInforma_00.
                                        ASSIGN ttDeliveryScheduleInforma_00.ttDeliveryScheduleInforma_00ID = iId.
                                        ASSIGN ttDeliveryScheduleInforma_00.ttQuotationLineID = ttQuotationLine.ttQuotationLineID.

                                        RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "DeliveryScheduleID", OUTPUT ttDeliveryScheduleInforma_00.DeliveryScheduleID).
                                        RUN searchTag IN hGenXml (INPUT "QuantityInformation", INPUT getStack(), OUTPUT iId).
                                        if (iId <> ?) THEN DO:
                                             addStack(iId).

                                                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "Quantity", OUTPUT ttDeliveryScheduleInforma_00.Quantity).
                                                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "OriginalQuantity", OUTPUT ttDeliveryScheduleInforma_00.OriginalQuantity).
                                                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "BalenceQuantity", OUTPUT ttDeliveryScheduleInforma_00.BalenceQuantity).
                                                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ReturnedQuantity", OUTPUT ttDeliveryScheduleInforma_00.ReturnedQuantity).
                                                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ReceivedQuantity", OUTPUT ttDeliveryScheduleInforma_00.ReceivedQuantity).
                                                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "VendorQuantity", OUTPUT ttDeliveryScheduleInforma_00.VendorQuantity).
                                                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "VendorBalenceQuantity", OUTPUT ttDeliveryScheduleInforma_00.VendorBalenceQuantity).
                                                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "VendorReturnedQuantity", OUTPUT ttDeliveryScheduleInforma_00.VendorReturnedQuantity).
                                                  RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "VendorReceivedQuantity", OUTPUT ttDeliveryScheduleInforma_00.VendorReceivedQuantity).
                                             delStack().
                                        END.

                                        RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "DeliveryDate", OUTPUT ttDeliveryScheduleInforma_00.DeliveryDate).
                                        RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "DeliveryTime", OUTPUT ttDeliveryScheduleInforma_00.DeliveryTime).
                                        RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "OriginalDeliveryDate", OUTPUT ttDeliveryScheduleInforma_00.OriginalDeliveryDate).
                                        RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "UpdateDate", OUTPUT ttDeliveryScheduleInforma_00.UpdateDate).
                                        RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "Status", OUTPUT ttDeliveryScheduleInforma_00.DeliveryScheduleStatus).
                                        RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "Concentration", OUTPUT ttDeliveryScheduleInforma_00.Concentration).
                                        RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "Efficiency", OUTPUT ttDeliveryScheduleInforma_00.Efficiency).
                                        ASSIGN iId = getStack().
                                        delStack().
                                        RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
                                   END.

                              delStack().
                         END.

                         RUN searchTag IN hGenXml (INPUT "ImportInformation", INPUT getStack(), OUTPUT iId).
                         if (iId <> ?) THEN DO:
                              addStack(iId).

                                   /*Criacao de valores para manter as relacoes*/
                                   CREATE ttImportInformation.
                                   ASSIGN ttImportInformation.ttImportInformationID = iId.
                                   ASSIGN ttImportInformation.ttQuotationLineID = ttQuotationLine.ttQuotationLineID.

                                   RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ImportationTaxPercentage", OUTPUT ttImportInformation.ImportationTaxPercentage).
                                   RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "Incoterm", OUTPUT ttImportInformation.Incoterm).
                                   RUN searchTag IN hGenXml (INPUT "SourceCountry", INPUT getStack(), OUTPUT iId).
                                   if (iId <> ?) THEN DO:
                                        addStack(iId).

                                             RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "CountryCode", OUTPUT ttImportInformation.CountryCode).
                                             RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "CountryName", OUTPUT ttImportInformation.CountryName).
                                        delStack().
                                   END.

                                   RUN searchTag IN hGenXml (INPUT "ImportationRules", INPUT getStack(), OUTPUT iId).
                                   if (iId <> ?) THEN DO:
                                        addStack(iId).

                                             RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ImportationRulesCode", OUTPUT ttImportInformation.ImportationRulesCode).
                                             RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ImportationRulesDescription", OUTPUT ttImportInformation.ImportationRulesDescription).
                                        delStack().
                                   END.

                                   RUN searchTag IN hGenXml (INPUT "FiscalClassification", INPUT getStack(), OUTPUT iId).
                                   if (iId <> ?) THEN DO:
                                        addStack(iId).

                                             RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "FiscalClassificationID", OUTPUT ttImportInformation.FiscalClassificationID).
                                             RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "FiscalClassificationDescription", OUTPUT ttImportInformation.FiscalClassificationDescription).
                                        delStack().
                                   END.

                                   RUN searchTag IN hGenXml (INPUT "Itinerary", INPUT getStack(), OUTPUT iId).
                                   if (iId <> ?) THEN DO:
                                        addStack(iId).

                                             RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ItineraryCode", OUTPUT ttImportInformation.ItineraryCode).
                                             RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ItineraryDescription", OUTPUT ttImportInformation.ItineraryDescription).
                                        delStack().
                                   END.

                                   RUN searchTag IN hGenXml (INPUT "ControlPoint", INPUT getStack(), OUTPUT iId).
                                   if (iId <> ?) THEN DO:
                                        addStack(iId).

                                             RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ControlPointCode", OUTPUT ttImportInformation.ControlPointCode).
                                             RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ControlPointDescription", OUTPUT ttImportInformation.ControlPointDescription).
                                        delStack().
                                   END.

                                   RUN searchTag IN hGenXml (INPUT "BasisControlPoint", INPUT getStack(), OUTPUT iId).
                                   if (iId <> ?) THEN DO:
                                        addStack(iId).

                                             RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ControlPointCode", OUTPUT ttImportInformation.ControlPointCode_00).
                                             RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ControlPointDescription", OUTPUT ttImportInformation.ControlPointDescription_00).
                                        delStack().
                                   END.

                                   RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "QuoteMap", OUTPUT ttImportInformation.QuoteMap).
                                   RUN searchTag IN hGenXml (INPUT "Manufacturer", INPUT getStack(), OUTPUT iId).
                                   if (iId <> ?) THEN DO:
                                        addStack(iId).

                                             RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ManufacturerNumber", OUTPUT ttImportInformation.ManufacturerNumber).
                                             RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ManufacturerName", OUTPUT ttImportInformation.ManufacturerName).
                                        delStack().
                                   END.

                                   RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "ShipmentDate", OUTPUT ttImportInformation.ShipmentDate).
                                   RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "DeliveryDate", OUTPUT ttImportInformation.DeliveryDate).
                              delStack().

                         END.

                         RUN searchTag IN hGenXml (INPUT "ListOfQuoteExtraInformation", INPUT getStack(), OUTPUT iId).
                         if (iId <> ?) THEN DO:
                              addStack(iId).

                                   RUN getFirstSonId IN hGenXml (INPUT getStack(), OUTPUT iId).

                                   DO WHILE iId <> ?:
                                   addStack(iId).

                                        /*Criacao de valores para manter as relacoes*/
                                        CREATE ttExtraInformation.
                                        ASSIGN ttExtraInformation.ttExtraInformationID = iId.
                                        ASSIGN ttExtraInformation.ttQuotationLineID = ttQuotationLine.ttQuotationLineID.

                                        RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "Key", OUTPUT ttExtraInformation.InfoKey).
                                        RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "Type", OUTPUT ttExtraInformation.InfoType).
                                        RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "Value", OUTPUT ttExtraInformation.InfoValue).
                                        ASSIGN iId = getStack().
                                        delStack().
                                        RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
                                   END.

                              delStack().
                         END.

                         ASSIGN iId = getStack().
                         delStack().
                         RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
                    END.

               delStack().
          END.
          IF l-portal OR l-paradigma THEN DO:
             RUN searchTag IN hGenXml (INPUT "ListOfDestinationPartner", INPUT getStack(), OUTPUT iId).
             if (iId <> ?) THEN DO:
                 addStack(iId).

                 RUN getFirstSonId IN hGenXml (INPUT getStack(), OUTPUT iId).
    
                 DO WHILE iId <> ?:
                     addStack(iId).
    
                     CREATE ttDestinationPartner.
                     ASSIGN ttDestinationPartner.ttDestinationPartnerId = iId
                            ttDestinationPartner.ttQuotationLineID      = ttQuotationLine.ttQuotationLineID.
    
                     RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "Cod", OUTPUT ttDestinationPartner.Cod).
                        
                     ASSIGN iId = getStack().
                     delStack().
                     RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
                 END.
    
                 delStack().
             END.
          END.

     delStack().
     /* ********* LEITURA DA MENSAGEM - END   ********* */


     /* ********* EFETIVAÄ«O - BEGIN ********* */

if lSuccessProcess then do:

    {adapters/xml/su2/axrsu003upsert.i}

end.

     /* ********* EFETIVAÄ«O - END   ********* */

/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.


PROCEDURE receiveMessage:

/*PARAMETERS - BEGIN*/
DEFINE INPUT PARAM hInputXML AS HANDLE NO-UNDO.
DEFINE OUTPUT PARAM hOutputXML AS HANDLE NO-UNDO.
/*PARAMETERS - END*/


/*LOCAL VARIABLES - BEGIN*/
/*LOCAL VARIABLES - END*/


/* ******************************************* */
/* *************** BODY - BEGIN ************** */
/* ******************************************* */

     /* VERIFICA SE MessageHandler.p ESTA NA MEMORIA */
     {xmlinc/xmlloadmessagehandlerrec.i &MessageHandler="hMessageHandler" &MHReturnValue="cReturnValue" &MHReturnError="hOutputXML"}

     IF cReturnValue <> "OK" THEN DO:
          RETURN cReturnValue.
     END.

     /* INTERPRETA, ARMAZENA E VALIDA A MENSAGEM QUE RECEBE */
     RUN parseMessage IN hMessageHandler (
          INPUT  hInputXml, INPUT "{&XmlTranName}", 
          INPUT "{&XmlMaxTranVersion}", 
          INPUT "{&XmlMinTranVersion}", 
          INPUT "{&XmlListOfEvents}",
          OUTPUT lSuccessProcess,
          OUTPUT cTranAction, 
          OUTPUT cTranEvent,
          OUTPUT cTranVersion,
          OUTPUT hOutputXML ).

     /* SE N«O PROCESSOU CORRETAMENTE RETORNA ERRO */
     IF NOT lSuccessProcess OR RETURN-VALUE <> "OK" THEN 
     /* DAR TRATAMENTO CONVENIENTE ANTES DE RETORNAR */
          RETURN RETURN-VALUE.

     /* VERIFICA SE APIXML ESTA NA MEMORIA */
     {xmlinc/xmlloadgenxmlrec.i &GenXml="hGenXml" &GXReturnValue="cReturnValue" &GXReturnError="hOutputXML"}

     /* VERIFICA SE O ut-genxml FOI INICIADO CORRETAMENTE */
     IF cReturnValue <> "OK"
     THEN DO:
          /* ELIMINA A MENSAGEM OBTIDA NO M?TODO getBusinessContent */
          DELETE OBJECT hBusinessContent NO-ERROR.

          RETURN cReturnValue.
     END.

{adapters/xml/su2/axrsu003versioncontrol.i}

/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.

