/* SETA SystemId */
RUN setSystemId IN hMessageHandler ("{&XmlMod}",  "{&XmlProdVersion}").



/*INDICA O VALOR DA CHAVE PRIMÁRIA DA TRANSAÇÃO */
RUN setKeyFields IN hMessageHandler ("ordem-compra.numero-ordem":U, STRING(POLineNumber_00)).


/* INFORMA A EMPRESA E O ESTABELECIMENTO */
RUN setCompanyId IN hMessageHandler (STRING(v_cdn_empres_usuar), "").



     /* RESETA OS VALORES */
     RUN reset IN hGenXml.

     /* SETA VALOR DE ENCODING */
     RUN setEncoding IN hGenXml ("UTF-8").


     RUN addNode IN hGenXml (getStack(), "Delete":U, "", OUTPUT iId).
     addStack(iId).

          IF PONumber <> ? THEN
          DO: /*Test LOGIC*/
               RUN addNode IN hGenXml (getStack(), "PONumber":U, PONumber, OUTPUT iId).
          END. /*Test LOGIC*/
          RUN addNodeDec IN hGenXml (getStack(), "POLineNumber":U, POLineNumber_00, OUTPUT iId).

          IF VendorNumber_00 <> ? THEN
          DO:
              RUN addNode IN hGenXml (getStack(), "Vendor":U, "", OUTPUT iId).
                  addStack(iId).

                        RUN addNodeDec IN hGenXml (getStack(), "VendorNumber":U, VendorNumber_00, OUTPUT iId).
                        IF VendorName_00 <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNode IN hGenXml (getStack(), "VendorName":U, VendorName_00, OUTPUT iId).
                        END. /*Test LOGIC*/
                        IF VendorTaxID_00 <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNode IN hGenXml (getStack(), "VendorTaxID":U, VendorTaxID_00, OUTPUT iId).
                        END. /*Test LOGIC*/
                   delStack().
          END.

     delStack().


/* OBTEM O XML NUMA HANDLE */
RUN generateXML IN hGenXml (OUTPUT hBusinessContent).


/* DEFINE O CONTEÚDO DO ELEMENTO BusinessContent */
RUN setBusinessContent IN hMessageHandler (INPUT hBusinessContent).

/* LIBERA MEMÓRIA ALOCADA PARA O OBJETO */
DELETE OBJECT hBusinessContent NO-ERROR.


/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.


