IF cTranEvent = "VendorConfirmPortal":U OR cTranEvent = "VendorReprovePortal":U THEN DO:

    FIND FIRST pedido-compr WHERE pedido-compr.num-pedido = PONumber EXCLUSIVE-LOCK NO-ERROR.

    IF AVAIL pedido-compr THEN DO:  
        ASSIGN
        &IF  "{&bf_mat_versao_ems}"  <  "2.09"  &THEN
           OVERLAY(pedido-compr.CHAR-1,57,1) = "N":U
        &ELSE
           pedido-compr.log-pend-aceite-fornec = NO
        &ENDIF 
      	.  

        IF cTranEvent = "VendorReprovePortal":U THEN DO:

            &IF  "{&bf_mat_versao_ems}"  <  "2.09"  &THEN
               OVERLAY(pedido-compr.CHAR-1,56,1) = "S":U
            &ELSE
               pedido-compr.log-reprov-fornec = YES
            &ENDIF 
          	. 
        END.
        ELSE DO:
            &IF  "{&bf_mat_versao_ems}"  <  "2.09"  &THEN
               OVERLAY(pedido-compr.CHAR-1,56,1) = "N":U
            &ELSE
               pedido-compr.log-reprov-fornec = NO
            &ENDIF 
          	. 
        END.
    END.
    ELSE DO:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "Pedido_de_Compra" *}
        run utp/ut-msgs.p (INPUT 'msg',
                           INPUT 3935,
                           INPUT RETURN-VALUE + ' ' + string(PONumber)).
        
        CREATE tt_log_erro.                  
        ASSIGN tt_log_erro.ttv_num_cod_erro = 3935
               tt_log_erro.ttv_des_msg_erro = trim(RETURN-VALUE).

        RETURN "NOK":U.

    END.
    RETURN "OK":U.
END.
