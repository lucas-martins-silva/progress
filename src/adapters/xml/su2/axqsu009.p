PROCEDURE PIQuery:
   

/*PARAMETERS - BEGIN*/
/*PARAMETERS - END*/


/*LOCAL VARIABLES - BEGIN*/
DEFINE VAR iId AS INTEGER INITIAL ? NO-UNDO.
/*LOCAL VARIABLES - END*/


/* ******************************************* */
/* *************** BODY - BEGIN ************** */
/* ******************************************* */


     /* OBTEM A PARTE DA MENSAGEM QUE ESTÊ ABAIXO DO ELEMENTO BusinessContent */
     RUN getBusinessContent IN hMessageHandler (OUTPUT hBusinessContent).

     /* LIMPA AS TEMP-TABLES INTERNAS DA API XML */
     RUN reset IN hGenXml.

     /* CARREGA A ESTRUTURA FILHA DE BusinessContent */
     RUN loadXml IN hGenXml (hBusinessContent).

     /* ELIMINA A MENSAGEM OBTIDA NO MêTODO getBusinessContent */
     DELETE OBJECT hBusinessContent NO-ERROR.

     /* ********* LEITURA DA MENSAGEM - BEGIN ********* */
     addStack(1).
          RUN searchTag IN hGenXml (INPUT "ListOfParameter", INPUT getStack(), OUTPUT iId).
          if (iId <> ?) THEN DO:
               addStack(iId).
               
               RUN searchTag IN hGenXml (INPUT "Parameter", INPUT getStack(), OUTPUT iId).
               if (iId <> ?) THEN DO:
                    addStack(iId).

                        /*Criacao de valores para manter as relacoes*/
                        CREATE ttListOfParameters.
                        ASSIGN ttListOfParameters.ttListOfParametersID = iId.
                        
                        /*RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "CompanyID", OUTPUT ttListOfParameters.CompanyID).*/
                        RUN searchTag IN hGenXML (INPUT "CompanyID", INPUT getStack(), OUTPUT iId).
                        IF (iId <> ?) THEN DO:
                            addStack(iId).
                            RUN getSonVal IN hGenXML (INPUT getStack(), INPUT "Domain", OUTPUT ttListOfParameters.Domain).
                            RUN getSonVal IN hGenXML (INPUT getStack(), INPUT "BusinessIdentifier", OUTPUT ttListOfParameters.BusinessIdentifier).
                            
                            &IF "{&bf_mat_versao_ems}" >= "2.071" &THEN
                                   RUN getSonVal IN hGenXML (INPUT getStack(), INPUT "CompanyCode", OUTPUT ttListOfParameters.CompanyCode).
                                   
                            &ELSE
                                   RUN getSonDec IN hGenXML (INPUT getStack(), INPUT "CompanyCode", OUTPUT ttListOfParameters.CompanyCode).
                            &ENDIF
                            
                            RUN getSonVal IN hGenXML (INPUT getStack(), INPUT "BranchCode", OUTPUT ttListOfParameters.BranchCode).
                            delStack().
                        END.
                        
                        RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ExecutorSite", OUTPUT ttListOfParameters.ExecutorSite).
                        RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ProjectNumber", OUTPUT ttListOfParameters.ProjectNumber).
                        RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ProjectPhase", OUTPUT ttListOfParameters.ProjectPhase).
                        RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "ProjectPhaseEMS", OUTPUT ttListOfParameters.ProjectPhaseEMS).
                        RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "RequisitionNumber", OUTPUT ttListOfParameters.RequisitionNumber).
                        RUN searchTag IN hGenXml (INPUT "IDSolumRM", INPUT getStack(), OUTPUT iId).
                        if (iId <> ?) THEN DO:
                             addStack(iId).
    
                                  RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "IDProject", OUTPUT ttListOfParameters.IDProject).
                                  RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "IDTask", OUTPUT ttListOfParameters.IDTask).
                             delStack().
                        END.
                    delStack().
               END.
               delStack().

          END.
     delStack().
     /* ********* LEITURA DA MENSAGEM - END   ********* */

     
     /* ********* EFETIVAÄ«O - BEGIN ********* */



