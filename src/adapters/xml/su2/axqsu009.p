PROCEDURE PIQueryReturnType:

/*PARAMETERS - BEGIN*/
DEFINE INPUT PARAM TABLE FOR ttListOfTransactions.
DEFINE INPUT PARAM TABLE FOR ttTransactionKey.
/*PARAMETERS - END*/


/*LOCAL VARIABLES - BEGIN*/
DEFINE VAR iId AS INTEGER INITIAL ? NO-UNDO.
/*LOCAL VARIABLES - END*/



/* ******************************************* */
/* *************** BODY - BEGIN ************** */
/* ******************************************* */

     
     /* RESETA OS VALORES */
     RUN reset IN hGenXml.

     RUN addNode IN hGenXml (getStack(), "ListOfTransactions", "", OUTPUT iId).
     addStack(iId).
     
     FOR EACH ttListOfTransactions:
           
            
            RUN addNode IN hGenXml (getStack(), "Transactions", "", OUTPUT iId).
            addStack(iId).
               
            
               &IF "{&bf_mat_versao_ems}" >= "2.071" &THEN
                   RUN addNodeVal IN hGenXml (getStack(), "CompanyID", ttListOfTransactions.CompanyId, OUTPUT iId).
                       
               &ELSE
                   RUN addNodeDec IN hGenXml (getStack(), "CompanyID", ttListOfTransactions.CompanyId, OUTPUT iId).
               &ENDIF
               
               RUN addNode IN hGenXml (getStack(), "ExecutorSite", ttListOfTransactions.ExecutorSite, OUTPUT iId).
               RUN addNodeDec IN hGenXml (getStack(), "ProjectNumber", ttListOfTransactions.ProjectNumber, OUTPUT iId).
               RUN addNodeDec IN hGenXml (getStack(), "ProjectPhase", ttListOfTransactions.ProjectPhase, OUTPUT iId).
               RUN addNodeDec IN hGenXml (getStack(), "ProjectPhaseEMS", ttListOfTransactions.ProjectPhaseEMS, OUTPUT iId).
               RUN addNode IN hGenXml (getStack(), "IDSolumRM", "", OUTPUT iId).
               addStack(iId).
                    RUN addNode IN hGenXml (getStack(), "IDProject", ttListOfTransactions.IDProject, OUTPUT iId).
                    RUN addNode IN hGenXml (getStack(), "IDTask", ttListOfTransactions.IDTask, OUTPUT iId).
               delStack().
               RUN addNode IN hGenXml (getStack(), "Transaction", "", OUTPUT iId).
               addStack(iId).

                   
                     
                    RUN addNode IN hGenXml (getStack(), "TransactionName", ttListOfTransactions.TransactionName, OUTPUT iId).
                    RUN addNode IN hGenXml (getStack(), "TransactionDescription", ttListOfTransactions.TransactionDescription, OUTPUT iId).
               delStack().
                
               RUN addNodeDec IN hGenXml (getStack(), "Quantity", ttListOfTransactions.Quantity, OUTPUT iId).
               RUN addNode IN hGenXml (getStack(), "UnitOfMeasure", "", OUTPUT iId).
               addStack(iId).

                    RUN addNode IN hGenXml (getStack(), "UnitOfMeasureCode", ttListOfTransactions.UnitOfMeasureCode, OUTPUT iId).
                    RUN addNode IN hGenXml (getStack(), "UnitOfMeasureDescription", ttListOfTransactions.UnitOfMeasureDescription, OUTPUT iId).
               delStack().
              
               RUN addNodeDec IN hGenXml (getStack(), "TransactionValue", ttListOfTransactions.TransactionValue, OUTPUT iId).
               RUN addNode IN hGenXml (getStack(), "Currency", "", OUTPUT iId).
               addStack(iId).

                    RUN addNodeDec IN hGenXml (getStack(), "CurrencyID", ttListOfTransactions.CurrencyId, OUTPUT iId).
                    RUN addNode IN hGenXml (getStack(), "CurrencyDescription", ttListOfTransactions.CurrencyDescription, OUTPUT iId).
                    RUN addNode IN hGenXml (getStack(), "CurrencySign", ttListOfTransactions.CurrencySign, OUTPUT iId).
               delStack().
               
               RUN addNode IN hGenXml (getStack(), "ListOfTransactionKey", "", OUTPUT iId).
               addStack(iId).
                   FOR EACH ttTransactionKey 
                      WHERE ttTransactionKey.cont = ttListOfTransactions.cont:
                            
                            RUN addNode IN hGenXml (getStack(), "TransactionKey", "", OUTPUT iId).
                            addStack(iId).
                                 
                                 RUN addNode IN hGenXml (getStack(), "FieldName", ttTransactionKey.FieldName, OUTPUT iId).
                                 RUN addNode IN hGenXml (getStack(), "FieldDescription", ttTransactionKey.FieldDescription, OUTPUT iId).
                                 RUN addNodeDec IN hGenXml (getStack(), "ContentType", ttTransactionKey.ContentType, OUTPUT iId).
                                 RUN addNode IN hGenXml (getStack(), "FieldContent", ttTransactionKey.FieldContent, OUTPUT iId).
                            delStack().
                   END.
               delStack().

               RUN addNode IN hGenXml (getStack(), "Status", "", OUTPUT iId).
               addStack(iId).

                    RUN addNodeDec IN hGenXml (getStack(), "StatusCode", ttListOfTransactions.Situacao, OUTPUT iId).
                    RUN addNode IN hGenXml (getStack(), "StatusDescription", ttListOfTransactions.desc-situacao, OUTPUT iId).
               delStack().
               
               IF ttListOfTransactions.TransactionName = "it-requisicao" OR
                  ttListOfTransactions.TransactionName = "movto-estoq"   OR 
                  ttListOfTransactions.TransactionName = "ordem-compra" THEN DO:

                   RUN addNode IN hGenXml (getStack(), "CustCenterCod", ttListOfTransactions.CustCenterCod, OUTPUT iId).
                   RUN addNodeDate IN hGenXml (getStack(), "DeliveryDate", ttListOfTransactions.DeliveryDate, OUTPUT iId).
                   RUN addNodeDate IN hGenXml (getStack(), "EmissionDate", ttListOfTransactions.EmissionDate, OUTPUT iId).
                   RUN addNode IN hGenXml (getStack(), "ItemCode", ttListOfTransactions.ItemCode, OUTPUT iId).
                   RUN addNode IN hGenXml (getStack(), "TransactionOriginCode", ttListOfTransactions.TransactionOriginCode, OUTPUT iId).
                   RUN addNode IN hGenXml (getStack(), "TransactionOriginDescription", ttListOfTransactions.TransactionOriginDescription, OUTPUT iId).
               
               END.
             delStack().

              
          
    
     END.
     delStack().

     
     /* OBTEM O XML NUMA HANDLE */
     RUN generateXML IN hGenXml (OUTPUT hQueryReturnContent). /* gera XML */
     
/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.


PROCEDURE receiveMessage:

/*PARAMETERS - BEGIN*/
