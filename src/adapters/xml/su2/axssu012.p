RUN isSubscribed IN hMessageHandler ("{&XmlProdName}",
                                     "{&XmlApp}",
                                     "{&XmlTranName}",
                                     "{&XmlTranVersion}",
                                     cEvent,
                                     cTranAction,
                                     OUTPUT lCreateMsg).

IF RETURN-VALUE <> "OK" THEN DO:
    CREATE TT_LOG_ERRO.
         ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 0.
         /* Inicio -- Projeto Internacional */
         DEFINE VARIABLE c-lbl-liter AS CHARACTER NO-UNDO.
         ASSIGN c-lbl-liter = TRIM(RETURN-VALUE).
         DEFINE VARIABLE c-lbl-liter-erro-ao-executar-issubscribed AS CHARACTER NO-UNDO.
         {utp/ut-liter.i "Erro_ao_executar_isSubscribed_no_MessageHandle" *}
         ASSIGN c-lbl-liter-erro-ao-executar-issubscribed = TRIM(RETURN-VALUE).
         ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO = c-lbl-liter-erro-ao-executar-issubscribed + ": "+ c-lbl-liter.
    RETURN RETURN-VALUE.
END.

IF NOT lCreateMsg THEN DO:
    CREATE TT_LOG_ERRO.
         ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 60.
         /* Inicio -- Projeto Internacional */
         {utp/ut-liter.i "A_Transacao_'{&XmlTranName}'_nao_e_assinada" *}
         ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO = RETURN-VALUE + '.'.
    RETURN "OK".
END.

/* PREENCHE O VALOR DO ELEM. Comment DE TransactionId */
RUN setTransInfoComment IN hMessageHandler ("Comentario do desenvolvedor").

/* SETA SystemId */
RUN setSystemId IN hMessageHandler ("{&XmlMod}",  "{&XmlProdVersion}").

find first tt-pedido-compr no-lock no-error.

/*INDICA O VALOR DA CHAVE PRIMµRIA DA TRANSA€ÇO */
RUN setKeyFields IN hMessageHandler ("num-pedido", string(tt-pedido-compr.num-pedido)).

/* INFORMA A EMPRESA E O ESTABELECIMENTO */
/*RUN setCompanyId IN hMessageHandler ("cCodEmp", "cCodEstab").*/

/* RESETA OS VALORES */
RUN reset IN hGenXml.

/* SETA VALOR DE ENCODING */
RUN setEncoding IN hGenXml ("UTF-8").

RUN addNode IN hGenXml (getStack(), "Upsert", "", OUTPUT iId).
addStack(iId).

    find first emitente where emitente.cod-emitente = tt-pedido-compr.cod-emitente no-lock no-error.

    RUN addNode IN hGenXml (getStack(), "TaxID", emitente.cgc, OUTPUT iId).
    RUN addNodeDec IN hGenXml (getStack(), "PONumber", tt-pedido-compr.num-pedido, OUTPUT iId).

    &if '{&bf_mat_versao_ems}' < '2.09' &then 
       RUN addNode IN hGenXml (getStack(), "PONumberWebb", trim(substring(tt-pedido-compr.char-1,3,50)), OUTPUT iId).
    &else
       RUN addNode IN hGenXml (getStack(), "PONumberWebb", trim(tt-pedido-compr.cod-ped-portal), OUTPUT iId).
    &endif
    
    RUN addNode IN hGenXml (getStack(), "DeliveryAddress", tt-pedido-compr.end-entrega, OUTPUT iId).

    find first estabelec where estabelec.cod-estabel = tt-pedido-compr.end-entrega no-lock no-error.

    RUN addNode IN hGenXml (getStack(), "DeliveryAddressDescription", (if avail estabelec then estabelec.nome else ""), OUTPUT iId).
    RUN addNode IN hGenXml (getStack(), "BillAddress", tt-pedido-compr.end-cobranca, OUTPUT iId).

    find first estabelec where estabelec.cod-estabel = tt-pedido-compr.end-cobranca no-lock no-error.

    RUN addNode IN hGenXml (getStack(), "BillAddressDescription", (if avail estabelec then estabelec.nome else ""), OUTPUT iId).
    RUN addNode IN hGenXml (getStack(), "ApproveAction", p-acao, OUTPUT iId).
    RUN addNode IN hGenXml (getStack(), "ApproveComment", c-commets, OUTPUT iId).
    RUN addNode IN hGenXml (getStack(), "Comment", tt-pedido-compr.comentarios, OUTPUT iId).
    RUN addNode IN hGenXml (getStack(), "ListOfPurchaseOrderLine", "", OUTPUT iId).
    addStack(iId).

    FOR EACH ttPurchaseOrderLine012:

        RUN addNode IN hGenXml (getStack(), "PurchaseOrderLine", "", OUTPUT iId).
        addStack(iId).

        RUN addNodeDec IN hGenXml (getStack(), "POLineNumber", ttPurchaseOrderLine012.POLineNumber, OUTPUT iId).
        RUN addNode IN hGenXml (getStack(), "POLineNumberWebb", trim(ttPurchaseOrderLine012.POLineNumberWebb), OUTPUT iId).
        RUN addNode IN hGenXml (getStack(), "ItemCode", ttPurchaseOrderLine012.ItemCode, OUTPUT iId).
        RUN addNodeDec IN hGenXml (getStack(), "Quantity", ttPurchaseOrderLine012.Quantity, OUTPUT iId).
        RUN addNode IN hGenXml (getStack(), "ItemDescription", ttPurchaseOrderLine012.ItemDescription, OUTPUT iId).
        RUN addNodeDec IN hGenXml (getStack(), "CurrencyID", ttPurchaseOrderLine012.CurrencyID, OUTPUT iId).
        RUN addNodeDec IN hGenXml (getStack(), "UnitPrice", ttPurchaseOrderLine012.UnitPrice, OUTPUT iId).
        RUN addNodeDec IN hGenXml (getStack(), "UnitPriceVendor", ttPurchaseOrderLine012.UnitPriceVendor, OUTPUT iId).
        RUN addNodeDec IN hGenXml (getStack(), "PriceVendor", ttPurchaseOrderLine012.PriceVendor, OUTPUT iId).
        RUN addNodeDate IN hGenXml (getStack(), "DeliveryDate", ttPurchaseOrderLine012.DeliveryDate, OUTPUT iId).
        delStack().

    end.

    delStack().
delStack().

/* OBTEM O XML NUMA HANDLE */
RUN generateXML IN hGenXml (OUTPUT hBusinessContent).

/* DEFINE O CONTEéDO DO ELEMENTO BusinessContent */
