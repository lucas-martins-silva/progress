PROCEDURE pi-verifica-cria-cotacao:

    DEFINE VARIABLE l-existe-cotac AS LOGICAL     NO-UNDO.
    DEFINE VARIABLE l-tipo-erro-encontrado AS LOGICAL NO-UNDO.
    DEFINE BUFFER bf-cotacao-item FOR cotacao-item.
    
    if not avail param-global then
        find first param-global no-lock no-error.
    
    FOR EACH tt-cotacao-item-venc NO-LOCK:

        ASSIGN l-existe-cotac = NO.
    
        FOR EACH cotacao-item WHERE cotacao-item.numero-ordem = tt-cotacao-item-venc.numero-ordem AND
                                    cotacao-item.it-codigo    = tt-cotacao-item-venc.it-codigo AND
                                    cotacao-item.cod-emitente = tt-cotacao-item-venc.cod-emitente NO-LOCK:
            
            IF 
            &if '{&bf_mat_versao_ems}' < '2.09' &then
                SUBSTRING(cotacao-item.char-2,324,50) = SUBSTRING(tt-cotacao-item-venc.char-2,324,50)
            &ELSE
                cotacao-item.cod-respos-fornec = tt-cotacao-item-venc.cod-respos-fornec
            &ENDIF
            THEN DO:
                ASSIGN l-existe-cotac = YES.
                FIND FIRST bf-cotacao-item WHERE bf-cotacao-item.numero-ordem = cotacao-item.numero-ordem AND     
                                                 bf-cotacao-item.it-codigo    = cotacao-item.it-codigo AND        
                                                 bf-cotacao-item.cod-emitente = cotacao-item.cod-emitente AND 
                                                 bf-cotacao-item.seq-cotac    = cotacao-item.seq-cotac NO-LOCK NO-ERROR.
                LEAVE.
            END. 
        END.
    
        /* J  existe cota‡Æo ‚ s¢ atualizar */
        IF l-existe-cotac THEN DO:
            ASSIGN tt-cotacao-item-venc.seq-cotac = bf-cotacao-item.seq-cotac.
        END.
        ELSE DO:
            FIND LAST bf-cotacao-item WHERE bf-cotacao-item.numero-ordem = tt-cotacao-item-venc.numero-ordem AND     
                                            bf-cotacao-item.it-codigo    = tt-cotacao-item-venc.it-codigo AND        
                                            bf-cotacao-item.cod-emitente = tt-cotacao-item-venc.cod-emitente NO-LOCK NO-ERROR.
    
            IF AVAIL bf-cotacao-item THEN DO:
                ASSIGN tt-cotacao-item-venc.seq-cotac = bf-cotacao-item.seq-cotac + 1.
            END.
            ELSE DO:
                ASSIGN tt-cotacao-item-venc.seq-cotac = 1.
            END.
            RUN ocp/ocapi003.p (input table tt-cotacao-item-venc,
                                output table rowErrors append).
                                
            /* Integra‡Æo com investimento */
            if  avail cotacao-item and param-global.modulo-in and ordem-compra.num-ord-inv <> 0 then do:
            
                FIND LAST bf-cotacao-item WHERE bf-cotacao-item.numero-ordem = tt-cotacao-item-venc.numero-ordem AND     
                                                bf-cotacao-item.it-codigo    = tt-cotacao-item-venc.it-codigo AND        
                                                bf-cotacao-item.cod-emitente = tt-cotacao-item-venc.cod-emitente AND
                                                bf-cotacao-item.seq-cotac    = tt-cotacao-item-venc.seq-cotac NO-LOCK NO-ERROR.
                                    
                run inp/in2103a.p (input rowid(bf-cotacao-item), input "I":U, output table rowErrors append).
            END. 
        END.
     END.
    
     ASSIGN l-tipo-erro-encontrado = NO.
     
     FOR EACH RowErrors,
         FIRST cadast_msg NO-LOCK
         WHERE cadast_msg.cdn_msg   = RowErrors.ErrorNumber
          AND cadast_msg.idi_tip_msg = 1 /*Erro*/:
         
         ASSIGN l-tipo-erro-encontrado = YES.
     END.
  
     IF NOT l-tipo-erro-encontrado THEN DO:

         /* Execu‡Æo da API de Efetiva‡Æo */
         RUN ocp/ocapi002.p (input        table ttDestinationPartner,
                             INPUT        TABLE tt-parametros,
                             INPUT        TABLE tt-cotacao-item-venc,
                             INPUT        TABLE tt-prazo-compra,
                             INPUT-OUTPUT TABLE tt-edital,
                             OUTPUT       TABLE rowErrors).
                             
         /* Integra‡Æo com investimento */
         if  avail cotacao-item and param-global.modulo-in and ordem-compra.num-ord-inv <> 0 then do:
             run inp/in2103a.p (input rowid(bf-cotacao-item), input "M":U, output table rowErrors append).
         END. 
                             
     END.
     
    RETURN "OK":U.
END.
