                                            addStack(iId).
    
                                                 RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "UnitOfMeasureCode", OUTPUT ttPurchaseRequestLine.UnitOfMeasureCode).
                                                 RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "UnitOfMeasureDescription", OUTPUT ttPurchaseRequestLine.UnitOfMeasureDescription).
                                            delStack().
                                       END.
    
                                       RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "EANCode", OUTPUT ttPurchaseRequestLine.EANCode).
                                       RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "VendorCode", OUTPUT ttPurchaseRequestLine.VendorCode).
                                  delStack().
                             END.
                             
                             RUN getSonDec  IN hGenXml (INPUT getStack(), INPUT "RequisitionQuantity", OUTPUT ttPurchaseRequestLine.RequisitionQuantity).
                             RUN getSonDec  IN hGenXml (INPUT getStack(), INPUT "AttendQuantity", OUTPUT ttPurchaseRequestLine.AttendQuantity).
                             RUN getSonDec  IN hGenXml (INPUT getStack(), INPUT "IssuedQuantity", OUTPUT ttPurchaseRequestLine.IssuedQuantity).
                             RUN getSonVal  IN hGenXml (INPUT getStack(), INPUT "Acct", OUTPUT ttPurchaseRequestLine.Acct).
                             RUN getSonVal  IN hGenXml (INPUT getStack(), INPUT "Sub-Acct", OUTPUT ttPurchaseRequestLine.Sub-Acct).
                             RUN getSonVal  IN hGenXml (INPUT getStack(), INPUT "Text", OUTPUT ttPurchaseRequestLine.Texto).
                             RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "DeliveryDate", OUTPUT ttPurchaseRequestLine.DeliveryDate).
                             RUN getSonDec  IN hGenXml (INPUT getStack(), INPUT "Status", OUTPUT ttPurchaseRequestLine.Situacao).
                             RUN getSonVal  IN hGenXml (INPUT getStack(), INPUT "Site", OUTPUT ttPurchaseRequestLine.Site).
                             RUN getSonVal  IN hGenXml (INPUT getStack(), INPUT "Warehouse", OUTPUT ttPurchaseRequestLine.Warehouse).
                             RUN getSonVal  IN hGenXml (INPUT getStack(), INPUT "Lot", OUTPUT ttPurchaseRequestLine.Lot).
                             RUN getSonDec  IN hGenXml (INPUT getStack(), INPUT "ReturnQuantity", OUTPUT ttPurchaseRequestLine.ReturnQuantity).
                             RUN getSonDec  IN hGenXml (INPUT getStack(), INPUT "ToReturnQuantity", OUTPUT ttPurchaseRequestLine.ToReturnQuantity).
                             RUN getSonVal  IN hGenXml (INPUT getStack(), INPUT "Requester", OUTPUT ttPurchaseRequestLine.Requester).
                             RUN getSonVal  IN hGenXml (INPUT getStack(), INPUT "Reference", OUTPUT ttPurchaseRequestLine.Reference).
                             RUN getSonDate IN hGenXml (INPUT getStack(), INPUT "ProcessingDate", OUTPUT ttPurchaseRequestLine.ProcessingDate).
                             RUN getSonDec  IN hGenXml (INPUT getStack(), INPUT "OrderNumber", OUTPUT ttPurchaseRequestLine.OrderNumber).
                             RUN getSonDec  IN hGenXml (INPUT getStack(), INPUT "ProjectPhase", OUTPUT ttPurchaseRequestLine.ProjectPhase).
                             RUN getSonDec  IN hGenXml (INPUT getStack(), INPUT "PlanningSequence", OUTPUT ttPurchaseRequestLine.PlanningSequence).
                             RUN getSonDec  IN hGenXml (INPUT getStack(), INPUT "TotalPrice", OUTPUT ttPurchaseRequestLine.TotalPrice).
                             RUN searchTag  IN hGenXml (INPUT "UnitOFMeasure", INPUT getStack(), OUTPUT iId).

                             if (iId <> ?) THEN DO:
                                  addStack(iId).
                                       RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "UnitOfMeasureCode", OUTPUT ttPurchaseRequestLine.UnitOfMeasureCode_00).
                                       RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "UnitOfMeasureDescription", OUTPUT ttPurchaseRequestLine.UnitOfMeasureDescription_00).
                                  delStack().
                             END.
                             RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "UnitPrice", OUTPUT ttPurchaseRequestLine.UnitPrice).
                             RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "Location", OUTPUT ttPurchaseRequestLine.Location).
                             RUN searchTag IN hGenXml (INPUT "Approver", INPUT getStack(), OUTPUT iId).
                             if (iId <> ?) THEN DO:
                                  addStack(iId).
    
                                       RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ApproverID", OUTPUT ttPurchaseRequestLine.ApproverID).
                                       RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "ApproverName", OUTPUT ttPurchaseRequestLine.ApproverName).
                                  delStack().
                             END.
                             RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "Priority",  OUTPUT ttPurchaseRequestLine.Priority).
                             RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "State",     OUTPUT ttPurchaseRequestLine.State).
                             RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "BusinessUnit", OUTPUT ttPurchaseRequestLine.BusinessUnit).
                             RUN searchTag IN hGenXml (INPUT "IDSolumRM", INPUT getStack(), OUTPUT iId).
                             IF (iId <> ?) THEN DO:
                                 addStack(iId).
                                    
                                     RUN searchTag IN hGenXml (INPUT "CompanyId", INPUT getStack(), OUTPUT iId).
                                     IF (iId <> ?) THEN DO:
                                         addStack(iId).
    
                                             RUN getSonVal IN hGenXML (INPUT getStack(), INPUT "Domain",             OUTPUT ttPurchaseRequestLine.domain).
                                             RUN getSonVal IN hGenXML (INPUT getStack(), INPUT "BusinessIdentifier", OUTPUT ttPurchaseRequestLine.BusinessIdentifier).
                                             
                                             &IF "{&bf_mat_versao_ems}" >= "2.071" &THEN
                                                RUN getSonVal IN hGenXML (INPUT getStack(), INPUT "CompanyCode",OUTPUT ttPurchaseRequestLine.CompanyCode).
                                             &ELSE
                                                RUN getSonDec IN hGenXML (INPUT getStack(), INPUT "CompanyCode",OUTPUT ttPurchaseRequestLine.CompanyCode).
                                             &ENDIF
                                             
                                             RUN getSonVal IN hGenXML (INPUT getStack(), INPUT "BranchCode",         OUTPUT ttPurchaseRequestLine.BranchCode).
                                         delStack().
                                     END.

                                    RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "IDProject", OUTPUT ttPurchaseRequestLine.IDProject).
                                    RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "IDTask", OUTPUT ttPurchaseRequestLine.IDTask).
                                    RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "IDMov", OUTPUT IDMov).

    
                                 delStack().
                                /*RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "IDSolumRM", OUTPUT ttPurchaseRequestLine.IDSolumRM).*/
                             END.
    
                             RUN searchTag IN hGenXml (INPUT "ListOfBusinessUnits", INPUT getStack(), OUTPUT iId).
                             if (iId <> ?) THEN DO:
                                  addStack(iId).
    
                                       RUN getFirstSonId IN hGenXml (INPUT getStack(), OUTPUT iId).
    
                                       DO WHILE iId <> ?:
                                       addStack(iId).
    
                                            /*Criacao de valores para manter as relacoes*/
                                            CREATE ttBusinessUnit.
                                            ASSIGN ttBusinessUnit.ttBusinessUnitID = iId.
                                            ASSIGN ttBusinessUnit.ttPurchaseRequestLineID = ttPurchaseRequestLine.ttPurchaseRequestLineID.
    
                                            RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "BusinessUnitID", OUTPUT ttBusinessUnit.BusinessUnitID).
                                            RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "BusinessUnitPercentage", OUTPUT ttBusinessUnit.BusinessUnitPercentage).
                                            ASSIGN iId = getStack().
                                            delStack().
                                            RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
                                       END.
    
                                  delStack().
                             END.
                             
                             RUN getSonLog IN hGenXML (INPUT getStack(), INPUT "Urgent", OUTPUT ttPurchaseRequestLine.Urgent).
                             RUN getSonLog IN hGenXML (INPUT getStack(), INPUT "ApprovSupplier", OUTPUT ttPurchaseRequestLine.ApprovSupplier).
                             RUN getSonVal IN hGenXML (INPUT getStack(), INPUT "Quality", OUTPUT ttPurchaseRequestLine.Quality).
                             RUN getSonVal IN hGenXML (INPUT getStack(), INPUT "UtilizationCode", OUTPUT ttPurchaseRequestLine.UtilizationCode).
    
                             ASSIGN iId = getStack().
                             delStack().
                             RUN getNextSonId IN hGenXml (INPUT getStack(), INPUT iId, OUTPUT iId).
                        END.
                    delStack().
                /*END.
               delStack().*/
          END.

     delStack().


     /* ********* LEITURA DA MENSAGEM - END   ********* */


     /* ********* EFETIVAÄ«O - BEGIN ********* */



{adapters/xml/su2/axrsu007upsert.i}


     /* ********* EFETIVAÄ«O - END   ********* */

/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */
END PROCEDURE.


PROCEDURE receiveMessage:

/*PARAMETERS - BEGIN*/
DEFINE INPUT PARAM hInputXML AS HANDLE NO-UNDO.
DEFINE OUTPUT PARAM hOutputXML AS HANDLE NO-UNDO.
/*PARAMETERS - END*/


/*LOCAL VARIABLES - BEGIN*/
/*LOCAL VARIABLES - END*/


/* ******************************************* */
/* *************** BODY - BEGIN ************** */
/* ******************************************* */

     /* VERIFICA SE MessageHandler.p ESTA NA MEMORIA */
     {xmlinc/xmlloadmessagehandlerrec.i &MessageHandler="hMessageHandler" &MHReturnValue="cReturnValue" &MHReturnError="hOutputXML"}

     IF cReturnValue <> "OK" THEN DO:
          RETURN cReturnValue.
     END.

     /* INTERPRETA, ARMAZENA E VALIDA A MENSAGEM QUE RECEBE */
     RUN parseMessage IN hMessageHandler (
          INPUT  hInputXml, INPUT "{&XmlTranName}", 
          INPUT "{&XmlMaxTranVersion}", 
          INPUT "{&XmlMinTranVersion}", 
          INPUT "{&XmlListOfEvents}",
          OUTPUT lSuccessProcess,
          OUTPUT cTranAction, 
          OUTPUT cTranEvent,
          OUTPUT cTranVersion,
          OUTPUT hOutputXML ).



     /* SE N«O PROCESSOU CORRETAMENTE RETORNA ERRO */
     IF NOT lSuccessProcess OR RETURN-VALUE <> "OK" THEN 
     /* DAR TRATAMENTO CONVENIENTE ANTES DE RETORNAR */
          RETURN RETURN-VALUE.

     /* VERIFICA SE APIXML ESTA NA MEMORIA */
     {xmlinc/xmlloadgenxmlrec.i &GenXml="hGenXml" &GXReturnValue="cReturnValue" &GXReturnError="hOutputXML"}

     /* VERIFICA SE O ut-genxml FOI INICIADO CORRETAMENTE */
     IF cReturnValue <> "OK"
     THEN DO:
          /* ELIMINA A MENSAGEM OBTIDA NO M?TODO getBusinessContent */
          DELETE OBJECT hBusinessContent NO-ERROR.

          RETURN cReturnValue.
     END.







{adapters/xml/su2/axrsu007versioncontrol.i}


/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.

PROCEDURE pi-carrega-temp-tables:
    
    CREATE  tt-requisicao. 
    ASSIGN  tt-requisicao.cod-estabel   = Site
            tt-requisicao.ct-codigo     = IF Acct = ? THEN "" ELSE Acct
            tt-requisicao.dt-atend      = IF ProcessingDate = ? THEN &IF "{&ems_dbtype}":U = "MSS":U &THEN 01/01/1800 &ELSE 01/01/1111 &ENDIF  ELSE ProcessingDate
            tt-requisicao.dt-devol      = IF returnDate = ? THEN &IF "{&ems_dbtype}":U = "MSS":U &THEN 01/01/1800 &ELSE 01/01/1111 &ENDIF  ELSE returnDate
            tt-requisicao.dt-requisicao = RequestDate
            tt-requisicao.estado        = IF State = ? OR State <= 0 OR State > 2 THEN 2 ELSE State
            tt-requisicao.impressa      = IF Printed = ? THEN 0 ELSE Printed
            tt-requisicao.loc-entrega   = IF Delivery = ? THEN "" ELSE Delivery
            tt-requisicao.narrativa     = IF Texto = ? THEN "" ELSE texto
            tt-requisicao.nome-abrev    = Requester
            tt-requisicao.nome-aprov    = IF ApproverName_00 = ? THEN "" ELSE ApproverName_00
            tt-requisicao.nr-requisicao = IF RequisitionNumber = ? THEN 0 ELSE RequisitionNumber 
            tt-requisicao.sc-codigo     = IF SubAcct = ? THEN "" ELSE SubAcct
            tt-requisicao.situacao      = IF Situacao = ? OR Situacao <= 0 OR Situacao > 4 THEN 1 ELSE Situacao
            tt-requisicao.tp-requis     = IF IssueType = ? OR IssueType <= 0 OR IssueType > 3 THEN 2 ELSE IssueType.
    
    FOR EACH ttPurchaseRequestLine:
        IF ttPurchaseRequestLine.Acct = "" OR ttPurchaseRequestLine.Acct = ?  THEN DO:
            RUN pi-sugere-ct-contabil IN h-boin168(INPUT ttPurchaseRequestLine.ItemCode,INPUT tt-requisicao.nome-abrev,
                                                   INPUT ttPurchaseRequestLine.Site,INPUT ttPurchaseRequestLine.ProjectPhase,OUTPUT c-ct-codigo).
            ASSIGN ttPurchaseRequestLine.Acct = c-ct-codigo.
        END.
        
        CREATE tt-it-requisicao.
        ASSIGN tt-it-requisicao.nome-abrev       = tt-requisicao.nome-abrev
               tt-it-requisicao.nr-requisicao    = IF RequisitionNumber = ? THEN 0 ELSE RequisitionNumber 
               tt-it-requisicao.sequencia        = IF ttPurchaseRequestLine.Sequence = ? THEN 0 ELSE ttPurchaseRequestLine.Sequence
               tt-it-requisicao.it-codigo        = ttPurchaseRequestLine.ItemCode
               tt-it-requisicao.qt-atendida      = IF ttPurchaseRequestLine.AttendQuantity = ? THEN 0 ELSE ttPurchaseRequestLine.AttendQuantity
               tt-it-requisicao.qt-a-atender     = IF ttPurchaseRequestLine.IssuedQuantity = ? THEN 0 ELSE ttPurchaseRequestLine.IssuedQuantity
               tt-it-requisicao.ct-codigo        = IF ttPurchaseRequestLine.Acct = ? THEN "" ELSE ttPurchaseRequestLine.Acct
               tt-it-requisicao.sc-codigo        = IF ttPurchaseRequestLine.Sub-Acct = ? THEN "" ELSE ttPurchaseRequestLine.Sub-Acct
               tt-it-requisicao.dt-entrega       = IF ttPurchaseRequestLine.DeliveryDate = ? THEN &IF "{&ems_dbtype}":U = "MSS":U &THEN 01/01/1800 &ELSE 01/01/1111 &ENDIF  ELSE ttPurchaseRequestLine.DeliveryDate
               tt-it-requisicao.situacao         = IF ttPurchaseRequestLine.Situacao = ? OR ttPurchaseRequestLine.Situacao = 0 THEN 1 ELSE ttPurchaseRequestLine.Situacao
               tt-it-requisicao.cod-estabel      = ttPurchaseRequestLine.Site
               tt-it-requisicao.cod-depos        = IF ttPurchaseRequestLine.Warehouse = ? THEN "" ELSE ttPurchaseRequestLine.Warehouse
               tt-it-requisicao.lote             = IF ttPurchaseRequestLine.Lot = ? THEN "" ELSE ttPurchaseRequestLine.Lot 
               tt-it-requisicao.qt-devolvida     = IF ttPurchaseRequestLine.ReturnQuantity = ? THEN 0 ELSE ttPurchaseRequestLine.ReturnQuantity
               tt-it-requisicao.qt-a-devolver    = IF ttPurchaseRequestLine.ToReturnQuantity = ? THEN 0 ELSE ttPurchaseRequestLine.ToReturnQuantity
               tt-it-requisicao.cod-refer        = IF ttPurchaseRequestLine.Reference = ? THEN "" ELSE ttPurchaseRequestLine.Reference
               tt-it-requisicao.dt-atend         = IF ttPurchaseRequestLine.ProcessingDate = ? THEN &IF "{&ems_dbtype}":U = "MSS":U &THEN 01/01/1800 &ELSE 01/01/1111 &ENDIF  ELSE ttPurchaseRequestLine.ProcessingDate
               tt-it-requisicao.numero-ordem     = IF ttPurchaseRequestLine.OrderNumber = ? THEN 0 ELSE ttPurchaseRequestLine.OrderNumber
               tt-it-requisicao.num-ord-inv      = IF ttPurchaseRequestLine.ProjectPhase = ? THEN 0 ELSE ttPurchaseRequestLine.ProjectPhase
               tt-it-requisicao.seq-planej       = IF ttPurchaseRequestLine.PlanningSequence = ? THEN 0 ELSE ttPurchaseRequestLine.PlanningSequence
               tt-it-requisicao.val-item         = IF ttPurchaseRequestLine.TotalPrice = ? THEN 0 ELSE ttPurchaseRequestLine.TotalPrice
               tt-it-requisicao.preco-unit       = IF ttPurchaseRequestLine.UnitPrice = ? THEN 0 ELSE ttPurchaseRequestLine.UnitPrice
               tt-it-requisicao.cod-localiz      = IF ttPurchaseRequestLine.Location = ? THEN "" ELSE ttPurchaseRequestLine.Location
               tt-it-requisicao.prioridade-aprov = IF ttPurchaseRequestLine.Priority <> 450 OR ttPurchaseRequestLine.Priority <> 750
                                                   OR ttPurchaseRequestLine.Priority <> 999 THEN 150 ELSE ttPurchaseRequestLine.Priority
               tt-it-requisicao.estado           = IF ttPurchaseRequestLine.State = ? THEN 2 ELSE ttPurchaseRequestLine.State
               tt-it-requisicao.cod-unid-negoc   = IF ttPurchaseRequestLine.BusinessUnit = ? THEN "" ELSE ttPurchaseRequestLine.BusinessUnit
               tt-it-requisicao.un               = ttPurchaseRequestLine.UnitOfMeasureCode 
               tt-it-requisicao.qt-requisitada   = IF ttPurchaseRequestLine.RequisitionQuantity = ? THEN 0 ELSE ttPurchaseRequestLine.RequisitionQuantity
               tt-it-requisicao.nome-aprov       = ttPurchaseRequestLine.ApproverName
               tt-it-requisicao.narrativa        = IF ttPurchaseRequestLine.Texto = ? THEN "" ELSE ttPurchaseRequestLine.Texto
               tt-it-requisicao.log-1            = IF ttPurchaseRequestLine.Urgent = ? THEN NO ELSE ttPurchaseRequestLine.Urgent
               tt-it-requisicao.log-2            = IF ttPurchaseRequestLine.ApprovSupplier = ? THEN NO ELSE ttPurchaseRequestLine.ApprovSupplier
               substring(tt-it-requisicao.char-1,1,1)  = IF ttPurchaseRequestLine.Quality = ? THEN "" ELSE ttPurchaseRequestLine.Quality
               substring(tt-it-requisicao.char-2,1,12) = IF ttPurchaseRequestLine.UtilizationCode = ? THEN "" ELSE ttPurchaseRequestLine.UtilizationCode
               tt-it-requisicao.ttPurchaseRequestLineID = ttPurchaseRequestLine.ttPurchaseRequestLineID.

        &IF "{&bf_mat_versao_ems}" >= "2.071" &THEN
               ASSIGN tt-it-requisicao.ep-codigo = IF ttPurchaseRequestLine.CompanyCode = ? THEN "" ELSE ttPurchaseRequestLine.CompanyCode.
               
        &ELSE
               ASSIGN tt-it-requisicao.ep-codigo = IF ttPurchaseRequestLine.CompanyCode = ? THEN 0 ELSE ttPurchaseRequestLine.CompanyCode.
        &ENDIF

        IF tt-it-requisicao.qt-requisitada = 0 THEN
            ASSIGN tt-it-requisicao.qt-requisitada = tt-it-requisicao.qt-a-atender.

        IF tt-it-requisicao.val-item = 0 THEN
            ASSIGN tt-it-requisicao.val-item = tt-it-requisicao.preco-unit * tt-it-requisicao.qt-requisitada.
        
        /*Apenas para RM Solum*/
        IF l-funcao-rm THEN DO:
            ASSIGN c-ep-codigo  = string(ttPurchaseRequestLine.CompanyCode)
                   c-id-projeto = ttPurchaseRequestLine.IDProject.
            /*Chama a procedure RetonornaOrdemInSolum e grava o n£mero da ordem retornada no campo num-ord-inv*/
            RUN RetornaOrdemInvSolum IN h-boin168(INPUT ttPurchaseRequestLine.IDProject,
                                                  INPUT ttPurchaseRequestLine.IDTask,
                                                  INPUT ttPurchaseRequestLine.CompanyCode,
                                                  OUTPUT i-num-ord-inv).
            
            RUN getRowErrors IN h-boin168(OUTPUT TABLE RowErrors).
            IF CAN-FIND(FIRST RowErrors) THEN
                        RUN pi-carrega-tt_log_erro(INPUT TABLE RowErrors).
            ELSE
                assign tt-it-requisicao.num-ord-inv = i-num-ord-inv.
        END.
        
       
    END.

END PROCEDURE.

PROCEDURE pi-carrega-tt_log_erro:
    DEFINE INPUT PARAMETER TABLE FOR RowErrors.
        
    FOR EACH RowErrors 
       WHERE RowErrors.ErrorNumber <> 10 AND
             RowErrors.ErrorType <> "INTERNAL":
        CREATE tt_log_erro. 
        ASSIGN tt_log_erro.ttv_num_cod_erro  = RowErrors.errorNumber    
               tt_log_erro.ttv_des_msg_ajuda = IF RowErrors.errorSubType = "ERROR":U THEN "business_error":U ELSE "business_information":U   
               tt_log_erro.ttv_des_msg_erro  = RowErrors.errorDescription
               l-erro = IF RowErrors.errorSubType = "ERROR":U THEN YES ELSE NO.
    END.
END PROCEDURE.

