DEFINE INPUT PARAM EmailAddress_00 AS CHARACTER INITIAL ? NO-UNDO.  /*E-mail do contato. (Uso interno: Campo = mgadm.cont-emit.e-mail)*/
DEFINE INPUT PARAM FiscalOperationCode_00 AS CHARACTER INITIAL ? NO-UNDO.  /*Código natureza de operação. (Uso interno: Campo = movind.docum-est.nat-operacao)*/
DEFINE INPUT PARAM FiscalOperationDescription_00 AS CHARACTER INITIAL ? NO-UNDO.  /*Descrição da natureza de operação. (Uso interno: Campo = mgind.natur-oper.denominacao)*/

&if "{&bf_dis_versao_ems}" >=  "2.08" &then
  DEFINE INPUT PARAM EndConsumer  AS LOGICAL INITIAL ? NO-UNDO.
  DEFINE INPUT PARAM Type_00      AS INTEGER INITIAL ? NO-UNDO.
  DEFINE INPUT PARAM Transfer     AS LOGICAL INITIAL ? NO-UNDO.
  DEFINE INPUT PARAM Kind_00       AS CHARACTER INITIAL ? NO-UNDO. 
&endif

DEFINE INPUT PARAM PhoneNumber_00 AS CHARACTER INITIAL ? NO-UNDO.  /*Telefone do contato. (Uso interno: Campo = mgadm.cont-emit.telefone)*/
DEFINE INPUT PARAM SiteDescription_02 AS CHARACTER INITIAL ? NO-UNDO.  /*Descrição do estabelecimento. (Uso interno: Campo = mgadm.estabelec.nome)*/
DEFINE INPUT PARAM SiteID_02 AS CHARACTER INITIAL ? NO-UNDO.  /*Código do estabelecimento. (Uso interno: Campo = movind.docum-est.cod-estabel)*/
DEFINE INPUT PARAM SiteShortName_00 AS CHARACTER INITIAL ? NO-UNDO.  /*Nome do estabelecimento. (Uso interno: Campo = mgadm.emitente.nome-abrev)*/
DEFINE INPUT PARAM SiteTaxID_00 AS CHARACTER INITIAL ? NO-UNDO.  /*CGC do estabelecimento. (Uso interno: Campo = mgadm.emitente.cgc)*/

&if "{&bf_dis_versao_ems}" >=  "2.08" &then
  DEFINE INPUT PARAM SiteVendorID_00 AS INTEGER INITIAL ? NO-UNDO.
&endif

DEFINE OUTPUT PARAM TABLE FOR tt_log_erro.
DEFINE INPUT PARAM VendorID_00 AS integer INITIAL ? NO-UNDO.  /*Código interno de identificação do fornecedor. (Uso interno: Campo = movind.docum-est.cod-emitente)*/
DEFINE INPUT PARAM VendorShortName_00 AS CHARACTER INITIAL ? NO-UNDO.  /*Nome abreviado do fornecedor. (Uso interno: Campo = mgadm.emitente.nome-abrev)*/
DEFINE INPUT PARAM VendorTaxID_00 AS CHARACTER INITIAL ? NO-UNDO.  /*CGC do fornecedor. (Uso interno: Campo = mgadm.emitente.cgc)*/
/*PARAMETERS - END*/


/*LOCAL VARIABLES - BEGIN*/
DEFINE VAR iCount AS INTEGER INITIAL ? NO-UNDO.
DEFINE VAR iId AS INTEGER INITIAL ? NO-UNDO.
DEFINE VAR pErrorId AS INTEGER INITIAL ? NO-UNDO.
DEFINE VAR pErrorType AS CHARACTER INITIAL ? NO-UNDO.
DEFINE VAR pTotalErrors AS INTEGER INITIAL ? NO-UNDO.
/*LOCAL VARIABLES - END*/


/* ******************************************* */
/* *************** BODY - BEGIN ************** */
/* ******************************************* */

/* VERIFICA SE MessageHandler.p ESTA NA MEMORIA */
{xmlinc/xmlloadmessagehandler.i &MessageHandler="hMessageHandler" &MHReturnValue="cReturnValue"}

IF cReturnValue <> "OK" THEN DO:
     CREATE TT_LOG_ERRO.

     ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 17006.
          /* Inicio -- Projeto Internacional */
          {utp/ut-liter.i "Erro_ao_executar_MessageHandle" *}
          ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO = RETURN-VALUE + ": "+ cReturnValue.
     RETURN cReturnValue.
END.

RUN isSubscribed IN hMessageHandler ("{&XmlProdName}", 
     "{&XmlApp}", 
     "{&XmlTranName}", 
     "{&XmlTranVersion}", 
     cEvent, 
     cTranAction, 
     OUTPUT lCreateMsg)
.

IF RETURN-VALUE <> "OK" THEN DO:
     CREATE TT_LOG_ERRO.

     ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 17006.
          /* Inicio -- Projeto Internacional */
          DEFINE VARIABLE c-lbl-liter AS CHARACTER NO-UNDO.
          ASSIGN c-lbl-liter = TRIM(RETURN-VALUE).
          DEFINE VARIABLE c-lbl-liter-erro-ao-executar-issubscribed AS CHARACTER NO-UNDO.
          {utp/ut-liter.i "Erro_ao_executar_isSubscribed_no_MessageHandle" *}
          ASSIGN c-lbl-liter-erro-ao-executar-issubscribed = TRIM(RETURN-VALUE).
          ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO = c-lbl-liter-erro-ao-executar-issubscribed + ": "+ c-lbl-liter.
     RETURN RETURN-VALUE.
END.

IF NOT lCreateMsg THEN RETURN "OK".       

RUN PIEngineRegras (INPUT cTranAction).
IF RETURN-VALUE <> "OK" THEN RETURN RETURN-VALUE.

/* PREENCHE O VALOR DO ELEM. Comment DE TransactionId */
RUN setTransInfoComment IN hMessageHandler ("Comentario do desenvolvedor").



/* SETA SystemId */
RUN setSystemId IN hMessageHandler ("{&XmlMod}",  "{&XmlProdVersion}").



/*INDICA O VALOR DA CHAVE PRIMÁRIA DA TRANSAÇÃO */
RUN setKeyFields IN hMessageHandler ("DocumentSeries", String(DocumentSeries_00)).

/*INDICA O VALOR DA CHAVE PRIMÁRIA DA TRANSAÇÃO */
RUN setKeyFields IN hMessageHandler ("DocumentNumber", String(DocumentNumber_00)).

/*INDICA O VALOR DA CHAVE PRIMÁRIA DA TRANSAÇÃO */
RUN setKeyFields IN hMessageHandler ("FiscalOperationCode", String(FiscalOperationCode_00)).

/*INDICA O VALOR DA CHAVE PRIMÁRIA DA TRANSAÇÃO */
RUN setKeyFields IN hMessageHandler ("VendorShortName", String(VendorShortName_00)).

/*INDICA O VALOR DA CHAVE PRIMÁRIA DA TRANSAÇÃO */
RUN setKeyFields IN hMessageHandler ("VendorTaxID", String(VendorTaxID_00)).


/* INFORMA A EMPRESA E O ESTABELECIMENTO */
/*RUN setCompanyId IN hMessageHandler ("cCodEmp", "cCodEstab").*/



     /* RESETA OS VALORES */
     RUN reset IN hGenXml.

     /* SETA VALOR DE ENCODING */
     RUN setEncoding IN hGenXml ("UTF-8").


     RUN addNode IN hGenXml (getStack(), "Delete", "", OUTPUT iId).
     addStack(iId).

          RUN addNode IN hGenXml (getStack(), "DocumentSeries", DocumentSeries_00, OUTPUT iId).
          RUN addNode IN hGenXml (getStack(), "DocumentNumber", DocumentNumber_00, OUTPUT iId).
          RUN addNode IN hGenXml (getStack(), "FiscalOperation", "", OUTPUT iId).
          addStack(iId).

               RUN addNode    IN hGenXml (getStack(), "FiscalOperationCode", FiscalOperationCode_00, OUTPUT iId).
               RUN addNode    IN hGenXml (getStack(), "FiscalOperationDescription", FiscalOperationDescription_00, OUTPUT iId).

             &if "{&bf_dis_versao_ems}" >=  "2.08" &then
               RUN addNodeLog IN hGenXml (getStack(), "EndConsumer", EndConsumer, OUTPUT iId).
               RUN addNodeDec IN hGenXml (getStack(), "Type", Type_00, OUTPUT iId).
               RUN addNodeLog IN hGenXml (getStack(), "Transfer", Transfer, OUTPUT iId).
               RUN addNode    IN hGenXml (getStack(), "Kind":u, Kind_00, OUTPUT iId).
             &endif
             
          delStack().

          RUN addNode IN hGenXml (getStack(), "Vendor", "", OUTPUT iId).
          addStack(iId).

               RUN addNode IN hGenXml (getStack(), "VendorShortName", VendorShortName_00, OUTPUT iId).
               RUN addNode IN hGenXml (getStack(), "VendorTaxID", VendorTaxID_00, OUTPUT iId).
               RUN addNodeDec IN hGenXml (getStack(), "VendorID", VendorID_00, OUTPUT iId).

               IF  ContactSequence_00 <> ? THEN DO:
                   RUN addNode IN hGenXml (getStack(), "Contact", "", OUTPUT iId).
                   addStack(iId).
                        RUN addNodeDec IN hGenXml (getStack(), "ContactSequence", ContactSequence_00, OUTPUT iId).
                        RUN addNode IN hGenXml (getStack(), "ContactName", ContactName_00, OUTPUT iId).
                        RUN addNode IN hGenXml (getStack(), "PhoneNumber", PhoneNumber_00, OUTPUT iId).
                        RUN addNode IN hGenXml (getStack(), "EmailAddress", EmailAddress_00, OUTPUT iId).
                   delStack().
               END.

          delStack().

          RUN addNodeDec IN hGenXml (getStack(), "DocumentType", DocumentType_00, OUTPUT iId).
          RUN addNode IN hGenXml (getStack(), "Site", "", OUTPUT iId).
          addStack(iId).

               RUN addNode IN hGenXml (getStack(), "SiteShortName", SiteShortName_00, OUTPUT iId).
               RUN addNode IN hGenXml (getStack(), "SiteTaxID", SiteTaxID_00, OUTPUT iId).
               RUN addNode IN hGenXml (getStack(), "SiteID", SiteID_02, OUTPUT iId).
               RUN addNode IN hGenXml (getStack(), "SiteDescription", SiteDescription_02, OUTPUT iId).
          delStack().


     delStack().


/* OBTEM O XML NUMA HANDLE */
RUN generateXML IN hGenXml (OUTPUT hBusinessContent).


/* DEFINE O CONTEÚDO DO ELEMENTO BusinessContent */
RUN setBusinessContent IN hMessageHandler (INPUT hBusinessContent).

/* LIBERA MEMÓRIA ALOCADA PARA O OBJETO */
DELETE OBJECT hBusinessContent NO-ERROR.



/*CONTRÓI A MENSAGEM XML E ENVIA PARA O ControlBroker */

/*
Comentei este t¢pico pois nÆo foi liberado este schema e ainda nÆo tem previsÆo de libera‡Æo
este novo schema seria liberado no projeto de Unifica‡Æo de condeito
&IF "{&mguni_version}" >= "2.071" &THEN
RUN sendMessage IN hMessageHandler (INPUT "xmlschema/su2/receiptdocument_204_001.xsd"). 
&ELSE*/
RUN sendMessage IN hMessageHandler (INPUT "xmlschema/su2/receiptdocument_204_000.xsd"). 
/*&ENDIF*/

/* VERIFICA SE OCORREU ALGUM ERRO */
IF RETURN-VALUE <> "OK" THEN DO:
     CREATE TT_LOG_ERRO.

     ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 17006.
          /* Inicio -- Projeto Internacional */
          DEFINE VARIABLE c-lbl-liter-2 AS CHARACTER NO-UNDO.
          ASSIGN c-lbl-liter-2 = TRIM(RETURN-VALUE).
          DEFINE VARIABLE c-lbl-liter-erro-no-envio-da-mensagem AS CHARACTER NO-UNDO.
          {utp/ut-liter.i "Erro_no_envio_da_Mensagem" *}
          ASSIGN c-lbl-liter-erro-no-envio-da-mensagem = TRIM(RETURN-VALUE).
          ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO = c-lbl-liter-erro-no-envio-da-mensagem + ": "+ c-lbl-liter-2.
     RETURN RETURN-VALUE.
END.



/* VERIFICA SE A MENSAGEM FOI PROCESSADA COM SUCESSO */
RUN getReturnStatus IN hMessageHandler (OUTPUT pSendSuccess, OUTPUT pTotalErrors).



/* SE NAO ENVIO COM SUCESSO */
IF NOT pSendSuccess THEN DO:
     REPEAT iCount = 1 TO pTotalErrors:
          CREATE TT_LOG_ERRO.
          RUN getError IN hMessageHandler (iCount, OUTPUT TT_LOG_ERRO.TTV_NUM_COD_ERRO, OUTPUT pErrorType, OUTPUT TT_LOG_ERRO.TTV_DES_MSG_ERRO).
          ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 17006.

          
     END.
     RETURN "NOK".
END.
ELSE RETURN "OK".

/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.

