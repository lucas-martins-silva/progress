         WHERE config-tip-operac.cod-tip-operac = 'AXSSU001' OR
               config-tip-operac.cod-tip-operac = 'GFE-NFE' NO-ERROR.
    IF   AVAIL config-tip-operac THEN DO:
        EMPTY TEMP-TABLE tt-variavel.
    
        CREATE tt-variavel.
        ASSIGN tt-variavel.cod-var-oper = 'transaction'
               tt-variavel.cod-val-var  = pTranAction.
        /*---[ PAI ]------------------------------------------------------------------------------*/
    
        /**/
        /*assign tt-variavel.cod-var-oper = 'cod-cond-pag'
               tt-variavel.cod-val-var  = string(ttInvoiceDocumentAux.PaymentPlanCode).*/


        create tt-variavel.
        assign tt-variavel.cod-var-oper = 'cod-emitente'.
               tt-variavel.cod-val-var  = string(ttReceiptDocument.VendorID).

        create tt-variavel.
        assign tt-variavel.cod-var-oper = 'tipo-frete'.
               tt-variavel.cod-val-var  = string(ttReceiptDocument.FreightModality).

        create tt-variavel.
        assign tt-variavel.cod-var-oper = 'ind-tip-nota'.
               tt-variavel.cod-val-var  = string(ttReceiptDocument.InvoiceDocumentType). 
        
        create tt-variavel.
        assign tt-variavel.cod-var-oper = 'nat-oper'.
               tt-variavel.cod-val-var  = ttReceiptDocument.FiscalOperationCode.

        /**/
       
        RUN cdp/cdapi034.p (INPUT i-ep-codigo-usuario,
                            INPUT ttReceiptDocument.SiteID,
                            INPUT config-tip-operac.cod-tip-operac,
                            INPUT TABLE tt-variavel,
                            OUTPUT i-cod-regra-utilizada,
                            OUTPUT TABLE tt-retorno,
                            OUTPUT TABLE RowErrors).
       
        IF  CAN-FIND(FIRST tt-retorno
                     WHERE tt-retorno.campo-retorno = config-tip-operac.cod-tip-operac
                     AND   tt-retorno.valor-retorno = 'no') THEN RETURN 'NOK'.

        IF CAN-FIND (FIRST ttDocumentItem)  THEN
        DO:
            FOR EACH ttDocumentItem:
                FIND FIRST tt-variavel WHERE 
                           tt-variavel.cod-var-oper = 'it-codigo' EXCLUSIVE-LOCK NO-ERROR.
                IF NOT AVAIL tt-variavel THEN DO:
                   CREATE tt-variavel.
                   ASSIGN tt-variavel.cod-var-oper = 'it-codigo'.
                END.
                ASSIGN tt-variavel.cod-val-var  = ttDocumentItem.ItemCode.

                create tt-variavel.
                assign tt-variavel.cod-var-oper = 'nat-operacaoitem'
                       tt-variavel.cod-val-var  = ttDocumentItem.FiscalOperationCode.
            
                RUN cdp/cdapi034.p (INPUT i-ep-codigo-usuario,
                                    INPUT ttReceiptDocument.SiteID, 
                                    INPUT config-tip-operac.cod-tip-operac,
                                    INPUT TABLE tt-variavel,
                                    OUTPUT i-cod-regra-utilizada,
                                    OUTPUT TABLE tt-retorno,
                                    OUTPUT TABLE RowErrors).
        
                IF  CAN-FIND(FIRST tt-retorno
                             WHERE tt-retorno.campo-retorno = config-tip-operac.cod-tip-operac
                             AND   tt-retorno.valor-retorno = 'no') THEN RETURN 'NOK'.
        
                for each tt-retorno:
                    IF  tt-retorno.campo-retorno = "it-codigo"        THEN ASSIGN ttDocumentItem.ItemCode = tt-retorno.valor-retorno.
                    IF  tt-retorno.campo-retorno = "nat-operacaoitem" THEN ASSIGN ttDocumentItem.FiscalOperationCode  = tt-retorno.valor-retorno.
                    IF  tt-retorno.campo-retorno = "nat-operacaoitem" THEN ASSIGN ttDocumentItem.FiscalOperationCode  = tt-retorno.valor-retorno.
                end. /* for each tt-retorno: Item */
        
             END. /*  for each ttDocumentItem */
         END. /* do first */

    
         for each tt-retorno:
                CASE tt-retorno.campo-retorno:
                     WHEN "cod-emitente" THEN ASSIGN ttReceiptDocument.VendorTaxID = tt-retorno.valor-retorno.
                     WHEN "tipo-frete" THEN ASSIGN   ttReceiptDocument.FreightModality = INT(tt-retorno.valor-retorno).
                     WHEN "ind-tip-nota" THEN ASSIGN ttReceiptDocument.InvoiceDocumentType = int(tt-retorno.valor-retorno).
                     WHEN "nat-operacao" THEN ASSIGN ttReceiptDocument.FiscalOperationCode = tt-retorno.valor-retorno.
                 END CASE.
         end. /* for each tt-retorno: */    
    
         IF  CAN-FIND(FIRST tt-retorno
                 WHERE tt-retorno.campo-retorno = 'AXSSU001'
                 AND   tt-retorno.valor-retorno = 'no') THEN DO: 
         RUN PI_gera_tt_log_erro.
         RETURN 'NOK'.
         END.

         RETURN 'OK'.
    END. /* IF  AVAIL  config-tip-operac */
    /*---------------------------------------------------------------------------------[ integra‡Æo EMSxNeogrid ]---*/
    &ENDIF
    
    RETURN "OK":U.

END PROCEDURE.


