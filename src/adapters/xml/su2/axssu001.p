&IF "{&mguni_version}" >= "2.071" &THEN
RUN sendMessage IN hMessageHandler (INPUT "xmlschema/su2/receiptdocument_204_001.xsd"). 
&ELSE
RUN sendMessage IN hMessageHandler (INPUT "xmlschema/su2/receiptdocument_204_000.xsd"). 
&ENDIF

/* VERIFICA SE OCORREU ALGUM ERRO */
IF RETURN-VALUE <> "OK" THEN DO:
     CREATE TT_LOG_ERRO.


     ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 17006.
          /* Inicio -- Projeto Internacional */
          DEFINE VARIABLE c-lbl-liter-4 AS CHARACTER NO-UNDO.
          ASSIGN c-lbl-liter-4 = TRIM(RETURN-VALUE).
          DEFINE VARIABLE c-lbl-liter-erro-no-envio-da-mensagem-2 AS CHARACTER NO-UNDO.
          {utp/ut-liter.i "Erro_no_envio_da_Mensagem" *}
          ASSIGN c-lbl-liter-erro-no-envio-da-mensagem-2 = TRIM(RETURN-VALUE).
          ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO = c-lbl-liter-erro-no-envio-da-mensagem-2 + ": "+ c-lbl-liter-4.
     RETURN RETURN-VALUE.
END.



/* VERIFICA SE A MENSAGEM FOI PROCESSADA COM SUCESSO */
RUN getReturnStatus IN hMessageHandler (OUTPUT pSendSuccess, OUTPUT pTotalErrors).



/* SE NAO ENVIO COM SUCESSO */
IF NOT pSendSuccess THEN DO:
     REPEAT iCount = 1 TO pTotalErrors:
          CREATE TT_LOG_ERRO.
          RUN getError IN hMessageHandler (iCount,
                                           OUTPUT TT_LOG_ERRO.TTV_NUM_COD_ERRO,
                                           OUTPUT pErrorType,
                                           OUTPUT TT_LOG_ERRO.TTV_DES_MSG_ERRO).
          ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 17006.

     END.
     RETURN "NOK".
END.
ELSE RETURN "OK".

/* ******************************************* */
/* *************** BODY - END   ************** */
/* ******************************************* */

END PROCEDURE.

PROCEDURE PI_gera_tt_log_erro:
 
IF  CAN-FIND(FIRST RowErrors) THEN DO:
    FOR EACH RowErrors 
       WHERE RowErrors.ErrorNumber <> 10 AND
             RowErrors.ErrorType <> "INTERNAL":
 
        CREATE tt_log_erro. 
        ASSIGN tt_log_erro.ttv_num_cod_erro  = RowErrors.errorNumber    
               tt_log_erro.ttv_des_msg_ajuda = IF RowErrors.errorSubType = "ERROR":U THEN "business_error":U ELSE "business_information":U   
               tt_log_erro.ttv_des_msg_erro  = RowErrors.errorDescription.                                        
    END.
    RETURN 'NOK'.
END. /* IF  CAN-FIND(FIRST RowErrors) */
 
END PROCEDURE.

