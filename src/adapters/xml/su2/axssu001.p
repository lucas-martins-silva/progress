FIELD TaxValue_05 AS decimal INITIAL ?   /*Valor total de IPI. (Uso interno: Campo = movind.docum-est.ipi-dc-fasb[2])*/
FIELD TaxValue_06 AS decimal INITIAL ?   /*Valor total de ISS. (Uso interno: Campo = movind.docum-est.iss-dc-fasb[2])*/
FIELD TaxValue_07 AS decimal INITIAL ?   /*Valor total do ICMS das mercadorias da nota fiscal, dos itens e o valor da diferença entre o total da nota e total dos itens. (Uso interno: Campo = movind.docum-est.icm-dc-fasb[2])*/
FIELD TotalDiscountValue AS decimal INITIAL ?   /*Total de descontos da Nota Fiscal. (Uso interno: Campo = movind.docum-est.tot-desconto)*/
FIELD TotalDiscountValue_00 AS decimal INITIAL ?   /*Total de descontos da Nota Fiscal. (Uso interno: Campo = movind.docum-est.tot-des-fasb[1]*/
FIELD TotalDiscountValue_01 AS decimal INITIAL ?   /*Total de descontos da Nota Fiscal. (Uso interno: Campo = movind.docum-est.tot-des-fasb[2]*/
FIELD TotalDiscountValue_02 AS decimal INITIAL ?   /*Total de descontos da Nota Fiscal. (Uso interno: Campo = movind.docum-est.tot-desconto-me)*/
FIELD TotalTaxValue AS decimal INITIAL ?   /*Valor total dos impostos do documento. (Uso interno: Campo = movind.docum-est.tot-taxa)*/
FIELD TotalTaxValue_00 AS decimal INITIAL ?   /*Valor total dos impostos do documento. (Uso interno: Campo = movind.docum-est.tot-taxa-me)*/
FIELD TransactionDate AS date INITIAL ?   /*Data da transação. (Uso interno: Campo = movind.docum-est.dt-trans)*/
FIELD TransactionType AS integer INITIAL ?   /*Tipo do documento. Valores: 1 - Entrada, 2 - Saida. (Uso interno: Campo = movind.docum-est.tipo-docto - Include = ininc/i01in218.i)*/
FIELD TributarySubstitutionBasis AS decimal INITIAL ?   /*Base de cálculo para o ICMS por regime de Substituição Tributária. (Uso interno: Campo = movind.docum-est.base-subs)*/
FIELD TributarySubstitutionBasis_00 AS decimal INITIAL ?   /*Base de cálculo para o PIS por regime de Substituição Tributária. (Uso interno: Campo = movind.docum-est.base-pis-subs)*/
FIELD TributarySubstitutionBasis_01 AS decimal INITIAL ?   /*Base de cálculo para o COFINS por regime de Substituição Tributária. (Uso interno: Campo = movind.docum-est.base-cofins-subs)*/
FIELD TributarySubstitutionBasis_02 AS decimal INITIAL ?   /*Base de cálculo para o ICMS por regime de Substituição Tributária. (Uso interno: Campo = movind.docum-est.base-subs-fasb[1])*/
FIELD TributarySubstitutionBasis_03 AS decimal INITIAL ?   /*Base de cálculo para o ICMS por regime de Substituição Tributária. (Uso interno: Campo = movind.docum-est.base-subs-fasb[2])*/
FIELD TributarySubstitutionValue AS decimal INITIAL ?   /*Valor do ICMS recolhido por Substituição Tributária. (Uso interno: Campo = movind.docum-est.vl-subs)*/
FIELD TributarySubstitutionValue_00 AS decimal INITIAL ?   /*Valor do PIS recolhido por Substituição Tributária. (Uso interno: Campo = movind.docum-est.vl-pis-subs)*/
FIELD TributarySubstitutionValue_01 AS decimal INITIAL ?   /*Valor do COFINS recolhido por Substituição Tributária. (Uso interno: Campo = movind.docum-est.vl-cofins-subs)*/
FIELD TributarySubstitutionValue_02 AS decimal INITIAL ?   /*Valor do ICMS recolhido por Substituição Tributária. (Uso interno: Campo = movind.docum-est.vl-subs-fasb[1])*/
FIELD TributarySubstitutionValue_03 AS decimal INITIAL ?   /*Valor do ICMS recolhido por Substituição Tributária. (Uso interno: Campo = movind.docum-est.vl-subs-fasb[2])*/
&if "{&bf_dis_versao_ems}" >=  "2.08" &then
  field TotalGrossWeight              as decimal initial ?
  field TotalCubedWeight              as decimal initial ?
  field TotalVolumeM3                 as decimal initial ?
  field VehicleType                   as character initial ?
  field OperationType                 as integer initial ?
  field Product                       as integer initial ?
  field Shipment                      as integer initial ?
  field Independent                   as logical initial ?
  field VehicleFrontPlate             as character initial ?
  field VehicleRearPlate              as character initial ?
  field Driver                        as integer initial ?
  field RouteSite                     as character initial ?
  field Route                         as integer initial ?
  field DepartureKM                   as decimal initial ?
  field ArrivalKM                     as decimal initial ?
  field PayDispatch                   as logical initial ?
  field ReshipmentCarrier             as character initial ?
  field RelatedVendor                 as integer initial ?
&endif
.

&if "{&bf_dis_versao_ems}" >=  "2.08" &then
  DEF TEMP-TABLE ttAgent NO-UNDO
      FIELD Sequence                         AS INTEGER   INITIAL ?
      FIELD AgentCode                        AS INTEGER   INITIAL ?
      FIELD AgentCityCode                    AS INTEGER   INITIAL ?.

  DEFINE TEMP-TABLE ttFreightSimulation NO-UNDO
     FIELD SiteID             AS CHARACTER INITIAL ?  
     FIELD DocumentSeries     AS CHARACTER INITIAL ?   
     FIELD DocumentNumber     AS CHARACTER INITIAL ?  
     FIELD CargoRouteNumber   AS INTEGER   INITIAL ?  
     FIELD CustomerTaxID      AS CHARACTER INITIAL ?  
     FIELD FreightTableNumber AS INTEGER   INITIAL ?  
     FIELD Product            AS INTEGER   INITIAL ?  
     FIELD ValidityDate       AS DATE      INITIAL ?  
     FIELD RouteNumber        AS INTEGER   INITIAL ?  
     FIELD TermNumber         AS INTEGER   INITIAL ?  
     FIELD AgreedValue        AS DECIMAL   INITIAL ?  
     FIELD FreightUnitValue   AS DECIMAL   INITIAL ?  
     FIELD FreightValue       AS DECIMAL   INITIAL ?  
     FIELD DaryValue          AS DECIMAL   INITIAL ?  
     FIELD ADEMEValue         AS DECIMAL   INITIAL ?  
     FIELD DispatchValue      AS DECIMAL   INITIAL ?  
     FIELD ITRValue           AS DECIMAL   INITIAL ?  
     FIELD OthersValue        AS DECIMAL   INITIAL ?  
     FIELD TollValue          AS DECIMAL   INITIAL ?  
     FIELD InsuranceValue     AS DECIMAL   INITIAL ?  
     FIELD SUFRAMAValue       AS DECIMAL   INITIAL ?  
     FIELD CollectionRate     AS DECIMAL   INITIAL ?  
     FIELD DeliveryRate       AS DECIMAL   INITIAL ?  
     FIELD DispatchRateValue  AS DECIMAL   INITIAL ?  
     FIELD Comments           AS CHARACTER INITIAL ?  
     FIELD ttFreightSimulationID AS INTEGER INITIAL ?
     INDEX ixttFreightSimulation IS PRIMARY UNIQUE ttFreightSimulationID ASCENDING.     
&endif

PROCEDURE PIUpsert:

/*PARAMETERS - BEGIN*/
DEFINE INPUT PARAM cEvent AS CHARACTER INITIAL ? NO-UNDO.
DEFINE INPUT PARAM cTranAction AS CHARACTER INITIAL ? NO-UNDO.
DEFINE INPUT PARAM TABLE FOR ttReceiptDocument.
DEFINE INPUT PARAM TABLE FOR ttDocumentItem.
DEFINE INPUT PARAM TABLE FOR ttDocumentBill.
DEFINE INPUT PARAM TABLE FOR ttBillTax.
DEFINE INPUT PARAM TABLE FOR ttAccessoryExpense.
DEFINE INPUT PARAM TABLE FOR ttDocumentForFreightDistr_00.
DEFINE INPUT PARAM TABLE FOR ttPurchaseOrder.
DEFINE INPUT PARAM TABLE FOR ttReceiptLocation.
DEFINE INPUT PARAM TABLE FOR ttValidationMessage.
define input param table for ttInventoryUpdate.
DEFINE OUTPUT PARAM TABLE FOR tt_log_erro.
/*PARAMETERS - END*/


/*LOCAL VARIABLES - BEGIN*/
DEFINE VAR iCount AS INTEGER INITIAL ? NO-UNDO.
DEFINE VAR iId AS INTEGER INITIAL ? NO-UNDO.
DEFINE VAR pErrorId AS INTEGER INITIAL ? NO-UNDO.
DEFINE VAR pErrorType AS CHARACTER INITIAL ? NO-UNDO.
DEFINE VAR pTotalErrors AS INTEGER INITIAL ? NO-UNDO.
/*LOCAL VARIABLES - END*/


/* ******************************************* */
/* *************** BODY - BEGIN ************** */
/* ******************************************* */

/* VERIFICA SE MessageHandler.p ESTA NA MEMORIA */
{xmlinc/xmlloadmessagehandler.i &MessageHandler="hMessageHandler" &MHReturnValue="cReturnValue"}

IF cReturnValue <> "OK" THEN DO:
     CREATE TT_LOG_ERRO.
     
          ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 17006.
          /* Inicio -- Projeto Internacional */
          {utp/ut-liter.i "Erro_ao_executar_MessageHandle" *}
          ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO = RETURN-VALUE + ": "+ cReturnValue.
     RETURN cReturnValue.
END.

RUN isSubscribed IN hMessageHandler ("{&XmlProdName}", 
     "{&XmlApp}", 
     "{&XmlTranName}", 
     "{&XmlTranVersion}", 
     cEvent, 
     cTranAction, 
     OUTPUT lCreateMsg)
.

IF RETURN-VALUE <> "OK" THEN DO:
     CREATE TT_LOG_ERRO.

     
          ASSIGN TT_LOG_ERRO.TTV_NUM_COD_ERRO = 17006.
          /* Inicio -- Projeto Internacional */
          DEFINE VARIABLE c-lbl-liter-3 AS CHARACTER NO-UNDO.
          ASSIGN c-lbl-liter-3 = TRIM(RETURN-VALUE).
          DEFINE VARIABLE c-lbl-liter-erro-ao-executar-issubscribed-2 AS CHARACTER NO-UNDO.
          {utp/ut-liter.i "Erro_ao_executar_isSubscribed_no_MessageHandle" *}
          ASSIGN c-lbl-liter-erro-ao-executar-issubscribed-2 = TRIM(RETURN-VALUE).
          ASSIGN TT_LOG_ERRO.TTV_DES_MSG_ERRO = c-lbl-liter-erro-ao-executar-issubscribed-2 + ": "+ c-lbl-liter-3.
     RETURN RETURN-VALUE.
END.

IF NOT lCreateMsg THEN RETURN "OK".                                                                               

RUN PIEngineRegras (INPUT cTranAction).
IF RETURN-VALUE <> "OK" THEN RETURN RETURN-VALUE.

/* PREENCHE O VALOR DO ELEM. Comment DE TransactionId */
RUN setTransInfoComment IN hMessageHandler ("Comentario do desenvolvedor").

/* SETA SystemId */
RUN setSystemId IN hMessageHandler ("{&XmlMod}",  "{&XmlProdVersion}").

/*INDICA O VALOR DA CHAVE PRIMÁRIA DA TRANSAÇÃO */
RUN setKeyFields IN hMessageHandler ("DocumentSeries", String(ttReceiptDocument.DocumentSeries)).

/*INDICA O VALOR DA CHAVE PRIMÁRIA DA TRANSAÇÃO */
RUN setKeyFields IN hMessageHandler ("DocumentNumber", String(ttReceiptDocument.DocumentNumber)).

/*INDICA O VALOR DA CHAVE PRIMÁRIA DA TRANSAÇÃO */
RUN setKeyFields IN hMessageHandler ("FiscalOperationCode", String(ttReceiptDocument.FiscalOperationCode)).

/*INDICA O VALOR DA CHAVE PRIMÁRIA DA TRANSAÇÃO */
RUN setKeyFields IN hMessageHandler ("VendorShortName", String(ttReceiptDocument.VendorShortName)).

/*INDICA O VALOR DA CHAVE PRIMÁRIA DA TRANSAÇÃO */
RUN setKeyFields IN hMessageHandler ("VendorTaxID", String(ttReceiptDocument.VendorTaxID)).


/* INFORMA A EMPRESA E O ESTABELECIMENTO */
/*RUN setCompanyId IN hMessageHandler ("cCodEmp", "cCodEstab").*/



     /* RESETA OS VALORES */
     RUN reset IN hGenXml.

     /* SETA VALOR DE ENCODING */
     RUN setEncoding IN hGenXml ("UTF-8").


     RUN addNode IN hGenXml (getStack(), "Upsert", "", OUTPUT iId).
     addStack(iId).

          RUN addNode IN hGenXml (getStack(), "DocumentSeries", ttReceiptDocument.DocumentSeries, OUTPUT iId).
          RUN addNode IN hGenXml (getStack(), "DocumentNumber", ttReceiptDocument.DocumentNumber, OUTPUT iId).
          RUN addNode IN hGenXml (getStack(), "FiscalOperation", "", OUTPUT iId).
          addStack(iId).

               RUN addNode IN hGenXml (getStack(), "FiscalOperationCode", ttReceiptDocument.FiscalOperationCode, OUTPUT iId).
               IF FiscalOperationDescription <> ? THEN
               DO: /*Test LOGIC*/
                    RUN addNode IN hGenXml (getStack(), "FiscalOperationDescription", ttReceiptDocument.FiscalOperationDescription, OUTPUT iId).
               END. /*Test LOGIC*/
            
             &if "{&bf_dis_versao_ems}" >=  "2.08" &then
               RUN addNodelog IN hGenXml (getStack(), "EndConsumer", ttReceiptDocument.EndConsumer, OUTPUT iId).
               RUN addNodeDec IN hGenXml (getStack(), "Type",        ttReceiptDocument.Type_00    , OUTPUT iId).
               RUN addNodeLog IN hGenXml (getStack(), "Transfer",    ttReceiptDocument.Transfer   , OUTPUT iId).
               RUN addNode    IN hGenXml (getStack(), "Kind",        ttReceiptDocument.Kind_00    , OUTPUT iId).               
             &endif

          delStack().

          RUN addNode IN hGenXml (getStack(), "Vendor", "", OUTPUT iId).
          addStack(iId).

               RUN addNode IN hGenXml (getStack(), "VendorShortName", ttReceiptDocument.VendorShortName, OUTPUT iId).
               RUN addNode IN hGenXml (getStack(), "VendorTaxID", ttReceiptDocument.VendorTaxID, OUTPUT iId).
               RUN addNodeDec IN hGenXml (getStack(), "VendorID", ttReceiptDocument.VendorID, OUTPUT iId).

               IF  ttReceiptDocument.ContactSequence <> ? THEN DO: 
                   RUN addNode IN hGenXml (getStack(), "Contact", "", OUTPUT iId).
                   addStack(iId).
                        RUN addNodeDec IN hGenXml (getStack(), "ContactSequence", ttReceiptDocument.ContactSequence, OUTPUT iId).
                        RUN addNode IN hGenXml (getStack(), "ContactName", ttReceiptDocument.ContactName, OUTPUT iId).
                        RUN addNode IN hGenXml (getStack(), "PhoneNumber", ttReceiptDocument.PhoneNumber, OUTPUT iId).
                        RUN addNode IN hGenXml (getStack(), "EmailAddress", ttReceiptDocument.EmailAddress, OUTPUT iId).
                   delStack().
               END.

          delStack().

          RUN addNodeDec IN hGenXml (getStack(), "DocumentType", ttReceiptDocument.DocumentType, OUTPUT iId).
          RUN addNode IN hGenXml (getStack(), "Site", "", OUTPUT iId).
          addStack(iId).

               RUN addNode IN hGenXml (getStack(), "SiteShortName", ttReceiptDocument.SiteShortName, OUTPUT iId).
               RUN addNode IN hGenXml (getStack(), "SiteTaxID", ttReceiptDocument.SiteTaxID, OUTPUT iId).
               RUN addNode IN hGenXml (getStack(), "SiteID", ttReceiptDocument.SiteID, OUTPUT iId).
               RUN addNode IN hGenXml (getStack(), "SiteDescription", ttReceiptDocument.SiteDescription, OUTPUT iId).

             &if "{&bf_dis_versao_ems}" >=  "2.08" &then
               RUN addNodeDec IN hGenXml (getStack(), "RelatedVendor":u, ttReceiptDocument.RelatedVendor, OUTPUT iId).
             &endif
               
          delStack().

          RUN addNode IN hGenXml (getStack(), "FiscalSite", "", OUTPUT iId).
          addStack(iId).

               RUN addNode IN hGenXml (getStack(), "SiteID", ttReceiptDocument.SiteID_00, OUTPUT iId).
               RUN addNode IN hGenXml (getStack(), "SiteDescription", ttReceiptDocument.SiteDescription_00, OUTPUT iId).
          delStack().

          RUN addNode IN hGenXml (getStack(), "SourceSite", "", OUTPUT iId).
          addStack(iId).

               RUN addNode IN hGenXml (getStack(), "SiteID", ttReceiptDocument.SiteID_01, OUTPUT iId).
               RUN addNode IN hGenXml (getStack(), "SiteDescription", ttReceiptDocument.SiteDescription_01, OUTPUT iId).
          delStack().

          RUN addNodeDec IN hGenXml (getStack(), "TransactionType", ttReceiptDocument.TransactionType, OUTPUT iId).
          RUN addNodeDate IN hGenXml (getStack(), "TransactionDate", ttReceiptDocument.TransactionDate, OUTPUT iId).
          RUN addNodeDate IN hGenXml (getStack(), "PrintDate", ttReceiptDocument.PrintDate, OUTPUT iId).
          RUN addNode IN hGenXml (getStack(), "SuspenseAccount", "", OUTPUT iId).
          addStack(iId).

               RUN addNode IN hGenXml (getStack(), "AccountNumber", ttReceiptDocument.AccountNumber, OUTPUT iId).
               RUN addNode IN hGenXml (getStack(), "SubAccountNumber", ttReceiptDocument.SubAccountNumber, OUTPUT iId).

          delStack().

          RUN addNodeDec IN hGenXml (getStack(), "Comments", ttReceiptDocument.Comments, OUTPUT iId).
          RUN addNode IN hGenXml (getStack(), "SourceState", ttReceiptDocument.SourceState, OUTPUT iId).

        &if "{&bf_dis_versao_ems}" >=  "2.08" &then
          RUN addNodeDec IN hGenXml (getStack(), "TotalGrossWeight", ttReceiptDocument.TotalGrossWeight, OUTPUT iId).
          RUN addNodeDec IN hGenXml (getStack(), "TotalCubedWeight":u, ttReceiptDocument.TotalCubedWeight, OUTPUT iId).
          RUN addNodeDec IN hGenXml (getStack(), "TotalVolumeM3":u, ttReceiptDocument.TotalVolumeM3, OUTPUT iId).
        &endif

          RUN addNodeDec IN hGenXml (getStack(), "ShippingMethod", ttReceiptDocument.ShippingMethod, OUTPUT iId).
          RUN addNode IN hGenXml (getStack(), "ShipmentNumber", ttReceiptDocument.ShipmentNumber, OUTPUT iId).
          RUN addNodeDec IN hGenXml (getStack(), "FreightModality", ttReceiptDocument.FreightModality, OUTPUT iId).

        &IF "{&bf_dis_versao_ems}" >=  "2.08" &THEN
          if  not valid-handle(h-boad123a) then
              run adbo/boad123a.p persistent set h-boad123a.
          run openQueryStatic in h-boad123a ('main').
          run goToKey         in h-boad123a ('SPP_TOTVSGFE').
          if  return-value = "NOK" then
              assign l-func-totvsgfe = no.
          else
              run getLogField in h-boad123a (input  'ativo',
                                             output l-func-totvsgfe).
          IF l-func-totvsgfe THEN DO:         

            RUN addNode IN hGenXml (getStack(), "Freight", "", OUTPUT iId).
            addStack(iId).

                RUN addNode IN hGenXml (getStack(), "VehicleType":u, ttReceiptDocument.VehicleType, OUTPUT iId).
                RUN addNodeDec IN hGenXml (getStack(), "OperationType", ttReceiptDocument.OperationType, OUTPUT iId).
                RUN addNodeDec IN hGenXml (getStack(), "Product", ttReceiptDocument.Product, OUTPUT iId).
                RUN addNode IN hGenXml (getStack(), "ReshipmentCarrier", ttReceiptDocument.ReshipmentCarrier, OUTPUT iId).   

                if can-find(first ttAgent) then do:

                    RUN addNode IN hGenXml (getStack(), "ListOfAgent":u, "", OUTPUT iId).
                    addStack(iId).
    
                    FOR EACH ttAgent:
    
                        RUN addNode IN hGenXml (getStack(), "Agent":u, "", OUTPUT iId).
                        addStack(iId).
                
                        IF ttAgent.Sequence <> ? THEN
                            RUN addNodeDec IN hGenXml (getStack(), "Sequence":u    , ttAgent.Sequence     , OUTPUT iId).
                
                        IF ttAgent.AgentCode <> ? THEN
                            RUN addNodeDec IN hGenXml (getStack(), "AgentCode":u    , ttAgent.AgentCode     , OUTPUT iId).
        
                        IF ttAgent.AgentCityCode <> ? THEN
                            RUN addNodeDec IN hGenXml (getStack(), "AgentCityCode":u, ttAgent.AgentCityCode, OUTPUT iId).
        
                        delStack().
                    END.
                    delStack().

                end.

                if can-find(first ttFreightSimulation) then do:

                    RUN addNode IN hGenXml (getStack(), "ListOfFreightSimulation":u, "", OUTPUT iId).
                    addStack(iId).
    
                    FOR EACH ttFreightSimulation:
    
                        RUN addNode IN hGenXml (getStack(), "FreightSimulation":u, "", OUTPUT iId).
                        addStack(iId).

                        IF ttFreightSimulation.SiteID <> ? AND ttFreightSimulation.SiteID <> "" THEN
                        DO: /*Test LOGIC*/
                             RUN addNode IN hGenXml (getStack(), "SiteID", ttFreightSimulation.SiteID, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.DocumentSeries <> ? AND ttFreightSimulation.DocumentSeries <> "" THEN
                        DO: /*Test LOGIC*/
                             RUN addNode IN hGenXml (getStack(), "DocumentSeries", ttFreightSimulation.DocumentSeries, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.DocumentNumber <> ? AND ttFreightSimulation.DocumentNumber <> "" THEN
                        DO: /*Test LOGIC*/
                             RUN addNode IN hGenXml (getStack(), "DocumentNumber", ttFreightSimulation.DocumentNumber, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.CargoRouteNumber <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "CargoRouteNumber", ttFreightSimulation.CargoRouteNumber, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.CustomerTaxID <> ? AND ttFreightSimulation.CustomerTaxID <> "" THEN
                        DO: /*Test LOGIC*/
                             RUN addNode IN hGenXml (getStack(), "CustomerTaxID", ttFreightSimulation.CustomerTaxID, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.FreightTableNumber <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "FreightTableNumber", ttFreightSimulation.FreightTableNumber, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.Product <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "Product", ttFreightSimulation.Product, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.ValidityDate <> ?  AND string(ttFreightSimulation.ValidityDate) <> "" THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDate IN hGenXml (getStack(), "ValidityDate":U, ttFreightSimulation.ValidityDate, OUTPUT iId).
                        END. /*Test LOGIC*/
                        IF ttFreightSimulation.RouteNumber <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "RouteNumber", ttFreightSimulation.RouteNumber, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.TermNumber <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "TermNumber", ttFreightSimulation.TermNumber, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.AgreedValue <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "AgreedValue", ttFreightSimulation.AgreedValue, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.FreightUnitValue <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "FreightUnitValue", ttFreightSimulation.FreightUnitValue, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.FreightValue <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "FreightValue", ttFreightSimulation.FreightValue, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.DaryValue <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "DaryValue", ttFreightSimulation.DaryValue, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.ADEMEValue <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "ADEMEValue", ttFreightSimulation.ADEMEValue, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.DispatchValue <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "DispatchValue", ttFreightSimulation.DispatchValue, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.ITRValue <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "ITRValue", ttFreightSimulation.ITRValue, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.OthersValue <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "OthersValue", ttFreightSimulation.OthersValue, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.TollValue <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "TollValue", ttFreightSimulation.TollValue, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.InsuranceValue <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "InsuranceValue", ttFreightSimulation.InsuranceValue, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.SUFRAMAValue <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "SUFRAMAValue", ttFreightSimulation.SUFRAMAValue, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.CollectionRate <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "CollectionRate", ttFreightSimulation.CollectionRate, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.DispatchRateValue <> ? THEN
                        DO: /*Test LOGIC*/
                             RUN addNodeDec IN hGenXml (getStack(), "DispatchRateValue", ttFreightSimulation.DispatchRateValue, OUTPUT iId).
                        END.
                        IF ttFreightSimulation.Comments <> ? AND ttFreightSimulation.Comments <> "" THEN
                        DO: /*Test LOGIC*/
                             RUN addNode IN hGenXml (getStack(), "Comments", ttFreightSimulation.Comments, OUTPUT iId).
                        END.
                      delStack().
                    END.
                    delStack().
                end.
                
                RUN addNodeDec IN hGenXml (getStack(), "Shipment":u, ttReceiptDocument.Shipment, OUTPUT iId).
                RUN addNodeLog IN hGenXml (getStack(), "PayDispatch":u, ttReceiptDocument.PayDispatch, OUTPUT iId).
                RUN addNodeLog IN hGenXml (getStack(), "Independent":u, ttReceiptDocument.Independent, OUTPUT iId).
                RUN addNode    IN hGenXml (getStack(), "VehicleFrontPlate":u, ttReceiptDocument.VehicleFrontPlate, OUTPUT iId).
                RUN addNode    IN hGenXml (getStack(), "VehicleRearPlate":u, ttReceiptDocument.VehicleRearPlate, OUTPUT iId).
                RUN addNodeDec IN hGenXml (getStack(), "Driver":u, ttReceiptDocument.Driver, OUTPUT iId).
                RUN addNodeDec IN hGenXml (getStack(), "RouteSite":u, ttReceiptDocument.RouteSite, OUTPUT iId).
                RUN addNodeDec IN hGenXml (getStack(), "Route":u, ttReceiptDocument.Route, OUTPUT iId).
                RUN addNodeDec IN hGenXml (getStack(), "DepartureKM":u, ttReceiptDocument.DepartureKM, OUTPUT iId).
                RUN addNodeDec IN hGenXml (getStack(), "ArrivalKM":u, ttReceiptDocument.ArrivalKM, OUTPUT iId).                      

          delStack().
          end.
          IF VALID-HANDLE (h-boad123a) THEN
            RUN destroy IN h-boad123a.
