PROCEDURE PIDelete:

/*PARAMETERS - BEGIN*/
DEFINE INPUT PARAM cEvent AS CHARACTER INITIAL ? NO-UNDO.
DEFINE INPUT PARAM ContactName_00 AS CHARACTER INITIAL ? NO-UNDO.  /*Nome do contato. (Uso interno: Campo = mgadm.cont-emit.nome)*/
