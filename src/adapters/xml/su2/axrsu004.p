                                        RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "BillToCityName", OUTPUT BillToCityName).
                                        RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "BillToDistrictName", OUTPUT BillToDistrictName).
                                        RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "BillToStateCode", OUTPUT BillToStateCode).
                                        RUN getSonDec IN hGenXml (INPUT getStack(), INPUT "BillToNationalPostalCode", OUTPUT BillToNationalPostalCode).
                                        RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "BillToCountryCode", OUTPUT BillToCountryCode).
                                        RUN searchTag IN hGenXml (INPUT "BillToContact", INPUT getStack(), OUTPUT iId).
                                        if (iId <> ?) THEN DO:
                                             addStack(iId).

                                                  RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "BillToContactName", OUTPUT BillToContactName).
                                                  RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "BillToEmailAddress", OUTPUT BillToEmailAddress).
                                                  RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "BillToTelephoneNumber", OUTPUT BillToTelephoneNumber).
                                             delStack().
