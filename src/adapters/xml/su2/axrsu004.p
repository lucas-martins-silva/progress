                                                  RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "FromRoleEmailAddress", OUTPUT FromRoleEmailAddress).
                                                  RUN getSonVal IN hGenXml (INPUT getStack(), INPUT "FromRoleTelephoneNumber", OUTPUT FromRoleTelephoneNumber).
                                             delStack().
