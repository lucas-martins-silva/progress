FIND FIRST tt-pedido-compr NO-ERROR.

FIND FIRST pedido-compr where pedido-compr.num-pedido = tt-pedido-compr.num-pedido exclusive-lock no-error.

assign 
&IF  "{&bf_mat_versao_ems}"  <  "2.09"  &THEN
    OVERLAY(pedido-compr.char-1,2,1)     = substring(tt-pedido-compr.char-1,2,1)       
    OVERLAY(pedido-compr.CHAR-1,1,1)     = substring(tt-pedido-compr.CHAR-1,1,1)       
    OVERLAY(pedido-compr.char-1,3,50)    = substring(tt-pedido-compr.char-1,3,50)      
&ELSE
    pedido-compr.log-integr-portal       = tt-pedido-compr.log-integr-portal        
    pedido-compr.log-congela-ped         = tt-pedido-compr.log-congela-ped      
    pedido-compr.cod-ped-portal          = tt-pedido-compr.cod-ped-portal       
&ENDIF
.
release pedido-compr.

for each tt-ordem-compra no-lock:  
    find first ordem-compra where ordem-compra.numero-ordem = tt-ordem-compra.numero-ordem exclusive-lock no-error.
    
    ASSIGN
    &IF  "{&bf_mat_versao_ems}"  <  "2.09"  &THEN
    	OVERLAY(ordem-compra.char-1,92,50)   = substring(tt-ordem-compra.char-1,92,50) 
    &ELSE
    	ordem-compra.cod-ord-portal          = tt-ordem-compra.cod-ord-portal
    &ENDIF
    .      
    release ordem-compra.      

end. 

for each tt-cotacao-item no-lock:
    find first cotacao-item where cotacao-item.numero-ordem = tt-cotacao-item.numero-ordem and
                                  cotacao-item.it-codigo    = tt-cotacao-item.it-codigo    and
                                  cotacao-item.seq-cotac    = tt-cotacao-item.seq-cotac    and
                                  cotacao-item.cod-emitente = tt-cotacao-item.cod-emitente exclusive-lock no-error.
     
    assign
    &IF "{&bf_mat_versao_ems}" >= "2.09" &THEN
        cotacao-item.cod-respos-fornec    = tt-cotacao-item.cod-respos-fornec     
        cotacao-item.log-integr-portal    = tt-cotacao-item.log-integr-portal     
        cotacao-item.log-congela-cotac    = tt-cotacao-item.log-congela-cotac     
        cotacao-item.cod-cotac-portal     = tt-cotacao-item.cod-cotac-portal      
        cotacao-item.cod-cotac-pai-portal = tt-cotacao-item.cod-cotac-pai-portal   
    &ELSE
        OVERLAY(cotacao-item.char-2,121,18) = substring(tt-cotacao-item.char-2,121,18)
        OVERLAY(cotacao-item.char-2,101,1)  = substring(tt-cotacao-item.char-2,101,1) 
        OVERLAY(cotacao-item.CHAR-2,102,1)  = substring(tt-cotacao-item.CHAR-2,102,1) 
        OVERLAY(cotacao-item.char-2,103,18) = substring(tt-cotacao-item.char-2,103,18)
        OVERLAY(cotacao-item.char-2,139,18) = substring(tt-cotacao-item.char-2,139,18)
    &ENDIF
    .    
    release cotacao-item. 
end.

    
    
    


        








