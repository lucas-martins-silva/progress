if iBancoIni = iBancoFim then
   open query {&QUERY-NAME} for each {&TABLE-NAME}
              WHERE aplic-emprestimo.ep-codigo     = i-ep-codigo-usuario
              AND   aplic-emprestimo.banco         = iBancoIni
              AND   aplic-emprestimo.agencia      >= cAgenciaIni
              AND   aplic-emprestimo.agencia      <= cAgenciaFim
              AND   aplic-emprestimo.cod-mod      >= cCodModIni
              AND   aplic-emprestimo.cod-mod      <= cCodModFim
              AND   aplic-emprestimo.nr-aplicacao >= cNrAplicacaoIni
              AND   aplic-emprestimo.nr-aplicacao <= cNrAplicacaoFim                                
              NO-LOCK,
              EACH  tipo-modalidade 
              WHERE tipo-modalidade.codigo    = aplic-emprestimo.cod-mod
              AND   tipo-modalidade.transacao = 2 NO-LOCK
              {1}
              {2}. 
else
   if cCodModIni = cCodModFim then              
      open query {&QUERY-NAME} for each {&TABLE-NAME}
                WHERE aplic-emprestimo.cod-mod       = cCodModIni
                AND   aplic-emprestimo.ep-codigo     = i-ep-codigo-usuario
                AND   aplic-emprestimo.banco        >= iBancoIni
                AND   aplic-emprestimo.banco        <= iBancoFim
                AND   aplic-emprestimo.agencia      >= cAgenciaIni
                AND   aplic-emprestimo.agencia      <= cAgenciaFim
                AND   aplic-emprestimo.nr-aplicacao >= cNrAplicacaoIni
                AND   aplic-emprestimo.nr-aplicacao <= cNrAplicacaoFim                                
                NO-LOCK,
                EACH  tipo-modalidade 
                WHERE tipo-modalidade.codigo    = aplic-emprestimo.cod-mod
                AND   tipo-modalidade.transacao = 2 NO-LOCK
                {1}
                {2}. 
   else
      open query {&QUERY-NAME} for each {&TABLE-NAME}
                 WHERE aplic-emprestimo.ep-codigo     = i-ep-codigo-usuario
                 AND   aplic-emprestimo.banco        >= iBancoIni
                 AND   aplic-emprestimo.banco        <= iBancoFim
                 AND   aplic-emprestimo.agencia      >= cAgenciaIni
                 AND   aplic-emprestimo.agencia      <= cAgenciaFim
                 AND   aplic-emprestimo.cod-mod      >= cCodModIni
                 AND   aplic-emprestimo.cod-mod      <= cCodModFim
                 AND   aplic-emprestimo.nr-aplicacao >= cNrAplicacaoIni
                 AND   aplic-emprestimo.nr-aplicacao <= cNrAplicacaoFim                                
                 NO-LOCK,
                 EACH  tipo-modalidade 
                 WHERE tipo-modalidade.codigo    = aplic-emprestimo.cod-mod
                 AND   tipo-modalidade.transacao = 2 NO-LOCK
                 {1}
                 {2}. 
