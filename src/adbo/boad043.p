procedure setConstraint2:
/* Seta vari vel de controle para openQuery2 contendo o c¢digo do 
   emitente. A openQuery2, por sua vez, busca conjunto de registros 
   da tabela cont-emit restingindo-os atrav‚s do c¢digo do emitente */

define input parameter p-cod-emitente as integer.

assign i-cod-emitente = p-cod-emitente.
 
end procedure.
 
procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock INDEXED-REPOSITION.
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} 
                       where {&TABLE-NAME}.cod-emitente = i-cod-emitente no-lock INDEXED-REPOSITION.            
    end case.
    assign l-query = true
           i-bo-query = i-abertura.
end procedure.
 
