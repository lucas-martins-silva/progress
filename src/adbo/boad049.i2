if c-conta-contab-ini = c-conta-contab-fim then do:
    open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock 
              where {&TABLE-NAME}.ep-codigo       = i-empresa          and
                    {&TABLE-NAME}.conta-contabil  = c-conta-contab-ini AND 
                    {&TABLE-NAME}.reduzida       >= i-conta-reduz-ini  AND
                    {&TABLE-NAME}.reduzida       <= i-conta-reduz-fim  AND
                    {&TABLE-NAME}.titulo         >= c-tit-ini          AND
                    {&TABLE-NAME}.titulo         <= c-tit-fim          and
                    ((l-ativada        and conta-contab.estado        = 1) 
                    or (l-desativada   and conta-contab.estado        = 2) 
                    or (l-sistema      and conta-contab.estado        = 3)) and 
                    ((l-despesa        and conta-contab.tipo          = 1)
                    or (l-receita      and conta-contab.tipo          = 2)
                    or (l-venda        and conta-contab.tipo          = 3)
                    or (l-passivo      and conta-contab.tipo          = 4)
                    or (l-ativo        and conta-contab.tipo          = 5)
                    or (l-titulo       and conta-contab.tipo          = 6)) and
                    ((l-contab         and conta-contab.contab       <> 1)
                    or (l-contas-pagar and conta-contab.contas-pagar <> 1) 
                    or (l-contas-receb and conta-contab.contas-receb <> 1) 
                    or (l-estoque      and conta-contab.estoque      <> 10) 
                    or (l-faturamento  and conta-contab.faturamento  <> 1)
                    or (l-folha-pagto  and conta-contab.folha-pagto  <> 1)
                    or (l-patrimonio   and conta-contab.patrimonio   <> 1) 
                    or (l-investimento and conta-contab.investimento <> 1) 
                    or (l-obrig-fisc   and conta-contab.obrig-fisc   <> 1) 
                    or (l-caixa-bancos and conta-contab.caixa-bancos <> 1))
                    by {&TABLE-NAME}.{1} INDEXED-REPOSITION.
end.
else do:
   if i-conta-reduz-ini = i-conta-reduz-fim then do:
        open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock 
                  where {&TABLE-NAME}.ep-codigo       = i-empresa          and
                        {&TABLE-NAME}.reduzida        = i-conta-reduz-ini  AND
                        {&TABLE-NAME}.conta-contabil >= c-conta-contab-ini AND 
                        {&TABLE-NAME}.conta-contabil <= c-conta-contab-fim AND
                        {&TABLE-NAME}.titulo         >= c-tit-ini          AND
                        {&TABLE-NAME}.titulo         <= c-tit-fim          and
                        ((l-ativada        and conta-contab.estado        = 1) 
                        or (l-desativada   and conta-contab.estado        = 2) 
                        or (l-sistema      and conta-contab.estado        = 3)) and 
                        ((l-despesa        and conta-contab.tipo          = 1)
                        or (l-receita      and conta-contab.tipo          = 2)
                        or (l-venda        and conta-contab.tipo          = 3)
                        or (l-passivo      and conta-contab.tipo          = 4)
                        or (l-ativo        and conta-contab.tipo          = 5)
                        or (l-titulo       and conta-contab.tipo          = 6)) and
                        ((l-contab         and conta-contab.contab       <> 1)
                        or (l-contas-pagar and conta-contab.contas-pagar <> 1) 
                        or (l-contas-receb and conta-contab.contas-receb <> 1) 
                        or (l-estoque      and conta-contab.estoque      <> 10) 
                        or (l-faturamento  and conta-contab.faturamento  <> 1)
                        or (l-folha-pagto  and conta-contab.folha-pagto  <> 1)
                        or (l-patrimonio   and conta-contab.patrimonio   <> 1) 
                        or (l-investimento and conta-contab.investimento <> 1) 
                        or (l-obrig-fisc   and conta-contab.obrig-fisc   <> 1) 
                        or (l-caixa-bancos and conta-contab.caixa-bancos <> 1))
                        by {&TABLE-NAME}.{1} INDEXED-REPOSITION.
   end.
   else do:
        open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock 
                  where {&TABLE-NAME}.ep-codigo       = i-empresa          and
                        {&TABLE-NAME}.conta-contabil >= c-conta-contab-ini AND 
                        {&TABLE-NAME}.conta-contabil <= c-conta-contab-fim AND
                        {&TABLE-NAME}.reduzida       >= i-conta-reduz-ini  AND
                        {&TABLE-NAME}.reduzida       <= i-conta-reduz-fim  AND
                        {&TABLE-NAME}.titulo         >= c-tit-ini          AND
                        {&TABLE-NAME}.titulo         <= c-tit-fim          and
                        ((l-ativada        and conta-contab.estado        = 1) 
                        or (l-desativada   and conta-contab.estado        = 2) 
                        or (l-sistema      and conta-contab.estado        = 3)) and 
                        ((l-despesa        and conta-contab.tipo          = 1)
                        or (l-receita      and conta-contab.tipo          = 2)
                        or (l-venda        and conta-contab.tipo          = 3)
                        or (l-passivo      and conta-contab.tipo          = 4)
                        or (l-ativo        and conta-contab.tipo          = 5)
                        or (l-titulo       and conta-contab.tipo          = 6)) and
                        ((l-contab         and conta-contab.contab       <> 1)
                        or (l-contas-pagar and conta-contab.contas-pagar <> 1) 
                        or (l-contas-receb and conta-contab.contas-receb <> 1) 
                        or (l-estoque      and conta-contab.estoque      <> 10) 
                        or (l-faturamento  and conta-contab.faturamento  <> 1)
                        or (l-folha-pagto  and conta-contab.folha-pagto  <> 1)
                        or (l-patrimonio   and conta-contab.patrimonio   <> 1) 
                        or (l-investimento and conta-contab.investimento <> 1) 
                        or (l-obrig-fisc   and conta-contab.obrig-fisc   <> 1) 
                        or (l-caixa-bancos and conta-contab.caixa-bancos <> 1))
                        by {&TABLE-NAME}.{1} INDEXED-REPOSITION.
   end.
end.

