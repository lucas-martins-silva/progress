procedure findCodigo:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter c-cod-estabel as char no-undo.
    def output parameter c-return as char no-undo.     
    find first estabelec where
        estabelec.cod-estabel = c-cod-estabel
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
       {utp/ut-table.i mgadm {&TABLE-NAME} 1}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.

procedure findCGC:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter c-cgc-estabel as char no-undo.
    def output parameter c-return as char no-undo.     
    find first estabelec where
        estabelec.cgc = c-cgc-estabel
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
       {utp/ut-table.i mgadm {&TABLE-NAME} 1}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.
