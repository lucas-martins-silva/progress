        if  i-cod-emitente-ini = i-cod-emitente-fim then do:
            open query {&QUERYNAME} for each {&TABLENAME}  
                                    where     {&TABLENAME}.cod-emitente  = i-cod-emitente-ini   and
                                              {&TABLENAME}.nome-abrev   >= c-nome-abrev-ini     and
                                              {&TABLENAME}.nome-abrev   <= c-nome-abrev-fim     and
                                              {&TABLENAME}.cgc          >= c-cgc-ini            and
                                              {&TABLENAME}.cgc          <= c-cgc-fim            and
                                              {&TABLENAME}.nome-emit    >= c-nome-emit-ini      and
                                              {&TABLENAME}.nome-emit    <= c-nome-emit-fim      and 
                                              {&TABLENAME}.cod-gr-cli  >= i-cod-gr-cli-ini    and
                                              {&TABLENAME}.cod-gr-cli  <= i-cod-gr-cli-fim    and
                                              {&TABLENAME}.nome-matriz  >= c-nome-matriz-ini    and
                                              {&TABLENAME}.nome-matriz  <= c-nome-matriz-fim    and
                                              {&TABLENAME}.identific    <> 2 no-lock
                                              by {&TABLENAME}.{1} indexed-reposition.  
        end.                                      
        else do:
            if c-nome-abrev-ini = c-nome-abrev-fim then do:
                open query {&QUERYNAME} for each {&TABLENAME}  
                                            where {&TABLENAME}.cod-emitente >= i-cod-emitente-ini   and
                                                  {&TABLENAME}.cod-emitente <= i-cod-emitente-fim   and
                                                  {&TABLENAME}.nome-abrev    = c-nome-abrev-ini     and
                                                  {&TABLENAME}.cgc          >= c-cgc-ini            and
                                                  {&TABLENAME}.cgc          <= c-cgc-fim            and
                                                  {&TABLENAME}.nome-emit    >= c-nome-emit-ini      and
                                                  {&TABLENAME}.nome-emit    <= c-nome-emit-fim      and 
                                                  {&TABLENAME}.cod-gr-cli  >= i-cod-gr-cli-ini    and
                                                  {&TABLENAME}.cod-gr-cli  <= i-cod-gr-cli-fim    and
                                                  {&TABLENAME}.nome-matriz  >= c-nome-matriz-ini    and
                                                  {&TABLENAME}.nome-matriz  <= c-nome-matriz-fim    and
                                                  {&TABLENAME}.identific    <> 2 no-lock
                                                  by {&TABLENAME}.{1} indexed-reposition.  
            end.
            else do: 
                if c-cgc-ini = c-cgc-fim then do:
                    open query {&QUERYNAME} for each {&TABLENAME}  
                                                where {&TABLENAME}.cod-emitente >= i-cod-emitente-ini   and
                                                      {&TABLENAME}.cod-emitente <= i-cod-emitente-fim   and
                                                      {&TABLENAME}.nome-abrev   >= c-nome-abrev-ini     and
                                                      {&TABLENAME}.nome-abrev   <= c-nome-abrev-fim     and
                                                      {&TABLENAME}.cgc           = c-cgc-ini            and
                                                      {&TABLENAME}.nome-emit    >= c-nome-emit-ini      and
                                                      {&TABLENAME}.nome-emit    <= c-nome-emit-fim      and 
                                                      {&TABLENAME}.cod-gr-cli  >= i-cod-gr-cli-ini    and
                                                      {&TABLENAME}.cod-gr-cli  <= i-cod-gr-cli-fim    and
                                                      {&TABLENAME}.nome-matriz  >= c-nome-matriz-ini    and
                                                      {&TABLENAME}.nome-matriz  <= c-nome-matriz-fim    and
                                                      {&TABLENAME}.identific    <> 2 no-lock
                                                      by {&TABLENAME}.{1} indexed-reposition.  
                end.
                else do:
                    if i-cod-gr-cli-ini = i-cod-gr-cli-fim then do:
                        open query {&QUERYNAME} for each {&TABLENAME}  
                                                    where {&TABLENAME}.cod-emitente >= i-cod-emitente-ini   and
                                                          {&TABLENAME}.cod-emitente <= i-cod-emitente-fim   and
                                                          {&TABLENAME}.nome-abrev   >= c-nome-abrev-ini     and
                                                          {&TABLENAME}.nome-abrev   <= c-nome-abrev-fim     and
                                                          {&TABLENAME}.cgc          >= c-cgc-ini            and
                                                          {&TABLENAME}.cgc          <= c-cgc-fim            and
                                                          {&TABLENAME}.nome-emit    >= c-nome-emit-ini      and
                                                          {&TABLENAME}.nome-emit    <= c-nome-emit-fim      and 
                                                          {&TABLENAME}.cod-gr-cli   = i-cod-gr-cli-ini    and
                                                          {&TABLENAME}.nome-matriz  >= c-nome-matriz-ini    and
                                                          {&TABLENAME}.nome-matriz  <= c-nome-matriz-fim    and
                                                          {&TABLENAME}.identific    <> 2 no-lock
                                                          by {&TABLENAME}.{1} indexed-reposition.  
                    end.
                    else do:
                        open query {&QUERYNAME} for each {&TABLENAME}  
                                                    where {&TABLENAME}.cod-emitente >= i-cod-emitente-ini   and
                                                          {&TABLENAME}.cod-emitente <= i-cod-emitente-fim   and
                                                          {&TABLENAME}.nome-abrev   >= c-nome-abrev-ini     and
                                                          {&TABLENAME}.nome-abrev   <= c-nome-abrev-fim     and
                                                          {&TABLENAME}.cgc          >= c-cgc-ini            and
                                                          {&TABLENAME}.cgc          <= c-cgc-fim            and
                                                          {&TABLENAME}.nome-emit    >= c-nome-emit-ini      and
                                                          {&TABLENAME}.nome-emit    <= c-nome-emit-fim      and 
                                                          {&TABLENAME}.cod-gr-cli  >= i-cod-gr-cli-ini    and
                                                          {&TABLENAME}.cod-gr-cli  <= i-cod-gr-cli-fim    and
                                                          {&TABLENAME}.nome-matriz  >= c-nome-matriz-ini    and
                                                          {&TABLENAME}.nome-matriz  <= c-nome-matriz-fim    and
                                                          {&TABLENAME}.identific    <> 2 no-lock
                                                          by {&TABLENAME}.{1} indexed-reposition.  
                    end.                                      
                end. 
            end.                                      
        end.                                      

