&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryNome DBOProgram 
PROCEDURE openQueryNome :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    if c-nome-ini = c-nome-fim then
        OPEN QUERY {&queryname} FOR EACH {&tablename} NO-LOCK 
             WHERE operac-cambio.nome  = c-nome-ini BY operac-cambio.nome.    
    else
        OPEN QUERY {&queryname} FOR EACH {&tablename} NO-LOCK 
             WHERE operac-cambio.nome >= c-nome-ini and
                   operac-cambio.nome <= c-nome-fim BY operac-cambio.nome.
                   
    RETURN "OK":U.
END PROCEDURE.

