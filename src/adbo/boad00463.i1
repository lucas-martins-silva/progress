/* calcula reduçao conforme cadastro de processo judicial */
FOR EACH proces-esocial-recebimento NO-LOCK
    WHERE proces-esocial-recebimento.cdn-emitente      = tt-docum-est-esoc-aux.cod-emitente
      AND proces-esocial-recebimento.cod-imposto       = STRING(dupli-imp.int-1)
      AND proces-esocial-recebimento.dat-inic-valid   <= tt-docum-est-esoc-aux.dt-trans  
      AND proces-esocial-recebimento.dat-fim-valid    >= tt-docum-est-esoc-aux.dt-trans
      AND proces-esocial-recebimento.cdn-mater-proces  = 1 /*Informar um número de processo judicial cadastrado através do evento S-1070, cujo {indMatProc} seja igual a [1]. Validaçao: O processo deve existir na tabela de processos (S-1070).*/
      AND (proces-esocial-recebimento.num-livre-1      = 0 OR /*Ambos*/
           proces-esocial-recebimento.num-livre-1      = 1):  /*eSocial*/
    
    /*Indicador se o processo é do próprio emitende (1) ou de outra entidade (2)*/
    ASSIGN OVERLAY(tt-docum-est-esoc-aux.cod-livre-2, 1, 1) = STRING(proces-esocial-recebimento.cdn-tip-autoria). 
        
    ASSIGN tt-docum-est-esoc-aux.nr-proc-jud = proces-esocial-recebimento.cod-process-judic              /*numero do processo*/
           {1}                                = (tt-docum-est-esoc-aux.vl-bruto * proces-esocial-recebimento.percentual / 100). /*vrSenarNRet valor que deixou de ser retido*/
     
    IF VALID-HANDLE(h-boad00566) THEN DO:
       
       RUN pi-retorna-codigo-suspensao IN h-boad00566 (INPUT proces-esocial-recebimento.cod-process-judic,
                                                       INPUT docum-est.dt-emiss, /* Suspensao vale a partir da data da decisao judicial */
                                                       OUTPUT c-cod-suspensao).
       ASSIGN tt-docum-est-esoc-aux.cod-seq-suspen = c-cod-suspensao.
       
    END.

    /*cria vinculo process-estab quando nao existir*/
    IF NOT CAN-FIND (FIRST process-estab
                        WHERE process-estab.cod-process-judic = tt-docum-est-esoc-aux.nr-proc-jud
                          AND process-estab.cod-estabel       = tt-docum-est-esoc-aux.cod-estabel) THEN DO:

        RUN getLastSeq IN h-boad00537 (OUTPUT i-num-seq-proces).
        
        CREATE tt-process-estab.
        ASSIGN tt-process-estab.num-seq           = i-num-seq-proces  
               tt-process-estab.cod-process-judic = tt-docum-est-esoc-aux.nr-proc-jud
               tt-process-estab.cod-estabel       = tt-docum-est-esoc-aux.cod-estabel.
        
        RUN openQueryStatic IN h-boad00537 (INPUT "main":U).
        RUN setRecord       IN h-boad00537 (INPUT TABLE tt-process-estab).
        RUN emptyRowErrors  IN h-boad00537.
        RUN createRecord    IN h-boad00537.
        
        DELETE tt-process-estab.

    END.
    /***********************************************/

END.
/**********************************************************/
