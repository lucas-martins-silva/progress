&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getKey DBOProgram  
PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice blnsr_id2
  Parameters:  
               retorna valor do campo cod-balanca
               retorna valor do campo cod-estabel
               retorna valor do campo cod-usuar
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pcod-balanca LIKE balan-usuar.cod-balanca NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-estabel LIKE balan-usuar.cod-estabel NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-usuar LIKE balan-usuar.cod-usuar NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pcod-balanca = RowObject.cod-balanca
           pcod-estabel = RowObject.cod-estabel
           pcod-usuar = RowObject.cod-usuar.

    RETURN "OK":U.
END PROCEDURE.

