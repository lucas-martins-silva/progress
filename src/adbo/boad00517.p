&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram  
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice blnsr_id2
  Parameters:  
               recebe valor do campo cod-balanca
               recebe valor do campo cod-estabel
               recebe valor do campo cod-usuar
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-balanca LIKE balan-usuar.cod-balanca NO-UNDO.
    DEFINE INPUT PARAMETER pcod-estabel LIKE balan-usuar.cod-estabel NO-UNDO.
    DEFINE INPUT PARAMETER pcod-usuar LIKE balan-usuar.cod-usuar NO-UNDO.

    FIND FIRST bfbalan-usuar WHERE 
        bfbalan-usuar.cod-balanca = pcod-balanca AND 
        bfbalan-usuar.cod-estabel = pcod-estabel AND 
        bfbalan-usuar.cod-usuar = pcod-usuar NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfbalan-usuar THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfbalan-usuar)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

