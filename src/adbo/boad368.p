&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE OpenQueryCodigo DBOProgram 
PROCEDURE OpenQueryCodigo :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    if i-codigo-ini = i-codigo-fim then
        OPEN QUERY {&queryname} FOR EACH {&tablename} NO-LOCK
             WHERE (texto-padrao-mec.codigo  = i-codigo-ini)
             by texto-padrao-mec.codigo INDEXED-REPOSITION.    
    else
        OPEN QUERY {&queryname} FOR EACH {&tablename} NO-LOCK
             WHERE (texto-padrao-mec.codigo >= i-codigo-ini and
                    texto-padrao-mec.codigo <= i-codigo-fim)
             by texto-padrao-mec.codigo INDEXED-REPOSITION.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE OpenQueryDescricao DBOProgram 
PROCEDURE OpenQueryDescricao :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    if c-descricao-ini = c-descricao-fim then
        OPEN QUERY {&queryname} FOR EACH {&tablename} NO-LOCK 
             WHERE texto-padrao-mec.descricao  = c-descricao-ini BY texto-padrao-mec.descricao INDEXED-REPOSITION.    
    else
        OPEN QUERY {&queryname} FOR EACH {&tablename} NO-LOCK 
             WHERE texto-padrao-mec.descricao >= c-descricao-ini and
                   texto-padrao-mec.descricao <= c-descricao-fim BY texto-padrao-mec.descricao INDEXED-REPOSITION.

    RETURN "OK":U.
END PROCEDURE.

