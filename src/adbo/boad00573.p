&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE beforeCreateRecord DBOProgram 
PROCEDURE beforeCreateRecord :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

   DEFINE VARIABLE i-seq LIKE transport-log.cdd-id-transp-log NO-UNDO.

   blk-1:
   REPEAT: 
       ASSIGN i-seq = NEXT-VALUE(seq-transport-log).
       IF NOT CAN-FIND(bf{&TableName}
                 WHERE bf{&TableName}.cdd-id-transp-log = i-seq) THEN
           LEAVE blk-1.
   END.

   ASSIGN RowObject.cdd-id-transp-log = i-seq.

END PROCEDURE.

