/*
**  BOAD039.i1
**
**  Procedure findCodigo: esta procedure foi transformada
**  em include pois este codigo e comum aos produtos EMS e
**  Magnus.
**
**  Ultima altera‡Æo : 08/03/2000 - brv13084
*/

procedure findCodigo:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter i-cod-cond-pag as inte no-undo.
    def output parameter c-return as char no-undo.
 
    find cond-pagto where
        cond-pagto.cod-cond-pag = i-cod-cond-pag
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
        {utp/ut-table.i mgadm cond-pagto 1}
        /****************************************************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.
