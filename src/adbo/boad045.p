define variable i-cod-rep as integer no-undo.
 
procedure setConstraint1:
 
end procedure.

procedure setConstraint2:

    define input parameter p-cod-rep as char no-undo.
    
    assign i-cod-rep = int(p-cod-rep).

end procedure.
 
procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock INDEXED-REPOSITION.
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where 
                                              {&TABLE-NAME}.cod-repres = i-cod-rep no-lock INDEXED-REPOSITION.
    end case.
    assign l-query = true
           i-bo-query = i-abertura.
end procedure.
 
