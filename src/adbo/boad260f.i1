DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

def var c-cod-estabel as char no-undo.
def var c-embarque    as char no-undo.
    
procedure setConstraint1:

end procedure. 

procedure setConstraint2:
    def input parameter p-cod-estabel    as char    no-undo.
    def input parameter p-embarque       as char    no-undo.
    
    assign c-cod-estabel = p-cod-estabel
           c-embarque    = p-embarque.
   
end procedure.

procedure setConstraint3:
    def input parameter p-cod-estabel    as char    no-undo.
    def input parameter p-embarque       as char    no-undo.
    
    assign c-cod-estabel = p-cod-estabel
           c-embarque    = p-embarque.
   
end procedure.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    
    case i-abertura:
        when 1 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock INDEXED-REPOSITION.    
        when 2 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock INDEXED-REPOSITION.
        when 3 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
    end case.

    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.
 
