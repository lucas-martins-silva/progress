&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE returnInfoDoc DBOProgram 
PROCEDURE returnInfoDoc :
/*------------------------------------------------------------------------------
  Purpose:     retornar as informaá‰es do tipo de documento do emitente
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEF  INPUT PARAM p-emitente   LIKE emitente-internac.cdn-emitente                NO-UNDO.
    DEF OUTPUT PARAM p-cod-docto  LIKE internac-tipo-docto-ident.cod-tip-docto-ident NO-UNDO.
    DEF OUTPUT PARAM p-cod-fiscal LIKE internac-tipo-docto-ident.cod-fisc            NO-UNDO.
    DEF OUTPUT PARAM p-formato    LIKE internac-tipo-docto-ident.cod-format          NO-UNDO.
    DEF OUTPUT PARAM p-descricao  LIKE internac-tipo-docto-ident.des-descr           NO-UNDO.
    DEF OUTPUT PARAM TABLE FOR rowErrors.
    
    EMPTY TEMP-TABLE rowErrors.
    
    FIND FIRST bf{&TableName} NO-LOCK
        WHERE bf{&TableName}.cdn-emitente = p-emitente NO-ERROR.
    IF  NOT AVAIL bf{&TableName} THEN DO:
        {method/svc/errors/inserr.i &ErrorNumber="33137"
                                    &ErrorType="EMS"
                                    &ErrorSubType="ERROR"
                                    &ErrorParameters="p-emitente"}
        RETURN "NOK":U.        
    END.
    
    FIND internac-tipo-docto-ident
        WHERE internac-tipo-docto-ident.cod-tip-docto-ident = bf{&TableName}.cod-tip-docto-ident NO-LOCK NO-ERROR.
    IF  NOT AVAIL internac-tipo-docto-ident THEN DO:
        {utp/ut-liter.i "Documento_Emitente" *}
        RUN utp/ut-msgs.p ('msg', 2, TRIM(RETURN-VALUE)). 
        
        CREATE RowErrors.
        ASSIGN RowErrors.ErrorNumber      = 2
               RowErrors.ErrorDescription = TRIM(RETURN-VALUE)
               RowErrors.ErrorType        = "EMS":U
               RowErrors.ErrorSubType     = "ERROR":U
               RowErrors.ErrorHelp        = TRIM(RETURN-VALUE).
        RETURN "NOK":U.
    END.
    
    ASSIGN p-cod-docto  = internac-tipo-docto-ident.cod-tip-docto-ident 
           p-cod-fiscal = internac-tipo-docto-ident.cod-fisc 
           p-formato    = internac-tipo-docto-ident.cod-format 
           p-descricao  = internac-tipo-docto-ident.des-descr.
    
    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/
    
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

