&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryNome DBOProgram 
PROCEDURE openQueryNome :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    if c-descricao-ini = c-descricao-fim then
        OPEN QUERY {&queryname} FOR EACH {&tablename} NO-LOCK
             WHERE forma-pgto-mec.descricao  = c-descricao-ini BY forma-pgto-mec.descricao INDEXED-REPOSITION.    
    else
        OPEN QUERY {&queryname} FOR EACH {&tablename} NO-LOCK
             WHERE forma-pgto-mec.descricao >= c-descricao-ini and
                   forma-pgto-mec.descricao <= c-descricao-fim BY forma-pgto-mec.descricao INDEXED-REPOSITION.

    RETURN "OK":U.
END PROCEDURE.

