&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getDescByCod DBOProgram 
PROCEDURE getDescByCod :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEF INPUT  PARAM pi-cdn-tip-carroc LIKE tip-carroc.cdn-tip-carroc NO-UNDO.
    DEF OUTPUT PARAM pc-des-tip-carroc LIKE tip-carroc.des-tip-carroc NO-UNDO.

    FIND FIRST tip-carroc WHERE tip-carroc.cdn-tip-carroc = pi-cdn-tip-carroc NO-LOCK NO-ERROR.
    IF AVAIL tip-carroc THEN
        ASSIGN pc-des-tip-carroc = tip-carroc.des-tip-carroc.
    ELSE 
        ASSIGN pc-des-tip-carroc = "".

    RETURN "OK":U.

END PROCEDURE.

