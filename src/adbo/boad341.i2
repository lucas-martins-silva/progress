def temp-table tt_integr_apb_impto_impl_pend no-undo
    &IF {&ROWID_READY} = YES &THEN
        field ttv_rec_integr_apb_item_lote     as rowid
        field ttv_rec_antecip_pef_pend         as rowid
    &ELSE
        field ttv_rec_integr_apb_item_lote     as recid format ">>>>>>9"
        field ttv_rec_antecip_pef_pend         as recid format ">>>>>>9"
    &ENDIF
    field tta_cod_pais                     as character format "x(3)"
    field tta_cod_unid_federac             as character format "x(3)"
    field tta_cod_imposto                  as character format "x(5)"
    field tta_cod_classif_impto            as character format "x(05)" initial "00000"
    field tta_ind_clas_impto               as character format "X(14)" initial "Retido"
    field tta_cod_plano_cta_ctbl           as character format "x(8)"
    field tta_cod_cta_ctbl                 as character format "x(20)"
    field tta_cod_espec_docto              as character format "x(3)"
    field tta_cod_ser_docto                as character format "x(3)"
    field tta_cod_tit_ap                   as character format "x(10)"
    field tta_cod_parcela                  as character format "x(02)"
    field tta_val_rendto_tribut            as decimal format ">,>>>,>>>,>>9.99" decimals 2 initial 0
    field tta_val_deduc_inss               as decimal format ">,>>>,>>>,>>9.99" decimals 2 initial 0
    field tta_val_deduc_depend             as decimal format ">,>>>,>>>,>>9.99" decimals 2 initial 0
    field tta_val_deduc_pensao             as decimal format ">,>>>,>>>,>>9.99" decimals 2 initial 0
    field tta_val_outras_deduc_impto       as decimal format ">,>>>,>>>,>>9.99" decimals 2 initial 0
    field tta_val_base_liq_impto           as decimal format ">,>>>,>>>,>>9.99" decimals 2 initial 0
    field tta_val_aliq_impto               as decimal format ">9.99" decimals 2 initial 0.00
    field tta_val_impto_ja_recolhid        as decimal format ">,>>>,>>>,>>9.99" decimals 2 initial 0
    field tta_val_imposto                  as decimal format ">,>>>,>>>,>>9.99" decimals 2 initial 0
    field tta_dat_vencto_tit_ap            as date format "99/99/9999" initial today
    field tta_cod_indic_econ               as character format "x(8)"
    field tta_val_impto_indic_econ_impto   as decimal format "->>>,>>>,>>9.99" decimals 2 initial 0
    field tta_des_text_histor              as character format "x(2000)"
    field tta_cdn_fornec_favorec           as Integer format ">>>,>>>,>>9" initial 0
    field tta_val_deduc_faixa_impto        as decimal format ">,>>>,>>>,>>9.99" decimals 2 initial 0
    field tta_num_id_tit_ap                as integer format "9999999999" initial 0
    field tta_num_id_movto_tit_ap          as integer format "9999999999" initial 0
    field tta_num_id_movto_cta_corren      as integer format "9999999999" initial 0
    field tta_cod_pais_ext                 as character format "x(20)"
    field tta_cod_cta_ctbl_ext             as character format "x(20)"
    field tta_cod_sub_cta_ctbl_ext         as character format "x(15)"
    field ttv_cod_tip_fluxo_financ_ext     as character format "x(12)"
    index tt_impto_impl_pend_ap_integr     is primary unique
          ttv_rec_integr_apb_item_lote     ascending
          tta_cod_pais                     ascending
          tta_cod_unid_federac             ascending
          tta_cod_imposto                  ascending
          tta_cod_classif_impto            ascending
    index tt_impto_impl_pend_ap_integr_ant is unique
          ttv_rec_antecip_pef_pend         ascending
          tta_cod_pais                     ascending
          tta_cod_unid_federac             ascending
          tta_cod_imposto                  ascending
          tta_cod_classif_impto            ascending
    .

def temp-table tt_integr_cambio_ems5 no-undo
    &IF {&ROWID_READY} = YES &THEN
        field ttv_rec_table_child              as rowid
        field ttv_rec_table_parent             as rowid
    &ELSE
        field ttv_rec_table_child              as recid format ">>>>>>9"
        field ttv_rec_table_parent             as recid format ">>>>>>9"
    &ENDIF
    field ttv_cod_contrat_cambio           as character format "x(15)"
    field ttv_dat_contrat_cambio_import    as date format "99/99/9999"
    field ttv_num_contrat_id_cambio        as integer format "999999999"
    field ttv_cod_estab_contrat_cambio     as character format "x(3)"
    field ttv_cod_refer_contrat_cambio     as character format "x(10)"
    field ttv_dat_refer_contrat_cambio     as date format "99/99/9999"
    index tt_rec_index                     is primary unique
          ttv_rec_table_parent             ascending
          ttv_rec_table_child              ascending
    .

