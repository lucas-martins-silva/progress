{include/i_dbvers.i}
def temp-table tt_integr_apb_pagto no-undo
    field tta_cod_empresa                  as character format "x(3)"
    field tta_cod_estab_refer              as character format "x(3)" initial ?
    field tta_cod_refer                    as character format "x(10)"
    field tta_cod_estab_bord               as character format "x(3)"
    field tta_dat_transacao                as date format "99/99/9999" initial today
    field tta_cod_indic_econ               as character format "x(8)"
    field tta_val_tot_lote_pagto_efetd     as decimal format "->>,>>>,>>>,>>9.99" decimals 2 initial 0
    field tta_val_tot_lote_pagto_infor     as decimal format "->>,>>>,>>>,>>9.99" decimals 2 initial 0
    field tta_cdn_fornecedor               as Integer format ">>>,>>>,>>9" initial 0
    field tta_cdn_cliente                  as Integer format ">>>,>>>,>>9" initial 0
    field tta_cod_usuar_pagto              as character format "x(12)"
    field tta_log_enctro_cta               as logical format "Sim/NÆo" initial no
    field tta_val_tot_liquidac_tit_acr     as decimal format "->>,>>>,>>>,>>9.99" decimals 2 initial 0
    field tta_num_bord_ap                  as integer format ">>>>>9" initial 0
    field tta_cod_msg_inic                 as character format "x(2)"
    field tta_cod_msg_fim                  as character format "x(2)"
    field tta_log_bord_ap_escrit           as logical format "Sim/NÆo" initial no
    field tta_log_bord_ap_escrit_envdo     as logical format "Sim/NÆo" initial no
    field tta_ind_tip_bord_ap              as character format "X(17)" initial "Normal"
    field tta_cod_finalid_econ             as character format "x(10)"
    field tta_cod_cart_bcia                as character format "x(3)"
    field tta_cod_livre_1                  as character format "x(100)"
    field tta_cod_livre_2                  as character format "x(100)"
    field tta_dat_livre_1                  as date format "99/99/9999" initial ?
    field tta_dat_livre_2                  as date format "99/99/9999" initial ?
    field tta_log_livre_1                  as logical format "Sim/NÆo" initial no
    field tta_log_livre_2                  as logical format "Sim/NÆo" initial no
    field tta_num_livre_1                  as integer format ">>>>>9" initial 0
    field tta_num_livre_2                  as integer format ">>>>>9" initial 0
    field tta_val_livre_1                  as decimal format ">>>,>>>,>>9.9999" decimals 4 initial 0
    field tta_val_livre_2                  as decimal format ">>>,>>>,>>9.9999" decimals 4 initial 0
    field ttv_log_atualiz_refer            as logical format "Sim/NÆo" initial no
    field ttv_log_gera_lote_parcial        as logical format "Sim/NÆo" initial no
    field ttv_ind_tip_atualiz              as character format "X(08)"
    field tta_cod_portador                 as character format "x(5)"
    &IF {&ROWID_READY} = YES &THEN
        field ttv_rec_table_parent             as rowid
    &ELSE
        field ttv_rec_table_parent             as recid format ">>>>>>9"
    &ENDIF
    field tta_cod_estab_ext                as character format "x(8)"
    field tta_cod_portad_ext               as character format "x(8)"
    field tta_cod_modalid_ext              as character format "x(8)"
    field tta_cod_finalid_econ_ext         as character format "x(8)"
    index tt_rec_index                     is primary unique
          ttv_rec_table_parent             ascending
    .

