    field tta_val_pagto_inic               as decimal format "->>>,>>>,>>9.99" decimals 2 initial 0
    field tta_val_desc_tit_ap_inic         as decimal format "->>>,>>>,>>9.99" decimals 2 initial 0
    field tta_val_pagto_orig_inic          as decimal format "->>>,>>>,>>9.99" decimals 2 initial 0
    field tta_val_desc_tit_ap_orig_inic    as decimal format "->>>,>>>,>>9.99" decimals 2 initial 0
    field tta_cod_docto_bco_pagto          as character format "x(20)"
    field tta_ind_sit_item_bord_ap         as character format "X(9)"
    field tta_log_critic_atualiz_ok        as logical format "Sim/NÆo" initial no
    field tta_cod_estab_cheq               as character format "x(3)"
    field tta_num_seq_item_cheq            as integer format ">>>9" initial 0
    field tta_cod_finalid_econ             as character format "x(10)"
    field tta_num_talon_cheq               as integer format ">>>,>>>,>>9" initial 0
    field tta_num_cheque                   as integer format ">>>>,>>>,>>9" initial ?
    field tta_ind_favorec_cheq             as character format "X(15)" initial "Portador"
    field tta_nom_favorec_cheq             as character format "x(40)"
    field tta_cod_indic_econ               as character format "x(8)"
    field tta_val_variac_cambial           as decimal format "->>>,>>>,>>9.99" decimals 2 initial 0
    field tta_ind_sit_item_lote_bxa_ap     as character format "X(9)" initial "Gerado"
    field tta_cod_cart_bcia                as character format "x(3)"
    field tta_cod_livre_1                  as character format "x(100)"
    field tta_cod_livre_2                  as character format "x(100)"
    field tta_dat_livre_1                  as date format "99/99/9999" initial ?
    field tta_dat_livre_2                  as date format "99/99/9999" initial ?
    field tta_num_livre_1                  as integer format ">>>>>9" initial 0
    field tta_num_livre_2                  as integer format ">>>>>9" initial 0
    field tta_val_livre_1                  as decimal format ">>>,>>>,>>9.9999" decimals 4 initial 0
    field tta_val_livre_2                  as decimal format ">>>,>>>,>>9.9999" decimals 4 initial 0
    field tta_log_livre_1                  as logical format "Sim/NÆo" initial no
    field tta_log_livre_2                  as logical format "Sim/NÆo" initial no
    field ttv_ind_forma_pagto              as character format "X(18)" initial "Assume do T¡tulo":U
    &IF {&ROWID_READY} = YES &THEN
        field ttv_rec_table_child              as rowid
        field ttv_rec_table_parent             as rowid
    &ELSE
        field ttv_rec_table_child              as recid format ">>>>>>9"
        field ttv_rec_table_parent             as recid format ">>>>>>9"
    &ENDIF
    field tta_cod_portad_ext               as character format "x(8)"
    field tta_cod_modalid_ext              as character format "x(8)"
    field tta_cod_finalid_econ_ext         as character format "x(8)"
    index tt_rec_index                     is primary unique
          ttv_rec_table_parent             ascending
          ttv_rec_table_child              ascending
    .

