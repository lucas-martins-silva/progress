&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.000
&scoped-define FIRST-TABLE-IN-QUERY tt-mov-ap
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME tt-mov-ap

{cdp/cdcfgmat.i} /* Integra‡Æo Importacao */

{include/boini.i}
{adbo/boad180f.i RowObject}
{adbo/boad180f.i tt-mov-ap}

DEFINE BUFFER b-mov-ap for tt-mov-ap.
DEFINE BUFFER b-mov-ap-aux for mov-ap.

def temp-table tt-mov-ap-aux
    field data   like mov-ap.dt-trans
    field itrans  as   integer
    field antec  as   logical
    field r-rowid  as   rowid.
    
DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

/********************************** Defini‡Æo de vari veis *******************************************/    

DEFINE VARIABLE i-ep-codigo    like tit-ap.ep-codigo   no-undo.
DEFINE VARIABLE c-cod-estabel  like tit-ap.cod-estabel no-undo.
DEFINE VARIABLE c-cod-esp      like tit-ap.cod-esp     no-undo.
DEFINE VARIABLE c-serie        like tit-ap.serie       no-undo.
DEFINE VARIABLE c-nr-docto     like tit-ap.nr-docto    no-undo.
DEFINE VARIABLE i-parcela      like tit-ap.parcela     no-undo.
DEFINE VARIABLE i-cod-fornec   like tit-ap.cod-fornec  no-undo.
def    var      c-lanc         as char format "x(01)"  no-undo.
def    var      c-tipo-tit-ap  as char                 no-undo.
def    var      i-tipo-tit-ap  as int                  no-undo.

/********************************** Fim Defini‡Æo de vari veis ***************************************/    
procedure setConstraint1:

end procedure. 

procedure setConstraint2:
  /*
    Recebe o Rowid do tit-ap para que possa achar todos os movimentos referentes ao titulo
    Parametros:
    rpar1 : p-rowid :rowid do titulo 
  */

   def input parameter p-rowid as rowid no-undo.
   
   find tit-ap where rowid(tit-ap) = p-rowid
 	no-lock no-error.
   if avail tit-ap then do:
     assign  i-ep-codigo    = tit-ap.ep-codigo   
             c-cod-estabel  = tit-ap.cod-estabel
             c-cod-esp      = tit-ap.cod-esp    
             c-serie        = tit-ap.serie      
             c-nr-docto     = tit-ap.nr-docto   
             i-parcela      = tit-ap.parcela      
             i-cod-fornec   = tit-ap.cod-fornec
             &if defined(bf-mat-comex) &then
                c-tipo-tit-ap  = tit-ap.tipo.
             &else
                i-tipo-tit-ap  = tit-ap.tipo.
             &endif
   end.
   RUN carregaTable.
end procedure.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock INDEXED-REPOSITION.    
        when 2 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock INDEXED-REPOSITION.
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.
 
