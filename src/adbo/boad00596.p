&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getGrupoPOL DBOProgram 
PROCEDURE getGrupoPOL :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE INPUT  PARAMETER pcod-estab           LIKE param-integr-pol.cod-estab NO-UNDO.
    DEFINE output PARAMETER pdes-list-grp-clien  AS CHAR FORMAT "x(150)"         NO-UNDO.
    DEFINE output PARAMETER pdes-list-grp-fornec AS CHAR FORMAT "x(150)"         NO-UNDO.

    FIND FIRST bfparam-integr-pol WHERE 
        bfparam-integr-pol.cod-estab = pcod-estab NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF  NOT AVAILABLE bfparam-integr-pol THEN 
        RETURN "NOK":U.

    &IF DEFINED(BF_FIN_CLIEN_FORNEC_EAI2) &THEN
        ASSIGN pdes-list-grp-clien  = bfparam-integr-pol.des-list-grp-clien 
               pdes-list-grp-fornec = bfparam-integr-pol.des-list-grp-fornec.
    &ELSE
        ASSIGN pdes-list-grp-clien  = GetEntryField(1, bfparam-integr-pol.cod-livre-2, chr(10)) 
               pdes-list-grp-fornec = GetEntryField(2, bfparam-integr-pol.cod-livre-2, chr(10)).
    &ENDIF
    
    IF pdes-list-grp-clien = "" THEN
        ASSIGN pdes-list-grp-clien = "*".

    IF pdes-list-grp-fornec = "" THEN
        ASSIGN pdes-list-grp-fornec = "*".

    return "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

