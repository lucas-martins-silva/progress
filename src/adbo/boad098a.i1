/* 
   Defini‡Æo das vari veis
*/

def buffer b-emitente    for emitente.
def buffer b1-emitente   for emitente.
def var i-cont1          as integer initial 0                no-undo.
def var i-cont2          as integer initial 0                no-undo.
def var i-cont3          as integer initial 0                no-undo.
def var i-cont4          as integer initial 0                no-undo.
def var p6-vl-ap-abe-gp  as decimal initial 0                no-undo.
def var de-vl-ped        as decimal initial 0                no-undo.
def var de-vl-ped-gp     as decimal initial 0                no-undo.
def var l-vendor         as logical init   no                no-undo.
def var c-opcao-cha      as char                             no-undo.
def var rw-emitente      as rowid                            no-undo.
def var r-registro       as rowid                            no-undo.
def var de-saldo-ven     like titulo.vl-saldo                no-undo.
def var i-mo-codigo      like param-cr.mo-codigo             no-undo.
def var de-limite        like emitente.lim-credito           no-undo.
def var i-atraso-medio   as integer format ">>>>>>>9" init 0 no-undo.
def var de-lim-credito   as decimal format ">>>,>>>,>>9.99"  no-undo.
def var i-pagina         as integer                          no-undo.
def var r-ped-venda-g    as rowid                            no-undo.
