&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE beforeCreateRecord DBOProgram 
PROCEDURE beforeCreateRecord :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

   DEFINE VARIABLE i-seq LIKE ext-emitente-mais-negoc.cdd-seq-emit-mais-negoc NO-UNDO.

   blk-1:
   REPEAT: 
       ASSIGN i-seq = NEXT-VALUE(seq-ext-emitente-mais-negoc).
       IF NOT CAN-FIND(bf{&TableName}
                 WHERE bf{&TableName}.cdd-seq-emit-mais-negoc = i-seq) THEN
           LEAVE blk-1.
   END.

   ASSIGN RowObject.cdd-seq-emit-mais-negoc = i-seq.

END PROCEDURE.

