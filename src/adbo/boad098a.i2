/* Defini‡Æo da temp-table de estatistica geral cliente */
def temp-table tt-estat-geral no-undo
   field de-lim-credito  as decimal 
   field de-lim-cred-gp  as decimal 
   field d-moeda         as int
   field de-totvlap      as decimal 
   field de-totvlap-gp   as decimal 
   field i-totpdap       as int            
   field de-totvlre      as decimal 
   field de-totvlre-gp   as decimal 
   field i-totpdre       as int 
   field de-totvlaa      as decimal 
   field de-totvlaa-gp   as decimal 
   field i-totpdaa       as int
   field de-vl-nota      as decimal 
   field de-vl-nota-gp   as decimal 
   field i-totpdcr       as int 
   field de-saldo-cr     as decimal 
   field de-saldo-cr-gp  as decimal  
   field p5-vl-cr-abe    as decimal 
   field de-saldo-ap     as decimal 
   field de-saldo-ap-gp  as decimal  
   field p6-vl-ap-abe    as decimal 
   field c-sinal         as char          
   field de-saldo        as decimal 
   field de-saldo-gp     as decimal.            

/* Defini‡Æo da temp-table de estat¡stica geral grupo cliente */
