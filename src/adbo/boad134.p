DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

def var i-cod-emitente   like emitente.cod-emitente no-undo.
def var dt-his-emit-ini  like his-emit.dt-his-emit  no-undo.
def var dt-his-emit-fim  like his-emit.dt-his-emit  no-undo.

procedure setConstraint1:
end procedure.

procedure setConstraint2:
     /*****  Entrada de dados p/ abertura de query usada p/ Emitente *******/
     def input parameter p-cod-emitente    like emitente.cod-emitente no-undo.
     def input parameter p-dt-his-emit-ini like his-emit.dt-his-emit  no-undo.     
     def input parameter p-dt-his-emit-fim like his-emit.dt-his-emit  no-undo.
     
     assign i-cod-emitente  = p-cod-emitente
            dt-his-emit-ini = p-dt-his-emit-ini
            dt-his-emit-fim = p-dt-his-emit-fim.
end procedure.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock INDEXED-REPOSITION.
        when 2 then do:
            if dt-his-emit-ini = dt-his-emit-fim then
               open query {&QUERY-NAME} for each {&TABLE-NAME} 
                                           where {&TABLE-NAME}.cod-emitente = i-cod-emitente  and
                                                 {&TABLE-NAME}.dt-his-emit  = dt-his-emit-ini no-lock INDEXED-REPOSITION. 
            else
               open query {&QUERY-NAME} for each {&TABLE-NAME} 
                                           where {&TABLE-NAME}.cod-emitente  = i-cod-emitente  and
                                                 {&TABLE-NAME}.dt-his-emit  >= dt-his-emit-ini and
                                                 {&TABLE-NAME}.dt-his-emit  <= dt-his-emit-fim no-lock INDEXED-REPOSITION. 
        end.                                      
    end case.
    assign l-query = true
           i-bo-query = i-abertura.
end procedure.
 
