**  Ultima altera‡Æo : 08/03/2000 - brv13084
*/

procedure findCodigo:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter i-cod-emitente as inte no-undo.
    def output parameter c-return as char no-undo.
 
    find emitente where
        emitente.cod-emitente = i-cod-emitente
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:    
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
        {utp/ut-table.i mgadm emitente 1}
        /****************************************************************************/    
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.

procedure findNome:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter c-nome-abrev as char no-undo.
    def output parameter c-return as char no-undo.
 
    find emitente where
        emitente.nome-abrev = c-nome-abrev
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        {utp/ut-table.i mgadm emitente 1}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.

procedure findCGC:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter c-cgc as CHAR no-undo.
    def output parameter c-return as char no-undo.
 
    find emitente where
        emitente.cgc = c-cgc
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:    
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
        {utp/ut-table.i mgadm emitente 1}
        /****************************************************************************/    
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.
