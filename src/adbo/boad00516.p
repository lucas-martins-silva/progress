&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram  
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice cadbalan_id2
  Parameters:  
               recebe valor do campo cod-balanca
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-balanca LIKE cad-balan.cod-balanca NO-UNDO.

    FIND FIRST bfcad-balan WHERE 
        bfcad-balan.cod-balanca = pcod-balanca NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfcad-balan THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfcad-balan)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

