&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.

    IF pType = "Create" THEN DO:

        IF CAN-FIND(FIRST bf{&TableName}  WHERE                                        
                          bf{&TableName}.cod-balanca = RowObject.cod-balanca) THEN DO: 
                                                                                       
            /* J† existe ocorrància do registro */                                     
            {utp/ut-liter.i "Balanáa" *}                                           
            {method/svc/errors/inserr.i &ErrorNumber="1"                               
                                        &ErrorType="EMS":U                             
                                        &ErrorSubType="ERROR":U                        
                                        &ErrorParameters="return-value"}               
        END.      

        IF RowObject.cod-balanca = "" THEN DO:
                                                                                                               
            {utp/ut-liter.i "C¢digo_da_Balanáa" *}                                          
            {method/svc/errors/inserr.i &ErrorNumber="164"                          
                                        &ErrorType="EMS":U                        
                                        &ErrorSubType="ERROR":U                   
                                        &ErrorParameters="return-value"}          
        END.       

        IF RowObject.nome-balanca = "" THEN DO:                           
                                                                                                               
            {method/svc/errors/inserr.i &ErrorNumber="190"               
                                        &ErrorType="EMS":U               
                                        &ErrorSubType="ERROR":U} 
        END.                                                             
    END.

    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

