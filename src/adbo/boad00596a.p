&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    DEF VAR c-liter AS CHAR NO-UNDO.

    IF  pType = "Create":U THEN DO:
        IF  CAN-FIND(FIRST bf{&TableName} 
                     WHERE bf{&tablename}.cod-localid = RowObject.cod-localid) THEN DO:
            {utp/ut-liter.i "Localidade" *}
            {method/svc/errors/inserr.i &ErrorNumber="4242" 
                                        &ErrorType="EMS"
                                        &ErrorParameters="RETURN-VALUE"}
        END. 
    END.

    IF  pType = "Create":U OR pType = "Update":U THEN DO:
        IF  RowObject.cod-localid = "" THEN DO:
            {utp/ut-liter.i "Localidade" *}
            {method/svc/errors/inserr.i &ErrorNumber="17677" 
                                        &ErrorType="EMS"
                                        &ErrorParameters="RETURN-VALUE"}
        END.

        IF  RowObject.nom-localid = "" THEN DO:
            {utp/ut-liter.i "Nome_Localidade" *}
            {method/svc/errors/inserr.i &ErrorNumber="17677" 
                                        &ErrorType="EMS"
                                        &ErrorParameters="RETURN-VALUE"}
        END.

        IF  RowObject.cod-fisc = "" THEN DO:
            {utp/ut-liter.i "C¢digo_Fiscal" *}
            {method/svc/errors/inserr.i &ErrorNumber="17677" 
                                        &ErrorType="EMS"
                                        &ErrorParameters="RETURN-VALUE"}
        END.
    END.

    IF  pType = "DELETE":U THEN DO:
        IF CAN-FIND (FIRST internac-transp-cp
                     WHERE internac-transp-cp.cod-localid = RowObject.cod-localid) THEN DO:
            {utp/ut-liter.i "Localidade" *} ASSIGN c-liter = TRIM(RETURN-VALUE).
            {utp/ut-liter.i "Localidade_Carta_Porte" *}
            ASSIGN c-liter = c-liter + "~~" + TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                         &ErrorNumber="5906"
                         &ErrorType="EMS"
                         &ErrorSubType="ERROR"
                         &ErrorParameters="c-liter"} 
        END.
    END.
    
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

