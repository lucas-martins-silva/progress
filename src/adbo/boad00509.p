&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/

    {utp/ut-liter.i Tipo_Ve°culo_Transporte * L}
    ASSIGN c-label-tabela = RETURN-VALUE.
    
    IF pType = "Create":U THEN DO:
        IF CAN-FIND(FIRST tip-veic-transp 
                    WHERE tip-veic-transp.cdn-tip-veic = rowObject.cdn-tip-veic) THEN DO:
            {utp/ut-liter.i Tipo_Ve≠culo *}            
            {method/svc/errors/inserr.i
                      &ErrorNumber="7"
                      &ErrorType="EMS"
                      &ErrorParameters="return-value"} 
                      
             RETURN "NOK":U.

        END.  
    END.    

    IF pType = "Create":U OR pType = "Update":U THEN DO:
        IF rowObject.des-tip-veic = ""                 
        OR rowObject.des-tip-veic = ? THEN DO:         
           {utp/ut-liter.i Descriá∆o *}                
           {method/svc/errors/inserr.i                 
                       &ErrorNumber="53947"            
                       &ErrorType="EMS"                
                       &ErrorParameters="return-value"}
        END.   
    END.  

    IF pType = "Delete" THEN DO:

        if  not available(param-global) then
            find first param-global no-lock no-error.

        IF AVAIL param-global AND substring(param-global.char-2,101,1) = "S" THEN DO: 
        
            IF CAN-FIND(FIRST preco-frete-coleta WHERE preco-frete-coleta.cdn-tip-veic = RowObject.cdn-tip-veic) THEN DO:
    
                {utp/ut-liter.i Tabela_de_Preco_Frete_Coleta * L}
                ASSIGN c-label-relac = RETURN-VALUE.
    
                {method/svc/errors/inserr.i &ErrorNumber="5"
                                            &ErrorType="EMS":U
                                            &ErrorSubType="ERROR":U
                                            &ErrorParameters=" c-label-tabela + '~~~~' + c-label-relac"}
            END.
        
        END.
        
    END.

    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

