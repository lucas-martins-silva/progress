PROCEDURE getDescByCod :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEF INPUT  PARAM pi-cdn-tip-veic LIKE tip-veic-transp.cdn-tip-veic NO-UNDO.
    DEF OUTPUT PARAM pc-des-tip-veic LIKE tip-veic-transp.des-tip-veic NO-UNDO.

    FIND FIRST tip-veic-transp WHERE tip-veic-transp.cdn-tip-veic = pi-cdn-tip-veic NO-LOCK NO-ERROR.
    IF AVAIL tip-veic-transp THEN
        ASSIGN pc-des-tip-veic = tip-veic-transp.des-tip-veic.
    ELSE 
        ASSIGN pc-des-tip-veic = "".

    RETURN "OK":U.


END PROCEDURE.

