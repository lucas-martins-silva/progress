
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE ChaveNfeFisico DBOProgram 
PROCEDURE ChaveNfeFisico:
    DEFINE INPUT PARAM pRowidDoctoFisico AS ROWID NO-UNDO.
    DEFINE OUTPUT PARAMETER pChAcessoCompNfe     LIKE  doc-orig-nfe.ch-acesso-comp-nfe      NO-UNDO.

    IF pRowidDoctoFisico <> ? THEN
    FIND FIRST doc-fisico NO-LOCK
         WHERE ROWID(doc-fisico) = pRowidDoctoFisico NO-ERROR.
    IF AVAIL doc-fisico THEN DO:
       ASSIGN rowObject.dt-emissao =  doc-fisico.dt-emissao.
       IF doc-fisico.cod-chave-aces-nf-eletro <> "" THEN 
           ASSIGN pChAcessoCompNfe = doc-fisico.cod-chave-aces-nf-eletro.
       ELSE DO: 
           FOR FIRST doc-orig-nfe FIELDS(ch-acesso-comp-nfe)                                                    
               WHERE doc-orig-nfe.idi-situacao  = 7  /* Atualizada Receb. Fisico */
               AND   doc-orig-nfe.idi-orig-trad = 2
               AND   doc-orig-nfe.cod-emitente  = doc-fisico.cod-emitente
               AND   doc-orig-nfe.cod-estabel   = doc-fisico.cod-estabel 
               AND   doc-orig-nfe.serie-docto   = doc-fisico.serie-docto 
               AND   doc-orig-nfe.nro-docto     = doc-fisico.nro-docto   
               AND   doc-orig-nfe.dt-emissao    = doc-fisico.dt-emissao NO-LOCK:
               ASSIGN pChAcessoCompNfe = doc-orig-nfe.ch-acesso-comp-nfe.
           END.
           IF NOT AVAIL doc-orig-nfe THEN DO:
              run retornaChaveAcesso (output pChAcessoCompNfe).
           END.
       END.
    END.
    ELSE DO:
          run retornaChaveAcesso (output pChAcessoCompNfe).
    END.
    
    
    RETURN "OK":U.

END PROCEDURE.
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validaPosicao35Chave DBOProgram 
PROCEDURE validaPosicao35Chave:
    DEFINE VARIABLE l-habilita-chave-nfe AS LOGICAL   NO-UNDO.

    if can-find(first funcao where funcao.cd-funcao = "spp-nfe":u and funcao.ativo = yes) then do:
            
            run VerificaOperacaoEmitenteNFE (input rowObject.nat-operacao,
                                             input rowObject.cod-emitente,
                                             input yes,
                                             output l-habilita-chave-nfe). 
    					                      
            if l-habilita-chave-nfe and substring(rowObject.cod-chave-aces-nf-eletro,35,1) = "0" then do:
    
                {method/svc/errors/inserr.i &ErrorNumber="54691"
                                            &ErrorType="EMS":U
                                            &ErrorSubType="ERROR":U}     
            end.
        end.
    RETURN "OK":U.

END PROCEDURE.
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE retornaChaveAcesso DBOProgram 
PROCEDURE retornaChaveAcesso:
    DEFINE OUTPUT PARAMETER pChaveNfe  LIKE docum-est.cod-chave-aces-nf-eletro  NO-UNDO.

    DEFINE VARIABLE i-chave-uf      AS INTEGER     NO-UNDO.
    DEFINE VARIABLE c-chave-modelo  AS CHARACTER   NO-UNDO.
    DEFINE VARIABLE c-chave-serie   LIKE docum-est.serie-docto NO-UNDO.
    DEFINE VARIABLE c-chave-cgc     AS CHARACTER FORMAT 'x(14)'  NO-UNDO.
    DEFINE VARIABLE h-boad098       AS HANDLE      NO-UNDO.
    DEFINE VARIABLE c-return        AS CHARACTER   NO-UNDO.
    DEFINE VARIABLE i-natureza      AS INTEGER     NO-UNDO.
    DEFINE VARIABLE i-diferenca     AS INTEGER     NO-UNDO.

     RUN defaultChaveAcessoNfe (input rowObject.cod-emitente,
                                input rowObject.nat-operacao,
                                output i-chave-uf,
                                output c-chave-modelo).

     ASSIGN c-chave-serie = rowObject.serie-docto.
     RUN rep/re1001a-1.p (INPUT-OUTPUT c-chave-serie).
    
     if c-chave-serie = "" then
        assign c-chave-serie = "000".
     else do:
         if length(c-chave-serie) < 3 then do:
             assign c-chave-serie = if length(c-chave-serie) = 1 then
                                      "00" + c-chave-serie
                                  else "0" + c-chave-serie.
         end.
         else
             if length(c-chave-serie) > 3 then
                assign c-chave-serie = substring(c-chave-serie,1,3).
     end.
     FIND FIRST bf-emitente NO-LOCK
          WHERE bf-emitente.cod-emitente = rowObject.cod-emitente NO-ERROR.
     IF NOT AVAIL emitente THEN RETURN "NOK":U.
     ASSIGN c-chave-cgc = replace(replace(bf-emitente.cgc,".",""),"/","").

     /*************COMPLETAR COM ZERO AS ESQUERDA QUANDO PESSOA FISICA***************************/
      IF NOT VALID-HANDLE(h-boad098) THEN DO:
          RUN adbo/boad098.p PERSISTENT SET h-boad098.
                      
          RUN findCodigo      IN h-boad098 (INPUT  rowObject.cod-emitente,
                                            OUTPUT c-return).
          IF c-return = "" THEN DO:
              RUN getIntField IN h-boad098 (INPUT  "natureza",
                                            OUTPUT i-natureza).
              IF i-natureza = 1 THEN DO:
                  
                  IF LENGTH(c-chave-cgc) < 14 THEN
                      ASSIGN i-diferenca = 14 - LENGTH(c-chave-cgc)
                             c-chave-cgc = FILL("0",i-diferenca) + c-chave-cgc.
              END.
          END.
      END.
     /*******************************************************************************************/

     ASSIGN pChaveNfe = string(i-chave-uf,"99") + 
                        (substr(string(year(rowObject.dt-emissao),"9999"),3,2)  +  string(month(rowObject.dt-emissao),"99")) +
                        c-chave-cgc +
                        c-chave-modelo + 
                        c-chave-serie + 
                        (if length(rowObject.nro-docto) < 9 THEN string(int(rowObject.nro-docto),"999999999") else substr(rowObject.nro-docto,1,9)).
                        
    RETURN "OK":U.
    
    FINALLY:
        DELETE PROCEDURE h-boad098.
        ASSIGN h-boad098 = ?.
    END FINALLY.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validaDigito DBOProgram 
PROCEDURE validaDigito :
/*------------------------------------------------------------------------------
  Purpose: Valida o D¡gito Verificador da chave de acesso.
           Compat¡vel com CNPJ num‚rico e alfanum‚rico.     
  Parameters:  pcChaveAcesso - recebe a chave de acesso
               pValida - retorna se deve validar ou nÆo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAM pChaveOriginal AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAM pValida        AS LOGICAL   NO-UNDO.

    DEFINE VARIABLE cChaveTratada   AS CHARACTER NO-UNDO.
    DEFINE VARIABLE cChaveSemDV     AS CHARACTER NO-UNDO.
    DEFINE VARIABLE iDVInformado    AS INTEGER   NO-UNDO.
    DEFINE VARIABLE iDVCalculado    AS INTEGER   NO-UNDO.

    DEFINE VARIABLE iPosicao        AS INTEGER   NO-UNDO.
    DEFINE VARIABLE iPeso           AS INTEGER   NO-UNDO.
    DEFINE VARIABLE iSoma           AS INTEGER   NO-UNDO.
    DEFINE VARIABLE iValorCaracter  AS INTEGER   NO-UNDO.
    DEFINE VARIABLE cCaractereChave AS CHARACTER NO-UNDO.
    
    ASSIGN cChaveTratada = ""
           cCaractereChave = "".

    DO iPosicao = 1 TO LENGTH(pChaveOriginal):

        ASSIGN cCaractereChave = CAPS(SUBSTRING(pChaveOriginal, iPosicao, 1)).

        /* Mant‚m apenas n£meros e letras A-Z */
        IF (cCaractereChave >= "0" AND cCaractereChave <= "9")
        OR (cCaractereChave >= "A" AND cCaractereChave <= "Z") THEN
            cChaveTratada = cChaveTratada + cCaractereChave.
    END.
    
    /* A chave de acesso v lida deve ter 44(NF-e, CT-e,etc) ou 50(NFSe Via) */
    IF  LENGTH(cChaveTratada) <> 44 
    AND LENGTH(cChaveTratada) <> 50 THEN DO:
        assign pValida = yes.
        RETURN.
    END.

    ASSIGN cChaveSemDV  = SUBSTRING(cChaveTratada,1,LENGTH(cChaveTratada) - 1)       
           iDVInformado = INTEGER(SUBSTRING(cChaveTratada,LENGTH(cChaveTratada), 1)).
         
    ASSIGN iPeso = 2
           iSoma = 0
           iValorCaracter = 0
           cCaractereChave = "".

    DO iPosicao = LENGTH(cChaveSemDV) TO 1 BY -1:

        ASSIGN cCaractereChave = SUBSTRING(cChaveSemDV, iPosicao, 1).
                    
        /* ConversÆo literal do padrÆo oficial (PADRÇO GOVERNO: ASCII - 48) */
        ASSIGN iValorCaracter = ASC(cCaractereChave) - 48.
   
        ASSIGN iSoma = iSoma + (iValorCaracter * iPeso)
               iPeso = iPeso + 1.

        IF iPeso > 9 THEN
           assign iPeso = 2.
    END.

    ASSIGN iDVCalculado = 11 - (iSoma MODULO 11).
     
      
    IF iDVCalculado >= 10 THEN
       assign iDVCalculado = 0.
     
    ASSIGN pValida = NOT (iDVCalculado = iDVInformado).

    RETURN "OK":U.
END PROCEDURE.
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
