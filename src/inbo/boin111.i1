
/*****************************************************************************
** Procedure Interna.....: pi-alterou-nmb
** Descricao.............: Altera‡Æo de n¡vel mais baixo de estrutura
*****************************************************************************/
PROCEDURE pi-alterou-nmb:
 
    /************************ Parameter Definition Begin ************************/
    def input param p-rw-item as rowid no-undo.
    def input param p-it-codigo as char no-undo.
    def buffer b2-item for item.
    def buffer b3-item for item.                   
    def buffer b-estrutura for estrutura.
    def buffer b-alternativo for alternativo.
    define var rw-b3-item as rowid.
    
    define buffer b-modelo-cf for modelo-cf.
    define buffer b-estr-mod-cf for estr-mod-cf.
        
    /************************ Procedure Begin ************************/
    find B2-item 
       where rowid(b2-item) = p-rw-item 
       no-lock no-error.
    for each B-estrutura 
       where b-estrutura.it-codigo = B2-item.it-codigo no-lock:
        /*** Teste de loop de estrutura ***/
        if b-estrutura.es-codigo = p-it-codigo then do: 
            return ('loop':U + '|' + b-estrutura.it-codigo).             
        end.   
        find B3-item 
            where B3-item.it-codigo = b-estrutura.es-codigo exclusive-lock no-error. 
        if  avail b3-item then do:
            if B3-item.niv-mais-bai <= B2-item.niv-mais-bai then do:
                /*** Teste de n¡veis de estrutura ***/
                if B2-item.niv-mais-bai > 29 then do:
                    return ('nv30').
                end.                     
                assign B3-item.niv-mais-bai = B2-item.niv-mais-bai + 1
                       rw-b3-item           = rowid(B3-item).
                
                &if defined(bf_mat_fech_estab) &then
                    /********************************************************
                    ** A partir da release 2.04 o nivel mais baixo passou  **
                    ** a ser replicado para a tabela 'item-estab' com o    **
                    ** intuito de melhorar a performance de execucao do    **
                    ** Calculo do Preco Medio                              **
                    ********************************************************/
                    for each item-estab where
                        item-estab.it-codigo = b3-item.it-codigo exclusive-lock:
                        assign item-estab.niv-mais-bai = b3-item.niv-mais-bai * -1.
                    end.
                &endif
                
                release B3-item.
                run pi-alterou-nmb(rw-b3-item, p-it-codigo).
                if return-value <> ('ok':U) then do:
                    assign c-erro = return-value.
                    stop.      
                end.   
            end.
        end.
        /*** Altera n¡vel mais baixo de itens alternativos ***/
        for each B-alternativo 
           where B-alternativo.es-codigo  = b-estrutura.es-codigo 
             and B-alternativo.it-codigo  = b-estrutura.it-codigo 
             and B-alternativo.sequencia  = b-estrutura.sequencia 
           no-lock:
            /*** Teste de loop de estrutura verificando alternativo ***/
            if b-alternativo.al-codigo = p-it-codigo then 
               return ('loop':U + '|' + b-alternativo.it-codigo).  
            find B3-item 
                where B3-item.it-codigo = B-alternativo.al-codigo exclusive-lock no-error. 
            if  avail b3-item then do:
                if B3-item.niv-mais-bai <= B2-item.niv-mais-bai then do:
                    /*** Teste de n¡veis de estrutura ***/
                    if B2-item.niv-mais-bai > 29 then do: 
                        return ('nv30').
                    end.                     
                    assign B3-item.niv-mais-bai = B2-item.niv-mais-bai + 1
                           rw-b3-item           = rowid(B3-item).

                    &if defined(bf_mat_fech_estab) &then
                        /********************************************************
                        ** A partir da release 2.04 o nivel mais baixo passou  **
                        ** a ser replicado para a tabela 'item-estab' com o    **
                        ** intuito de melhorar a performance de execucao do    **
                        ** Calculo do Preco Medio                              **
                        ********************************************************/
                        for each item-estab where
                            item-estab.it-codigo = b3-item.it-codigo exclusive-lock:
                            assign item-estab.niv-mais-bai = b3-item.niv-mais-bai * -1.
                        end.
                    &endif
                           
                    release B3-item.
                    run pi-alterou-nmb(rw-b3-item, p-it-codigo).
                    if return-value <> ('ok':U) then do: 
                        assign c-erro = return-value.
                        stop.     
                    end.    
                end.  
            end.
        end.                
    end.    
    
    /*** C lculo de n¡vel mais baixo considerando os componentes do modelo-cf ***/
    find b-modelo-cf where
         b-modelo-cf.item-criado = B2-item.it-codigo no-lock no-error.
    if available b-modelo-cf then do:
         
        for each b-estr-mod-cf 
           where b-estr-mod-cf.mo-codigo = b-modelo-cf.mo-codigo no-lock:
           
            if b-estr-mod-cf.it-codigo = p-it-codigo then do: 
                return ('loop':U + '|' + b-modelo-cf.item-criado).             
            end.   
            
            find B3-item 
                where B3-item.it-codigo = b-estr-mod-cf.it-codigo exclusive-lock no-error. 
            if  avail b3-item and
                B3-item.niv-mais-bai <= B2-item.niv-mais-bai then do:
                
                /*** Teste de n¡veis de estrutura ***/
                if B2-item.niv-mais-bai > 29 then do:
                    return ('nv30').
                end.                     
                assign B3-item.niv-mais-bai = B2-item.niv-mais-bai + 1
                       rw-b3-item           = rowid(B3-item).

                &if defined(bf_mat_fech_estab) &then
                    /********************************************************
                    ** A partir da release 2.04 o nivel mais baixo passou  **
                    ** a ser replicado para a tabela 'item-estab' com o    **
                    ** intuito de melhorar a performance de execucao do    **
                    ** Calculo do Preco Medio                              **
                    ********************************************************/
                    for each item-estab where
                        item-estab.it-codigo = b3-item.it-codigo exclusive-lock:
                        assign item-estab.niv-mais-bai = b3-item.niv-mais-bai * -1.
                    end.
                &endif

                       
                release B3-item.
                run pi-alterou-nmb(rw-b3-item, p-it-codigo).
                if return-value <> ('ok':U) then do:
                    assign c-erro = return-value.
                    stop.      
                end.   
                
            end.
        end.
    
    end.
    
    return('ok':U).
 
END PROCEDURE. /* pi-alterou-nmb */   
