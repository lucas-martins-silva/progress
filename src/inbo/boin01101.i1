/***********************************************************************************
* Temp-tables utilizadas na boin01101.p e mla0170rp.p                              *
*                                                                                  *
* situacao: 'Mantido', 'Novo', 'Substitu¡do', 'Eliminado', 'Origem', 'Transferido' * 
* id-sit  :     1    ,    2  ,       3      ,       4    ,     5   ,       6       * 
* r-rowid : rowid do registro alterado,exclu¡do ou inserido.                       * 
***********************************************************************************/ 
DEFINE TEMP-TABLE tt-mla-conf-visual-usuar-origem NO-UNDO LIKE mla-configur-visual-usuar
    FIELD situacao AS CHAR FORMAT "x(20)"
    FIELD id-sit   AS INT
    FIELD r-rowid  AS ROWID
    INDEX codigo   cod-usuar
                   idi-interfac 
                   situacao.
                   
DEFINE TEMP-TABLE tt-mla-conf-visual-usuar-dest NO-UNDO LIKE tt-mla-conf-visual-usuar-origem.
