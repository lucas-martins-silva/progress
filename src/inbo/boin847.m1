/*------------------------------------------------------------------------------
  Purpose:     Reprocessa NF-e atrav‚s da REAPI316
  Parameters:  pr-nota -> ROWID nota a ser processada
               l-ok    -> Indica se o processamento da nota ocorreu com sucesso
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT  PARAMETER pr-nota        AS ROWID     NO-UNDO.
    DEFINE OUTPUT PARAMETER l-ok           AS LOGICAL   NO-UNDO.

    RUN verificaFiscalFisico(INPUT pr-nota).
    IF RETURN-VALUE = "NOK":U THEN DO:
        ASSIGN l-ok = NO.
        RETURN "NOK":U.
    END.
    
    define variable l-erro-saldo           as logical   no-undo.
    define variable l-saldo-ok             as logical   no-undo.
    DEFINE VARIABLE l-agregado             AS LOGICAL   NO-UNDO.
    DEFINE VARIABLE l-altera-dt-trans      AS LOGICAL   NO-UNDO.    
    DEFINE VARIABLE l-bloq-item-branco     AS LOGICAL   NO-UNDO.
    DEFINE VARIABLE l-existe-ret-benef     AS LOGICAL   NO-UNDO.
    DEFINE VARIABLE l-existe-mat-agreg     AS LOGICAL   NO-UNDO.
    DEFINE VARIABLE l-orig-ativo           AS LOGICAL   NO-UNDO.
    DEFINE VARIABLE c-conta                AS CHARACTER NO-UNDO.
    DEFINE VARIABLE c-sub-conta            AS CHARACTER NO-UNDO.
    DEFINE VARIABLE ch-acesso              AS CHARACTER NO-UNDO.
    DEFINE VARIABLE c-cnpj-destino         AS CHARACTER NO-UNDO.
    DEFINE VARIABLE c-lista-naturezas      AS CHARACTER NO-UNDO.
    DEFINE VARIABLE i-seq-aux              AS INTEGER   NO-UNDO.
    DEFINE VARIABLE i-cont-cfop            AS INTEGER   NO-UNDO.
    DEFINE VARIABLE de-val-frete-docto     AS DECIMAL   NO-UNDO.
    DEFINE VARIABLE de-val-seguro-docto    AS DECIMAL   NO-UNDO.
    DEFINE VARIABLE de-val-outros-docto    AS DECIMAL   NO-UNDO.
    DEFINE VARIABLE de-val-frete-item      AS DECIMAL   NO-UNDO.
    DEFINE VARIABLE de-total-frete         AS DECIMAL   NO-UNDO. /* Totaliza o frete da nota. */
    DEFINE VARIABLE de-total-seguro        AS DECIMAL   NO-UNDO. /* Totaliza o seguro da nota. */
    DEFINE VARIABLE de-total-outros        AS DECIMAL   NO-UNDO. /* Totaliza as outras despesas da nota. */
    DEFINE VARIABLE de-valor-mercad        AS DECIMAL   NO-UNDO.
    DEFINE VARIABLE de-despesas-item       AS DECIMAL   NO-UNDO.
    DEFINE VARIABLE i-seq-item-maior-valor AS INTEGER   NO-UNDO.
    DEFINE VARIABLE de-maior-valor-item    AS DECIMAL   NO-UNDO.
    DEFINE VARIABLE l-desaloca             AS LOGICAL   NO-UNDO.
    DEFINE VARIABLE i-cont-prog            AS INTEGER   NO-UNDO.
    DEFINE VARIABLE l-re0708               AS LOGICAL   NO-UNDO.
    DEFINE VARIABLE lGeradoViaOriginacao   AS LOGICAL   NO-UNDO.
    DEFINE VARIABLE h-acomp                AS HANDLE    NO-UNDO.
    DEFINE VARIABLE de-total-fifo          AS DECIMAL   NO-UNDO. /* Totaliza quantidade selecionada por FIFO para o item.       */
    DEFINE VARIABLE de-total-fifo-emit     AS DECIMAL   NO-UNDO. /* Totaliza quantidade selecionada por FIFO na UN do emitente. */
    DEFINE VARIABLE de-total-desconto      AS DECIMAL   NO-UNDO. /* Totaliza o desconto selecionada por FIFO. */
    DEFINE VARIABLE de-soma-fifo           AS DECIMAL   NO-UNDO. /* Somatorio quantidades FIFO Manual.                          */
    DEFINE VARIABLE de-soma-fifo-emit      AS DECIMAL   NO-UNDO. /* Somatorio quantidades FIFO Manual na UN do emitente.        */
    DEFINE VARIABLE de-soma-outros-fifo    AS DECIMAL   NO-UNDO. /* Variavel utilizada no calculo dos valores do FIFO Manual.   */
    DEFINE VARIABLE de-soma-seguro-fifo    AS DECIMAL   NO-UNDO. /* Variavel utilizada no calculo dos valores do FIFO Manual.   */
    DEFINE VARIABLE de-soma-desconto-fifo  AS DECIMAL   NO-UNDO. /* Variavel utilizada no calculo dos valores do FIFO Manual.   */
    DEFINE VARIABLE de-soma-frete-fifo     AS DECIMAL   NO-UNDO. /* Variavel utilizada no calculo dos valores do FIFO Manual.   */
    DEFINE VARIABLE de-frete-unit          AS DECIMAL   NO-UNDO. /* Variavel utilizada no calculo dos valores do FIFO Manual.   */
    DEFINE VARIABLE de-outros-unit         AS DECIMAL   NO-UNDO. /* Variavel utilizada no calculo dos valores do FIFO Manual.   */
    DEFINE VARIABLE de-seguro-unit         AS DECIMAL   NO-UNDO. /* Variavel utilizada no calculo dos valores do FIFO Manual.   */
    DEFINE VARIABLE de-soma-total-outros   AS DECIMAL   NO-UNDO. /* Soma o total "Outros" de todas as naturezas do conversor.   */
    DEFINE VARIABLE de-soma-total-seguro   AS DECIMAL   NO-UNDO. /* Soma o total "Seguro" de todas as naturezas do conversor.   */
    DEFINE VARIABLE de-soma-total-frete    AS DECIMAL   NO-UNDO. /* Soma o total "Frete" de todas as naturezas do conversor.    */
    DEFINE VARIABLE de-soma-total-desconto AS DECIMAL   NO-UNDO. /* Soma o total "Desconto" de todas as naturezas do conversor. */
    DEFINE VARIABLE de-frete-item          AS DECIMAL   NO-UNDO. /* Armazena o frete do item corrente.        */
    DEFINE VARIABLE de-seguro-item         AS DECIMAL   NO-UNDO. /* Armazena o seguro do item corrente.       */
    DEFINE VARIABLE de-outros-item         AS DECIMAL   NO-UNDO. /* Armazena outros valores do item corrente. */
    DEFINE VARIABLE de-despesa-item        AS DECIMAL   NO-UNDO. /* Armazena as despesas do item corrente.    */
    DEFINE VARIABLE de-desconto-item       AS DECIMAL   NO-UNDO. /* Armazena o desconto do item corrente.    */
    DEFINE VARIABLE de-desconto-unit       AS DECIMAL   NO-UNDO.    
    DEFINE VARIABLE d-aliq-pis             AS DECIMAL   NO-UNDO.
    DEFINE VARIABLE d-aliq-cofins          AS DECIMAL   NO-UNDO.
    DEFINE VARIABLE p-aliq-st              AS DECIMAL   NO-UNDO.
    DEFINE VARIABLE de-vl-icm-prop-sta     AS DECIMAL   NO-UNDO.
    DEFINE VARIABLE l-frete-item           AS LOGICAL   NO-UNDO.  
    DEFINE VARIABLE l-vfrete-it            AS LOGICAL   NO-UNDO.  
    DEFINE VARIABLE l-seguro-item          AS LOGICAL   NO-UNDO.  
    DEFINE VARIABLE l-vseg-it              AS LOGICAL   NO-UNDO.  
    DEFINE VARIABLE l-outros-item          AS LOGICAL   NO-UNDO.  
    DEFINE VARIABLE l-voutro-it            AS LOGICAL   NO-UNDO.  
    DEFINE VARIABLE l-desconto-item        AS LOGICAL   NO-UNDO.    
    DEFINE VARIABLE l-sem-pedido           AS LOGICAL   NO-UNDO.
    DEFINE VARIABLE i-ctrl-quebra          AS INTEGER   NO-UNDO.
    DEFINE VARIABLE l-integra-ems-his      AS LOGICAL   NO-UNDO.
    DEFINE VARIABLE c-cod-depos            LIKE deposito.cod-depos          NO-UNDO.
    DEFINE VARIABLE c-cod-localiz          LIKE item.cod-localiz            NO-UNDO.
    DEFINE VARIABLE c-cod-refer            LIKE item.cod-refer              NO-UNDO.
    DEFINE VARIABLE c-cod-unid-negoc       LIKE ordem-compra.cod-unid-neg   NO-UNDO.
    DEFINE VARIABLE i-nr-ord-produ         LIKE item-doc-est.nr-ord-produ   NO-UNDO.
    DEFINE VARIABLE c-nat-oper-aux         LIKE natur-oper.nat-operacao     NO-UNDO.
    DEFINE VARIABLE vl-ct-codigo           LIKE item-doc-est.ct-codigo      NO-UNDO. 
    DEFINE VARIABLE vl-sc-codigo           LIKE item-doc-est.sc-codigo      NO-UNDO.
    DEFINE VARIABLE l-fifo-oc-docum        AS LOGICAL  INITIAL NO           NO-UNDO. /* Armazena se precisa fazer o FIFO para o documento */
    DEFINE VARIABLE l-erro-reapi316        AS LOGICAL  INITIAL NO           NO-UNDO. /* Erro na geracao do documento (reapi316) */
    DEFINE VARIABLE de-seq-item-ant        LIKE rat-lote-medic-nfe.seq-item NO-UNDO.
    DEFINE VARIABLE h-reapi412             AS HANDLE                        NO-UNDO.
    DEFINE VARIABLE h-reapi316b            AS HANDLE                        NO-UNDO.
    DEFINE VARIABLE lOpeTriang             AS LOGICAL  INITIAL NO           NO-UNDO.
    DEFINE VARIABLE c-natur-aux            AS CHARACTER                     NO-UNDO.
    DEFINE VARIABLE h-reapi434             AS HANDLE                        NO-UNDO.    
    DEFINE VARIABLE h-re1911               AS HANDLE                        NO-UNDO. 
    DEFINE VARIABLE c-liter-1              AS CHARACTER                     NO-UNDO.
    DEFINE VARIABLE c-liter-2              AS CHARACTER                     NO-UNDO.
    DEFINE VARIABLE c-liter-3              AS CHARACTER                     NO-UNDO.
    DEFINE VARIABLE l-itemimpmonitor       AS LOGICAL                       NO-UNDO.

    /***************************************************************
    ** Engenharia PIS/COFINS por Unidade de Produto Lei 10833 MAT **
    ***************************************************************/
    DEFINE VARIABLE de-valor-un-pis-devol    AS DECIMAL FORMAT ">>>9.99999" NO-UNDO.
    DEFINE VARIABLE de-valor-un-cofins-devol AS DECIMAL FORMAT ">>>9.99999" NO-UNDO.
    
    DEFINE BUFFER b-natur-oper-item    FOR natur-oper.
    DEFINE BUFFER bf-item-doc-est-tri  FOR item-doc-est.
    DEFINE BUFFER bf-item-doc-est-dev  FOR item-doc-est.
    DEFINE BUFFER bf-natur-oper-it-tri FOR natur-oper.

    EMPTY TEMP-TABLE tt-docum-est.
    EMPTY TEMP-TABLE tt-item-doc-est.
    EMPTY TEMP-TABLE tt-natureza.
    EMPTY TEMP-TABLE tt-dupli-apagar. 
    EMPTY TEMP-TABLE tt-erro. /* Evita duplica‡Æo do erro 5934 no browse de mensagens. */
    EMPTY TEMP-TABLE tt-relac-saldo.
    EMPTY TEMP-TABLE tt-despesas-item.
    EMPTY TEMP-TABLE tt-item-nf-adc.
    EMPTY TEMP-TABLE tt-ext-docum-est.

    IF NOT VALID-HANDLE(h-cdapi995) THEN
        RUN cdp/cdapi995.p PERSISTENT SET h-cdapi995.
    IF  NOT VALID-HANDLE(h-boin176) THEN
        RUN inbo/boin176.p PERSISTENT SET h-boin176.
    IF NOT VALID-HANDLE(h-boin01109) THEN
        RUN inbo/boin01109.p PERSISTENT SET h-boin01109.

    FIND FIRST param-global NO-LOCK NO-ERROR.
    IF  NOT AVAIL param-global THEN
        RETURN "NOK":U.

    /*-*-*-*-*-*-*-*-* Cria handles *-*-*-*-*-*-*-*-*/

    IF NOT VALID-HANDLE(h-boin857) /* -> BO item-doc-orig-nfe */
    OR h-boin857:TYPE      <> "PROCEDURE":U 
    OR h-boin857:FILE-NAME <> "inbo/boin857.p":U THEN
        RUN inbo/boin857.p PERSISTENT SET h-boin857.

    IF NOT VALID-HANDLE(h-boin404re) /* -> BO saldo-terc */
    OR h-boin404re:TYPE      <> "PROCEDURE":U 
    OR h-boin404re:FILE-NAME <> "inbo/boin404re.p":U THEN
        RUN inbo/boin404re.p PERSISTENT SET h-boin404re.
        
    IF NOT VALID-HANDLE(h-boin862) /* -> BO param-convrsr-nfe */
    OR h-boin862:TYPE      <> "PROCEDURE":U 
    OR h-boin862:FILE-NAME <> "inbo/boin862.p":U THEN
        RUN inbo/boin862.p PERSISTENT SET h-boin862.
    
    /*-*-*-*-*-*-* FIM -> Cria handles *-*-*-*-*-*-*/
    
    RUN openQueryStatic IN h-boin862 (INPUT "Main":U) NO-ERROR.
    RUN getFirst IN h-boin862.
    IF  RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.
    ELSE DO:
        RUN getLogField IN h-boin862 (INPUT "log-altera-dat-trans":U,         OUTPUT l-altera-dt-trans).
        RUN getLogField IN h-boin862 (INPUT "log-bloq-item-branco":U,         OUTPUT l-bloq-item-branco).
    END.   
    
    ASSIGN l-integra-ems-his = CAN-FIND (FIRST funcao
                                         WHERE funcao.cd-funcao = "spp-integra-ems-his":U
                                         AND   funcao.ativo     = yes).

    ASSIGN l-ok                 = YES
           l-saldo-ok           = YES
           i-seq-aux            = 0
           i-cont-cfop          = 0
           l-desaloca           = NO
           l-existe-ret-benef   = NO
           l-existe-mat-agreg   = NO
           lGeradoViaOriginacao = NO.

    
    /* Libera os registros para evitar erros com disponibilidade de algumas tabelas */
    RELEASE natur-oper.
    RELEASE componente.
    RELEASE saldo-terc.

    EMPTY TEMP-TABLE tt-rat-ordem-orig-nfe-aux.
    
    ASSIGN l-re0708 = NO.

    DO  i-cont-prog = 1 TO 5:
        IF  PROGRAM-NAME(i-cont-prog) MATCHES "*re0708*" THEN DO:
            ASSIGN l-re0708 = YES.
            LEAVE.
        END.
    END.

    /****** PONTO UPC COFCO *******/
    if  c-nom-prog-upc-mg97 <> "" then do:
       for each  tt-epc
           where tt-epc.cod-event = "inicioReprocessaNota":
           delete tt-epc.
       end.
        
       create tt-epc.
       assign tt-epc.cod-event     = "inicioReprocessaNota"
              tt-epc.cod-parameter = "doc-orig-nfe-rowid"
              tt-epc.val-parameter = string(pr-nota).
              
       create tt-epc.
       assign tt-epc.cod-event     = "inicioReprocessaNota"
              tt-epc.cod-parameter = "l-re0708"
              tt-epc.val-parameter = string(l-re0708).
        
       {include/i-epc201.i "inicioReprocessaNota"}
        
       for first tt-epc
           where tt-epc.cod-event     = "inicioReprocessaNota"
           and   tt-epc.cod-parameter = "erro":
           assign l-ok = no.
           return "NOK":U.
       end.
    end.
    /*****************************/

    blocoNota:
    FOR FIRST bf{&TableName} exclusive-lock
        WHERE ROWID(bf{&TableName}) = pr-nota:   
     
        /* Limpa as temp-tables de agregado e acabado.  */
        EMPTY TEMP-TABLE tt-movto-pend. 
        EMPTY TEMP-TABLE tt-movto-pend-aux.
	
        IF l-re0708 THEN DO:
            RUN utp/ut-acomp.p PERSISTENT SET h-acomp.
            {utp/ut-liter.i "Gerando_Informa‡äes_Nota_Fiscal..." *}
            RUN pi-inicializar IN h-acomp(RETURN-VALUE).
            {utp/ut-liter.i "Gerando_Informa‡äes_Documento..." *}
            RUN pi-acompanhar IN h-acomp(RETURN-VALUE).
            RUN pi-desabilita-cancela IN h-acomp.
        END.

        FOR FIRST estabelec FIELDS(ep-codigo)
            WHERE estabelec.cod-estabel = bf{&TableName}.cod-estabel NO-LOCK:
            ASSIGN i-empresa = estabelec.ep-codigo.
        END.

        FOR EACH bfmsg-ret-nfe NO-LOCK
            WHERE bfmsg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
            AND   bfmsg-ret-nfe.idi-orig-trad      = 2:
            
            FOR FIRST msg-ret-nfe EXCLUSIVE-LOCK
                WHERE msg-ret-nfe.seq-msg = bfmsg-ret-nfe.seq-msg:
                ASSIGN msg-ret-nfe.log-ativo = NO.
            END.
            RELEASE msg-ret-nfe.
        END.
        
        FOR FIRST param-re FIELDS (inc-seq seq-item-um esp-def-dup atu-erro sem-pedido)
            WHERE param-re.usuario = c-seg-usuario NO-LOCK:
        END.
        IF  NOT AVAIL param-re THEN DO:
            RUN implantaErro(INPUT bf{&TableName}.ch-acesso-comp-nfe, 
                             INPUT 2,
                             INPUT "O usu rio que est  gerando o documento (" + c-seg-usuario + ") nÆo possui cadastro no recebimento (RE0101)",
                             INPUT 0).
            ASSIGN l-ok = NO.
            RELEASE msg-ret-nfe.
            LEAVE blocoNota.
        END.
        
        /*Comparativo - Bloqueia gera‡Æo NF com divergˆncia*/
        RUN emptyRowErrors  IN h-boin01109.
        RUN bloqueiaEntradaNfeComDivergencia IN h-boin01109 (INPUT bf{&TableName}.ch-acesso-comp-nfe).
        RUN getRowErrors    IN h-boin01109 (OUTPUT TABLE RowErrors).
        IF can-find (first RowErrors
                     where RowErrors.ErrorType <> "INTERNAL":U) THEN DO:
        
           RUN rowErrorsToMsgRetNFe (bf{&TableName}.ch-acesso-comp-nfe, YES, INPUT TABLE RowErrors).
           ASSIGN l-ok = NO.
           LEAVE blocoNota.
        END.
        /***************************************************/
        IF  l-altera-dt-trans THEN DO: /*verifica parâmetro RE0119*/
            ASSIGN bf{&TableName}.dt-transacao = TODAY.            
        END.
       
        IF  bf{&TableName}.cnpj-destino <> "99999999000191" THEN
            ASSIGN c-cnpj-destino = bf{&TableName}.cnpj-destino.
        ELSE
            ASSIGN c-cnpj-destino = bf{&TableName}.cnpj.
            
        FIND FIRST estabelec NO-LOCK WHERE estabelec.cgc = c-cnpj-destino NO-ERROR.
        
        IF  NOT AVAIL estabelec THEN DO:
            CREATE msg-ret-nfe.
            ASSIGN msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                   msg-ret-nfe.idi-orig-trad      = 2
                   msg-ret-nfe.dt-msg             = TODAY
                   msg-ret-nfe.hr-msg             = STRING(TIME, "HH:MM:SS")
                   msg-ret-nfe.log-ativo          = YES
                   msg-ret-nfe.cd-msg             = 17567
                   msg-ret-nfe.texto-msg          = "NÆo existe estabelecimento para o CNPJ destino. A nota deve ser cancelada."
                   msg-ret-nfe.seq-msg            = NEXT-VALUE(seq-msg-ret-nfe)
                   l-ok                           = NO.
            release msg-ret-nfe.
            LEAVE blocoNota.
        END.
        ELSE DO:
            IF NOT CAN-FIND(FIRST estabelec
                            WHERE estabelec.cod-estabel = bf{&TableName}.cod-estabel
                            AND   (   (    c-cnpj-destino <> ?
                                       AND estabelec.cgc   = c-cnpj-destino)
                                   OR (    bf{&TableName}.cpf-destino <> ?
                                       AND estabelec.cgc  = bf{&TableName}.cpf-destino))) THEN DO:
                CREATE msg-ret-nfe.
                ASSIGN msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                       msg-ret-nfe.idi-orig-trad      = 2
                       msg-ret-nfe.dt-msg             = TODAY
                       msg-ret-nfe.hr-msg             = STRING(TIME, "HH:MM:SS")
                       msg-ret-nfe.log-ativo          = YES
                       msg-ret-nfe.cd-msg             = 17567
                       msg-ret-nfe.texto-msg          = "CGC do Estabelecimento difere do CNPJ/CPF de destino da nota."
                       msg-ret-nfe.seq-msg            = NEXT-VALUE(seq-msg-ret-nfe)
                       l-ok                           = NO.
                release msg-ret-nfe.
                leave blocoNota.
            END.
        END.
        
        if not can-find(first emitente 
                        where emitente.cod-emitente = bf{&TableName}.cod-emitente
                        and   (   (    bf{&TableName}.cnpj <> ?
                                   and emitente.cgc   = bf{&TableName}.cnpj)
                               or (    bf{&TableName}.cpf <> ?
                                   and emitente.cgc  = bf{&TableName}.cpf))) then do:

            create msg-ret-nfe.
            assign msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                   msg-ret-nfe.idi-orig-trad      = 2
                   msg-ret-nfe.dt-msg             = TODAY
                   msg-ret-nfe.hr-msg             = STRING(TIME, "HH:MM:SS")
                   msg-ret-nfe.log-ativo          = YES
                   msg-ret-nfe.cd-msg             = 17006
                   msg-ret-nfe.texto-msg          = "CGC do Emitente " + string(bf{&TableName}.cod-emitente) + " difere do CNPJ/CPF de origem da nota."
                   msg-ret-nfe.seq-msg            = NEXT-VALUE(seq-msg-ret-nfe)
                   l-ok                           = NO.
            release msg-ret-nfe.
            leave blocoNota.
        END.

        /* Fornecedor Emite Documento Eletronico */
        IF CAN-FIND(FIRST emitente 
                    WHERE emitente.cod-emitente = bf{&TableName}.cod-emitente
                      AND (NOT emitente.log-nf-eletro OR
                           NOT emitente.log-possui-nf-eletro)) THEN DO:
            FOR FIRST emitente EXCLUSIVE-LOCK
                WHERE emitente.cod-emitente = bf{&TableName}.cod-emitente:
                ASSIGN emitente.log-nf-eletro        = YES WHEN emitente.identific <> 2
                       emitente.log-possui-nf-eletro = YES WHEN emitente.identific <> 1.
            END.
            RELEASE emitente.
        END.

        ASSIGN ch-acesso     = bf{&TableName}.ch-acesso-comp-nfe
               desconto-item = NO.

        
        /** VERIFICA MAIS DE UMA NATUREZA DE OPERACAO **/
        FOR EACH item-doc-orig-nfe FIELDS (nat-operacao ch-acesso-comp-nfe seq-item preco-total vl-desconto vl-frete vl-outros vl-seguro)
            WHERE item-doc-orig-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
              AND item-doc-orig-nfe.idi-orig-trad      = 2 NO-LOCK:


            IF  item-doc-orig-nfe.nat-operacao = "" OR item-doc-orig-nfe.nat-operacao = ? THEN DO:
                RUN utp/ut-msgs.p (INPUT "msg":U,
                                   INPUT 2049, /* Natureza de opera‡Æo em branco */
                                   INPUT "").  /* HELP: Natureza de opera‡Æo deve ser informada. */
                CREATE msg-ret-nfe.
                ASSIGN msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                       msg-ret-nfe.idi-orig-trad      = 2
                       msg-ret-nfe.dt-msg             = TODAY
                       msg-ret-nfe.hr-msg             = STRING(TIME, "HH:MM:SS")
                       msg-ret-nfe.log-ativo          = YES
                       msg-ret-nfe.cd-msg             = 2049
                       msg-ret-nfe.texto-msg          = RETURN-VALUE
                       msg-ret-nfe.seq-msg            = NEXT-VALUE(seq-msg-ret-nfe)
                       l-ok                           = NO.
                RELEASE msg-ret-nfe.
                LEAVE blocoNota.
            END.
            
            IF  NOT CAN-FIND(FIRST tt-natureza WHERE tt-natureza.nat-operacao = item-doc-orig-nfe.nat-operacao) THEN DO:

                /* Se usa m£ltiplas naturezas no recebimento (re0103) */
                IF  l-mult-natur-receb THEN DO: /* Var def em cd9701.i */
                    /* Grava na tt-natureza todas as naturezas dos documentos … serem gerados.
                       O campo nat-oper-agrup grava as naturezas a serem utilizadas nas "capas" dos documentos (docum-est) - natureza principal. 
                       O campo nat-operacao   grava as naturezas fiscais que serÆo atribuidas aos itens do documento (item-doc-est) */
                    
                    FIND FIRST b-natur-oper-item WHERE b-natur-oper-item.nat-operacao = item-doc-orig-nfe.nat-operacao NO-ERROR.
                    ASSIGN c-nat-oper-aux = "".
            
                    /* Verifica se h  alguma natureza compat¡vel */
                    /* Valida todas as compatibilidades que as naturezas precisam ter, caso seja incompat¡vel, segue para a pr¢xima natureza */
                    FOR EACH tt-natureza NO-LOCK:
                        FIND FIRST natur-oper WHERE natur-oper.nat-operacao = tt-natureza.nat-oper-agrup NO-LOCK NO-ERROR.
                        
                        /* Verificar se o primeiro d¡gito do CFOP ‚ diferente, se for nÆo pode usar a natureza, pois sÆo opera‡äes diferentes */
                        IF  STRING(b-natur-oper-item.cod-cfop, "9") <> STRING(natur-oper.cod-cfop, "9") THEN NEXT.
                        
                        /* Opera‡Æo com terceiros */
                        IF  b-natur-oper-item.terceiros <> natur-oper.terceiros THEN NEXT.

                        /* Tipo de Opera‡Æo com terceiros */
                        IF  b-natur-oper-item.terceiros AND b-natur-oper-item.tp-oper-terc <> natur-oper.tp-oper-terc THEN NEXT.
                        
                        /* Opera‡Æo de transferˆncia */            
                        IF  b-natur-oper-item.transf <> natur-oper.transf THEN NEXT.
                        
                        /* Tipo compra */
                        IF  b-natur-oper-item.tipo-compra <> natur-oper.tipo-compra THEN NEXT.
                        
                        /* Opera‡Æo triangular - Valida‡Æo est  ocorrendo baseado na natureza do documento, portanto precisa quebrar */
                        IF  b-natur-oper-item.log-oper-triang <> natur-oper.log-oper-triang THEN NEXT.
                        
                        /* Natureza Drawback - Validar, pois conforme conversado com a equipe de Comex, continuaremos quebrando os documentos at‚ que seja feita adequa‡Æo no re1005 */
                        IF  b-natur-oper-item.log-natur-operac-draw <> natur-oper.log-natur-operac-draw THEN NEXT.
            
                        /* Passou por todas as valida‡äes, usa a mesma natureza agrupadora j  armazenada na tt-natureza */
                        ASSIGN c-nat-oper-aux = tt-natureza.nat-oper-agrup.

                        LEAVE.
                    END.
                    
                    CREATE tt-natureza.
                    ASSIGN tt-natureza.nat-operacao   = item-doc-orig-nfe.nat-operacao
                           tt-natureza.nat-oper-agrup = IF c-nat-oper-aux = "" THEN item-doc-orig-nfe.nat-operacao ELSE c-nat-oper-aux
                           i-cont-cfop                = i-cont-cfop + 1.
                END.
                ELSE DO:
                    CREATE tt-natureza.
                    ASSIGN tt-natureza.nat-operacao   = item-doc-orig-nfe.nat-operacao
                           tt-natureza.nat-oper-agrup = item-doc-orig-nfe.nat-operacao /* Se nÆo usa Mult.Naturezas grava a mesma natureza. */
                           i-cont-cfop                = i-cont-cfop + 1.
                END.
                
                FOR FIRST natur-oper 
                    WHERE natur-oper.nat-operacao = tt-natureza.nat-operacao NO-LOCK:
                    IF  natur-oper.cod-model-nf-eletro <> "55" 
                    AND natur-oper.cod-model-nf-eletro <> "65" THEN DO:
                        
                        RUN utp/ut-msgs.p (INPUT "msg":U,
                                           INPUT 55197, /* Natureza de operacao  nao possui Modelo Eletronico! */
                                           INPUT tt-natureza.nat-operacao).
                        CREATE msg-ret-nfe.
                        ASSIGN msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                               msg-ret-nfe.idi-orig-trad      = 2
                               msg-ret-nfe.dt-msg             = TODAY
                               msg-ret-nfe.hr-msg             = STRING(TIME, "HH:MM:SS")
                               msg-ret-nfe.log-ativo          = YES
                               msg-ret-nfe.cd-msg             = 55197
                               msg-ret-nfe.texto-msg          = RETURN-VALUE
                               msg-ret-nfe.seq-msg            = NEXT-VALUE(seq-msg-ret-nfe)
                               l-ok                           = NO.
                        RELEASE msg-ret-nfe.
                        LEAVE blocoNota.
                    END.
                    IF  natur-oper.imp-nota = YES THEN DO:
                        RUN utp/ut-msgs.p (INPUT "msg":U,
                                           INPUT 7207, /* Natureza de Operação gera faturamento */
                                           INPUT tt-natureza.nat-operacao).
                        CREATE msg-ret-nfe.
                        ASSIGN msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                               msg-ret-nfe.idi-orig-trad      = 2
                               msg-ret-nfe.dt-msg             = TODAY
                               msg-ret-nfe.hr-msg             = STRING(TIME, "HH:MM:SS")
                               msg-ret-nfe.log-ativo          = YES
                               msg-ret-nfe.cd-msg             = 7207
                               msg-ret-nfe.texto-msg          = RETURN-VALUE
                               msg-ret-nfe.seq-msg            = NEXT-VALUE(seq-msg-ret-nfe)
                               l-ok                           = NO.
                        RELEASE msg-ret-nfe.
                        LEAVE blocoNota.
                    END. 
                    
                    IF lNT2024002 = no THEN DO:
                       IF natur-oper.tipo-compra = 9 THEN DO:
                           {utp/ut-liter.i (NT2024002) * r }
                           RUN utp/ut-msgs.p (INPUT "help":U,
                                              INPUT 58156, /*Nota Cr‚dito/D‚bito somente poder  ser utilizada quando a fun‡Æo da reforma tribut ria &1 estiver ativa. */
                                              INPUT TRIM(RETURN-VALUE)).
                           
                           RUN implantaErro(INPUT bf{&TableName}.ch-acesso-comp-nfe, 
                                             INPUT 58156,
                                             INPUT RETURN-VALUE,
                                             INPUT 1). /*erro*/
                           ASSIGN l-ok = NO.
                           RELEASE msg-ret-nfe.
                           LEAVE blocoNota.                                            
                       END.    
                    END.
                                        
                    IF  (   bf{&TableName}.cod-finalidade = '5'   /*finalidade cr‚dito*/
                         OR bf{&TableName}.cod-finalidade = '6')  /*finalidade d‚bito*/
                    AND natur-oper.tipo-compra <> 9 /*nota cr‚dito/d‚bito*/ THEN DO:
                            IF bf{&TableName}.cod-finalidade = '5' THEN DO:
                                {utp/ut-liter.i 5(Cr‚dito) * r }
                            END.            
                            ELSE DO: 
                               {utp/ut-liter.i 6(D‚bito) * r }
                            END.
                            ASSIGN c-liter-1 = TRIM(RETURN-VALUE).
                            
                            {utp/ut-liter.i natureza_de_opera‡Æo_com_o_tipo_compra  * r }
                            ASSIGN c-liter-2 = TRIM(RETURN-VALUE).
                            
                            {utp/ut-liter.i Nota_de_Cr‚dito/D‚bito * r }
                            ASSIGN c-liter-3 = TRIM(RETURN-VALUE).
                            
                            RUN utp/ut-msgs.p (INPUT "help":U,
                                               INPUT 58158, /*Documento com finalidade &1, somente ser  permitido informar &2 igual a &3*/ 
                                               INPUT trim(c-liter-1) + "~~":U + trim(c-liter-2) + "~~":U + trim(c-liter-3) ).
                                               
                             RUN implantaErro(INPUT bf{&TableName}.ch-acesso-comp-nfe, 
                                             INPUT 58158, /*Documento com finalidade &1, somente ser  permitido informar &2 igual a &3*/
                                             INPUT RETURN-VALUE,
                                             INPUT 1). /*erro*/
                           ASSIGN l-ok = NO.
                           RELEASE msg-ret-nfe.
                           LEAVE blocoNota.                                                
                    END.
                    
                    IF  bf{&TableName}.cod-finalidade <> '5'   //finalidade cr²dito
                    AND bf{&TableName}.cod-finalidade <> '6'  //finalidade d²bito
                    AND natur-oper.tipo-compra = 9 /*nota de credito/debito*/ THEN DO:
                        {utp/ut-liter.i Natureza_de_opera‡Æo_com_o_tipo_compra_igual_Nota_cr‚dito/d‚bito * r }
                        ASSIGN c-liter-1 = TRIM(RETURN-VALUE).
                        
                         RUN utp/ut-msgs.p (INPUT "msg":U,
                                            INPUT 58159, /*Documento com finalidade &1 no XML. &2 , somente ser  permitido para documentos com finalidade 5(cr‚dito) ou 6(d‚bito)*/ 
                                            INPUT string(bf{&TableName}.cod-finalidade) + "~~":U + trim(c-liter-1)). 
                        
                         RUN utp/ut-msgs.p (INPUT "help":U,
                                            INPUT 58159, /*Documento com finalidade &1 no XML. &2 , somente ser  permitido para documentos com finalidade 5(cr‚dito) ou 6(d‚bito)*/ 
                                            INPUT string(bf{&TableName}.cod-finalidade) + "~~":U + trim(c-liter-1)).                     
                                            
                        RUN implantaErro(INPUT bf{&TableName}.ch-acesso-comp-nfe, 
                                           INPUT 58159, /*Documento com finalidade &1 no XML. &2 , somente ser  permitido para documentos com finalidade 5(cr‚dito) ou 6(d‚bito)*/ 
                                           INPUT RETURN-VALUE,
                                           INPUT 1). /*erro*/                                                
                        
                        ASSIGN l-ok = NO.
                        RELEASE msg-ret-nfe.
                        LEAVE blocoNota. 
                    END.
                END.
                IF  AVAIL natur-oper AND natur-oper.tipo-compra = 4 THEN
                    /* Existe ao menos um item que ‚ material agregado */
                    ASSIGN l-existe-mat-agreg = YES.
                ELSE IF AVAIL natur-oper AND natur-oper.tp-oper-terc = 2 THEN
                    /* Existe ao menos um item que ‚ retorno de beneficiamento */
                    ASSIGN l-existe-ret-benef = YES.

            END. /* END IF NOT CAN-FIND(FIRST tt-natureza */

            /* Chamado SDQAAI - Verifica se existe algum desconto informado nos itens */
            IF  item-doc-orig-nfe.vl-desconto <> 0 AND item-doc-orig-nfe.vl-desconto <> ? THEN
                ASSIGN desconto-item = YES.
                
            /* Chamado TTPVPS - Verifica se existe algum item com outras despesas, frete ou seguro informado */
            IF  not l-voutro-it AND item-doc-orig-nfe.vl-outros <> 0 AND item-doc-orig-nfe.vl-outros <> ? THEN    
                ASSIGN l-voutro-it = YES.
            IF  not l-vseg-it AND item-doc-orig-nfe.vl-seguro <> 0 AND item-doc-orig-nfe.vl-seguro <> ? THEN        
                ASSIGN l-vseg-it   = YES.
            IF  not l-vfrete-it AND item-doc-orig-nfe.vl-frete <> 0 AND item-doc-orig-nfe.vl-frete <> ? THEN            
                ASSIGN l-vfrete-it = YES.
                
            /************ GERACAO TEMP-TABLE PARA QUEBRA DOS ITENS POR FIFO *************/
            /*--- Inicio quebra ordens por FIFO - Gera Temp-table base para a quebra ---*/
            IF  CAN-FIND(FIRST rat-ordem-orig-nfe
                         WHERE rat-ordem-orig-nfe.ch-acesso-comp-nfe = item-doc-orig-nfe.ch-acesso-comp-nfe
                           AND rat-ordem-orig-nfe.seq-item           = item-doc-orig-nfe.seq-item) THEN DO:

                ASSIGN l-fifo-oc-docum = YES.
                
                FOR EACH  rat-ordem-orig-nfe EXCLUSIVE-LOCK
                    WHERE rat-ordem-orig-nfe.ch-acesso-comp-nfe = item-doc-orig-nfe.ch-acesso-comp-nfe
                      AND rat-ordem-orig-nfe.seq-item           = item-doc-orig-nfe.seq-item:

                    /* Copia a tt-rat-ordem-orig-nfe-aux para a tt-rat-ordem-orig-nfe-aux-aux. */
                    CREATE tt-rat-ordem-orig-nfe-aux.
                    BUFFER-COPY rat-ordem-orig-nfe TO tt-rat-ordem-orig-nfe-aux.
                    
                    ASSIGN tt-rat-ordem-orig-nfe-aux.r-rowid = ROWID(rat-ordem-orig-nfe). 
                    
                    /* Atribuicao dos demais campos. */
                    FOR FIRST ordem-compra NO-LOCK /* Busca campos da ordem conforme a REAPI400. */
                        WHERE ordem-compra.numero-ordem = rat-ordem-orig-nfe.numero-ordem:

                        ASSIGN tt-rat-ordem-orig-nfe-aux.ordem-servic = ordem-compra.ordem-servic
                               tt-rat-ordem-orig-nfe-aux.num-ord-inv  = ordem-compra.num-ord-inv /* Sem medicao por contrato. */
                               tt-rat-ordem-orig-nfe-aux.ct-codigo    = IF CAN-FIND(FIRST unid-neg-ordem 
                                                                                    WHERE unid-neg-ordem.numero-ordem = ordem-compra.numero-ordem) THEN "":U
                                                                        ELSE ordem-compra.ct-codigo
                               tt-rat-ordem-orig-nfe-aux.cod-unid-neg = IF CAN-FIND(FIRST unid-neg-ordem 
                                                                                    WHERE unid-neg-ordem.numero-ordem = ordem-compra.numero-ordem) THEN "":U
                                                                        ELSE ordem-compra.cod-unid-negoc.
                        /*--- Busca referencia da parcela conforme a REAPI400. ---*/
                        FOR FIRST prazo-compra FIELDS(cod-refer) NO-LOCK 
                            WHERE prazo-compra.numero-ordem = rat-ordem-ext.numero-ordem
                              AND prazo-compra.parcela      = rat-ordem-ext.parcela:
                            ASSIGN tt-rat-ordem-orig-nfe-aux.cod-refer = prazo-compra.cod-refer.
                        END.
                    END.
                END.
            END.
            /******************************************************************************/

        END.
        

        /************************** CONTROLE DE QUEBRA FIFO OC ***************************/
        /* APOS CRIAR OS REGISTROS DA TT-RAT-ORDEM-ORIG-NFE-AUX PARA OS ITENS, SIMULA A QUEBRA. */
        /* Executa a quebra para cada item individualmente devido a uma exce‡Æo que **
        ** ocorre na quebra por unidade de negocio quando um item esta marcado para **
        ** considerar a unidade de negocio e o outro nao. Caso considere todas as   **
        ** ordens da temp-table de uma vez, os blocos do for each serao executados  **
        ** por ordem de compra, nao por sequencia, assim uma ordem selecionada para **
        ** outra sequencia pode "atravessar" a execucao do bloco e acabar causando  **
        ** uma quebra indevida, principalmente se as ordens selecionadas estiverem  **
        ** em ordem numerica crescente ou decrescente.                              **
        ** Ex: para a sequencia 10 foram selecionadas as ordens 1236.00 e 1238.00 e **
        ** para a sequencia 20 foi selecionada a ordem 1237.00. Executando o bloco  **
        ** para todos os registros a temp-table sera lida pela ordem numerica das   **
        ** ordens de compra, assim o registro da sequencia 20 sera processado entre **
        ** os dois registros da sequencia 10, causando uma quebra indevida no FIFO. */
        FOR EACH  item-doc-orig-nfe
            WHERE item-doc-orig-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
              AND item-doc-orig-nfe.idi-orig-trad      = 2 NO-LOCK:
            
            /* O break by quebra o for each em blocos. Cada bloco executado **
            ** ativa a condicao first-of para todos os blocos abaixo dele.  */
            FOR EACH  tt-rat-ordem-orig-nfe-aux
                WHERE tt-rat-ordem-orig-nfe-aux.seq-item = item-doc-orig-nfe.seq-item
                BREAK BY tt-rat-ordem-orig-nfe-aux.ordem-servic
                      BY tt-rat-ordem-orig-nfe-aux.num-ord-inv
                      BY tt-rat-ordem-orig-nfe-aux.cod-refer
                      BY tt-rat-ordem-orig-nfe-aux.ct-codigo
                      BY tt-rat-ordem-orig-nfe-aux.sc-codigo
                      BY tt-rat-ordem-orig-nfe-aux.numero-ordem:

                IF  (    FIRST-OF(tt-rat-ordem-orig-nfe-aux.ct-codigo)
                     OR  FIRST-OF(tt-rat-ordem-orig-nfe-aux.sc-codigo))
                OR  (    FIRST-OF(tt-rat-ordem-orig-nfe-aux.numero-ordem)
                     AND tt-rat-ordem-orig-nfe-aux.num-ord-inv <> 0 ) THEN DO:
                    /* A variavel i-ctrl-quebra mantem o seu valor mesmo que seja feita quebra de **
                    ** documento por natureza. Cada vez que a quebra de FIFO for feita, ela sera  **
                    ** incrementada. Os registros com mesmo controle pertencerao a mesma quebra.  */
                    ASSIGN i-ctrl-quebra = i-ctrl-quebra + 1.
                END.
                ASSIGN tt-rat-ordem-orig-nfe-aux.ctrl-quebra = i-ctrl-quebra.
            END.
        END.
        /********************************************************************************/


        /***** RELACIONAMENTO AUTOMATICO DE DOCUMENTOS *****/
        /* Caso existe nota de retorno de beneficiamento e material agregado ‚ necess rio verificar se v¡nculo entre as notas foi criado.
           Essa l¢gica para criar os relacionamentos j  executada no reapi320, por‚m a natureza de opera‡Æo pode ser sido manutenida e por 
           esse motivo ‚ necess ria a nova verifica‡Æo */
        IF  l-existe-mat-agreg AND l-existe-ret-benef THEN DO:

            FOR EACH item-doc-orig-nfe EXCLUSIVE-LOCK
                WHERE item-doc-orig-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                AND   item-doc-orig-nfe.idi-orig-trad = 2:
            
                /* Valida natureza de material agregado. */
                IF  CAN-FIND(FIRST natur-oper
                             WHERE natur-oper.nat-operacao = item-doc-orig-nfe.nat-operacao
                             AND   natur-oper.tipo-compra  =  4 /* Material Agregado. */ ) THEN DO:
                    
                    /* O indice "unico" composto pela chave de acesso nao e unico. */
                    
                    FOR EACH tt-natureza:
                                                    
                        IF CAN-FIND(FIRST natur-oper
                                    WHERE natur-oper.nat-operacao = tt-natureza.nat-operacao
                                    AND   natur-oper.terceiros
                                    AND   natur-oper.tp-oper-terc = 2 /* Beneficiamento. */ ) THEN DO:                                    
                                                                                          
                            find first movto-pend-nfe exclusive-lock
                                 where movto-pend-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                                   and movto-pend-nfe.tipo               = 2 no-error.
                                 
                            if not avail movto-pend-nfe then do:                            
                                CREATE movto-pend-nfe.
                                ASSIGN movto-pend-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe.
                            end.
                                                        
                            ASSIGN movto-pend-nfe.serie-docto        = bf{&TableName}.serie-docto
                                   movto-pend-nfe.nro-docto          = bf{&TableName}.nro-docto
                                   movto-pend-nfe.cod-emitente       = bf{&TableName}.cod-emitente
                                   movto-pend-nfe.nat-operacao       = tt-natureza.nat-operacao
                                   movto-pend-nfe.tipo               = 2.
                        END.
                    END.
                END.
                ELSE /* NENHUM RELACIONAMENTO AUTOMATICO A SER REALIZADO. */
                    NEXT.
            END.

        END.
        /***** FIM - RELACIONAMENTO AUTOMATICO DE DOCUMENTOS *****/
        
        ASSIGN c-lista-naturezas = "".
        /** CRIA CONFORME CADA NATUREZA DE OPERACAO **/
        FOR EACH tt-natureza BREAK BY tt-natureza.nat-oper-agrup:

            ASSIGN c-lista-naturezas = c-lista-naturezas + tt-natureza.nat-operacao + ",".

            IF  NOT LAST-OF(tt-natureza.nat-oper-agrup) THEN /* Se usa multi. nat. ou nÆo segue a mesma l¢gica */
                NEXT.                                        /* pois sempre grava o campo nat-oper-agrup */

            FOR FIRST natur-oper 
                WHERE natur-oper.nat-operacao = tt-natureza.nat-oper-agrup NO-LOCK: 
            END.
            
            RUN processaAgregado (INPUT 1, OUTPUT c-conta, OUTPUT c-sub-conta).
  
            IF  RETURN-VALUE = "NOK":U THEN DO:
                ASSIGN l-ok = NO.
                LEAVE blocoNota.
            END.
            
            IF  CAN-FIND(FIRST tt-movto-pend) THEN DO:
                ASSIGN l-agregado = YES.
            END.

            IF  AVAIL natur-oper AND
                natur-oper.tipo-compra = 3 AND
                natur-oper.imp-nota THEN DO:
                
                RUN utp/ut-msgs.p (INPUT "msg":U,
                                   INPUT 52296,
                                   INPUT "").                                   

                CREATE msg-ret-nfe.
                ASSIGN msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                       msg-ret-nfe.idi-orig-trad      = 2
                       msg-ret-nfe.dt-msg             = TODAY
                       msg-ret-nfe.hr-msg             = STRING(TIME, "HH:MM:SS")
                       msg-ret-nfe.log-ativo          = YES
                       msg-ret-nfe.cd-msg             = 52296
                       msg-ret-nfe.texto-msg          = RETURN-VALUE
                       msg-ret-nfe.seq-msg            = NEXT-VALUE(seq-msg-ret-nfe)
                       l-ok = NO.
                release msg-ret-nfe.
                LEAVE blocoNota. 
            END.

            &IF DEFINED(bf_dis_consiste_conta) &THEN
                {cdp/cd9970.i bf{&TableName}.cod-estabel}
            &ENDIF                    
                       
            /***** DOCUMENTO *****/
            CREATE tt-docum-est.
            ASSIGN tt-docum-est.pais-origem  = "RE1001"
                   tt-docum-est.cod-emitente = bf{&TableName}.cod-emitente
                   tt-docum-est.nro-docto    = bf{&TableName}.nro-docto  
                   tt-docum-est.nat-operacao = tt-natureza.nat-oper-agrup  /* Se usa ou ¤ m£lt. natur, usa novo campo (nat-oper-agrup) */
                   tt-docum-est.serie-docto  = bf{&TableName}.serie-docto
                   tt-docum-est.cod-observa  = bf{&TableName}.cod-observa
                   tt-docum-est.cod-estabel  = bf{&TableName}.cod-estabel
                   tt-docum-est.dt-emissao   = bf{&TableName}.dt-emissao
                   tt-docum-est.dt-trans     = bf{&TableName}.dt-transacao 
                   tt-docum-est.usuario      = c-seg-usuario
                   tt-docum-est.tot-desconto = 0
                   tt-docum-est.valor-frete  = 0 /* Leva zero por padrao. O programa ira alterar posteriormente. */
                   tt-docum-est.valor-outras = IF bf{&TableName}.valor-outros   = ? THEN 0  ELSE bf{&TableName}.valor-outros
                   tt-docum-est.valor-seguro = IF bf{&TableName}.valor-seguro   = ? THEN 0  ELSE bf{&TableName}.valor-seguro
                   tt-docum-est.observacao   = if bf{&TableName}.inf-complement = ? then "" else SUBSTRING(bf{&TableName}.inf-complement,1,2000)                  
                   tt-docum-est.log-consid-ender-nf-saida = bf{&TableName}.log-consid-ender-nf-saida
                   tt-docum-est.origem         = "XML"
                   tt-docum-est.cod-finalidade = trim(bf{&TableName}.cod-finalidade)
                   tt-docum-est.cod-tipo-nf-cred-deb  = if bf{&TableName}.cod-tipo-nf-cred-deb <> ? AND bf{&TableName}.cod-tipo-nf-cred-deb <> "" then bf{&TableName}.cod-tipo-nf-cred-deb ELSE ""
                   tt-docum-est.cod-tipo-oper-gov = IF lNT2024002 THEN bf{&TableName}.cod-tipo-oper-gov ELSE 0
                   tt-docum-est.cod-tipo-ente-gov  = IF lNT2024002 THEN bf{&TableName}.cod-tipo-ente-gov ELSE 0
                   
            &IF "{&bf_mat_versao_ems}" < "2.07" &THEN
                  OVERLAY(tt-docum-est.char-1,93,60) = bf{&TableName}.ch-acesso-comp-nfe
                  OVERLAY(tt-docum-est.char-1,153,1) = "1".
            &ELSE
                  tt-docum-est.cod-chave-aces-nf-eletro = bf{&TableName}.ch-acesso-comp-nfe
                  tt-docum-est.cdn-sit-nfe              = 1.
            &ENDIF
            
            CASE INT(bf{&TableName}.mod-frete):
                WHEN 0 OR 
                WHEN 9 THEN ASSIGN tt-docum-est.mod-frete = 1.
                WHEN 1 THEN ASSIGN tt-docum-est.mod-frete = 2.
                OTHERWISE ASSIGN tt-docum-est.mod-frete = 3.
            END CASE.
            
            /*Modalidade de Frete NF-e*/
            ASSIGN &IF '{&BF_MAT_VERSAO_EMS}' >= '2.09'
                   &THEN tt-docum-est.cod-modalid-frete
                   &ELSE OVERLAY(tt-docum-est.char-2,143,8)
                   &ENDIF
                   = bf{&TableName}.mod-frete.
            /*Modalidade de Frete NF-e*/
            
            /* Valida o CGC da transportadora em branco. */
            IF (TRIM(bf{&TableName}.cnpj-transp) <> "" AND bf{&TableName}.cnpj-transp <> ?) OR
               (TRIM(bf{&TableName}.cpf-transp)  <> "" AND bf{&TableName}.cpf-transp  <> ?) THEN DO:
               
                IF (TRIM(bf{&TableName}.cnpj-transp) <> "" AND bf{&TableName}.cnpj-transp <> ?) THEN
                    FOR FIRST transporte WHERE transporte.cgc = bf{&TableName}.cnpj-transp NO-LOCK: 
                       ASSIGN tt-docum-est.nome-transp = transporte.nome-abrev.
                    END.
                ELSE 
                    FOR FIRST transporte WHERE transporte.cgc = bf{&TableName}.cpf-transp NO-LOCK: 
                        ASSIGN tt-docum-est.nome-transp = transporte.nome-abrev.
                    END.
            END.
            
            FIND FIRST tt-ext-docum-est EXCLUSIVE-LOCK
                 WHERE tt-ext-docum-est.serie-docto  = tt-docum-est.serie-docto
                   AND tt-ext-docum-est.nro-docto    = tt-docum-est.nro-docto
                   AND tt-ext-docum-est.cod-emitente = tt-docum-est.cod-emitente
                   AND tt-ext-docum-est.nat-operacao = tt-docum-est.nat-operacao
                   AND tt-ext-docum-est.cod-param    = "fatogeradorCBS-IBS":U       NO-ERROR.
            IF NOT AVAIL tt-ext-docum-est THEN DO:
                CREATE tt-ext-docum-est.
                ASSIGN tt-ext-docum-est.serie-docto  = tt-docum-est.serie-docto
                       tt-ext-docum-est.nro-docto    = tt-docum-est.nro-docto
                       tt-ext-docum-est.cod-emitente = tt-docum-est.cod-emitente
                       tt-ext-docum-est.nat-operacao = tt-docum-est.nat-operacao
                       tt-ext-docum-est.cod-param    = "fatogeradorCBS-IBS":U.    
                
                IF lNT2024002 = yes THEN do:
                    if bf{&TableName}.cidade-fato-gerador <> " " then do:
                        ASSIGN OVERLAY(tt-ext-docum-est.cod-livre-1,1,50) = bf{&TableName}.cidade-fato-gerador
                               OVERLAY(tt-ext-docum-est.cod-livre-2,1,4)  = bf{&TableName}.uf-fato-gerador.
                        FOR FIRST cidade NO-LOCK
                            WHERE cidade.cidade = bf{&TableName}.cidade-fato-gerador
                              AND cidade.estado = bf{&TableName}.uf-fato-gerador:
                            ASSIGN OVERLAY(tt-ext-docum-est.cod-livre-3,1,20) = cidade.pais.
                        END.                   
                    END. 
                    ELSE DO:
                        ASSIGN OVERLAY(tt-ext-docum-est.cod-livre-1,1,50) = estabelec.cidade
                               OVERLAY(tt-ext-docum-est.cod-livre-2,1,4)  = estabelec.estado.
                        FOR FIRST cidade NO-LOCK
                            WHERE cidade.cidade = estabelec.cidade
                              AND cidade.estado = estabelec.estado:
                            ASSIGN OVERLAY(tt-ext-docum-est.cod-livre-3,1,20) = cidade.pais.
                        END.                   
                    END.    
                END.
            END.
            
            IF  bf{&TableName}.placa <> ? THEN
                ASSIGN tt-docum-est.cod-placa[1] = bf{&TableName}.placa.

            IF bf{&TableName}.uf-placa <> ? THEN
                ASSIGN tt-docum-est.cod-uf-placa[1] = bf{&TableName}.uf-placa.
            
            if  AVAIL natur-oper AND natur-oper.tipo-compra = 4 THEN
                ASSIGN tt-docum-est.mod-atual  = 1
                       tt-docum-est.ct-transit = c-conta
                       tt-docum-est.sc-transit = c-sub-conta.
            
            /** BUSCA ESTABELECIMENTO ORIGEM PARA TRANSFERENCIA **/
            IF  AVAIL natur-oper AND natur-oper.transf THEN DO:
                FIND FIRST estabelec WHERE estabelec.cgc = bf{&TableName}.cnpj
                                       AND estabelec.cod-emitente = bf{&TableName}.cod-emitente NO-LOCK NO-ERROR.
                IF  AVAIL estabelec THEN
                    ASSIGN tt-docum-est.estab-de-or = estabelec.cod-estabel.
            END.
            /*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-* FIM -> DOCUMENTO *-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*/   

            IF l-re0708 THEN DO:
                {utp/ut-liter.i "Gerando_Informa‡äes_Item..." *}
                RUN pi-acompanhar IN h-acomp(RETURN-VALUE).
            END.
            /*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-* ITENS DO DOCUMENTO *-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*/

            ASSIGN i-seq-item         = param-re.seq-item-um
                   de-val-frete-docto = 0
                   l-erro-variacao    = NO.

            /*--- Notas de Entrega Futura devem sugerir a conta transitoria ---*/
            RUN getFatAntecipEntFutura IN h-boin176(INPUT tt-docum-est.nat-operacao,
                                                    OUTPUT l-fatura-fat-antecip,
                                                    OUTPUT l-remessa-fat-antecip,
                                                    OUTPUT l-fatura-ent-futura, 
                                                    OUTPUT l-remessa-ent-futura).
            
            IF l-fatura-ent-futura THEN DO:
               FIND estab-mat WHERE estab-mat.cod-estabel = tt-docum-est.cod-estabel NO-LOCK NO-ERROR.        
               IF  AVAIL estab-mat THEN
                   ASSIGN vl-ct-codigo = estab-mat.cod-cta-entreg-fut-unif
                          vl-sc-codigo = estab-mat.cod-ccusto-entreg-fut-unif.
            END.
            
            FOR EACH item-doc-orig-nfe NO-LOCK
                WHERE item-doc-orig-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                  AND item-doc-orig-nfe.idi-orig-trad      = 2:

                IF  LOOKUP(item-doc-orig-nfe.nat-operacao, c-lista-naturezas) = 0 THEN /* Se esse item nÆo ‚ desse documento, vai para o pr¢ximo */
                    NEXT.
                    
                IF NOT AVAIL natur-oper 
                OR (AVAIL natur-oper AND natur-oper.nat-operacao <> item-doc-orig-nfe.nat-operacao) THEN
                    FOR FIRST natur-oper 
                        WHERE natur-oper.nat-operacao = item-doc-orig-nfe.nat-operacao NO-LOCK: 
                    END.

                RUN findTabelas IN h-boin857 (input rowid(bf{&TableName}),
                                              input natur-oper.nat-operacao,
                                              input item-doc-orig-nfe.it-codigo).
                
                /* ->> Controle para evitar aloca‡Æo de parcelas indevidamente - Alocar a mesma parcela sem que haja saldo dispon¡vel */
                ASSIGN l-erro-variacao = NO.
            
                /** VALIDA€ÇO QUANTIDADE **/
                RUN validaContratoOrdem IN h-boin857 (OUTPUT l-contrato, OUTPUT i-total).
        
                IF  NOT l-contrato OR i-total = 0 THEN DO:
                    IF VALID-HANDLE(h-boin857) THEN DO:
                        RUN setConstraintMonitor IN h-boin857 (INPUT item-doc-orig-nfe.ch-acesso-comp-nfe,
                                                               INPUT 2).
                        RUN openQueryStatic      IN h-boin857 (INPUT "Monitor":U).
                        RUN goToKey              IN h-boin857 (item-doc-orig-nfe.ch-acesso-comp-nfe, 
                                                               item-doc-orig-nfe.idi-orig-trad, 
                                                               item-doc-orig-nfe.seq-item).
                    END.
                     
                    RUN validaVariacaoQtd IN h-boin857 (INPUT item-doc-orig-nfe.numero-ordem,
                                                        INPUT item-doc-orig-nfe.parcela,
                                                        INPUT item-doc-orig-nfe.qtd-interna,
                                                        INPUT item-doc-orig-nfe.it-codigo,
                                                        OUTPUT l-erro-variacao).
                END.                                                        
                                                         
                IF  l-erro-variacao THEN DO:
                    IF  param-re.aceita-var THEN DO:
                        RUN utp/ut-msgs.p (INPUT "msg":U,
                                           INPUT 18799, /*mensagem: Quantidade fora da variacao permitida.*/
                                           INPUT "''").
                        CREATE msg-ret-nfe.
                        ASSIGN msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                               msg-ret-nfe.idi-orig-trad      = 2
                               msg-ret-nfe.dt-msg             = TODAY
                               msg-ret-nfe.hr-msg             = STRING(TIME, "HH:MM:SS")
                               msg-ret-nfe.log-ativo          = YES
                               msg-ret-nfe.cd-msg             = 18799
                               msg-ret-nfe.texto-msg          = RETURN-VALUE
                               msg-ret-nfe.seq-msg            = NEXT-VALUE(seq-msg-ret-nfe)
                               msg-ret-nfe.tipo-msg           = 2.
                       release msg-ret-nfe.
                    END.
                    ELSE DO:
                        {utp/ut-liter.i "Quantidade" *}
                        RUN utp/ut-msgs.p (INPUT "msg":U,
                                           INPUT 28643, /*mensagem: Variacao de quantidade nao permitida.*/
                                           INPUT RETURN-VALUE).                
                        CREATE msg-ret-nfe.
                        ASSIGN msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                               msg-ret-nfe.idi-orig-trad      = 2
                               msg-ret-nfe.dt-msg             = TODAY
                               msg-ret-nfe.hr-msg             = STRING(TIME, "HH:MM:SS")
                               msg-ret-nfe.log-ativo          = YES
                               msg-ret-nfe.cd-msg             = 28643
                               msg-ret-nfe.texto-msg          = RETURN-VALUE
                               msg-ret-nfe.seq-msg            = NEXT-VALUE(seq-msg-ret-nfe)
                               msg-ret-nfe.tipo-msg           = 1
                               l-ok                           = no.
                        release msg-ret-nfe.              
                        LEAVE blocoNota.
                    END.
                END.    
                /*******************************/

                RUN validaQtdeFracionada. //Somente com fun‡Æo REC-VALID-XML-FRAC ativada!
                IF RETURN-VALUE = "ERROR":U THEN DO:
                    release msg-ret-nfe.
                    assign l-ok = no.
                    LEAVE blocoNota.
                END.

                CREATE tt-despesas-item.
                ASSIGN tt-despesas-item.seq-item     = i-seq-item
                       tt-despesas-item.nat-operacao = tt-natureza.nat-oper-agrup
                       tt-despesas-item.vl-seguro    = IF item-doc-orig-nfe.vl-seguro <> ? THEN item-doc-orig-nfe.vl-seguro ELSE 0
                       tt-despesas-item.vl-outros    = IF item-doc-orig-nfe.vl-outros <> ? THEN item-doc-orig-nfe.vl-outros ELSE 0.
                       
                /* S¢ sugere o FIFO para notas que podem ter pedido */
                IF  NOT param-re.log-1 
                OR  item-doc-orig-nfe.numero-ordem > 0
                OR  can-find(first natur-oper 
                             where natur-oper.nat-operacao = item-doc-orig-nfe.nat-operacao
                               and ((natur-oper.nota-rateio) OR
                                    (natur-oper.transf)      OR 
                                    (natur-oper.terceiros        AND natur-oper.tp-oper-terc <> 3) OR
                                    (natur-oper.tipo-compra <> 4 AND natur-oper.tipo-compra  <> 1) )) THEN DO:
                    ASSIGN l-fifo-oc = NO.
                END.
                ELSE 
                    ASSIGN l-fifo-oc = item-doc-orig-nfe.log-fifo-oc.
                
                IF NOT l-fifo-oc-docum AND l-fifo-oc THEN
                    ASSIGN l-fifo-oc-docum = YES.                    
                    
                FIND FIRST ITEM
                     WHERE ITEM.it-codigo = item-doc-orig-nfe.it-codigo NO-LOCK NO-ERROR.

                ASSIGN de-indice = 1.

                FIND FIRST item-fornec
                     WHERE item-fornec.cod-emitente = bf{&TableName}.cod-emitente 
                       AND item-fornec.it-codigo    = item-doc-orig-nfe.it-codigo 
                       AND item-fornec.ativo NO-LOCK NO-ERROR.
                IF AVAIL item-fornec THEN
                    ASSIGN unid-item-doc-est = item-fornec.unid-med-for
                           de-indice         = item-fornec.fator-conver / exp(10,item-fornec.num-casa-dec).
                ELSE DO:
                    IF AVAIL ITEM AND (ITEM.un = item-doc-orig-nfe.un-comercial OR ITEM.tipo-contr = 4) THEN DO:           
                        IF ITEM.un = item-doc-orig-nfe.un-comercial THEN
                            ASSIGN unid-item-doc-est = item-doc-orig-nfe.un-comercial.
                        IF ITEM.tipo-contr = 4 THEN
                            ASSIGN unid-item-doc-est = item-doc-orig-nfe.un-interna.
                    END. 
                    ELSE DO:
                        FIND tab-conv-un
                         WHERE tab-conv-un.un = item-doc-orig-nfe.un-interna
                           AND tab-conv-un.unid-med-for = item-doc-orig-nfe.un-comercial NO-LOCK NO-ERROR.
                        IF AVAIL tab-conv-un THEN
                            ASSIGN unid-item-doc-est = item-doc-orig-nfe.un-interna.
                        ELSE
                            ASSIGN unid-item-doc-est = item-doc-orig-nfe.un-comercial.                             
                    END.
                END.

                /* FO TDLBCK - Valida item da ordem x item da nota.     */
                /* Durante a manutencao foi verificado que o DE-PARA    ** 
                ** pode retornar itens invalidos para a ordem pois ele  ** 
                ** nao considera o item da ordem informada. No Gera     ** 
                ** Fisico o documento fica bloqueado, mas no Fiscal o   ** 
                ** item da ordem ‚ sugerido automaticamente no          ** 
                ** creatRecord, sem passar por essa validacao primeiro. */
                IF  item-doc-orig-nfe.numero-ordem <> 0 THEN DO:
                    FOR FIRST ordem-compra EXCLUSIVE-LOCK
                        WHERE ordem-compra.numero-ordem = item-doc-orig-nfe.numero-ordem:
                        
                        IF ordem-compra.it-codigo <> item-doc-orig-nfe.it-codigo THEN DO:
                            CREATE msg-ret-nfe.
                            ASSIGN msg-ret-nfe.ch-acesso-comp-nfe = item-doc-orig-nfe.ch-acesso-comp-nfe
                                   msg-ret-nfe.idi-orig-trad      = 2
                                   msg-ret-nfe.dt-msg             = TODAY
                                   msg-ret-nfe.hr-msg             = STRING(TIME, "HH:MM:SS")
                                   msg-ret-nfe.log-ativo          = YES
                                   msg-ret-nfe.cd-msg             = 15187
                                   msg-ret-nfe.texto-msg          = "Item da ordem inv lido."
                                   msg-ret-nfe.seq-msg            = NEXT-VALUE(seq-msg-ret-nfe)
                                   l-ok                           = NO.
                            release msg-ret-nfe.
                            /* O conversor desaloca o saldo dos itens por natureza, mas gera tudo de uma vez.
                            Assim ao passar aqui na segunda natureza, j  desalocou o saldo dos itens que tem a 
                            primeira natureza. Por‚m se der um return aqui, nao chega a executar a l¢gica que 
                            realoca o saldo (geracao do documento no fiscal), fazendo com que o saldo alocado
                            para os itens das naturezas anteriores se perca. */
                            LEAVE blocoNota.
                        END.
                    END.
                    RELEASE ordem-compra.
                END.

                IF CAN-FIND(FIRST item-ref-nfe NO-LOCK
                            WHERE item-ref-nfe.ch-acesso-comp-nfe = item-doc-orig-nfe.ch-acesso-comp-nfe
                              AND item-ref-nfe.seq-item           = item-doc-orig-nfe.seq-item          ) THEN DO:

                    RUN validarSaldoTercInsuficiente.
                    IF RETURN-VALUE = "ERROR":U THEN DO:
                        RELEASE msg-ret-nfe.
                        ASSIGN l-ok = NO.
                        LEAVE blocoNota.
                    END.

                    FOR EACH item-ref-nfe NO-LOCK
                       WHERE item-ref-nfe.ch-acesso-comp-nfe = item-doc-orig-nfe.ch-acesso-comp-nfe
                         AND item-ref-nfe.seq-item           = item-doc-orig-nfe.seq-item:
                        
                        FOR FIRST saldo-terc NO-LOCK
                            WHERE saldo-terc.cod-emitente = item-ref-nfe.cod-emitente
                              AND saldo-terc.nro-docto    = item-ref-nfe.nro-docto   
                              AND saldo-terc.serie-docto  = item-ref-nfe.serie-docto 
                              AND saldo-terc.nat-operacao = item-ref-nfe.nat-operacao
                              AND saldo-terc.it-codigo    = item-ref-nfe.it-codigo   
                              AND saldo-terc.cod-refer    = item-doc-orig-nfe.cod-refer   
                              AND saldo-terc.sequencia    = item-ref-nfe.seq-saldo-terc:
                        END.
                        
                        IF  AVAIL natur-oper AND AVAIL saldo-terc THEN DO:
                            /* Chama a procedure com a valida‡Æo correta. */
                            RUN validaSaldoTerc (OUTPUT l-saldo-ok).
                            IF  l-saldo-ok THEN
                                FIND FIRST componente OF saldo-terc NO-LOCK NO-ERROR.
                            ELSE
                                ASSIGN l-erro-saldo = YES.
                        END.

                        IF  AVAIL natur-oper AND AVAIL item-ref-nfe AND AVAIL componente THEN DO:
                            if natur-oper.terceiros = yes and natur-oper.tp-oper-terc = 5 and natur-oper.tipo-compra <> 1 then do:
                                RUN utp/ut-msgs.p (INPUT "help":U,
                                                   INPUT 55358,
                                                   INPUT tt-natureza.nat-operacao + " - Opera‡Æo de Devolu‡Æo Consigna‡Æo deve ter o Tipo Compra como Normal").
                                CREATE msg-ret-nfe.
                                ASSIGN msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                                       msg-ret-nfe.idi-orig-trad      = 2
                                       msg-ret-nfe.dt-msg             = TODAY
                                       msg-ret-nfe.hr-msg             = STRING(TIME, "HH:MM:SS")
                                       msg-ret-nfe.log-ativo          = YES
                                       msg-ret-nfe.cd-msg             = 55358
                                       msg-ret-nfe.texto-msg          = RETURN-VALUE
                                       msg-ret-nfe.seq-msg            = NEXT-VALUE(seq-msg-ret-nfe)
                                       l-ok                           = NO.
                                RELEASE msg-ret-nfe.
                                LEAVE blocoNota.
                            end.
                            else
                            /* roda a procedure que valida a item-doc-orig-nfe e cria a tt-item-doc-est */
                            RUN criaItemNotaRefer.
                        END.
                        
                        ELSE DO:
                        
                            /* Preenchimento das despesas do item */
                            ASSIGN de-despesas-item = 0.
                            
                            IF  item-doc-orig-nfe.vl-frete <> ? and item-doc-orig-nfe.vl-frete <> 0 THEN
                                ASSIGN de-despesas-item = item-doc-orig-nfe.vl-frete.
                            ELSE if not l-vfrete-it then DO:
                                IF  bf{&TableName}.valor-produto <> 0 /* Quando for Servi‡o vem zerada esta tag */ THEN DO:
                                    ASSIGN de-val-frete-item = TRUNCATE(((bf{&TableName}.valor-frete * ROUND(item-doc-orig-nfe.preco-total, 5)) 
                                                                        / bf{&TableName}.valor-produto),2)
                                           de-despesas-item = de-val-frete-item.
                                END.
                            END.
                            
                            IF  item-doc-orig-nfe.vl-outros <> ? THEN
                                ASSIGN de-despesas-item = de-despesas-item + item-doc-orig-nfe.vl-outros.
                            ELSE IF not l-voutro-it AND
                                    bf{&TableName}.valor-outros  <> 0 AND
                                    bf{&TableName}.valor-produto <> 0 /* Quando for Servi‡o vem zerada esta tag */ THEN
                                ASSIGN de-despesas-item =  de-despesas-item + TRUNCATE(((bf{&TableName}.valor-outros * ROUND(item-doc-orig-nfe.preco-total, 5)) 
                                                                                       / bf{&TableName}.valor-produto),2).
                            IF  item-doc-orig-nfe.vl-seguro <> ? THEN
                                ASSIGN de-despesas-item = de-despesas-item + item-doc-orig-nfe.vl-seguro.
                            ELSE IF not l-vseg-it and
                                    bf{&TableName}.valor-seguro  <> 0 AND
                                    bf{&TableName}.valor-produto <> 0 /* Quando for Servi‡o vem zerada esta tag */ THEN
                                ASSIGN de-despesas-item = de-despesas-item + TRUNCATE(((bf{&TableName}.valor-seguro * ROUND(item-doc-orig-nfe.preco-total, 5)) 
                                                                                / bf{&TableName}.valor-produto),2).
                            /* FIM - Preenchimento das despesas do item */
                            
                            /* Cria a tt-item-doc-est normalmente. */
                            CREATE tt-item-doc-est.
                            ASSIGN tt-item-doc-est.serie-docto    = bf{&TableName}.serie-docto     
                                   tt-item-doc-est.nro-docto      = bf{&TableName}.nro-docto       
                                   tt-item-doc-est.cod-emitente   = bf{&TableName}.cod-emitente    
                                   tt-item-doc-est.nat-operacao   = tt-natureza.nat-oper-agrup /* Se usa ou nÆo M£lt. Natur usa o novo campo */
                                   tt-item-doc-est.sequencia      = i-seq-item                     
                                   i-seq-item                     = i-seq-item + IF param-re.inc-seq > 0 THEN param-re.inc-seq ELSE 10.
                            ASSIGN tt-item-doc-est.it-codigo      = IF AVAIL item-fornec THEN item-fornec.it-codigo ELSE item-doc-orig-nfe.it-codigo
                                   tt-item-doc-est.num-pedido     = item-doc-orig-nfe.num-pedido  
                                   tt-item-doc-est.numero-ordem   = item-doc-orig-nfe.numero-ordem
                                   tt-item-doc-est.desconto[1]    = IF item-doc-orig-nfe.vl-desconto = ? THEN 0 ELSE item-doc-orig-nfe.vl-desconto
                                   tt-item-doc-est.parcela        = item-doc-orig-nfe.parcela     
                                   tt-item-doc-est.encerra-pa     = IF item-doc-orig-nfe.encerra-pa = ? THEN NO ELSE item-doc-orig-nfe.encerra-pa
                                   tt-item-doc-est.nr-ord-produ   = IF AVAIL saldo-terc AND saldo-terc.nr-ord-produ <> 0 THEN saldo-terc.nr-ord-produ ELSE item-doc-orig-nfe.nr-ord-produ
                                   tt-item-doc-est.qt-do-forn     = IF AVAIL ITEM AND ITEM.fraciona THEN ( item-ref-nfe.qtd-alocada * de-indice ) 
                                                                    ELSE ROUND((item-ref-nfe.qtd-alocada * de-indice),0)
                                   tt-item-doc-est.un             = unid-item-doc-est
                                   tt-item-doc-est.quantidade     = item-ref-nfe.qtd-alocada
                                   tt-item-doc-est.preco-unit[1]  = ROUND(item-doc-orig-nfe.preco-unit, 5)
                                   tt-item-doc-est.preco-total[1] = ROUND(item-doc-orig-nfe.preco-unit, 5) * tt-item-doc-est.qt-do-forn
                                   tt-item-doc-est.class-fiscal   = item-doc-orig-nfe.class-fiscal
                                   tt-item-doc-est.log-1          = l-fifo-oc
                                   tt-item-doc-est.log-fifo-oc    = l-fifo-oc
                                   tt-item-doc-est.ct-codigo      = if l-fatura-ent-futura then vl-ct-codigo else item-doc-orig-nfe.ct-codigo
                                   tt-item-doc-est.sc-codigo      = if l-fatura-ent-futura then vl-sc-codigo else item-doc-orig-nfe.sc-codigo
                                   tt-item-doc-est.cod-refer      = item-doc-orig-nfe.cod-refer     
                                   tt-item-doc-est.cod-depos      = item-doc-orig-nfe.cod-depos     
                                   tt-item-doc-est.cod-localiz    = item-doc-orig-nfe.cod-localiz   
                                   tt-item-doc-est.lote           = item-doc-orig-nfe.lote-serie
                                   tt-item-doc-est.dt-vali-lote   = item-doc-orig-nfe.dt-vali-lote
                                   tt-item-doc-est.cod-unid-negoc = item-doc-orig-nfe.cod-unid-negoc
                                   tt-item-doc-est.int-1          = item-doc-orig-nfe.int-1
                                   tt-item-doc-est.pr-total-cmi   = if item-doc-orig-nfe.vl-frete = ? or item-doc-orig-nfe.vl-frete = 0 then de-val-frete-item else item-doc-orig-nfe.vl-frete
                                   tt-item-doc-est.despesas[1]    = de-despesas-item
                                   tt-item-doc-est.narrativa      = item-doc-orig-nfe.narrativa
                                   tt-item-doc-est.reabre-pd      = item-ref-nfe.reabre-pd
                                   tt-item-doc-est.nat-of         = item-doc-orig-nfe.nat-operacao /* Sempre salva a natureza fiscal do item */
                                   OVERLAY(tt-item-doc-est.char-2,832,5) = STRING(item-doc-orig-nfe.seq-item) /* Grava a sequencia do item do monitor nfe */
                                   tt-item-doc-est.ind-bem-movel-usado   = IF lNT2024002 THEN item-doc-orig-nfe.ind-bem-movel-usado else no
                                   tt-item-doc-est.log-doacao            = IF lNT2024002 THEN item-doc-orig-nfe.log-doacao else no
                                   tt-item-doc-est.ano-mes-apuracao      = IF lNT2024002 THEN item-doc-orig-nfe.ano-mes-apuracao ELSE "".                                    
                             

                            IF tt-item-doc-est.ct-codigo = "" AND AVAIL ITEM AND (ITEM.tipo-contr = 1 OR ITEM.tipo-contr = 4) THEN 
                               ASSIGN tt-item-doc-est.ct-codigo = item.ct-codigo 
                                      tt-item-doc-est.sc-codigo = item.sc-codigo.

                            /* Alterado para evitar arredondamento para 0 com quantidades muito pequenas. */
                            IF  tt-item-doc-est.preco-total[1]     = 0
                                AND item-doc-orig-nfe.preco-unit  <> 0
                                AND item-ref-nfe.qtd-alocada      <> 0 THEN
                                ASSIGN tt-item-doc-est.preco-total[1] = 0.01.
                            
                            if item-doc-orig-nfe.int-2  = 23 then /*Nota Cr‚dito/D‚bito*/
                               assign tt-item-doc-est.baixa-ce    = no 
                                      tt-item-doc-est.log-1       = no 
                                      tt-item-doc-est.log-fifo-oc = no .
                                      
                            ASSIGN tt-item-doc-est.peso-liquido   = DEC(STRING(item-doc-orig-nfe.peso-liq, ">>>>,>>9.99999")) NO-ERROR.
                  
                            IF  avail natur-oper then do:
                            
                                if  natur-oper.tipo-compra  = 3      /* Devolu‡Æo de cliente    */
                                or  natur-oper.tp-oper-terc = 2      /* Retorno Beneficiamento  */ 
                                OR  natur-oper.tp-oper-terc = 4      /* Faturamento Consignacao */
                                OR  natur-oper.tp-oper-terc = 5 THEN /* Devolucao Consignacao   */ 
                                    ASSIGN tt-item-doc-est.serie-comp = item-ref-nfe.serie-docto
                                           tt-item-doc-est.nro-comp   = item-ref-nfe.nro-docto
                                           tt-item-doc-est.nat-comp   = item-ref-nfe.nat-operacao
                                           tt-item-doc-est.seq-comp   = item-ref-nfe.seq-saldo-terc
                                           tt-item-doc-est.emite-comp = item-ref-nfe.cod-emitente.
                                           
                                if  item-doc-orig-nfe.int-2  <> 23 then
                                    RUN pi-item-fiscal.
        
                                /* FO AAFNC3 - ENGEPACK - Corrigida criacao dos itens da nota   **
                                ** de devolucao, de acordo com as informacoes da nota de saida. */
                                if natur-oper.tipo-compra = 3 then do: /* Devolu‡Æo de Cliente. */
                                    for first it-nota-fisc no-lock
                                        where it-nota-fisc.cod-estabel = bf{&TableName}.cod-estabel
                                        and   it-nota-fisc.serie       = item-ref-nfe.serie-docto
                                        and   it-nota-fisc.nr-nota-fis = item-ref-nfe.nro-docto
                                        and   it-nota-fisc.nr-seq-fat  = item-ref-nfe.seq-saldo-terc
                                        and   it-nota-fisc.it-codigo   = item-ref-nfe.it-codigo:

                                        RUN piBuscaPisCofins IN h-cdapi995 (INPUT  "it-nota-fisc",
                                                                            INPUT  ROWID(it-nota-fisc),
                                                                            INPUT  NO, /* não recalcular e gravar quando já existe na ext-it-nota-fisc */
                                                                            INPUT  NO,
                                                                            OUTPUT d-aliq-pis,
                                                                            OUTPUT d-val-base-pis,
                                                                            OUTPUT d-val-pis,
                                                                            OUTPUT d-aliq-cofins,
                                                                            OUTPUT d-val-base-cofins,
                                                                            OUTPUT d-val-cofins).
                
                                        /**************************
                                        * PIS/COFINS POR UNIDADE *
                                        **************************/
            
                                        de-valor-un-pis-devol    = IF it-nota-fisc.idi-forma-calc-pis = 2 /* Pis Un Prod */
                                                                   THEN it-nota-fisc.val-unit-pis         /* Vl Unit Pis*/
                                                                   ELSE 0.
                                        de-valor-un-cofins-devol = IF it-nota-fisc.idi-forma-calc-cofins = 2 /* Pis Un Prod */
                                                                   THEN it-nota-fisc.val-unit-cofins         /* Vl Unit Pis*/
                                                                   ELSE 0. 
            
                                        IF de-valor-un-pis-devol <> 0 then
                                            assign d-aliq-pis = 0.
            
                                        IF de-valor-un-cofins-devol <> 0 then
                                            assign d-aliq-cofins = 0.     
                                            

                                        assign tt-item-doc-est.data-comp           = it-nota-fisc.dt-emis-nota
                                               tt-item-doc-est.nr-pedcli           = it-nota-fisc.nr-pedcli
                                               tt-item-doc-est.nr-pd-seq           = it-nota-fisc.nr-seq-ped
                                               tt-item-doc-est.baixa-ce            = it-nota-fisc.baixa-estoq
                                               tt-item-doc-est.log-2               = it-nota-fisc.ind-icm-ret
                                               tt-item-doc-est.val-perc-red-icms   = it-nota-fisc.perc-red-icm
                                               tt-item-doc-est.val-perc-rep-ipi    = it-nota-fisc.perc-red-ipi
                                               tt-item-doc-est.idi-tributac-pis    = int(substring(it-nota-fisc.char-2,96,1))  /* Tributacao PIS     */     
                                               tt-item-doc-est.idi-tributac-cofins = int(substring(it-nota-fisc.char-2,97,1))  /* Tributacao COFINS  */     
                                               tt-item-doc-est.val-aliq-pis        = d-aliq-pis    /* Aliquota PIS       */     
                                               tt-item-doc-est.val-aliq-cofins     = d-aliq-cofins. /* Aliquota do COFINS */   

                                        if substr(natur-oper.char-1,168,1) <> "S":U then do: /*Deduzir ICMS ST Devol. Cliente*/
                                            IF NOT VALID-HANDLE (h-reapi412) THEN
                                                RUN rep/reapi412.p PERSISTENT SET h-reapi412.
                                            RUN inicializaAtributos        IN h-reapi412.
                                            RUN setRowidItemNotaFiscal     IN h-reapi412 (INPUT ROWID(it-nota-fisc)).
                                            RUN setRowidNaturezaOperFiscal IN h-reapi412 (INPUT ROWID(natur-oper)).
                                            RUN setSerieDocto              IN h-reapi412 (INPUT tt-item-doc-est.serie-docto).
                                            RUN setNumeroDocto             IN h-reapi412 (INPUT tt-item-doc-est.nro-docto).
                                            RUN setEmitenteDocto           IN h-reapi412 (INPUT tt-item-doc-est.cod-emitente).
                                            RUN setNatOperacaoDocto        IN h-reapi412 (INPUT tt-item-doc-est.nat-operacao).
                                            RUN setCodEstabelDocto         IN h-reapi412 (INPUT bf{&TableName}.cod-estabel).
                                            RUN setICMSRetido              IN h-reapi412 (INPUT tt-item-doc-est.log-2).
                                            RUN setQuantidadeItem          IN h-reapi412 (INPUT tt-item-doc-est.quantidade).
                                            RUN setSequenciaItem           IN h-reapi412 (INPUT tt-item-doc-est.sequencia).
                                            RUN setItem                    IN h-reapi412 (INPUT tt-item-doc-est.it-codigo).

                                            RUN buscaIcmsSTSaida           IN h-reapi412.

                                            IF RETURN-VALUE = "OK" THEN DO:
                                                RUN isSaveICMS-STA IN h-reapi412. /* Eh para salvar? */
                                                IF RETURN-VALUE = "YES" THEN DO:
                                                    RUN saveICMS-STA IN h-reapi412. /* Salva */
                                                    IF RETURN-VALUE = "NOK" THEN DO:
                                                        RUN getRowErrors IN h-reapi412 (OUTPUT TABLE RowErrors).
                                                        RUN rowErrorsToMsgRetNFe (item-doc-orig-nfe.ch-acesso-comp-nfe, YES, INPUT TABLE RowErrors).
                                                        LEAVE blocoNota.
                                                    END.
                                                    ELSE DO:
                                                        RUN getValBaseSubs IN h-reapi412 (OUTPUT tt-item-doc-est.base-subs[1]).
                                                        RUN getValSubs     IN h-reapi412 (OUTPUT tt-item-doc-est.vl-subs[1]).
                                                    END.
                                                END.
                                            END.
                                        end. /*if substr(natur-oper.char-1,168,1) <> "S"*/
                                         
                                        RUN grava-aliquotas IN h-cdapi995 (INPUT "item-doc-est",
                                                                           INPUT tt-item-doc-est.serie-docto + "/" + 
                                                                                 tt-item-doc-est.nro-docto + "/" + 
                                                                                 string(tt-item-doc-est.cod-emitente) + "/" + 
                                                                                 tt-item-doc-est.nat-operacao + "/" + 
                                                                                 string(tt-item-doc-est.sequencia), 
                                                                           INPUT d-aliq-pis,   
                                                                           INPUT d-aliq-cofins). 
                                                       
                                        find first nar-it-nota no-lock 
                                            where nar-it-nota.cod-estabel  = it-nota-fisc.cod-estabel
                                            and   nar-it-nota.serie        = it-nota-fisc.serie
                                            and   nar-it-nota.nr-nota-fis  = it-nota-fisc.nr-nota-fis
                                            and   nar-it-nota.nr-sequencia = it-nota-fisc.nr-seq-fat
                                            and   nar-it-nota.it-codigo    = it-nota-fisc.it-codigo no-error.
                                        if  avail nar-it-nota then 
                                            assign tt-item-doc-est.narrativa = if tt-item-doc-est.narrativa <> "" then 
                                                                                  (tt-item-doc-est.narrativa + " | " + nar-it-nota.narrativa) 
                                                                               else nar-it-nota.narrativa.
                                    end. /*for first it-nota-fisc no-lock*/
                                end. /*if natur-oper.tipo-compra = 3*/

                                IF  natur-oper.log-oper-triang THEN
                                    ASSIGN tt-item-doc-est.serie-terc     = item-ref-nfe.serie-docto
                                           tt-item-doc-est.nro-docto-terc = item-ref-nfe.nro-docto
                                           tt-item-doc-est.nat-terc       = item-ref-nfe.nat-operacao
                                           tt-item-doc-est.seq-terc       = item-ref-nfe.seq-saldo-terc
                                           tt-item-doc-est.cod-emit-terc  = item-ref-nfe.cod-emitente.                        
                            end.

                            find first ordem-compra
                            where ordem-compra.numero-ordem = item-doc-orig-nfe.numero-ordem no-lock no-error.                
                            if avail ordem-compra then do:
                                if tt-item-doc-est.nr-ord-produ = 0 then 
                                    assign tt-item-doc-est.nr-ord-produ = ordem-compra.ordem-servic.
                            end.
                        END.

                        /* Cria temp-table com a rela‡Æo do saldo em poder de terceiros.        **
                        ** S¢ existir  saldo alocado no conversor se houver nota referenciada.  */
                        CREATE tt-relac-saldo.
                        ASSIGN i-seq-aux                     = i-seq-aux + 1
                               tt-relac-saldo.sequencia      = i-seq-aux
                               tt-relac-saldo.seq-saldo-terc = item-ref-nfe.seq-saldo-terc
                               tt-relac-saldo.qtd-alocar     = item-ref-nfe.qtd-alocada
                               tt-relac-saldo.cod-emitente   = item-ref-nfe.cod-emitente
                               tt-relac-saldo.nro-docto      = item-ref-nfe.nro-docto
                               tt-relac-saldo.serie-docto    = item-ref-nfe.serie-docto
                               tt-relac-saldo.nat-operacao   = item-doc-orig-nfe.nat-operacao
                               tt-relac-saldo.nat-terc       = item-ref-nfe.nat-operacao
                               tt-relac-saldo.it-codigo      = item-doc-orig-nfe.it-codigo.
                    END.
                END.
                /* Se nÆo tiver docto referenciado: */
                ELSE DO:               

                    IF AVAIL natur-oper THEN DO:                    
                        IF  natur-oper.tp-oper-terc = 2          /* Retorno Beneficiamento  */ 
                        OR  natur-oper.tp-oper-terc = 4          /* Faturamento Consignacao */
                        OR  natur-oper.tp-oper-terc = 5 THEN DO: /* Devolucao Consignacao   */ 
                            ASSIGN de-qtd-saldo = 0.
                            
                            FOR EACH saldo-terc NO-LOCK
                                WHERE saldo-terc.cod-emitente = bf{&TableName}.cod-emitente
                                AND   saldo-terc.it-codigo    = item-doc-orig-nfe.it-codigo
                                AND   saldo-terc.cod-refer    = item-doc-orig-nfe.cod-refer:
                                ASSIGN de-qtd-saldo = de-qtd-saldo + (saldo-terc.quantidade - saldo-terc.dec-1).
                            END.
                            
                            /* Reposicionando a saldo-terc.              **
                            ** O posicionamento usando for each ‚ falho. */
                            find first saldo-terc no-lock
                                where saldo-terc.cod-emitente = bf{&TableName}.cod-emitente
                                and   saldo-terc.it-codigo    = item-doc-orig-nfe.it-codigo
                                and   saldo-terc.cod-refer    = item-doc-orig-nfe.cod-refer no-error.
                            
                            if avail saldo-terc then do:
                                run validaSaldoterc (output l-saldo-ok).
                                if l-saldo-ok then
                                    find first componente of saldo-terc no-lock no-error.
                                else
                                    assign l-erro-saldo = yes.
                            END.
                        END.
                    END.               

                    IF  avail natur-oper then do:
                        if natur-oper.tipo-compra  = 3 then do:     /* Devolu‡Æo de cliente    */
                            RUN utp/ut-msgs.p (INPUT "msg":U,
                                               INPUT 52356,
                                               INPUT item-doc-orig-nfe.it-codigo).
                                               
                            
                            CREATE msg-ret-nfe.
                            ASSIGN msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                                   msg-ret-nfe.idi-orig-trad      = 2
                                   msg-ret-nfe.dt-msg             = TODAY
                                   msg-ret-nfe.hr-msg             = STRING(TIME, "HH:MM:SS")
                                   msg-ret-nfe.log-ativo          = YES
                                   msg-ret-nfe.cd-msg             = 52356
                                   msg-ret-nfe.texto-msg          = RETURN-VALUE
                                   msg-ret-nfe.seq-msg            = NEXT-VALUE(seq-msg-ret-nfe)
                                   msg-ret-nfe.tipo-msg           = 2.
                            release msg-ret-nfe.
                        end.
                        else if (natur-oper.tp-oper-terc = 2  /* Retorno Beneficiamento  */ 
                             or  natur-oper.tp-oper-terc = 4  /* Faturamento consigna‡Æo */
                             OR  natur-oper.tp-oper-terc = 5  /* Devolucao Consignacao   */        
                             or  natur-oper.tp-oper-terc = 6) /* Reajuste de pre‡o       */ THEN do:
                       
                            {utp/ut-liter.i "Vincular_nota_de_sa¡da" *}
                            RUN utp/ut-msgs.p (INPUT "msg":U,
                                               INPUT 52312,
                                               INPUT item-doc-orig-nfe.it-codigo + "~~" + RETURN-VALUE).
                                               
                            
                            CREATE msg-ret-nfe.
                            ASSIGN msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                                   msg-ret-nfe.idi-orig-trad      = 2
                                   msg-ret-nfe.dt-msg             = TODAY
                                   msg-ret-nfe.hr-msg             = STRING(TIME, "HH:MM:SS")
                                   msg-ret-nfe.log-ativo          = YES
                                   msg-ret-nfe.cd-msg             = 52312
                                   msg-ret-nfe.texto-msg          = RETURN-VALUE
                                   msg-ret-nfe.seq-msg            = NEXT-VALUE(seq-msg-ret-nfe)
                                   l-ok = NO.
                            release msg-ret-nfe.
                            leave blocoNota.
                        end.
                    end.

                    IF  AVAIL natur-oper
                    AND AVAIL saldo-terc
                    AND AVAIL componente THEN
                        /* roda a procedure que valida a item-doc-orig-nfe e cria a tt-item-doc-est */
                        RUN criaItemNotaRefer.
                    ELSE DO:
                        IF AVAIL natur-oper AND NOT natur-oper.transf THEN DO:

                             ASSIGN de-desconto-item   = 0  /* Armazena o desconto do item corrente.      */
                                    de-frete-item      = 0  /* Armazena o frete do item corrente.         */
                                    de-seguro-item     = 0  /* Armazena o seguro do item corrente.        */
                                    de-outros-item     = 0  /* Armazena outras despesas do item corrente. */
                                    de-total-fifo      = 0  /* Inicializa o total em quantidade do FIFO para cada item. */
                                    de-total-fifo-emit = 0  /* Inicializa o total em quantidade do FIFO para cada item. */
                                    de-frete-unit      = 0  /* Inicializa o frete unitario do FIFO.       */
                                    de-desconto-unit   = 0. /* Inicializa o desconto unitario do FIFO.    */
                             
                             /*********************** DESPESAS DO ITEM ***********************/
                             /* Seta o desconto do item. */
                             if (    item-doc-orig-nfe.vl-desconto <> ?
                                 and item-doc-orig-nfe.vl-desconto <> 0) then
                                 assign l-desconto-item   = yes
                                        de-desconto-item  = item-doc-orig-nfe.vl-desconto
                                        de-total-desconto = de-total-desconto + de-desconto-item.
                        
                             /* Seta o frete do item. */
                             if (    item-doc-orig-nfe.vl-frete <> ?
                                 and item-doc-orig-nfe.vl-frete <> 0) then
                                 assign l-frete-item   = yes
                                        de-frete-item  = item-doc-orig-nfe.vl-frete
                                        de-total-frete = de-total-frete + de-frete-item.
                             
                             /* Seta as demais despesas do item. */
                             if (    item-doc-orig-nfe.vl-seguro <> ?
                                 and item-doc-orig-nfe.vl-seguro <> 0) then
                                 assign l-seguro-item   = yes
                                        de-seguro-item  = item-doc-orig-nfe.vl-seguro
                                        de-total-seguro = de-total-seguro + de-seguro-item.
                        
                             if (    item-doc-orig-nfe.vl-outros <> ?
                                 and item-doc-orig-nfe.vl-outros <> 0) then
                                 assign l-outros-item   = yes
                                        de-outros-item  = item-doc-orig-nfe.vl-outros
                                        de-total-outros = de-total-outros + de-outros-item.
                             /********************* FIM DESPESAS DO ITEM *********************/

                            /*--- Se encontrar pedidos/ordens informados na pasta 'Pedidos CC'
                                  do RE0118A, entao quebra o item em novas sequencias. ---*/
                            IF  item-doc-orig-nfe.log-fifo-oc 
                            AND CAN-FIND(FIRST tt-rat-ordem-orig-nfe-aux
                                         WHERE tt-rat-ordem-orig-nfe-aux.ch-acesso-comp-nfe = item-doc-orig-nfe.ch-acesso-comp-nfe
                                         AND   tt-rat-ordem-orig-nfe-aux.seq-item           = item-doc-orig-nfe.seq-item) then do:

                                if  l-desconto-item then
                                    assign de-desconto-unit  = de-desconto-item / item-doc-orig-nfe.qtd-comercial.
                                else 
                                    assign de-desconto-unit = 0.

                                if l-outros-item then
                                    assign de-outros-unit = de-outros-item / item-doc-orig-nfe.qtd-comercial.
                                else 
                                    assign de-outros-unit = 0.

                                if l-seguro-item then
                                    assign de-seguro-unit = de-seguro-item / item-doc-orig-nfe.qtd-comercial.
                                else 
                                    assign de-seguro-unit = 0.

                                if l-frete-item then
                                    assign de-frete-unit = de-frete-item / item-doc-orig-nfe.qtd-comercial.
                                else 
                                    assign de-frete-unit = 0.

                                assign de-soma-desconto-fifo = 0
                                       de-soma-outros-fifo   = 0
                                       de-soma-seguro-fifo   = 0
                                       de-soma-frete-fifo    = 0.

                                for each tt-rat-ordem-orig-nfe-aux
                                    where tt-rat-ordem-orig-nfe-aux.ch-acesso-comp-nfe = item-doc-orig-nfe.ch-acesso-comp-nfe
                                    and   tt-rat-ordem-orig-nfe-aux.seq-item           = item-doc-orig-nfe.seq-item
                                    break by tt-rat-ordem-orig-nfe-aux.ctrl-quebra:
                                    
                                   for first medicao-contrat
                                       where medicao-contrat.nr-contrato     = tt-rat-ordem-orig-nfe-aux.nr-contrato
                                         and medicao-contrat.num-seq-item    = tt-rat-ordem-orig-nfe-aux.num-seq-item
                                         and medicao-contrat.numero-ordem    = tt-rat-ordem-orig-nfe-aux.numero-ordem
                                         and medicao-contrat.num-seq-event   = tt-rat-ordem-orig-nfe-aux.num-seq-event
                                         and medicao-contrat.num-seq-medicao = tt-rat-ordem-orig-nfe-aux.num-seq-medicao no-lock:
                                   end.                                    
                                    
                                    /* Soma as quantidades selecionadas por FIFO para setar a quantidade da nota. */
                                    assign de-soma-fifo       = de-soma-fifo       + tt-rat-ordem-orig-nfe-aux.qtd-interna 
                                           de-soma-fifo-emit  = de-soma-fifo-emit  + tt-rat-ordem-orig-nfe-aux.val-quant-emit
                                           de-total-fifo      = de-total-fifo      + tt-rat-ordem-orig-nfe-aux.qtd-interna    /* Nao ‚ zerada ao quebrar os itens. */
                                           de-total-fifo-emit = de-total-fifo-emit + tt-rat-ordem-orig-nfe-aux.val-quant-emit  /* Nao ‚ zerada ao quebrar os itens. */
                                           tt-rat-ordem-orig-nfe-aux.seq-item-doc-est = i-seq-item.
                                    
                                    if first-of(ctrl-quebra) then do:                                   
                                        assign c-cod-depos      = ""
                                               c-cod-localiz    = ""
                                               c-cod-refer      = ""
                                               i-nr-ord-produ   = 0.
                                               

                                        /*--- Sugestao de localizacao unica e Verificacao o item gera CQ ---*/
                                        for first item-uni-estab fields (cod-localiz loc-unica contr-qualid) no-lock
                                            where item-uni-estab.it-codigo   = item-doc-orig-nfe.it-codigo
                                            and   item-uni-estab.cod-estabel = bf{&TableName}.cod-estabel:
                                            if item-uni-estab.loc-unica then
                                                assign c-cod-localiz = item-uni-estab.cod-localiz.
                                        end.
                                        
                                        
                                        /*--- Sugestao referencia ---*/
                                        for first item fields () no-lock
                                            where item.it-codigo    = item-doc-orig-nfe.it-codigo
                                            and   item.tipo-con-est = 4, /* Referˆncia */
                                            first prazo-compra fields (cod-refer) no-lock
                                                where prazo-compra.numero-ordem = tt-rat-ordem-orig-nfe-aux.numero-ordem
                                                and   prazo-compra.parcela      = tt-rat-ordem-orig-nfe-aux.parcela:
                                                assign c-cod-refer = prazo-compra.cod-refer.
                                        end.
                                      
                                        /*--- ORDEM DE PRODUCAO ---*/
                                        for first ordem-compra fields (ordem-servic dep-almoxar numero-ordem cod-unid-negoc ct-codigo) no-lock
                                            where ordem-compra.numero-ordem = tt-rat-ordem-orig-nfe-aux.numero-ordem:   /* 14789 - Alterado para comparar apenas a OC e pegar a unidade de negocio da Ordem de compra*/

                                            if ordem-compra.ordem-servic <> 0 then
                                                assign i-nr-ord-produ = ordem-compra.ordem-servic.

                                            // caso seja item com CQ, o deposito de CQ j  ir  constar na item-doc-orig-nfe.cod-depos
                                            if avail item-uni-estab and not item-uni-estab.contr-qualid then
                                                assign c-cod-depos = ordem-compra.dep-almoxar.

                                            IF  CAN-FIND(FIRST unid-neg-ordem 
                                                         WHERE unid-neg-ordem.numero-ordem = ordem-compra.numero-ordem) THEN
                                                ASSIGN c-cod-unid-negoc = "":U.
                                            ELSE 
                                                ASSIGN c-cod-unid-negoc = if ordem-compra.ct-codigo <> "" then ordem-compra.cod-unid-negoc else "".
                                            
                                        end.
                                    end.

                                    
                                    /* EFETIVA A QUEBRA DE FIFO MANUAL. */
                                    IF  LAST-OF(tt-rat-ordem-orig-nfe-aux.ctrl-quebra) THEN DO:
                                        
                                        FIND FIRST tt-item-doc-est
                                             WHERE tt-item-doc-est.serie-docto    = bf{&TableName}.serie-docto 
                                               AND tt-item-doc-est.nro-docto      = bf{&TableName}.nro-docto   
                                               AND tt-item-doc-est.cod-emitente   = bf{&TableName}.cod-emitente
                                               AND tt-item-doc-est.nat-operacao   = tt-natureza.nat-oper-agrup /* Se usa ou ¤ M£lt. Natur, usa o novo campo */
                                               AND tt-item-doc-est.sequencia      = i-seq-item NO-ERROR.
                                              
                                        IF  NOT AVAIL tt-item-doc-est THEN
                                            CREATE tt-item-doc-est.
                                        
                                        ASSIGN tt-item-doc-est.serie-docto    = bf{&TableName}.serie-docto
                                               tt-item-doc-est.nro-docto      = bf{&TableName}.nro-docto       
                                               tt-item-doc-est.cod-emitente   = bf{&TableName}.cod-emitente
                                               tt-item-doc-est.nat-operacao   = tt-natureza.nat-oper-agrup /* Se usa ou nÆo M£lt. Natur usa o novo campo */
                                               tt-item-doc-est.sequencia      = i-seq-item
                                               i-seq-item                     = i-seq-item + param-re.inc-seq /* Ver se a sequencia fica certa. */
                                               tt-item-doc-est.it-codigo      = item-doc-orig-nfe.it-codigo
                                               /* Como a quantidade do item vem de uma tabela relacionada que pode quebrar o item em   **
                                               ** diversas sequencias, o preco total da sequencia pode nao corresponder ao preco total **
                                               ** da item-doc-orig-nfe. Portanto, eh obrigatorio recalcular o preco total a partir do   **
                                               ** total da quantidade na unidade do emitente e do preco unitario da item-doc-orig-nfe. */
                                               tt-item-doc-est.qt-do-forn     = if available medicao-contrat then item-doc-orig-nfe.qtd-comercial else de-soma-fifo-emit /* Total FIFO UN Fornecedor. */
                                               tt-item-doc-est.quantidade     = if available medicao-contrat then item-doc-orig-nfe.qtd-interna else de-soma-fifo      /* Total FIFO UN Interna.    */
                                               tt-item-doc-est.preco-unit[1]  = item-doc-orig-nfe.preco-unit
                                               tt-item-doc-est.preco-total[1] = round((tt-item-doc-est.preco-unit[1] * tt-item-doc-est.qt-do-forn), 5)
                                               /* Informacoes relacionamento FIFO. */ 
                                               tt-item-doc-est.num-pedido     = 0 
                                               tt-item-doc-est.numero-ordem   = 0 
                                               tt-item-doc-est.parcela        = 0 
                                               tt-item-doc-est.ct-codigo      = if l-fatura-ent-futura then vl-ct-codigo else tt-rat-ordem-orig-nfe-aux.ct-codigo
                                               tt-item-doc-est.sc-codigo      = if l-fatura-ent-futura then vl-sc-codigo else tt-rat-ordem-orig-nfe-aux.sc-codigo
                                               tt-item-doc-est.num-ord-inv    = tt-rat-ordem-orig-nfe-aux.num-ord-inv
                                               tt-item-doc-est.nr-ord-produ   = if  i-nr-ord-produ > 0 then 
                                                                                    i-nr-ord-produ
                                                                                else 
                                                                                    item-doc-orig-nfe.nr-ord-produ
                                               tt-item-doc-est.encerra-pa     = no
                                               tt-item-doc-est.un             = unid-item-doc-est
                                               tt-item-doc-est.desconto[1]    = trunc(de-desconto-unit * tt-item-doc-est.qt-do-forn, 2)
                                               tt-item-doc-est.class-fiscal   = item-doc-orig-nfe.class-fiscal
                                               tt-item-doc-est.log-1          = YES 
                                               tt-item-doc-est.log-fifo-oc    = YES
                                               tt-item-doc-est.cod-refer      = if  c-cod-refer > "" then
                                                                                    c-cod-refer 
                                                                                else 
                                                                                    item-doc-orig-nfe.cod-refer     
                                               tt-item-doc-est.cod-depos      = if  c-cod-depos > "" then 
                                                                                    c-cod-depos
                                                                                else
                                                                                    item-doc-orig-nfe.cod-depos     
                                               tt-item-doc-est.cod-localiz    = if  c-cod-localiz > "" then
                                                                                    c-cod-localiz
                                                                                else
                                                                                    item-doc-orig-nfe.cod-localiz   
                                               tt-item-doc-est.lote           = item-doc-orig-nfe.lote-serie          
                                               tt-item-doc-est.dt-vali-lote   = item-doc-orig-nfe.dt-vali-lote
                                               tt-item-doc-est.valor-frete    = trunc(de-frete-unit * tt-item-doc-est.qt-do-forn, 2)
                                               tt-item-doc-est.pr-total-cmi   = tt-item-doc-est.valor-frete
                                               tt-item-doc-est.despesas[1]    = tt-item-doc-est.valor-frete
                                                                                + trunc(de-seguro-unit * tt-item-doc-est.qt-do-forn, 2)
                                                                                + trunc(de-outros-unit * tt-item-doc-est.qt-do-forn, 2)
                                               tt-item-doc-est.cod-unid-negoc = c-cod-unid-negoc
                                               tt-item-doc-est.int-1          = item-doc-orig-nfe.int-1
                                               tt-item-doc-est.narrativa      = item-doc-orig-nfe.narrativa
                                               tt-item-doc-est.nat-of         = item-doc-orig-nfe.nat-operacao /* Sempre salva a natureza fiscal do item */
                                               OVERLAY(tt-item-doc-est.char-2,832,5) = STRING(item-doc-orig-nfe.seq-item) /* Grava a sequencia do item do monitor nfe */
                                               tt-item-doc-est.ind-bem-movel-usado   = IF lNT2024002 THEN item-doc-orig-nfe.ind-bem-movel-usado else no
                                               tt-item-doc-est.log-doacao            = IF lNT2024002 THEN item-doc-orig-nfe.log-doacao else no
                                               tt-item-doc-est.ano-mes-apuracao      = IF lNT2024002 THEN item-doc-orig-nfe.ano-mes-apuracao ELSE "".
                                           
                                        
                                        
                                        /* Calcula as aliquotas dos impostos. */
                                        if  item-doc-orig-nfe.int-2  <> 23 then
                                            RUN pi-item-fiscal.
                                        
                                        /* Ao fim da quebra atual, zera as variaveis para uso na proxima quebra. */
                                        assign de-soma-fifo          = 0 
                                               de-soma-fifo-emit     = 0
                                               de-soma-outros-fifo   = de-soma-outros-fifo   + trunc(de-outros-unit * tt-item-doc-est.qt-do-forn, 2)
                                               de-soma-seguro-fifo   = de-soma-seguro-fifo   + trunc(de-seguro-unit * tt-item-doc-est.qt-do-forn, 2)
                                               de-soma-frete-fifo    = de-soma-frete-fifo    + tt-item-doc-est.valor-frete
                                               de-soma-desconto-fifo = de-soma-desconto-fifo + tt-item-doc-est.desconto[1].
                                        
                                        if l-integra-ems-his then do:
                                        
                                             ASSIGN OVERLAY(tt-item-doc-est.char-2,452,50)  = string(tt-rat-ordem-orig-nfe-aux.cod-barras)
                                                    overlay(tt-item-doc-est.char-2,600,9)   = string(tt-rat-ordem-orig-nfe-aux.cdn-fabrican).
                                             
                                             find first rat-lote-medic-nfe
                                                  where rat-lote-medic-nfe.ch-acesso-comp-nfe = item-doc-orig-nfe.ch-acesso-comp-nfe
                                                  and   rat-lote-medic-nfe.idi-orig-trad      = 2
                                                  and   rat-lote-medic-nfe.seq-item           = item-doc-orig-nfe.seq-item no-lock no-error.  
                                             if avail rat-lote-medic-nfe then   
                                                 assign tt-item-doc-est.cod-lote-fabrican       = rat-lote-medic-nfe.cod-lote-fabrican
                                                        tt-item-doc-est.dat-valid-lote-fabrican = rat-lote-medic-nfe.dat-valid-lote-fabrican.
                                             
                                        end.


                                    end.
                                end.
                                run executarEngineRecSemPedido (input  item-doc-orig-nfe.seq-item,
                                                                output l-sem-pedido).        
                                
                                /* Apos ser realizada toda a quebra de FIFO, valida se foi selecionada quantidade suficiente. */
                                if available medicao-contrat then
                                    assign de-total-fifo = round((tt-item-doc-est.preco-total[1] / tt-item-doc-est.preco-unit[1]), 2).
                                
                                if  de-total-fifo < item-doc-orig-nfe.qtd-interna then do:
                                    
                                    /*--- CHAMADOS TDJQD5/TEVA20 ---*/
                                    if  c-nom-prog-upc-mg97 <> "" then do:
                                        for each  tt-epc
                                            where tt-epc.cod-event = "RecNotaSemBaixarPed":
                                            delete tt-epc.
                                        end.
                                
                                        create tt-epc.
                                        assign tt-epc.cod-event     = "RecNotaSemBaixarPed"
                                               tt-epc.cod-parameter = "sem-pedido".
                                
                                        {include/i-epc201.i "RecNotaSemBaixarPed"}
                                
                                        for first tt-epc
                                            where tt-epc.cod-event     = "RecNotaSemBaixarPed"
                                            and   tt-epc.cod-parameter = "sem-pedido"
                                            and   tt-epc.val-parameter = "valida":
                                            assign l-sem-pedido = no.
                                        end.
                                    end.
                                    
                                    if  avail param-re
                                    and l-sem-pedido then do:

                                        find first tt-item-doc-est
                                             where tt-item-doc-est.serie-docto    = bf{&TableName}.serie-docto 
                                               and tt-item-doc-est.nro-docto      = bf{&TableName}.nro-docto   
                                               and tt-item-doc-est.cod-emitente   = bf{&TableName}.cod-emitente
                                               and tt-item-doc-est.nat-operacao   = tt-natureza.nat-oper-agrup /* Se usa ou nÆo M£lt. Natur usa o novo campo */
                                               and tt-item-doc-est.sequencia      = i-seq-item no-error.
                                              
                                        if  not avail tt-item-doc-est then
                                                create tt-item-doc-est.

                                        assign tt-item-doc-est.serie-docto    = bf{&TableName}.serie-docto
                                               tt-item-doc-est.nro-docto      = bf{&TableName}.nro-docto       
                                               tt-item-doc-est.cod-emitente   = bf{&TableName}.cod-emitente
                                               tt-item-doc-est.nat-operacao   = tt-natureza.nat-oper-agrup  /* Se usa ou nÆo M£lt. Natur usa o novo campo */
                                               tt-item-doc-est.sequencia      = i-seq-item
                                               i-seq-item                     = i-seq-item + param-re.inc-seq /* Ver se a sequencia fica certa. */

                                               tt-item-doc-est.it-codigo      = if avail item-fornec then item-fornec.it-codigo 
                                                                                else item-doc-orig-nfe.it-codigo
                                               /* Como a quantidade do item vem de uma tabela relacionada que pode quebrar o item em   **
                                               ** diversas sequencias, o preco total da sequencia pode nao corresponder ao preco total **
                                               ** da item-doc-orig-nfe. Portanto, ‚ obrigatorio recalcular o preco total a partir do   **
                                               ** total da quantidade na unidade do emitente e do preco unitario da item-doc-orig-nfe. */
                                               tt-item-doc-est.qt-do-forn     = round((item-doc-orig-nfe.qtd-comercial - de-total-fifo-emit), 5)
                                               tt-item-doc-est.quantidade     = round((item-doc-orig-nfe.qtd-interna - de-total-fifo), 5)
                                               tt-item-doc-est.preco-unit[1]  = item-doc-orig-nfe.preco-unit
                                               tt-item-doc-est.preco-total[1] = round((tt-item-doc-est.preco-unit[1] * tt-item-doc-est.qt-do-forn), 5)
                                               tt-item-doc-est.num-pedido     = 0
                                               tt-item-doc-est.numero-ordem   = 0
                                               tt-item-doc-est.parcela        = 0
                                               tt-item-doc-est.nr-ord-produ   = item-doc-orig-nfe.nr-ord-produ
                                               tt-item-doc-est.encerra-pa     = no
                                               tt-item-doc-est.un             = unid-item-doc-est
                                               tt-item-doc-est.class-fiscal   = item-doc-orig-nfe.class-fiscal
                                               tt-item-doc-est.desconto[1]    = trunc(de-desconto-unit * tt-item-doc-est.qt-do-forn, 2)
                                               tt-item-doc-est.log-1          = yes /*item-doc-orig-nfe.log-fifo-oc*/
                                               tt-item-doc-est.log-fifo-oc    = yes /*item-doc-orig-nfe.log-fifo-oc*/
                                               tt-item-doc-est.ct-codigo      = item-doc-orig-nfe.ct-codigo
                                               tt-item-doc-est.cod-refer      = item-doc-orig-nfe.cod-refer
                                               tt-item-doc-est.cod-depos      = item-doc-orig-nfe.cod-depos
                                               tt-item-doc-est.cod-localiz    = item-doc-orig-nfe.cod-localiz
                                               tt-item-doc-est.lote           = item-doc-orig-nfe.lote-serie          
                                               tt-item-doc-est.dt-vali-lote   = item-doc-orig-nfe.dt-vali-lote
                                               tt-item-doc-est.valor-frete    = trunc(de-frete-unit * tt-item-doc-est.qt-do-forn, 2)
                                               tt-item-doc-est.pr-total-cmi   = tt-item-doc-est.valor-frete
                                               tt-item-doc-est.despesas[1]    = tt-item-doc-est.valor-frete
                                                                                + trunc(de-seguro-unit * tt-item-doc-est.qt-do-forn, 2)
                                                                                + trunc(de-outros-unit * tt-item-doc-est.qt-do-forn, 2)
                                               tt-item-doc-est.cod-unid-negoc = item-doc-orig-nfe.cod-unid-negoc
                                               tt-item-doc-est.int-1          = item-doc-orig-nfe.int-1
                                               tt-item-doc-est.narrativa      = item-doc-orig-nfe.narrativa
                                               tt-item-doc-est.nat-of         = item-doc-orig-nfe.nat-operacao /* Sempre salva a natureza fiscal do item */
                                               OVERLAY(tt-item-doc-est.char-2,832,5) = STRING(item-doc-orig-nfe.seq-item) /* Grava a sequencia do item do monitor nfe */
                                               tt-item-doc-est.ind-bem-movel-usado   = IF lNT2024002 THEN item-doc-orig-nfe.ind-bem-movel-usado else no
                                               tt-item-doc-est.log-doacao            = IF lNT2024002 THEN item-doc-orig-nfe.log-doacao else no
                                               tt-item-doc-est.ano-mes-apuracao      = IF lNT2024002 THEN item-doc-orig-nfe.ano-mes-apuracao ELSE "".
                                        
                                        IF tt-item-doc-est.ct-codigo = "" AND AVAIL ITEM AND (ITEM.tipo-contr = 1 OR ITEM.tipo-contr = 4) THEN 
                                           ASSIGN tt-item-doc-est.ct-codigo = item.ct-codigo 
                                                  tt-item-doc-est.sc-codigo = item.sc-codigo.
                                                          
                                        /* Calcula as aliquotas dos impostos. */
                                        if  item-doc-orig-nfe.int-2  <> 23 then
                                            RUN pi-item-fiscal.

                                        assign de-soma-outros-fifo   = de-soma-outros-fifo   + trunc(de-outros-unit * tt-item-doc-est.qt-do-forn, 2)
                                               de-soma-seguro-fifo   = de-soma-seguro-fifo   + trunc(de-seguro-unit * tt-item-doc-est.qt-do-forn, 2)
                                               de-soma-frete-fifo    = de-soma-frete-fifo    + tt-item-doc-est.valor-frete
                                               de-soma-desconto-fifo = de-soma-desconto-fifo + tt-item-doc-est.desconto[1].
                                               
                                        if l-integra-ems-his then do:
                                        
                                             ASSIGN OVERLAY(tt-item-doc-est.char-2,452,50)  = string(tt-rat-ordem-orig-nfe-aux.cod-barras)
                                                    overlay(tt-item-doc-est.char-2,600,9)   = string(tt-rat-ordem-orig-nfe-aux.cdn-fabrican).
                                             
                                             find first rat-lote-medic-nfe
                                                  where rat-lote-medic-nfe.ch-acesso-comp-nfe = item-doc-orig-nfe.ch-acesso-comp-nfe
                                                  and   rat-lote-medic-nfe.idi-orig-trad      = 2
                                                  and   rat-lote-medic-nfe.seq-item           = item-doc-orig-nfe.seq-item no-lock no-error.  
                                             if avail rat-lote-medic-nfe then   
                                                 assign tt-item-doc-est.cod-lote-fabrican       = rat-lote-medic-nfe.cod-lote-fabrican
                                                        tt-item-doc-est.dat-valid-lote-fabrican = rat-lote-medic-nfe.dat-valid-lote-fabrican.
                                        
                                        end.

                                    end.
                                    else do:
                                        
                                        /* Nao permite gerar nota sem saldar todo o FIFO manual. */
                                        for each bfmsg-ret-nfe no-lock
                                            where bfmsg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                                            and   bfmsg-ret-nfe.idi-orig-trad      = 2:
                                        
                                            for first msg-ret-nfe exclusive-lock
                                                where msg-ret-nfe.seq-msg = bfmsg-ret-nfe.seq-msg:
                                                assign msg-ret-nfe.log-ativo = no.
                                            end.
                                            release msg-ret-nfe.
                                        end.

                                        /*--- Este erro sera criado apenas para o FIFO manual ---*/
                                        create msg-ret-nfe.
                                        assign msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                                               msg-ret-nfe.idi-orig-trad      = 2
                                               msg-ret-nfe.dt-msg             = today
                                               msg-ret-nfe.hr-msg             = string(time, "HH:MM:SS")
                                               msg-ret-nfe.log-ativo          = yes
                                               msg-ret-nfe.cd-msg             = 17006
                                               msg-ret-nfe.texto-msg          = "Quantidade " + string(de-total-fifo) + " selecionada por FIFO insuficiente para o item " + string(item-doc-orig-nfe.seq-item) + "."
                                               msg-ret-nfe.seq-msg            = next-value(seq-msg-ret-nfe)
                                               l-ok                           = no.
                                        release msg-ret-nfe.
                                        leave blocoNota.
                                    end.
                                end.

                                /* Calcula o desconto residual do item para acertar os valores caso **
                                ** o desconto total dos itens tenha sido arredondado pelo programa. */
                                if l-desconto-item then do:

                                    if de-soma-desconto-fifo < de-desconto-item then do:
                                        assign tt-item-doc-est.desconto[1] = tt-item-doc-est.desconto[1] + (de-desconto-item - de-soma-desconto-fifo).
                                    end.
                                end.

                                /* Calcula outros valores residuais do item e soma na despesa. */
                                if l-outros-item then do:
                                    if de-soma-outros-fifo < de-outros-item then do:
                                        assign tt-item-doc-est.despesas[1] = tt-item-doc-est.despesas[1] + (de-outros-item - de-soma-outros-fifo).
                                    end.
                                end.

                                /* Calcula valores residuais do seguro do item e soma na despesa. */
                                if l-seguro-item then do:
                                    if de-soma-seguro-fifo < de-seguro-item then do:
                                        assign tt-item-doc-est.despesas[1] = tt-item-doc-est.despesas[1] + (de-seguro-item - de-soma-seguro-fifo).
                                    end.
                                end.

                                if l-frete-item then do:
                                    if de-soma-frete-fifo < de-frete-item then do:
                                        assign tt-item-doc-est.valor-frete  = tt-item-doc-est.valor-frete + (de-frete-item - de-soma-frete-fifo)
                                               tt-item-doc-est.pr-total-cmi = tt-item-doc-est.valor-frete
                                               tt-item-doc-est.despesas[1]  = tt-item-doc-est.despesas[1] + (de-frete-item - de-soma-frete-fifo).
                                    end.
                                end.
                            end.
                            else do:
                            
                                /*--- Se nao encontrar pedidos/ordens informados na pasta 'Pedidos CC' do 
                                      RE0118A, entao cria o item normalmente ---*/
        
                                /* Preenchimento das despesas do item */
                                assign de-despesas-item = 0.
                                
                                if item-doc-orig-nfe.vl-frete <> ? and item-doc-orig-nfe.vl-frete <> 0 then 
                                    assign de-despesas-item = item-doc-orig-nfe.vl-frete.
                                else if not l-vfrete-it then do:
                                    if  bf{&TableName}.valor-produto <> 0 /* Quando for Servi‡o vem zerada esta tag */ then do:
                                        assign de-val-frete-item = truncate(((bf{&TableName}.valor-frete * round(item-doc-orig-nfe.preco-total, 5)) 
                                                                             / bf{&TableName}.valor-produto),2)
                                               de-despesas-item = de-val-frete-item.
                                    end.
                                end.
                                
                                if item-doc-orig-nfe.vl-outros <> ? then
                                    assign de-despesas-item = de-despesas-item + item-doc-orig-nfe.vl-outros.
                                else if not l-voutro-it and
                                        bf{&TableName}.valor-outros  <> 0 and
                                        bf{&TableName}.valor-produto <> 0 /* Quando for Servi‡o vem zerada esta tag */ then
                                    assign de-despesas-item =  de-despesas-item + truncate(((bf{&TableName}.valor-outros * round(item-doc-orig-nfe.preco-total, 5)) 
                                                                                           / bf{&TableName}.valor-produto),2).
                                                                                           
                                if item-doc-orig-nfe.vl-seguro <> ? then
                                    assign de-despesas-item = de-despesas-item + item-doc-orig-nfe.vl-seguro.
                                else if not l-vseg-it and 
                                        bf{&TableName}.valor-seguro  <> 0 and
                                        bf{&TableName}.valor-produto <> 0 /* Quando for Servi‡o vem zerada esta tag */ then
                                    assign de-despesas-item = de-despesas-item + truncate(((bf{&TableName}.valor-seguro * round(item-doc-orig-nfe.preco-total, 5)) 
                                                                                    / bf{&TableName}.valor-produto),2).
                                    
                                /* FIM - Preenchimento das despesas do item */
                                
                                CREATE tt-item-doc-est.
                                ASSIGN tt-item-doc-est.serie-docto            = bf{&TableName}.serie-docto     
                                       tt-item-doc-est.nro-docto              = bf{&TableName}.nro-docto       
                                       tt-item-doc-est.cod-emitente           = bf{&TableName}.cod-emitente    
                                       tt-item-doc-est.nat-operacao           = tt-natureza.nat-oper-agrup  /* Se usa ou nÆo M£lt. Natur usa o novo campo */
                                       tt-item-doc-est.sequencia              = i-seq-item                     
                                       i-seq-item                             = i-seq-item + param-re.inc-seq  
                            
                                       tt-item-doc-est.it-codigo              = IF AVAIL item-fornec THEN item-fornec.it-codigo ELSE item-doc-orig-nfe.it-codigo
                                       tt-item-doc-est.num-pedido             = item-doc-orig-nfe.num-pedido  
                                       tt-item-doc-est.numero-ordem           = item-doc-orig-nfe.numero-ordem
                                       tt-item-doc-est.parcela                = item-doc-orig-nfe.parcela     
                                       tt-item-doc-est.encerra-pa             = IF item-doc-orig-nfe.encerra-pa = ? THEN NO ELSE item-doc-orig-nfe.encerra-pa
                                       tt-item-doc-est.nr-ord-produ           = item-doc-orig-nfe.nr-ord-produ
                                       tt-item-doc-est.qt-do-forn             = item-doc-orig-nfe.qtd-comercial
                                       tt-item-doc-est.un                     = unid-item-doc-est
                                       tt-item-doc-est.quantidade             = item-doc-orig-nfe.qtd-interna
                                       tt-item-doc-est.desconto[1]            = IF item-doc-orig-nfe.vl-desconto = ? THEN 0 ELSE item-doc-orig-nfe.vl-desconto
                                       tt-item-doc-est.preco-unit[1]          = round(item-doc-orig-nfe.preco-unit, 5)
                                       tt-item-doc-est.preco-total[1]         = round(item-doc-orig-nfe.preco-total, 5)
                                       tt-item-doc-est.class-fiscal           = item-doc-orig-nfe.class-fiscal
                                       tt-item-doc-est.log-1                  = l-fifo-oc
                                       tt-item-doc-est.log-fifo-oc            = l-fifo-oc
                                       tt-item-doc-est.ct-codigo              = if l-fatura-ent-futura then vl-ct-codigo else item-doc-orig-nfe.ct-codigo
                                       tt-item-doc-est.sc-codigo              = if l-fatura-ent-futura then vl-sc-codigo else item-doc-orig-nfe.sc-codigo
                                       tt-item-doc-est.cod-refer              = item-doc-orig-nfe.cod-refer     
                                       tt-item-doc-est.cod-depos              = item-doc-orig-nfe.cod-depos     
                                       tt-item-doc-est.cod-localiz            = item-doc-orig-nfe.cod-localiz   
                                       tt-item-doc-est.lote                   = item-doc-orig-nfe.lote-serie          
                                       tt-item-doc-est.dt-vali-lote           = item-doc-orig-nfe.dt-vali-lote
                                       tt-item-doc-est.pr-total-cmi           = if item-doc-orig-nfe.vl-frete = ? or item-doc-orig-nfe.vl-frete = 0 then de-val-frete-item else item-doc-orig-nfe.vl-frete                              
                                       tt-item-doc-est.despesas[1]            = de-despesas-item 
                                       tt-item-doc-est.cod-unid-negoc         = item-doc-orig-nfe.cod-unid-negoc
                                       tt-item-doc-est.int-1                  = item-doc-orig-nfe.int-1
                                       tt-item-doc-est.narrativa              = item-doc-orig-nfe.narrativa
                                       tt-item-doc-est.nat-of                 = item-doc-orig-nfe.nat-operacao /* Sempre salva a natureza fiscal do item */
                                       OVERLAY(tt-item-doc-est.char-2,832,5)  = STRING(item-doc-orig-nfe.seq-item) /* Grava a sequencia do item do monitor nfe */
                                       tt-item-doc-est.ind-bem-movel-usado   = IF lNT2024002 THEN item-doc-orig-nfe.ind-bem-movel-usado else no
                                       tt-item-doc-est.log-doacao            = IF lNT2024002 THEN item-doc-orig-nfe.log-doacao else no
                                       tt-item-doc-est.ano-mes-apuracao      = IF lNT2024002 THEN item-doc-orig-nfe.ano-mes-apuracao ELSE "".
                                
                                
                                IF tt-item-doc-est.ct-codigo = "" AND AVAIL ITEM AND (ITEM.tipo-contr = 1 OR ITEM.tipo-contr = 4) THEN 
                                   ASSIGN tt-item-doc-est.ct-codigo = item.ct-codigo 
                                          tt-item-doc-est.sc-codigo = item.sc-codigo.                                
                                          
                                if  item-doc-orig-nfe.int-2  <> 23 then                                       
                                    RUN pi-item-fiscal.
        
                                ASSIGN tt-item-doc-est.peso-liquido   = DEC(STRING(item-doc-orig-nfe.peso-liq, ">>>>,>>9.99999")) NO-ERROR.
                                
                                if l-integra-ems-his then do:
                                     
                                     find first rat-lote-medic-nfe
                                          where rat-lote-medic-nfe.ch-acesso-comp-nfe = item-doc-orig-nfe.ch-acesso-comp-nfe
                                          and   rat-lote-medic-nfe.seq-item           = item-doc-orig-nfe.seq-item no-lock no-error.  
                                     if avail rat-lote-medic-nfe then   
                                         assign tt-item-doc-est.cod-lote-fabrican       = rat-lote-medic-nfe.cod-lote-fabrican
                                                tt-item-doc-est.dat-valid-lote-fabrican = rat-lote-medic-nfe.dat-valid-lote-fabrican
                                                OVERLAY(tt-item-doc-est.char-2,452,50)  = rat-lote-medic-nfe.cod-barras.

                                        find first ordem-compra
                                             where ordem-compra.numero-ordem = item-doc-orig-nfe.numero-ordem no-lock no-error.

                                        IF  AVAIL ordem-compra THEN DO:
                                            FOR FIRST cotacao-item fields(cdn-fabrican)
                                                WHERE cotacao-item.cod-emitente = ordem-compra.cod-emitente
                                                  AND cotacao-item.numero-ordem = ordem-compra.numero-ordem
                                                  AND cotacao-item.data-cotacao = ordem-compra.data-cotacao NO-LOCK:
                                                ASSIGN overlay(tt-item-doc-est.char-2,600,9)= string(cotacao-item.cdn-fabrican).
                                            END.
                                        END.
                                                
                                end.
                
                                /** BUSCA PARCELA DA OC **/
                                IF  NOT l-fifo-oc 
                                AND item-doc-orig-nfe.numero-ordem > 0
                                AND item-doc-orig-nfe.parcela      = 0 THEN DO:
                                                       
                                    /* Aloca parcela mais antiga */
                                    for first prazo-compra no-lock
                                        where prazo-compra.numero-ordem = item-doc-orig-nfe.numero-ordem 
                                          and prazo-compra.situacao     = 2 
                                          and ( prazo-compra.quant-saldo - prazo-compra.dec-1 ) > 0  
                                           by prazo-compra.data-entrega
                                           by prazo-compra.numero-ordem
                                           BY prazo-compra.parcela:
                                        assign tt-item-doc-est.parcela  = prazo-compra.parcela.
                                    end.
                                    if  tt-item-doc-est.parcela = 0 then 
                                        for first prazo-compra no-lock
                                            where prazo-compra.numero-ordem = tt-it-doc-fisico.numero-ordem 
                                              and prazo-compra.situacao     = 2 
                                               by prazo-compra.data-entrega
                                               by prazo-compra.numero-ordem
                                               BY prazo-compra.parcela:
                                            assign tt-item-doc-est.parcela  = prazo-compra.parcela.
                                        end.
        
                                end.
                                
                                if  not avail ordem-compra
                                or  ordem-compra.numero-ordem <> item-doc-orig-nfe.numero-ordem then
                                    find first ordem-compra
                                         where ordem-compra.numero-ordem = item-doc-orig-nfe.numero-ordem no-lock no-error.                
                                if avail ordem-compra then do:
                                    if ordem-compra.ordem-servic <> 0 then do:
                                       if tt-item-doc-est.nr-ord-produ = 0 then 
                                            assign tt-item-doc-est.nr-ord-produ = ordem-compra.ordem-servic.
                                    end.
                                end.
                            end.
                        END.
                    end.
                END.
                
                release saldo-terc.
                release componente.

            END.
            /*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-* FIM -> ITENS DO DOCUMENTO *-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*/

            
            /* Rateio do frete e despesas do documento de acordo com os itens da nota. */
            assign de-valor-mercad        = 0
                   de-val-frete-docto     = 0
                   de-val-seguro-docto    = 0
                   de-val-outros-docto    = 0
                   i-seq-item-maior-valor = 0
                   de-maior-valor-item    = 0.
            
            for each tt-item-doc-est of tt-docum-est:
            
                if tt-item-doc-est.preco-total[1] > de-maior-valor-item and 
                   tt-item-doc-est.despesas[1] <> 0 then do:
                    assign i-seq-item-maior-valor = tt-item-doc-est.sequencia
                           de-maior-valor-item    = tt-item-doc-est.preco-total[1].
                end.


                /* Rateio de frete */
                if  tt-item-doc-est.pr-total-cmi = 0 and not l-vfrete-it then do:
                    if  bf{&TableName}.valor-produto <> 0 /* Quando for Servi‡o vem zerada esta tag */ then
                        assign de-val-frete-docto = de-val-frete-docto + truncate(((bf{&TableName}.valor-frete * tt-item-doc-est.preco-total[1]) 
                                                                                  / bf{&TableName}.valor-produto),2).
                end.
                else do:                                                                                    
                    assign de-val-frete-docto = de-val-frete-docto + tt-item-doc-est.pr-total-cmi.
                end.
                
                /* Rateio de seguro e outros despesas */
                find first tt-despesas-item where 
                           tt-despesas-item.seq-item     = tt-item-doc-est.sequencia    and 
                           tt-despesas-item.nat-operacao = tt-item-doc-est.nat-operacao no-error. 
                if avail tt-despesas-item then do:

                    /* Seguro */
                    if tt-despesas-item.vl-seguro = 0 and not l-vseg-it then do:
                        if  bf{&TableName}.valor-produto <> 0 /* Quando for Servi‡o vem zerada esta tag */ then
                            assign de-val-seguro-docto = de-val-seguro-docto + truncate(((bf{&TableName}.valor-seguro * tt-item-doc-est.preco-total[1]) 
                                                                                        / bf{&TableName}.valor-produto),2).
                    end.   
                    else do:
                        assign de-val-seguro-docto = de-val-seguro-docto + tt-despesas-item.vl-seguro.
                    end.
                    
                    /* Outras */ 
                    if tt-despesas-item.vl-outros = 0 and not l-voutro-it then do:
                        if  bf{&TableName}.valor-produto <> 0 /* Quando for Servi‡o vem zerada esta tag */ then
                            assign de-val-outros-docto = de-val-outros-docto + truncate(((bf{&TableName}.valor-outros * tt-item-doc-est.preco-total[1]) 
                                                                                        / bf{&TableName}.valor-produto),2).
                    end.
                    else do:
                        assign de-val-outros-docto = de-val-outros-docto + tt-despesas-item.vl-outros.
                    end.
                end.

                
                /* Valor total das mercadorias da nota */
                assign de-valor-mercad    = de-valor-mercad + tt-item-doc-est.preco-total[1].
            end.

            assign tt-docum-est.valor-frete  = de-val-frete-docto
                   tt-docum-est.valor-outras = de-val-outros-docto
                   tt-docum-est.valor-seguro = de-val-seguro-docto
                   de-total-frete            = de-total-frete  + tt-docum-est.valor-frete
                   de-total-seguro           = de-total-seguro + tt-docum-est.valor-seguro
                   de-total-outros           = de-total-outros + tt-docum-est.valor-outras
                   tt-docum-est.valor-mercad = de-valor-mercad
                   tt-docum-est.despesa-nota = tt-docum-est.valor-frete + tt-docum-est.valor-outras + tt-docum-est.valor-seguro.

            /* FIM - Rateio frete e despesas */
           
            /* S¢ vai colocar o desconto por documento quando nÆo tiver desconto por item */
            IF desconto-item = NO THEN do:
                IF bf{&TableName}.valor-desconto = ? THEN do:
                    ASSIGN tt-docum-est.tot-desconto =  0.
                end.
                ELSE do:
                    if  bf{&TableName}.valor-produto <> 0 /* Quando for Servi‡o vem zerada esta tag */ then
                        assign tt-docum-est.tot-desconto = (bf{&TableName}.valor-desconto * tt-docum-est.valor-mercad) / bf{&TableName}.valor-produto.
                end.
            end.
                
            /*PONTO UPC DENSO CHAMADO 864013*/
            IF c-nom-prog-dpc-mg97  <> ""
            OR c-nom-prog-upc-mg97  <> ""
            OR c-nom-prog-appc-mg97 <> "" THEN DO:

                EMPTY TEMP-TABLE tt-epc.

                create tt-epc.
                assign tt-epc.cod-event     = "RelacionarOP":U
                       tt-epc.cod-parameter = "tt-item-doc-est-handle"
                       tt-epc.val-parameter = string(TEMP-TABLE tt-item-doc-est:HANDLE).

                /* PARAMETRO UNIMED NORDESTE PAULISTA - CHAMADO TDXJNY. **
                ** PERMITE RELACIONAR ITEM-DOC-EST E ITEM-DOC-ORIG-NFE. */
                create tt-epc.
                assign tt-epc.cod-event     = "RelacionarOP"
                       tt-epc.cod-parameter = "ch-acesso-comp-nfe"
                       tt-epc.val-parameter = bf{&TableName}.ch-acesso-comp-nfe.

                /*** Chamada do programa EPC ***/
                {include/i-epc201.i  "RelacionarOP" }
            END.
            /*****************************************************/
            
            /** DUPLICATAS DO DOCUMENTO **/
            IF l-re0708 THEN DO:
                {utp/ut-liter.i "Gerando_Informa‡äes_Duplicatas..." *}
                RUN pi-acompanhar IN h-acomp(RETURN-VALUE).
            END.
            RUN geraDuplicatas (INPUT 1, INPUT ch-acesso).

            ASSIGN c-lista-naturezas = "". /* Zera lista para a pr¢xima nota */

        END. /* FOR EACH TT-NATUREZA */

        /* Ajustes de frete e despesas*/

        /* Leva a diferenca entre o total do frete e o frete do XML para a ultima nota. */
        IF  de-total-frete < bf{&TableName}.valor-frete THEN DO:
            FOR LAST tt-docum-est:
                ASSIGN tt-docum-est.valor-frete = tt-docum-est.valor-frete + (bf{&TableName}.valor-frete - de-total-frete).
                FOR FIRST tt-item-doc-est OF tt-docum-est WHERE tt-item-doc-est.sequencia = i-seq-item-maior-valor:            
                    ASSIGN tt-item-doc-est.pr-total-cmi = tt-item-doc-est.pr-total-cmi + (bf{&TableName}.valor-frete - de-total-frete)
                           tt-item-doc-est.despesas[1]  = tt-item-doc-est.despesas[1]  + (bf{&TableName}.valor-frete - de-total-frete).
                END.
            END.
        END.
        
        /* Leva a diferenca entre o total do seguro e o seguro do XML para a ultima nota. */
        IF  de-total-seguro < bf{&TableName}.valor-seguro THEN DO:
            FOR LAST tt-docum-est:
                ASSIGN tt-docum-est.valor-seguro = tt-docum-est.valor-seguro + (bf{&TableName}.valor-seguro - de-total-seguro).
                FOR FIRST tt-item-doc-est OF tt-docum-est WHERE tt-item-doc-est.sequencia = i-seq-item-maior-valor:
                    ASSIGN tt-item-doc-est.despesas[1] = tt-item-doc-est.despesas[1] + (bf{&TableName}.valor-seguro - de-total-seguro).
                END.
            END.
        END.
      
        /* Leva a diferenca entre o total das outras despesas e as despesas do XML para a ultima nota. */
        IF  de-total-outros < bf{&TableName}.valor-outros THEN DO:
            FOR LAST tt-docum-est:
                ASSIGN tt-docum-est.valor-outras = tt-docum-est.valor-outras + (bf{&TableName}.valor-outros - de-total-outros).
                FOR FIRST tt-item-doc-est OF tt-docum-est WHERE tt-item-doc-est.sequencia = i-seq-item-maior-valor:
                    ASSIGN tt-item-doc-est.despesas[1] = tt-item-doc-est.despesas[1] + (bf{&TableName}.valor-outros - de-total-outros).
                END.
            END.
        END.
        
        IF  l-erro-saldo THEN
            ASSIGN l-ok = NO.
            
        /*  Validar item em branco. */
        IF l-bloq-item-branco 
        and can-find(first item-doc-orig-nfe NO-LOCK
                     where item-doc-orig-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                     and   item-doc-orig-nfe.idi-orig-trad      = 2
                     and   trim(item-doc-orig-nfe.it-codigo)    = "") then do:

            create msg-ret-nfe.
            assign msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                   msg-ret-nfe.idi-orig-trad      = 2
                   msg-ret-nfe.dt-msg             = today
                   msg-ret-nfe.hr-msg             = string(time, "HH:MM:SS")
                   msg-ret-nfe.log-ativo          = yes
                   msg-ret-nfe.cd-msg             = 17567
                   msg-ret-nfe.texto-msg          = "Parƒmetro 'Bloqueio Item Branco' nÆo permite gerar documento com item branco."
                   msg-ret-nfe.seq-msg            = next-value(seq-msg-ret-nfe)
                   l-ok                           = no.
            release msg-ret-nfe.
            leave blocoNota.
        end.
        
        /* Validar se existe deposito informado quando houver rastro para operação de compra */
		
		assign de-seq-item-ant = 0.
		
		for each item-doc-orig-nfe NO-LOCK
		   where item-doc-orig-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
             and item-doc-orig-nfe.idi-orig-trad      = 2
			 and item-doc-orig-nfe.int-2              = 1: /*compra*/
			
            for each rat-lote-medic-nfe no-lock 
               where rat-lote-medic-nfe.ch-acesso-comp-nfe = item-doc-orig-nfe.ch-acesso-comp-nfe
                 and rat-lote-medic-nfe.seq-item           = item-doc-orig-nfe.seq-item
				 and rat-lote-medic-nfe.idi-orig-trad      = 2:
                
                if (not can-find(first deposito where deposito.cod-depos = rat-lote-medic-nfe.cod-depos) or
                    not can-find(first localizacao 
                                 where localizacao.cod-estabel = bf{&TableName}.cod-estabel /*doc-orig-nfe.cod-estabel*/
                                   and localizacao.cod-depos   = rat-lote-medic-nfe.cod-depos
                                   and localizacao.cod-localiz = rat-lote-medic-nfe.cod-localiz )) then do:
                                   
                    if de-seq-item-ant <> rat-lote-medic-nfe.seq-item then do:
                        
                        assign de-seq-item-ant = rat-lote-medic-nfe.seq-item.
            
                        RUN utp/ut-msgs.p (INPUT "msg":U,
                                           INPUT 28636,  /*NÆo foi encontrado &1 para &2.*/  
                                           INPUT "deposito/localiza‡Æo" + "~~":U + "o item de sequencia " + string(rat-lote-medic-nfe.seq-item)).                    
            
                        create msg-ret-nfe.
                        assign msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                               msg-ret-nfe.idi-orig-trad      = 2
                               msg-ret-nfe.dt-msg             = today
                               msg-ret-nfe.hr-msg             = string(time, "HH:MM:SS")
                               msg-ret-nfe.log-ativo          = yes
                               msg-ret-nfe.cd-msg             = 28636
                               msg-ret-nfe.texto-msg          = RETURN-VALUE
                               msg-ret-nfe.seq-msg            = next-value(seq-msg-ret-nfe)
                               l-ok                           = no.
                        
                        release msg-ret-nfe.
                    end.
                end.          
            end.
		end.
 
        for each item-doc-orig-nfe NO-LOCK
           where item-doc-orig-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
             and item-doc-orig-nfe.idi-orig-trad      = 2
             and item-doc-orig-nfe.int-2              = 2: /*devolucao*/
            
            if not can-find(first item-ref-nfe   /* Devolucao que nao tem nota origem/referenciada */
                            where item-ref-nfe.ch-acesso-comp-nfe = item-doc-orig-nfe.ch-acesso-comp-nfe
                              and item-ref-nfe.seq-item           = item-doc-orig-nfe.seq-item) then do:

                for first item no-lock where item.it-codigo = item-doc-orig-nfe.it-codigo:
                    if item.tipo-con-est <> 1
                    and (item-doc-orig-nfe.lote-serie = "" or item-doc-orig-nfe.lote-serie = ?) then do:										  
                        RUN implantaErroConfCadastroMsg(INPUT item-doc-orig-nfe.ch-acesso-comp-nfe,
                                                        INPUT 1818, //Lote deve ser diferente de branco
                                                        INPUT "Seq: ":U + STRING(item-doc-orig-nfe.seq-item),
                                                        INPUT 1).
                        assign l-ok = no.
                        release msg-ret-nfe.
                    end.

                    if item.tipo-con-est > 2
                    and (item-doc-orig-nfe.dt-vali-lote = ? or
                            item-doc-orig-nfe.dt-vali-lote < today) then do:
                        RUN implantaErroConfCadastroMsg(INPUT item-doc-orig-nfe.ch-acesso-comp-nfe,
                                                        INPUT 1247, //Data de validade vencida para o lote
                                                        INPUT "Seq: ":U + STRING(item-doc-orig-nfe.seq-item),
                                                        INPUT 1).
                        assign l-ok = no.
                        release msg-ret-nfe.
                    end.					
                end.
            end.
        end.
 
        if de-seq-item-ant <> 0 OR l-ok = no then do:
            leave blocoNota.
        end. 

        /* Base Origina‡Æo de GrÆos Conectada    */
        RUN cdp/cd0032.p (OUTPUT l-orig-ativo).
        IF  l-orig-ativo THEN DO:

            /* Projeto PCREQ-7597 - Geracao_Romaneio_via_Totvs_Colaboracao                                                 *
             * O projeto tem por objetivo permitir a gera‡Æo autom tica de romaneio atrav‚s da rotina do totvs colabora‡Æo *
             * desde que o item tenha caracteristica do m¢dulo e parametros devidamente marcados                           *
             * H  duas formas: via romaneio atrav‚s de uma tela informando chave de acesso ou via Monitor NF-e/CT-e/NFS-e  */

            /* Parƒmetro Origina‡Æo de GrÆos Marcado */
            IF  lLiberGeracRomaneio THEN DO:
                ASSIGN lGeradoViaOriginacao = YES
                       lLiberGeracRomaneio  = NO. /* Este flag ser  ativado somente nas rotinas RE0708(btReprocessa) e gg2000j */

                DEFINE VARIABLE h-ggapi6010   AS HANDLE            NO-UNDO.
                RUN ggp/ggapi6010.p PERSISTENT SET h-ggapi6010.

                IF  iRowIdRomaneioVinc <> ? THEN
                    RUN piGeraRomaneioChave-2 IN h-ggapi6010 (INPUT  iRowIdRomaneioVinc, /* Este campo somente ser  atualizado pela rotina GG2000J */
                                                              INPUT  pr-nota,
                                                              INPUT  TABLE tt-docum-est,
                                                              INPUT  TABLE tt-item-doc-est,
                                                              OUTPUT TABLE tt-erro-rat).
                ELSE
                    RUN piGeraRomaneioChave   IN h-ggapi6010 (INPUT  pr-nota,
                                                              INPUT  TABLE tt-docum-est,
                                                              INPUT  TABLE tt-item-doc-est,
                                                              OUTPUT TABLE tt-erro-rat).
                ASSIGN iRowIdRomaneioVinc = ?. 

                DELETE PROCEDURE h-ggapi6010.

                IF  CAN-FIND(FIRST tt-erro-rat) THEN DO:
                    FOR EACH tt-erro-rat:
                        CREATE msg-ret-nfe.
                        ASSIGN msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                               msg-ret-nfe.idi-orig-trad      = 2
                               msg-ret-nfe.dt-msg             = TODAY
                               msg-ret-nfe.hr-msg             = STRING(TIME, "HH:MM:SS")
                               msg-ret-nfe.log-ativo          = YES
                               msg-ret-nfe.cd-msg             = tt-erro-rat.cd-erro
                               msg-ret-nfe.texto-msg          = tt-erro-rat.desc-erro
                               msg-ret-nfe.seq-msg            = NEXT-VALUE(seq-msg-ret-nfe).
                        RELEASE msg-ret-nfe.
                    END.

                    ASSIGN l-ok = NO.
                END.
                
                /* Ap¢s o processo da gera‡Æo do romaneio sai do bloco */
                LEAVE blocoNota.
            END.
        END.
        ASSIGN l-desaloca = YES.
        /* Desaloca o saldo em poder de terceiros para prevenir duplicação de saldo. */
        for each tt-relac-saldo:
            run alocaSaldoTerc in h-boin404re (input no,
                                               input tt-relac-saldo.qtd-alocar,
                                               input tt-relac-saldo.seq-saldo-terc,
                                               input tt-relac-saldo.cod-emitente,
                                               input tt-relac-saldo.nro-docto,
                                               input tt-relac-saldo.serie-docto,
                                               input tt-relac-saldo.nat-operacao,
                                               input tt-relac-saldo.nat-terc,
                                               input tt-relac-saldo.it-codigo).
        end.

        /* Desaloca o saldo da OC para todos os itens da nota de uma vez, evitando  **
        ** assim erro de alocacao pelo return nas validacoes internas do conversor. */
        for each tt-item-doc-est:
            if  tt-item-doc-est.num-pedido   <> 0
            and tt-item-doc-est.numero-ordem <> 0
            and tt-item-doc-est.parcela      <> 0
            and tt-item-doc-est.log-1        = no then
                run baixaSaldoOrdem (input no, /* no -> desaloca. */
                                     input tt-item-doc-est.numero-ordem,
                                     input tt-item-doc-est.parcela,
                                     input tt-item-doc-est.quantidade).
        end.

        /*Gerando os dados de Descri‡Æo e unidade medida emitente do XML*/        
        EMPTY TEMP-TABLE tt-ext-item-doc-est.
        FOR EACH tt-item-doc-est:
            IF NOT CAN-FIND (FIRST ext-item-doc-est NO-LOCK
                             WHERE ext-item-doc-est.serie-docto  = tt-item-doc-est.serie-docto
                               AND ext-item-doc-est.nro-docto    = tt-item-doc-est.nro-docto
                               AND ext-item-doc-est.cod-emitente = tt-item-doc-est.cod-emitente
                               AND ext-item-doc-est.nat-operacao = tt-item-doc-est.nat-operacao
                               AND ext-item-doc-est.sequencia    = tt-item-doc-est.sequencia
                               AND ext-item-doc-est.cod-param    = "infoXML":U) THEN DO:
                               
                FOR FIRST item-doc-orig-nfe NO-LOCK
                    WHERE item-doc-orig-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                      AND item-doc-orig-nfe.seq-item           = INT(SUBSTRING(tt-item-doc-est.char-2,832,5)) /*Sequencia Item monitor*/
                      AND item-doc-orig-nfe.idi-orig-trad      = 1: /*Dados originais XML*/
                      
                    CREATE tt-ext-item-doc-est.
                    ASSIGN tt-ext-item-doc-est.serie-docto  = tt-item-doc-est.serie-docto
                           tt-ext-item-doc-est.nro-docto    = tt-item-doc-est.nro-docto
                           tt-ext-item-doc-est.cod-emitente = tt-item-doc-est.cod-emitente
                           tt-ext-item-doc-est.nat-operacao = tt-item-doc-est.nat-operacao
                           tt-ext-item-doc-est.sequencia    = tt-item-doc-est.sequencia
                           tt-ext-item-doc-est.cod-param    = "infoXML":U.
                    ASSIGN OVERLAY(tt-ext-item-doc-est.cod-livre-1,1,120) = item-doc-orig-nfe.desc-item
                           OVERLAY(tt-ext-item-doc-est.cod-livre-2,1,6)   = item-doc-orig-nfe.un-comercial.
                END.
            END.
        END.

        IF lFuncaoImpostosAtivada THEN DO:
            DEF VAR h-boin01091 AS HANDLE NO-UNDO.
            EMPTY TEMP-TABLE tt-item-doc-est-elegivel.
            EMPTY TEMP-TABLE tt-item-doc-est-tribut.

            /* Avalia item a item se usa os impostos do monitor, em vez de
               decidir uma unica vez pela natureza do cabe‡alho */
            FOR EACH tt-item-doc-est NO-LOCK:
                RUN utilizaImpostosMonitorParams (INPUT bf{&TableName}.ch-acesso-comp-nfe,
                                                  INPUT INT(SUBSTRING(tt-item-doc-est.char-2,832,5)), /*Seq Item monitor*/
                                                  INPUT NO,   /* funcao j  validada por lFuncaoImpostosAtivada */
                                                  INPUT YES,  /* valida se tem dados traduzidos */
                                                  OUTPUT l-itemimpmonitor).

                IF l-itemimpmonitor THEN DO:
                    CREATE tt-item-doc-est-elegivel.
                    BUFFER-COPY tt-item-doc-est TO tt-item-doc-est-elegivel.
                END.
            END.

            IF CAN-FIND(FIRST tt-item-doc-est-elegivel) THEN DO:
                RUN inbo/boin01091.p PERSISTENT SET h-boin01091.

                RUN criaTTItemDocEstTributComBaseItemDocImpNfe IN h-boin01091 (INPUT bf{&TableName}.ch-acesso-comp-nfe,
                                                                               INPUT TABLE tt-item-doc-est-elegivel,
                                                                               OUTPUT TABLE tt-item-doc-est-tribut).
                DELETE PROCEDURE h-boin01091.
            END.
        END.

        
        FOR EACH tt-item-doc-est NO-LOCK:
            FOR EACH item-doc-orig-nfe of bf{&TableName} NO-LOCK
               WHERE item-doc-orig-nfe.idi-orig-trad = 2
                 AND item-doc-orig-nfe.it-codigo     = tt-item-doc-est.it-codigo
                 AND item-doc-orig-nfe.seq-item      = INT(SUBSTRING(tt-item-doc-est.char-2,832,5))
                 AND item-doc-orig-nfe.cod-prod-anp  <> "":
                
                IF NOT CAN-FIND(FIRST item-nf-adc NO-LOCK
                                WHERE item-nf-adc.cod-estab         = tt-docum-est.cod-estabel
                                  AND item-nf-adc.cod-serie         = tt-item-doc-est.serie-docto
                                  AND item-nf-adc.cod-nota-fisc     = tt-item-doc-est.nro-docto
                                  AND item-nf-adc.cdn-emitente      = tt-item-doc-est.cod-emitente
                                  AND item-nf-adc.num-seq           = tt-item-doc-est.sequencia
                                  AND item-nf-adc.num-seq-item-nf   = tt-item-doc-est.sequencia
                                  AND item-nf-adc.cod-item          = tt-item-doc-est.it-codigo
                                  AND item-nf-adc.idi-tip-dado      = 36 /* Grupo Combustivel */
                                  AND item-nf-adc.cod-natur-operac  = IF tt-item-doc-est.nat-of <> "" 
                                                                      THEN tt-item-doc-est.nat-of 
                                                                      ELSE tt-item-doc-est.nat-operacao) THEN DO:
                    CREATE tt-item-nf-adc.
                    ASSIGN tt-item-nf-adc.cod-estab                = tt-docum-est.cod-estabel
                           tt-item-nf-adc.cod-serie                = tt-item-doc-est.serie-docto
                           tt-item-nf-adc.cod-nota-fisc            = tt-item-doc-est.nro-docto
                           tt-item-nf-adc.cdn-emitente             = tt-item-doc-est.cod-emitente
                           tt-item-nf-adc.cod-natur-operac         = IF tt-item-doc-est.nat-of <> "" THEN tt-item-doc-est.nat-of ELSE tt-item-doc-est.nat-operacao
                           tt-item-nf-adc.idi-tip-dado             = 36 /* Grupo Combustivel */
                           tt-item-nf-adc.num-seq                  = tt-item-doc-est.sequencia
                           tt-item-nf-adc.num-seq-item-nf          = tt-item-doc-est.sequencia
                           tt-item-nf-adc.cod-item                 = tt-item-doc-est.it-codigo 
                           tt-item-nf-adc.cod-livre-1              = item-doc-orig-nfe.cod-prod-anp   
                           tt-item-nf-adc.cod-livre-2              = item-doc-orig-nfe.desc-anp
                           tt-item-nf-adc.val-livre-1              = item-doc-orig-nfe.perc-glp
                           tt-item-nf-adc.val-livre-2              = item-doc-orig-nfe.perc-gnn
                           tt-item-nf-adc.val-livre-3              = item-doc-orig-nfe.perc-gni 
                           tt-item-nf-adc.val-livre-4              = item-doc-orig-nfe.valor-part
                           overlay(tt-item-nf-adc.cod-livre-3,1,8) = IF item-doc-orig-nfe.perc-mistura-biodiesel = ? THEN "0" ELSE string(item-doc-orig-nfe.perc-mistura-biodiesel).
                           
                END.
                
                FOR EACH item-doc-orig-comb-nfe NO-LOCK
                   WHERE item-doc-orig-comb-nfe.ch-acesso-comp-nfe = item-doc-orig-nfe.ch-acesso-comp-nfe
                     AND item-doc-orig-comb-nfe.idi-orig-trad      = 2
                     AND item-doc-orig-comb-nfe.seq-item           = item-doc-orig-nfe.seq-item:
                     
                    CREATE tt-item-nf-adc.
                    ASSIGN tt-item-nf-adc.cod-estab        = tt-docum-est.cod-estabel
                           tt-item-nf-adc.cod-serie        = tt-item-doc-est.serie-docto
                           tt-item-nf-adc.cod-nota-fisc    = tt-item-doc-est.nro-docto
                           tt-item-nf-adc.cdn-emitente     = tt-item-doc-est.cod-emitente
                           tt-item-nf-adc.cod-natur-operac = IF tt-item-doc-est.nat-of <> "" THEN tt-item-doc-est.nat-of ELSE tt-item-doc-est.nat-operacao
                           tt-item-nf-adc.idi-tip-dado     = 37 /* Grupo Origem Combustivel */
                           tt-item-nf-adc.num-seq          = item-doc-orig-comb-nfe.seq-orig-comb 
                           tt-item-nf-adc.num-seq-item-nf  = tt-item-doc-est.sequencia
                           tt-item-nf-adc.cod-item         = tt-item-doc-est.it-codigo.
                           
                    ASSIGN tt-item-nf-adc.num-livre-1 = item-doc-orig-comb-nfe.ind-import 
                           tt-item-nf-adc.val-livre-1 = item-doc-orig-comb-nfe.perc-orig.
                           
                    find first unid-feder no-lock
                         where unid-feder.cod-uf-ibge = item-doc-orig-comb-nfe.uf-orig  no-error.
                    if avail unid-feder then 
                       assign tt-item-nf-adc.cod-livre-1 = unid-feder.estado.
                    else 
                        assign tt-item-nf-adc.cod-livre-1 = ''.
                END.
            END.                           
        END.
        
        /****** PONTO UPC COFCO *******/
        if  c-nom-prog-upc-mg97 <> "" then do:
            for each  tt-epc
                where tt-epc.cod-event = "antesEfetivarNota":
                delete tt-epc.
            end.
            
            create tt-epc.
            assign tt-epc.cod-event     = "antesEfetivarNota"
                   tt-epc.cod-parameter = "doc-orig-nfe-rowid"
                   tt-epc.val-parameter = string(pr-nota).
                   
            create tt-epc.
            assign tt-epc.cod-event     = "antesEfetivarNota"
                   tt-epc.cod-parameter = "tt-docum-est-handle"
                   tt-epc.val-parameter = string(TEMP-TABLE tt-docum-est:HANDLE).
                   
            create tt-epc.
            assign tt-epc.cod-event     = "antesEfetivarNota"
                   tt-epc.cod-parameter = "tt-item-doc-est-handle"
                   tt-epc.val-parameter = string(TEMP-TABLE tt-item-doc-est:HANDLE).
                   
            create tt-epc.
            assign tt-epc.cod-event     = "antesEfetivarNota"
                   tt-epc.cod-parameter = "tt-dupli-apagar-handle"
                   tt-epc.val-parameter = string(TEMP-TABLE tt-dupli-apagar:HANDLE).
                   
            create tt-epc.
            assign tt-epc.cod-event     = "antesEfetivarNota"
                   tt-epc.cod-parameter = "tt-rat-docum-handle"
                   tt-epc.val-parameter = string(TEMP-TABLE tt-rat-docum:HANDLE).
                   
            create tt-epc.
            assign tt-epc.cod-event     = "antesEfetivarNota"
                   tt-epc.cod-parameter = "tt-dupli-imp-handle"
                   tt-epc.val-parameter = string(TEMP-TABLE tt-dupli-imp:HANDLE).
                   
            create tt-epc.
            assign tt-epc.cod-event     = "antesEfetivarNota"
                   tt-epc.cod-parameter = "tt-rat-ordem-orig-nfe-aux-handle"
                   tt-epc.val-parameter = string(TEMP-TABLE tt-rat-ordem-orig-nfe-aux:HANDLE).
                   
            {include/i-epc201.i "antesEfetivarNota"}
        end.
        /*****************************/

        IF l-ok THEN
        /* ABERTA TRANSACAO PARA PODER DESFAZER A CRIACAO DA TABELA **
        ** CASO OCORRµ ERRO DURANTE A GERACAO DO FIFO.              */
        do on error undo, leave:
            IF l-re0708 THEN DO:
                {utp/ut-liter.i "Gerando_Nota_Fiscal..." *}
                RUN pi-inicializar IN h-acomp(RETURN-VALUE).
                {utp/ut-liter.i "Efetivando_Nota_Fiscal..." *}
                RUN pi-acompanhar IN h-acomp(RETURN-VALUE).
            END.
            
            RUN rep/reapi316b.p PERSISTENT SET h-reapi316b (INPUT  "ADD",
                                                            INPUT  TABLE tt-docum-est,
                                                            INPUT  TABLE tt-rat-docum,
                                                            INPUT  TABLE tt-item-doc-est,
                                                            INPUT  TABLE tt-dupli-apagar,
                                                            INPUT  TABLE tt-dupli-imp,
                                                            OUTPUT TABLE tt-erro).
            RUN setTTExtItemDocEst IN h-reapi316b (INPUT TABLE tt-ext-item-doc-est).
            RUN setTTExtDocumEst IN h-reapi316b (INPUT TABLE tt-ext-docum-est).
            
            if can-find(first tt-item-doc-est-tribut) then
                RUN setTTItemDocEstTribut IN h-reapi316b (INPUT TABLE tt-item-doc-est-tribut).
            
            FOR FIRST tt-item-nf-adc NO-LOCK: END.
            IF AVAIL tt-item-nf-adc THEN DO:
                RUN setTTItemNfAdc IN h-reapi316b (INPUT TABLE tt-item-nf-adc).
            END.

            /*--- LOGICA PARA GERACAO DA RAT-ORDEM CONFORME SELECAO EM TELA NO RE0118A ---*/
            IF l-fifo-oc-docum THEN DO:
               RUN geraFifo.

               FOR FIRST tt2-rat-ordem NO-LOCK: END.
               IF AVAIL tt2-rat-ordem THEN DO:
                   RUN setTTRatOrdem IN h-reapi316b (INPUT TABLE tt2-rat-ordem).
               END.
            END.

            RUN pi-execute IN h-reapi316b NO-ERROR. //Mantendo a logica de antes com no-error
            RUN getTTErro IN h-reapi316b (OUTPUT TABLE tt-erro).
            DELETE PROCEDURE h-reapi316b NO-ERROR.
            ASSIGN h-reapi316b = ?.
                    
            ASSIGN l-erro-reapi316 = CAN-FIND(FIRST tt-erro).

            /* VALIDACAO QUANTIDADE */
            RUN validaquantidade (OUTPUT l-ok, OUTPUT TABLE tt-erro).
            IF  NOT l-ok THEN
                UNDO, LEAVE.
            
            /*--- LOGICA PARA REALOCACAO DAS PARCELAS DA RAT-ORDEM ---*/
            IF l-fifo-oc-docum AND l-erro-reapi316 THEN DO:
               FOR EACH tt-item-doc-est NO-LOCK:
                   FOR EACH tt2-rat-ordem NO-LOCK
                      WHERE tt2-rat-ordem.serie-docto  = tt-item-doc-est.serie-docto
                        AND tt2-rat-ordem.nro-docto    = tt-item-doc-est.nro-docto
                        AND tt2-rat-ordem.cod-emitente = tt-item-doc-est.cod-emitente
                        AND tt2-rat-ordem.nat-operacao = tt-item-doc-est.nat-operacao
                        and tt2-rat-ordem.sequencia    = tt-item-doc-est.sequencia:
                        
                        RUN baixaSaldoOrdem (input yes, /* yes -> aloca. */
                                             input tt2-rat-ordem.numero-ordem,
                                             input tt2-rat-ordem.parcela,
                                             input tt2-rat-ordem.quantidade).
                                            
                        IF tt2-rat-ordem.val-medicao > 0 THEN         
                           FOR FIRST medicao-contrat
                               WHERE medicao-contrat.nr-contrato     = tt2-rat-ordem.nr-contrato
                                 AND medicao-contrat.num-seq-item    = tt2-rat-ordem.num-seq-item
                                 AND medicao-contrat.numero-ordem    = tt2-rat-ordem.numero-ordem
                                 AND medicao-contrat.num-seq-event   = tt2-rat-ordem.num-seq-event
                                 AND medicao-contrat.num-seq-medicao = tt2-rat-ordem.num-seq-medicao NO-LOCK:
                                 
                               RUN pi-aloca-medicao(INPUT yes, /*alocar*/
                                                    INPUT tt2-rat-ordem.val-medicao, 
                                                    INPUT ROWID(medicao-contrat)).
                           END.
                   END.
               END. /*FblOR EACH tt-item-doc-est*/
            END. /*IF l-fifo-oc-docum AND l-erro-reapi316*/
                
            if NOT l-erro-reapi316 then do:
                /*GERA RAT-LOTE COM BASE NA ABA LOTES DO RE0118*/    
                if can-find(first rat-lote-medic-nfe
                   where rat-lote-medic-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                   and   rat-lote-medic-nfe.idi-orig-trad      = 2) then do:
                         
                   RUN geraLoteMedic (INPUT rowid(bf{&TableName}),
                                      input 1, /*1 -Fiscal 2-Fisico*/
                                      OUTPUT l-ok, 
                                      OUTPUT TABLE tt-erro).
                   IF  NOT l-ok THEN
                   UNDO, LEAVE.                                 
                end.
                else do: /* para faturamento de consigna‡Æo, se nÆo tem a rat-lote-medic-nfe, gera a rat-componente */
                    IF AVAIL natur-oper AND natur-oper.terceiros = YES AND natur-oper.tp-oper-terc = 4 THEN do: /* faturamento de consigna‡Æo */
                      
                       FOR EACH item-doc-orig-nfe of bf{&TableName} NO-LOCK
                          WHERE item-doc-orig-nfe.idi-orig-trad = 2:
                                                 
                            RUN CreateRatComponente (INPUT rowid(bf{&TableName}),
                                                     INPUT TABLE tt-docum-est,
                                                     INPUT item-doc-orig-nfe.seq-item,
                                                     OUTPUT l-ok).                                                 
                           
                           IF NOT l-ok THEN
                               UNDO, LEAVE.
                       END.
                    END.                
                end.
            end.
            
            IF AVAIL natur-oper 
                 AND natur-oper.terceiros = YES 
                 AND (natur-oper.tp-oper-terc = 2 
                  OR  natur-oper.tp-oper-terc = 5 
                  OR  natur-oper.tp-oper-terc = 9    /*Retorno Dep Fechado*/
                  OR  natur-oper.tp-oper-terc = 11)  /*Retorno Arm Geral*/
                 AND NOT l-erro-reapi316 THEN DO: /* Retorno de Beneficiamento e Devolução de Consignação */
                  RUN CreateRatLotTerc (INPUT rowid(bf{&TableName}),
                                        INPUT  TABLE tt-docum-est,
                                        OUTPUT l-ok).
                 IF  NOT l-ok THEN
                     UNDO, LEAVE.
            END.
                
            /* Quando ocorrem erros na BO, o l-ok nao ‚ setado imediatamente, portanto verifica a existencia de registros na tt-erros. */
            IF  l-agregado AND NOT l-erro-reapi316 THEN DO:
                IF l-re0708 THEN DO:
                    {utp/ut-liter.i "Processando_Acabado/Agregado..." *}
                    RUN pi-acompanhar IN h-acomp(RETURN-VALUE).
                END.
                RUN processaAgregado (input 2, OUTPUT c-conta, OUTPUT c-sub-conta).
                IF  RETURN-VALUE = "NOK" THEN
                    UNDO, LEAVE.
            END.
            
            /* PONTO UPC KEKO CHAMADO 2573970 */
            IF c-nom-prog-dpc-mg97  <> ""
            OR c-nom-prog-upc-mg97  <> ""
            OR c-nom-prog-appc-mg97 <> "" THEN DO:

                EMPTY TEMP-TABLE tt-epc.

                CREATE tt-epc.
                ASSIGN tt-epc.cod-event     = "afterReapi316":U
                       tt-epc.cod-parameter = "r-doc-orig-nfe":U
                       tt-epc.val-parameter = STRING(pr-nota).
                                
                CREATE tt-epc.
                ASSIGN tt-epc.cod-event     = "afterReapi316":U
                       tt-epc.cod-parameter = "tt-erro-handle":U
                       tt-epc.val-parameter = STRING(TEMP-TABLE tt-erro:HANDLE).
                       
                CREATE tt-epc.
                ASSIGN tt-epc.cod-event     = "afterReapi316":U
                       tt-epc.cod-parameter = "CANCELAR":U
                       tt-epc.val-parameter = "NO":U.

                /*** Chamada do programa EPC ***/
                {include/i-epc201.i  "afterReapi316" }
                
                FIND FIRST tt-epc 
                    WHERE tt-epc.cod-event     = "afterReapi316":U
                    AND   tt-epc.cod-parameter = "CANCELAR":U
                    AND   tt-epc.val-parameter = "YES":U NO-ERROR.
                IF AVAIL tt-epc THEN DO:
                    ASSIGN l-ok = NO.
                    UNDO, LEAVE.
                END.
            END.
            /*****************************************************/
        END.
        
        FOR EACH bfmsg-ret-nfe NO-LOCK
            WHERE bfmsg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
              AND bfmsg-ret-nfe.idi-orig-trad      = 2:

            FOR FIRST msg-ret-nfe EXCLUSIVE-LOCK
                WHERE msg-ret-nfe.seq-msg  = bfmsg-ret-nfe.seq-msg and
                      msg-ret-nfe.tipo-msg <> 2:
                ASSIGN msg-ret-nfe.log-ativo = NO.
            END.
            RELEASE msg-ret-nfe.
        END.

        IF CAN-FIND(FIRST tt-erro) THEN DO:
            FOR EACH tt-erro:
                CREATE msg-ret-nfe.
                ASSIGN msg-ret-nfe.ch-acesso-comp-nfe = bf{&TableName}.ch-acesso-comp-nfe
                       msg-ret-nfe.idi-orig-trad      = 2
                       msg-ret-nfe.dt-msg             = TODAY
                       msg-ret-nfe.hr-msg             = STRING(TIME, "HH:MM:SS")
                       msg-ret-nfe.log-ativo          = YES
                       msg-ret-nfe.cd-msg             = tt-erro.cd-erro
                       msg-ret-nfe.texto-msg          = tt-erro.desc-erro
                       msg-ret-nfe.seq-msg            = NEXT-VALUE(seq-msg-ret-nfe).
                release msg-ret-nfe.
            END.
            
            ASSIGN l-ok       = NO
                   l-desaloca = NO.
        END.
        ELSE DO:
            RUN geraDuplicatas (INPUT 2, INPUT ch-acesso).
        END.
    END. /* FIM blocoNota*/


    IF  NOT l-ok
    AND l-desaloca then do:

        /* DESALOCA O SALDO AQUI POIS O l-ok NAO DEPENDE APENAS DA EXISTENCIA DE TT-ERROS.     **
        ** PODER SER QUE ELE TENHA SIDO MARCADO INTERNAMENTE PELAS VALIDACOES DA REPROCESSA    **
        ** NOTA, ASSIM ISSO FARIA O SALDO SER DESALOCADO E NAO SER  ALOCADO NOVAMENTE, POIS    **
        ** NAO CHEGARIA A EXECUTAR AS PROCEDURES DO CONVERSOR E DO PRODUTO QUE GERAM TT-ERROS. */

        /* Realoca o saldo em poder de terceiros caso ocorra erro. */
        for each tt-relac-saldo:
            run alocaSaldoTerc in h-boin404re (input yes,
                                               input tt-relac-saldo.qtd-alocar,
                                               input tt-relac-saldo.seq-saldo-terc,
                                               input tt-relac-saldo.cod-emitente,
                                               input tt-relac-saldo.nro-docto,
                                               input tt-relac-saldo.serie-docto,
                                               input tt-relac-saldo.nat-operacao,
                                               input tt-relac-saldo.nat-terc,
                                               input tt-relac-saldo.it-codigo).
        end.
        
        /* Aloca o saldo da OC para todos os itens. */
        for each tt-item-doc-est:
            
            if  tt-item-doc-est.numero-ordem <> 0
            and tt-item-doc-est.num-pedido   <> 0
            and tt-item-doc-est.parcela      <> 0
            and tt-item-doc-est.log-1        = no then
                run baixaSaldoOrdem (input yes, /* yes -> aloca. */
                                     input tt-item-doc-est.numero-ordem,
                                     input tt-item-doc-est.parcela,
                                     input tt-item-doc-est.quantidade).
        end.

    end.

    IF  lGeradoViaOriginacao = YES THEN DO:
        IF  l-ok THEN
            FOR FIRST bf{&TableName} FIELDS (idi-situacao)
                WHERE ROWID(bf{&TableName}) = pr-nota EXCLUSIVE-LOCK:
                ASSIGN bf{&TableName}.idi-situacao = 10 /* Gerado via Origina‡Æo */.
            END.

    END.
    ELSE
    IF  l-ok THEN DO:
        IF l-re0708 THEN DO:
            {utp/ut-liter.i "Gerando_informa‡äes_adicionais_da_nota_referenciada..." *}
            RUN pi-acompanhar IN h-acomp(RETURN-VALUE).
        END.

        IF NOT VALID-HANDLE(h-reapi434) THEN
           RUN rep/reapi434.p PERSISTENT SET h-reapi434.   
           
        IF CAN-FIND(FIRST funcao NO-LOCK
                    WHERE funcao.cd-funcao = "spp-NT2024002":U
                      AND funcao.ativo ) THEN DO:     
            IF NOT VALID-HANDLE(h-re1911) THEN
               RUN rep/re1911.p PERSISTENT SET h-re1911.    
            FOR EACH tt-docum-est:
            
                FOR EACH tt-item-doc-est of tt-docum-est NO-LOCK:
                   FOR FIRST doc-orig-refer-nfe NO-LOCK 
                       WHERE doc-orig-refer-nfe.ch-acesso-comp-nfe  = tt-docum-est.cod-chave-aces-nf-eletro
                         AND doc-orig-refer-nfe.idi-orig-trad       = 2
                         and doc-orig-refer-nfe.num-seq             = INT(SUBSTRING(tt-item-doc-est.char-2,832,5)): 
                         
                       IF  doc-orig-refer-nfe.ref-por-item        = YES
                       AND (   TRIM(tt-docum-est.cod-finalidade) = '5'  /*finalidade cr‚dito */
                            OR TRIM(tt-docum-est.cod-finalidade) = '6')  /*finalidade d‚bito*/ then do:
                             
                             RUN setChaveRefer   in h-reapi434  (input doc-orig-refer-nfe.ch-acesso-nfe).
                             RUN cria-referencia-por-item   IN h-reapi434 (INPUT  tt-docum-est.cod-estabel,
                                                                           INPUT  tt-docum-est.serie-docto,
                                                                           INPUT  tt-docum-est.nro-docto,
                                                                           INPUT  tt-docum-est.cod-emitente,
                                                                           INPUT  tt-item-doc-est.nat-operacao,
                                                                           INPUT  tt-item-doc-est.it-codigo,
                                                                           INPUT  tt-item-doc-est.sequencia,
                                                                           INPUT  '', 
                                                                           INPUT  '', 
                                                                           INPUT  '', 
                                                                           INPUT  0, 
                                                                           INPUT  doc-orig-refer-nfe.seq-item-xml,
                                                                           INPUT  6, /*Nota cr‚dito/d‚bito*/
                                                                           OUTPUT TABLE rowErrors).  
                       END.  
                    END. 
                END.
                FOR EACH doc-orig-refer-nfe NO-LOCK 
                   WHERE doc-orig-refer-nfe.ch-acesso-comp-nfe  = tt-docum-est.cod-chave-aces-nf-eletro 
                     AND doc-orig-refer-nfe.idi-orig-trad       = 2:
                                                              
                    IF doc-orig-refer-nfe.pagto-antecipado    = YES
                    OR (    doc-orig-refer-nfe.ref-por-item  = NO
                        AND (   TRIM(tt-docum-est.cod-finalidade) = '5'  /*finalidade cr‚dito */
                             OR TRIM(tt-docum-est.cod-finalidade) = '6'  /*finalidade d‚bito*/ ))
                    OR (tt-docum-est.cod-tipo-oper-gov = 2 OR tt-docum-est.cod-tipo-oper-gov = 3) THEN DO: 
                        IF VALID-HANDLE(h-re1911) THEN DO:    
                        
                            run setCodEstabel   in h-re1911  (input tt-docum-est.cod-estabel).
                            run setSerieDocto   in h-re1911  (input tt-docum-est.serie-docto).
                            run setNroDocto     in h-re1911  (input tt-docum-est.nro-docto).
                            run setCodEmitente  in h-re1911  (input tt-docum-est.cod-emitente).
                            run setNatOperacao  in h-re1911  (input tt-docum-est.nat-operacao).
                            run setChaveRefer   in h-re1911  (input doc-orig-refer-nfe.ch-acesso-nfe).
                            run setNumSeq       in h-re1911  (input doc-orig-refer-nfe.num-seq ).
                            run setTipoDocto    in h-re1911  (input 3). //documento referˆnciado
                            run setPagtoAntecip in  h-re1911 (input doc-orig-refer-nfe.pagto-antecipado).
                            
                            RUN emptyTtNotaFiscAdc in h-re1911.
                            run efetivarTtNotaFisc in h-re1911.
                            run getRowErrors in h-re1911 (OUTPUT TABLE rowErrors).
                                                   
                        END.
                    END.
                END.
                                                
                /* Chamar o RE1911 para gravar o idi-tip-dado = 20 (dt-prev-entrega) */
                IF VALID-HANDLE(h-re1911) THEN DO:
                                                        
                    IF bf{&TableName}.dt-prev-entrega <> ? THEN DO: 
                                                           
                        run setCodEstabel   in h-re1911  (input tt-docum-est.cod-estabel).
                        run setSerieDocto   in h-re1911  (input tt-docum-est.serie-docto).
                        run setNroDocto     in h-re1911  (input tt-docum-est.nro-docto).
                        run setCodEmitente  in h-re1911  (input tt-docum-est.cod-emitente).
                        run setNatOperacao  in h-re1911  (input tt-docum-est.nat-operacao).
                        run setChaveRefer   in h-re1911  (input tt-docum-est.cod-chave-aces-nf-eletro). 
                        run setNumSeq       in h-re1911  (0).
                        run setTipoDocto    in h-re1911  (input 20). /* idi-tip-dado = 20 */
                        run setPagtoAntecip in  h-re1911 (input NO). /* NÆo ‚ pagto antecipado */
                           
                        RUN emptyTtNotaFiscAdc in h-re1911.
                        run efetivarTtNotaFisc in h-re1911.
                        run getRowErrors in h-re1911 (OUTPUT TABLE rowErrors).
                        
                    END.
                END.
                
            END.     
        END.
        /* Gerar informa‡äes adicionais da nota referenciada. */       
        for each doc-orig-nfe of bf{&TableName}
            where doc-orig-nfe.idi-orig-trad = 2,
            each item-doc-orig-nfe of doc-orig-nfe no-lock,
                each item-ref-nfe no-lock
                where item-ref-nfe.ch-acesso-comp-nfe = item-doc-orig-nfe.ch-acesso-comp-nfe
                and   item-ref-nfe.seq-item           = item-doc-orig-nfe.seq-item:

             FIND FIRST tt-natureza WHERE tt-natureza.nat-operacao = item-doc-orig-nfe.nat-operacao NO-ERROR. /* Busca nat. Agrup */
             
              FOR FIRST natur-oper FIELDS (tipo-compra log-oper-triang tp-oper-terc)  NO-LOCK
                 WHERE natur-oper.nat-operacao = item-doc-orig-nfe.nat-operacao: END.
             IF AVAIL natur-oper THEN DO: 
                 RUN emptyRowErrors.
                 
                 ASSIGN lOpeTriang = NO.
                 IF natur-oper.tp-oper-terc = 2 THEN
                     FOR FIRST bf-item-doc-est-tri FIELDS(nat-operacao)
                         WHERE bf-item-doc-est-tri.cod-emit-terc   = doc-orig-nfe.cod-emitente
                           AND bf-item-doc-est-tri.nro-docto-terc  = item-ref-nfe.nro-docto
                           AND bf-item-doc-est-tri.serie-terc      = item-ref-nfe.serie-docto
                           AND bf-item-doc-est-tri.nat-terc        = item-ref-nfe.nat-operacao NO-LOCK:
                           
                         FOR FIRST bf-natur-oper-it-tri FIELDS(log-oper-triang)
                             WHERE bf-natur-oper-it-tri.nat-operacao = bf-item-doc-est-tri.nat-operacao
                               AND bf-natur-oper-it-tri.log-oper-triang:
                             ASSIGN lOpeTriang = YES.
                         END.   
                     END.    
                                                      
                 IF natur-oper.tipo-compra = 3 THEN DO: /*Devolu‡Æo de Cliente*/ 
                     IF CAN-FIND(FIRST funcao NO-LOCK
                                 WHERE funcao.cd-funcao = "spp-NT2024002":U
                                   AND funcao.ativo ) THEN DO:
                         
                         /*Verificar se no XML a referˆncia foi realizada por item para referenciar por item no CD4035.*/
                         FIND FIRST doc-orig-refer-nfe
                              WHERE doc-orig-refer-nfe.ch-acesso-comp-nfe = item-doc-orig-nfe.ch-acesso-comp-nfe
                                AND doc-orig-refer-nfe.idi-orig-trad      = 2 NO-LOCK NO-ERROR.
                         
                         IF AVAIL doc-orig-refer-nfe AND 
                            doc-orig-refer-nfe.ref-por-item AND 
                            doc-orig-refer-nfe.seq-item-xml > 0 THEN DO:
                         
                            FOR FIRST bf-item-doc-est-dev
                                WHERE bf-item-doc-est-dev.cod-emitente = doc-orig-nfe.cod-emitente
                                  AND bf-item-doc-est-dev.serie-comp   = item-ref-nfe.serie-docto
                                  AND bf-item-doc-est-dev.nro-comp     = item-ref-nfe.nro-docto
                                  AND bf-item-doc-est-dev.nat-comp     = item-ref-nfe.nat-operacao 
                                  AND bf-item-doc-est-dev.seq-comp     = item-ref-nfe.seq-saldo-terc
                                  AND bf-item-doc-est-dev.it-codigo    = item-doc-orig-nfe.it-codigo NO-LOCK:
                         
                         
                                RUN cria-referencia-por-item   IN h-reapi434 (INPUT  doc-orig-nfe.cod-estabel,
                                                                              INPUT  doc-orig-nfe.serie-docto,
                                                                              INPUT  doc-orig-nfe.nro-docto,
                                                                              INPUT  doc-orig-nfe.cod-emitente,
                                                                              INPUT  item-doc-orig-nfe.nat-operacao,
                                                                              INPUT  item-doc-orig-nfe.it-codigo,
                                                                              INPUT  bf-item-doc-est-dev.sequencia,
                                                                              INPUT  item-ref-nfe.serie-docto,      
                                                                              INPUT  item-ref-nfe.nro-docto,
                                                                              INPUT  item-ref-nfe.nat-operacao,
                                                                              INPUT  item-ref-nfe.seq-saldo-terc,
                                                                              INPUT  item-ref-nfe.seq-item-xml,
                                                                              INPUT  1, /*Devolu‡Æo de cliente*/
                                                                              OUTPUT TABLE rowErrors).			
                                                                              
                     
                            END.
                         END.
                     END.

                     RUN rep/re1910.p (INPUT  doc-orig-nfe.cod-estabel, 
                                       INPUT  doc-orig-nfe.serie-docto, 
                                       INPUT  doc-orig-nfe.nro-docto,   
                                       INPUT  doc-orig-nfe.cod-emitente,
                                       INPUT  tt-natureza.nat-oper-agrup,
                                       INPUT  item-doc-orig-nfe.it-codigo,
                                       INPUT  item-ref-nfe.serie-docto,
                                       INPUT  item-ref-nfe.nro-docto,  
                                       INPUT  item-ref-nfe.nat-operacao,
                                       INPUT  1, /*devolu‡Æo de cliente*/
                                       OUTPUT TABLE rowErrors).
                 END.
                 ELSE IF (NOT natur-oper.log-oper-triang 
                          AND NOT lOpeTriang
                          AND (natur-oper.tp-oper-terc = 2              /*Retorno de Beneficiamento*/
                           OR  natur-oper.tp-oper-terc = 9              /*Retorno Dep Fechado*/
                           OR  natur-oper.tp-oper-terc = 11)) THEN      /*Retorno Armaz Geral*/
                     RUN rep/re1910.p (INPUT  doc-orig-nfe.cod-estabel, 
                                       INPUT  doc-orig-nfe.serie-docto, 
                                       INPUT  doc-orig-nfe.nro-docto,   
                                       INPUT  doc-orig-nfe.cod-emitente,
                                       INPUT  tt-natureza.nat-oper-agrup,
                                       INPUT  item-doc-orig-nfe.it-codigo,
                                       INPUT  item-ref-nfe.serie-docto,
                                       INPUT  item-ref-nfe.nro-docto,  
                                       INPUT  item-ref-nfe.nat-operacao,
                                       INPUT  2, /*retorno de beneficiamento*/
                                       OUTPUT TABLE rowErrors).
                 ELSE IF natur-oper.tp-oper-terc = 4 THEN /*Faturamento de consigna‡Æo*/
                     RUN rep/re1910.p (INPUT  doc-orig-nfe.cod-estabel, 
                                       INPUT  doc-orig-nfe.serie-docto, 
                                       INPUT  doc-orig-nfe.nro-docto,   
                                       INPUT  doc-orig-nfe.cod-emitente,
                                       INPUT  tt-natureza.nat-oper-agrup,
                                       INPUT  item-doc-orig-nfe.it-codigo,
                                       INPUT  item-ref-nfe.serie-docto,
                                       INPUT  item-ref-nfe.nro-docto,  
                                       INPUT  item-ref-nfe.nat-operacao,
                                       INPUT  4, /*Faturamento de consigna‡Æo*/
                                       OUTPUT TABLE rowErrors).
                 ELSE IF natur-oper.tp-oper-terc = 5 THEN /*Devolu‡Æo de consigna‡Æo*/
                     RUN rep/re1910.p (INPUT  doc-orig-nfe.cod-estabel, 
                                       INPUT  doc-orig-nfe.serie-docto, 
                                       INPUT  doc-orig-nfe.nro-docto,   
                                       INPUT  doc-orig-nfe.cod-emitente,
                                       INPUT  tt-natureza.nat-oper-agrup,
                                       INPUT  item-doc-orig-nfe.it-codigo,
                                       INPUT  item-ref-nfe.serie-docto,
                                       INPUT  item-ref-nfe.nro-docto,  
                                       INPUT  item-ref-nfe.nat-operacao,
                                       INPUT  3, /*Devolu‡Æo de consigna‡Æo*/
                                       OUTPUT TABLE rowErrors).
                 ELSE IF natur-oper.tp-oper-terc = 6 THEN /*Reajuste de pre‡o*/
                     RUN rep/re1910.p (INPUT  doc-orig-nfe.cod-estabel, 
                                       INPUT  doc-orig-nfe.serie-docto, 
                                       INPUT  doc-orig-nfe.nro-docto,   
                                       INPUT  doc-orig-nfe.cod-emitente,
                                       INPUT  tt-natureza.nat-oper-agrup,
                                       INPUT  item-doc-orig-nfe.it-codigo,
                                       INPUT  item-ref-nfe.serie-docto,
                                       INPUT  item-ref-nfe.nro-docto,  
                                       INPUT  item-ref-nfe.nat-operacao,
                                       INPUT  5, /*Reajuste de pre‡o*/
                                       OUTPUT TABLE rowErrors).
                 
                 FOR EACH RowErrors WHERE RowErrors.ErrorType <> "INTERNAL":U:
                     CREATE msg-ret-nfe.
                     ASSIGN msg-ret-nfe.ch-acesso-comp-nfe = item-doc-orig-nfe.ch-acesso-comp-nfe
                            msg-ret-nfe.idi-orig-trad      = 2
                            msg-ret-nfe.dt-msg             = TODAY
                            msg-ret-nfe.hr-msg             = STRING(TIME, "HH:MM:SS")
                            msg-ret-nfe.log-ativo          = YES
                            msg-ret-nfe.cd-msg             = RowErrors.errorNumber
                            msg-ret-nfe.texto-msg          = RowErrors.errorDescription
                            msg-ret-nfe.seq-msg            = NEXT-VALUE(seq-msg-ret-nfe)
                            msg-ret-nfe.tipo-msg           = 2. /* Aviso */
                     RELEASE msg-ret-nfe.
                 END.
             END. /*IF AVAIL natur-oper*/
        end. /*for each doc-orig-nfe*/
        /* Fim da cria‡Æo das informa‡äes adicionais da nota referenciada. */

        FOR FIRST bf{&TableName} FIELDS (idi-situacao)
            WHERE ROWID(bf{&TableName}) = pr-nota EXCLUSIVE-LOCK:
            ASSIGN bf{&TableName}.idi-situacao = 1 /* Digitada Recebimento */.
        END.
    END.
    ELSE DO:
        FOR FIRST bf{&TableName} FIELDS (idi-situacao)
            WHERE ROWID(bf{&TableName}) = pr-nota EXCLUSIVE-LOCK:
            ASSIGN bf{&TableName}.idi-situacao = 2 /* Com erro de neg¢cio */ .
        END.
    END.
    RELEASE bf{&TableName}.

    FOR FIRST doc-orig-nfe WHERE ROWID(doc-orig-nfe) = pr-nota NO-LOCK:
        IF NOT doc-orig-nfe.log-metric-env-ls AND doc-orig-nfe.idi-situacao = 1 /* Digitada Recebimento */ THEN
            RUN enviaMetricasAdicionais.
    END.

    /****** PONTO UPC COFCO *******/
    if  c-nom-prog-upc-mg97 <> "" then do:
        for each  tt-epc
            where tt-epc.cod-event = "fimReprocessaNota":
            delete tt-epc.
        end.
        
        create tt-epc.
        assign tt-epc.cod-event     = "fimReprocessaNota"
               tt-epc.cod-parameter = "doc-orig-nfe-rowid"
               tt-epc.val-parameter = string(pr-nota).
               
        create tt-epc.
        assign tt-epc.cod-event     = "fimReprocessaNota"
               tt-epc.cod-parameter = "tt-docum-est-handle"
               tt-epc.val-parameter = string(TEMP-TABLE tt-docum-est:HANDLE).
               
        create tt-epc.
        assign tt-epc.cod-event     = "fimReprocessaNota"
               tt-epc.cod-parameter = "tt-item-doc-est-handle"
               tt-epc.val-parameter = string(TEMP-TABLE tt-item-doc-est:HANDLE).
               
        {include/i-epc201.i "fimReprocessaNota"}
    end.
    /*****************************/

    RETURN "OK":U.
    
    CATCH oError AS Progress.Lang.Error:
		DEF VAR iNumMessage AS INT NO-UNDO.
		ASSIGN l-ok = NO.

		FOR FIRST bf{&TableName} NO-LOCK
			WHERE ROWID(bf{&TableName}) = pr-nota:
		END.

		RUN inativarMensagensDocto(INPUT bf{&TableName}.ch-acesso-comp-nfe).
		
		DO iNumMessage = 1 TO oError:NumMessages:			
			RUN implantaErro(INPUT bf{&TableName}.ch-acesso-comp-nfe,
							 INPUT oError:getMessageNum(iNumMessage),
							 INPUT "Erro progress: " + 
								   oError:getMessage(iNumMessage) + 
								   IF oError:CallStack <> ? THEN " CallStack: " + oError:CallStack ELSE "",
							 INPUT 1). /* 1-Erro */
		END.
		
		RETURN "NOK":U.
    END CATCH.	
	
    FINALLY:
		IF  l-re0708 
		AND VALID-HANDLE(h-acomp) THEN
			RUN pi-finalizar IN h-acomp.
    
        FOR FIRST bf{&TableName} NO-LOCK
            WHERE ROWID(bf{&TableName}) = pr-nota:  
            RUN setProcessamento (INPUT bf{&TableName}.ch-acesso-comp-nfe, INPUT false).
        END.
         
        /*-*-*-*-*-*-*-*-* Elimina handles *-*-*-*-*-*-*-*-*/
        IF  VALID-HANDLE(h-boin857)        AND
            h-boin857:TYPE = "PROCEDURE":U AND
            h-boin857:FILE-NAME = "inbo/boin857.p":U THEN DO:
           
            DELETE PROCEDURE h-boin857.
            ASSIGN h-boin857 = ?.
        END.   
        
        IF  VALID-HANDLE(h-boin404re)        AND
            h-boin404re:TYPE = "PROCEDURE":U AND
            h-boin404re:FILE-NAME = "inbo/boin404re.p":U THEN DO:
            DELETE PROCEDURE h-boin404re.
            ASSIGN h-boin404re = ?.
        END.   
        
        IF  VALID-HANDLE(h-boin862)        AND
            h-boin862:TYPE = "PROCEDURE":U AND
            h-boin862:FILE-NAME = "inbo/boin862.p":U THEN DO:
            DELETE PROCEDURE h-boin862.
            ASSIGN h-boin862 = ?.
        END. 

        IF VALID-HANDLE(h-cdapi995) THEN DO:
            RUN pi-finalizar in h-cdapi995.
            ASSIGN h-cdapi995 = ?.
        END.

        IF  VALID-HANDLE(h-boin176) THEN DO:
            RUN destroy IN h-boin176.
            DELETE PROCEDURE h-boin176 NO-ERROR.
            ASSIGN h-boin176 = ?.
        END.

        IF VALID-HANDLE(h-reapi412) THEN DO:
            DELETE PROCEDURE h-reapi412 NO-ERROR.
            ASSIGN h-reapi412 = ?.
        END.

        IF  VALID-HANDLE(h-boin01109) THEN DO:
            DELETE PROCEDURE h-boin01109.
            ASSIGN h-boin01109 = ?.
        END.
        
        IF VALID-HANDLE(h-reapi434) THEN DO:
           DELETE PROCEDURE h-reapi434.
           ASSIGN h-reapi434 = ?.
        END.
        
        IF VALID-HANDLE(h-re1911) THEN DO:
           DELETE PROCEDURE h-re1911.
           ASSIGN h-re1911 = ?.
        END.
        /*-*-*-*-*-*-*-* FIM -> Elimina handles *-*-*-*-*-*-*-*/
    END.
