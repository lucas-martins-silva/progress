&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE copiaFamilia DBOProgram 
PROCEDURE copiaFamilia :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input param p-fm-equipto-origem  like fam-equipto.fm-equipto.
    def input param p-fm-equipto-destino like fam-equipto.fm-equipto.

    for first fam-equipto where fm-equipto = p-fm-equipto-origem NO-LOCK. end.
    if available(fam-equipto) then do:
        for each mgc-proced-familia
              where mgc-proced-familia.fm-equipto = p-fm-equipto-origem NO-LOCK:
            create ttMgcProcedFamilia-aux.
            buffer-copy mgc-proced-familia to ttMgcProcedFamilia-aux.
            assign ttMgcProcedFamilia-aux.fm-equipto = p-fm-equipto-origem.
        end.
    end.

      do transaction:
           for each ttMgcProcedFamilia-aux by ttMgcProcedFamilia-aux.cod-proced-calib:
               if not can-find(mgc-proced-familia where mgc-proced-familia.fm-equipto = p-fm-equipto-destino
                                             and mgc-proced-familia.cod-proced-calib = ttMgcProcedFamilia-aux.cod-proced-calib) then do:
                   create mgc-proced-familia.
                   assign mgc-proced-familia.fm-equipto = p-fm-equipto-destino
                          mgc-proced-familia.cod-proced-calib  = ttMgcProcedFamilia-aux.cod-proced-calib
                          mgc-proced-familia.dat-desativ       = ttMgcProcedFamilia-aux.dat-desativ.
               end.
           end.
     end.         

END PROCEDURE.

