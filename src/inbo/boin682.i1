**  BOIN682.i1
**
**  Procedure goToKey/FindCodigo : estas procedures foram
**  transformadas em include pois este codigo e comum aos produtos EMS e
**  Magnus.
**
*/


PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no ¡ndice CODIGO
  Parameters:
               recebe valor dos campos do ¡ndice CODIGO
               retorna status do processo
  Notes:
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pgrupo LIKE param-global.grupo NO-UNDO.

    FIND FIRST bfparam-global WHERE
        bfparam-global.grupo = pgrupo
        NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser  retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfparam-global THEN
        RETURN "NOK":U.

    /*--- Reposiciona query atrav‚s de rowid e verifica a ocorrˆncia de erros, caso
          existam erros ser  retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfparam-global)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

PROCEDURE findCodigo :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

def input parameter c-grupo as char no-undo.
def output parameter c-return as char no-undo.

run openQueryStatic in this-procedure (input "Main":U).
run goToKey in this-procedure (input c-grupo).

if return-value = "NOK":U then
    assign c-return = "NOK":U.

END PROCEDURE.

&IF DEFINED(bf-mat-comex) &THEN    /* Magnus */
PROCEDURE retornaFormatoContaContabil :
/*------------------------------------------------------------------------------
  Purpose:     Retornar o formato da conta cont bil cadastrado nos parƒmetros
               globais (somente para Magnus, que nÆo possui essa informa‡Æo 
               gravada diretamente na tabela param-global
  Parameters:  OUPUT do formato
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE OUTPUT PARAMETER cFormato AS CHARACTER NO-UNDO.

    FIND mgadm._file WHERE
         mgadm._file._file-name = "conta-contab":U NO-LOCK.
    FIND mgadm._field OF mgadm._file WHERE
         mgadm._field._field-name = "conta" NO-LOCK.

    ASSIGN cFormato = mgadm._field._format.

    RETURN 'OK':U.
END PROCEDURE.
&ENDIF
