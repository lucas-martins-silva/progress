&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE pi-cria-adit-campos DBOProgram 
PROCEDURE pi-cria-adit-campos :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

DEF INPUT PARAM p-desc-tabela    AS CHAR FORMAT "X(40)".
DEF INPUT PARAM p-desc-campo     AS CHAR FORMAT "X(40)".
DEF INPUT PARAM p-nome-tabela    LIKE adit-campos.nome-tabela NO-UNDO.
DEF INPUT PARAM p-nome-campo     LIKE adit-campos.nome-campo NO-UNDO.

IF NOT CAN-FIND ({&TableName} WHERE {&TableName}.nome-tabela            = p-nome-tabela
                               AND  {&TableName}.nome-campo             = p-nome-campo ) THEN DO:
    CREATE {&TableName}.

    ASSIGN {&TableName}.nome-tabela = p-nome-tabela  
           {&TableName}.nome-campo  = p-nome-campo  
    &IF '{&bf_mat_versao_ems}' >= '2.06' &THEN
           {&TableName}.des-tabela  = p-desc-tabela 
           {&TableName}.des-campo   = p-desc-campo
    &else
           OVERLAY({&TableName}.char-1,1,40 )  = p-desc-tabela
           OVERLAY({&TableName}.char-1,41,40 ) = p-desc-campo
    &endif. 

END.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE pi-elimina-adit-campos DBOProgram 
PROCEDURE pi-elimina-adit-campos :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

DEF INPUT PARAM p-nome-tabela  LIKE adit-campos.nome-tabela NO-UNDO.
DEF INPUT PARAM p-nome-campo   LIKE adit-campos.nome-campo NO-UNDO.


FIND bf{&TableName} WHERE bf{&TableName}.nome-tabela           = p-nome-tabela                      
                    AND   bf{&TableName}.nome-campo            = p-nome-campo EXCLUSIVE-LOCK NO-ERROR.                    
                  
IF  AVAIL bf{&TableName} THEN 
    DELETE bf{&TableName}.
ELSE 
    RETURN "NOK":U.

RETURN "OK":U.
END PROCEDURE.

