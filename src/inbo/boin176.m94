DEF VAR c-origem-it        AS CHARACTER            NO-UNDO.
DEF VAR c-cst-icms         AS CHARACTER            NO-UNDO.
DEF VAR c-cst-ipi          AS CHARACTER            NO-UNDO.
DEF VAR c-cst-pis          AS CHARACTER            NO-UNDO.
DEF VAR c-cst-cofins       AS CHARACTER            NO-UNDO.

IF CAN-FIND (FIRST tt-item-doc-est-tribut NO-LOCK
             WHERE tt-item-doc-est-tribut.cod-serie-docto  = {1}.serie-docto 
               AND tt-item-doc-est-tribut.cod-num-docto    = {1}.nro-docto   
               AND tt-item-doc-est-tribut.cdn-emitente     = {1}.cod-emitente
               AND tt-item-doc-est-tribut.cod-natur-operac = {1}.nat-operacao
               AND tt-item-doc-est-tribut.num-seq          = {1}.sequencia) THEN DO:

    ASSIGN {1}.cd-trib-ipi            = 1
           {1}.aliquota-ipi           = 0
           {1}.val-perc-rep-ipi       = 0
           {1}.base-ipi[1]            = 0
           {1}.ipi-ntrib[1]           = 0
           {1}.ipi-outras[1]          = 0
           {1}.valor-ipi[1]           = 0.
                                
    ASSIGN {1}.cd-trib-icm            = 1
           {1}.aliquota-icm           = 0
           {1}.val-perc-red-icms      = 0
           {1}.base-icm               = 0
           {1}.icm-ntrib              = 0
           {1}.icm-outras[1]          = 0
           {1}.valor-icm              = 0
           OVERLAY({1}.char-2,796,6)  = string(0)
           OVERLAY({1}.char-2,802,17) = string(0)
           OVERLAY({1}.char-2,860,20) = string(0)
           {1}.icm-complem            = 0
           {1}.base-subs              = 0
           {1}.vl-subs                = 0.
                                    
    ASSIGN {1}.idi-tributac-pis       = 1
           {1}.val-aliq-pis           = 0
           de-aliquota-pis            = 0
           {1}.base-pis               = 0
           {1}.valor-pis              = 0.
                                       
    ASSIGN {1}.idi-tributac-cofins    = 1
           {1}.val-aliq-cofins        = 0
           de-aliquota-cofins         = 0
           {1}.val-base-calc-cofins   = 0
           {1}.val-cofins             = 0.
           
    EMPTY TEMP-TABLE tt-ext-item-doc-est.
    /*Zerar valores do desonerado na tabela ext-item-doc-est*/
    CREATE tt-ext-item-doc-est.
    ASSIGN tt-ext-item-doc-est.serie-docto  = {1}.serie-docto 
           tt-ext-item-doc-est.nro-docto    = {1}.nro-docto   
           tt-ext-item-doc-est.cod-emitente = {1}.cod-emitente
           tt-ext-item-doc-est.nat-operacao = {1}.nat-operacao
           tt-ext-item-doc-est.sequencia    = {1}.sequencia
           tt-ext-item-doc-est.cod-param    = "icms-deson":U
           tt-ext-item-doc-est.val-livre-1  = 0    // Aliquota desonerado
           tt-ext-item-doc-est.val-livre-2  = 0    // Valor desonerado
           tt-ext-item-doc-est.log-livre-1  = YES. // Aplica como desconto

    /*Zerar valores de FCP e FCP ST na tabela ext-item-doc-est*/
    CREATE tt-ext-item-doc-est.
    ASSIGN tt-ext-item-doc-est.serie-docto               = {1}.serie-docto 
           tt-ext-item-doc-est.nro-docto                 = {1}.nro-docto   
           tt-ext-item-doc-est.cod-emitente              = {1}.cod-emitente
           tt-ext-item-doc-est.nat-operacao              = {1}.nat-operacao
           tt-ext-item-doc-est.sequencia                 = {1}.sequencia
           tt-ext-item-doc-est.cod-param                 = "fcp":U    
           tt-ext-item-doc-est.val-livre-1               = 0  
           tt-ext-item-doc-est.val-livre-2               = 0
           tt-ext-item-doc-est.val-livre-3               = 0
           tt-ext-item-doc-est.val-livre-4               = 0
           tt-ext-item-doc-est.val-livre-5               = 0
           tt-ext-item-doc-est.val-livre-6               = 0
           OVERLAY(tt-ext-item-doc-est.cod-livre-1,1,20) = '0'
           OVERLAY(tt-ext-item-doc-est.cod-livre-1,21,8) = '0'. 
           
    /*Zerar valores do Simples Nacional na tabela ext-item-doc-est*/
    IF  AVAIL emitente 
    AND SUBSTRING(emitente.char-1,133,1) = "S":U /*Optante Simples Nacional*/ THEN DO:
        CREATE tt-ext-item-doc-est.
        ASSIGN tt-ext-item-doc-est.serie-docto  = {1}.serie-docto 
               tt-ext-item-doc-est.nro-docto    = {1}.nro-docto   
               tt-ext-item-doc-est.cod-emitente = {1}.cod-emitente
               tt-ext-item-doc-est.nat-operacao = {1}.nat-operacao
               tt-ext-item-doc-est.sequencia    = {1}.sequencia
               tt-ext-item-doc-est.cod-param    = "simplesnacional":U
               tt-ext-item-doc-est.val-livre-1                  = 0     /* Aliquota Simples Nacional */
               tt-ext-item-doc-est.val-livre-2                  = 0     /* Base Simples Nacional */          
               tt-ext-item-doc-est.val-livre-3                  = 0     /* Valor Simples Nacional */
               OVERLAY(tt-ext-item-doc-est.cod-livre-1,1,10)    = '0'.  /* CSOSN  Simples Nacional */
    END.
    
    FIND FIRST bf-natur-oper-item WHERE bf-natur-oper-item.nat-operacao = {1}.nat-of NO-LOCK NO-ERROR.

    FOR EACH tt-item-doc-est-tribut NO-LOCK
       WHERE tt-item-doc-est-tribut.cod-serie-docto  = {1}.serie-docto 
         AND tt-item-doc-est-tribut.cod-num-docto    = {1}.nro-docto   
         AND tt-item-doc-est-tribut.cdn-emitente     = {1}.cod-emitente
         AND tt-item-doc-est-tribut.cod-natur-operac = {1}.nat-operacao
         AND tt-item-doc-est-tribut.num-seq          = {1}.sequencia: 

        // Conteudo do campo em formato decimal
        ASSIGN d-cod-conteudo = 0.
        ASSIGN d-cod-conteudo = DEC(REPLACE(tt-item-doc-est-tribut.cod-conteudo,".",",")) NO-ERROR.  
           
        CASE tt-item-doc-est-tribut.nom-trib:
            WHEN rep.imp.Imposto:ICMS THEN DO:
                CASE tt-item-doc-est-tribut.cod-campo:
                    WHEN AtributoImposto:CST           THEN ASSIGN c-cst-icms                 = tt-item-doc-est-tribut.cod-conteudo.
                    WHEN AtributoImposto:ORIGEM        THEN ASSIGN c-origem-it                = tt-item-doc-est-tribut.cod-conteudo.
                    WHEN AtributoImposto:COD-TRIB      THEN ASSIGN {1}.cd-trib-icm            = INT(tt-item-doc-est-tribut.cod-conteudo).
                    WHEN AtributoImposto:ALIQUOTA      THEN ASSIGN {1}.aliquota-icm           = d-cod-conteudo.
                    WHEN AtributoImposto:PERC-REDUC-BC THEN ASSIGN {1}.val-perc-red-icms      = d-cod-conteudo.
                    WHEN AtributoImposto:BASE-TRIB     THEN ASSIGN {1}.base-icm               = d-cod-conteudo.
                    WHEN AtributoImposto:BASE-ISENTA   THEN ASSIGN {1}.icm-ntrib              = d-cod-conteudo.
                    WHEN AtributoImposto:BASE-OUTRAS   THEN ASSIGN {1}.icm-outras[1]          = d-cod-conteudo.
                    WHEN AtributoImposto:VALOR         THEN ASSIGN {1}.valor-icm              = d-cod-conteudo.
                    WHEN AtributoImposto:VALOR-OUTRAS  THEN ASSIGN {1}.icm-outras[2]          = d-cod-conteudo.
                    WHEN AtributoImposto:PERC-DIFER    THEN ASSIGN OVERLAY({1}.char-2,796,6)  = STRING(d-cod-conteudo).
                    WHEN AtributoImposto:VALOR-DIFER   THEN ASSIGN OVERLAY({1}.char-2,802,17) = STRING(d-cod-conteudo).
                    WHEN AtributoImposto:VALOR-DESON OR WHEN
                         AtributoImposto:ALIQ-DESON  OR WHEN
                         AtributoImposto:DEDUZ-DESON THEN DO:
                        FIND FIRST tt-ext-item-doc-est 
                             WHERE tt-ext-item-doc-est.serie-docto  = {1}.serie-docto 
                               AND tt-ext-item-doc-est.nro-docto    = {1}.nro-docto   
                               AND tt-ext-item-doc-est.cod-emitente = {1}.cod-emitente
                               AND tt-ext-item-doc-est.nat-operacao = {1}.nat-operacao
                               AND tt-ext-item-doc-est.sequencia    = {1}.sequencia
                               AND tt-ext-item-doc-est.cod-param    = "icms-deson":U NO-ERROR.

                        CASE tt-item-doc-est-tribut.cod-campo:
                            WHEN AtributoImposto:ALIQ-DESON THEN
                                ASSIGN tt-ext-item-doc-est.val-livre-1 = d-cod-conteudo.
                            WHEN AtributoImposto:VALOR-DESON THEN
                                ASSIGN tt-ext-item-doc-est.val-livre-2 = d-cod-conteudo.
                            WHEN AtributoImposto:DEDUZ-DESON THEN // Aplica como desconto
                                ASSIGN tt-ext-item-doc-est.log-livre-1 = (NOT TRIM(tt-item-doc-est-tribut.cod-conteudo) = "0").
                        END CASE.
                    END.
                END CASE.
            END.
            WHEN rep.imp.Imposto:SIMPLES THEN DO:
            
                IF NOT CAN-FIND(FIRST tt-ext-item-doc-est NO-LOCK
                                WHERE tt-ext-item-doc-est.serie-docto   = {1}.serie-docto
                                  AND tt-ext-item-doc-est.nro-docto     = {1}.nro-docto
                                  AND tt-ext-item-doc-est.cod-emitente  = {1}.cod-emitente
                                  AND tt-ext-item-doc-est.nat-operacao  = {1}.nat-operacao
                                  AND tt-ext-item-doc-est.sequencia     = {1}.sequencia
                                  AND tt-ext-item-doc-est.cod-param     = "simplesnacional":U) THEN DO:
                    CREATE tt-ext-item-doc-est.
                    ASSIGN tt-ext-item-doc-est.serie-docto                  = {1}.serie-docto 
                           tt-ext-item-doc-est.nro-docto                    = {1}.nro-docto   
                           tt-ext-item-doc-est.cod-emitente                 = {1}.cod-emitente
                           tt-ext-item-doc-est.nat-operacao                 = {1}.nat-operacao
                           tt-ext-item-doc-est.sequencia                    = {1}.sequencia
                           tt-ext-item-doc-est.cod-param                    = "simplesnacional":U.
                END.                           
            
                FIND FIRST tt-ext-item-doc-est
                     WHERE tt-ext-item-doc-est.serie-docto   = {1}.serie-docto
                       AND tt-ext-item-doc-est.nro-docto     = {1}.nro-docto
                       AND tt-ext-item-doc-est.cod-emitente  = {1}.cod-emitente
                       AND tt-ext-item-doc-est.nat-operacao  = {1}.nat-operacao
                       AND tt-ext-item-doc-est.sequencia     = {1}.sequencia
                       AND tt-ext-item-doc-est.cod-param     = "simplesnacional":U NO-ERROR.
                CASE tt-item-doc-est-tribut.cod-campo:
                    WHEN AtributoImposto:ORIGEM        THEN ASSIGN OVERLAY(tt-ext-item-doc-est.cod-livre-1,1,1)     = STRING(d-cod-conteudo).
                    WHEN AtributoImposto:CSOSN         THEN ASSIGN OVERLAY(tt-ext-item-doc-est.cod-livre-1,2,9)     = STRING(d-cod-conteudo).
                    WHEN AtributoImposto:ALIQUOTA      THEN ASSIGN tt-ext-item-doc-est.val-livre-1                  = d-cod-conteudo.
                    WHEN AtributoImposto:BASE          THEN ASSIGN tt-ext-item-doc-est.val-livre-2                  = d-cod-conteudo.
                    WHEN AtributoImposto:VALOR         THEN ASSIGN tt-ext-item-doc-est.val-livre-3                  = d-cod-conteudo.
                END CASE.                    
            END.
            WHEN rep.imp.Imposto:ICMS-ST OR WHEN rep.imp.Imposto:ICMS-STA THEN DO:
            
                {inbo/boin176.m73 "{1}.it-codigo"}
                
                /* Verificar se marca ou n∆o o icms-retido (log-2) */ 
                IF bf-natur-oper-item.log-icms-substto-antecip AND NOT lSujTribMonofasica THEN
                    ASSIGN {1}.log-2 = IF bf-natur-oper-item.tipo-compra <= 3 AND NOT bf-natur-oper-item.terceiros THEN YES
                                       ELSE {1}.log-2.
                ELSE
                    ASSIGN {1}.log-2 = IF bf-natur-oper-item.subs-trib AND bf-natur-oper-item.tipo-compra = 2 THEN YES /* Frete */
                                       ELSE {1}.log-2.

                FIND FIRST tt-item-nf-adc
                     WHERE tt-item-nf-adc.cod-estab             = docum-est.cod-estabel
                       AND tt-item-nf-adc.cod-serie             = {1}.serie-docto
                       AND tt-item-nf-adc.cod-nota-fisc         = {1}.nro-docto
                       AND tt-item-nf-adc.cdn-emitente          = {1}.cod-emitente
                       AND tt-item-nf-adc.cod-natur-operac      = {1}.nat-operacao
                       AND tt-item-nf-adc.idi-tip-dado          = 1
                       AND tt-item-nf-adc.num-seq               = 1
                       AND tt-item-nf-adc.num-seq-item-nf       = {1}.sequencia
                       AND tt-item-nf-adc.cod-item              = {1}.it-codigo NO-ERROR.
                
                IF NOT AVAIL tt-item-nf-adc THEN DO:
                    create tt-item-nf-adc.
                    assign tt-item-nf-adc.cod-estab             = docum-est.cod-estabel
                           tt-item-nf-adc.cod-serie             = {1}.serie-docto
                           tt-item-nf-adc.cod-nota-fisc         = {1}.nro-docto
                           tt-item-nf-adc.cdn-emitente          = {1}.cod-emitente
                           tt-item-nf-adc.cod-natur-operac      = {1}.nat-operacao
                           tt-item-nf-adc.idi-tip-dado          = 1
                           tt-item-nf-adc.num-seq               = 1
                           tt-item-nf-adc.num-seq-item-nf       = {1}.sequencia
                           tt-item-nf-adc.cod-item              = {1}.it-codigo.
                END.

                CASE tt-item-doc-est-tribut.cod-campo:
                    WHEN AtributoImposto:BASE          THEN ASSIGN {1}.base-subs                   = d-cod-conteudo.
                    WHEN AtributoImposto:VALOR         THEN ASSIGN {1}.vl-subs                     = d-cod-conteudo.
                    WHEN AtributoImposto:ALIQUOTA      THEN ASSIGN tt-item-nf-adc.val-aliq-icms-st = d-cod-conteudo.
                    WHEN AtributoImposto:PERC-MVA-ST   THEN ASSIGN tt-item-nf-adc.val-livre-1      = d-cod-conteudo. // % MVA
                    WHEN AtributoImposto:PERC-REDUC-BC THEN ASSIGN tt-item-nf-adc.val-livre-2      = d-cod-conteudo. // % Red BC ST
                END CASE.
            END.
            WHEN rep.imp.Imposto:ICMS-COMPL THEN DO:
                CASE tt-item-doc-est-tribut.cod-campo:
                    WHEN AtributoImposto:BASE  THEN ASSIGN OVERLAY({1}.char-2,860,20) = STRING(d-cod-conteudo).
                    WHEN AtributoImposto:VALOR THEN ASSIGN {1}.icm-complem            = d-cod-conteudo.
                END CASE.
            END.
            WHEN rep.imp.Imposto:FCP OR WHEN rep.imp.Imposto:FCP-ST OR WHEN rep.imp.Imposto:FCP-STA THEN DO:
                FIND FIRST tt-ext-item-doc-est 
                     WHERE tt-ext-item-doc-est.serie-docto  = {1}.serie-docto 
                       AND tt-ext-item-doc-est.nro-docto    = {1}.nro-docto   
                       AND tt-ext-item-doc-est.cod-emitente = {1}.cod-emitente
                       AND tt-ext-item-doc-est.nat-operacao = {1}.nat-operacao
                       AND tt-ext-item-doc-est.sequencia    = {1}.sequencia
                       AND tt-ext-item-doc-est.cod-param    = "fcp":U NO-ERROR.

                IF tt-item-doc-est-tribut.nom-trib = rep.imp.Imposto:FCP THEN
                    CASE tt-item-doc-est-tribut.cod-campo:
                        WHEN AtributoImposto:BASE           THEN ASSIGN tt-ext-item-doc-est.val-livre-1 = d-cod-conteudo.
                        WHEN AtributoImposto:VALOR          THEN ASSIGN tt-ext-item-doc-est.val-livre-3 = d-cod-conteudo.
                        WHEN AtributoImposto:ALIQUOTA       THEN ASSIGN tt-ext-item-doc-est.val-livre-2 = d-cod-conteudo.
                        WHEN AtributoImposto:PERC-DIFER     THEN ASSIGN OVERLAY(tt-ext-item-doc-est.cod-livre-1,1,20) = STRING(d-cod-conteudo).
                        WHEN AtributoImposto:VALOR-DIFER    THEN ASSIGN OVERLAY(tt-ext-item-doc-est.cod-livre-1,21,8) = STRING(d-cod-conteudo).
                    END CASE.
                ELSE // FCP ST ou FCP STA
                    CASE tt-item-doc-est-tribut.cod-campo:
                        WHEN AtributoImposto:BASE     THEN ASSIGN tt-ext-item-doc-est.val-livre-4 = d-cod-conteudo.
                        WHEN AtributoImposto:VALOR    THEN ASSIGN tt-ext-item-doc-est.val-livre-6 = d-cod-conteudo.
                        WHEN AtributoImposto:ALIQUOTA THEN ASSIGN tt-ext-item-doc-est.val-livre-5 = d-cod-conteudo.
                    END CASE.                

                /* 1-FCP Normal, 2-FCP Subst. Trib., 3-FCP Subst. Trib. Antecip */
                ASSIGN tt-ext-item-doc-est.num-livre-2 = 1.       
                IF AVAIL bf-natur-oper-item AND bf-natur-oper-item.subs-trib THEN
                    ASSIGN tt-ext-item-doc-est.num-livre-2 = 2.
                ELSE IF AVAIL bf-natur-oper-item AND 
                        (bf-natur-oper-item.log-contrib-st-antec or bf-natur-oper-item.log-icms-substto-antecip) AND 
                        NOT bf-natur-oper-item.terceiros THEN  
                    ASSIGN tt-ext-item-doc-est.num-livre-2 = 3.
            END.
            WHEN rep.imp.Imposto:IPI THEN DO:
                CASE tt-item-doc-est-tribut.cod-campo:
                    WHEN AtributoImposto:CST           THEN ASSIGN c-cst-ipi            = tt-item-doc-est-tribut.cod-conteudo.
                    WHEN AtributoImposto:COD-TRIB      THEN ASSIGN {1}.cd-trib-ipi      = INT(tt-item-doc-est-tribut.cod-conteudo).
                    WHEN AtributoImposto:ALIQUOTA      THEN ASSIGN {1}.aliquota-ipi     = d-cod-conteudo.
                    WHEN AtributoImposto:PERC-REDUC-BC THEN ASSIGN {1}.val-perc-rep-ipi = d-cod-conteudo.
                    WHEN AtributoImposto:BASE-TRIB     THEN ASSIGN {1}.base-ipi[1]      = d-cod-conteudo.
                    WHEN AtributoImposto:BASE-ISENTA   THEN ASSIGN {1}.ipi-ntrib[1]     = d-cod-conteudo.
                    WHEN AtributoImposto:BASE-OUTRAS   THEN ASSIGN {1}.ipi-outras[1]    = d-cod-conteudo.
                    WHEN AtributoImposto:VALOR         THEN ASSIGN {1}.valor-ipi[1]     = d-cod-conteudo.
                END CASE.
            END.
            WHEN rep.imp.Imposto:PIS THEN DO:
                CASE tt-item-doc-est-tribut.cod-campo:
                    WHEN AtributoImposto:CST      THEN ASSIGN c-cst-pis            = tt-item-doc-est-tribut.cod-conteudo.
                    WHEN AtributoImposto:COD-TRIB THEN ASSIGN {1}.idi-tributac-pis = INT(tt-item-doc-est-tribut.cod-conteudo).
                    WHEN AtributoImposto:ALIQUOTA THEN ASSIGN {1}.val-aliq-pis     = d-cod-conteudo
                                                              de-aliquota-pis      = d-cod-conteudo.
                    WHEN AtributoImposto:BASE     THEN ASSIGN {1}.base-pis         = d-cod-conteudo.
                    WHEN AtributoImposto:VALOR    THEN ASSIGN {1}.valor-pis        = d-cod-conteudo.
                END CASE.
            END.
            WHEN rep.imp.Imposto:COFINS THEN DO:
                CASE tt-item-doc-est-tribut.cod-campo:
                    WHEN AtributoImposto:CST      THEN ASSIGN c-cst-cofins             = tt-item-doc-est-tribut.cod-conteudo.
                    WHEN AtributoImposto:COD-TRIB THEN ASSIGN {1}.idi-tributac-cofins  = INT(tt-item-doc-est-tribut.cod-conteudo).
                    WHEN AtributoImposto:ALIQUOTA THEN ASSIGN {1}.val-aliq-cofins      = d-cod-conteudo
                                                              de-aliquota-cofins       = d-cod-conteudo.
                    WHEN AtributoImposto:BASE     THEN ASSIGN {1}.val-base-calc-cofins = d-cod-conteudo.
                    WHEN AtributoImposto:VALOR    THEN ASSIGN {1}.val-cofins           = d-cod-conteudo.
                END CASE.
            END.
        END CASE.
        
        /* atualizar valores de pis/cofins ST - N∆o tratar por enquanto */
        
    END. /* FOR EACH tt-item-doc-est-tribut */
    
    /* PIS / COFINS Atualiza Aliquota *****************************/
    RUN grava-aliquotas IN h-cdapi995 (INPUT "item-doc-est",
                                       INPUT {1}.serie-docto + "/" + 
                                             {1}.nro-docto + "/" + 
                                             STRING({1}.cod-emitente) + "/" + 
                                             {1}.nat-operacao + "/" + 
                                             STRING({1}.sequencia), 
                                       INPUT de-aliquota-pis, 
                                       INPUT de-aliquota-cofins).
    /**************************************************************/         

    /* Atualiza CST ***********************************************/
    /*atualizar os CSTs na tabela item-doc-est-tribut*/
    /**************************************************************/                      
    FOR FIRST tt-item-doc-est-tribut
        WHERE tt-item-doc-est-tribut.cod-serie-docto  = {1}.serie-docto 
          AND tt-item-doc-est-tribut.cod-num-docto    = {1}.nro-docto   
          AND tt-item-doc-est-tribut.cdn-emitente     = {1}.cod-emitente
          AND tt-item-doc-est-tribut.cod-natur-operac = {1}.nat-operacao
          AND tt-item-doc-est-tribut.num-seq          = {1}.sequencia
          AND tt-item-doc-est-tribut.nom-trib         = rep.imp.Imposto:ICMS
          AND tt-item-doc-est-tribut.cod-campo        = AtributoImposto:CST:
        
        IF c-origem-it = '' THEN
            ASSIGN c-origem-it = IF AVAIL ITEM THEN STRING(ITEM.codigo-orig) ELSE ''.
        
        ASSIGN tt-item-doc-est-tribut.cod-conteudo = c-origem-it + c-cst-icms   // no RE1001 o campo de CST Ç composto de origem + cst
        
               // campo char que armazena origem + CST ICMS
               OVERLAY({1}.char-2,502,3) = IF tt-item-doc-est-tribut.cod-conteudo <> ? THEN tt-item-doc-est-tribut.cod-conteudo ELSE ""
               OVERLAY({1}.char-2,637,3) = c-origem-it.
    END.

    FOR EACH ct-trib-item-doc-est EXCLUSIVE-LOCK
       WHERE ct-trib-item-doc-est.cdn-emitente      = {1}.cod-emitente
         AND ct-trib-item-doc-est.cod-ser-docto     = {1}.serie-docto
         AND ct-trib-item-doc-est.cod-docto         = {1}.nro-docto
         AND ct-trib-item-doc-est.cod-natur-operac  = {1}.nat-operacao
         AND ct-trib-item-doc-est.num-seq           = {1}.sequencia:
          
        IF ct-trib-item-doc-est.cod-tip-trib <> "COD AJUSTE":U AND
           ct-trib-item-doc-est.cod-tip-trib <> "COD INF ADIC":U THEN
            DELETE ct-trib-item-doc-est.
    END.
             
END.    
