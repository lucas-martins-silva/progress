/*------------------------------------------------------------------------------
  Purpose:     Include com o c¢digo da procedure setConsistPend na boin767c.p.
               Foi necess†rio criar a include pois estava excedendo o tamanho da
               BO, nao deixando assim ser editado a procedure
  
------------------------------------------------------------------------------*/    

    EMPTY TEMP-TABLE tt-erros.

    /**  Verifica documento previamente aprovado
    **/
    if  not available mla-doc-pend-aprov THEN DO:
    
        RUN pi-gerar-dados-extrato (INPUT " entrou boin767c.i2 ").

        FIND LAST b-mla-doc-pend-aprov
            WHERE b-mla-doc-pend-aprov.nr-trans = tt-pendencia.nr-trans NO-LOCK NO-ERROR.

        IF  AVAIL b-mla-doc-pend-aprov THEN DO:
            CASE b-mla-doc-pend-aprov.ind-situacao:
                WHEN 2 THEN DO: /* Aprovado   */
                    /**  INICIO Chamada EPC 
                    **/
                    EMPTY TEMP-TABLE tt-epc.

                    create tt-epc.
                    assign tt-epc.cod-event     = "ENTER-mlaapi100-APROVADO":U
                           tt-epc.cod-parameter = "mla-doc-pend-aprov-rowid"
                           tt-epc.val-parameter = string(gr-mla-rowid-pend).
                    {include/i-epc201.i "ENTER-mlaapi100"}
                    IF  RETURN-VALUE = "NOK" THEN DO:
                        ASSIGN p-cod-erro  = 999999.
                        {method/svc/errors/inserr.i &ErrorNumber="34029"
                                                    &ErrorType="EMS":U
                                                    &ErrorSubType="ERROR":U
                                                    &ErrorParameters="''"}
                    END.
                    /**  FIM Chamada EPC  **/

                    IF  b-mla-doc-pend-aprov.cod-usuar-altern <> "" THEN DO:

                        FIND FIRST tt-mla-usuar-aprov WHERE tt-mla-usuar-aprov.cod-usuar = b-mla-doc-pend-aprov.cod-usuar-altern NO-LOCK NO-ERROR.

                        IF NOT AVAIL tt-mla-usuar-aprov THEN DO:

                            FOR FIRST b-mla-usuar-aprov FIELDS (cod-usuar nome-usuar e-mail recebe-email)
                                WHERE b-mla-usuar-aprov.cod-usuar = b-mla-doc-pend-aprov.cod-usuar-altern NO-LOCK:

                                CREATE tt-mla-usuar-aprov.
                                ASSIGN tt-mla-usuar-aprov.cod-usuar    = b-mla-usuar-aprov.cod-usuar      
                                       tt-mla-usuar-aprov.nome-usuar   = b-mla-usuar-aprov.nome-usuar     
                                       tt-mla-usuar-aprov.e-mail       = b-mla-usuar-aprov.e-mail         
                                       tt-mla-usuar-aprov.recebe-email = b-mla-usuar-aprov.recebe-email. 
                            END. 
                        END.

                        ASSIGN c-usuar-nome-usuar = tt-mla-usuar-aprov.nome-usuar.
                        IF AVAIL tt-mla-usuar-aprov THEN DO:
                            assign p-desc-erro = "Documento previamente Aprovado pelo usu†rio (Aprovador Alternativo) " 
                                               + b-mla-doc-pend-aprov.cod-usuar-altern
                                               + '(' 
                                               + c-usuar-nome-usuar
                                               + ')'
                                               + " no dia " 
                                               + STRING(b-mla-doc-pend-aprov.dt-aprova,'99/99/9999').
                            {method/svc/errors/inserr.i &ErrorNumber="34025"
                                                        &ErrorType="EMS":U
                                                        &ErrorSubType="ERROR":U
                                                        &ErrorParameters="b-mla-doc-pend-aprov.cod-usuar-altern + ' (' + c-usuar-nome-usuar + ')' + '~~~~' + 
                                                                          STRING(b-mla-doc-pend-aprov.dt-aprova,'99/99/9999') "}
                        END.
                    END.
                    ELSE DO:
                        FIND FIRST tt-mla-usuar-aprov WHERE tt-mla-usuar-aprov.cod-usuar = b-mla-doc-pend-aprov.cod-usuar NO-LOCK NO-ERROR.

                        IF NOT AVAIL tt-mla-usuar-aprov THEN DO:

                            FOR FIRST b-mla-usuar-aprov FIELDS (cod-usuar nome-usuar e-mail recebe-email)
                                WHERE b-mla-usuar-aprov.cod-usuar = b-mla-doc-pend-aprov.cod-usuar NO-LOCK: 

                                CREATE tt-mla-usuar-aprov.
                                ASSIGN tt-mla-usuar-aprov.cod-usuar    = b-mla-usuar-aprov.cod-usuar      
                                       tt-mla-usuar-aprov.nome-usuar   = b-mla-usuar-aprov.nome-usuar     
                                       tt-mla-usuar-aprov.e-mail       = b-mla-usuar-aprov.e-mail         
                                       tt-mla-usuar-aprov.recebe-email = b-mla-usuar-aprov.recebe-email. 
                            END. 
                        END.

                        ASSIGN c-usuar-nome-usuar = tt-mla-usuar-aprov.nome-usuar.
                        IF AVAIL tt-mla-usuar-aprov THEN DO:
                            assign p-desc-erro = "Documento previamente Aprovado pelo usu†rio " 
                                               + b-mla-doc-pend-aprov.cod-usuar 
                                               + " (" 
                                               + c-usuar-nome-usuar
                                               + ")" 
                                               + " no dia " 
                                              + STRING(b-mla-doc-pend-aprov.dt-aprova,"99/99/9999").
                            {method/svc/errors/inserr.i &ErrorNumber="34026"
                                                        &ErrorType="EMS":U
                                                        &ErrorSubType="ERROR":U
                                                        &ErrorParameters="b-mla-doc-pend-aprov.cod-usuar + ' (' + c-usuar-nome-usuar + ')' + '~~~~' + 
                                                                          STRING(b-mla-doc-pend-aprov.dt-aprova,'99/99/9999') "}
                        END.
                    END.
                END.
                WHEN 3 THEN DO: /* Rejeitado  */
                    /**  INICIO Chamada EPC  
                    **/
                    EMPTY TEMP-TABLE tt-epc.

                    create tt-epc.
                    assign tt-epc.cod-event     = "ENTER-mlaapi100-REJEITADO":U
                           tt-epc.cod-parameter = "mla-doc-pend-aprov-rowid"
                           tt-epc.val-parameter = string(gr-mla-rowid-pend).
                    {include/i-epc201.i "ENTER-mlaapi100"}
                    IF  RETURN-VALUE = "NOK" THEN DO:
                        ASSIGN p-cod-erro  = 999999.
                        {method/svc/errors/inserr.i &ErrorNumber="34029"
                                                    &ErrorType="EMS":U
                                                    &ErrorSubType="ERROR":U
                                                    &ErrorParameters="''"}
                    END.
                    /**  FIM Chamada EPC  **/

                    IF  b-mla-doc-pend-aprov.cod-usuar-altern <> "" and not l-aprov-via-portal THEN DO:

                        FIND FIRST tt-mla-usuar-aprov WHERE tt-mla-usuar-aprov.cod-usuar = b-mla-doc-pend-aprov.cod-usuar-altern NO-LOCK NO-ERROR.

                        IF NOT AVAIL tt-mla-usuar-aprov THEN DO:

                            FOR FIRST b-mla-usuar-aprov FIELDS (cod-usuar nome-usuar e-mail recebe-email)
                                WHERE b-mla-usuar-aprov.cod-usuar = b-mla-doc-pend-aprov.cod-usuar-altern NO-LOCK:

                                CREATE tt-mla-usuar-aprov.
                                ASSIGN tt-mla-usuar-aprov.cod-usuar    = b-mla-usuar-aprov.cod-usuar      
                                       tt-mla-usuar-aprov.nome-usuar   = b-mla-usuar-aprov.nome-usuar     
                                       tt-mla-usuar-aprov.e-mail       = b-mla-usuar-aprov.e-mail         
                                       tt-mla-usuar-aprov.recebe-email = b-mla-usuar-aprov.recebe-email. 
                            END. 
                        END.

                        ASSIGN c-usuar-nome-usuar = tt-mla-usuar-aprov.nome-usuar.
                        IF AVAIL tt-mla-usuar-aprov THEN DO:
                            assign p-desc-erro = "Documento previamente Rejeitado pelo usu†rio (Aprovador Alternativo) " 
                                               + b-mla-doc-pend-aprov.cod-usuar-altern 
                                               + " (" 
                                               + c-usuar-nome-usuar
                                               + ")" 
                                               + " no dia " 
                                               + STRING(b-mla-doc-pend-aprov.dt-rejeita,"99/99/9999").
                            IF  tt-pendencia.tipo-trans <> 3 THEN /*Se n∆o for reaprovaá∆o*/                   
                                {method/svc/errors/inserr.i &ErrorNumber="34027"
                                                            &ErrorType="EMS":U
                                                            &ErrorSubType="ERROR":U
                                                            &ErrorParameters="b-mla-doc-pend-aprov.cod-usuar-altern + ' (' + c-usuar-nome-usuar + ')' + '~~~~' + 
                                                                              STRING(b-mla-doc-pend-aprov.dt-rejeita,'99/99/9999') "}
                        END.
                    END.
                    ELSE DO:

                        FIND FIRST tt-mla-usuar-aprov WHERE tt-mla-usuar-aprov.cod-usuar = b-mla-doc-pend-aprov.cod-usuar NO-LOCK NO-ERROR.

                        IF NOT AVAIL tt-mla-usuar-aprov THEN DO:

                            FOR FIRST b-mla-usuar-aprov FIELDS (cod-usuar nome-usuar e-mail recebe-email)
                                WHERE b-mla-usuar-aprov.cod-usuar = b-mla-doc-pend-aprov.cod-usuar NO-LOCK:

                                CREATE tt-mla-usuar-aprov.
                                ASSIGN tt-mla-usuar-aprov.cod-usuar    = b-mla-usuar-aprov.cod-usuar      
                                       tt-mla-usuar-aprov.nome-usuar   = b-mla-usuar-aprov.nome-usuar     
                                       tt-mla-usuar-aprov.e-mail       = b-mla-usuar-aprov.e-mail         
                                       tt-mla-usuar-aprov.recebe-email = b-mla-usuar-aprov.recebe-email. 
                            END. 
                        END.

                        ASSIGN c-usuar-nome-usuar = tt-mla-usuar-aprov.nome-usuar.
                        IF AVAIL tt-mla-usuar-aprov THEN DO:
                            assign p-desc-erro = "Documento previamente Rejeitado pelo usu†rio " 
                                               + b-mla-doc-pend-aprov.cod-usuar 
                                               + " (" 
                                               + c-usuar-nome-usuar
                                               + ")" 
                                               + " no dia " 
                                               + STRING(b-mla-doc-pend-aprov.dt-rejeita,"99/99/9999").
                            IF  tt-pendencia.tipo-trans <> 3 THEN /*Se n∆o for reaprovaá∆o*/
                                {method/svc/errors/inserr.i &ErrorNumber="34028"
                                                            &ErrorType="EMS":U
                                                            &ErrorSubType="ERROR":U
                                                            &ErrorParameters="b-mla-doc-pend-aprov.cod-usuar + ' (' + c-usuar-nome-usuar + ')' + '~~~~' + 
                                                                              STRING(b-mla-doc-pend-aprov.dt-rejeita,'99/99/9999') "}
                        END.
                    END.
                END.
            END CASE.
        END.
        ELSE DO:
            assign p-cod-erro = 999990.
            {method/svc/errors/inserr.i &ErrorNumber="28928"
                                        &ErrorType="EMS":U
                                        &ErrorSubType="ERROR":U
                                        &ErrorParameters="''"}

        END.
    END.
    IF  p-cod-erro <> 0 THEN
        RETURN "NOK".

    /**  Consiste N£mero da Transaá∆o
    **/

    IF  AVAILABLE mla-doc-pend-aprov AND
        tt-pendencia.nr-trans <> 0 AND
        tt-pendencia.nr-trans <> mla-doc-pend-aprov.nr-trans THEN DO:
        ASSIGN p-cod-erro = 30964.
        {method/svc/errors/inserr.i &ErrorNumber="30964"
                                    &ErrorType="EMS":U
                                    &ErrorSubType="ERROR":U
                                    &ErrorParameters="''"}

    END.
    IF  p-cod-erro <> 0 THEN
        RETURN "NOK".

    /**  Verifica limite 
    **/
    if  avail mla-doc-pend-aprov and
        not (mla-doc-pend-aprov.ind-tip-aprov = 3 OR mla-doc-pend-aprov.ind-tip-aprov = 4) and /* aprovacao tecnica e padrao nao verifica limite */
            (tt-pendencia.tipo-trans    = 1 OR tt-pendencia.tipo-trans    = 3) then do:

        IF tt-pendencia.cod-tip-doc = 7 /* Pedido de Compra Total*/
        OR tt-pendencia.cod-tip-doc = 8 /* Pedido Emergencial Total*/ THEN DO:
            FOR FIRST pedido-compr FIELDS (num-pedido char-1)
                 WHERE pedido-compr.num-pedido = INT(mla-doc-pend-aprov.chave-doc) NO-LOCK:
                IF TRIM(SUBSTRING(pedido-compr.char-1,58,1)) = "N":U THEN DO: /*processo ainda n∆o foi finalizado*/
                    RUN pi-formata-chave IN THIS-PROCEDURE(INPUT tt-pendencia.cod-tip-doc,
                                                           INPUT tt-pendencia.chave-doc,
                                                           OUTPUT c-chave-mla-formatada).
                    assign p-cod-erro = 53929.
                           c-chave-mla = " (" + c-chave-mla-aux + ": " + c-chave-mla-formatada + ")". 
                    {utp/ut-liter.i "Pedido_de_Compra" * }
                    {method/svc/errors/inserr.i &ErrorNumber="53929"
                                                &ErrorType="EMS":U
                                                &ErrorSubType="ERROR":U
                                                &ErrorParameters="trim(return-value) + c-chave-mla"}
                                        
                END.
            END.
        END.

        IF tt-pendencia.cod-tip-doc = 2 /* Solicitaá∆o Compra Total */
        OR tt-pendencia.cod-tip-doc = 4 /* Requisiá∆o Estoque Total */ THEN DO:
            FOR FIRST requisicao FIELDS (nr-requisicao char-1)
                 WHERE requisicao.nr-requisicao = INT(mla-doc-pend-aprov.chave-doc) NO-LOCK:
                IF TRIM(SUBSTRING(requisicao.char-1,1,1)) = "N":U THEN DO: /*processo ainda n∆o foi finalizado*/
                    RUN pi-formata-chave IN THIS-PROCEDURE(INPUT tt-pendencia.cod-tip-doc,
                                                           INPUT tt-pendencia.chave-doc,
                                                           OUTPUT c-chave-mla-formatada).
                    assign p-cod-erro = 53929
                           c-chave-mla = " (" + c-chave-mla-aux + ": " + c-chave-mla-formatada + ")". 
                    {utp/ut-liter.i "Solicitaá∆o_de_Compra/Requisiá∆o_de_Estoque" * }
                    {method/svc/errors/inserr.i &ErrorNumber="53929"
                                                &ErrorType="EMS":U
                                                &ErrorSubType="ERROR":U
                                                &ErrorParameters="trim(return-value) + c-chave-mla"}
                                        
                END.
            END.
        END.

        ASSIGN de-limite-aprovacao  = 0
               da-perm-validade-ini = &IF "{&ems_dbtype}":U = "MSS":U &THEN 01/01/1800 &ELSE 01/01/0001 &ENDIF 
               da-perm-validade-fim = &IF "{&ems_dbtype}":U = "MSS":U &THEN 01/01/1800 &ELSE 01/01/0001 &ENDIF .
        IF  l-limite-aprov THEN DO:

            FIND FIRST tt-mla-perm-aprov NO-LOCK
                 WHERE tt-mla-perm-aprov.ep-codigo   = tt-pendencia.ep-codigo 
                   AND tt-mla-perm-aprov.cod-estabel = tt-pendencia.cod-estabel 
                   AND tt-mla-perm-aprov.cod-usuar   = c-usuar-limite       
                   AND tt-mla-perm-aprov.cod-tip-doc = tt-pendencia.cod-tip-doc  NO-ERROR.

            IF NOT AVAIL tt-mla-perm-aprov THEN DO:
                FOR FIRST mla-perm-aprov FIELDS (ep-codigo cod-estabel cod-usuar cod-tip-doc
                                                 limite-aprov validade-ini validade-fim)
                     WHERE mla-perm-aprov.ep-codigo   = tt-pendencia.ep-codigo 
                       AND mla-perm-aprov.cod-estabel = tt-pendencia.cod-estabel 
                       AND mla-perm-aprov.cod-usuar   = c-usuar-limite       
                       AND mla-perm-aprov.cod-tip-doc = tt-pendencia.cod-tip-doc  NO-LOCK:
    
                    CREATE tt-mla-perm-aprov.
                    ASSIGN tt-mla-perm-aprov.ep-codigo    = mla-perm-aprov.ep-codigo     
                           tt-mla-perm-aprov.cod-estabel  = mla-perm-aprov.cod-estabel   
                           tt-mla-perm-aprov.cod-usuar    = mla-perm-aprov.cod-usuar     
                           tt-mla-perm-aprov.cod-tip-doc  = mla-perm-aprov.cod-tip-doc   
                           tt-mla-perm-aprov.limite-aprov = mla-perm-aprov.limite-aprov  
                           tt-mla-perm-aprov.validade-ini = mla-perm-aprov.validade-ini  
                           tt-mla-perm-aprov.validade-fim = mla-perm-aprov.validade-fim.  
                END.
            END.


            if avail tt-mla-perm-aprov then do: 
                ASSIGN de-perm-limite-aprov = tt-mla-perm-aprov.limite-aprov
                       da-perm-validade-fim = tt-mla-perm-aprov.validade-fim
                       da-perm-validade-ini = tt-mla-perm-aprov.validade-ini
                       de-limite-aprovacao  = de-perm-limite-aprov.
            end.

            FIND FIRST tt-item WHERE tt-item.it-codigo = mla-doc-pend-aprov.it-codigo NO-LOCK NO-ERROR.

            IF NOT AVAIL tt-item THEN DO:
                FOR FIRST ITEM FIELD(it-codigo desc-item fm-codigo) where
                    item.it-codigo = mla-doc-pend-aprov.it-codigo NO-LOCK:

                    CREATE tt-item.
                    ASSIGN tt-item.it-codigo = ITEM.it-codigo
                           tt-item.desc-item = ITEM.desc-item
                           tt-item.fm-codigo = ITEM.fm-codigo.
                END.
            END.

            FIND FIRST tt-mla-lim-aprov-fam WHERE 
                       tt-mla-lim-aprov-fam.ep-codigo   = tt-pendencia.ep-codigo   AND 
                       tt-mla-lim-aprov-fam.fm-codigo   = tt-item.fm-codigo        AND 
                       tt-mla-lim-aprov-fam.cod-tip-doc = tt-pendencia.cod-tip-doc AND
                       tt-mla-lim-aprov-fam.cod-usuar   = c-usuar-limite NO-LOCK NO-ERROR.

            IF NOT AVAIL tt-mla-lim-aprov-fam THEN DO:
                FOR FIRST mla-lim-aprov-fam FIELDS (ep-codigo fm-codigo cod-tip-doc 
                                                    cod-usuar limite-aprov) where
                    mla-lim-aprov-fam.ep-codigo   = tt-pendencia.ep-codigo   AND 
                    mla-lim-aprov-fam.fm-codigo   = tt-item.fm-codigo        AND 
                    mla-lim-aprov-fam.cod-tip-doc = tt-pendencia.cod-tip-doc AND
                    mla-lim-aprov-fam.cod-usuar   = c-usuar-limite NO-LOCK:
                    CREATE tt-mla-lim-aprov-fam.
                    ASSIGN tt-mla-lim-aprov-fam.ep-codigo     = mla-lim-aprov-fam.ep-codigo  
                           tt-mla-lim-aprov-fam.fm-codigo     = mla-lim-aprov-fam.fm-codigo  
                           tt-mla-lim-aprov-fam.cod-tip-doc   = mla-lim-aprov-fam.cod-tip-doc
                           tt-mla-lim-aprov-fam.cod-usuar     = mla-lim-aprov-fam.cod-usuar  
                           tt-mla-lim-aprov-fam.limite-aprov  = mla-lim-aprov-fam.limite-aprov.
                END.
            END.

            IF AVAIL tt-mla-lim-aprov-fam THEN
                ASSIGN de-limite-aprovacao = tt-mla-lim-aprov-fam.limite-aprov.
        END.

        /**  EPC para tratar limite de aprovaá∆o do alternativo
        **/

        IF AVAIL mla-doc-pend-aprov THEN
            run lap/mlaapi060.p (input  rowid(mla-doc-pend-aprov),
                                  input  de-limite-aprovacao,
                                  output de-limite-aprovacao).

        /**  Fim EPC  **/
        /*Chamado TPOLOI - Rodrigo*/
        /*find first mla-usuar-aprov
		    where mla-usuar-aprov.cod-usuar = c-usuar-limite no-lock no-error.
		if  avail mla-usuar-aprov AND 
            mla-usuar-aprov.mo-codigo <> mla-doc-pend-aprov.mo-codigo THEN DO:        
		
			RUN cdp/cd0812.p   (INPUT  mla-doc-pend-aprov.mo-codigo,  	 /*Moeda Origem*/
								INPUT  mla-usuar-aprov.mo-codigo,    	 /* Moeda Destino*/
								INPUT  de-limite-aprovacao, 			 /* Valor Origem a converter */
								INPUT  TODAY,                            /* Datas da Convers„o*/
								OUTPUT de-limite-aprovacao).			 /* Valor retorno convertido */

			if de-limite-aprovacao = ? then
				assign de-limite-aprovacao = 0.
		end.*/

        
        IF  (da-perm-validade-ini > today  or 
             da-perm-validade-fim < today) and
             not l-mestre THEN DO: 
            RUN pi-formata-chave IN THIS-PROCEDURE(INPUT mla-doc-pend-aprov.cod-tip-doc,
                                                   INPUT mla-doc-pend-aprov.chave-doc,
                                                   OUTPUT c-chave-mla-formatada).
            assign p-cod-erro = 54407
                   c-chave-mla = " (" + c-chave-mla-aux + ": " + c-chave-mla-formatada + ")".
            {method/svc/errors/inserr.i &ErrorNumber="54407"
                                        &ErrorType="EMS":U
                                        &ErrorSubType="ERROR":U
                                        &ErrorParameters="c-chave-mla"}

        END.
 
        if  AVAILABLE mla-doc-pend-aprov and de-limite-aprovacao < mla-doc-pend-aprov.valor-doc and not l-mestre THEN DO:

            run lap/mla0301b.p (input  gr-mla-rowid-pend,
                                 output l-semlimite-prox). 
            RUN pi-formata-chave IN THIS-PROCEDURE(INPUT mla-doc-pend-aprov.cod-tip-doc,
                                                       INPUT mla-doc-pend-aprov.chave-doc,
                                                       OUTPUT c-chave-mla-formatada).
            if  l-semlimite-prox then DO:
                ASSIGN p-cod-erro = 54407
                       c-chave-mla = " (" + c-chave-mla-aux + ": " + c-chave-mla-formatada + ")".
                {method/svc/errors/inserr.i &ErrorNumber="54407"
                                            &ErrorType="EMS":U
                                            &ErrorSubType="ERROR":U
                                            &ErrorParameters="c-chave-mla"}

            END.
            else //aprovador nao tem limite de aprovacao, porem o proximo da faixa tem limite
                IF mla-doc-pend-aprov.ind-situacao <> 2 AND mla-doc-pend-aprov.ind-situacao <> 4 then do: //documento nao pode estar aprovado ou reaprovado
                    run utp/ut-msgs.p (input "show",input 15540,input " ").
                    if return-value = "no" then
                        ASSIGN p-cod-erro = 15540
                               c-chave-mla = " (" + c-chave-mla-aux + ": " + c-chave-mla-formatada + ")".
                end.
        END.
    END.

    LOG-MANAGER:WRITE-MESSAGE (">>> Limite: " + STRING(TRIM(STRING(de-limite-aprovacao,">,>>>,>>>,>>>,>>9.99")))) NO-ERROR.

    /**  Verifica lotaá∆o 
    **/
    FIND LAST b-mla-doc-pend-aprov  
        WHERE b-mla-doc-pend-aprov.ep-codigo    = tt-pendencia.ep-codigo
        AND   b-mla-doc-pend-aprov.cod-estabel  = tt-pendencia.cod-estabel
        AND   b-mla-doc-pend-aprov.cod-tip-doc  = tt-pendencia.cod-tip-doc 
        AND   b-mla-doc-pend-aprov.chave-doc    = tt-pendencia.chave-doc
        AND   b-mla-doc-pend-aprov.historico    = NO        NO-LOCK NO-ERROR.

    FIND FIRST tt-mla-perm-lotacao NO-LOCK
         WHERE tt-mla-perm-lotacao.ep-codigo   = b-mla-doc-pend-aprov.ep-codigo
           AND tt-mla-perm-lotacao.cod-usuar   = c-usuar-perm-lotacao
           AND tt-mla-perm-lotacao.cod-lotacao = b-mla-doc-pend-aprov.cod-lotacao-doc NO-ERROR.

    RUN pi-gerar-dados-extrato (INPUT " boin767c.i2  chave: " + string(tt-pendencia.chave-doc)).
    RUN pi-gerar-dados-extrato (INPUT " boin767c.i2  user : " + string(c-usuar-perm-lotacao)).
    RUN pi-gerar-dados-extrato (INPUT " lotacao: " + String(b-mla-doc-pend-aprov.cod-lotacao-doc)).    
    
    IF NOT AVAIL tt-mla-perm-lotacao THEN DO:
        FOR FIRST mla-perm-lotacao FIELDS (ep-codigo cod-usuar cod-lotacao validade-ini validade-fim) 
             WHERE mla-perm-lotacao.ep-codigo   = b-mla-doc-pend-aprov.ep-codigo
               AND mla-perm-lotacao.cod-usuar   = c-usuar-perm-lotacao
               AND mla-perm-lotacao.cod-lotacao = b-mla-doc-pend-aprov.cod-lotacao-doc NO-LOCK:

            CREATE tt-mla-perm-lotacao.
            ASSIGN tt-mla-perm-lotacao.ep-codigo    = mla-perm-lotacao.ep-codigo      
                   tt-mla-perm-lotacao.cod-usuar    = mla-perm-lotacao.cod-usuar     
                   tt-mla-perm-lotacao.cod-lotacao  = mla-perm-lotacao.cod-lotacao   
                   tt-mla-perm-lotacao.validade-ini = mla-perm-lotacao.validade-ini  
                   tt-mla-perm-lotacao.validade-fim = mla-perm-lotacao.validade-fim. 
        END.
    END.

    IF AVAIL tt-mla-perm-lotacao THEN
        ASSIGN da-perm-lotacao-validade-fim = tt-mla-perm-lotacao.validade-fim
               da-perm-lotacao-validade-ini = tt-mla-perm-lotacao.validade-ini.
    
    if NOT AVAIL tt-mla-perm-lotacao
    or da-perm-lotacao-validade-ini > today 
    or da-perm-lotacao-validade-fim < today then do:
        if  NOT l-mestre then DO:
            RUN pi-formata-chave IN THIS-PROCEDURE(INPUT tt-pendencia.cod-tip-doc,
                                                   INPUT tt-pendencia.chave-doc,
                                                   OUTPUT c-chave-mla-formatada).
            assign p-cod-erro = 54408
                   c-chave-mla = " (" + c-chave-mla-aux + ": " + c-chave-mla-formatada + ")".   
                   
            RUN pi-gerar-dados-extrato (INPUT " 54408 - boin767c.i2 : " + c-chave-mla).
        
            {method/svc/errors/inserr.i &ErrorNumber="54408"
                                        &ErrorType="EMS":U
                                        &ErrorSubType="ERROR":U
                                        &ErrorParameters="c-chave-mla"}

        END.
    end.

    IF  p-cod-erro <> 0 THEN
        RETURN "NOK".

    IF AVAIL mla-doc-pend-aprov THEN
        LOG-MANAGER:WRITE-MESSAGE (">>> Lotacao: " + STRING(TRIM(mla-doc-pend-aprov.cod-lotacao-doc))) NO-ERROR.

    /**  Verifica verba 
    **/
    if  tt-pendencia.tipo-trans = 1 AND AVAIL mla-doc-pend-aprov then do:
        ASSIGN de-verba-valor-verba     = 0
               de-verba-verba-utilizada = 0
               de-saldo-verba           = 0.
        if  l-tipo-doc-verba-aprov then do:
            if  i-param-destino-verba = 1 then
                FOR FIRST mla-verba-aprov FIELDS (ep-codigo cod-estabel cod-usuar cod-tip-doc
                                                  periodo-ini periodo-fim valor-verba verba-utilizada)
                     WHERE mla-verba-aprov.ep-codigo    = mla-doc-pend-aprov.ep-codigo 
                       AND mla-verba-aprov.cod-estabel  = mla-doc-pend-aprov.cod-estabel
                       AND mla-verba-aprov.cod-usuar    = mla-doc-pend-aprov.cod-usuar 
                       AND mla-verba-aprov.cod-tip-doc  = mla-doc-pend-aprov.cod-tip-doc
                       AND mla-verba-aprov.periodo-ini <= TODAY
                       AND mla-verba-aprov.periodo-fim >= TODAY NO-LOCK: END.
            ELSE
                FOR FIRST mla-verba-aprov FIELDS (ep-codigo cod-estabel cod-usuar cod-tip-doc
                                                  periodo-ini periodo-fim valor-verba verba-utilizada)
                     WHERE mla-verba-aprov.ep-codigo    = mla-doc-pend-aprov.ep-codigo 
                       AND mla-verba-aprov.cod-estabel  = mla-doc-pend-aprov.cod-estabel
                       AND mla-verba-aprov.cod-usuar    = gc-mla-cod-usuar
                       AND mla-verba-aprov.cod-tip-doc  = mla-doc-pend-aprov.cod-tip-doc
                       AND mla-verba-aprov.periodo-ini <= TODAY
                       AND mla-verba-aprov.periodo-fim >= TODAY NO-LOCK: END.
            if AVAIL mla-verba-aprov THEN
                ASSIGN de-verba-valor-verba     = mla-verba-aprov.valor-verba
                       de-verba-verba-utilizada = mla-verba-aprov.verba-utilizada
                       de-saldo-verba           = de-verba-valor-verba - de-verba-verba-utilizada.
        END.
    END.

    LOG-MANAGER:WRITE-MESSAGE (">>> Verba: " + STRING(de-saldo-verba,">,>>>,>>>,>>>,>>9.99")) NO-ERROR.

    /**  Aprova/rejeita pendància 
    **/
    assign l-aprova-auto = no.

    /**  Verifica aprovaá∆o lista 
    **/
    /*if  AVAIL mla-doc-pend-aprov AND
        tt-pendencia.tipo-trans <> 2 and 
        mla-doc-pend-aprov.ind-tip-aprov = 2 then do:
        find first b-mla-doc-pend-aprov no-lock 
             where b-mla-doc-pend-aprov.ep-codigo        = mla-doc-pend-aprov.ep-codigo 
             and   b-mla-doc-pend-aprov.cod-estabel      = mla-doc-pend-aprov.cod-estabel 
             and   b-mla-doc-pend-aprov.cod-tip-doc      = mla-doc-pend-aprov.cod-tip-doc   
             and   b-mla-doc-pend-aprov.ind-tip-aprov    = mla-doc-pend-aprov.ind-tip-aprov 
             and   b-mla-doc-pend-aprov.chave-doc        = mla-doc-pend-aprov.chave-doc     
             and  (b-mla-doc-pend-aprov.ind-situacao     = 2 or b-mla-doc-pend-aprov.ind-situacao     = 4)                               
             and  (b-mla-doc-pend-aprov.cod-usuar        = gc-mla-cod-usuar or b-mla-doc-pend-aprov.cod-usuar-altern = gc-mla-cod-usuar)
             and   b-mla-doc-pend-aprov.historico        = NO no-error.
        if  available b-mla-doc-pend-aprov then do:
            if l-aprova-auto then next.
            else do:
                if  gi-mla-origem = 2 THEN DO:
                    assign p-cod-erro = 26634.
                    {method/svc/errors/inserr.i &ErrorNumber="26634"
                                                &ErrorType="EMS":U
                                                &ErrorSubType="ERROR":U
                                                &ErrorParameters="''"}

                END.
            END.
        END.
    END.
    IF  p-cod-erro <> 0 THEN
        RETURN "NOK".*/

    /**  Verifica rejeiá∆o 
    **/
    if  tt-pendencia.tipo-trans = 2 then do:

        FIND FIRST tt-mla-rej-aprov WHERE tt-mla-rej-aprov.cod-rejeicao = gi-mla-cod-rejeicao NO-LOCK NO-ERROR.

        IF NOT AVAIL tt-mla-rej-aprov THEN DO:
            FOR FIRST mla-rej-aprov FIELDS (cod-rejeicao des-rejeicao obriga-narrativa log-1)
                 WHERE mla-rej-aprov.cod-rejeicao = gi-mla-cod-rejeicao NO-LOCK:
                CREATE tt-mla-rej-aprov.
                ASSIGN tt-mla-rej-aprov.cod-rejeicao     = mla-rej-aprov.cod-rejeicao       
                       tt-mla-rej-aprov.des-rejeicao     = mla-rej-aprov.des-rejeicao       
                       tt-mla-rej-aprov.obriga-narrativa = mla-rej-aprov.obriga-narrativa
                       tt-mla-rej-aprov.log-1            = mla-rej-aprov.log-1.  
            END.
        END.

        IF NOT AVAIL tt-mla-rej-aprov THEN DO:
            if l-aprova-auto then next.
            else do:
                if  gi-mla-origem = 2 THEN DO:
                    assign p-cod-erro = 999991.
                    {method/svc/errors/inserr.i &ErrorNumber="2609"
                                                &ErrorType="EMS":U
                                                &ErrorSubType="ERROR":U
                                                &ErrorParameters="''"}

                END.
            END.
        END.
        ELSE DO:
            if  tt-mla-rej-aprov.obriga-narrativa and
                gc-mla-narrativa = "" then do:
                if  l-aprova-auto then next.
                else do:
                    if  gi-mla-origem = 1 OR gi-mla-origem = 2 THEN DO:
                        assign p-cod-erro = 999992.
                        {method/svc/errors/inserr.i &ErrorNumber="15547"
                                                    &ErrorType="EMS":U
                                                    &ErrorSubType="ERROR":U
                                                    &ErrorParameters="''"}

                    END.
                END.
            END.
        END.
    END.
    IF  p-cod-erro <> 0 THEN
        RETURN "NOK".

    /**  Verifica verba do aprovador  
    **/
    IF AVAIL mla-doc-pend-aprov THEN DO:

        FIND FIRST mla-tipo-aprov NO-LOCK
             WHERE mla-tipo-aprov.cod-tip-aprov = mla-doc-pend-aprov.cod-tip-aprov NO-ERROR.
        ASSIGN i-tipo-ind-tip-aprov = mla-doc-pend-aprov.ind-tip-aprov.
        
        /* Ponto UPC */
        if  c-nom-prog-dpc-mg97  <> "":U
        or  c-nom-prog-appc-mg97 <> "":U
        or  c-nom-prog-upc-mg97  <> "":U then do:

            EMPTY TEMP-TABLE tt-epc.

            CREATE tt-epc.
            ASSIGN tt-epc.cod-event     = "verificaVerbaAprovador"
                   tt-epc.cod-parameter = "rowDocPendAprov-handleBO"
                   tt-epc.val-parameter = STRING(ROWID(mla-doc-pend-aprov)) + "/" + string(this-procedure).

            {include/i-epc201.i "verificaVerbaAprovador"}

            IF  RETURN-VALUE = "OK" THEN 
                RETURN "OK":U.
            ELSE DO:
                RUN pi-formata-chave IN THIS-PROCEDURE(INPUT mla-doc-pend-aprov.cod-tip-doc,
                                                       INPUT mla-doc-pend-aprov.chave-doc,
                                                       OUTPUT c-chave-mla-formatada).
                assign p-cod-erro = 54406
                       c-chave-mla = " (" + c-chave-mla-aux + ": " + c-chave-mla-formatada + ")".
                {method/svc/errors/inserr.i &ErrorNumber="54406"
                                            &ErrorType="EMS":U
                                            &ErrorSubType="ERROR":U
                                            &ErrorParameters="c-chave-mla"}
                RETURN "NOK":U.
            END.
        END.
        
        /**  FIM Chamada EPC  **/
		
    		assign de-val-doc-convert = de-saldo-verba.
    		
    		/*Chamado TPOLOI - Rodrigo*/
    		/*find first mla-usuar-aprov		
    			  where mla-usuar-aprov.cod-usuar = mla-doc-pend-aprov.cod-usuar no-lock no-error.
    		if  avail mla-usuar-aprov AND 
                mla-usuar-aprov.mo-codigo <> mla-doc-pend-aprov.mo-codigo then DO:
                		  
    			RUN cdp/cd0812.p (INPUT  mla-doc-pend-aprov.mo-codigo,  /*Moeda Origem - Documento*/
    							  INPUT  mla-usuar-aprov.mo-codigo,		/* Moeda Destino - Aprovador*/
    							  INPUT  de-saldo-verba,				/* Valor Origem a converter */
    							  INPUT  TODAY,              			/* Datas da Convers„o*/
    							  OUTPUT de-val-doc-convert).     		/* Valor retorno convertido */
    							  
    			if de-val-doc-convert = ? then
    				assign de-val-doc-convert = 0.
            END.*/
		
        if  RETURN-VALUE = "OK" and
            i-tipo-ind-tip-aprov <> 4 and
            tt-pendencia.tipo-trans <> 2 and 
            de-val-doc-convert < mla-doc-pend-aprov.valor-doc and 
            l-tipo-doc-verba-aprov then do:
            if  l-aprova-auto then next.
            else do:
                if  gi-mla-origem = 2 THEN DO:
                    RUN pi-formata-chave IN THIS-PROCEDURE(INPUT mla-doc-pend-aprov.cod-tip-doc,
                                                           INPUT mla-doc-pend-aprov.chave-doc,
                                                           OUTPUT c-chave-mla-formatada).
                    assign p-cod-erro = 54406
                           c-chave-mla = " (" + c-chave-mla-aux + ": " + c-chave-mla-formatada + ")".
                    {method/svc/errors/inserr.i &ErrorNumber="54406"
                                                &ErrorType="EMS":U
                                                &ErrorSubType="ERROR":U
                                                &ErrorParameters="c-chave-mla"}

                END.
            end.
        END.
        IF  p-cod-erro <> 0 THEN
            RETURN "NOK".
    END.

    RETURN "OK".
