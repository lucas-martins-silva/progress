PROCEDURE setDefaultCalculoImpostos :
/*------------------------------------------------------------------------------
  Purpose:
  Parameters:  <none>
  Notes:
------------------------------------------------------------------------------*/


    def input param pi-seta-default-tributacao as logical no-undo.
    def input param pi-seta-default-aliquota   as logical no-undo.


    assign l-default-tributacao = pi-seta-default-tributacao
           l-default-aliquota   = pi-seta-default-aliquota.


END PROCEDURE.




PROCEDURE setDefaultsEstoque :
/*------------------------------------------------------------------------------
  Purpose:
  Parameters:  <none>
  Notes:
------------------------------------------------------------------------------*/


    run findItem ( RowObject.it-codigo ).


    if  return-value <> "OK":U
    or  not avail docum-est then
        return "NOK":U.

    if  l-material-agregado then
        assign RowObject.baixa-ce = no.


    if  RowObject.numero-ordem <> 0
    and not RowObject.log-1 then do:
        run findOrdemCompra ( RowObject.numero-ordem,
                              ? ).
        run findPrazoCompra ( RowObject.numero-ordem,
                              RowObject.parcela ).
    end.

    FIND FIRST rat-ordem NO-LOCK
         WHERE rat-ordem.cod-emitente = RowObject.cod-emitente
         AND   rat-ordem.serie-docto  = RowObject.serie-docto
         AND   rat-ordem.nro-docto    = RowObject.nro-docto
         AND   rat-ordem.nat-operacao = RowObject.nat-operacao
         AND   rat-ordem.sequencia    = RowObject.sequencia NO-ERROR.

    for first item-uni-estab
        fields ( it-codigo     lim-var-valor
                 cod-estabel   var-val-re-maior
                 var-qtd-re    lim-var-qtd
                 deposito-pad  cod-localiz
                 loc-unica     cod-obsoleto
                 contr-qualid)
        where item-uni-estab.it-codigo   = RowObject.it-codigo
          and item-uni-estab.cod-estabel = docum-est.cod-estabel no-lock: end.

    if  RowObject.cod-depos = "" then
        assign l-deposito = no.
    else assign l-deposito = yes.

    if not l-nf-transf-devol-ret then do:
        if not l-deposito then do:
           if avail ordem-compra
           and rowObject.numero-ordem <> 0 then
              assign RowObject.cod-depos = ordem-compra.dep-almoxar.
           else if avail rat-ordem then do: /*Localiza c¢digo deposito quando Ç por FIFO*/
              FIND FIRST ordem-compra NO-LOCK
                   WHERE ordem-compra.num-pedido   = rat-ordem.num-pedido
                   AND   ordem-compra.numero-ordem = rat-ordem.numero-ordem NO-ERROR.
              IF AVAIL ordem-compra THEN
                 ASSIGN RowObject.cod-depos = ordem-compra.dep-almoxar.
           end.
           else if avail item-uni-estab then
               assign RowObject.cod-depos = item-uni-estab.deposito-pad.
           else assign RowObject.cod-depos = item.deposito-pad.
        end.
        else assign RowObject.cod-depos = RowObject.cod-depos.

        assign RowObject.cod-localiz = if  RowObject.cod-localiz = ""
                                       AND NOT l-deposito
                                       then if  avail item-uni-estab
                                            then item-uni-estab.cod-localiz
                                            else item.cod-localiz
                                       else RowObject.cod-localiz
               RowObject.cod-refer   = if  RowObject.cod-refer = ""
                                       and avail prazo-compra
                                          then prazo-compra.cod-refer
                                          else RowObject.cod-refer.
    end.

    /* Item com Controle por Lote ou Referància */
    if  ( item.tipo-con-est = 3 or item.tipo-con-est = 4 )
    and RowObject.lote <> " " then do:


        find last saldo-estoq use-index item-lote
            where saldo-estoq.it-codigo   = RowObject.it-codigo
              and saldo-estoq.cod-estabel = docum-est.cod-estabel
              and saldo-estoq.lote        = RowObject.lote
              and saldo-estoq.cod-refer   = RowObject.cod-refer
           no-lock no-error.
        if  avail saldo-estoq then
            assign RowObject.dt-vali-lote  = saldo-estoq.dt-vali-lote.
    end.


    if  item.tipo-con-est <> 2
    and item.tipo-con-est <> 3
    and item.tipo-con-est <> 4 then
        assign RowObject.lote = "".


    if  item.tipo-con-est <> 3
    and item.tipo-con-est <> 4 then
        assign RowObject.dt-vali-lote = ?.


    if  item.tipo-con-est <> 4 then
        assign Rowobject.cod-refer = "".


    if  item-uni-estab.loc-unica then
        assign RowObject.cod-localiz = item-uni-estab.cod-localiz.

    if  l-NT2024002
    and natur-oper.tipo-compra = 9 /*Nota Debito/Credito */ then
        assign RowObject.baixa-ce = no.


    return "OK":U.


END PROCEDURE.




PROCEDURE setDefaultsEtiquetas :
/*------------------------------------------------------------------------------
  Purpose:
  Parameters:  <none>
  Notes:
------------------------------------------------------------------------------*/

    def output param piQtEtiquetas like item-doc-est.qt-etiquetas init 0 no-undo.
    def output param piHabilita    as   logical                          no-undo.


    if  avail param-global
    and param-global.modulo-cl then do:

        for each tt-etq-item:
            delete tt-etq-item.
        end.

        for each tt-prog-bc:
            delete tt-prog-bc.
        end.

        create  tt-prog-bc.
        assign  tt-prog-bc.cod-prog-dtsul           = "re1001"
                tt-prog-bc.cod-versao-integracao    = 1
                tt-prog-bc.usuario                  = c-seg-usuario
                tt-prog-bc.opcao                    = 1.

        run bcp/bcapi004.p (input-output table tt-prog-bc,
                            input-output table tt-erro).

        if  return-value = "OK" then do:

            find first tt-prog-bc exclusive-lock no-error.

            create  tt-etq-item.
            assign  tt-etq-item.it-codigo               = RowObject.it-codigo
                    tt-etq-item.cod-versao-integracao   = 1
                    tt-etq-item.qt-item                 = dec(RowObject.quantidade)
                    tt-etq-item.cd-trans                = if  avail tt-prog-bc
                                                          then tt-prog-bc.cd-trans
                                                          else "".

            run bcp/bcapi011.p (input-output table tt-etq-item).

            find first tt-etq-item exclusive-lock no-error.



            assign piQtEtiquetas = if  return-value = "OK"
                                  and avail tt-etq-item
                                  then tt-etq-item.qt-etiqueta
                                  else 0
                   piHabilita   = if  return-value = "OK"
                                  then yes
                                  else no.
        end.
    end.




END PROCEDURE.




PROCEDURE setDefaultsFields :
/*------------------------------------------------------------------------------
  Purpose:
  Parameters:  <none>
  Notes:  Determina o default dos campos do item da nota.
------------------------------------------------------------------------------*/

    def var l-habilita-etiqueta as logical                     no-undo.
    def var de-qt-etiquetas     like item-doc-est.qt-etiquetas no-undo.
    def var c-cfop-nota-saida   as character format "x(5)"     no-undo.
    def var de-pre-unit-for     as decimal                     no-undo.
    def var l-erro-co           as logical                     no-undo.

    if  not avail RowObject
    or  not avail docum-est then
        RETURN "NOK":U.

    assign de-quant-forn = RowObject.qt-do-forn.

    if  not RowObject.log-1 then do: /* Nao eh Fifo */
        if  RowObject.numero-ordem <> 0
        or  RowObject.num-pedido   <> 0 then
            run setDefaultsOrdemCompra.
    end.
    else
        if  RowObject.num-pedido <> 0 then do:
            if  RowObject.it-codigo = "" then
                for first b-ordem-compra
                    fields ( numero-ordem     num-pedido      it-codigo
                             situacao         nr-contrato      conta-contabil
                             num-ord-inv      ordem-servic    num-seq-item
                             data-cotacao     pre-unit-for    mo-codigo
                             codigo-ipi       taxa-financ     perc-descto
                             aliquota-ipi     cod-cond-pag    valor-taxa
                             nr-dias-taxa     int-1           cod-emitente
                             natureza         narrativa       dep-almoxar )
                    where b-ordem-compra.num-pedido = RowObject.num-pedido no-lock:
                end.
            else
                for first b-ordem-compra
                    fields ( numero-ordem     num-pedido      it-codigo
                             situacao         nr-contrato      conta-contabil
                             num-ord-inv      ordem-servic    num-seq-item
                             data-cotacao     pre-unit-for    mo-codigo
                             codigo-ipi       taxa-financ     perc-descto
                             aliquota-ipi     cod-cond-pag    valor-taxa
                             nr-dias-taxa     int-1           cod-emitente
                             natureza         narrativa       dep-almoxar )
                    where b-ordem-compra.num-pedido = RowObject.num-pedido
                      and b-ordem-compra.it-codigo  = RowObject.it-codigo no-lock:
                end.
            if  avail b-ordem-compra then
                assign RowObject.it-codigo = b-ordem-compra.it-codigo.
        end.

    if  RowObject.it-codigo <> " " then do:
        run getItemFornec.
        run setDefaultsItem.
        assign c-it-do-forn = "".
    end.
    else
        if  c-it-do-forn <> " " then do:
            run getItem ( input c-it-do-forn ).
            run setDefaultsItem.
        end.
        else do:
            run getItemFornec.
            run setDefaultsItem.
        end.


    if  RowObject.numero-ordem <> 0 then do:


        if  RowObject.qt-do-forn = 0
        and RowObject.quantidade = 0 then do:
            run setDefaultsQuantidade.
        end.
        else do:
            run setDefaultsQtdScreen.
        end.


        if  RowObject.preco-total[1] = 0 AND RowObject.preco-unit[1] = 0 then do:
            run setDefaultsPrecoTotal.
        end.
        else do:
            if  RowObject.preco-total[1] <> 0 and ( RowObject.preco-unit[1] = 0 or RowObject.preco-unit[1] = ? ) then
                assign RowObject.preco-unit[1] = RowObject.preco-total[1]
                                                 / (RowObject.qt-do-forn + int(RowObject.qt-do-forn = 0)).
            else do:
                if RowObject.preco-unit[1] <> 0 and RowObject.preco-total[1] = 0 then do:

                   assign i-total = 0.

                   run cnp/cn9174.p ( RowObject.numero-ordem,
                                      5,
                                      RowObject.int-1,
                                      0,
                                      docum-est.dt-emissao,
                                      output de-pre-unit-for,
                                      output l-erro-co,
                                      output l-contrato,
                                      output i-total,
                                      input-output table tt-erro).

                   if i-total = 1          // Indica que a ordem Ç referente a um contrato com item controlado por limite de custo
                   or i-total = 2 then do: // Indica que a ordem Ç referente a um contrato controlado por "total nota"
                       run setDefaultsPrecoTotal.

                       if return-value = "NOK":U then.
                       else do:
                          {utp/ut-liter.i a_informaá∆o_de_preáo_unit†rio_do_contrato}

                          {method/svc/errors/inserr.i &ErrorNumber="33383"
                                                      &ErrorType="EMS":U
                                                      &ErrorSubType="INFORMATION":U
                                                      &ErrorParameters="return-value + '~~~~~' +
                                                                        string(ordem-compra.nr-contrato) + '~~~~~' +
                                                                        string(RowObject.it-codigo) + '~~~~~' +
                                                                        string(RowObject.numero-ordem)"}
                       end.
                   end.
                   else
                       assign RowObject.preco-total[1] = RowObject.preco-unit[1]
                                                       * (RowObject.qt-do-forn + int(RowObject.qt-do-forn = 0)).
                end.
                else do:

                    assign i-total = 0.

                    run cnp/cn9174.p ( RowObject.numero-ordem,
                                       5,
                                       RowObject.int-1,
                                       RowObject.preco-total[1],
                                       docum-est.dt-emissao,
                                       output de-pre-unit-for,
                                       output l-erro-co,
                                       output l-contrato,
                                       output i-total,
                                       input-output table tt-erro).

                    if i-total = 1 then // Ordem de contrato com item controlado por limite de custo
                       assign RowObject.preco-unit[1] = de-pre-unit-for.
                    else
                       if i-total = 2 then // Ordem de contrato "total nota"
                          assign RowObject.preco-unit[1] = RowObject.preco-total[1] / de-pre-unit-for.


                    if i-total = 1 or i-total = 2 then do:

                       {utp/ut-liter.i a_informaá∆o_de_preáo_unit†rio_do_contrato}

                       {method/svc/errors/inserr.i &ErrorNumber="33383"
                                                   &ErrorType="EMS":U
                                                   &ErrorSubType="INFORMATION":U
                                                   &ErrorParameters="return-value + '~~~~~' +
                                                                     string(ordem-compra.nr-contrato) + '~~~~~' +
                                                                     string(RowObject.it-codigo) + '~~~~~' +
                                                                     string(RowObject.numero-ordem)"}
                    end.

                end.
            end.
        end.
    end.
    else do:

        run setDefaultsQtdScreen.

        if  RowObject.preco-total[1] <> 0 and ( RowObject.preco-unit[1] = 0 or RowObject.preco-unit[1] = ? ) then
            assign RowObject.preco-unit[1] = RowObject.preco-total[1]
                                             / (RowObject.qt-do-forn + int(RowObject.qt-do-forn = 0)).
        else
            if  RowObject.preco-unit[1] <> 0 and RowObject.preco-total[1] = 0 then
                assign RowObject.preco-total[1] = RowObject.preco-unit[1]
                                                  * (RowObject.qt-do-forn + int(RowObject.qt-do-forn = 0)).
    end.


    if  RowObject.numero-ordem <> 0
    and RowObject.preco-total[1] <> 0 then do:
        run setDefaultsOrdCompServico.
    end.

    /* Devolucao de cliente sem nota de saida */
    if  l-pede-data-comp
    and RowObject.data-comp = ? then
        assign RowObject.data-comp = docum-est.dt-trans.

    run setDespesasItem.

    run setDefaultsEstoque.

    /* Unidade de Neg¢cio */
    /*l-mat-unid-negoc -> Param Materiais - Utiliza UN*/
    if l-mat-unid-negoc then
        run setDefaultsUnidadeNegocio.

    RUN setQtdeUnTributavelIS (INPUT RowObject.quantidade,
                               INPUT INT(SUBSTRING(RowObject.char-2,832,5)),
                               INPUT RowObject.nat-of).

    /***Sugest∆o cClassTrib/CST do CBS/IBS***/
    RUN sugereCClassTrib.

    run createTempTableImpostos.


    assign l-recalcula = no
           l-recalcula-pis-cofins = no.

    /***ICMS Desonerado***/
    if not l-servicos
    and i-pais-impto-usuario = 1 then do:
        run calculaDescontoICMS.
    end.
    /*********************/

    /* Impostos do Brasil */
    if  i-pais-impto-usuario = 1 then
        run assignValueImposto.


    run setDefaultsOperTriang. /* Operaá∆o Triangular */


    run setDefaultsEtiquetas ( output de-qt-etiquetas,   /* Calculo Quantidade Etiquetas */
                               output l-habilita-etiqueta ).
    assign RowObject.qt-etiquetas = de-qt-etiquetas.

    /*CFOP da nota de sa°da (a da venda)*/
    IF TRIM(RowObject.cod-cfop-saida) EQ "" THEN DO:
        RUN buscaCFOPSaida (OUTPUT c-cfop-nota-saida).
        ASSIGN RowObject.cod-cfop-saida = c-cfop-nota-saida.
    END.
    /************************************/

    return "OK":U.


END PROCEDURE.




PROCEDURE setDefaultsItem :
/*------------------------------------------------------------------------------
  Purpose:
  Parameters:  <none>
  Notes:
------------------------------------------------------------------------------*/

    def var de-aliquota        like item-doc-est.aliquota-ipi no-undo.
    def var c-un               like item-doc-est.un           no-undo.
    def var l-procedimento-ok  as logical                     no-undo.
    DEF VAR cUnXml             as character                   no-undo.
    DEF VAR iSeqXml            like item-doc-est.sequencia    no-undo.

    if  not avail docum-est then
        return "NOK":U.

    /***** Leitura do Item *****/
    run findItem ( RowObject.it-codigo ).

    if  return-value =  "NOK":U then
        return "NOK":U.

    /***** Leitura do Estabelecimento *****/
    run findEstabelec ( docum-est.cod-estabel ).

    if  return-value =  "NOK":U then
        return "NOK":U.

    /***** Leitura do Emitente *****/
    run findEmitente ( RowObject.cod-emitente ).

    if  return-value =  "NOK":U then
        return "NOK":U.

    /***** Leitura da Natureza de Operaá∆o *****/
    run findNaturOper ( RowObject.nat-operacao ).

    if  return-value =  "NOK":U then
        return "NOK":U.

    {cdp/cd9700.i1 natur-oper}
    if  natur-oper.tipo-compra = 3 // Devoluá∆o de cliente
    and not l-fatura-ent-futura
    and valid-handle(h-boin090)
    and (docum-est.origem = "I" or docum-est.origem = "XML") /*Se o documento teve origem no conversor*/
    and docum-est.log-consid-ender-nf-saida = yes
    and  not can-find (FIRST b-item-doc-est NO-LOCK
                       WHERE b-item-doc-est.cod-emitente   = RowObject.cod-emitente
                       AND   b-item-doc-est.serie-docto    = RowObject.serie-docto
                       AND   b-item-doc-est.nro-docto      = RowObject.nro-docto
                       AND   b-item-doc-est.nat-operacao   = RowObject.nat-operacao) then do:

         RUN consistEnderecoNF in h-boin090 (input RowObject.serie-comp,
                                             input RowObject.nro-comp).

    end.


    ASSIGN i-numero-ordem = 0.
    IF RowObject.log-1 THEN
        FOR FIRST rat-ordem FIELDS(numero-ordem)
            WHERE rat-ordem.cod-emitente = RowObject.cod-emitente
              AND rat-ordem.serie-docto  = RowObject.serie-docto
              AND rat-ordem.nro-docto    = RowObject.nro-docto
              AND rat-ordem.nat-operacao = RowObject.nat-operacao
              AND rat-ordem.sequencia    = RowObject.sequencia NO-LOCK:
            ASSIGN i-numero-ordem = rat-ordem.numero-ordem.
        END.
    ELSE
        ASSIGN i-numero-ordem = RowObject.numero-ordem.

    /***** Leitura da Ordem de Compra *****/
    if  i-numero-ordem <> 0 then
        run findOrdemCompra (INPUT i-numero-ordem,
                             input ? ).


    /***** Leitura da Ordem de Produá∆o *****/
    if  RowObject.nr-ord-produ <> 0 then
        run findOrdProd ( RowObject.nr-ord-produ ).

    /*ATUALIZA CONTA CONTABIL*/
    IF NOT ((docum-est.origem = "i" or docum-est.origem = "XML") AND
            SUBSTRING(RowObject.char-2,832,5) <> "") THEN
        if  l-pede-conta
        or  ( avail item and can-do("1,4", string(item.tipo-contr)) )
        or  not RowObject.baixa-ce
        or  (    natur-oper.terceiros
             and not can-do("4,6", string(natur-oper.tp-oper-terc)) ) then do:


            if  RowObject.nr-ord-produ = 0 then do:
                if  RowObject.ct-codigo = "" then
                    assign RowObject.ct-codigo = if avail ordem-compra
                                                 and i-numero-ordem <> 0 then
                                                     ordem-compra.ct-codigo
                                                 else
                                                     if avail item
                                                     and RowObject.ct-codigo = "" then
                                                         item.ct-codigo
                                                     else ""
                           RowObject.sc-codigo = if avail ordem-compra
                                                 and i-numero-ordem <> 0 then
                                                     ordem-compra.sc-codigo
                                                 else
                                                     if avail item then
                                                         item.sc-codigo
                                                     else "".
            end.
            else
                if  avail ord-prod then
                    assign RowObject.ct-codigo = ord-prod.ct-codigo
                           RowObject.sc-codigo = ord-prod.sc-codigo.
        end.
        else
            if  RowObject.nr-ord-produ = 0 then do:
                assign RowObject.ct-codigo = "".
            end.

    if  avail ordem-compra
    and ordem-compra.nr-contrato <> 0
    and param-global.modulo-cn then do:

        if  i-numero-ordem <> 0 then
            run cnp/cn9072.p (input i-numero-ordem,
                              input rowid(docum-est),
                              input 12,                    /* Conta-Atual   */
                              output l-conta-matriz,
                              input-output table tt-erro ).
        else
            assign l-conta-matriz = no.

        /* Qdo n∆o existir Matriz de Conta x Unidade de Neg¢cio, ser† considerado   */
        /* obrigat¢rio ter conta de aplicaá∆o e ser† assumida a Matriz Unid Neg¢cio */
        /* (unid-neg-ordem)  informada na ordem de compra, ou a da ordem            */
        /* (ordem-compra.cod-unid-negoc) caso n∆o exista matriz.                    */

        if  not l-conta-matriz and RowObject.ct-codigo = "" then do:
            assign RowObject.ct-codigo = if i-numero-ordem <> 0 then
                                             ordem-compra.ct-codigo
                                         else
                                             if avail item then
                                                 item.ct-codigo
                                             else ""
                   RowObject.sc-codigo = if i-numero-ordem <> 0 then
                                             ordem-compra.sc-codigo
                                         else
                                             if avail item then
                                                 item.sc-codigo
                                             else "".
        end.

        if  l-conta-matriz then do:
            run cnp/cn9072.p (input i-numero-ordem,
                              input rowid(docum-est),
                              input 11,                    /* Conta-Atual   */
                              output l-conta-matriz,
                              input-output table tt-erro ).

            if  can-find(first tt-erro
                         where tt-erro.cd-erro = 28663
                            or tt-erro.cd-erro = 28664
                            or tt-erro.cd-erro = 28665) then do:
                {utp/ut-liter.i Matriz_de_Rateio_da_Mediá∆o *}
            end.
            else do:
                if  can-find(first tt-erro
                             where tt-erro.cd-erro = 15221) then do:
                    if  can-find(first matriz-rat-item
                                    of item-contrat
                                 where item-contrat.num-seq-item = ordem-compra.num-seq-item
                                   and item-contrat.nr-contrato  = ordem-compra.nr-contrato) then do:
                        {utp/ut-liter.i Matriz_de_Rateio_Item_do_Contrato *}
                    end.
                    else
                        if  can-find(first matriz-rat-contr
                                     where matriz-rat-contr.nr-contrato = ordem-compra.nr-contrato) then do:
                            {utp/ut-liter.i Matriz_de_Rateio_do_Contrato *}
                        end.
                end.
                else do:
                    {utp/ut-liter.i Matriz_de_Unidade_de_Negocio_da_Ordem_de_Compra *}
                end.
            end.

            /*O numero da OI s¢ pode ser apagado se n∆o for contrato por ordem*/
            find first item-contrat no-lock
                 where item-contrat.nr-contrato = ordem-compra.nr-contrato
                   and item-contrat.num-seq-item = ordem-compra.num-seq-item no-error.
            if not avail item-contrat or
               (avail item-contrat and item-contrat.ind-tipo-control <> 2) then
               assign RowObject.num-ord-inv  = 0.

            ASSIGN RowObject.ct-codigo    = ""
                   RowObject.sc-codigo    = "".

            {method/svc/errors/inserr.i &ErrorNumber="33383"
                                        &ErrorType="EMS":U
                                        &ErrorSubType="INFORMATION":U
                                        &ErrorParameters="return-value + '~~~~~' +
                                                          string(ordem-compra.nr-contrato) + '~~~~~' +
                                                          string(RowObject.it-codigo) + '~~~~~' +
                                                          string(i-numero-ordem)"}
        end.
    end.

    /*ATUALIZA UNIDADE DE MEDIDA*/
    assign c-un = if avail item then item.un else "".
    IF  avail item-fornec and not l-devolucao and not l-retorno and not l-transf and not l-dev-transf THEN DO:
        ASSIGN c-un = item-fornec.unid-med-for.
    END.
    ELSE DO:
        if item.tipo-contr = 4 then /* Item Debito Direto */
           assign c-un = item.un.
        else do:
              IF  item.ind-inf-qtf = NO THEN
                  ASSIGN c-un = item.un.
              ELSE
                  IF  item.ind-inf-qtf = YES THEN DO: /* Unidade da Fam°lia */
                      for first familia fields(familia.un) no-lock
                          where familia.fm-codigo = item.fm-codigo: end.
                      IF  AVAIL familia THEN DO:
                          for first para-ped no-lock: end.
                          &IF '{&bf_dis_versao_ems}' >= '2.09' &THEN
                            IF NOT para-ped.log-usa-fator-item-clien THEN DO:
                          &ELSE
                            IF SUBSTRING(para-ped.char-2,4,3) = 'no' OR SUBSTRING(para-ped.char-2,4,3) = "" THEN DO:
                          &ENDIF
                              find first item-unid-venda where
                                         item-unid-venda.it-codigo = item.it-codigo and
                                         item-unid-venda.un        = familia.un no-lock no-error.
                              if avail item-unid-venda then
                                 assign c-un = familia.un.
                          end. /*IF NOT para-ped.log-usa-fator-item-clien*/
                          else do:
                              for first item-cli where
                                        item-cli.it-codigo       = item.it-codigo and
                                        item-cli.unid-med-cli              = familia.un            and
                                        item-cli.nome-abrev      = emitente.nome-abrev   and
                                        item-cli.log-unid-prefer = yes                   and
                                        item-cli.ind-sit-relac   = 1 no-lock: end.
                              if  not avail item-cli then
                                  for first item-cli where
                                            item-cli.it-codigo       = item.it-codigo and
                                            item-cli.unid-med-cli              = familia.un            and
                                            item-cli.nome-abrev      = emitente.nome-abrev   and
                                            item-cli.ind-sit-relac   = 1 no-lock: end.
                              if avail item-cli then
                                 assign c-un = familia.un.
                          end. /*else IF NOT para-ped.log-usa-fator-item-clien*/
                      END.
                  END. /*IF  item.ind-inf-qtf = YES*/
                  ELSE DO: /* Unidade do Faturamento */

                      /*Quando for uma transferencia, buscar o emitente relacionado ao estabelecimento para localizar o cadastrado do item-cli*/
                      if l-transf and avail estabelec then do:
                        /***** Leitura do Emitente *****/
                        run findEmitente ( estabelec.cod-emitente ).
                      end.

                      for first item-cli fields ( unid-med-cli ) where
                                item-cli.it-codigo       = item.it-codigo      and
                                item-cli.nome-abrev      = emitente.nome-abrev and
                                item-cli.log-unid-prefer = yes                 and
                                item-cli.ind-sit-relac   = 1 no-lock: end.
                      if  not avail item-cli then
                          for first item-cli fields ( unid-med-cli ) where
                                    item-cli.it-codigo     = item.it-codigo      and
                                    item-cli.nome-abrev    = emitente.nome-abrev and
                                    item-cli.ind-sit-relac = 1 no-lock: end.

                      if avail item-cli then
                          assign c-un = item-cli.unid-med-cli.

                      /*Busca novamente o emitente da docum-est*/
                      if l-transf then run findEmitente ( RowObject.cod-emitente ).

                  END. /*ELSE DO: /* Unidade do Faturamento */*/
        END.
    END.
    if  avail item
    and (item.tipo-contr = 4  or l-integra-ems-his)
    and AVAIL ordem-compra then
        FOR first cotacao-item FIELDS(un char-1)
            where cotacao-item.cod-emitente = ordem-compra.cod-emitente
              and cotacao-item.numero-ordem = ordem-compra.numero-ordem
              and cotacao-item.data-cotacao = ordem-compra.data-cotacao
              and cotacao-item.cot-aprovada = yes no-lock:
            assign c-un = cotacao-item.un.
        END.

    if  RowObject.un = " " then
        assign RowObject.un = c-un.

    /* CLASSIFICAÄ«O FISCAL E IMPOSTOS */
    if  avail item then do:

        assign RowObject.class-fiscal = if  RowObject.class-fiscal = ""
                                        then item.class-fiscal
                                        else RowObject.class-fiscal.

        /*NBS*/
        if  substring(RowObject.char-2,956,20) = ""
        and (natur-oper.cod-model-nf-eletro = "56" OR natur-oper.log-nfse-nacional) then do:
             assign overlay(RowObject.char-2,956,20) = substring(item.char-1,342,20).
        end.

        /* Busca do codigo CEST */
        IF SUBSTRING(RowObject.char-2,840,20) = "" THEN DO:

            IF NOT VALID-HANDLE( h-cdapi1001) THEN
                RUN cdp/cdapi1001.p PERSISTENT SET h-cdapi1001.

            IF NOT AVAIL unid-feder THEN
                FOR FIRST unid-feder NO-LOCK
                    WHERE unid-feder.pais   = docum-est.pais
                      AND unid-feder.estado = docum-est.uf.
                END.

            EMPTY TEMP-TABLE tt-sit-tribut.

            RUN pi-seta-tributos IN h-cdapi1001 (input "11").
            RUN pi-retorna-sit-tribut IN h-cdapi1001 (INPUT  1, /* tipo-nota */
                                                      INPUT  docum-est.cod-estabel,
                                                      INPUT  RowObject.nat-operacao,
                                                      INPUT  RowObject.class-fiscal,
                                                      INPUT  RowObject.it-codigo,
                                                      INPUT  integer(unid-feder.cod-uf-ibge),
                                                      INPUT  docum-est.cod-emitente,
                                                      INPUT  docum-est.dt-emissao,
                                                      OUTPUT TABLE tt-sit-tribut).

            FOR FIRST tt-sit-tribut
                WHERE tt-sit-tribut.cdn-tribut = 11:
                IF  tt-sit-tribut.cdn-sit-tribut <> 0
                AND tt-sit-tribut.seq-tab-comb   <> 0 THEN
                    overlay(RowObject.char-2,840,20) /** CEST **/ = STRING(tt-sit-tribut.cdn-sit-tribut,"9999999").
                ELSE
                    overlay(RowObject.char-2,840,20) /** CEST **/ = "".
            END.
        END.

        run setDefaultsImpostosTribAliq.

        IF VALID-HANDLE(h-cdapi1001) THEN DO:
           DELETE PROCEDURE h-cdapi1001.
           ASSIGN h-cdapi1001 = ?.
        END.

    end.

    IF l-integra-ems-his
    and avail cotacao-item
    and RowObject.num-pedido <> 0
    and (substring(RowObject.char-2,600,9) = "" or substring(RowObject.char-2,600,9) = "0") THEN DO:
	    overlay(RowObject.char-2,600,9) = substring(cotacao-item.char-1,127,9).
    END.

    /********* CHAMADA EPC PARA VALIDACOES ESPECIFICAS **********/
    {method/svc/custom/custom.i &Event = "AfterSetDefaultsItem"}
    /***********************************************************/

    /* Grava sempre a natureza fiscal, mesmo que n∆o utilize m£ltiplas naturezas */
    IF  RowObject.nat-of = "" OR RowObject.nat-of = ? THEN
        ASSIGN RowObject.nat-of = RowObject.nat-operacao.

    if not valid-handle(h-reapi435) then
       run rep/reapi435.p persistent set h-reapi435.

    IF  natur-oper.cod-model-nf-eletro = "55":U
    AND docum-est.origem <> "XML"
    AND CAN-FIND(FIRST funcao NO-LOCK
                 WHERE funcao.cd-funcao = "RE-SUGERE-SEQ-UN-XML":U
                   AND funcao.ativo) THEN DO:

        RUN setUnidComercial IN h-reapi435 (input RowObject.un).
        RUN setEmitente      IN h-reapi435 (INPUT RowObject.cod-emitente).
        RUN setSerieDocto    IN h-reapi435 (INPUT RowObject.serie-docto).
        RUN setNroDocto      IN h-reapi435 (INPUT RowObject.nro-docto ).
        RUN setNatOper       IN h-reapi435 (INPUT RowObject.nat-operacao).
        RUN setSequencia     IN h-reapi435 (INPUT RowObject.sequencia).
        RUN sugereSeqUnXML   IN h-reapi435 (OUTPUT iSeqXml).

        ASSIGN OVERLAY(RowObject.char-2,832,5) = trim(string(iSeqXml)).
        RUN efetivaTtExtItemDocEst IN h-reapi435.
    END.

    RETURN "OK":U.
    FINALLY:
        IF VALID-HANDLE(h-reapi435) THEN DO:
            DELETE PROCEDURE h-reapi435.
            ASSIGN h-reapi435 = ?.
        END.
    END FINALLY.

END PROCEDURE.




PROCEDURE setDefaultsOperTriang :
/*------------------------------------------------------------------------------
  Purpose:
  Parameters:  <none>
  Notes: Seta dos defaults dos campos referente a Operaá∆o Triangular.
------------------------------------------------------------------------------*/

    if  not avail docum-est then
        return "NOK":U.


    run findNaturOper ( docum-est.nat-operacao ).


    if  return-value <> "OK":U then
        return "NOK":U.

    if  natur-oper.log-oper-triang then do:


        if  RowObject.num-pedido <> 0 then
            run findPedido ( RowObject.num-pedido ).


        if  not avail pedido-compr
        and RowObject.num-pedido     = 0
        and RowObject.cod-emit-terc  = 0 then do:
            for first rat-ordem no-lock
                where rat-ordem.serie-docto  = RowObject.serie-docto
                  and rat-ordem.nro-docto    = RowObject.nro-docto
                  and rat-ordem.cod-emitente = RowObject.cod-emitente
                  and rat-ordem.nat-operacao = RowObject.nat-operacao
                  and rat-ordem.sequencia    = RowObject.sequencia:
                for first pedido-compr no-lock
                    where pedido-compr.num-pedido = rat-ordem.num-pedido: end.
            end.
        end.

        assign RowObject.cod-emit-terc  = if  RowObject.cod-emit-terc = 0
                                          then if  avail pedido-compr
                                               then pedido-compr.cod-emit-terc
                                               else docum-est.cod-emitente
                                          else RowObject.cod-emit-terc

               RowObject.nro-docto-terc = if  RowObject.nro-docto-terc = ""
                                          then docum-est.nro-docto
                                          else RowObject.nro-docto-terc

               RowObject.serie-terc  = if  RowObject.serie-terc = ""
                                          then docum-est.serie-docto
                                          else RowObject.serie-terc

               RowObject.nat-terc       = if  RowObject.nat-terc = ""
                                          then if  not natur-oper.terceiros
                                               then natur-oper.nat-vinculada
                                               else RowObject.nat-operacao
                                          else RowObject.nat-terc

               RowObject.seq-terc       = if  RowObject.seq-terc = 0
                                          then RowObject.sequencia
                                          else RowObject.seq-terc.


    end.


    return "OK":U.

END PROCEDURE.




PROCEDURE setDefaultsOrdCompServico :
/*------------------------------------------------------------------------------
  Purpose:
  Parameters:  <none>
  Notes:    Ordem de Compra de Serviáo
------------------------------------------------------------------------------*/


    def var de-preco-cc      as decimal no-undo.
    def var de-desconto-cc   as decimal no-undo.
    def var de-qtd-aux       as decimal no-undo.
    def var de-taxa          as decimal no-undo.
    def var de-preco-t       as decimal no-undo.
    def var de-val-contrato  as decimal no-undo.
    def var de-val-formula   as decimal no-undo.
    def var de-despesa       as decimal no-undo.
    def var de-frete         as decimal no-undo.

    /*Preco informado e quantidade nao informada*/


    run findOrdemCompra (RowObject.numero-ordem,
                         input ?).

    if  avail ordem-compra
    and ordem-compra.natureza = 2
    and ordem-compra.nr-contrato = 0 then do:


       run findPrazoCompra ( RowObject.numero-ordem,
                             RowObject.parcela ).


       if  avail prazo-compra then do:
           run rep/re1908.p (rowid(ordem-compra),
                            docum-est.dt-emissao,
                            output de-preco-cc,
                            output de-desconto-cc,
                            output de-taxa).

           if  param-global.modulo-cn
           and ordem-compra.nr-contrato <> 0 then do:
               run cnp/cn9060.p (INPUT RowObject.int-1,
                                 ?,
                                 ordem-compra.numero-ordem,
                                 0,
                                 no,
                                 RowObject.quantidade,
                                 docum-est.dt-emissao,
                                 output de-val-contrato,
                                 output de-val-aux,
                                 output de-val-formula,
                                 output de-val-aux).
               if  de-val-formula > 0 then
                   assign de-preco-cc = de-val-formula
                          de-desconto   = 0.
               else
               if  de-val-contrato > 0 then
                   assign de-preco-cc = de-val-contrato
                          de-desconto   = 0.
           end.

           run getIndice ( input RowObject.cod-emitente,
                           output de-indice ).

           assign de-preco-cc = round(de-preco-cc,5)
                  de-preco-t  = de-preco-cc * prazo-compra.quantidade.

           assign RowObject.qt-do-forn = if  de-quant-forn = 0
                                         then ((RowObject.preco-total[1] * prazo-compra.quantidade) / de-preco-t)
                                         else RowObject.qt-do-forn
                  /* Se o item n∆o fraciona, ent∆o arredonda a quantidade fornecedor, assim como faz com a quantidade */
                  RowObject.qt-do-forn = if item.fraciona
                                         then RowObject.qt-do-forn
                                         else round(RowObject.qt-do-forn,0)
                  RowObject.quantidade = if item.fraciona
                                         then (RowObject.qt-do-forn / de-indice)
                                         else round((RowObject.qt-do-forn / de-indice),0)
                  RowObject.preco-unit[1] = ( RowObject.preco-total[1] / ( RowObject.qt-do-forn + int( RowObject.qt-do-forn = 0))).
       end.
    end.

    return "OK":U.

END PROCEDURE.




PROCEDURE setDefaultsOrdemCompra :
/*------------------------------------------------------------------------------
  Purpose:
  Parameters:  <none>
  Notes:
------------------------------------------------------------------------------*/


    def var l-erro-co as logical no-undo.


    if  RowObject.num-pedido <> 0 then
        run findPedido ( RowObject.num-pedido ).


    if  return-value <> "OK":U
    or  not avail RowObject   then
        return "NOK":U.

    if  RowObject.numero-ordem <> 0 then
        run findOrdemCompra ( RowObject.numero-ordem,
                              input ? ).


    if  return-value <> "OK":U
    or  not avail RowObject   then
        return "NOK":U.

    if  RowObject.num-pedido <> 0
    and RowObject.numero-ordem = 0 then do:

        /* Busca primeira ordem com data de entrega mais antiga */
        for each  ordem-compra
            where ordem-compra.num-pedido    = RowObject.num-pedido
              and ordem-compra.situacao      = 2
              and (   ordem-compra.it-codigo = RowObject.it-codigo
                   or RowObject.it-codigo = " " )      no-lock,


            first prazo-compra use-index ordem-sit no-lock
                where prazo-compra.numero-ordem  = ordem-compra.numero-ordem
                  and prazo-compra.situacao      = 2
                  and ( prazo-compra.quant-saldo - prazo-compra.dec-1 - prazo-compra.qtd-recbda-fut > 0 )
                by prazo-compra.data-entrega
                by prazo-compra.numero-ordem:


            assign RowObject.numero-ordem = ordem-compra.numero-ordem
                   RowObject.parcela      = if RowObject.parcela = 0
                                            then prazo-compra.parcela
                                            else Rowobject.parcela
                   RowObject.nr-ato-concessorio = if SUBSTRING(prazo-compra.char-2,11,30) <> ? then SUBSTRING(prazo-compra.char-2,11,30) else "".


            leave.
        end.

        if  RowObject.parcela = 0 then do:

            find first ordem-compra
               where ordem-compra.num-pedido    = RowObject.num-pedido
                 and ordem-compra.situacao      = 2
                 and (   ordem-compra.it-codigo = RowObject.it-codigo
                       or RowObject.it-codigo = " " )      no-lock no-error.



            if  avail ordem-compra
            and ordem-compra.nr-contrato <> 0
            and param-global.modulo-cn then do:


                for first prazo-compra
                    fields ( numero-ordem    parcela         quant-saldo
                             situacao        data-entrega    dec-1
                             quant-rejeit     qtd-sal-forn     quantidade
                             quant-receb     cod-refer       char-2      )
                    use-index ordem-sit no-lock
                    where prazo-compra.numero-ordem = ordem-compra.numero-ordem
                      and prazo-compra.situacao     = 2 :
                end.


                if  available prazo-compra then
                    assign RowObject.numero-ordem  = ordem-compra.numero-ordem
                           RowObject.parcela       = if RowObject.parcela = 0
                                                     then prazo-compra.parcela
                                                     else Rowobject.parcela
                           RowObject.nr-ato-concessorio = if SUBSTRING(prazo-compra.char-2,11,30) <> ? then SUBSTRING(prazo-compra.char-2,11,30) else "".


            end.
        end.
    end.


    if  RowObject.num-pedido = 0
    and RowObject.numero-ordem <> 0 then do:


        find ordem-compra
            where ordem-compra.numero-ordem = RowObject.numero-ordem
            no-lock no-error.
        if  available ordem-compra
        and ordem-compra.num-pedido <> 0 then
            assign RowObject.num-pedido = ordem-compra.num-pedido.
    end.


    find ordem-compra
        where ordem-compra.numero-ordem = RowObject.numero-ordem
        no-lock no-error.


    if  avail ordem-compra then do:
        ASSIGN RowObject.nr-ord-produ = ordem-compra.ordem-servic WHEN RowObject.nr-ord-produ = 0
               RowObject.op-codigo   = ordem-compra.op-codigo    WHEN RowObject.op-codigo   = 0.

        if  RowObject.parcela = 0 then do:
            for first prazo-compra
                fields ( numero-ordem    parcela         quant-saldo
                         situacao        data-entrega    dec-1
                         quant-rejeit     qtd-sal-forn     quantidade
                         quant-receb     cod-refer       char-2
                         qtd-recbda-fut )
                where prazo-compra.numero-ordem = RowObject.numero-ordem
                  and prazo-compra.situacao     = 2
                  and ( prazo-compra.quant-saldo - prazo-compra.dec-1 - prazo-compra.qtd-recbda-fut ) > 0 use-index ordem-sit no-lock:
            end.
            if  not avail prazo-compra then
                for first prazo-compra
                    fields ( numero-ordem    parcela         quant-saldo
                             situacao        data-entrega    dec-1
                             quant-rejeit     qtd-sal-forn     quantidade
                             quant-receb     cod-refer       char-2
                             qtd-recbda-fut )
                     where prazo-compra.numero-ordem = RowObject.numero-ordem
                       and prazo-compra.situacao     = 2 no-lock:
                end.
            if  available prazo-compra then
                assign RowObject.parcela  = prazo-compra.parcela
                       RowObject.nr-ato-concessorio = if SUBSTRING(prazo-compra.char-2,11,30) <> ? then SUBSTRING(prazo-compra.char-2,11,30) else "".

        end.


        assign l-evento = no.


        if  ordem-compra.nr-contrato <> 0
        and param-global.modulo-cn then do:
            run cnp/cn9071.p (RowObject.numero-ordem,
                              RowObject.num-pedido,
                              2,
                              output l-evento,
                              output l-erro-co,
                              input-output table tt-erro).
        end.

        if  l-evento then do:
            /*find first evento-ped
               where evento-ped.numero-ordem = ordem-compra.numero-ordem
                 and evento-ped.nr-contrato  = ordem-compra.nr-contrato
                 and evento-ped.num-seq-item = ordem-compra.num-seq-item
                 no-lock no-error.
            */

            run pi-retorna-evento (output i-evento-aux).


            if RowObject.int-1 = 0 then
               assign RowObject.int-1 = i-evento-aux.




            if  param-re.encerra-cc = yes
            and not l-contrato
            and not docum-est.rec-fisico then
                assign l-encerra-pa = yes.

        end.
    end.

    if  avail ordem-compra then do:


        assign RowObject.narrativa   = if RowObject.narrativa = ""
                                       then ordem-compra.narrativa
                                       else RowObject.narrativa
               RowObject.it-codigo   = ordem-compra.it-codigo
               RowObject.num-ord-inv = ordem-compra.num-ord-inv.


        RUN findItem ( input RowObject.it-codigo ).


        RUN findItemFornec  ( input RowObject.it-codigo,
                              input RowObject.cod-emitente ).


        /*
        assign RowObject.un = if  avail item-fornec
                              and not l-devolucao   then
                                  item-fornec.unid-med-for
                              else
                                  if  avail item then
                                      item.un
                                  else
                                      " ".
        */

        if  avail item
        and item.tipo-contr = 4 then do:


            find first cotacao-item
                where cotacao-item.cod-emitente = ordem-compra.cod-emitente
                  and cotacao-item.numero-ordem = ordem-compra.numero-ordem
                  and cotacao-item.data-cotacao = ordem-compra.data-cotacao
                  and cotacao-item.cot-aprovada = yes
                  no-lock no-error.


            if  avail cotacao-item then
                assign RowObject.un = cotacao-item.un.

        end.


    end.

    if  RowObject.nr-ord-produ <> 0 then do:
        find ord-prod where
             ord-prod.nr-ord-produ = RowObject.nr-ord-produ no-lock no-error.
        if avail ord-prod then
           assign RowObject.ct-codigo = ord-prod.ct-codigo
                  RowObject.sc-codigo = ord-prod.sc-codigo.
    end.

    return "OK":U.

END PROCEDURE.




PROCEDURE setDefaultsPrecoTotal :
/*------------------------------------------------------------------------------
  Purpose:
  Parameters:  <none>
  Notes:
------------------------------------------------------------------------------*/


    def var de-qtd-max like item-doc-est.quantidade no-undo.
    def var l-erro-co  as logical                   no-undo.

    run findItem ( input RowObject.it-codigo ).


    if  return-value = "NOK":U then
        return "NOK":U.

    run findOrdemCompra ( input RowObject.numero-ordem,
                          input ? ).


    if  return-value = "NOK":U then
        return "NOK":U.



    run calculatePriceOrdemCompra ( input ?,
                                    output de-vl-merc-liq ).

    if  item.tipo-contr = 4 then do:
        find first cotacao-item
            where cotacao-item.cod-emitente = ordem-compra.cod-emitente
              and cotacao-item.numero-ordem = ordem-compra.numero-ordem
              and cotacao-item.data-cotacao = ordem-compra.data-cotacao
              and cotacao-item.cot-aprovada = yes
              no-lock no-error.


        if  avail cotacao-item then
            assign RowObject.un = cotacao-item.un.

    end.


    assign i-total = 0.


    /* Contrato - Para identificar se o contrato Ç por total contratado */


    if  avail ordem-compra and ordem-compra.nr-contrato <> 0
    and param-global.modulo-cn then do:


        run cnp/cn9174.p ( ordem-compra.numero-ordem,
                           2,
                           RowObject.int-1,
                           0,
                           docum-est.dt-emissao,
                           output de-qtd-max,
                           output l-erro-co,
                           output l-contrato,
                           output i-total,
                           input-output table tt-erro).

        if  l-erro-co then do:
            {method/svc/errors/inserr.i
                            &ErrorNumber="15212"  /*N∆o h†ˇ saldo liberado para o contrato*/
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"}
        end.
    end.


    assign de-preco-cc             = round(de-preco-cc,5)
           de-qtd-aux              = RowObject.qt-do-forn + int(RowObject.qt-do-forn = 0)
           RowObject.preco-unit[1] = de-preco-cc
           RowObject.desconto[1]   = de-desconto-cc * de-qtd-aux.

    if  i-total = 1 or i-total = 3 then /* Quando ordem possui contrato e este Ç por total contratado ou limite de custo */
        assign RowObject.preco-total[1] = de-preco-cc
               RowObject.preco-unit[1]  = RowObject.preco-total[1]
                                          / (RowObject.qt-do-forn + int(RowObject.qt-do-forn = 0)).
    else
        assign RowObject.preco-total[1] =  de-preco-cc * de-qtd-aux.

    if  avail param-re
    and param-re.rateia-desc
    and avail docum-est
    and docum-est.tot-desconto <> 0 then do:
        run rep/re1001r.p (rowid(docum-est),
                           RowObject.preco-total[1],
                           1,
                           output de-desconto).


        if  de-desconto <> 0 then do:
            assign RowObject.desconto[1] = de-desconto.
        end.
    end.


    return "OK":U.

END PROCEDURE.




PROCEDURE setDefaultsQtdScreen :
/*------------------------------------------------------------------------------
  Purpose:
  Parameters:  <none>
  Notes:
------------------------------------------------------------------------------*/
    def var de-pre-unit-for as decimal no-undo.
    def var l-erro-co       as logical no-undo.

    run getIndice (input RowObject.cod-emitente, output de-indice).

    assign i-total = 0.

    if RowObject.numero-ordem <> 0 then
       run cnp/cn9174.p ( RowObject.numero-ordem,
                          5,
                          RowObject.int-1,
                          0,
                          docum-est.dt-emissao,
                          output de-pre-unit-for,
                          output l-erro-co,
                          output l-contrato,
                          output i-total,
                          input-output table tt-erro).

    if i-total = 0 then do:

        if  RowObject.qt-do-forn <> 0
        and RowObject.quantidade = 0  then do:

            // tratamento especifico para quando for feito o recebimento da quantidade total do saldo da parcela da ordem de compra
            IF RowObject.numero-ordem <> 0 AND avail ordem-compra AND avail prazo-compra THEN DO:
                assign de-qtd-aux = prazo-compra.quant-saldo
                                    - prazo-compra.dec-1
                                    - prazo-compra.qtd-recbda-fut
                       de-qtd-aux = if de-qtd-aux < 0 then 0
                                    else de-qtd-aux
                       de-qtd-aux = if item.fraciona then de-qtd-aux
                                    else truncate( de-qtd-aux, 0 ).

                IF RowObject.qt-do-forn = ROUND(de-qtd-aux * de-indice, 4) THEN
                    assign RowObject.quantidade = de-qtd-aux.
            END.

            IF RowObject.quantidade = 0 THEN
                assign RowObject.quantidade = if item.fraciona
                                              then (RowObject.qt-do-forn / de-indice)
                                              else truncate((RowObject.qt-do-forn / de-indice),0).
        end.
        else
            if  RowObject.qt-do-forn = 0
            and RowObject.quantidade <> 0  then
                assign RowObject.qt-do-forn = RowObject.quantidade * de-indice.
    end.
    else do:
        run setDefaultsQuantidade. // Contrato controlado por limite de custo nao permite informar quantidade, apenas valor.

        if return-value = "NOK":U then.
        else do:
           {utp/ut-liter.i a_quantidade_referente_a_mediá∆o_liberada}

           {method/svc/errors/inserr.i &ErrorNumber="33383"
                                       &ErrorType="EMS":U
                                       &ErrorSubType="INFORMATION":U
                                       &ErrorParameters="return-value + '~~~~~' +
                                                        string(ordem-compra.nr-contrato) + '~~~~~' +
                                                        string(RowObject.it-codigo) + '~~~~~' +
                                                        string(RowObject.numero-ordem)"}
        end.
    end.

    return "OK":U.

END PROCEDURE.




PROCEDURE setDefaultsQuantidade :
/*------------------------------------------------------------------------------
  Purpose:
  Parameters:  <none>
  Notes:
------------------------------------------------------------------------------*/

    def var de-qtd-max      like item-doc-est.quantidade no-undo.
    def var de-pre-unit-for as decimal                   no-undo.
    def var l-erro-co       as logical                   no-undo.

    run findItem ( input RowObject.it-codigo ).


    if  return-value = "NOK":U then
        return "NOK":U.

    run findOrdemCompra ( input RowObject.numero-ordem,
                          input ? ).


    if  return-value = "NOK":U then
        return "NOK":U.


    run getIndice ( input ordem-compra.cod-emitente,
                    output de-indice ).

    /***** Leitura Parcela da Ordem de Compra *****/


    run findPrazoCompra ( input RowObject.numero-ordem,
                          input RowObject.parcela ).

    if avail prazo-compra then do:

       /* Recalcula o indice para conversao da unidade de medida
          quando a ordem de compra nao pertence ao item informado
          ou o item da ordem for igual a branco.                  */


        if  docum-est.mod-atual = 1   /* Indica Nota de Material Agregado */
        and (   RowObject.it-codigo <> ordem-compra.it-codigo
             or ordem-compra.it-codigo = " " )  then
            assign de-indice = prazo-compra.qtd-sal-forn
                              / prazo-compra.quant-saldo.

        assign de-qtd-aux = prazo-compra.quant-saldo
                            - prazo-compra.dec-1
                            - prazo-compra.qtd-recbda-fut
               de-qtd-aux = if  de-qtd-aux < 0 then 0
                            else de-qtd-aux

               RowObject.qt-do-forn = de-qtd-aux * de-indice

               de-qtd-aux = if  item.fraciona then de-qtd-aux
                            else truncate( de-qtd-aux, 0 )

               RowObject.quantidade = de-qtd-aux.
    end.


    assign i-total = 0.


    /* Inicio validacao contrato - So para buscar a quantidade */


    if  avail ordem-compra and ordem-compra.nr-contrato <> 0
    and param-global.modulo-cn then do:


        run cnp/cn9174.p ( ordem-compra.numero-ordem,
                           2,
                           RowObject.int-1,
                           0,
                           docum-est.dt-emissao,
                           output de-qtd-max,
                           output l-erro-co,
                           output l-contrato,
                           output i-total,
                           input-output table tt-erro).


        if  l-erro-co then do:
            {method/svc/errors/inserr.i
                            &ErrorNumber="15212"  /*N∆o h†ˇ saldo liberado para o contrato*/
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"}
        end.

        if l-contrato = yes then do:

            if  RowObject.preco-total[1] <> 0
            and i-total = 1 then do:
                run cnp/cn9174.p ( ordem-compra.numero-ordem,
                                   5,
                                   RowObject.int-1,
                                   RowObject.preco-total[1],
                                   docum-est.dt-emissao,
                                   output de-pre-unit-for,
                                   output l-erro-co,
                                   output l-contrato,
                                   output i-total,
                                   input-output table tt-erro).
                case i-total:
                   when 1 then  // Retorna 1 do ponto 5(cn9174) se item do contrato for controlado por limite de custo
                      assign RowObject.qt-do-forn = RowObject.preco-total[1] / de-pre-unit-for.
                   when 2 then
                      assign RowObject.qt-do-forn = de-pre-unit-for. // Contrato por total nota retorna a quantidade no primeiro parametro de retorno do cn9174
                   otherwise do:
                      if de-qtd-max > 0 then
                         assign RowObject.qt-do-forn = de-qtd-max.
                      else
                         assign RowObject.qt-do-forn = 0
                                de-qtd-max           = 0.
                   end.
                end case.
            end.
            else do:
                if  de-qtd-max > 0 then
                    assign RowObject.qt-do-forn = de-qtd-max.
                else
                    assign RowObject.qt-do-forn = 0
                           de-qtd-max = 0.
            end.

            assign RowObject.quantidade = RowObject.qt-do-forn / de-indice.
            if  avail item and not item.fraciona then
                assign RowObject.quantidade = truncate(RowObject.quantidade,0).

        end.
    end.

    return "OK":U.

END PROCEDURE.



PROCEDURE setDefaultsImpostosTribAliq :
/*------------------------------------------------------------------------------
  Purpose:
  Parameters:  <none>
  Notes:
------------------------------------------------------------------------------*/

    def var de-trib-pis        as int             no-undo.
    def var de-trib-cofins     as int             no-undo.
    DEF BUFFER b-natur-oper-fisc FOR natur-oper.

    IF NOT VALID-HANDLE(h-cdapi995) THEN
        RUN cdp/cdapi995.p PERSISTENT SET h-cdapi995.

    if  not avail docum-est then
        run findDocumento ( RowObject.Cod-Emitente,
                            RowObject.Serie-Docto,
                            RowObject.Nro-Docto,
                            RowObject.Nat-Operacao ).

    if not avail item then
        run findItem ( RowObject.it-codigo ).

    if  not avail docum-est or
        not avail item      then
        return "NOK":U.

    run findEstabelec ( docum-est.cod-estabel ).
    if not avail estabelec then
        return "NOK":U.

    if  not valid-handle(h_bodi317im2bra) then
        run dibo/bodi317im2bra.p persistent set h_bodi317im2bra.

    if  not valid-handle(h-cd4337) then
        run cdp/cd4337.p persistent set h-cd4337.

    {inbo/boin176.m73 "RowObject.it-codigo"}

    /* Se usa multiplas naturezas no recebimento busca natureza fiscal do item */
    IF  l-mult-natur-receb THEN /* Natureza fiscal do Item */
        FIND FIRST b-natur-oper-fisc WHERE b-natur-oper-fisc.nat-operacao = RowObject.nat-of NO-LOCK NO-ERROR.

    /* Se n∆o usa multiplas naturezas ou usa mas a nota Ç antiga (digit. antes de marcar o parÉm.) */
    IF  NOT AVAIL b-natur-oper-fisc THEN /* Natureza de operaá∆o do documento */
        FIND FIRST b-natur-oper-fisc WHERE b-natur-oper-fisc.nat-operacao = RowObject.nat-operacao NO-LOCK NO-ERROR.

    /* Alteraá∆o para busca da aliquota do ICMS  */
    IF  b-natur-oper-fisc.log-icms-substto-antecip AND NOT lSujTribMonofasica THEN
        ASSIGN RowObject.log-2 = IF b-natur-oper-fisc.tipo-compra <= 3 AND NOT b-natur-oper-fisc.terceiros THEN YES
                                 ELSE RowObject.log-2.
    ELSE
        ASSIGN RowObject.log-2 = IF b-natur-oper-fisc.subs-trib AND b-natur-oper-fisc.tipo-compra = 2 THEN YES /* Frete */
                                 ELSE RowObject.log-2.

    if ((not l-devolucao and not l-dev-transf) or (l-devolucao and RowObject.nro-comp = "")) then /*devoluá∆o sem nota de origem*/
        assign RowObject.val-perc-rep-ipi = b-natur-oper-fisc.perc-red-ipi
               RowObject.val-perc-red-icms = b-natur-oper-fisc.perc-red-icm.

    RUN localizaItem IN h_bodi317im2bra (INPUT  RowObject.it-codigo, OUTPUT l-procedimento-ok).

    /* CHAMADA EPC - GRENDENE - Atualizar vari†vel l-default-aliquota */
    {method/svc/custom/custom.i &Event = "lDefaultAliquotaNO"}

    if ((RowObject.aliquota-ipi = 0 and l-default-aliquota) or
         l-alteracao-nat-oper                             ) and
       ((not l-devolucao  and
         not l-dev-transf and    /*devoluá∆o transferencia*/
         b-natur-oper-fisc.tp-oper-terc <> 2 and
         b-natur-oper-fisc.tipo-compra  <> 9 and /*Nota Credito/Debito*/
         b-natur-oper-fisc.tp-oper-terc <> 5) or /*N∆o pode ser Ret.Benef., nem devol.consig.*/
        (l-devolucao and RowObject.nro-comp = "")) then
        run getAliquotaIPI ( input RowObject.class-fiscal,
                             input item.it-codigo,
                             output RowObject.aliquota-ipi ).

    if  b-natur-oper-fisc.transf
    and avail saldo-terc then
        run findEstabelec ( saldo-terc.cod-estabel ).

    find first b-emit-estab no-lock
         where b-emit-estab.cod-emitente = estabelec.cod-emitente no-error.

    /* CHAMADA EPC - GRENDENE - Atualizar vari†vel l-default-aliquota */
    {method/svc/custom/custom.i &Event = "lDefaultAliquotaYES"}

    IF ((RowObject.aliquota-icm = 0 AND l-default-aliquota) or
        l-alteracao-nat-oper                              ) and
       ((not l-devolucao  and
         not l-dev-transf and   /*devoluá∆o transferencia*/
         b-natur-oper-fisc.tp-oper-terc <> 2 and
         b-natur-oper-fisc.tipo-compra  <> 9 and /*Nota Credito/Debito*/
         b-natur-oper-fisc.tp-oper-terc <> 5) or /*N∆o pode ser Ret.Benef., nem devol.consig.*/
        (RowObject.aliquota-icm = 0 and (l-devolucao or b-natur-oper-fisc.tp-oper-terc = 2 or b-natur-oper-fisc.tp-oper-terc = 5))  or
        (l-devolucao and RowObject.nro-comp = "")) THEN DO:
        RUN createTbWtDocto.
        RUN createTbWtItDocto(INPUT RowObject.sequencia,
                              INPUT RowObject.it-codigo,
                              INPUT RowObject.quantidade,
                              INPUT RowObject.qt-do-forn,
                              INPUT RowObject.preco-total[1],
                              INPUT RowObject.desconto[1],
                              INPUT RowObject.despesas[1] - DEC(SUBSTR(RowObject.char-2,819,13)),
                              INPUT RowObject.pr-total-cmi ).
        RUN localizaWtDocto   IN h_bodi317im2bra(INPUT 1,
                                                 OUTPUT l-procedimento-ok ).
        RUN localizaWtItDocto IN h_bodi317im2bra(INPUT 1,
                                                 INPUT tb-wt-it-docto.seq-wt-it-docto,
                                                 OUTPUT l-procedimento-ok ).

        RUN calculaAliquotaICMS in h_bodi317im2bra ( (if avail b-emit-estab
                                                      then b-emit-estab.contrib-icms
                                                      else yes),
                                                     (if avail b-emit-estab
                                                      then b-emit-estab.natureza
                                                      else 2), /*J*/
                                                     (if l-devolucao                        /* Devoluá∆o Cliente */
                                                      or b-natur-oper-fisc.tp-oper-terc = 5 /* Devoluá∆o Consignaá∆o */
                                                      or l-transf                           /* Transferencia */
                                                      or l-dev-transf                       /*devoluá∆o transferencia*/
                                                      then estabelec.estado
                                                      else emitente.estado),
                                                     (if l-devolucao                        /* Devoluá∆o Cliente */
                                                      or b-natur-oper-fisc.tp-oper-terc = 5 /* Devoluá∆o Consignaá∆o */
                                                      then estabelec.pais
                                                      else emitente.pais),
                                                     (if l-devolucao                        /* Devoluá∆o Cliente */
                                                      or b-natur-oper-fisc.tp-oper-terc = 5 /* Devoluá∆o Consignaá∆o */
                                                      or l-transf                           /* Transferencia */
                                                      or l-dev-transf                        /*devoluá∆o transferencia*/
                                                      then emitente.estado
                                                      else estabelec.estado),
                                                      item.it-codigo,
                                                      b-natur-oper-fisc.nat-operacao,       /* Natureza fiscal ou de operaá∆o... */
                                                      output RowObject.aliquota-icm,
                                                      output l-procedimento-ok ).
    END.

    if  l-default-tributacao and
        ((not l-devolucao and not l-dev-transf) or (l-devolucao and RowObject.nro-comp = "")) then do: /*devoluá∆o sem nota de origem*/

        run codigoTributacaoIPI in h_bodi317im2bra ( INPUT  RowObject.it-codigo,
                                                     INPUT  (IF  l-mult-natur-receb AND RowObject.nat-of <> "" THEN /* l-mult-natur-receb -> cd9701.i */
                                                                 RowObject.nat-of /* Se usa Multi. Naturezas e ela foi informada: usa ela */
                                                            ELSE RowObject.nat-operacao), /* Sen∆o usa a natureza da nota. */
                                                     OUTPUT RowObject.cd-trib-ipi,
                                                     OUTPUT l-procedimento-ok ).

        run codigoTributacaoICMS in h_bodi317im2bra ( input RowObject.it-codigo,
                                                      INPUT (IF  l-mult-natur-receb AND RowObject.nat-of <> "" THEN /* l-mult-natur-receb -> cd9701.i */
                                                                 RowObject.nat-of /* Se usa Multi. Naturezas e ela foi informada: usa ela */
                                                            ELSE RowObject.nat-operacao), /* Sen∆o usa a natureza da nota. */
                                                      output RowObject.cd-trib-icm,
                                                      output l-procedimento-ok ).
    end.

    if l-servicos then do:
        if  RowObject.aliquota-iss = 0 or l-alteracao-nat-oper then
            assign RowObject.aliquota-iss = item.aliquota-iss.

        if  l-default-tributacao then
            run codigoTributacaoISS in h_bodi317im2bra ( input RowObject.it-codigo,
                                                         INPUT (IF  l-mult-natur-receb AND RowObject.nat-of <> "" THEN /* l-mult-natur-receb -> cd9701.i */
                                                                     RowObject.nat-of /* Se usa Multi. Naturezas e ela foi informada: usa ela */
                                                                ELSE RowObject.nat-operacao), /* Sen∆o usa a natureza da nota. */
                                                         output RowObject.cd-trib-iss,
                                                         output l-procedimento-ok ).
    end.

    IF b-natur-oper-fisc.tipo-compra  <> 3  and
       b-natur-oper-fisc.tipo-compra  <> 8  and  /*devoluá∆o transferencia*/
       b-natur-oper-fisc.tipo-compra  <> 9  and /*Nota Credito/Debito*/
       b-natur-oper-fisc.tp-oper-terc <> 5  or
       (l-devolucao and RowObject.nro-comp = "")  THEN DO: /* Devolucao ou devoluá∆o consignaá∆o */

    /* Busca aliquota e tributacao de PIS */
       RUN pi-tributa-aliquota-pis IN h-cd4337 ( BUFFER estabelec,
                                                 BUFFER item,
                                                 BUFFER emitente,
                                                 BUFFER b-natur-oper-fisc,
                                                 INPUT  docum-est.dt-emissao,
                                                 OUTPUT de-trib-pis,
                                                 OUTPUT de-aliquota-pis,
                                                 OUTPUT de-valor-un-pis,
                                                 OUTPUT de-val-reduc-pis-normal ).

       assign RowObject.idi-tributac-pis = de-trib-pis
              RowObject.val-aliq-pis     = de-aliquota-pis.

       /* Busca aliquota e tributacao de COFINS */
       RUN pi-tributa-aliquota-cofins IN h-cd4337 ( BUFFER estabelec,
                                                    BUFFER item,
                                                    BUFFER emitente,
                                                    BUFFER b-natur-oper-fisc,
                                                    INPUT  docum-est.dt-emissao,
                                                    OUTPUT de-trib-cofins,
                                                    OUTPUT de-aliquota-cofins,
                                                    OUTPUT de-valor-un-cofins,
                                                    OUTPUT de-val-reduc-cofins-normal ).

       assign RowObject.idi-tributac-cofins = de-trib-cofins
              RowObject.val-aliq-cofins     = de-aliquota-cofins.

       RUN grava-aliquotas IN h-cdapi995 (INPUT "item-doc-est",
                                          INPUT RowObject.serie-docto + "/" +
                                                RowObject.nro-docto + "/" +
                                                string(RowObject.cod-emitente) + "/" +
                                                RowObject.nat-operacao + "/" +
                                                string(RowObject.sequencia),
                                          INPUT de-aliquota-pis,
                                          INPUT de-aliquota-cofins).
    END.

    /*setar ICMS Retido quando natureza da operaá∆o do item usa Substituiá∆o Tribut†ria e sistema usa multiplas naturezas*/
    IF l-mult-natur-receb and avail (b-natur-oper-fisc) and  b-natur-oper-fisc.subs-trib then do:
        Assign RowObject.log-2 = yes.
    end.

    /* Se Nota de Credito/Debito, isenta todos os impostos Antigos*/
    IF  l-NT2024002
    AND b-natur-oper-fisc.tipo-compra = 9  THEN
        ASSIGN RowObject.cd-trib-icm          = 2
               RowObject.cd-trib-ipi          = 2
               RowObject.cd-trib-iss          = 2
               RowObject.idi-tributac-cofins  = 2
               RowObject.idi-tributac-pis     = 2.

    /*Aliquotas CBS, IBS UF, IBS Mun e IS*/
    RUN setDefaultsTribAliqRtc.

    if valid-handle(h-cd4337) then do:
        delete procedure h-cd4337.
        assign h-cd4337 = ?.
    end.

    if valid-handle(h_bodi317im2bra) then do:
        delete procedure h_bodi317im2bra.
        assign h_bodi317im2bra = ?.
    end.

    return "OK":U.

END PROCEDURE.

PROCEDURE setDefaultsTribAliqRtc :
    DEF VAR h-cdapi1005            AS HANDLE                             NO-UNDO.
    DEF VAR dAliq                  LIKE relacto-tributo.aliquota         NO-UNDO.
    DEF VAR dPercDifer             LIKE relacto-tributo.perc-diferido    NO-UNDO.
    DEF VAR dPercRed               LIKE relacto-tributo.perc-red         NO-UNDO.
    DEF VAR dPercCredPresum        LIKE relacto-tributo.perc-cred-presum NO-UNDO.
    DEF VAR dAliqDeson             LIKE relacto-tributo.aliquota         NO-UNDO.
    DEF VAR dPercRedAliqGov        AS DECIMAL                            NO-UNDO.
    DEF VAR i-ano-emis-nf          AS INTEGER                            NO-UNDO.

    DEF BUFFER b-natur-oper-fisc FOR natur-oper.

    {inbo/boin176.m73 "RowObject.it-codigo"}

    IF NOT AVAIL docum-est THEN
        RUN findDocumento ( RowObject.Cod-Emitente,
                            RowObject.Serie-Docto,
                            RowObject.Nro-Docto,
                            RowObject.Nat-Operacao ).

    IF NOT AVAIL docum-est OR
       NOT AVAIL item      THEN
        RETURN "NOK":U.

    /* Se usa multiplas naturezas no recebimento busca natureza fiscal do item */
    IF  l-mult-natur-receb THEN /* Natureza fiscal do Item */
        FIND FIRST b-natur-oper-fisc WHERE b-natur-oper-fisc.nat-operacao = RowObject.nat-of NO-LOCK NO-ERROR.

    /* Se n∆o usa multiplas naturezas ou usa mas a nota Ç antiga (digit. antes de marcar o parÉm.) */
    IF  NOT AVAIL b-natur-oper-fisc THEN /* Natureza de operaá∆o do documento */
        FIND FIRST b-natur-oper-fisc WHERE b-natur-oper-fisc.nat-operacao = RowObject.nat-operacao NO-LOCK NO-ERROR.

    ASSIGN l-utilizaImpostoMonitor = NO.

    RUN utilizaImpostosMonitorRecFiscal (INPUT RowObject.serie-docto,
                                         INPUT RowObject.nro-docto,
                                         INPUT RowObject.cod-emitente,
                                         INPUT RowObject.nat-operacao,
                                         INPUT INT(SUBSTRING(RowObject.char-2,832,5)),
                                         OUTPUT l-utilizaImpostoMonitor).

    IF  l-NT2024002 and
        VALID-HANDLE(h-boin090) AND
       ((l-devolucao AND RowObject.nro-comp <> "") OR
        l-dev-transf OR /*devol transf*/
        l-transf OR
        b-natur-oper-fisc.tp-oper-terc = 2   OR /*Retorno Beneficiamento*/
        b-natur-oper-fisc.tp-oper-terc = 9   OR /*Retorno Dep Fechado*/
        b-natur-oper-fisc.tp-oper-terc = 5   OR /*Devoluá∆o Consigná∆o*/
        b-natur-oper-fisc.tp-oper-terc = 11)  /*Retorno ArmazÇm Geral*/
        THEN DO:
       RUN copiarInfCBSIBSNFOrig(INPUT h-boin090).
    END.

    /***Aliquotas CBS, IBS UF e IBS Mun*********************************/
    IF l-NT2024002 AND
       not l-utilizaImpostoMonitor  AND
       ((NOT l-devolucao  AND
         NOT l-dev-transf AND /*devol transf*/
         NOT l-transf AND
         NOT l-multa-juros AND
         b-natur-oper-fisc.tp-oper-terc <> 2   AND /*Retorno Beneficiamento*/
         b-natur-oper-fisc.tp-oper-terc <> 9   AND /*Retorno Dep Fechado*/
         b-natur-oper-fisc.tp-oper-terc <> 5   AND /*Devoluá∆o Consigná∆o*/
         b-natur-oper-fisc.tp-oper-terc <> 11  AND /*Retorno ArmazÇm Geral*/
         NOT l-remessa-fat-antecip             AND
         NOT l-remessa-ent-futura)             OR
        (l-devolucao AND RowObject.nro-comp = "") OR
        (l-multa-juros AND RowObject.nro-comp = "") OR
        (b-natur-oper-fisc.tp-oper-terc = 2 AND
         l-remessa-ent-futura)                      OR
        (b-natur-oper-fisc.tp-oper-terc = 1 AND
         l-remessa-fat-antecip)  )  THEN DO:

        FOR FIRST ext-docum-est NO-LOCK
            WHERE ext-docum-est.serie-docto  = docum-est.serie-docto
              AND ext-docum-est.nro-docto    = docum-est.nro-docto
              AND ext-docum-est.cod-emitente = docum-est.cod-emitente
              AND ext-docum-est.nat-operacao = docum-est.nat-operacao
              AND ext-docum-est.cod-param    = "fatogeradorCBS-IBS":U: END.

        IF lSujTribMonofasica THEN DO:
            FOR FIRST param-monofasico NO-LOCK
                WHERE param-monofasico.cod-anp = TRIM(SUBSTRING(item.char-1,268,20)):
            END.
            ASSIGN i-ano-emis-nf = YEAR(docum-est.dt-emissao).
        END.

        /*Processo Suframa - sugest∆o para todos os tipos de nota, baseado no cadastro do item*/
        FIND FIRST reg-inf-compl NO-LOCK
            WHERE reg-inf-compl.cod-tab-inform   = "item-dist":U
              AND reg-inf-compl.cod-campo-inform = "c-Proc-Suframa":U NO-ERROR.
        IF AVAIL reg-inf-compl THEN DO:
            FIND FIRST inf-compl NO-LOCK
                WHERE inf-compl.cdn-identif = reg-inf-compl.cdn-identif
                  AND inf-compl.num-campo   = 0
                  AND inf-compl.cod-indice  = RowObject.it-codigo NO-ERROR.
            IF AVAIL inf-compl AND inf-compl.des-campo <> "" THEN
                RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:PROCESSO-SUFRAMA, INPUT inf-compl.des-campo).
        END.

        IF NOT VALID-HANDLE(h-cdapi1005) THEN
            RUN cdp/cdapi1005.p PERSISTENT SET h-cdapi1005.

        RUN emptyTtRelactoTributo IN h-cdapi1005.
        RUN setDados              IN h-cdapi1005 (INPUT 1, /*Entrada*/
                                                  INPUT if docum-est.dt-competencia <> ? then docum-est.dt-competencia else docum-est.dt-emissao,
                                                  INPUT docum-est.cod-estabel,
                                                  INPUT (IF RowObject.nat-of <> "" THEN RowObject.nat-of ELSE RowObject.nat-operacao),
                                                  INPUT RowObject.it-codigo,
                                                  INPUT RowObject.class-fiscal,
                                                  INPUT emitente.cod-gr-forn,
                                                  INPUT RowObject.cod-emitente,
                                                  INPUT b-natur-oper-fisc.cod-cfop,
                                                  INPUT item.cod-servico,
                                                  INPUT (IF AVAIL ext-docum-est THEN ext-docum-est.cod-livre-1 ELSE docum-est.cidade),  /*cidade*/
                                                  INPUT (IF AVAIL ext-docum-est THEN ext-docum-est.cod-livre-2 ELSE docum-est.uf)). /*UF*/

        run setNbs IN h-cdapi1005 (input if substring(RowObject.char-2,956,20) <> ? and substring(RowObject.char-2,956,20) <> '' then substring(RowObject.char-2,956,20) else '*').
        RUN gerattcombinacao IN h-cdapi1005.

        ASSIGN dAliq           = 0
               dPercDifer      = 0
               dPercRed        = 0
               dPercCredPresum = 0
               dAliqDeson      = 0
               dPercRedAliqGov = 0.

        RUN emptyTtRelactoTributo IN h-cdapi1005.
        RUN setIndTributo         IN h-cdapi1005 (INPUT 1). /*CBS*/
        RUN buscarRelactotributo  IN h-cdapi1005.
        RUN getTributo            IN h-cdapi1005 (OUTPUT dAliq,
                                                  OUTPUT dPercDifer,
                                                  OUTPUT dPercRed,
                                                  OUTPUT dPercCredPresum,
                                                  OUTPUT dAliqDeson,
                                                  OUTPUT dPercRedAliqGov).

        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-EFETIVA, INPUT '0').
        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:VALOR       , INPUT '0').

        IF lSujTribMonofasica THEN DO:
            IF AVAIL param-monofasico THEN DO:
                /*Para o CBS, a partir de 2027 o c†lculo Ç por AdRem e essa al°quota est† configurada no CD0618*/
                IF i-ano-emis-nf >= 2027 THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-MONO,      INPUT STRING(param-monofasico.aliq-AdRemCBS)).
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:TIPO-CALC-MONO, INPUT rep.list.TipoCalcMono:ADREM).
                END.
                ELSE DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-MONO,      INPUT STRING(dAliq)).
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:TIPO-CALC-MONO, INPUT rep.list.TipoCalcMono:ADVALOREM).
                END.

                RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-MONO-RET,      INPUT STRING(param-monofasico.aliq-AdRemCBS-reten)).
            END.
        END.
        ELSE DO:
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQUOTA,     INPUT STRING(dAliq)).
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:PERC-DIFER,   INPUT STRING(dPercDifer)).
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-RED,     INPUT STRING(dPercRed)).
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:PERC-CP,      INPUT STRING(dPercCredPresum)).
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:PERC-RED-GOV, INPUT STRING(dPercRedAliqGov)).

            IF docum-est.cod-tipo-ente-gov > 0 THEN
                RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-GOV,  INPUT STRING(dAliq)).
        END.

        /*Al°quota efetiva ALC/ZFM (cadastro de al°quotas dos tributos) - apenas CBS*/
        EMPTY TEMP-TABLE tt-relacto-tributo.
        RUN getTtRelactoTributo IN h-cdapi1005 (OUTPUT TABLE tt-relacto-tributo).
        FOR FIRST tt-relacto-tributo:
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-EFETIVA-ALCZFM, INPUT STRING(tt-relacto-tributo.perc-efet-alczfm)).
        END.

        ASSIGN dAliq           = 0
               dPercDifer      = 0
               dPercRed        = 0
               dPercCredPresum = 0
               dAliqDeson      = 0
               dPercRedAliqGov = 0.

        RUN emptyTtRelactoTributo IN h-cdapi1005.
        RUN setIndTributo         IN h-cdapi1005 (INPUT 2). /*IBS UF*/
        RUN buscarRelactotributo  IN h-cdapi1005.
        RUN getTributo            IN h-cdapi1005 (OUTPUT dAliq,
                                                  OUTPUT dPercDifer,
                                                  OUTPUT dPercRed,
                                                  OUTPUT dPercCredPresum,
                                                  OUTPUT dAliqDeson,
                                                  OUTPUT dPercRedAliqGov).

        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-EFETIVA, INPUT '0').
        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:VALOR       , INPUT '0').

        IF lSujTribMonofasica THEN DO:
            IF AVAIL param-monofasico THEN DO:
                /*Para o IBS UF, a partir de 2029 o c†lculo Ç por AdRem e essa al°quota est† configurada no CD0618*/
                IF i-ano-emis-nf >= 2029 THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-MONO,      INPUT STRING(param-monofasico.aliq-AdRemIBS)).
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:TIPO-CALC-MONO, INPUT rep.list.TipoCalcMono:ADREM).
                END.
                ELSE DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-MONO,      INPUT STRING(dAliq)).
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:TIPO-CALC-MONO, INPUT rep.list.TipoCalcMono:ADVALOREM).
                END.

                RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-MONO-RET,      INPUT STRING(param-monofasico.aliq-AdRemIBS-reten)).
            END.
        END.
        ELSE DO:
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQUOTA,     INPUT STRING(dAliq)).
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:PERC-DIFER,   INPUT STRING(dPercDifer)).
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-RED,     INPUT STRING(dPercRed)).
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:PERC-CP,      INPUT STRING(dPercCredPresum)).
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:PERC-RED-GOV, INPUT STRING(dPercRedAliqGov)).

            IF docum-est.cod-tipo-ente-gov > 0 THEN
                RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-GOV,  INPUT STRING(dAliq)).
        END.

        ASSIGN dAliq           = 0
               dPercDifer      = 0
               dPercRed        = 0
               dPercCredPresum = 0
               dAliqDeson      = 0
               dPercRedAliqGov = 0.

        RUN emptyTtRelactoTributo IN h-cdapi1005.
        RUN setIndTributo         IN h-cdapi1005 (INPUT 3). /*IBS MUN*/
        RUN buscarRelactotributo  IN h-cdapi1005.
        RUN getTributo            IN h-cdapi1005 (OUTPUT dAliq,
                                                  OUTPUT dPercDifer,
                                                  OUTPUT dPercRed,
                                                  OUTPUT dPercCredPresum,
                                                  OUTPUT dAliqDeson,
                                                  OUTPUT dPercRedAliqGov).
        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQ-EFETIVA, INPUT '0').
        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:VALOR       , INPUT '0').

        IF lSujTribMonofasica THEN DO:
            /*Para o IBS MUN, s¢ haver† c†lculo quando for por AdValorem (atÇ 2028), sendo que s¢ tem essa separaá∆o em IBS MUN no mono padr∆o*/
            IF i-ano-emis-nf < 2029 THEN DO:
                RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQ-MONO,      INPUT STRING(dAliq)).
                RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:TIPO-CALC-MONO, INPUT rep.list.TipoCalcMono:ADVALOREM).
            END.
        END.
        ELSE DO:
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQUOTA,     INPUT STRING(dAliq)).
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:PERC-DIFER,   INPUT STRING(dPercDifer)).
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQ-RED,     INPUT STRING(dPercRed)).
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:PERC-RED-GOV, INPUT STRING(dPercRedAliqGov)).

            IF docum-est.cod-tipo-ente-gov > 0 THEN
               RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQ-GOV,  INPUT STRING(dAliq)).
        END.

        /* Verifica se o item tem o parÉmetro Incide IS como Sim */
        IF SUBSTRING(item.char-1,289,1) = "S" THEN DO:

            RUN emptyTtRelactoTributo IN h-cdapi1005.
            RUN setIndTributo         IN h-cdapi1005 (INPUT 4).

            /* IS */
            RUN buscarRelactotributo  IN h-cdapi1005.

            EMPTY TEMP-TABLE tt-relacto-tributo.

            /*retorna a temp-table com o dados que foram filtrados*/
            RUN getTtRelactoTributo   IN h-cdapi1005 (OUTPUT TABLE tt-relacto-tributo).

            FOR FIRST tt-relacto-tributo:
                RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:ALIQUOTA,      INPUT STRING(tt-relacto-tributo.aliquota)).
                RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:ALIQ-ESPEC-UN, INPUT STRING(tt-relacto-tributo.aliq-esp-por-unid-aprop-is)).
            END.

            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:VALOR, INPUT '0').

        END.

        IF VALID-HANDLE(h-cdapi1005) THEN DO:
            DELETE PROCEDURE h-cdapi1005.
            ASSIGN h-cdapi1005 = ?.
        END.
    END.

    RETURN "OK":U.

END PROCEDURE.
