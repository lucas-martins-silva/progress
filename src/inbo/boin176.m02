        WHEN "vl-iss-cmi":U THEN ASSIGN pFieldValue = RowObject.vl-iss-cmi.
        WHEN "vl-subs[1]":U THEN ASSIGN pFieldValue = RowObject.vl-subs[1].
        WHEN "vl-subs[2]":U THEN ASSIGN pFieldValue = RowObject.vl-subs[2].
        WHEN "vl-subs-cmi":U THEN ASSIGN pFieldValue = RowObject.vl-subs-cmi.
        WHEN "vl-taxa":U THEN ASSIGN pFieldValue = RowObject.vl-taxa.
        WHEN "vl-taxa-me":U THEN ASSIGN pFieldValue = RowObject.vl-taxa-me.
        WHEN "vl-unit-mob":U THEN ASSIGN pFieldValue = RowObject.vl-unit-mob.
        WHEN "preco-total-bruto":U THEN ASSIGN pFieldValue = RowObject.preco-total-bruto.
        WHEN "preco-unit-bruto":U THEN ASSIGN pFieldValue = RowObject.preco-unit-bruto.
        WHEN "preco-total-liquido":U THEN ASSIGN pFieldValue = RowObject.preco-total-liquido.
        WHEN "preco-unit-liquido":U THEN ASSIGN pFieldValue = RowObject.preco-unit-liquido.
        
        &IF "{&bf_mat_versao_ems}":U >= "2.06":U &THEN
            WHEN "base-pis":U             THEN ASSIGN pFieldValue = RowObject.base-pis.
            WHEN "valor-pis":U            THEN ASSIGN pFieldValue = RowObject.valor-pis.
            WHEN "val-base-calc-cofins":U THEN ASSIGN pFieldValue = RowObject.val-base-calc-cofins.
            WHEN "val-cofins":U           THEN ASSIGN pFieldValue = RowObject.val-cofins.
        &ENDIF
        
        OTHERWISE RETURN "NOK":U.
    END CASE.

    RETURN "OK":U.
END PROCEDURE.




PROCEDURE getDescriptionFields :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  
        1. Input pFieldName      -> Atributo da Tabela Item-Doc-Est
        2. Output pDescription   -> Descri»’o do atributo da Tabela Item-Doc-Est

  Notes:  Determina descri»’o do campos.     
------------------------------------------------------------------------------*/

    DEFINE INPUT PARAMETER   pFieldName   AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER  pDescription AS CHARACTER NO-UNDO.


   

    CASE pFieldName:
        WHEN "desc-item":U           THEN ASSIGN pDescription = if  avail item then 
                                                                    item.desc-item
                                                                else "".
        WHEN "it-codigo":U           THEN ASSIGN pDescription = if  avail item-fornec then 
                                                                    item-fornec.it-codigo
                                                                else "".
        WHEN "item-do-forn":U        THEN ASSIGN pDescription = if  avail item-fornec then 
                                                                    item-fornec.item-do-forn
                                                                else "".
        WHEN "c-desc-class-fiscal":U THEN ASSIGN pDescription = if  avail classif-fisc then 
                                                                    classif-fisc.descricao
                                                                else "".

        WHEN "cod-refer":U           THEN ASSIGN pDescription = if  avail referencia then 
                                                                    referencia.descricao
                                                                else "".
                                                           

        WHEN "cod-depos":U           THEN ASSIGN pDescription = if  avail deposito then 
                                                                    deposito.nome
                                                                else "".

        WHEN "cod-estabel":U         THEN ASSIGN pDescription = if  avail docum-est then 
                                                                    docum-est.cod-estabel
                                                                else "".
                                                                

        WHEN "tipo-con-est":U        THEN ASSIGN pDescription = if  avail item then
                                                                    string({ininc/i01in122.i 04 item.tipo-con-est})
                                                                else "".

        WHEN "tipo-contr":U          THEN ASSIGN pDescription = if  avail item then
                                                                    string({ininc/i09in122.i 04 item.tipo-contr})
                                                                else "".
        

        WHEN "nome-abrev":U          THEN ASSIGN pDescription = if  avail emitente then
                                                                    emitente.nome-abrev
                                                                else "".
                                                                

        WHEN "nome-emit":U           THEN ASSIGN pDescription = if  avail emitente then
                                                                    emitente.nome-emit
                                                                else "".

        OTHERWISE RETURN "NOK":U.
        

    END CASE.


END PROCEDURE.




PROCEDURE getDocumEst :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: Localiza Documento na boin090. 
         Chamado pelo TransferTotalItensNota e initializeFind.      
------------------------------------------------------------------------------*/

    def input param piCodEmitente like item-doc-est.cod-emitente no-undo.
    def input param piSerieDocto  like item-doc-est.serie-docto  no-undo.
    def input param piNroDocto    like item-doc-est.nro-docto    no-undo.
    def input param piNatOperacao like item-doc-est.nat-operacao no-undo.

    if  not valid-handle(h-boin090) then do:
        run inbo/boin090.p persistent set h-boin090.
        run openQueryStatic in h-boin090 ( input "Main":U ).
    end.        
            

    run goToKey in h-boin090 ( input piSerieDocto,
                               input piNroDocto,
                               input piCodEmitente,
                               input piNatOperacao ).
                                   

    return "OK":U.
    

END PROCEDURE.




PROCEDURE getHandleDocumEst :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def output param piHandle as handle no-undo.
    

    if  valid-handle(h-boin090) then 
        assign piHandle = h-boin090.
    

    return "OK":U.
        

END PROCEDURE.




PROCEDURE getIndice :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:  Determina o ­ndice (fator de conver»’o).      
------------------------------------------------------------------------------*/

    def input  param piEmitente  like item-doc-est.cod-emitente  no-undo.
    def output param de-indice   as decimal                      no-undo.

    def var c-nossa-unid         like item-doc-est.un             no-undo.
    def var c-unid-forn          like item-doc-est.un             no-undo.

    run getUnidadeMedida ( input RowObject.it-codigo,
                           input " ",
                           input RowObject.numero-ordem,
                           input RowObject.parcela,
                           output c-nossa-unid,
                           output c-unid-forn ).

    if  not l-devolucao 
    and not l-retorno  then do:
        {cdp/cd9950.i c-nossa-unid 
                      c-unid-forn
                      docum-est.cod-emitente}
    end.
    else do:
        if avail item and
           avail emitente and
           item.ind-inf-qtf = ? and 
           (l-devolucao or l-retorno) then do:
           &IF '{&bf_mat_versao_ems}' >= '2.062' &THEN
                for first para-ped no-lock:
                end.           
                &IF '{&bf_dis_versao_ems}' >= '2.09' &THEN
                    IF NOT para-ped.log-usa-fator-item-clien THEN DO:
                &ELSE
                    IF SUBSTRING(para-ped.CHAR-2,4,3) = 'no' OR SUBSTRING(para-ped.char-2,4,3) = "" THEN DO:
                &ENDIF
                   FOR FIRST item-unid-venda 
                       WHERE item-unid-venda.it-codigo = ITEM.it-codigo
                         AND item-unid-venda.un = RowObject.un NO-LOCK: END.
                   IF AVAIL item-unid-venda THEN
                       assign de-indice = item-unid-venda.fator-conversao / 
                                          if  item-unid-venda.num-casa-dec = 0 then 1
                                          else exp(10,item-unid-venda.num-casa-dec).  
                   ELSE
                       assign de-indice = 1.
                end.
                else do:
                   for first item-cli fields(unid-med-cli fator-conversao num-casa-dec)
                        where item-cli.it-codigo = item.it-codigo
                          and item-cli.nome-abrev = emitente.nome-abrev no-lock:
                          assign de-indice = item-cli.fator-conversao / 
                                             if  item-cli.num-casa-dec = 0 then 1
                                             else exp(10,item-cli.num-casa-dec).  
                   end.                 
                end.
           &ELSE
                for first item-cli fields(unid-med-cli fator-conversao num-casa-dec)
                     where item-cli.it-codigo = item.it-codigo
                       and item-cli.nome-abrev = emitente.nome-abrev no-lock:
                       assign de-indice = item-cli.fator-conversao / 
                                          if  item-cli.num-casa-dec = 0 then 1
                                          else exp(10,item-cli.num-casa-dec).  
                end. 
           &ENDIF  
        end.
        else
            assign de-indice = 1.    
    end.         

    if  de-indice = 0 or de-indice = ? then 
        assign de-indice = 1.                  

    return "OK":U.

END PROCEDURE.




PROCEDURE getIntField :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valor de campos do tipo inteiro
  Parameters:  
               recebe nome do campo
               retorna valor do campo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pFieldName AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldValue AS INTEGER NO-UNDO.

    /*--- Verifica se temptable RowObject estÿ dispon­vel, caso n’o esteja serÿ
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
        RETURN "NOK":U.

    CASE pFieldName:
        WHEN "cd-trib-icm":U THEN ASSIGN pFieldValue = RowObject.cd-trib-icm.
        WHEN "cd-trib-ipi":U THEN ASSIGN pFieldValue = RowObject.cd-trib-ipi.
        WHEN "cd-trib-iss":U THEN ASSIGN pFieldValue = RowObject.cd-trib-iss.
        WHEN "cod-emit-benef":U THEN ASSIGN pFieldValue = RowObject.cod-emit-benef.
        WHEN "cod-emitente":U THEN ASSIGN pFieldValue = RowObject.cod-emitente.
        WHEN "cod-emit-terc":U THEN ASSIGN pFieldValue = RowObject.cod-emit-terc.
        WHEN "cod-tax":U THEN ASSIGN pFieldValue = RowObject.cod-tax.
        WHEN "cod-tax-isr":U THEN ASSIGN pFieldValue = RowObject.cod-tax-isr.
        WHEN "codigo-rejei":U THEN ASSIGN pFieldValue = RowObject.codigo-rejei.
        WHEN "emite-comp":U THEN ASSIGN pFieldValue = RowObject.emite-comp.
        WHEN "etiquetas":U THEN ASSIGN pFieldValue = RowObject.etiquetas.
        WHEN "flag-atu":U THEN ASSIGN pFieldValue = RowObject.flag-atu.
        WHEN "fn-docto-ap":U THEN ASSIGN pFieldValue = RowObject.fn-docto-ap.
        WHEN "i-nr-gi":U THEN ASSIGN pFieldValue = RowObject.i-nr-gi.
        WHEN "i-seq-inv":U THEN ASSIGN pFieldValue = RowObject.i-seq-inv.
        WHEN "idi-tributac-pis":U THEN ASSIGN pFieldValue = RowObject.idi-tributac-pis.
        WHEN "idi-tributac-cofins":U THEN ASSIGN pFieldValue = RowObject.idi-tributac-cofins.
        WHEN "int-1":U THEN ASSIGN pFieldValue = RowObject.int-1.
        WHEN "int-2":U THEN ASSIGN pFieldValue = RowObject.int-2.
        WHEN "nr-ficha":U THEN ASSIGN pFieldValue = RowObject.nr-ficha.
        WHEN "nr-ord-produ":U THEN ASSIGN pFieldValue = RowObject.nr-ord-produ.
        WHEN "nr-pd-ent":U THEN ASSIGN pFieldValue = RowObject.nr-pd-ent.
        WHEN "nr-pd-seq":U THEN ASSIGN pFieldValue = RowObject.nr-pd-seq.
        WHEN "num-ord-inv":U THEN ASSIGN pFieldValue = RowObject.num-ord-inv.
        WHEN "num-pedido":U THEN ASSIGN pFieldValue = RowObject.num-pedido.
        WHEN "numero-ordem":U THEN ASSIGN pFieldValue = RowObject.numero-ordem.
        WHEN "op-codigo":U THEN ASSIGN pFieldValue = RowObject.op-codigo.
        WHEN "origem":U THEN ASSIGN pFieldValue = RowObject.origem.
        WHEN "parcela":U THEN ASSIGN pFieldValue = RowObject.parcela.
        WHEN "qt-etiquetas":U THEN ASSIGN pFieldValue = RowObject.qt-etiquetas.
        WHEN "seq-comp":U THEN ASSIGN pFieldValue = RowObject.seq-comp.
        WHEN "seq-terc":U THEN ASSIGN pFieldValue = RowObject.seq-terc.
        WHEN "sequencia":U THEN ASSIGN pFieldValue = RowObject.sequencia.
        WHEN "sit-item":U THEN ASSIGN pFieldValue = RowObject.sit-item.
        OTHERWISE RETURN "NOK":U.
    END CASE.

    RETURN "OK":U.
END PROCEDURE.




PROCEDURE getItem :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:   Determina o item atrav²s do item do fornecedor.
------------------------------------------------------------------------------*/

    DEF INPUT PARAM piItemFornec LIKE ITEM-DOC-EST.IT-CODIGO NO-UNDO.       
    


    /* Acessa Item-Fornec */
    RUN findNossoItem  ( input piItemFornec,
                         input RowObject.cod-emitente ).


    IF  return-value = "NOK":U then
        return "NOK":U.

    assign RowObject.it-codigo = item-fornec.it-codigo.

    return "OK":U.

END PROCEDURE.




PROCEDURE getItemFornec :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:   Determina o item do fornecedor atrav²s do item.     
------------------------------------------------------------------------------*/

    

    /* Acessa Item-Fornec */
    RUN findItemFornec  ( input RowObject.it-codigo,
                          input RowObject.cod-emitente ).


    IF  return-value = "NOK":U then
        return "NOK":U.

    assign c-it-do-forn = item-fornec.item-do-forn.

    return "OK":U.

END PROCEDURE.




PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do ­ndice documento
  Parameters:  
               retorna valor do campo serie-docto
               retorna valor do campo nro-docto
               retorna valor do campo cod-emitente
               retorna valor do campo nat-operacao
               retorna valor do campo sequencia
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pcod-emitente LIKE item-doc-est.cod-emitente NO-UNDO.
    DEFINE OUTPUT PARAMETER pserie-docto LIKE item-doc-est.serie-docto NO-UNDO.
    DEFINE OUTPUT PARAMETER pnro-docto LIKE item-doc-est.nro-docto NO-UNDO.
    DEFINE OUTPUT PARAMETER pnat-operacao LIKE item-doc-est.nat-operacao NO-UNDO.
    DEFINE OUTPUT PARAMETER psequencia LIKE item-doc-est.sequencia NO-UNDO.

    /*--- Verifica se temptable RowObject estÿ dispon­vel, caso n’o esteja serÿ
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pserie-docto = RowObject.serie-docto
           pnro-docto = RowObject.nro-docto
           pcod-emitente = RowObject.cod-emitente
           pnat-operacao = RowObject.nat-operacao
           psequencia = RowObject.sequencia.

    RETURN "OK":U.
END PROCEDURE.




