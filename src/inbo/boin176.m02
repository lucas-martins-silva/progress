------------------------------------------------------------------------------*/

    def input param piTotaliza as int no-undo.
    

    assign i-totaliza = piTotaliza.  

END PROCEDURE.




PROCEDURE getUnidadeMedida :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: Determina a nossa unidade de medida e a do fornecedor.   
------------------------------------------------------------------------------*/

    def input  param piItem        like item-doc-est.it-codigo    no-undo.
    def input  param piType        as character                   no-undo.
    def input  param piNumeroOrdem like item-doc-est.numero-ordem no-undo.
    def input  param piParcela     like item-doc-est.parcela      no-undo.
    def output param c-nossa-unid  like item-doc-est.un           no-undo.
    def output param c-unid-forn   like item-doc-est.un           no-undo.
    

    def var c-un                   like item-doc-est.un           no-undo.    
    

    /***** Leitura do Item *****/

    run findItem ( piItem ).

    if  return-value <> "OK":U 
    or  not avail docum-est then 
        return "NOK":U.
        

    run findItemFornec ( piItem,
                         docum-est.cod-emitente ).
                         
    run findEmitente ( docum-est.cod-emitente ).

    assign c-un = if  avail item-fornec 
                  AND NOT (l-devolucao AND RowObject.nro-comp <> "") then
                      item-fornec.unid-med-for
                  else 
                      if  avail item then 
                          item.un 
                      else 
                          " ".
    if avail item and
       avail emitente and
       item.ind-inf-qtf = ? and 
       (l-devolucao or l-retorno) then
            for first item-cli fields(unid-med-cli)
                 where item-cli.it-codigo = item.it-codigo
                   and item-cli.nome-abrev = emitente.nome-abrev no-lock:
                   assign c-un = item-cli.unid-med-cli.
            end.                        

    if  avail item
    and (   piNumeroOrdem <> 0
         or (    avail RowObject 
             and RowObject.int-2 <> 0 )) then do: /* N£mero da Ordem Compra quando o item ‚ gerado pelo botÆo pedido - WEB */

        if  piNumeroOrdem <> 0  then
            run findOrdemCompra ( piNumeroOrdem,
                                  ? ).
        else if  RowObject.int-2 <> 0 then
                 run findOrdemCompra ( RowObject.int-2,
                                       ? ).
        if  avail ordem-compra then do:
            find first cotacao-item
                where cotacao-item.cod-emitente = ordem-compra.cod-emitente
                  and cotacao-item.numero-ordem = ordem-compra.numero-ordem
                  and cotacao-item.data-cotacao = ordem-compra.data-cotacao
                  and cotacao-item.cot-aprovada = yes
                  no-lock no-error.
            if  avail cotacao-item then 
                assign c-un = cotacao-item.un.
        end.
    end.             

    assign c-unid-forn = c-un.

    if  piType = "CREATE":U  then 
        assign RowObject.un = c-un.

    if  avail item
    and item.tipo-contr = 4
    and avail ordem-compra  then do:
    

        for first prazo-compra
            fields ( numero-ordem    parcela         quant-saldo
                     situacao        data-entrega    dec-1
                     quant-rejeit     qtd-sal-forn     quantidade
                     quant-receb     cod-refer       un 
                     qtd-recbda-fut )
                     

            where prazo-compra.numero-ordem = ordem-compra.numero-ordem 
              and prazo-compra.parcela      = piParcela no-lock:
        end.

        if  not avail prazo-compra then 
            find first prazo-compra 
                 where prazo-compra.numero-ordem = ordem-compra.numero-ordem 
                 no-lock no-error.
            

        assign c-nossa-unid = if avail prazo-compra
                              then prazo-compra.un
                              else if avail item 
                                   then item.un
                                   else "".
    end.
    else assign c-nossa-unid = if avail item 
                               then item.un
                               else "".
    return "OK":U.

END PROCEDURE.




PROCEDURE getValuesItemMatEstab :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:  Retorna os percentuais de limite e varia»’o da tabela 
          item-uni-estab ou item-mat.
------------------------------------------------------------------------------*/

    def output param de-var-perc-vl   as decimal no-undo.
    def output param de-var-lim-vl    as decimal no-undo.
    def output param de-var-perc-qt   as decimal no-undo.
    def output param de-var-lim-qt    as decimal no-undo.
    


    for first item-uni-estab
        fields ( it-codigo     lim-var-valor
                 cod-estabel   var-val-re-maior
                 var-qtd-re    lim-var-qtd
                 deposito-pad  cod-localiz
                 loc-unica     contr-qualid)
        where item-uni-estab.it-codigo   = RowObject.it-codigo
          and item-uni-estab.cod-estabel = docum-est.cod-estabel no-lock:
        

    end.
    

    if  not avail item-uni-estab
    or (     avail item-uni-estab 
        and (   item-uni-estab.var-val-re-maior = 0
             or item-uni-estab.lim-var-valor    = 0
             or item-uni-estab.var-qtd-re       = 0
             or item-uni-estab.lim-var-qtd      = 0 ) ) then do:
        for first item-mat
            fields ( it-codigo      var-val-re-maior
                     lim-var-valor  var-qtd-re     
                     lim-var-qtd    lim-var-valor     ) 
            where item-mat.it-codigo = RowObject.it-codigo no-lock:
        end.
    end.

    assign de-var-perc-vl  = if  avail item-uni-estab
                             and item-uni-estab.var-val-re-maior > 0 
                             then item-uni-estab.var-val-re-maior
                             else item-mat.var-val-re-maior

           de-var-lim-vl   = if  avail item-uni-estab
                             and item-uni-estab.lim-var-valor > 0 
                             then item-uni-estab.lim-var-valor
                             else item-mat.lim-var-valor

           de-var-perc-qt  = if  avail item-uni-estab
                             and item-uni-estab.var-qtd-re > 0 
                             then item-uni-estab.var-qtd-re
                             else item-mat.var-qtd-re
                                 

           de-var-lim-qt   = if  avail item-uni-estab
                             and item-uni-estab.lim-var-qtd > 0 
                             then item-uni-estab.lim-var-qtd
                             else item-mat.lim-var-qtd.
                                             

    return "OK":U.

END PROCEDURE.




