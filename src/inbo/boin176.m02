    IF AVAIL docum-est THEN
        assign pRowid = rowid(docum-est).

END PROCEDURE.




PROCEDURE getSeqItem :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:   Retorna o sequ¼ncia do pr½ximo item da nota.     
------------------------------------------------------------------------------*/

    def output param i-seq like item-doc-est.sequencia no-undo.

    if  not avail docum-est then
        return "NOK":U.

    run findUsuario ( input c-seg-usuario ).

    find last b-item-doc-est 
        where b-item-doc-est.cod-emitente = docum-est.cod-emitente 
          and b-item-doc-est.nro-docto    = docum-est.nro-docto    
          and b-item-doc-est.serie-docto  = docum-est.serie-docto  
          and b-item-doc-est.nat-operacao = docum-est.nat-operacao 
        no-lock no-error.

    if  available b-item-doc-est then
        assign i-seq = b-item-doc-est.sequencia + param-re.inc-seq.
    else
        assign i-seq = param-re.seq-item-um.

    return "OK":U.

END PROCEDURE.




