PROCEDURE getAliquotaIPI :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:   Determina a aliquota de IPI atrav²s do item ou classifica»’o fiscal, 
           conforme par³metro do usuÿrio.    
------------------------------------------------------------------------------*/

    def input  param piClassFiscal like item-doc-est.class-fiscal no-undo.
    def input  param piItem        like item-doc-est.it-codigo    no-undo.
    def output param de-aliquota   like item-doc-est.aliquota-ipi no-undo.

    if  not avail docum-est then
        return "NOK":U.
        

    run findUsuario ( c-seg-usuario ).
    

    if  return-value <> "OK":U then 
        return "NOK":U.    

    run findItem ( piItem ).
    

    if  return-value <> "OK":U then 
        return "NOK":U.    
    

    run findClassFiscal ( piClassFiscal ).
    

    if  avail param-re
    and param-re.orig-aliq-ip  = 1
    and avail classif-fisc  then 
        assign de-aliquota = classif-fisc.aliquota-ipi.
    else 
        assign de-aliquota = item.aliquota-ipi.

    return "OK":U.

END PROCEDURE.




PROCEDURE getCamposNaturOper :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE input  parameter piNatOperacao like docum-est.nat-operacao no-undo.
    DEFINE INPUT  PARAMETER pFieldName    AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldValue   AS CHARACTER NO-UNDO.

    if not avail natur-oper or natur-oper.nat-operacao <> piNatOperacao then
       run findNaturOper (input piNatOperacao).

    /*--- Verifica se temptable RowObject estÿ dispon­vel, caso n’o esteja serÿ
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE natur-oper THEN 
        RETURN "NOK":U.

    CASE pFieldName:
        WHEN "perc-red-ipi":U THEN ASSIGN pFieldValue = string(natur-oper.perc-red-ipi).
        WHEN "perc-red-icm":U THEN ASSIGN pFieldValue = string(natur-oper.perc-red-icm).
        OTHERWISE RETURN "NOK":U.
    END CASE.

    RETURN "OK":U.
END PROCEDURE.




PROCEDURE getCharField :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valor de campos do tipo caracter
  Parameters:  
               recebe nome do campo
               retorna valor do campo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pFieldName AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldValue AS CHARACTER NO-UNDO.

    /*--- Verifica se temptable RowObject estÿ dispon­vel, caso n’o esteja serÿ
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
        RETURN "NOK":U.

    CASE pFieldName:
        WHEN "c-nr-invoice":U THEN ASSIGN pFieldValue = RowObject.c-nr-invoice.
        WHEN "char-1":U THEN ASSIGN pFieldValue = RowObject.char-1.
        WHEN "char-2":U THEN ASSIGN pFieldValue = RowObject.char-2.
