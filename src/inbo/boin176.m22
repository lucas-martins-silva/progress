PROCEDURE createItemOfNotaFiscal:
/*------------------------------------------------------------------------------
  Purpose:
  Parameters:  <none>
  Notes: Cria‡Æo dos itens da nota de devolu‡Æo, apartir da nota fiscal de venda.
------------------------------------------------------------------------------*/

    def input param piHboin090  as handle                   no-undo.
    def input param table       for tt-item-devol-cli.

    def var i-seq-aux           like item-doc-est.sequencia no-undo.
    def var i-seq-exp           like item-doc-est.sequencia no-undo.
    def var de-indice           as dec                      no-undo.
    def var l-configurado       as logical                  no-undo.
    def var c-un                like item-doc-est.un        no-undo.
    DEF VAR d-aliq-pis          as dec                      NO-UNDO.
    DEF VAR d-aliq-cofins       as dec                      NO-UNDO.
    DEF VAR d-val-base-pis      as dec                      NO-UNDO.
    DEF VAR d-val-base-cofins   as dec                      NO-UNDO.
    DEF VAR d-val-pis           as dec                      NO-UNDO.
    DEF VAR d-val-cofins        as dec                      NO-UNDO.
    DEF VAR l-ref-por-item      AS LOGICAL init no          NO-UNDO.

    def buffer bf-natur-oper-fut for natur-oper.
    /**********************************************************
    ** Desenvolvimento Engenharia Controle de Seriais        **
    ** Variavel indicara se a funcao SPP-SERIAIS-NF estara   **
    ** ativa ou nao.                                         **
    **********************************************************/
    DEFINE VARIABLE l-funcao-spp-seriais-nf AS LOGICAL NO-UNDO.
    DEFINE VARIABLE h-boin735               AS HANDLE  NO-UNDO.
    DEFINE VARIABLE h-bodi516               AS HANDLE  NO-UNDO.
    DEFINE VARIABLE h-bodi515               AS HANDLE  NO-UNDO.
    DEFINE VARIABLE h-reapi412              AS HANDLE  NO-UNDO.
    DEFINE VARIABLE h-reapi434              AS HANDLE  NO-UNDO.
    DEFINE VARIABLE h-re1910                AS HANDLE  NO-UNDO.

    DEFINE BUFFER b-natur-oper-fiscal       FOR natur-oper. /* buffer aux. para buscar a natureza do item */

    DEFINE VARIABLE c-erro-cabec AS CHAR NO-UNDO.
    DEFINE VARIABLE c-erro-desc AS CHAR NO-UNDO.

    IF NOT VALID-HANDLE(h-cdapi995) THEN
        RUN cdp/cdapi995.p PERSISTENT SET h-cdapi995.

    FIND FIRST funcao
         WHERE funcao.cd-funcao = "spp-seriais-nf":U AND
               funcao.ativo     = YES                NO-LOCK NO-ERROR.

    IF AVAIL funcao THEN
        ASSIGN l-funcao-spp-seriais-nf = YES.
    ELSE
        ASSIGN l-funcao-spp-seriais-nf = NO.

    assign h-boin090 = piHboin090.

    run getKey in piHboin090 ( output i-cod-emitente,
                               output c-serie-docto,
                               output c-nro-docto,
                               output c-nat-operacao ).

    run findDocumento ( i-cod-emitente,
                        c-serie-docto,
                        c-nro-docto,
                        c-nat-operacao ).


    if  not avail docum-est then
        RETURN "NOK":U.

    &if "{&DBType}":U <> "PROGRESS":U &then
        run openQueryStatic (input "OfDocumEst":U).
    &endif

    run findNaturOper ( c-nat-operacao ).

    run findUsuario ( docum-est.usuario ).


    if  not avail param-re then
        return "NOK":U.

    {cdp/cd9700.i1 natur-oper}

    run getSeqItem ( output i-seq-aux ).

    assign i-seq-exp = i-seq-aux.

    assign l-nf-transf-devol-ret = yes. /* nao seta os defaults de depos, local, refer na setDefaultsEstoque */

    IF l-funcao-spp-seriais-nf THEN DO:
        IF  NOT VALID-HANDLE(h-boin735)               OR
            h-boin735:TYPE      <> "PROCEDURE":U      OR
            h-boin735:FILE-NAME <> "inbo/boin735.p":U THEN DO:
            RUN inbo/boin735.p PERSISTENT SET h-boin735.
        END.
    END.

    bloco:
    do  trans on error undo, leave:

        for each tt-item-devol-cli exclusive-lock:

            run emptyRowObject.

            find it-nota-fisc
                where rowid(it-nota-fisc) = tt-item-devol-cli.rw-it-nota-fisc no-lock no-error.

            /*validação entrega futura*/
            IF  l-fatura-ent-futura
	        and natur-oper.tipo-compra = 3 THEN DO:
                FOR FIRST bf-natur-oper-fut
                    WHERE bf-natur-oper-fut.nat-operacao = it-nota-fisc.nat-operacao NO-LOCK:
                    IF AVAIL bf-natur-oper-fut then do:
                         IF bf-natur-oper-fut.ind-entfut
                         AND NOT bf-natur-oper-fut.ind-est-qtd
                 	     AND (SUBSTRING(bf-natur-oper-fut.char-1,1,5) = "0"
                	     OR   SUBSTRING(bf-natur-oper-fut.char-1,1,5) = "") THEN DO:
                                FOR FIRST componente
                                    WHERE componente.nro-docto     = it-nota-fisc.nr-nota-fis
                                      AND componente.nat-operacao  = bf-natur-oper-fut.nat-comp
                	              AND componente.cod-emitente  = docum-est.cod-emitente
                	              AND componente.serie-docto   = it-nota-fisc.serie
                	              AND componente.it-codigo     = it-nota-fisc.it-codigo
                                      AND componente.sequencia     = it-nota-fisc.nr-seq-fat NO-LOCK:           /*14447 - Adicionado sequencia na clausula para notas com mesmo item em mais de uma sequencia*/
                                      /*** Localiza a saldo-terc para atualizacao do saldo digitado ***/
                	              FOR FIRST saldo-terc
                                          WHERE saldo-terc.nro-docto    = componente.nro-docto
                                            AND saldo-terc.cod-emitente = componente.cod-emitente
                	            	    AND saldo-terc.serie-docto  = componente.serie-docto
                	            	    AND saldo-terc.sequencia    = componente.sequencia   EXCLUSIVE-LOCK:
                                            if  tt-item-devol-cli.quant-devol > (it-nota-fisc.qt-faturada[1] - saldo-terc.dec-1) then do:
                                                def var d-aux as decimal no-undo.
                                                assign d-aux = it-nota-fisc.qt-faturada[1] - saldo-terc.dec-1.
                                                /* Quantidade de Saldo na Fatura Insuficiente */
                                                {method/svc/errors/inserr.i
                                                                 &ErrorNumber="53775"
                                                                 &ErrorType="EMS"
                                                                 &ErrorSubType="ERROR"
                                                                 &ErrorParameters="String(d-aux)"}
                        	                undo bloco, return "NOK":U. /* Desfaz o bloco e retorna com erro */
                        	            end.
                                            if tt-item-devol-cli.quant-devol > saldo-terc.quantidade then do:
                                                /* Quantidade de Saldo na Fatura Insuficiente */
                                                {method/svc/errors/inserr.i
                                                                   &ErrorNumber="53775"
                                                                   &ErrorType="EMS"
                                                                   &ErrorSubType="ERROR"
                                                                   &ErrorParameters="String(saldo-terc.quantidade)"}
                                                undo bloco, return "NOK":U. /* Desfaz o bloco e retorna com erro */
                                            END.
                	              END.
                	        END.
                         END.
                         ELSE DO:
                                {utp/ut-liter.i "Nota_Fiscal_nÆo_‚_uma_fatura_de_entrega_futura" *}
                                ASSIGN c-erro-cabec = RETURN-VALUE.

                                {utp/ut-liter.i "Verifique_se_a_nota_que_est _sendo_devolvida_‚_uma_nota_de_fatura_de_entrega_futura." *}
                                assign c-erro-desc = RETURN-VALUE.

                                /* Quantidade de Saldo na Fatura Insuficiente */
                                {method/svc/errors/inserr.i
                                                  &ErrorNumber="17006"
                                                  &ErrorType="EMS"
                                                  &ErrorSubType="ERROR"
                                                  &ErrorParameters="c-erro-cabec + '~~~~':U + c-erro-desc"}
                        	undo bloco, return "NOK":U. /* Desfaz o bloco e retorna com erro */
                         END.
                    END.
	        END.
            END.

            /*valida‡Æo faturamento antecipado*/
            IF  l-fatura-fat-antecip
            AND natur-oper.tipo-compra = 3 THEN DO:
                FOR FIRST bf-natur-oper-fut
                    WHERE bf-natur-oper-fut.nat-operacao = it-nota-fisc.nat-operacao NO-LOCK:
                    FIND FIRST movto-fatur-antecip
                        WHERE movto-fatur-antecip.cod-estabel  = it-nota-fisc.cod-estabel
                          AND movto-fatur-antecip.serie-docto  = it-nota-fisc.serie
                          AND movto-fatur-antecip.nr-nota-fis  = it-nota-fisc.nr-nota-fis
                          AND movto-fatur-antecip.cod-emitente = it-nota-fisc.cd-emitente
                          AND movto-fatur-antecip.nat-operacao = it-nota-fisc.nat-operacao
                          AND movto-fatur-antecip.it-codigo    = it-nota-fisc.it-codigo
                          AND movto-fatur-antecip.cod-refer    = it-nota-fisc.cod-refer
                          AND movto-fatur-antecip.num-seq      = if it-nota-fisc.nr-seq-ped > 0 /* Gambiarra por causa da alteracao 375123 do faturamento */
                                                                  then it-nota-fisc.nr-seq-ped
                                                                  else it-nota-fisc.nr-seq-fat NO-LOCK NO-ERROR.
                    IF AVAIL movto-fatur-antecip THEN DO:
                        FOR FIRST sdo-fatur-antecip
                            WHERE sdo-fatur-antecip.num-id-sdo = movto-fatur-antecip.num-id-sdo NO-LOCK:
                            IF tt-item-devol-cli.quant-devol > sdo-fatur-antecip.qtd-saldo THEN DO:
                                /* Quantidade de Saldo na Fatura Insuficiente */
                                {method/svc/errors/inserr.i
                                                  &ErrorNumber="53775"
                                                  &ErrorType="EMS"
                                                  &ErrorSubType="ERROR"
                                                  &ErrorParameters="String(sdo-fatur-antecip.qtd-saldo)"}
                                undo bloco, return "NOK":U. /* Desfaz o bloco e retorna com erro */
                            END.
                        END.
                    END.
                    ELSE DO:
                        {utp/ut-liter.i "Nota_Fiscal_nÆo_‚_uma_fatura_de_faturamento_antecipado" *}
                        ASSIGN c-erro-cabec = RETURN-VALUE.

                        {utp/ut-liter.i "Verifique_se_a_nota_que_est _sendo_devolvida_‚_uma_nota_de_fatura_de_faturamento_antecipado." *}
                        assign c-erro-desc = RETURN-VALUE.

                        /* Quantidade de Saldo na Fatura Insuficiente */
                        {method/svc/errors/inserr.i
                                          &ErrorNumber="17006"
                                          &ErrorType="EMS"
                                          &ErrorSubType="ERROR"
                                          &ErrorParameters="c-erro-cabec + '~~~~':U + c-erro-desc"}
                        undo bloco, return "NOK":U. /* Desfaz o bloco e retorna com erro */
                    END.
                END.
            END.

            /*devolu‡Æo de remessa de entrega futura*/
            IF l-remessa-ent-futura
            AND natur-oper.tipo-compra = 3 THEN DO:
                FOR FIRST bf-natur-oper-fut
                    WHERE bf-natur-oper-fut.nat-operacao = it-nota-fisc.nat-operacao NO-LOCK:
                    IF NOT bf-natur-oper-fut.ind-est-qtd
                    OR SUBSTRING(bf-natur-oper-fut.char-1,1,5) <> "0" THEN DO:
                        {utp/ut-liter.i "Nota_Fiscal_nÆo_‚_uma_remessa_de_entrega_futura" *}
                        ASSIGN c-erro-cabec = RETURN-VALUE.

                        {utp/ut-liter.i "Verifique_se_a_nota_que_est _sendo_devolvida_‚_uma_nota_de_remessa_de_entrega_futura." *}
                        assign c-erro-desc = RETURN-VALUE.

                        /* Quantidade de Saldo na Fatura Insuficiente */
                        {method/svc/errors/inserr.i
                                          &ErrorNumber="17006"
                                          &ErrorType="EMS"
                                          &ErrorSubType="ERROR"
                                          &ErrorParameters="c-erro-cabec + '~~~~':U + c-erro-desc"}
                        undo bloco, return "NOK":U. /* Desfaz o bloco e retorna com erro */

                    END.
                END.
            END.

            /*devolu‡Æo de remessa de faturamento antecipado*/
            /*valida se a nota que est  sendo devolvida ‚ uma remessa de faturamento antecipado*/
            IF l-remessa-fat-antecip
            AND natur-oper.tipo-compra = 3 THEN DO:
                FOR FIRST bf-natur-oper-fut
                    WHERE bf-natur-oper-fut.nat-operacao = it-nota-fisc.nat-operacao NO-LOCK:
                    IF NOT bf-natur-oper-fut.ind-est-qtd
                    OR SUBSTRING(bf-natur-oper-fut.char-1,1,5) <> "1" THEN DO:
                        {utp/ut-liter.i "Nota_Fiscal_nÆo_‚_uma_remessa_de_faturamento_antecipado" *}
                        ASSIGN c-erro-cabec = RETURN-VALUE.

                        {utp/ut-liter.i "Verifique_se_a_nota_que_est _sendo_devolvida_‚_uma_nota_de_remessa_de_faturamento_antecipado." *}
                        assign c-erro-desc = RETURN-VALUE.

                        /* Quantidade de Saldo na Fatura Insuficiente */
                        {method/svc/errors/inserr.i
                                          &ErrorNumber="17006"
                                          &ErrorType="EMS"
                                          &ErrorSubType="ERROR"
                                          &ErrorParameters="c-erro-cabec + '~~~~':U + c-erro-desc"}
                        undo bloco, return "NOK":U. /* Desfaz o bloco e retorna com erro */
                    END.
                end.


            END.



            run findItem ( input it-nota-fisc.it-codigo ).
            assign c-un = item.un.
            /* Calcula indice para conversao da quantidade */
            &if defined (bf_dis_preco_un_med_mult) &then
                assign de-indice = it-nota-fisc.qt-faturada[2] / it-nota-fisc.qt-faturada[1].
            &else
                assign de-indice = if it-nota-fisc.ind-fat-qtfam = no then 1
                                   else it-nota-fisc.qt-faturada[2] / it-nota-fisc.qt-faturada[1].
            &endif


            if it-nota-fisc.ind-fat-qtfam = ? then
                assign c-un = it-nota-fisc.un-fatur[2].

            if not natur-oper.transf
            and (natur-oper.tipo-compra = 3 or natur-oper.tipo-compra = 8) then
                c-un = it-nota-fisc.un-fatur[2].

            /* Se usa m£ltiplas naturezas no recebimento */
            IF  l-mult-natur-receb THEN /* Var def em cd9701.i */
                /* Busca b-natur-oper-fiscal = Natureza fiscal do Item - natureza informada no re1001e2 */
                FIND FIRST b-natur-oper-fiscal WHERE b-natur-oper-fiscal.nat-operacao = tt-item-devol-cli.nat-of NO-LOCK NO-ERROR.

            /* Se nÆo usa multiplas naturezas ou usa mas a nota ‚ antiga (digit. antes de marcar o parƒm.) */
            IF  NOT l-mult-natur-receb OR NOT AVAIL b-natur-oper-fiscal THEN
                /* Busca b-natur-oper-fiscal = Natureza de opera‡Æo da Nota */
                FIND FIRST b-natur-oper-fiscal WHERE b-natur-oper-fiscal.nat-operacao = docum-est.nat-operacao NO-LOCK NO-ERROR.

            create RowObject.
            assign RowObject.cod-emitente           = docum-est.cod-emitente
                   RowObject.serie-docto            = docum-est.serie-docto
                   RowObject.nro-docto              = docum-est.nro-docto
                   RowObject.nat-operacao           = docum-est.nat-operacao
                   RowObject.sequencia              = i-seq-aux
                   RowObject.it-codigo              = it-nota-fisc.it-codigo
                   RowObject.cod-refer              = it-nota-fisc.cod-refer
                   RowObject.serie-comp             = it-nota-fisc.serie
                   RowObject.nro-comp               = it-nota-fisc.nr-nota-fis
                   RowObject.nat-comp               = it-nota-fisc.nat-operacao
                   RowObject.seq-comp               = it-nota-fisc.nr-seq-fat
                   RowObject.nr-pd-seq              = it-nota-fisc.nr-seq-ped
                   RowObject.nr-pedcli              = it-nota-fisc.nr-pedcli
                   RowObject.data-comp              = it-nota-fisc.dt-emis-nota
                   RowObject.baixa-ce               = it-nota-fisc.baixa-estoq
                   RowObject.class-fiscal           = it-nota-fisc.class-fiscal
                   RowObject.un                     = c-un
                   RowObject.quantidade             = tt-item-devol-cli.quant-devol
                   RowObject.qt-do-forn             = RowObject.quantidade * de-indice
                   RowObject.cd-trib-icm            = it-nota-fisc.cd-trib-icm
                   RowObject.cd-trib-ipi            = it-nota-fisc.cd-trib-ipi
                   RowObject.aliquota-ipi           = it-nota-fisc.aliquota-ipi
                   RowObject.aliquota-icm           = it-nota-fisc.aliquota-icm
                   RowObject.preco-total[1]         = tt-item-devol-cli.preco-devol
                   RowObject.preco-unit[1]          = if tt-item-devol-cli.quant-devol = 0 then 0 else (tt-item-devol-cli.preco-devol / tt-item-devol-cli.quant-devol)
                   RowObject.cod-depos              = tt-item-devol-cli.cod-depos
                   RowObject.reabre-pd              = tt-item-devol-cli.reabre-pd
                   RowObject.desconto[1]            = tt-item-devol-cli.vl-desconto
                   RowObject.peso-liquido           = IF it-nota-fisc.qt-faturada[1] <> 0 THEN  (RowObject.quantidade * it-nota-fisc.peso-liq-fat)
                                                      / it-nota-fisc.qt-faturada[1]
                                                      ELSE it-nota-fisc.qt-faturada[1]
                   i-seq-aux                        = i-seq-aux + param-re.inc-seq
                   RowObject.nat-of                 = tt-item-devol-cli.nat-of /* Sempre grava a natureza fiscal do item */
                   RowObject.val-perc-rep-ipi       = natur-oper.perc-red-ipi
                   RowObject.val-perc-red-icms      = it-nota-fisc.perc-red-icm
                   overlay(RowObject.char-2,1,6)    = ""
                   overlay(RowObject.char-2,7,6)    = ""
                   RowObject.log-2                  = it-nota-fisc.ind-icm-ret
                   rowObject.idi-tributac-pis       = int(substring(it-nota-fisc.char-2,96,1))  /* Tributacao PIS     */
                   rowObject.idi-tributac-cofins    = int(substring(it-nota-fisc.char-2,97,1)). /* Tributacao COFINS  */

            RUN piBuscaPisCofins IN h-cdapi995 (INPUT  "it-nota-fisc",
                                                INPUT  ROWID(it-nota-fisc),
                                                INPUT  NO, /* não recalcular e gravar quando já existe na ext-it-nota-fisc */
                                                INPUT  NO,
                                                OUTPUT d-aliq-pis,
                                                OUTPUT d-val-base-pis,
                                                OUTPUT d-val-pis,
                                                OUTPUT d-aliq-cofins,
                                                OUTPUT d-val-base-cofins,
                                                OUTPUT d-val-cofins).

            /**************************
            * PIS/COFINS POR UNIDADE *
            **************************/

            de-valor-un-pis-devol    = IF it-nota-fisc.idi-forma-calc-pis = 2 /* Pis Un Prod */
                                       THEN it-nota-fisc.val-unit-pis         /* Vl Unit Pis*/
                                       ELSE 0.
            de-valor-un-cofins-devol = IF it-nota-fisc.idi-forma-calc-cofins = 2 /* Pis Un Prod */
                                       THEN it-nota-fisc.val-unit-cofins         /* Vl Unit Pis*/
                                       ELSE 0.

            IF de-valor-un-pis-devol <> 0 then
                assign d-aliq-pis = 0.

            IF de-valor-un-cofins-devol <> 0 then
               assign d-aliq-cofins = 0.



            assign rowObject.val-aliq-pis         = d-aliq-pis         /* Aliquota PIS  */
                   rowObject.val-aliq-cofins      = d-aliq-cofins.    /* Aliquota do COFINS */

            RUN grava-aliquotas IN h-cdapi995 (INPUT "item-doc-est",
                                               INPUT RowObject.serie-docto + "/" +
                                                     RowObject.nro-docto + "/" +
                                                     string(RowObject.cod-emitente) + "/" +
                                                     RowObject.nat-operacao + "/" +
                                                     string(RowObject.sequencia),
                                               INPUT d-aliq-pis,
                                               INPUT d-aliq-cofins).

            if substr(b-natur-oper-fiscal.char-1,168,1) <> "S":U then do: /*Deduzir ICMS ST Devol. Cliente*/
                IF NOT VALID-HANDLE (h-reapi412) THEN
                    RUN rep/reapi412.p PERSISTENT SET h-reapi412.
                RUN inicializaAtributos        IN h-reapi412.
                RUN setRowidItemNotaFiscal     IN h-reapi412 (INPUT ROWID(it-nota-fisc)).
                RUN setRowidNaturezaOperFiscal IN h-reapi412 (INPUT ROWID(b-natur-oper-fiscal)).
                RUN setSerieDocto              IN h-reapi412 (INPUT RowObject.serie-docto).
                RUN setNumeroDocto             IN h-reapi412 (INPUT RowObject.nro-docto).
                RUN setEmitenteDocto           IN h-reapi412 (INPUT RowObject.cod-emitente).
                RUN setNatOperacaoDocto        IN h-reapi412 (INPUT RowObject.nat-operacao).
                RUN setCodEstabelDocto         IN h-reapi412 (INPUT docum-est.cod-estabel).
                RUN setICMSRetido              IN h-reapi412 (INPUT RowObject.log-2).
                RUN setQuantidadeItem          IN h-reapi412 (INPUT RowObject.quantidade).
                RUN setSequenciaItem           IN h-reapi412 (INPUT RowObject.sequencia).
                RUN setItem                    IN h-reapi412 (INPUT RowObject.it-codigo).

                RUN buscaIcmsSTSaida           IN h-reapi412.

                IF RETURN-VALUE = "OK" THEN DO:
                    RUN isSaveICMS-STA IN h-reapi412. /* Eh para salvar? */
                    IF RETURN-VALUE = "YES" THEN DO:
                        RUN saveICMS-STA IN h-reapi412. /* Salva */
                        IF RETURN-VALUE = "NOK" THEN DO:
                            RUN getRowErrors IN h-reapi412 (OUTPUT TABLE RowErrors).
                            UNDO bloco, RETURN "NOK":U. /* Desfaz o bloco e retorna */
                        END.
                        ELSE DO:
                            RUN getValBaseSubs IN h-reapi412 (OUTPUT RowObject.base-subs[1]).
                            RUN getValSubs     IN h-reapi412 (OUTPUT RowObject.vl-subs[1]).
                        END.
                    END.
                END.
            end. /*if substr(b-natur-oper-fiscal.char-1,168,1) <> "S"*/

            /* Criacao da nota-fisc-adc para a devolu‡Æo de Exporta‡Æo - NF-e Controle de Exporta‡Æo por item */

             for each bf-nota-fisc-adc-1
                where bf-nota-fisc-adc-1.cod-estab        = it-nota-fisc.cod-estabel
                  and bf-nota-fisc-adc-1.cod-serie        = it-nota-fisc.serie
                  and bf-nota-fisc-adc-1.cod-nota-fisc    = it-nota-fisc.nr-nota-fis
                  and bf-nota-fisc-adc-1.cod-natur-operac = it-nota-fisc.nat-operacao
                  and bf-nota-fisc-adc-1.idi-tip-dado     = 21
                  and bf-nota-fisc-adc-1.num-seq          = it-nota-fisc.nr-seq-fat no-lock:

			     EMPTY TEMP-TABLE tt-nota-fisc-adc.
			     create tt-nota-fisc-adc.
				 assign tt-nota-fisc-adc.cod-estab               = docum-est.cod-estabel
			            tt-nota-fisc-adc.cod-serie               = docum-est.serie-docto
			        	tt-nota-fisc-adc.cod-nota-fisc           = docum-est.nro-docto
			        	tt-nota-fisc-adc.cdn-emitente            = docum-est.cod-emitente
			        	tt-nota-fisc-adc.cod-natur-operac        = docum-est.nat-operacao
			        	tt-nota-fisc-adc.idi-tip-dado            = 21
						tt-nota-fisc-adc.num-seq                 = bf-nota-fisc-adc-1.num-seq
			        	tt-nota-fisc-adc.cod-item                = bf-nota-fisc-adc-1.cod-item
			        	tt-nota-fisc-adc.cod-livre-1             = bf-nota-fisc-adc-1.cod-livre-1
			        	tt-nota-fisc-adc.cod-livre-2             = bf-nota-fisc-adc-1.cod-livre-2
			        	tt-nota-fisc-adc.cod-ser-docto-referado  = bf-nota-fisc-adc-1.cod-ser-docto-referado
			        	tt-nota-fisc-adc.cod-docto-referado      = bf-nota-fisc-adc-1.cod-docto-referado
			        	tt-nota-fisc-adc.cdn-emit-docto-referado = bf-nota-fisc-adc-1.cdn-emit-docto-referado
			        	tt-nota-fisc-adc.cod-livre-4             = bf-nota-fisc-adc-1.cod-livre-4
			        	tt-nota-fisc-adc.num-livre-1             = bf-nota-fisc-adc-1.num-livre-1
			        	tt-nota-fisc-adc.cod-livre-3             = bf-nota-fisc-adc-1.cod-livre-3
			        	tt-nota-fisc-adc.val-livre-1             = bf-nota-fisc-adc-1.val-livre-1
			        	tt-nota-fisc-adc.num-livre-2             = bf-nota-fisc-adc-1.num-livre-2.

                 if not valid-handle(h-bodi515) then
                 RUN dibo/bodi515.p PERSISTENT SET h-bodi515.

				 RUN openQueryStatic IN h-bodi515 (INPUT "Main":U).

				 IF AVAIL tt-nota-fisc-adc THEN DO:
                     RUN goToKey IN h-bodi515 (input tt-nota-fisc-adc.cod-estab,
                                               input tt-nota-fisc-adc.cod-serie,
                                               input tt-nota-fisc-adc.cod-nota-fisc,
                                               input tt-nota-fisc-adc.cdn-emitente,
                                               input tt-nota-fisc-adc.cod-natur-operac,
                                               input tt-nota-fisc-adc.idi-tip-dado,
                                               input tt-nota-fisc-adc.num-seq).

                     IF RETURN-VALUE = "NOK":U THEN do:
                         create nota-fisc-adc.
                         assign nota-fisc-adc.cod-estab               = tt-nota-fisc-adc.cod-estab
                                nota-fisc-adc.cod-serie               = tt-nota-fisc-adc.cod-serie
                                nota-fisc-adc.cod-nota-fisc           = tt-nota-fisc-adc.cod-nota-fisc
                                nota-fisc-adc.cdn-emitente            = INT(STRING(tt-nota-fisc-adc.num-seq) + STRING(i-seq-exp))
                                nota-fisc-adc.cod-natur-operac        = tt-nota-fisc-adc.cod-natur-operac
                                nota-fisc-adc.idi-tip-dado            = tt-nota-fisc-adc.idi-tip-dado
                                nota-fisc-adc.num-seq                 = tt-nota-fisc-adc.num-seq
                                nota-fisc-adc.cod-item                = tt-nota-fisc-adc.cod-item
                                nota-fisc-adc.cod-livre-1             = tt-nota-fisc-adc.cod-livre-1
                                nota-fisc-adc.cod-livre-2             = tt-nota-fisc-adc.cod-livre-2
                                nota-fisc-adc.cod-ser-docto-referado  = tt-nota-fisc-adc.cod-ser-docto-referado
                                nota-fisc-adc.cod-docto-referado      = tt-nota-fisc-adc.cod-docto-referado
                                nota-fisc-adc.cdn-emit-docto-referado = tt-nota-fisc-adc.cdn-emit-docto-referado
                                nota-fisc-adc.cod-livre-4             = tt-nota-fisc-adc.cod-livre-4
                                nota-fisc-adc.num-livre-1             = tt-nota-fisc-adc.num-livre-1
                                nota-fisc-adc.cod-livre-3             = tt-nota-fisc-adc.cod-livre-3
                                nota-fisc-adc.val-livre-1             = tt-nota-fisc-adc.val-livre-1
                                nota-fisc-adc.num-livre-2             = tt-nota-fisc-adc.num-livre-2
                                i-seq-exp                             = i-seq-exp + param-re.inc-seq.
                    end.

                    else do:
                        for each nota-fisc-adc
                           where nota-fisc-adc.cod-estab         = tt-nota-fisc-adc.cod-estab
                             and nota-fisc-adc.cod-serie         = tt-nota-fisc-adc.cod-serie
                             and nota-fisc-adc.cod-nota-fisc     = tt-nota-fisc-adc.cod-nota-fisc
                             and nota-fisc-adc.cdn-emitente      = tt-nota-fisc-adc.cdn-emitente
                             and nota-fisc-adc.cod-natur-operac  = tt-nota-fisc-adc.cod-natur-operac
                             and nota-fisc-adc.idi-tip-dado      = tt-nota-fisc-adc.idi-tip-dado
                             and nota-fisc-adc.num-seq           = tt-nota-fisc-adc.num-seq exclusive-lock:

                            assign  nota-fisc-adc.cdn-emitente            = INT(STRING(tt-nota-fisc-adc.num-seq) + STRING(i-seq-exp))
                                    nota-fisc-adc.cod-item                = tt-nota-fisc-adc.cod-item
                                    nota-fisc-adc.cod-livre-1             = tt-nota-fisc-adc.cod-livre-1
                                    nota-fisc-adc.cod-livre-2             = tt-nota-fisc-adc.cod-livre-2
                                    nota-fisc-adc.cod-ser-docto-referado  = tt-nota-fisc-adc.cod-ser-docto-referado
                                    nota-fisc-adc.cod-docto-referado      = tt-nota-fisc-adc.cod-docto-referado
                                    nota-fisc-adc.cdn-emit-docto-referado = tt-nota-fisc-adc.cdn-emit-docto-referado
                                    nota-fisc-adc.cod-livre-4             = tt-nota-fisc-adc.cod-livre-4
                                    nota-fisc-adc.num-livre-1             = tt-nota-fisc-adc.num-livre-1
                                    nota-fisc-adc.cod-livre-3             = tt-nota-fisc-adc.cod-livre-3
                                    nota-fisc-adc.val-livre-1             = tt-nota-fisc-adc.val-livre-1
                                    nota-fisc-adc.num-livre-2             = tt-nota-fisc-adc.num-livre-2
                                    i-seq-exp                             = i-seq-exp + param-re.inc-seq.
                        end.
                    end.
                 END.
			 end.

             if valid-handle(h-bodi515) then
                delete procedure h-bodi515.
             assign h-bodi515 = ?.

            /*Fim da cria‡Æo da nota-fisc-adc para devolu‡Æo de exporta‡Æo*/

            find first nota-fiscal no-lock
                 where nota-fiscal.cod-estabel = it-nota-fisc.cod-estabel
                   and nota-fiscal.serie       = it-nota-fisc.serie
                   and nota-fiscal.nr-nota-fis = it-nota-fisc.nr-nota-fis no-error.

            /* Copia das informa‡äes adicionais do nota e dos itens da nota de saida */
            FOR EACH item-nf-adc NO-LOCK
               WHERE item-nf-adc.cod-estab        = it-nota-fisc.cod-estabel
                 AND item-nf-adc.cod-serie        = it-nota-fisc.serie
                 AND item-nf-adc.cod-nota-fisc    = it-nota-fisc.nr-nota-fis
                 AND item-nf-adc.cdn-emitente     = nota-fiscal.cod-emitente
                 AND item-nf-adc.cod-natur-operac = it-nota-fisc.nat-operacao
                 AND item-nf-adc.num-seq          = it-nota-fisc.nr-seq-fat
                 AND item-nf-adc.num-seq-item-nf  = it-nota-fisc.nr-seq-fat
                 AND item-nf-adc.cod-item         = it-nota-fisc.it-codigo :

                IF item-nf-adc.idi-tip-dado <> 24 AND item-nf-adc.idi-tip-dado <> 25 AND item-nf-adc.idi-tip-dado <> 39 THEN NEXT.

                EMPTY TEMP-TABLE tt-item-nf-adc.
                CREATE tt-item-nf-adc.
                ASSIGN tt-item-nf-adc.cod-estab        = docum-est.cod-estabel
                       tt-item-nf-adc.cod-serie        = RowObject.serie-docto
                       tt-item-nf-adc.cod-nota-fisc    = RowObject.nro-docto
                       tt-item-nf-adc.cdn-emitente     = RowObject.cod-emitente
                       tt-item-nf-adc.cod-natur-operac = (IF RowObject.nat-of <> "" THEN RowObject.nat-of ELSE RowObject.nat-operacao)
                       tt-item-nf-adc.num-seq          = RowObject.sequencia
                       tt-item-nf-adc.num-seq-item-nf  = RowObject.sequencia
                       tt-item-nf-adc.cod-item         = RowObject.it-codigo.

                CASE item-nf-adc.idi-tip-dado:
                    /* NT2015/003 - Copia das informa‡äes do ICMS de Partilha - DIFAL */
                    WHEN 24 THEN DO:
                        ASSIGN tt-item-nf-adc.idi-tip-dado = 24
                               tt-item-nf-adc.cod-livre-1  = item-nf-adc.cod-livre-1   /*Aliq UF Dest*/
                               tt-item-nf-adc.cod-livre-2  = item-nf-adc.cod-livre-2   /*Aliq Inter*/
                               tt-item-nf-adc.val-livre-2  = item-nf-adc.val-livre-2   /*% ICMS FCP*/
                               tt-item-nf-adc.num-livre-1  = item-nf-adc.num-livre-1   /*ICMSInterPart*/
                               tt-item-nf-adc.val-livre-1  = ROUND((item-nf-adc.val-livre-1 / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2)  /*Vl BC UF Dest*/
                               tt-item-nf-adc.cod-livre-4  = STRING(ROUND((DEC(item-nf-adc.cod-livre-4) / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2))  /*Vl ICMS FCP*/
                               tt-item-nf-adc.val-livre-3  = ROUND((item-nf-adc.val-livre-4 / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2)   /* VL ICMS UF Dest inverte Devol */
                               tt-item-nf-adc.val-livre-4  = ROUND((item-nf-adc.val-livre-3 / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2).  /* VL ICMS UF Orig inverte Devol */

                        ASSIGN OVERLAY(tt-item-nf-adc.cod-livre-3,1,2)   = SUBSTRING(item-nf-adc.cod-livre-3,3,2)    /* Devolucao UF Destino passa p/ Origem   */
                               OVERLAY(tt-item-nf-adc.cod-livre-3,3,2)   = SUBSTRING(item-nf-adc.cod-livre-3,1,2)    /* Devolucao UF Origem passa p/ Destino   */
                               OVERLAY(tt-item-nf-adc.cod-livre-3,5,100) = SUBSTRING(item-nf-adc.cod-livre-3,5,100)  /* Grava os demais parametros desse campo */
                               OVERLAY(tt-item-nf-adc.cod-livre-3,41,20) = STRING(ROUND((DEC(TRIM(SUBSTRING(item-nf-adc.cod-livre-3,41,20)))/ it-nota-fisc.qt-faturada[1] * RowObject.quantidade),2)). /* Vl BC FCP UF Dest*/
                    END.
                    /* Copia das informa‡äes de FCP */
                    WHEN 25 THEN DO:
                        ASSIGN tt-item-nf-adc.idi-tip-dado = 25
                               tt-item-nf-adc.log-livre-1  = item-nf-adc.log-livre-1  /*YES = FCP majorou ST, NO = FCP majorou ICMS*/
                               tt-item-nf-adc.log-livre-2  = item-nf-adc.log-livre-2  /*Quando o FCP e FCP ST for junto no mesmo item da nota ser  = ?*/

                               tt-item-nf-adc.val-livre-1  = ROUND((item-nf-adc.val-livre-1 / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2) /*Base FCP ST*/
                               tt-item-nf-adc.val-livre-2  = item-nf-adc.val-livre-2  /*Aliquota FCP ST*/
                               tt-item-nf-adc.cod-livre-4  = STRING(ROUND((DEC(item-nf-adc.cod-livre-4) / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2)) /*Valor FCP ST*/
                               tt-item-nf-adc.num-livre-1  = item-nf-adc.num-livre-1  /*Cod. mensagem FCP ST observ. nota*/

                               tt-item-nf-adc.val-livre-3 = ROUND((item-nf-adc.val-livre-3 / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2) /*Base FCP*/
                               tt-item-nf-adc.val-livre-4 = item-nf-adc.val-livre-4   /*Aliquota FCP*/
                               tt-item-nf-adc.cod-livre-3 = STRING(ROUND((DEC(item-nf-adc.cod-livre-3) / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2)) /*Valor FCP*/
                               tt-item-nf-adc.num-livre-2 = item-nf-adc.num-livre-2.  /*Cod. mensagem FCP    */

                        IF DEC(SUBSTRING(item-nf-adc.cod-livre-2,1,20)) > 0 THEN     /*Valor FCP Diferido*/
                            ASSIGN OVERLAY(tt-item-nf-adc.cod-livre-2,1,20) = STRING(ROUND((DEC(SUBSTRING(item-nf-adc.cod-livre-2,1,20)) / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2)).   /*Valor FCP Diferido*/

                        IF DEC(SUBSTRING(item-nf-adc.cod-livre-2,21,8)) > 0 THEN     /*Percentual FCP Diferido*/
                            ASSIGN OVERLAY(tt-item-nf-adc.cod-livre-2,21,8) = SUBSTRING(item-nf-adc.cod-livre-2,21,8).   /*Percentual FCP Diferido*/

                        ASSIGN OVERLAY(RowObject.char-2,880,8)  = STRING(tt-item-nf-adc.val-livre-2) /*Aliquota FCP*/
                               OVERLAY(RowObject.char-2,888,20) = STRING(tt-item-nf-adc.cod-livre-4) /*Valor FCP*/.

                        if item-nf-adc.log-livre-1 and /*FCP Majorou ST*/
                           substr(b-natur-oper-fiscal.char-1,168,1) = "S":U then /*Deduzir ICMS ST Devol. Cliente*/
                             assign tt-item-nf-adc.cod-livre-4       = STRING(0)
                                    OVERLAY(RowObject.char-2,888,20) = STRING(0).

                        EMPTY TEMP-TABLE tt-ext-item-doc-est.
                        CREATE tt-ext-item-doc-est.
                        ASSIGN tt-ext-item-doc-est.serie-docto  = RowObject.serie-docto
                               tt-ext-item-doc-est.nro-docto    = RowObject.nro-docto
                               tt-ext-item-doc-est.cod-emitente = RowObject.cod-emitente
                               tt-ext-item-doc-est.nat-operacao = RowObject.nat-operacao
                               tt-ext-item-doc-est.sequencia    = RowObject.sequencia
                               tt-ext-item-doc-est.cod-param    = "fcp":U
                               tt-ext-item-doc-est.val-livre-1  = tt-item-nf-adc.val-livre-3        /*Base FCP*/
                               tt-ext-item-doc-est.val-livre-2  = tt-item-nf-adc.val-livre-4        /*Aliq FCP*/
                               tt-ext-item-doc-est.val-livre-3  = DEC(tt-item-nf-adc.cod-livre-3).  /*Valor FCP*/

                        IF AVAIL b-natur-oper-fiscal AND substr(b-natur-oper-fiscal.char-1,168,1) <> "S":U THEN DO:

                           ASSIGN tt-ext-item-doc-est.val-livre-4  = tt-item-nf-adc.val-livre-1        /*Base FCP ST*/
                                  tt-ext-item-doc-est.val-livre-5  = tt-item-nf-adc.val-livre-2        /*Aliq FCP ST*/
                                  tt-ext-item-doc-est.val-livre-6  = DEC(tt-item-nf-adc.cod-livre-4).  /*Valor FCP ST*/
                        END.

                        IF DEC(SUBSTRING(tt-item-nf-adc.cod-livre-2,1,20)) > 0 THEN     /*Valor FCP Diferido*/
                            ASSIGN OVERLAY(tt-ext-item-doc-est.cod-livre-1,1,20) = SUBSTRING(tt-item-nf-adc.cod-livre-2,1,20).   /*Valor FCP Diferido*/

                        IF DEC(SUBSTRING(tt-item-nf-adc.cod-livre-2,21,8)) > 0 THEN     /*Percentual FCP Diferido*/
                            ASSIGN OVERLAY(tt-ext-item-doc-est.cod-livre-1,21,8) = SUBSTRING(tt-item-nf-adc.cod-livre-2,21,8).   /*Percentual FCP Diferido*/

                        /*1-FCP Normal, 2-FCP Subst. Trib., 3-FCP Subst. Trib. Antecip*/
                        ASSIGN tt-ext-item-doc-est.num-livre-2 = 1.

                        IF AVAIL b-natur-oper-fiscal AND b-natur-oper-fiscal.subs-trib THEN
                           ASSIGN tt-ext-item-doc-est.num-livre-2 = 2.
                        ELSE IF AVAIL b-natur-oper-fiscal AND
                                (b-natur-oper-fiscal.log-contrib-st-antec or b-natur-oper-fiscal.log-icms-substto-antecip) AND
                                NOT b-natur-oper-fiscal.terceiros THEN
                          ASSIGN tt-ext-item-doc-est.num-livre-2 = 3.

                        IF  NOT VALID-HANDLE(h-boin01017) THEN
                           RUN inbo/boin01017.p PERSISTENT SET h-boin01017.
                        RUN openQueryStatic IN h-boin01017 (INPUT "Main":U) NO-ERROR.

                        RUN goToKey IN h-boin01017 (INPUT RowObject.serie-docto,
                                                    INPUT RowObject.nro-docto,
                                                    INPUT RowObject.cod-emitente,
                                                    INPUT RowObject.nat-operacao,
                                                    INPUT RowObject.sequencia,
                                                    INPUT "fcp":U).

                        IF RETURN-VALUE = "OK":U THEN DO:
                           RUN emptyRowErrors IN h-boin01017.
                           RUN setRecord IN h-boin01017 (INPUT TABLE tt-ext-item-doc-est).
                           RUN updateRecord IN h-boin01017.
                        END.
                        ELSE DO:
                           RUN emptyRowErrors IN h-boin01017.
                           RUN setRecord IN h-boin01017 (INPUT TABLE tt-ext-item-doc-est).
                           RUN createRecord IN h-boin01017.
                        END.

                        IF VALID-HANDLE(h-boin01017) THEN DO:
                           DELETE PROCEDURE h-boin01017.
                           ASSIGN h-boin01017 = ?.
                        END.

                    END.
                    WHEN 39 THEN DO:
                        ASSIGN tt-item-nf-adc.idi-tip-dado = 39
                               tt-item-nf-adc.cod-livre-1  = item-nf-adc.cod-livre-1   /*fundo*/
                               tt-item-nf-adc.val-livre-1  = ROUND((item-nf-adc.val-livre-1 / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2)    /*base fundo*/
                               tt-item-nf-adc.val-livre-2  = item-nf-adc.val-livre-2                                                                    /*% fundo*/
                               tt-item-nf-adc.val-livre-3  = ROUND((item-nf-adc.val-livre-3 / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2).  /*Valor fundo*/
                    END.
                END CASE.

                IF NOT VALID-HANDLE(h-bodi516) THEN
                   RUN dibo/bodi516.p PERSISTENT SET h-bodi516.
                RUN openQueryStatic IN h-bodi516 (INPUT "Main":U).
                RUN goToKey IN h-bodi516 (INPUT docum-est.cod-estabel,
                                          INPUT tt-item-nf-adc.cod-serie,
                                          INPUT tt-item-nf-adc.cod-nota-fisc,
                                          INPUT tt-item-nf-adc.cdn-emitente,
                                          INPUT tt-item-nf-adc.cod-natur-operac,
                                          INPUT tt-item-nf-adc.idi-tip-dado, /*24-Difal ou 25-FCP*/
                                          INPUT tt-item-nf-adc.num-seq,
                                          INPUT tt-item-nf-adc.num-seq-item-nf,
                                          INPUT tt-item-nf-adc.cod-item).

                IF RETURN-VALUE = "NOK":U THEN DO:
                   RUN setRecord IN h-bodi516 (INPUT TABLE tt-item-nf-adc).
                   RUN emptyRowErrors IN h-bodi516.
                   RUN createRecord IN h-bodi516.
                END.
                ELSE DO:
                   RUN setRecord IN h-bodi516 (INPUT TABLE tt-item-nf-adc).
                   RUN emptyRowErrors IN h-bodi516.
                   RUN updateRecord IN h-bodi516.
                END.

                IF VALID-HANDLE(h-bodi516) THEN
                    DELETE PROCEDURE h-bodi516.
                ASSIGN h-bodi516 = ?.
            END.

            if l-NT2024002 then do:
                IF NOT VALID-HANDLE(h-re1910) THEN
                    RUN rep/re1910.p PERSISTENT SET h-re1910 (INPUT  docum-est.cod-estabel,
                                                            INPUT  RowObject.serie-docto,
                                                            INPUT  RowObject.nro-docto,
                                                            INPUT  RowObject.cod-emitente,
                                                            INPUT  (IF RowObject.nat-of <> ""
                                                                    AND (docum-est.cod-finalidade <> "5" OR docum-est.cod-tipo-nf-cred-deb <> "3")
                                                                    THEN RowObject.nat-of ELSE RowObject.nat-operacao),
                                                            INPUT  RowObject.it-codigo,
                                                            INPUT  RowObject.serie-comp,
                                                            INPUT  RowObject.nro-comp,
                                                            INPUT  RowObject.nat-comp,
                                                            INPUT  '1',
                                                            OUTPUT TABLE rowErrors).

                run verifica-referencia-por-item in h-re1910 (OUTPUT l-ref-por-item).

                IF VALID-HANDLE(h-re1910) THEN do:
                    DELETE PROCEDURE h-re1910.
                    ASSIGN h-re1910 = ?.
                end.
            end.
            /*Cria referˆncia por item - DFeReferenciado*/
            IF l-NT2024002 AND
              ((l-ref-por-item) or
              (CAN-FIND(FIRST funcao NO-LOCK
                          WHERE funcao.cd-funcao = "RE-REF-POR-IT-NFD":U
                            AND funcao.ativo) AND
                docum-est.cod-finalidade <> "5") OR
               (docum-est.cod-finalidade = "5" AND cod-tipo-nf-cred-deb = "6")) THEN DO:
				IF NOT VALID-HANDLE(h-reapi434) THEN
					RUN rep/reapi434.p PERSISTENT SET h-reapi434.

				RUN cria-referencia-por-item IN h-reapi434 (INPUT  docum-est.cod-estabel,
														    INPUT  RowObject.serie-docto,
															INPUT  RowObject.nro-docto,
															INPUT  RowObject.cod-emitente,
															INPUT  (IF RowObject.nat-of <> "" THEN RowObject.nat-of ELSE RowObject.nat-operacao),
															INPUT  RowObject.it-codigo,
															INPUT  RowObject.sequencia,
															INPUT  RowObject.serie-comp,
															INPUT  RowObject.nro-comp,
															INPUT  RowObject.nat-comp,
															INPUT  RowObject.seq-comp,
                                                            INPUT  0,
															INPUT  1, /*Devolu‡Æo de cliente*/
															OUTPUT TABLE rowErrors).

                IF VALID-HANDLE(h-reapi434) THEN DO:
                    DELETE PROCEDURE h-reapi434.
                    ASSIGN h-reapi434 = ?.
                END.

            END.

			/* Tipo de Controle Debito Direto ou Fisico */
            if  can-do("1,4", string(item.tipo-contr)) then do:
                if  it-nota-fisc.ct-cuscon <> " " then do:
                    assign RowObject.ct-codigo = it-nota-fisc.ct-cuscon
                           RowObject.sc-codigo = it-nota-fisc.sc-cuscon.
                end.
                else do:
                    assign RowObject.ct-codigo      = item.ct-codigo
                           RowObject.sc-codigo      = item.sc-codigo.
                end.
            end.

            /*Unidade de Neg¢cio*/
            assign RowObject.cod-unid-negoc = it-nota-fisc.cod-unid-negoc.

            find nar-it-nota
                where nar-it-nota.cod-estabel   = it-nota-fisc.cod-estabel
                  and nar-it-nota.serie         = it-nota-fisc.serie
                  and nar-it-nota.nr-nota-fis   = it-nota-fisc.nr-nota-fis
                  and nar-it-nota.nr-sequencia  = it-nota-fisc.nr-seq-fat
                  and nar-it-nota.it-codigo     = it-nota-fisc.it-codigo
                no-lock no-error.


            if  avail nar-it-nota then
                assign RowObject.narrativa = nar-it-nota.narrativa.

            assign l-cria-rat-lote = NO.

            {method/svc/custom/custom.i &Event = "CreateItemOfNotaFiscal"}

            IF l-NT2024002 THEN DO:
                RUN copiarInfCBSIBSNFOrig(INPUT piHboin090).
            END.

            run emptyRowErrors.
            run createRecord.  /* Cria tabela item-doc-est */

            if  return-value = "NOK":U then do:
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-a-sequencia AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "A_sequˆncia" *}
                ASSIGN c-lbl-liter-a-sequencia = TRIM(RETURN-VALUE).
                {method/svc/errors/inserr.i
                                    &ErrorNumber="6470" /* &1 esta com problemas. */
                                    &ErrorType="EMS"
                                    &ErrorSubType="ERROR"
                                    &ErrorParameters="c-lbl-liter-a-sequencia + ' ' + string(RowObject.seq-comp)"}

                undo bloco, return "NOK":U. /* Desfaz o bloco e retorna com erro */
            end.

            /*****************************************
            ** Nova Funcionalidade Controle Seriais **
            *****************************************/
            IF l-funcao-spp-seriais-nf THEN DO:
                RUN associaSerialNFaDevolucao IN h-boin735 (INPUT ROWID(it-nota-fisc),
                                                            INPUT RowObject.r-rowid).
            END.

            RUN findItem (INPUT it-nota-fisc.it-codigo).

            /* Cria a tabela rat-lote de acordo com a nota de saida para */
            /* itens controlados no estoque por lote ou referencia.      */
            assign l-configurado = avail item
                                   and (   item.politica    = 5   /* configurado */
                                        or item.politica    = 6). /* composto    */
            if (RowObject.baixa-ce
            or  ( not RowObject.baixa-ce
                  and l-configurado ))
            and RowObject.quantidade <> 0 then do:

                run createRatLoteDevolTerc ( it-nota-fisc.qt-faturada[1] ).

                if  return-value = "NOK":U then do:
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-a-sequencia-2 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "A_sequˆncia" *}
                    ASSIGN c-lbl-liter-a-sequencia-2 = TRIM(RETURN-VALUE).
                    {method/svc/errors/inserr.i
                                        &ErrorNumber="6470" /* &1 esta com problemas. */
                                        &ErrorType="EMS"
                                        &ErrorSubType="ERROR"
                                        &ErrorParameters="c-lbl-liter-a-sequencia-2 + ' ' + string(RowObject.seq-comp)"}

                    undo bloco, return "NOK":U. /* Desfaz o bloco e retorna com erro */
                end.
            end.
        end.
    end.

    /* A variÿvel i-totaliza indica o que documento deverÿ ser totalizado */
    run getTotalizaNota ( 0 ).

    RUN copiaEnteOperGovNForig IN piHboin090 (INPUT i-cod-emitente,
                                              INPUT c-serie-docto,
                                              INPUT c-nro-docto,
                                              INPUT c-nat-operacao).

    /* Calculo do ICMS, ICMS Subst, ICMS Complementar e totaliza a NF */
    run TransferTotalItensNota ( i-cod-emitente,
                                 c-serie-docto,
                                 c-nro-docto,
                                 c-nat-operacao ).

    /* seta o valor "no" para que ao importar os itens de uma nota de compra
       via EDI, as informa‡äes default de dep¢sito, localiza‡Æo e c¢digo de
       referˆncia sejam sugeridas para o item. */
    assign l-nf-transf-devol-ret = no
           l-cria-rat-lote = yes.

    return "OK":U.

    FINALLY:
        IF VALID-HANDLE(h-reapi412) THEN DO:
            DELETE PROCEDURE h-reapi412 NO-ERROR.
            ASSIGN h-reapi412 = ?.
        END.
        IF VALID-HANDLE(h-boin735) THEN DO:
            DELETE PROCEDURE h-boin735 NO-ERROR.
            ASSIGN h-boin735 = ?.
        END.
    END.

END PROCEDURE.

PROCEDURE copiarInfCBSIBSNFOrig:
    DEF INPUT PARAM piHboin090    AS HANDLE                       NO-UNDO.

    DEF VAR c-estabel             AS CHARACTER NO-UNDO.
    DEF VAR iSeqItemNfOrig        LIKE item-doc-est.sequencia      NO-UNDO.

    DEFINE BUFFER b-natur-oper-fiscal FOR natur-oper.

    IF l-mult-natur-receb THEN
       FIND FIRST b-natur-oper-fiscal WHERE b-natur-oper-fiscal.nat-operacao = (if RowObject.nat-of <> "" then RowObject.nat-of else RowObject.nat-operacao) NO-LOCK NO-ERROR.
    ELSE
       FIND FIRST b-natur-oper-fiscal WHERE b-natur-oper-fiscal.nat-operacao = docum-est.nat-operacao NO-LOCK NO-ERROR.

    run getFatAntecipEntFutura( INPUT RowObject.nat-operacao,
                               OUTPUT l-fatura-fat-antecip,
                               OUTPUT l-remessa-fat-antecip,
                               OUTPUT l-fatura-ent-futura,
                               OUTPUT l-remessa-ent-futura).

    IF  AVAIL b-natur-oper-fiscal AND b-natur-oper-fiscal.tp-oper-terc = 4 THEN
        RETURN "OK":U.

    IF (l-multa-juros AND RowObject.nro-comp <> "")   /*nÆo ‚ devolu‡Æo de cliente*/
    THEN DO:

        FOR EACH item-doc-est-tribut NO-LOCK
           WHERE item-doc-est-tribut.cod-serie-docto  = RowObject.serie-comp
             AND item-doc-est-tribut.cod-num-docto    = RowObject.nro-comp
             AND item-doc-est-tribut.cdn-emitente     = RowObject.cod-emitente
             AND item-doc-est-tribut.cod-natur-operac = RowObject.nat-comp
             AND item-doc-est-tribut.num-seq          = RowObject.seq-comp :

            CASE item-doc-est-tribut.nom-trib:
                WHEN rep.imp.Imposto:CBS THEN DO:

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:C-CLASS-TRIB THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:C-CLASS-TRIB,         INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:CST THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:CST,                  INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:C-CLASS-TRIB-REG THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:C-CLASS-TRIB-REG,     INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:CST-REG THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:CST-REG,              INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:C-CLASS-CP THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:C-CLASS-CP,           INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQUOTA THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQUOTA,             INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-RED THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-RED,             INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-EFETIVA THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-EFETIVA,         INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQUOTA-REG THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQUOTA-REG,         INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-RED-REG THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-RED-REG,         INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-EFETIVA-REG THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-EFETIVA-REG,     INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:PERC-DIFER THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:PERC-DIFER,           INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:PERC-CP THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:PERC-CP,              INPUT   item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo = AtributoImposto:PROCESSO-SUFRAMA THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:PROCESSO-SUFRAMA,     INPUT   item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo = AtributoImposto:ALIQ-EFETIVA-ALCZFM THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-EFETIVA-ALCZFM,  INPUT   item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:PERC-RED-GOV THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:PERC-RED-GOV,         INPUT   item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-GOV THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-GOV,             INPUT   item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-EFETIVA-GOV THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-EFETIVA-GOV,     INPUT   item-doc-est-tribut.cod-conteudo).
                END.
                WHEN  rep.imp.Imposto:IBS-UF THEN DO:

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:C-CLASS-TRIB THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:C-CLASS-TRIB,      INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:CST THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:CST,               INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:C-CLASS-TRIB-REG THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:C-CLASS-TRIB-REG,  INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:CST-REG THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:CST-REG,           INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:C-CLASS-CP THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:C-CLASS-CP,        INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQUOTA THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQUOTA,          INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-RED THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-RED,          INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-EFETIVA THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-EFETIVA,      INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQUOTA-REG THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQUOTA-REG,      INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-RED-REG THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-RED-REG,      INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-EFETIVA-REG THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-EFETIVA-REG,  INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:PERC-DIFER THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:PERC-DIFER,        INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:PERC-CP THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:PERC-CP,           INPUT   item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:PERC-RED-GOV THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:PERC-RED-GOV,      INPUT   item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-GOV THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-GOV,          INPUT   item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-EFETIVA-GOV THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-EFETIVA-GOV,  INPUT   item-doc-est-tribut.cod-conteudo).
                END.
                WHEN  rep.imp.Imposto:IBS-MUN THEN DO:
                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:C-CLASS-TRIB THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:C-CLASS-TRIB,     INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:CST THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:CST,              INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:C-CLASS-TRIB-REG THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:C-CLASS-TRIB-REG, INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:CST-REG THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:CST-REG,          INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQUOTA THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQUOTA,         INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-RED THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQ-RED,         INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-EFETIVA THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQ-EFETIVA,     INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQUOTA-REG THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQUOTA-REG,      INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-RED-REG THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQ-RED-REG,      INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-EFETIVA-REG THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQ-EFETIVA-REG,  INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:PERC-DIFER THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:PERC-DIFER,        INPUT  item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:PERC-RED-GOV THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:PERC-RED-GOV,      INPUT   item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-GOV THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQ-GOV,          INPUT   item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-EFETIVA-GOV THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQ-EFETIVA-GOV,  INPUT   item-doc-est-tribut.cod-conteudo).
                END.

                WHEN rep.imp.Imposto:IS THEN DO:

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:C-CLASS-TRIB THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:C-CLASS-TRIB,     INPUT item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:CST THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:CST,              INPUT item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQUOTA THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:ALIQUOTA,         INPUT item-doc-est-tribut.cod-conteudo).

                   IF item-doc-est-tribut.cod-campo  = AtributoImposto:ALIQ-ESPEC-UN THEN
                      RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:ALIQ-ESPEC-UN,    INPUT item-doc-est-tribut.cod-conteudo).
                END.

            END CASE.
        END.
    END.
    ELSE DO:
        IF AVAIL b-natur-oper-fiscal AND b-natur-oper-fiscal.transf then
            ASSIGN c-estabel = docum-est.estab-de-or.
        ELSE
            ASSIGN c-estabel = docum-est.cod-estabel.

        FOR EACH  it-nota-fisc-trib NO-LOCK
            WHERE it-nota-fisc-trib.cod-estabel = c-estabel
              AND it-nota-fisc-trib.serie       = RowObject.serie-comp
              AND it-nota-fisc-trib.nr-nota-fis = RowObject.nro-comp
              AND it-nota-fisc-trib.nr-seq-fat  = RowObject.seq-comp
              AND it-nota-fisc-trib.it-codigo   = RowObject.it-codigo:

            CASE it-nota-fisc-trib.tip-tributo:
                WHEN 1 THEN DO:  /*CBS*/
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:C-CLASS-TRIB,     INPUT it-nota-fisc-trib.cod-class-trib).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:CST,              INPUT it-nota-fisc-trib.cod-cst).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:C-CLASS-CP,       INPUT it-nota-fisc-trib.cod-clas-cred-presum).

                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQUOTA,         INPUT STRING(it-nota-fisc-trib.aliq-trib)).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-RED,         INPUT STRING(it-nota-fisc-trib.perc-red-aliq)).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-EFETIVA,     INPUT STRING(it-nota-fisc-trib.aliq-efetiva)).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:PERC-DIFER,       INPUT STRING(it-nota-fisc-trib.perc-difer)).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:PERC-CP,          INPUT STRING(it-nota-fisc-trib.perc-cred-presum)).

                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:PROCESSO-SUFRAMA,    INPUT string(it-nota-fisc-trib.proces-suframa)).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-EFETIVA-ALCZFM, INPUT STRING(it-nota-fisc-trib.perc-efet-alczfm)).

                   IF it-nota-fisc-trib.log-compra-gov THEN DO:
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:PERC-RED-GOV,     INPUT STRING(it-nota-fisc-trib.perc-red-aliq-gov)).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-GOV,         INPUT STRING(it-nota-fisc-trib.aliq-cheia-regul)).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-EFETIVA-GOV, INPUT STRING(it-nota-fisc-trib.aliq-regul)).
                   END.
                   ELSE DO:
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:C-CLASS-TRIB-REG, INPUT it-nota-fisc-trib.cod-class-trib-regul).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:CST-REG,          INPUT it-nota-fisc-trib.cod-cst-regul).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQUOTA-REG,     INPUT STRING(it-nota-fisc-trib.aliq-cheia-regul)).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-RED-REG,     INPUT STRING(it-nota-fisc-trib.perc-red-aliq-regul)).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, INPUT AtributoImposto:ALIQ-EFETIVA-REG, INPUT STRING(it-nota-fisc-trib.aliq-regul)).
                   END.
                END.
                WHEN 2 THEN DO: /*IBS UF*/
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:C-CLASS-TRIB,     INPUT it-nota-fisc-trib.cod-class-trib).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:CST,              INPUT it-nota-fisc-trib.cod-cst).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:C-CLASS-CP,       INPUT it-nota-fisc-trib.cod-clas-cred-presum).

                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQUOTA,         INPUT STRING(it-nota-fisc-trib.aliq-trib)).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-RED,         INPUT STRING(it-nota-fisc-trib.perc-red-aliq)).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-EFETIVA,     INPUT STRING(it-nota-fisc-trib.aliq-efetiva)).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:PERC-DIFER,       INPUT STRING(it-nota-fisc-trib.perc-difer)).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:PERC-CP,          INPUT STRING(it-nota-fisc-trib.perc-cred-presum)).

                   IF it-nota-fisc-trib.log-compra-gov THEN DO:
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:PERC-RED-GOV,     INPUT STRING(it-nota-fisc-trib.perc-red-aliq-gov)).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-GOV,         INPUT STRING(it-nota-fisc-trib.aliq-cheia-regul)).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-EFETIVA-GOV, INPUT STRING(it-nota-fisc-trib.aliq-regul)).
                   END.
                   ELSE DO:
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:C-CLASS-TRIB-REG, INPUT it-nota-fisc-trib.cod-class-trib-regul).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:CST-REG,          INPUT it-nota-fisc-trib.cod-cst-regul).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQUOTA-REG,     INPUT STRING(it-nota-fisc-trib.aliq-cheia-regul)).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-RED-REG,     INPUT STRING(it-nota-fisc-trib.perc-red-aliq-regul)).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, INPUT AtributoImposto:ALIQ-EFETIVA-REG, INPUT STRING(it-nota-fisc-trib.aliq-regul)).
                   END.
                END.
                WHEN 3 THEN DO: /*IBS Mun*/
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:C-CLASS-TRIB,     INPUT it-nota-fisc-trib.cod-class-trib).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:CST,              INPUT it-nota-fisc-trib.cod-cst).

                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQUOTA,         INPUT STRING(it-nota-fisc-trib.aliq-trib)).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQ-RED,         INPUT STRING(it-nota-fisc-trib.perc-red-aliq)).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQ-EFETIVA,     INPUT STRING(it-nota-fisc-trib.aliq-efetiva)).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:PERC-DIFER,       INPUT STRING(it-nota-fisc-trib.perc-difer)).

                   IF it-nota-fisc-trib.log-compra-gov THEN DO:
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:PERC-RED-GOV,     INPUT STRING(it-nota-fisc-trib.perc-red-aliq-gov)).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQ-GOV,         INPUT STRING(it-nota-fisc-trib.aliq-cheia-regul)).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQ-EFETIVA-GOV, INPUT STRING(it-nota-fisc-trib.aliq-regul)).
                   END.
                   ELSE DO:
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:C-CLASS-TRIB-REG, INPUT it-nota-fisc-trib.cod-class-trib-regul).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:CST-REG,          INPUT it-nota-fisc-trib.cod-cst-regul).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQUOTA-REG,     INPUT STRING(it-nota-fisc-trib.aliq-cheia-regul)).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQ-RED-REG,     INPUT STRING(it-nota-fisc-trib.perc-red-aliq-regul)).
                       RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, INPUT AtributoImposto:ALIQ-EFETIVA-REG, INPUT STRING(it-nota-fisc-trib.aliq-regul)).
                   END.
                END.
                WHEN 4 THEN DO: /*IS*/
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:C-CLASS-TRIB,  INPUT it-nota-fisc-trib.cod-class-trib).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:CST,           INPUT it-nota-fisc-trib.cod-cst).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:ALIQUOTA,      INPUT STRING(it-nota-fisc-trib.aliq-trib)).
                   RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:ALIQ-ESPEC-UN, INPUT STRING(it-nota-fisc-trib.aliq-unid-med-aprop)).
                END.

            END CASE.
        END.
    END.
    RETURN "OK":U.
END PROCEDURE.
