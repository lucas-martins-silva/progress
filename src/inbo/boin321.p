PROCEDURE setConstraint2 :
/*------------------------------------------------------------------------------
  Purpose:    Seta as vari veis de controle para queries contendo o
              planejador inicial e final.
  Parameters:  ipar1: p-inicial: Planejador Inicial
               ipar2: p-final:   Planejador Final 

------------------------------------------------------------------------------ */              
               
/* ------------------------ PROXIES BO 1.1 ----------------------------- */
    
    def input parameter p-inicial     as char no-undo.
    def input parameter p-final       as char no-undo.
    
    run setConstraintFiltroCdPlanej (p-inicial,
                                     p-final).
    RETURN "OK":U.

END PROCEDURE.

