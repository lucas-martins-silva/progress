&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE setConstraintFiltroCdPlanej DBOProgram 
PROCEDURE setConstraintFiltroCdPlanej :
/*------------------------------------------------------------------------------
  Purpose:     Seta as vari veis de controle para queries contendo o
               planejador inicial e final.
  Parameters:  ipar1: p-inicial: Planejador Inicial
               ipar2: p-final:   Planejador Final       
------------------------------------------------------------------------------*/
   def input parameter p-inicial      as char.
   def input parameter p-final        as char.
  
      assign c-inicial      = p-inicial.
      assign c-final        = p-final.

                               
    RETURN "OK":U.

END PROCEDURE.

