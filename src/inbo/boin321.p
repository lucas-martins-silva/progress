&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQuery DBOProgram 
PROCEDURE openQuery :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
/* ------------------------ PROXIES BO 1.1 ----------------------------- */

    define input parameter i-abertura as integer no-undo.
       case i-abertura:
           when 1 then
              RUN openQueryStatic (input "Main":U). 
              
           when 2 then
              RUN openQueryStatic (input "ByFiltroCdPlanej":U).
           
           when 3 then
              RUN openQueryStatic (input "ByFiltroNome":U).
           
       end case.
    
    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryByFiltroCdPlanej DBOProgram 
PROCEDURE openQueryByFiltroCdPlanej :
/*------------------------------------------------------------------------------
  Purpose:    Busca conjunto de registros da tabela planejad, dentro de uma faixa 
              de planejador inicial e final.Ordena por planejador.
 
  ------------------------------------------------------------------------------*/
 open query {&QUERYNAME} for each {&TABLENAME} where {&TABLENAME}.cd-planejado >= c-inicial AND
                                                     {&TABLENAME}.cd-planejado <= c-final
                                                      NO-LOCK by {&TABLENAME}.cd-planejado
                                                      INDEXED-REPOSITION.
                                          
    RETURN "OK":U.


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryByFiltroNome DBOProgram 
PROCEDURE openQueryByFiltroNome :
/*------------------------------------------------------------------------------
  Purpose:     Busca conjunto de registros da tabela planejad, dentro de 
               uma faixa de nome inicial e final. Ordena por nome.

 ------------------------------------------------------------------------------*/
  open query {&QUERYNAME} for each {&TABLENAME} where {&TABLENAME}.nome >= c-inicial AND
                                                      {&TABLENAME}.nome  <= c-final
                                                       NO-LOCK by {&TABLENAME}.nome
                                                       INDEXED-REPOSITION.
                                          
    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryMain DBOProgram 
PROCEDURE openQueryMain :
/*------------------------------------------------------------------------------
  Purpose:     Abertura da query principal do DBO
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH planejad NO-LOCK INDEXED-REPOSITION.

    RETURN "OK":U.
END PROCEDURE.

