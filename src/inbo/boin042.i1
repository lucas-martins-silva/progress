if can-find(first {1} where {1}.cc-codigo = rowObject.cc-codigo) then do:
    {utp/ut-table.i {2} {1} 1}
    {method/svc/errors/inserr.i &ErrorNumber="8699"
                                &ErrorType="EMS"
                                &ErrorSubType="ERROR"
                                &ErrorParameters="c-centro + chr(32) + rowObject.cc-codigo + '~~~~' + return-value"}
end.
