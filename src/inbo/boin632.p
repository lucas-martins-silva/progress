&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryMain DBOProgram 
PROCEDURE openQueryMain :
/*------------------------------------------------------------------------------
  Purpose:     Abertura da query principal do DBO
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH rej-aprov NO-LOCK INDEXED-REPOSITION.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryRangeCodrej DBOProgram 
PROCEDURE openQueryRangeCodrej :
/*------------------------------------------------------------------------------
  Purpose:    
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH {&TableName} WHERE
                                     {&TableName}.cod-rej >= c-cod-rej-ini AND
                                     {&TableName}.cod-rej <= c-cod-rej-fim                                                               
                                     NO-LOCK INDEXED-REPOSITION.                                                                              
                                                                                 

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryRangeDesrejeicao DBOProgram 
PROCEDURE openQueryRangeDesrejeicao :
/*------------------------------------------------------------------------------
