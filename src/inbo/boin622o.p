&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice aprovador
  Parameters:  
               recebe valor do campo cod-aprov
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-aprov LIKE aprovador.cod-aprov NO-UNDO.

    FIND FIRST bfaprovador WHERE 
        bfaprovador.cod-aprov = pcod-aprov NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfaprovador THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfaprovador)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryCodAprov DBOProgram 
PROCEDURE openQueryCodAprov :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
 OPEN QUERY {&queryName} FOR EACH  {&tableName} 
                                WHERE {&tableName}.cod-aprov >= c-cod-aprov-ini
                                AND   {&tableName}.cod-aprov <= c-cod-aprov-fim
                                AND   {&TableName}.perm-manut = yes
                            NO-LOCK.
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryDescricao DBOProgram 
PROCEDURE openQueryDescricao :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
 OPEN QUERY {&queryName} FOR EACH  {&tableName} 
                                WHERE {&tableName}.des-aprov >= c-des-aprov-ini
                                AND   {&tableName}.des-aprov <= c-des-aprov-fim
                                AND   {&TableName}.perm-manut = yes
                            NO-LOCK.
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryPermManut DBOProgram 
PROCEDURE openQueryPermManut :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
   OPEN QUERY {&QueryName} 
        FOR EACH {&TableName}
            WHERE {&TableName}.perm-manut = yes NO-LOCK.
            
   RETURN "OK":U.         
END PROCEDURE.

