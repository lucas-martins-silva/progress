&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no ­ndice CODIGO
  Parameters:
               recebe valor dos campos do ­ndice CODIGO
               retorna status do processo
  Notes:
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pge-codigo LIKE grup-estoque.ge-codigo NO-UNDO.

    FIND FIRST bfgrup-estoque WHERE
        bfgrup-estoque.ge-codigo = pge-codigo
        NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro serÿ retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfgrup-estoque THEN
        RETURN "NOK":U.

    /*--- Reposiciona query atrav²s de rowid e verifica a ocorr¼ncia de erros, caso
          existam erros serÿ retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfgrup-estoque)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE HabilitaCodBarras DBOProgram 
PROCEDURE HabilitaCodBarras :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
DEFINE INPUT  PARAMETER pit-codigo LIKE ITEM.it-codigo      NO-UNDO.
DEFINE OUTPUT PARAMETER p-log      LIKE grup-estoque.log-1  NO-UNDO.

    FOR FIRST ITEM NO-LOCK 
        WHERE ITEM.it-codigo = pit-codigo,
        FIRST bf{&TableName} NO-LOCK
        WHERE bf{&TableName}.ge-codigo = ITEM.ge-codigo:
        
            &IF '{&bf_mat_versao_ems}' >= '2.08' &THEN
                  ASSIGN p-log =  bf{&TableName}.log-orig-ext.
            &ELSE
               &IF '{&bf_mat_versao_ems}' >= '2.062' &THEN
        
                   ASSIGN p-log = bf{&TableName}.log-1 .
               &ENDIF
            &ENDIF.
    END.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryByCodigo DBOProgram 
PROCEDURE openQueryByCodigo :
/*------------------------------------------------------------------------------
  Purpose:     Abertura da query openQueryByCodigo ordenando pelo c¢digo
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH {&TABLENAME} WHERE
                                     {&TABLENAME}.ge-codigo >= i-ge-codigo-ini AND
                                     {&TABLENAME}.ge-codigo <= i-ge-codigo-fim NO-LOCK           
                                     BY {&TABLENAME}.ge-codigo INDEXED-REPOSITION.
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

