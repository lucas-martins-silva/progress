PROCEDURE openQueryByDescricao :
/*------------------------------------------------------------------------------
  Purpose:     Abertura da query openQueryByDescricao ordenando pela descri‡Æo
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH {&TABLENAME} WHERE
                                     {&TABLENAME}.descricao >= c-descricao-ini AND
                                     {&TABLENAME}.descricao <= c-descricao-fim NO-LOCK
                                     BY {&TABLENAME}.descricao INDEXED-REPOSITION.
    RETURN "OK":U.
END PROCEDURE.

