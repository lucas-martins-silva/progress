/**********************************************************************************************************
** 
** PROCEDURE DividirSplit
** Objetivo: Divide 1 partiá∆o de operaá∆o
** Validaá‰es: A partiá∆o n∆o pode estar finalizada
**             O percentual m°nimo para a primeira partiá∆o dever† ser pelo menos igual a quantidade reportada
** Regra:   Se passar no primeiro parametro de-perc1 = 0 
            de-perc2 ser† interpretada como quantidade para o novo split e o primeiro split n∆o ser† alterado
**            
**********************************************************************************************************/
{cdp/cdcfgman.i}
{sfc/sf9999.i}

procedure DividirSplit:
    define parameter buffer b-split-operac for split-operac.
    define input parameter de-perc1        as decimal no-undo.
    define input parameter de-perc2        as decimal no-undo.
    
    define output parameter table for tt-bo-erro.
 
    def var v-next-split as integer initial 1 no-undo.
     
    def var de-qtd-1  like split-operac.qtd-operac-aprov no-undo.
    def var de-qtd-2  like split-operac.qtd-operac-aprov no-undo.
    def var de-qtd-0  like split-operac.qtd-operac-aprov no-undo.
 
    def buffer b2-split-operac for split-operac.
     
   
    /** Limpeza da Temp-table de erros **/
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

    if de-perc1 > 0   then 
        assign de-qtd-1 = b-split-operac.qtd-previs-operac * de-perc1 / 100
               de-qtd-2 = b-split-operac.qtd-previs-operac * de-perc2 / 100.
    else 
        assign de-qtd-1 = b-split-operac.qtd-previs-operac
               de-qtd-2 = de-perc2.
   
    
    run DividirSplitQtd(buffer b-split-operac,
                        de-qtd-1,
                        de-qtd-2,
                        output table tt-bo-erro).

end procedure.

procedure DividirSplitQtd:
    define parameter buffer b-split-operac for split-operac.
    define input parameter  de-qtd1      like split-operac.qtd-previs-operac no-undo.
    define input parameter  de-qtd2      like split-operac.qtd-previs-operac no-undo.
    define output parameter table for tt-bo-erro.
    
    def buffer bf-grup-maquina for grup-maquina.

    def var v-next-split as integer initial 1 no-undo.
    
    def var de-qtd-1  like split-operac.qtd-operac-aprov no-undo.
    def var de-qtd-2  like split-operac.qtd-operac-aprov no-undo.
    def var de-qtd-0  like split-operac.qtd-operac-aprov no-undo.

    def buffer b2-split-operac for split-operac.

    /** Limpeza da Temp-table de erros **/
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

    assign de-qtd-1 = de-qtd1
           de-qtd-2 = de-qtd2.

    find item where 
         item.it-codigo = b-split-operac.it-codigo no-lock no-error.

    find first oper-ord where 
         oper-ord.nr-ord-produ   = b-split-operac.nr-ord-produ and
         oper-ord.num-operac-sfc = b-split-operac.num-operac-sfc no-lock no-error. 

    if not item.fraciona then 
         assign de-qtd-1 = integer(de-qtd-1)
                de-qtd-2 = integer(de-qtd-2).    

    if b-split-operac.ind-estado-split = 5 and 
       de-qtd-1 <> b-split-operac.qtd-previs-operac then do:
         create tt-bo-erro.
         assign i-seq-erro              = i-seq-erro + 1
                tt-bo-erro.i-sequen     = i-seq-erro
                tt-bo-erro.cd-erro      = 17786.
         return.    
    end.
    if b-split-operac.log-1 = no then do: /*Quando parametro reporta para mais de um centro de trabalho for n∆o*/       
       /*** Interferància de quantidade aprovado ***/
       if de-qtd-1 < b-split-operac.qtd-operac-aprov then do:
          assign de-qtd-2 = max(0, de-qtd-2 - b-split-operac.qtd-operac-aprov + de-qtd-1)
                 de-qtd-1 = b-split-operac.qtd-operac-aprov.
       end.
       
       if de-qtd-2 <= 0 then do:
           /*Quantidade do split original deve ser maior ou igual a quantidade aprovado.*/
           /*N∆o foi poss°vel efetuar a divis∆o*/
            create tt-bo-erro.
            assign i-seq-erro              = i-seq-erro + 1
                   tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 32058.
            return.            
       end.
    end.

    find last  b2-split-operac
         where b2-split-operac.nr-ord-produ   = b-split-operac.nr-ord-produ and 
               b2-split-operac.num-operac-sfc = b-split-operac.num-operac-sfc no-lock no-error.

    assign v-next-split = b2-split-operac.num-split-operac + 1.

    create b2-split-operac.
    buffer-copy b-split-operac  
         except b-split-operac.num-split-operac to b2-split-operac
         assign b2-split-operac.num-split-operac            = v-next-split
                b2-split-operac.qtd-previs-operac           = de-qtd-2
                de-qtd-0                                    = b-split-operac.qtd-previs-operac
                b-split-operac.qtd-previs-operac            = de-qtd-1                                  
                b-split-operac.val-perc-avanco              = if b-split-operac.qtd-previs-operac = 0 then 100 else 
                                                                 b-split-operac.qtd-operac-aprov / b-split-operac.qtd-previs-operac * 100
                b-split-operac.val-perc-operac              = (b-split-operac.qtd-previs-operac / oper-ord.qtd-previs-operac) * 100
                b2-split-operac.cod-ferr-prod               = ""                                        
                b2-split-operac.val-perc-avanco             = 0                                         
                b2-split-operac.log-split-rep               = no                                        
                b2-split-operac.log-split-finaliz           = no                                        
                b2-split-operac.cod-ctrab                   = ""                                        
                b2-split-operac.cod-ferr-prod               = ""                                        
                b2-split-operac.ind-estado-split            = min (b-split-operac.ind-estado-split, 3)  
                b2-split-operac.qtd-operac-aprov            = 0                                         
                b2-split-operac.qtd-operac-refgda           = 0                                         
                b2-split-operac.qtd-operac-reptda           = 0                                         
                b2-split-operac.qtd-operac-retrab           = 0                                         
                b2-split-operac.val-perc-avanco             = 0                                         
                b2-split-operac.val-perc-operac             = (b2-split-operac.qtd-previs-operac / oper-ord.qtd-previs-operac) * 100 
                b2-split-operac.dat-fim-operac              = ?
                b2-split-operac.qtd-segs-fim-operac         = 0
                b2-split-operac.dat-fim-setup               = ?
                b2-split-operac.qtd-segs-fim-setup          = 0 
                b2-split-operac.dat-inic-operac             = ?   
                b2-split-operac.qtd-segs-inic-operac        = 0
                b2-split-operac.dat-inic-setup              = ?   
                b2-split-operac.qtd-segs-inic-setup         = 0 
                b2-split-operac.dat-produt-dispon           = ?
                b2-split-operac.qtd-segs-produt-dispon      = 0
                
                /*Datas Programadas*/
                b2-split-operac.dat-progda-inic-setup       = ?
                b2-split-operac.qtd-segs-progdo-inic-setup  = 0
                b2-split-operac.dat-progda-inic-operac      = ?
                b2-split-operac.qtd-segs-progdo-inic-operac = 0
                b2-split-operac.dat-progda-fim-operac       = ?
                b2-split-operac.qtd-segs-progdo-fim-operac  = 0
                
                b2-split-operac.tempo-real-maq              = 0
                b2-split-operac.tempo-real-mod              = 0
                b2-split-operac.tempo-real-operac           = 0  
                b2-split-operac.tempo-real-pos-operac       = 0
                b2-split-operac.tempo-real-prepar           = 0
                                                            
                b2-split-operac.log-reporte-cp              = no
                b2-split-operac.log-split-finaliz           = no 
                b2-split-operac.log-split-rep               = no
                b2-split-operac.data-1                      = ? //Para garatir que ap¢s a divis∆o o novo split possa ser iniciado.
                b2-split-operac.log-reporta-varios-ctrab = b-split-operac.log-reporta-varios-ctrab . /*** Apartir da 2.05 Ç utizado este campo fo: 937.436 ****/
                
    run AlocarSplit(buffer b2-split-operac, 
                    input today).

    find bf-grup-maquina no-lock
         where bf-grup-maquina.gm-codigo = b-split-operac.gm-codigo no-error.
  
    if de-qtd-0 <> de-qtd-1 then
        run CalcularTempoPadraoO (buffer oper-ord,
                                  input  b-split-operac.cod-ctrab,
                                  input  b-split-operac.cod-ferr-prod,
                                  input  b-split-operac.qtd-previs-operac,
                                  output b-split-operac.tempo-pad-maq,
                                  output b-split-operac.tempo-pad-mod,
                                  output b-split-operac.qtd-capac-operac). 
                                  
    assign b-split-operac.tempo-pad-operac = if bf-grup-maquina.ind-tip-ctrab = 4 then 
                                             b-split-operac.tempo-pad-mod 
                                             else                               
                                             b-split-operac.tempo-pad-maq.
                                             
    
    run CalcularTempoPadraoO (buffer oper-ord,
                              input  b2-split-operac.cod-ctrab,
                              input  b2-split-operac.cod-ferr-prod,
                              input  b2-split-operac.qtd-previs-operac,
                              output b2-split-operac.tempo-pad-maq,
                              output b2-split-operac.tempo-pad-mod,
                              output b2-split-operac.qtd-capac-operac).
                              
                              
    assign b2-split-operac.tempo-pad-operac = if bf-grup-maquina.ind-tip-ctrab = 4 then 
                                              b2-split-operac.tempo-pad-mod 
                                              else                               
                                              b2-split-operac.tempo-pad-maq.

    assign b2-split-operac.tempo-pad-carga  = b2-split-operac.tempo-pad-maq + 
                                              b2-split-operac.tempo-pad-setup.

end procedure.


/**********************************************************************************************************
** 
** PROCEDURE UnirSplit
** Objetivo: Unir 2 partiá‰es de operaá∆o
** Validaá‰es: Nenhuma partiá∆o dever† estar finalizada
**             Uma das partiá‰es n∆o deve estar iniciada
**
**********************************************************************************************************/


procedure UnirSplit:
    define input parameter rw-split1    as rowid no-undo.
    define input parameter rw-split2    as rowid no-undo.
    define output parameter table for tt-bo-erro.
    
    def var c-liter as char no-undo.

    define buffer b-split-operac for split-operac.
    define buffer bf-grup-maquina for grup-maquina.

    /** Limpeza da Temp-table de erros **/
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

    find first split-operac
         where rowid(split-operac)   = rw-split1 exclusive-lock no-error.

    find first b-split-operac
         where rowid(b-split-operac) = rw-split2 exclusive-lock no-error.
         
    /*Validaá∆o que estava na b03in535.w, do sf0303*/
    if split-operac.nr-ord-produ   <> b-split-operac.nr-ord-produ or
       split-operac.num-operac-sfc <> b-split-operac.num-operac-sfc then do:
       
         create tt-bo-erro.
         {utp/ut-liter.i Splits_de_Operaá∆o *}
         assign c-liter = return-value.
         {utp/ut-liter.i Ordem_de_Produá∆o_ou_Operaá∆o *}         
         assign i-seq-erro              = i-seq-erro + 1
                tt-bo-erro.i-sequen     = i-seq-erro
                tt-bo-erro.cd-erro      = 17829
                tt-bo-erro.parametros   = c-liter + "~~" + return-value.
         return.
    end.

    if split-operac.ind-estado-split   = 5 or
       b-split-operac.ind-estado-split = 5 then do:
         {utp/ut-liter.i Operaá∆o_(Split) *}
         create tt-bo-erro.
         assign i-seq-erro              = i-seq-erro + 1
                tt-bo-erro.i-sequen     = i-seq-erro
                tt-bo-erro.cd-erro      = 17786
                tt-bo-erro.parametros   = return-value.
         return.
    end.

    if split-operac.ind-estado-split   = 4 and
       b-split-operac.ind-estado-split = 4 then do:
         {utp/ut-liter.i Operaá∆o_(Split) *}
         create tt-bo-erro.
         assign i-seq-erro              = i-seq-erro + 1
                tt-bo-erro.i-sequen     = i-seq-erro
                tt-bo-erro.cd-erro      = 17787
                tt-bo-erro.parametros   = return-value.
         return.         
    end.    

    /*se 1o split diferente de finalizado, inverte pois as qts aprovadas estao no split iniciado.*/
    if split-operac.ind-estado-split <> 4 then do:
        find first split-operac
             where rowid(split-operac)   = rw-split2 exclusive-lock no-error.

        find first b-split-operac
             where rowid(b-split-operac) = rw-split1 exclusive-lock no-error.        
    end.

    /** Busca a quantidade prevista da Operaá∆o **/
    for first oper-ord 
        where oper-ord.nr-ord-produ = split-operac.nr-ord-produ
        and   oper-ord.op-codigo    = split-operac.op-codigo
        and   oper-ord.it-codigo    = split-operac.it-codigo no-lock:
        if (split-operac.qtd-previs-operac + b-split-operac.qtd-previs-operac) 
            > oper-ord.qtd-previs-operac then do:

            assign split-operac.qtd-previs-operac  = oper-ord.qtd-previs-operac.

            /** Cria informaá∆o para usu†rio da quantidade prevista **/
            create tt-bo-erro.
            assign i-seq-erro              = i-seq-erro + 1
                   tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 28536.            
        end.
        else 
            /** MÇtodo normal de somat¢ria da quantidade **/
            assign split-operac.qtd-previs-operac  = split-operac.qtd-previs-operac + 
                                                     b-split-operac.qtd-previs-operac   /* Ativ. 168.387 */
                   split-operac.val-perc-operac    = split-operac.qtd-previs-operac / oper-ord.qtd-previs-operac  * 100.
    end.

    find first oper-ord where 
         oper-ord.nr-ord-produ   = split-operac.nr-ord-produ and
         oper-ord.num-operac-sfc = split-operac.num-operac-sfc no-lock no-error. 

    find bf-grup-maquina no-lock
         where bf-grup-maquina.gm-codigo = split-operac.gm-codigo no-error.
         
    run CalcularTempoPadraoO (buffer oper-ord,
                             input  split-operac.cod-ctrab,
                             input  split-operac.cod-ferr-prod,
                             input  split-operac.qtd-previs-operac,
                             output split-operac.tempo-pad-maq,
                             output split-operac.tempo-pad-mod,
                             output split-operac.qtd-capac-operac). 
                             

    assign split-operac.tempo-pad-operac = if bf-grup-maquina.ind-tip-ctrab = 4 then 
                                           split-operac.tempo-pad-mod 
                                           else                               
                                           split-operac.tempo-pad-maq.
                             
    delete b-split-operac.
    
    /*Tira o estado de lock do registro*/
    if avail split-operac then
        find current split-operac no-lock no-error.
        
    for first param-cp fields (log-integr-ppi-mes) no-lock: end.
    if param-cp.log-integr-ppi-mes then do:         
          for first ord-prod fields()
             where ord-prod.nr-ord-produ = oper-ord.nr-ord-produ no-lock :
          end.
          run cpp/cpapi301b.p ( input rowid(ord-prod),
                                input oper-ord.nr-ord-produ, 
                                input 2). /*alteracao*/        
          if return-value = "NOK" then do:
                 {utp/ut-liter.i Ordem_de_produá∆o *}
                 create tt-bo-erro.
                 assign i-seq-erro              = i-seq-erro + 1
                        tt-bo-erro.i-sequen     = i-seq-erro
                        tt-bo-erro.cd-erro      = 54436
                        tt-bo-erro.parametros   = return-value.
          END.
    end.

end procedure.

PROCEDURE alocarSplit:

    def parameter buffer b-split-operac for split-operac.
    def input parameter  p-dat-liber as date no-undo.

    /*** Aqui estar† a futura l¢gica de alocaá∆o do EMS 5.00 ***/
    def buffer b-ord-prod for ord-prod. 
    def buffer b-oper-ord for oper-ord.
     

    DEF VAR l-sfc-mudanca AS LOGICAL init no NO-UNDO.
    assign l-sfc-mudanca = l-glob-novo-sfc.
    
    /* MMAN-4468 - se tiver mais de um ct para o mesmo gm, carrega o cod-ctrab em branco para o novo split */
    find ctrab where ctrab.gm-codigo = b-split-operac.gm-codigo no-lock no-error.

                                              
    for first  b-ord-prod fields( b-ord-prod.cod-estabel
                                  b-ord-prod.nr-linha   
                                  b-ord-prod.nr-ord-produ )  no-lock                                                         
         where b-ord-prod.nr-ord-produ = b-split-operac.nr-ord-produ :
    end.

    if available ctrab then do:
        assign b-split-operac.cod-ctrab       = ctrab.cod-ctrab
               b-split-operac.qtd-carga-batch = ctrab.qtd-carga-batch.

        for first area-produc-ctrab fields(area-produc-ctrab.cod-area-produc)
             where area-produc-ctrab.cod-ctrab       = ctrab.cod-ctrab
               and area-produc-ctrab.dat-inic-valid <= p-dat-liber
               and area-produc-ctrab.dat-fim-valid  >  p-dat-liber no-lock :
        end.       
        if available area-produc-ctrab then 
            assign b-split-operac.cod-area-produc = area-produc-ctrab.cod-area-produc.            
    end.     
    else do:   
        if l-sfc-mudanca = no then do:
           for first area-produc-ctrab fields (cod-area-produc) where 
                     area-produc-ctrab.gm-codigo       = b-split-operac.gm-codigo and 
                     area-produc-ctrab.dat-inic-valid <= p-dat-liber and 
                     area-produc-ctrab.dat-fim-valid  >  p-dat-liber no-lock:
               assign b-split-operac.cod-area-produc = area-produc-ctrab.cod-area-produc.
           end.
        end.        
        else do:
          find first b-oper-ord no-lock
               where b-oper-ord.nr-ord-produ   = b-split-operac.nr-ord-produ
                 and b-oper-ord.num-operac-sfc = b-split-operac.num-operac-sfc no-error.

          FIND FIRST area-produc-prefer NO-LOCK
               WHERE area-produc-prefer.num-id-operacao    = b-oper-ord.num-id-operacao
                 AND area-produc-prefer.it-codigo          = b-oper-ord.it-codigo 
                 AND area-produc-prefer.op-codigo          = b-oper-ord.op-codigo
                 AND area-produc-prefer.cod-roteiro        = b-oper-ord.cod-roteiro
                 AND area-produc-prefer.num-operac-alterna = b-oper-ord.op-altern 
                 AND area-produc-prefer.cod-estabel        = b-ord-prod.cod-estabel 
                 AND area-produc-prefer.nr-linha           = b-ord-prod.nr-linha    NO-ERROR.

          FIND area-produc NO-LOCK
               WHERE area-produc.cod-area-produc = area-produc-prefer.cod-area-produc
                 NO-ERROR.
        
          If avail area-produc-prefer and avail area-produc and 
           can-find (first area-produc-ctrab 
                     where area-produc-ctrab.gm-codigo       = b-split-operac.gm-codigo 
                       and area-produc-ctrab.dat-inic-valid <= p-dat-liber 
                       and area-produc-ctrab.dat-fim-valid   > p-dat-liber 
                       and area-produc-ctrab.cod-area-produc = area-produc-prefer.cod-area-produc) then
                  assign b-split-operac.cod-area-produc = area-produc-prefer.cod-area-produc.
           Else do:
              for each area-produc fields (cod-area-produc cod-estabel) no-lock, 
                 FIRST  area-produc-ctrab 
               where area-produc.cod-area-produc       = area-produc-ctrab.cod-area-produc
                 AND area-produc.cod-estabel           = b-ord-prod.cod-estabel
                 and area-produc-ctrab.gm-codigo       = b-split-operac.gm-codigo
                 and area-produc-ctrab.dat-inic-valid <= p-dat-liber
                 and area-produc-ctrab.dat-fim-valid  >  p-dat-liber no-lock:
               assign b-split-operac.cod-area-produc = area-produc-ctrab.cod-area-produc.
              end.
           End.
        End.
    end.

END PROCEDURE.

