PROCEDURE afterCreateRecord :
/*-------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def buffer bf-natur-oper-fut   for natur-oper.
    def buffer bf-docum-est-fut    for docum-est.
    DEF BUFFER b-natur-oper        FOR natur-oper. /* Buffer para achar a natureza complementar da natureza de sa°da */

    DEFINE VARIABLE h-calc    AS HANDLE NO-UNDO.
    DEFINE VARIABLE h-boin847 AS HANDLE NO-UNDO.
    DEFINE VARIABLE h-bodi515 AS HANDLE  NO-UNDO.

    &if defined (bf_mat_bloqueio_fornec) &then        
        if l-grava-consist-nota then do:
            if not valid-handle (h_boin060) then
                run inbo/boin060.p persistent set h_boin060.

            run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                                 RowObject.serie-docto,
                                                 RowObject.nro-docto,
                                                 RowObject.nat-operacao,
                                                 1,   
                                                 no, 
                                                 0,
                                                 0,
                                                 27886,
                                                 2 ).
            if valid-handle (h_boin060) then do:
                delete procedure h_boin060.
                                 h_boin060 = ?.
            end.
            assign l-grava-consist-nota = no.
        end.
    &endif
    if  l-transf then do:

        for each tt-saldo-terc:
            delete tt-saldo-terc.
        end.
        
        for each saldo-terc  
             where saldo-terc.serie-docto   = RowObject.serie-docto
               and saldo-terc.nro-docto     = RowObject.nro-docto
               and saldo-terc.cod-emitente  = RowObject.cod-emitente
               and saldo-terc.nat-operacao <> RowObject.nat-operacao
               and saldo-terc.cod-estabel   = RowObject.estab-de-or
               and saldo-terc.quantidade    > 0 
               and saldo-terc.tipo-sal-terc = 3 no-lock break by saldo-terc.sequencia: 

            /*** Correá∆o FO 888.358 (Liziane) ****/
            IF  NOT l-mult-natur-receb AND l-varias-oper AND saldo-terc.nat-operacao <> c-nat-oper-comp THEN
                /* l-mult-natur-receb -> Var def em cd9701.i */
                /* Se n∆o usa m£ltiplas naturezas no recebimento. */
                NEXT.

            FOR FIRST b-natur-oper FIELDS(nat-comp)
                WHERE b-natur-oper.nat-operacao = saldo-terc.nat-operacao NO-LOCK: END.

            for first componente 
                where componente.serie-docto  = saldo-terc.serie-docto
                  and componente.nro-docto    = saldo-terc.nro-docto
                  and componente.cod-emitente = saldo-terc.cod-emitente
                  and componente.nat-operacao = saldo-terc.nat-operacao
                  and componente.it-codigo    = saldo-terc.it-codigo
                  and componente.cod-refer    = saldo-terc.cod-refer
                  and componente.sequencia    = saldo-terc.sequencia
                no-lock: end.
            IF  AVAIL componente THEN DO:
                CREATE tt-saldo-terc.
                ASSIGN tt-saldo-terc.rw-saldo-terc = ROWID(saldo-terc)
                       tt-saldo-terc.quantidade    = saldo-terc.quantidade
                       tt-saldo-terc.preco-total   = (componente.preco-total[1] / componente.quantidade * saldo-terc.quantidade)
                       tt-saldo-terc.cod-depos     = saldo-terc.cod-depos
                       tt-saldo-terc.desconto      = (componente.desconto[1] / componente.quantidade * saldo-terc.quantidade).
                       
                IF componente.nat-operacao BEGINS "5" OR
                   componente.nat-operacao BEGINS "6" OR
                   componente.nat-operacao BEGINS "7" THEN DO:
                   
                   FOR FIRST nota-fiscal
                        WHERE nota-fiscal.cod-estabel    = saldo-terc.cod-estabel
                          AND  nota-fiscal.serie         = componente.serie-docto
                          AND  nota-fiscal.nr-nota-fis   = componente.nro-docto
                          AND  nota-fiscal.cod-emitente  = saldo-terc.emite-comp NO-LOCK:
                   
                       FOR FIRST it-nota-fisc 
                           WHERE it-nota-fisc.cod-estabel = saldo-terc.cod-estabel
                             AND it-nota-fisc.serie       = componente.serie-docto
                             AND it-nota-fisc.nr-nota-fis = componente.nro-docto 
                             AND it-nota-fisc.nr-seq-fat  = componente.sequencia
                             AND it-nota-fisc.it-codigo   = componente.it-codigo NO-LOCK:
                                
                            IF it-nota-fisc.per-des-icms > 0 OR /*desconto ICMS*/ 
                               it-nota-fisc.dec-1 > 0        OR /*ICMS ZFM*/ 
                               dec(substring(it-nota-fisc.char-1,128,16)) > 0 OR       /*PIS ZFM*/
                               dec(substring(it-nota-fisc.char-1,145,16)) > 0 THEN DO: /*COFINS ZFM*/
                               
                                ASSIGN tt-saldo-terc.desconto    = (it-nota-fisc.vl-merc-ori - it-nota-fisc.vl-merc-liq)
                                       tt-saldo-terc.preco-total = it-nota-fisc.vl-merc-ori.
                                       
                                IF  it-nota-fisc.per-des-icms > 0 THEN DO:
                    		    FOR FIRST ext-it-nota-fisc
                    		        WHERE ext-it-nota-fisc.cod-estabel = it-nota-fisc.cod-estabel
                    		        AND   ext-it-nota-fisc.serie       = it-nota-fisc.serie
                    		        AND   ext-it-nota-fisc.nr-nota-fis = it-nota-fisc.nr-nota-fis
                    		        AND   ext-it-nota-fisc.nr-seq-fat  = it-nota-fisc.nr-seq-fat
                    		        AND   ext-it-nota-fisc.it-codigo   = it-nota-fisc.it-codigo
                    		        AND   ext-it-nota-fisc.cod-param   = "Val-Desc-ICMS" NO-LOCK: END.
                                    IF AVAIL ext-it-nota-fisc THEN  
                                        ASSIGN tt-saldo-terc.desconto = tt-saldo-terc.desconto - ext-it-nota-fisc.val-livre-1.
                                    ELSE    
                                        IF it-nota-fisc.val-pct-desconto-total >= it-nota-fisc.per-des-icms THEN DO:
                                            IF it-nota-fisc.dec-1 > 0                         OR   /*ICMS ZFM*/ 
                                               dec(substring(it-nota-fisc.char-1,128,16)) > 0 OR   /*PIS ZFM*/
                                               dec(substring(it-nota-fisc.char-1,145,16)) > 0 THEN /*COFINS ZFM*/
                                                ASSIGN tt-saldo-terc.desconto = tt-saldo-terc.desconto - (it-nota-fisc.vl-merc-ori * (it-nota-fisc.per-des-icms / 100)).
                                            ELSE
                                                ASSIGN tt-saldo-terc.desconto = (it-nota-fisc.vl-merc-ori - (it-nota-fisc.vl-merc-liq / ((100 - it-nota-fisc.per-des-icms) / 100))).
                                        END.
                                END.
                                    
                                if tt-saldo-terc.desconto < 0 then
                                   assign tt-saldo-terc.desconto = 0.
                            END.
                       END. /*FOR FIRST it-nota-fisc*/
                   END. /*FOR FIRST nota-fiscal*/
                END. /*IF componente.nat-operacao*/


                /* Se USA m£ltiplas naturezas e o documento veio do conversor: */
                IF  l-mult-natur-receb AND
                    CAN-FIND(FIRST doc-orig-nfe WHERE doc-orig-nfe.ch-acesso-comp-nfe = RowObject.cod-chave-aces-nf-eletro
                                                  AND doc-orig-nfe.idi-orig-trad      = 2) THEN DO:

                    IF  NOT VALID-HANDLE(h-boin847) THEN
                        RUN inbo/boin847.p PERSISTEN SET h-boin847.
                
                    /* Busca natureza fiscal informada para o item */
                    RUN retornaNatFiscalItemConversor IN h-boin847 (INPUT  RowObject.cod-estabel,
                                                                    INPUT  RowObject.cod-emitente,
                                                                    INPUT  RowObject.nro-docto,
                                                                    INPUT  RowObject.serie-docto,
                                                                    INPUT  saldo-terc.it-codigo,
                                                                    INPUT  (saldo-terc.sequencia / 10), /* Sequància saldo-terc Ç sempre 10 em 10 e do doc-orig Ç sempre 1 em 1 */
                                                                    OUTPUT tt-saldo-terc.nat-of).

                    IF  VALID-HANDLE(h-boin847) THEN DO:
                        DELETE PROCEDURE h-boin847.
                        ASSIGN h-boin847 = ?.
                    END.
                END.

                IF  tt-saldo-terc.nat-of = "" OR tt-saldo-terc.nat-of = ? THEN
                    /* Independente se usa ou n∆o m£ltiplas naturezas no recebimento, passa a gravar a natureza fiscal do item (nat-of) */
                    IF  l-mult-natur-receb 
                    AND AVAIL b-natur-oper 
                    AND b-natur-oper.nat-comp <> "" THEN
                        ASSIGN tt-saldo-terc.nat-of = b-natur-oper.nat-comp.
                    ELSE /* Se a natureza de sa°da n∆o tiver complementar, atribui a natureza do cabeáalho da nota (RowObject.nat-operacao) */
                        ASSIGN tt-saldo-terc.nat-of = RowObject.nat-operacao.
            END.

        END.
        
        if  not valid-handle(h_boin176) then 
            run inbo/boin176.p persistent set h_boin176.
       
        run emptyRowErrors in h_boin176.

        /* Criaá∆o dos itens na boin176 */
        run createItemOfComponente in h_boin176 ( input this-procedure,
                                                  input table tt-saldo-terc ).

        run getRowErrors in h_boin176 ( output table rowErrors append).

        find first rowErrors no-lock no-error.
        IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U
                                      AND RowErrors.ErrorType   <> "INTERNAL":U) THEN
           RETURN "NOK":U.
        else
         return "OK":U.
        
    end.
    
    /* ***** Atualiza Embarque ***** */
    &IF '{&bf_mat_versao_ems}' >= '2.062' &THEN
       IF AVAIL param-global AND param-global.modulo-07 THEN DO:
           IF  RowObject.embarque <> "" OR TRIM(SUBSTR(RowObject.char-1,1,20)) <> '' THEN DO:
               ASSIGN cNrEmbarque = IF RowObject.embarque <> "" THEN RowObject.embarque
                                    ELSE TRIM(SUBSTR(RowObject.char-1,1,20)).
               
               IF  NOT VALID-HANDLE (h-bocx378) THEN
                   RUN cxbo/bocx378.p PERSISTENT SET h-bocx378.
               
              /*Se o estabelecimento da ordem de compra n∆o foi informado
                utiliza o c¢digo do estabelecimento da docum-est.*/
              if c-cod-estabel-oc = "" then
                 assign c-cod-estabel-oc = RowObject.cod-estabel.
               
               RUN goToKey IN h-bocx378 (input if i-pais-impto-usuario <> 1 then RowObject.cod-estabel else c-cod-estabel-oc,
                                         input cNrEmbarque,
                                         input RowObject.serie-docto,
                                         input RowObject.nro-docto,
                                         input RowObject.cod-emitente,
                                         input RowObject.nat-operacao).
               
               IF  RETURN-VALUE = "NOK":U THEN DO:
                   RUN piCriaRowObject IN h-bocx378 (INPUT if i-pais-impto-usuario <> 1 then RowObject.cod-estabel else c-cod-estabel-oc,
                                                     INPUT cNrEmbarque,
                                                     INPUT RowObject.serie-docto,
                                                     INPUT RowObject.nro-docto,
                                                     INPUT RowObject.cod-emitente,
                                                     INPUT RowObject.nat-operacao).
                   RUN createRecord IN h-bocx378.
                   release embarq-import-docto.
               END.
               
               DELETE PROCEDURE h-bocx378.
               ASSIGN h-bocx378 = ?.
           END.
       END.
    &ENDIF
    
    /* Automaá∆o das retená‰es no recebimento */
    if can-find(first funcao where 
                      funcao.cd-funcao = "spp-aut-impto":U             and
                      funcao.ativo)                                    and 
        can-find(first funcao where 
                      funcao.cd-funcao = "adm-apb-ems-5.00":U          and
                      funcao.ativo = yes                               and
                      funcao.log-1 = yes)                              and
        can-find(first natur-oper where
                      natur-oper.nat-operacao = RowObject.nat-operacao and
                      natur-oper.emite-duplic)                         then do:

        /* empty temp-table tt_impostos. */
       empty temp-table tt_log_erros.
       empty temp-table tt_erros_conexao.
	   empty temp-table tt_param_integr_imptos_apb.
	   empty temp-table tt_integr_imptos_pgto_apb.
	   empty temp-table tt_erros_integr_imptos_apb.

       run setConnectEMS5 (input 1). 
       
       if not l-conectado or
          can-find(first tt_erros_conexao) then 
          return "OK":U.
       
       run findEstabelec (input RowObject.cod-estabel).
	   
	   ASSIGN c-cod-empresa = estabelec.ep-codigo
			  c-cod-estabel = estabelec.cod-estabel.
			  
			  
	   /*--- Traducao empresa e estabelecimento ---*/
	   RUN pi-traduz-empresa-estab(INPUT-OUTPUT c-cod-empresa,
                                   INPUT-OUTPUT c-cod-estabel).	 
								   
       IF  RETURN-VALUE = "NOK" THEN
		RETURN "NOK".  
								   
		/*--- Retorna impostos retidos do fornecedor ---*/
		CREATE tt_param_integr_imptos_apb.
		ASSIGN tt_param_integr_imptos_apb.tta_cod_empresa       = c-cod-empresa
			   tt_param_integr_imptos_apb.tta_cdn_fornecedor    = RowObject.cod-emitente 
			   tt_param_integr_imptos_apb.tta_cod_estab         = c-cod-estabel
			   tt_param_integr_imptos_apb.tta_val_pagto_tit_ap  = 1 /* Passar o valor fixo 1 */
			   tt_param_integr_imptos_apb.tta_dat_transacao     = RowObject.dt-trans
			   tt_param_integr_imptos_apb.tta_dat_emis_docto    = RowObject.dt-emissao
			   tt_param_integr_imptos_apb.tta_dat_vencto_tit_ap = RowObject.dt-trans
			   tt_param_integr_imptos_apb.ttv_log_impto_obrig   = NO.			   

 
		RUN prgfin/apb/apb719za.py PERSISTENT SET  h-calc.			
		RUN pi_main_retorna_impostos_calculados_01 IN h-calc (INPUT  TABLE tt_param_integr_imptos_apb,                                                                         
															  OUTPUT TABLE tt_integr_imptos_pgto_apb,
															  OUTPUT TABLE tt_erros_integr_imptos_apb).		
        DELETE PROCEDURE h-calc.
        ASSIGN h-calc = ?.	
        		
        if not can-find(first tt_log_erros) and
               can-find(first tt_integr_imptos_pgto_apb)  then do: 
               assign c-help = "".
               for each tt_integr_imptos_pgto_apb:
                  assign c-help = c-help + tt_integr_imptos_pgto_apb.tta_cod_imposto +
                                   " - " + tt_integr_imptos_pgto_apb.tta_des_imposto +
								   chr(10).                   
               end.
			   
               {method/svc/errors/inserr.i &ErrorNumber="32311"
                                           &ErrorType="EMS":U
                                           &ErrorSubType="WARNING":U
                                           &ErrorParameters="c-help"}
        end.
                                   
       run setConnectEMS5 (input 2). 
    end.
    
    /*--- quando a nota eh fatura entrega futura grava a natureza complementar no item-doc-est ---*/
    find bf-natur-oper-fut where
         bf-natur-oper-fut.nat-operacao = rowObject.nat-operacao no-lock no-error.
         
    /*--- verifica se docum-est eh de nota de fatura faturamento ou fatura entrega futura ---*/
    {cdp/cd9700.i1 bf-natur-oper-fut}

    IF  l-fatura-ent-futura 
    AND AVAIL bf-natur-oper-fut THEN DO:
    
        find bf-docum-est-fut {cdp/cd8900.i bf-docum-est-fut rowObject} exclusive-lock no-error.
        if  avail bf-docum-est-fut then
            assign bf-docum-est-fut.log-entreg-fut = yes.
    END.         

    /* Conversor NFe/CTe/NFSe */
    IF  CAN-FIND(FIRST funcao WHERE funcao.cd-funcao = "spp-conv-nfe-entrada":U AND funcao.ativo NO-LOCK) THEN DO:
    
        define variable c-chave-comp-nfe  as character no-undo.
        define variable c-chave-comp-cte  as character no-undo.
        define variable h-boin871         as handle    no-undo.
        define variable h-boin874         as handle    no-undo.
        DEFINE VARIABLE c-lbl-liter-msg   AS CHARACTER NO-UNDO.
        DEFINE VARIABLE c-lbl-liter-msgII AS CHARACTER NO-UNDO.
        DEFINE VARIABLE l-valido          AS LOGICAL NO-UNDO.
        
            
        FIND FIRST param-convrsr-nfe NO-LOCK NO-ERROR.
        
        /*NFSe **************************************************************/
        IF AVAIL param-convrsr-nfe AND param-convrsr-nfe.log-livre-2 THEN DO:
            IF NOT VALID-HANDLE(h-boin874)
                OR h-boin874:TYPE      <> "PROCEDURE":U
                OR h-boin874:FILE-NAME <> "inbo/boin874.p":U THEN
                RUN inbo/boin874.p PERSISTENT SET h-boin874.
            
            RUN atualizaSituacaoPeloDocumento IN h-boin874 (INPUT RowObject.cod-emitente,
                                                            INPUT RowObject.nro-docto,
                                                            INPUT RowObject.serie-docto,
                                                            INPUT RowObject.dt-emissao,
                                                            INPUT 1). /* Digitada Receb. Fiscal */

            DELETE PROCEDURE h-boin874 NO-ERROR.            
            ASSIGN h-boin874 = ?.                       
        END.
        /********************************************************************/

        /*CTe **************************************************************/
        IF AVAIL param-convrsr-nfe AND param-convrsr-nfe.log-livre-1 THEN DO:

            IF NOT VALID-HANDLE(h-boin871)
            OR h-boin871:TYPE      <> "PROCEDURE":U
            OR h-boin871:FILE-NAME <> "inbo/boin871.p":U THEN
                RUN inbo/boin871.p PERSISTENT SET h-boin871.

            assign c-chave-comp-cte = &IF "{&bf_mat_versao_ems}" < "2.07" &THEN
                                          TRIM(SUBSTRING(rowObject.char-1,93,60))
                                      &ELSE                                    
                                          rowObject.cod-chave-aces-nf-eletro   
                                      &ENDIF
                                      .
            IF  VALID-HANDLE(h-boin871)        AND
                h-boin871:TYPE = "PROCEDURE":U AND
                h-boin871:FILE-NAME = "inbo/boin871.p":U THEN DO:

                assign l-valido = false.
                                   
                if LENGTH(c-chave-comp-cte) = 44 then do:
                    if substring(c-chave-comp-cte,21,2) = "57" or
                       substring(c-chave-comp-cte,21,2) = "67" then 
                        assign l-valido = true.
                end.                
                else do: 
                    if avail bf-natur-oper-fut and
                      (bf-natur-oper-fut.cod-model-nf-eletro = '57' or 
                       bf-natur-oper-fut.cod-model-nf-eletro = '67') then
                        assign l-valido = true.                        

                end.                    
                if l-valido then do:
                    RUN atualizaSituacaoPelaChaveDeAcesso in h-boin871 (input c-chave-comp-cte,
                                                                        input RowObject.serie-docto,
                                                                        input RowObject.nro-docto,
                                                                        input RowObject.cod-emitente,
                                                                        input RowObject.nat-operacao,
                                                                        input 1). /* Situaá∆o 1: Digitada Receb. Fiscal */

                end.
                DELETE PROCEDURE h-boin871.
                ASSIGN h-boin871 = ?.
            END.

            /* Quando a nota de CT-e vem do Conversor, a modalidade vai ser sempre 1 - Por conta do destinat·rio/remetente */
            IF TRIM(SUBSTRING(docum-est.char-2,143,8)) = "" AND 
               AVAIL bf-natur-oper-fut AND 
               bf-natur-oper-fut.tipo-compra = 2 THEN DO:
                  ASSIGN OVERLAY(docum-est.char-2,143,8) = "1".
            END.
            
        END.
        /*******************************************************************/
        
        ASSIGN c-chave-comp-nfe = &IF "{&bf_mat_versao_ems}" < "2.07" &THEN
                                      TRIM(SUBSTRING(rowObject.char-1,93,60))
                                  &ELSE                                    
                                      rowObject.cod-chave-aces-nf-eletro   
                                  &ENDIF  
                                  .
        IF  NOT RowObject.origem = "i":U and  NOT RowObject.origem = "XML":U THEN DO:
            IF CAN-FIND(FIRST item-doc-orig-nfe
                        WHERE item-doc-orig-nfe.ch-acesso-comp-nfe = c-chave-comp-nfe
                          AND item-doc-orig-nfe.idi-orig-trad      = 2
                          AND item-doc-orig-nfe.numero-ordem       > 0)
            OR CAN-FIND(FIRST rat-ordem-orig-nfe
                        WHERE rat-ordem-orig-nfe.ch-acesso-comp-nfe = c-chave-comp-nfe) THEN DO:
                {method/svc/errors/inserr.i &ErrorNumber="55110"
                                            &ErrorType="EMS":U
                                            &ErrorSubType="ERROR":U}
                RETURN "NOK":U.
            END.
            IF CAN-FIND(FIRST item-ref-nfe
                        WHERE item-ref-nfe.ch-acesso-comp-nfe = c-chave-comp-nfe) THEN DO:
                {method/svc/errors/inserr.i &ErrorNumber="55111"
                                            &ErrorType="EMS":U
                                            &ErrorSubType="ERROR":U}
                RETURN "NOK":U.
            END.
        END.

        IF NOT VALID-HANDLE(h-boin847) 
        OR h-boin847:TYPE      <> "PROCEDURE":U 
        OR h-boin847:FILE-NAME <> "inbo/boin847.p":U THEN 
            RUN inbo/boin847.p PERSISTENT SET h-boin847.
        
        RUN atualizaSituacaoPelaChaveDeAcesso in h-boin847 (input c-chave-comp-nfe,
                                                            input RowObject.serie-docto,
                                                            input RowObject.nro-docto,
                                                            input RowObject.cod-emitente,
                                                            input RowObject.nat-operacao,
                                                            input RowObject.cod-estabel,
                                                            input 1). /* Situaªío 1: Digitada Receb. Fiscal */
        IF  VALID-HANDLE(h-boin847) THEN DO:
            DELETE PROCEDURE h-boin847.
            ASSIGN h-boin847 = ?.
        END.
        
    END.
    /* Fim Conversor NFe/CTe */

    RETURN "OK":U.

END PROCEDURE.

PROCEDURE pi-traduz-empresa-estab:
		  
    DEF INPUT-OUTPUT PARAM v_cod_empre LIKE estabelec.ep-codigo   NO-UNDO. 
    DEF INPUT-OUTPUT PARAM v_cod_estab LIKE estabelec.cod-estabel NO-UNDO. 
	
     EMPTY TEMP-TABLE tt_xml_input_output. 
	
    
    CREATE tt_xml_input_output.
    ASSIGN tt_xml_input_output.ttv_cod_label = 'Funá∆o':U
           tt_xml_input_output.ttv_des_conteudo = "Faturamento 2.00"
           tt_xml_input_output.ttv_num_seq_1 = 1.
    
    CREATE tt_xml_input_output.
    ASSIGN tt_xml_input_output.ttv_cod_label = 'Produto':U
           tt_xml_input_output.ttv_des_conteudo = "EMS 5"
           tt_xml_input_output.ttv_num_seq_1 = 1.

    CREATE tt_xml_input_output.
    ASSIGN tt_xml_input_output.ttv_cod_label = 'Empresa':U
           tt_xml_input_output.ttv_des_conteudo = v_cod_empre /* Codigo da Empresa no EMS2 */
           tt_xml_input_output.ttv_num_seq_1 = 1.
    
    CREATE tt_xml_input_output.
    ASSIGN tt_xml_input_output.ttv_cod_label = 'Estabel':U 
           tt_xml_input_output.ttv_des_conteudo = v_cod_estab /* Codigo do Estabelecimento no EMS2 */
           tt_xml_input_output.ttv_num_seq_1 = 1.
    
    RUN prgint/utb/utb786za.py (INPUT-OUTPUT TABLE tt_xml_input_output,
                                OUTPUT TABLE tt_log_erros).
    
    FIND tt_log_erros WHERE tt_log_erros.ttv_num_cod_erro <> 0 NO-ERROR.
    IF  AVAIL tt_log_erros THEN DO:        	
        FOR EACH tt_log_erros:
              {method/svc/errors/inserr.i &ErrorNumber="17006"
                                          &ErrorType="EMS":U
                                          &ErrorSubType="ERROR":U
                                          &ErrorParameters="tt_log_erros.ttv_des_erro  + '~~~~' + tt_log_erros.ttv_des_ajuda"}                                   
        END.
        RETURN "NOK". 
    END.
    ELSE DO:
        FOR EACH tt_xml_input_output BREAK BY tt_xml_input_output.ttv_num_seq_1:
            IF  tt_xml_input_output.ttv_cod_label = 'Empresa':U THEN
                ASSIGN v_cod_empre = tt_xml_input_output.ttv_des_conteudo_aux.
            IF  tt_xml_input_output.ttv_cod_label = 'Estabel':U THEN
                ASSIGN v_cod_estab = tt_xml_input_output.ttv_des_conteudo_aux.
        END.        
    END.
     
    RETURN "OK".

END.



