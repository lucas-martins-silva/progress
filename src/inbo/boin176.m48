PROCEDURE sugereItemUniEstab :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input        param pc-cod-estabel like docum-est.cod-estabel no-undo.
    def input        param pc-it-codigo   like rat-lote.it-codigo    no-undo.
    def input-output param pc-cod-depos   like rat-lote.cod-depos    no-undo.
    def input-output param pc-cod-localiz like rat-lote.cod-localiz  no-undo.
    

    for first localizacao fields (cod-estabel  cod-depos 
                                  cod-localiz  descricao)
        where localizacao.cod-estabel = pc-cod-estabel
          and localizacao.cod-depos   = pc-cod-depos
          and localizacao.cod-localiz = pc-cod-localiz no-lock:
    end.
    

    if  not avail localizacao then do:
        for first item-uni-estab fields (cod-estabel  it-codigo
                                         cod-localiz  deposito-pad
                                         loc-unica    contr-qualid)
            where item-uni-estab.cod-estabel = pc-cod-estabel
              and item-uni-estab.it-codigo   = pc-it-codigo no-lock:
        end.
        if  avail item-uni-estab then
            assign pc-cod-depos   = item-uni-estab.deposito-pad
                   pc-cod-localiz = item-uni-estab.cod-localiz.
        else do:
            {method/svc/errors/inserr.i &ErrorNumber="25904"
                                        &ErrorType="EMS"
                                        &ErrorSubType="ERROR" 
                                        &ErrorParameters=" pc-it-codigo + '~~~~~' + pc-cod-estabel "}
        end.
    end.
                        

END PROCEDURE.




