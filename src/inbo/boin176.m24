
PROCEDURE createRatLote :
/*------------------------------------------------------------------------------ 
  Purpose:
  Parameters:  <none>
  Notes: Cria»’o do rat-lote, serÿ criado apenas um registro com os dados vindos
         do setDefaultsEstoque. Essa cria»’o ² feita apartir da boin367.
         Executado apartir do afterCreateRecord.

------------------------------------------------------------------------------*/
        
    DEFINE INPUT-OUTPUT PARAMETER p-qtd-rat-acum  AS dec NO-UNDO.
    DEFINE INPUT-OUTPUT PARAMETER p-cont-rat-lote AS dec NO-UNDO.
    
    def var l-deposito-cq   as logical no-undo.
	
    if  not avail item-uni-estab
    or  not avail natur-oper
    or  not avail docum-est
    or  RowObject.quantidade = 0 then
        return "NOK":U.

    run findEstabelec ( docum-est.cod-estabel ).
    

    if  return-value <> "OK":U then
        return "NOK":U.        
            
    if  not valid-handle(h-boin367) then
        run inbo/boin367.p persistent set h-boin367.

    run setConstraintOfDocumEst in h-boin367 (input RowObject.cod-emitente,
                                              input RowObject.serie-docto,  
                                              input RowObject.nro-docto,
                                              input RowObject.nat-operacao).
    run openQueryStatic in h-boin367 ( input "OfDocumEst").
    
    for each tt-rat-lote:
        delete tt-rat-lote.
    end.
    create tt-rat-lote.
    assign tt-rat-lote.serie-docto      = RowObject.serie-docto
           tt-rat-lote.nro-docto        = RowObject.nro-docto
           tt-rat-lote.nat-operacao     = RowObject.nat-operacao
           tt-rat-lote.cod-emitente     = RowObject.cod-emitente
           tt-rat-lote.sequencia        = RowObject.sequencia
           tt-rat-lote.it-codigo        = RowObject.it-codigo
           tt-rat-lote.cod-localiz      = RowObject.cod-localiz
           tt-rat-lote.lote             = RowObject.lote
           tt-rat-lote.dt-vali-lote     = RowObject.dt-vali-lote
           tt-rat-lote.dat-fabricc-lote = RowObject.dat-fabricc-lote
           tt-rat-lote.quantidade       = RowObject.quantidade.
           
    /*Grava Ficha vinculada via CQ0240 quando item for Roteiro de Inspe‡Æo Antecipado*/
    if avail ficha-cq then do:
         if l-vinc-rot-pend then do:
         
             if i-cont-cq > 0 then do:
             
                assign p-cont-rat-lote = p-cont-rat-lote + 1. 
             
                for first item fields (fraciona) no-lock
                    where item.it-codigo = RowObject.it-codigo.
                end.
                
                assign tt-rat-lote.nr-ficha = ficha-cq.nr-ficha.
                
                if avail item and item.fraciona then do:
                    assign tt-rat-lote.quantidade = (RowObject.quantidade / i-cont-cq).
                end.                        
                else do:
                    if p-cont-rat-lote <> i-cont-cq then
                        assign tt-rat-lote.quantidade = truncate(RowObject.quantidade / i-cont-cq,0)
                               p-qtd-rat-acum = p-qtd-rat-acum + ((RowObject.quantidade / i-cont-cq) - truncate(RowObject.quantidade / i-cont-cq,0)).
                    else
                        assign tt-rat-lote.quantidade = truncate(RowObject.quantidade / i-cont-cq,0)
                               p-qtd-rat-acum         = p-qtd-rat-acum + ((RowObject.quantidade / i-cont-cq) - truncate(RowObject.quantidade / i-cont-cq,0))
                               tt-rat-lote.quantidade = tt-rat-lote.quantidade + p-qtd-rat-acum.                
                end.
                
             end.   
             
             if ficha-cq.log-com-nota then
                assign tt-rat-lote.nr-ficha = ficha-cq.nr-ficha.
 
         end.
             
    end.           

           
    IF CAN-FIND(FIRST funcao WHERE funcao.cd-funcao = "spp-integra-ems-his" AND funcao.ativo = YES) THEN DO:  
          &IF '{&bf_mat_versao_ems}' >= '2.08' &THEN
               ASSIGN tt-rat-lote.cod-barras               = SUBSTRING(RowObject.char-2,452,50)
                tt-rat-lote.cod-lote-fabrican              = RowObject.cod-lote-fabrican
                tt-rat-lote.dat-valid-lote-fabrican      = RowObject.dat-valid-lote-fabrican.
          &ELSE
               ASSIGN OVERLAY(tt-rat-lote.char-2, 1, 50) = SUBSTRING(RowObject.char-2,452,50)
                      overlay(tt-rat-lote.CHAR-2,51,20)  = SUBSTRING(RowObject.char-2,505,20)   
                      tt-rat-lote.data-2                 = RowObject.data-2.            
                      
          &ENDIF
          
          &IF "{&bf_mat_versao_ems}" >= "2.09":U &then
              ASSIGN tt-rat-lote.cdn-fabrican = RowObject.cdn-fabrican.
          &ELSE
              ASSIGN OVERLAY(tt-rat-lote.char-2,71,9) = substring(RowObject.char-2,600,9).
          &ENDIF
    END.
    
    if can-find(first funcao 
                where funcao.cd-funcao = "lote-avancado" 
                  and funcao.ativo = yes) then 
            ASSIGN tt-rat-lote.cod-lote-fabrican        = RowObject.cod-lote-fabrican
                   tt-rat-lote.dat-valid-lote-fabrican  = RowObject.dat-valid-lote-fabrican
                   tt-rat-lote.nom-fabrican             = RowObject.nom-fabrican.   
    
         
    
 
    &IF DEFINED(bf_man_per_ppm) &THEN
        ASSIGN tt-rat-lote.per-ppm = e-per-ppm.
    &ENDIF
    
    if  natur-oper.tipo = 1
    and not natur-oper.terceiros 
    or  (    natur-oper.tp-oper-terc <> 1
         and natur-oper.tp-oper-terc <> 2 ) then 

        if  param-global.modulo-cq          /* Possui modulo CQ */
        and param-cq.tipo-cq > 1            /* S¢ Gera Roteiro ou CQ Total */
        and not natur-oper.transf           /* Nao e Transferencia */
        and avail item-uni-estab
        and item-uni-estab.contr-qualid               /* Item possui CQ */
        and item.it-codigo <> " " then do:  /* Item deve ser codificado */ 

            run findParamCQ   in h-boin367.
            run findItem      in h-boin367 ( input RowObject.it-codigo ).
            run findItemUniEstab in h-boin367 ( input RowObject.it-codigo,
                                                input docum-est.cod-estabel ).
            run findDocumento in h-boin367 ( input RowObject.cod-emitente,
                                             input RowObject.serie-docto,
                                             input RowObject.nro-docto,
                                             input RowObject.nat-operacao ).
            run getDepositoCQ in h-boin367 ( output l-deposito-cq ).
        end.            
    
    &IF '{&bf_mat_versao_ems}' < '2.062' &THEN
        assign tt-rat-lote.cod-depos = if  not l-deposito /* Usuÿrio n’o informou dep½sito */
                                       and l-deposito-cq
                                       then estabelec.deposito-cq
                                       else RowObject.cod-depos.
    &else                                   
        if not l-deposito /*Usu rio nÆo informou dep¢sito*/
            and l-deposito-cq then do: /*Deve ser sugerido dep¢sito CQ*/
            
             run buscaDepositoCQ (output tt-rat-lote.cod-depos).
        end.
        else
            assign tt-rat-lote.cod-depos = RowObject.cod-depos.
           
    &ENDIF
    
    /*Quando ‚ roteiro antecipado sugere dep¢sito padrÆo*/
    if l-vinc-rot-pend then do:
    
        run buscaDepositoPadrao (input RowObject.numero-ordem,
                                 input RowObject.it-codigo,
                                 output tt-rat-lote.cod-depos).
    
    end. 

    run setExecutaEngine in h-boin367 (input not l-deposito).

    run setRecord in h-boin367 ( input table tt-rat-lote ).

    run getFieldsItem in h-boin367 ( RowObject.baixa-ce,
                                     RowObject.quantidade ).

    run emptyRowErrors in h-boin367.
    

    run createRecord in h-boin367.
    

    run getRowErrors in h-boin367 ( output table tt-RowErrorsAux ).
    

    FOR EACH tt-RowErrorsAux NO-LOCK:
        CREATE RowErrors.
        BUFFER-COPY tt-RowErrorsAux TO RowErrors.
    END.
    
    if valid-handle(h-boin367) then do:
        run destroy in h-boin367.
        assign h-boin367 = ?.                
    end.
	
    find first rowErrors no-lock
       where rowErrors.ErrorSubType = "ERROR":U no-error.
    if  avail rowErrors then 
        return "NOK":U.
    else        
        return "OK":U.

END PROCEDURE.

procedure sugereDepositoFDA:
    def input  param piCodEstab     like docum-est.cod-estabel      no-undo.
    def input  param piItem         like item-doc-est.it-codigo     no-undo.
    def input  param piNumeroOrdem  like item-doc-est.numero-ordem  no-undo.
    def output param c-cod-depos like rat-lote.cod-depos            no-undo.
    
    def var showSample	   as logical no-undo.
    def var sampleType	   as integer no-undo.
    def var h-ceapi030     as handle  no-undo.
    def var l-sugere-lote  as log     no-undo.
    def var l-deposito-cq as logical no-undo.
    
    if  not valid-handle(h-boin367) then
        run inbo/boin367.p persistent set h-boin367.

    run setConstraintOfDocumEst in h-boin367 (input RowObject.cod-emitente,
                                              input RowObject.serie-docto,  
                                              input RowObject.nro-docto,
                                              input RowObject.nat-operacao).
                                              
    run openQueryStatic in h-boin367 ( input "OfDocumEst").

    run getDepositoCQ in h-boin367 ( output l-deposito-cq ).
    
    if not valid-handle(h-ceapi030) then
        run cep/ceapi030.p persistent set h-ceapi030 (input table tt-dados-fda,
                                                      output table tt-valores,
                                                      output table tt-erro).
    run pi-param-esp in h-ceapi030 (input piItem,
                                    input "",
                                    input piCodEstab,
                                    output l-sugere-lote,
                                    output showSample,
                                    output sampleType).

    if showSample then do:
       run buscaDepositoPadrao (input  piNumeroOrdem,
                                input  piItem,
                                output c-cod-depos).
    end.
    else do: 
       run getDepositoCQ in h-boin367 ( output l-deposito-cq ).
       if l-deposito-cq then 

       FIND FIRST item-uni-estab
            WHERE item-uni-estab.it-codigo = piItem
              AND item-uni-estab.cod-estabel = piCodEstab NO-LOCK NO-ERROR.

       if l-deposito-cq and avail item-uni-estab and item-uni-estab.contr-qualid then 
          run buscaDepositoCQ (output c-cod-depos).
       else
          run buscaDepositoPadrao (input piNumeroOrdem,
                                   input piItem,
                                   output c-cod-depos).
    end.
        

    if valid-handle(h-ceapi030) then
        delete procedure h-ceapi030.
end procedure.

procedure buscaDepositoCQ:
    def output param c-cod-depos-cq like rat-lote.cod-depos no-undo.
    
    &IF '{&bf_mat_versao_ems}' >= '2.062' &THEN
       DEFINE VARIABLE c-unid-neg-aux AS CHARACTER  NO-UNDO.
    
       if not valid-handle(h-cdapi024) 
           or h-cdapi024:type <> "PROCEDURE"
           or h-cdapi024:file-name <> "cdp/cdapi024.p" then do:
           run cdp/cdapi024.p persistent set h-cdapi024.
       end.
    
           /*Se a UN nÆo foi informada no item do documento,
           buscar  unidade de neg¢cio do relacionamento ITEM X ESTABELECIMENTO X DEPàSITO,
           se nÆo existir, retornar  UN do relacionamento ITEM X ESTABELECIMENTO. */
           if RowObject.cod-unid-negoc = "" then do:
        
               if valid-handle(h-cdapi024) then 
                   run RetornaUnidadeNegocioExternaliz in h-cdapi024 (input docum-est.cod-estabel,
                                                                      input RowObject.it-codigo,
                                                                      input RowObject.cod-depos,
                                                                      output c-unid-neg-aux).
           end.
           else
               assign c-unid-neg-aux = RowObject.cod-unid-negoc.
        
           /*Relacionamento entre UN e Estabel, para determina‡Æo dos dep¢sitos,
           se nÆo encontrar, utilizar  o dep¢sito informado para o estabelecimento*/
           find first unid-negoc-cq
               where unid-negoc-cq.cod-estabel    = docum-est.cod-estabel
               and   unid-negoc-cq.cod-unid-negoc = c-unid-neg-aux no-lock no-error.
           if avail unid-negoc-cq then
               assign c-cod-depos-cq = unid-negoc-cq.cod-depos-cq.
           else
               assign c-cod-depos-cq = estabelec.deposito-cq.
               
        
        if valid-handle(h-cdapi024) then do:
            delete procedure h-cdapi024.
            assign h-cdapi024 = ?.
        end.
    &else
        assign c-cod-depos-cq = estabelec.deposito-cq.
    &endif
end procedure.
procedure buscaDepositoPadrao:
   def input  param piNumeroOrdem  like item-doc-est.numero-ordem  no-undo.
   def input  param piItem         like item-doc-est.it-codigo     no-undo.
   def output param piCodDepos      like item.deposito-pad          no-undo.
   
   find first item 
        where item.it-codigo = piItem no-lock no-error.
        
   find first item-uni-estab
        where item-uni-estab.it-codigo   = piItem
        and   item-uni-estab.cod-estabel = estabelec.cod-estabel no-lock no-error.
        
   if  piNumeroOrdem <> 0 then
       for first ordem-compra fields ( numero-ordem dep-almoxar )
           where ordem-compra.numero-ordem = piNumeroOrdem no-lock.
       end.
        
    assign piCodDepos   = if  avail ordem-compra
                              then ordem-compra.dep-almoxar
                              else if  avail item-uni-estab
                                   then item-uni-estab.deposito-pad
                                   else item.deposito-pad.
end procedure.

procedure gravaDataCorteCQ:
/*------------------------------------------------------------------------------ 
  Purpose:
  Parameters:  <none>
  Notes: Gravar valor do campo "Roteiro CQ At²" para gera»’o automÿtica da rat-lote
         com base nos roteiros digitados no CQ0240.

------------------------------------------------------------------------------*/

def input parameter p-data as date no-undo.

assign d-data-corte-cq = p-data.

end procedure.




