PROCEDURE beforeCopyBuffer2TT :
/*------------------------------------------------------------------------------
  Purpose:
  Parameters:
  Notes:       
------------------------------------------------------------------------------*/
   
  IF lAgrupaPorItem THEN DO:
     if i-cont < 1 then ASSIGN cLastItem = "?".
     assign i-cont = i-cont + 1.

     repeat while (item-doc-est.it-codigo = cLastItem):
       get next qr{&TableName}.

       if not avail item-doc-est then do:
          get last qr{&TableName}.
          leave.
       end.
     end.

     ASSIGN cLastItem = item-doc-est.it-codigo.
     if (i-cont = 1) then
       ASSIGN cLastItem = "?".
     /* o browser sempre encontra o 1õ registro (que ² branco) e depois traz os registros do browser */
     /* coloquei esse if para que o primeiro item da quey seja ignorado */
  END.

  return "OK".
END PROCEDURE.




PROCEDURE beforeDestroy :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:  Elimina a BOs da mem½ria.      
------------------------------------------------------------------------------*/

    if  valid-handle (h-boin404re) then do:
        delete procedure h-boin404re.
        assign h-boin404re = ?.
    end.

    if  valid-handle (h-boin090) then do:
        delete procedure h-boin090.
        assign h-boin090 = ?.
    end.
    
    if  valid-handle (h_bodi317im2bra) then do:
        delete procedure h_bodi317im2bra.
        assign h_bodi317im2bra = ?.
    end.
    
    if  valid-handle (h-bodi613calc2) then do:
        delete procedure h-bodi613calc2.
        assign h-bodi613calc2 = ?.
    end.
    
    if  valid-handle (h-cdcfgfiscal) then do:
        delete procedure h-cdcfgfiscal.
        assign h-cdcfgfiscal = ?.
    end.

    if  valid-handle (h-boin367) then do:
        delete procedure h-boin367.
        assign h-boin367 = ?.
    end.

    if  valid-handle (h-boin010) then do:
        delete procedure h-boin010.
        assign h-boin010 = ?.
    end.

    if  valid-handle (h-boin006) then do:
        delete procedure h-boin006.
        assign h-boin006 = ?.
    end.

    if  valid-handle (h-cd4337) then do:
        delete procedure h-cd4337.
        assign h-cd4337 = ?.
    end.

    if  valid-handle (h-cd4338) then do:
        delete procedure h-cd4338.
        assign h-cd4338 = ?.
    end.

    if  valid-handle (h-boiv029) then do:
        delete procedure h-boiv029.
        assign h-boiv029 = ?.
    end.

    if  valid-handle (h_api_ccusto) then do:
        delete object h_api_ccusto.
        assign h_api_ccusto = ?.
    end.
    if  valid-handle (h_api_cta_ctbl) then do:
        delete object h_api_cta_ctbl.
        assign h_api_cta_ctbl = ?.
    end.   
    
    if  valid-handle (h-cdapi034) then do:
        delete procedure h-cdapi034.
        assign h-cdapi034 = ?.
    end.  

    return "OK":U.
    
