PROCEDURE beforeUpdateRecord :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: Desaloca ordem de compra e saldo em poder de terceiros.      
------------------------------------------------------------------------------*/
    DEF VAR h-boin404      AS HANDLE     NO-UNDO.

    for first b-item-doc-est
        fields ( cod-emitente  serie-docto  nro-docto     
                 nat-operacao  sequencia    dec-1
                 quantidade )
         where b-item-doc-est.cod-emitente = RowObject.cod-emitente
           and b-item-doc-est.serie-docto  = RowObject.serie-docto
           and b-item-doc-est.nro-docto    = RowObject.nro-docto
           and b-item-doc-est.nat-operacao = RowObject.nat-operacao
           and b-item-doc-est.sequencia    = RowObject.sequencia 
           no-lock: end.

    run getFatAntecipEntFutura (input  RowObject.nat-operacao,
                                output l-fatura-fat-antecip,
                                output l-remessa-fat-antecip,
                                output l-fatura-ent-futura,
                                output l-remessa-ent-futura).
        
    /* Se for remessa de faturamento antecipado:
       Diminui a quantidade do documento a qtd-receb-fisic da sdo-fatur-antecip (bodi578) */
    IF  l-remessa-fat-antecip THEN DO:
        IF NOT VALID-HANDLE(h-bodi578) THEN
            RUN dibo/bodi578.p PERSISTENT SET h-bodi578.
        
        RUN atualizaSaldoFisicoItem IN h-bodi578 (input b-item-doc-est.seq-comp,
                                                  input "",
                                                  input "",
                                                  input "",
                                                  input 0,
                                                  input "",
                                                  input "",
                                                  input 0,
                                                  input (b-item-doc-est.quantidade * -1)).       
        DELETE PROCEDURE h-bodi578.          
    END.    
   

    /* Desaloca»’o Saldo Terceiros */
    if  natur-oper.tp-oper-terc = 2           /* Retorno Beneficiamento */
    or  natur-oper.tp-oper-terc = 4           /* Faturamento Consignacao  */
    or  natur-oper.tp-oper-terc = 5           /* Devolucao Consignacao  */
    or  natur-oper.tp-oper-terc = 9           /* Retorno Dep Fechado */
    or  natur-oper.tp-oper-terc = 11 then do: /* Retorno Armaz Geral */

        find saldo-terc 
            where saldo-terc.cod-emitente = RowObject.cod-emitente
              and saldo-terc.nro-docto    = RowObject.nro-comp
              and saldo-terc.serie-docto  = RowObject.serie-comp
              and saldo-terc.nat-operacao = RowObject.nat-comp
              and saldo-terc.it-codigo    = RowObject.it-codigo
              and saldo-terc.cod-refer    = RowObject.cod-refer
              and saldo-terc.sequencia    = RowObject.seq-comp
            exclusive-lock no-error.

        if  avail saldo-terc 
        and avail item-doc-est then do:

            /* Devolu‡Æo Simbolica Consigna‡Æo */
            IF  {cdp/cd0066.i2 saldo-terc.cod-estabel}
            AND natur-oper.tp-oper-terc = 4 THEN DO: /* Faturamento Consignacao  */
                RUN inbo/boin404.p PERSISTENT SET h-boin404.
                RUN updateFifoDevolucaoSimbolica
                            IN h-boin404 (YES,
                                          NO,
                                          ROWID(saldo-terc),
                                          item-doc-est.quantidade).
                DELETE PROCEDURE h-boin404.
            end.
            else do:
                /* Desaloca */
                assign saldo-terc.dec-1   = saldo-terc.dec-1 - b-item-doc-est.quantidade
                       saldo-terc.dec-1   = if  saldo-terc.dec-1 < 0 
                                            then 0 
                                            else saldo-terc.dec-1.
                release saldo-terc. 
            end.
        end.   
    end.
    
    /*Altera‡Æo dos registros dos codigos de ajuste - CD4035*/
    run beforeUpdateNotaFiscAdc (INPUT RowObject.serie-docto, 
                                 INPUT RowObject.nro-docto,   
                                 INPUT RowObject.cod-emitente,
                                 INPUT RowObject.nat-operacao,
                                 INPUT RowObject.sequencia,
                                 INPUT RowObject.nat-of).
    
    return "OK":U.

END PROCEDURE.

PROCEDURE beforeValidateBoin060 :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:  Instancia e elimina boin060 na memoria.      
------------------------------------------------------------------------------*/
    define input param i-boin060 as integer no-undo. 
    
    if i-boin060 = 1 then do:  /* 1 - Instancia */
        if  not valid-handle(h-boin060)
        or  h-boin060:type      <> "PROCEDURE":U
        or  h-boin060:file-name <> "inbo/boin060.p":U then
        run inbo/boin060.p persistent set h-boin060.
    end.
    else do: /* 2 - Elimina */
        delete procedure h-boin060 no-error.
        assign h-boin060 = ?.
    end.
        
    return "OK":U.

END PROCEDURE.

PROCEDURE beforeUpdateNotaFiscAdc :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: Altera‡Æo dos registros dos codigos de ajuste - CD4035 
------------------------------------------------------------------------------*/

    DEFINE INPUT PARAMETER pserie-docto  LIKE item-doc-est.serie-docto  NO-UNDO.
    DEFINE INPUT PARAMETER pnro-docto    LIKE item-doc-est.nro-docto    NO-UNDO.
    DEFINE INPUT PARAMETER pcod-emitente LIKE item-doc-est.cod-emitente NO-UNDO.
    DEFINE INPUT PARAMETER pnat-operacao LIKE item-doc-est.nat-operacao NO-UNDO.
    DEFINE INPUT PARAMETER psequencia    LIKE item-doc-est.sequencia    NO-UNDO. 
    DEFINE INPUT PARAMETER pnat-of       LIKE item-doc-est.nat-of       NO-UNDO.

    IF NOT AVAIL docum-est THEN
       for first docum-est no-lock
           where docum-est.serie-docto  = pserie-docto 
             and docum-est.nro-docto    = pnro-docto   
             and docum-est.cod-emitente = pcod-emitente
             and docum-est.nat-operacao = pnat-operacao: end.    

    for first b-item-doc-est no-lock
        where b-item-doc-est.serie-docto  = pserie-docto 
          and b-item-doc-est.nro-docto    = pnro-docto
          and b-item-doc-est.cod-emitente = pcod-emitente
          and b-item-doc-est.nat-operacao = pnat-operacao
          and b-item-doc-est.sequencia    = psequencia: end.         
    
    IF AVAIL docum-est AND 
       AVAIL b-item-doc-est AND 
       CAN-FIND(FIRST nota-fisc-adc NO-LOCK
                WHERE nota-fisc-adc.cod-estab         = docum-est.cod-estabel
                  AND nota-fisc-adc.cod-serie         = b-item-doc-est.serie-docto 
                  AND nota-fisc-adc.cod-nota-fisc     = b-item-doc-est.nro-docto   
                  AND nota-fisc-adc.cdn-emitente      = b-item-doc-est.cod-emitente
                  AND nota-fisc-adc.cod-natur-operac <> pnat-of
                  AND nota-fisc-adc.idi-tip-dado      = 7
                  AND nota-fisc-adc.cod-item          = b-item-doc-est.it-codigo
                  AND nota-fisc-adc.num-livre-1       = b-item-doc-est.sequencia) THEN DO:
        
        IF NOT VALID-HANDLE(h-bodi515) THEN
           RUN dibo/bodi515.p PERSISTENT SET h-bodi515.
        RUN openQueryStatic IN h-bodi515 (INPUT "Main":U).
        
        FOR EACH nota-fisc-adc NO-LOCK
           WHERE nota-fisc-adc.cod-estab         = docum-est.cod-estabel
             AND nota-fisc-adc.cod-serie         = b-item-doc-est.serie-docto
             AND nota-fisc-adc.cod-nota-fisc     = b-item-doc-est.nro-docto
             AND nota-fisc-adc.cdn-emitente      = b-item-doc-est.cod-emitente
             AND nota-fisc-adc.cod-natur-operac <> pnat-of
             AND nota-fisc-adc.idi-tip-dado      = 7
             AND nota-fisc-adc.cod-item          = b-item-doc-est.it-codigo
             AND nota-fisc-adc.num-livre-1       = b-item-doc-est.sequencia:
             
            RUN goToKey IN h-bodi515 (INPUT nota-fisc-adc.cod-estab,
                                      INPUT nota-fisc-adc.cod-serie,
                                      INPUT nota-fisc-adc.cod-nota-fisc,
                                      INPUT nota-fisc-adc.cdn-emitente,
                                      INPUT nota-fisc-adc.cod-natur-operac,
                                      INPUT 7, 
                                      INPUT nota-fisc-adc.num-seq).
            IF RETURN-VALUE = "OK":U THEN
                RUN deleteRecord IN h-bodi515.
        END.
        
        IF VALID-HANDLE(h-bodi515) THEN
           DELETE PROCEDURE h-bodi515.
    END.
        
    return "OK":U.

END PROCEDURE.
