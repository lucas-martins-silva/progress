/********************************************************************************
**
**  tratarFormulaIndice: Verificar se a f¢rmula est† correta e n∆o possui
**                       recursividade.
**
*********************************************************************************/

def temp-table tt-var-formul NO-UNDO
    field cod-var-formul    as char format "x(8)" 
    field de-val-var-formul as dec  format "->>>,>>>,>>9.99999" decimals 5.

def temp-table tt-ind-compon NO-UNDO
    field num-seq        as int
    field cod-visao      as char
    field cod-var-formul as char 
    index id     is unique primary num-seq
    index indice                   cod-visao cod-var-formul.

def var i-num-seq as int no-undo.
def var i-cd-erro as int no-undo. 

PROCEDURE tratarFormulaIndice:

    def input  param c-cod-visao    like ind-vis-man.cod-visao   no-undo.
    def input  param c-cod-ind-calc like ind-vis-man.cod-ind-int no-undo.
    def input  param c-formula      like ind-vis-man.formula     no-undo.
    def output param table for tt-bo-erro.
    
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    
    def var l-erro            as log no-undo.
    def var de-result-formula as dec no-undo.
    
    /*** Elimina todos os °ndices componentes ***/
    for each est-ind-man
        where est-ind-man.cod-visao    = c-cod-visao 
          and est-ind-man.cod-ind-calc = c-cod-ind-calc EXCLUSIVE-LOCK :
        delete est-ind-man.
    end.
    
    /*** Identifica componentes da f¢rmula e gera tempor†ria tt-var-formul ***/

    run smf/sm9001.p (input c-formula,
                      output table tt-var-formul).

    /*** Verificaá∆o dos componentes da f¢rmula ***/
    
    run verificarComponentesFormula (input c-cod-visao,
                                     output l-erro).
    if  l-erro = yes then do:
        run criarErroRetorno (input 18040).
        return.
    end.

    run verificarRecursividadeFormula (input c-cod-visao,
                                       input c-cod-ind-calc,
                                       output l-erro).
    if  l-erro = yes then do:
        run criarErroRetorno (input 18039).
        return.
    end.

    for each tt-var-formul:
        assign tt-var-formul.de-val-var-formul = 1.
    end.

    /* Faz um teste e verifica se a f¢rmula est† correta */
    if  c-formula <> "" then do:
        assign de-result-formula = 0.
        run smf/sm9002.p (input table tt-var-formul,
                          input c-formula,
                          input-output de-result-formula,
                          output i-cd-erro).

        if  i-cd-erro <> 0 then do:
            run criarErroRetorno (input i-cd-erro).
            return.
        end.
    end.
    
    /*** Gera estrutura do °ndice ***/
    
    for each tt-var-formul:
        create est-ind-man.
        assign est-ind-man.cod-visao           = c-cod-visao
               est-ind-man.cod-ind-calc        = c-cod-ind-calc
               est-ind-man.cod-ind-comp        = tt-var-formul.cod-var-formul

               /*** atualiza o valor do resulta do f¢rmula com 1 para realizar teste de sintaxe. ***/

               tt-var-formul.de-val-var-formul = 1.
    end.
END PROCEDURE.

PROCEDURE verificarComponentesFormula:

    def input  param c-cod-visao as char no-undo.
    def output param l-erro      as log  no-undo.

    assign l-erro = no.

    for each tt-var-formul:

        find ind-vis-man
            where ind-vis-man.cod-visao   = c-cod-visao
              and ind-vis-man.cod-ind-int = tt-var-formul.cod-var-formul no-lock no-error.
        if  avail ind-vis-man then do:
        
            find tt-ind-compon
                where tt-ind-compon.cod-visao      = c-cod-visao
                  and tt-ind-compon.cod-var-formul = tt-var-formul.cod-var-formul no-lock no-error.

            /*** Gera tt p/ verificaá∆o da recursividade da f¢rmula ***/
            if  not avail tt-ind-compon then do:
                create tt-ind-compon.
                assign tt-ind-compon.num-seq        = i-num-seq 
                       tt-ind-compon.cod-visao      = c-cod-visao
                       tt-ind-compon.cod-var-formul = tt-var-formul.cod-var-formul
                       i-num-seq                    = i-num-seq + 1.
            end.
        end.
        else /*** Componente da f¢rmula n∆o identificado ***/
            assign l-erro = yes.
    end.

END PROCEDURE.

PROCEDURE verificarRecursividadeFormula:

    def input  param c-cod-visao    as char no-undo.
    def input  param c-cod-ind-calc as char no-undo.
    def output param l-erro         as log  no-undo.

    def buffer b-tt-ind-compon for tt-ind-compon.

    assign l-erro = no.

    for each tt-ind-compon:
    
        for each est-ind-man
            where est-ind-man.cod-visao    = c-cod-visao
              and est-ind-man.cod-ind-calc = tt-ind-compon.cod-var-formul no-lock:
            
            find b-tt-ind-compon
                where b-tt-ind-compon.cod-visao      = c-cod-visao
                  and b-tt-ind-compon.cod-var-formul = est-ind-man.cod-ind-comp no-error.
            if  not avail b-tt-ind-compon then do:
                create b-tt-ind-compon.
                assign b-tt-ind-compon.num-seq        = i-num-seq 
                       b-tt-ind-compon.cod-visao      = c-cod-visao
                       b-tt-ind-compon.cod-var-formul = est-ind-man.cod-ind-comp
                       i-num-seq                      = i-num-seq + 1.
            end.
        end.
    end.

    /*** Verifica se a f¢rmula possui recursividade ***/
    find tt-ind-compon
        where tt-ind-compon.cod-visao      = c-cod-visao 
          and tt-ind-compon.cod-var-formul = c-cod-ind-calc no-error.
    if  avail tt-ind-compon then 
        assign l-erro = yes.

END PROCEDURE.

PROCEDURE criarErroRetorno:

    def input param p-cd-erro as int no-undo.

    create tt-bo-erro.
    assign i-seq-erro            = i-seq-erro + 1
           tt-bo-erro.i-sequen   = i-seq-erro
           tt-bo-erro.cd-erro    = p-cd-erro
           tt-bo-erro.parametros = ''.

    run utp/ut-msgs.p (input "msg",
                       input p-cd-erro,
                       input '').
    assign tt-bo-erro.mensagem = return-value.

END PROCEDURE.
