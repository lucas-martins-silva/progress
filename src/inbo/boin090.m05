PROCEDURE findFirstChave:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: 
------------------------------------------------------------------------------*/
          
    /* Seguran‡a por estabelecimento */
    IF l-estab-security-active THEN
        FIND FIRST {&TableName} 
             WHERE {&TABLENAME}.serie-docto  = cSerie
               AND {&TABLENAME}.nro-docto    = cDocto
               AND {&TABLENAME}.cod-emitente = cEmitente
               AND {&TABLENAME}.nat-operacao = cNatOperacao
               AND CAN-FIND(FIRST {&ESTAB-SEC-TT} 
                            WHERE {&ESTAB-SEC-TT-FIELD} = {&TABLENAME}.cod-estabel) NO-LOCK NO-ERROR.    
    ELSE
        FIND FIRST {&TableName} 
             WHERE {&TABLENAME}.serie-docto  = cSerie
               AND {&TABLENAME}.nro-docto    = cDocto
               AND {&TABLENAME}.cod-emitente = cEmitente
               AND {&TABLENAME}.nat-operacao = cNatOperacao NO-LOCK NO-ERROR. 
               
     RETURN "OK":U.
     
END PROCEDURE.


