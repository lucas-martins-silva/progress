
find op-sfc where
     op-sfc.nr-ord-produ = oper-ord.nr-ord-produ and 
     op-sfc.ind-estado-op   > 1 and
     op-sfc.ind-estado-op   < 4 no-lock no-error.


if not available op-sfc then 
    next.
   

/*** Tenta encontrar split iniciado para o centro de trabalho ***/ 
find first split-operac
     where split-operac.nr-ord-produ     = oper-ord.nr-ord-produ
       and split-operac.num-operac-sfc   = oper-ord.num-operac-sfc
       and split-operac.cod-ctrab        = p-cod-ctrab
       and split-operac.ind-estado-split = 4 no-lock no-error.
       

/*** Tenta encontrar split liberado para o centro trabalho ***/
if not avail split-operac then 
    find first split-operac
        where split-operac.nr-ord-produ     = oper-ord.nr-ord-produ
          and split-operac.num-operac-sfc   = oper-ord.num-operac-sfc
          and split-operac.ind-estado-split = 3 
          and (split-operac.cod-ctrab        = ""  
            or split-operac.cod-ctrab        = p-cod-ctrab) no-lock no-error.
            
if l-mudancas-sfc = no then do:
   /*Se o Novo Chao de Fabrica estiver implantado, nÆo ir  verificar splits j  alocados, nem splits finalizados*/

   /*** Tenta encontrar Split alocado em outra m quina ***/
   if not available split-operac then 
        find first split-operac
             where split-operac.nr-ord-produ     = oper-ord.nr-ord-produ
               and split-operac.num-operac-sfc   = oper-ord.num-operac-sfc
               and split-operac.ind-estado-split >= 3 
               and split-operac.ind-estado-split <= 4 /*no-lock*/ no-error.
          
   /*** Tenta encontrar split finalizado ***/
   if not available split-operac then 
        find first split-operac 
             where split-operac.nr-ord-produ     = oper-ord.nr-ord-produ
               and split-operac.num-operac-sfc   = oper-ord.num-operac-sfc 
               and split-operac.ind-estado-split = 5 NO-LOCK no-error.
end.

