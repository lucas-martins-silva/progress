&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE setChangeSituacao DBOProgram 
PROCEDURE setChangeSituacao :
/*------------------------------------------------------------------------------
  Purpose:     Atualiza a situa»’o
  Parameters:  
               recebe valor do campo ep-codigo
               recebe valor do campo cod-estabel
               recebe valor do campo cod-tip-doc
               recebe valor do campo chave-doc
               recebe valor do cmapo ind-situacao
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pep-codigo   LIKE mla-doc-sit.ep-codigo NO-UNDO.
    DEFINE INPUT PARAMETER pcod-estabel LIKE mla-doc-sit.cod-estabel NO-UNDO.
    DEFINE INPUT PARAMETER pcod-tip-doc LIKE mla-doc-sit.cod-tip-doc NO-UNDO.
    DEFINE INPUT PARAMETER pchave-doc LIKE mla-doc-sit.chave-doc NO-UNDO.
    DEFINE INPUT PARAMETER pind-situacao LIKE mla-doc-sit.ind-situacao NO-UNDO.

    FIND FIRST bfmla-doc-sit WHERE 
        bfmla-doc-sit.ep-codigo = pep-codigo AND
        bfmla-doc-sit.cod-estabel = pcod-estabel AND
        bfmla-doc-sit.cod-tip-doc = pcod-tip-doc AND 
        bfmla-doc-sit.chave-doc = pchave-doc EXCLUSIVE-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro serÿ retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfmla-doc-sit THEN 
        RETURN "NOK":U.
    ELSE
        ASSIGN bfmla-doc-sit.ind-situacao = pind-situacao.

    RETURN "OK":U.
END PROCEDURE.

