&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram  
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice cod-layout-pk
  Parameters:  
               recebe valor do campo cod-layout
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-layout LIKE layout-restdo-analis.cod-layout NO-UNDO.

    FIND FIRST bflayout-restdo-analis WHERE 
        bflayout-restdo-analis.cod-layout = pcod-layout NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bflayout-restdo-analis THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bflayout-restdo-analis)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    DEFINE VARIABLE c-erro-texto AS CHARACTER NO-UNDO.

    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/

    IF pType = "Create":U THEN DO: /*teste somente para criaá∆o*/

        IF CAN-FIND (FIRST {&TableName} WHERE {&TableName}.cod-layout = RowObject.cod-layout) THEN DO:
            {utp/ut-liter.i "Layout_Resultado_An†lise_CQ" *}
            ASSIGN c-erro-texto = RETURN-VALUE.
            {METHOD/svc/errors/inserr.i &ErrorNumber="1"                             
                                        &ErrorType="EMS"
                                        &ErrorParameters="c-erro-texto"}
        END.
    
    END.

    IF pType = "Create":U OR pType = "Update":U THEN DO: /*teste para criaá∆o e alteraá∆o*/

        IF NOT CAN-FIND(FIRST emitente WHERE emitente.cod-emitente = RowObject.cdn-lab) THEN DO: /*testa existància do laborat¢rio*/
            {utp/ut-liter.i "Laborat¢rio" *}
            ASSIGN c-erro-texto = RETURN-VALUE.
            {METHOD/svc/errors/inserr.i &ErrorNumber="47"                             
                                        &ErrorType="EMS"                             
                                        &ErrorParameters="c-erro-texto"}
        END.

        IF RowObject.cod-layout = "":U THEN DO:
            {utp/ut-liter.i "C¢digo_do_layout" *}
            ASSIGN c-erro-texto = RETURN-VALUE.
            {METHOD/svc/errors/inserr.i &ErrorNumber="3145"                             
                                        &ErrorType="EMS"
                                        &ErrorParameters="c-erro-texto"}
        END.

        IF RowObject.des-layout = "":U THEN DO:
            {METHOD/svc/errors/inserr.i &ErrorNumber="190"                             
                                        &ErrorType="EMS"}
        END.

        IF RowObject.cod-separador = "":U THEN DO:
            {utp/ut-liter.i "Separador" *}
            ASSIGN c-erro-texto = RETURN-VALUE.
            {METHOD/svc/errors/inserr.i &ErrorNumber="3145"                             
                                        &ErrorType="EMS"
                                        &ErrorParameters="c-erro-texto"}
        END.

        IF RowObject.cod-separador = ",":U OR RowObject.cod-separador = ".":U THEN DO:
            ASSIGN c-erro-texto = "',' e '.'.".
            {METHOD/svc/errors/inserr.i &ErrorNumber="54719"                             
                                        &ErrorType="EMS"                             
                                        &ErrorParameters="c-erro-texto"}
        END.

    END.

    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


