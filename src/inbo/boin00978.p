PROCEDURE beforeDeleteRecord :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
  FOR EACH layout-restdo-analis-col EXCLUSIVE-LOCK 
      WHERE layout-restdo-analis-col.cod-layout  = RowObject.cod-layout:
        DELETE layout-restdo-analis-col.
  END.

  RETURN "OK":U.

END PROCEDURE.

