PROCEDURE verificaColuna :
/*------------------------------------------------------------------------------
  Purpose:    verificar se o layout selecionado pelo usu·rio possui colunas  
  Parameters: cÛdigo do layout
  Notes:      utilizado no cq0241
------------------------------------------------------------------------------*/
    DEF INPUT PARAMETER pCodLayout LIKE RowObject.cod-layout NO-UNDO.

    FOR FIRST layout-restdo-analis-col WHERE layout-restdo-analis-col.cod-layout = pCodLayout NO-LOCK: END.
