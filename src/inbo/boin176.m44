PROCEDURE validateRecord : 
/*------------------------------------------------------------------------------
  Purpose:     Valida‡äes pertinentes ao DBO
  Parameters:  recebe o tipo de valida‡Æo (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    def var c-un  like item-doc-est.un          no-undo.
    DEF VAR h-boin404              as handle    no-undo.
    DEF VAR deQtde                 as decimal   no-undo.
    DEF VAR deQtdeItem             as decimal   no-undo.
    def var c-lb-unidade           as char      no-undo.
    def var c-lb-item              as char      no-undo.
    def var c-lb-emitente          as char      no-undo.
    DEF VAR c-lb-msg               as char      no-undo.
    def var c-lbl-pf               as char      no-undo.
    def var c-lbl-cfop-saida       as char      no-undo.
    def var l-sem-pedido           as log       no-undo.
    def var l-erro-ordens-embarque as log       no-undo.
    def var l-erro-refer           as log       no-undo.
    
    for first para-fat fields ( char-1  nr-item-nota ) no-lock: end.            

    /*--- Utilize o parƒmetro pType para identificar quais as valida‡äes a serem executadas ---*/
    /*--- Os valores poss¡veis para o parƒmetro sÆo: Create, Delete e Update ---*/
    /*--- Devem ser tratados erros PROGRESS e erros do Produto, atrav‚s do include: method/svc/errors/inserr.i ---*/
    /*--- Inclua aqui as valida‡äes ---*/

    assign c-tipo = pType
           l-passou = YES.

    run findParamGlobal.

    /***** Leitura Docum-est *****/
    run findDocumento ( RowObject.cod-emitente,
                        RowObject.serie-docto,
                        RowObject.nro-docto,
                        RowObject.nat-operacao ).

    if  return-value <> "OK":U then
        return "NOK":U.
    

    if  docum-est.ce-atual then do:
        {method/svc/errors/inserr.i
                            &ErrorNumber="19515" /*Nota fiscal j˜ atualizada*/
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR" }
    end.        

    /* Valida se a natureza fiscal informada para Item ‚ existente... */
    IF  pType <> "DELETE":U AND l-mult-natur-receb AND RowObject.nat-of <> "" THEN DO:
        FIND FIRST b-natur-oper-item NO-LOCK 
             WHERE b-natur-oper-item.nat-operacao = RowObject.nat-of NO-ERROR.
        IF NOT AVAILABLE b-natur-oper-item THEN DO:
            {method/svc/errors/inserr.i 
                    &ErrorNumber  = 52830    /* msg: A natureza fiscal informada para o item nÆo foi encontrada */
                    &ErrorType    = "EMS":U  /* help: Informe uma natureza fiscal v lida para o item */
            	    &ErrorSubType = "ERROR":U}
            RETURN "NOK":U.  
        END.      
            
        IF  AVAILABLE b-natur-oper-item
        AND b-natur-oper-item.nat-ativa = NO THEN DO:
            {method/svc/errors/inserr.i 
                    &ErrorNumber  = 26759    /* msg: Natureza de opera‡Æo inativa */
                    &ErrorType    = "EMS":U  
            	    &ErrorSubType = "ERROR":U}
            RETURN "NOK":U.  
        END.                
    END.  
    
    /**************** EPC utilizada pela Grendene ***************/
    /**************** Rodado no add, mod e del ******************/
    {method/svc/custom/custom.i &Event = "validateRecord"}
    /************************************************************/

    /*=========== SuperGasbras/MinasGÿs ===========*/                           
    ASSIGN i-nr-linhas-nota = if avail para-fat then para-fat.nr-item-nota else ?.

    &IF DEFINED(BF_dis_param_estab) &THEN
        IF CAN-FIND(funcao WHERE
                    funcao.cd-funcao = "fn-estab-nr-linhas-nota" AND
                    funcao.ativo     = YES) THEN DO:

           RUN cdp/cd8701.p (INPUT docum-est.cod-estabel,
                             INPUT-OUTPUT i-nr-linhas-nota).
        END.
    &ENDIF
   /*==============================================*/
   
    IF pType = "Update"
    OR pType = "delete" THEN DO:
        IF NOT docum-est.rec-fisico AND
           (docum-est.ind-sit-wms-ext  <> 0 and /*Digitada*/
            docum-est.ind-sit-wms-ext  <> 1 and /*NÆo Integra*/
            docum-est.ind-sit-wms-ext  <> 5 and /*Conferencia NOK*/
            docum-est.ind-sit-wms-ext  <> 6) then do: /*Inativado*/
            {method/svc/errors/inserr.i &ErrorNumber="57473"
                                        &ErrorType="EMS"
                                        &ErrorSubType="ERROR" }
            return "NOK".
        END.
    END.

    IF  pType <> "DELETE":U THEN DO: 
        if  RowObject.usuario <> c-seg-usuario then do:        
            find b-docum-est 
               where b-docum-est.cod-emitente = RowObject.cod-emitente
                 and b-docum-est.serie-docto  = RowObject.serie-docto
                 and b-docum-est.nro-docto    = RowObject.nro-docto
                 and b-docum-est.nat-operacao = RowObject.nat-operacao exclusive-lock no-error.
            if  avail b-docum-est THEN DO:   
                assign b-docum-est.usuario = c-seg-usuario.                                                         
                release b-docum-est.
            END.
        end.

        run initializeFind.

        run getFatAntecipEntFutura (input  RowObject.nat-operacao,
                                    output l-fatura-fat-antecip,
                                    output l-remessa-fat-antecip,
                                    output l-fatura-ent-futura,
                                    output l-remessa-ent-futura).

        IF  (l-fatura-fat-antecip OR l-fatura-ent-futura) /* faturamento antecipado ou entrega futura */
            AND natur-oper.tipo-compra <> 3 THEN DO:      /* e que nÆo seja do tipo compra "Devolu‡Æo Cliente" */
            if  RowObject.ct-codigo = "" then do:
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-conta-contabil-deve-ser-inform AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Conta_cont bil_deve_ser_informada_em_notas_de_fatura_de_entrega_futura" *}
                ASSIGN c-lbl-liter-conta-contabil-deve-ser-inform = TRIM(RETURN-VALUE).
                {method/svc/errors/inserr.i
                                &ErrorNumber="17006"
                                &ErrorType="EMS"
                                &ErrorSubType="ERROR"
                                &ErrorParameters="c-lbl-liter-conta-contabil-deve-ser-inform"}
            end.
        end.

        for first param-estoq
            fields ( char-2 )
            no-lock.
        end.            

        for first param-contrat
            fields ( log-1 )
            no-lock.
        end.                    

        for first param-cp
            fields ( var-requis var-req-menor)
            no-lock.
        end.            

        /***** Leitura Item *****/         
        run findItem ( RowObject.it-codigo ).        

        if  return-value <> "OK":U then
            return "NOK":U.
            
        /***** Leitura Item x Estabelecimento *****/           
        run findItemUniEstab(docum-est.cod-estabel,
                             RowObject.it-codigo).

        if  return-value <> "OK":U then
            return "NOK":U. 

        /***** Leitura Parümetros Usu˜rio Recebimento *****/
        run findUsuario ( docum-est.usuario ).

        /***** Leitura Natureza de Opera¯Êo *****/   
        run findNaturOper ( RowObject.nat-operacao ).    

        /***** Leitura Emitente *****/    
        run findEmitente ( RowObject.cod-emitente ).
        
        find first param-compra no-lock no-error.
        
        /***** Leitura Estabelecimento *****/
        run findEstabelec ( docum-est.cod-estabel ).
        
        /* Verifica se a fun‡Æo Devolu‡Æo Simb¢lica de Consigna‡Æo est  ATIVA */
        IF  {cdp/cd0066.i2 docum-est.cod-estabel} THEN DO:
            
            IF  AVAIL natur-oper AND natur-oper.tp-oper-terc = 4 THEN DO:
                FIND FIRST saldo-terc NO-LOCK
                     WHERE saldo-terc.cod-emitente = RowObject.cod-emitente
                       AND saldo-terc.nro-docto    = RowObject.nro-comp
                       AND saldo-terc.serie-docto  = RowObject.serie-comp
                       AND saldo-terc.nat-operacao = RowObject.nat-comp
                       AND saldo-terc.it-codigo    = RowObject.it-codigo
                       AND saldo-terc.cod-refer    = RowObject.cod-refer
                       AND saldo-terc.sequencia    = RowObject.seq-comp NO-ERROR.
                IF  AVAIL saldo-terc THEN DO:
                    RUN inbo/boin404.p PERSISTENT SET h-boin404.
                    RUN validaFaturamentoSimbolico IN h-boin404 (INPUT  ROWID(saldo-terc),
                                                                 OUTPUT deQtde).
                    DELETE PROCEDURE h-boin404.
                    
                    FIND FIRST b-item-doc-est NO-LOCK
                         WHERE ROWID(b-item-doc-est) = RowObject.r-rowid NO-ERROR.
                    IF  AVAIL b-item-doc-est THEN
                        ASSIGN deQtdeItem = b-item-doc-est.qt-do-forn.
                    ELSE
                        ASSIGN deQtdeItem = 0.

                    IF  RowObject.quantidade > (deQtde + deQtdeItem) THEN DO:
                        IF RowObject.quantidade <> RowObject.qt-do-forn THEN DO:
                           IF RowObject.qt-do-forn > (deQtde + deQtdeItem) THEN DO: /* valida a qtd do fornecedor, que é a qtd que atualiza saldo-terc. */
                              /* Quantidade a Faturar maior que Quantidade Devolvida Simbolicamente  */
                              {method/svc/errors/inserr.i
                                              &ErrorNumber="34985"
                                              &ErrorType="EMS"
                                              &ErrorSubType="ERROR"
                                              &ErrorParameters="TRIM(STRING(RowObject.quantidade,'>>>>>>>>>>9.9999')) + '~~~~' +
                                                                TRIM(STRING((deQtde + deQtdeItem),'>>>>>>>>>>9.9999'))+ '~~~~' +
                                                                TRIM(STRING(RowObject.sequencia))"}
                           END.
                        END.
                        ELSE DO:
                              /* Quantidade a Faturar maior que Quantidade Devolvida Simbolicamente  */
                              {method/svc/errors/inserr.i
                                              &ErrorNumber="34985"
                                              &ErrorType="EMS"
                                              &ErrorSubType="ERROR"
                                              &ErrorParameters="TRIM(STRING(RowObject.quantidade,'>>>>>>>>>>9.9999')) + '~~~~' +
                                                                TRIM(STRING((deQtde + deQtdeItem),'>>>>>>>>>>9.9999'))+ '~~~~' +
                                                                TRIM(STRING(RowObject.sequencia))"}
                        END.
                    END.
                END.
            END.
        END.
        
        /*Verifica se a natureza de rendimento, relacionada ao item existe*/
        IF  SUBSTRING(RowObject.char-2,946,9) <> ""  /*c¢digo natureza de rendimmento*/
        AND NOT CAN-FIND(FIRST natur-rendto 
                        WHERE natur-rendto.cod-natur-rendto = SUBSTRING(RowObject.char-2,946,9)
                          AND NOT natur-rendto.log-inativ) THEN DO:
              {utp/ut-liter.i "Sequˆncia"}
              ASSIGN c-lb-msg = RETURN-VALUE.
              {method/svc/errors/inserr.i
                           &ErrorNumber="56730" /*Natureza de Rendimento nÆo Cadastrada ou inativa! &1*/
                           &ErrorType="EMS"
                           &ErrorSubType="ERROR"
                           &ErrorParameters="c-lb-msg + ': ' + TRIM(STRING(RowObject.sequencia))" }
        END.

        /***** Valida‡äes Somente para CREATE *****/
        IF  pType = "CREATE":U THEN DO:
            RUN validateCreateRecord.

            IF  RETURN-VALUE <> "OK":U THEN
                RETURN "NOK":U.
        END.

       /****** Valida Devolu¯Êo de Cliente ******/
        if  avail docum-est
        and not docum-est.rec-fisico 
        and l-devolucao then
            run validateDevolucao. 
        

        /***** Leitura Classifica¯Êo Fiscal *****/
        run findClassFiscal ( RowObject.class-fiscal ).

        /***** Validaîïes Somente para Modifica¯Êo *****/
    

        if  pType = "Update":U then
            run validateUpdateRecord.     
            
        if  RowObject.nat-terc <> "" then do:
            find first b-natur-oper WHERE
                       b-natur-oper.nat-operacao = RowObject.nat-terc NO-LOCK NO-ERROR.

            if  avail b-natur-oper and
                      b-natur-oper.nat-ativa = no then do:
                {method/svc/errors/inserr.i
                                    &ErrorNumber="26759"
                                    &ErrorType="EMS"
                                    &ErrorSubType="ERROR"
                                    &ErrorParameters=" "}
            end.
        end.

        &IF DEFINED (bf_man_204) &THEN
            IF l-min-mmi = no THEN DO:
                IF  RowObject.num-ord-inv > 0 AND param-global.modulo-in AND RowObject.nr-ord-produ > 0 THEN DO:
                    ASSIGN RowObject.nr-ord-produ = 0.
                    {method/svc/errors/inserr.i
                                       &ErrorNumber="28223" /*Ord Compra relacionada a Ord Investimento nao permite relacionamento com Ord Prod*/
                                       &ErrorType="EMS"
                                       &ErrorSubType="ERROR"}
                   RETURN "NOK":U.
                END.
            END.
         &ENDIF        
        
        /***Verifica narrativa para nota propria****/
        if  natur-oper.imp-nota 
        and item.ind-imp-desc = 7
        and TRIM(RowObject.narrativa) = "":U then do:
           {method/svc/errors/inserr.i
                                       &ErrorNumber="27098"
                                       &ErrorType="EMS"
                                       &ErrorSubType="WARNING"}
        end.
         

        /***** Atualiza os valores *****/
        run determineValueValid.
                
        run executarEngineRecSemPedido (output  l-sem-pedido ).
        
        /*** Ponto Upc - Chamado - THNLU7 ***/

        if  c-nom-prog-upc-mg97 <> "" then do:
             for each  tt-epc
                 where tt-epc.cod-event = "VerificaParamSemPedido":
                 delete tt-epc.
             end.
    
             create tt-epc.
             assign tt-epc.cod-event     = "VerificaParamSemPedido"
                    tt-epc.cod-parameter = "cod-emitente"
                    tt-epc.val-parameter = string(RowObject.cod-emitente).
    
             {include/i-epc201.i "VerificaParamSemPedido"}
    
             for first tt-epc
                 where tt-epc.cod-event     = "VerificaParamSemPedido"
                   AND tt-epc.cod-parameter = "Retorno-SemPedido":
                   
                 assign l-sem-pedido = logical(tt-epc.val-parameter).
                 
             end.
        end.
        
        /*** Fim Ponto Upc ***/

        if  not RowObject.log-1 then do: /* Nao ‚ fifo */
        

            if  RowObject.num-pedido   <> 0 
            or  RowObject.numero-ordem <> 0 then do:
        

                run validatePedidoOrdem.
                

                if  return-value = "NOK" then
                    return "NOK":U.
            end.
            else 
                if  not l-devolucao
                and not l-transf
                and not l-dev-transf
                and (   natur-oper.tp-oper-terc = 3
                     or not natur-oper.terceiros)
                and param-global.modulo-cc
                and not docum-est.rec-fisico 
                and RowObject.numero-ordem = 0 
                AND TRIM(SUBSTR(RowObject.char-2,540,20)) = "" /* Nota1 - explicacao abaixo */
                and not l-sem-pedido
                and not RowObject.log-1        /* Fifo */
                and not CAN-FIND(FIRST rat-ordem-orig-nfe     /* Pasta "Pedidos CC" do conversor NF-e */
                                 WHERE rat-ordem-orig-nfe.ch-acesso-comp-nfe = docum-est.cod-chave-aces-nf-eletro 
                                   AND rat-ordem-orig-nfe.seq-item           = INT(SUBSTRING(RowObject.char-2,832,5))) /* seq item conversor NF-e */
                and not natur-oper.nota-rateio /* Nota Rateio */ 
                and natur-oper.tipo-compra <> 7 /* Cana de A‡£car */
                and natur-oper.tipo-compra <> 9 //Nota Credito/Debito
                then do:

                    IF NOT CAN-FIND(FIRST rat-ordem 
                                    WHERE rat-ordem.cod-emitente = RowObject.cod-emitente
                                      AND rat-ordem.serie-docto  = RowObject.serie-docto
                                      AND rat-ordem.nro-docto    = RowObject.nro-docto
                                      AND rat-ordem.nat-operacao = RowObject.nat-operacao
                                      AND rat-ordem.sequencia    = RowObject.sequencia) THEN DO: 
                        /* Inicio -- Projeto Internacional */
                        DEFINE VARIABLE c-lbl-liter-pedidoordem-2 AS CHARACTER NO-UNDO.
                        {utp/ut-liter.i "Pedido/Ordem" *}
                        ASSIGN c-lbl-liter-pedidoordem-2 = TRIM(RETURN-VALUE).
                        {method/svc/errors/inserr.i
                                        &ErrorNumber="54" /*Deve ser informado Pedido/Ordem de compra*/
                                        &ErrorType="EMS"
                                        &ErrorSubType="ERROR"
                                        &ErrorParameters="c-lbl-liter-pedidoordem-2" }
                    END.

                    /* Nota1: TSWMJQ - o campo contem contrato de originacao de graos, e quando  */
                    /*        preenchido nao deve validar a informacao na rat-ordem.             */
            end.
        end.
        else do:
             assign l-erro-refer = no.
             
             for each rat-ordem no-lock
                where rat-ordem.cod-emitente = RowObject.cod-emitente
                  and rat-ordem.serie-docto  = RowObject.serie-docto
                  and rat-ordem.nro-docto    = RowObject.nro-docto
                  and rat-ordem.nat-operacao = RowObject.nat-operacao
                  and rat-ordem.sequencia    = RowObject.sequencia:
                  
                  for first prazo-compra fields (numero-ordem parcela cod-refer)
                      where prazo-compra.numero-ordem = rat-ordem.numero-ordem
                        and prazo-compra.parcela      = rat-ordem.parcela
                        and prazo-compra.cod-refer   <> RowObject.cod-refer no-lock:
                        
                        {method/svc/errors/inserr.i
                                    &ErrorNumber="56951" /*Referencia da parcela da OC eh diferente do item da nota*/
                                    &ErrorType="EMS"
                                    &ErrorSubType="WARNING"}
                                    
                        assign l-erro-refer = yes.
                  end.
                  if l-erro-refer then leave.
             end.
             
             if can-find(funcao where
                         funcao.cd-funcao = "spp-consist-refer-nf" and
                         funcao.ativo) then do:
                 run beforeValidateBoin060 (input 1). /* Instancia */
                 run updateConsistNota in h-boin060 (RowObject.cod-emitente,
                                                     RowObject.serie-docto,
                                                     RowObject.nro-docto,
                                                     RowObject.nat-operacao,
                                                     RowObject.sequencia,
                                                     not l-erro-refer, /*elimina consit nota*/
                                                     0,
                                                     0,
                                                     56951, /*Referencia da parcela da OC eh diferente do item da nota*/
                                                     2). /*tipo 1=erro 2=advertencia*/
                 run beforeValidateBoin060 (input 2). /* Elimina */ 
             end.
        end.

        /****** Valida Ordem de Producao ******/

        if  RowObject.nr-ord-produ <> 0 then do:
            run validateOrdProd.    
        end.
       

        /****** Valida Conta Contabil ******/
        /*TVCKYR - NÆo validar conta e centro de custo quando a nota for transa‡Æo. Valida‡äes devem ocorrer na atualiza‡Æo da Nota.*/
        if l-transf = no and l-dev-transf = no then  
           run validateContaContabil.


        /* Unidade de Neg¢cio */
        &IF '{&bf_mat_versao_ems}' >= '2.062' &THEN
        
            /*l-mat-unid-negoc -> Param Materiais - Utiliza UN*/
            if l-mat-unid-negoc then do:
                run validateUnidadeNegocio.
            end.
        &ENDIF

        /****** Valida Quantidade ******/
    

        run validateQuantidade ( pType ). 
    

        /****** Valida Unidade de Medida ******/

        if  not can-find(tab-unidade where tab-unidade.un = RowObject.un ) then do:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-unidade-de-medida AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Unidade_de_Medida" *}
            ASSIGN c-lbl-liter-unidade-de-medida = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                                &ErrorNumber="2"
                                &ErrorType="EMS"
                                &ErrorSubType="ERROR"
                                &ErrorParameters="c-lbl-liter-unidade-de-medida" }
        end.
    

        FIND FIRST item-fornec 
             WHERE item-fornec.cod-emitente = docum-est.cod-emitente 
               AND item-fornec.it-codigo    = RowObject.it-codigo
               AND item-fornec.ativo NO-LOCK NO-ERROR.

        /*ATUALIZA UNIDADE DE MEDIDA*/
        assign c-un = if avail item then item.un else "".
        if  avail item-fornec and not l-devolucao and not l-retorno and not l-transf and not l-dev-transf THEN DO:
            ASSIGN c-un = item-fornec.unid-med-for.
        END.
        ELSE DO:
            IF item.tipo-contr = 4 then /* Item Debito Direto */
               assign c-un = item.un.
            else do:
                  IF  item.ind-inf-qtf = NO THEN
                      ASSIGN c-un = item.un.
                  ELSE
                      IF  item.ind-inf-qtf = YES THEN DO: /* Unidade da Famðlia */
                          for first familia fields(familia.un) no-lock
                              where familia.fm-codigo = item.fm-codigo: end.
                          IF  AVAIL familia THEN DO:
                              for first para-ped no-lock: end.
                              &IF '{&bf_dis_versao_ems}' >= '2.09' &THEN
                                IF NOT para-ped.log-usa-fator-item-clien THEN DO:
                              &ELSE
                                IF SUBSTRING(para-ped.char-2,4,3) = 'no' OR SUBSTRING(para-ped.char-2,4,3) = "" THEN DO:
                              &ENDIF
                                  find first item-unid-venda where
                                             item-unid-venda.it-codigo = item.it-codigo and
                                             item-unid-venda.un        = familia.un no-lock no-error.
                                  if avail item-unid-venda then
                                     assign c-un = familia.un.
                              end. /*IF NOT para-ped.log-usa-fator-item-clien*/
                              else do:
                                  for first item-cli where
                                            item-cli.it-codigo       = item.it-codigo and
                                            item-cli.unid-med-cli              = familia.un            and
                                            item-cli.nome-abrev      = emitente.nome-abrev   and
                                            item-cli.log-unid-prefer = yes                   and
                                            item-cli.ind-sit-relac   = 1 no-lock: end.
                                  if  not avail item-cli then
                                      for first item-cli where
                                                item-cli.it-codigo       = item.it-codigo and
                                                item-cli.unid-med-cli              = familia.un            and
                                                item-cli.nome-abrev      = emitente.nome-abrev   and
                                                item-cli.ind-sit-relac   = 1 no-lock: end.
                                  if avail item-cli then
                                     assign c-un = familia.un.
                              end. /*else IF NOT para-ped.log-usa-fator-item-clien*/
                          END.
                      END. /*IF  item.ind-inf-qtf = YES*/
                      ELSE DO: /* Unidade do Faturamento */
                      
                          /*Quando for uma transferencia, localizar o estabelecimento do docum-est e buscar o emitente relacionado ao estabelecimento, 
                            para localizar o cadastrado do item-cli*/
                          if l-transf then do:
                            /***** Leitura Estabelecimento *****/
                            run findEstabelec ( docum-est.cod-estabel ).
                            /***** Leitura do Emitente *****/
                            run findEmitente ( estabelec.cod-emitente ).    
                          end. 
                      
                          for first item-cli fields ( unid-med-cli ) where 
                                    item-cli.it-codigo       = item.it-codigo      and
                                    item-cli.nome-abrev      = emitente.nome-abrev and
                                    item-cli.log-unid-prefer = yes                 and
                                    item-cli.ind-sit-relac   = 1 no-lock: end.
                          if  not avail item-cli then
                              for first item-cli fields ( unid-med-cli ) where
                                        item-cli.it-codigo     = item.it-codigo      and
                                        item-cli.nome-abrev    = emitente.nome-abrev and
                                        item-cli.ind-sit-relac = 1 no-lock: end.
                          
                          if avail item-cli then
                              assign c-un = item-cli.unid-med-cli.
                          
                          /*Busca novamente o emitente da docum-est*/
                          if l-transf then run findEmitente ( RowObject.cod-emitente ).

                      END. /*ELSE DO: /* Unidade do Faturamento */*/                                                     
            END.
        END.
        if  avail item
        and item.tipo-contr = 4 
        and (   RowObject.numero-ordem <> 0
             or RowObject.int-2 <> 0 ) then do:  /* Bot’o Pedido WEB */
            

            if  RowObject.int-2 <> 0 then
                run findOrdemCompra ( Rowobject.int-2,
                                      ? ).
            else if  RowObject.numero-ordem <> 0 then
                run findOrdemCompra ( Rowobject.numero-ordem,
                                      ? ).
            

            if  avail ordem-compra then do:
                find first cotacao-item
                    where cotacao-item.cod-emitente = ordem-compra.cod-emitente
                      and cotacao-item.numero-ordem = ordem-compra.numero-ordem
                      and cotacao-item.data-cotacao = ordem-compra.data-cotacao
                      no-lock no-error.
     

                if  avail cotacao-item then 
                    assign c-un = cotacao-item.un.
            end.
        end.

        if  RowObject.un <> c-un 
        AND RowObject.quantidade > 0
        and not l-devolucao 
        and not l-dev-transf
        and not l-retorno       
        and (available item-fornec or (avail item and item.tipo-contr <> 4)) then do: 
            if avail item-fornec 
                 and param-compra.log-multi-unid-medid then do:
                 if not can-find (first item-fornec-umd
                                  where item-fornec-umd.it-codigo    = item-fornec.it-codigo
                                    and item-fornec-umd.cod-emitente = item-fornec.cod-emitente
                                    and item-fornec-umd.unid-med-for = RowObject.un
                                    and item-fornec-umd.log-ativo) then do:
                              
                    {utp/ut-table.i mgind tab-unidade 1}
                    ASSIGN c-lb-unidade  = RETURN-VALUE.
        
                    {utp/ut-table.i mgind ITEM 1}
                    ASSIGN c-lb-item  = RETURN-VALUE.
        
                    {utp/ut-liter.i "Fornecedor"}
                    ASSIGN c-lb-emitente  = RETURN-VALUE.
                      {method/svc/errors/inserr.i
                          &ErrorNumber="17899" /*Unidade de medida nÆo est  relacionada ao Item X Fornecedor*/
                          &ErrorType="EMS"
                          &ErrorSubType="ERROR" 
                          &ErrorParameters="c-lb-unidade + ': ' + RowObject.un + '~~~~' + 
                                            c-lb-item + ': ' + item-fornec.it-codigo + ', ' + 
                                            c-lb-emitente + ': ' + string(item-fornec.cod-emitente)"}
                 end.          
            end.
            else do:
                {utp/ut-liter.i "Unidade"}
                ASSIGN c-lb-unidade = RETURN-VALUE.
                {utp/ut-liter.i "Sequência"}
                ASSIGN c-lb-msg = RETURN-VALUE.
                {method/svc/errors/inserr.i
                         &ErrorNumber="7346" /*Unidade de medida nÒo confere*/
                         &ErrorType="EMS"
                         &ErrorSubType="ERROR"
                         &ErrorParameters="c-lb-msg + ': ' + IF INT(SUBSTRING(RowObject.char-2,832,5)) > 0 THEN SUBSTRING(RowObject.char-2,832,5) ELSE STRING(RowObject.sequencia) +
                                           ', ' + c-lb-unidade + ': ' + c-un "}
            end.
        end.
 

        /* Valida Nßmero de Itens permitido na Nota */
        if  param-global.modulo-ft   
        and avail para-fat
        and avail natur-oper
        and natur-oper.imp-nota then do: 
        

            assign i-tamanho-linha = int(substring(para-fat.char-1,6,5))
                   i-nr-linhas     = 0.

            /*Processamento para o item que est˜ sendo incluso/alterado*/
            run calculateItensNota (RowObject.narrativa).
    

            /*Processamento para os itens da nota j˜ cadastrados*/ 
            for each b-item-doc-est
               where b-item-doc-est.nro-docto     = RowObject.nro-docto
                 and b-item-doc-est.serie-docto   = RowObject.serie-docto
                 and b-item-doc-est.cod-emitente  = RowObject.cod-emitente
                 and b-item-doc-est.nat-operacao  = RowObject.nat-operacao 
                 and b-item-doc-est.sequencia     <> RowObject.sequencia no-lock:
  

                /** Leitura Item **/
    

                run findItem ( b-item-doc-est.it-codigo ).
                
                run calculateItensNota (b-item-doc-est.narrativa).
    

            end.
        

            RUN FindItem ( RowObject.it-codigo ).
            
            if  i-nr-linhas > i-nr-linhas-nota then do:
                {method/svc/errors/inserr.i
                                   &ErrorNumber="15423" /*Problema com a narrativa do item da nota fiscal*/
                                   &ErrorType="EMS"
                                   &ErrorSubType="ERROR" }
            end.
        end.  

        /** Valida Pre¯o **/
        run validateValores(INPUT pType).
        if  l-servicos then 
            if  RowObject.cd-trib-iss <> 2 
            and RowObject.cd-trib-iss <> 3 then do:
                 /* Inicio -- Projeto Internacional */
                 DEFINE VARIABLE c-lbl-liter-codigo-tributacao-iss AS CHARACTER NO-UNDO.
                 {utp/ut-liter.i "C¢digo Tributa‡Æo ISS" *}
                 ASSIGN c-lbl-liter-codigo-tributacao-iss = TRIM(RETURN-VALUE).
                 {method/svc/errors/inserr.i
                                     &ErrorNumber="158" /*C¢digo Tributa‡Æo ISS*/
                                     &ErrorType="EMS"
                                     &ErrorSubType="ERROR"
                                     &ErrorParameters="c-lbl-liter-codigo-tributacao-iss" }

            end.
        if  RowObject.class-fiscal = ""
        and docum-est.cod-observa <> 4 
        and avail param-re
        and avail item
        and ( param-re.pd-cf-item or item.tipo-contr = 4 ) then do:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-classificacao-fiscal AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Classifica‡Æo_Fiscal" *}
            ASSIGN c-lbl-liter-classificacao-fiscal = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                                &ErrorNumber="2"
                                &ErrorType="EMS"
                                &ErrorSubType="ERROR" 
                                &ErrorParameters="c-lbl-liter-classificacao-fiscal"}
        end.
        /* Valida Opera¯Êo Triangular */
        if  avail natur-oper
        and natur-oper.log-oper-triang then
            run validateOperTriang.

        if  (not can-find(funcao where funcao.cd-funcao = "spp-drb-sld-terc":U and funcao.ativo))
        and param-global.modulo-07
        and param-global.modulo-ex
        &if "{&bf_dis_versao_ems}":U >= "2.06":U &then                                             
            and natur-oper.log-natur-operac-draw                                                       
            and param-global.log-modul-draw  /*Modulo Drawback*/
        &else                                                                                      
            and substring(natur-oper.char-1,94,1) = "1"         
            and substring(param-global.char-2,22,1) = "1" /*Modulo Drawback*/                                       
        &endif
        and emitente.natureza > 2 
        and connected ("mgcex":U) then do:
        
            if  not valid-handle (h-bocx332) then 
                run cxbo/bocx332.p persistent set h-bocx332.
            run warningDrawback in h-bocx332 (input RowObject.serie-docto, 
                                              input RowObject.nro-docto,   
                                              input RowObject.cod-emitente,
                                              input RowObject.nat-operacao,
                                              output table RowErrors append).
            if  valid-handle (h-bocx332) then do:
                delete procedure h-bocx332.
                assign h-bocx332 = ?.
            end.
        end.
        
        /* ** Valida‡Æo M¢dulo Origina‡Æo (GrÆos) ** */
        IF  RowObject.numero-ordem           = 0    
        AND SUBSTR(RowObject.char-2,540,20) <> "":U THEN DO:
            FOR EACH rowErrors
               WHERE rowErrors.ErrorNumber = 54 EXCLUSIVE-LOCK:
              DELETE rowErrors.
            END.
        END.
        
        FOR EACH  movto-pend FIELDS (nro-docto nat-operacao
                                     serie-docto cod-emitente)
            WHERE movto-pend.nro-comp     = RowObject.nro-docto   
              AND movto-pend.nat-comp     = RowObject.nat-operacao
              AND movto-pend.cod-emitente = RowObject.cod-emitente
              AND movto-pend.serie-comp   = RowObject.serie-docto  
              AND movto-pend.tipo         = 2 NO-LOCK:
            IF  NOT CAN-FIND(FIRST bfitem-doc-est
                             WHERE bfitem-doc-est.nro-docto    = movto-pend.nro-docto
                               AND bfitem-doc-est.nat-operacao = movto-pend.nat-operacao
                               AND bfitem-doc-est.serie-docto  = movto-pend.serie-docto
                               AND bfitem-doc-est.cod-emitente = movto-pend.cod-emitente 
                               AND bfitem-doc-est.nr-ord-produ  = RowObject.nr-ord-produ) THEN DO:
        
                   /* Inicio -- Projeto Internacional */
                   DEFINE VARIABLE c-lbl-liter-ordem-producao-informada-nao-e AS CHARACTER NO-UNDO.
                   {utp/ut-liter.i "Ordem_Produ‡Æo_informada_nÆo_encontrada_na_NF_de_retorno" *}
                   ASSIGN c-lbl-liter-ordem-producao-informada-nao-e = TRIM(RETURN-VALUE).
                   {method/svc/errors/inserr.i
                                       &ErrorNumber="27979" 
                                       &ErrorType="EMS"
                                       &ErrorSubType="ERROR"
                                       &ErrorParameters="c-lbl-liter-ordem-producao-informada-nao-e"}
                                                                                   
            END.
        END.

        /* ------> Valida a natureza fiscal do item (nat-of) em rela‡Æo a natureza do documento (nat-operacao). */
        /* ------> Procedure dispon¡vel em: boin176.m66 */
        IF  pType <> "DELETE":U and l-mult-natur-receb THEN /* Se usa multiplas naturezas no recebimento -> Var def em cd9701.i */
            RUN ValidaNatOperItem (INPUT RowObject.serie-docto,
                                   INPUT RowObject.nro-docto,
                                   INPUT RowObject.cod-emitente,
                                   INPUT RowObject.nat-operacao,
                                   INPUT RowObject.nat-of,
                                   INPUT RowObject.it-codigo,
                                   INPUT RowObject.sequencia,
                                   INPUT RowObject.seq-comp,
                                   INPUT docum-est.uf,
                                   INPUT emitente.natureza,
                                   INPUT docum-est.cod-estabel).
        /* ------> */

        IF pType <> "DELETE":U AND
           substring(RowObject.char-2,840,20) <> "" THEN DO:
            IF NOT CAN-FIND (FIRST sit-tribut NO-LOCK
                             WHERE sit-tribut.cdn-tribut     = 11 /*CEST*/
                               AND sit-tribut.cdn-sit-tribut = int(substring(RowObject.char-2,840,20))) THEN DO:
                   DEFINE VARIABLE c-lbl-liter-cest-invalida AS CHARACTER NO-UNDO.
                   {utp/ut-liter.i "CEST" *}
                   ASSIGN c-lbl-liter-cest-invalida = TRIM(RETURN-VALUE).
                   DEFINE VARIABLE c-lbl-liter-cest-cadastro AS CHARACTER NO-UNDO.
                   {utp/ut-liter.i "Verifique_se_o_CEST_informado_est _cadastrado_no_programa_CD0354_-_Manuten‡Æo_Relacionamento_CEST." *}
                   ASSIGN c-lbl-liter-cest-cadastro = TRIM(RETURN-VALUE).
                   {method/svc/errors/inserr.i
                                       &ErrorNumber="158" 
                                       &ErrorType="EMS"
                                       &ErrorSubType="ERROR"
                                       &ErrorParameters="c-lbl-liter-cest-invalida + '~~~~':U + c-lbl-liter-cest-cadastro"}
            END.
        END.

        /* Verifica se foi informado ato concess¢rio no pedido ou no embarque */
        if  param-global.log-modul-draw  /*Modulo Drawback*/
            and connected ("mgcex") then do:
            assign l-validar = yes.
            /* Valida‡Æo de saldo dispon¡vel para realizar baixa */
            IF RowObject.numero-ordem = 0 AND
               RowObject.parcela      = 0 THEN DO:
               assign l-validar = no.
            END.
            ELSE DO:
               find first prazo-compra no-lock
                   where prazo-compra.numero-ordem = RowObject.numero-ordem
                   and   prazo-compra.parcela      = RowObject.parcela
                   and   trim(substring(prazo-compra.char-2,11,30)) <> "" no-error.
                
               if avail prazo-compra and  pType = "CREATE":U then
                   assign l-validar = no. /* aloca‡Æo foi feita no pedido de compra */
        
               find first ordens-embarque 
                   where ordens-embarque.numero-ordem   = RowObject.numero-ordem
                   and   ordens-embarque.parcela = RowObject.parcela                 
                   and   TRIM(SUBSTRING(ordens-embarque.char-1,1,20)) <> "" no-error.
               if avail ordens-embarque and  pType = "CREATE":U then
                   assign l-validar = no. /* aloca‡Æo foi feita no embarque */
        
            END.        
        END.
        
        ASSIGN c-nr-ato-concessorio-antigo = "".        
        FOR FIRST bfitem-doc-est no-lock
            WHERE bfitem-doc-est.nro-docto    = RowObject.nro-docto
              AND bfitem-doc-est.nat-operacao = RowObject.nat-operacao
              AND bfitem-doc-est.serie-docto  = RowObject.serie-docto
              AND bfitem-doc-est.cod-emitente = RowObject.cod-emitente:
            ASSIGN c-nr-ato-concessorio-antigo = bfitem-doc-est.nr-ato-concessorio.                        
        END.   
        
        /*valida se existe cfop nota de saída*/
        IF TRIM(RowObject.cod-cfop-saida) NE "" THEN DO:
            IF NOT CAN-FIND(FIRST cfop-natur
                            WHERE cfop-natur.cod-cfop = TRIM(RowObject.cod-cfop-saida)) THEN DO:
                {method/svc/errors/inserr.i
                       &ErrorNumber="33404" 
                       &ErrorType="EMS"
                       &ErrorSubType="ERROR"
                       &ErrorParameters="TRIM(RowObject.cod-cfop-saida)"}
            END.
        END.
        /*mudança de layout                                                                                                           */      
        /*ELSE DO:                                                                                                                    */
        /*    IF CAN-FIND (FIRST item-orgao-control                                                                                   */
        /*                 WHERE item-orgao-control.it-codigo = RowObject.it-codigo                                                   */
        /*                   AND item-orgao-control.log-item-agpf = YES) THEN DO:  /*Item controlado pela policia federal - CD0161*/  */
        /*        /*56572 - Item &1 controlado &2. &3 deve ser informada.*/                                                           */
        /*        {utp/ut-liter.i pela_Pol¡cia_Federal *}                                                                             */
        /*        c-lbl-pf = RETURN-VALUE.                                                                                            */
        /*        {utp/ut-liter.i CFOP_da_nota_emitida  *}                                                                            */
        /*        c-lbl-cfop-saida = RETURN-VALUE.                                                                                    */
        /*        {method/svc/errors/inserr.i                                                                                         */
        /*                &ErrorNumber="56572"                                                                                        */
        /*                &ErrorType="EMS"                                                                                            */
        /*                &ErrorSubType="WARNING"                                                                                     */
        /*                &ErrorParameters="RowObject.it-codigo + '~~~~' +                                                            */
        /*                                  c-lbl-pf            + '~~~~' +                                                            */
        /*                                  c-lbl-cfop-saida "}                                                                       */
        /*    END.                                                                                                                    */
        /*END.                                                                                                                        */
        /*************************************/
        
        
        IF  pType = "UPDATE":U and l-validar THEN DO:                          
            if  RowObject.nr-ato-concessorio <> c-nr-ato-concessorio-antigo 
                and natur-oper.log-natur-operac-draw /* Natureza Drawback */                                                      
                and param-global.log-modul-draw  /*Modulo Drawback*/
                and connected ("mgcex") then do:
                
                    find first pedido-drb no-lock
                        where pedido-drb.cod-estabel = docum-est.cod-estabel
                        and   pedido-drb.nr-ato-concessorio = RowObject.nr-ato-concessorio no-error.
                    FIND FIRST pedido-drb-item
                        WHERE pedido-drb-item.nr-pedido-drb = pedido-drb.nr-pedido-drb
                          AND pedido-drb-item.cod-estabel   = pedido-drb.cod-estabel
                          AND pedido-drb-item.it-codigo     = RowObject.it-codigo
                          AND pedido-drb-item.idi-reg       = 1 EXCLUSIVE-LOCK NO-ERROR.
            
                    IF AVAIL pedido-drb-item THEN DO:
            
                        IF NOT VALID-HANDLE(h-bocx315) THEN
                            RUN cxbo/bocx315.p PERSISTENT SET h-bocx315.
                            
                        if not avail emitente then
                            find first emitente no-lock 
                                where emitente.cod-emitente = RowObject.cod-emitente no-error.
                                            
                        if not avail estabelec then
                            find first estabelec no-lock
                                where estabelec.cod-estabel = docum-est.cod-estabel no-error.
                
                        IF  emitente.natureza > 2 
                            and emitente.pais <> estabelec.pais THEN
                            assign i-IntNac = 1. /* internacional */
                        ELSE
                            assign i-IntNac = 2. /* nacional */
                        
                        RUN retornaQuantidadeSaldoDrb IN h-bocx315 (INPUT i-IntNac, /* 1 - internacional; 2 - nacional */
                                                                    INPUT pedido-drb.modalidade,
                                                                    INPUT pedido-drb.cod-estabel,
                                                                    INPUT RowObject.it-codigo,
                                                                    INPUT pedido-drb.nr-pedido-drb,
                                                                    OUTPUT de-quant-sdo).                                                                 
                       
                        if i-IntNac = 1 then do: /* INTERNACIONAL */
                                IF de-quant-sdo >= (pedido-drb-item.qtd-alocada-import + RowObject.quantidade) THEN
                                    ASSIGN l-erro = no.
                                ELSE
                                    ASSIGN l-erro = yes.
                        end.
                        else do: /* NACIONAL */
                                IF de-quant-sdo >= (pedido-drb-item.qtd-alocada-nac + RowObject.quantidade) THEN
                                    ASSIGN l-erro = no.
                                ELSE
                                    ASSIGN l-erro = yes.
                        end.
                                         
                        IF l-erro THEN DO:
                            {utp/ut-liter.i Ato_concess¢rio_nÆo_possui_saldo_suficiente. *}
                            assign c-msg = RETURN-VALUE.
                            {method/svc/errors/inserr.i
                                            &ErrorNumber="17006"
                                            &ErrorType="EMS"
                                            &ErrorSubType="ERROR" 
                                            &ErrorParameters="c-msg"}
                        END.
                        
                        IF VALID-HANDLE(h-bocx315) THEN DO:
                            DELETE PROCEDURE h-bocx315.
                            ASSIGN h-bocx315 = ? .
                        END.
                    END.
            end.
            
        END. /* pType = UPDATE */       
    end.
    else do: /* pType = DELETE */
        if can-find(first pd-cc-it-nfe use-index documento where
                      pd-cc-it-nfe.nro-docto    = RowObject.nro-docto     and
                      pd-cc-it-nfe.serie-docto  = RowObject.serie-docto   and
                      pd-cc-it-nfe.nat-operacao = RowObject.nat-operacao  and
                      pd-cc-it-nfe.cod-emitente = RowObject.cod-emitente) or
        can-find(first pd-pd-it-nfe use-index documento where
                      pd-pd-it-nfe.nro-docto    = RowObject.nro-docto     and
                      pd-pd-it-nfe.serie-docto  = RowObject.serie-docto   and
                      pd-pd-it-nfe.nat-operacao = RowObject.nat-operacao  and
                      pd-pd-it-nfe.cod-emitente = RowObject.cod-emitente) then do:
           {method/svc/errors/inserr.i
                               &ErrorNumber="6718" /*Item da nota possui relacionamentos ativos */
                               &ErrorType="EMS"
                               &ErrorSubType="ERROR" }
        end.

        if  param-global.modulo-07
        and emitente.natureza > 2
        and emitente.pais <> estabelec.pais
        and connected ("mgcex") then do:
        
            assign l-erro-ordens-embarque = no.
            if  not valid-handle (h-bocx225) then 
                run cxbo/bocx225.p persistent set h-bocx225.

            /** Apenas valida, nao efetiva eliminacao dos movimentos **/
            run verificaOrdensEmbarque in h-bocx225 (input  docum-est.cod-estabel,
                                                     input  RowObject.numero-ordem,
                                                     output l-erro-ordens-embarque).

            if l-erro-ordens-embarque then do:
                {method/svc/errors/inserr.i
                                    &ErrorNumber="54588" /*Esse item est  vinculado a um processo de importa‡Æo no m¢dulo de importa‡Æo e sua exclusÆo nÆo ‚ permitida.*/
                                    &ErrorType="EMS"
                                    &ErrorSubType="ERROR" }
            end.

            if  valid-handle (h-bocx225) then do:
                delete procedure h-bocx225.
                assign h-bocx225 = ?.
            end.
        end.

        if  (not can-find(funcao where funcao.cd-funcao = "spp-drb-sld-terc":U and funcao.ativo))
        and RowObject.nr-ato-concessorio <> "":U 
        and param-global.modulo-07
        and param-global.modulo-ex
        &if "{&bf_dis_versao_ems}":U >= "2.06":U &then                                             
            and natur-oper.log-natur-operac-draw                                                       
        &else                                                                                      
            and substring(natur-oper.char-1,94,1) = "1":U
        &endif
        and emitente.natureza > 2
        and emitente.pais <> estabelec.pais
        and substr(docum-est.char-1,90,1) = "1":U
        and connected ("mgcex") then do:

            if  not valid-handle (h-bocx332) then 
                run cxbo/bocx332.p persistent set h-bocx332.
            /** Apenas valida, nao efetiva eliminacao dos movimentos **/
            run eliminaMovtos in h-bocx332 (input RowObject.r-rowid,
                                            input no, /** Nao Elimina Movtos **/
                                            input no,  
                                            output table RowErrors append).
            if  valid-handle (h-bocx332) then do:
                delete procedure h-bocx332.
                assign h-bocx332 = ?.
            end.
        end.

        if  can-find (first docum-est
                      where docum-est.cod-emitente = RowObject.cod-emitente
                      and   docum-est.serie-docto    = RowObject.serie-docto
                      and   docum-est.nro-docto      = RowObject.nro-docto
                      and   docum-est.nat-operacao   = RowObject.nat-operacao
                      and   docum-est.log-1 /*NF atualizada no Faturamento*/) then do:
                {method/svc/errors/inserr.i
                                    &ErrorNumber="15950"
                                    &ErrorType="EMS":U
                                    &ErrorSubType="ERROR":U}
        end.

    end.
    
    /* Indica que o documento podera ser totalizado */
    assign i-totaliza = 0.     
    
    if  pType <> "Delete"
    and l-NT2024002
    and rowObject.ano-mes-apuracao <> ""
    and trim(rowObject.ano-mes-apuracao) <> "-"
    and can-find (first docum-est
                  where docum-est.cod-emitente = RowObject.cod-emitente
                    and docum-est.serie-docto  = RowObject.serie-docto
                    and docum-est.nro-docto    = RowObject.nro-docto
                    and docum-est.nat-operacao = RowObject.nat-operacao
                    and int(docum-est.cod-finalidade) = 6 //nota de debito
                    and (   int(docum-est.cod-tipo-nf-cred-deb) = 2
                         or int(docum-est.cod-tipo-nf-cred-deb) = 3
                         or int(docum-est.cod-tipo-nf-cred-deb) = 8)) then do:
                         
         if  int(substr(rowObject.ano-mes-apuracao,1,4)) < 2025 then do:

            {utp/ut-liter.i Ano_informado_deve_ser_maior_ou_igual_a_2025 * r}
            {method/svc/errors/inserr.i
                            &ErrorNumber="58166"
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR" 
                            &ErrorParameters="return-value"}         
         end.      
         
         if int(substr(rowObject.ano-mes-apuracao,6,2)) < 1 
         or int(substr(rowObject.ano-mes-apuracao,6,2)) > 12 then do:
         
            {utp/ut-liter.i Mˆs_informado_deve_estar_entre_1_e_12 * r}
            {method/svc/errors/inserr.i
                            &ErrorNumber="58166"
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR" 
                            &ErrorParameters="return-value"}
         end.
         
         if substr(rowObject.ano-mes-apuracao,5,1) <> "-" then do:
         
            {utp/ut-liter.i D¡gito_separador_deve_ser_um_tra‡o * r}
            {method/svc/errors/inserr.i
                            &ErrorNumber="58166"
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR" 
                            &ErrorParameters="return-value"}
         end.
         
         
    end.
    
    /**************** Rodado no add, mod e del ******************/
    {method/svc/custom/custom.i &Event = "EndValidateRecord"}
    /************************************************************/
    /*--- Verifica ocorrencia de erros gerados por EPC ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "EPC":U) THEN 
        RETURN "NOK":U.
        
    /*--- Verifica ocorr¬ncia de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN 
        RETURN "NOK":U.

    RETURN "OK":U.

END PROCEDURE.
