/*********************************************************************************
**
** PROCEDURE: EliminarPertOrdem
** Objetivo:  Libera‡Æo de opera‡äes iniciais, atualiza‡Æo de opera‡äes 
              iniciais e finais
**              
*********************************************************************************/

PROCEDURE EliminarPertOrdem:

    define parameter buffer b-pert-ordem for pert-ordem.
    
    define buffer b2-pert-ordem for pert-ordem.

    find op-sfc where
         op-sfc.nr-ord-produ = b-pert-ordem.nr-ord-produ no-lock no-error.
    if  not avail op-sfc then
        return.
    
    find first b2-pert-ordem
         where b2-pert-ordem.nr-ord-produ      = b-pert-ordem.nr-ord-produ
           and b2-pert-ordem.num-operac-predec = b-pert-ordem.num-operac-predec
           and rowid(b2-pert-ordem)           <> rowid(b-pert-ordem) no-lock no-error.

    if  not avail b2-pert-ordem then do:
        find oper-ord
            where oper-ord.nr-ord-produ   = b-pert-ordem.nr-ord-produ
              and oper-ord.num-operac-sfc = b-pert-ordem.num-operac-predec exclusive-lock no-error.
        IF  AVAIL oper-ord THEN
            assign oper-ord.log-operac-final = yes.
        
    end.

    find first b2-pert-ordem
        where b2-pert-ordem.nr-ord-produ     = b-pert-ordem.nr-ord-produ
          and b2-pert-ordem.num-operac-suces = b-pert-ordem.num-operac-suces
          and rowid(b2-pert-ordem)          <> rowid(b-pert-ordem) no-lock no-error.
    
    if  not avail b2-pert-ordem then do:
        find oper-ord
            where oper-ord.nr-ord-produ   = b-pert-ordem.nr-ord-produ
              and oper-ord.num-operac-sfc = b-pert-ordem.num-operac-suces exclusive-lock no-error.
        IF AVAIL oper-ord THEN
            assign oper-ord.log-operac-inic = yes.

       if op-sfc.ind-estado-op >= 2 AND AVAIL oper-ord and
          not oper-ord.log-restric-operac then 
            assign oper-ord.dat-liber-operac      = today
                   oper-ord.qtd-segs-liber-operac = time.
    end.  

END PROCEDURE.   


/*********************************************************************************
**
** PROCEDURE: IncluirPertOrdem
** Objetivo:  Atualiza‡Æo de opera‡äes start e opera‡äes finais
**              
*********************************************************************************/
PROCEDURE IncluirPertOrdem:

    define parameter buffer b-pert-ordem for pert-ordem.
     
    define buffer b-oper-ord for oper-ord. 

    find oper-ord where 
         oper-ord.nr-ord-produ = b-pert-ordem.nr-ord-produ and
         oper-ord.it-codigo    = b-pert-ordem.it-codigo    and
         oper-ord.cod-roteiro  = b-pert-ordem.cod-roteiro  and
         oper-ord.op-codigo    = b-pert-ordem.op-codigo exclusive-lock no-error.

    find b-oper-ord where 
         b-oper-ord.nr-ord-produ = b-pert-ordem.nr-ord-produ and
         b-oper-ord.it-codigo    = b-pert-ordem.it-predec    and
         b-oper-ord.cod-roteiro  = b-pert-ordem.rot-predec   and
         b-oper-ord.op-codigo    = b-pert-ordem.op-predec exclusive-lock no-error.
         
    if avail b-pert-ordem then
        assign b-pert-ordem.num-operac-predec = b-oper-ord.num-operac-sfc
               b-pert-ordem.num-operac-suces  = oper-ord.num-operac-sfc.

    if avail oper-ord then do:
        if  oper-ord.log-operac-inic then 
            assign oper-ord.log-operac-inic = no.
    end.

    if avail b-oper-ord then do:
        if  b-oper-ord.log-operac-final then
            assign b-oper-ord.log-operac-final = no.
    end.

END PROCEDURE.   
