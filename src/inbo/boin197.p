&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getKey DBOProgram 
PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice item
  Parameters:  
               retorna valor do campo it-codigo
               retorna valor do campo lote
               retorna valor do campo it-componente
               retorna valor do campo lote-componente
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pit-codigo LIKE lote-prod.it-codigo NO-UNDO.
    DEFINE OUTPUT PARAMETER plote LIKE lote-prod.lote NO-UNDO.
    DEFINE OUTPUT PARAMETER pit-componente LIKE lote-prod.it-componente NO-UNDO.
    DEFINE OUTPUT PARAMETER plote-componente LIKE lote-prod.lote-componente NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pit-codigo = RowObject.it-codigo
           plote = RowObject.lote
           pit-componente = RowObject.it-componente
           plote-componente = RowObject.lote-componente.

    RETURN "OK":U.
END PROCEDURE.

