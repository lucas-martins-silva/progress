PROCEDURE calculateVariationQuantity :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:   Determina varia»’o de quantidade, retorna:
           *de-qtd-max-perc - quantidade maxima permitida para recebimento, apli-
                              cando o percentual definido no item-mat-estab/item-mat.
           *de-qtd-max-lim  - quantidade maxima permitida para recebimento, apli-
                              cando o limite definido no item-mat-estab/item-mat.
           *de-max-perc-qt  - percentual maximo para variacao definido no item-mat-
                              estab/item-mat.      
           *de-max-lim-qt   - limite maximo para variacao definido no item-mat-
                              estab/item-mat.      

------------------------------------------------------------------------------*/

    def input  param de-qtd-orig       as decimal no-undo.
    def output param de-qtd-max-perc   as decimal no-undo.
    def output param de-qtd-max-lim    as decimal no-undo.
    def output param de-max-perc-qt    as decimal no-undo.
    def output param de-max-lim-qt     as decimal no-undo.
    

    def var de-max-perc-vl            as decimal no-undo.
    def var de-max-lim-vl             as decimal no-undo.
    def var de-qtd-tot-ordem          as decimal no-undo.
    def var de-qtd-aux                as decimal no-undo.
    def var de-qtd-var                as decimal no-undo.
             

    run getValuesItemMatEstab ( output de-max-perc-vl,
                                output de-max-lim-vl,
                                output de-max-perc-qt,
                                output de-max-lim-qt ).                  


    for each prazo-compra
       fields ( numero-ordem    parcela         quant-saldo
                situacao        data-entrega    dec-1
                quant-rejeit     qtd-sal-forn     quantidade
                quant-receb     cod-refer                   )
        use-index ordem
        where prazo-compra.numero-ordem = RowObject.numero-ordem
        no-lock:
        

        assign de-qtd-tot-ordem = de-qtd-tot-ordem + prazo-compra.quantidade.

        if (prazo-compra.quant-receb + prazo-compra.dec-1 - quant-rejeit) >       
                                             prazo-compra.quantidade then
            assign de-qtd-var = de-qtd-var
                              + (prazo-compra.quant-receb
                              +  prazo-compra.dec-1
                              -  prazo-compra.quant-rejeit)
                              -  prazo-compra.quantidade.
    end.
    

    assign de-qtd-aux = round(de-qtd-tot-ordem * de-max-perc-qt / 100 , 4).
    assign de-qtd-aux = de-qtd-aux - de-qtd-var.
    assign de-qtd-aux = if   de-qtd-aux < 0 then 0 
                        else de-qtd-aux.
    
    if  param-re.aceita-var then
        assign de-qtd-max-perc = de-qtd-orig + de-qtd-aux
               de-qtd-max-lim  = de-qtd-orig + de-max-lim-qt.
    else
        assign de-qtd-max-perc = de-qtd-orig
               de-qtd-max-lim  = de-qtd-orig.

    return "OK":U.

END PROCEDURE.




