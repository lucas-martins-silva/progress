PROCEDURE calculatePisCofins :
/*------------------------------------------------------------------------------
  Purpose:
  Parameters:  <none>
  Notes: Calcula a Base e Valor de PIS
------------------------------------------------------------------------------*/
    def var de-trib-pis                as int                       no-undo.
    def var de-trib-cofins             as int                       no-undo.
    def var i-cd-trib-ipi              as int                       no-undo.
    def var de-vlr-merc-nota-dev       as decimal                   no-undo.
    def var de-despesas                as decimal                   no-undo.

    def var l-cfg-trib-valores          as logical                      no-undo.
    def var l-calc-pis-cofins-por-unid  as logical                      no-undo.
    def var i-seq-wt-docto-aux          like wt-docto.seq-wt-docto      no-undo.

    DEF BUFFER b-natur-oper-fiscal FOR natur-oper.
    /* MP563 - aliquota majorada */
    def var de-aliquota-cofins-cr  as dec  no-undo.
    def var de-aliquota-pis-cr     as dec no-undo.
    def var de-base-cofins-cr      as dec  no-undo.
    def var de-vl-cofins-cr        as dec  no-undo.
    def var c-cod-cfop             as char no-undo.
    DEF var de-aliquota-cofins-maj as dec  no-undo.
    DEF var de-aliquota-pis-maj    as dec  no-undo.
    DEF VAR de-aliq-pis            AS DEC FORMAT ">>9.9999" NO-UNDO.
    DEF VAR de-aliq-cofins         AS DEC FORMAT ">>9.9999" NO-UNDO.

    DEF VAR h-im9048               AS HANDLE NO-UNDO.

    DEF VAR ali-dif-pis-temp     AS DEC NO-UNDO.
    DEF VAR ali-dif-cofins-temp  AS DEC NO-UNDO.
    DEF var i-trib-cofins-cr     AS INTEGER NO-UNDO.
    DEF VAR i-trib-pis-cr        AS INTEGER NO-UNDO.
    DEF VAR de-it-preco-total    AS DECIMAL NO-UNDO.
    DEF VAR de-valor-desc-icms   AS DECIMAL NO-UNDO.
    DEF VAR de-qtd-conv-pis      AS DECIMAL NO-UNDO.
    DEF VAR de-qtd-conv-cofins   AS DECIMAL NO-UNDO.

    /* Na modifica‡Æo os valores unit rios de pis/cofins sempre estao zerados,
       com isso, ‚ necess rio buscar novamente estes valores, pois a valida‡Æo
       do calculado x informado ‚ feito com base nas vari veis de-vl-pis e de-vl-cofins */

    IF NOT VALID-HANDLE(h-cdapi995) THEN
        RUN cdp/cdapi995.p PERSISTENT SET h-cdapi995.

    if  not valid-handle(h-cd4337) then
        run cdp/cd4337.p persistent set h-cd4337.

    if  not valid-handle (h-cd4338) then
        run cdp/cd4338.p persistent set h-cd4338.

    /* Se usa m£ltiplas naturezas no recebimento */
    IF  l-mult-natur-receb THEN /* Var def em cd9701.i */
        /* Busca b-natur-oper-fiscal = Natureza fiscal do Item */
        FIND FIRST b-natur-oper-fiscal WHERE b-natur-oper-fiscal.nat-operacao = RowObject.nat-of NO-LOCK NO-ERROR.

    /* Se nÆo usa multiplas naturezas ou usa mas a nota ‚ antiga (digit. antes de marcar o parƒm.) */
    IF  NOT AVAIL b-natur-oper-fiscal THEN
        /* Busca b-natur-oper-fiscal = Natureza de opera‡Æo da Nota */
        FIND FIRST b-natur-oper-fiscal WHERE b-natur-oper-fiscal.nat-operacao = RowObject.nat-operacao NO-LOCK NO-ERROR.

    /* Chamada para buscar o valor unit rio do PIS */
    IF l-recalcula-pis-cofins = NO THEN
    run pi-tributa-aliquota-pis in h-cd4337 ( buffer estabelec,
                                              buffer item,
                                              buffer emitente,
                                              buffer b-natur-oper-fiscal,
                                              input  docum-est.dt-emissao,
                                              output de-trib-pis,
                                              output de-aliquota-pis,
                                              output de-valor-un-pis,
                                              output de-val-reduc-pis-normal).

    /* Chamada para buscar o valor unit rio do COFINS */
    IF l-recalcula-pis-cofins = NO then
    run pi-tributa-aliquota-cofins in h-cd4337 ( buffer estabelec,
                                                 buffer item,
                                                 buffer emitente,
                                                 buffer b-natur-oper-fiscal,
                                                 input  docum-est.dt-emissao,
                                                 output de-trib-cofins,
                                                 output de-aliquota-cofins,
                                                 output de-valor-un-cofins,
                                                 output de-val-reduc-cofins-normal).

    IF l-recalcula-pis-cofins = NO and de-valor-un-pis <> 0 THEN
        run pi-retorna-qtd-conv-pis in h-cd4337 (input  rowObject.quantidade,
                                                 output de-qtd-conv-pis).

    IF l-recalcula-pis-cofins = NO and de-valor-un-cofins <> 0 THEN
        run pi-retorna-qtd-conv-cofins in h-cd4337 (input  rowObject.quantidade,
                                                    output de-qtd-conv-cofins).

    if (natur-oper.tipo-compra = 3 or natur-oper.tipo-compra = 8 or natur-oper.tp-oper-terc = 5) and RowObject.nro-comp <> "" THEN DO: /*Dev Cliente e Dev Consignacao: Nao sobrepor o que buscou da NF de saida*/
        ASSIGN  de-trib-pis          = rowObject.idi-tributac-pis
                de-trib-cofins       = rowObject.idi-tributac-cofins
                de-aliquota-pis      = IF ROUND(RowObject.val-aliq-pis,2)    = ROUND(de-aliquota-pis,2)    THEN de-aliquota-pis    ELSE RowObject.val-aliq-pis
                de-aliquota-cofins   = IF ROUND(RowObject.val-aliq-cofins,2) = ROUND(de-aliquota-cofins,2) THEN de-aliquota-cofins ELSE RowObject.val-aliq-cofins.

        FOR FIRST it-nota-fisc FIELDS (idi-forma-calc-pis val-unit-pis idi-forma-calc-cofins val-unit-cofins char-2 it-codigo qt-faturada)
            where it-nota-fisc.cod-estabel = docum-est.cod-estabel
              and it-nota-fisc.serie       = rowObject.serie-comp
              and it-nota-fisc.nr-nota-fis = rowObject.nro-comp
              and it-nota-fisc.nr-seq-fat  = rowObject.seq-comp no-lock:

            /*Regra para buscar pis/cofins por unidade e percentual de reducao conforme nota de saida*/
            ASSIGN de-valor-un-pis      = IF it-nota-fisc.idi-forma-calc-pis = 2 /* Pis Un Prod */
                                          THEN it-nota-fisc.val-unit-pis         /* Vl Unit Pis*/
                                          ELSE 0
                   de-valor-un-cofins   = IF it-nota-fisc.idi-forma-calc-cofins = 2 /* Pis Un Prod */
                                          THEN it-nota-fisc.val-unit-cofins         /* Vl Unit Pis*/
                                          ELSE 0
                   de-val-reduc-pis-normal    = dec(substring(it-nota-fisc.char-2,86,5))
                   de-val-reduc-cofins-normal = dec(substring(it-nota-fisc.char-2,91,5)).

            IF de-valor-un-pis <> 0 OR de-valor-un-cofins <> 0 THEN
               FOR FIRST item-dist NO-LOCK
                   WHERE item-dist.it-codigo = it-nota-fisc.it-codigo:
                   FOR FIRST ext-it-nota-fisc NO-LOCK
                       WHERE ext-it-nota-fisc.cod-estabel = docum-est.cod-estabel
                         AND ext-it-nota-fisc.serie       = rowObject.serie-comp
                         AND ext-it-nota-fisc.nr-nota-fis = rowObject.nro-comp
                         AND ext-it-nota-fisc.nr-seq-fat  = rowObject.seq-comp
                         AND ext-it-nota-fisc.it-codigo   = rowObject.it-codigo
                         AND ext-it-nota-fisc.cod-param   = "inf-PIS/COFINS": END.

                   IF TRIM(SUBSTRING(item-dist.char-2,27,6)) <> "" AND /*Unid Pis*/
                      TRIM(SUBSTRING(item-dist.char-2,27,6)) <> item.un AND
                      AVAIL ext-it-nota-fisc THEN
                       ASSIGN de-valor-un-pis = ROUND((ext-it-nota-fisc.val-livre-3 / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2) /*valor pis*/
                              de-qtd-conv-pis = DEC(SUBSTRING(ext-it-nota-fisc.cod-livre-1,5,16)).

                   IF TRIM(SUBSTRING(item-dist.char-2,21,6)) <> "" AND /*Unid Cofins*/
                      TRIM(SUBSTRING(item-dist.char-2,21,6)) <> item.un AND
                      AVAIL ext-it-nota-fisc THEN
                       ASSIGN de-valor-un-cofins = ROUND((ext-it-nota-fisc.val-livre-6 / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2) /*valor cofins*/
                              de-qtd-conv-cofins = DEC(SUBSTRING(ext-it-nota-fisc.cod-livre-1,21,16)).
               END.
        END.
    end.

    if  rowObject.cd-trib-ipi = 3     /* IPI Outros */
    and not natur-oper.terceiros then /* Nao e operacao com terceiros */
        assign i-cd-trib-ipi = 3.     /* IPI Outros */
    else
        assign i-cd-trib-ipi = 2.     /* IPI Isento */

    if  avail natur-oper
    and natur-oper.terceiros
    and natur-oper.tp-oper-terc = 4 then do:     /* Faturamento Consignacao */
        find componente
            where componente.serie-docto  = RowObject.serie-comp
            and   componente.cod-emitente = docum-est.cod-emitente
            and   componente.nro-docto    = RowObject.nro-comp
            and   componente.nat-operacao = RowObject.nat-comp
            and   componente.sequencia    = RowObject.seq-comp
            and   componente.it-codigo    = RowObject.it-codigo
            and   componente.cod-refer    = RowObject.cod-refer no-lock no-error.
        if  avail componente
        and componente.cd-trib-ipi = 3 then  /* IPI Outros */
            assign i-cd-trib-ipi = componente.cd-trib-ipi.
    end.

    IF (de-aliquota-pis = 0 OR de-aliquota-cofins = 0 ) AND l-recalcula-pis-cofins = NO THEN
    RUN recupera-aliquotas IN h-cdapi995 (INPUT "item-doc-est",
                                          INPUT rowObject.serie-docto + "/" +
                                                rowObject.nro-docto + "/" +
                                                string(rowObject.cod-emitente) + "/" +
                                                rowObject.nat-operacao + "/" +
                                                string(rowObject.sequencia),
                                          output de-aliquota-pis,
                                          output de-aliquota-cofins).


 	if RowObject.nro-comp = "" or /*Sem nota relacionada*/
       natur-oper.tipo-compra <> 3 and natur-oper.tipo-compra <> 8 and natur-oper.tp-oper-terc <> 5 then do: /* Devol Cli ou Devol Consig*/
                IF de-aliquota-pis    = 0 THEN ASSIGN de-aliquota-pis    = rowObject.val-aliq-pis.
                IF de-aliquota-cofins = 0 THEN ASSIGN de-aliquota-cofins = rowObject.val-aliq-cofins.
    end.

    /***ICMS Desonerado***/
    assign de-valor-desc-icms = 0.
    if l-recalcula-pis-cofins then do:
        if l-apl-desc-icm-recalc and de-val-desc-icm-recalc > 0 then
            ASSIGN de-valor-desc-icms = de-val-desc-icm-recalc. /*valor desconto icms*/
    end.
    else do:
        FOR FIRST ext-item-doc-est NO-LOCK
            WHERE ext-item-doc-est.serie-docto  = RowObject.serie-docto
              AND ext-item-doc-est.nro-docto    = RowObject.nro-docto
              AND ext-item-doc-est.cod-emitente = RowObject.cod-emitente
              AND ext-item-doc-est.nat-operacao = RowObject.nat-operacao
              AND ext-item-doc-est.sequencia    = RowObject.sequencia
              AND ext-item-doc-est.cod-param    = "icms-deson":U
              AND ext-item-doc-est.log-livre-1  = yes: /*aplica como desconto*/
            ASSIGN de-valor-desc-icms = ext-item-doc-est.val-livre-2. /*valor desconto icms*/
        END.
    end.
    /********************/

    assign de-despesas       = rowObject.despesas[1] - dec(SUBSTR(rowobject.char-2,819,13))
           de-it-preco-total = rowObject.preco-total[1].

    /******KOMATSU*******************************************************/
    if can-find (first funcao
                 where funcao.cd-funcao = "spp-deduz-sn-pis-cofins":U
                   and funcao.ativo) and
        de-vl-simplesnac <> 0 then
        assign de-it-preco-total = rowObject.preco-total[1] - de-vl-simplesnac.
    /********************************************************************/

    run pi-calcula-pis in h-cd4338 (input  rowObject.idi-tributac-pis,
                                    input  de-aliquota-pis,
                                    input  de-valor-un-pis,
                                    input  de-val-reduc-pis-normal,
                                    input  i-cd-trib-ipi,
                                    input  rowObject.valor-ipi[1],
                                    input  de-it-preco-total,
                                    input  de-despesas,
                                    input  (rowObject.desconto[1] + de-valor-desc-icms),
                                    input  rowObject.quantidade,
                                    buffer b-natur-oper-fiscal,
                                    output de-base-pis,
                                    output de-vl-pis).

    run pi-calcula-cofins in h-cd4338 (input  rowObject.idi-tributac-cofins,
                                       input  de-aliquota-cofins,
                                       input  de-valor-un-cofins,
                                       input  de-val-reduc-cofins-normal,
                                       input  i-cd-trib-ipi,
                                       input  rowObject.valor-ipi[1],
                                       input  de-it-preco-total,
                                       input  de-despesas,
                                       input  (rowObject.desconto[1] +  de-valor-desc-icms),
                                       input  rowObject.quantidade,
                                       buffer b-natur-oper-fiscal,
                                       output de-base-cofins,
                                       output de-vl-cofins).

    if (natur-oper.tipo-compra = 3 or natur-oper.tipo-compra = 8 or natur-oper.tp-oper-terc = 5) and RowObject.nro-comp <> ""  AND rowObject.idi-tributac-pis  = 2 /*Isento*/  THEN DO:
         ASSIGN  de-base-pis          = 0
                 de-base-cofins       = 0.

    end.

    if l-recalcula = no then do:   /* inclusao e  e botao recalculo*/
       assign RowObject.base-pis              = de-base-pis
              RowObject.valor-pis             = de-vl-pis
              RowObject.val-base-calc-cofins  = de-base-cofins
              RowObject.val-cofins            = de-vl-cofins.

    end.

    assign l-utilizaImpostoMonitor = no.
    RUN utilizaImpostosMonitorRecFiscal (INPUT  RowObject.serie-docto,
                                         INPUT  RowObject.nro-docto,
                                         INPUT  RowObject.cod-emitente,
                                         INPUT  RowObject.nat-operacao,
                                         INPUT  INT(SUBSTRING(RowObject.char-2,832,5)),
                                         OUTPUT l-utilizaImpostoMonitor).

    IF l-utilizaImpostoMonitor = NO THEN DO:

       /*PIS/COFINS por unidade - valor*/
       IF de-valor-un-pis <> 0 THEN DO:
          RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:PIS,
                                        INPUT AtributoImposto:VALOR-UNID,
                                        INPUT de-valor-un-pis).
       END.
       IF de-valor-un-cofins <> 0 THEN DO:
          RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:COFINS,
                                        INPUT AtributoImposto:VALOR-UNID,
                                        INPUT de-valor-un-cofins).
       END.

       /*PIS/COFINS por unidade - quantidade convertida p/ unidade do governo*/
       if de-qtd-conv-pis <> 0 then do:
          RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:PIS,
                                        INPUT AtributoImposto:QUANT-UNID,
                                        INPUT de-qtd-conv-pis).
       end.
       if de-qtd-conv-cofins <> 0 then do:
          RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:COFINS,
                                        INPUT AtributoImposto:QUANT-UNID,
                                        INPUT de-qtd-conv-cofins).
       end.
    END.
    /**********************************************************************/

    /* ------------------------- */
    /* MP563 - aliquota majorada */
    /* ------------------------- */

    IF  param-global.modulo-07      /* modulo de importacao */
    AND docum-est.origem = "I"
    AND SUBSTRING(docum-est.char-1,1,20) <> "" /* documento gerado pelo modulo */
    AND NOT b-natur-oper-fiscal.nota-rateio THEN DO:

        IF DEC(SUBSTR(item.char-2,84,9)) <> 0 THEN /* PIS com 4 decimais */
            ASSIGN ali-dif-pis-temp = DEC(SUBSTR(item.char-2,84,9)).
        ELSE
            ASSIGN ali-dif-pis-temp = dec(substring(item.char-2,74,5)).

        IF DEC(SUBSTR(item.char-2,93,9)) <> 0 THEN /* COFINS com 4 decimais */
            ASSIGN ali-dif-cofins-temp = DEC(SUBSTR(item.char-2,93,9)).
        ELSE
            ASSIGN ali-dif-cofins-temp = dec(substring(item.char-2,79,5)).

        if avail classif-fisc then do:
            &if '{&bf_mat_versao_ems}' >= '2.09' &then
              ASSIGN de-aliquota-pis-maj    = IF ali-dif-pis-temp <> 0
                                              THEN ali-dif-pis-temp     /*Alíquota Diferênciada*/
                                              ELSE classif-fisc.val-aliq-pis-acresc
                     de-aliquota-cofins-maj = IF ali-dif-cofins-temp <> 0
                                              THEN ali-dif-cofins-temp  /*Alíquota Diferênciada*/
                                              ELSE classif-fisc.aliquota-cofins-acresc.
            &else
              ASSIGN de-aliquota-pis-maj    = IF ali-dif-pis-temp <> 0
                                              THEN ali-dif-pis-temp     /*Alíquota Diferênciada*/
                                              ELSE DEC(SUBSTRING(classif-fisc.char-1,65,9))
                     de-aliquota-cofins-maj = IF ali-dif-cofins-temp <> 0
                                              THEN ali-dif-cofins-temp  /*Alíquota Diferênciada*/
                                              ELSE DEC(SUBSTRING(classif-fisc.char-1,56,9)).
            &endif
        end.

        if  de-aliquota-cofins-maj <> 0 then do:
            &IF defined(bf_dis_formato_CFOP) &THEN
                assign c-cod-cfop = b-natur-oper-fiscal.cod-cfop.
            &else
                assign c-cod-cfop = trim(substr(b-natur-oper-fiscal.char-1,45,10)).
            &ENDIF

            if trim(c-cod-cfop) begins '3' then do:

                IF NOT VALID-HANDLE(h-im9048) THEN
                    RUN imp/im9048.p PERSISTENT SET h-im9048.

                RUN pi-aliquota-cofins-importacao-credito IN h-im9048 (BUFFER b-natur-oper-fiscal,
                                                                       BUFFER item,
                                                                       INPUT docum-est.cod-estabel,
                                                                       INPUT docum-est.dt-emissao,
                                                                       INPUT YES,
                                                                       INPUT docum-est.embarque,
                                                                       INPUT RowObject.numero-ordem,
                                                                       INPUT RowObject.parcela,
                                                                       OUTPUT i-trib-cofins-cr,
                                                                       OUTPUT de-aliquota-cofins-cr).

                if de-aliquota-cofins-cr <> de-aliquota-cofins then do:
                    &if '{&bf_mat_versao_ems}' >= '2.09' &then
                        assign RowObject.val-aliq-cofins-cr    = de-aliquota-cofins-cr
                               RowObject.val-cofins-cr         = round((de-base-cofins * de-aliquota-cofins-cr) / 100,2)
                               overlay(RowObject.char-2,909,1) = "S":U. /*** Majora‡Æo com aliquota PIS/COFINS zerada ***/
                    &else
                        assign overlay(RowObject.char-2,609,9)  = string(de-aliquota-cofins-cr)
                               overlay(RowObject.char-2,618,16) = string(round((de-base-cofins * de-aliquota-cofins-cr) / 100,2),">>>>>>>>>9.99":U)
                               overlay(RowObject.char-2,909,1)  = "S":U. /*** Majora‡Æo com aliquota PIS/COFINS zerada ***/
                    &endif
                end.
            end.
        end.
        if  de-aliquota-pis-maj <> 0 then do:
            &IF defined(bf_dis_formato_CFOP) &THEN
                assign c-cod-cfop = b-natur-oper-fiscal.cod-cfop.
            &else
                assign c-cod-cfop = trim(substr(b-natur-oper-fiscal.char-1,45,10)).
            &ENDIF

            if trim(c-cod-cfop) begins '3' then do:

                IF NOT VALID-HANDLE(h-im9048) THEN
                    RUN imp/im9048.p PERSISTENT SET h-im9048.

                RUN pi-aliquota-pis-importacao-credito IN h-im9048 (BUFFER b-natur-oper-fiscal,
                                                                    BUFFER item,
                                                                    INPUT docum-est.cod-estabel,
                                                                    INPUT docum-est.dt-emissao,
                                                                    INPUT YES,
                                                                    INPUT docum-est.embarque,
                                                                    INPUT RowObject.numero-ordem,
                                                                    INPUT RowObject.parcela,
                                                                    OUTPUT i-trib-pis-cr,
                                                                    OUTPUT de-aliquota-pis-cr).


                if de-aliquota-pis-cr <> de-aliquota-pis then do:
                    &if '{&bf_mat_versao_ems}' >= '2.09' &then
                        assign RowObject.val-aliq-pis-cr       = de-aliquota-pis-cr
                               RowObject.val-pis-cr            = round((de-base-pis * de-aliquota-pis-cr) / 100,2)
                               overlay(RowObject.char-2,908,1) = "S":U. /*** Majora‡Æo com aliquota PIS/COFINS zerada ***/
                    &else
                        assign overlay(RowObject.char-2,647,9)  = string(de-aliquota-pis-cr)
                               overlay(RowObject.char-2,656,16) = string(round((de-base-pis * de-aliquota-pis-cr) / 100,2),">>>>>>>>>9.99":U)
                               overlay(RowObject.char-2,908,1)  = "S":U. /*** Majora‡Æo com aliquota PIS/COFINS zerada ***/
                    &endif
                end.
            end.
        end.
        IF VALID-HANDLE(h-im9048) THEN
            DELETE PROCEDURE h-im9048.
    END.
    ELSE DO:

        IF AVAIL classif-fisc THEN DO:
            IF  item.class-fiscal = classif-fisc.class-fiscal
            AND dec(substr(item.char-2,79,5)) <> 0 THEN
                IF DEC(SUBSTR(item.char-2,93,9)) <> 0 THEN /* COFINS com 4 decimais */
                    ASSIGN de-aliquota-cofins-maj = DEC(SUBSTR(item.char-2,93,9)).
                ELSE
                    ASSIGN de-aliquota-cofins-maj = dec(substring(item.char-2,79,5)).
            ELSE DO:
                &if '{&bf_dis_versao_ems}' >= '2.09' &then
                    if classif-fisc.aliquota-cofins-acresc <> 0 then
                        assign de-aliquota-cofins-maj = classif-fisc.aliquota-cofins-acresc no-error.
                &else
                    if dec(substring(classif-fisc.char-1,56,9)) <> 0 then
                        assign de-aliquota-cofins-maj = dec(substring(classif-fisc.char-1,56,9)) no-error.
                &endif
            END.
        END.

        if de-aliquota-cofins-maj > 0 then do:
            &IF defined(bf_dis_formato_CFOP) &THEN
                assign c-cod-cfop = natur-oper.cod-cfop.
            &else
                assign c-cod-cfop = trim(substr(natur-oper.char-1,45,10)).
            &ENDIF

            if trim(c-cod-cfop) begins '3' then do:
                run pi-aliquota-cofins-credito in h-cd4337 ( buffer estabelec,
                                                             buffer item,
                                                             buffer emitente,
                                                             buffer natur-oper,
                                                             input  docum-est.dt-emissao,
                                                             output de-aliquota-cofins-cr).

                if de-aliquota-cofins-cr <> de-aliquota-cofins then do:
                    &if '{&bf_dis_versao_ems}' >= '2.09' &then
                        assign RowObject.val-aliq-cofins-cr    = de-aliquota-cofins-cr
                               RowObject.val-cofins-cr         = round((de-base-cofins * de-aliquota-cofins-cr) / 100,2)
                               overlay(RowObject.char-2,909,1) = "S":U. /*** Majora‡Æo com aliquota PIS/COFINS zerada ***/
                    &else
                        assign overlay(RowObject.char-2,609,9)  = string(de-aliquota-cofins-cr)
                               overlay(RowObject.char-2,618,16) = string(round((de-base-cofins * de-aliquota-cofins-cr) / 100,2),">>>>>>>>>9.99":U)
                               overlay(RowObject.char-2,909,1)  = "S":U. /*** Majora‡Æo com aliquota PIS/COFINS zerada ***/
                    &endif
                end.
            end.
        end.

        IF AVAIL classif-fisc THEN DO:
            IF item.class-fiscal = classif-fisc.class-fiscal
            AND dec(substr(item.char-2,74,5)) <> 0  THEN
                IF DEC(SUBSTR(item.char-2,84,9)) <> 0 THEN /* PIS com 4 decimais */
                    ASSIGN de-aliquota-pis-maj = DEC(SUBSTR(item.char-2,84,9)).
                ELSE
                    ASSIGN de-aliquota-pis-maj = dec(substring(item.char-2,74,5)).
            ELSE DO:
                &if '{&bf_dis_versao_ems}' >= '2.09' &then
                    if classif-fisc.val-aliq-pis-acresc <> 0 then
                        assign de-aliquota-pis-maj = classif-fisc.val-aliq-pis-acresc no-error.
                &else
                    if dec(substring(classif-fisc.char-1,65,9)) <> 0 then
                        assign de-aliquota-pis-maj = dec(substring(classif-fisc.char-1,65,9)) no-error.
                &endif
            END.
        END.

        if de-aliquota-pis-maj <> 0 then do:
            &IF defined(bf_dis_formato_CFOP) &THEN
                assign c-cod-cfop = b-natur-oper-fiscal.cod-cfop.
            &else
                assign c-cod-cfop = trim(substr(b-natur-oper-fiscal.char-1,45,10)).
            &ENDIF

            if trim(c-cod-cfop) begins '3' then do:
                run pi-aliquota-pis-credito in h-cd4337 ( buffer estabelec,
                                                          buffer item,
                                                          buffer emitente,
                                                          buffer b-natur-oper-fiscal,
                                                          input  docum-est.dt-emissao,
                                                          output de-aliquota-pis-cr).

                if de-aliquota-pis-cr <> de-aliquota-pis then do:
                    &if '{&bf_dis_versao_ems}' >= '2.09' &then
                        assign RowObject.val-aliq-pis-cr       = de-aliquota-pis-cr
                               RowObject.val-pis-cr            = round((de-base-pis * de-aliquota-pis-cr) / 100,2)
                               overlay(RowObject.char-2,908,1) = "S":U. /*** Majora‡Æo com aliquota PIS/COFINS zerada ***/
                    &else
                        assign overlay(RowObject.char-2,647,9)  = string(de-aliquota-pis-cr)
                               overlay(RowObject.char-2,656,16) = string(round((de-base-pis * de-aliquota-pis-cr) / 100,2),">>>>>>>>>9.99":U)
                               overlay(RowObject.char-2,908,1)  = "S":U. /*** Majora‡Æo com aliquota PIS/COFINS zerada ***/
                    &endif
                end.
            end.
        end.
    END.
    /* ------------------------- */
    /* MP563 - aliquota majorada */
    /* ------------------------- */


    /* Projeto 4 casas decimais */
    RUN recupera-aliquotas IN h-cdapi995 (INPUT  "natur-oper",
                                          INPUT  b-natur-oper-fiscal.nat-operacao,
                                          OUTPUT de-aliq-pis,
                                          OUTPUT de-aliq-cofins).

    if de-aliq-pis = 0 then
        assign de-aliq-pis = b-natur-oper-fiscal.perc-pis[1].
    if de-aliq-cofins = 0 then
        assign de-aliq-cofins = b-natur-oper-fiscal.per-fin-soc[1].
    /****************************/

    IF NOT param-global.modulo-07
    OR substr(docum-est.char-1,1,20) = "" THEN DO:
        if RowObject.nro-comp = "" then do:
            if natur-oper.tipo-compra = 3 or natur-oper.tipo-compra = 8 then do:
                for first item-cli fields(char-1)
                    where item-cli.it-codigo  = RowObject.it-codigo
                      and item-cli.nome-abrev = emitente.nome-abrev no-lock. end.
                if avail item-cli then do:
                    if dec(substr(item-cli.char-1,31,5)) > 0 then /*perc pis*/
                        assign RowObject.vl-pis-subs   = RowObject.base-pis * (decimal(substr(item-cli.char-1,31,5)) / 10000)
                               RowObject.base-pis-subs = RowObject.base-pis.
                    else
                        assign RowObject.vl-pis-subs   = RowObject.quantidade * (decimal(substr(item-cli.char-1,1,15)) / 10000) * (de-aliq-pis / 100)
                               RowObject.base-pis-subs = RowObject.quantidade * (decimal(substr(item-cli.char-1,1,15)) / 10000).

                    if dec(substr(item-cli.char-1,36,5)) > 0 then /*perc cofins*/
                        assign RowObject.vl-cofins-subs   = RowObject.val-base-calc-cofins * (decimal(substr(item-cli.char-1,36,5)) / 10000)
                               RowObject.base-cofins-subs = RowObject.val-base-calc-cofins.
                    else
                        assign RowObject.vl-cofins-subs   = RowObject.quantidade * (decimal(substr(item-cli.char-1,16,15)) / 10000) * (de-aliq-cofins / 100)
                               RowObject.base-cofins-subs = RowObject.quantidade * (decimal(substr(item-cli.char-1,16,15)) / 10000).
                end.

                if not avail item-cli
                or RowObject.vl-pis-subs    = 0
                or RowObject.vl-cofins-subs = 0 then do:
                    for first item-mat fields(val-base-pis-substto val-base-cofins-substto)
                        where item-mat.it-codigo = RowObject.it-codigo no-lock:
                        if RowObject.vl-pis-subs = 0 then
                            assign RowObject.vl-pis-subs    = RowObject.quantidade * item-mat.val-base-pis-substto * (de-aliq-pis / 100)
                                   RowObject.base-pis-subs  = RowObject.quantidade * item-mat.val-base-pis-substto.
                        if RowObject.vl-cofins-subs = 0 then
                            assign RowObject.vl-cofins-subs   = RowObject.quantidade * item-mat.val-base-cofins-substto * (de-aliq-cofins / 100)
                                   RowObject.base-cofins-subs = RowObject.quantidade * item-mat.val-base-cofins-substto.
                    end.
                end.
            end.
            else do:
                for first item-mat fields(val-base-pis-substto val-base-cofins-substto)
                    where item-mat.it-codigo = RowObject.it-codigo no-lock. end.
                if avail item-mat then
                    assign RowObject.vl-pis-subs      = RowObject.quantidade * item-mat.val-base-pis-substto    * (de-aliq-pis    / 100)
                           RowObject.vl-cofins-subs   = RowObject.quantidade * item-mat.val-base-cofins-substto * (de-aliq-cofins / 100)
                           RowObject.base-pis-subs    = item-mat.val-base-pis-substto
                           RowObject.base-cofins-subs = item-mat.val-base-cofins-substto.
            end.
        end.
        else do:
            assign de-vlr-merc-nota-dev = RowObject.preco-total[1] - RowObject.desconto[1].

            IF AVAIL natur-oper AND natur-oper.transf THEN DO:
                for first it-nota-fisc fields(vl-pis vl-finsocial vl-merc-liq val-base-pis-substto val-base-cofins-substto)
                    where it-nota-fisc.cod-estabel = docum-est.estab-de-or
                      and it-nota-fisc.serie       = RowObject.serie-comp
                      and it-nota-fisc.nr-nota-fis = RowObject.nro-comp
                      and it-nota-fisc.nr-seq-fat  = RowObject.seq-comp
                      and it-nota-fisc.it-codigo   = RowObject.it-codigo no-lock. end.
            END.
            ELSE DO:
                for first it-nota-fisc fields(vl-pis vl-finsocial vl-merc-liq val-base-pis-substto val-base-cofins-substto)
                    where it-nota-fisc.cod-estabel = estabelec.cod-estabel
                      and it-nota-fisc.serie       = RowObject.serie-comp
                      and it-nota-fisc.nr-nota-fis = RowObject.nro-comp
                      and it-nota-fisc.nr-seq-fat  = RowObject.seq-comp
                      and it-nota-fisc.it-codigo   = RowObject.it-codigo no-lock. end.
            END.
            IF  AVAIL it-nota-fisc
            AND de-vlr-merc-nota-dev > 0 THEN
                ASSIGN RowObject.vl-pis-subs      = it-nota-fisc.vl-pis                  * (de-vlr-merc-nota-dev / it-nota-fisc.vl-merc-liq)
                       RowObject.vl-cofins-subs   = it-nota-fisc.vl-finsocial            * (de-vlr-merc-nota-dev / it-nota-fisc.vl-merc-liq)
                       RowObject.base-pis-subs    = it-nota-fisc.val-base-pis-substto    * (de-vlr-merc-nota-dev / it-nota-fisc.vl-merc-liq)
                       RowObject.base-cofins-subs = it-nota-fisc.val-base-cofins-substto * (de-vlr-merc-nota-dev / it-nota-fisc.vl-merc-liq).
        END.
    END.

    /** L¢gica inserida para evitar que, quando o valor do PIS/COFINS for igual a ? ou menor que zero,
        o seu valor seja atualizado com zero, evitando os erros Progress 275 e 5368 **/
    if RowObject.vl-pis-subs = ? or
       RowObject.vl-pis-subs < 0 then
        assign RowObject.vl-pis-subs = 0.

    if RowObject.vl-cofins-subs = ? or
       RowObject.vl-cofins-subs < 0 then
        assign RowObject.vl-cofins-subs = 0.

	if RowObject.base-pis-subs = ? or
       RowObject.base-pis-subs < 0 then
        assign RowObject.base-pis-subs = 0.

	if RowObject.base-cofins-subs = ? or
       RowObject.base-cofins-subs < 0 then
        assign RowObject.base-cofins-subs = 0.
    /****************************************************************/

    if valid-handle(h-cd4337) then do:
        delete procedure h-cd4337.
        assign h-cd4337 = ?.
    end.

    if valid-handle(h-cd4338) then do:
        delete procedure h-cd4338.
        assign h-cd4338 = ?.
    end.

    /* configurador de tributos - inicio */
    if not valid-handle(h-bodi613calc2) then
        run dibo/bodi613calc2.p persistent set h-bodi613calc2.

    for each tb-wt-it-docto exclusive-lock:
        assign overlay(tb-wt-it-docto.char-1,100,7) = string(de-aliquota-pis)
               overlay(tb-wt-it-docto.char-1,107,7) = string(de-aliquota-cofins)
               overlay(tb-wt-it-docto.char-2,86,5) = string(de-val-reduc-pis-normal)
               overlay(tb-wt-it-docto.char-2,91,5) = string(de-val-reduc-cofins-normal)
               overlay(tb-wt-it-docto.char-2,96,1) = string(RowObject.idi-tributac-pis)
               overlay(tb-wt-it-docto.char-2,97,1) = string(RowObject.idi-tributac-cofins).
    end.

    for each tb-wt-it-imposto exclusive-lock:
        assign tb-wt-it-imposto.vl-pis             = RowObject.valor-pis
               tb-wt-it-imposto.vl-cofins          = RowObject.val-cofins.
    end.


    /* enviar temp-tables */
    run enviaTbWtDocto in h-bodi613calc2 ( input table tb-wt-docto ) .
    run enviaTbWtItDocto in h-bodi613calc2 ( input table tb-wt-it-docto ) .
    run enviaTbWtItImposto in h-bodi613calc2 ( input table tb-wt-it-imposto ).

    RUN localizaWtDocto in h-bodi613calc2 ( input 1,
                                            output l-procedimento-ok ).
    if  not l-procedimento-ok then do:
        delete procedure h-bodi613calc2.
        RETURN "NOK":U.
    end.

    RUN pi-recebe-handle in h_bodi317im2bra (input "h-bodi613calc2",
                                             input h-bodi613calc2).

    RETURN "OK":U.

END PROCEDURE.
