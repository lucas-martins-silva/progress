&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    DEFINE VARIABLE c-liter      AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/
    
    IF pType = "CREATE" OR  pType = "UPDATE"  THEN DO:
     
        FIND FIRST bfinternac-tip-operacao WHERE 
                   bfinternac-tip-operacao.cdn-tip-operacao  = RowObject.cdn-tip-operacao NO-LOCK NO-ERROR.
        IF AVAIL bfinternac-tip-operacao THEN DO:
               
            IF ptype = "Create":U THEN DO:
               {utp/ut-liter.i C¢digo *}
               {method/svc/errors/inserr.i &ErrorNumber="7" /*&1 j† cadastrado(a)*/
                                           &ErrorType="EMS"
                                           &ErrorSubType="ERROR"
                                           &ErrorParameters="RETURN-VALUE"}
            END.
        END.
    END. 
    
    IF pType = "Delete" THEN DO:
     
        IF i-pais-impto-usuario = 33 /* Peru */ THEN DO:
         
            FIND FIRST movto-estoq-internac 
                 WHERE movto-estoq-internac.des-decla-import = 'dadosPeru' AND 
                       movto-estoq-internac.cdn-tip-operac   = RowObject.cdn-tip-operacao NO-LOCK NO-ERROR.
            IF AVAIL movto-estoq-internac THEN DO:
                {utp/ut-liter.i "Tipo_de_Operaá∆o" *}
                ASSIGN c-liter = TRIM(RETURN-VALUE).
                {utp/ut-liter.i "Movimento_de_Estoque" *}
                ASSIGN c-liter = c-liter  + '~~' + TRIM(RETURN-VALUE).
                {utp/ut-liter.i movimento *}
                {method/svc/errors/inserr.i &ErrorNumber="35032" /*N∆o ≤ poss°vel excluir o &1*/
                                            &ErrorType="EMS"
                                            &ErrorSubType="ERROR"
                                            &ErrorParameters="c-liter"}
            
            END.
             
            FIND FIRST ext-docum-est
                 WHERE ext-docum-est.num-livre-2 = RowObject.cdn-tip-operacao NO-LOCK NO-ERROR.
            IF AVAIL ext-docum-est THEN DO:
                {utp/ut-liter.i "Tipo_de_Operaá∆o" *}
                ASSIGN c-liter = TRIM(RETURN-VALUE).
                {utp/ut-liter.i "Documento_no_Recebimento" *}
                ASSIGN c-liter = c-liter  + '~~' + TRIM(RETURN-VALUE).
                {method/svc/errors/inserr.i &ErrorNumber="35032" /*N∆o ≤ poss°vel excluir o &1*/
                                            &ErrorType="EMS"
                                            &ErrorSubType="ERROR"
                                            &ErrorParameters="c-liter"}
            
            END.
        END.
    END.

    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

