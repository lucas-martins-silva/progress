/*------------------------------------------------------------------------------

  Purpose:  Metodo usado para retornar a chave do documento do GFE usado na aprova‡Æo do MLA   
  Parameters:  Passa a chave do documento sem pipe e retorna a chave com pipe ex: 1 |77785  |1303 |10
  Notes:       
------------------------------------------------------------------------------*/

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE ReturnKeyDoc DBOProgram 
PROCEDURE ReturnKeyDoc :
    DEFINE INPUT  PARAMETER p-chave-doc      AS CHARACTER NO-UNDO.
    DEFINE INPUT  PARAMETER p-cod-tip-doc    AS INTEGER   NO-UNDO.        
    DEFINE OUTPUT PARAMETER p-retorno-chave  AS CHARACTER NO-UNDO.

    DEF VAR cBusca AS CHARACTER INITIAL ' '. 
    DEF VAR cRetorno AS CHARACTER INITIAL ''.
    DEF VAR i-aux AS INTEGER.
    DEF VAR i-cont AS INTEGER.
    DEF VAR valorLoop AS CHARACTER NO-UNDO.

    REPEAT i-cont = 1 TO NUM-ENTRIES(p-chave-doc,cBusca):
        ASSIGN valorLoop = ENTRY(i-cont,p-chave-doc, cBusca). 
            IF TRIM(valorLoop) <> '' AND TRIM(valorLoop) <> ? THEN
            DO: 
                IF cRetorno <> '' THEN
                    cRetorno = cRetorno + '|' + valorLoop.
                ELSE
                    cRetorno = valorLoop.
            END.

            IF (i-cont = 9) AND (valorLoop = '') AND (p-cod-tip-doc = 31) THEN /* Quando Serie ‚ vazio */
                    cRetorno = cRetorno + '|' + ''.
    
            IF (i-cont = 12) AND (valorLoop = '') AND (p-cod-tip-doc = 30) THEN /* Quando Serie ‚ vazio */
                    cRetorno = cRetorno + '|' + ''.
            

    END.
        
    ASSIGN p-retorno-chave = cRetorno.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
