PROCEDURE createDoctoItemOfRecFisico :
/*-----------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:  Criaá∆o de notas fiscais provenientes do recebimento f°sico.
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAM TABLE FOR tt-nat-of-itens.
    DEF OUTPUT PARAMETER r-docum-est AS ROWID                    NO-UNDO.
    DEF OUTPUT PARAMETER l-erro-imp  AS LOG                      NO-UNDO.
    

    DEF VAR dt-mensal-ate            LIKE param-estoq.mensal-ate NO-UNDO.
    DEF VAR l-erro                   AS LOGICAL                  NO-UNDO.
    DEF VAR h-boin735                AS HANDLE                   NO-UNDO.
    DEF VAR h-bodi516                AS HANDLE                   NO-UNDO.
    DEF VAR h-reapi429               AS HANDLE                   NO-UNDO.
    DEF VAR h-reapi435               AS HANDLE                   NO-UNDO.
    DEF VAR h-re1911                 AS HANDLE                   NO-UNDO.
    DEF VAR c-msg-liter              AS CHAR FORMAT "x(20)"      NO-UNDO.
    DEF VAR r-aux-nada               AS ROWID                    NO-UNDO. /* Usada somente p n∆o dar erro no chamada da validateFieldsKey() */
    DEF VAR c-liter-1                AS CHAR NO-UNDO.
    
    def buffer bf-estabelec-dep      for estabelec.
    DEF BUFFER bf-nat-oper-it        FOR natur-oper. /* buffer aux. para buscar a natureza do item */
    DEF BUFFER bf-doc-orig-nfe       FOR doc-orig-nfe.
    
    
    RUN validateFieldsKey(OUTPUT r-aux-nada). /* Validaá∆o de campos chave... */

    if  not avail emitente then
        run findemitente (RowObject.cod-emitente).
    
    assign RowObject.uf = emitente.estado.
    
    if  NOT valid-handle(h-reapi435)
    AND RowObject.origem <> "XML" 
    AND CAN-FIND(FIRST funcao NO-LOCK
                 WHERE funcao.cd-funcao = "RE-SUGERE-SEQ-UN-XML":U 
                   AND funcao.ativo) THEN
        run rep/reapi435.p persistent set h-reapi435.
        

    IF RowObject.cod-observa = 3 AND NOT VALID-HANDLE(h-reapi429) THEN
       RUN rep/reapi429.p PERSISTENT SET h-reapi429.
       
    find first RowErrors 
         where RowErrors.ErrorSubType = "ERROR":U no-lock no-error.

    if  not avail RowErrors then do:
        if  not avail doc-fisico then        
            find doc-fisico 
                where doc-fisico.serie-docto  = RowObject.serie-docto  
                  and doc-fisico.nro-docto    = RowObject.nro-docto    
                  and doc-fisico.cod-emitente = RowObject.cod-emitente 
                  and doc-fisico.tipo-nota    = RowObject.tipo-nota    
                  and doc-fisico.situacao     = 2
                no-lock no-error.
        if  not available doc-fisico then do:        
            {method/svc/errors/inserr.i
                                &ErrorNumber="17419" /* N∆o existem documentos */
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U }
        end.
        else do:
            for each it-doc-fisico no-lock
               where it-doc-fisico.serie-docto  = doc-fisico.serie-docto
                 and it-doc-fisico.cod-emitente = doc-fisico.cod-emitente
                 and it-doc-fisico.nro-docto    = doc-fisico.nro-docto
                 and it-doc-fisico.tipo-nota    = doc-fisico.tipo-nota:
                    if  doc-fisico.tipo-nota = 2 then do:                
                            if doc-fisico.dt-emissao < it-doc-fisico.data-comp  then do:
                                    assign c-msg-liter = "".
                                    {utp/ut-liter.i "Data_de_emiss∆o_da_nota_de_sa°da" * R}
                                    assign c-msg-liter = return-value.
                                    {utp/ut-liter.i "data_de_emiss∆o_da_devoluá∆o" * R}
                            
                                    {method/svc/errors/inserr.i
                                         &ErrorNumber="17085" 
                                         &ErrorType="EMS":U
                                         &ErrorSubType="ERROR":U
                                         &ErrorParameters="c-msg-liter + '~~~~' + RETURN-VALUE" }
                                         return "NOK":U.
                            end.
                    end. 
            end.  
	    if  RowObject.dt-trans < doc-fisico.dt-trans then do:
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-transacao-rec-fiscal AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Transaá∆o_(Recebimento_Fiscal)" *}
                ASSIGN c-lbl-liter-transacao-rec-fiscal = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-transacao-rec-fisico AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Transaá∆o_(Recebimento_F°sico)" *}
                ASSIGN c-lbl-liter-transacao-rec-fisico = TRIM(RETURN-VALUE).
                {method/svc/errors/inserr.i
                                    &ErrorNumber="89"
                                    &ErrorType="EMS":U
                                    &ErrorSubType="ERROR":U
                                    &ErrorParameters="c-lbl-liter-transacao-rec-fiscal + '~~~~' + c-lbl-liter-transacao-rec-fisico" }
                 return "NOK":U.                    
            end.
            
            /* Verifica Bancos Hist¢ricos */    
            if  avail param-global
            and param-global.modulo-bh 
            and can-find ( first his-docum-est 
                           where his-docum-est.serie-docto  = RowObject.serie-docto 
                             and his-docum-est.nro-docto    = RowObject.nro-docto
                             and his-docum-est.cod-emitente = RowObject.cod-emitente     
                             and his-docum-est.nat-operacao = RowObject.nat-operacao ) then do:
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-documento-estoque AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Documento_Estoque" *}
                ASSIGN c-lbl-liter-documento-estoque = TRIM(RETURN-VALUE).
                {method/svc/errors/inserr.i &ErrorNumber="28152"
                                            &ErrorType="EMS"
                                            &ErrorSubType="ERROR"
                                            &ErrorParameters="c-lbl-liter-documento-estoque" }
            end.
                                  
            /* Determina data do mÇdio */
            if  param-estoq.tp-fech = 1 then
                assign dt-mensal-ate = param-estoq.mensal-ate.
            else do:
                
                run findEstabelec ( doc-fisico.cod-estabel ).

                if  avail estab-mat then 
                    assign dt-mensal-ate = estab-mat.mensal-ate.
            end.                
            
            if  RowObject.dt-trans <= dt-mensal-ate then do:
                {method/svc/errors/inserr.i
                                    &ErrorNumber="1586"
                                    &ErrorType="EMS":U
                                    &ErrorSubType="ERROR":U }
                return "NOK":U.                                    
            end.
            
            if  avail natur-oper
            and natur-oper.tipo-compra = 9 //Credito/Debito
            then do:
 
                {utp/ut-liter.i pelo_recebimento_f°sico * r }
                ASSIGN c-liter-1 = TRIM(RETURN-VALUE).
                
                {method/svc/errors/inserr.i
                                    &ErrorNumber="58157"
                                    &ErrorType="EMS":U
                                    &ErrorSubType="ERROR":U
                                    &ErrorParameters="c-liter-1"}
            end.            
            
            if can-find(first RowErrors 
                        where RowErrors.ErrorSubType = "ERROR":U ) then
                return "NOK":U.
                
            for each tt-erro:
                delete tt-erro.
            end.                

            run rep/re2905.p (input rowid(doc-fisico),
                              input RowObject.nat-operacao,
                              input RowObject.cod-observa,
                              input RowObject.dt-trans,
                              INPUT TABLE tt-nat-of-itens, /* Naturezas fiscais dos itens (nat-of) */
                              input RowObject.cod-finalidade,
                              input RowObject.cod-tipo-nf-cred-deb,                              
                              output r-docum-est,
                              output l-erro-imp,
                              output table tt-erro).
                              
                              
            IF CAN-FIND(FIRST funcao NO-LOCK
                        WHERE funcao.cd-funcao = "spp-NT2024002":U
                          AND funcao.ativo ) THEN DO: 
                          
                IF NOT VALID-HANDLE(h-re1911) THEN
                   RUN rep/re1911.p PERSISTENT SET h-re1911.  
                   
                FOR EACH doc-orig-refer-nfe NO-LOCK 
                   WHERE doc-orig-refer-nfe.ch-acesso-comp-nfe  = RowObject.cod-chave-aces-nf-eletro 
                     AND doc-orig-refer-nfe.idi-orig-trad       = 2 :
                     
                    FIND FIRST b-docum-est
                         WHERE rowid(b-docum-est) = r-docum-est NO-LOCK NO-ERROR.
            
                    IF  AVAIL b-docum-est 
                    AND (  doc-orig-refer-nfe.pagto-antecipado = YES 
                         OR  b-docum-est.cod-tipo-oper-gov     = 2 
                         OR  b-docum-est.cod-tipo-oper-gov     = 3) THEN DO:
                       
                        run setCodEstabel   in h-re1911 (input b-docum-est.cod-estabel).
                        run setSerieDocto   in h-re1911 (input b-docum-est.serie-docto).
                        run setNroDocto     in h-re1911 (input b-docum-est.nro-docto).
                        run setCodEmitente  in h-re1911 (input b-docum-est.cod-emitente).
                        run setNatOperacao  in h-re1911 (input b-docum-est.nat-operacao).
                        run setChaveRefer   in h-re1911 (input doc-orig-refer-nfe.ch-acesso-nfe).
                        run setNumSeq       in h-re1911 (input doc-orig-refer-nfe.num-seq ).
                        run setTipoDocto    in h-re1911 (input 3). //documento referànciado
                        run setPagtoAntecip in h-re1911 (input doc-orig-refer-nfe.pagto-antecipado).
                        
                        RUN emptyTtNotaFiscAdc in h-re1911.
                        run efetivarTtNotaFisc in h-re1911.
                        run getRowErrors in h-re1911 (OUTPUT TABLE rowErrors).
                    END.
                END.
                                
                /* Chamar o RE1911 para gravar o idi-tip-dado = 20 (dt-prev-entrega) */
                FIND FIRST bf-doc-orig-nfe 
                    WHERE bf-doc-orig-nfe.ch-acesso-comp-nfe = RowObject.cod-chave-aces-nf-eletro
                    AND   bf-doc-orig-nfe.idi-orig-trad      = 2
                    NO-LOCK NO-ERROR.
                                                
                IF AVAIL bf-doc-orig-nfe AND bf-doc-orig-nfe.dt-prev-entrega <> ? THEN DO:
                                                        
                    IF VALID-HANDLE(h-re1911) THEN DO:
                        
                        run setCodEstabel   in h-re1911 (input RowObject.cod-estabel).
                        run setSerieDocto   in h-re1911 (input RowObject.serie-docto).
                        run setNroDocto     in h-re1911 (input RowObject.nro-docto).
                        run setCodEmitente  in h-re1911 (input RowObject.cod-emitente).
                        run setNatOperacao  in h-re1911 (input RowObject.nat-operacao).
                        run setChaveRefer   in h-re1911 (input RowObject.cod-chave-aces-nf-eletro).
                        run setNumSeq       in h-re1911 (0).
                        run setTipoDocto    in h-re1911 (input 20).
                        run setPagtoAntecip in h-re1911 (input NO).
                        
                        RUN emptyTtNotaFiscAdc in h-re1911.
                        run efetivarTtNotaFisc in h-re1911.
                        run getRowErrors in h-re1911 (OUTPUT TABLE rowErrors).
                    END.
                END.
            END.
                                      

           /*ksm 42618 Chamada UPC UAA*/ 
           if c-nom-prog-dpc-mg97  <> ""  or
              c-nom-prog-upc-mg97  <> ""  or  
              c-nom-prog-appc-mg97 <> "" then do:
               
		   FOR EACH tt-epc
                     WHERE tt-epc.cod-event     = "Create-docum-est"
                       and tt-epc.cod-parameter = "rowid-docum-est":
                     DELETE tt-epc.
                   END.
                   
                   CREATE tt-epc.    
                   ASSIGN tt-epc.cod-event     = "Create-docum-est"
                          tt-epc.cod-parameter = "rowid-docum-est"
                          tt-epc.val-parameter = string(r-docum-est).
                          
                   {include/i-epc201.i "Create-docum-est"} 
            end.        
            /*fim ksm 42618 Chamada UPC UAA*/    
            for each tt-erro:
                &if "{&bf_mat_versao_ems}":U >= "2.04":U &then
                        {method/svc/errors/inserr.i
                                            &ErrorNumber=tt-erro.cd-erro
                                            &ErrorType="EMS":U
                                            &ErrorParameters=tt-erro.mensagem }
                &else
                        {method/svc/errors/inserr.i
                                            &ErrorNumber=tt-erro.cd-erro
                                            &ErrorType="EMS":U
                                            &ErrorSubType="ERROR":U }
                &endif
            end.

            if not l-erro-imp and
               can-find (first tt-erro) then
               return "NOK":U.
               
            for each it-doc-fisico no-lock
               where it-doc-fisico.serie-docto  = doc-fisico.serie-docto
                 and it-doc-fisico.cod-emitente = doc-fisico.cod-emitente
                 and it-doc-fisico.nro-docto    = doc-fisico.nro-docto
                 and it-doc-fisico.tipo-nota    = doc-fisico.tipo-nota:
                 
                if  avail natur-oper and it-doc-fisico.nro-comp <> "" then do:
                    {cdp/cd9700.i1 natur-oper}
                    
                    if  natur-oper.tp-oper-terc = 2 or      /*Retorno Beneficiamento ou Remessa de Entrega Futura*/
                        natur-oper.tp-oper-terc = 4 or      /*Faturamento Consignaá∆o*/
                        natur-oper.tp-oper-terc = 5 or      /*Devoluá∆o Consignaá∆o*/
                        natur-oper.tipo-compra  = 3 or      /*Devoluá∆o Cliente*/ 
                        (natur-oper.transf and natur-oper.log-contrib-st-antec) or /*Transferencia*/
                        l-remessa-fat-antecip        or     /*Remessa de Faturamento Antecipado*/
                        natur-oper.tp-oper-terc = 9  or     /*Ret Dep Fechado*/
                        natur-oper.tp-oper-terc = 11 then   /*Ret Armazem Geral*/

                        RUN notaFiscAdic.
                end.               
                
                IF  VALID-HANDLE(h-reapi435)
                AND natur-oper.cod-model-nf-eletro = "55":U
                AND RowObject.origem <> "XML" 
                AND CAN-FIND(FIRST funcao NO-LOCK
                             WHERE funcao.cd-funcao = "RE-SUGERE-SEQ-UN-XML":U 
                               AND funcao.ativo) THEN DO:
                     
                    RUN setUnidComercial IN h-reapi435 (input it-doc-fisico.un).
                    RUN setTipoNota      IN h-reapi435 (INPUT it-doc-fisico.tipo-nota).
                    RUN setEmitente      IN h-reapi435 (INPUT it-doc-fisico.cod-emitente).
                    RUN setSerieDocto    IN h-reapi435 (INPUT it-doc-fisico.serie-docto).
                    RUN setNroDocto      IN h-reapi435 (INPUT it-doc-fisico.nro-docto ).
                    RUN setNatOper       IN h-reapi435 (INPUT RowObject.nat-operacao).
                    RUN setSequencia     IN h-reapi435 (INPUT it-doc-fisico.sequencia).
                    RUN sugereSeqUnXMLOrigFisico IN h-reapi435.
                    RUN efetivaTtExtItemDocEst IN h-reapi435.
                    
                END.
                
                 if  avail natur-oper and it-doc-fisico.nro-comp <> "" then do:
                     {cdp/cd9700.i1 natur-oper}
                     
                     /* Alerta - Nota Devoluá∆o n∆o permite vincular Nota Oper. Terceiros */
                     if natur-oper.tipo-compra = 3 and /*Devolucao Cliente*/
                        SUBSTRING(natur-oper.char-1,159,1) <> "S" and /*NF de Estorno*/
                        (not l-fatura-ent-futura  and not l-remessa-ent-futura and
                         not l-fatura-fat-antecip and not l-remessa-fat-antecip) then do:
                         
                         find first saldo-terc no-lock 
                              where saldo-terc.cod-emitente = it-doc-fisico.cod-emitente
                                and saldo-terc.serie-docto  = it-doc-fisico.serie-comp
                                and saldo-terc.nro-docto    = it-doc-fisico.nro-comp
                                and saldo-terc.nat-operacao = it-doc-fisico.nat-comp
                                and saldo-terc.it-codigo    = it-doc-fisico.it-codigo
                                and saldo-terc.cod-refer    = it-doc-fisico.cod-refer
                                and saldo-terc.sequencia    = it-doc-fisico.seq-comp no-error.
                         if avail saldo-terc then do:
                             {utp/ut-liter.i "Seq" *}
                             assign c-msg-liter = RETURN-VALUE + ": " + string(it-doc-fisico.sequencia).
                         
                             /* Alerta - Nota Devoluá∆o n∆o permite vincular Nota Oper. Terceiros */
                             {method/svc/errors/inserr.i &ErrorNumber="56798"
                                                         &ErrorType="EMS":U
                                                         &ErrorSubType="INFORMATION":U
                                                         &ErrorParameters="c-msg-liter"}
                                                         
                             if not valid-handle (h_boin060) then
                                 run inbo/boin060.p persistent set h_boin060.
                             
                             run updateConsistNota in h_boin060 ( it-doc-fisico.cod-emitente,
                                                                  it-doc-fisico.serie-docto,
                                                                  it-doc-fisico.nro-docto,
                                                                  RowObject.nat-operacao,
                                                                  it-doc-fisico.sequencia,
                                                                  no,
                                                                  0,
                                                                  0,
                                                                  56798,
                                                                  2).
                                                                  
                             if valid-handle (h_boin060) then
                                 delete procedure h_boin060.
                         end. /*if avail saldo-terc*/         
                                         
                        IF RowObject.cod-observa = 3 AND VALID-HANDLE(h-reapi429) THEN DO:
                            
                            RUN emptyTtItemDocEstTribut IN h-reapi429.
                            FOR FIRST item-doc-est NO-LOCK
                                WHERE item-doc-est.cod-emitente = RowObject.cod-emitente
                                AND   item-doc-est.serie-docto  = RowObject.serie-docto 
                                AND   item-doc-est.nro-docto    = RowObject.nro-docto   
                                AND   item-doc-est.nat-operacao = RowObject.nat-operacao
                                AND   item-doc-est.sequencia    = it-doc-fisico.sequencia:
                                
                                RUN calcDescBcPisCofins  IN h-reapi429 (INPUT BUFFER item-doc-est:HANDLE).
                                RUN saveItemDocEstTribut IN h-reapi429.
                            END.
                        end. 
                     end. /*if natur-oper.tipo-compra = 3*/
                     /*********************************************************************/
                 end.
                 
                 /*** REINF R-2055 CD4035 - Aquisiá∆o Produá∆o Rural ***/
                 IF AVAIL emitente AND SUBSTRING(emitente.char-2,104,8) = "PR Rural":U AND
                    AVAIL natur-oper AND SUBSTRING(natur-oper.char-1,176,1) <> "0" AND /*Comercializacao Producao Rural*/
                    natur-oper.emite-duplic AND         /*Gerar Duplicatas*/
                    docum-est.cod-observa <> 3 AND      /*Devoluá∆o Cliente*/
                    docum-est.cod-observa <> 4 THEN DO: /*Serviáo*/
        
                     IF l-mult-natur-receb THEN DO: /* Var def em cd9701.i */
                        FIND FIRST tt-nat-of-itens NO-LOCK 
                             WHERE tt-nat-of-itens.sequencia = it-doc-fisico.sequencia NO-ERROR.
                        
                        FIND FIRST bf-nat-oper-it NO-LOCK 
                             WHERE bf-nat-oper-it.nat-operacao = tt-nat-of-itens.nat-of NO-ERROR.
                     END.   
                     ELSE 
                         FIND FIRST bf-nat-oper-it NO-LOCK 
                              WHERE bf-nat-oper-it.nat-operacao = RowObject.nat-operacao NO-ERROR.
                    
                     EMPTY TEMP-TABLE tt-item-nf-adc.
                     
                     IF NOT VALID-HANDLE(h-bodi516) THEN
                        RUN dibo/bodi516.p PERSISTENT SET h-bodi516.
                     RUN openQueryStatic IN h-bodi516 (INPUT "Main":U).
                     
                     CREATE tt-item-nf-adc.
                     ASSIGN tt-item-nf-adc.cod-estab        = RowObject.cod-estabel
                            tt-item-nf-adc.cod-serie        = it-doc-fisico.serie-docto 
                            tt-item-nf-adc.cod-nota-fisc    = it-doc-fisico.nro-docto   
                            tt-item-nf-adc.cdn-emitente     = it-doc-fisico.cod-emitente
                            tt-item-nf-adc.cod-natur-operac = bf-nat-oper-it.nat-operacao
                            tt-item-nf-adc.idi-tip-dado     = 35 /*REINF R-2055*/
                            tt-item-nf-adc.num-seq          = it-doc-fisico.sequencia
                            tt-item-nf-adc.num-seq-item-nf  = it-doc-fisico.sequencia
                            tt-item-nf-adc.cod-item         = it-doc-fisico.it-codigo
                            tt-item-nf-adc.val-livre-1      = (it-doc-fisico.preco-total[1] + it-doc-fisico.despesas[1] - it-doc-fisico.desconto[1]).
                            
                      RUN goToKey IN h-bodi516 (INPUT RowObject.cod-estabel,       
                                                INPUT it-doc-fisico.serie-docto,       
                                                INPUT it-doc-fisico.nro-docto,   
                                                INPUT it-doc-fisico.cod-emitente,    
                                                INPUT bf-nat-oper-it.nat-operacao,
                                                INPUT 35, /*REINF R-2055*/
                                                INPUT it-doc-fisico.sequencia,
                                                INPUT it-doc-fisico.sequencia,
                                                INPUT it-doc-fisico.it-codigo).
                      IF RETURN-VALUE <> "OK":U THEN DO:
                          RUN setRecord      IN h-bodi516 (INPUT TABLE tt-item-nf-adc).
                          RUN emptyRowErrors IN h-bodi516.
                          RUN createRecord   IN h-bodi516.
                      END.
                      
                      IF VALID-HANDLE(h-bodi516) THEN
                          DELETE PROCEDURE h-bodi516.
                 END.
                 /******************************************************/       
                 /**************NFe - Grupo combust°vel****************************************/
                 IF   AVAIL natur-oper 
                 AND  natur-oper.cod-model-nf-eletro    = "55" 
                 AND  it-doc-fisico.cod-prod-anp        <> ""  THEN DO: 
                 
                     IF l-mult-natur-receb THEN DO: /* Var def em cd9701.i */
                        FIND FIRST tt-nat-of-itens NO-LOCK 
                             WHERE tt-nat-of-itens.sequencia = it-doc-fisico.sequencia NO-ERROR.
                        
                        FIND FIRST bf-nat-oper-it NO-LOCK 
                             WHERE bf-nat-oper-it.nat-operacao = tt-nat-of-itens.nat-of NO-ERROR.
                     END.   
                     ELSE 
                         FIND FIRST bf-nat-oper-it NO-LOCK 
                              WHERE bf-nat-oper-it.nat-operacao = RowObject.nat-operacao NO-ERROR.
                    
                     EMPTY TEMP-TABLE tt-item-nf-adc.
                     
                     IF NOT VALID-HANDLE(h-bodi516) THEN
                        RUN dibo/bodi516.p PERSISTENT SET h-bodi516.
                     RUN openQueryStatic IN h-bodi516 (INPUT "Main":U).
                                           
                     CREATE tt-item-nf-adc.
                     ASSIGN tt-item-nf-adc.cod-estab        = doc-fisico.cod-estabel 
                            tt-item-nf-adc.cod-serie        = it-doc-fisico.serie-docto 
                            tt-item-nf-adc.cod-nota-fisc    = it-doc-fisico.nro-docto   
                            tt-item-nf-adc.cdn-emitente     = it-doc-fisico.cod-emitente
                            tt-item-nf-adc.cod-natur-operac = bf-nat-oper-it.nat-operacao
                            tt-item-nf-adc.idi-tip-dado     = 36 /*NFe - grupo combustivel*/
                            tt-item-nf-adc.num-seq          = it-doc-fisico.sequencia
                            tt-item-nf-adc.num-seq-item-nf  = it-doc-fisico.sequencia
                            tt-item-nf-adc.cod-item         = it-doc-fisico.it-codigo
                            tt-item-nf-adc.cod-livre-1      = it-doc-fisico.cod-prod-anp 
                            tt-item-nf-adc.cod-livre-2      = it-doc-fisico.desc-anp     
                            tt-item-nf-adc.val-livre-1      = it-doc-fisico.perc-glp     
                            tt-item-nf-adc.val-livre-2      = it-doc-fisico.perc-gnn     
                            tt-item-nf-adc.val-livre-3      = it-doc-fisico.perc-gni     
                            tt-item-nf-adc.val-livre-4      = it-doc-fisico.valor-part.  

                      FOR FIRST item-doc-orig-nfe NO-LOCK
                          WHERE item-doc-orig-nfe.ch-acesso-comp-nfe        = doc-fisico.cod-chave-aces-nf-eletro
                            AND item-doc-orig-nfe.seq-item                  = INTEGER(SUBSTRING(it-doc-fisico.char-2,42,5)):
                          ASSIGN OVERLAY(tt-item-nf-adc.cod-livre-3,1,8)    = IF STRING(item-doc-orig-nfe.perc-mistura-biodiesel) = ""
                                                                              OR item-doc-orig-nfe.perc-mistura-biodiesel         = ?   THEN "0"
                                                                              ELSE STRING(item-doc-orig-nfe.perc-mistura-biodiesel). 
                      END.
                      
                      RUN goToKey IN h-bodi516 (INPUT doc-fisico.cod-estabel,
                                                INPUT it-doc-fisico.serie-docto,       
                                                INPUT it-doc-fisico.nro-docto,   
                                                INPUT it-doc-fisico.cod-emitente,    
                                                INPUT bf-nat-oper-it.nat-operacao,
                                                INPUT 36, /*NFe - grupo combustivel*/
                                                INPUT it-doc-fisico.sequencia,
                                                INPUT it-doc-fisico.sequencia,
                                                INPUT it-doc-fisico.it-codigo).
                      IF RETURN-VALUE <> "OK":U THEN DO:
                          RUN setRecord      IN h-bodi516 (INPUT TABLE tt-item-nf-adc).
                          RUN emptyRowErrors IN h-bodi516.
                          RUN createRecord   IN h-bodi516.
                      END.
                      
                      FOR EACH item-doc-orig-comb-nfe NO-LOCK
                          WHERE item-doc-orig-comb-nfe.ch-acesso-comp-nfe = doc-fisico.cod-chave-aces-nf-eletro
                            AND item-doc-orig-comb-nfe.idi-orig-trad      = 2
                            AND item-doc-orig-comb-nfe.seq-item           = INTEGER(SUBSTRING(it-doc-fisico.char-2,42,5)): 
                           
                           EMPTY TEMP-TABLE tt-item-nf-adc.
                          
                          CREATE tt-item-nf-adc.
                          ASSIGN tt-item-nf-adc.cod-estab       = doc-fisico.cod-estabel
                                 tt-item-nf-adc.cod-serie       = it-doc-fisico.serie-docto
                                 tt-item-nf-adc.cod-nota-fisc   = it-doc-fisico.nro-docto
                                 tt-item-nf-adc.cdn-emitente    = it-doc-fisico.cod-emitente
                                 tt-item-nf-adc.cod-natur-operac  = bf-nat-oper-it.nat-operacao
                                 tt-item-nf-adc.idi-tip-dado    = 37 /* Grupo Origem Combust°vel*/
                                 tt-item-nf-adc.num-seq         = INTEGER(item-doc-orig-comb-nfe.seq-orig-comb)
                                 tt-item-nf-adc.num-seq-item-nf = it-doc-fisico.sequencia
                                 tt-item-nf-adc.cod-item        = it-doc-fisico.it-codigo.
                                 
                          ASSIGN tt-item-nf-adc.num-livre-1 = item-doc-orig-comb-nfe.ind-import   /*ttorigComb.indImport*/
                                 tt-item-nf-adc.val-livre-1 = item-doc-orig-comb-nfe.perc-orig.   /*ttorigComb.pOrig*/
                                                                      
                          FIND FIRST unid-feder 
                              WHERE unid-feder.cod-uf-ibge = item-doc-orig-comb-nfe.uf-orig NO-LOCK NO-ERROR.
                          IF AVAIL unid-feder THEN
                              ASSIGN tt-item-nf-adc.cod-livre-1 = unid-feder.estado.
                          ELSE
                              ASSIGN tt-item-nf-adc.cod-livre-1 = "".                                 
                               
                          RUN goToKey IN h-bodi516 (INPUT tt-item-nf-adc.cod-estab,
                                                    INPUT tt-item-nf-adc.cod-serie,
                                                    INPUT tt-item-nf-adc.cod-nota-fisc,
                                                    INPUT tt-item-nf-adc.cdn-emitente,
                                                    INPUT tt-item-nf-adc.cod-natur-operac,
                                                    INPUT 37, /* Grupo Origme Combustivel */ 
                                                    INPUT tt-item-nf-adc.num-seq,
                                                    INPUT tt-item-nf-adc.num-seq-item-nf,
                                                    INPUT tt-item-nf-adc.cod-item).
                                                  
                          IF RETURN-VALUE <> "OK":U THEN DO:
                              RUN setRecord       IN h-bodi516 (INPUT TABLE tt-item-nf-adc).
                              RUN emptyRowErrors  IN h-bodi516.
                              RUN createRecord    IN h-bodi516.
                          END.    
                      END.
                      
                      IF VALID-HANDLE(h-bodi516) THEN
                          DELETE PROCEDURE h-bodi516.
                 END.
                 /******************************************************/
            end.  
            
            IF  avail natur-oper 
                AND natur-oper.terceiros
                AND natur-oper.tp-oper-terc = 8  THEN DO: /* Rem Deposito Fechado*/   
                
                run findEstabelec ( doc-fisico.cod-estabel). /*Estabelecimento da nota*/
                

                for first bf-estabelec-dep
                   where bf-estabelec-dep.cod-emitente = RowObject.cod-emitente no-lock.  /*Procura pelo estabelecimento do emitente da nota Fabrica*/
                end.
                
                IF NOT CAN-FIND (FIRST saldo-terc  
                        WHERE saldo-terc.serie-docto     = RowObject.serie-docto
                          AND saldo-terc.nro-docto       = RowObject.nro-docto
                          AND saldo-terc.cod-emitente    = estabelec.cod-emitente
                          AND saldo-terc.cod-estabel     = bf-estabelec-dep.cod-estabel
                          AND saldo-terc.tipo-sal-terc = 7 )THEN DO:  /* Saida Deposito Fechado*/
                
                   {method/svc/errors/inserr.i
                                     &ErrorNumber="56824" /*Nota Fiscal de Remessa de Dep¢sito Fechado deve possuir o mesmo n£mero de documento, emitente e sÇrie da operaá∆o de remessa sa°da*/
                                     &ErrorType="EMS":U
                                     &ErrorSubType="WARNING":U
                                     &ErrorParameters="''"}
                             
                   if not valid-handle (h_boin060) then
                        run inbo/boin060.p persistent set h_boin060.
                
                   run updateConsistNota in h_boin060 (RowObject.cod-emitente,
                                                       RowObject.serie-docto,
                                                       RowObject.nro-docto,
                                                       RowObject.nat-operacao,
                                                       0,
                                                       no, 
                                                       0,
                                                       0,
                                                       56824,
                                                       2).
                    if valid-handle (h_boin060) then do:
                        delete procedure h_boin060.
                        assign h_boin060 = ?.                  
                    END. /*if valid-handle*/   
                END. /*IF NOT CAN-FIND*/             
            END. /*IF  avail natur-oper*/    

            find first b-docum-est
               where rowid(b-docum-est) = r-docum-est exclusive-lock no-error.
            if  avail b-docum-est then 
                assign b-docum-est.usuario    = c-seg-usuario
                       b-docum-est.esp-fiscal = if  avail natur-oper
                                                then natur-oper.especie-doc
                                                else b-docum-est.esp-fiscal.

            release b-docum-est.
            
            run repositionRecord (input r-docum-est).
            
            &if "{&bf_mat_versao_ems}":U >= "2.05":U &then
                if  can-find (funcao
                               where funcao.cd-funcao = "spp-seriais-nf":U
                               and   funcao.ativo) then do:
                    if  not valid-handle (h-boin735) then 
                        run inbo/boin735.p persistent set h-boin735.
        
                    run copiaSerialRecFisicoParaRecFiscal in h-boin735 (input r-docum-est).
        
                    run getRowErrors in h-boin735 (output table rowErrors append).
        
                    if  valid-handle (h-boin735) then do:
                        delete procedure h-boin735.
                        assign h-boin735 = ?.
                    end.
                end.
            &endif
        end.
    end.        
    else 
        return "NOK":U.
        

    /***** Verifica Movimentaá∆o - Natureza Operaá∆o X Unidade Federaá∆o *****/

    run validateTypeMovto ( l-transf ). 

    /***** Verificar Modelo e serie eletronica *****/
         
    run validateDadosNFe.

    find first RowErrors 
         where RowErrors.ErrorSubType = "ERROR":U no-lock no-error.

    if  not avail RowErrors then 
        return "OK":U.
    else    
        return "NOK":U.
        
    FINALLY:
        DELETE PROCEDURE h-reapi429 NO-ERROR.
        ASSIGN h-reapi429 = ?.
        
        DELETE PROCEDURE h-reapi435 NO-ERROR.
        ASSIGN h-reapi435 = ?.
        
        IF VALID-HANDLE(h-re1911) THEN DO:
           DELETE PROCEDURE h-re1911 NO-ERROR.
           ASSIGN h-re1911 = ?.
        END.
    END FINALLY.    
    
END PROCEDURE.



PROCEDURE notaFiscAdic :

    DEFINE VARIABLE c-chave   AS CHARACTER  NO-UNDO.
    DEFINE VARIABLE c-modelo  AS CHARACTER  NO-UNDO.
    def    var      h-bodi516       as handle   no-undo. 
    def    buffer   b-natur-oper    for natur-oper.
    DEF    VAR      h-boin01017     AS HANDLE   NO-UNDO.
    DEF    VAR      l-ret-goToKey   AS LOGICAL  NO-UNDO.
    DEF    VAR      h-re1911        AS HANDLE   NO-UNDO.
    DEF    VAR      c-cod-estab-aux LIKE docum-est.cod-estabel NO-UNDO.
    
    DEFINE BUFFER bf-natur-oper-item FOR natur-oper. /* buffer aux. para buscar a natureza do item */
    
    IF NOT AVAIL natur-oper OR 
       natur-oper.nat-operacao <> RowObject.nat-operacao THEN
       find first natur-oper no-lock 
            where natur-oper.nat-operacao = RowObject.nat-operacao no-error.
            
    {cdp/cd9700.i1 natur-oper}
    
    if avail natur-oper and it-doc-fisico.nro-comp <> "" then do:
        if natur-oper.tipo-compra = 3 then /*Devoluá∆o de Cliente*/
            RUN rep/re1910.p (INPUT  doc-fisico.cod-estabel,
                              INPUT  it-doc-fisico.serie-docto,
                              INPUT  it-doc-fisico.nro-docto,
                              INPUT  it-doc-fisico.cod-emitente,
                              INPUT  natur-oper.nat-operacao,
                              INPUT  it-doc-fisico.it-codigo,
                              INPUT  it-doc-fisico.serie-comp,      
                              INPUT  it-doc-fisico.nro-comp,
                              INPUT  it-doc-fisico.nat-comp,
                              INPUT  1, /*devoluá∆o de cliente*/
                              OUTPUT TABLE rowErrors).
        else if (not natur-oper.log-oper-triang and natur-oper.tp-oper-terc = 2) then do:
            if l-remessa-ent-futura then /* Remessa de Entrega Futura */
                RUN rep/re1910.p (INPUT  doc-fisico.cod-estabel,    
                		  INPUT  it-doc-fisico.serie-docto, 
                		  INPUT  it-doc-fisico.nro-docto,   
                		  INPUT  it-doc-fisico.cod-emitente,
                		  INPUT  natur-oper.nat-operacao,   
                		  INPUT  it-doc-fisico.it-codigo,
                		  INPUT  it-doc-fisico.serie-comp,     
                		  INPUT  it-doc-fisico.nro-comp, 
                                  INPUT  it-doc-fisico.nat-comp, 
                		  INPUT  6, /*Remessa de Entrega Futura*/
                		  OUTPUT TABLE rowErrors).
            ELSE /*Retorno de Beneficiamento */
                RUN rep/re1910.p (INPUT  doc-fisico.cod-estabel,
                                  INPUT  it-doc-fisico.serie-docto,
                                  INPUT  it-doc-fisico.nro-docto,
                                  INPUT  it-doc-fisico.cod-emitente,
                                  INPUT  natur-oper.nat-operacao,
                                  INPUT  it-doc-fisico.it-codigo,
                                  INPUT  it-doc-fisico.serie-comp,      
                                  INPUT  it-doc-fisico.nro-comp,
                                  INPUT  it-doc-fisico.nat-comp,
                                  INPUT  2, /*retorno de beneficiamento*/
                                  OUTPUT TABLE rowErrors).
        end.                      
        else if natur-oper.tp-oper-terc = 4 then /*Faturamento de Consignaá∆o*/
            RUN rep/re1910.p (INPUT  doc-fisico.cod-estabel,
                              INPUT  it-doc-fisico.serie-docto,
                              INPUT  it-doc-fisico.nro-docto,
                              INPUT  it-doc-fisico.cod-emitente,
                              INPUT  natur-oper.nat-operacao,
                              INPUT  it-doc-fisico.it-codigo,
                              INPUT  it-doc-fisico.serie-comp,      
                              INPUT  it-doc-fisico.nro-comp,
                              INPUT  it-doc-fisico.nat-comp,
                              INPUT  4, /*faturamento de consignaá∆o*/
                              OUTPUT TABLE rowErrors).
        else if natur-oper.tp-oper-terc = 5 then /*Devoluá∆o de Consignaá∆o*/
            RUN rep/re1910.p (INPUT  doc-fisico.cod-estabel,
                              INPUT  it-doc-fisico.serie-docto,
                              INPUT  it-doc-fisico.nro-docto,
                              INPUT  it-doc-fisico.cod-emitente,
                              INPUT  natur-oper.nat-operacao,
                              INPUT  it-doc-fisico.it-codigo,
                              INPUT  it-doc-fisico.serie-comp,      
                              INPUT  it-doc-fisico.nro-comp,
                              INPUT  it-doc-fisico.nat-comp,
                              INPUT  3, /*devoluá∆o de consignaá∆o*/
                              OUTPUT TABLE rowErrors).
        else if l-remessa-fat-antecip then /*Remessa Faturamento Antecipado*/
            RUN rep/re1910.p (INPUT  doc-fisico.cod-estabel,    
                    	      INPUT  it-doc-fisico.serie-docto, 
                    	      INPUT  it-doc-fisico.nro-docto,   
                    	      INPUT  it-doc-fisico.cod-emitente,
                    	      INPUT  natur-oper.nat-operacao,   
                    	      INPUT  it-doc-fisico.it-codigo,   
                    	      INPUT  it-doc-fisico.serie-comp,        
                    	      INPUT  it-doc-fisico.nro-comp,    
                              INPUT  it-doc-fisico.nat-comp,    
                    	      INPUT  7, /*Faturamento Antecipado*/
                    	      OUTPUT TABLE rowErrors).
        else if (natur-oper.tp-oper-terc = 9 or natur-oper.tp-oper-terc = 11)  then /*Retorno Deposito Fechado ou Retorno Armazem Geral*/
            RUN rep/re1910.p (INPUT  doc-fisico.cod-estabel,
                              INPUT  it-doc-fisico.serie-docto,
                              INPUT  it-doc-fisico.nro-docto,
                              INPUT  it-doc-fisico.cod-emitente,
                              INPUT  natur-oper.nat-operacao,
                              INPUT  it-doc-fisico.it-codigo,
                              INPUT  it-doc-fisico.serie-comp,      
                              INPUT  it-doc-fisico.nro-comp,
                              INPUT  it-doc-fisico.nat-comp,
                              INPUT  2, 
                              OUTPUT TABLE rowErrors).
                              

    end. /*if avail natur-oper*/

    IF AVAIL natur-oper AND natur-oper.transf then
        ASSIGN c-cod-estab-aux = doc-fisico.estab-de-or.
    ELSE
        ASSIGN c-cod-estab-aux = doc-fisico.cod-estabel.
   
    /* NT2015/003 - Copia das informaá‰es do ICMS de Partilha - DIFAL */
    find FIRST it-nota-fisc no-lock
        WHERE it-nota-fisc.nr-nota-fis = it-doc-fisico.nro-comp
          and it-nota-fisc.serie       = it-doc-fisico.serie-comp
          and it-nota-fisc.cod-estabel = c-cod-estab-aux
          and it-nota-fisc.it-codigo   = it-doc-fisico.it-codigo
          and it-nota-fisc.nr-seq-fat  = it-doc-fisico.seq-comp no-error. 

    if  avail it-nota-fisc then do:
        find first nota-fiscal no-lock 
             where nota-fiscal.cod-estabel = it-nota-fisc.cod-estabel
               and nota-fiscal.serie       = it-nota-fisc.serie      
               and nota-fiscal.nr-nota-fis = it-nota-fisc.nr-nota-fis no-error.
               
        find first b-natur-oper no-lock where b-natur-oper.nat-operacao = it-nota-fisc.nat-operacao no-error.
        
        IF l-mult-natur-receb THEN /* Var def em cd9701.i */
           FIND FIRST tt-nat-of-itens WHERE tt-nat-of-itens.sequencia = it-doc-fisico.sequencia NO-LOCK NO-ERROR.
                                       
        FOR EACH item-nf-adc NO-LOCK 
           WHERE item-nf-adc.cod-estab        = it-nota-fisc.cod-estabel 
             AND item-nf-adc.cod-serie        = it-nota-fisc.serie       
             AND item-nf-adc.cod-nota-fisc    = it-nota-fisc.nr-nota-fis 
             AND item-nf-adc.cdn-emitente     = nota-fiscal.cod-emitente 
             AND item-nf-adc.cod-natur-operac = it-nota-fisc.nat-operacao
             AND item-nf-adc.num-seq          = it-nota-fisc.nr-seq-fat
             AND item-nf-adc.num-seq-item-nf  = it-nota-fisc.nr-seq-fat
             AND item-nf-adc.cod-item         = it-nota-fisc.it-codigo :
           
           IF item-nf-adc.idi-tip-dado <> 24 AND item-nf-adc.idi-tip-dado <> 25 AND item-nf-adc.idi-tip-dado <> 39 THEN NEXT.
           
           IF l-mult-natur-receb THEN /* Var def em cd9701.i */
               FIND FIRST bf-natur-oper-item WHERE bf-natur-oper-item.nat-operacao = tt-nat-of-itens.nat-of NO-LOCK NO-ERROR.
           ELSE 
               FIND FIRST bf-natur-oper-item WHERE bf-natur-oper-item.nat-operacao = RowObject.nat-operacao NO-LOCK NO-ERROR.
           
           /*Se for NF Transf copia FCP se a natureza estiver parametrizada como Substitu≠do,*/
           /*pois substituto deve estar parametrizado para calcular*/
           IF AVAIL bf-natur-oper-item AND bf-natur-oper-item.transf AND bf-natur-oper-item.log-icms-substto-antecip THEN NEXT.
           IF AVAIL bf-natur-oper-item AND bf-natur-oper-item.transf AND item-nf-adc.idi-tip-dado <> 25 THEN NEXT.
            
           EMPTY TEMP-TABLE tt-item-nf-adc.
           CREATE tt-item-nf-adc.
           ASSIGN tt-item-nf-adc.cod-estab        = doc-fisico.cod-estabel
                  tt-item-nf-adc.cod-serie        = it-doc-fisico.serie-docto
                  tt-item-nf-adc.cod-nota-fisc    = it-doc-fisico.nro-docto
                  tt-item-nf-adc.cdn-emitente     = it-doc-fisico.cod-emitente
                  tt-item-nf-adc.cod-natur-operac = (if l-mult-natur-receb and tt-nat-of-itens.nat-of <> "" then tt-nat-of-itens.nat-of else RowObject.nat-operacao)
                  tt-item-nf-adc.num-seq          = it-doc-fisico.sequencia
                  tt-item-nf-adc.num-seq-item-nf  = it-doc-fisico.sequencia
                  tt-item-nf-adc.cod-item         = it-doc-fisico.it-codigo.
           
           CASE item-nf-adc.idi-tip-dado:
               /* NT2015/003 - Copia das informaá‰es do ICMS de Partilha - DIFAL */
               WHEN 24 THEN DO:
                   ASSIGN tt-item-nf-adc.idi-tip-dado = 24
                          tt-item-nf-adc.cod-livre-1  = item-nf-adc.cod-livre-1   /*Aliq UF Dest*/
                          tt-item-nf-adc.cod-livre-2  = item-nf-adc.cod-livre-2   /*Aliq Inter*/
                          tt-item-nf-adc.val-livre-2  = item-nf-adc.val-livre-2   /*% ICMS FCP*/
                          tt-item-nf-adc.num-livre-1  = item-nf-adc.num-livre-1   /*ICMSInterPart*/
                          tt-item-nf-adc.val-livre-1  = ROUND((item-nf-adc.val-livre-1 / it-nota-fisc.qt-faturada[1] * it-doc-fisico.quantidade), 2)  /*Vl BC UF Dest*/
                          tt-item-nf-adc.cod-livre-4  = STRING(ROUND((DEC(item-nf-adc.cod-livre-4) / it-nota-fisc.qt-faturada[1] * it-doc-fisico.quantidade), 2)) /*Vl ICMS FCP*/
                          tt-item-nf-adc.val-livre-3  = ROUND((item-nf-adc.val-livre-4 / it-nota-fisc.qt-faturada[1] * it-doc-fisico.quantidade), 2)  /* VL ICMS UF Dest inverte Devol */
                          tt-item-nf-adc.val-livre-4  = ROUND((item-nf-adc.val-livre-3 / it-nota-fisc.qt-faturada[1] * it-doc-fisico.quantidade), 2). /* VL ICMS UF Orig inverte Devol */
      
                   ASSIGN OVERLAY(tt-item-nf-adc.cod-livre-3,1,2)   = SUBSTRING(item-nf-adc.cod-livre-3,3,2)    /* Devolucao UF Destino passa p/ Origem   */ 
                          OVERLAY(tt-item-nf-adc.cod-livre-3,3,2)   = SUBSTRING(item-nf-adc.cod-livre-3,1,2)    /* Devolucao UF Origem passa p/ Destino   */
                          OVERLAY(tt-item-nf-adc.cod-livre-3,5,100) = SUBSTRING(item-nf-adc.cod-livre-3,5,100)  /* Grava os demais parametros desse campo */
                          OVERLAY(tt-item-nf-adc.cod-livre-3,41,20) = STRING(ROUND((DEC(TRIM(SUBSTRING(item-nf-adc.cod-livre-3,41,20)))/ it-nota-fisc.qt-faturada[1] * it-doc-fisico.quantidade),2)). /* Vl BC FCP UF Dest*/
               END.
               /* Copia das informaá‰es de FCP */
               WHEN 25 THEN DO:
                   ASSIGN tt-item-nf-adc.idi-tip-dado = 25
                          tt-item-nf-adc.log-livre-1  = item-nf-adc.log-livre-1  /*YES = FCP majorou ST, NO = FCP majorou ICMS*/
                          tt-item-nf-adc.log-livre-2  = item-nf-adc.log-livre-2  /*Quando o FCP e FCP ST for junto no mesmo item da nota ser† = ?*/
                          
                          tt-item-nf-adc.val-livre-1  = ROUND((item-nf-adc.val-livre-1 / it-nota-fisc.qt-faturada[1] * it-doc-fisico.quantidade), 2) /*Base FCP ST*/
                          tt-item-nf-adc.val-livre-2  = item-nf-adc.val-livre-2  /*Aliquota FCP ST*/
                          tt-item-nf-adc.cod-livre-4  = STRING(ROUND((DEC(item-nf-adc.cod-livre-4) / it-nota-fisc.qt-faturada[1] * it-doc-fisico.quantidade), 2)) /*Valor FCP ST*/
                          tt-item-nf-adc.num-livre-1  = item-nf-adc.num-livre-1  /*Cod. mensagem FCP ST observ. nota*/
                          
                          tt-item-nf-adc.val-livre-3 = ROUND((item-nf-adc.val-livre-3 / it-nota-fisc.qt-faturada[1] * it-doc-fisico.quantidade), 2) /*Base FCP*/
                          tt-item-nf-adc.val-livre-4 = item-nf-adc.val-livre-4   /*Aliquota FCP*/
                          tt-item-nf-adc.cod-livre-3 = STRING(ROUND((DEC(item-nf-adc.cod-livre-3) / it-nota-fisc.qt-faturada[1] * it-doc-fisico.quantidade), 2)) /*Valor FCP*/
                          tt-item-nf-adc.num-livre-2 = item-nf-adc.num-livre-2.  /*Cod. mensagem FCP    */   
                          
                   IF DEC(SUBSTRING(item-nf-adc.cod-livre-2,21,8)) > 0 THEN     /*Valor FCP Diferido*/
                       ASSIGN OVERLAY(tt-item-nf-adc.cod-livre-2,1,20) = STRING(ROUND((DEC(SUBSTRING(item-nf-adc.cod-livre-2,1,20)) / it-nota-fisc.qt-faturada[1] * it-doc-fisico.quantidade), 2)).   /*Valor FCP Diferido*/                                                                         
                       
                   IF DEC(SUBSTRING(item-nf-adc.cod-livre-2,21,8)) > 0 THEN     /*Percentual FCP Diferido*/
                       ASSIGN OVERLAY(tt-item-nf-adc.cod-livre-2,21,8) = SUBSTRING(item-nf-adc.cod-livre-2,21,8).   /*Percentual FCP Diferido*/                   
                    
                   
                   IF item-nf-adc.log-livre-1 AND  /*FCP Majorou ST*/
                      SUBSTR(b-natur-oper.char-1,168,1) = "S":U THEN /*Deduzir ICMS ST Devol. Cliente*/
                       ASSIGN tt-item-nf-adc.cod-livre-4 = STRING(0).
                   
                   IF  NOT VALID-HANDLE(h-boin01017) THEN
                      RUN inbo/boin01017.p PERSISTENT SET h-boin01017.
                   
                   RUN openQueryStatic IN h-boin01017 (INPUT "Main":U) NO-ERROR.

                   RUN goToKey IN h-boin01017 (INPUT it-doc-fisico.serie-docto, 
                                               INPUT it-doc-fisico.nro-docto,   
                                               INPUT it-doc-fisico.cod-emitente,
                                               INPUT RowObject.nat-operacao,
                                               INPUT it-doc-fisico.sequencia,   
                                               INPUT "fcp":U).
                   
                   IF  RETURN-VALUE = "OK":U THEN DO:
		              ASSIGN l-ret-goToKey = YES.
                      RUN emptyRowErrors IN h-boin01017.
                      RUN getRecord IN h-boin01017 (OUTPUT TABLE tt-ext-item-doc-est).
                      FIND FIRST tt-ext-item-doc-est EXCLUSIVE-LOCK NO-ERROR.
                   END.
                   ELSE DO:
                      ASSIGN l-ret-goToKey = NO.
                      EMPTY TEMP-TABLE tt-ext-item-doc-est.
                      CREATE tt-ext-item-doc-est.
                      ASSIGN tt-ext-item-doc-est.serie-docto  = it-doc-fisico.serie-docto
                             tt-ext-item-doc-est.nro-docto    = it-doc-fisico.nro-docto
                             tt-ext-item-doc-est.cod-emitente = it-doc-fisico.cod-emitente
                             tt-ext-item-doc-est.nat-operacao = RowObject.nat-operacao
                             tt-ext-item-doc-est.sequencia    = it-doc-fisico.sequencia
                             tt-ext-item-doc-est.cod-param    = "fcp":U.                   
                   END.
                   
                   ASSIGN tt-ext-item-doc-est.val-livre-1  = tt-item-nf-adc.val-livre-3        /*Base FCP*/
                          tt-ext-item-doc-est.val-livre-2  = tt-item-nf-adc.val-livre-4        /*Aliq FCP*/
                          tt-ext-item-doc-est.val-livre-3  = DEC(tt-item-nf-adc.cod-livre-3).  /*Valor FCP*/
                          
                   IF AVAIL bf-natur-oper-item AND substr(bf-natur-oper-item.char-1,168,1) <> "S":U THEN DO:
                       ASSIGN tt-ext-item-doc-est.val-livre-4  = tt-item-nf-adc.val-livre-1        /*Base FCP ST*/ 
                              tt-ext-item-doc-est.val-livre-5  = tt-item-nf-adc.val-livre-2        /*Aliq FCP ST*/ 
                              tt-ext-item-doc-est.val-livre-6  = DEC(tt-item-nf-adc.cod-livre-4).  /*Valor FCP ST*/
                   END.
                  
                   /*1-FCP Normal, 2-FCP Subst. Trib., 3-FCP Subst. Trib. Antecip*/
                   ASSIGN tt-ext-item-doc-est.num-livre-2 = 1.
                  
                   IF AVAIL bf-natur-oper-item AND bf-natur-oper-item.subs-trib THEN
                       ASSIGN tt-ext-item-doc-est.num-livre-2 = 2.
                   ELSE IF AVAIL bf-natur-oper-item AND 
                          (bf-natur-oper-item.log-contrib-st-antec or bf-natur-oper-item.log-icms-substto-antecip) AND 
                           NOT bf-natur-oper-item.terceiros THEN  
                       ASSIGN tt-ext-item-doc-est.num-livre-2 = 3.
                       
                   IF DEC(SUBSTRING(item-nf-adc.cod-livre-2,1,20)) > 0 THEN     /*Valor FCP Diferido*/
                       ASSIGN OVERLAY(tt-ext-item-doc-est.cod-livre-1,1,20) = SUBSTRING(item-nf-adc.cod-livre-2,1,20).
                       
                   IF DEC(SUBSTRING(item-nf-adc.cod-livre-2,21,8)) > 0 THEN     /*Percentual FCP Diferido*/
                       ASSIGN OVERLAY(tt-ext-item-doc-est.cod-livre-1,21,8) = SUBSTRING(item-nf-adc.cod-livre-2,21,8).
                      
                   IF l-ret-goToKey THEN DO:
                       RUN emptyRowErrors IN h-boin01017.
                       RUN setRecord IN h-boin01017 (INPUT TABLE tt-ext-item-doc-est).
                       RUN updateRecord IN h-boin01017.  
                   END.    
                   ELSE DO:
                       RUN emptyRowErrors IN h-boin01017.
                       RUN setRecord IN h-boin01017 (INPUT TABLE tt-ext-item-doc-est).
                       RUN createRecord IN h-boin01017.
                   END.
                  
                   IF VALID-HANDLE(h-boin01017) THEN DO:
                      DELETE PROCEDURE h-boin01017.
                      ASSIGN h-boin01017 = ?.
                   END.
               END.
               WHEN 39 THEN DO:
                   ASSIGN tt-item-nf-adc.idi-tip-dado = 39
                          tt-item-nf-adc.cod-livre-1  = item-nf-adc.cod-livre-1   /*fundo*/
                          tt-item-nf-adc.val-livre-1  = ROUND((item-nf-adc.val-livre-1 / it-nota-fisc.qt-faturada[1] * it-doc-fisico.quantidade), 2)    /*base fundo*/
                          tt-item-nf-adc.val-livre-2  = item-nf-adc.val-livre-2                                                                    /*% fundo*/
                          tt-item-nf-adc.val-livre-3  = ROUND((item-nf-adc.val-livre-3 / it-nota-fisc.qt-faturada[1] * it-doc-fisico.quantidade), 2).  /*Valor fundo*/
               END.
           END CASE.
           
           IF NOT VALID-HANDLE(h-bodi516) THEN
              RUN dibo/bodi516.p PERSISTENT SET h-bodi516.
           RUN openQueryStatic IN h-bodi516 (INPUT "Main":U).
           RUN goToKey IN h-bodi516 (INPUT doc-fisico.cod-estabel,
                                     INPUT it-doc-fisico.serie-docto,
                                     INPUT it-doc-fisico.nro-docto,
                                     INPUT it-doc-fisico.cod-emitente,
                                     INPUT (IF l-mult-natur-receb and tt-nat-of-itens.nat-of <> "" THEN tt-nat-of-itens.nat-of ELSE RowObject.nat-operacao),
                                     INPUT tt-item-nf-adc.idi-tip-dado,
                                     INPUT it-doc-fisico.sequencia,
                                     INPUT it-doc-fisico.sequencia,
                                     INPUT it-doc-fisico.it-codigo).
           IF RETURN-VALUE = "NOK":U THEN DO:
              RUN setRecord IN h-bodi516 (INPUT TABLE tt-item-nf-adc).
              RUN emptyRowErrors IN h-bodi516.
              RUN createRecord IN h-bodi516.
           END.   
           ELSE DO:
              RUN setRecord IN h-bodi516 (INPUT TABLE tt-item-nf-adc).
              RUN emptyRowErrors IN h-bodi516.
              RUN updateRecord IN h-bodi516.  
           END.
           IF VALID-HANDLE(h-bodi516) THEN
               DELETE PROCEDURE h-bodi516.
           ASSIGN h-bodi516 = ?.
        END.    
                  
    end.
               
END PROCEDURE.


PROCEDURE validateFieldsKey :
    /* Validaá∆o de campos pertencentes a chave. Criada procedure separada para ser poss°vel chamar de outros locais. */
    
    DEFINE OUTPUT PARAMETER r-rowid-doc-fisico AS ROWID   NO-UNDO.
    DEFINE VARIABLE         lDevSimbConsig     AS LOGICAL NO-UNDO.

    RUN emptyRowErrors.
    
    IF  NOT CAN-FIND (serie WHERE serie.serie = RowObject.serie-docto) THEN DO:
        /* Inicio -- Projeto Internacional */
        {utp/ut-table.i mgind serie 1} /* Busca o label da tabela */
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U
                            &ErrorParameters=TRIM(RETURN-VALUE)}
    END.
        
    RUN findNaturOper (RowObject.nat-operacao).
    IF  RETURN-VALUE = "OK":U THEN DO:
        IF  natur-oper.imp-nota = YES THEN DO:
        
            if can-find(FIRST doc-orig-nfe 
                 where doc-orig-nfe.cod-emitente  = RowObject.cod-emitente
                   and doc-orig-nfe.cod-estabel   = RowObject.cod-estabel   
                   AND doc-orig-nfe.serie-docto   = RowObject.serie-docto 
                   and doc-orig-nfe.nro-docto     = RowObject.nro-docto
                   and doc-orig-nfe.idi-orig-trad = 2) then do:

                {method/svc/errors/inserr.i
                               &ErrorNumber="54991"
                               &ErrorType="EMS":U
                               &ErrorSubType="ERROR":U } 
                RETURN "NOK":U.
            end.
            
            if RowObject.tipo-nota = 3 then do:
                {method/svc/errors/inserr.i
                               &ErrorNumber="54990"
                               &ErrorType="EMS":U
                               &ErrorSubType="ERROR":U } 
                RETURN "NOK":U.            
            end.

        END.

        IF  natur-oper.nat-ativa = NO THEN DO:
            {method/svc/errors/inserr.i
                            &ErrorNumber="26759"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U }
            RETURN "NOK":U.
        END.

        ASSIGN lDevSimbConsig = {cdp/cd0066.i RowObject.cod-estabel natur-oper}
        IF  lDevSimbConsig THEN DO:
            {method/svc/errors/inserr.i
                                &ErrorNumber="35608"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U }
        END.

    END.
    
    IF  {cdp/cd0066.i2 RowObject.cod-estabel} AND RowObject.tipo-nota = 7 THEN DO:
        {method/svc/errors/inserr.i
                        &ErrorNumber="35097"
                        &ErrorType="EMS":U
                        &ErrorSubType="ERROR":U }
    END.
    
    FIND FIRST doc-fisico 
        WHERE doc-fisico.serie-docto  = RowObject.serie-docto  
          AND doc-fisico.nro-docto    = RowObject.nro-docto    
          AND doc-fisico.cod-emitente = RowObject.cod-emitente 
          AND doc-fisico.tipo-nota    = RowObject.tipo-nota    
          AND doc-fisico.situacao     = 2 NO-LOCK NO-ERROR.
    IF  NOT AVAIL doc-fisico THEN DO:
        {method/svc/errors/inserr.i
                            &ErrorNumber="17419" /* N∆o existem documentos */
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U }
        RETURN "NOK":U.
    END.
    ELSE DO:
        ASSIGN r-rowid-doc-fisico = ROWID(doc-fisico).
    END.
    
    RETURN "OK":U.

END PROCEDURE.


PROCEDURE validaFinalidadeNfe:
    
    def var c-lbl-liter-valid-finalidade-1  as char no-undo.
    def var c-lbl-liter-valid-finalidade-2  as char no-undo.
    
    if RowObject.cod-finalidade = '6' and
       RowObject.tipo-nota      = 2   then do:

        {utp/ut-liter.i "Finalidade_da_NF-e:_6_-_Nota_de_DÇbito_n∆o_Ç" *}
        assign c-lbl-liter-valid-finalidade-1 = trim(return-value).
        
        {utp/ut-liter.i "_para_Tipo_Nota:_Devoluá∆o" *}
        assign c-lbl-liter-valid-finalidade-2 = trim(return-value).
        
        {method/svc/errors/inserr.i
                       &ErrorNumber="58151"
                       &ErrorType="EMS":U
                       &ErrorSubType="ERROR":U
                       &ErrorParameters="c-lbl-liter-valid-finalidade-1 + '~~~~' + c-lbl-liter-valid-finalidade-2" }
        return "NOK":U.            
    end.   
    
    if RowObject.cod-finalidade = '5' and
       not l-spp-NT2024002 then do:
       
        {utp/ut-liter.i A_finalidade_informada * r }
        assign c-lbl-liter-valid-finalidade-1 = trim(return-value).

        {utp/ut-liter.i (NT2024002) * r }
        assign c-lbl-liter-valid-finalidade-2 = trim(return-value).

        {method/svc/errors/inserr.i
                            &ErrorNumber="58226"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U
                            &ErrorParameters="c-lbl-liter-valid-finalidade-1 + '~~~~' + c-lbl-liter-valid-finalidade-2"}
        return "NOK":U.                   
    end.   

END PROCEDURE.




