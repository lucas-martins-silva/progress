PROCEDURE assignValueImposto :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:  Executa a procedure calculate_IPI_ISS para calculo desses impostos e
          transfere os dados da temp-table de impostos para o RowObject.
          * not l-validade - significa que nío foi executado apartir do
                             validateRecord.
          

------------------------------------------------------------------------------*/
    def buffer bf-natur-oper-item  for natur-oper.
    DEF VAR d-cod-conteudo AS DECIMAL INIT 0 NO-UNDO.
    
    DEFINE VARIABLE l-utilizaImpostoMonitor AS LOGICAL  NO-UNDO.

    assign l-imp = no.
    
    if avail docum-est and
       docum-est.origem = "I":U and 
       param-global.modulo-07 and
       emitente.pais <> estabelec.pais and
       (emitente.natureza = 3 or emitente.natureza = 4) then do:
        /* Nacionalizaá∆o por Embarque */
        IF VALID-HANDLE (h-bocx378) THEN DO:
           RUN goToKey2 IN h-bocx378 (INPUT docum-est.serie-docto,
                                      INPUT docum-est.nro-docto,
                                      INPUT docum-est.cod-emitente,
                                      INPUT docum-est.nat-operacao).
           IF  RETURN-VALUE = "OK":U THEN
               ASSIGN l-imp = yes.
        END.
        /* Nacionalizaá∆o por DI */
        IF NOT l-imp THEN DO:
           IF NOT VALID-HANDLE (h-bocx407) THEN 
              RUN cxbo/bocx407.p persistent set h-bocx407.              
           RUN pi-valida-integracao-di IN h-bocx407 (INPUT docum-est.embarque,
                                                     INPUT docum-est.cod-estabel,
                                                     OUTPUT p-retorno).
           ASSIGN l-imp = p-retorno.        
           IF VALID-HANDLE(h-bocx407)THEN DO:
              delete procedure h-bocx407.
              assign h-bocx407 = ?.
           end.           
        END.
         
    end.

    run calculate_IPI_ISS.

    if  not l-recalcula    /* Somente para recalculo do imposto */
    and avail tb-wt-it-imposto then do:
        assign RowObject.base-ipi[1]    = tb-wt-it-imposto.vl-bipi-it     
               RowObject.ipi-ntrib[1]   = tb-wt-it-imposto.vl-ipint-it        
               RowObject.ipi-outras[1]  = tb-wt-it-imposto.vl-ipiou-it
               RowObject.ipi-outras[2]  = tb-wt-it-imposto.vl-ipi-outras
               RowObject.valor-ipi[1]   = tb-wt-it-imposto.vl-ipi-it
               RowObject.base-iss[1]    = tb-wt-it-imposto.vl-biss-it
               RowObject.valor-iss[1]   = tb-wt-it-imposto.vl-iss-it
               RowObject.iss-ntrib[1]   = tb-wt-it-imposto.vl-issnt-it
               RowObject.iss-outras[1]  = tb-wt-it-imposto.vl-issou-it.
    end.
        

    run calculate_ICMS_SubsTrib_ICMSComp.
    
    RUN findEmitente ( RowObject.cod-emitente ).
    
    IF not l-recalcula AND  /*Para inclus∆o e recalculo do imposto*/
       AVAIL emitente AND 
       SUBSTRING(emitente.char-1,133,1) = "S":U AND /*Optante do Simples Nacional*/
       docum-est.cod-observa <>  3 THEN DO: /*diferente de devoluá∆o de cliente*/
    
        RUN sugere_simples_nacional.
    END.    
    
    /*Envio dos dados do Simples Nacional para o configurador de tributos para geraá∆o de codigo de ajuste*/
    for first tb-wt-it-imposto exclusive-lock
        where tb-wt-it-imposto.seq-wt-docto    = 1
          and tb-wt-it-imposto.seq-wt-it-docto = RowObject.sequencia:
        for first ext-item-doc-est no-lock
            where ext-item-doc-est.serie-docto  = RowObject.serie-docto
              and ext-item-doc-est.nro-docto    = RowObject.nro-docto
              and ext-item-doc-est.cod-emitente = RowObject.cod-emitente
              and ext-item-doc-est.nat-operacao = RowObject.nat-operacao
              and ext-item-doc-est.sequencia    = RowObject.sequencia
              and ext-item-doc-est.cod-param    = "simplesnacional":
              
           assign overlay(tb-wt-it-imposto.char-1,150,20) = string(ext-item-doc-est.val-livre-2)  /*base simples nac*/
                  overlay(tb-wt-it-imposto.char-1,170,20) = string(ext-item-doc-est.val-livre-3)  /*valor simples nac*/
                  overlay(tb-wt-it-imposto.char-1,356,5)  = string(ext-item-doc-est.val-livre-1). /*aliq simples nac*/
        end.         
    end.

    run calculatePisCofins. 
    
    IF  NOT l-imp AND
        CAN-FIND (FIRST natur-oper NO-LOCK
                  WHERE natur-oper.nat-operacao = RowObject.nat-of 
                    AND (natur-oper.log-contrib-st-antec OR        /*Contrib Substituido Antecip*/
                         natur-oper.log-icms-substto-antecip)) THEN DO: /*ICMS Subs Trib Antecip*/
                         
        DEF VAR c-cod-estab-aux LIKE docum-est.cod-estabel NO-UNDO.                  
        ASSIGN c-cod-estab-aux = IF l-transf THEN docum-est.estab-de-or ELSE docum-est.cod-estabel.
                         
        {inbo/boin176.m96 "RowObject" docum-est.cod-estabel c-cod-estab-aux}
    END.
    
    
    ASSIGN l-utilizaImpostoMonitor = NO.
    
    RUN utilizaImpostosMonitorRecFiscal (INPUT RowObject.serie-docto,
                                         INPUT RowObject.nro-docto,
                                         INPUT RowObject.cod-emitente,
                                         INPUT RowObject.nat-operacao,
                                         INPUT INT(SUBSTRING(RowObject.char-2,832,5)),
                                         OUTPUT l-utilizaImpostoMonitor).
    if  not l-recalcula
    and l-utilizaImpostoMonitor then do:
        {inbo/boin176.m93 "RowObject"} /* seta valores impostos do monitor na tb-wt-it-imposto */
    end.

    if not l-imp then do:
        {inbo/boin176.m99} /* chamada configurador de tributos */
    end.
    
    if  not l-recalcula
    and not l-imp then do:
    
    {inbo/boin176.m97 "RowObject"} /* retorno configurador de tributos */
    
    end.
    
    IF  l-recalcula AND NOT l-imp AND
        (RowObject.base-subs[1] > 0 OR RowObject.vl-subs[1] > 0) AND
        CAN-FIND (FIRST natur-oper NO-LOCK
                  WHERE natur-oper.nat-operacao = RowObject.nat-of 
                    AND natur-oper.log-contrib-st-antec) AND
        CAN-FIND (FIRST ct-trib-item-doc-est no-LOCK
                  WHERE ct-trib-item-doc-est.cdn-emitente      = RowObject.cod-emitente
                    AND ct-trib-item-doc-est.cod-ser-docto     = RowObject.serie-docto
                    AND ct-trib-item-doc-est.cod-docto         = RowObject.nro-docto
                    AND ct-trib-item-doc-est.cod-natur-operac  = RowObject.nat-operacao
                    AND ct-trib-item-doc-est.num-seq           = RowObject.sequencia
                    AND ct-trib-item-doc-est.cod-tip-trib      = "COD AJUSTE":U) THEN DO:
        {inbo/boin176.m95 "RowObject"} 
    END.
           
    
    if  not l-recalcula
    and l-utilizaImpostoMonitor then do:
        {inbo/boin176.m94 "RowObject"} /* retorno impostos do monitor */
    end.
    
    return "OK":U. 
    FINALLY:
        DELETE PROCEDURE h-reapi429 NO-ERROR.
        ASSIGN h-reapi429 = ?.
    END FINALLY.    

END PROCEDURE.

