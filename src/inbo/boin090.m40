&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE piSetaDadosLeasing DBOProgram 
PROCEDURE piSetaDadosLeasing:
    DEFINE INPUT PARAMETER parrendador       AS CHARACTER NO-UNDO.
    DEFINE INPUT PARAMETER pcontrato-leasing AS CHARACTER NO-UNDO.
    
        ASSIGN c-arrendador       = parrendador       
               c-contrato-leasing = pcontrato-leasing.
    return "OK":U.
END PROCEDURE.
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE SetDadosFatoGerador DBOProgram
PROCEDURE SetDadosFatoGerador:
    DEFINE INPUT PARAMETER p-cidade-fato-gerador AS CHARACTER NO-UNDO.
    DEFINE INPUT PARAMETER p-uf-fato-gerador     AS CHARACTER NO-UNDO.
    DEFINE INPUT PARAMETER p-pais-fato-gerador   AS CHARACTER NO-UNDO.

    ASSIGN c-cidade-fato-gerador = p-cidade-fato-gerador
           c-uf-fato-gerador     = p-uf-fato-gerador
           c-pais-fato-gerador   = p-pais-fato-gerador.
    return "OK":U.
END PROCEDURE.
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE CreatettExtDocumEst DBOProgram 
PROCEDURE CreatettExtDocumEst:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  recebe cod-param: contrato-leasing, fatogeradorCBS-IBS
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER p-cod-param AS CHARACTER NO-UNDO.

    IF  NOT VALID-HANDLE(h-boin01016) THEN
        RUN inbo/boin01016.p PERSISTENT SET h-boin01016.
    IF  VALID-HANDLE(h-boin01016) THEN DO:

        EMPTY TEMP-TABLE tt-ext-docum-est.
        CREATE tt-ext-docum-est.
        ASSIGN tt-ext-docum-est.serie-docto  = RowObject.serie-docto
               tt-ext-docum-est.nro-docto    = RowObject.nro-docto
               tt-ext-docum-est.cod-emitente = RowObject.cod-emitente
               tt-ext-docum-est.nat-operacao = RowObject.nat-operacao
               tt-ext-docum-est.cod-param    = p-cod-param.

        CASE p-cod-param:
            WHEN "contrato-leasing":U THEN DO:
                IF  c-arrendador       <> ""
                AND c-contrato-leasing <> "" THEN
                    ASSIGN OVERLAY(tt-ext-docum-est.cod-livre-2,1,6)  = c-arrendador
                           OVERLAY(tt-ext-docum-est.cod-livre-1,1,12) = c-contrato-leasing
                           c-arrendador                               = ""
                           c-contrato-leasing                         = "".
            END.
            WHEN "fatogeradorCBS-IBS":U THEN DO:
                ASSIGN OVERLAY(tt-ext-docum-est.cod-livre-1,1,50) = c-cidade-fato-gerador
                       OVERLAY(tt-ext-docum-est.cod-livre-2,1,4)  = c-uf-fato-gerador
                       OVERLAY(tt-ext-docum-est.cod-livre-3,1,20) = c-pais-fato-gerador
                       c-cidade-fato-gerador                      = ""
                       c-uf-fato-gerador                          = ""
                       c-pais-fato-gerador                        = "".
            END.
        END CASE.

        RUN openQueryStatic IN h-boin01016 (INPUT "Main":U) NO-ERROR.
        RUN goToKey IN h-boin01016 (INPUT RowObject.serie-docto,
                                    INPUT RowObject.nro-docto,
                                    INPUT RowObject.cod-emitente,
                                    INPUT RowObject.nat-operacao,
                                    INPUT p-cod-param).
        IF  RETURN-VALUE = "OK":U THEN DO:
            RUN emptyRowErrors IN h-boin01016.
            RUN setRecord IN h-boin01016 (INPUT TABLE tt-ext-docum-est).
            RUN updateRecord IN h-boin01016.  /* atualizar */
        END.
        ELSE DO:
            RUN emptyRowErrors IN h-boin01016.
            RUN setRecord IN h-boin01016 (INPUT TABLE tt-ext-docum-est).
            RUN createRecord IN h-boin01016.  /* ou criar o registro */
        END.
    END.
    return 'OK':U.
END PROCEDURE.
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME  
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE DeletettExtDocumEst DBOProgram 
PROCEDURE DeletettExtDocumEst:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  recebe cod-param: contrato-leasing, fatogeradorCBS-IBS
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER p-cod-param AS CHARACTER NO-UNDO.

    IF  NOT VALID-HANDLE(h-boin01016) THEN
        RUN inbo/boin01016.p PERSISTENT SET h-boin01016.

    IF  VALID-HANDLE(h-boin01016)THEN DO:
        EMPTY TEMP-TABLE tt-ext-docum-est.
        CREATE tt-ext-docum-est.
        ASSIGN tt-ext-docum-est.serie-docto  = RowObject.serie-docto
               tt-ext-docum-est.nro-docto    = RowObject.nro-docto
               tt-ext-docum-est.cod-emitente = RowObject.cod-emitente
               tt-ext-docum-est.nat-operacao = RowObject.nat-operacao
               tt-ext-docum-est.cod-param    = p-cod-param.

        RUN openQueryStatic IN h-boin01016 (INPUT "Main":U) NO-ERROR.
        RUN goToKey IN h-boin01016 (INPUT RowObject.serie-docto,
                                    INPUT RowObject.nro-docto,
                                    INPUT RowObject.cod-emitente,
                                    INPUT RowObject.nat-operacao,
                                    INPUT p-cod-param).
        IF  RETURN-VALUE = "OK":U THEN DO:
            RUN emptyRowErrors IN h-boin01016.
            RUN setRecord IN h-boin01016 (INPUT TABLE tt-ext-docum-est).
            RUN deleteRecord IN h-boin01016.  /* eliminar */
        END.
    END.
    return 'OK':U.
END PROCEDURE.
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME  
