PROCEDURE findBcoExt :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
-------------------------------------------------------------------------------*/

    /* Tabela nÆo existe mais e procedure nÆo ‚ mais utilizada
    def input param piNomLogicBco   like bco-ext.nom-logic-bco  no-undo.
    

    if  not avail bco-ext
    or  bco-ext.nom-logic-bco <> piNomLogicBco then
    

        for first bco-ext 
            fields ( ep-codigo          nom-logic-bco
                     localiz-fisic-bco  param-conex-bco )
            where bco-ext.ep-codigo     = param-global.empresa-prin 
              and bco-ext.nom-logic-bco = piNomLogicBco no-lock:
        end.
        

    if  not avail bco-ext then do:
        {method/svc/errors/inserr.i
                            &ErrorNumber="8263"
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"
                            &ErrorParameters="'Bancos Externos'"}
        RETURN "NOK":U.
    end.
    else         */
        RETURN "OK":U.     

END PROCEDURE.




PROCEDURE findClassFiscal :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input param piClassFiscal   like item-doc-est.class-fiscal no-undo.
    

    IF i-pais-impto-usuario <> 1 THEN
        RETURN "OK":U.      

    if  not avail classif-fisc
    or  classif-fisc.class-fiscal <> piClassFiscal then 
    

        for first classif-fisc
            fields ( aliquota-ipi   class-fiscal  char-1
                     descricao      dec-1)

            where classif-fisc.class-fiscal = piClassFiscal no-lock:
        end.
        

    if  not avail classif-fisc then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "'Classifica‡Æo Fiscal'" *}
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"
                            &ErrorParameters="TRIM(RETURN-VALUE)"}
        RETURN "NOK":U.
    end.
    else
        RETURN "OK":U.      

END PROCEDURE.




PROCEDURE findContaContabil :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input param piConta      like item-doc-est.ct-codigo no-undo.
    def input param piCCusto     like item-doc-est.sc-codigo no-undo.
    def input param pcCodEstabel like docum-est.cod-estabel no-undo.
    
    EMPTY temp-table tt_log_erro.

    run prgint/utb/utb742za.py persistent set h_api_ccusto.
    run prgint/utb/utb743za.py persistent set h_api_cta_ctbl.

    run pi_valida_cta_ctbl_integr in h_api_cta_ctbl (input  string(i-empresa),  /* EMPRESA EMS2 */
                                                     input  "CEP",              /* MODULO */
                                                     input  "",                 /* PLANO CONTAS */ 
                                                     input  piConta,            /* CONTA */
                                                     input  "(nenhum)",         /* FINALIDADES */
                                                     input  docum-est.dt-trans, /* DATA DE TRANSACAO */ 
                                                     output table tt_log_erro). /* ERROS */                                               

    find first tt_log_erro no-lock no-error.

    if avail tt_log_erro then do:
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U 
                            &ErrorParameters=tt_log_erro.ttv_des_msg_erro}
		
		delete object h_api_ccusto.
		delete object h_api_cta_ctbl.					
							
        RETURN "NOK":U.
    end.
    else do:
        EMPTY temp-table tt_log_erro.
        run pi_verifica_utilizacao_ccusto in h_api_ccusto (input  string(i-empresa),  /* EMPRESA EMS 2 */
                                                           input  pcCodEstabel,       /* ESTABELECIMENTO EMS2 */
                                                           input  "",                 /* PLANO CONTAS */
                                                           input  piConta,            /* CONTA */
                                                           input  docum-est.dt-trans, /* DT TRANSACAO */
                                                           output v_log_utz_ccusto,   /* UTILIZA CCUSTO ? */
                                                           output table tt_log_erro). /* ERROS */
        if v_log_utz_ccusto then do:
            EMPTY temp-table tt_log_erro.
            run pi_busca_dados_ccusto in h_api_ccusto (input  string(i-empresa),  /* EMPRESA EMS2 */
                                                       input  "",                 /* CODIGO DO PLANO CCUSTO */
                                                       input  piCCusto,           /* CCUSTO */
                                                       input  docum-est.dt-trans, /* DATA DE TRANSACAO */
                                                       output v_des_ccusto,       /* DESCRICAO DO CCUSTO */
                                                       output table tt_log_erro). /* ERROS */ 
            find first tt_log_erro no-lock no-error.
            if avail tt_log_erro then do:
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "'Centro Custo'" *}
                {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U 
                            &ErrorParameters="TRIM(RETURN-VALUE)"}
				
				delete object h_api_ccusto.
				delete object h_api_cta_ctbl.			
							
                RETURN "NOK":U.
            end.
            else do:
			
				delete object h_api_ccusto.
				delete object h_api_cta_ctbl.
            
				RETURN "OK":U.
			end.
        end.
        else do:
		
			delete object h_api_ccusto.
			delete object h_api_cta_ctbl.
            
			RETURN "OK":U.
		end.
    end.

END PROCEDURE.


PROCEDURE findContrato :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input param piNrContrato like contrato-for.nr-contrato no-undo.
    

    if  not avail contrato-for
    or  contrato-for.nr-contrato <> piNrContrato then 
        
        for first contrato-for fields ( nr-contrato dec-2 )
            where contrato-for.nr-contrato = piNrContrato no-lock: end.
        
    if  not avail contrato-for then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "'Contrato'" *}
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"
                            &ErrorParameters="TRIM(RETURN-VALUE)"}
        RETURN "NOK":U.
    end.
    else         
        RETURN "OK":U.        

END PROCEDURE.


