PROCEDURE findRowidDocumEst :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: Utilizado pela WEB      
------------------------------------------------------------------------------*/

    def input param r-docum-est as rowid no-undo.
    

    find docum-est 
        where rowid(docum-est) = r-docum-est no-lock no-error.
        

    if  not avail docum-est then
        return "NOK":U.
                

    run initializeFind.
    

END PROCEDURE.




PROCEDURE findUsuario :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input param piUsuario like docum-est.usuario no-undo.

    if  not avail param-re
    or  param-re.usuario <> piUsuario then 

        for first param-re
            fields ( usuario         sem-pedido       rec-out-for   
                     inc-seq         seq-item-um      pd-seq     
                     baixa-estoq     encerra-cc       rateia-desc
                     pd-despesas      log-1            preco-unit 
                     pede-desc-it    pede-quant       rateia-frete
                     orig-aliq-ip    ped-imp-nota     pd-cf-item
                     pd-aliq-icms    pd-aliq-ipi      pd-cd-ipi
                     pd-cd-icms       variacao         aceita-var
                     dec-1           reabre-pd        tipo-arredonda
                     cod-ent-item    pede-it-agreg    char-1
                     &if "{&bf_mat_versao_ems}" >= "2.062" &then
                        log-pedir-unid-negoc
                     &endif)
            where param-re.usuario = piUsuario no-lock:
        end.

    if  not avail param-re
    or  not avail docum-est then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "'Usu rio Recebimento'" *}
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"
                            &ErrorParameters="TRIM(RETURN-VALUE)"}
        RETURN "NOK":U.
    end.
    else         
        RETURN "OK":U.        


END PROCEDURE.




