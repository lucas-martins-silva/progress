PROCEDURE findPrazoCompra :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input param piNumeroOrdem   like item-doc-est.numero-ordem no-undo.
    def input param piParcela       like item-doc-est.parcela      no-undo.


    if  not avail prazo-compra
    or  prazo-compra.numero-ordem <> piNumeroOrdem
    or  prazo-compra.parcela      <> piParcela then 
    

        for first prazo-compra
            fields ( numero-ordem    parcela         quant-saldo
                     situacao        data-entrega    dec-1
                     quant-rejeit     qtd-sal-forn     quantidade
                     quant-receb     cod-refer       un          
                     qtd-recbda-fut )
                     

            where prazo-compra.numero-ordem = piNumeroOrdem 
              and prazo-compra.parcela      = piParcela no-lock:
        end.
        

    if  not avail prazo-compra then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "'Parcela da Ordem de Compra'" *}
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"
                            &ErrorParameters="TRIM(RETURN-VALUE)"}
        RETURN "NOK":U.
    end.
    else         
        RETURN "OK":U.        


END PROCEDURE.




