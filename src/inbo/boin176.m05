PROCEDURE findOrdemCompra :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input param piNumeroOrdem      like item-doc-est.numero-ordem no-undo.
    def input param piRowidOrdemCompra as rowid                       no-undo.
    


    if  piNumeroOrdem <> ? then do:
        if  not avail ordem-compra
        or  ordem-compra.numero-ordem <> piNumeroOrdem then 
    

            for first ordem-compra
                fields ( numero-ordem     num-pedido      it-codigo      
                         situacao         nr-contrato     
                         num-ord-inv      ordem-servic    num-seq-item  
                         data-cotacao     pre-unit-for    mo-codigo
                         codigo-ipi       taxa-financ     perc-descto
                         aliquota-ipi     cod-cond-pag    valor-taxa
                         nr-dias-taxa     int-1           cod-emitente
                         natureza         narrativa       dep-almoxar 
                         ct-codigo        sc-codigo )
                     

                where ordem-compra.numero-ordem   = piNumeroOrdem no-lock:
            end.
    end.
    else do:
        for first ordem-compra
                fields ( numero-ordem     num-pedido      it-codigo      
                         situacao         nr-contrato     
                         num-ord-inv      ordem-servic    num-seq-item  
                         data-cotacao     pre-unit-for    mo-codigo
                         codigo-ipi       taxa-financ     perc-descto
                         aliquota-ipi     cod-cond-pag    valor-taxa
                         nr-dias-taxa     int-1           cod-emitente
                         natureza         narrativa       dep-almoxar 
                         &IF '{&bf_mat_versao_ems}' >= '2.062' &THEN
                             cod-unid-negoc /*Unidade de Neg¢cio*/
                         &ENDIF
                         ct-codigo        sc-codigo 
                         )
                     

                where rowid(ordem-compra) = piRowidOrdemCompra no-lock:
        end.
    end.                    

    if  not avail ordem-compra then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "'Ordem de Compra'" *}
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"
                            &ErrorParameters="TRIM(RETURN-VALUE)"}
        RETURN "NOK":U.
    end.
    else         
       RETURN "OK":U.               
    

END PROCEDURE.




PROCEDURE findOrdProd :
/*------------------------------------------------------------------------------
