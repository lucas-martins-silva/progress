PROCEDURE findEstabelec :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input param piEstab   like docum-est.cod-estabel no-undo.
    

    assign i-empresa = param-global.empresa-prin.

    if  not avail estabelec
    or  estabelec.cod-estabel <> piEstab then do:

        for first estabelec
            fields ( cod-estabel  cod-emitente
                     estado       deposito-cq
                     cidade       pais 
                     char-2       ep-codigo
                     idi-tributac-cofins)
            where estabelec.cod-estabel = piEstab no-lock:
        end.

        /* somente se ativada a seguranca por estabelecimento */
        if not avail estabelec and l-seg-ativa-modulo and CAN-FIND (estabelec WHERE estabelec.cod-estabel = piEstab) then do:
            /* Seguranca estabelecimento - desativando ON FIND */
            ON FIND OF estabelec DO: END.

            for first estabelec
                fields ( cod-estabel  cod-emitente
                         estado       deposito-cq
                         cidade       pais 
                         char-2       ep-codigo
                         idi-tributac-cofins)
                where estabelec.cod-estabel = piEstab no-lock:
            end.

            /* Seguranca estabelecimento - voltando o ON FIND da estabelec */
            ON FIND OF estabelec DO:
                IF NOT CAN-FIND(tt_estab_ems2
                          WHERE tt_estab_ems2.tta_cod_estab = estabelec.cod-estabel) THEN
                    RETURN ERROR.
            END.
        end.
    end.

    if  not avail estabelec then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "'Estabelecimento'" *}
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"
                            &ErrorParameters="TRIM(RETURN-VALUE)"}
        RETURN "NOK":U.
    end.
    else do:
        run cdp/cd9970.p (input rowid(estabelec),
                          output i-empresa).

        RETURN "OK":U.        
    end.        


END PROCEDURE.




PROCEDURE findFichaCQ :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:   Verifica se existe algum roteiro de inspe»’o gerado manualmente para a 
         nota fiscal.
------------------------------------------------------------------------------*/
    

    if  not avail param-cq
    or  not avail param-global
    or  not avail item 
    or  not avail docum-est then
        return "NOK":U.

    if  param-global.modulo-cq 
    and param-cq.tipo-cq > 1    /* S½ gera roteiro ou CQ Total */
    and avail item
    and avail item-uni-estab 
    and item-uni-estab.contr-qualid then do:
    

        for first ficha-cq  
            fields ( nr-ficha      nro-docto    cod-emitente
                     it-codigo     cod-depos    cod-estabel
                     baixa-estoq   origem       log-com-nota
                     inspecionado                           ) 
            where ficha-cq.serie-docto  = RowObject.serie-docto 
              and ficha-cq.nro-docto    = RowObject.nro-docto
              and ficha-cq.cod-emitente = RowObject.cod-emitente
              and ficha-cq.cod-estabel  = docum-est.cod-estabel
              and (   ficha-cq.nr-ficha = RowObject.nr-ficha
                   or RowObject.nr-ficha = 0 )  
              and ficha-cq.it-codigo    = RowObject.it-codigo no-lock:
        end.
    end.
    

    if  avail ficha-cq
    and ficha-cq.baixa-estoq = no
    and ficha-cq.origem = 1
    and ficha-cq.log-com-nota = yes
    and ficha-cq.inspecionado = no then 
        return "OK":U.
    else
        return "NOK":U.            

END PROCEDURE.




PROCEDURE findItem :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input param piItem   like item-doc-est.it-codigo no-undo.
    

    if  not avail item
    or  item.it-codigo <> piItem then 
        for first item
            where item.it-codigo = piItem no-lock:
        end.

    if  not avail item then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "'Item'" *}
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"
                            &ErrorParameters="TRIM(RETURN-VALUE)+ piItem "}
        RETURN "NOK":U.
    end.
    else 
        RETURN "OK":U.        

END PROCEDURE.


PROCEDURE findItemContrato :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input param piNrContrato like item-contrat.nr-contrato  no-undo.
    def input param piNumSeqItem like item-contrat.num-seq-item no-undo.
    

    if  not avail item-contrat
    or  item-contrat.nr-contrato  <> piNrContrato and 
        item-contrat.num-seq-item <> piNumSeqItem then 
        
        for first item-contrat fields ( val-total )
            where item-contrat.nr-contrato  = piNrContrato and
                  item-contrat.num-seq-item = piNumSeqItem no-lock: end.
        
    if  not avail item-contrat then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "'Item do Contrato'" *}
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR" 
                            &ErrorParameters="TRIM(RETURN-VALUE)"}
        RETURN "NOK":U.
    end.
    else         
        RETURN "OK":U.        

END PROCEDURE.


PROCEDURE findItemUniEstab :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input param p-cod-estabel like item-uni-estab.cod-estabel no-undo.
    def input param p-it-codigo   like item-uni-estab.it-codigo   no-undo.
    

    for first item-uni-estab
        fields (it-codigo     lim-var-valor
                cod-estabel   var-val-re-maior
                var-qtd-re    lim-var-qtd
                deposito-pad  cod-localiz
                loc-unica     contr-qualid     
                cod-obsoleto  char-2)
          where item-uni-estab.it-codigo   = p-it-codigo
            and item-uni-estab.cod-estabel = p-cod-estabel no-lock:
    end.
    if  not avail item-uni-estab then do:
        {method/svc/errors/inserr.i
                   &ErrorNumber="25904"
                   &ErrorType="EMS"
                   &ErrorSubType="ERROR"
                   &ErrorParameters="RowObject.it-codigo + '~~~~' + p-cod-estabel"}
        RETURN "NOK":U.
    end.
    else 
        RETURN "OK":U.        

END PROCEDURE.


PROCEDURE findItemFornec :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input param piItem     like item-doc-est.it-codigo    no-undo.
    def input param piEmitente like item-doc-est.cod-emitente no-undo.    

    if  piEmitente = 0 then
        assign piEmitente = RowObject.cod-emitente.

    if  not avail item-fornec
    or  item-fornec.it-codigo <> piItem
    or  item-fornec.cod-emitente  <> piEmitente  then 

        for first item-fornec
            fields ( it-codigo      cod-emitente
                     item-do-forn   unid-med-for
                     tp-inspecao    niv-inspecao
                     fator-conver   num-casa-dec )
            where item-fornec.it-codigo = piItem
              and item-fornec.cod-emitente  = piEmitente
              AND item-fornec.ativo no-lock:
        end.

    if  not avail item-fornec then 
        RETURN "NOK":U.
    else         
        RETURN "OK":U.   

END PROCEDURE.




PROCEDURE findItNotaFisc :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input param piCodEstabel like docum-est.cod-estabel    no-undo.
    def input param piSerie      like item-doc-est.serie-docto no-undo.
    def input param piNrNotaFis  like item-doc-est.nro-docto   no-undo.
    def input param piNrSeqFat   like it-nota-fisc.nr-seq-fat  no-undo.
    

    if  not avail it-nota-fisc
    or  it-nota-fisc.cod-estabel <> piCodEstabel 
    or  it-nota-fisc.serie       <> piSerie  
    or  it-nota-fisc.nr-nota-fis <> piNrNotaFis 
    or  it-nota-fisc.nr-seq-fat  <> piNrSeqFat then 
    

        for first it-nota-fisc
            fields ( cod-estabel  serie 
                     nr-nota-fis  nr-seq-fat )
                     

            where it-nota-fisc.cod-estabel = piCodEstabel
              and it-nota-fisc.serie       = piSerie
              and it-nota-fisc.nr-nota-fis = piNrNotaFis 
              and it-nota-fisc.nr-seq-fat  = piNrSeqFat no-lock:
        end.
        

    if  not avail it-nota-fisc then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "'Item da Nota de Sa¡da'" *}
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"
                            &ErrorParameters="TRIM(RETURN-VALUE)"}
        RETURN "NOK":U.
    end.
    else 
        RETURN "OK":U.        

END PROCEDURE.




