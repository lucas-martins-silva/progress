/******************************************************************
**
**      boin090.i2  - Calculo do Credito Presumido
**
**      Parametro.: {1} - Valor a ser Atualizado
**
*******************************************************************/
                
                
if  emitente.int-1 = 1 
and natur-oper.tipo-compra = 2 /* Frete */ 
and {1} <> 0 then do: 

    assign {1} = {1} - ({1} * 0.2).

end.

