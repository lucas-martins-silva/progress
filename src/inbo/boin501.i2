   {inbo/boin501.i21 "11" "Centro_Trabalho_x_Ferramenta_x_Item" ""SFC""  "4" ""sfc/sf0803.p""}

   {inbo/boin501.i22 ""MAN001"" ""}
   {inbo/boin501.i22 ""MAN004"" ""}
   {inbo/boin501.i22 ""MAN006"" ""}
   {inbo/boin501.i22 ""MAN011"" ""}

   {inbo/boin501.i23 "16"  "Unidades_aprovadas"                     "">>,>>>,>>9.9<<"" """" " "}
   {inbo/boin501.i23 "17"  "Unidades_refugadas"                     "">>,>>9.9<<""     """" " "}
   {inbo/boin501.i23 "18"  "Unidades_retrabalhadas"                 "">>,>>9.9<<""     """" " "}

   assign c-trad1 = {ininc/i01in504.i 04 17}.
   assign c-trad2 = {ininc/i01in504.i 04 16}.   
   assign c-trad3 = {ininc/i01in504.i 04 18}.   
   &if "{&FNC_MULTI_IDIOMA}" = "Yes" &then
        RUN utp/ut-liter.p (trim(c-trad1), "*", "").
        assign c-trad1 = return-value.
        RUN utp/ut-liter.p (trim(c-trad2), "*", "").
        assign c-trad2 = return-value.
        RUN utp/ut-liter.p (trim(c-trad3), "*", "").
        assign c-trad3 = return-value.        
   &endif   

   assign c-formula = "100 * " + c-trad1 + " / ( " + c-trad2 + " + " + c-trad1 + " + " + c-trad3 + " )". /** 100*UNREF/(UNAPR+UNREF+UNRET) **/   
   {inbo/boin501.i23 "19"  "Indice_Refugo"                           "">>9.99""     "c-formula" " "}


   assign c-formula = "100 * " + c-trad3 + " / ( " + c-trad2 + " + " + c-trad1 + " + " + c-trad3 + " )". /** 100*UNRET/(UNAPR+UNREF+UNRET) **/   
   {inbo/boin501.i23 "20"  "Indice_Retrabalho"                       "">>9.99""     "c-formula" " "}

   {inbo/boin501.i23 "13" "Capacidade_PadrÆo_Utilizada"            "">>,>>>,>>9.99""  """" " "}
   {inbo/boin501.i23 "5"  "Tempo_utilizado"                        "">>>9.9""         """" "Horas"}
   {inbo/boin501.i23 "7"  "Tempo_padrÆo_utilizado"                 "">>>9.9""         """" "Horas"}

   assign c-trad1 = {ininc/i01in504.i 04 7}.
   assign c-trad2 = {ininc/i01in504.i 04 5}.     
   &if "{&FNC_MULTI_IDIOMA}" = "Yes" &then
        RUN utp/ut-liter.p (trim(c-trad1), "*", "").
        assign c-trad1 = return-value.
        RUN utp/ut-liter.p (trim(c-trad2), "*", "").
        assign c-trad2 = return-value.
   &endif   

   assign c-formula = "100 * " + c-trad1 + " / " + c-trad2. /** 100*HRPUTL/HRUTL **/   
   {inbo/boin501.i23 "6"   "Eficiˆncia_(Tempo_padrÆo/Tempo_real)"   "">>9.99""       "c-formula" " "}
   {inbo/boin501.i23 "26"  "Tempo_utilizado_extra"                  "">>>9.9""       """"        "Horas"}
   {inbo/boin501.i23 "14"  "Fator_Item_Unidade_Alternativa"         "">>,>>9.9<<<<"" """"        " "}   

   {inbo/boin501.i25} /*** Gera‡Æo de Indices Manufatura ***/


END PROCEDURE.

