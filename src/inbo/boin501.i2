/**********************************************************************************************************
** 
** PROCEDURE   GerarHierarquiaVisao
** Objetivo:   Criar automaticamente a Hierarquia das Visäes
**             
**********************************************************************************************************/
PROCEDURE GerarHierarquiaVisao:

    def buffer b-hrq-vis  for hrq-vis-man.
    def buffer b2-hrq-vis for hrq-vis-man.

    def var v-lista-dim1  as char format "x(200)".
    def var v-lista-dim2  as char format "x(200)".
    def var v-visao       as char format "x(3)".
    def var i             as int.
    def var i-seq         as int.
    def var i-inter       as int.

    find last b-hrq-vis use-index id no-lock no-error.
    assign i-seq = if  avail b-hrq-vis then b-hrq-vis.num-id-hrq + 1
                                       else 1.
    for each  visao-man
        where visao-man.num-dim = 2 no-lock:
        create hrq-vis-man.
        assign hrq-vis-man.cod-visao-n1 = visao-man.cod-visao
               hrq-vis-man.des-hrq-vis  = visao-man.des-visao 
               hrq-vis-man.num-id-hrq   = i-seq
               i-seq                    = i-seq + 1.     
    end.

    {inbo/boin501.i24 "1" "2" "3"}
    {inbo/boin501.i24 "2" "3" "4"}

    /*** Montagem do c¢digo da hierarquia ***/
    for each hrq-vis-man exclusive-lock:
        assign hrq-vis-man.cod-hrq-vis = hrq-vis-man.cod-visao-n1.

        if  hrq-vis-man.cod-visao-n2 = "" then
            next.

        assign i = 1.
        repeat:
            assign v-visao = substring(hrq-vis-man.cod-visao-n2,i,3).
            if  v-visao = "" then 
                leave.

            if  INDEX(hrq-vis-man.cod-visao-n1,v-visao) = 0 then do: 
                assign hrq-vis-man.cod-hrq-vis = hrq-vis-man.cod-hrq-vis + v-visao.
                leave.
            end.
            assign i = i + 3.
        end.

        if  hrq-vis-man.cod-visao-n3 = "" then
            next.

        assign i = 1.
        repeat:
            assign v-visao = substring(hrq-vis-man.cod-visao-n3,i,3).
            if  v-visao = "" then 
                leave.

            if  INDEX(hrq-vis-man.cod-visao-n2,v-visao) = 0 then do: 
                assign hrq-vis-man.cod-hrq-vis = hrq-vis-man.cod-hrq-vis + v-visao.
                leave.
            end.
            assign i = i + 3.     
        end.

        if  hrq-vis-man.cod-visao-n4 = "" then
            next.

        assign i = 1.
        repeat:
            assign v-visao = substring(hrq-vis-man.cod-visao-n4,i,3).
            if  v-visao = "" then 
                leave.

            if  INDEX(hrq-vis-man.cod-visao-n3,v-visao) = 0 then do: 
                assign hrq-vis-man.cod-hrq-vis = hrq-vis-man.cod-hrq-vis + v-visao.
                leave.
            end.
            assign i = i + 3.     
        end.
    end.

END PROCEDURE.
