/**********************************************************************************************************
** 
** PROCEDURE   PreinicializarVisaoMan
** Objetivo:   Criar automaticamente VisÆo Man e seus relacionamentos
** Parƒmetros: Entrada h-handle (para janela de acompanhamento)
**             
**********************************************************************************************************/
PROCEDURE PreinicializarVisaoMan:

   def input parameter h-handle as handle no-undo.

   def var c-liter  as char no-undo.
   def var c-label  as char no-undo.

   def buffer b-dim-vis-man for dim-vis-man.
   def buffer b-ind-vis-man for ind-vis-man.
   def buffer b-visao-man   for visao-man.

   run GerarVisaoCTR       (input h-handle). 
   run GerarVisaoITM       (input h-handle).
   run GerarVisaoCMP       (input h-handle).
   run GerarVisaoCTRITM    (input h-handle).
   run GerarVisaoITMCMP    (input h-handle).
   run GerarVisaoCTRPAR    (input h-handle).
   run GerarVisaoPAR       (input h-handle).
   run GerarVisaoITMCMPLCP (input h-handle).            
   run GerarVisaoCTRFERITM (input h-handle).
   run GerarVisaoOPE       (input h-handle).
   run GerarVisaoCTRREF    (input h-handle).
   run GerarVisaoOPEREF    (input h-handle).
   run GerarVisaoREF       (input h-handle).
   run GerarVisaoCTROPEREF (input h-handle).           

END PROCEDURE.

/**********************************************************************************************************
** 
** PROCEDURE   GerarVisaoCTR
** Objetivo:   Criar automaticamente a VisÆo Man CTR e seus relacionamentos
** Parƒmetros: Entrada h-handle (para janela de acompanhamento)
**             
**********************************************************************************************************/
PROCEDURE GerarVisaoCTR:

   def input parameter h-handle as handle no-undo.

   def var c-liter   as char no-undo.
   def var c-label   as char no-undo.
   def var c-visao   as char no-undo.
   def var c-ind     as char no-undo.
   def var c-formula as char no-undo.

   def buffer b-dim-vis-man for dim-vis-man.
   def buffer b-ind-vis-man for ind-vis-man.
   def buffer b-visao-man   for visao-man.
   
   {inbo/boin501.i21 "3" "Operacional_Centro_Trabalho" ""SFC"" "2" """"}

   {inbo/boin501.i22 ""MAN001"" ""}
   {inbo/boin501.i22 ""MAN004"" ""}

   {inbo/boin501.i23 "2"  "Tempo_dispon¡vel"                         "">>>9.9""     """" "Horas"}
   {inbo/boin501.i23 "1"  "Tempo_total_de_parada"                    "">>>9.9""     """" "Horas"}
   {inbo/boin501.i23 "3"  "Tempo_paradas_alteram_eficiˆncia"         "">>>9.9""     """" "Horas"}
   {inbo/boin501.i23 "24" "Tempo_total_parada_fora_do_turno"         "">>>9.9""     """" "Horas"}
   {inbo/boin501.i23 "25" "Hrs_parada_alteram_eficiˆncia_fora_turno" "">>>9.9""     """" "Horas"}

   assign c-trad1 = {ininc/i01in504.i 04 3}.
   assign c-trad2 = {ininc/i01in504.i 04 2}.
   assign c-trad3 = {ininc/i01in504.i 04 1}.
   &if "{&FNC_MULTI_IDIOMA}" = "Yes" &then
        RUN utp/ut-liter.p (trim(c-trad1), "*", "").
        assign c-trad1 = return-value.
        RUN utp/ut-liter.p (trim(c-trad2), "*", "").
        assign c-trad2 = return-value.
        RUN utp/ut-liter.p (trim(c-trad3), "*", "").
        assign c-trad3 = return-value.      
   &endif  

   assign c-formula = "100 * " + c-trad1 + " / (" + c-trad2 + " + " +
                                 c-trad1 + " - " + c-trad3 + ")". /** 100*HRPARN / (HRDSP + HRPARN - HRPART) **/ 
   {inbo/boin501.i23 "4"  "Indice_Paradas"                 "">>9.99""     "c-formula" " "}

   {inbo/boin501.i23 "5"  "Tempo_utilizado"                "">>>9.9""     """" "Horas"}
   {inbo/boin501.i23 "26" "Tempo_utilizado_extra"          "">>>9.9""     """" "Horas"}
   {inbo/boin501.i23 "7"  "Tempo_padrÆo_utilizado"         "">>>9.9""     """" "Horas"}
   
   assign c-trad1 = {ininc/i01in504.i 04 7}.
   assign c-trad2 = {ininc/i01in504.i 04 5}.
   &if "{&FNC_MULTI_IDIOMA}" = "Yes" &then
        RUN utp/ut-liter.p (trim(c-trad1), "*", "").
        assign c-trad1 = return-value.
        RUN utp/ut-liter.p (trim(c-trad2), "*", "").
        assign c-trad2 = return-value.
   &endif  

   assign c-formula = "100 * " + c-trad1 + " / " + c-trad2. /** 100*HRPUTL/HRUTL **/    
   {inbo/boin501.i23 "6"   "Eficiˆncia_(Tempo_padrÆo/Tempo_real)"    "">>9.99""     "c-formula" " "}

   {inbo/boin501.i23 "8"  "Capacidade_real_utilizada"              "">>,>>>,>>9.99""  """" " "}

   {inbo/boin501.i23 "9"  "Capacidade_Dispon¡vel"                  "">>,>>>,>>9.99"" """"  " "}

   assign c-trad1 = {ininc/i01in504.i 04 5}.
   assign c-trad2 = {ininc/i01in504.i 04 2}.
   &if "{&FNC_MULTI_IDIOMA}" = "Yes" &then
        RUN utp/ut-liter.p (trim(c-trad1), "*", "").
        assign c-trad1 = return-value.
        RUN utp/ut-liter.p (trim(c-trad2), "*", "").
        assign c-trad2 = return-value.
   &endif     

   assign c-formula = "100 * " + c-trad1 + " / " + c-trad2. /** 100*HRUTL/HRDSP **/
   {inbo/boin501.i23 "10"  "Indice_Utiliza‡Æo_Tempo"               "">>9.99""     "c-formula" " "}

   assign c-trad1 = {ininc/i01in504.i 04 8}.
   assign c-trad2 = {ininc/i01in504.i 04 9}.
   &if "{&FNC_MULTI_IDIOMA}" = "Yes" &then
        RUN utp/ut-liter.p (trim(c-trad1), "*", "").
        assign c-trad1 = return-value.
        RUN utp/ut-liter.p (trim(c-trad2), "*", "").
        assign c-trad2 = return-value.
   &endif     

   assign c-formula = "100 * " + c-trad1 + " / " + c-trad2. /** 100*CPRUTL/CPDSP **/
   {inbo/boin501.i23 "11"  "Indice_Utiliza‡Æo_Capacidade"          "">>9.99""     "c-formula" " "}

   {inbo/boin501.i23 "19"  "Indice_Refugo"     "">>9.99""  """" " "}
   {inbo/boin501.i23 "20"  "Indice_Retrabalho" "">>9.99""  """" " "}
   {inbo/boin501.i23 "30"  "Carga_Reportada" "">>,>>>,>>9.99""  """" " "}

   {inbo/boin501.i25} /*** Gera‡Æo de Indices Manufatura ***/

END PROCEDURE.

