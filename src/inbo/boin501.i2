   {inbo/boin501.i23 "23" "Indice_desvio_consumo"        ""->>9.99""     "c-formula" " "}

   {inbo/boin501.i23 "14" "Fator_Item_Unidade_Alternativa"       "">>,>>9.9<<<<"" """" " "}
   {inbo/boin501.i23 "15" "Fator_Componente_Unidade_Alternativa" "">>,>>9.9<<<<"" """" " "}   

   {inbo/boin501.i25} /*** Gera‡Æo de Indices Manufatura ***/


END PROCEDURE.

