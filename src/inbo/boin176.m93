IF CAN-FIND (FIRST tt-item-doc-est-tribut NO-LOCK
             WHERE tt-item-doc-est-tribut.cod-serie-docto  = {1}.serie-docto 
               AND tt-item-doc-est-tribut.cod-num-docto    = {1}.nro-docto   
               AND tt-item-doc-est-tribut.cdn-emitente     = {1}.cod-emitente
               AND tt-item-doc-est-tribut.cod-natur-operac = {1}.nat-operacao
               AND tt-item-doc-est-tribut.num-seq          = {1}.sequencia) THEN DO:

    FIND FIRST tb-wt-it-docto EXCLUSIVE-LOCK
         WHERE tb-wt-it-docto.seq-wt-docto    = 1
           AND tb-wt-it-docto.seq-wt-it-docto = {1}.sequencia NO-ERROR.    
    
    FIND FIRST tb-wt-it-imposto EXCLUSIVE-LOCK
         WHERE tb-wt-it-imposto.seq-wt-docto    = 1
           AND tb-wt-it-imposto.seq-wt-it-docto = {1}.sequencia NO-ERROR.    
       
    IF AVAIL tb-wt-it-docto AND AVAIL tb-wt-it-imposto THEN DO:
        FOR EACH tt-item-doc-est-tribut NO-LOCK
           WHERE tt-item-doc-est-tribut.cod-serie-docto  = {1}.serie-docto 
             AND tt-item-doc-est-tribut.cod-num-docto    = {1}.nro-docto   
             AND tt-item-doc-est-tribut.cdn-emitente     = {1}.cod-emitente
             AND tt-item-doc-est-tribut.cod-natur-operac = {1}.nat-operacao
             AND tt-item-doc-est-tribut.num-seq          = {1}.sequencia: 

            // Conteudo do campo em formato decimal
            ASSIGN d-cod-conteudo = 0.
            ASSIGN d-cod-conteudo = DEC(REPLACE(tt-item-doc-est-tribut.cod-conteudo,".",",")) NO-ERROR.
            
            CASE tt-item-doc-est-tribut.nom-trib:
                WHEN rep.imp.Imposto:ICMS THEN DO:
                    CASE tt-item-doc-est-tribut.cod-campo:
                        WHEN AtributoImposto:COD-TRIB      THEN ASSIGN tb-wt-it-imposto.cd-trib-icm            = INT(tt-item-doc-est-tribut.cod-conteudo).
                        WHEN AtributoImposto:ALIQUOTA      THEN ASSIGN tb-wt-it-imposto.aliquota-icm           = d-cod-conteudo.
                        WHEN AtributoImposto:PERC-REDUC-BC THEN ASSIGN tb-wt-it-imposto.perc-red-icm           = d-cod-conteudo.
                        WHEN AtributoImposto:BASE-TRIB     THEN ASSIGN tb-wt-it-imposto.vl-bicms-it            = d-cod-conteudo.
                        WHEN AtributoImposto:BASE-ISENTA   THEN ASSIGN tb-wt-it-imposto.vl-icmsnt-it           = d-cod-conteudo.
                        WHEN AtributoImposto:BASE-OUTRAS   THEN ASSIGN tb-wt-it-imposto.vl-icmsou-it           = d-cod-conteudo.
                        WHEN AtributoImposto:VALOR         THEN ASSIGN tb-wt-it-imposto.vl-icms-it             = d-cod-conteudo.
                        WHEN AtributoImposto:PERC-DIFER    THEN ASSIGN tb-wt-it-imposto.val-perc-icms-diferim  = d-cod-conteudo.
                        WHEN AtributoImposto:VALOR-DIFER   THEN ASSIGN tb-wt-it-imposto.val-diferim-icms-item  = d-cod-conteudo.
                    END CASE.
                END.
                WHEN rep.imp.Imposto:SIMPLES THEN DO:                    
                    CASE tt-item-doc-est-tribut.cod-campo:
                        WHEN AtributoImposto:BASE          THEN ASSIGN OVERLAY(tb-wt-it-imposto.char-1,150,20)  = STRING(d-cod-conteudo).
                        WHEN AtributoImposto:ALIQUOTA      THEN ASSIGN OVERLAY(tb-wt-it-imposto.char-1,170,20)  = STRING(d-cod-conteudo).
                        WHEN AtributoImposto:VALOR         THEN ASSIGN OVERLAY(tb-wt-it-imposto.char-1,356,5)   = STRING(d-cod-conteudo).
                    END CASE.
                END.
                WHEN rep.imp.Imposto:ICMS-ST THEN DO:
                    CASE tt-item-doc-est-tribut.cod-campo:
                        WHEN AtributoImposto:BASE          THEN ASSIGN tb-wt-it-imposto.vl-bsubs-it           = d-cod-conteudo.
                        WHEN AtributoImposto:VALOR         THEN ASSIGN tb-wt-it-imposto.vl-icmsub-it          = d-cod-conteudo.
                        WHEN AtributoImposto:ALIQUOTA      THEN ASSIGN overlay(tb-wt-it-imposto.char-1,71,6)  = STRING(d-cod-conteudo).
                        WHEN AtributoImposto:PERC-MVA-ST   THEN ASSIGN tb-wt-it-imposto.dec-1                 = d-cod-conteudo. // % MVA
                        WHEN AtributoImposto:PERC-REDUC-BC THEN ASSIGN overlay(tb-wt-it-imposto.char-1,344,7) = STRING(d-cod-conteudo).      // % Red BC ST
                    END CASE.
                END.
                WHEN rep.imp.Imposto:ICMS-STA THEN DO:
                    CASE tt-item-doc-est-tribut.cod-campo:
                        WHEN AtributoImposto:BASE          THEN ASSIGN tb-wt-it-imposto.vl-bsubsit-e[1]      = d-cod-conteudo.
                        WHEN AtributoImposto:VALOR         THEN ASSIGN tb-wt-it-imposto.vl-icmsubit-e[1]     = d-cod-conteudo.
                        WHEN AtributoImposto:ALIQUOTA      THEN ASSIGN overlay(tb-wt-it-imposto.char-1,71,6) = STRING(d-cod-conteudo).
                    END CASE.
                END.
                WHEN rep.imp.Imposto:ICMS-COMPL THEN DO:
                    CASE tt-item-doc-est-tribut.cod-campo:
                        WHEN AtributoImposto:BASE  THEN ASSIGN overlay(tb-wt-it-imposto.char-1,296,20) = STRING(d-cod-conteudo).
                        WHEN AtributoImposto:VALOR THEN ASSIGN tb-wt-it-imposto.icm-complem            = d-cod-conteudo.
                    END CASE.
                END.
                WHEN rep.imp.Imposto:IPI THEN DO:
                    CASE tt-item-doc-est-tribut.cod-campo:
                        WHEN AtributoImposto:COD-TRIB      THEN ASSIGN tb-wt-it-imposto.cd-trib-ipi  = INT(tt-item-doc-est-tribut.cod-conteudo).
                        WHEN AtributoImposto:ALIQUOTA      THEN ASSIGN tb-wt-it-imposto.aliquota-ipi = d-cod-conteudo.
                        WHEN AtributoImposto:PERC-REDUC-BC THEN ASSIGN tb-wt-it-imposto.perc-red-ipi = d-cod-conteudo.
                        WHEN AtributoImposto:BASE-TRIB     THEN ASSIGN tb-wt-it-imposto.vl-bipi-it   = d-cod-conteudo.
                        WHEN AtributoImposto:BASE-ISENTA   THEN ASSIGN tb-wt-it-imposto.vl-ipint-it  = d-cod-conteudo.
                        WHEN AtributoImposto:BASE-OUTRAS   THEN ASSIGN tb-wt-it-imposto.vl-ipiou-it  = d-cod-conteudo.
                        WHEN AtributoImposto:VALOR         THEN ASSIGN tb-wt-it-imposto.vl-ipi-it    = d-cod-conteudo.
                    END CASE.
                END.
                WHEN rep.imp.Imposto:PIS THEN DO:
                    CASE tt-item-doc-est-tribut.cod-campo:
                        WHEN AtributoImposto:COD-TRIB      THEN ASSIGN overlay(tb-wt-it-docto.char-2,96,1) = STRING(d-cod-conteudo).
                        WHEN AtributoImposto:ALIQUOTA      THEN ASSIGN overlay(tb-wt-it-docto.char-1,100,7) = STRING(d-cod-conteudo).
                        WHEN AtributoImposto:PERC-REDUC-BC THEN ASSIGN overlay(tb-wt-it-docto.char-2,86,5) = STRING(d-cod-conteudo).
                        WHEN AtributoImposto:VALOR         THEN ASSIGN tb-wt-it-docto.val-retenc-pis       = d-cod-conteudo.
                    END CASE.
                END.
                WHEN rep.imp.Imposto:COFINS THEN DO:
                    CASE tt-item-doc-est-tribut.cod-campo:
                        WHEN AtributoImposto:COD-TRIB      THEN ASSIGN overlay(tb-wt-it-docto.char-2,97,1) = STRING(d-cod-conteudo).
                        WHEN AtributoImposto:ALIQUOTA      THEN ASSIGN overlay(tb-wt-it-docto.char-1,107,7) = STRING(d-cod-conteudo).
                        WHEN AtributoImposto:PERC-REDUC-BC THEN ASSIGN overlay(tb-wt-it-docto.char-2,91,5) = STRING(d-cod-conteudo).
                        WHEN AtributoImposto:VALOR         THEN ASSIGN tb-wt-it-docto.val-retenc-cofins    = d-cod-conteudo.
                    END CASE.
                END.
            END CASE.
        END. /* FOR EACH tt-item-doc-est-tribut */
    END. /*IF AVAIL tb-wt-it-docto AND AVAIL tb-wt-it-imposto*/
END.

