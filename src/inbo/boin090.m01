PROCEDURE enablebtrecfisico :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE INPUT PARAMETER  pFieldName   AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldEnable AS INTEGER   NO-UNDO.    

    if  pFieldName = "btRecFisico":U THEN 
        ASSIGN pFieldEnable = if avail param-estoq and
                                       param-estoq.rec-fisico
                              then 1
                              else 0.

END PROCEDURE.

PROCEDURE desabilitaBotoes:
/*------------------------------------------------------------------------------
  Purpose: Retorna se deve desabilitar botoes de alterar/excluir
  Parameters:  <none>
  Notes: docum-est deve estar posicionada caso contrario e retornado NOK
------------------------------------------------------------------------------*/
    DEF OUTPUT PARAM l-desabilita AS LOG INIT NO NO-UNDO.

    if not avail docum-est then
        return "NOK":U.
    
    IF docum-est.origem = "AQR":U THEN DO:
        ASSIGN l-desabilita = YES.
        RETURN "OK":U.
    END.
    
    IF NOT docum-est.rec-fisico AND
       (docum-est.ind-sit-wms-ext = 2  OR /*Aguardando*/
        docum-est.ind-sit-wms-ext = 3  OR /*Em processo*/
        docum-est.ind-sit-wms-ext = 4) THEN /*Conferencia OK*/
        ASSIGN l-desabilita = YES.
    
   
       
    RETURN "OK":U.
    
END PROCEDURE.

PROCEDURE enableButtons :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: 0 - desabilita
         1 - habilita ( devolu‡Æo ou com produ‡Æo)
         2 - habilita ( terceiros ou sem produ‡Æo)

         btDuplicatas   - inclui, modifica, elimina e impostos
         btDupGerar     - gera‡Æo duplicatas
         btDespAces     - inclui, modifica, elimina
         btAcabado      - inclui, modifica, elimina
         btAgregado     - agregados
         btRateio       - modifica
         btItensInc     - inclui 
         btItensMod     - modifica
         btItemElim     - elimina
         btItensTotNota - totaliza Nota
         btPedido       - que est  no link de itens
         btGerar        - link itens
         btEstrutura    - link itens
         btRecFisico    
         btRateio        
                        

------------------------------------------------------------------------------*/

    DEFINE INPUT PARAMETER  pFieldName   AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldEnable AS INTEGER   NO-UNDO.
    
    DEFINE VAR l-habilita-multa-juros AS LOGICAL INITIAL NO NO-UNDO.  
    {rep/re1001a.i50}

    if  not avail docum-est then
        return "NOK":U.
        

    run findNaturOper ( docum-est.nat-operacao ).
    run findEstabelec ( RowObject.cod-estabel ).
    run findEmitente ( input RowObject.cod-emitente ).
    

    if  return-value <> "OK":U then
        return "NOK":U.
    

    run setFlagsNota ( docum-est.cod-observa,
                       docum-est.nat-operacao ).
                       
    ASSIGN l-habilita-multa-juros =  (l-multa-juros AND NOT CAN-FIND (FIRST item-doc-est no-lock
                                                                      WHERE item-doc-est.serie-docto  = RowObject.serie-docto  
                                                                        AND item-doc-est.nro-docto    = RowObject.nro-docto    
                                                                        AND item-doc-est.cod-emitente = RowObject.cod-emitente 
                                                                        AND item-doc-est.nat-operacao = RowObject.nat-operacao)).
                
    
    
    {cdp/cd9700.i1 natur-oper} /* seta variavel l-fatura-fat-antecip */

    CASE pFieldName:
        WHEN "btDuplicatas":U   THEN ASSIGN pFieldEnable = if  not docum-est.ce-atual 
                                                           and avail natur-oper
                                                           and natur-oper.tipo = 1
                                                           and natur-oper.emite-duplic
                                                           then 1
                                                           else 0.
        WHEN "btDupGerar":U     THEN ASSIGN pFieldEnable = if  not docum-est.ce-atual 
                                                           and docum-est.tot-valor > 0
                                                           and avail natur-oper
                                                           and natur-oper.tipo = 1
                                                           and natur-oper.emite-duplic
                                                           then 1
                                                           else 0.
                                                           

        WHEN "btDespAces":U     THEN ASSIGN pFieldEnable = if  not docum-est.ce-atual 
                                                           and avail natur-oper
                                                           and natur-oper.tipo = 1
                                                           and not natur-oper.nota-rateio
                                                           and not natur-oper.tipo-compra = 9 //nota cr‚dito e d‚bito
                                                           then 1
                                                           else 0.
        WHEN "btAcabado":U      THEN ASSIGN pFieldEnable = if  not docum-est.ce-atual 
                                                           and docum-est.mod-atual = 1  
                                                           then if  not param-global.modulo-cp
                                                                and not param-global.modulo-mi 
                                                                then 2 /* Sem produ‡Æo */ 
                                                                else 1 /* Com produ‡Æo */
                                                           else 0. 
        WHEN "btAgregado":U     THEN ASSIGN pFieldEnable = if  not docum-est.ce-atual 
                                                           and avail natur-oper
                                                           and natur-oper.terceiros
                                                           and natur-oper.tp-oper-terc = 2
                                                           then 1
                                                           else 0.                                                           
        WHEN "btRateio":U       THEN ASSIGN pFieldEnable = if  not docum-est.ce-atual 
                                                           and avail natur-oper
                                                           and natur-oper.nota-rateio
                                                           then 1
                                                           else 0.                                                           
        WHEN "btItensInc":U     THEN ASSIGN pFieldEnable = if  docum-est.ce-atual
                                                           or  docum-est.rec-fisico
                                                           or  docum-est.esp-docto = 23 /* Transferªncia */
                                                           or  (    avail natur-oper
                                                                and natur-oper.terceiros 
                                                                and (   natur-oper.tp-oper-terc = 2 
                                                                     or natur-oper.tp-oper-terc = 4
                                                                     or natur-oper.tp-oper-terc = 5 
                                                                     or natur-oper.tp-oper-terc = 6
                                                                     or natur-oper.tp-oper-terc = 9
                                                                     or natur-oper.tp-oper-terc = 11 ) )    
                                                           then 0
                                                           else 1.
        WHEN "btItensElim":U    THEN ASSIGN pFieldEnable = if  docum-est.ce-atual
                                                           or  docum-est.rec-fisico
                                                           or  docum-est.esp-docto = 23 /* Transferªncia */
                                                           then 0
                                                           else 1.
        WHEN "btItensMod":U     THEN ASSIGN pFieldEnable = if  not docum-est.ce-atual
                                                           then 1
                                                           else 0.
        WHEN "btItensTotNota":U THEN ASSIGN pFieldEnable = if  not docum-est.ce-atual
                                                           then 1
                                                           else 0.
        WHEN "btPedido":U       THEN ASSIGN pFieldEnable = if  not docum-est.ce-atual
                                                           and avail natur-oper
                                                           and not natur-oper.terceiros
                                                           and not natur-oper.transf
                                                           and (   l-industria 
                                                                or l-comercio )
                                                           then 1
                                                           else 0.                                                           
        WHEN "btGerar":U        THEN ASSIGN pFieldEnable = if  not docum-est.ce-atual
                                                           and (   docum-est.esp-docto = 20 
                                                                or natur-oper.tipo-compra = 8
                                                                or l-habilita-multa-juros  )
                                                           then 1 /* Habilita Devolu‡Æo Cliente */
                                                           else if  not docum-est.ce-atual 
                                                                and avail natur-oper
                                                                and natur-oper.terceiros
                                                                and (   natur-oper.tp-oper-terc =  2 
                                                                     or natur-oper.tp-oper-terc =  4  
                                                                     or natur-oper.tp-oper-terc =  5 
                                                                     or natur-oper.tp-oper-terc =  6 
                                                                     or natur-oper.tp-oper-terc =  9
                                                                     or natur-oper.tp-oper-terc = 11 )
                                                                then 2 /* Habilita Terceiros */    
                                                                else if  l-remessa-fat-antecip then 3
                                                                     else 0.  
        WHEN "btEstrutura":U    THEN ASSIGN pFieldEnable = if  not docum-est.ce-atual
                                                           and avail natur-oper
                                                           and natur-oper.terceiros
                                                           and (   natur-oper.tp-oper-terc = 1   /* remessa */
                                                                or natur-oper.tp-oper-terc = 2   /* retorno */
                                                                or natur-oper.tp-oper-terc = 5 ) /* devolu‡Æo */
                                                           then 1
                                                           else 0.                                                                                                                    
        WHEN "btRateio":U       THEN ASSIGN pFieldEnable = if  not docum-est.ce-atual
                                                           and avail natur-oper
                                                           and natur-oper.nota-rateio
                                                           then 1
                                                           else 0.

        WHEN "btImportacao":U   THEN ASSIGN pFieldEnable = if  not docum-est.ce-atual
                                                           and param-global.modulo-07
                                                           and not natur-oper.tipo-compra = 9 //nota cr‚dito e d‚bito
                                                           then 1
                                                           else 0.
                                                           

        WHEN "btDespesasImp":U   THEN ASSIGN pFieldEnable = if not docum-est.ce-atual
                                                           and param-global.modulo-07
                                                           and avail emitente
                                                           and (emitente.natureza = 3 or
                                                                emitente.natureza = 4)
                                                           and avail estabelec 
                                                           and estabelec.pais <> emitente.pais     
                                                           then 1
                                                           else 0.
        WHEN "btImportacaoFundap":U THEN do:
            {cdp/cd4300.i4   yes docum-est.char-1}
            {rep/re1001a.i51 yes}
            if not docum-est.ce-atual
                and param-global.modulo-07
                and avail emitente
                and avail estabelec
                and (((emitente.natureza = 3 or emitente.natureza = 4) and 
                     (estabelec.pais <> emitente.pais)) or
                     (c-embarque <> "":U))
                then assign pFieldEnable = 1.
                else assign pFieldEnable = 0.
        end.
        when "btGeraporItem" then do:
            assign pFieldEnable = if not docum-est.ce-atual
                                     and (docum-est.esp-docto = 20 or natur-oper.tipo-compra = 8)
                                     then 1
                                  else if not docum-est.ce-atual
                                          and avail natur-oper
                                          and natur-oper.terceiros
                                          and (   natur-oper.tp-oper-terc = 2
                                               or natur-oper.tp-oper-terc = 4
                                               or natur-oper.tp-oper-terc = 5
                                               or natur-oper.tp-oper-terc = 9
                                               or natur-oper.tp-oper-terc = 11) then 2
                                  else 0.
        end.
        
        when "btDelete" then
            assign pFieldEnable = if NOT docum-est.rec-fisico AND
                                     docum-est.ind-sit-wms-ext = 5 /*Conferencia NOK*/
                                     then 0
                                     else 1.

        OTHERWISE ASSIGN pFieldEnable = 1.
        

    END CASE.

    RETURN "OK":U.

END PROCEDURE.




PROCEDURE enableFields :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: 
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER  pType        AS CHARACTER NO-UNDO.
    DEFINE INPUT PARAMETER  pFieldName   AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldEnable AS LOGICAL   NO-UNDO.

    if  avail RowObject then do:        

        if  RowObject.usuario <> "":U then 
            run findUsuario ( RowObject.usuario ).        
        

        run setFlagsNota ( RowObject.cod-observa,
                           RowObject.nat-operacao ).        
    end.

    if  not avail param-re then
        run findUsuario ( c-seg-usuario ).
        
    def var l-natur-of-subs as log no-undo.
    DEF BUFFER b-natur-oper   FOR natur-oper.
    DEF BUFFER b-item-doc-est FOR item-doc-est.
    
    assign l-natur-of-subs = no.
    /* Se USA mœltiplas nas=turezas no recebimento. */
    IF  l-mult-natur-receb THEN DO: /* Var def em cd9701.i */
        FOR EACH b-item-doc-est NO-LOCK
            WHERE b-item-doc-est.serie-docto  = RowObject.serie-docto
              AND b-item-doc-est.nro-docto    = RowObject.nro-docto
              AND b-item-doc-est.cod-emitente = RowObject.cod-emitente
              AND b-item-doc-est.nat-operacao = RowObject.nat-operacao:
            FIND FIRST b-natur-oper NO-LOCK
                 WHERE b-natur-oper.nat-operacao = b-item-doc-est.nat-of NO-ERROR.
            IF AVAIL b-natur-oper AND
               b-natur-oper.subs-trib THEN 
                assign l-natur-of-subs = yes.
        end.
    end.
    else 
        if avail natur-oper and 
           natur-oper.subs-trib then
           assign l-natur-of-subs = yes.  

    CASE pFieldName:
        WHEN "esp-docto":U      THEN ASSIGN pFieldEnable = no.
        WHEN "esp-fiscal":U     THEN ASSIGN pFieldEnable =      avail param-re
                                                            and param-re.pd-esp-fiscal.
        WHEN "cod-observa":U    THEN ASSIGN pFieldEnable = ( pType = "Create":U ).
        WHEN "cod-estabel":U    THEN do:
                 ASSIGN pFieldEnable = ( not param-estoq.estab-uni 
                                         and (pType = "Create":U
                                              or (pType = "Update":U
                                                  and avail RowObject
                                                  and not RowObject.rec-fisico))).
                 /*NÆo habilitar  o campo cod-estabel quando a natureza de opre‡Æo for de terceiros e possuir item*/
                 if  ptype = "Update":U 
                 and avail natur-oper
                 and natur-oper.terceiros
                 and can-find (first item-doc-est
                              where item-doc-est.serie-docto         = docum-est.serie-docto  
                              and   item-doc-est.nro-docto           = docum-est.nro-docto    
                              and   item-doc-est.cod-emitente        = docum-est.cod-emitente 
                              and   item-doc-est.nat-operacao        = docum-est.nat-operacao) then
                    ASSIGN pFieldEnable = no.
        end.
        WHEN "estab-de-or":U    THEN ASSIGN pFieldEnable = l-transf.
        WHEN "estab-fisc":U     THEN do: 
            ASSIGN pFieldEnable = (avail param-global 
                                   and param-global.modulo-of ) .
            IF pType = "Update":U AND AVAIL natur-oper THEN DO:
                IF natur-oper.tipo-compra = 3 THEN
                    ASSIGN pFieldEnable = NO.
            END.
        END.
        WHEN "dt-emissao":U     THEN ASSIGN pFieldEnable = (   pType = "Create":U
                                                            or pType = "Copy":U  
                                                            or (    pType = "Update":U
                                                                and avail RowObject
                                                                and not RowObject.rec-fisico
                                                                )
                                                           ).
        WHEN "nat-comp":U       THEN ASSIGN pFieldEnable = l-transf .    /* bete XXXXXXXXXXXXXXXX */
        WHEN "unid-feder":U     THEN ASSIGN pFieldEnable = ( avail param-re and param-re.alt-uf ).
        WHEN "valor-frete":U    THEN DO:
          IF AVAIL param-re AND SUBSTR(param-re.char-1,28,1) = "S" /*Sim*/ THEN ASSIGN pFieldEnable = YES.
                                                                           ELSE ASSIGN pFieldEnable = NO.
        END.  
        WHEN "valor-seguro":U    THEN DO:
          IF AVAIL param-re AND SUBSTR(param-re.char-1,28,1) = "S" /*Sim*/ THEN ASSIGN pFieldEnable = YES.
                                                                           ELSE ASSIGN pFieldEnable = NO.
        END.  
        WHEN "valor-embal":U    THEN DO:
          IF AVAIL param-re AND SUBSTR(param-re.char-1,28,1) = "S" /*Sim*/ THEN ASSIGN pFieldEnable = YES.
                                                                           ELSE ASSIGN pFieldEnable = NO.
        END.  
        WHEN "valor-outros":U    THEN DO:
          IF AVAIL param-re AND SUBSTR(param-re.char-1,28,1) = "S" /*Sim*/ THEN ASSIGN pFieldEnable = YES.
                                                                           ELSE ASSIGN pFieldEnable = NO.
        END.  
        WHEN "tot-peso":U       THEN ASSIGN pFieldEnable = not l-transf.
        WHEN "tot-desconto":U   THEN ASSIGN pFieldEnable = not l-transf.
        WHEN "valor-mercad":U   THEN ASSIGN pFieldEnable = not l-transf.
        WHEN "despesa-nota":U   THEN ASSIGN pFieldEnable = no.
        WHEN "dt-venc-icm":U    THEN ASSIGN pFieldEnable = not l-servicos.
        WHEN "dt-venc-ipi":U    THEN ASSIGN pFieldEnable = not l-servicos.
        WHEN "dt-venc-iss":U    THEN ASSIGN pFieldEnable = l-servicos.
        

        WHEN "mod-frete":U      THEN ASSIGN pFieldEnable =    (     avail natur-oper 
                                                                and natur-oper.tipo-compra = 2). /* Frete */
        WHEN "nff":U            THEN ASSIGN pFieldEnable = (    not avail natur-oper
                                                             or natur-oper.emite-duplic ).
        WHEN "estorn-comiss":U  THEN ASSIGN pFieldEnable = l-devolucao and not RowObject.cr-atual.
        WHEN "nf-emitida-est":U THEN ASSIGN pFieldEnable = l-devolucao.
        

        WHEN "base-iss":U       THEN ASSIGN pFieldEnable = (    avail param-re 
                                                            and param-re.ped-imp-nota 
                                                            and l-servicos ).
        WHEN "iss-deb-cre":U    THEN ASSIGN pFieldEnable = (    avail param-re 
                                                            and param-re.ped-imp-nota 
                                                            and l-servicos ).
        WHEN "base-subs":U      THEN ASSIGN pFieldEnable = (    avail param-re
                                                            and param-re.ped-imp-nota 
                                                            and avail natur-oper
                                                            and l-natur-of-subs 
                                                            and natur-oper.tipo-compra <> 2). /* Frete */
        WHEN "vl-subs":U        THEN ASSIGN pFieldEnable = (    avail param-re
                                                            and param-re.ped-imp-nota 
                                                            and avail natur-oper
                                                            and l-natur-of-subs 
                                                            and natur-oper.tipo-compra <> 2). /* Frete */
        WHEN "icm-complem":U    THEN ASSIGN pFieldEnable = (    avail param-re
                                                            and param-re.ped-imp-nota 
                                                            and RowObject.icm-complem <> 0).
        WHEN "icm-fonte":U      THEN ASSIGN pFieldEnable = (    avail param-re
                                                            and param-re.ped-imp-nota
                                                            and avail natur-oper
                                                            and natur-oper.subs-trib 
                                                            and (     natur-oper.tipo-compra = 2 /* Frete */
                                                                  or (    RowObject.base-subs = 0 
                                                                      and RowObject.vl-subs   = 0 ))).
        WHEN "base-ipi":U       THEN ASSIGN pFieldEnable = (    avail param-re
                                                            and param-re.ped-imp-nota 
                                                            and not l-servicos ).
        WHEN "ipi-deb-cre":U    THEN ASSIGN pFieldEnable = (    avail param-re
                                                            and param-re.ped-imp-nota 
                                                            and not l-servicos ).
        WHEN "base-icm":U       THEN ASSIGN pFieldEnable = (    avail param-re
                                                            and param-re.ped-imp-nota 
                                                            and not l-servicos ).
        WHEN "icm-deb-cre":U    THEN ASSIGN pFieldEnable = (    avail param-re
                                                            and param-re.ped-imp-nota 
                                                            and not l-servicos ).
        WHEN "cod-modalid-frete":U THEN ASSIGN pFieldEnable = yes.
        WHEN "de-valor-pedagio":U THEN ASSIGN pFieldEnable = (  avail param-re
                                                            and substring(param-re.char-1,21,1) = "1" 
                                                            and avail natur-oper
                                                            and natur-oper.tipo-compra = 2). 
        OTHERWISE ASSIGN pFieldEnable = yes.
        

    END CASE.

    RETURN "OK":U.

END PROCEDURE.




