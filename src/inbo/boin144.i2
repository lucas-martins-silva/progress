/**********************************************************************************
**
** ExportarAtributosCtrab
** OBJETIVO: Exporta‡Æo de atributos para centros de trabalho do grupo de m quina
**
**********************************************************************************/
PROCEDURE ExportarAtributosCtrab:

    define parameter buffer b-grup-maquina for grup-maquina.

    for each ctrab where
             ctrab.gm-codigo = b-grup-maquina.gm-codigo exclusive-lock:

        assign ctrab.log-ctrab-progdo = grup-maquina.log-ctrab-progdo 
               ctrab.ind-tip-ctrab    = grup-maquina.ind-tip-ctrab    
               ctrab.log-pto-control  = grup-maquina.log-pto-control
               ctrab.qtd-lead-time    = grup-maquina.qtd-lead-time.

    end.

END PROCEDURE. 
