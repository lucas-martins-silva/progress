    DEFINE OUTPUT PARAMETER pcdn-tip-det LIKE mla-docto-pend-aprovac-det.cdn-tip-det NO-UNDO.
    DEFINE OUTPUT PARAMETER pcdn-seq LIKE mla-docto-pend-aprovac-det.cdn-seq NO-UNDO.

