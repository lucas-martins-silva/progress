&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram  
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice mldctpna_id2
  Parameters:  
               recebe valor do campo nr-trans
               recebe valor do campo cdn-tip-det
               recebe valor do campo cdn-seq
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pnr-trans LIKE mla-docto-pend-aprovac-det.nr-trans NO-UNDO.
    DEFINE INPUT PARAMETER pcdn-tip-det LIKE mla-docto-pend-aprovac-det.cdn-tip-det NO-UNDO.
    DEFINE INPUT PARAMETER pcdn-seq LIKE mla-docto-pend-aprovac-det.cdn-seq NO-UNDO.

    FIND FIRST bfmla-docto-pend-aprovac-det WHERE 
        bfmla-docto-pend-aprovac-det.nr-trans = pnr-trans AND 
        bfmla-docto-pend-aprovac-det.cdn-tip-det = pcdn-tip-det AND 
        bfmla-docto-pend-aprovac-det.cdn-seq = pcdn-seq NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfmla-docto-pend-aprovac-det THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfmla-docto-pend-aprovac-det)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

