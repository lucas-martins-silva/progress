&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQuery DBOProgram 
PROCEDURE openQuery :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
/* ------------------------ PROXIES BO 1.1 ----------------------------- */

    define input parameter i-abertura as integer no-undo.
       case i-abertura:
           when 1 then
              RUN openQueryStatic (input "Main":U). 
              
           when 2 then
              RUN openQueryStatic (input "ByFiltroCodRoteiro":U).
           
           when 3 then
              RUN openQueryStatic (input "ByFiltroDescricao":U).
           
       end case.
    
    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryByFiltroCodRoteiro DBOProgram 
PROCEDURE openQueryByFiltroCodRoteiro :
/*------------------------------------------------------------------------------
  Purpose:    Busca conjunto de registros da tabela rot-fabric, 
              dentro de uma faixa de roteiro inicial e final, 
              situa‡Æo(pode ser ativo, inativo ou experimental).
              Ordena por roteiro. 
  
------------------------------------------------------------------------------*/

  open query {&QUERYNAME} for each {&TABLENAME} where {&TABLENAME}.cod-roteiro >= c-inicial          and 
                                                      {&TABLENAME}.cod-roteiro <= c-final            and
                                                      (({&TABLENAME}.situacao = 1 and l-ativo)       or
                                                      ({&TABLENAME}.situacao = 2  and l-inativo)     or   
                                                      ({&TABLENAME}.situacao = 3  and l-experimental))
                                                       no-lock by {&TABLENAME}.cod-roteiro INDEXED-REPOSITION.
                                     
    RETURN "OK":U.


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryByFiltroDescricao DBOProgram 
PROCEDURE openQueryByFiltroDescricao :
/*------------------------------------------------------------------------------
  Purpose:    Busca conjunto de registros da tabela rot-fabric, 
              dentro de uma faixa de roteiro inicial e final,
              situa‡Æo(pode ser ativo, inativo ou experimental).
              Ordena por descri‡Æo. 
  
------------------------------------------------------------------------------*/
  open query {&QUERYNAME} for each {&TABLENAME} where {&TABLENAME}.descricao >= c-inicial            and 
                                                      {&TABLENAME}.descricao <= c-final              and
                                                      (({&TABLENAME}.situacao = 1 and l-ativo)       or
                                                      ({&TABLENAME}.situacao = 2  and l-inativo)     or   
                                                      ({&TABLENAME}.situacao = 3  and l-experimental))
                                                       no-lock by {&TABLENAME}.descricao INDEXED-REPOSITION.
     
    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryMain DBOProgram 
PROCEDURE openQueryMain :
/*------------------------------------------------------------------------------
  Purpose:     Abertura da query principal do DBO
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH rot-fabric NO-LOCK INDEXED-REPOSITION.

    RETURN "OK":U.
END PROCEDURE.

