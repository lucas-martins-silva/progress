&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE setConstraint2 DBOProgram 
PROCEDURE setConstraint2 :
/*------------------------------------------------------------------------------
  Purpose:     Seta as vari veis de controle para queries contendo
               o c¢digo inicial e final e as situa‡äes ativo, inativo
               e experimental.
  Parameters:  ipar1:p-inicial:Roteiro Inicial
               ipar2:p-final: Roteiro Final
               ipar3:p-ativo: Ativo
               ipar4:p-inativo: Inativo 
               ipar5:p-experimental: Experimental
      
------------------------------------------------------------------------------*/
/* ------------------------ PROXIES BO 1.1 ----------------------------- */
    
   def input parameter p-inicial      as char.
   def input parameter p-final        as char.
   def input parameter p-ativo        as char.
   def input parameter p-inativo      as char.
   def input parameter p-experimental as char.
    
    run setConstraintFiltroRoteiro(p-inicial,
                                   p-final,
                                   p-ativo,
                                   p-inativo,
                                   p-experimental).
    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE setConstraintFiltroRoteiro DBOProgram 
PROCEDURE setConstraintFiltroRoteiro :
/*------------------------------------------------------------------------------
  Purpose:     Seta as vari veis de controle para queries contendo
               o c¢digo inicial e final e as situa‡äes ativo, inativo
               e experimental.
  Parameters:  ipar1:p-inicial:Roteiro Inicial
               ipar2:p-final: Roteiro Final
               ipar3:p-ativo: Ativo
               ipar4:p-inativo: Inativo 
               ipar5:p-experimental: Experimental
------------------------------------------------------------------------------*/
   def input parameter p-inicial      as char.
   def input parameter p-final        as char.
   def input parameter p-ativo        as char.
   def input parameter p-inativo      as char.
   def input parameter p-experimental as char.

  
   assign c-inicial      = p-inicial.
   assign c-final        = p-final.
   assign l-ativo        = if p-ativo        = "yes" then YES else NO.
   assign l-inativo      = if p-inativo      = "yes" then YES else NO.
   assign l-experimental = if p-experimental = "yes" then YES else NO.
   
   
   RETURN "OK":U.
   
END PROCEDURE.

