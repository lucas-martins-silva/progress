&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no ¡ndice CLASS-FISCAL
  Parameters:
               recebe valor dos campos do ¡ndice CLASS-FISCAL
               retorna status do processo
  Notes:
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pclass-fiscal LIKE classif-fisc.class-fiscal NO-UNDO.

    FIND FIRST bfclassif-fisc WHERE
        bfclassif-fisc.class-fiscal = pclass-fiscal
        NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser  retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfclassif-fisc THEN
        RETURN "NOK":U.

    /*--- Reposiciona query atrav‚s de rowid e verifica a ocorrˆncia de erros, caso
          existam erros ser  retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfclassif-fisc)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryFaixaClassFisc DBOProgram 
PROCEDURE openQueryFaixaClassFisc :
/*------------------------------------------------------------------------------
  Purpose: 
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/

    OPEN QUERY {&QueryName} FOR EACH {&TableName}
                               WHERE {&TableName}.class-fiscal >= cClassFiscIni
                               AND   {&TableName}.class-fiscal <= cClassFiscFim NO-LOCK.

    RETURN "OK":U.
END PROCEDURE.

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryFaixaDescClassFisc DBOProgram 
PROCEDURE openQueryFaixaDescClassFisc :
/*------------------------------------------------------------------------------
  Purpose: 
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/

    OPEN QUERY {&QueryName} FOR EACH {&TableName}
                               WHERE {&TableName}.descricao >= cDescClassFiscIni
                                 AND {&TableName}.descricao <= cDescClassFiscFim  NO-LOCK
                                  BY {&TableName}.descricao.

    RETURN "OK":U.
END PROCEDURE.

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryMain DBOProgram 
PROCEDURE openQueryMain :
/*------------------------------------------------------------------------------
  Purpose:     Abertura da query principal do DBO
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH classif-fisc NO-LOCK INDEXED-REPOSITION.

    RETURN "OK":U.
END PROCEDURE.

