&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getDecField DBOProgram 
PROCEDURE getDecField :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valor de campos do tipo decimal
  Parameters:
               recebe nome do campo
               retorna valor do campo
               retorna status do processo
  Notes:
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pFieldName AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldValue AS DECIMAL NO-UNDO.

    /*--- Verifica se temptable RowObject est  dispon¡vel, caso nÆo esteja ser 
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN
        RETURN "NOK":U.

    CASE pFieldName:
        WHEN "cod-naladi-sh":U THEN ASSIGN pFieldValue = RowObject.cod-naladi-sh.
        WHEN "cod-ncm":U THEN ASSIGN pFieldValue = RowObject.cod-ncm.
        WHEN "dec-1":U THEN ASSIGN pFieldValue = RowObject.dec-1.
        WHEN "dec-2":U THEN ASSIGN pFieldValue = RowObject.dec-2.
        WHEN "aliquota-imp":U THEN ASSIGN pFieldValue = RowObject.aliquota-imp.
        WHEN "aliquota-ipi":U THEN ASSIGN pFieldValue = RowObject.aliquota-ipi.
        WHEN "cod-mercosul":U THEN ASSIGN pFieldValue = RowObject.cod-mercosul.
        WHEN "cod-naladi":U THEN ASSIGN pFieldValue = RowObject.cod-naladi.
        &If '{&BF_dis_VERSAO_EMS}' >= '2.062' &THEN
            WHEN "val-repas-max-comis":U THEN ASSIGN pFieldValue = RowObject.val-repas-max-comis.
        &endif
