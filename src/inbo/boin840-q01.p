&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryCodigo DBOProgram 
PROCEDURE openQueryCodigo :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    OPEN QUERY qr{&tableName} 
        FOR EACH {&tableName} NO-LOCK
           WHERE {&tableName}.cdn-fabrican >= i-cod-fabrican-ini 
             AND {&tableName}.cdn-fabrican <= i-cod-fabrican-fim     
             AND {&tableName}.cod-item = c-it-codigo
        BY {&tableName}.cdn-fabrican INDEXED-REPOSITION. 
        
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryMain DBOProgram 
PROCEDURE openQueryMain :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    OPEN QUERY qr{&tableName} 
      FOR EACH {&tableName} NO-LOCK
         WHERE {&tableName}.cdn-fabrican = fab-medic.cdn-fabrican
           AND {&tableName}.cod-item = c-it-codigo INDEXED-REPOSITION.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE setConstraintCodigo DBOProgram 
PROCEDURE setConstraintCodigo :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

def input parameter p-cod-fabrican-ini LIKE fab-medic.cdn-fabrican no-undo.
def input parameter p-cod-fabrican-fim LIKE fab-medic.cdn-fabrican no-undo.
DEF INPUT PARAMETER p-it-codigo        LIKE ITEM.it-codigo         NO-UNDO.

ASSIGN i-cod-fabrican-ini = p-cod-fabrican-ini
       i-cod-fabrican-fim = p-cod-fabrican-fim
       c-it-codigo        = p-it-codigo.

RETURN "OK":U.

END PROCEDURE.

