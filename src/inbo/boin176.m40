PROCEDURE validateOperTriang :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: Valida‡Æo dos dados referente a opera‡Æo triangular.
         - natur-oper   - natureza da nota fiscal
         - b-natur-oper - natureza de entrega
------------------------------------------------------------------------------*/

    def buffer b-natur-oper for natur-oper.
    def var l-erro-consist as logical no-undo.
    

    for first b-natur-oper
        fields ( nat-operacao     
                 terceiros       
                 tp-oper-terc )
        where b-natur-oper.nat-operacao = RowObject.nat-terc no-lock.
    end.
        

    if  not avail b-natur-oper then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-table.i mgind natur-oper 1} /* Busca o label da tabela */
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR" 
                            &ErrorParameters=TRIM(RETURN-VALUE)}
    end.
    

    if  avail b-natur-oper
    and not b-natur-oper.terceiros 
    or (    avail b-natur-oper
        and b-natur-oper.tp-oper-terc <> 1
        and b-natur-oper.tp-oper-terc <> 3) then do:
        {method/svc/errors/inserr.i
                            &ErrorNumber="19079" /*Natureza de Opera‡Æo de Entrega invÿlida*/
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"}
    end.

    assign l-erro-consist = no.
    if  avail b-natur-oper
    and avail natur-oper
    and RowObject.nat-terc <> natur-oper.nat-vinculada 
    and not natur-oper.terceiros then 
        assign l-erro-consist = yes.

    run beforeValidateBoin060 (input 1). /* Instancia */
    
    run updateConsistNota in h-boin060 ( RowObject.cod-emitente,
                                         RowObject.serie-docto,
                                         RowObject.nro-docto,
                                         RowObject.nat-operacao,
                                         RowObject.sequencia,
                                         (not l-erro-consist),
                                         0,
                                         0,
                                         19080, /*Nat. Oper. de entrega nÆo confere com Nat. Complementar*/
                                         2 ).
                                         
    run beforeValidateBoin060 (input 2). /* Elimina */

    /* Valida Emitente */
    run findEmitente ( RowObject.cod-emit-terc ).
    

    if  RowObject.cod-emit-terc = 0 then do:
        {method/svc/errors/inserr.i
                            &ErrorNumber="27334" /*Emitente de Entraga Inv lido*/ /*19079*/
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"}
    end.
        

    if  avail pedido-compr then do:

        assign l-erro-consist = no.
        if  RowObject.cod-emit-terc <> pedido-compr.cod-emit-terc then 
            assign l-erro-consist = yes.
        

        run beforeValidateBoin060 (input 1). /* Instancia */
        
        run updateConsistNota in h-boin060 ( RowObject.cod-emitente,
                                             RowObject.serie-docto,
                                             RowObject.nro-docto,
                                             RowObject.nat-operacao,
                                             RowObject.sequencia,
                                             (not l-erro-consist),
                                             0,
                                             0,
                                             19081, /*Emitente de entrega difere do emitente do pedido*/
                                             2 ).
                                             
        run beforeValidateBoin060 (input 2). /* Elimina */ 
    end.
    

    /* Valida S‚rie */
    if  not can-find(serie where serie.serie = RowObject.serie-terc) then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-table.i mgind serie 1} /* Busca o label da tabela */
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"
                            &ErrorParameters=TRIM(RETURN-VALUE)}
    end.
        

    /* Valida N£mero */
    if  RowObject.nro-docto-terc = "0000000" 
    or  RowObject.nro-docto-terc = "" then do:
        {method/svc/errors/inserr.i
                            &ErrorNumber="16686" /*N£mero do documento deve ser diferente de zero*/
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR" }
    end. 

    if  length(RowObject.nro-docto-terc) > length(c-formato) then do:
        {method/svc/errors/inserr.i
                            &ErrorNumber="36151" /*N£mero maior que o formato*/
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR" 
                            &ErrorParameters=length(c-formato)}
    end.     
   

    /* Valida Sequˆncia */
    if  RowObject.seq-terc = 0 then do:
        {method/svc/errors/inserr.i
                            &ErrorNumber="7781" /*Sequˆncia deve ser diferete de zero*/
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR" }
    end.     


    /* Verifica se jÿ existe saldo em poder de terceiros */
    for first componente
        fields ( cod-emitente  serie-docto
                 nro-docto     nat-operacao
                 sequencia     it-codigo
                 cod-refer     cod-localiz)
        where componente.cod-emitente = RowObject.cod-emit-terc
          and componente.serie-docto  = RowObject.serie-terc
          and componente.nro-docto    = RowObject.nro-docto-terc
          and componente.nat-operacao = RowObject.nat-terc
          and componente.sequencia    = RowObject.seq-terc
          and componente.it-codigo    = RowObject.it-codigo
          and componente.cod-refer    = RowObject.cod-refer no-lock:
    end.
    if  avail componente then do:                             
        /* Inicio -- Projeto Internacional */
        {utp/ut-table.i movind saldo-terc 1} /* Busca o label da tabela */
        {method/svc/errors/inserr.i
                            &ErrorNumber="1"
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"
                            &ErrorParameters=TRIM(RETURN-VALUE)}
    end.                            

    return "OK":U.            

END PROCEDURE.




