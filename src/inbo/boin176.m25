PROCEDURE createRatLoteDevolTerc :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: Criaªío do rat-lote (dados para baixa do estoque) para as nota de devoluªío      
         e terceiros dos itens controlados por lote e referºncia.
------------------------------------------------------------------------------*/   

    def input param piQtFaturada  like it-nota-fisc.qt-faturada[1] no-undo.

    def buffer bf-item-doc-est    for item-doc-est.
    def buffer b-rat-lote         for rat-lote.
        
    def var c-cod-depos           as char                          no-undo.
    def var de-qtd-saldo          like rat-lote.quantidade         no-undo.
    def var de-qtd-saldo-lote     like rat-lote.quantidade         no-undo.
    def var c-cod-estabel         like docum-est.cod-estabel       no-undo.
    def var l-configurado         as log                           no-undo.
    def var c-cod-localiz         like fat-ser-lote.cod-localiz    no-undo.

    if  not valid-handle(h-boin006) then 
        run inbo/boin006.p persistent set h-boin006.
    if  not valid-handle(h-boin367) then 
        run inbo/boin367.p persistent set h-boin367.
        
    run setConstraintOfDocumEst in h-boin367 (input RowObject.cod-emitente,
                                              input RowObject.serie-docto,  
                                              input RowObject.nro-docto,
                                              input RowObject.nat-operacao).

    run openQueryStatic in h-boin367 ( input "OfDocumEst").
    
    for each tt-rat-lote:
        delete tt-rat-lote.
    end.  

    assign de-qtd-saldo = RowObject.quantidade.

    run findNaturOper ( docum-est.nat-operacao ).

    if  not avail natur-oper then do:
        run eliminaHandle.
        RETURN "NOK":U.
    end.

    assign c-cod-estabel = if  natur-oper.transf 
                           then docum-est.estab-de-or
                           else docum-est.cod-estabel.
    
    if  (   item.politica = 5         /* Item Configurado */
         or item.politica = 6 )       /* Item Composto */ 
    and not RowObject.baixa-ce  then  /* Item Pai nao Baixa Estoque */
        assign l-configurado = yes.
		
	IF c-nom-prog-dpc-mg97  <> "" OR 
       c-nom-prog-appc-mg97 <> "" OR
       c-nom-prog-upc-mg97  <> "" THEN DO:
    
        FOR EACH tt-epc:
            DELETE tt-epc.
        END.
        
        create tt-epc.
        assign tt-epc.cod-event     = "TrataConfigurado"
               tt-epc.cod-parameter = "l-configurado"
               tt-epc.val-parameter = string(l-configurado).
    
        create tt-epc.
        assign tt-epc.cod-event     = "TrataConfigurado":U
               tt-epc.cod-parameter = "nro-docto":U
               tt-epc.val-parameter = STRING(rowObject.nro-docto).
    
        create tt-epc.
        assign tt-epc.cod-event     = "TrataConfigurado":U
               tt-epc.cod-parameter = "nat-operacao":U
               tt-epc.val-parameter = STRING(rowObject.nat-operacao).
    
        create tt-epc.
        assign tt-epc.cod-event     = "TrataConfigurado":U
               tt-epc.cod-parameter = "cod-emitente":U
               tt-epc.val-parameter = STRING(rowObject.cod-emitente).
    
        create tt-epc.
        assign tt-epc.cod-event     = "TrataConfigurado":U
               tt-epc.cod-parameter = "serie-docto":U
               tt-epc.val-parameter = STRING(rowObject.serie-docto).
    
        create tt-epc.
        assign tt-epc.cod-event     = "TrataConfigurado":U
               tt-epc.cod-parameter = "sequencia":U
               tt-epc.val-parameter = STRING(rowObject.sequencia).
               
        {include/i-epc201.i "TrataConfigurado"}
                             
         FIND FIRST tt-epc NO-LOCK 
              where tt-epc.cod-event     = "TrataConfigurado" 
                AND tt-epc.cod-parameter = "RetornoConfigurado" NO-ERROR.
         IF AVAIL tt-epc THEN DO:
            ASSIGN l-configurado = IF tt-epc.val-parameter = 'yes' 
                                     THEN YES
                                     ELSE NO.
         END.                                   
    END.
        
    if l-configurado then do:
        for first fat-ser-lote 
                fields ( cod-estabel serie nr-nota-fis nr-seq-fat it-codigo ) 
            where fat-ser-lote.cod-estabel = c-cod-estabel
              and fat-ser-lote.serie       = RowObject.serie-comp
              and fat-ser-lote.nr-nota-fis = RowObject.nro-comp         
              and fat-ser-lote.nr-seq-fat  = RowObject.seq-comp no-lock.
        end.
        
        if not item.fraciona and
           piQtFaturada <> RowObject.quantidade then do:
           
            /** Esta l¢gica foi inclu°da para que, na devoluá∆o parcial de item composto ou configurado que n∆o aceite quantidade
                fracionada, seja calculada a quantidade de cada item-filho a ser devolvida, de acordo com a NFS. **/
            for each fat-ser-lote
                fields ( cod-estabel serie nr-nota-fis 
                         nr-seq-fat it-codigo cod-depos 
                         cod-localiz nr-serlote qt-baixada[1] cod-refer)
                where fat-ser-lote.cod-estabel = c-cod-estabel
                  and fat-ser-lote.serie       = RowObject.serie-comp
                  and fat-ser-lote.nr-nota-fis = RowObject.nro-comp         
                  and fat-ser-lote.nr-seq-fat  = RowObject.seq-comp no-lock
               break by fat-ser-lote.it-codigo:
               
               /** A tt-rat-config Ç respons†vel por calcular proporcionalmente e armazenar o saldo a ser devolvido de cada item-filho, conforme a 
                   quantidade do item-pai faturada originalmente (piQtFaturada) e a quantidade a ser devolvida (RowObject.quantidade) **/ 
               find first tt-rat-config
                    where tt-rat-config.it-codigo = fat-ser-lote.it-codigo
                      and tt-rat-config.lote      = fat-ser-lote.nr-serlote
                      and tt-rat-config.cod-refer = fat-ser-lote.cod-refer
                      and tt-rat-config.sequencia = RowObject.sequencia no-error.
               if not avail tt-rat-config then do:
                   create tt-rat-config.
                   assign tt-rat-config.it-codigo    = fat-ser-lote.it-codigo
                          tt-rat-config.lote         = fat-ser-lote.nr-serlote     
                          tt-rat-config.cod-refer    = fat-ser-lote.cod-refer
                          tt-rat-config.sequencia    = RowObject.sequencia
                          tt-rat-config.de-qtd-saldo = fat-ser-lote.qt-baixada[1].
               end.
               else
                   assign tt-rat-config.de-qtd-saldo = tt-rat-config.de-qtd-saldo + fat-ser-lote.qt-baixada[1].
                   
               if last-of(fat-ser-lote.it-codigo) then
                   assign tt-rat-config.de-qtd-saldo = (tt-rat-config.de-qtd-saldo / piQtFaturada) 
                                                     * RowObject.quantidade
                          tt-rat-config.de-qtd-saldo = round(tt-rat-config.de-qtd-saldo, 0).
                          
            end.
        end.
    end.    
    else        
        for first fat-ser-lote 
                fields ( cod-estabel serie nr-nota-fis nr-seq-fat it-codigo ) 
            where fat-ser-lote.cod-estabel = c-cod-estabel
              and fat-ser-lote.serie       = RowObject.serie-comp
              and fat-ser-lote.nr-nota-fis = RowObject.nro-comp         
              and fat-ser-lote.nr-seq-fat  = RowObject.seq-comp
              and fat-ser-lote.it-codigo   = RowObject.it-codigo no-lock.
        end.

    if avail fat-ser-lote then do:
    
        if (item.tipo-con-est = 3 or item.tipo-con-est = 4) OR
            (item.tipo-con-est = 2 and natur-oper.tipo-compra = 3) /*n£mero de sÇrie e devoluá∆o de cliente*/
        AND not natur-oper.transf then do:
            run pi-calc-saldo-byLote (input c-cod-estabel).
        end. /*if (item.tipo-con-est = 3 or item.tipo-con-est = 4)*/
        
        for each fat-ser-lote
            fields ( cod-estabel serie nr-nota-fis 
                     nr-seq-fat it-codigo cod-depos 
                     cod-localiz nr-serlote qt-baixada[1] cod-refer)
            where fat-ser-lote.cod-estabel = c-cod-estabel
              and fat-ser-lote.serie       = RowObject.serie-comp
              and fat-ser-lote.nr-nota-fis = RowObject.nro-comp         
              and fat-ser-lote.nr-seq-fat  = RowObject.seq-comp no-lock
           break by fat-ser-lote.cod-depos:
                 
            IF CAN-FIND(FIRST ITEM WHERE 
                          ITEM.it-codigo    = fat-ser-lote.it-codigo AND 
                          ITEM.tipo-con-est = 2 AND /* Numero de SÇrie */
                          l-configurado) THEN DO:
                    IF CAN-FIND(FIRST saldo-estoq WHERE 
                                      saldo-estoq.it-codigo   = fat-ser-lote.it-codigo AND
                                      saldo-estoq.lote        = fat-ser-lote.nr-serlote AND
                                      saldo-estoq.qtidade-atu > 0) THEN
                        NEXT.
            END.
             
            if l-configurado then do:
                if item.fraciona then
                    assign de-qtd-saldo = ( fat-ser-lote.qt-baixada[1] / piQtFaturada ) 
                                        * RowObject.quantidade. 
                else do:
                    /** Quando a devoluá∆o for total, o programa simplesmente baixa a quantidade original da fat-ser-lote **/    
                    if piQtFaturada = RowObject.quantidade then   
                        assign de-qtd-saldo = fat-ser-lote.qt-baixada[1].
                    else do:
                        /** Quando a quantidade a ser devolvida do item-filho Ç maior do que a quantidade da nota de faturamento,
                            Ç baixada a quantidade referente Ö  fat-ser-lote.qt-baixada[1]. Se n∆o, a quantidade a ser baixada Ç a da
                            tt-rat-config.de-qtd-saldo. Dessa forma, a quantidade Ç baixada sequencialmente, ou seja, conforme a 
                            quantidade dispon°vel para o item de acordo com a NFS **/
                        find first tt-rat-config
                            where tt-rat-config.it-codigo = fat-ser-lote.it-codigo
                              and tt-rat-config.lote      = fat-ser-lote.nr-serlote
                              and tt-rat-config.cod-refer = fat-ser-lote.cod-refer
                              and tt-rat-config.sequencia = RowObject.sequencia no-error.
                        if avail tt-rat-config then
                            assign de-qtd-saldo               = if tt-rat-config.de-qtd-saldo <= fat-ser-lote.qt-baixada[1] then
                                                                    tt-rat-config.de-qtd-saldo
                                                                else 
                                                                    fat-ser-lote.qt-baixada[1]
                                   tt-rat-config.de-qtd-saldo = tt-rat-config.de-qtd-saldo - de-qtd-saldo.
                    end.
                    
                    if de-qtd-saldo = 0 then
                        next.    
                end.        
            end.                                                        
            
            if not l-configurado 
            and fat-ser-lote.it-codigo <> RowObject.it-codigo then  /* se o item nao e configurado o codigo deve ser igual */
                next.
                        
            if  CAN-FIND(FIRST ITEM 
                         WHERE ITEM.it-codigo    = fat-ser-lote.it-codigo 
                           AND ITEM.tipo-con-est = 2) /* Numero de SÇrie */ then do:
                 for first saldo-estoq fields (it-codigo lote qtidade-atu dt-fabric)
                     where saldo-estoq.it-codigo = fat-ser-lote.it-codigo
                       and saldo-estoq.lote      = fat-ser-lote.nr-serlote 
                       and saldo-estoq.qtidade-atu > 0 no-lock:
                 end.
                 if avail saldo-estoq then /* item controlado por nro de serie */
                     next.
            end.
            else do:  
                if natur-oper.transf = no then do: /*operaá∆o transferencia*/
                        assign c-cod-estabel = docum-est.cod-estabel.
                end.
                else do:
                        assign c-cod-estabel = fat-ser-lote.cod-estabel.  
                end.
                
                for first saldo-estoq 
                    where saldo-estoq.it-codigo   = fat-ser-lote.it-codigo
                      and saldo-estoq.lote        = fat-ser-lote.nr-serlote 
                      and saldo-estoq.cod-estabel = c-cod-estabel no-lock:
                end.                
           
            end.

            assign de-qtd-saldo-lote = de-qtd-saldo. /* inicia com saldo total para itens que nao possuem controle por Lote */
            
            if (  (item.tipo-con-est = 2 and natur-oper.tipo-compra = 3) /*n£mero de sÇrie e devoluá∆o de cliente*/
                or item.tipo-con-est = 3
                or item.tipo-con-est = 4)
            AND not natur-oper.transf then do:
                assign de-qtd-saldo-lote = 0.
                find first tt-saldo-lote no-lock
                     where tt-saldo-lote.it-codigo   = fat-ser-lote.it-codigo
                       and tt-saldo-lote.lote        = fat-ser-lote.nr-serlote
                       and tt-saldo-lote.cod-localiz = fat-ser-lote.cod-localiz
                       and tt-saldo-lote.cod-depos   = fat-ser-lote.cod-depos no-error.
                if avail tt-saldo-lote then
                    assign de-qtd-saldo-lote = tt-saldo-lote.quantidade.

                if de-qtd-saldo-lote <= 0 then
                    next.
                else
                    if de-qtd-saldo-lote > de-qtd-saldo then
                        assign de-qtd-saldo-lote = de-qtd-saldo.
            end.

            empty temp-table tt-rat-lote. /* Elimina registro tabela temporaria */

            /* Verifica se foi informado Deposito, se eh Transferencia e eh Documento do conversor NF-e */
            IF RowObject.cod-depos <> "" AND
               natur-oper.transf AND
               CAN-FIND(FIRST doc-orig-nfe WHERE doc-orig-nfe.ch-acesso-comp-nfe = TRIM(docum-est.cod-chave-aces-nf-eletro)
                                             AND doc-orig-nfe.idi-orig-trad      = 2) THEN
                assign c-cod-depos   = RowObject.cod-depos
                       c-cod-localiz = RowObject.cod-localiz.
            ELSE
                assign c-cod-depos   = if  RowObject.cod-depos <> " " and not natur-oper.transf /* transferencia*/
                                       then RowObject.cod-depos       /* Deposito para devolucao */
                                       else fat-ser-lote.cod-depos
                       c-cod-localiz = fat-ser-lote.cod-localiz /* Localizaá∆o informada na NFS */ .

            /* Busca a rat-lote para o dep¢sito encontrado acima e localizaá∆o da NFS */
            find rat-lote {cdp/cd8900.i rat-lote RowObject} 
                 and rat-lote.sequencia   = RowObject.sequencia
                 and rat-lote.it-codigo   = fat-ser-lote.it-codigo
                 and rat-lote.cod-depos   = c-cod-depos
                 and rat-lote.cod-localiz = c-cod-localiz
                 and rat-lote.lote        = fat-ser-lote.nr-serlote
                 AND rat-lote.cod-refer   = fat-ser-lote.cod-refer exclusive-lock no-error.
            if  not avail rat-lote then do:
                /* Esta l¢gica foi inclu°da para que, quando a localizacao da NFS n∆o exista para o dep¢sito
                   informado na devoluá∆o, e isso aconteáa para mais de um registro, as quantidades sejam
                   somadas para o mesmo item e apenas 1 registro seja criado na rat-lote */            

                IF  NOT l-devolucao
                AND NOT l-retorno THEN DO:
                    /* Se n∆o encontra, sugere o dep¢sito e localizacao da item-uni-estab */
                    run sugereItemUniEstab (input docum-est.cod-estabel,
                                            input fat-ser-lote.it-codigo,
                                            input-output c-cod-depos,
                                            input-output c-cod-localiz).    

                    /* Busca novamente a rat-lote, mas agora para o dep¢sito e localizaá∆o sugeridos na item-uni-estab */
                    find rat-lote {cdp/cd8900.i rat-lote RowObject}
                         and rat-lote.sequencia   = RowObject.sequencia
                         and rat-lote.it-codigo   = fat-ser-lote.it-codigo
                         and rat-lote.cod-depos   = c-cod-depos
                         and rat-lote.cod-localiz = c-cod-localiz
                         and rat-lote.lote        = fat-ser-lote.nr-serlote 
                         AND rat-lote.cod-refer   = fat-ser-lote.cod-refer exclusive-lock no-error.                            
                END.
            end.
            
            IF c-nom-prog-dpc-mg97  <> "" OR 
               c-nom-prog-appc-mg97 <> "" OR
               c-nom-prog-upc-mg97  <> "" THEN DO:
              
                FOR EACH tt-epc:
                    DELETE tt-epc.
                END.
                 
                create tt-epc.
                assign tt-epc.cod-event     = "AlteraQuantidade":U
                       tt-epc.cod-parameter = "rowid-fat-ser-lote":U
                       tt-epc.val-parameter = STRING(ROWID(fat-ser-lote)). 
                
                create tt-epc.
                assign tt-epc.cod-event     = "AlteraQuantidade":U
                       tt-epc.cod-parameter = "qtd-recebida":U
                       tt-epc.val-parameter = STRING(RowObject.quantidade).
                
                create tt-epc.
                assign tt-epc.cod-event     = "AlteraQuantidade":U
                       tt-epc.cod-parameter = "nro-docto":U
                       tt-epc.val-parameter = STRING(rowObject.nro-docto).
                
                create tt-epc.
                assign tt-epc.cod-event     = "AlteraQuantidade":U
                       tt-epc.cod-parameter = "nat-operacao":U
                       tt-epc.val-parameter = STRING(rowObject.nat-operacao).
                
                create tt-epc.
                assign tt-epc.cod-event     = "AlteraQuantidade":U
                       tt-epc.cod-parameter = "cod-emitente":U
                       tt-epc.val-parameter = STRING(rowObject.cod-emitente).
                
                create tt-epc.
                assign tt-epc.cod-event     = "AlteraQuantidade":U
                       tt-epc.cod-parameter = "serie-docto":U
                       tt-epc.val-parameter = STRING(rowObject.serie-docto).
                
                create tt-epc.
                assign tt-epc.cod-event     = "AlteraQuantidade":U
                       tt-epc.cod-parameter = "sequencia":U
                       tt-epc.val-parameter = STRING(rowObject.sequencia).
		        
                {include/i-epc201.i "AlteraQuantidade"}
	            
                FIND FIRST tt-epc NO-LOCK 
                     where tt-epc.cod-event     = "AlteraQuantidade" 
                       AND tt-epc.cod-parameter = "QtdAlterada" NO-ERROR.
                IF AVAIL tt-epc THEN DO:
                   ASSIGN de-qtd-saldo-lote = DEC(tt-epc.val-parameter)
                          de-qtd-saldo      = DEC(tt-epc.val-parameter).    
                END.  
            end.                    		
            if  not avail rat-lote then do:
                create tt-rat-lote.
                assign tt-rat-lote.serie-docto      = RowObject.serie-docto 
                       tt-rat-lote.nro-docto        = RowObject.nro-docto 
                       tt-rat-lote.nat-operacao     = RowObject.nat-operacao 
                       tt-rat-lote.cod-emitente     = RowObject.cod-emitente
                       tt-rat-lote.sequencia        = RowObject.sequencia 
                       tt-rat-lote.cod-refer        = fat-ser-lote.cod-refer
                       tt-rat-lote.it-codigo        = fat-ser-lote.it-codigo 
                       tt-rat-lote.cod-depos        = c-cod-depos
                       tt-rat-lote.cod-localiz      = c-cod-localiz
                       tt-rat-lote.lote             = fat-ser-lote.nr-serlote
                       tt-rat-lote.dt-vali-lote     = if  avail saldo-estoq
                                                      then saldo-estoq.dt-vali-lote
                                                      else ?
                       tt-rat-lote.dat-fabricc-lote = if  avail saldo-estoq
                                                      then saldo-estoq.dt-fabric
                                                      else docum-est.dt-trans
                       tt-rat-lote.quantidade       = if  de-qtd-saldo-lote < fat-ser-lote.qt-baixada[1]
                                                      then de-qtd-saldo-lote
                                                      else fat-ser-lote.qt-baixada[1].
                                                      

                &IF DEFINED(bf_man_per_ppm) &THEN
                    ASSIGN tt-rat-lote.per-ppm = e-per-ppm.
                &ENDIF
                    
                if l-configurado then   /* Ivomar */
                    assign tt-rat-lote.cod-refer  = fat-ser-lote.cod-refer.

                run setExecutaEngine in h-boin367 (input (RowObject.cod-depos = "" or l-executa-engine)).

                run setRecord      in h-boin367 ( input table tt-rat-lote ).
                run getFieldsItem  in h-boin367 ( RowObject.baixa-ce,
                                                  RowObject.quantidade ).

                run emptyRowErrors in h-boin367.
                run createRecord   in h-boin367. /* Cria tabela rat-lote */


                run getRowErrors in h-boin367 ( output table tt-RowErrorsAux ).
            

                FOR EACH tt-RowErrorsAux NO-LOCK:
                    CREATE RowErrors.
                    BUFFER-COPY tt-RowErrorsAux TO RowErrors.
                END.

                find first rowErrors no-lock no-error.
                if  avail rowErrors and
                    rowErrors.ErrorSubType = "ERROR":U then do:
                    run eliminaHandle.
                    return "NOK":U.
                end.    

            end.
            else
                /* Quando o rat-lote estiver criado apenas soma a quantidade */
                assign rat-lote.quantidade = rat-lote.quantidade
                                           + if  de-qtd-saldo-lote < fat-ser-lote.qt-baixada[1]
                                             then de-qtd-saldo-lote
                                             else fat-ser-lote.qt-baixada[1].
          	
		   find first bf-saldo-terc 
				where bf-saldo-terc.cod-emitente = RowObject.cod-emitente
				  and bf-saldo-terc.nro-docto    = RowObject.nro-comp
				  and bf-saldo-terc.serie-docto  = RowObject.serie-comp
				  and bf-saldo-terc.nat-operacao = RowObject.nat-comp
				  and bf-saldo-terc.it-codigo    = RowObject.it-codigo
				  and bf-saldo-terc.cod-refer    = RowObject.cod-refer
				  and bf-saldo-terc.sequencia    = RowObject.seq-comp
					 no-lock no-error.       

            if avail bf-saldo-terc  then            
                 run updateQtdAloc in h-boin006 ( RowObject.serie-comp ,  
                                                  RowObject.nro-comp,  
                                                  RowObject.nat-comp /* "211CEF" */ ,  
                                                  RowObject.seq-comp,
                                                  RowObject.cod-emitente,
                                                  fat-ser-lote.it-codigo, 
                                                  fat-ser-lote.cod-refer, 
                                                  fat-ser-lote.nr-serlote, 
                                                  "aloca",
                                                  if  de-qtd-saldo < fat-ser-lote.qt-baixada[1]
                                                      then de-qtd-saldo
                                                      else fat-ser-lote.qt-baixada[1] ).
                                                      
            else do:            

                FOR FIRST nota-fiscal
                    WHERE nota-fiscal.nr-nota-fis  = item-doc-est.nro-comp
                       AND nota-fiscal.serie       = item-doc-est.serie-comp 
                       AND nota-fiscal.cod-estabel = docum-est.cod-estabel NO-LOCK:
                       
                       
                       for first bf-natur-oper-aux where bf-natur-oper-aux.nat-operacao = nota-fiscal.nat-operacao: end.
            
			

                        run updateQtdAloc in h-boin006 (  RowObject.serie-comp ,  
                                                          RowObject.nro-comp,  
                                                          bf-natur-oper-aux.nat-comp  /* "211CEF" */ ,  
                                                          RowObject.seq-comp,
                                                          RowObject.cod-emitente,
                                                          fat-ser-lote.it-codigo, 
                                                          fat-ser-lote.cod-refer, 
                                                          fat-ser-lote.nr-serlote, 
                                                          "aloca",
                                                          if  de-qtd-saldo < fat-ser-lote.qt-baixada[1]
                                                              then de-qtd-saldo
                                                              else fat-ser-lote.qt-baixada[1] ).                        
                        
                    
                END. 
		
			end.
            if not l-configurado then  /* Item Pai Baixa Estoque */
            do:
                assign de-qtd-saldo = de-qtd-saldo 
                                    - if  not avail rat-lote 
                                      then tt-rat-lote.quantidade 
                                      else fat-ser-lote.qt-baixada[1].
               

                if  de-qtd-saldo <= 0 then
                    leave.
            end.
        end.
    end.
    else do:
        if item.tipo-con-est = 3
        or item.tipo-con-est = 4 then
            find first bf-item-doc-est no-lock
                where bf-item-doc-est.cod-emit-terc  = RowObject.cod-emitente
                  and bf-item-doc-est.serie-terc     = RowObject.serie-comp  
                  and bf-item-doc-est.nro-docto-terc = RowObject.nro-comp    
                  and bf-item-doc-est.nat-terc       = RowObject.nat-comp    
                  and bf-item-doc-est.seq-terc       = RowObject.seq-comp 
                  and bf-item-doc-est.it-codigo      = RowObject.it-codigo
                  and bf-item-doc-est.cod-refer      = RowObject.cod-refer
                  and bf-item-doc-est.baixa-ce no-error.
        else
            for first rat-lote 
                fields ( cod-emitente serie-docto nro-docto
                         nat-operacao  sequencia it-codigo 
                         quantidade cod-depos cod-localiz 
                         lote dt-vali-lote dat-fabricc-lote cod-refer) 
                where rat-lote.cod-emitente = RowObject.cod-emitente
                  and rat-lote.serie-docto  = RowObject.serie-comp
                  and rat-lote.nro-docto    = RowObject.nro-comp        
                  and rat-lote.nat-operacao = RowObject.nat-comp
                  and rat-lote.sequencia    = RowObject.seq-comp no-lock: end. 
        
        if avail bf-item-doc-est 
        or avail rat-lote then do:
            for each rat-lote 
                fields ( cod-emitente serie-docto nro-docto 
                         nat-operacao sequencia it-codigo 
                         quantidade cod-depos cod-localiz 
                         lote dt-vali-lote dat-fabricc-lote cod-refer) 
                where rat-lote.cod-emitente = (if avail bf-item-doc-est then bf-item-doc-est.cod-emitente else RowObject.cod-emitente)
                  and rat-lote.serie-docto  = (if avail bf-item-doc-est then bf-item-doc-est.serie-docto  else RowObject.serie-docto)
                  and rat-lote.nat-operacao = (if avail bf-item-doc-est then bf-item-doc-est.nat-operacao else RowObject.nat-operacao)
                  and rat-lote.nro-docto    = (if avail bf-item-doc-est then bf-item-doc-est.nro-docto    else RowObject.nro-docto)
                  and rat-lote.sequencia    = (if avail bf-item-doc-est then bf-item-doc-est.sequencia    else RowObject.sequencia) no-lock:
        
                empty temp-table tt-rat-lote. /* Elimina registro tabela temporaria */
                
                assign c-cod-depos = if  RowObject.cod-depos <> " "
                                     then RowObject.cod-depos       /* Deposito retorno terceiros */
                                     else rat-lote.cod-depos
                        c-cod-localiz = rat-lote.cod-localiz.
                
                find first b-rat-lote {cdp/cd8900.i b-rat-lote RowObject }
                     and b-rat-lote.sequencia   = RowObject.sequencia
                     and b-rat-lote.it-codigo   = rat-lote.it-codigo
                     and b-rat-lote.cod-depos   = c-cod-depos
                     and b-rat-lote.cod-localiz = rat-lote.cod-localiz
                     and b-rat-lote.lote        = rat-lote.lote exclusive-lock no-error.
                if  not avail b-rat-lote then do:
                
                    run sugereItemUniEstab (input docum-est.cod-estabel,
                                            input rowObject.it-codigo,
                                            input-output c-cod-depos,
                                            input-output c-cod-localiz).
                                            
                    create tt-rat-lote.
                    assign tt-rat-lote.cod-emitente     = RowObject.cod-emitente
                           tt-rat-lote.serie-docto      = RowObject.serie-docto 
                           tt-rat-lote.nro-docto        = RowObject.nro-docto 
                           tt-rat-lote.nat-operacao     = RowObject.nat-operacao 
                           tt-rat-lote.sequencia        = RowObject.sequencia 
                           tt-rat-lote.it-codigo        = rat-lote.it-codigo
                           tt-rat-lote.cod-depos        = c-cod-depos
                           tt-rat-lote.cod-localiz      = c-cod-localiz
                           tt-rat-lote.lote             = rat-lote.lote
                           tt-rat-lote.dt-vali-lote     = rat-lote.dt-vali-lote
                           tt-rat-lote.dat-fabricc-lote = rat-lote.dat-fabricc-lote 
                           tt-rat-lote.quantidade       = if  rat-lote.quantidade > de-qtd-saldo 
                                                          then de-qtd-saldo
                                                          else rat-lote.quantidade.
                                                      
                    &IF DEFINED(bf_man_per_ppm) &THEN
                        ASSIGN tt-rat-lote.per-ppm = e-per-ppm.
                    &ENDIF
                     
                    run setRecord      in h-boin367 ( input table tt-rat-lote ).
                    run getFieldsItem  in h-boin367 ( RowObject.baixa-ce,
                                                      RowObject.quantidade ).

                    run setExecutaEngine in h-boin367 (input (RowObject.cod-depos = "" or l-executa-engine)).

                    run emptyRowErrors in h-boin367.
                    run createRecord   in h-boin367. /* Cria tabela rat-lote */
                
                    run getRowErrors in h-boin367 ( output table tt-RowErrorsAux ).
                    
                    FOR EACH tt-RowErrorsAux NO-LOCK:
                        CREATE RowErrors.
                        BUFFER-COPY tt-RowErrorsAux TO RowErrors.
                    END.
                    
                    find first rowErrors no-lock no-error.
                    if  avail rowErrors and
                        rowErrors.ErrorSubType = "ERROR":U then do:
                        run eliminaHandle.
                        return "NOK":U.
                    end.    
                end.                
                else /* Quando o rat-lote estiver criado apenas soma a quantidade */
                    assign b-rat-lote.quantidade = b-rat-lote.quantidade
                                                 + if  rat-lote.quantidade > de-qtd-saldo 
                                                   then de-qtd-saldo
                                                   else rat-lote.quantidade.                                                   
                
                run updateQtdAloc in h-boin006 ( RowObject.serie-comp,  
                                                 RowObject.nro-comp,  
                                                 RowObject.nat-comp,  
                                                 RowObject.seq-comp,
                                                 RowObject.cod-emitente,
                                                 RowObject.it-codigo, 
                                                 rat-lote.cod-refer, 
                                                 rat-lote.lote, 
                                                 "aloca",
                                                 if  rat-lote.quantidade > de-qtd-saldo 
                                                 then de-qtd-saldo
                                                 else rat-lote.quantidade ).

                if  rat-lote.quantidade > de-qtd-saldo then do:
                    assign de-qtd-saldo = 0.
                    leave.
                end.
                else 
                    assign de-qtd-saldo = de-qtd-saldo - rat-lote.quantidade.
            end.
        end.
        else /* Quando saldo-terc foi implantado manualmente */
            if  avail saldo-terc then do:
                for first saldo-estoq       
                    fields ( it-codigo lote dt-vali-lote dt-fabric)
                    where saldo-estoq.it-codigo = saldo-terc.it-codigo
                      and saldo-estoq.lote      = saldo-terc.lote no-lock.
                end.
                
        
                empty temp-table tt-rat-lote. /* Elimina registro tabela temporaria */
        
        
                assign c-cod-depos = if  RowObject.cod-depos <> " "
                                     then RowObject.cod-depos       /* Deposito para devolucao */
                                     else componente.cod-depos
                       c-cod-localiz = saldo-terc.cod-localiz.
        
                find rat-lote {cdp/cd8900.i rat-lote RowObject}
                     and rat-lote.sequencia   = RowObject.sequencia
                     and rat-lote.it-codigo   = RowObject.it-codigo
                     and rat-lote.cod-depos   = c-cod-depos
                     and rat-lote.cod-localiz = saldo-terc.cod-localiz
                     and rat-lote.lote        = saldo-terc.lote exclusive-lock no-error.
                
        
                if  not avail rat-lote then do:
                    run sugereItemUniEstab (input docum-est.cod-estabel,
                                            input rowObject.it-codigo,
                                            input-output c-cod-depos,
                                            input-output c-cod-localiz).
                    create tt-rat-lote.
                    assign tt-rat-lote.serie-docto      = RowObject.serie-docto 
                           tt-rat-lote.nro-docto        = RowObject.nro-docto 
                           tt-rat-lote.nat-operacao     = RowObject.nat-operacao 
                           tt-rat-lote.cod-emitente     = RowObject.cod-emitente
                           tt-rat-lote.sequencia        = RowObject.sequencia 
                                                        
                                                        
                           tt-rat-lote.it-codigo        = RowObject.it-codigo 
                           tt-rat-lote.cod-depos        = c-cod-depos
                           tt-rat-lote.cod-localiz      = c-cod-localiz
                           tt-rat-lote.lote             = saldo-terc.lote
                           tt-rat-lote.dt-vali-lote     = if  avail saldo-estoq
                                                          then saldo-estoq.dt-vali-lote
                                                          else if  avail componente
                                                               then componente.dt-vali-lote   
                                                               else ?
                           tt-rat-lote.dat-fabricc-lote = if  avail saldo-estoq
                                                          then saldo-estoq.dt-fabric
                                                          else  docum-est.dt-trans
                           tt-rat-lote.quantidade       = RowObject.quantidade.
                        &IF DEFINED(bf_man_per_ppm) &THEN
                            ASSIGN tt-rat-lote.per-ppm = e-per-ppm.
                        &ENDIF
                    
        
                    run setRecord      in h-boin367 ( input table tt-rat-lote ).
                    run getFieldsItem  in h-boin367 ( RowObject.baixa-ce,
                                                      RowObject.quantidade ).

                    run setExecutaEngine in h-boin367 (input (RowObject.cod-depos = "" or l-executa-engine)).

                    run emptyRowErrors in h-boin367.
                    run createRecord   in h-boin367. /* Cria tabela rat-lote */
                    
        
                    run getRowErrors in h-boin367 ( output table tt-RowErrorsAux ).
                    FOR EACH tt-RowErrorsAux NO-LOCK:
                        CREATE RowErrors.
                        BUFFER-COPY tt-RowErrorsAux TO RowErrors.
                    END.
                    
        
                    find first rowErrors no-lock no-error.
                    if  avail rowErrors and
                        rowErrors.ErrorSubType = "ERROR":U then do:
                        run eliminaHandle.
                        return "NOK":U.
                    end.

                end.
                else
                    /* Quando o rat-lote estiver criado apenas substitui a quantidade */
                    assign rat-lote.quantidade = RowObject.quantidade.
                   
              
                run updateQtdAloc in h-boin006 ( RowObject.serie-comp ,  
                                                 RowObject.nro-comp,  
                                                 RowObject.nat-comp,  
                                                 RowObject.seq-comp,
                                                 RowObject.cod-emitente,
                                                 RowObject.it-codigo, 
                                                 saldo-terc.cod-refer,
                                                 saldo-terc.lote, 
                                                 "aloca",
                                                 RowObject.quantidade ).
            end.        
    end.
    
    empty temp-table tt-saldo-lote.

    run eliminaHandle.

    return "OK":U.

END PROCEDURE.

PROCEDURE eliminaHandle:
    
    if valid-handle(h-boin367) then do:
       RUN beforeDestroy IN h-boin367.
       delete procedure  h-boin367.
       assign h-boin367 = ?.                
    end.
    IF VALID-HANDLE(h-boin006) THEN DO:
        DELETE PROCEDURE h-boin006.
        ASSIGN h-boin006 = ?.
    END.
    IF VALID-HANDLE(h-boin010) THEN DO:
        DELETE PROCEDURE h-boin010.
        ASSIGN h-boin010 = ?.
    END.
    
END PROCEDURE.

 
procedure pi-calc-saldo-byLote:

    def input param p-cod-estabel like docum-est.cod-estabel no-undo.

    for each fat-ser-lote
       where fat-ser-lote.cod-estabel = p-cod-estabel
         and fat-ser-lote.serie       = RowObject.serie-comp
         and fat-ser-lote.nr-nota-fis = RowObject.nro-comp         
         and fat-ser-lote.nr-seq-fat  = RowObject.seq-comp no-lock:
        create tt-saldo-lote.
        assign tt-saldo-lote.it-codigo    = fat-ser-lote.it-codigo
               tt-saldo-lote.lote         = fat-ser-lote.nr-serlote
               tt-saldo-lote.cod-localiz  = fat-ser-lote.cod-localiz
               tt-saldo-lote.cod-depos    = fat-ser-lote.cod-depos
               tt-saldo-lote.quantidade   = fat-ser-lote.qt-baixada[1].  
    end. /*for each fat-ser-lote*/
    
    FOR EACH bf-item-doc-est no-lock
       where bf-item-doc-est.cod-emitente   = RowObject.cod-emitente
         and bf-item-doc-est.serie-comp     = RowObject.serie-comp
         and bf-item-doc-est.nro-comp       = RowObject.nro-comp 
         and bf-item-doc-est.nat-comp       = RowObject.nat-comp                    
         and bf-item-doc-est.seq-comp       = RowObject.seq-comp 
         and bf-item-doc-est.it-codigo      = RowObject.it-codigo:

        EMPTY TEMP-TABLE tt-saldo-lote-rec.

        for each rat-lote 
           where rat-lote.cod-emitente = bf-item-doc-est.cod-emitente
             and rat-lote.serie-docto  = bf-item-doc-est.serie-docto 
             and rat-lote.nat-operacao = bf-item-doc-est.nat-operacao
             and rat-lote.nro-docto    = bf-item-doc-est.nro-docto   
             and rat-lote.sequencia    = bf-item-doc-est.sequencia no-lock:

            find first tt-saldo-lote-rec 
                 WHERE tt-saldo-lote-rec.it-codigo    = rat-lote.it-codigo
                   AND tt-saldo-lote-rec.lote         = rat-lote.lote 
                   AND tt-saldo-lote-rec.cod-localiz  = rat-lote.cod-localiz
                   AND tt-saldo-lote-rec.cod-depos    = rat-lote.cod-depos NO-LOCK NO-ERROR.
            IF NOT AVAIL tt-saldo-lote-rec THEN DO:
                CREATE tt-saldo-lote-rec.
                ASSIGN tt-saldo-lote-rec.it-codigo    = rat-lote.it-codigo    
                       tt-saldo-lote-rec.lote         = rat-lote.lote   
                       tt-saldo-lote-rec.cod-localiz  = rat-lote.cod-localiz  
                       tt-saldo-lote-rec.cod-depos    = rat-lote.cod-depos    
                       tt-saldo-lote-rec.quantidade   = rat-lote.quantidade.
            END.
        END. /*for each rat-lote*/

        FOR EACH tt-saldo-lote-rec NO-LOCK:
             FIND FIRST tt-saldo-lote NO-LOCK
                  WHERE tt-saldo-lote.it-codigo    = tt-saldo-lote-rec.it-codigo
                    AND tt-saldo-lote.lote         = tt-saldo-lote-rec.lote 
                    AND tt-saldo-lote.cod-localiz  = tt-saldo-lote-rec.cod-localiz
                    AND tt-saldo-lote.cod-depos    = tt-saldo-lote-rec.cod-depos
                    and tt-saldo-lote.quantidade  >= tt-saldo-lote-rec.quantidade NO-ERROR.
             IF AVAIL tt-saldo-lote THEN DO: 
                 IF tt-saldo-lote.quantidade >= tt-saldo-lote-rec.quantidade then
                     assign de-qtd-aux                   = tt-saldo-lote.quantidade
                            tt-saldo-lote.quantidade     = tt-saldo-lote.quantidade - tt-saldo-lote-rec.quantidade
                            tt-saldo-lote-rec.quantidade = tt-saldo-lote-rec.quantidade - de-qtd-aux.
                 else
                     assign tt-saldo-lote-rec.quantidade = tt-saldo-lote-rec.quantidade - tt-saldo-lote.quantidade
                            tt-saldo-lote.quantidade = 0.
             END.
             ELSE DO:
                 FOR EACH tt-saldo-lote NO-LOCK
                      WHERE tt-saldo-lote.it-codigo = tt-saldo-lote-rec.it-codigo
                        AND tt-saldo-lote.lote      = tt-saldo-lote-rec.lote :
                     IF tt-saldo-lote.quantidade >= tt-saldo-lote-rec.quantidade then
                         assign de-qtd-aux                   = tt-saldo-lote.quantidade
                                tt-saldo-lote.quantidade     = tt-saldo-lote.quantidade - tt-saldo-lote-rec.quantidade
                                tt-saldo-lote-rec.quantidade = tt-saldo-lote-rec.quantidade - de-qtd-aux.
                     else
                         assign tt-saldo-lote-rec.quantidade = tt-saldo-lote-rec.quantidade - tt-saldo-lote.quantidade
                                tt-saldo-lote.quantidade = 0.
                 END.
             END.
        END. /*FOR EACH tt-saldo-lote-rec*/
    END. /*FOR EACH bf-item-doc-est*/

end procedure.

PROCEDURE setExecutaEngine:
    DEFINE INPUT PARAMETER pl-executa-engine AS LOG NO-UNDO.

    ASSIGN l-executa-engine = pl-executa-engine.

    RETURN "OK":U.

END PROCEDURE.
