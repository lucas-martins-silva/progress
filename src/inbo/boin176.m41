PROCEDURE validateOrdProd :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: Validaá∆o da ordem de produá∆o      
------------------------------------------------------------------------------*/

    def var de-qtd-max like item-doc-est.quantidade no-undo.
    def var c-texto-msg-1 as char no-undo.
    def var c-texto-msg-2 as char no-undo.
    
    if not valid-handle(h-cpapi029) then
        run cpp/cpapi029.p persistent set h-cpapi029.
        
    run findOrdProd ( RowObject.nr-ord-produ ).

    if  avail ord-prod then do:
        if ord-prod.cod-estabel <> docum-est.cod-estabel then do:
            {method/svc/errors/inserr.i
                                &ErrorNumber="15189" /*Ordem de produá∆o n∆o pertence ao estabelecimento da nota*/
                                &ErrorType="EMS"
                                &ErrorSubType="ERROR"}
        end.
 
        if  avail item and item.tipo-requis = 2 then do:
            {method/svc/errors/inserr.i
                                &ErrorNumber="26798" /*Item possui tipo de requisiá∆o por transferància*/
                                &ErrorType="EMS"
                                &ErrorSubType="WARNING"}
        end.
 
        if  param-global.modulo-mi then do:
            &IF DEFINED (bf_mnt_ems208) &THEN
            for first ord-manut
                fields ( nr-ord-produ
                         estado   
                         estado-om
                         tipo 
                         tp-manut)
            &ELSE
            for first ord-manut
                fields ( nr-ord-produ
                         estado   
                         estado-om
                         tipo 
                         dec-1)
            &ENDIF
                where ord-manut.nr-ord-produ = RowObject.nr-ord-produ no-lock.
            end.

            if  avail ord-manut then do:
                if  ord-manut.estado-om = 3 then do:
                    {method/svc/errors/inserr.i
                                        &ErrorNumber="30665" /*Ordem de manutená∆o suspensa*/
                                        &ErrorType="EMS"
                                        &ErrorSubType="WARNING"}
                end.

                if  ord-manut.estado-om = 4 then do:
                    if  ord-manut.estado = 8 then do:
                        {method/svc/errors/inserr.i
                                            &ErrorNumber="52171" /*Ordem de manutená∆o terminada*/
                                            &ErrorType="EMS"
                                            &ErrorSubType="ERROR"
                                            &ErrorParameters="ord-manut.nr-ord-produ"}
                    end.            

                    if  ord-manut.estado = 7 then do:
                        IF can-find(first funcao 
                                    where funcao.cd-funcao = "spp-ativa-ordem-term":U /*Existe uma funá∆o que permite requisitar para ordens finalizadas*/
                                    and  funcao.ativo no-lock) then do:
                            {method/svc/errors/inserr.i
                                                &ErrorNumber="18803" /*Ordem de manutená∆o finalizada.*/
                                                &ErrorType="EMS"
                                                &ErrorSubType="WARNING"}                                    
                                                            
                        end.
                        else do:
                            {method/svc/errors/inserr.i
                                                &ErrorNumber="26831" /*Ordem de manutená∆o finalizada.*/
                                                &ErrorType="EMS"
                                                &ErrorSubType="ERROR"}
                        end.
                    end.
                end. 
                
                &IF DEFINED (bf_mnt_ems205) &THEN
                    if connected("mgmnt") and connected("movmnt") then do:
                        find first param-global no-lock no-error. 
                        if  avail param-global 
                        and param-global.log-modul-calib = yes then do:
                        &IF DEFINED (bf_mnt_ems208) &THEN
                               if ord-manut.tp-manut = 3 
                        &else
                               if ord-manut.dec-1 = 3 
                        &endif /* Calibraá∆o*/ 
                            and ord-manut.estado = 1 then do:
                                {method/svc/errors/inserr.i
                                          &ErrorNumber="28075" /*Calibraá∆o.*/
                                          &ErrorType="EMS"
                                          &ErrorSubType="ERROR"}
                            end.
                        end.
                    end.
               &ELSE
                   find first param-global no-lock no-error. 
                   if  avail param-global 
                   and substring(param-global.char-2,100,1) = "2" then do:
                       &IF DEFINED (bf_mnt_ems208) &THEN
                               if ord-manut.tp-manut = 3 
                        &else
                               if ord-manut.dec-1 = 3 
                        &endif  /* Calibraá∆o*/ 
                       and ord-manut.estado = 1 then do:
                          {method/svc/errors/inserr.i
                                  &ErrorNumber="28075" /*Calibraá∆o.*/
                                  &ErrorType="EMS"
                                  &ErrorSubType="ERROR"}
                       end.           
                   end.
               &ENDIF
            end.
        end.
        
        /*************************************************************
        **             Ordem Manutená∆o de Frotas
        *************************************************************/
        /** Permite Recebimento de Materiais para Ordens de Produá∆o Finalizada do tipo "MV" **/
        if ord-prod.origem = "MV":U then do:
        
/************************************************************************************************************************            
            /*Validaá∆o de Frotas: Caso a OM seja originada em frotas, a data da OM nao pode ser superior a data da NFE
            Logica esta sendo retirada, pois equipe de inovaá∆o de frotas irà avaliar a melhor alternativa para esta situaá∆o. 
            Visto tambàm que esta logica esta gerando diversos problemas em clientes.*/
            
            IF  ord-prod.dt-emissao > docum-est.dt-emissao
            THEN DO:
                DEFINE VARIABLE cLiter1 AS CHARACTER   NO-UNDO.
                DEFINE VARIABLE cLiter2 AS CHARACTER   NO-UNDO.
                DEFINE VARIABLE cLiter3 AS CHARACTER   NO-UNDO.
                DEFINE VARIABLE cLiter4 AS CHARACTER   NO-UNDO.
                DEFINE VARIABLE cLiter5 AS CHARACTER   NO-UNDO.

                {utp/ut-liter.i "Data_da_Ordem_de_Produá∆o_Inv†lida!" *}
                ASSIGN cLiter1 = TRIM(RETURN-VALUE).
                {utp/ut-liter.i "A_data_de_abertura_da_Ordem_de_Produá∆o_n∆o_pode_ser_superior_a_data_da_Nota_Fiscal." *}
                ASSIGN cLiter2 = TRIM(RETURN-VALUE).
                {utp/ut-liter.i "Data Ordem" *}
                ASSIGN cLiter3 = TRIM(RETURN-VALUE).
                {utp/ut-liter.i "Data Nota Fiscal" *}
                ASSIGN cLiter4 = TRIM(RETURN-VALUE).
                assign cLiter5 = cLiter1 + "~~" + cLiter2 
                                                + CHR(13) 
                                                + cLiter3 + ":" + STRING(ord-prod.dt-emissao)
                                                + CHR(13)
                                                + cLiter4 + ":" + STRING(docum-est.dt-emissao).
                
                {method/svc/errors/inserr.i
                                    &ErrorNumber="17006"
                                    &ErrorType="EMS"
                                    &ErrorSubType="ERROR"
                                    &ErrorParameters="cLiter5"}

            END.
************************************************************************************************************************/

            if  ord-prod.estado = 8 then do:
                {method/svc/errors/inserr.i
                                    &ErrorNumber="52171" /*Ordem de manutená∆o terminada*/
                                    &ErrorType="EMS"
                                    &ErrorSubType="ERROR"
                                    &ErrorParameters="ord-manut.nr-ord-produ"}
            end.            
            if  ord-prod.estado = 7 then do:
                {method/svc/errors/inserr.i
                                    &ErrorNumber="18803" /*Ordem de manutená∆o finalizada.*/
                                    &ErrorType="EMS"
                                    &ErrorSubType="WARNING"}
            end.
        end.
        /************************************************************/
        if  not avail ord-manut and ord-prod.origem <> "MV":U 
        and (ord-prod.estado = 7 or ord-prod.estado = 8 ) then do:
            {method/svc/errors/inserr.i
                                &ErrorNumber="52172" /* Ordem de produá∆o est† finalizada*/
                                &ErrorType="EMS"
                                &ErrorSubType="ERROR"
                                &ErrorParameters="RowObject.nr-ord-produ"}
        end.
        /************************************************************/
        
        for first lin-prod fields (nr-linha sum-requis)
            where lin-prod.nr-linha = ord-prod.nr-linha no-lock.
        end.
      
                
        if docum-est.mod-atual <> 1 then do: /*material agregado*/
            if  avail lin-prod
            and lin-prod.sum-requis = 2          /* Processo Servi∆o */
            and avail item 
            and item.tipo-requis    = 1          /* Tipo Req Normal  */
            and RowObject.quantidade <> 0 then do:
               
                RUN pi-execute IN h-cpapi029 (INPUT 2,
                                              INPUT ord-prod.cod-estabel,
                                              INPUT ord-prod.nr-linha,
                                              OUTPUT c-dep-fabrica,
                                              OUTPUT d-var-rep       ,
                                              OUTPUT d-var-req-menor ,
                                              OUTPUT d-var-requis    ,
                                              OUTPUT d-var-transf   ,
                                              OUTPUT TABLE tt-erro append). 
                                              
                find reservas
                    where reservas.nr-ord-produ = ord-prod.nr-ord-produ
                      and reservas.it-codigo    = RowObject.it-codigo
                      and reservas.item-pai     = RowObject.item-pai
                      and reservas.cod-roteiro  = RowObject.cod-roteiro
                      and reservas.op-codigo    = RowObject.op-codigo
                    no-lock no-error.    
                    
                if  avail reservas then do:
                    /*speto*/
                    ASSIGN de-v-men = d-var-req-menor 
                           de-v-mai = d-var-requis    
                           c-v-msgs = "".
                    
                    if  c-nom-prog-dpc-mg97  <> "" 
                    or  c-nom-prog-appc-mg97 <> "" 
                    or  c-nom-prog-upc-mg97  <> "" then do:
       
                        FOR EACH tt-epc
                           WHERE tt-epc.cod-event = "Altera-Variacao-Req":
                           DELETE tt-epc.
                        END.
                        
                        CREATE tt-epc.                                                
                        ASSIGN tt-epc.cod-event     = "Altera-Variacao-Req"
                               tt-epc.cod-parameter = "it-codigo"
                               tt-epc.val-parameter = reservas.it-codigo.
                        
                        CREATE tt-epc.                                                
                        ASSIGN tt-epc.cod-event     = "Altera-Variacao-Req"
                               tt-epc.cod-parameter = "nr-ord-produ"
                               tt-epc.val-parameter = STRING(reservas.nr-ord-produ).
                        
                        CREATE tt-epc.                                                
                        ASSIGN tt-epc.cod-event     = "Altera-Variacao-Req"
                               tt-epc.cod-parameter = "cod-roteiro"
                               tt-epc.val-parameter = reservas.cod-roteiro.
                        
                        CREATE tt-epc.                                                
                        ASSIGN tt-epc.cod-event     = "Altera-Variacao-Req"
                               tt-epc.cod-parameter = "op-codigo"
                               tt-epc.val-parameter = STRING(reservas.op-codigo).
                         
                        CREATE tt-epc.                                                
                        ASSIGN tt-epc.cod-event     = "Altera-Variacao-Req"
                               tt-epc.cod-parameter = "var-req-menor"
                               tt-epc.val-parameter = STRING(de-v-men).
                        
                        CREATE tt-epc.                                                
                        ASSIGN tt-epc.cod-event     = "Altera-Variacao-Req"
                               tt-epc.cod-parameter = "var-req-maior"
                               tt-epc.val-parameter = STRING(de-v-mai).
                         
                        {include/i-epc201.i "Altera-Variacao-Req"}
                        IF RETURN-VALUE = "NOK" THEN
                           ASSIGN de-v-men = d-var-req-menor
                                  de-v-mai = d-var-requis.
                        ELSE DO:
                           FIND FIRST tt-epc
                               WHERE tt-epc.cod-event     = "Altera-Variacao-Req"
                                  AND tt-epc.cod-parameter = "var-req-menor" NO-ERROR.
                           IF AVAIL tt-epc THEN
                              ASSIGN de-v-men = DECIMAL(tt-epc.val-parameter) NO-ERROR.
                        
                           FIND FIRST tt-epc
                                WHERE tt-epc.cod-event     = "Altera-Variacao-Req"
                                  AND tt-epc.cod-parameter = "var-req-maior" NO-ERROR.
                           IF AVAIL tt-epc THEN
                              ASSIGN de-v-mai = DECIMAL(tt-epc.val-parameter) NO-ERROR.
                              
                           FIND FIRST tt-epc
                                WHERE tt-epc.cod-event     = "Altera-Variacao-Req"
                                  AND tt-epc.cod-parameter = "mensagem-erro" NO-ERROR.
                           IF AVAIL tt-epc THEN
                              ASSIGN c-v-msgs = tt-epc.val-parameter NO-ERROR.
                        END.
                    end.
                    
                    if  de-v-mai < 999 and ord-prod.origem = "CP" then do:
                        assign de-qtd-max = reservas.quant-orig
                                          + ( reservas.quant-orig * de-v-mai / 100 ).
         
        
                        if  not(item.fraciona) then
                            assign de-qtd-max = truncate(de-qtd-max, 0 ).
         
        
                        if  (RowObject.quantidade + reservas.quant-atend ) > de-qtd-max then do:
                            if c-v-msgs <> "" then do:                    
                                 {method/svc/errors/inserr.i
                                                &ErrorNumber="17006" /*Customiza a mensagem cfme o retorno da epc*/
                                                &ErrorType="EMS"
                                                &ErrorSubType="ERROR"
                                                &ErrorDescription=c-v-msgs}
                            end.
                            else do:
                            
                                {utp/ut-liter.i " Seq: " *}
                                assign c-v-msgs  = TRIM(RETURN-VALUE) + string(RowObject.sequencia).
                                {utp/ut-liter.i " Item: " *}
                                assign c-v-msgs  = c-v-msgs  + " " + TRIM(RETURN-VALUE) + RowObject.it-codigo.
                
                
                                {method/svc/errors/inserr.i
                                           &ErrorNumber="56380"
                                           &ErrorType="EMS"
                                           &ErrorSubType="ERROR"
                                           &ErrorParameters="c-v-msgs"}
                                 assign c-v-msgs = "".
                              
                            end.
                            
                        end.
                    end.
                end.
            end.    
        end.

        find first reservas 
            where reservas.nr-ord-produ = RowObject.nr-ord-produ 
              and reservas.it-codigo    = RowObject.it-codigo no-lock no-error.
        if  not avail reservas
        and (   RowObject.item-pai <> ""
             or RowObject.cod-roteiro <> ""
             or (RowObject.op-codigo <> 0 AND
                 NOT ord-prod.rep-prod = 2)) then do:
             {method/svc/errors/inserr.i
                                &ErrorNumber="1245" /*N∆o existe reserva*/
                                &ErrorType="EMS"
                                &ErrorSubType="ERROR"}
        end.

        if  avail reservas then do:
            find first reservas
                where reservas.nr-ord-produ = ord-prod.nr-ord-produ
                  and reservas.it-codigo    = RowObject.it-codigo
                  and reservas.item-pai     = RowObject.item-pai
                  and reservas.cod-roteiro  = RowObject.cod-roteiro
                  and reservas.op-codigo    = RowObject.op-codigo
                no-lock no-error.    
            if  not avail reservas then do:    
                {method/svc/errors/inserr.i
                                    &ErrorNumber="1245" /*Nao existe reserva*/
                                    &ErrorType="EMS"
                                    &ErrorSubType="ERROR"}
            end.     
        end.
    end.

    if valid-handle(h-cpapi029) then
         delete procedure h-cpapi029.
         
    return "OK":U.

END PROCEDURE.




