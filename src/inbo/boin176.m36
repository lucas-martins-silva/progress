PROCEDURE TransferTotalItensNota :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: Essa procedure ² executado para cÿlculo do ICMS, ICMS Complementar e
         Substitui»’o Tributÿria. 
         Atrav²s da procedure calculateTotalItem executada por esta ² feito a
         totaliza»’o do valores (inclusive impostos) e esses valores s’o repas-
         sados para o documento (docum-est) atrav²s da procedure setTotaisNota
         da inbo090.
         Variÿvel "i-totaliza = 0" indica que a nota poderÿ ser totalizada, isto ²,
         a procedure setTotaisNota (boin090) poderÿ atualizar os totais do 
         docum-est.
------------------------------------------------------------------------------*/
  

    def input param piCodEmitente like item-doc-est.cod-emitente no-undo.
    def input param piSerieDocto  like item-doc-est.serie-docto  no-undo.
    def input param piNroDocto    like item-doc-est.nro-docto    no-undo.
    def input param piNatOperacao like item-doc-est.nat-operacao no-undo.

    DEF VAR h-bodi516          AS HANDLE      NO-UNDO.
    DEF VAR h-bofi281          AS HANDLE      NO-UNDO.
    DEF VAR i-ajust            AS INTEGER     NO-UNDO.
    DEF VAR i-aux              AS INTEGER     NO-UNDO.
    DEF VAR c-cod-ajust        AS CHARACTER   NO-UNDO.
    DEF VAR c-cod-ajust-2      AS CHARACTER   NO-UNDO.
    DEF VAR c-cod-ajust-conf   AS CHARACTER   NO-UNDO.
    DEF VAR l-registro-existe  AS LOGICAL     NO-UNDO.
    
    DEF BUFFER b-natur-oper-fiscal FOR natur-oper. /* Buffer aux. para a natureza fiscal dos itens */

    run findParamGlobal.
	
    run getDocumEst ( input piCodEmitente,
                      input piSerieDocto,
                      input piNroDocto,
                      input piNatOperacao ).

    IF NOT AVAIL docum-est THEN 
        FIND FIRST docum-est NO-LOCK 
             WHERE docum-est.cod-emitente = piCodEmitente
               AND docum-est.serie-docto  = piSerieDocto 
               AND docum-est.nro-docto    = piNroDocto   
               AND docum-est.nat-operacao = piNatOperacao NO-ERROR.
    
    IF i-pais-impto-usuario = 1 AND 
       AVAIL docum-est AND
       CONNECTED("mgfis") THEN DO:
        /************************************* ICMS Complementar *********************************************/
        run findEstabelec ( docum-est.cod-estabel ).

        IF NOT VALID-HANDLE(h-bofi281) THEN
            RUN fibo/bofi281.p PERSISTENT SET h-bofi281.
        RUN validateCodAjust IN h-bofi281 (INPUT  estabelec.estado, 
                                           OUTPUT i-ajust,
                                           OUTPUT c-cod-ajust,
                                           OUTPUT c-cod-ajust-2).
                                           
        IF i-ajust <> 0 THEN DO:
            IF NOT VALID-HANDLE(h-bodi515) THEN
                RUN dibo/bodi515.p PERSISTENT SET h-bodi515.
            RUN openQueryStatic IN h-bodi515 (INPUT "Main":U).

            FOR EACH item-doc-est FIELDS(nat-of serie-docto nro-docto cod-emitente nat-operacao nat-of sequencia icm-complem)
               WHERE item-doc-est.cod-emitente = piCodEmitente
                 AND item-doc-est.serie-docto  = piSerieDocto
                 AND item-doc-est.nro-docto    = piNroDocto
                 AND item-doc-est.nat-operacao = piNatOperacao NO-LOCK:
                 
                 IF item-doc-est.icm-complem[1] <> 0 THEN DO:
                     FOR EACH nota-fisc-adc EXCLUSIVE-LOCK
                        WHERE nota-fisc-adc.cod-estab        = estabelec.cod-estabel
                          AND nota-fisc-adc.cod-serie        = item-doc-est.serie-docto
                          AND nota-fisc-adc.cod-nota-fisc    = item-doc-est.nro-docto
                          AND nota-fisc-adc.cdn-emitente     = item-doc-est.cod-emitente
                          AND nota-fisc-adc.cod-natur-operac = item-doc-est.nat-of
                          AND nota-fisc-adc.idi-tip-dado     = 7:
                          IF nota-fisc-adc.cod-ajust = c-cod-ajust OR 
                             nota-fisc-adc.cod-ajust = c-cod-ajust-2 THEN
                              DELETE nota-fisc-adc.
                     END.
                 END.
            END.     
        
            for each item-doc-est 
               where item-doc-est.cod-emitente = piCodEmitente
                 and item-doc-est.serie-docto  = piSerieDocto 
                 and item-doc-est.nro-docto    = piNroDocto   
                 and item-doc-est.nat-operacao = piNatOperacao no-lock:
                 if item-doc-est.icm-complem[1] <> 0 then do:
                     DO i-aux = 0 TO i-ajust - 1:
                         EMPTY TEMP-TABLE tt-nota-fisc-adc.
                         RUN goToKeyObrigTribut IN h-bodi515(INPUT estabelec.cod-estabel, 
                                                             INPUT item-doc-est.serie-docto, 
                                                             INPUT item-doc-est.nro-docto, 
                                                             INPUT item-doc-est.cod-emitente,    
                                                             INPUT item-doc-est.nat-of,
                                                             INPUT 7, 
                                                             INPUT item-doc-est.it-codigo,
                                                             INPUT IF i-aux = 0 THEN c-cod-ajust ELSE c-cod-ajust-2).
                         ASSIGN l-registro-existe = RETURN-VALUE = "OK":U.
                         IF  l-registro-existe THEN DO:
                             RUN getRecord IN h-bodi515 (OUTPUT TABLE tt-nota-fisc-adc).
                             FIND FIRST tt-nota-fisc-adc NO-ERROR.
                         END.
                         
                         /* Se usa m£ltiplas naturezas no recebimento */
                         IF  l-mult-natur-receb THEN /* Var def em cd9701.i */
                             /* Busca b-natur-oper-fiscal = Natureza fiscal do Item */
                             FIND FIRST b-natur-oper-fiscal WHERE b-natur-oper-fiscal.nat-operacao = item-doc-est.nat-of NO-LOCK NO-ERROR.
                         
                         /* Se nÆo usa multiplas naturezas ou usa mas a nota ‚ antiga (digit. antes de marcar o parƒm.) */
                         IF  NOT l-mult-natur-receb OR NOT AVAIL b-natur-oper-fiscal THEN
                             /* Busca b-natur-oper-fiscal = Natureza de opera‡Æo da Nota */
                             FIND FIRST b-natur-oper-fiscal WHERE b-natur-oper-fiscal.nat-operacao = item-doc-est.nat-operacao NO-LOCK NO-ERROR.
            
                         IF  NOT l-registro-existe 
                         OR  NOT AVAIL tt-nota-fisc-adc THEN DO:
                             CREATE tt-nota-fisc-adc.
                             ASSIGN tt-nota-fisc-adc.cod-estab        = estabelec.cod-estabel
                                    tt-nota-fisc-adc.cod-serie        = item-doc-est.serie-docto
                                    tt-nota-fisc-adc.cod-nota-fisc    = item-doc-est.nro-docto
                                    tt-nota-fisc-adc.cdn-emitente     = item-doc-est.cod-emitente
                                    tt-nota-fisc-adc.cod-natur-operac = item-doc-est.nat-of
                                    tt-nota-fisc-adc.idi-tip-dado     = 7
                                    tt-nota-fisc-adc.cod-item         = item-doc-est.it-codigo
                                    tt-nota-fisc-adc.cod-ajust        = IF i-aux = 0 THEN c-cod-ajust ELSE c-cod-ajust-2 /*docum-est.uf + "40000001"*/ .
                         END.
                         
                         ASSIGN tt-nota-fisc-adc.val-icms-outras    = 0.
                         IF i-ajust = 1 THEN
                             ASSIGN tt-nota-fisc-adc.val-base-calc-icms = tt-nota-fisc-adc.val-base-calc-icms + DEC(SUBSTRING(item-doc-est.char-2,860,20))
                                    tt-nota-fisc-adc.val-aliq-icms      = b-natur-oper-fiscal.aliq-icm-com
                                    tt-nota-fisc-adc.val-icms           = tt-nota-fisc-adc.val-icms + item-doc-est.icm-complem[1].
                         ELSE DO:
                             FOR FIRST unid-feder FIELDS (char-1 per-icms-int per-icms-ext)
                                 WHERE unid-feder.pais   = estabelec.pais
                                   AND unid-feder.estado = estabelec.estado NO-LOCK. END.
                                   
                             RUN findEmitente ( item-doc-est.cod-emitente ).
                             
                             IF i-aux = 0 THEN DO: /* Ajust = 2 - Debito */
                                 IF AVAIL unid-feder AND
                                    SUBSTRING(unid-feder.char-1,9,1) = "S" THEN
                                     ASSIGN tt-nota-fisc-adc.val-base-calc-icms = tt-nota-fisc-adc.val-base-calc-icms + DEC(SUBSTRING(item-doc-est.char-2,860,20)).
                                 ELSE 
                                     ASSIGN tt-nota-fisc-adc.val-base-calc-icms = tt-nota-fisc-adc.val-base-calc-icms + item-doc-est.base-icm[1] + item-doc-est.icm-outras[1] + item-doc-est.icm-outras[2].    
                      
                                 ASSIGN tt-nota-fisc-adc.val-aliq-icms = item-doc-est.aliquota-icm + b-natur-oper-fiscal.aliq-icm-com
                                        tt-nota-fisc-adc.val-icms      = tt-nota-fisc-adc.val-icms + item-doc-est.valor-icm[1] + item-doc-est.icm-complem[1].
                                        
                                 IF AVAIL emitente AND SUBSTRING(emitente.char-1,133,1) = "S":U THEN
                                     ASSIGN tt-nota-fisc-adc.val-base-calc-icms = tt-nota-fisc-adc.val-base-calc-icms + item-doc-est.icm-ntrib[1]
                                            tt-nota-fisc-adc.val-aliq-icms      = tt-nota-fisc-adc.val-aliq-icms + unid-feder.per-icms-ext 
                                            tt-nota-fisc-adc.val-icms           = ROUND((tt-nota-fisc-adc.val-base-calc-icms * tt-nota-fisc-adc.val-aliq-icms / 100),2).
                             END.           
                             ELSE DO: /* Ajust = 2 - Credito */
                                 ASSIGN tt-nota-fisc-adc.val-base-calc-icms = tt-nota-fisc-adc.val-base-calc-icms + item-doc-est.base-icm[1] + item-doc-est.icm-outras[1] + item-doc-est.icm-outras[2] 
                                        tt-nota-fisc-adc.val-aliq-icms      = item-doc-est.aliquota-icm
                                        tt-nota-fisc-adc.val-icms           = tt-nota-fisc-adc.val-icms + item-doc-est.valor-icm[1].
    
                                 IF AVAIL emitente AND SUBSTRING(emitente.char-1,133,1) = "S":U THEN
                                     ASSIGN tt-nota-fisc-adc.val-base-calc-icms = tt-nota-fisc-adc.val-base-calc-icms + item-doc-est.icm-ntrib[1]
                                            tt-nota-fisc-adc.val-aliq-icms      = unid-feder.per-icms-ext
                                            tt-nota-fisc-adc.val-icms           = ROUND((tt-nota-fisc-adc.val-base-calc-icms * tt-nota-fisc-adc.val-aliq-icms / 100),2).
                             END.
                         END.    
                                        
                         IF estabelec.estado = "MG" THEN
                             ASSIGN OVERLAY(tt-nota-fisc-adc.cod-livre-1,30,3) = "100".
                             
                         RUN setRecord IN h-bodi515 (INPUT TABLE tt-nota-fisc-adc).
                     
                         RUN emptyRowErrors IN h-bodi515.
                         
                         IF  RETURN-VALUE = "OK":U THEN DO:
                             IF  l-registro-existe THEN do:
                                 RUN updateRecord IN h-bodi515.
                             end.    
                             ELSE do:
                                 RUN createRecord IN h-bodi515.                         
                                 RUN getRowErrors IN h-bodi515 (OUTPUT TABLE rowErrors).
                             end.    
                         END.
                     END. /*do*/   
                 end. /*if icm-complem[1] <> 0*/  
             end. /* for each*/
        end. /*IF  i-ajust*/
        
        ASSIGN i-ajust = 0.
    END.
    /************************************* ICMS Complementar *********************************************/
    
    if valid-handle(h-bodi515) then
        delete procedure h-bodi515.
    assign h-bodi515 = ?.

    IF VALID-HANDLE(h-bofi281) THEN
        DELETE PROCEDURE h-bofi281.
    ASSIGN h-bofi281 = ?.

    {method/svc/custom/custom.i &Event = "TotalizaNota"}

    run calculateTotalItem ( input piCodEmitente,
                             input piSerieDocto,
                             input piNroDocto,
                             input piNatOperacao, 
                             output table tt-total-item).

    find first tt-total-item no-lock no-error.

    run setTotaisNota in h-boin090 ( input table tt-total-item,
                                     input i-totaliza ).
  

    if  return-value <> "OK":U then
        return "NOK":U.
        
    return "OK":U.
  
END PROCEDURE.




