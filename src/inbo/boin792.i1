/***********************************************************************************
* Temp-tables utilizadas na boin792.p e mla0170rp.p                                *
*                                                                                  *
* situacao: 'Mantido', 'Novo', 'Substitu¡do', 'Eliminado', 'Origem', 'Transferido' * 
* id-sit  :     1    ,    2  ,       3      ,       4    ,     5   ,       6       * 
* r-rowid : rowid do registro alterado,exclu¡do ou inserido.                       * 
***********************************************************************************/ 
DEFINE TEMP-TABLE tt-mla-hierarquia-aprov-origem NO-UNDO LIKE mla-hierarquia-aprov
    FIELD situacao AS CHAR FORMAT "x(20)"
    FIELD id-sit   AS INT
    FIELD r-rowid  AS ROWID
    INDEX codigo   ep-codigo   
                   cod-estabel 
                   cod-lotacao ASC
                   cod-tip-doc 
                   seq-aprov 
                   cod-usuar
                   situacao.
                   
DEFINE TEMP-TABLE tt-mla-hierarquia-aprov-destino NO-UNDO LIKE tt-mla-hierarquia-aprov-origem.


