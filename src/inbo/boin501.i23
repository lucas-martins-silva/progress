/********************************************************************************
**
** Gera‡Æo de INDICES VISÇO MANUFATURA
** {1} Öndice
** {2} Descri‡Æo Öndice
** {3} Formato
** {4} F¢rmula
** {5} Unidade Medida Gerencial
**
********************************************************************************/

assign c-ind   = {ininc/i01in504.i 04 {1}}.

&if "{&FNC_MULTI_IDIOMA}" = "Yes" &then
   RUN utp/ut-liter.p (trim(c-ind), "*", "").
   assign c-ind = return-value.
&endif

find first tt-indicador where
           tt-indicador.cod-visao   = visao-man.cod-visao and
           tt-indicador.cod-ind-int = c-ind no-error.

if not available tt-indicador then do:

   {utp/ut-liter.i {2} * R}
   assign c-liter = return-value.

   create tt-indicador.
   assign tt-indicador.cod-visao       = visao-man.cod-visao
          tt-indicador.cod-ind-int     = c-ind
          tt-indicador.cod-ind-alias   = c-ind
          tt-indicador.seq-ind         = i-seq-ind
          tt-indicador.formato         = {3}
          tt-indicador.des-ind-man     = c-liter
          tt-indicador.log-ativo       = yes.

end.

{utp/ut-liter.i "{5}" * R}
assign c-liter = return-value.

assign tt-indicador.num-ind-int     = {1}
       tt-indicador.formula         = {4}
       tt-indicador.cod-um-gerc     = c-liter 
       tt-indicador.log-reg-dtsul   = yes.
