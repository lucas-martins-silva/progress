&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice id
  Parameters:  
               recebe valor do campo cod-area-produc
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-area-produc LIKE area-produc.cod-area-produc NO-UNDO.

    FIND FIRST bfarea-produc WHERE 
        bfarea-produc.cod-area-produc = pcod-area-produc NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfarea-produc THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfarea-produc)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryFiltroArea DBOProgram 
PROCEDURE openQueryFiltroArea :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
open query {&QUERYNAME} for each {&TABLENAME} where
                                 {&TABLENAME}.cod-area-produc >= c-area-ini AND
                                 {&TABLENAME}.cod-area-produc <= c-area-fim
                                  NO-LOCK  INDEXED-REPOSITION.
                                          
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryFiltroDescricao DBOProgram 
PROCEDURE openQueryFiltroDescricao :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
open query {&QUERYNAME} for each {&TABLENAME} where
                                 {&TABLENAME}.des-area-produc >= c-des-ini AND
                                 {&TABLENAME}.des-area-produc <= c-des-fim
                                  NO-LOCK BY {&TABLENAME}.des-area-produc INDEXED-REPOSITION.
                                          
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


