&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.

    DEF VAR l-erro AS LOG NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/

    IF pType = "Create" THEN DO:

        IF RowObject.cod-num = "" THEN DO:
            {utp/ut-liter.i Nota Promiss¢ria Rural *}
            {method/svc/errors/inserr.i
                     &ErrorNumber="164"
                     &ErrorType="EMS"
                     &ErrorParameters="return-value"} 
        END.
    
        IF CAN-FIND(FIRST bfnota-promis-rural WHERE bfnota-promis-rural.cod-num = RowObject.cod-num) THEN DO:
            {utp/ut-liter.i Nota Promiss¢ria Rural *}
            {method/svc/errors/inserr.i
                     &ErrorNumber="1"
                     &ErrorType="EMS"
                     &ErrorParameters="return-value"} 
        END.

    END.

    IF RowObject.dat-inic = ? THEN DO:
        {utp/ut-liter.i Data_de_In°cio *}
        {method/svc/errors/inserr.i
                 &ErrorNumber="164"
                 &ErrorType="EMS"
                 &ErrorParameters="return-value"} 
    END.

    IF RowObject.dat-fim = ? THEN DO:
        {utp/ut-liter.i Data_Fim *}
        {method/svc/errors/inserr.i
                 &ErrorNumber="164"
                 &ErrorType="EMS"
                 &ErrorParameters="return-value"} 
    END.

    IF RowObject.dat-fim < RowObject.dat-inic THEN DO:
        {method/svc/errors/inserr.i
                 &ErrorNumber="2908"
                 &ErrorType="EMS"
                 &ErrorParameters=" "} 
    END.
    
    /*Verifica se o existe NPR cadastrada para o periodo informado*/
    ASSIGN l-erro = NO.
    FOR EACH bfnota-promis-rural FIELDS(cod-num dat-inic dat-fim) NO-LOCK
       WHERE bfnota-promis-rural.cdn-produt-rural = RowObject.cdn-produt-rural:

        /*descarta o registro corrente*/
        IF bfnota-promis-rural.cod-num <> RowObject.cod-num THEN DO:
        
            IF RowObject.dat-inic >= bfnota-promis-rural.dat-inic AND 
               RowObject.dat-inic <= bfnota-promis-rural.dat-fim THEN
                ASSIGN l-erro = YES.
            
            IF RowObject.dat-fim >= bfnota-promis-rural.dat-inic AND 
               RowObject.dat-fim <= bfnota-promis-rural.dat-fim THEN
                ASSIGN l-erro = YES.

        END.

        IF l-erro = YES THEN
            LEAVE.

    END. 

    IF l-erro THEN DO:
        {method/svc/errors/inserr.i
                 &ErrorNumber="54578"
                 &ErrorType="EMS"
                 &ErrorParameters="RowObject.cdn-produt-rural"} 
    END.


    IF NOT CAN-FIND(FIRST emitente WHERE emitente.cod-emitente = RowObject.cdn-produt-rural) THEN DO:
        {method/svc/errors/inserr.i
                 &ErrorNumber="54574"
                 &ErrorType="EMS"
                 &ErrorParameters=" "} 
    END.
    
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

