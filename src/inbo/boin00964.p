PROCEDURE linkToProdutor :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input param pHandle as handle no-undo.
    
    run getKey in pHandle (output i-produtor).   
    
    return "OK":U.

END PROCEDURE.

