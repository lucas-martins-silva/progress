PROCEDURE VerificaPadraoNacional:
    DEFINE INPUT PARAM p-nat-operacao LIKE docum-est.nat-operacao NO-UNDO.
    DEFINE OUTPUT PARAM log-nfse-nacional AS LOGICAL NO-UNDO.
    
    DEFINE BUFFER b-chave-natur-oper FOR natur-oper.

    FIND FIRST b-chave-natur-oper NO-LOCK 
         WHERE b-chave-natur-oper.nat-operacao = p-nat-operacao NO-ERROR.
    IF AVAIL b-chave-natur-oper THEN DO:         
        IF b-chave-natur-oper.log-nfse-nacional /*Padr∆o Nacional*/ THEN
             ASSIGN log-nfse-nacional = YES.    
    END.
    RETURN "OK":U.
END PROCEDURE.

PROCEDURE retornaChaveAcessoPadraoNac:    
    DEFINE INPUT  PARAMETER pCodEmitente AS INT  NO-UNDO.
    DEFINE INPUT  PARAMETER pNroDocto    AS CHAR NO-UNDO.
    DEFINE INPUT  PARAMETER pDataEmis    AS DATE NO-UNDO.
    DEFINE OUTPUT PARAMETER pChaveNfe    LIKE docum-est.cod-chave-aces-nf-eletro  NO-UNDO.

    DEFINE VARIABLE c-cod-municipio AS CHARACTER   NO-UNDO. /* C¢digo do munic°pio (sugerir o c¢digo IBGE)*/
    DEFINE VARIABLE c-amb-geracao   AS CHARACTER   NO-UNDO. /* Ambiente geraá∆o (1-Prefeitura 2-Sistema nacional de NFS-e)*/
    DEFINE VARIABLE c-tip-insc-fed  AS CHARACTER   NO-UNDO. /* Tipo de Inscriá∆o Federal (1-CPF 2-CNPJ)*/
    DEFINE VARIABLE c-insc-federal  AS CHARACTER   NO-UNDO. /* Inscriá∆o Federal (emitente.cgc)*/
    DEFINE VARIABLE c-num-nfse      AS CHARACTER   NO-UNDO. /* N£mero da NFS-e - conforme o campo de numeraá∆o do documento(preencher com zeros)*/
    DEFINE VARIABLE c-anoMes-emis   AS CHARACTER   NO-UNDO. /* Ano e màs data emiss∆o (formato AAMM)*/
    DEFINE VARIABLE c-cod-numerico  AS CHARACTER   NO-UNDO. /* C¢digo numÇrico aleat¢rio (n∆o sugerir - preencher com zeros)*/
    DEFINE VARIABLE c-dig-verific   AS CHARACTER   NO-UNDO. /* D°gito verificador (n∆o sugerir) */
    DEFINE VARIABLE i-diferenca     AS INTEGER     NO-UNDO.
    
    DEFINE BUFFER bf-chave-emit FOR emitente.
        
    FIND FIRST bf-chave-emit NO-LOCK
         WHERE bf-chave-emit.cod-emitente = pCodEmitente NO-ERROR.
    IF NOT AVAIL bf-chave-emit THEN RETURN "NOK":U.
   
    /* Busca Cod IBGE cidade - emitente */
    FIND FIRST cidade NO-LOCK
         WHERE cidade.cidade = bf-chave-emit.cidade 
           AND cidade.estado = bf-chave-emit.estado NO-ERROR.
    IF AVAIL cidade THEN DO:  
        IF cidade.cdn-munpio-ibge <> 0 AND cidade.cdn-munpio-ibge <> ? THEN 
            ASSIGN c-cod-municipio = STRING(cidade.cdn-munpio-ibge).
        ELSE 
            ASSIGN c-cod-municipio = STRING(cidade.int-2).
    END.
    ELSE RETURN "NOK":U.
    
    IF TRIM(c-cod-municipio) = "" OR TRIM(c-cod-municipio) = "0" OR TRIM(c-cod-municipio) = ? THEN
        ASSIGN c-cod-municipio = "0000000".
    
    /* Busca Tipo Inscricao Federal */
    IF bf-chave-emit.natureza = 1 THEN   
        ASSIGN c-tip-insc-fed = '1'. /*1-CPF*/
    ELSE 
        IF bf-chave-emit.natureza = 2 THEN 
            ASSIGN c-tip-insc-fed = '2'. /*2-CNPJ*/
        ELSE
            ASSIGN c-tip-insc-fed = '0'.
   
    IF bf-chave-emit.natureza = 1 /*Pessoa f°sica*/ THEN DO:
       IF LENGTH(bf-chave-emit.cgc) < 14 THEN
          ASSIGN i-diferenca = 14 - LENGTH(bf-chave-emit.cgc)
                 c-insc-federal = FILL("0",i-diferenca) + bf-chave-emit.cgc.
    END.
    ELSE 
      ASSIGN c-insc-federal  = STRING(bf-chave-emit.cgc, "x(14)").

    ASSIGN c-amb-geracao   = '2' /*2-Sistema Nacional NFS-e*/
           c-num-nfse      = (if length(pNroDocto) < 13 THEN string(dec(pNroDocto),"9999999999999") else substr(pNroDocto,1,13))
           c-anoMes-emis   = SUBSTRING(STRING(YEAR(pDataEmis)),3,2) + STRING(MONTH(pDataEmis), '99')
           c-cod-numerico  = FILL('0',9)
           c-dig-verific   = '' . 

    /* Chave de acesso padr∆o nacional - 50 digitos */       
    ASSIGN pChaveNfe = c-cod-municipio + /*7*/
                       c-amb-geracao   + /*1*/
                       c-tip-insc-fed  + /*1*/
                       c-insc-federal  + /*14*/
                       c-num-nfse      + /*13*/
                       c-anoMes-emis   + /*4*/
                       c-cod-numerico  + /*9*/
                       c-dig-verific.    /*1*/  

    RETURN "OK":U.      

END PROCEDURE.

PROCEDURE retornaChaveAcessoPadraoNFSeVia:    
    DEFINE INPUT  PARAMETER pCodEmitente AS INT  NO-UNDO.
    DEFINE INPUT  PARAMETER pNroDocto    AS CHAR NO-UNDO.
    DEFINE INPUT  PARAMETER pSerieDocto  AS CHAR NO-UNDO.
    DEFINE INPUT  PARAMETER pDataEmis    AS DATE NO-UNDO.
    DEFINE OUTPUT PARAMETER pChaveNfe    LIKE docum-est.cod-chave-aces-nf-eletro  NO-UNDO.

    DEFINE VARIABLE c-cod-localid   AS CHARACTER   NO-UNDO. /* Localidade/Trecho, preencher com zero e habilitar para digitaá∆o*/
    DEFINE VARIABLE c-amb-geracao   AS CHARACTER   NO-UNDO. /* Ambiente geraá∆o, preencher com zero e habilitar para digitaá∆o*/
    DEFINE VARIABLE c-insc-federal  AS CHARACTER   NO-UNDO. /* Inscriá∆o Federal (emitente.cgc)*/
    DEFINE VARIABLE c-num-nfseVia   AS CHARACTER   NO-UNDO. /* N£mero da NFSeVia - conforme o campo de numeraá∆o do documento(preencher com zeros)*/
    DEFINE VARIABLE c-ser-nfseVia   AS CHARACTER   NO-UNDO. /* SÇrie da NFSeVia - conforme o campo de sÇrie do documento(preencher com zeros)*/
    DEFINE VARIABLE c-anoMes-emis   AS CHARACTER   NO-UNDO. /* Ano e màs data emiss∆o (formato AAMM)*/
    DEFINE VARIABLE c-cod-numerico  AS CHARACTER   NO-UNDO. /* C¢digo numÇrico aleat¢rio, preencher com zero e habilitar para digitaá∆o*/
    DEFINE VARIABLE c-dig-verific   AS CHARACTER   NO-UNDO. /* D°gito verificador, preencher com zero e habilitar para digitaá∆o */
    DEFINE VARIABLE i-diferenca     AS INTEGER     NO-UNDO.
    
    DEFINE BUFFER bf-chave-emit FOR emitente.
        
    FIND FIRST bf-chave-emit NO-LOCK
         WHERE bf-chave-emit.cod-emitente = pCodEmitente NO-ERROR.
    IF NOT AVAIL bf-chave-emit THEN RETURN "NOK":U.
   
    IF bf-chave-emit.natureza = 1 /*Pessoa f°sica*/ THEN DO:
       IF LENGTH(bf-chave-emit.cgc) < 14 THEN
          ASSIGN i-diferenca = 14 - LENGTH(bf-chave-emit.cgc)
                 c-insc-federal = FILL("0",i-diferenca) + bf-chave-emit.cgc.
    END.
    ELSE 
      ASSIGN c-insc-federal = STRING(bf-chave-emit.cgc, "x(14)").

    ASSIGN c-cod-localid   = FILL("0",7)
           c-amb-geracao   = '0' 
           c-num-nfseVia   = (IF  LENGTH(pNroDocto)   < 13 THEN STRING(DEC(pNroDocto),"9999999999999") else SUBSTR(pNroDocto,1,13))
           c-ser-nfseVia   = (IF  LENGTH(pSerieDocto) < 3  THEN STRING(DEC(pSerieDocto),"999") ELSE SUBSTR(pSerieDocto,1,3))
           c-anoMes-emis   = SUBSTRING(STRING(YEAR(pDataEmis)),3,2) + STRING(MONTH(pDataEmis), "99")
           c-cod-numerico  = FILL("0",7)
           c-dig-verific   = "0" . 

    /* Chave de acesso padr∆o NFSe Via - 50 digitos */       
    ASSIGN pChaveNfe = c-cod-localid   + /*7*/
                       c-amb-geracao   + /*1*/
                       c-insc-federal  + /*14*/
                       c-num-nfseVia   + /*13*/
                       c-ser-nfseVia   + /*3*/
                       c-anoMes-emis   + /*4*/
                       c-cod-numerico  + /*7*/
                       c-dig-verific.    /*1*/  

    RETURN "OK":U.      

END PROCEDURE.

PROCEDURE defaultChaveAcessoNfe :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters: 
  Notes: Busca defaults chave acesso NF-e.  
------------------------------------------------------------------------------*/

    def input  param p-cod-emitente like emitente.cod-emitente.
    def input  param p-nat-operacao like natur-oper.nat-operacao.
    def output param p-cod-uf-ibge  as int  no-undo format "99"   init "00".
    def output param p-cod-modelo   as char no-undo format "x(2)" init "00".

    
    &if "{&bf_mat_versao_ems}" < "2.07" &then
    
        for first b-emitente no-lock where
                  b-emitente.cod-emitente = p-cod-emitente,
            first unid-feder no-lock where
                  unid-feder.pais   = b-emitente.pais and
                  unid-feder.estado = b-emitente.estado: 

                assign p-cod-uf-ibge = int(substr(unid-feder.char-1,1,2)) when substr(unid-feder.char-1,1,2) <> "".
        end.

        for first b-natur-oper fields(char-2) no-lock where
                  b-natur-oper.nat-operacao = p-nat-operacao:
             assign p-cod-modelo = substr(b-natur-oper.char-2,120,2) when substr(b-natur-oper.char-2,120,2) <> "".
        end.

    &else
        for first b-emitente fields(estado pais) no-lock where
                  b-emitente.cod-emitente = p-cod-emitente,
            first unid-feder no-lock where
                  unid-feder.pais   = b-emitente.pais and
                  unid-feder.estado = b-emitente.estado: 

                assign p-cod-uf-ibge = int(substr(unid-feder.cod-uf-ibge,1,2)) when unid-feder.cod-uf-ibge <> "".
        end.

        for first b-natur-oper fields(cod-model-nf-eletro) no-lock where
                  b-natur-oper.nat-operacao = p-nat-operacao:
             assign p-cod-modelo = b-natur-oper.cod-model-nf-eletro when b-natur-oper.cod-model-nf-eletro <> "".
        end.
    &endif
    

    return "OK":U.
    

END PROCEDURE.

PROCEDURE verificaEmitenteNFe :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input   param piEmitente like emitente.cod-emitente  no-undo.
    def output  param plNfe      as   logical                no-undo.
    
    
    
    assign plNfe = can-find(first bf-emitente
                            where bf-emitente.cod-emitente = piEmitente and 
                            &if "{&bf_mat_versao_ems}" < "2.07" &then
                                 substr(bf-emitente.char-1,99,1) = "1"
                            &else
                                 bf-emitente.log-possui-nf-eletro 
                            &endif).
   
   
     return "OK".

END PROCEDURE.   

PROCEDURE verificaEmitenteRecebeNFe :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input   param piEmitente like emitente.cod-emitente  no-undo.
    def output  param plNfe      as   logical                no-undo.
    
    assign plNfe = can-find(first bf-emitente
                            where bf-emitente.cod-emitente = piEmitente and 
                            &if "{&bf_mat_versao_ems}" < "2.07" &then
                                 SUBSTR(bf-emitente.char-1,100,1) = "1"
                            &else
                                 bf-emitente.log-nf-eletro 
                            &endif).
        
   
     return "OK".

END PROCEDURE.   

PROCEDURE getUfCgcNotasTransf204:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters: 
  Notes: Busca UF e CGC da chave de acesso (NF-e) de uma nota fiscal de 
  transferància entre estabelecimentos, se a operaá∆o for interestadual.
  (Essa situaá∆o somente acontece na 204).
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAM  p-nat-oper-comp AS CHAR NO-UNDO.
    DEFINE INPUT PARAM  p-nat-oper      AS CHAR NO-UNDO.
    DEFINE INPUT PARAM  p-nro-docto     AS CHAR NO-UNDO.
    DEFINE INPUT PARAM  p-cod-emitente  AS INT  NO-UNDO.
    DEFINE INPUT PARAM  p-serie         AS CHAR NO-UNDO.
    DEFINE INPUT PARAM  p-cod-estabel   AS CHAR NO-UNDO.
    DEFINE INPUT PARAM  p-programa      AS CHAR NO-UNDO.
    DEFINE OUTPUT PARAM p-uf            AS INT  NO-UNDO.
    DEFINE OUTPUT PARAM p-cgc           AS CHAR NO-UNDO.
    DEFINE VARIABLE c-chave-modelo      AS CHAR NO-UNDO.

    FIND FIRST natur-oper
        WHERE natur-oper.nat-operacao = p-nat-oper NO-LOCK NO-ERROR.
    IF AVAIL natur-oper 
         AND natur-oper.transf THEN DO:
        IF p-programa = "re1001a" THEN DO:
            IF p-nat-oper-comp <> "" THEN DO:
                FOR FIRST saldo-terc
                    WHERE saldo-terc.cod-emitente  = p-cod-emitente
                      AND saldo-terc.nro-docto     = p-nro-docto
                      AND saldo-terc.serie-docto   = p-serie
                      AND saldo-terc.nat-operacao <> p-nat-oper
                      AND saldo-terc.nat-operacao  = p-nat-oper-comp
                      AND saldo-terc.tipo-sal-terc = 3 /* Transferencia */ NO-LOCK:
            
                END.
            END.
            ELSE DO:
                FOR FIRST saldo-terc
                    WHERE saldo-terc.cod-emitente  = p-cod-emitente
                      AND saldo-terc.nro-docto     = p-nro-docto
                      AND saldo-terc.serie-docto   = p-serie
                      AND saldo-terc.nat-operacao <> p-nat-oper 
                      AND saldo-terc.tipo-sal-terc = 3 /* Transferencia */ NO-LOCK:
            
                END.
            END.
        END.
        ELSE IF p-programa = "re1001a1" THEN DO: /* Neste momento j† temos o estabelecimento de origem */
            FOR FIRST saldo-terc
                WHERE saldo-terc.cod-emitente  = p-cod-emitente
                  AND saldo-terc.nro-docto     = p-nro-docto
                  AND saldo-terc.serie-docto   = p-serie
                  AND saldo-terc.nat-operacao <> p-nat-oper 
                  AND saldo-terc.tipo-sal-terc = 3 /* Transferencia */ 
                  AND saldo-terc.cod-estabel   = p-cod-estabel NO-LOCK:
                      
            END.
        END.
        
        IF AVAIL saldo-terc THEN DO:
            /* Estabelecimennto da nota de origem da transferencia, na release 2.04 */
            FIND estabelec WHERE estabelec.cod-estabel = saldo-terc.cod-estabel NO-LOCK NO-ERROR.
            if  avail estabelec THEN DO:
                FIND FIRST unid-feder no-lock where
                           unid-feder.pais   = estabelec.pais and
                           unid-feder.estado = estabelec.estado NO-ERROR. 
                IF AVAIL unid-feder THEN 
                    ASSIGN p-uf = int(substr(unid-feder.char-1,1,2)) when substr(unid-feder.char-1,1,2) <> "". /*codigo ibge*/
                
                FIND FIRST emitente WHERE emitente.cod-emitente = estabelec.cod-emitente NO-LOCK NO-ERROR.
                IF AVAIL emitente THEN 
                    ASSIGN p-cgc = emitente.cgc.
            END.
        END.
    END.
    ELSE DO:
        run defaultChaveAcessoNfe (input p-cod-emitente,
                                   input p-nat-oper,
                                   output p-uf,
                                   output c-chave-modelo).
    END.
    RETURN "OK":u.

END PROCEDURE.
