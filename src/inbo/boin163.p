procedure getCharField:
    define input  parameter c-field as char.
    define output parameter c-value as char.
 
    case c-field:
        when "char-1" then c-value = RowObject.char-1.
        when "char-2" then c-value = RowObject.char-2.
        when "check-sum" then c-value = RowObject.check-sum.
        when "cod-depos" then c-value = RowObject.cod-depos.
        when "cod-localiz" then c-value = RowObject.cod-localiz.
        when "cod-refer" then c-value = RowObject.cod-refer.
        when "conta-contabil" then c-value = RowObject.conta-contabil.
        when "it-codigo" then c-value = RowObject.it-codigo.
        when "lote" then c-value = RowObject.lote.
        when "nat-comp" then c-value = RowObject.nat-comp.
        when "nro-comp" then c-value = RowObject.nro-comp.
        when "nro-docto" then c-value = RowObject.nro-docto.
        when "serie-comp" then c-value = RowObject.serie-comp.
        when "serie-docto" then c-value = RowObject.serie-docto.
        when "un" then c-value = RowObject.un.
        otherwise return error.
    end case.
end procedure.
 
procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.
 
    case c-field:
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        when "qt-do-forn" then c-value = RowObject.qt-do-forn.
        when "quant-conf" then c-value = RowObject.quant-conf.
        when "quant-devol" then c-value = RowObject.quant-devol.
        when "quantidade" then c-value = RowObject.quantidade.
        when "valor" then c-value = RowObject.valor.
        when "preco-total-bruto" then c-value = RowObject.preco-total-bruto.
        when "preco-unit-bruto" then c-value = RowObject.preco-unit-bruto.
        when "preco-total-liquido" then c-value = RowObject.preco-total-liquido.
        when "preco-unit-liquido" then c-value = RowObject.preco-unit-liquido.
        otherwise return error.
    end case.
end procedure.
 
procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.
 
    case c-field:
        when "cod-emitente" then c-value = RowObject.cod-emitente.
