procedure findDocumento:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter c-serie-docto as char no-undo.
    def input parameter c-nro-docto as char no-undo.
    def input parameter i-cod-emitente as inte no-undo.
    def input parameter i-tipo-nota as inte no-undo.
    def input parameter i-sequencia as inte no-undo.
    def output parameter c-return as char no-undo.
 
    find it-doc-fisico where
        it-doc-fisico.serie-docto = c-serie-docto
        and it-doc-fisico.nro-docto = c-nro-docto
        and it-doc-fisico.cod-emitente = i-cod-emitente
        and it-doc-fisico.tipo-nota = i-tipo-nota
        and it-doc-fisico.sequencia = i-sequencia
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        {utp/ut-table.i mgind {&TABLE-NAME} 1}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.
 
