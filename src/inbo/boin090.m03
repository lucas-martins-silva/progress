PROCEDURE findCGCEmitente :
/*------------------------------------------------------------------------------ 
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input   param piCGC         like emitente.cgc           no-undo.
    def output  param piEmitente    like emitente.cod-emitente  no-undo.
    
    def buffer bf-emitente for emitente.
    
    assign i-cod-emit-aux = 0.
    
    for first bf-emitente
        where bf-emitente.cgc = piCGC 
        AND CAN-FIND(FIRST dist-emitente 
                     WHERE dist-emitente.cod-emitente = bf-emitente.cod-emitente
                       AND dist-emitente.idi-sit-fornec <> 4) NO-LOCK:
    end.  
    
    if  avail bf-emitente then 
        assign i-cod-emit-aux = bf-emitente.cod-emitente.
   
    /**********************CHAMADA**********************/
    {method/svc/custom/custom.i &Event = "AfterFindCGCEmitente"}
    /***************************************************/
   
    assign piEmitente = i-cod-emit-aux.

END PROCEDURE.           
              

PROCEDURE findContaContab :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input param piContaTransit   like docum-est.ct-transit   no-undo.
    def input param piCcustoTransit  like docum-est.sc-transit   no-undo.
    def input param piCodEstabel     like docum-est.cod-estabel  no-undo.
    
    EMPTY temp-table tt_log_erro.

    run prgint/utb/utb742za.py persistent set h_api_ccusto.
    run prgint/utb/utb743za.py persistent set h_api_cta_ctbl.

    run pi_valida_cta_ctbl_integr in h_api_cta_ctbl (input  string(i-empresa),  /* EMPRESA EMS2 */
                                                     input  "CEP",              /* MODULO */
                                                     input  "",                 /* PLANO CONTAS */ 
                                                     input  piContaTransit,     /* CONTA */
                                                     input  "(nenhum)",         /* FINALIDADES */
                                                     input  RowObject.dt-trans, /* DATA DE TRANSACAO */ 
                                                     output table tt_log_erro). /* ERROS */

    find first tt_log_erro no-lock no-error.

    if avail tt_log_erro then do:

        {method/svc/errors/inserr.i
                    &ErrorNumber="37101"
                    &ErrorType="EMS"
                    &ErrorParameters=piContaTransit}
                            
        delete object h_api_ccusto.
        delete object h_api_cta_ctbl.

        RETURN "NOK":U.
    end.
    else do:
        EMPTY temp-table tt_log_erro.
        run pi_verifica_utilizacao_ccusto in h_api_ccusto (input  string(i-empresa),  /* EMPRESA EMS 2 */
                                                           input  piCodEstabel,       /* ESTABELECIMENTO EMS2 */
                                                           input  "",                 /* PLANO CONTAS */
                                                           input  piContaTransit,     /* CONTA */
                                                           input  RowObject.dt-trans, /* DT TRANSACAO */
                                                           output v_log_utz_ccusto,   /* UTILIZA CCUSTO ? */
                                                           output table tt_log_erro). /* ERROS */

        if v_log_utz_ccusto and piCcustoTransit = "" then do:
            
            {method/svc/errors/inserr.i
                        &ErrorNumber="2441"
                        &ErrorType="EMS":U}

            delete object h_api_ccusto.
            delete object h_api_cta_ctbl.
            
            RETURN "NOK":U.

        end.

        if v_log_utz_ccusto then do:
            EMPTY temp-table tt_log_erro.
            run pi_busca_dados_ccusto in h_api_ccusto (input  string(i-empresa),  /* EMPRESA EMS2 */
                                                       input  "",                 /* CODIGO DO PLANO CCUSTO */
                                                       input  piCcustoTransit,    /* CCUSTO */
                                                       input  RowObject.dt-trans, /* DATA DE TRANSACAO */
                                                       output v_des_ccusto,       /* DESCRICAO DO CCUSTO */
                                                       output table tt_log_erro). /* ERROS */ 
            find first tt_log_erro no-lock no-error.
            if avail tt_log_erro then do:
                {method/svc/errors/inserr.i
                            &ErrorNumber="37890"
                            &ErrorType="EMS":U
                            &ErrorParameters=piCcustoTransit + "~~~~" + piContaTransit}

                delete object h_api_ccusto.
                delete object h_api_cta_ctbl.

                RETURN "NOK":U.
            end.
            else do:

                delete object h_api_ccusto.
                delete object h_api_cta_ctbl.

                RETURN "OK":U.
            end.
        end.
        else do:
        
            delete object h_api_ccusto.
            delete object h_api_cta_ctbl.

            RETURN "OK":U.
        end.
    end.
        
END PROCEDURE.
        

PROCEDURE findEmitente :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input param piCodEmitente   like docum-est.cod-emitente no-undo.
    
    if  not avail emitente
    or  emitente.cod-emitente <> piCodEmitente then 

        for first emitente
            where emitente.cod-emitente = piCodEmitente no-lock.
        end.

    if  not avail emitente then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "'Emitente'" *}
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U 
                            &ErrorParameters="TRIM(RETURN-VALUE)"}
        RETURN "NOK":U.
    end.
    else         
        RETURN "OK":U.        

END PROCEDURE.


PROCEDURE findEstabelec :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input param piCodEstabel  like docum-est.cod-estabel no-undo.
    
    assign i-empresa = param-global.empresa-prin.
    
    if  not avail estabelec
    or  estabelec.cod-estabel <> piCodEstabel then do:
		


		IF l-estab-security-active = YES THEN DO:		
			for first estabelec
				where estabelec.cod-estabel = piCodEstabel
				  and CAN-FIND(FIRST {&ESTAB-SEC-TT} where {&ESTAB-SEC-TT-FIELD} = piCodEstabel) no-lock.
			end.
			
			
			for first estab-mat 
				where estab-mat.cod-estabel = piCodEstabel 
				  and CAN-FIND(FIRST {&ESTAB-SEC-TT} where {&ESTAB-SEC-TT-FIELD} = piCodEstabel) no-lock.
			end.
		END.
		ELSE DO:
			for first estabelec
				where estabelec.cod-estabel = piCodEstabel no-lock.
			end.
			
			
			for first estab-mat
				where estab-mat.cod-estabel = piCodEstabel no-lock.
			end.		
		
		END.
			
	end.

    if  not avail estabelec then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "'Estabelecimento'" *}
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U 
                            &ErrorParameters="TRIM(RETURN-VALUE)"}
        RETURN "NOK":U.
    end.
    else do:
        run cdp/cd9970.p (input rowid(estabelec),
                          output i-empresa).

        RETURN "OK":U.        
    end.        

END PROCEDURE.


PROCEDURE findNaturOper :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input param piNatOperacao   like docum-est.nat-operacao no-undo.
    
    if  not avail natur-oper
    or  natur-oper.nat-operacao <> piNatOperacao then do:
    
        for first natur-oper                     
            where natur-oper.nat-operacao = piNatOperacao no-lock.
        end.
    end.

    if  not avail natur-oper then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "'Natureza de Opera‡Æo'" *}
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U 
                            &ErrorParameters="TRIM(RETURN-VALUE)"}
        RETURN "NOK":U.
    end.
    ELSE DO: 
        /*=========== SuperGasbras/MinasG s ==================*/
          &IF DEFINED(BF_dis_natur_uf) &THEN
              IF CAN-FIND(funcao WHERE
                          funcao.cd-funcao = "fn-estab-natur-uf" AND
                          funcao.ativo     = YES) THEN DO:
                   
                 RUN cdp/cd8704.p (INPUT piNatOperacao,
                                        INPUT RowObject.cod-estabel,
                                        INPUT-OUTPUT l-erro-nat).
                   
                 IF l-erro-nat THEN DO:
                     {method/svc/errors/inserr.i 
                                  &ErrorNumber="27868"
                                  &ErrorType="EMS"
                                  &ErrorSubType="Error"
                                  &ErrorParameters="''"}
                       RETURN "NOK":U.
                 END.
              END.
          &ENDIF
        /*====================================================*/
        RETURN "OK":U.        
    END.
END PROCEDURE.


PROCEDURE findUnidFeder :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input param piUF   like docum-est.uf no-undo.
    
    if  not avail emitente then 
        return "NOK":U.
    
    if  not avail unid-feder 
    or  unid-feder.pais   <> emitente.pais
    or  unid-feder.estado <> piUF then 
        
        for first unid-feder 
            where unid-feder.pais   = emitente.pais
              and unid-feder.estado = piUF no-lock.
        end.
        
    if  not avail unid-feder then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "'Unidade de Federa‡Æo'" *}
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U 
                            &ErrorParameters="TRIM(RETURN-VALUE)"}
        RETURN "NOK":U.
    end.
    else         
        RETURN "OK":U.   

END PROCEDURE.           


PROCEDURE findUnidFederEstab :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input  param piCodEstabel like estabelec.cod-estabel no-undo.
    def output param piBaseSt     like unid-feder.ind-base-st no-undo.
    
    def buffer b-estab for estabelec.
    
    for first b-estab
        where b-estab.cod-estabel = piCodEstabel no-lock:
    end.
    
    if  avail b-estab then do:        
        
        for first unid-feder
            where unid-feder.pais   = b-estab.pais
              and unid-feder.estado = b-estab.estado no-lock.
        end.

        if  avail unid-feder then 
            assign piBaseSt = unid-feder.ind-base-st.

    end.
    RETURN "OK":U.        

END PROCEDURE.

              
PROCEDURE findUsuario :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input param piUsuario  like docum-est.usuario no-undo.
        
    if  not avail param-re
    or  param-re.usuario <> piUsuario then 
        for first param-re
            where param-re.usuario = piUsuario no-lock.
        end.

    if  not avail param-re then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "'Usu rio do Recebimento'" *}
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U 
                            &ErrorParameters="TRIM(RETURN-VALUE)"}
        RETURN "NOK":U.
    end.
    else         
        RETURN "OK":U.        
    
END PROCEDURE.

PROCEDURE findNaturOperNotaRateio :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input param c-nat-operacao like docum-est.nat-operacao no-undo.
    def input param c-serie-docto  like docum-est.serie-docto  no-undo.
    def input param c-nro-docto    like docum-est.nro-docto    no-undo.
    def input param i-cod-emitente like docum-est.cod-emitente no-undo.
    def output param l-nota-rateio like natur-oper.nota-rateio no-undo.
    
    find natur-oper
        where natur-oper.nat-operacao = c-nat-operacao no-lock no-error.
    if  avail natur-oper then do:
        if  natur-oper.nota-rateio then 
            assign l-nota-rateio = yes .
        else   
            assign l-nota-rateio = no .
    end.
    
    /** Vinculada a um nf de importacao **/
    find rat-docum
        where rat-docum.serie-docto  = c-serie-docto 
        and   rat-docum.nro-docto    = c-nro-docto   
        and   rat-docum.cod-emitente = i-cod-emitente
        and   rat-docum.nat-operacao = c-nat-operacao no-lock no-error.
    if  avail rat-docum then do:
        find emitente 
            where emitente.cod-emitente = rat-docum.nf-emitente no-lock no-error.
        if  avail emitente
        and emitente.natureza > 2 then
            return "OK":U.
        else
            return "NOK":U.
    end.
    else 
       return "NOK":U.
    
END PROCEDURE.

PROCEDURE atualizaEmbarqueImp:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    define input parameter c-serie-docto  like docum-est.serie-docto  no-undo.
    define input parameter c-nro-docto    like docum-est.nro-docto    no-undo.
    define input parameter i-cod-emitente like docum-est.cod-emitente no-undo.
    define input parameter c-nat-operacao like docum-est.nat-operacao no-undo.
    
    if param-global.modulo-07 then do:
            find first bf{&TableName} 
                where bf{&TableName}.serie-docto  = c-serie-docto 
                and   bf{&TableName}.nro-docto    = c-nro-docto   
                and   bf{&TableName}.cod-emitente = i-cod-emitente
                and   bf{&TableName}.nat-operacao = c-nat-operacao no-lock no-error.
                
            run repositionRecord in this-procedure (input rowid(bf{&TableName})).
            
            if return-value = "OK" then do:
                find natur-oper
                    where natur-oper.nat-operacao = bf{&TableName}.nat-operacao no-lock no-error.
                if avail natur-oper 
                    and natur-oper.nota-rateio then do:
                    /*Apenas quando emitente = trading ou estrangeiro*/ 
                    for first rat-docum 
                        where rat-docum.serie-docto   = bf{&TableName}.serie-docto
                          and rat-docum.nro-docto     = bf{&TableName}.nro-docto
                          and rat-docum.cod-emitente  = bf{&TableName}.cod-emitente
                          and rat-docum.nat-operacao  = bf{&TableName}.nat-operacao no-lock:
                          if can-find(first emitente         
                                      where emitente.cod-emitente = rat-docum.nf-emitente
                                        and emitente.natureza     >= 3 no-lock) then do:
                             find first bf{&TableName} 
                                 where bf{&TableName}.serie-docto  = c-serie-docto 
                                 and   bf{&TableName}.nro-docto    = c-nro-docto   
                                 and   bf{&TableName}.cod-emitente = i-cod-emitente
                                 and   bf{&TableName}.nat-operacao = c-nat-operacao exclusive-lock no-error.
                             if avail bf{&TableName} then do:
                                assign overlay(bf{&TableName}.char-1,1,12) = bf{&TableName}.nro-docto.
				release bf{&TableName}.
			     end.
                          end.   
                    end.
                end.
            end.
    end.
                 
    return "OK".

END PROCEDURE.

PROCEDURE findEstabelecNotaRateio :
/*------------------------------------------------------------------------------ 
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input  param c-nat-operacao like docum-est.nat-operacao no-undo.
    def input  param c-serie-docto  like docum-est.serie-docto  no-undo.
    def input  param c-nro-docto    like docum-est.nro-docto    no-undo.
    def input  param i-cod-emitente like docum-est.cod-emitente no-undo.
    def output param c-estab        LIKE docum-est.cod-estabel  no-undo.
    
    FIND FIRST bf{&TableName}
         WHERE bf{&TableName}.nat-operacao = c-nat-operacao
           AND bf{&TableName}.serie-docto  = c-serie-docto
           AND bf{&TableName}.nro-docto    = c-nro-docto
           AND bf{&TableName}.cod-emitente = i-cod-emitente NO-LOCK NO-ERROR.
      IF AVAIL bf{&TableName} THEN
        ASSIGN c-estab = bf{&TableName}.cod-estabel.
    

END PROCEDURE.
