&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getCharField DBOProgram 
PROCEDURE getCharField :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valor de campos do tipo caracter
  Parameters:  
               recebe nome do campo
               retorna valor do campo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pFieldName AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldValue AS CHARACTER NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
        RETURN "NOK":U.

    CASE pFieldName:
        WHEN "char-1":U THEN ASSIGN pFieldValue = RowObject.char-1.
        WHEN "char-2":U THEN ASSIGN pFieldValue = RowObject.char-2.
        WHEN "check-sum":U THEN ASSIGN pFieldValue = RowObject.check-sum.
        WHEN "cod-estabel":U THEN ASSIGN pFieldValue = RowObject.cod-estabel.
        WHEN "hora-fin[1]":U THEN ASSIGN pFieldValue = RowObject.hora-fin[1].
        WHEN "hora-fin[2]":U THEN ASSIGN pFieldValue = RowObject.hora-fin[2].
        WHEN "hora-fin[3]":U THEN ASSIGN pFieldValue = RowObject.hora-fin[3].
        WHEN "hora-fin[4]":U THEN ASSIGN pFieldValue = RowObject.hora-fin[4].
        WHEN "hora-fin[5]":U THEN ASSIGN pFieldValue = RowObject.hora-fin[5].
        WHEN "hora-fin[6]":U THEN ASSIGN pFieldValue = RowObject.hora-fin[6].
        WHEN "hora-fin[7]":U THEN ASSIGN pFieldValue = RowObject.hora-fin[7].
        WHEN "hora-fin[8]":U THEN ASSIGN pFieldValue = RowObject.hora-fin[8].
        WHEN "hora-ini[1]":U THEN ASSIGN pFieldValue = RowObject.hora-ini[1].
        WHEN "hora-ini[2]":U THEN ASSIGN pFieldValue = RowObject.hora-ini[2].
        WHEN "hora-ini[3]":U THEN ASSIGN pFieldValue = RowObject.hora-ini[3].
        WHEN "hora-ini[4]":U THEN ASSIGN pFieldValue = RowObject.hora-ini[4].
        WHEN "hora-ini[5]":U THEN ASSIGN pFieldValue = RowObject.hora-ini[5].
        WHEN "hora-ini[6]":U THEN ASSIGN pFieldValue = RowObject.hora-ini[6].
        WHEN "hora-ini[7]":U THEN ASSIGN pFieldValue = RowObject.hora-ini[7].
        WHEN "hora-ini[8]":U THEN ASSIGN pFieldValue = RowObject.hora-ini[8].
        WHEN "turno[1]":U THEN ASSIGN pFieldValue = RowObject.turno[1].
        WHEN "turno[2]":U THEN ASSIGN pFieldValue = RowObject.turno[2].
        WHEN "turno[3]":U THEN ASSIGN pFieldValue = RowObject.turno[3].
        WHEN "turno[4]":U THEN ASSIGN pFieldValue = RowObject.turno[4].
        WHEN "turno[5]":U THEN ASSIGN pFieldValue = RowObject.turno[5].
        WHEN "turno[6]":U THEN ASSIGN pFieldValue = RowObject.turno[6].
        WHEN "turno[7]":U THEN ASSIGN pFieldValue = RowObject.turno[7].
        WHEN "turno[8]":U THEN ASSIGN pFieldValue = RowObject.turno[8].
        OTHERWISE RETURN "NOK":U.
    END CASE.

    RETURN "OK":U.
END PROCEDURE.

