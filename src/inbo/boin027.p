&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice estab-dt
  Parameters:  
               recebe valor do campo cod-estabel
               recebe valor do campo data
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-estabel LIKE calen-prod.cod-estabel NO-UNDO.
    DEFINE INPUT PARAMETER pdata LIKE calen-prod.data NO-UNDO.

    FIND FIRST bfcalen-prod WHERE 
        bfcalen-prod.cod-estabel = pcod-estabel AND 
        bfcalen-prod.data = pdata NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfcalen-prod THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfcalen-prod)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryCalendarioWMS DBOProgram 
PROCEDURE openQueryCalendarioWMS :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
OPEN QUERY {&QueryName} FOR EACH calen-prod NO-LOCK
    WHERE calen-prod.cod-estabel >= c-cod-estabel-ini
      AND calen-prod.cod-estabel <= c-cod-estabel-fim
      AND calen-prod.data        >= d-data-ini
      AND calen-prod.data        <= d-data-fim INDEXED-REPOSITION.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryMain DBOProgram 
PROCEDURE openQueryMain :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
OPEN QUERY {&QueryName} FOR EACH {&TableName} NO-LOCK INDEXED-REPOSITION.
RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE setConstraintCalendarioWMS DBOProgram 
PROCEDURE setConstraintCalendarioWMS :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
DEFINE INPUT PARAM pcod-estabel-ini AS CHARACTER NO-UNDO.
DEFINE INPUT PARAM pcod-estabel-fim AS CHARACTER NO-UNDO.
DEFINE INPUT PARAM pdata-ini        AS DATE      NO-UNDO.
DEFINE INPUT PARAM pdata-fim        AS DATE      NO-UNDO.

    ASSIGN c-cod-estabel-ini = pcod-estabel-ini
           c-cod-estabel-fim = pcod-estabel-fim
           d-data-ini        = pdata-ini
           d-data-fim        = pdata-fim.

    RETURN "OK":U.
END PROCEDURE.

