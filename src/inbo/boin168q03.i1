/****************************************************************************
** BOIN168Q03.I1 - Verifica a primeira e a ultima solicitacao do comprador **
**                 a ser demonstrada no browser "Solicitacao" - programa   **
**                 WCC0523                                                 **
****************************************************************************/

/***********************************************************************************************************************/
/***********************************************************************************************************************/
/******** PROCESSO QUE BUSCA O ROWID DO éLTIMO ITEM DA éLTIMA REQUISI€ÇO VµLIDA PARA A PESQUISA DO WCC0523. ************/
/***********************************************************************************************************************/
/***********************************************************************************************************************/

FOR LAST b-requisicao
   WHERE b-requisicao.situacao       = 1
     AND b-requisicao.tp-requis     >  1
     AND b-requisicao.nr-requisicao >= p-nr-requisicao-ini
     AND b-requisicao.nr-requisicao <= p-nr-requisicao-fim
     AND b-requisicao.cod-estabel   >= p-cod-estabel-ini
     AND b-requisicao.cod-estabel   <= p-cod-estabel-fim
     AND b-requisicao.dt-requisicao >= p-dt-requisicao-ini
     AND b-requisicao.dt-requisicao <= p-dt-requisicao-fim
     AND b-requisicao.nome-abrev    >= p-nome-abrev-ini
     AND b-requisicao.nome-abrev    <= p-nome-abrev-fim NO-LOCK: END. /*Posiciona na £ltima requisicao*/

IF AVAIL b-requisicao THEN
    FOR LAST b-it-requisicao
       WHERE b-it-requisicao.nr-requisicao = b-requisicao.nr-requisicao
         AND b-it-requisicao.it-codigo  >= p-it-codigo-ini
         AND b-it-requisicao.it-codigo  <= p-it-codigo-fim
         AND b-it-requisicao.situacao   <> 4
         AND b-it-requisicao.situacao   <> 2
         AND b-it-requisicao.estado      = 1
         AND b-it-requisicao.dt-entrega >= p-dt-previsao-ini
         AND b-it-requisicao.dt-entrega <= p-dt-previsao-fim NO-LOCK: END. /*Posiciona no £ltimo item da requisi‡Æo*/


DO WHILE l-achou-last = NO: /*Enquanto recebe "NO" o registro nÆo ‚ valido*/
    l-achou-last = YES.

    IF AVAIL b-it-requisicao THEN DO:

        FOR FIRST ITEM FIELDS(cod-comprado 
                              it-codigo 
                              narrativa 
                              tipo-contr
                              fm-codigo
                              desc-item) 
            WHERE item.it-codigo = b-it-requisicao.it-codigo NO-LOCK: END. /*Posiciona no item da it-requisicao corrente.*/

        /*Verifica se existe alguma informa‡Æo referente ao codigo do comprador.*/
        IF SUBSTRING(b-it-requisicao.char-1,2,12) <> "" THEN DO:

            /*Posiciona nas informa‡äes do comprador referente ao item da it-requisi‡Æo corrente.*/
            FOR FIRST comprador FIELDS(cod-comprado)
                WHERE comprador.cod-comprado = SUBSTRING(b-it-requisicao.char-1,2,12) NO-LOCK: END.

            /*Verifica se a vari vel esta setada como YES, caso nÆo, impede que o valor seja alterado e registros inv lidos sejam considerados.*/
            IF l-achou-last AND AVAIL comprador THEN
                ASSIGN l-achou-last = comprador.cod-comprado = p-cod-comprado. /*Verifica se o c¢digo comprador tratado ‚ igual ao passado como parametro no WCC0523.*/

            /*Verifica se a vari vel esta setada como YES, caso nÆo, impede que o valor seja alterado e registros inv lidos sejam considerados.*/
            IF l-achou-last THEN
                ASSIGN l-achou-last = SUBSTRING(b-it-requisicao.char-1,2,12) = p-cod-comprado. /*Verifica se o c¢digo comprador tratado ‚ igual ao passado como parametro no WCC0523.*/
        END.
        ELSE DO:
            FOR FIRST item-uni-estab FIELDS(cod-estabel
                                            it-codigo
                                            cod-comprado)
                WHERE item-uni-estab.cod-estabel = b-requisicao.cod-estabel
                  AND item-uni-estab.it-codigo   = b-it-requisicao.it-codigo NO-LOCK: END. /*Posiciona no item-uni-estab da it-requisi‡Æo corrente.*/

            IF AVAIL item-uni-estab THEN DO:
                /*Verifica se a vari vel esta setada como YES, caso nÆo, impede que o valor seja alterado e registros inv lidos sejam considerados.*/
                IF l-achou-last THEN
                    ASSIGN l-achou-last = item-uni-estab.cod-comprado = p-cod-comprado. /*Verifica se o c¢digo do comprador tratado ‚ igual ao passado como parametro no WCC0523.*/
            END.
            /*Verifica se a vari vel esta setada como YES, caso nÆo, impede que o valor seja alterado e registros inv lidos sejam considerados.*/
            ELSE IF l-achou-last AND AVAIL item THEN
                    ASSIGN l-achou-last = item.cod-comprado = p-cod-comprado. /*Verifica se o c¢digo do comprador tratado ‚ igual ao passado como parametro no WCC0523.*/
        END.

        /*Verifica se a vari vel esta setada como YES, caso nÆo, impede que o valor seja alterado e registros inv lidos sejam considerados.*/
        IF l-achou-last THEN
            ASSIGN l-achou-last = CAN-FIND(FIRST familia
                                           WHERE familia.fm-codigo  = item.fm-codigo
                                             AND familia.fm-codigo >= p-familia-ini
                                             AND familia.fm-codigo <= p-familia-fim). /*Verifica se o item da it-requisi‡Æo corrente possui fam¡lia.*/

        IF l-achou-last THEN DO:
            ASSIGN i-tp-ressup = 1.
            RUN cdp/cd1406a2.p (INPUT  b-it-requisicao.it-codigo,
                                INPUT  b-requisicao.cod-estabel,
                                OUTPUT i-tp-ressup).
            /*Para conta contabil igual a "" (branco) e tp-ressup diferente de dois, o registro nÆo ‚ valido.*/
            ASSIGN l-achou-last = (b-it-requisicao.ct-codigo + b-it-requisicao.sc-codigo) <> "" OR i-tp-ressup = 2. /*Se ao menos uma for verdade, assume YES.*/
        END.

        IF l-achou-last THEN DO:
           /************** In¡cio EPC Grendene ***************************************/
           FOR EACH  tt-epc 
               WHERE tt-epc.cod-event = "ValidaRegistro":U:
               DELETE tt-epc.
           END.
           /************** Chamada EPC ***********************************************/
           CREATE tt-epc.
           ASSIGN tt-epc.cod-event     = "ValidaRegistro":U
                  tt-epc.cod-parameter = "NrSolicitacao":U
                  tt-epc.val-parameter = STRING(b-it-requisicao.nr-requisicao).

           CREATE tt-epc.
           ASSIGN tt-epc.cod-event     = "ValidaRegistro":U
                  tt-epc.cod-parameter = "rowidItRequisicao":U
                  tt-epc.val-parameter = STRING(ROWID(b-it-requisicao)).

           {include/i-epc201.i "ValidaRegistro"}

           FIND FIRST tt-epc
                WHERE tt-epc.cod-event     = "ValidaRegistro":U
                AND   tt-epc.cod-parameter = "retornoValida":U NO-LOCK NO-ERROR.

           IF AVAIL tt-epc THEN DO:
               IF tt-epc.val-parameter = "NO" THEN 
                  ASSIGN l-achou-first = NO.
           END.
           /************** Fim EPC Grendene ******************************************/
        END.

        /*Para valor igual a "NO" ‚ necess rio verificar o registro anterior, pois esse corrente nÆo ‚ valido para o resultado esperado pela pesquisa.*/
        IF NOT l-achou-last THEN 
            FIND PREV b-it-requisicao 
                WHERE b-it-requisicao.nr-requisicao = b-requisicao.nr-requisicao
                  AND b-it-requisicao.it-codigo  >= p-it-codigo-ini
                  AND b-it-requisicao.it-codigo  <= p-it-codigo-fim
                  AND b-it-requisicao.situacao   <> 4
                  AND b-it-requisicao.situacao   <> 2 
                  AND b-it-requisicao.estado      = 1
                  AND b-it-requisicao.dt-entrega >= p-dt-previsao-ini
                  AND b-it-requisicao.dt-entrega <= p-dt-previsao-fim NO-LOCK NO-ERROR. /*Posiciona no item anterior, da requisi‡Æo corrente.*/
        ELSE
            ASSIGN r-rowid-last = ROWID(b-it-requisicao). /*Encontrou o £ltimo registro.*/
    END. /*IF AVAIL b-it-requisicao*/

    /*Verifica se a busca pelo item anterior, da requisi‡Æo corrente, retornou algum registro. Caso nÆo, ‚ neccess rio procurar a requisi‡Æo anterior.*/
    IF NOT AVAIL b-it-requisicao THEN DO: 
        ASSIGN l-achou-last = NO.
        FIND PREV b-requisicao 
            WHERE b-requisicao.situacao       = 1
              AND b-requisicao.tp-requis      > 1
              AND b-requisicao.nr-requisicao >= p-nr-requisicao-ini 
              AND b-requisicao.nr-requisicao <= p-nr-requisicao-fim
              AND b-requisicao.cod-estabel   >= p-cod-estabel-ini
              AND b-requisicao.cod-estabel   <= p-cod-estabel-fim
              AND b-requisicao.dt-requisicao >= p-dt-requisicao-ini
              AND b-requisicao.dt-requisicao <= p-dt-requisicao-fim
              AND b-requisicao.nome-abrev    >= p-nome-abrev-ini
              AND b-requisicao.nome-abrev    <= p-nome-abrev-fim NO-LOCK NO-ERROR.

        IF AVAIL b-requisicao THEN
            FIND LAST b-it-requisicao
                WHERE b-it-requisicao.nr-requisicao  = b-requisicao.nr-requisicao
                  AND b-it-requisicao.it-codigo     >= p-it-codigo-ini
                  AND b-it-requisicao.it-codigo     <= p-it-codigo-fim
                  AND b-it-requisicao.situacao      <> 4
                  AND b-it-requisicao.situacao      <> 2
                  AND b-it-requisicao.estado         = 1
                  AND b-it-requisicao.dt-entrega    >= p-dt-previsao-ini
                  AND b-it-requisicao.dt-entrega    <= p-dt-previsao-fim NO-LOCK NO-ERROR. /*Posiciona no £ltimo item da requisi‡Æo corrente.*/
        ELSE
            LEAVE. /*Caso a busca pela requisi‡Æo anterior nÆo encontre nada, sai do bloco.*/
    END. /*IF NOT AVAIL b-it-requisicao*/
END. /*DO WHILE l-achou-last*/

/***********************************************************************************************************************/
/****** FIM DO PROCESSO QUE BUSCA O ROWID DO éLTIMO ITEM DA éLTIMA REQUISI€ÇO VµLIDA PARA A PESQUISA DO WCC0523. *******/
/***********************************************************************************************************************/
/***********************************************************************************************************************/
/******** PROCESSO QUE BUSCA O ROWID DO PRIMEIRO ITEM DA PRIMEIRA REQUISI€ÇO VµLIDA PARA A PESQUISA DO WCC0523. ********/
/***********************************************************************************************************************/
/***********************************************************************************************************************/

FIND FIRST b-requisicao
     WHERE b-requisicao.situacao       = 1
       AND b-requisicao.tp-requis     >  1
       AND b-requisicao.nr-requisicao >= p-nr-requisicao-ini
       AND b-requisicao.nr-requisicao <= p-nr-requisicao-fim
       AND b-requisicao.cod-estabel   >= p-cod-estabel-ini
       AND b-requisicao.cod-estabel   <= p-cod-estabel-fim
       AND b-requisicao.dt-requisicao >= p-dt-requisicao-ini
       AND b-requisicao.dt-requisicao <= p-dt-requisicao-fim
       AND b-requisicao.nome-abrev    >= p-nome-abrev-ini
       AND b-requisicao.nome-abrev    <= p-nome-abrev-fim NO-LOCK NO-ERROR. /*Posiciona na primeira requisi‡Æo.*/

IF AVAIL b-requisicao THEN
    FIND FIRST b-it-requisicao
         WHERE b-it-requisicao.nr-requisicao  = b-requisicao.nr-requisicao
           AND b-it-requisicao.it-codigo     >= p-it-codigo-ini
           AND b-it-requisicao.it-codigo     <= p-it-codigo-fim
           AND b-it-requisicao.situacao      <> 4
           AND b-it-requisicao.situacao      <> 2
           AND b-it-requisicao.estado         = 1
           AND b-it-requisicao.dt-entrega    >= p-dt-previsao-ini
           AND b-it-requisicao.dt-entrega    <= p-dt-previsao-fim NO-LOCK NO-ERROR. /*Posiciona no primeiro item da requisi‡Æo corrente.*/

DO WHILE l-achou-first = NO: /*Enquanto recebe "NO" o registro nÆo ‚ valido*/
    l-achou-first = YES.
    IF AVAIL b-it-requisicao THEN DO:
        FOR FIRST item FIELDS(cod-comprado
                              it-codigo
                              narrativa
                              tipo-contr
                              fm-codigo
                              desc-item)
            WHERE item.it-codigo = b-it-requisicao.it-codigo NO-LOCK: END. /*Posiciona no item da it-requisicao corrente.*/

        /*Verifica se existe alguma informa‡Æo referente ao codigo do comprador.*/
        IF SUBSTRING(b-it-requisicao.char-1,2,12) <> "" THEN DO:

            /*Posiciona nas informa‡äes do comprador referente ao item da it-requisi‡Æo corrente.*/
            FOR FIRST comprador FIELDS(cod-comprado)
                WHERE comprador.cod-comprado = SUBSTRING(b-it-requisicao.char-1,2,12) NO-LOCK: END.

            /*Verifica se a vari vel esta setada como YES, caso nÆo, impede que o valor seja alterado e registros inv lidos sejam considerados.*/
            IF l-achou-first AND AVAIL comprador THEN
                ASSIGN l-achou-first = comprador.cod-comprado = p-cod-comprado. /*Verifica se o c¢digo do comprador tratado ‚ igual ao passado como parametro no WCC0523.*/

            /*Verifica se a vari vel esta setada como YES, caso nÆo, impede que o valor seja alterado e registros inv lidos sejam considerados.*/
            IF l-achou-first THEN 
                ASSIGN l-achou-first = SUBSTRING(b-it-requisicao.char-1,2,12) = p-cod-comprado. /*Verifica se o c¢digo do comprador tratado ‚ igual ao passado como parametro no WCC0523.*/
        END.

        ELSE DO:
            FOR FIRST item-uni-estab FIELDS(cod-estabel
                                            it-codigo
                                            cod-comprado)
                WHERE item-uni-estab.cod-estabel = b-requisicao.cod-estabel
                  AND item-uni-estab.it-codigo   = b-it-requisicao.it-codigo NO-LOCK: END. /*Posiciona no item-uni-estab da it-requisi‡Æo corrente.*/

            IF AVAIL item-uni-estab THEN DO:
                /*Verifica se a vari vel esta setada como YES, caso nÆo, impede que o valor seja alterado e registros inv lidos sejam considerados.*/
                IF l-achou-first THEN
                    ASSIGN l-achou-first = item-uni-estab.cod-comprado = p-cod-comprado. /*Verifica se o c¢digo do comprador tratado ‚ igual ao passado como parametro no WCC0523.*/
            END.
            /*Verifica se a vari vel esta setada como YES, caso nÆo, impede que o valor seja alterado e registros inv lidos sejam considerados.*/
            ELSE IF l-achou-first AND AVAIL item THEN
                ASSIGN l-achou-first = item.cod-comprado = p-cod-comprado. /*Verifica se o c¢digo do comprador tratado ‚ igual ao passado como parametro no WCC0523.*/
        END.

        /*Verifica se a vari vel esta setada como YES, caso nÆo, impede que o valor seja alterado e registros inv lidos sejam considerados.*/
        IF l-achou-first THEN
            ASSIGN l-achou-first = CAN-FIND(FIRST familia 
                                            WHERE familia.fm-codigo  = item.fm-codigo 
                                              AND familia.fm-codigo >= p-familia-ini
                                              AND familia.fm-codigo <= p-familia-fim). /*Verifica se o item da it-requisi‡Æo corrente possui fam¡lia.*/

        IF l-achou-first THEN DO:
            ASSIGN i-tp-ressup = 1.
            RUN cdp/cd1406a2.p (INPUT  b-it-requisicao.it-codigo,
                                INPUT  b-requisicao.cod-estabel,
                                OUTPUT i-tp-ressup).
            /*Para conta contabil igual a "" (branco) e tp-ressup diferente de dois, o registro nÆo ‚ valido.*/
            ASSIGN l-achou-first = (b-it-requisicao.ct-codigo + b-it-requisicao.sc-codigo) <> "" or i-tp-ressup = 2. /*Se ao menos uma for verdade, assume YES.*/
        END.

        IF l-achou-first THEN DO:
            /************** In¡cio EPC Grendene ***************************************/
            FOR EACH  tt-epc 
                WHERE tt-epc.cod-event = "ValidaRegistro":U:
                DELETE tt-epc.
            END.
            /************** Chamada EPC ***********************************************/
            CREATE tt-epc.
            ASSIGN tt-epc.cod-event     = "ValidaRegistro":U
                   tt-epc.cod-parameter = "NrSolicitacao":U
                   tt-epc.val-parameter = STRING(b-it-requisicao.nr-requisicao).

            CREATE tt-epc.
            ASSIGN tt-epc.cod-event     = "ValidaRegistro":U
                   tt-epc.cod-parameter = "rowidItRequisicao":U
                   tt-epc.val-parameter = STRING(ROWID(b-it-requisicao)).

            {include/i-epc201.i "ValidaRegistro"}

            FIND FIRST tt-epc
                 WHERE tt-epc.cod-event     = "ValidaRegistro":U
                 AND   tt-epc.cod-parameter = "retornoValida":U NO-LOCK NO-ERROR.

            IF AVAIL tt-epc THEN DO:
                IF tt-epc.val-parameter = "NO" THEN 
                   ASSIGN l-achou-first = NO.
            END.
            /************** Fim EPC Grendene ******************************************/
        END.
        /*Verifica se a vari vel esta setada como YES, caso nÆo, impede que o valor seja alterado e registros inv lidos sejam considerados.*/
        IF NOT l-achou-first THEN
            FIND NEXT b-it-requisicao 
                WHERE b-it-requisicao.nr-requisicao = b-requisicao.nr-requisicao
                  AND b-it-requisicao.it-codigo  >= p-it-codigo-ini
                  AND b-it-requisicao.it-codigo  <= p-it-codigo-fim
                  AND b-it-requisicao.situacao   <> 4
                  AND b-it-requisicao.situacao   <> 2
                  AND b-it-requisicao.estado      = 1
                  AND b-it-requisicao.dt-entrega >= p-dt-previsao-ini
                  AND b-it-requisicao.dt-entrega <= p-dt-previsao-fim NO-LOCK NO-ERROR. /*Posiciona no item posterior, da requisi‡Æo corrente.*/
        ELSE 
            ASSIGN r-rowid-first = ROWID(b-it-requisicao). /*Encontrou o primeiro registro.*/       

    END. /*IF AVAIL b-it-requisicao*/

    /*Verifica se a busca pelo item posterior, da requisi‡Æo corrente, retornou algum registro. Caso nÆo, ‚ neccess rio procurar a requisi‡Æo posterior.*/
    IF NOT AVAIL b-it-requisicao THEN DO: 
        ASSIGN l-achou-first = NO.
        FIND NEXT b-requisicao
            WHERE b-requisicao.situacao       = 1
              AND b-requisicao.tp-requis      > 1
              AND b-requisicao.nr-requisicao >= p-nr-requisicao-ini
              AND b-requisicao.nr-requisicao <= p-nr-requisicao-fim
              AND b-requisicao.cod-estabel   >= p-cod-estabel-ini
              AND b-requisicao.cod-estabel   <= p-cod-estabel-fim
              AND b-requisicao.dt-requisicao >= p-dt-requisicao-ini
              AND b-requisicao.dt-requisicao <= p-dt-requisicao-fim
              AND b-requisicao.nome-abrev    >= p-nome-abrev-ini
              AND b-requisicao.nome-abrev    <= p-nome-abrev-fim NO-LOCK NO-ERROR.

        IF AVAIL b-requisicao  THEN
            FIND FIRST b-it-requisicao
                 WHERE b-it-requisicao.nr-requisicao  = b-requisicao.nr-requisicao
                   AND b-it-requisicao.it-codigo     >= p-it-codigo-ini
                   AND b-it-requisicao.it-codigo     <= p-it-codigo-fim
                   AND b-it-requisicao.situacao      <> 4
                   AND b-it-requisicao.situacao      <> 2
                   AND b-it-requisicao.estado         = 1
                   AND b-it-requisicao.dt-entrega    >= p-dt-previsao-ini
                   AND b-it-requisicao.dt-entrega    <= p-dt-previsao-fim NO-LOCK NO-ERROR. /*Posiciona no primeiro item da requisi‡Æo corrente.*/
        ELSE
            LEAVE. /*Caso a busca pela requisi‡Æo posterior nÆo encontre nada, sai do bloco.*/
    END. /*IF NOT AVAIL b-it-requisicao*/
END. /*DO WHILE l-achou-first*/   

/***********************************************************************************************************************/
/**** FIM DO PROCESSO QUE BUSCA O ROWID DO PRIMEIRO ITEM DA PRIMEIRA REQUISI€ÇO VµLIDA PARA A PESQUISA DO WCC0523. *****/
/***********************************************************************************************************************/

/* fim da include */
