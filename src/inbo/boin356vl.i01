/********************************************************************************
**  Programa: BOIN356VL.I01                                                    **
**  Data....: 25.05.2004 11:26 - Miranda                                       **
**  Autor...: CINGO - Desenvolvimento de Sistemas Sob Encomenda                **
**  Objetivo: Integracao Compras - Importacao x MRP                            **
**            Verifica se a ordem de compra esta vinculada a um processo de    **
**            importacao com acompanhamento. Caso estiver, a parcela em ques-  **
**            tao sera setada para nao ser reprogramada pelo MRP               **
********************************************************************************/

IF  NOT l-acesso-bocx150 THEN DO:
    
    IF  NOT VALID-HANDLE(h-bocx150)               OR
        h-bocx150:TYPE      <> "PROCEDURE":U      OR
        h-bocx150:FILE-NAME <> "cxbo/bocx150.p":U THEN DO:
        RUN cxbo/bocx150.p PERSISTENT SET h-bocx150.
    END.

    RUN buscaHistorico IN h-bocx150 (INPUT  ordem-compra.num-pedido,
                                     OUTPUT l-acompanhamento).

    IF  VALID-HANDLE(h-bocx150) THEN DO:
        DELETE PROCEDURE h-bocx150.
        ASSIGN h-bocx150        = ?
               l-acesso-bocx150 = YES.
    END.
END.

IF  l-acesso-bocx150   AND
    l-acompanhamento   AND
    AVAIL prazo-compra THEN DO:
    ASSIGN prazo-compra.int-2 = 2.
END.

