PROCEDURE calculateNumberInvoice :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def output param pc-nro-docto as character  no-undo.
    

    assign pc-nro-docto = left-trim(RowObject.nro-docto).
    

    /* EPC GRENDENE PARA NÇO RENUMERAR NOTA FISCAL */
    {method/svc/custom/custom.i &Event = "beforeCalculateNumberInvoice"}        
    if  return-value = "NOK":U then do:
        return.
    end.
    


    for first serie
        fields ( serie.forma-emis ) 
        where serie.serie = RowObject.serie-docto no-lock .
    end.
    

    /*=========== SuperGasbras/MinasG s ==================*/
      ASSIGN i-forma-emis = IF AVAIL serie THEN serie.forma-emis ELSE 0.
    

      &IF DEFINED(BF_dis_serie_estab) &THEN
          IF CAN-FIND(funcao WHERE
                      funcao.cd-funcao = "fn-estab-forma-emis" AND
                      funcao.ativo     = YES) THEN DO:
    

             RUN cdp/cd8700.p (INPUT RowObject.cod-estabel,
                               INPUT RowObject.serie-docto,
                               INPUT-OUTPUT i-forma-emis).
          END.
      &ENDIF
    /*====================================================*/
    

    if  i-forma-emis = 1 then do:
        

        for first ser-estab
            fields ( nr-ult-nota ind-prox-dt dt-prox-fat dt-ult-fat )
            where ser-estab.serie       = RowObject.serie-docto 
              and ser-estab.cod-estabel = RowObject.cod-estabel no-lock .
        end.              
        

        if  not avail ser-estab then do:
            {method/svc/errors/inserr.i
                                &ErrorNumber="6514"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U}
            RETURN "NOK":U.
        end.
                                                    
        if RowObject.declaracao-import = "" then
            assign pc-nro-docto = string(dec(ser-estab.nr-ult-nota) + 1).

        find bf{&TableName}
            where bf{&TableName}.serie-docto  = RowObject.serie-docto
              and bf{&TableName}.nro-docto    = left-trim(string(dec(pc-nro-docto), c-formato ))
              and bf{&TableName}.cod-emitente = RowObject.cod-emitente
              and bf{&TableName}.nat-operacao = RowObject.nat-operacao
              and bf{&TableName}.declaracao-import = "" /*O campo declaracao-import foi incluso nessa leitura pois esta valida‡Æo nÆo ‚ necess ria quando ‚ uma nota com DI*/
            no-lock no-error.
        if  avail bf{&TableName} then do:        
            {method/svc/errors/inserr.i
                                &ErrorNumber="17218"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U
                                &ErrorParameters= " string(RowObject.cod-emitente) + '~~~~' + 
                                                   RowObject.serie-docto + '~~~~' +
                                                   left-trim(string(dec(pc-nro-docto), c-formato )) + '~~~~' +
                                                   RowObject.nat-operacao " }
        end.                            

        if  ser-estab.ind-prox-dt 
        and RowObject.dt-trans > ser-estab.dt-prox-fat then do:
            {method/svc/errors/inserr.i
                                &ErrorNumber="6218"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U }
        end.

        if  RowObject.dt-trans < ser-estab.dt-ult-fat then do:
            {method/svc/errors/inserr.i
                                &ErrorNumber="6495"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U }
        end.
        

        if  RowObject.dt-trans > ser-estab.dt-ult-fat then do:
            {method/svc/errors/inserr.i
                                &ErrorNumber="5135"
                                &ErrorType="EMS":U
                                &ErrorSubType="WARNING":U }
        end.        
 

        if  RowObject.nro-docto <> left-trim(string(dec(pc-nro-docto),c-formato)) then do:
            {method/svc/errors/inserr.i
                                &ErrorNumber="5268"
                                &ErrorType="EMS":U
                                &ErrorSubType="WARNING":U 
                                &ErrorParameters=" RowObject.nro-docto + '~~~~' + 
                                                   left-trim(string(dec(pc-nro-docto),c-formato))" }
        end.

    end.    


    IF  CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    ELSE 
        RETURN "OK":U.

END PROCEDURE.




PROCEDURE getHandleBOImpto :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def output param pi-handleBOImpostos    as handle  no-undo.
    def output param pi-seq-tb-wt-docto     as integer no-undo.
    

    assign pi-handleBOImpostos = h_bodi317im2bra
           pi-seq-tb-wt-docto  = if  avail tb-wt-docto then 
                                     tb-wt-docto.seq-wt-docto
                                 else 1.

END PROCEDURE.




PROCEDURE habilitaembarque :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
If avail param-global 
     and param-global.modulo-07 
then Return "OK":U.
else Return "NOK":U.

END PROCEDURE.




PROCEDURE validateEmbarque :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def var l-valida-embarq as log init yes no-undo.

    {cdp/cd4300.i4 "yes" RowObject.char-1}

    If    avail param-global and 
              param-global.modulo-07 = yes 
      and avail emitente 
      and (emitente.natureza = 3 or emitente.natureza = 4)
      and avail estabelec 
      and (estabelec.pais <> emitente.pais) 
      and avail natur-oper 
      and natur-oper.nota-rateio = no 
    then do:
      if aux-c-char[1] = "":U then do:
         /* Inicio -- Projeto Internacional */
         DEFINE VARIABLE c-lbl-liter-embarque AS CHARACTER NO-UNDO.
         {utp/ut-liter.i "Embarque" *}
         ASSIGN c-lbl-liter-embarque = TRIM(RETURN-VALUE).
         {method/svc/errors/inserr.i
                      &ErrorNumber="265" /*Embarque deve ser informado*/
                      &ErrorType="EMS":U
                      &ErrorSubType="ERROR":U
                      &ErrorParameters="c-lbl-liter-embarque"}
      end.
      else do:
         if not valid-handle (h_bocx220) then
            run cxbo/bocx220.p persistent set h_bocx220.
         run findPK_codigo in h_bocx220 (input Rowobject.cod-estabel, 
                                         input aux-c-char[1], 
                                         output c-return).
         if valid-handle (h_bocx220) then do:
             delete procedure h_bocx220.
             assign h_bocx220 = ?.
         end.
         
         &IF '{&BF_MAT_VERSAO_EMS}' >= '2.062' &THEN
             if RowObject.origem = "I" and l-ems2-imp-mexico then
                 assign l-valida-embarq = no.
             else do:
                 IF  i-pais-impto-usuario = 1 THEN
                     assign l-valida-embarq = yes.
                 ELSE
                     assign l-valida-embarq = NO.
             end.
         &ENDIF

         if l-valida-embarq and 
            c-return = "":U 
            and RowObject.declaracao-import = "" then do:
             /* Inicio -- Projeto Internacional */
             DEFINE VARIABLE c-lbl-liter-embarque-2 AS CHARACTER NO-UNDO.
             {utp/ut-liter.i "Embarque" *}
             ASSIGN c-lbl-liter-embarque-2 = TRIM(RETURN-VALUE).
             {method/svc/errors/inserr.i
                         &ErrorNumber="8" /*Embarque j  Cadastrado*/
                         &ErrorType="EMS":U
                         &ErrorSubType="ERROR":U 
                         &ErrorParameters="c-lbl-liter-embarque-2"}                                                  
         end.
         
         if  can-find(funcao where funcao.cd-funcao = "adm-apb-ems-5.00" 
                               AND funcao.ativo = yes 
                               AND funcao.log-1 = yes) THEN
            IF LENGTH(trim(aux-c-char[1])) > 16 THEN DO:
                {utp/ut-liter.i Embarque * L} 
                {method/svc/errors/inserr.i
                             &ErrorNumber="27336" /*numero do embaque nao pode ser superior a 16 digitos*/
                             &ErrorType="EMS":U
                             &ErrorSubType="ERROR":U 
                             &ErrorParameters=" trim(return-value) + '~~~~' + '16' "}

            END.         
      end.      
    end. 

END PROCEDURE.




PROCEDURE verificaModuloImp :
    /*
    ** Integracao Modulo Importacao
    ** Objetivo: Verifica se o documento foi gerado pelo M¢dulo de Importa‡Æo
    ** l-fornec-fundap -> identifica se estÿ ocorrendo FUNDAP
    */
    
    assign l-fornec-fundap = no.
    
    IF avail param-global and
             param-global.modulo-07 THEN DO:
      IF AVAIL RowObject THEN DO:
          {cdp/cd4300.i4 "yes" rowobject.char-1}
          {rep/re1001a.i51 "yes"}
          IF c-embarque <> "":U THEN 
              ASSIGN l-imp = YES.
          ELSE ASSIGN l-imp = NO.
          RUN findEmitente ( INPUT RowObject.cod-emitente ).
          RUN findEstabelec ( INPUT RowObject.cod-estabel ).
          IF  RETURN-VALUE <> "OK":U THEN
            RETURN "NOK":U.  
          IF emitente.pais = estabelec.pais THEN
              ASSIGN l-fornec-fundap = YES.
      END.
    END.
    ELSE ASSIGN l-imp = NO.
    
END PROCEDURE.



procedure desabilitaBtCheckImp:
   /*
   ** Integracao Modulo Importacao
   ** Objetivo: Verifica se foi um documento gerado pelo im0100 
   ** para que seja desabilitado o botao de "recalculo do item" (re1001b2)
   */ 

   define input  parameter pc-serie-docto  like item-doc-est.serie-docto  no-undo.
   define input  parameter pc-nro-docto    like item-doc-est.nro-docto    no-undo.
   define input  parameter pi-cod-emitente like item-doc-est.cod-emitente no-undo.
   define input  parameter pc-nat-operacao like item-doc-est.nat-operacao no-undo.
   define output parameter pl-habilita     as   logical                   no-undo.

   assign pl-habilita = yes.

   find docum-est where 
        docum-est.serie-docto  = pc-serie-docto  and
        docum-est.nro-docto    = pc-nro-docto    and
        docum-est.cod-emitente = pi-cod-emitente and
        docum-est.nat-operacao = pc-nat-operacao no-lock no-error.

   if avail docum-est then do:
       find emitente where 
            emitente.cod-emitente = docum-est.cod-emitente no-lock no-error.
        
        if  avail emitente 
        and (emitente.natureza = 3 or emitente.natureza = 4) then do: /*emitente estrangeiro ou trading*/

            find natur-oper where 
                 natur-oper.nat-operacao = docum-est.nat-operacao no-lock no-error.

            {cdp/cd4300.i4 "yes" docum-est.char-1}

            assign pl-habilita = if  aux-c-char[1]          <> "":U /*embarque informado*/
                                 and docum-est.origem       = "I":U  /*documento importado*/
                                 and natur-oper.nota-rateio = no     /*natureza nao pode ser de rateio*/
                                 then no
                                 else yes.
        end.
   end.

   return "OK":U.
end procedure.

