/*****************************************************************************
** Procedure Interna.....: pi-recalcula-nmb
** Descricao.............: Rec lculo do n¡vel mais baixo do item
*****************************************************************************/
PROCEDURE pi-recalcula-nmb:
 
    /************************ Parameter Definition Begin ************************/
    def param buffer b2-item for item.
    def input parameter p-rw-table as rowid no-undo.
    
    def buffer b3-item for item.                   
    def buffer b-estrutura for estrutura.
    def buffer b-alternativo for alternativo.
    def var i-nmb as integer.
    def var i-nmb-ant as integer.
    def var i-old-nmb as integer.

    def buffer B-estr-mod-cf for estr-mod-cf. 
    def buffer b-modelo-cf   for modelo-cf.
    /************************ Procedure Begin ************************/
    assign i-nmb = -1
           i-nmb-ant = b2-item.niv-mais-bai.

    for each B-estrutura fields (es-codigo it-codigo)
        use-index ONDE-SE-USA 
        where B-estrutura.es-codigo = B2-item.it-codigo no-lock,
        first b3-item fields (it-codigo niv-mais-bai)
        where b3-item.it-codigo = b-estrutura.it-codigo no-lock:
        if  p-rw-table = rowid(b-estrutura) then 
            next.
        if  B3-item.niv-mais-bai + 1 = i-nmb-ant then 
            return.

        assign i-nmb = max(i-nmb, B3-item.niv-mais-bai).

    end.
    
    for each B-alternativo fields (al-codigo it-codigo)
        use-index ONDE-SE-USA 
        where B-alternativo.al-codigo = B2-item.it-codigo no-lock,
        first B3-item fields (it-codigo niv-mais-bai)
        where B3-item.it-codigo = B-alternativo.it-codigo no-lock:
        if p-rw-table = rowid(b-alternativo) then 
            next.
        if  B3-item.niv-mais-bai + 1 = i-nmb-ant then 
            return.
        
        assign i-nmb = max(i-nmb, B3-item.niv-mais-bai).
    end.  

    for each B-estr-mod-cf 
        where B-estr-mod-cf.it-codigo = B2-item.it-codigo no-lock:
        
        find first b-modelo-cf where
                   b-modelo-cf.mo-codigo = B-estr-mod-cf.mo-codigo no-lock no-error.
        if not available b-modelo-cf then next.           
        find b3-item 
            where b3-item.it-codigo = b-modelo-cf.item-criado no-lock no-error.
        if not available b3-item then next.
        
        if  p-rw-table = rowid(b-estr-mod-cf) then 
            next.
        if  B3-item.niv-mais-bai + 1 = i-nmb-ant then 
            return.

        assign i-nmb = max(i-nmb, B3-item.niv-mais-bai).

    end.

    assign i-nmb = i-nmb + 1.
    
    if B2-item.niv-mais-bai <> i-nmb then do:
       find current b2-item exclusive-lock.
       assign i-old-nmb            = B2-item.niv-mais-bai
              B2-item.niv-mais-bai = i-nmb.

       &if defined(bf_mat_fech_estab) &then
          /********************************************************
          ** A partir da release 2.04 o nivel mais baixo passou  **
          ** a ser replicado para a tabela 'item-estab' com o    **
          ** intuito de melhorar a performance de execucao do    **
          ** Calculo do Preco Medio                              **
          ********************************************************/
          for each item-estab where
              item-estab.it-codigo = b2-item.it-codigo exclusive-lock:
             assign item-estab.niv-mais-bai = b2-item.niv-mais-bai * -1.
          end.
       &endif
              

       for each B-estrutura fields (it-codigo es-codigo)
          where B-estrutura.it-codigo = B2-item.it-codigo no-lock,
          first B3-item fields (it-codigo niv-mais-bai)
          where B3-item.it-codigo = B-estrutura.es-codigo no-lock:
          if  p-rw-table = rowid(b-estrutura) then 
              next.
          if (B3-item.niv-mais-bai - i-old-nmb <= 1) then 
              run pi-recalcula-nmb(buffer B3-item, p-rw-table).    
       end.
       
       for each B-alternativo fields (it-codigo al-codigo)
          where B-alternativo.it-codigo = B2-item.it-codigo no-lock,
          first B3-item fields (it-codigo niv-mais-bai)
          where B3-item.it-codigo = B-alternativo.al-codigo no-lock:
          if  p-rw-table = rowid(b-alternativo) then 
              next.
          if (B3-item.niv-mais-bai - i-old-nmb <= 1) then 
              run pi-recalcula-nmb(buffer B3-item, p-rw-table).
       end.
       
       find b-modelo-cf where 
            b-modelo-cf.item-criado = B2-item.it-codigo no-lock no-error.
       if available b-modelo-cf then do:
       
           for each B-estr-mod-cf fields (it-codigo mo-codigo)
              where B-estr-mod-cf.mo-codigo = b-modelo-cf.mo-codigo no-lock,
               first B3-item fields (it-codigo niv-mais-bai)
               where B3-item.it-codigo = B-estr-mod-cf.it-codigo no-lock:
               if  p-rw-table = rowid(b-estr-mod-cf) then 
                   next.
               if (B3-item.niv-mais-bai - i-old-nmb <= 1) then 
                   run pi-recalcula-nmb(buffer B3-item, p-rw-table).    
           end.
       end.    

    end.
 
END PROCEDURE. /* pi-recalcula-nmb */        
 
