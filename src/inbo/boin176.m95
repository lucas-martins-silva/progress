/**********************************************************************
** inbo/boin176.m95 - Regrava valor STA para historico de calculo do 
** configurador de tributos
**********************************************************************/

    FIND FIRST tb-wt-docto no-lock
         WHERE tb-wt-docto.seq-wt-docto = 1 NO-ERROR.
    
    FOR EACH tb-wt-it-docto NO-LOCK 
        WHERE tb-wt-it-docto.seq-wt-it-docto = {1}.sequencia,
        EACH tb-ct-trib-wt-item-docto NO-LOCK 
        WHERE tb-ct-trib-wt-item-docto.num-seq-wt-docto      = tb-wt-it-docto.seq-wt-docto
          AND tb-ct-trib-wt-item-docto.num-seq-wt-item-docto = tb-wt-it-docto.seq-wt-it-docto
          AND tb-ct-trib-wt-item-docto.cod-tip-trib          = "COD AJUSTE":U:
    
        FOR EACH ct-trib-item-doc-est EXCLUSIVE-LOCK
            WHERE ct-trib-item-doc-est.cdn-emitente      = tb-wt-docto.cod-emitente
              AND ct-trib-item-doc-est.cod-ser-docto     = tb-wt-docto.serie
              AND ct-trib-item-doc-est.cod-docto         = tb-wt-docto.nr-nota
              AND ct-trib-item-doc-est.cod-natur-operac  = tb-wt-docto.nat-operacao
              AND ct-trib-item-doc-est.num-seq           = tb-ct-trib-wt-item-docto.num-seq-wt-item-docto
              AND ct-trib-item-doc-est.cod-tip-trib      = tb-ct-trib-wt-item-docto.cod-tip-trib
              AND ct-trib-item-doc-est.cod-configur-trib = tb-ct-trib-wt-item-docto.cod-configur-trib: 
              
            ASSIGN ct-trib-item-doc-est.idi-cod-tributac   = tb-ct-trib-wt-item-docto.idi-cod-tributac
                   ct-trib-item-doc-est.val-aliq           = tb-ct-trib-wt-item-docto.val-aliq
                   ct-trib-item-doc-est.val-base           = tb-ct-trib-wt-item-docto.val-base-calc
                   ct-trib-item-doc-est.val-trib           = tb-ct-trib-wt-item-docto.val-trib
                   ct-trib-item-doc-est.val-perc-reduc     = tb-ct-trib-wt-item-docto.val-perc-reduc
                   ct-trib-item-doc-est.val-fix-trib       = tb-ct-trib-wt-item-docto.val-fix-trib
                   ct-trib-item-doc-est.val-quant-fix      = tb-ct-trib-wt-item-docto.val-quant-fix
                   ct-trib-item-doc-est.cod-memo-calc-base = tb-ct-trib-wt-item-docto.cod-memo-calc-base
                   ct-trib-item-doc-est.cod-memo-calc-trib = tb-ct-trib-wt-item-docto.cod-memo-calc-trib.
        END. /*FOR EACH ct-trib-item-doc-est*/
    END. /*FOR EACH tb-wt-it-docto*/
    
/*** fim inbo/boin176.m95 ***/
