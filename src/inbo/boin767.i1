
DEF TEMP-TABLE tt{&TABLENAME} no-undo
    LIKE {&TABLENAME}
    field rowid-doc        as rowid
    field limite           as logical
    field lotacao          as logical
    field situacao         as char format "x(10)"
    field chave            as char format "x(63)"
    FIELD hora-aprova      AS CHAR FORMAT "x(08)"
    FIELD hora-rejeita     AS CHAR FORMAT "x(08)"
    FIELD hora-reaprova    AS CHAR FORMAT "x(08)"
    FIELD prazo-aprov      AS CHAR FORMAT "x(10)"
    field nome-usuar-trans like mla-usuar-aprov.nome-usuar
    field nome-usuar-doc   like mla-usuar-aprov.nome-usuar
    field nome-usuar-aprov like mla-usuar-aprov.nome-usuar
    field nome-usuar-alter like mla-usuar-aprov.nome-usuar
    field iNrpendencias    as int
    field vl-doc-conv      LIKE mla-doc-pend-aprov.valor-doc
    field moeda-conv       LIKE mla-doc-pend-aprov.mo-codigo.

DEF TEMP-TABLE tt-parametros no-undo
    FIELD ind-situacao-ini      LIKE mla-doc-pend-aprov.ind-situacao
    FIELD ind-situacao-fim      LIKE mla-doc-pend-aprov.ind-situacao
    FIELD ep-codigo-ini         LIKE mla-doc-pend-aprov.ep-codigo
    FIELD ep-codigo-fim         LIKE mla-doc-pend-aprov.ep-codigo
    FIELD cod-estabel-ini       LIKE mla-doc-pend-aprov.cod-estabel
    FIELD cod-estabel-fim       LIKE mla-doc-pend-aprov.cod-estabel
    FIELD cod-tip-doc-ini       LIKE mla-doc-pend-aprov.cod-tip-doc
    FIELD cod-tip-doc-fim       LIKE mla-doc-pend-aprov.cod-tip-doc
    FIELD historico             LIKE mla-doc-pend-aprov.historico
    FIELD so-alternativos       LIKE mla-doc-pend-aprov.historico
    FIELD sem-limite            LIKE mla-doc-pend-aprov.historico
    FIELD sem-lotacao           LIKE mla-doc-pend-aprov.historico
    FIELD cod-usuar-aprov-ini   LIKE mla-doc-pend-aprov.cod-usuar
    FIELD cod-usuar-aprov-fim   LIKE mla-doc-pend-aprov.cod-usuar
    FIELD cod-usuar-altern-ini  LIKE mla-doc-pend-aprov.cod-usuar-altern
    FIELD cod-usuar-altern-fim  LIKE mla-doc-pend-aprov.cod-usuar-altern
    FIELD cod-usuar-doc-ini     LIKE mla-doc-pend-aprov.cod-usuar-doc
    FIELD cod-usuar-doc-fim     LIKE mla-doc-pend-aprov.cod-usuar-doc
    FIELD cod-usuar-trans-ini   LIKE mla-doc-pend-aprov.cod-usuar-trans
    FIELD cod-usuar-trans-fim   LIKE mla-doc-pend-aprov.cod-usuar-trans
    FIELD cod-lotacao-doc-ini   LIKE mla-doc-pend-aprov.cod-lotacao-doc
    FIELD cod-lotacao-doc-fim   LIKE mla-doc-pend-aprov.cod-lotacao-doc
    FIELD cod-lotacao-trans-ini LIKE mla-doc-pend-aprov.cod-lotacao-trans
    FIELD cod-lotacao-trans-fim LIKE mla-doc-pend-aprov.cod-lotacao-trans
    FIELD valor-ini             LIKE mla-doc-pend-aprov.valor-doc
    FIELD valor-fim             LIKE mla-doc-pend-aprov.valor-doc
    FIELD geracao-ini           LIKE mla-doc-pend-aprov.dt-geracao
    FIELD geracao-fim           LIKE mla-doc-pend-aprov.dt-geracao
    FIELD aprovacao-ini         LIKE mla-doc-pend-aprov.dt-aprova
    FIELD aprovacao-fim         LIKE mla-doc-pend-aprov.dt-aprova
    FIELD rejeicao-ini          LIKE mla-doc-pend-aprov.dt-rejeita
    FIELD rejeicao-fim          LIKE mla-doc-pend-aprov.dt-rejeita
    FIELD reaprovacao-ini       LIKE mla-doc-pend-aprov.dt-reaprova
    FIELD reaprovacao-fim       LIKE mla-doc-pend-aprov.dt-reaprova
    FIELD chave-doc-ini         LIKE mla-doc-pend-aprov.chave-doc
    FIELD chave-doc-fim         LIKE mla-doc-pend-aprov.chave-doc.

DEFINE TEMP-TABLE tt-data-user no-undo
	FIELD cod-usuar        AS CHAR FORMAT "x(12)"
	FIELD cod-usuar-altern AS CHAR FORMAT "x(12)"
	FIELD nome-usuar  	   AS CHAR
	FIELD da-inicial       AS DATE FORMAT "99/99/9999"
	FIELD da-final         AS DATE FORMAT "99/99/9999"
	INDEX codigo           AS PRIMARY cod-usuar ASCENDING.

DEFINE TEMP-TABLE tt-mla-alternativos-def no-undo
	FIELD cod-usuar        AS CHAR FORMAT "x(12)"
	FIELD cod-usuar-altern AS CHAR FORMAT "x(12)"
	FIELD da-inicial       AS DATE FORMAT "99/99/9999"
	FIELD da-final         AS DATE FORMAT "99/99/9999"
	INDEX codigo           AS PRIMARY cod-usuar ASCENDING
        INDEX data             da-inicial da-final.
