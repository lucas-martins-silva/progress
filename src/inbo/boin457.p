procedure buscaItensCons:
    define input  parameter i-op-codigo as int.
    define output parameter table for tt-oper-item-cons-pad.
    
    for each oper-item-cons-pad where oper-item-cons-pad.nr-oper-pad = i-op-codigo NO-LOCK :
        create tt-oper-item-cons-pad.
        buffer-copy oper-item-cons-pad to tt-oper-item-cons-pad.
    end.
end procedure.
