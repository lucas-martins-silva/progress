FOR EACH saldo-terc 
    WHERE saldo-terc.cod-estabel   = doc-orig-nfe.cod-estabel
      {1} /* Filtro do codigo do item eh passado por parametro */
      AND saldo-terc.cod-emitente  = doc-orig-nfe.cod-emitente
      AND saldo-terc.tipo-sal-terc = i-tipo-sal-terc NO-LOCK:

      ASSIGN lFatConsigDevSimb = {cdp/cd0066.i2 saldo-terc.cod-estabel} AND item-doc-orig-nfe.int-2 = 7 . /* Fat. Consig.*/

      /******** Inicio UPC Unimed Nordeste RS **********/
      IF c-nom-prog-dpc-mg97  <> "" OR 
         c-nom-prog-appc-mg97 <> "" OR
         c-nom-prog-upc-mg97  <> "" THEN DO:
        
          FOR EACH tt-epc 
              WHERE tt-epc.cod-event = "devol-simb-consig-nfe":U:
              DELETE tt-epc.
          END.
        
          CREATE tt-epc.
          ASSIGN tt-epc.cod-event     = "devol-simb-consig-nfe":U
                 tt-epc.cod-parameter = "rowid-saldo-terc":U
                 tt-epc.val-parameter = STRING(ROWID(saldo-terc)).
    
          CREATE tt-epc.
          ASSIGN tt-epc.cod-event     = "devol-simb-consig-nfe":U
                 tt-epc.cod-parameter = "rowid-item-doc-orig-nfe":U
                 tt-epc.val-parameter = STRING(ROWID(item-doc-orig-nfe)).

          {include/i-epc201.i "devol-simb-consig-nfe"}
    
          FOR FIRST tt-epc 
              WHERE tt-epc.cod-event     = "devol-simb-consig-nfe"
              AND   tt-epc.cod-parameter = "altera-flag":
              ASSIGN lFatConsigDevSimb = LOGICAL(tt-epc.val-parameter).
          END.
      END.
      /******* Fim UPC Unimed Nordeste RS *******/

        /* Se for faturamento de consigna‡Æo, e valida devolu‡Æo simb¢lica*/                            
        IF lFatConsigDevSimb THEN DO:                          
            ASSIGN deQtdeAFatur  = 0.                          
            
            FOR EACH componente NO-LOCK
                WHERE componente.cod-emitente = saldo-terc.cod-emitente
                  AND componente.nro-comp     = saldo-terc.nro-docto
                  AND componente.serie-comp   = saldo-terc.serie-docto
                  AND componente.nat-comp     = saldo-terc.nat-operacao
                  AND componente.seq-comp     = saldo-terc.sequencia
                  AND componente.it-codigo    = saldo-terc.it-codigo:                

                FIND FIRST bNaturOper NO-LOCK
                     WHERE bNaturOper.nat-operacao = componente.nat-operacao NO-ERROR.
                IF  AVAIL bNaturOper THEN DO:
                    ASSIGN lMovtoDevSimbConsig = {cdp/cd0066.i1 bNaturOper componente}
                END.
                ELSE
                    ASSIGN lMovtoDevSimbConsig = NO.                                

                IF  lMovtoDevSimbConsig THEN DO:
                    ASSIGN deQtdeAFatur = deQtdeAFatur + 
                           &IF "{&mguni_version}" >= "2.08" &THEN
                            (componente.qtd-devol-simbol - componente.qtd-fatur-consig - componente.qtd-afatur-consig)
                           &ELSE
                            (DEC(SUBSTR(componente.char-1,40,14)) - DEC(SUBSTR(componente.char-1,68,14)) - DEC(SUBSTR(componente.char-1,54,14)))
                           &ENDIF .
                END.
            END.

            IF deQtdeAFatur <= 0 THEN
                NEXT.
        END.
        ELSE DO:
            IF saldo-terc.quantidade - saldo-terc.dec-1 = 0 THEN
                NEXT.
        END.

        IF CAN-FIND(FIRST tt-saldo
                    WHERE tt-saldo.serie-docto    = saldo-terc.serie-docto 
                      AND tt-saldo.nro-docto      = saldo-terc.nro-docto
                      AND tt-saldo.cod-emitente   = saldo-terc.cod-emitente
                      AND tt-saldo.nat-operacao   = saldo-terc.nat-operacao
                      AND tt-saldo.seq-saldo-terc = saldo-terc.sequencia
                      AND tt-saldo.it-codigo      = saldo-terc.it-codigo) THEN
            NEXT.

          
    FOR FIRST nota-fiscal 
        WHERE nota-fiscal.cod-estabel  = saldo-terc.cod-estabel
          AND nota-fiscal.serie        = saldo-terc.serie-docto 
          AND nota-fiscal.nr-nota-fis  = saldo-terc.nro-docto
          AND nota-fiscal.cod-emitente = saldo-terc.cod-emitente NO-LOCK:                                                     
    END.

    /* Valida a data de emissao da nota de saida. */
    if avail nota-fiscal
    and (   nota-fiscal.dt-emis-nota > doc-orig-nfe.dt-emissao
         or nota-fiscal.dt-emis-nota = ? ) then
        next.
    else do: 
        if saldo-terc.dt-retorno > doc-orig-nfe.dt-emissao then do:
            for first docum-est
                where docum-est.serie-docto  = saldo-terc.serie-docto
                  and docum-est.nro-docto    = saldo-terc.nro-docto
                  and docum-est.cod-emitente = saldo-terc.cod-emitente
                  and docum-est.cod-estabel  = saldo-terc.cod-estabel no-lock:
            end.
            if not avail docum-est
            or docum-est.dt-emissao > doc-orig-nfe.dt-emissao then
                next. /* Se nao achou nota fiscal, o saldo foi implantado pelo re0407. */
        end.
    end.


    CREATE tt-saldo.
    ASSIGN tt-saldo.ch-acesso-comp-nfe = pchave-acesso
           tt-saldo.cod-emitente       = saldo-terc.cod-emitente
           tt-saldo.it-codigo          = saldo-terc.it-codigo
           tt-saldo.nat-operacao       = saldo-terc.nat-operacao
           tt-saldo.nro-docto          = saldo-terc.nro-docto
           tt-saldo.qtd-alocada        = saldo-terc.quantidade - saldo-terc.dec-1
           tt-saldo.qtd-comercial      = 0
           tt-saldo.seq-item           = i-cont + 1
           i-cont                      = i-cont + 1
           tt-saldo.seq-saldo-terc     = saldo-terc.sequencia
           tt-saldo.serie-docto        = saldo-terc.serie-docto
           tt-saldo.dt-retorno         = saldo-terc.dt-retorno.

    /* Para Devolu‡Æo simb¢lica o saldo ‚ calculado de forma diferente */                        
    IF lFatConsigDevSimb  THEN    
        ASSIGN tt-saldo.qtd-alocada = deQtdeAFatur.                    

    FOR FIRST tt-doc-orig-refer
        WHERE tt-doc-orig-refer.cod-estabel = saldo-terc.cod-estabel
          AND tt-doc-orig-refer.serie-docto = saldo-terc.serie-docto
          AND tt-doc-orig-refer.nro-docto   = saldo-terc.nro-docto  :
    END.
    IF AVAIL tt-doc-orig-refer THEN
        ASSIGN tt-saldo.ch-acesso-nfe  = tt-doc-orig-refer.ch-acesso-nfe     
               tt-saldo.l-referenciada = YES.
    ELSE
        ASSIGN tt-saldo.ch-acesso-nfe  = "":U
               tt-saldo.l-referenciada = NO.
    
    FOR FIRST componente OF saldo-terc NO-LOCK:
        ASSIGN tt-saldo.vlr-unit-item  = componente.preco-total[1] / componente.qt-do-forn
               tt-saldo.vlr-tot-item   = componente.preco-total[1]
               tt-saldo.narrativa-item      = componente.narrativa.
               
        FOR FIRST it-nota-fisc 
                WHERE it-nota-fisc.cod-estabel  = saldo-terc.cod-estabel
                AND it-nota-fisc.serie          = componente.serie-docto
                AND it-nota-fisc.nr-nota-fis    = componente.nro-docto 
                AND it-nota-fisc.nr-seq-fat     = componente.sequencia
                AND it-nota-fisc.it-codigo      = componente.it-codigo NO-LOCK:
        END.
        IF AVAIL nota-fiscal AND AVAIL it-nota-fisc THEN
                ASSIGN tt-saldo.dt-saldo = nota-fiscal.dt-emis-nota.
        ELSE
           ASSIGN tt-saldo.dt-saldo = saldo-terc.dt-retorno.
    END.
END.
