/*PROCEDURE pi-valida-hora:*/

    DEFINE INPUT PARAM cFieldValue AS CHARACTER NO-UNDO.
    DEFINE INPUT PARAM cFieldLabel AS CHARACTER NO-UNDO.

    DEFINE VARIABLE iVerifyVar AS INTEGER     NO-UNDO.

    IF cFieldValue <> "" THEN DO:
        ASSIGN iVerifyVar = INTEGER(cFieldValue) NO-ERROR.
        IF ERROR-STATUS:ERROR THEN DO:
            {method/svc/errors/inserr.i &ErrorNumber="16963"
                                        &ErrorType="EMS"
                                        &ErrorSubType="ERROR"
                                        &ErrorParameters="cFieldLabel"}
        END.
        ELSE DO:
            IF LENGTH(TRIM(cFieldValue)) <> 5 THEN DO:
                
                {method/svc/errors/inserr.i &ErrorNumber="54898"
                                            &ErrorType="EMS"
                                            &ErrorSubType="ERROR"
                                            &ErrorParameters="cFieldLabel + '~~~~' + '5'"}
            END.
            ELSE IF int(SUBSTRING(cFieldValue,4,2)) > 59 THEN DO:
                
                {method/svc/errors/inserr.i &ErrorNumber="3073"
                                            &ErrorType="EMS"
                                            &ErrorSubType="ERROR"}
            END.
        END.
    END.
    RETURN "OK":U.

