/*verifica se a ordem de compra possui acompanhamento do processo*/
if not valid-handle (h-bocx150) then
    if connected("mgcex") then
        run cxbo/bocx150.p persistent set h-bocx150.

if valid-handle (h-bocx150) then do:
    run buscaHistorico in h-bocx150 (input ordem-compra.num-pedido,
                                     output l-acompan).
    if l-acompan then
        /*Parcela fixada (parcela n∆o ser† re-planejada)*/
        assign prazo-compra.int-2 = 2.
end.
IF VALID-HANDLE(h-bocx150) THEN
		DELETE PROCEDURE h-bocx150.
