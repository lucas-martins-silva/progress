/*****************************************************************************
** Procedure Interna.....: pi-determina-inicio-evento
** Objetivo..............: Determinar a data e hora inicial de um evento
**                         definido que  possui um tempo t, termina num momento
**                         determinado dat2 e hra2, e considera padroes de turno
**                         e calendario definidos.
*****************************************************************************/

PROCEDURE pi-determina-inicio-evento:

    def input        param p-cod-area         as char    format "x(12)"          no-undo.
    def input        param p-cod-grp-maq      as char    format "x(9)"           no-undo.
    def input        param p-cod-ctrab        as char    format "x(16)"          no-undo.
    def input        param p-cod-calend-sfc   as char    format "x(8)"           no-undo.
    def input        param p-dat-fim          as date    format "99/99/9999"     no-undo.
    def input        param p-qtd-segs-fim     as decimal format ">>,>>9"         no-undo.
    def output       param p-dat-inic         as date    format "99/99/9999"     no-undo.
    def output       param p-qtd-segs-inic    as decimal format ">>,>>9"         no-undo.
    def input        param p-qtd-tempo-util   as decimal format ">>,>>9.99"   decimals 4 no-undo.
    
    def var i-turno                   as integer no-undo.
    def var i-aux-qtd-segs-fim-turno  as integer no-undo.
    def var d-dat-aux                 as date    no-undo.

    if  p-qtd-tempo-util <= 0 then do:
        assign p-dat-inic      = p-dat-fim
               p-qtd-segs-inic = p-qtd-segs-fim.
        return.
    end.
    
    /* inicializa parÉmetros a serem calculados */
    assign v-dat-calcul       = p-dat-fim
           v-qtd-segs-calcul  = p-qtd-segs-fim
           p-qtd-tempo-util   = p-qtd-tempo-util * 3600
           v-dat-inic-valid   = 12/31/9999.

    /* inicia loop para calculo da data */
    calculo-data:
    repeat:
        /* verifica se o modelo de turno ainda Ç v†lido, substitui por turno valido */
        if  v-dat-inic-valid > v-dat-calcul then do:
            run pi-gera-tt-turno (input p-cod-area,
                                  input p-cod-grp-maq,
                                  input p-cod-ctrab,
                                  input v-dat-calcul,
                                  output v-dat-inic-valid,
                                  output v-dat-fim-valid).
        end.

        assign v-num-dia-sema = weekday(v-dat-calcul).
        /***********************************************************************
                  Troca de Turno e Termino do turno no dia posterior
        Este tratamento abaixo se faz necessario devido a mudaná∆o de turno, quando temos 
        um turno terminado no outro dia justamente no dia final de sua validade (grp x modelo), 
        desta forma:
        Modelo 1                  Modelo 2
        Turno 1 - 06:00 - 14:00   Turno 1 - 08:00 - 16:00
        Turno 2 - 14:00 - 22:00
        Turno 3 - 22:00 - 05:00
        Validades do Turno
        Modelo 1 01/01/2000 atÇ 20/02/2008
        Modelo 2 20/02/2008 atÇ 31/12/9999
        Calculando Datas e Hora de Fim a partir de 18/02/2008 Ös 06:00 duraá∆o de 44 horas
        
        Montagem corretas dos turnos
        dia 18
                        06:00 - 14:00 / 14:00 - 22:00 / 22:00 - 00:00 = 18 horas
        dia 19
        00:00 - 05:00 / 06:00 - 14:00 / 14:00 - 22:00 / 22:00 - 00:00 = 23 horas
        dia 20
        00:00 - 05:00 / 08:00 - 16:00                                 = 3 horas
        Nesta situaá∆o a data de fim correta Ç dia 20/02/2008 Ös 03:00
        **************************************************************************
        Antes ele tratava o dia 20 da seguinte maneira
        dia 20
        08:00 - 16:00                                                 = 3 horas
        Nesta situaá∆o a data de fim gerada era dia 20/02/2008 Ös 11:00
        **************************************************************************/
        if v-dat-calcul + 1 = v-dat-fim-valid then do:
           
           /* verifica se o modelo de turno ainda Ç v†lido, substitui por turno valido */
           run pi-gera-tt-turno (input p-cod-area,
                                 input p-cod-grp-maq,
                                 input p-cod-ctrab,
                                 input v-dat-calcul + 1,
                                 output v-dat-inic-valid,
                                 output v-dat-fim-valid).
           
           for each tt-turno-semana
               where tt-turno-semana.num-dia-sema = weekday(v-dat-calcul)
               break by tt-turno-semana.qtd-segs-fim-turno desc:
               
               /*Filtra registros desnecessarios*/                       
               if v-dat-calcul = p-dat-fim and tt-turno-semana.qtd-segs-inic-turno > p-qtd-segs-fim then next.
               
               /*Determina dia real para descobrir se Ç util ou n∆o*/
               if tt-turno-semana.num-dia-turno <> 0 then
                   assign i-turno   = (tt-turno-semana.num-dia-turno - tt-turno-semana.num-dia-sema)
                          d-dat-aux = v-dat-calcul + i-turno.
               else
                   assign d-dat-aux = v-dat-calcul.

               if d-dat-aux <= v-dat-calcul then next.
               
               /*Caso o dia real do turno seja posterior a data de validade do turno o
                mesmo deve ser desconsiderado.
                Ex: Turno 3 22:00 - 06:00  | Numa situaá∆o em que 20/02 seja a data de termino do modelo de turno
                    Turno 1 06:00 - 14:00  | o intervalo das 22:00 - 00:00 que pertence ao turno 3 do dia 21 n∆o 
                    Turno 2 14:00 - 22:00  | deve ser considerado
               */
               if d-dat-aux >= v-dat-fim-valid then next.
               if d-dat-aux < v-dat-inic-valid then next.
                       
               find calen-data no-lock
                    where calen-data.cd-calen = p-cod-calend-sfc
                      and calen-data.data     = d-dat-aux no-error.
                      
               /*Ç dia util se n∆o o registro e desconsiderado*/
               if avail calen-data         and 
                  calen-data.tipo-dia <> 1 then next.   
               
               /*Calculo para determinar data*/
               if v-dat-calcul = p-dat-fim then
                  assign i-aux-qtd-segs-fim-turno = min(tt-turno-semana.qtd-segs-fim-turno,p-qtd-segs-fim).
               else
                  assign i-aux-qtd-segs-fim-turno = tt-turno-semana.qtd-segs-fim-turno.

               assign p-qtd-tempo-util = p-qtd-tempo-util - (i-aux-qtd-segs-fim-turno - tt-turno-semana.qtd-segs-inic-turno).
               
               if p-qtd-tempo-util <= 0 then do:
                  assign p-dat-inic      = v-dat-calcul
                         p-qtd-segs-inic = tt-turno-semana.qtd-segs-inic-turno + abs(p-qtd-tempo-util).
                  leave calculo-data.       
               end.
           end.
        end.
        
        /*******************************************************************
                        Tratamento para o dia normal
        ********************************************************************/
        /* verifica se o modelo de turno ainda Ç v†lido, substitui por turno valido */
        if  v-dat-inic-valid > v-dat-calcul then do:
            run pi-gera-tt-turno (input p-cod-area,
                                  input p-cod-grp-maq,
                                  input p-cod-ctrab,
                                  input v-dat-calcul,
                                  output v-dat-inic-valid,
                                  output v-dat-fim-valid).
        end.
        
        for each tt-turno-semana
            where tt-turno-semana.num-dia-sema = v-num-dia-sema
            break by tt-turno-semana.qtd-segs-fim-turno desc:
            
            /*Filtra registros desnecessarios*/                       
            if v-dat-calcul = p-dat-fim and tt-turno-semana.qtd-segs-inic-turno > p-qtd-segs-fim then next.
            
            /*Determina dia real para descobrir se Ç util ou n∆o*/
            if tt-turno-semana.num-dia-turno <> 0 then 
                assign i-turno   = (tt-turno-semana.num-dia-turno - tt-turno-semana.num-dia-sema)
                       d-dat-aux = v-dat-calcul + i-turno.
            else
                assign d-dat-aux = v-dat-calcul.

            /*Caso o dia real do turno seja posterior a data de validade do turno o
            mesmo deve ser desconsiderado.
            Ex: Turno 3 22:00 - 06:00  | Numa situaá∆o em que 20/02 seja a data de termino do modelo de turno
                Turno 1 06:00 - 14:00  | o intervalo das 22:00 - 00:00 que pertence ao turno 3 do dia 21 n∆o 
                Turno 2 14:00 - 22:00  | deve ser considerado
            */
            if d-dat-aux >= v-dat-fim-valid then next.
            if d-dat-aux <  v-dat-inic-valid then next.
                           
            find calen-data no-lock
                 where calen-data.cd-calen = p-cod-calend-sfc
                   and calen-data.data     = d-dat-aux no-error.
            /*Ç dia util se n∆o o registro e desconsiderado*/
            if avail calen-data         and 
               calen-data.tipo-dia <> 1 then next.   
            
            /*Calculo para determinar data*/
            if v-dat-calcul = p-dat-fim then
               assign i-aux-qtd-segs-fim-turno = min(tt-turno-semana.qtd-segs-fim-turno,p-qtd-segs-fim).
            else
               assign i-aux-qtd-segs-fim-turno = tt-turno-semana.qtd-segs-fim-turno.

            assign p-qtd-tempo-util = p-qtd-tempo-util - (i-aux-qtd-segs-fim-turno - tt-turno-semana.qtd-segs-inic-turno).
            
            if p-qtd-tempo-util <= 0 then do:
               assign p-dat-inic      = v-dat-calcul      
                      p-qtd-segs-inic = tt-turno-semana.qtd-segs-inic-turno + abs(p-qtd-tempo-util).
               leave calculo-data.       
            end.
        end.
        
        /***********************************************************************
               Troca de Turno e Inicio de turno no dia anterior
        Este tratamento abaixo se faz necessario devido a mudaná∆o de turno, quando temos 
        um turno terminado no outro dia justamente no dia final de sua validade (grp x modelo), 
        desta forma:
        Modelo 1                 Modelo 2                  
        Turno 1 - 08:00 - 16:00  Turno 1 - 22:00 - 06:00   
                                 Turno 2 - 06:00 - 14:00   
                                 Turno 3 - 14:00 - 20:00   
        Validades do Turno
        Modelo 1 01/01/2000 atÇ 20/02/2008
        Modelo 2 20/02/2008 atÇ 31/12/9999
        Calculando Datas e Hora de Fim a partir de 18/02/2008 Ös 08:00 duraá∆o de 20 horas
        
        Montagem corretas dos turnos
        dia 18
        08:00 - 16:00                                                 = 8 horas
        dia 19                                                        
        08:00 - 16:00 / 22:00 - 00:00                                 = 10 horas
        dia 20
        00:00 - 06:00 / 06:00 - 14:00 / 14:00 - 20:00 / 22:00 - 00:00 = 2 horas
        Nesta situaá∆o a data de fim correta Ç dia 20/02/2008 Ös 02:00
        **************************************************************************
        Antes ele tratava o dia 19 da seguinte maneira
        dia 19
        08:00 - 16:00                                                 = 8 horas
        dia 20
        00:00 - 06:00 / 06:00 - 14:00 / 14:00 - 20:00 / 22:00 - 00:00 = 4 horas
        Nesta situaá∆o a data de fim gerada era dia 20/02/2008 Ös 04:00
        **************************************************************************/
        if v-dat-calcul = v-dat-inic-valid then do:
           run pi-gera-tt-turno (input p-cod-area,
                                 input p-cod-grp-maq,
                                 input p-cod-ctrab,
                                 input v-dat-calcul - 1,
                                 output v-dat-inic-valid,
                                 output v-dat-fim-valid).
        
           for each tt-turno-semana
               where tt-turno-semana.num-dia-sema = weekday(v-dat-calcul)
               break by tt-turno-semana.qtd-segs-fim-turno desc:
               
               /*Filtra registros desnecessarios*/                               
               if v-dat-calcul = p-dat-fim and tt-turno-semana.qtd-segs-inic-turno > p-qtd-segs-fim then next.
               
               /*Determina dia real para descobrir se Ç util ou n∆o*/
               if tt-turno-semana.num-dia-turno <> 0 then
                   assign i-turno   = (tt-turno-semana.num-dia-turno - tt-turno-semana.num-dia-sema)
                          d-dat-aux = v-dat-calcul + i-turno.
               else
                   assign d-dat-aux = v-dat-calcul.
                   
               if d-dat-aux >= v-dat-calcul then next.
                       
               /*Caso o dia real do turno seja posterior a data de validade do turno o
               mesmo deve ser desconsiderado.
               Ex: Turno 3 22:00 - 06:00  | Numa situaá∆o em que 20/02 seja a data de termino do modelo de turno
                   Turno 1 06:00 - 14:00  | o intervalo das 22:00 - 00:00 que pertence ao turno 3 do dia 21 n∆o 
                   Turno 2 14:00 - 22:00  | deve ser considerado
               */
               if d-dat-aux >= v-dat-fim-valid then next.
               if d-dat-aux <  v-dat-inic-valid then next.

               find calen-data no-lock
                    where calen-data.cd-calen = p-cod-calend-sfc
                      and calen-data.data     = d-dat-aux no-error.
               /*Ç dia util se n∆o o registro e desconsiderado*/
               if avail calen-data         and 
                  calen-data.tipo-dia <> 1 then next.   
               
               /*Calculo para determinar data*/   
               if v-dat-calcul = p-dat-fim then
                  assign i-aux-qtd-segs-fim-turno = min(tt-turno-semana.qtd-segs-fim-turno,p-qtd-segs-fim).
               else
                  assign i-aux-qtd-segs-fim-turno = tt-turno-semana.qtd-segs-fim-turno.
        
               assign p-qtd-tempo-util = p-qtd-tempo-util - (i-aux-qtd-segs-fim-turno - tt-turno-semana.qtd-segs-inic-turno).
               
               if p-qtd-tempo-util <= 0 then do:
                  assign p-dat-inic      = v-dat-calcul
                         p-qtd-segs-inic = tt-turno-semana.qtd-segs-inic-turno + abs(p-qtd-tempo-util).
                  leave calculo-data.       
               end.
           end.
        end.

        assign v-dat-calcul  = v-dat-calcul - 1.
        
        if v-dat-calcul < p-dat-fim - 3000 then do:
            assign p-dat-inic = v-dat-calcul
                   p-qtd-segs-inic = 0.
                leave calculo-data.
        end.

    end.

END PROCEDURE.
