PROCEDURE setDescItem :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:  Retorna a descri»’o do item da ordem de compra (nota).     
------------------------------------------------------------------------------*/

    def input  param piItCodigo  like item.it-codigo no-undo.
    def output param c-desc-item like item.desc-item no-undo.

    run findItem ( input piItCodigo ).
    

    if  avail item then do:
        find item-mat where item-mat.it-codigo = item.it-codigo no-lock no-error. 
        if avail item-mat and item-mat.log-1 = yes /*item Gen²rico*/ and item.tipo-contr = 4 /* d²bito direto */ then do: 
            if  avail RowObject 
            and RowObject.narrativa <> "" then
                assign c-desc-item = string( RowObject.narrativa, 'x(60)' ). /* Narrativa Item da Nota */
                

            else if  avail ordem-compra then
                     assign c-desc-item = string( ordem-compra.narrativa, 'x(60)' ). /* Narrativa OC */
                     

                 else if  avail it-nota-fisc then do:
                          for first nar-it-nota 
                             fields ( cod-estabel serie nr-nota-fis nr-sequencia narrativa )              
                             where nar-it-nota.cod-estabel  = it-nota-fisc.cod-estabel 
                               and nar-it-nota.serie        = it-nota-fisc.serie       
                               and nar-it-nota.nr-nota-fis  = it-nota-fisc.nr-nota-fis 
                               and nar-it-nota.nr-sequencia = it-nota-fisc.nr-seq-fat no-lock: end.
             

                          if  avail nar-it-nota then
                              assign c-desc-item = string( nar-it-nota.narrativa, 'x(60)' ). /* Narrativa It-Nota-fisc*/
                      end.
        end.
        else 
            assign c-desc-item = item.desc-item. /* Descri»’o Item */
    end.            
    else 
        RETURN "NOK":U.
        

    return "OK":U.

END PROCEDURE.




