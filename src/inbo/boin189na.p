&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE afterCopyBuffer2TT DBOProgram 
PROCEDURE afterCopyBuffer2TT:
    DEFINE VARIABLE c-nome-estabel AS CHARACTER NO-UNDO.
    
    FOR FIRST estabelec 
        WHERE estabelec.cod-estabel = {&TableName}.cod-estabel NO-LOCK:

        CREATE RowObjectExtra.
        ASSIGN RowObjectExtra.r-Rowid = ROWID({&TableName})
               RowObjectExtra.nomeEstab = estabelec.nome. 
    
    END.
          
   
END PROCEDURE.
