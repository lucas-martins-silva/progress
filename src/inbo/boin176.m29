PROCEDURE enableFields :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  
        1. Input pType          -> Tipo de Transaªío ( "Create" ou "Update" ) 
        2. Input pFieldName     -> Atributo da Tabela Item-Doc-Est
        3. Output pFieldEnable  -> Habilita ou Nío o Atributo 
  Notes:       
        Pr≤-requisitos: A procedure intiliazeFind deve ter sido executada.
------------------------------------------------------------------------------*/

    DEFINE INPUT PARAMETER  pType        AS CHARACTER NO-UNDO.
    DEFINE INPUT PARAMETER  pFieldName   AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldEnable AS LOGICAL   NO-UNDO.
    
    def var l-habilita-etiqueta          as logical   no-undo.
    def var de-qt-etiquetas              like item-doc-est.qt-etiquetas no-undo. 
    DEF BUFFER b-natur-oper-fiscal       FOR natur-oper. /* Buffer aux. para a natureza fiscal dos itens */
    
    if not avail param-compra then
        find first param-compra no-lock no-error.
        
    if  not avail docum-est then 
        return "NOK":U.
    
    if  avail natur-oper then do:
        {cdp/cd9700.i1 natur-oper} /* seta variavel l-fatura-ent-futura e l-fatura-fat-antecip */
    end.
    
    /* Se usa múltiplas naturezas no recebimento */
    IF  l-mult-natur-receb THEN /* Var def em cd9701.i */
        /* Busca b-natur-oper-fiscal = Natureza fiscal do Item */
        FIND FIRST b-natur-oper-fiscal WHERE b-natur-oper-fiscal.nat-operacao = RowObject.nat-of NO-LOCK NO-ERROR.
    
    /* Se nío usa multiplas naturezas ou usa mas a nota ≤ antiga (digit. antes de marcar o par≥m.) */
    IF  NOT l-mult-natur-receb OR NOT AVAIL b-natur-oper-fiscal THEN
        /* Busca b-natur-oper-fiscal = Natureza de operaªío da Nota */
        FIND FIRST b-natur-oper-fiscal WHERE b-natur-oper-fiscal.nat-operacao = RowObject.nat-operacao NO-LOCK NO-ERROR.

    CASE pFieldName:
        WHEN "sequencia":U      THEN ASSIGN pFieldEnable =      pType = "CREATE":U 
                                                            and avail param-re
                                                            and param-re.pd-seq.
                                                            

        WHEN "it-codigo":U      THEN ASSIGN pFieldEnable =  avail param-re 
                                                            and (   not l-material-agregado
                                                                    or  param-re.pede-it-agreg )
                                                            and param-re.cod-ent-item = 1.
        

        WHEN "it-do-forn":U      THEN ASSIGN pFieldEnable = avail param-re
                                                            and (   not l-material-agregado
                                                                    or  param-re.pede-it-agreg )
                                                            and param-re.cod-ent-item = 2.

        WHEN "baixa-ce":U       THEN ASSIGN pFieldEnable =      l-pede-baixa-ce
                                                            and not l-material-agregado
                                                            and not l-fatura-ent-futura
                                                            and not l-fatura-fat-antecip. 
                                                            

        WHEN "nr-ord-produ":U   THEN ASSIGN pFieldEnable =  l-pede-ord-prod 
                                                            and ( param-global.modulo-cp or param-global.modulo-mi ) 
                                                            and avail natur-oper
                                                            and (   not natur-oper.terceiros
                                                                 or not can-do("4,6", string(natur-oper.tp-oper-terc)) ).

        WHEN "numero-ordem":U   THEN ASSIGN pFieldEnable =  l-pede-compra.                                                    
        

        WHEN "num-pedido":U     THEN ASSIGN pFieldEnable =  l-pede-compra.                                                    

        WHEN "parcela":U        THEN ASSIGN pFieldEnable =      l-pede-compra
                                                            and avail RowObject 
                                                            and RowObject.numero-ordem <> 0. 

        WHEN "log-1":U          THEN ASSIGN pFieldEnable =      avail param-re 
                                                            and param-re.log-1  /*Fifo*/
                                                            and l-pede-compra
                                                            and avail natur-oper 
                                                            and not natur-oper.nota-rateio 
                                                            and (   pType = "CREATE":U
                                                                 or (    avail RowObject
                                                                     and RowObject.numero-ordem = 0)).

        WHEN "int-1":U          THEN ASSIGN pFieldEnable =  l-evento  
                                                            and avail RowObject
                                                            and RowObject.numero-ordem <> 0. /*Evento*/
                                                           

        WHEN "encerra-pa":U     THEN ASSIGN pFieldEnable =  l-encerra-pa.

        WHEN "quantidade":U     THEN ASSIGN pFieldEnable =  not l-transf
                                                            and l-pede-qtd.

        WHEN "qt-do-forn":U     THEN ASSIGN pFieldEnable =  not l-transf
                                                            and l-pede-qtd
                                                            and avail natur-oper
                                                            and NOT (l-devolucao AND RowObject.nro-comp <> "").

        WHEN "preco-unit[1]":U  THEN ASSIGN pFieldEnable =  not l-transf
                                                            and (    not avail natur-oper 
                                                                 or  not natur-oper.terceiros 
                                                                 or  l-alter-itens
                                                                 or (    natur-oper.tp-oper-terc <> 2 
                                                                     and natur-oper.tp-oper-terc <> 4 
                                                                     and  natur-oper.tp-oper-terc <> 5))
                                                            and avail param-re 
                                                            and param-re.preco-unit.

        WHEN "preco-total[1]":U THEN ASSIGN pFieldEnable =  not l-transf
                                                            and (    not avail natur-oper 
                                                                 or  not natur-oper.terceiros 
                                                                 or  l-alter-itens
                                                                 or (    natur-oper.tp-oper-terc <> 2 
                                                                     and natur-oper.tp-oper-terc <> 4 
                                                                     and  natur-oper.tp-oper-terc <> 5)).
                                                                     

        WHEN "desconto[1]":U    THEN ASSIGN pFieldEnable =  not l-transf
                                                            and (    not avail natur-oper 
                                                                 or  not natur-oper.terceiros 
                                                                 or  l-alter-itens
                                                                 or (    natur-oper.tp-oper-terc <> 2 
                                                                     and natur-oper.tp-oper-terc <> 4 
                                                                     and  natur-oper.tp-oper-terc <> 5))
                                                            and avail param-re 
                                                            and param-re.pede-desc-it.

        WHEN "peso-liquido":U   THEN ASSIGN pFieldEnable =  l-pede-peso.                                                   

        WHEN "pr-total-cmi":U   THEN ASSIGN pFieldEnable =  l-pede-valor.                                                   

        WHEN "despesas[1]":U    THEN ASSIGN pFieldEnable =  l-pede-valor.                                                   

        WHEN "ct-codigo":U THEN ASSIGN pFieldEnable =  avail RowObject
                                                            and RowObject.nr-ord-produ = 0 
                                                            and avail natur-oper 
                                                            and (   l-pede-conta 
                                                                 or ( avail item and can-do("1,4", string(item.tipo-contr)) ) 
                                                                 or (    natur-oper.terceiros 
                                                                     and not can-do("4,6", string(natur-oper.tp-oper-terc)) )).

        WHEN "aliquota-ipi":U   THEN ASSIGN pFieldEnable =  not l-servicos
                                                            and avail param-re
                                                            and param-re.pd-aliq-ipi. 

        WHEN "cd-trib-ipi":U    THEN ASSIGN pFieldEnable =  not l-servicos
                                                            and avail param-re
                                                            and param-re.pd-cd-ipi.
        

        WHEN "aliquota-icm":U   THEN ASSIGN pFieldEnable =  not l-servicos
                                                            and avail param-re
                                                            and param-re.pd-aliq-icms. 

        WHEN "cd-trib-icm":U    THEN ASSIGN pFieldEnable =  not l-servicos
                                                            and avail param-re
                                                            and param-re.pd-cd-icms.
        

        WHEN "aliquota-iss":U   THEN ASSIGN pFieldEnable =  l-servicos. 

        WHEN "cd-trib-iss":U    THEN ASSIGN pFieldEnable =  l-servicos.

        WHEN "log-2":U          THEN ASSIGN pFieldEnable =  not l-servicos
                                                            and avail b-natur-oper-fiscal
                                                            and b-natur-oper-fiscal.tipo-compra <> 2 /* Frete */
                                                            and (   b-natur-oper-fiscal.subs-trib
                                                                 or b-natur-oper-fiscal.log-icms-substto-antecip).  /*ICMS Substituto Antecip*/

        WHEN "class-fiscal":U   THEN ASSIGN pFieldEnable =  not l-servicos
                                                            and avail param-re
                                                            and (   param-re.pd-cf-item
                                                                 or (avail item and item.tipo-contr = 4)).

        WHEN "nr-ficha":U       THEN ASSIGN pFieldEnable =  no.  /* l-industria
                                                            or l-ent-cons.*/

        WHEN "data-comp":U      THEN ASSIGN pFieldEnable =  l-pede-data-comp.
        

        WHEN "reabre-pd":U      THEN ASSIGN pFieldEnable =  l-devolucao
                                                            and ( avail RowObject and RowObject.nr-pedcli <> "")
                                                            and (avail param-re and param-re.reabre-pd)
                                                            and param-global.modulo-pd.

        WHEN "triangular":U     THEN ASSIGN pFieldEnable =  avail natur-oper
                                                            and natur-oper.log-oper-triang.
                                                            

        WHEN "qt-etiquetas":U   THEN DO:                    run setDefaultsEtiquetas ( output de-qt-etiquetas,
                                                                                       output l-habilita-etiqueta ). 
                                     ASSIGN pFieldEnable = l-habilita-etiqueta.
                                END.     

        WHEN "perc-ipi":U       THEN ASSIGN pFieldEnable = if (avail param-re and int(substring(param-re.char-1,3,1)) = 0) then no else yes.

        WHEN "perc-icm":U       THEN ASSIGN pFieldEnable = if (avail param-re and int(substring(param-re.char-1,4,1)) = 0) then no else yes.                                                            
                                                            
        WHEN "de-valor-pedagio":U THEN ASSIGN pFieldEnable = (  avail param-re
                                                              and substring(param-re.char-1,21,1) = "1" 
                                                              and avail natur-oper
                                                              and natur-oper.tipo-compra = 2). 

        WHEN "nbs":U THEN DO:            
            ASSIGN pFieldEnable = YES.

            /* Se N«O for modelo 56 E N«O for NFS-e Nacional, desabilita o campo */
            IF AVAIL natur-oper THEN DO:
                IF natur-oper.cod-model-nf-eletro <> "56" AND 
                   NOT natur-oper.log-nfse-nacional THEN
                    ASSIGN pFieldEnable = NO.
            END.
        END.                                                      
                                                            
        &if "{&bf_mat_versao_ems}" >= "2.062" &then
        WHEN "cod-unid-negoc":U THEN ASSIGN pFieldEnable =  if (avail param-re 
                                                                  and l-mat-unid-negoc
                                                                  and param-re.usuario = c-seg-usuario
                                                                  and param-re.log-pedir-unid-negoc) 
                                                            then yes else no.
         WHEN "un":U THEN ASSIGN pFieldEnable = (avail item and item.tipo-contr = 4) or              /*Item DÇbito Direto*/
                                                (param-compra.log-multi-unid-medid and               /*multiplas unidades*/
                                                (not natur-oper.terceiros                            /*N∆o for Saldo Terceiros*/
                                                     or natur-oper.tp-oper-terc = 3)                 /*Consignaá∆o*/
                                                 AND not (l-devolucao AND RowObject.nro-comp <> "")  /*n∆o for devoluá∆o com nota origem*/
                                                 AND not l-transf).                                  /*n∆o for transferància*/
       
        &endif
        OTHERWISE ASSIGN pFieldEnable = yes.           
        

    END CASE.

    IF c-nom-prog-upc-mg97  <> "" OR 
       c-nom-prog-dpc-mg97  <> "" OR 
       c-nom-prog-appc-mg97 <> "" THEN DO:
        
        /* Include i-epc200.i2: Criacao de registro para temp-table tt-epc */
        FOR EACH tt-epc 
           WHERE tt-epc.cod-event = "desabilita-campo":
            DELETE tt-epc.
        END.

        {include/i-epc200.i2 &CodEvent='"desabilita-campo"'
                             &CodParameter='"usuario"'
                             &ValueParameter="c-seg-usuario"}
        
        {include/i-epc200.i2 &CodEvent='"desabilita-campo"'
                             &CodParameter='"campo"'
                             &ValueParameter="pFieldName"}
                             
        {include/i-epc200.i2 &CodEvent='"desabilita-campo"'
                             &CodParameter='"acao"'
                             &ValueParameter="pType"}

                             
        /* Include i-epc201.i: Chamada do programa de EPC */
        {include/i-epc201.i "desabilita-campo"}

        FIND FIRST tt-epc 
             WHERE tt-epc.cod-event = "desabilita-campo"
               AND tt-epc.cod-parameter = "retorno" NO-LOCK NO-ERROR.
        IF AVAILABLE(tt-epc) THEN DO:
            ASSIGN pFieldEnable = IF tt-epc.val-parameter = "YES" THEN YES ELSE NO.
        END. /*-IF AVAILABLE(tt-epc)-*/
    END. /*-IF c-nom-prog-upc-mg97  <> "" ...-*/
    RETURN "OK":U.


END PROCEDURE.




