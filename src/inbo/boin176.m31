PROCEDURE initializeUpdate :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:   
  

        Obs.: Essa procedure sempre deverÿ ser executada na modifica»’o.    
------------------------------------------------------------------------------*/

    for each tb-wt-it-docto exclusive-lock:
        delete tb-wt-it-docto.
    end.

    for each tb-wt-it-imposto exclusive-lock:
        delete tb-wt-it-imposto.
    end.
    
    for each tb-wt-it-impostoCBSIBS exclusive-lock:
        delete tb-wt-it-impostoCBSIBS.
    end.    

    assign l-evento         =     param-global.modulo-cn 
                              and (avail RowObject and RowObject.int-1 <> 0)
                              and not l-NFDebCred 

           l-encerra-pa     =     avail RowObject
                              and param-re.encerra-cc 
                              and RowObject.numero-ordem <> 0 
                              and l-pede-compra

           l-pede-baixa-ce  =     param-re.baixa-estoq = no 
                              and ( l-devolucao = no 
                              or  (avail RowObject and RowObject.nro-comp = "")) 
                              and l-transf = no 
                              and l-dev-transf = no
                              and not l-NFDebCred
                              and not docum-est.rec-fisico 
                              and ( natur-oper.terceiros = no 
                              or    natur-oper.tp-oper-terc <= 3 )

           l-pede-data-comp = (l-devolucao 
                              or (    natur-oper.terceiros 
                                  and (  natur-oper.tp-oper-terc = 2 
                                       or natur-oper.tp-oper-terc = 4 
                                       or natur-oper.tp-oper-terc = 5 
                                       or natur-oper.tp-oper-terc = 6) ) )
                            and not docum-est.rec-fisico 
                            and not l-NFDebCred 
                            and l-devolucao 
                            and avail RowObject
                            and RowObject.nro-comp = ""

           de-qt-ori        = RowObject.quantidade.                            

    return "OK":U.
           

END PROCEDURE.




