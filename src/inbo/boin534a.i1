/****************************************************************************
**
** Procedure.......: AtualizarPerfilCapacCtrab
** Descricao.......: Atualiza o perfil de capacidade do centro de trabalho
** Parametros......: Centro de trabalho
**                   Variacao de carga (1 ou 0,5 quando ² backward e forward)
**                   Referencia data para inicio do perfil v-dat-ini 
**                   Referencia hora para inicio do perfil v-dat-ini 
**                   Referencia data para fim do perfil v-dat-fim 
**                   Referencia hora para fim do perfil v-dat-fim 
**                   Evento gerador de carga: Operacao de ordem de producao:
**                                                  1 carga / 2 descarga
**                                            Operacao de ordem manuten‡Æo:
**                                                  3 carga / 4 descarga
**                                            Alteracao de capacidade:
**                                                  5 incrementa / 6 diminui
**                         Fator de arredondamento para pontos do perfil 
**                                            (default 5 minutos = 60 segs) 
**                                                    
****************************************************************************/

PROCEDURE AtualizarPerfilCapacCtrab:

    def input param p-cod-ctrab       as char no-undo.
    def input param p-qtd-variacao    as dec  form "->>>>,>>9.99999999" decimals 8 no-undo.
    def input param p-dat-inicio      as date no-undo.
    def input param p-num-hra-inic    as int  no-undo.
    def input param p-dat-fim         as date no-undo.
    def input param p-num-hra-fim     as int  no-undo.
    def input param p-num-evento      as int  no-undo.   
    def input param p-qtd-aproximacao as dec  form "->>>>,>>9.9999" decimals 4 no-undo.

    def buffer b-perf-capac-ctrab for perf-capac-ctrab.

    def var v-cod-refer-perf-capac      as character no-undo.
    def var v-ind-tip                   as character no-undo.
    def var v-row-perf-capac-fim        as rowid     no-undo.    
    def var v-row-perf-capac-inic       as rowid     no-undo.
    def var v-val-refer-perf-capac-fim  as decimal   no-undo.
    def var v-val-refer-perf-capac-inic as decimal   no-undo.
    def var v-val-refer-perf          as decimal   no-undo.

    /* Arredonda horas inicio e fim de evento */

    assign p-num-hra-inic = round((p-num-hra-inic / p-qtd-aproximacao), 0) * p-qtd-aproximacao
           p-num-hra-fim  = round((p-num-hra-fim  / p-qtd-aproximacao), 0) * p-qtd-aproximacao
           v-val-refer-perf-capac-inic =  year(p-dat-inicio) * 10000 +
                                         month(p-dat-inicio) * 100   +
                                           day(p-dat-inicio)         + p-num-hra-inic / 100000
           v-val-refer-perf-capac-fim  =   year(p-dat-fim) * 10000 +
                                          month(p-dat-fim) * 100   +
                                            day(p-dat-fim)         + p-num-hra-fim / 100000.

    /* INICIALIZA PARAMETROS PARA CALCULO DE PERFIL       
       Eventos 1, 2 Mexem com carga de ordens de produ‡Æo
       Eventos 3, 4 Mexem com carga de ordens manuten‡Æo   
       Eventos 5, 6 Mexem com mudan‡a de capacidade */ 

    if  v-val-refer-perf-capac-inic < v-val-refer-perf-capac-fim then do:  

        /* Inversao do evento */
        if  p-num-evento = 2
        or  p-num-evento = 4
        or  p-num-evento = 6 then 
            assign p-qtd-variacao = p-qtd-variacao * -1.

        /* VERIFICA EXISTENCIA REGISTROS DE PERFIL COM A DATA INICIAL DO PERIODO */
        
        find perf-capac-ctrab exclusive-lock
            where perf-capac-ctrab.cod-ctrab      = p-cod-ctrab
              and perf-capac-ctrab.val-refer-perf = v-val-refer-perf-capac-inic no-error.

        if  not avail perf-capac-ctrab then do:
           
            find last b-perf-capac-ctrab
                where b-perf-capac-ctrab.cod-ctrab      = p-cod-ctrab
                  and b-perf-capac-ctrab.val-refer-perf < v-val-refer-perf-capac-inic no-lock no-error.

           if  not avail b-perf-capac-ctrab then do:
               create b-perf-capac-ctrab.
               assign b-perf-capac-ctrab.cod-ctrab        = p-cod-ctrab
                      b-perf-capac-ctrab.dat-ponto-perfil = date(1,1,1)
                      b-perf-capac-ctrab.hra-ponto-perfil = 0.
           end.

           create perf-capac-ctrab.
           buffer-copy b-perf-capac-ctrab to perf-capac-ctrab
           assign perf-capac-ctrab.dat-ponto-perfil = p-dat-inicio
                  perf-capac-ctrab.hra-ponto-perfil = p-num-hra-inic
                  perf-capac-ctrab.val-refer-perf   = v-val-refer-perf-capac-inic.
        end.

        /* ATUALIZA REGISTROS DE PERFIL QUE ESTAO DENTRO DO INTERVALO DE
           CHAMADA DA FUNCAO */

        assign v-row-perf-capac-inic = rowid(perf-capac-ctrab).

        blkler:
        repeat:
            assign v-row-perf-capac-fim = rowid(perf-capac-ctrab)
                   v-val-refer-perf     = perf-capac-ctrab.val-refer-perf.

            if  p-num-evento = 1  or  p-num-evento = 2 then
                assign perf-capac-ctrab.val-carg-op-plan = perf-capac-ctrab.val-carg-op-plan + p-qtd-variacao.

            if  p-num-evento = 3  or  p-num-evento = 4 then
                assign perf-capac-ctrab.val-carg-manut   = perf-capac-ctrab.val-carg-manut   + p-qtd-variacao.

            if  p-num-evento = 5  or  p-num-evento = 6 then
                assign perf-capac-ctrab.val-capac-carg   = perf-capac-ctrab.val-capac-carg   + p-qtd-variacao.

            assign perf-capac-ctrab.val-capac-resid = perf-capac-ctrab.val-capac-carg   -
                                                      perf-capac-ctrab.val-carg-op-plan -
                                                      perf-capac-ctrab.val-carg-manut.

            find first perf-capac-ctrab
                where perf-capac-ctrab.cod-ctrab      = p-cod-ctrab
                  and perf-capac-ctrab.val-refer-perf > v-val-refer-perf exclusive no-error.

            if  not available perf-capac-ctrab
            or  perf-capac-ctrab.val-refer-perf >= v-val-refer-perf-capac-fim then
                leave blkler.
        end.

        /* ELIMINA DUPLICIDADE DE REGISTROS - Registro inicial do periodo */
        find perf-capac-ctrab
            where rowid(perf-capac-ctrab) = v-row-perf-capac-inic exclusive-lock.

        find last b-perf-capac-ctrab
            where b-perf-capac-ctrab.cod-ctrab      = perf-capac-ctrab.cod-ctrab
              and b-perf-capac-ctrab.val-refer-perf < perf-capac-ctrab.val-refer-perf
            no-lock no-error.
    
        if  avail b-perf-capac-ctrab
        and perf-capac-ctrab.val-carg-op-plan = b-perf-capac-ctrab.val-carg-op-plan
        and perf-capac-ctrab.val-carg-manut   = b-perf-capac-ctrab.val-carg-manut
        and perf-capac-ctrab.val-capac-carg   = b-perf-capac-ctrab.val-capac-carg then do:

            /* Se o registro a ser deletado e igual ao final, mudar
               v-row-perf-capac-fim para o b-perfil */
            
            if  v-row-perf-capac-fim = rowid(perf-capac-ctrab) then 
                assign v-row-perf-capac-fim = rowid(b-perf-capac-ctrab).
                
            delete perf-capac-ctrab.
        end.

        /* VERIFICA REGISTROS COM A DATA FINAL DO PERIODO */
        find perf-capac-ctrab
            where perf-capac-ctrab.cod-ctrab      = p-cod-ctrab
              and perf-capac-ctrab.val-refer-perf = v-val-refer-perf-capac-fim EXCLUSIVE-LOCK no-error.

        if  not avail perf-capac-ctrab then do:
            find b-perf-capac-ctrab
                where rowid(b-perf-capac-ctrab) = v-row-perf-capac-fim no-lock no-error.

            create perf-capac-ctrab.
            buffer-copy b-perf-capac-ctrab to perf-capac-ctrab
            assign perf-capac-ctrab.dat-ponto-perfil = p-dat-fim
                   perf-capac-ctrab.hra-ponto-perfil = p-num-hra-fim
                   perf-capac-ctrab.val-refer-perf   = v-val-refer-perf-capac-fim.
            
            if  p-num-evento = 1  or  p-num-evento = 2 then
                assign perf-capac-ctrab.val-carg-op-plan = perf-capac-ctrab.val-carg-op-plan - p-qtd-variacao.

            if  p-num-evento = 3  or  p-num-evento = 4 then
                assign perf-capac-ctrab.val-carg-manut   = perf-capac-ctrab.val-carg-manut   - p-qtd-variacao.

            if  p-num-evento = 5  or  p-num-evento = 6 then
                assign perf-capac-ctrab.val-capac-carg   = perf-capac-ctrab.val-capac-carg   - p-qtd-variacao.

            assign perf-capac-ctrab.val-capac-resid = perf-capac-ctrab.val-capac-carg   -
                                                      perf-capac-ctrab.val-carg-op-plan -
                                                      perf-capac-ctrab.val-carg-manut
                   v-row-perf-capac-fim  = rowid(perf-capac-ctrab).
        end.

        /* ELIMINA DUPLICIDADE DE REGISTROS - Registro final do periodo */
        find first b-perf-capac-ctrab
            where b-perf-capac-ctrab.cod-ctrab      = perf-capac-ctrab.cod-ctrab
              and b-perf-capac-ctrab.val-refer-perf > perf-capac-ctrab.val-refer-perf no-error.
    
        if  available b-perf-capac-ctrab
        and perf-capac-ctrab.val-carg-op-plan = b-perf-capac-ctrab.val-carg-op-plan
        and perf-capac-ctrab.val-carg-manut   = b-perf-capac-ctrab.val-carg-manut
        and perf-capac-ctrab.val-capac-carg   = b-perf-capac-ctrab.val-capac-carg then
            delete b-perf-capac-ctrab.
        
       find last  b-perf-capac-ctrab
            where b-perf-capac-ctrab.cod-ctrab      = perf-capac-ctrab.cod-ctrab
              and b-perf-capac-ctrab.val-refer-perf < perf-capac-ctrab.val-refer-perf no-error.
    
        if  available b-perf-capac-ctrab
        and perf-capac-ctrab.val-carg-op-plan = b-perf-capac-ctrab.val-carg-op-plan
        and perf-capac-ctrab.val-carg-manut   = b-perf-capac-ctrab.val-carg-manut
        and perf-capac-ctrab.val-capac-carg   = b-perf-capac-ctrab.val-capac-carg then
            delete perf-capac-ctrab.
    end.
    
END PROCEDURE.

/* Fim do Include */
