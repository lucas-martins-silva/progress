DEFINE TEMP-TABLE ttManualRequisition NO-UNDO 
       FIELD cod-estabel LIKE movto-estoq.cod-estabel
       FIELD cod-estabel-desc AS character
       FIELD nro-docto LIKE movto-estoq.nro-docto
       FIELD serie-docto LIKE movto-estoq.serie-docto
       FIELD dt-trans LIKE movto-estoq.dt-trans
       FIELD it-codigo LIKE movto-estoq.it-codigo
       FIELD it-codigo-desc AS character
       FIELD cod-depos LIKE movto-estoq.cod-depos
       FIELD cod-depos-desc AS character
       FIELD cod-localiz LIKE movto-estoq.cod-localiz
       FIELD cod-localiz-desc AS character
       FIELD lote LIKE movto-estoq.lote
       FIELD dt-vali-lote LIKE saldo-estoq.dt-vali-lote
       FIELD cod-refer LIKE movto-estoq.cod-refer
       FIELD cod-refer-desc AS character
       FIELD quantidade LIKE movto-estoq.quantidade
       FIELD un LIKE movto-estoq.un
       FIELD un-desc AS character
       FIELD nr-ord-produ LIKE movto-estoq.nr-ord-produ
       FIELD tog-atualiza AS logical
       FIELD num-ord-inv LIKE movto-estoq.num-ord-inv
       FIELD ct-codigo LIKE movto-estoq.ct-codigo
       FIELD ct-titulo AS character
       FIELD cod-unid-negoc LIKE movto-estoq.cod-unid-negoc
       FIELD cod-unid-negoc-desc AS character
       FIELD cod-roteiro LIKE reservas.cod-roteiro
       FIELD item-pai LIKE reservas.item-pai
       FIELD op-codigo LIKE reservas.op-codigo
       FIELD dt-nf-saida LIKE movto-estoq.dt-nf-saida
       FIELD descricao-db LIKE movto-estoq.descricao-db
       FIELD sc-codigo LIKE movto-estoq.sc-codigo
       FIELD sc-titulo AS character
.
def var de-val-quantidade        like movto-estoq.quantidade     no-undo.
def var de-difere-val-quantidade like movto-estoq.quantidade     no-undo.
def var de-fracao-val-quantidade like movto-estoq.quantidade     no-undo.
def var i-ficha-cq               like ficha-cq.nr-ficha          no-undo.
def var sc-conta                 like movto-estoq.sc-codigo      no-undo.
def var ct-conta                 like movto-estoq.ct-codigo      no-undo.

def buffer b-saldo     for saldo-estoq.
def buffer b-mov-es    for movto-estoq.
def buffer b-movto     for movto-mat.
def buffer b-ordem     for ord-prod.
def var    h_api_cta   as handle no-undo.
def var h_api_ccust as handle no-undo.

{cqp/cqapi001.i}
{cpp/cpapi013.i}    /* Definicao da temp-table de alocacao    */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE createRequisition DBOFunction 
PROCEDURE createRequisitionCE0205 :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER TABLE FOR ttSummaryInventoryBalance.
    DEFINE INPUT PARAMETER p-nr-requisicao AS INTEGER NO-UNDO.
    DEFINE INPUT PARAMETER p-sequencia     AS INTEGER NO-UNDO.
    //DEFINE OUTPUT PARAMETER TABLE FOR RowErrors.
    
    DEF VAR h-boin029 AS HANDLE NO-UNDO.
    
    EMPTY TEMP-TABLE ttManualRequisition.
    
    
    FOR EACH ttSummaryInventoryBalance WHERE ttSummaryInventoryBalance.qt-a-atender > 0:
    
        CREATE ttManualRequisition.
        ASSIGN ttManualRequisition.cod-estabel    = it-requisicao.cod-estabel
               ttManualRequisition.nr-ord-produ   = it-requisicao.nr-ord-produ 
               ttManualRequisition.it-codigo      = it-requisicao.it-codigo 
               ttManualRequisition.item-pai       = it-requisicao.item-pai 
               ttManualRequisition.un             = it-requisicao.un         
               ttManualRequisition.ct-codigo      = it-requisicao.ct-codigo   
               ttManualRequisition.sc-codigo      = it-requisicao.sc-codigo   
               ttManualRequisition.cod-unid-negoc = it-requisicao.cod-unid-negoc   
               ttManualRequisition.op-codigo      = it-requisicao.op-seq   
               ttManualRequisition.cod-localiz    = ttSummaryInventoryBalance.cod-localiz 
               ttManualRequisition.dt-trans       = ttSummaryInventoryBalance.dt-trans 
               ttManualRequisition.cod-refer      = ttSummaryInventoryBalance.cod-refer   
               ttManualRequisition.cod-depos      = ttSummaryInventoryBalance.cod-depos   
               ttManualRequisition.lote           = ttSummaryInventoryBalance.lote       
               ttManualRequisition.dt-vali-lote   = ttSummaryInventoryBalance.dt-vali-lote       
               ttManualRequisition.quantidade     = ttSummaryInventoryBalance.qt-a-atender       
               ttManualRequisition.nro-docto      = string(it-requisicao.nr-requisicao,"999,999,999")
               ttManualRequisition.tog-atualiza   = TRUE   
               ttManualRequisition.serie-docto    = "".
               
     END.
     
    
    blockCreateRequisiton:
    DO ON ERROR UNDO blockCreateRequisiton, LEAVE blockCreateRequisiton
       ON STOP  UNDO blockCreateRequisiton, LEAVE blockCreateRequisiton
       ON QUIT  UNDO blockCreateRequisiton, LEAVE blockCreateRequisiton:   

        EMPTY TEMP-TABLE tt-movto.
        EMPTY TEMP-TABLE tt-movto-un.
        EMPTY TEMP-TABLE tt-erro.
        EMPTY TEMP-TABLE tt-erro-aux.
        EMPTY TEMP-TABLE tt-erro-inv.

        FIND FIRST ttManualRequisition NO-LOCK NO-ERROR.
    			
        /* Efetua as validacoes necessarias -------------------------------------*/
        RUN validateRecordCE0205 IN this-procedure (INPUT table ttManualRequisition).
                                             // OUTPUT table RowErrors).
    
        IF  RETURN-VALUE = "NOK":U THEN
            UNDO blockCreateRequisiton, RETURN "NOK":U.

        IF l-unidade-negocio AND ttManualRequisition.num-ord-inv <> 0 THEN DO:
           RUN ivbo/boiv029.p PERSISTENT SET h-boin029.
           RUN retornaMatrizUnidNegoc IN h-boin029 (INPUT ttManualRequisition.num-ord-inv,
                                                    OUTPUT table tt-matriz,
                                                    OUTPUT table tt-erro-inv).
           DELETE PROCEDURE h-boin029.
        END.

        IF AVAIL item                             AND 
           item.fraciona                    = NO  AND 
           item.tipo-contr                 <> 4   AND  
           l-unidade-negocio                = YES AND 
           ttManualRequisition.num-ord-inv <> 0   AND 
           CAN-FIND(FIRST tt-matriz)              THEN DO:
            FOR EACH tt-matriz:
                CREATE tt-movto-un.
                ASSIGN tt-movto-un.i-sequen      = 0
                       tt-movto-un.cod-unid-neg  = tt-matriz.cod-unid-neg
                       tt-movto-un.perc-unid-neg = tt-matriz.perc-rateio.
            END.                                        
            FOR EACH tt-matriz:
                DELETE tt-matriz.
            END.
        END.

        IF  l-unidade-negocio                    AND 
            ttManualRequisition.num-ord-inv <> 0 AND
            NOT CAN-FIND(FIRST tt-movto-un)      THEN DO:

            IF  CAN-FIND(FIRST tt-erro-inv NO-LOCK) THEN DO:
            
                FOR EACH tt-erro-inv:                        
                    RUN createRowErrors IN THIS-PROCEDURE(INPUT 2, INPUT tt-erro-inv.cd-erro, INPUT tt-erro-inv.mensagem).
                END.           
                UNDO blockCreateRequisiton, RETURN "NOK":U.
            END.

            ASSIGN de-val-quantidade        = ttManualRequisition.quantidade
                   de-difere-val-quantidade = ttManualRequisition.quantidade.
    
            FOR EACH tt-matriz:
                RUN createRecordCE0205 (INPUT tt-matriz.cod-unid-neg,
                                        INPUT tt-matriz.perc-rateio).
            END.
    
            FIND FIRST tt-movto NO-ERROR.
            IF  AVAIL tt-movto THEN DO:
    
                IF  de-difere-val-quantidade <> 0
                AND de-difere-val-quantidade < tt-movto.quantidade THEN
                    ASSIGN tt-movto.quantidade = tt-movto.quantidade + de-difere-val-quantidade.
            END.
    
            /* Ajusta quantidade(decimal) caso item n’o fraciona */
            IF  NOT item.fraciona THEN DO:
    
                ASSIGN de-fracao-val-quantidade = 0.
                FOR EACH tt-movto
                    BREAK BY tt-movto.quantidade:
    
                    ASSIGN de-fracao-val-quantidade = de-fracao-val-quantidade + (tt-movto.quantidade - trunc(tt-movto.quantidade,0))
                           tt-movto.quantidade = trunc(tt-movto.quantidade,0).
    
                    IF  LAST(tt-movto.quantidade) THEN
                        ASSIGN tt-movto.quantidade = tt-movto.quantidade + de-fracao-val-quantidade.
                END.
            END.
        END.
        ELSE 
            RUN createRecordCE0205 (INPUT ttManualRequisition.cod-unid-negoc,
                                    INPUT 100).
        
        if not valid-handle (h-ceapi001k) then
            RUN cep/ceapi001k.p PERSISTENT SET h-ceapi001k.

        IF CAN-FIND(FIRST tt-movto-un) THEN
           RUN pi-valida-movto-uneg IN h-ceapi001k (INPUT table tt-movto-un).

        RUN pi-execute IN h-ceapi001k (INPUT-OUTPUT table tt-movto,
                                       INPUT-OUTPUT table tt-erro-ceapi001k,
                                       INPUT YES). 
                                       
        IF VALID-HANDLE(h-ceapi001k) THEN DO:
            delete procedure h-ceapi001k.
            assign h-ceapi001k = ?.
        END.
          

        FIND FIRST tt-erro-ceapi001k NO-ERROR.
        IF  NOT AVAIL tt-erro-ceapi001k THEN DO:
            IF  ttManualRequisition.num-ord-inv <> 0 THEN DO:

                RUN inp/in2115.p(INPUT-OUTPUT table tt-movto,
                                 INPUT-OUTPUT table tt-erro-aux).
                IF  CAN-FIND (FIRST tt-erro-aux) THEN DO:

                    FOR EACH tt-erro-aux:
                        RUN createRowErrors IN THIS-PROCEDURE(INPUT 2, INPUT tt-erro-aux.cd-erro, INPUT tt-erro-aux.mensagem).
                    END.
                    UNDO blockCreateRequisiton, RETURN "NOK":U.
                END.
            END.
        END.
        ELSE DO:
            FOR EACH tt-erro-ceapi001k:
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 2, INPUT tt-erro-ceapi001k.cd-erro, INPUT tt-erro-ceapi001k.mensagem).
            END.
            UNDO blockCreateRequisiton, RETURN "NOK":U.
        END.
    
        find requisicao
            where requisicao.nr-requisicao = it-requisicao.nr-requisicao exclusive-lock no-error.
        find current it-requisicao exclusive-lock.
        
        assign requisicao.dt-atend         = ttManualRequisition.dt-trans
               it-requisicao.qt-atendida   = it-requisicao.qt-atendida   + ttManualRequisition.quantidade
               it-requisicao.qt-a-atender  = it-requisicao.qt-a-atender  - ttManualRequisition.quantidade
               it-requisicao.qt-a-devolver = it-requisicao.qt-a-devolver + ttManualRequisition.quantidade 
               it-requisicao.dt-atend      = ttManualRequisition.dt-trans.
               
        if  it-requisicao.qt-devolvida > 0 then do:
            assign it-requisicao.qt-devolvida = it-requisicao.qt-devolvida - ttManualRequisition.quantidade .
            if  it-requisicao.qt-devolvida < 0 then
                assign it-requisicao.qt-devolvida = 0.
        end.        
        
        FIND FIRST ws-atend-devol-it-requis NO-LOCK 
             WHERE ws-atend-devol-it-requis.nr-requisicao  = it-requisicao.nr-requisicao
               AND ws-atend-devol-it-requis.seq-it-requis  = it-requisicao.sequencia NO-ERROR.
        
        IF AVAIL ws-atend-devol-it-requis THEN DO:
              
            ASSIGN i-atend-em-processo = 0.
            FOR EACH ws-atend-devol-it-requis NO-LOCK
               WHERE ws-atend-devol-it-requis.nr-requisicao  = it-requisicao.nr-requisicao
                 AND ws-atend-devol-it-requis.seq-it-requis  = it-requisicao.sequencia
                 AND ws-atend-devol-it-requis.it-codigo      = it-requisicao.it-codigo
                 AND ws-atend-devol-it-requis.idi-tipo-movto = 1 // 1-Atendimento
                 AND (ws-atend-devol-it-requis.idi-sit-docto = 1 OR ws-atend-devol-it-requis.idi-sit-docto = 2)
                 BY ws-atend-devol-it-requis.seq-atend-devol.
                  ASSIGN i-atend-em-processo = i-atend-em-processo + 1.
            END.
                    
            IF  l-fim-req-WMS-SAAS
            AND i-atend-em-processo < 2
            AND it-requisicao.qt-atendida >= it-requisicao.qt-requisitada THEN DO:
                    ASSIGN it-requisicao.situacao     = 2 /* FECHADA */
                           it-requisicao.qt-a-atender = 0.
            END.
                
            IF it-requisicao.qt-a-atender < 0 THEN ASSIGN it-requisicao.qt-a-atender = 0.
                
            find first bfit-requisicao
                where bfit-requisicao.nr-requisicao = it-requisicao.nr-requisicao 
                and   bfit-requisicao.situacao      = 1
                no-lock no-error.
            if  not avail bfit-requisicao then do:
                assign requisicao.situacao = 2.
            end.           
        
        END.
        ELSE DO:
            if  it-requisicao.qt-a-atender = 0 then do:
                assign it-requisicao.situacao = 2.
                
                find first bfit-requisicao
                     where bfit-requisicao.nr-requisicao = it-requisicao.nr-requisicao
                     and   bfit-requisicao.situacao      = 1
                no-lock no-error.
                
                if  not avail bfit-requisicao then do:
                      assign requisicao.situacao = 2.
                end.
                
            end.
        END.
        
        RELEASE it-requisicao.
        RELEASE requisicao.

        /* Integracao Controle Qualidade */
        IF  AVAIL param-global     AND param-global.modulo-cq 
        AND AVAIL deposito         AND deposito.ind-dep-cq 
        AND AVAIL item-uni-estab   AND item-uni-estab.contr-qualid THEN DO:
    
            CREATE tt-ficha.
            ASSIGN tt-ficha.cod-estabel  = ttManualRequisition.cod-estabel
                   tt-ficha.it-codigo    = ttManualRequisition.it-codigo
                   tt-ficha.nro-docto    = ttManualRequisition.nro-docto
                   tt-ficha.serie-docto  = ttManualRequisition.serie-docto
                   tt-ficha.cod-depos    = ttManualRequisition.cod-depos
                   tt-ficha.cod-localiz  = ttManualRequisition.cod-localiz
                   tt-ficha.lote         = ttManualRequisition.lote
                   tt-ficha.cod-refer    = ttManualRequisition.cod-refer
                   tt-ficha.qt-original  = ttManualRequisition.quantidade
                   tt-ficha.ct-destino   = ttManualRequisition.ct-codigo
                   tt-ficha.sc-destino   = ttManualRequisition.sc-codigo
                   tt-ficha.baixa-estoq  = YES
                   tt-ficha.origem       = 2
                   tt-ficha.data-1       = ttManualRequisition.dt-trans. 
    
            RUN cqp/cqapi001.p  (INPUT-OUTPUT table tt-ficha,
                                 INPUT-OUTPUT table tt-erro,
                                 INPUT-OUTPUT i-ficha-cq,
                                 INPUT-OUTPUT ttManualRequisition.op-codigo).
    
            FOR EACH tt-erro:
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 2, INPUT tt-erro.cd-erro, INPUT tt-erro.mensagem).
            END.
        END.
    END.

 END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE createRequisitionReturn DBOFunction 
PROCEDURE createRequisitionReturn :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE INPUT PARAMETER TABLE FOR ttSummaryInventoryBalance.
    def output param table for RowErrors.
    DEF VAR l-erro                   AS   LOGICAL                    NO-UNDO.
    
    EMPTY TEMP-TABLE ttManualRequisition.
    empty temp-table tt-movto.
    empty temp-table tt-erro.

    
    
    FOR EACH ttSummaryInventoryBalance WHERE ttSummaryInventoryBalance.qt-a-atender > 0:

        FIND FIRST movto-estoq NO-LOCK
         WHERE ROWID(movto-estoq) = TO-ROWID(ttSummaryInventoryBalance.rw-movto) NO-ERROR.
    
        CREATE ttManualRequisition.
        ASSIGN ttManualRequisition.cod-estabel    = it-requisicao.cod-estabel
               ttManualRequisition.nr-ord-produ   = it-requisicao.nr-ord-produ 
               ttManualRequisition.it-codigo      = it-requisicao.it-codigo 
               ttManualRequisition.item-pai       = it-requisicao.item-pai 
               ttManualRequisition.un             = it-requisicao.un         
               ttManualRequisition.ct-codigo      = it-requisicao.ct-codigo   
               ttManualRequisition.sc-codigo      = it-requisicao.sc-codigo   
               ttManualRequisition.cod-unid-negoc = it-requisicao.cod-unid-negoc   
               ttManualRequisition.op-codigo      = it-requisicao.op-seq   
               ttManualRequisition.cod-localiz    = ttSummaryInventoryBalance.cod-localiz 
               ttManualRequisition.dt-trans       = ttSummaryInventoryBalance.dt-trans 
               ttManualRequisition.cod-refer      = ttSummaryInventoryBalance.cod-refer   
               ttManualRequisition.cod-depos      = ttSummaryInventoryBalance.cod-depos   
               ttManualRequisition.lote           = ttSummaryInventoryBalance.lote       
               ttManualRequisition.dt-nf-saida    = IF AVAIL movto-estoq THEN movto-estoq.dt-trans ELSE ?
               ttManualRequisition.dt-vali-lote   = ttSummaryInventoryBalance.dt-vali-lote       
               ttManualRequisition.quantidade     = ttSummaryInventoryBalance.qt-a-atender       
               ttManualRequisition.nro-docto      = string(it-requisicao.nr-requisicao,"999,999,999")
               ttManualRequisition.tog-atualiza   = TRUE   
               ttManualRequisition.serie-docto    = "".
               
    END.

    blockCreateRequisitionReturn:
    do  on error undo blockCreateRequisitionReturn, leave blockCreateRequisitionReturn
        on stop  undo blockCreateRequisitionReturn, leave blockCreateRequisitionReturn
        on quit  undo blockCreateRequisitionReturn, leave blockCreateRequisitionReturn: 

        find first ttManualRequisition no-lock no-error.

        if ttManualRequisition.cod-estabel = ? then assign ttManualRequisition.cod-estabel = "":U.
        if ttManualRequisition.cod-localiz = ? then assign ttManualRequisition.cod-localiz = "":U.
        if ttManualRequisition.cod-refer   = ? then assign ttManualRequisition.cod-refer   = "":U.
        if ttManualRequisition.cod-depos   = ? then assign ttManualRequisition.cod-depos   = "":U.
        if ttManualRequisition.un          = ? then assign ttManualRequisition.un          = "":U.
        if ttManualRequisition.ct-codigo   = ? then assign ttManualRequisition.ct-codigo   = "":U.
        if ttManualRequisition.sc-codigo   = ? then assign ttManualRequisition.sc-codigo   = "":U.
        if ttManualRequisition.lote        = ? then assign ttManualRequisition.lote        = "":U.
        if ttManualRequisition.nro-docto   = ? then assign ttManualRequisition.nro-docto   = "":U.
        if ttManualRequisition.serie-docto = ? then assign ttManualRequisition.serie-docto = "":U.
		
		
        /* Efetua as validacoes necessarias -------------------------------------*/
        run validateRecordReturn in this-procedure (input table ttManualRequisition,
                                                    output table RowErrors).
        if  return-value = "NOK":U then
            undo blockCreateRequisitionReturn, return "NOK":U.
    
        /* Gera a movimentacao de estoque -----------------------------------------*/
        run createRecordReturn (input  table ttManualRequisition,
                                output table RowErrors).

        RUN haveRowErrors IN THIS-PROCEDURE(OUTPUT l-erro).

        if not l-erro then 
            run atualizaQuantidadesItemReq (input table ttSummaryInventoryBalance).

        if  return-value <> "OK":U then
            undo blockCreateRequisitionReturn, return "NOK":U.
    end.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecordReturn DBOFunction 
PROCEDURE validateRecordReturn :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input  param table for ttManualRequisition.
    def output param table for RowErrors.

    def var c-estabelec              like movto-estoq.cod-estabel    no-undo.
    def var c-cod-estabel-usuar      like movto-estoq.cod-estabel    no-undo.
    def var i-empresa                like param-global.empresa-prin  no-undo.
    def var l-utiliza-ccusto         as   log                        no-undo.
    def var v_des_cta_ctbl           AS   CHAR                       no-undo.
    def var v_num_tip_cta_ctbl       AS   INTEGER                    no-undo.
    def var v_num_sit_cta_ctbl       AS   INTEGER                    no-undo.
    def var v_ind_finalid_cta        AS   CHAR                       no-undo.
    def var v_des_ccusto             AS   CHAR                       no-undo.
    DEF VAR l-erro                   AS   LOGICAL                    NO-UNDO.

    find first param-global no-lock.

    userCodeBlock:
    DO ON ERROR UNDO, LEAVE userCodeBlock
       ON STOP  UNDO, LEAVE userCodeBlock
       ON QUIT  UNDO, LEAVE userCodeBlock:
    
        find first ttManualRequisition no-lock no-error.
    
        empty temp-table tt-movto.
		
		//{cdp/cd9970.i ttManualRequisition.cod-estabel}
        assign i-empresa = param-global.empresa-prin when avail param-global.
    
        if  ttManualRequisition.dt-trans > today then do:
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1929, INPUT ""). 
        end.

        /* Inicio -- Projeto Internacional */
        DEFINE VARIABLE c-item AS CHARACTER FORMAT "X(4)" NO-UNDO.
        {utp/ut-liter.i "Item" *}
        ASSIGN c-item = TRIM(RETURN-VALUE).
    
        find first item no-lock
             where item.it-codigo = ttManualRequisition.it-codigo no-error.
        if  not avail item then do:
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2, INPUT "c-item"). 
        end.
        else do: 
            
            if  item.cod-obsoleto = 4 then do:
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1885, INPUT ""). 
                RETURN "NOK".
            end.
    
            if  item.it-codigo = "" or item.tipo-contr = 4 then do:
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1886, INPUT ""). 
                RETURN "NOK".
            end.
    
            if  ttManualRequisition.quantidade > 1 and item.tipo-con-est = 2 then do:     
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 5048, INPUT ""). 
                RETURN "NOK".
            end.
        end.
    
        if  ttManualRequisition.nr-ord-produ <> 0
        and avail param-global      
        and (   param-global.modulo-cp  
             or param-global.modulo-mi) then do:
    
            if  not avail ord-prod
            or  (avail ord-prod and ord-prod.nr-ord-produ <> ttManualRequisition.nr-ord-produ) then
                find first ord-prod no-lock
                    where ord-prod.nr-ord-produ = ttManualRequisition.nr-ord-produ no-error.
    
            if  avail ord-prod then do:
    
                if  ord-prod.rep-prod > 1 
                and ord-prod.rep-prod < 4 then do:
    
                    if  ttManualRequisition.op-codigo <> 0  
                    or  ttManualRequisition.cod-roteiro  <> "" then do:
    
                        find first oper-ord no-lock
                            where oper-ord.nr-ord-produ = ttManualRequisition.nr-ord-produ
                              and oper-ord.it-codigo   = ttManualRequisition.item-pai 
                              and oper-ord.op-codigo   = ttManualRequisition.op-codigo 
                              and oper-ord.cod-roteiro     = ttManualRequisition.cod-roteiro no-error.
                        if  not avail oper-ord then do:
                            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 17006, INPUT "Opera?Æo/Roteiro Inv lido para Item-Pai."). 
                               RETURN "NOK".
    
                        end.
                        else 
                            assign i-seq = oper-ord.sequencia.
                    end.
                end.
                else assign i-seq = 0.
    
                if  ord-prod.estado = 8  then do:
                    RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1881, INPUT ""). 
                    RETURN "NOK".
                end.
    
                if  ord-prod.estado = 7 then do:
    
                    find first ord-manut no-lock
                         where ord-manut.nr-ord-produ = ord-prod.nr-ord-produ no-error.
                    if  not avail ord-manut then do:
                        RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1881, INPUT ""). 
                        RETURN "NOK".
                    end.
                end.
                
                if  avail item
                and item.it-codigo = ord-prod.it-codigo 
                and ord-prod.tipo <> 5 
                and ord-prod.tipo <> 9 then do:
                    RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2008, INPUT ""). 
                    RETURN "NOK".
                end.
    
                find first reservas no-lock
                    where reservas.nr-ord-produ = ord-prod.nr-ord-produ 
                    and   reservas.it-codigo    = ttManualRequisition.it-codigo no-error.
                if  avail reservas then do:
                    if  avail item
                    and item.tipo-requis = 2 then do:
                        RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 5675, INPUT ""). 
                        RETURN "NOK".
                    end.
                end.
    
                if  (ord-prod.rep-prod > 1 and ord-prod.rep-prod < 4) 
                or  avail reservas then
                    /* ce0205.i1 */
                    run validateOrdProd. 
    
            end.
            else do:
    
                /* Ordem de Producao nao encontrada */
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1879, INPUT ""). 
                RETURN "NOK".
            end.
        end.
    
        find first b-mov-es use-index data-item 
             where b-mov-es.dt-trans    = ttManualRequisition.dt-nf-saida
             and   b-mov-es.cod-estabel = ttManualRequisition.cod-estabel
             and   b-mov-es.it-codigo   = ttManualRequisition.it-codigo
             and   b-mov-es.esp-docto   = 28
             and   b-mov-es.op-seq      = if avail ord-prod and ord-prod.nr-ord-produ <> 0 and ord-prod.rep-prod <> 1 and ord-prod.rep-prod <> 4 
                                          then i-seq 
                                          else 0 no-lock no-error.
        if  not avail b-mov-es 
        and i-seq <> 0 then do:
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 7400, INPUT ""). 
            RETURN "NOK".
        end.
    
        assign ct-conta = ttManualRequisition.ct-codigo
               sc-conta = ttManualRequisition.sc-codigo.
 
        if not valid-handle(h_api_cta) then
            run prgint/utb/utb743za.py persistent set h_api_cta.
        
        /* Valida conta e centro de custo */
        run pi_valida_conta_contabil in h_api_cta (input  i-empresa,          /* EMPRESA EMS2 */
                                                   input  ttManualRequisition.cod-estabel,  /* ESTABELECIMENTO EMS2 */
                                                   input  "",                 /* UNIDADE NEGàCIO */
                                                   input  "",                 /* PLANO CONTAS */ 
                                                   input  ct-conta,           /* CONTA */
                                                   input  "",                 /* PLANO CCUSTO */ 
                                                   input  sc-conta,           /* CCUSTO */
                                                   input  today,              /* DATA TRANSACAO */
                                                   output table tt_log_erro). /* ERROS */
        
        find first tt_log_erro no-lock no-error.
        if avail tt_log_erro then do: 
			 for each tt_log_erro:
                    RUN createRowErrors IN THIS-PROCEDURE(INPUT 2, INPUT tt_log_erro.ttv_des_msg_erro, INPUT tt_log_erro.ttv_des_msg_ajuda). 
                    RETURN "NOK".
			end.
										
        end.
        else do:
            /* Busca finalidade, tipo e situa?Æo da conta */        
            run pi_busca_dados_cta_ctbl in h_api_cta (input        i-empresa,          /* EMPRESA EMS2 */
                                                      input        "",                 /* PLANO DE CONTAS */
                                                      input-output ct-conta,           /* CONTA */
                                                      input        today,              /* DATA TRANSACAO */   
                                                      output       v_des_cta_ctbl,     /* DESCRICAO CONTA */
                                                      output       v_num_tip_cta_ctbl, /* TIPO DA CONTA */
                                                      output       v_num_sit_cta_ctbl, /* SITUA°?O DA CONTA */
                                                      output       v_ind_finalid_cta,  /* FINALIDADES DA CONTA */
                                                      output table tt_log_erro).       /* ERROS */            
            
            if v_num_sit_cta_ctbl <> 3 then do:
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 443, INPUT ""). 
                RETURN "NOK". 
            end.
        end.
        
        /*TÉCNICA DE INTERNACIONALIZAÇÃO*/
        DEFINE VARIABLE c-unidade_negocio AS CHARACTER FORMAT "X(21)" NO-UNDO.
        {utp/ut-liter.i "'Unidade de Neg¢cio'" *}
        ASSIGN c-unidade_negocio = TRIM(RETURN-VALUE).

        DEFINE VARIABLE c-estabecimento AS CHARACTER FORMAT "X(17)" NO-UNDO.
        {utp/ut-liter.i "'Estabelecimento'" *}
        ASSIGN c-estabecimento = TRIM(RETURN-VALUE).

        DEFINE VARIABLE c-deposito AS CHARACTER FORMAT "X(11)" NO-UNDO.
        {utp/ut-liter.i "'Dep¢sito'" *}
        ASSIGN c-deposito = TRIM(RETURN-VALUE).
        
        DEFINE VARIABLE c-referencia AS CHARACTER FORMAT "X(13)" NO-UNDO.
        {utp/ut-liter.i "'Refer?ncia'" *}
        ASSIGN c-referencia = TRIM(RETURN-VALUE).

         DEFINE VARIABLE c-unidade_medida AS CHARACTER FORMAT "X(19)" NO-UNDO.
        {utp/ut-liter.i "'Unidade de Medida'" *}
        ASSIGN c-unidade_medida = TRIM(RETURN-VALUE).

        if valid-handle(h_api_cta) then
            delete object h_api_cta.         
    
        if  l-unidade-negocio 
        and ttManualRequisition.cod-unid-negoc <> "" then do:
    
            if  not can-find (first unid-negoc
                             where unid-negoc.cod-unid-negoc = ttManualRequisition.cod-unid-negoc) then do:
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2, INPUT "c-unidade_negocio"). 
                RETURN "NOK".
            end.
        end.
    
        find first estabelec no-lock
             where estabelec.cod-estabel = ttManualRequisition.cod-estabel no-error.
        if  not avail estabelec then do:
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2, INPUT "c-estabecimento").
            RETURN "NOK".
        end.
    
        find first deposito no-lock 
             where deposito.cod-depos = ttManualRequisition.cod-depos no-error.
        if  avail deposito then do:
    
            if  avail item 
            and avail estabelec then
                for first item-uni-estab fields (contr-qualid)
                    where item-uni-estab.it-codigo   = item.it-codigo
                    and   item-uni-estab.cod-estabel = estabelec.cod-estabel no-lock. end.
    
            if  deposito.ind-dep-rej 
            and (avail item-uni-estab and item-uni-estab.contr-qualid) then do:
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1888, INPUT "").
                RETURN "NOK".
            end.
        end.
        else do:
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2, INPUT "c-deposito").
            RETURN "NOK".
        end.
    
        if  avail item
        and item.tipo-con-est > 1 and ttManualRequisition.lote = "" then do:
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2158, INPUT "").
            RETURN "NOK".
        end.
    
    
        find first item-uni-estab no-lock
             where item-uni-estab.it-codigo   = ttManualRequisition.it-codigo
             and   item-uni-estab.cod-estabel = ttManualRequisition.cod-estabel no-error.
        if  not avail item-uni-estab then do:
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2158, INPUT "").
            RETURN "NOK".
        end.
    
        if  avail item
        and item.tipo-con-est = 2 then do:
    
            find first b-saldo use-index lote
                 where b-saldo.lote        = ttManualRequisition.lote 
                 and   b-saldo.it-codigo   = item.it-codigo 
                 and   b-saldo.qtidade-atu > 0 no-lock no-error.
            if  avail b-saldo and b-saldo.qtidade-atu > 0 then do:
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1889, INPUT "").
                RETURN "NOK".
            end.
        end.
    
        if  avail item
        and (item.tipo-con-est = 3 or item.tipo-con-est = 4) then do:
    
            find first b-saldo no-lock
                 where b-saldo.lote      = ttManualRequisition.lote 
                 and   b-saldo.cod-refer = ttManualRequisition.cod-refer
                 and   b-saldo.it-codigo = item.it-codigo no-error.
            if  not avail b-saldo then do:
    
                if  ttManualRequisition.dt-vali-lote = ? then do:
                    RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2205, INPUT "").
                    RETURN "NOK".
                end.
    
                if item.tipo-con-est = 4 then do:
    
                    find first referencia no-lock
                         where referencia.cod-refer = ttManualRequisition.cod-refer no-error.
                    if  not avail referencia then do:
                        RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2, INPUT "c-referencia").
                        RETURN "NOK".
                    end.
                end.
            end.
        end.
    
        find tab-unidade 
            where tab-unidade.un = ttManualRequisition.un no-lock no-error.
        if  avail tab-unidade then do:
            
            if  avail item
            and ttManualRequisition.un <> item.un then do:
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2, INPUT "").
                RETURN "NOK".
            end.
            
        end.
        else do:
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2, INPUT "c-unidade_medida").
            RETURN "NOK".
        end.
    
        if  ttManualRequisition.quantidade <= 0 then do:
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1368, INPUT ""). 
            RETURN "NOK".
        end.
    
        if  avail item
        and not item.fraciona 
        and ttManualRequisition.quantidade <> integer(ttManualRequisition.quantidade) then do:
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1892, INPUT ""). 
            RETURN "NOK".
        end.
    END.

    if  can-find(first RowErrors where RowErrors.ErrorSubType = "ERROR":U) then 
        return "NOK":U.  

    return "OK":U.
END PROCEDURE.


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE createRecord DBOFunction 
PROCEDURE createRecordReturn :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input  param table for ttManualRequisition.
    def output param table for RowErrors.

    def var cod-deposito-pad        like movto-estoq.cod-depos       no-undo.
    def var cod-localiz             like movto-estoq.cod-localiz     no-undo.

    find first item where item.it-codigo = ttManualRequisition.it-codigo no-error.

    userCodeBlock:
    DO ON ERROR UNDO, LEAVE userCodeBlock
       ON STOP  UNDO, LEAVE userCodeBlock
       ON QUIT  UNDO, LEAVE userCodeBlock:
    
        find first saldo-estoq use-index estabel-dep 
             where saldo-estoq.cod-estabel = ttManualRequisition.cod-estabel
             and   saldo-estoq.cod-depos   = ttManualRequisition.cod-depos
             and   saldo-estoq.cod-localiz = ttManualRequisition.cod-localiz
             and   saldo-estoq.lote        = ttManualRequisition.lote
             and   saldo-estoq.cod-refer   = ttManualRequisition.cod-refer
             and   saldo-estoq.it-codigo   = ttManualRequisition.it-codigo no-lock no-error.
        
        empty temp-table tt-matriz.
        
        if  l-unidade-negocio and ttManualRequisition.num-ord-inv <> 0 then do:
        
            run ivbo/boiv029.p persistent set h-boiv029.
            run retornaMatrizUnidNegoc in h-boiv029 (input  ttManualRequisition.num-ord-inv,
                                                     output table tt-matriz,
                                                     output table tt-erro-inv).
            delete procedure h-boiv029.
        
            if  can-find(first tt-erro-inv) then do:
                for each tt-erro-inv:
                     RUN createRowErrors IN THIS-PROCEDURE(INPUT 2, INPUT tt-erro-inv.cd-erro, INPUT tt-erro-inv.mensagem). 
                     return "NOK":U.
                end.
            end.
        end.
        else do:
    
            create tt-matriz.
            assign tt-matriz.cod-unid-neg = ttManualRequisition.cod-unid-negoc
                   tt-matriz.perc-rateio  = 100.
        end.
        
        for each tt-matriz:
            create tt-movto.  
            assign tt-movto.cod-versao-integracao = 1
                   tt-movto.dt-trans         = ttManualRequisition.dt-trans
                   tt-movto.nr-ord-produ     = ttManualRequisition.nr-ord-produ
                   tt-movto.num-ord-inv      = ttManualRequisition.num-ord-inv
                   tt-movto.nro-docto        = ttManualRequisition.nro-docto
                   tt-movto.serie-docto      = ttManualRequisition.serie-docto
                   tt-movto.ct-codigo        = ttManualRequisition.ct-codigo
                   tt-movto.sc-codigo        = ttManualRequisition.sc-codigo
                   tt-movto.it-codigo        = ttManualRequisition.it-codigo
                   tt-movto.cod-estabel      = ttManualRequisition.cod-estabel
                   tt-movto.cod-depos        = ttManualRequisition.cod-depos
                   tt-movto.num-sequen       = it-requisicao.sequencia
                   tt-movto.sequen-nf        = it-requisicao.sequencia
                   tt-movto.cod-localiz      = ttManualRequisition.cod-localiz
                   tt-movto.cod-refer        = ttManualRequisition.cod-refer
                   tt-movto.lote             = ttManualRequisition.lote
                   tt-movto.quantidade       = ttManualRequisition.quantidade * tt-matriz.perc-rateio / 100
                   tt-movto.un               = ttManualRequisition.un
                   tt-movto.tipo-trans       = 1
                   tt-movto.dt-nf-saida      = ttManualRequisition.dt-nf-saida
                   tt-movto.cod-prog-orig    = "dvReqPOUI":U
                   tt-movto.esp-docto        = 5 /* requisicao */  
                   tt-movto.dt-vali-lote     = ttManualRequisition.dt-vali-lote
                   tt-movto.op-seq           = if avail ord-prod and ord-prod.nr-ord-produ <> 0 and ord-prod.rep-prod <> 1 and ord-prod.rep-prod <> 4 then i-seq else 0
                   tt-movto.usuario          = c-seg-usuario 
                   tt-movto.descricao-db     = ttManualRequisition.descricao-db.
    
        
            if  l-unidade-negocio then
                assign tt-movto.cod-unid-negoc = tt-matriz.cod-unid-neg. 
        
            find first oper-ord no-lock
                 where oper-ord.it-codigo    = ttManualRequisition.item-pai
                 and   oper-ord.nr-ord-produ = ttManualRequisition.nr-ord-produ
                 and   oper-ord.op-codigo    = ttManualRequisition.op-codigo
                 and   oper-ord.cod-roteiro  = ttManualRequisition.cod-roteiro no-error.
            if  avail(oper-ord) then
                assign tt-movto.op-seq = if  avail ord-prod            
                                         and ord-prod.nr-ord-produ <> 0 
                                         and ord-prod.rep-prod    <> 1 
                                         and ord-prod.rep-prod    <> 4 then oper-ord.sequencia 
                                         else 0.
            
            
            
            if  ttManualRequisition.cod-depos = "" then
                assign tt-movto.cod-depos = item.deposito-pad.

             run cep/ceapi014.p (input ttManualRequisition.it-codigo,
                                 input ttManualRequisition.cod-estabel,
                                 output cod-deposito-pad,
                                 output cod-localiz,
                                 output loc-unica).

            if  ttManualRequisition.cod-localiz = "" and not loc-unica then
                assign tt-movto.cod-localiz = item.cod-localiz.
    
            if  avail ord-prod then
                assign tt-movto.ct-codigo    = ord-prod.ct-codigo
                       tt-movto.sc-codigo    = ord-prod.sc-codigo
                       tt-movto.num-ord-inv  = ord-prod.num-ord-inv.
    
            find first param-global no-lock no-error.
            if  avail param-global and param-global.modulo-cs then do:
    
                find last b-movto use-index num-seq 
                    where b-movto.nr-ord-produ = ord-prod.nr-ord-produ no-lock no-error.
                if  avail b-movto then
                    assign tt-movto.num-sequen = if  avail ord-prod         
                                                 and ord-prod.rep-prod <> 1 
                                                 and ord-prod.rep-prod <> 4 then b-movto.num-sequen + 1
                                                 else 0.
                else
                    assign tt-movto.num-sequen = if  avail ord-prod         
                                                 and ord-prod.rep-prod <> 1 
                                                 and ord-prod.rep-prod <> 4 then 1
                                                 else 0.        
            end.
        end.
    
        empty temp-table tt-erro.
        empty temp-table tt-erro-aux.
        
        find first tt-movto no-error.
        run cep/ceapi001k.p persistent set h-ceapi001k.
        run pi-execute in h-ceapi001k (input-output table tt-movto,
                                       input-output table tt-erro-ceapi001k,
                                       input yes).     
        
        find first tt-erro-ceapi001k no-lock no-error.
        if  not avail tt-erro-ceapi001k then do:
    
            if  ttManualRequisition.num-ord-inv <> 0 then do:
    
                run inp/in2115.p(input-output table tt-movto,
                                 input-output table tt-erro-aux).
    
                find first tt-erro-aux no-lock no-error.
                if  avail tt-erro-aux then do:
    
                    for each tt-erro-aux:
                        RUN createRowErrors IN THIS-PROCEDURE(INPUT 2, INPUT tt-erro-aux.cd-erro, INPUT tt-erro-aux.mensagem). 
                        return "NOK":U.
                    end.

                end.
            end.
        end.
        else do:
            for each tt-erro-ceapi001k:
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 2, INPUT tt-erro-ceapi001k.cd-erro, INPUT tt-erro-ceapi001k.mensagem).
                return "NOK":U.
            end.
        end.
        
        find first tt-movto no-error.
    
        find first movto-estoq no-lock
             where rowid(movto-estoq) = tt-movto.r-mov-inv no-error.
    
        find first item-uni-estab no-lock
             where item-uni-estab.it-codigo   = ttManualRequisition.it-codigo
             and   item-uni-estab.cod-estabel = ttManualRequisition.cod-estabel no-error.
    
        find first deposito no-lock
             where deposito.cod-depos = ttManualRequisition.cod-depos no-error.
        
        if  param-global.modulo-cq      and deposito.ind-dep-cq 
        and item-uni-estab.contr-qualid and param-cq.tipo-cq > 0 then do:
    
            create tt-ficha.
            assign tt-ficha.cod-depos    = ttManualRequisition.cod-depos
                   tt-ficha.cod-estabel  = ttManualRequisition.cod-estabel
                   tt-ficha.it-codigo    = ttManualRequisition.it-codigo
                   tt-ficha.cod-localiz  = ttManualRequisition.cod-localiz
                   tt-ficha.lote         = ttManualRequisition.lote
                   tt-ficha.nr-ord-produ = ttManualRequisition.nr-ord-produ
                   tt-ficha.op-seq       = if avail ord-prod and ord-prod.nr-ord-produ <> 0 and ord-prod.rep-prod <> 1 and ord-prod.rep-prod <> 4 then movto-estoq.op-seq else 0
                   tt-ficha.nr-ordem     = ttManualRequisition.nr-ord-produ
                   tt-ficha.nro-docto    = ttManualRequisition.nro-docto
                   tt-ficha.origem       = 1
                   tt-ficha.ct-destino   = movto-estoq.ct-codigo
                   tt-ficha.sc-destino   = movto-estoq.sc-codigo
                   tt-ficha.nat-operacao = movto-estoq.nat-operacao
                   tt-ficha.cod-emitente = movto-estoq.cod-emitente
                   tt-ficha.qt-original  = ttManualRequisition.quantidade
                   tt-ficha.serie-docto  = ttManualRequisition.serie-docto
                   tt-ficha.baixa-estoq  = yes
                   tt-ficha.cod-refer    = ttManualRequisition.cod-refer.
        
            run cqp/cqapi001.p (input-output table tt-ficha,
                                input-output table tt-erro,
                                input-output i-ficha-cq,
                                input-output ttManualRequisition.op-codigo).
        
            if  avail tt-erro then do: 
    
                for each tt-erro:
                    RUN createRowErrors IN THIS-PROCEDURE(INPUT 2, INPUT tt-erro.cd-erro, INPUT tt-erro.mensagem).
                    return "NOK":U.
                end.
            end.
        end.
        
        /**************************** retirada a baixa das reservas **********************************/
        if  avail ord-prod and param-global.modulo-cp then do:
    
            &if defined (bf_man_linha_estab) &then
            
            find first lin-prod no-lock
                 where lin-prod.cod-estabel = ord-prod.cod-estabel
                 and   lin-prod.nr-linha    = ord-prod.nr-linha no-error.
    
            &else
            
            find first lin-prod no-lock 
                 where lin-prod.nr-linha = ord-prod.nr-linha no-error.
    
            &endif 
            
            if  not ttManualRequisition.tog-atualiza then do:
    
                if  avail lin-prod and lin-prod.sum-requis = 1 then do:
                    RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1901, INPUT "").
                    return "NOK":U.
                end.
            end.
    
            if  avail ord-prod then do:
    
                find b-ordem 
                    where b-ordem.nr-ord-produ = ord-prod.nr-ord-produ exclusive-lock no-error.
                if  avail b-ordem and b-ordem.estado <> 6  then do:
    
                    assign b-ordem.estado = 5.
                    release b-ordem.
                end.
            end.
        end.
    END.

    return "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE atualizaQuantidadesItem DBOFunction 
PROCEDURE atualizaQuantidadesItemReq PRIVATE:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER TABLE FOR ttSummaryInventoryBalance.

    FOR EACH ttSummaryInventoryBalance WHERE ttSummaryInventoryBalance.qt-a-atender > 0:
        
        FIND FIRST it-requisicao EXCLUSIVE-LOCK
             WHERE it-requisicao.nr-requisicao = ttSummaryInventoryBalance.nr-requisicao
               AND it-requisicao.sequencia     = ttSummaryInventoryBalance.sequencia NO-ERROR.

        FIND FIRST requisicao EXCLUSIVE-LOCK
             WHERE requisicao.nr-requisicao = it-requisicao.nr-requisicao NO-ERROR.
    
        ASSIGN it-requisicao.qt-devolvida  = it-requisicao.qt-devolvida   + ttSummaryInventoryBalance.qt-a-atender /*Qt devolvida*/
               it-requisicao.qt-a-devolver = it-requisicao.qt-a-devolver  - ttSummaryInventoryBalance.qt-a-atender /*Qt devolvida*/
               it-requisicao.qt-atendida   = it-requisicao.qt-atendida    - ttSummaryInventoryBalance.qt-a-atender /*Qt devolvida*/
               it-requisicao.qt-a-atender  = it-requisicao.qt-requisitada - it-requisicao.qt-atendida.
               
        IF it-requisicao.qt-a-atender < 0 AND 
            CAN-FIND (FIRST ws-atend-devol-requis-job NO-LOCK
                      WHERE ws-atend-devol-requis-job.nr-requisicao = ttSummaryInventoryBalance.nr-requisicao
                        AND ws-atend-devol-requis-job.seq-it-requis = ttSummaryInventoryBalance.sequencia) THEN           
            ASSIGN it-requisicao.qt-a-atender = 0.   

        IF AVAILABLE requisicao THEN DO:
            ASSIGN requisicao.dt-devol    = today
                   requisicao.situacao    = 1
                   it-requisicao.situacao = 1.
        END.
                        
    END.

    RELEASE requisicao.
    RELEASE it-requisicao.
     
    RETURN "OK":U.
END PROCEDURE.
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOFunction 
PROCEDURE validateRecordCE0205 :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEF INPUT  PARAM table FOR ttManualRequisition.
    //DEF OUTPUT PARAM table FOR RowErrors.

    DEF VAR i-seq-erro       AS INT     NO-UNDO.
    DEF VAR h_api_cta        AS HANDLE  NO-UNDO.
    DEF VAR h_api_ccust      AS HANDLE  NO-UNDO.
    
    def var c-estabelec              like movto-estoq.cod-estabel    no-undo.
    def var c-cod-estabel-usuar      like movto-estoq.cod-estabel    no-undo.
    def var i-empresa                like param-global.empresa-prin  no-undo.
    def var l-utiliza-ccusto         as   log                        no-undo.
    def var v_des_cta_ctbl           AS   CHAR                       no-undo.
    def var v_num_tip_cta_ctbl       AS   INTEGER                    no-undo.
    def var v_num_sit_cta_ctbl       AS   INTEGER                    no-undo.
    def var v_ind_finalid_cta        AS   CHAR                       no-undo.
    def var v_des_ccusto             AS   CHAR                       no-undo.
    DEF VAR l-erro                   AS   LOGICAL                    NO-UNDO.
	
    EMPTY TEMP-TABLE tt-movto.
    EMPTY TEMP-TABLE tt-movto-un.
    
    find first param-estoq no-lock no-error.
    if  avail param-estoq then do:

        assign c-cod-estabel-usuar = param-estoq.estabel-pad.

        /* Funcao Super/Minas */
        &if defined(Bf_dis_usuario_estab) &then
        
            if  can-find(first funcao 
                        where funcao.cd-funcao = "Fn-estab-usuario":U
                        and   funcao.ativo     = yes) then
                run cdp/cd8702.p (input c-seg-usuario,
                                  input-output c-cod-estabel-usuar).
        &endif
        
        assign c-estabelec = c-cod-estabel-usuar.
    end.    
        
    /* Seta Empresa */
    assign i-empresa = param-global.empresa-prin when avail param-global.

    &if defined (bf_dis_consiste_conta) &then

        find estabelec 
            where estabelec.cod-estabel = c-estabelec no-lock no-error.
        if  avail estabelec then
            run cdp/cd9970.p (input rowid(estabelec),
                              output i-empresa).
    &endif

    find first empresa
         where empresa.ep-codigo = i-empresa no-lock no-error.
    
    
    

    userCodeBlock:
    DO ON ERROR UNDO, LEAVE userCodeBlock
       ON STOP  UNDO, LEAVE userCodeBlock
       ON QUIT  UNDO, LEAVE userCodeBlock:

        FIND FIRST ttManualRequisition NO-LOCK NO-ERROR.
        
        IF  ttManualRequisition.dt-trans > TODAY THEN DO:
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1788, INPUT "").
        END.
    
        FIND FIRST item NO-LOCK
             WHERE item.it-codigo = ttManualRequisition.it-codigo NO-ERROR.
        IF  NOT AVAIL item THEN DO:
            {utp/ut-table.i mgind item 1} /* 1 - Busca label da tabela */
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2, INPUT TRIM(RETURN-VALUE)). 
        END.
        ELSE DO:     
            IF  item.cod-obsoleto = 4 THEN DO:
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1885, INPUT ""). 
            END.
    
            IF  item.it-codigo = "" OR item.tipo-contr = 4 THEN DO:
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1886, INPUT ""). 
            END.
        END.
    
        IF  ttManualRequisition.nr-ord-produ <> 0
        AND AVAIL param-global      
        AND (   param-global.modulo-cp  
             OR param-global.modulo-mi) THEN DO:
    
            IF  NOT AVAIL ord-prod
            OR  (AVAIL ord-prod AND ord-prod.nr-ord-produ <> ttManualRequisition.nr-ord-produ) THEN
                FIND FIRST ord-prod NO-LOCK
                    WHERE ord-prod.nr-ord-produ = ttManualRequisition.nr-ord-produ NO-ERROR.
    
            IF  AVAIL ord-prod THEN DO:
    
                IF  ord-prod.rep-prod > 1 
                AND ord-prod.rep-prod < 4 THEN DO:
    
                    IF  ttManualRequisition.op-codigo <> 0  
                    OR  ttManualRequisition.cod-roteiro  <> "" THEN DO:
    
                        FIND FIRST oper-ord NO-LOCK
                            WHERE oper-ord.nr-ord-produ = ttManualRequisition.nr-ord-produ
                              AND oper-ord.it-codigo   = ttManualRequisition.item-pai 
                              AND oper-ord.op-codigo   = ttManualRequisition.op-codigo 
                              AND oper-ord.cod-roteiro     = ttManualRequisition.cod-roteiro NO-ERROR.
                        IF  NOT AVAIL oper-ord THEN DO:
                            /* Inicio -- Projeto Internacional */
                            DEFINE VARIABLE c-lbl-liter-oper-roteiro-inv AS CHARACTER NO-UNDO.
                            {utp/ut-liter.i "Opera»’o/Roteiro_Invÿlido_para_Item-Pai." *}
                            ASSIGN c-lbl-liter-oper-roteiro-inv = TRIM(RETURN-VALUE).
                            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 17006, INPUT c-lbl-liter-oper-roteiro-inv).     
                        end.
                        else 
                            assign i-seq = oper-ord.sequencia.
                    end.
                end.
                else assign i-seq = 0.
    
                &if defined (bf_mnt_calib) &then
            
                    find first ord-manut no-lock 
                         where ord-manut.nr-ord-produ = ord-prod.nr-ord-produ no-error.
                    if  avail param-global
                    &if defined (bf_mnt_ems205) &then
                    and param-global.log-modul-calib 
                    &else
                    and substr(param-global.char-2,100,1) = "2"
                    &endif
                    and avail ord-manut
                    &IF DEFINED (bf_mnt_ems208) &THEN
                    AND ord-manut.tp-manut = 3
                    &else
                    AND ord-manut.dec-1 = 3
                    &endif
                    and ord-manut.estado = 1 then do:
                        /* Inicio -- Projeto Internacional */
                        DEFINE VARIABLE c-lbl-liter-ordem-de-produ AS CHARACTER NO-UNDO.
                        {utp/ut-liter.i "Ordem_de_Produ»’o" *}
                        ASSIGN c-lbl-liter-ordem-de-produ = TRIM(RETURN-VALUE).
                        /* Modulo de calibracao implantado */
                        RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 28075, INPUT c-lbl-liter-ordem-de-produ).
                    end.
    
                &endif
                
                if  ord-prod.estado = 8  then do:
                    RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 26830, INPUT "").
                end.
    
                if  ord-prod.estado = 7 then do:
    
                    find first ord-manut no-lock
                         where ord-manut.nr-ord-produ = ord-prod.nr-ord-produ no-error.
                    if  not avail ord-manut then do:
                        RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 26831, INPUT "").
                    end.
                end.
                    
                if  avail item
                and item.it-codigo = ord-prod.it-codigo 
                and ord-prod.tipo <> 5 
                and ord-prod.tipo <> 9 then do:
                    RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2008, INPUT "").
                end.
    
                find first reservas no-lock
                    where reservas.nr-ord-produ = ord-prod.nr-ord-produ 
                    and   reservas.it-codigo    = ttManualRequisition.it-codigo no-error.
                if  avail reservas then do:
                    if  avail item
                    and item.tipo-requis = 2 then do:
                        RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 5675, INPUT "").
                    end.
                end.
    
                if  (ord-prod.rep-prod > 1 and ord-prod.rep-prod < 4) 
                or  avail reservas then
                    run validateOrdProd. 
        
                &if defined (bf_man_linha_estab) &then
                
                find first lin-prod no-lock
                     where lin-prod.cod-estabel = ord-prod.cod-estabel
                     and   lin-prod.nr-linha    = ord-prod.nr-linha no-error.
    
                &else
                
                find first lin-prod no-lock
                     where lin-prod.nr-linha = ord-prod.nr-linha no-error.
    
                &endif
                
                if  ttManualRequisition.tog-atualiza then do:
    
                    find first reservas no-lock
                         where reservas.nr-ord-produ = ord-prod.nr-ord-produ
                         and   reservas.item-pai     = ttManualRequisition.item-pai
                         and   reservas.cod-roteiro  = ttManualRequisition.cod-roteiro
                         and   reservas.op-codigo    = ttManualRequisition.op-codigo
                         and   reservas.it-codigo    = ttManualRequisition.it-codigo no-error.
                    if  avail reservas then do:
    
                        find first aloca-reserva no-lock
                             where aloca-reserva.nr-ord-produ = ord-prod.nr-ord-produ 
                             and   aloca-reserva.it-codigo    = ttManualRequisition.it-codigo 
                             and   aloca-reserva.cod-estabel  = ttManualRequisition.cod-estabel 
                             and   aloca-reserva.cod-depos    = ttManualRequisition.cod-depos   
                             and   aloca-reserva.item-pai     = ttManualRequisition.item-pai
                             and   aloca-reserva.cod-roteiro  = ttManualRequisition.cod-roteiro
                             and   aloca-reserva.op-codigo    = ttManualRequisition.op-codigo
                             and   aloca-reserva.cod-localiz  = ttManualRequisition.cod-localiz 
                             and   aloca-reserva.lote-serie   = ttManualRequisition.lote no-error.
                        if  avail aloca-reserva
                        and ttManualRequisition.quantidade > aloca-reserva.quant-aloc then do:
                            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1893, INPUT string(ttManualRequisition.quantidade) + '~~~~' + string(aloca-reserva.quant-aloc)).
                        end.
                    end.
                end.
            end.
            else do:
                /* Ordem de Producao nao encontrada */
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1879, INPUT "").
            end.
        end.

        assign ct-conta = ttManualRequisition.ct-codigo
               sc-conta = ttManualRequisition.sc-codigo.
            
        {cdp/cd9970.i ttManualRequisition.cod-estabel}
        
        if not valid-handle (h_api_cta) then 
            run prgint/utb/utb743za.py persistent set h_api_cta.
			
        run pi_busca_dados_cta_ctbl in h_api_cta (input        i-empresa,          /* EMPRESA EMS2 */
                                                  input        "",                 /* PLANO DE CONTAS */
                                                  input-output ct-conta,           /* CONTA */
                                                  input        today,              /* DATA TRANSACAO */
                                                  output       v_des_cta_ctbl,     /* DESCRICAO CONTA */
                                                  output       v_num_tip_cta_ctbl, /* TIPO DA CONTA */
                                                  output       v_num_sit_cta_ctbl, /* SITUA°€O DA CONTA */
                                                  output       v_ind_finalid_cta,  /* FINALIDADES DA CONTA */
                                                  output table tt_log_erro).       /* ERROS */
        
        IF VALID-HANDLE(h_api_cta) THEN DO:
            delete procedure h_api_cta.
            assign h_api_cta = ?.
        END.
        
        if not valid-handle (h_api_ccust) then 
            run prgint/utb/utb742za.py persistent set h_api_ccust.       
          
        FIND FIRST tt_log_erro no-error.
        IF AVAIL tt_log_erro THEN DO:
            FOR EACH tt_log_erro:
              RUN createRowErrors IN THIS-PROCEDURE(INPUT 2, INPUT tt_log_erro.ttv_num_cod_erro, INPUT tt_log_erro.ttv_des_msg_erro).
            END.  
        END.
        ELSE DO:
            run pi_verifica_utilizacao_ccusto in h_api_ccust (input i-empresa,                          /* EMPRESA EMS 2 */
                                                              input ttManualRequisition.cod-estabel,    /* ESTABELECIMENTO EMS2 */
                                                              input "",                                 /* PLANO CONTAS */
                                                              input ct-conta,                           /* CONTA */
                                                              input  today,                             /* DT TRANSACAO */
                                                              output l-utiliza-ccusto,                  /* UTILIZA CCUSTO ? */
                                                              output table tt_log_erro).                /* ERROS */
        END.
        
        IF l-utiliza-ccusto then do:
            run pi_busca_dados_ccusto in h_api_ccust (input  i-empresa,          /* EMPRESA EMS2 */
                                                      input  "",                 /* CODIGO DO PLANO CCUSTO */
                                                      input  sc-conta,           /* CCUSTO */
                                                      input  today,              /* DATA DE TRANSACAO */
                                                      output v_des_ccusto,       /* DESCRICAO DO CCUSTO */
                                                      output table tt_log_erro). /* ERROS */

            FIND FIRST tt_log_erro no-error.
            IF AVAIL tt_log_erro THEN DO:
                FOR EACH tt_log_erro:
                  RUN createRowErrors IN THIS-PROCEDURE(INPUT 2, INPUT tt_log_erro.ttv_num_cod_erro, INPUT tt_log_erro.ttv_des_msg_erro).
                END.				 
            END.   
        END.
        
        IF VALID-HANDLE(h_api_ccust) THEN DO:
            delete procedure h_api_ccust.
            assign h_api_ccust = ?.
        END.
        
          
        assign ttManualRequisition.ct-codigo = ct-conta
               ttManualRequisition.sc-codigo = sc-conta.
                 
        if  l-unidade-negocio 
        and ttManualRequisition.cod-unid-negoc <> "" then do:
    
            if  not can-find (first unid-negoc where unid-negoc.cod-unid-negoc = ttManualRequisition.cod-unid-negoc) then do:
                /* Inicio -- Projeto Internacional */
                {utp/ut-table.i mgind unid-negoc 1} /* 1 - Busca label da tabela */
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2, INPUT TRIM(RETURN-VALUE)).
            end.
        end.
    
        find first estabelec no-lock
             where estabelec.cod-estabel = ttManualRequisition.cod-estabel no-error.
        if  not avail estabelec then do:
            /* Inicio -- Projeto Internacional */
            {utp/ut-table.i mgadm estabelec 1} /* 1 - Busca label da tabela */
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2, INPUT TRIM(RETURN-VALUE)).
        end.
        find first deposito no-lock 
             where deposito.cod-depos = ttManualRequisition.cod-depos no-error.
        if  avail deposito then do:
 
            if  avail item 
            and avail estabelec then
                for first item-uni-estab fields (contr-qualid)
                    where item-uni-estab.it-codigo   = item.it-codigo
                    and   item-uni-estab.cod-estabel = estabelec.cod-estabel no-lock. end.
    
            if  deposito.ind-dep-cq  
            and (avail item-uni-estab and item-uni-estab.contr-qualid) then do:
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1887, INPUT "").
            end.
    
            if  deposito.ind-dep-rej 
            and (avail item-uni-estab and item-uni-estab.contr-qualid) then do:
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1888, INPUT "").
            end.
        end.
        else do:
            /* Inicio -- Projeto Internacional */
            {utp/ut-table.i mgind deposito 1} /* 1 - Busca label da tabela */
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2, INPUT TRIM(RETURN-VALUE)).
        end.
        if  avail item
        and item.tipo-con-est > 1 and ttManualRequisition.lote = "" then do:
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2158, INPUT "").
        end.
    
        if  avail item
        and (item.tipo-con-est = 3 or item.tipo-con-est = 4) then do:
    
            find first b-saldo no-lock
                 where b-saldo.lote      = ttManualRequisition.lote 
                 and   b-saldo.cod-refer = ttManualRequisition.cod-refer
                 and   b-saldo.it-codigo = item.it-codigo no-error.
            if  not avail b-saldo then do:
    
                if  ttManualRequisition.dt-vali-lote = ? then do:
                    RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2205, INPUT "").
                end.
    
                if item.tipo-con-est = 4 then do:
    
                    find first referencia no-lock
                         where referencia.cod-refer = ttManualRequisition.cod-refer no-error.
                    if  not avail referencia then do:
                        /* Inicio -- Projeto Internacional */
                        {utp/ut-table.i mgind referencia 1} /* 1 - Busca label da tabela */
                        RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2, INPUT TRIM(RETURN-VALUE)).
                    end.
                end.
            end.
        end.
        find tab-unidade 
            where tab-unidade.un = ttManualRequisition.un no-lock no-error.
        if  avail tab-unidade then do:
    
            if  avail item
            and ttManualRequisition.un <> item.un then do:
                RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1571, INPUT "").
            end.
        end.
        else do:
            /* Inicio -- Projeto Internacional */
            {utp/ut-table.i mgind tab-unidade 1} /* 1 - Busca label da tabela */
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 2, INPUT TRIM(RETURN-VALUE)).
        end.
    
        if  ttManualRequisition.quantidade <= 0 then do:
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1368, INPUT "").
        end.
        if  avail item
        and not item.fraciona 
        and ttManualRequisition.quantidade <> integer(ttManualRequisition.quantidade) then do:
            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1892, INPUT "").
        end.
     
        /* Valida»’o de Saldo-Estoq/Quantidade  ce0205.i2*/
        run validateInventoryBalance.
    END.

    RUN haveRowErrors IN THIS-PROCEDURE(OUTPUT l-erro).

    IF l-erro THEN
        return "NOK":U.  

    return "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateOrdProd DBOFunction 
PROCEDURE validateOrdProd :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    userCodeBlock:
    DO ON ERROR UNDO, LEAVE userCodeBlock
       ON STOP  UNDO, LEAVE userCodeBlock
       ON QUIT  UNDO, LEAVE userCodeBlock:
        IF  ttManualRequisition.tog-atualiza THEN DO:
    
            FIND FIRST ord-manut NO-LOCK
                 WHERE ord-manut.nr-ord-produ = ord-prod.nr-ord-produ NO-ERROR.
    
            IF (ttManualRequisition.cod-roteiro <> "" OR ttManualRequisition.op-codigo <> 0) 
            AND NOT AVAIL ord-manut 
            AND ord-prod.origem <> "MV":U THEN DO: 
    
                IF  ttManualRequisition.cod-roteiro <> "" THEN 
                    FIND FIRST oper-ord NO-LOCK
                         WHERE oper-ord.nr-ord-produ = ord-prod.nr-ord-produ 
                         AND   oper-ord.it-codigo    = ttManualRequisition.item-pai 
                         AND   oper-ord.op-codigo    = ttManualRequisition.op-codigo 
                         AND   oper-ord.cod-roteiro  = ttManualRequisition.cod-roteiro NO-ERROR.
                ELSE 
                    FIND FIRST oper-ord NO-LOCK
                         WHERE oper-ord.nr-ord-produ = ord-prod.nr-ord-produ 
                         AND   oper-ord.it-codigo    = ttManualRequisition.item-pai 
                         AND   oper-ord.op-codigo    = ttManualRequisition.op-codigo NO-ERROR.
    
                IF  NOT AVAIL oper-ord THEN DO:
                    RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1220, INPUT "").
                END.
                ELSE IF ord-prod.rep-prod > 1 AND ord-prod.rep-prod < 4 THEN
                    ASSIGN i-seq = oper-ord.sequencia.
            END.
        END.
    END.

    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE createRecord DBOFunction 
PROCEDURE createRecordCE0205 :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input param p-cod-unid-negoc like tt-matriz.cod-unid-neg no-undo.
    def input param p-perc-rateio    like tt-matriz.perc-rateio  no-undo.
    
    def buffer b-movto     for movto-mat.
    
    userCodeBlock:
    DO ON ERROR UNDO, LEAVE userCodeBlock
       ON STOP  UNDO, LEAVE userCodeBlock
       ON QUIT  UNDO, LEAVE userCodeBlock:
    
        create tt-movto.
        assign tt-movto.cod-versao-integracao  = 1
               tt-movto.cod-estabel            = ttManualRequisition.cod-estabel
               tt-movto.nro-docto              = ttManualRequisition.nro-docto
               tt-movto.serie-docto            = ttManualRequisition.serie-docto
               tt-movto.dt-trans               = ttManualRequisition.dt-trans
               tt-movto.it-codigo              = ttManualRequisition.it-codigo
               tt-movto.cod-depos              = ttManualRequisition.cod-depos
               tt-movto.cod-refer              = ttManualRequisition.cod-refer
               tt-movto.cod-localiz            = ttManualRequisition.cod-localiz
               tt-movto.lote                   = ttManualRequisition.lote
               tt-movto.dt-vali-lote           = ttManualRequisition.dt-vali-lote
               tt-movto.ct-codigo              = ttManualRequisition.ct-codigo
               tt-movto.sc-codigo              = ttManualRequisition.sc-codigo
               tt-movto.quantidade             = ttManualRequisition.quantidade
               tt-movto.un                     = ttManualRequisition.un
               tt-movto.num-sequen             = it-requisicao.sequencia
               tt-movto.sequen-nf              = it-requisicao.sequencia
               tt-movto.cod-prog-orig          = "atReqPOUI":U
               tt-movto.tipo-trans             = 2
               tt-movto.esp-docto              = 28 /*requisicao*/
               tt-movto.usuario                = c-seg-usuario
               tt-movto.nr-ord-produ           = ttManualRequisition.nr-ord-produ
               tt-movto.num-ord-inv            = ttManualRequisition.num-ord-inv
               tt-movto.op-seq                 = i-seq
               tt-movto.descricao-db           = ttManualRequisition.descricao-db.
        
        if  p-perc-rateio > 0 then
            assign tt-movto.quantidade = tt-movto.quantidade * p-perc-rateio / 100.
        
        if  l-unidade-negocio then
            assign tt-movto.cod-unid-negoc = p-cod-unid-negoc.
    
        if  avail ord-prod then do:
        
            assign tt-movto.ct-codigo = ord-prod.ct-codigo
                   tt-movto.sc-codigo = ord-prod.sc-codigo.
            
            if  avail param-global and param-global.modulo-cs then do:
    
                find last b-movto use-index num-seq 
                    where b-movto.nr-ord-produ = ord-prod.nr-ord-produ no-lock no-error.
                if  avail b-movto then
                    assign tt-movto.num-sequen = b-movto.num-sequen + 1.
                else
                    assign tt-movto.num-sequen = 1.
            end.
        end.
        else do:
            assign tt-movto.ct-codigo = ttManualRequisition.ct-codigo
                   tt-movto.sc-codigo = ttManualRequisition.sc-codigo.
        end.
    
        empty temp-table tt-erro.
        empty temp-table tt-erro-aux.
        
        /* efetua as baixas das reservas ce0205.i*/
        find first tt-movto no-error.
        if  not avail ord-manut 
        or  (avail ord-manut and ord-manut.estado < 7) then 
            run updateReservation (INPUT ttManualRequisition.nr-ord-produ).
        
        assign de-difere-val-quantidade = de-difere-val-quantidade - (de-val-quantidade * (p-perc-rateio / 100)).
    END.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE updateReservation DBOFunction 
PROCEDURE updateReservation :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/   
    def input param p-nr-ord-produ like ord-prod.nr-ord-produ no-undo.
    
    DEF VAR h-cpapi013 AS HANDLE NO-UNDO.
    
    def buffer b-ordem     for ord-prod.
    def buffer b-ord-manut for ord-prod.
    
    IF NOT AVAIL param-global THEN 
        FIND FIRST param-global NO-LOCK NO-ERROR.
        
    IF NOT AVAIL ord-prod THEN 
        FIND FIRST ord-prod NO-LOCK WHERE ord-prod.nr-ord-produ = p-nr-ord-produ NO-ERROR.

    userCodeBlock:
    DO ON ERROR UNDO, LEAVE userCodeBlock
       ON STOP  UNDO, LEAVE userCodeBlock
       ON QUIT  UNDO, LEAVE userCodeBlock:
       
        if  avail ord-prod and param-global.modulo-cp then do:
    
            &if defined (bf_man_linha_estab) &then
            
            find lin-prod 
                 where lin-prod.cod-estabel = ord-prod.cod-estabel
                   and lin-prod.nr-linha    = ord-prod.nr-linha no-lock no-error.
    
            &else
            
            find lin-prod 
                where lin-prod.nr-linha = ord-prod.nr-linha no-lock no-error.
    
            &endif
            
            if  ttManualRequisition.tog-atualiza then do:

                if  avail item then
                    find first reservas 
                        where reservas.nr-ord-produ = ord-prod.nr-ord-produ 
                          and (   reservas.item-pai = ttManualRequisition.item-pai
                              or  ttManualRequisition.item-pai = "")
                          and reservas.it-codigo    = item.it-codigo exclusive-lock no-error.
    
                if  avail reservas then do:
               
                    if  tt-movto.esp-docto = 28 then do:
               
                        assign reservas.quant-atend  = reservas.quant-atend + tt-movto.quantidade
                               reservas.quant-requis = reservas.quant-requis + tt-movto.quantidade.
               
                        if  reservas.quant-atend > reservas.quant-orig then do:
                            RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1898, INPUT "").
                            assign reservas.quant-atend = reservas.quant-orig.
                        end.
                    end.
           
                    find first aloca-reserva no-lock
                         where aloca-reserva.nr-ord-produ = ord-prod.nr-ord-produ 
                         and   aloca-reserva.item-pai     = ttManualRequisition.item-pai
                         and   aloca-reserva.cod-roteiro  = ttManualRequisition.cod-roteiro
                         and   aloca-reserva.op-codigo    = ttManualRequisition.op-codigo
                         and   aloca-reserva.it-codigo    = tt-movto.it-codigo
                         and   aloca-reserva.cod-estabel  = tt-movto.cod-estabel
                         and   aloca-reserva.cod-depos    = tt-movto.cod-depos
                         and   aloca-reserva.cod-localiz  = tt-movto.cod-localiz
                         and   aloca-reserva.lote-serie   = tt-movto.lote no-error.
                    if  avail  aloca-reserva then do:

                        if  tt-movto.esp-docto = 28 then do:
                        
                            if  not valid-handle (h-cpapi013) then    
                            run cpp/cpapi013.p persistent set h-cpapi013 (input        table tt-alocacao,
                                                                          input        table tt-deposito,
                                                                          input-output table tt-erro-inv,
                                                                          input        yes).
    
                            if  tt-movto.quantidade > aloca-reserva.quant-aloc then
                                run pi-elimina-aloca-manual in h-cpapi013 (input rowid(aloca-reserva)).
                            else  
                                run pi-mod-aloca-manual in h-cpapi013 (input rowid(aloca-reserva),
                                                                       input (aloca-reserva.quant-aloc - tt-movto.quantidade)).
                                                                                                               
                            RUN pi-finalizar in h-cpapi013.
                        end.
                    end.
                    release reservas.
                end.
               
                if  avail lin-prod and lin-prod.sum-requis = 1 then do:
                    RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1900, INPUT "").
                    /* Linha de processo, reserva atendida somente no reporte */
                end.
            end.
    
            find b-ordem 
                where b-ordem.nr-ord-produ = ord-prod.nr-ord-produ exclusive-lock no-error.
            if  avail b-ordem and b-ordem.estado <> 6  then do:
    
                assign b-ordem.estado = 5.
                release b-ordem.
            end.
            
            find b-ord-manut 
                where b-ord-manut.nr-ord-produ = ord-prod.nr-ord-produ exclusive-lock no-error.
            if  avail b-ord-manut and b-ord-manut.estado <> 6  then do:
    
               assign b-ord-manut.estado = 5.
               release b-ord-manut.
            end.
        end.
    END.

    return "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateInventoryBalance DBOFunction 
PROCEDURE validateInventoryBalance :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def var de-saldo-calc            as decimal                      no-undo.

    userCodeBlock:
    DO ON ERROR UNDO, LEAVE userCodeBlock
       ON STOP  UNDO, LEAVE userCodeBlock
       ON QUIT  UNDO, LEAVE userCodeBlock:
        if  avail aloca-reserva then 
            assign de-saldo-calc = aloca-reserva.quant-aloc.
        else 
            assign de-saldo-calc = 0.
    
        find saldo-estoq use-index estabel-dep 
            where saldo-estoq.cod-estabel = ttManualRequisition.cod-estabel          
            and   saldo-estoq.cod-depos   = ttManualRequisition.cod-depos   
            and   saldo-estoq.cod-localiz = ttManualRequisition.cod-localiz
            and   saldo-estoq.lote        = ttManualRequisition.lote        
            and   saldo-estoq.cod-refer   = ttManualRequisition.cod-refer   
            and   saldo-estoq.it-codigo   = ttManualRequisition.it-codigo no-lock no-error. 
        if  not available saldo-estoq then do:
    
            if  avail item
            and item.tipo-con-est = 2 then do:
        
                find first b-saldo use-index lote 
                     where b-saldo.lote      = ttManualRequisition.lote
                     and   b-saldo.it-codigo = item.it-codigo
                     and   ((b-saldo.qtidade-atu + de-saldo-calc        -
                             b-saldo.qt-alocada  - b-saldo.qt-aloc-prod - 
                             b-saldo.qt-aloc-ped = 1)   or
                            (b-saldo.qtidade-atu + de-saldo-calc        - 
                             b-saldo.qt-alocada  - b-saldo.qt-aloc-prod - 
                             b-saldo.qt-aloc-ped = -1)) no-lock no-error.
                if  avail b-saldo then do:
    
                    if  (b-saldo.qtidade-atu  + de-saldo-calc - 
                         b-saldo.qt-alocada   - b-saldo.qt-aloc-prod - 
                         b-saldo.qt-aloc-ped) = 1 then do:
                         RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 1894, INPUT "").
                    end.
                    else do:
                        RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 15372, INPUT item.un).
                    end.
                end.
            end.
        end.
        else do:
            if  ttManualRequisition.quantidade > 
               (saldo-estoq.qtidade-atu  + de-saldo-calc            - 
                saldo-estoq.qt-alocada   - saldo-estoq.qt-aloc-prod - 
                saldo-estoq.qt-aloc-ped ) then do:
    
                if  avail item
                and item.tipo-con-est = 2 
                and (saldo-estoq.qtidade-atu + de-saldo-calc - 
                     saldo-estoq.qt-alocada  - saldo-estoq.qt-aloc-prod - 
                     saldo-estoq.qt-aloc-ped) < 0 then do:
                     RUN createRowErrors IN THIS-PROCEDURE(INPUT 1, INPUT 15372, INPUT item.un).
                end.
            end.
        end.
    END.

    return "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME