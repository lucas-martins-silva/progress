&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram  
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice idx_exec
  Parameters:  
               recebe valor do campo id-exec
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pid-exec LIKE dta-agente-exec.id-exec NO-UNDO.

    FIND FIRST bfdta-agente-exec WHERE 
        bfdta-agente-exec.id-exec = pid-exec NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfdta-agente-exec THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfdta-agente-exec)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/

    IF pType = "UPDATE" THEN DO:
        ASSIGN RowObject.cod-usuario = c-seg-usuario
               RowObject.dt-alter-ts = NOW.

        FOR FIRST dta-agente-exec 
            WHERE dta-agente-exec.id-exec = RowObject.id-exec
            NO-LOCK:

            IF NOT AVAILABLE dta-agente-exec THEN DO:
                {utp/ut-table.i emsfnd dta-agente-exec 1}
                {method/svc/errors/inserr.i
                            &ErrorNumber="56"
                            &ErrorType="EMS"
                            &ErrorParameters= RETURN-VALUE
                            &ErrorSubType = "ERROR"}    
            END.
            ELSE DO:
                
                IF dta-agente-exec.cod-agente <> RowObject.cod-agente THEN DO:
                    {utp/ut-liter.i C¢digo_do_Agente}
                    {method/svc/errors/inserr.i
                                &ErrorNumber="6057"
                                &ErrorType="EMS"
                                &ErrorParameters= RETURN-VALUE
                                &ErrorSubType = "ERROR"}    
                END.
                IF dta-agente-exec.id-exec <> RowObject.id-exec THEN DO:
                    {utp/ut-liter.i ID_da_Execuá∆o}
                    {method/svc/errors/inserr.i
                                &ErrorNumber="6057"
                                &ErrorType="EMS"
                                &ErrorParameters= RETURN-VALUE
                                &ErrorSubType = "ERROR"}    
                END.
                IF dta-agente-exec.cod-instancia <> RowObject.cod-instancia THEN DO:
                    {utp/ut-liter.i C¢digo_da_InstÉncia}
                    {method/svc/errors/inserr.i
                                &ErrorNumber="6057"
                                &ErrorType="EMS"
                                &ErrorParameters= RETURN-VALUE
                                &ErrorSubType = "ERROR"}    
                END.
            END.
        END.
    END.
    ELSE IF pType = "CREATE" THEN DO:

        ASSIGN RowObject.cod-usuario = c-seg-usuario
               RowObject.dt-criacao-ts = NOW
               RowObject.dt-alter-ts = NOW.
               RowObject.id-exec = NEXT-VALUE(seq-dta-agente-exec).
    END.

    DEFINE VARIABLE hApiAgents AS HANDLE NO-UNDO.
    RUN dta/services/apiAgents.p PERSISTENT SET hApiAgents.
    RUN pi-get-factory-agents IN hApiAgents (OUTPUT TABLE  ttAgents).
    DELETE PROCEDURE hApiAgents.

    IF NOT CAN-FIND(FIRST ttAgents
                    WHERE ttAgents.cod-agente = RowObject.cod-agente) THEN DO:

        {utp/ut-table.i emsfnd dta-agente 1}
        {method/svc/errors/inserr.i
                    &ErrorNumber="56"
                    &ErrorType="EMS"
                    &ErrorParameters= RETURN-VALUE
                    &ErrorSubType = "ERROR"}    
    END.   

    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

