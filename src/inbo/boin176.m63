PROCEDURE getFormatoCCusto :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEF OUTPUT PARAM p-format-ccusto AS CHAR NO-UNDO.

    if  not valid-handle(h_api_ccusto) then
        run prgint/utb/utb742za.py persistent set h_api_ccusto.

    EMPTY TEMP-TABLE tt_log_erro.

    ASSIGN v_cod_formato = ''.

    if  valid-handle(h_api_ccusto) then
        run pi_retorna_formato_ccusto in h_api_ccusto (input  i-empresa,          /* EMPRESA EMS2 */
                                                       input  "",                 /* PLANO CONTAS */
                                                       input  docum-est.dt-trans, /* DATA DE TRANSACAO */ 
                                                       output v_cod_formato,      /* FORMATO CONTA */
                                                       output table tt_log_erro). /* ERROS */

    ASSIGN p-format-ccusto = v_cod_formato.

    delete object h_api_ccusto no-error.

    RETURN "ok".

END PROCEDURE.




