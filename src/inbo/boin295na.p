&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE OpenQueryMain DBOProgram 
PROCEDURE OpenQueryMain :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH {&TableName} 
        WHERE {&TableName}.cod-emitente = i-cod-emitente NO-LOCK INDEXED-REPOSITION.
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE OpenQueryofEmitente DBOProgram 
PROCEDURE OpenQueryofEmitente :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH {&TableName} 
        WHERE {&TableName}.num-pedido >= i-num-pedido-ini
          and {&TableName}.num-pedido <= i-num-pedido-fim
          and {&TableName}.cod-emitente = i-cod-emitente NO-LOCK INDEXED-REPOSITION.
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE SetConstraintofEmitente DBOProgram 
PROCEDURE SetConstraintofEmitente :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER p-num-pedido-ini  AS INT NO-UNDO.
    DEFINE INPUT PARAMETER p-num-pedido-fim  AS INT NO-UNDO.
    DEFINE INPUT PARAMETER p-cod-emitente    AS INT NO-UNDO.

    ASSIGN i-num-pedido-ini = p-num-pedido-ini
           i-num-pedido-fim = p-num-pedido-fim
           i-cod-emitente   = p-cod-emitente.

    RETURN "OK":U.   
END PROCEDURE.

