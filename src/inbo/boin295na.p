&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getDescEmitente DBOProgram 
PROCEDURE getDescEmitente :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
   define input  parameter pcod-emit  like emitente.cod-emitente no-undo.
   define output parameter desc-emit  like emitente.nome-abrev       no-undo.
   
   find emitente where emitente.cod-emitente = pcod-emit no-lock no-error.
   if avail emitente then
      assign desc-emit = emitente.nome-abrev.
   else
      assign desc-emit = "".
      
   return desc-emit.
END PROCEDURE.

