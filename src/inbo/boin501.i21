/********************************************************************************
**
** Geraá∆o de VIS«O MANUFATURA
** {1} C¢digo da vis∆o
** {2} Descriá∆o da vis∆o
** {3} M¢dulo Principal da vis∆o
** {4} N£mero de dimens‰es
** {5} Programa externo 
**
********************************************************************************/
assign c-label = {ininc/i01in501.i 04 {1}}.

&if "{&FNC_MULTI_IDIOMA}" = "Yes" &then
   RUN utp/ut-liter.p (trim(c-label), "*", "").
   assign c-label = return-value.
&endif

find visao-man where
     visao-man.cod-visao  = c-label EXCLUSIVE-LOCK no-error.

if valid-handle (h-handle) then
   run pi-acompanhar  in h-handle (input c-label).

if not available visao-man then do:

   {utp/ut-liter.i {2} * R}
   assign c-liter = return-value.

   create visao-man.
   assign visao-man.cod-visao       = c-label
          visao-man.num-visao       = {1}
          visao-man.des-visao       = c-liter
          visao-man.num-dim         = {4}
          visao-man.cod-modul-dtsul = {3}
          visao-man.log-reg-dtsul   = yes
          visao-man.nom-prog-ext    = {5}.
end.
