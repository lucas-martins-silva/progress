
ASSIGN cFields = "FIELDS(num-id-operacao gm-codigo it-codigo cod-roteiro op-codigo data-inicio data-termino)".

IF {3} = 0 THEN //Operacao
    ASSIGN  cCondicao = "For each operacao " + cFields + " no-lock "
                        + " where operacao.it-codigo    = " + '"' + STRING({1}) + '"'
                        + "   and operacao.cod-roteiro  = " + '"' + STRING({2}) + '"'
                        + "   and operacao.data-inicio <= " + '"' + STRING(TODAY) + '"'
                        + "   and operacao.data-termino > " + '"' + STRING(TODAY) + '"'.
ELSE
    ASSIGN  cCondicao = "For each operacao " + cFields + " no-lock "
                        + " where operacao.it-codigo    = " + '"' + STRING({1}) + '"'
                        + "   and operacao.cod-roteiro  = " + '"' + STRING({2}) + '"'
                        + "   and operacao.op-codigo    = " + '"' + STRING({3}) + '"'
                        + "   and operacao.data-inicio <= " + '"' + STRING(TODAY) + '"'
                        + "   and operacao.data-termino > " + '"' + STRING(TODAY) + '"'.

IF VALID-HANDLE(hQuery)
THEN DO:
    DELETE OBJECT hQuery.
END.

CREATE QUERY hQuery. 
hQuery:SET-BUFFERS(BUFFER operacao:HANDLE).
hQuery:QUERY-PREPARE(STRING(cCondicao)).
hQuery:QUERY-OPEN.
hQuery:GET-FIRST.

DO WHILE NOT hQuery:QUERY-OFF-END:
    if  p-log-main
    and operacao.gm-codigo = ctrab.gm-codigo then do:
        create tt-oper-ctrab.
        assign tt-oper-ctrab.seq          = i-seq
               tt-oper-ctrab.gm-altern    = ""
               tt-oper-ctrab.rw-operacao  = rowid(operacao)
               tt-oper-ctrab.rw-op-altern = ?
               tt-oper-ctrab.val-efic     = 1
               i-seq                      = i-seq + 1.
    end.          
    if  operacao.gm-codigo = ctrab.gm-codigo then
        hQuery:GET-NEXT.
  
    /*** Procura opera‡äes alternativas ***/
    if  p-log-altern then do:
        blk-altern:
    
        for each op-altern where
                 op-altern.num-id-operacao = operacao.num-id-operacao and
                 op-altern.gm-codigo       = ctrab.gm-codigo no-lock:
            create tt-oper-ctrab.
            assign tt-oper-ctrab.seq          = i-seq
                   tt-oper-ctrab.gm-altern    = operacao.gm-codigo
                   tt-oper-ctrab.rw-operacao  = rowid(operacao)
                   tt-oper-ctrab.rw-op-altern = rowid(op-altern)
                   tt-oper-ctrab.val-efic     = 1
                   i-seq                      = i-seq + 1.
            leave blk-altern.
        end.
        
        /*** Cria‡Æo de opera‡Æo alternativa via grupo m quina alternativo ***/
        if  not can-find (first tt-oper-ctrab) then do:
            find first grup-maq-altern where
                       grup-maq-altern.gm-altern = ctrab.gm-codigo and  
                       grup-maq-altern.gm-codigo = operacao.gm-codigo no-lock no-error.
                      
            if  available grup-maq-altern then do:           
                create tt-oper-ctrab.
                assign tt-oper-ctrab.seq          = i-seq
                       tt-oper-ctrab.gm-altern    = operacao.gm-codigo
                       tt-oper-ctrab.rw-operacao  = rowid(operacao)
                       tt-oper-ctrab.rw-op-altern = ?
                       tt-oper-ctrab.val-efic     = grup-maq-altern.val-perc-eficiencia / 100
                       i-seq                      = i-seq + 1.
            end.
        end.
    end.    
    hQuery:GET-NEXT.
END.

IF VALID-HANDLE(hQuery)
THEN DO:
    DELETE OBJECT hQuery.
END.

