PROCEDURE encontrarModeloTurno:

    def Input  param p-cod-area  as char format "x(8)"       no-undo.
    def Input  param p-gm-codigo as char format "x(9)"       no-undo.
    def Input  param p-cod-ctrab as char format "x(16)"      no-undo.
    def Input  param p-dat-refer as date format "99/99/9999" no-undo.
    def output param p-cod-turno as char format "x(8)"       no-undo.

    def var dat-inic-valid as date no-undo.
    def var dat-fim-valid  as date no-undo.

    if  p-cod-ctrab <> ? then
        run DeterminarModelTurnoCtrab (input  p-cod-area,
                                       input  p-gm-codigo,
                                       input  p-cod-ctrab,
                                       input  p-dat-refer,
                                       output dat-inic-valid,
                                       output dat-fim-valid,
                                       output p-cod-turno).
                                       
    else 
        if  p-gm-codigo <> ? then
            run DeterminarModelTurnoGrpArea (input p-gm-codigo,
                                             input p-dat-refer,
                                             output dat-inic-valid,
                                             output dat-fim-valid,
                                             output p-cod-turno).
        else                                      
            run DeterminarModelTurnoGrpArea (input p-cod-area,
                                             input p-dat-refer,
                                             output dat-inic-valid,
                                             output dat-fim-valid,
                                             output p-cod-turno).
END PROCEDURE.

PROCEDURE setarInicioTurno:

    def  input param p-cod-turno  as char format "x(8)"       no-undo.
    def  Input param p-dat-refer  as date format "99/99/9999" no-undo.
    def output param p-dat-inicio as date format "99/99/9999" no-undo.
    def output param p-hra-inicio as dec  format ">9.99"      no-undo.
    
    def var i-num-dia as int no-undo.

    find first turno-semana
        where turno-semana.cod-model-turno = p-cod-turno no-lock no-error.
    assign i-num-dia = weekday(p-dat-refer).
    if avail turno-semana then do:
            
            if  turno-semana.hra-inicio[i-num-dia] < turno-semana.hra-fim[i-num-dia] then
                assign p-dat-inicio = p-dat-refer
                       p-hra-inicio = turno-semana.hra-inicio[i-num-dia].
        
            if  turno-semana.hra-inicio[i-num-dia] > turno-semana.hra-fim[i-num-dia] then
                assign p-dat-inicio = p-dat-refer - 1
                       p-hra-inicio = turno-semana.hra-inicio[i-num-dia].
        
            if  turno-semana.hra-inicio[i-num-dia] = turno-semana.hra-fim[i-num-dia] then do:
        
                find last turno-semana
                    where turno-semana.cod-model-turno = p-cod-turno no-lock no-error.
                if avail turno-semana then do:
                        assign i-num-dia = if  i-num-dia = 1 
                                           then 7 
                                           else i-num-dia - 1.
                        
                        if  turno-semana.hra-inicio[i-num-dia] > turno-semana.hra-fim[i-num-dia] then
                            assign p-dat-inicio = p-dat-refer
                                   p-hra-inicio = turno-semana.hra-fim[i-num-dia].
                        else
                            assign p-dat-inicio = p-dat-refer
                                   p-hra-inicio = 0.
                end.
            end.
    end.
END PROCEDURE.

/*** Nesta estrutura o sistema nÆo considera os reportes que sÆo realizados antes 
     do primeiro turno da data de inicio e apos do £ltimo turno da data final ***/
/*** Caso exista a necessidade dever  ser alterada a SetarFimTurno para 
     posicionar a data final no inicio do seguinte turno. Para isto ser  necess rio
     cuidar com os dias que nÆo possuem turno para retornar 24 horas  ***/     

PROCEDURE setarFimTurno:

    def  input param p-cod-turno  as char format "x(8)"       no-undo.
    def  Input param p-dat-refer  as date format "99/99/9999" no-undo.
    def output param p-dat-fim    as date format "99/99/9999" no-undo.
    def output param p-hra-fim    as dec  format ">9.99"      no-undo.
    
    def var i-num-dia as int no-undo.
    def buffer b-turno-semana for turno-semana.
    
    find first b-turno-semana
         where b-turno-semana.cod-model-turno = p-cod-turno no-lock no-error.

    find last turno-semana
        where turno-semana.cod-model-turno = p-cod-turno no-lock no-error.
    
    if avail turno-semana then do:
        
            assign i-num-dia = weekday(p-dat-refer).
            
            if  b-turno-semana.hra-inicio[i-num-dia] < turno-semana.hra-fim[i-num-dia] then
                assign p-dat-fim = p-dat-refer
                       p-hra-fim = turno-semana.hra-fim[i-num-dia].
            else if  b-turno-semana.hra-inicio[i-num-dia] > turno-semana.hra-fim[i-num-dia] then
                    assign p-hra-fim = turno-semana.hra-fim[i-num-dia]
                           p-dat-fim = p-dat-refer + 
                                       if (turno-semana.num-turno = 1) then 0
                                                                       else 1.
                 else if   b-turno-semana.hra-inicio[i-num-dia] = turno-semana.hra-fim[i-num-dia] and
                           b-turno-semana.hra-inicio[i-num-dia] > 0 then do:
                         
                          assign i-num-dia = if  i-num-dia = 7
                                             then 1
                                             else i-num-dia + 1.
                          
                          if b-turno-semana.hra-inicio[i-num-dia] > b-turno-semana.hra-fim[i-num-dia]  then 
                              assign p-dat-fim = p-dat-refer
                                     p-hra-fim = b-turno-semana.hra-inicio[i-num-dia].
                                     
                          else
                              assign p-dat-fim = p-dat-refer + 1
                                     p-hra-fim = turno-semana.hra-fim[i-num-dia].
                                     
                      end.
                      else
                          assign p-dat-fim = p-dat-refer
                                 p-hra-fim = b-turno-semana.hra-inicio[i-num-dia].

    end.

END PROCEDURE.

PROCEDURE inicializarIntervaloTurno:

    def Input  param p-cod-area        as char format "x(8)"       no-undo.
    def Input  param p-gm-codigo       as char format "x(9)"       no-undo.
    def Input  param p-cod-ctrab       as char format "x(16)"      no-undo.
    def input  param p-dat-inicio      as date format "99/99/9999" no-undo.
    def input  param p-dat-termino     as date format "99/99/9999" no-undo.
    def output param p-dat-inic-turno  as date format "99/99/9999" no-undo.
    def output param p-segs-inic-turno as int  format ">9.99"      no-undo.
    def output param p-dat-fim-turno   as date format "99/99/9999" no-undo.
    def output param p-segs-fim-turno  as int  format ">9.99"      no-undo.

    def var p-cod-turno      as char no-undo.
    def var p-hra-inic-turno as dec no-undo.
    def var p-hra-fim-turno  as dec no-undo.
    
    run encontrarModeloTurno (input p-cod-area,
                              input p-gm-codigo,
                              input p-cod-ctrab,
                              input p-dat-inicio,
                              output p-cod-turno).

    run setarInicioTurno (input p-cod-turno,
                          input p-dat-inicio,
                          output p-dat-inic-turno,
                          output p-hra-inic-turno).
    assign p-segs-inic-turno = p-hra-inic-turno * 3600.
    
    run setarFimTurno (input p-cod-turno,
                       input p-dat-termino,
                       output p-dat-fim-turno,
                       output p-hra-fim-turno).
    assign p-segs-fim-turno = p-hra-fim-turno * 3600.
    
END PROCEDURE.

/* Fim do Programa */
