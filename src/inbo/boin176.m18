PROCEDURE calculateVariationValue :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:  Determina varia»’o de valor, retorna:
           *de-valor-max-perc - valor maxima permitida para recebimento, aplicando
                                o percentual definido no item-mat-estab/item-mat.
           *de-valor-max-lim  - valor maxima permitida para recebimento, aplicando
                                o limite definido no item-mat-estab/item-mat.
           *de-max-perc-vl    - percentual maximo para variacao definido no item-mat-
                                estab/item-mat.      
           *de-max-lim-vl     - limite maximo para variacao definido no item-mat-
                                estab/item-mat.  
------------------------------------------------------------------------------*/

    def input  param de-valor-orig     as decimal no-undo.
    def output param de-valor-max-perc as decimal no-undo.
    def output param de-valor-max-lim  as decimal no-undo.
    def output param de-max-perc-vl    as decimal no-undo.
    def output param de-max-lim-vl     as decimal no-undo.
    

    def var de-max-perc-qt             as decimal no-undo.
    def var de-max-lim-qt              as decimal no-undo.
                 

    run getValuesItemMatEstab ( output de-max-perc-vl,
                                output de-max-lim-vl,
                                output de-max-perc-qt,
                                output de-max-lim-qt ).                  
    

    if  param-re.aceita-var then
        assign de-valor-max-perc = round(de-valor-orig + 
                                   (de-valor-orig * de-max-perc-vl / 100), 2)
               de-valor-max-lim  = round(de-valor-orig + de-max-lim-vl,2).
    else
        assign de-valor-max-perc = round(de-valor-orig, 2)
               de-valor-max-lim  = round(de-valor-orig, 2).

    return "OK":U.

END PROCEDURE.




