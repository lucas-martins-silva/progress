PROCEDURE validateTransferencia :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def buffer bf-estabelec for estabelec.    

    /****************
    MULLER - ESTA VALIDACAO IRA SER ALTERADA. A PARTIR DA 2.06B O ESTABELECIMENTO DE ORIGEM = EMITENTE PARA AS TRANSFERENCIAS
    **************/
    if  RowObject.estab-de-or = RowObject.cod-estabel then do:
        {method/svc/errors/inserr.i
                            &ErrorNumber="15371"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U}
    end.                                

    /** Emitente Origem x Estabelecimento Origem **/
    if not can-find (first bf-estabelec 
                     where bf-estabelec.cod-estabel  = RowObject.estab-de-or 
                       and bf-estabelec.cod-emitente = RowObject.cod-emitente) then do:
         {method/svc/errors/inserr.i
                            &ErrorNumber="33717"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U}
    end.
    else
        /** Emitente Destino x Estabelecimento Destino **/
        for first bf-estabelec fields (cod-emitente)
            where bf-estabelec.cod-estabel = RowObject.cod-estabel no-lock:
            for first saldo-terc fields (emite-comp)
                        where saldo-terc.serie-docto   = RowObject.serie-docto 
                          and saldo-terc.nro-docto     = RowObject.nro-docto
                          and saldo-terc.cod-emitente  = RowObject.cod-emitente 
                          and saldo-terc.cod-estabel   = RowObject.estab-de-or
                          and saldo-terc.tipo-sal-terc = 3 NO-LOCK:
                if saldo-terc.emite-comp <> bf-estabelec.cod-emitente then do:
                    {utp/ut-liter.i destino *}              
                    {method/svc/errors/inserr.i
                                    &ErrorNumber="34320"
                                    &ErrorType="EMS":U
                                    &ErrorSubType="ERROR":U
                                    &ErrorParameters="return-value + '~~~~' + RowObject.cod-estabel +
                                                     '~~~~~' + string(saldo-terc.emite-comp)"}
                end.
            end.
        end.
     
    if  not can-find(bf-estabelec where bf-estabelec.cod-estabel = RowObject.estab-de-or) then do:    
        /* Inicio -- Projeto Internacional */
        DEFINE VARIABLE c-lbl-liter-estabelecimento-de-origem AS CHARACTER NO-UNDO.
        {utp/ut-liter.i "Estabelecimento_de_Origem" *}
        ASSIGN c-lbl-liter-estabelecimento-de-origem = TRIM(RETURN-VALUE).
        {method/svc/errors/inserr.i
                            &ErrorNumber="47"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U
                            &ErrorParameters="c-lbl-liter-estabelecimento-de-origem"}
    end.

    for first saldo-terc
        fields ( )
         where saldo-terc.serie-docto   = RowObject.serie-docto
           and saldo-terc.nro-docto     = RowObject.nro-docto
           and saldo-terc.cod-emitente  = RowObject.cod-emitente
           and saldo-terc.nat-operacao <> RowObject.nat-operacao
           and saldo-terc.cod-estabel   = RowObject.estab-de-or
           and saldo-terc.quantidade    > 0 
           and saldo-terc.tipo-sal-terc = 3 NO-LOCK.
    end.

    if  not avail saldo-terc then do:
        {method/svc/errors/inserr.i
                            &ErrorNumber="5128"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U}
    end.

    /*** Corre‡Æo FO 888.358 (Liziane) ****/
    IF  cType = "CREATE":U AND NOT l-mult-natur-receb THEN DO: /* l-mult-natur-receb -> Var def em cd9701.i */
        assign l-varias-oper      = no                         /* NÆo usa m£ltiplas naturezas no recebimento */
               c-nat-operacao-aux = "":U.
        for each saldo-terc  
            fields (nat-operacao) 
             where saldo-terc.serie-docto   = RowObject.serie-docto
               and saldo-terc.nro-docto     = RowObject.nro-docto
               and saldo-terc.cod-emitente  = RowObject.cod-emitente
               and saldo-terc.nat-operacao <> RowObject.nat-operacao
               and saldo-terc.cod-estabel   = RowObject.estab-de-or
               and saldo-terc.quantidade    > 0 
               and saldo-terc.tipo-sal-terc = 3 no-lock:
        
            if  c-nat-operacao-aux <> "":U then
            if  saldo-terc.nat-operacao <> c-nat-operacao-aux then do:
                assign l-varias-oper = yes.
                leave.
            end.
        
            assign c-nat-operacao-aux = saldo-terc.nat-operacao.
        end.
        if  l-varias-oper then do:
            for first saldo-terc  
                fields (log-1) 
                 where saldo-terc.serie-docto   = RowObject.serie-docto
                   and saldo-terc.nro-docto     = RowObject.nro-docto
                   and saldo-terc.cod-emitente  = RowObject.cod-emitente
                   and saldo-terc.nat-operacao <> RowObject.nat-operacao
                   and saldo-terc.cod-estabel   = RowObject.estab-de-or
                   and saldo-terc.quantidade    > 0 
                   and saldo-terc.tipo-sal-terc = 3 
                   and saldo-terc.nat-operacao  = c-nat-oper-comp no-lock .
            end.
            if  not avail saldo-terc then do:
                {method/svc/errors/inserr.i &ErrorNumber="5128"
                                            &ErrorType="EMS"
                                            &ErrorSubType="ERROR" }
            end.
        
        end.
    end.
    /***/

    RETURN "OK":U.

END PROCEDURE.




