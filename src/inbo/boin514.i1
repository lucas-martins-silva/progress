/********************************************************************************
** Procedure : ValidarElimina‡ÆoCtrabFerram
**  Objetivo  : Validar relacionamentos da tabela ctrab-ferram
**  Parƒmetros: Buffer ctrab-ferram
*********************************************************************************/
PROCEDURE ValidarElimina‡ÆoCtrabFerram:

    define parameter buffer b-ctrab-ferram for ctrab-ferram.
    
    def var c-tabela as char no-undo.
    
    find first split-operac
         where split-operac.cod-ctrab     = b-ctrab-ferram.cod-ctrab
           and split-operac.cod-ferr-prod = b-ctrab-ferram.cod-ferr-prod
         no-lock no-error.
    if avail split-operac then do:
       {utp/ut-table.i mgind ctrab-ferram 01}
       assign c-tabela = return-value.
       {utp/ut-table.i movind split-operac 01}
       run utp/ut-msgs.p (input 'show',
                          input 8699,
                          input c-tabela + "~~" + return-value).
       return "NOK":U.
    end.
    
    return "OK":U.
END PROCEDURE.
