/**********************************************************************************************
* Temp-tables utilizadas na boin01101.p e mla0170rp.p                                         *
*                                                                                             *
* situacao: 'Mantido', 'Novo', 'Substitu¡do', 'Eliminado', 'Origem', 'Transferido', 'Erro'    * 
* id-sit  :     1    ,    2  ,       3      ,       4    ,     5   ,       6,         7       * 
* r-rowid : rowid do registro alterado,exclu¡do ou inserido.                                  * 
***********************************************************************************************/ 
DEFINE TEMP-TABLE tt-mla-layout-usuar-doc-origem NO-UNDO LIKE mla-layout-usuar-doc
    FIELD situacao AS CHAR FORMAT "x(20)"
    FIELD id-sit   AS INT
    FIELD r-rowid  AS ROWID
    FIELD erros    AS CHAR FORMAT "x(2000)"
    INDEX codigo   cod-usuar
                   idi-interfac 
                   situacao.
                   
DEFINE TEMP-TABLE tt-mla-layout-usuar-doc-dest NO-UNDO LIKE tt-mla-layout-usuar-doc-origem.

DEFINE BUFFER bftt-mla-layout-usuar-doc-origem FOR tt-mla-layout-usuar-doc-origem.
DEFINE BUFFER bftt-mla-layout-usuar-doc-dest FOR tt-mla-layout-usuar-doc-dest.
