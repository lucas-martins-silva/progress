&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE setaTipoServico DBOProgram 
PROCEDURE setaTipoServico :
    
    DEFINE BUFFER itemDocEstREINF FOR item-doc-est.

    DEFINE INPUT PARAM p-serie-docto  LIKE item-doc-est.serie-docto  NO-UNDO.
    DEFINE INPUT PARAM p-nro-docto    LIKE item-doc-est.nro-docto    NO-UNDO.
    DEFINE INPUT PARAM p-cod-emitente LIKE item-doc-est.cod-emitente NO-UNDO.
    DEFINE INPUT PARAM p-nat-operacao LIKE item-doc-est.nat-operacao NO-UNDO.
    DEFINE INPUT PARAM p-sequencia    LIKE item-doc-est.sequencia    NO-UNDO.
    DEFINE INPUT PARAM c-serv-inss    AS   CHAR                      NO-UNDO.

    FOR FIRST itemDocEstREINF EXCLUSIVE-LOCK
        WHERE itemDocEstREINF.serie-docto  = p-serie-docto  
          AND itemDocEstREINF.nro-docto    = p-nro-docto    
          AND itemDocEstREINF.cod-emitente = p-cod-emitente 
          AND itemDocEstREINF.nat-operacao = p-nat-operacao 
          AND itemDocEstREINF.sequencia    = p-sequencia:

        ASSIGN OVERLAY(itemDocEstREINF.char-2,941,3) = c-serv-inss.

    END.

RETURN "OK":U.

END PROCEDURE.
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME  

