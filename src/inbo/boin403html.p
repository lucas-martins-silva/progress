PROCEDURE afterCopyBuffer2TT:
    /*------------------------------------------------------------------------------
      Purpose:     afterCopyBuffer2TT
      Parameters:  <none>
      Notes:       Adiciona quantidade disponivel
                   temp-table RowObjectExtra
    ------------------------------------------------------------------------------*/
    CREATE RowObjectExtra.
    ASSIGN RowObjectExtra.r-Rowid = ROWID({&TableName}).

    ASSIGN RowObjectExtra.qt-disponivel = {&TableName}.qtidade-atu  -
                                          {&TableName}.qt-alocada   -
                                          {&TableName}.qt-aloc-prod -
                                          {&TableName}.qt-aloc-ped.                                             

    RETURN "OK":U.
END PROCEDURE.


