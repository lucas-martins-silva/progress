/*******************************************************************************************************
**
** PROCEDURE: atualizaLiberacaoCtrabs
** OBJETIVO:  Libera‡Æo de reporte de opera‡Æo para para splits dos Centros de Trabalhos
** PARAMETROS: entrada rSplit = Rowid da split-operac.
**
*******************************************************************************************************/
PROCEDURE atualizaLiberacaoCtrabs:
     
define input parameter rSplit as rowid no-undo.

define buffer bSplit1 for split-operac.
define buffer bSplit2 for split-operac.

/** Busca o Split corrente reportado **/
for first bSplit1 
    where rowid(bSplit1) = rSplit no-lock:
    /** Busca todos os splits dos centros de trabalhos **/
    for each  bSplit2
        where bSplit2.nr-ord-produ     = bSplit1.nr-ord-produ
        and   bSplit2.num-operac-sfc   = bSplit1.num-operac-sfc  
        and   bSplit2.num-split-operac > bSplit1.num-split-operac 
        and   bSplit2.log-1 exclusive-lock:
        /** Atualiza‡Æo das quantidades **/
        assign bSplit2.qtd-operac-refgda = bSplit1.qtd-operac-refgda
               bSplit2.qtd-operac-aprov  = bSplit1.qtd-operac-aprov 
               bSplit2.qtd-operac-retrab = bSplit1.qtd-operac-retrab
               bSplit2.qtd-operac-reptda = bSplit1.qtd-operac-reptda
               bSplit2.val-perc-avanco   = bSplit1.val-perc-avanco.
    end.

end.

END PROCEDURE.
