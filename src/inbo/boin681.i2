/*--------------------------------------------------------------------------
    File       : BOIN681.P
    Autor      : Cristina - log9646
    Utilizado  : wcc0392.p ( Consulta Variacao Preco )
                 wcc0393.w ( Relatorio Evolucao Preco)
  ----------------------------------------------------------------------- */

    /* cotacao da moeda */
    assign  c-data = string(year(controle-preco.data-cotacao),"9999") + 
                     string(month(controle-preco.data-cotacao),"99").
   
    /* cotacao do respectivo dia */
    assign i-dia  = day(controle-preco.data-cotacao). 
    
    if piTipoPreco  = 1 then
       assign de-preco = controle-preco.preco-unit-vista.
    else if piTipoPreco  = 2 then do: 
       assign de-preco = controle-preco.preco-unit-prazo.
    end.   
    
    if  valid-handle(h-boad098na) then do:
        run openQueryStatic in h-boad098na(input "Main":U) .
        RUN GotoKey in h-boad098na(input controle-preco.cod-emitente).
        if return-value = "OK" then do:
           RUN GetCharField in h-boad098na(input  "nome-emit", 
                                           output c-nome-emit).
        end.
    end.     
    
    RUN Converte_cotacao_moeda (input  pdeMoeda1,        
                                input  de-preco,
                                input  c-data,
                                input  i-dia,
                                output de-cotacao-moeda1, 
                                output de-preco-conv1).   
                               
    RUN Converte_cotacao_moeda (input  pdeMoeda1,
                                input  de-preco,
                                input  c-data,
                                input  i-dia,
                                output de-cotacao-moeda2,  
                                output de-preco-conv2).
                               
    assign e-preco-moeda-1      = if   c-type = "consulta" 
                                           then de-preco-conv1
                                           else de-preco
           e-preco-moeda-2      = de-preco-conv1 
           e-preco-moeda-3      = de-preco-conv2 
           e-perc-ant-1         = ((de-preco / de-preco-ant) - 1) * 100
           e-perc-ant-2         = ((de-preco-conv1 / de-preco-ant1) - 1) * 100   
           e-perc-ant-3         = ((de-preco-conv2 / de-preco-ant2) - 1) * 100
           e-perc-acum-1        = ((de-preco / de-preco-acum) - 1) * 100
           e-perc-acum-2        = ((de-preco-conv1 / de-preco-acum1) - 1) * 100
           e-perc-acum-3        = ((de-preco-conv2 / de-preco-acum2) - 1) * 100.         

    create tt-precos.
    assign tt-precos.cod-estabel         = controle-preco.cod-estabel
           tt-precos.it-codigo           = controle-preco.it-codigo 
           tt-precos.cod-emitente        = controle-preco.cod-emitente
           tt-precos.data-cotacao        = controle-preco.data-cotacao
           tt-precos.inicio-calculo      = da-inicio-calculo
           tt-precos.cod-cond-pag        = controle-preco.cod-cond-pag
           tt-precos.valor-taxa          = controle-preco.valor-taxa
           tt-precos.preco-unit-vista    = controle-preco.preco-unit-vista
           tt-precos.preco-unit-prazo    = controle-preco.preco-unit-prazo
           tt-precos.preco-moeda[1]      = if e-preco-moeda-1 <> ? then e-preco-moeda-1 else 0
           tt-precos.preco-moeda[2]      = if e-preco-moeda-2 <> ? then e-preco-moeda-2 else 0 
           tt-precos.preco-moeda[3]      = if e-preco-moeda-3 <> ? then e-preco-moeda-3 else 0 
           tt-precos.perc-ant[1]         = if e-perc-ant-1 <> ? then e-perc-ant-1 else 0
           tt-precos.perc-ant[2]         = if e-perc-ant-2 <> ? then e-perc-ant-2 else 0   
           tt-precos.perc-ant[3]         = if e-perc-ant-3 <> ? then e-perc-ant-3 else 0
           tt-precos.perc-acum[1]        = if e-perc-acum-1 <> ? then e-perc-acum-1 else 0
           tt-precos.perc-acum[2]        = if e-perc-acum-2 <> ? then e-perc-acum-2 else 0
           tt-precos.perc-acum[3]        = if e-perc-acum-3 <> ? then e-perc-acum-3 else 0
           tt-precos.aliquota-ipi        = controle-preco.aliquota-ipi
           tt-precos.nome-emit           = c-nome-emit
           tt-precos.manual-autom        = (if (controle-preco.numero-ordem = 0) 
                                            then "Manual"
                                            else "Autom tico"). 

         if c-type = "consulta" then do:
            {inbo/boin681epc.i string(rowid(controle-preco))}
         end.                                            
 
    assign da-data-ant    = controle-preco.data-cotacao
           de-preco-ant   = de-preco
           de-preco-ant1  = de-preco-conv1
           de-preco-ant2  = de-preco-conv2.

/***  fim  ***/  
