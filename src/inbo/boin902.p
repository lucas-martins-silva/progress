&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram  
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice idx_agente_instancia_param
  Parameters:  
               recebe valor do campo cod-instancia
               recebe valor do campo cod-param
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-instancia LIKE dta-agente-instancia-param.cod-instancia NO-UNDO.
    DEFINE INPUT PARAMETER pcod-param LIKE dta-agente-instancia-param.cod-param NO-UNDO.

    FIND FIRST bfdta-agente-instancia-param WHERE 
        bfdta-agente-instancia-param.cod-instancia = pcod-instancia AND 
        bfdta-agente-instancia-param.cod-param = pcod-param NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfdta-agente-instancia-param THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfdta-agente-instancia-param)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.

    DEFINE VARIABLE c-erro AS CHARACTER NO-UNDO.

    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/

    FIND FIRST dta-agente-instancia
        WHERE dta-agente-instancia.cod-instancia = RowObject.cod-instancia NO-LOCK NO-ERROR.

    IF NOT AVAIL dta-agente-instancia THEN DO:
        {utp/ut-liter.i Agente}
        
        {method/svc/errors/inserr.i
                    &ErrorNumber="2"
                    &ErrorType="EMS"
                    &ErrorParameters=RETURN-VALUE
                    &ErrorSubType = "ERROR"}
    END.

    IF AVAIL dta-agente-instancia AND (dta-agente-instancia.cod-agente = "MCS_INTEGRIDADE_CUSTOS") THEN DO:
        IF RowObject.cod-param = "cod-estabel" AND RowObject.des-valor = "" THEN DO:
            
            {utp/ut-liter.i Estabelecimento *}
            
            {method/svc/errors/inserr.i
                        &ErrorNumber="164"
                        &ErrorType="EMS"
                        &ErrorParameters=RETURN-VALUE
                        &ErrorSubType = "ERROR"}    
        END.    
        ELSE IF RowObject.cod-param = "cod-usuar" AND RowObject.des-valor = "" THEN DO:
            
            {utp/ut-liter.i Usu†rio *}
            
            {method/svc/errors/inserr.i
                        &ErrorNumber="164"
                        &ErrorType="EMS"
                        &ErrorParameters=RETURN-VALUE
                        &ErrorSubType = "ERROR"}    
        END.    
    END.
        
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

