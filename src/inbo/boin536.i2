/*******************************************************************************************************
**
** PROCEDURE: LiberarReporte
** OBJETIVO:  Libera‡Æo de reporte de opera‡Æo para efetuar movimenta‡Æo
** PARAMETROS: buffer rep-oper-ctrab
**
*******************************************************************************************************/
{cdp/cdcfgman.i}
/* Alterado FO 1293768 */ 
DEFINE BUFFER bf-oper FOR oper-ord.
PROCEDURE LiberarReporte:

    define parameter buffer b-rep-oper-ctrab for rep-oper-ctrab.
    
    def var v-log-finaliz-op as logical no-undo.
    def var rw-oper-ord      as rowid   no-undo.
    def var l-rep-qtd-zero   as log     no-undo.
    def var de-tempo-zero    as dec     no-undo.

    def buffer b-oper-ord for oper-ord.
    define buffer b2-rep-oper-ctrab for rep-oper-ctrab.
    
    find first param-sfc no-lock no-error.
    &if defined(bf_man_207a) &then
        ASSIGN l-rep-qtd-zero       = param-sfc.log-report-quant-zero.
    &else
        ASSIGN l-rep-qtd-zero       = if substring(param-sfc.char-1,31,1) = "S":U then yes else no.
    &endif

    find split-operac exclusive-lock where
        split-operac.nr-ord-produ     = b-rep-oper-ctrab.nr-ord-produ   and 
        split-operac.num-operac-sfc   = b-rep-oper-ctrab.num-operac-sfc and
        split-operac.num-split-operac = b-rep-oper-ctrab.num-split-operac no-error.

    assign split-operac.qtd-operac-refgda  = split-operac.qtd-operac-refgda + b-rep-oper-ctrab.qtd-operac-refgda
           split-operac.qtd-operac-aprov   = split-operac.qtd-operac-aprov  + b-rep-oper-ctrab.qtd-operac-aprov
           split-operac.qtd-operac-retrab  = split-operac.qtd-operac-retrab + b-rep-oper-ctrab.qtd-operac-retrab
           split-operac.qtd-operac-reptda  = split-operac.qtd-operac-aprov  + split-operac.qtd-operac-refgda.

    if split-operac.qtd-previs-operac > 0 then 
        assign split-operac.val-perc-avanco = (split-operac.qtd-operac-aprov / split-operac.qtd-previs-operac) * 100.
    else    
        assign split-operac.val-perc-avanco  =  100.   
   
    /*Mois‚s Pereira - 30/04/2008 **********************************************
      Ajuste de percentual de avan‡o para reporte com quantidade zero
      Esta informa‡Æo ser  utilizada no processo de aloca‡Æo de atividades
      sempre realizando aloca‡Æo restante baseado neste percentual de avan‡o
    ****************************************************************************/
    if split-operac.val-perc-avanco < 100 and l-rep-qtd-zero = yes then do:
       assign de-tempo-zero = 0.
       blk-rep:
       for each b2-rep-oper-ctrab no-lock use-index operacao
          where b2-rep-oper-ctrab.nr-ord-produ      = b-rep-oper-ctrab.nr-ord-produ
            and b2-rep-oper-ctrab.num-operac-sfc    = b-rep-oper-ctrab.num-operac-sfc
            and b2-rep-oper-ctrab.num-split-operac  = b-rep-oper-ctrab.num-split-operac 
            break by b2-rep-oper-ctrab.val-refer-inic-rep: 
            
            if b2-rep-oper-ctrab.qtd-operac-reptda = 0 then
               assign de-tempo-zero = de-tempo-zero + b2-rep-oper-ctrab.qtd-tempo-reporte.
            else
               assign de-tempo-zero = 0.
       end.

       if de-tempo-zero <> 0 and
          split-operac.qtd-operac-reptda > 0 and
          split-operac.tempo-pad-operac > 0 then
          assign split-operac.val-perc-avanco = min(  (split-operac.qtd-operac-aprov + 1) / split-operac.qtd-previs-operac * 100 - 0.01,
                                                      ((split-operac.qtd-operac-aprov) / split-operac.qtd-previs-operac * 100) 
                                                                                    +
                                                      (de-tempo-zero / (split-operac.tempo-pad-operac / 3600) * 100) /*Avan‡o em Tempo*/).
    end.

    find oper-ord exclusive-lock where
         oper-ord.nr-ord-produ = b-rep-oper-ctrab.nr-ord-produ and
         oper-ord.num-operac-sfc = b-rep-oper-ctrab.num-operac-sfc.

    find ord-prod no-lock 
         where ord-prod.nr-ord-produ = oper-ord.nr-ord-produ no-error.   
    assign oper-ord.qtd-aprov-sfc    =  oper-ord.qtd-aprov-sfc  + b-rep-oper-ctrab.qtd-operac-aprov
           oper-ord.qtd-refgda-sfc   =  oper-ord.qtd-refgda-sfc + b-rep-oper-ctrab.qtd-operac-refgda
           oper-ord.qtd-retrab-sfc   =  oper-ord.qtd-retrab-sfc + b-rep-oper-ctrab.qtd-operac-retrab
           oper-ord.qtd-reptda-sfc   =  oper-ord.qtd-refgda-sfc + oper-ord.qtd-aprov-sfc
           oper-ord.qt-produzida     =  oper-ord.qtd-reptda-sfc / oper-ord.qtd-previs-operac * ord-prod.qt-ordem
           oper-ord.qt-refugada      =  oper-ord.qtd-refgda-sfc / oper-ord.qtd-previs-operac * ord-prod.qt-ordem
           oper-ord.estado           = 2.

    if oper-ord.qtd-previs-operac > 0 and
       oper-ord.qtd-reptda-sfc    > 0 then       
        assign oper-ord.val-perc-avanco = 100 * oper-ord.qtd-aprov-sfc / oper-ord.qtd-previs-operac.

    /*** Movimenta‡äes da ordem caso opera‡Æo seja œltima opera‡Æo da rede-pert ***/
    if oper-ord.log-operac-final then do:

        /*** Atualiza‡Æo de quantidade reportada - 
             Verificar ordem com multiplas opera‡äes finais (Itatiaia) ***/
        find op-sfc exclusive-lock where
             op-sfc.nr-ord-produ = oper-ord.nr-ord-produ no-error.

        assign op-sfc.qtd-reptda-sfc   = oper-ord.qtd-reptda-sfc / oper-ord.qtd-previs-operac * ord-prod.qt-ordem
               op-sfc.qtd-aprov-sfc    = oper-ord.qtd-aprov-sfc  / oper-ord.qtd-previs-operac * ord-prod.qt-ordem
               op-sfc.qtd-retrab-sfc   = oper-ord.qtd-retrab-sfc / oper-ord.qtd-previs-operac * ord-prod.qt-ordem
               op-sfc.qtd-refgda-sfc   = oper-ord.qtd-refgda-sfc / oper-ord.qtd-previs-operac * ord-prod.qt-ordem.
    end. 

    /*** Atualiza datas de termino do split da opera‡Æo reportado ***/ 
    if  split-operac.dat-fim-operac = ? or 
        split-operac.dat-fim-operac < b-rep-oper-ctrab.dat-fim-reporte or 
       (split-operac.dat-fim-operac = b-rep-oper-ctrab.dat-fim-reporte and 
        split-operac.qtd-segs-fim-operac < b-rep-oper-ctrab.qtd-segs-fim-reporte) 
        then  do:
        assign split-operac.dat-fim-operac         = rep-oper-ctrab.dat-fim-reporte 
               split-operac.qtd-segs-fim-operac    = rep-oper-ctrab.qtd-segs-fim-reporte
               split-operac.dat-produt-dispon      = rep-oper-ctrab.dat-fim-reporte 
               split-operac.qtd-segs-produt-dispon = rep-oper-ctrab.qtd-segs-fim-reporte.

         /*** Corre‡Æo de tempo por tempo de cura (pos-processo) ***/
        if  split-operac.tempo-pad-pos-operac > 0 then 
            run pi-corrige-data-tempo (input-output split-operac.dat-produt-dispon, 
                                       input-output split-operac.qtd-segs-produt-dispon, 
                                       Input split-operac.tempo-pad-pos-operac).

    end. 

    /** Atualiza‡Æo dos splits criados para mais Centros de Trabalho (Nansen 887.479) **/
    &IF DEFINED (bf_man_sfc_ref_oper) &THEN
    if split-operac.log-reporta-varios-ctrab then
    &else
    if split-operac.log-1 then
    &endif
        run atualizaLiberacaoCtrabs (input rowid(split-operac)).

    assign rw-oper-ord = rowid(oper-ord).

    /*** Libera‡Æo de opera‡äes sucessoras ***/
    run LiberarSucessoras (buffer oper-ord, 
                           split-operac.dat-produt-dispon,
                           split-operac.qtd-segs-produt-dispon).

    find oper-ord where rowid(oper-ord) = rw-oper-ord no-lock no-error.  

    /*** Finaliza‡Æo autom tica da opera‡Æo ***/
    if oper-ord.val-perc-avanco >= 100 then do:
        find item-man where
             item-man.it-codigo = oper-ord.it-codigo no-lock no-error.

        if not available item-man then do: 
            find first param-sfc no-lock.
            assign v-log-finaliz-op = param-sfc.log-finaliz-op.
        end.
        else  
            assign v-log-finaliz-op = item-man.log-finaliz-op.

        if v-log-finaliz-op then 
            run FecharOperacao (buffer oper-ord).
    end.
    
    /* Alterado FO 1293768 - se nÆo for reporte por ordem, atualiza quantidade das antecessoras */
    /*** Atualiza quantidades de antecessoras para exporta‡Æo no APS ***/
    /************************************************************************
    Comentado por Mois‚s Pereira - Projeto 130 Automacao
    Estava gerando a seguinte situa‡Æo:
    Ordem 1 - Reporte por Ordem
    Operacao Reportada
    10       50
    20       50
    Estorno a opera‡Æo 50 pe‡as da op 20 ele seta a qt reportada da op 10 = 0 tamb‚m, 
    por‚m o reporte da opera‡Æo 10 ainda esta dispon¡vel para reporte e por esta quantidade
    estar igual a 0 ele nÆo permite estorna-la mais.*/
    IF ord-prod.rep-prod <> 1 or oper-ord.log-operac-final OR (ord-prod.rep-prod = 1 AND param-sfc.log-consid-rede-pert) THEN
        run AtualizarEstadoAntecessoras (buffer oper-ord). 
    /*************************************************************************/    

    IF oper-ord.log-operac-final = YES THEN DO:
        FOR EACH bf-oper 
            WHERE bf-oper.nr-ord-produ = oper-ord.nr-ord-produ EXCLUSIVE-LOCK:
            IF bf-oper.qt-produzida = 0 THEN
                ASSIGN bf-oper.qt-produzida = oper-ord.qt-produzida.
        END.                                                       
    END. 

    /*Refugo por opera‡Æo - Atualiza‡Æo da Quantidade Produzida e Refugada na Ord-prod*/
    IF oper-ord.log-operac-final = NO AND b-rep-oper-ctrab.qtd-operac-refgda > 0 THEN DO:
    find ord-prod exclusive-lock 
      where ord-prod.nr-ord-produ = oper-ord.nr-ord-produ no-error.   
    assign ord-prod.qt-produzida = ord-prod.qt-produzida + (b-rep-oper-ctrab.qtd-operac-refgda / oper-ord.qtd-previs-operac * ord-prod.qt-ordem)
           ord-prod.qt-refugada  = ord-prod.qt-refugada  + (b-rep-oper-ctrab.qtd-operac-refgda / oper-ord.qtd-previs-operac * ord-prod.qt-ordem).
    END.


    release op-sfc.
    release bf-oper.
    release split-operac.

END PROCEDURE.

/*******************************************************************************************************
**
** PROCEDURE: LiberarReporteInv
** OBJETIVO:  Fun‡Æo inversa da Libera‡Æo de reporte de opera‡Æo 
**            Para ser utilizada na elimina‡Æo do reporte e no estorno do reporte  
** PARAMETROS: buffer rep-oper-ctrab
**
*******************************************************************************************************/
PROCEDURE LiberarReporteInv:

    define parameter buffer b-rep-oper-ctrab for rep-oper-ctrab.

    define buffer b2-rep-oper-ctrab for rep-oper-ctrab.

    def var v-val-refer-1 like split-operac.qtd-operac-aprov   no-undo.
    def var v-val-refer-2 like split-operac.qtd-operac-aprov   no-undo.
    def var v-tempo-maq   like split-operac.qtd-operac-aprov   no-undo.
    def var v-tempo-mod   like split-operac.qtd-operac-aprov   no-undo.
    def var v-tempo-ext   like split-operac.qtd-operac-aprov   no-undo.
    def var rw-oper-ord   as rowid no-undo.
    
    def var l-rep-qtd-zero   as log     no-undo.
    def var de-tempo-zero    as dec     no-undo.
    
    find first param-sfc no-lock no-error.
    &if defined(bf_man_207a) &then
        ASSIGN l-rep-qtd-zero       = param-sfc.log-report-quant-zero.
    &else
        ASSIGN l-rep-qtd-zero       = if substring(param-sfc.char-1,31,1) = "S":U then yes else no.
    &endif

    find split-operac exclusive-lock
         where split-operac.nr-ord-produ     = b-rep-oper-ctrab.nr-ord-produ
           and split-operac.num-operac-sfc   = b-rep-oper-ctrab.num-operac-sfc
           and split-operac.num-split-operac = b-rep-oper-ctrab.num-split-operac
         no-error.

    assign split-operac.qtd-operac-refgda = split-operac.qtd-operac-refgda - b-rep-oper-ctrab.qtd-operac-refgda
           split-operac.qtd-operac-aprov  = split-operac.qtd-operac-aprov  - b-rep-oper-ctrab.qtd-operac-aprov
           split-operac.qtd-operac-retrab = split-operac.qtd-operac-retrab - b-rep-oper-ctrab.qtd-operac-retrab
           split-operac.qtd-operac-reptda = split-operac.qtd-operac-aprov  + split-operac.qtd-operac-refgda
           split-operac.qtd-operac-reptda = split-operac.qtd-operac-aprov  + split-operac.qtd-operac-refgda
           split-operac.tempo-real-operac = 0
           split-operac.tempo-real-maq    = 0
           split-operac.tempo-real-mod    = 0.
           
    /*Primeiro reporte do split, e nesta situa‡Æo temos que zerar os campos de prepara‡Æo*/
    if not can-find(first b2-rep-oper-ctrab
           where b2-rep-oper-ctrab.nr-ord-produ      = b-rep-oper-ctrab.nr-ord-produ                                    
             and b2-rep-oper-ctrab.num-operac-sfc    = b-rep-oper-ctrab.num-operac-sfc              
             and b2-rep-oper-ctrab.num-split-operac  = b-rep-oper-ctrab.num-split-operac            
             and b2-rep-oper-ctrab.num-seq-rep      <> b-rep-oper-ctrab.num-seq-rep)
                                                     and 
        (split-operac.dat-inic-setup                 = split-operac.dat-fim-setup      and 
         split-operac.qtd-segs-inic-setup            = split-operac.qtd-segs-fim-setup) then do:
        assign split-operac.dat-inic-setup      = ?
               split-operac.dat-fim-setup       = ?
               split-operac.qtd-segs-inic-setup = 0
               split-operac.qtd-segs-fim-setup  = 0
               split-operac.tempo-real-prepar   = 0.
    end.   

    if split-operac.qtd-previs-operac > 0 then 
        assign split-operac.val-perc-avanco = split-operac.qtd-operac-aprov / split-operac.qtd-previs-operac * 100.
    else
        assign split-operac.val-perc-avanco  =  100.

    find oper-ord exclusive-lock where
         oper-ord.nr-ord-produ   = b-rep-oper-ctrab.nr-ord-produ and
         oper-ord.num-operac-sfc = b-rep-oper-ctrab.num-operac-sfc no-error.
    
    find ord-prod no-lock 
         where ord-prod.nr-ord-produ = oper-ord.nr-ord-produ no-error.   
    
    assign oper-ord.qtd-aprov-sfc    =  oper-ord.qtd-aprov-sfc  - b-rep-oper-ctrab.qtd-operac-aprov
           oper-ord.qtd-refgda-sfc   =  oper-ord.qtd-refgda-sfc - b-rep-oper-ctrab.qtd-operac-refgda
           oper-ord.qtd-retrab-sfc   =  oper-ord.qtd-retrab-sfc - b-rep-oper-ctrab.qtd-operac-retrab
           oper-ord.qtd-reptda-sfc   =  oper-ord.qtd-refgda-sfc + oper-ord.qtd-aprov-sfc.

    if oper-ord.qtd-previs-operac > 0 then       
        assign oper-ord.val-perc-avanco  =  100 * oper-ord.qtd-aprov-sfc / oper-ord.qtd-previs-operac.
    else    
        assign oper-ord.val-perc-avanco  =  100.

    assign rw-oper-ord = rowid(oper-ord).
    run BloquearSucessoras(buffer oper-ord). 
    find oper-ord where rowid(oper-ord) = rw-oper-ord no-lock no-error.  

    /*** Movimenta‡äes da ordem caso opera‡Æo seja œltima opera‡Æo da rede-pert ***/
    if oper-ord.log-operac-final then do:

        /*** Atualiza‡Æo de quantidade reportada - 
             Verificar ordem com multiplas opera‡äes finais (Itatiaia) ***/
        find op-sfc exclusive-lock where
             op-sfc.nr-ord-produ = oper-ord.nr-ord-produ no-error.
        if avail op-sfc then     
                assign op-sfc.qtd-reptda-sfc   = oper-ord.qtd-reptda-sfc / oper-ord.qtd-previs-operac * ord-prod.qt-ordem
                       op-sfc.qtd-aprov-sfc    = oper-ord.qtd-aprov-sfc  / oper-ord.qtd-previs-operac * ord-prod.qt-ordem
                       op-sfc.qtd-retrab-sfc   = oper-ord.qtd-retrab-sfc / oper-ord.qtd-previs-operac * ord-prod.qt-ordem
                       op-sfc.qtd-refgda-sfc   = oper-ord.qtd-refgda-sfc / oper-ord.qtd-previs-operac * ord-prod.qt-ordem.
    end. 
        /*Refugo por opera»’o - Atualiza»’o da Quantidade Produzida e Refugada na Ord-prod*/
          IF oper-ord.log-operac-final = NO AND b-rep-oper-ctrab.qtd-operac-refgda > 0 THEN DO:
          find ord-prod exclusive-lock 
            where ord-prod.nr-ord-produ = oper-ord.nr-ord-produ no-error.   
          assign ord-prod.qt-produzida = ord-prod.qt-produzida - (b-rep-oper-ctrab.qtd-operac-refgda / oper-ord.qtd-previs-operac * ord-prod.qt-ordem)
                 ord-prod.qt-refugada  = ord-prod.qt-refugada  - (b-rep-oper-ctrab.qtd-operac-refgda / oper-ord.qtd-previs-operac * ord-prod.qt-ordem).
    END.


    /*** Atualiza‡Æo de datas do split reportado, opera‡Æo reportada e ordem de produ‡Æo ***/
    /*** Se n’o existe nenhum reporte voltar a inicializar as datas de in­cio de opera‡Æo como ? ***/
    find first b2-rep-oper-ctrab  
         where b2-rep-oper-ctrab.nr-ord-produ      = b-rep-oper-ctrab.nr-ord-produ
           and b2-rep-oper-ctrab.num-operac-sfc    = b-rep-oper-ctrab.num-operac-sfc
           and b2-rep-oper-ctrab.num-split-operac  = b-rep-oper-ctrab.num-split-operac
           and b2-rep-oper-ctrab.num-seq-rep  <> b-rep-oper-ctrab.num-seq-rep no-lock no-error.

    if  not available b2-rep-oper-ctrab then
          run AlterarEstadoSplit (buffer split-operac, input 3). /* liberado*/
    else do:
          run AlterarEstadoSplit (buffer split-operac, input 4).  /* iniciado*/

          assign v-val-refer-1 = 9999123100000
                 v-val-refer-2 = 0.
          
          assign de-tempo-zero = 0.
          /*** Atualiza data de in­cio para split reportado ***/
          blk-rep:
          for each b2-rep-oper-ctrab no-lock use-index operacao
             where b2-rep-oper-ctrab.nr-ord-produ      = b-rep-oper-ctrab.nr-ord-produ
               and b2-rep-oper-ctrab.num-operac-sfc    = b-rep-oper-ctrab.num-operac-sfc
               and b2-rep-oper-ctrab.num-split-operac  = b-rep-oper-ctrab.num-split-operac 
               break by b2-rep-oper-ctrab.val-refer-inic-rep:
               
              if b2-rep-oper-ctrab.num-seq-rep = b-rep-oper-ctrab.num-seq-rep then next.
              
              if b2-rep-oper-ctrab.qtd-operac-reptda = 0 then
                 assign de-tempo-zero = de-tempo-zero + b2-rep-oper-ctrab.qtd-tempo-reporte.
              else
                 assign de-tempo-zero = 0.

              /*** Determinar inicio, termino e avaliar tempo mod, mÿquina ***/
              assign v-val-refer-1 = min (v-val-refer-1, b2-rep-oper-ctrab.val-refer-inic-rep)
                     v-val-refer-2 = max (v-val-refer-2, b2-rep-oper-ctrab.val-refer-fim-rep)
                     v-tempo-maq   = v-tempo-maq + b2-rep-oper-ctrab.qtd-tempo-reporte
                     v-tempo-mod   = v-tempo-mod + b2-rep-oper-ctrab.qtd-tempo-mod 
                     v-tempo-ext   = v-tempo-ext + b2-rep-oper-ctrab.qtd-tempo-extra.
          end.

          if de-tempo-zero <> 0 and split-operac.val-perc-avanco < 100 and l-rep-qtd-zero = yes and split-operac.tempo-pad-operac > 0 then
             assign split-operac.val-perc-avanco = min(  (split-operac.qtd-operac-aprov + 1) / split-operac.qtd-previs-operac * 100  - 0.01,
                                                         ((split-operac.qtd-operac-aprov) / split-operac.qtd-previs-operac * 100) 
                                                                                      +
                                                         (de-tempo-zero / (split-operac.tempo-pad-operac / 3600) * 100) /*Avan‡o em Tempo*/).

          find grup-maquina where 
               grup-maquina.gm-codigo = split-operac.gm-codigo no-lock no-error.

          assign split-operac.tempo-real-extra  = v-tempo-ext
                 split-operac.tempo-real-maq    = v-tempo-maq
                 split-operac.tempo-real-mod    = v-tempo-mod
                 split-operac.tempo-real-operac = if grup-maquina.ind-tip-ctrab = 4 then v-tempo-mod
                                                  else v-tempo-maq.
                     if v-val-refer-1 <> 9999123100000 then 
          run pi-converte-valor-data-segs (input v-val-refer-1,
                                              output split-operac.dat-inic-operac ,
                                              output split-operac.qtd-segs-inic-operac).
          else                                               
              assign split-operac.dat-inic-operac      = split-operac.dat-fim-setup
                     split-operac.qtd-segs-inic-operac = split-operac.qtd-segs-fim-setup.
                    
          if v-val-refer-2 <> 0 then 
              run pi-converte-valor-data-segs (input v-val-refer-2,
                                               output split-operac.dat-fim-operac ,
                                               output split-operac.qtd-segs-fim-operac).
          else
              assign split-operac.dat-fim-operac      = ?                                          
                     split-operac.qtd-segs-fim-operac = 0.
          run pi-converte-valor-data-segs (input v-val-refer-1,
                                           output split-operac.dat-inic-operac ,
                                           output split-operac.qtd-segs-inic-operac).

          run pi-converte-valor-data-segs (input v-val-refer-2,
                                           output split-operac.dat-fim-operac ,
                                           output split-operac.qtd-segs-fim-operac).


          /*** Atualiza‡Æo do tempo de disponibilidade do produto ***/
          if  split-operac.tempo-pad-pos-operac > 0 then 
              run pi-corrige-data-tempo (input-output split-operac.dat-produt-dispon, 
                                         input-output split-operac.qtd-segs-produt-dispon, 
                                         Input split-operac.tempo-pad-pos-operac).
          else                                        
              assign split-operac.dat-produt-dispon      = split-operac.dat-fim-operac 
                     split-operac.qtd-segs-produt-dispon = split-operac.qtd-segs-fim-operac.

    end.

    /*** Elimina‡Æo em cascata de dependentes do rep-oper-ctrab ***/
    for each rep-oper-mod where
             rep-oper-mod.nr-ord-produ = b-rep-oper-ctrab.nr-ord-produ and
             rep-oper-mod.num-seq-rep  = b-rep-oper-ctrab.num-seq-rep exclusive-lock:
        delete rep-oper-mod.
    end.
    for each rep-refugo-oper where
             rep-refugo-oper.nr-ord-produ = b-rep-oper-ctrab.nr-ord-produ and
             rep-refugo-oper.num-seq-rep  = b-rep-oper-ctrab.num-seq-rep exclusive-lock:
        delete rep-refugo-oper.
    end.
    for each rep-refugo-mat where
             rep-refugo-mat.nr-ord-produ = b-rep-oper-ctrab.nr-ord-produ and
             rep-refugo-mat.num-seq-rep  = b-rep-oper-ctrab.num-seq-rep exclusive-lock:
        delete rep-refugo-mat.
    end.
    for each rep-ic-oper where
             rep-ic-oper.nr-ord-produ = b-rep-oper-ctrab.nr-ord-produ and
             rep-ic-oper.num-seq-rep  = b-rep-oper-ctrab.num-seq-rep exclusive-lock:
        delete rep-ic-oper.
    end.
    for each rep-ic-oper-tab where
             rep-ic-oper-tab.nr-ord-produ    = b-rep-oper-ctrab.nr-ord-produ and
             rep-ic-oper-tab.num-seq-rep = b-rep-oper-ctrab.num-seq-rep exclusive-lock:
        delete rep-ic-oper-tab.
    end.

    release oper-ord.
    release op-sfc.
    release split-operac.

END PROCEDURE.

/*******************************************************************************************************
**
** PROCEDURE:  AtualizarEstadoAntecessoras
** OBJETIVO:   Atualiza quantidades reportadas de antecessoras >> APS
** PARAMETROS: buffer b-oper-ord
**
*******************************************************************************************************/

PROCEDURE AtualizarEstadoAntecessoras:

    define parameter buffer b-oper-ord for oper-ord.

    define buffer b2-oper-ord for oper-ord.
    define buffer b-pert-ordem for pert-ordem.

    /*Maykon 07/2013 - Aten‡Æo, essa situa‡Æo dever  ser analisada melhor
    Existe uma indefini‡Æo a respeito do num-operac-sfc da operacao ser o num-operac da rede pert
    Neste ponto a busca pela oper-ord (se num-operac-sfc ou sequencia) deve ser o mesmo da 
    procedure sequenciaoperacoes da cpapi023.p*/
    for each b-pert-ordem where 
             b-pert-ordem.nr-ord-produ      = b-oper-ord.nr-ord-produ   and
             b-pert-ordem.num-operac-suces  = b-oper-ord.sequencia no-lock:

        find b2-oper-ord where
             b2-oper-ord.nr-ord-produ    = oper-ord.nr-ord-produ and
             b2-oper-ord.sequencia = b-pert-ordem.num-operac-predec exclusive-lock.
             

        if b2-oper-ord.qt-produzida < b-oper-ord.qt-produzida then do:
           assign b2-oper-ord.qt-produzida = b-oper-ord.qt-produzida.

           run AtualizarEstadoAntecessoras (buffer b2-oper-ord).           

        end.               
    end.
    release b2-oper-ord.

END PROCEDURE.

