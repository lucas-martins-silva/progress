/***********************************************************************************
* Temp-tables utilizadas na boin771.p e mla0170rp.p                                *
*                                                                                  *
* situacao: 'Mantido', 'Novo', 'Substitu¡do', 'Eliminado', 'Origem', 'Transferido' * 
* id-sit  :     1    ,    2  ,       3      ,       4    ,     5   ,       6       * 
* r-rowid : rowid do registro alterado,exclu¡do ou inserido.       ,               * 
***********************************************************************************/ 
DEFINE TEMP-TABLE tt-mla-lista-aprov-ref-origem NO-UNDO LIKE mla-lista-aprov-ref
    FIELD situacao AS CHAR FORMAT "x(20)"
    FIELD id-sit   AS INT
    FIELD r-rowid  AS ROWID
    INDEX codigo   ep-codigo
                   cod-estabel
                   cod-tip-doc
                   codigo
                   situacao.
                   
DEFINE TEMP-TABLE tt-mla-lista-aprov-ref-destino NO-UNDO LIKE tt-mla-lista-aprov-ref-origem.
