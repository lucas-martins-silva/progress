PROCEDURE initializeFind :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:  È obrigat½rio a execu»’o dessa procedure no in­cio do programa, para
          que fique dispon­vel alguns dados importantes para a perfeita execu»’o
          da BO.     
------------------------------------------------------------------------------*/

    for each tb-wt-docto exclusive-lock:
        delete tb-wt-docto.
    end.

    for each tb-wt-it-docto exclusive-lock:
        delete tb-wt-it-docto.
    end.

    for each tb-wt-it-imposto exclusive-lock:
        delete tb-wt-it-imposto.
    end.     
    
    for each tb-wt-it-impostoCBSIBS exclusive-lock:
        delete tb-wt-it-impostoCBSIBS.
    end.    

    if  not avail docum-est then 
        RETURN "NOK":U.
        

    run findParamGlobal.

    for first param-mat 
        fields ( ind-unid-neg ) no-lock.
    end.

    run findParamCompra.

    run findParamCQ.
    

    /***** Leitura Natureza de Opera»’o *****/
    

    run findNaturOper ( docum-est.nat-operacao ).

    

    /***** Leitura Emitente *****/
    

    run findEmitente ( docum-est.cod-emitente ).


    /***** Leitura Par³metros Usuÿrio Recebimento *****/
    

    run findUsuario ( c-seg-usuario ).

    /***** Leitura Estabelecimento *****/
    

    run findEstabelec ( docum-est.cod-estabel ).

    if  not valid-handle(h-boin090) then
        run getDocumEst ( docum-est.cod-emitente,   
                          docum-est.serie-docto,
                          docum-est.nro-docto,
                          docum-est.nat-operacao ).


    /***** Leitura  C½digo de Observa»’o *****/

    /* SETA FLAGS DE CONTROLE */
    run setFlagsNota in h-boin090 ( docum-est.cod-observa,
                                    docum-est.nat-operacao ).                     

    run getFlagsNota in h-boin090 ( output l-industria,
                                    output l-comercio,
                                    output l-devolucao,
                                    output l-servicos,
                                    output l-transf,
                                    output l-ent-cons,
                                    output l-retorno,
                                    output l-ret-fat ).
    
    run isMultaJuros in h-boin090 (input docum-est.nat-operacao, output l-multa-juros).

    /***** Atualiza»’o de variÿveis de controle *****/
    assign  l-dev-transf     = natur-oper.tipo-compra = 8
            l-NFDebCred      = (natur-oper.tipo-compra = 9)
            l-pede-compra    =      not l-devolucao 
                                and not l-transf  
                                and not l-dev-transf
                                and not l-NFDebCred 
                                and (   natur-oper.tp-oper-terc = 3 
                                     or not natur-oper.terceiros ) 
                                and param-global.modulo-cc
                                

           l-pede-pedordem  =     l-pede-compra 
                              and not l-NFDebCred 
                              and not docum-est.rec-fisico

           l-pede-conta     = not l-devolucao  
 

           l-pede-ord-prod  = not l-devolucao
                              and not l-NFDebCred 
                             

           l-pede-qtd       =       not docum-est.rec-fisico 
                               and (   not natur-oper.terceiros 
                                    or natur-oper.tp-oper-terc <> 6)
           

           l-pede-peso      = not l-servicos
           

           l-pede-valor     = avail param-re
                              and param-re.pd-despesas

           l-pede-data-comp = (l-devolucao 
                              or (    natur-oper.terceiros 
                                  and (  natur-oper.tp-oper-terc = 2 
                                       or natur-oper.tp-oper-terc = 4 
                                       or natur-oper.tp-oper-terc = 5 
                                       or natur-oper.tp-oper-terc = 6) ) )
                            and not docum-est.rec-fisico 
                            and l-devolucao 
                            and avail RowObject
                            and RowObject.nro-comp = ""
                            and not l-NFDebCred 
                            

           /* Indica se Altera valor dos itens em operacao com terceiros */
           l-alter-itens   = avail natur-oper 
                             and int(substr(natur-oper.char-2,36,5)) = 1

           l-material-agregado =     avail docum-est
                                 and docum-est.mod-atual = 1


           l-evento         =     param-global.modulo-cn 
                              and (avail RowObject and RowObject.int-1 <> 0)
                              and not l-NFDebCred 

           l-encerra-pa     =     avail RowObject
                              and param-re.encerra-cc 
                              and RowObject.numero-ordem <> 0 
                              and l-pede-compra

           l-pede-baixa-ce  =     param-re.baixa-estoq = no 
                              and ( l-devolucao = no 
                              or  (avail RowObject and RowObject.nro-comp = "")) 
                              and l-transf = no 
                              and l-dev-transf = no
                              and not l-NFDebCred
                              and not docum-est.rec-fisico 
                              and ( natur-oper.terceiros = no 
                              or    natur-oper.tp-oper-terc <= 3 )
           

           c-it-do-forn    = "" .

    return "OK":U.
    

END PROCEDURE.




