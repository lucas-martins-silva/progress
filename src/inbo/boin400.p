&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getKey DBOProgram  
PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice codigo
  Parameters:  
               retorna valor do campo it-codigo
               retorna valor do campo sequencia
               retorna valor do campo cod-roteiro
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pit-codigo LIKE rot-item.it-codigo NO-UNDO.
    DEFINE OUTPUT PARAMETER psequencia LIKE rot-item.sequencia NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-roteiro LIKE rot-item.cod-roteiro NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pit-codigo = RowObject.it-codigo
           psequencia = RowObject.sequencia
           pcod-roteiro = RowObject.cod-roteiro.

    RETURN "OK":U.
END PROCEDURE.

