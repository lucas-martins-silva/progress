&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getKey DBOProgram 
PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice itmfrncx-id
  Parameters:  
               retorna valor do campo cod-item
               retorna valor do campo cod-exame
               retorna valor do campo cdn-emitente
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pcod-item LIKE item-fornec-exam.cod-item NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-exame LIKE item-fornec-exam.cod-exame NO-UNDO.
    DEFINE OUTPUT PARAMETER pcdn-emitente LIKE item-fornec-exam.cdn-emitente NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pcod-item = RowObject.cod-item
           pcod-exame = RowObject.cod-exame
           pcdn-emitente = RowObject.cdn-emitente.

    RETURN "OK":U.
END PROCEDURE.

