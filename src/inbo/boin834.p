&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice itmfrncx-id
  Parameters:  
               recebe valor do campo cod-item
               recebe valor do campo cod-exame
               recebe valor do campo cdn-emitente
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-item LIKE item-fornec-exam.cod-item NO-UNDO.
    DEFINE INPUT PARAMETER pcod-exame LIKE item-fornec-exam.cod-exame NO-UNDO.
    DEFINE INPUT PARAMETER pcdn-emitente LIKE item-fornec-exam.cdn-emitente NO-UNDO.

    FIND FIRST bfitem-fornec-exam WHERE 
        bfitem-fornec-exam.cod-item = pcod-item AND 
        bfitem-fornec-exam.cod-exame = pcod-exame AND 
        bfitem-fornec-exam.cdn-emitente = pcdn-emitente NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfitem-fornec-exam THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfitem-fornec-exam)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE linkToItemFornec DBOProgram 
PROCEDURE linkToItemFornec :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input parameter pHandle as handle no-undo.

    run getKey in pHandle ( output c-cod-item,
                            output i-cdn-emitente ).

    return "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryByItemFornec DBOProgram 
PROCEDURE openQueryByItemFornec :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    open query {&queryName} for each {&tableName} 
        where {&tableName}.cod-item     = c-cod-item
        and   {&tableName}.cdn-emitente = i-cdn-emitente no-lock indexed-reposition.

    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryMain DBOProgram 
PROCEDURE openQueryMain :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    OPEN QUERY {&queryName} FOR EACH {&tableName} NO-LOCK INDEXED-REPOSITION.

    RETURN "OK":U.

END PROCEDURE.

