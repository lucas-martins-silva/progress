if not can-find(first b-dim-man where
                b-dim-man.cod-dim-man  = {1}) then do:

   if valid-handle (h-handle) then
      run pi-acompanhar  in h-handle (input {1}).

   {utp/ut-table.i mgind {3} 01}
   assign c-label = return-value.

   &if "{&FNC_MULTI_IDIOMA}" = "Yes" &then
           RUN utp/ut-liter.p (trim({ininc/i01in500.i 04 {2}}), "*", "").
           assign c-liter1 = return-value.
   &else
           assign c-liter1 = {ininc/i01in500.i 04 {2}}.
   &endif

   create dim-man.
   assign dim-man.cod-dim-man   = {1}
          dim-man.cod-dimensao  = c-liter1
          dim-man.num-dim-man   = {2}
          dim-man.des-dimensao  = c-label
          dim-man.log-reg-dtsul = yes.

end.
