DEF TEMP-TABLE tt-nc-geradas NO-UNDO
    FIELD rw-nota-fiscal AS ROWID
    FIELD nr-nota        AS CHAR.

DEF TEMP-TABLE tt-nd-geradas NO-UNDO
    FIELD rw-nota-fiscal AS ROWID
    FIELD nr-nota        AS CHAR.

DEF TEMP-TABLE tt-pv-gerados NO-UNDO
    FIELD rw-ped-venda AS ROWID
    FIELD nr-pedido    AS CHAR.

DEF TEMP-TABLE tt-rd-gerados NO-UNDO
    FIELD rw-remito AS ROWID
    FIELD nr-remito AS CHAR.
    
DEF TEMP-TABLE tt-erros-nc NO-UNDO
    FIELD cod-erro  AS INT
    FIELD cod-param AS CHAR.

DEF TEMP-TABLE tt-erros-nd NO-UNDO
    FIELD cod-erro  AS INT
    FIELD cod-param AS CHAR.
    
DEF TEMP-TABLE tt-erros-pv NO-UNDO
    FIELD cod-erro  AS INT
    FIELD cod-param AS CHAR.    
    
DEF TEMP-TABLE tt-erros-rd NO-UNDO
    FIELD cod-erro  AS INT
    FIELD cod-param AS CHAR.    

