&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/
	
	if pType = "CREATE":U then do:
		IF CAN-FIND(responsavel WHERE responsavel.cod-resp = RowObject.cod-resp) THEN DO:
			{utp/ut-liter.i Respons†vel}
			{method/svc/errors/inserr.i
			   &ErrorNumber="7" 
			   &ErrorType="EMS"
			   &ErrorParameters=RETURN-VALUE}
		END.  
	end.
	
    IF pType = "CREATE":U OR pType = "UPDATE":U THEN DO:
        
		IF RowObject.cod-resp = "" THEN DO:
            {utp/ut-liter.i C¢digo_para_usu†rio_necessita_ser_diferente_de_branco}
             {method/svc/errors/inserr.i
               &ErrorNumber="17006" 
               &ErrorType="EMS"
               &ErrorParameters=RETURN-VALUE}
        END.            
		else do:
			IF NOT CAN-FIND(usuar_mestre WHERE usuar_mestre.cod_usuario = RowObject.cod-resp) THEN DO:
				{utp/ut-liter.i Usu†rio_do_Sistema}
				{method/svc/errors/inserr.i
				   &ErrorNumber="2" 
				   &ErrorType="EMS"
				   &ErrorParameters=RETURN-VALUE}
			END.
		end.
		
        IF RowObject.nome-resp = "" THEN DO:
            {utp/ut-liter.i Nome_para_usu†rio_necessita_ser_diferente_de_branco}
             {method/svc/errors/inserr.i
               &ErrorNumber="17006" 
               &ErrorType="EMS"
               &ErrorParameters=RETURN-VALUE}
        END.
		
		IF RowObject.cod-respons-2 = "" THEN DO:
            {utp/ut-liter.i C¢digo_para_respons†vel_alternativo_necessita_ser_diferente_de_branco}
             {method/svc/errors/inserr.i
               &ErrorNumber="17006" 
               &ErrorType="EMS"
               &ErrorParameters=RETURN-VALUE}
        END. 
		else do:
			IF NOT CAN-FIND(responsavel WHERE responsavel.cod-resp = RowObject.cod-respons-2) THEN DO:
				{utp/ut-liter.i Respons†vel_Alternativo}
				{method/svc/errors/inserr.i
				   &ErrorNumber="2" 
				   &ErrorType="EMS"
				   &ErrorParameters=RETURN-VALUE}
			END.   
		end.
		IF RowObject.permissao < 1 THEN DO:
            {utp/ut-liter.i Altera_Situaá∆o_Roteiro_deve_ser_informado}
             {method/svc/errors/inserr.i
               &ErrorNumber="17006" 
               &ErrorType="EMS"
               &ErrorParameters=RETURN-VALUE}
        END.     
    END.
    
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

