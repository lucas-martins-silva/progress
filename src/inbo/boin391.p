&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE piBuscaNomeUsuar DBOProgram 
PROCEDURE piBuscaNomeUsuar :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

DEFINE INPUT  PARAMETER p-cod-usuar AS CHAR NO-UNDO.
DEFINE OUTPUT PARAMETER p-nome      AS CHAR NO-UNDO.

FOR FIRST usuar_mestre WHERE usuar_mestre.cod_usuario  = p-cod-usuar NO-LOCK:
    ASSIGN p-nome = usuar_mestre.nom_usuario.
END.


RETURN 'OK':U.

END PROCEDURE.

