PROCEDURE calculateItensNota :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:   Calcula o nœmero mÿximo de itens (linhas) permitido na nota fiscal,
           isso quando a natureza estÿ parametrizada para ser impressa no fatu-
           ramento. Executado apartir do validateRecord.
------------------------------------------------------------------------------*/

    def input param piNarrativa  like item-doc-est.narrativa no-undo.
    def var c-descricao          as char                     no-undo.
    def var i-nr-linhas-item     as int                      no-undo. 


    assign c-descricao = ""
           i-nr-linhas-item = 0.
 

    if  avail item then do:
        

        /* Considerar descricao do item */
        if  item.ind-imp-desc <= 4
        or  item.ind-imp-desc >= 8 then
            assign c-descricao = item.desc-item.

        /* Considerar linhas da narrativa do item */
        if  lookup(string(item.ind-imp-desc), "2,5,6,10") > 0 then do:
            find narrativa
                where narrativa.it-codigo = item.it-codigo no-lock no-error.
            if  avail narrativa then
                if  item.ind-imp-desc = 10 then
                    assign c-descricao = c-descricao + " " +
                                         trim(substring(narrativa.descricao,1,24)).
                else
                    assign c-descricao = c-descricao + " " + trim(narrativa.descricao).
        end.        
        else
            /* Considerar narrativa do item-cli */
            if  lookup(string(item.ind-imp-desc), "3,8") > 0 then do:
                find item-cli
                    where item-cli.nome-abrev = emitente.nome-abrev 
                    and   item-cli.it-codigo  = item.it-codigo no-lock no-error.

                if  avail item-cli then 
                    if  item.ind-imp-desc = 8 then
                        assign c-descricao = c-descricao + " " +
                                             trim(substring(item-cli.narrativa,1,24)).
                    else
                        assign c-descricao = c-descricao + " " + trim(item-cli.narrativa).
            end.    
            else
                /* Considerar narrativa informada */
                if  lookup(string(item.ind-imp-desc), "4,7,9") > 0 then
                    if  item.ind-imp-desc = 9 then /* 24 caracteres da narrativa informada */
                        assign c-descricao = c-descricao + " " +
                                             trim(substring(piNarrativa,1,24)).
                    else
                        if  item.ind-imp-desc = 4 then /* Descricao mais narrativa informada */
                            assign c-descricao = c-descricao + " " +
                                                 trim(piNarrativa).
                        else
                            /* Somente narrativa informada */
                            assign c-descricao = trim(piNarrativa).
        


        do  i-cont = 1 to length(c-descricao):
            assign c-descricao-aux = substring(c-descricao, 
                                               (((i-cont - 1) * i-tamanho-linha) + 1), 
                                               i-tamanho-linha).
            if  c-descricao-aux = "" then 
                leave.
            else
                assign i-nr-linhas-item = i-nr-linhas-item + 1.
        end.
    

        if  i-nr-linhas-item = 0 then
            assign i-nr-linhas-item = 1.
     

        assign i-nr-linhas = i-nr-linhas + i-nr-linhas-item.
    end.

    return "OK":U.

END PROCEDURE.




