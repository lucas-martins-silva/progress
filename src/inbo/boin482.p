&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getKey DBOProgram  
PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice id
  Parameters:  
               retorna valor do campo it-codigo
               retorna valor do campo sequencia
               retorna valor do campo cod-lista-compon
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pit-codigo LIKE lista-compon-item.it-codigo NO-UNDO.
    DEFINE OUTPUT PARAMETER psequencia LIKE lista-compon-item.sequencia NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-lista-compon LIKE lista-compon-item.cod-lista-compon NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pit-codigo = RowObject.it-codigo
           psequencia = RowObject.sequencia
           pcod-lista-compon = RowObject.cod-lista-compon.

    RETURN "OK":U.
END PROCEDURE.

