&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice id
  Parameters:  
               recebe valor do campo dat-ult-atualiz
               recebe valor do campo hra-ult-atualiz
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pdat-ult-atualiz LIKE param-cs.dat-ult-atualiz NO-UNDO.
    DEFINE INPUT PARAMETER phra-ult-atualiz LIKE param-cs.hra-ult-atualiz NO-UNDO.

    FIND FIRST bfparam-cs WHERE 
        bfparam-cs.dat-ult-atualiz = pdat-ult-atualiz AND 
        bfparam-cs.hra-ult-atualiz = phra-ult-atualiz NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfparam-cs THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfparam-cs)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


