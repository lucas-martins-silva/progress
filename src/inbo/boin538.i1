procedure GerarRepRefugoOper:

    def param buffer b-rep-oper-ctrab for rep-oper-ctrab.
    def input param table             for tt-rep-refugo-oper.
    def input param i-seq-tt as int no-undo.

    for each tt-rep-refugo-oper
        where tt-rep-refugo-oper.nr-ord-produ = b-rep-oper-ctrab.nr-ord-produ
          and tt-rep-refugo-oper.num-seq-rep  = i-seq-tt:
        
        create rep-refugo-oper.
        buffer-copy tt-rep-refugo-oper to rep-refugo-oper
        assign rep-refugo-oper.num-seq-rep = b-rep-oper-ctrab.num-seq-rep.
    end.

end procedure.
