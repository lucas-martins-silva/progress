/***********************************************************************************
**
** BOIN404TE.I1 - Defini‡Æo de tabelas tempor rias para gera‡Æo dos dados dos itens 
                  de terceiros.
**
************************************************************************************/

def temp-table tt-item-terc no-undo
    field it-codigo         like componente.it-codigo
    field desconto          like componente.desconto extent 0
    field peso-liquido      like componente.peso-liquido
    field cod-refer         like componente.cod-refer
    field serie-docto       like componente.serie-docto
    field nro-docto         like componente.nro-docto
    field nat-operacao      like componente.nat-operacao 
    field sequencia         like componente.sequencia
    field seq-comp          like componente.sequencia
    field un                like componente.un
    field nr-ord-prod       like componente.nr-ord-prod
    field ct-codigo         like componente.ct-codigo
    field sc-codigo         like componente.sc-codigo
    field quantidade        like componente.quantidade
    field qt-do-forn-cli    like componente.qt-do-forn
    field class-fiscal      like componente.class-fiscal
    field aliquota-ipi      like componente.aliquota-ipi
    field aliquota-iss      like item.aliquota-iss
    field narrativa         like componente.narrativa
    field baixa-ce          like componente.baixa-ce
    field item-pai          like componente.it-codigo 
    field cod-roteiro       as char
    field op-codigo         as int 
    field ind-icm-ret       like componente.log-2
    field vl-preori         as dec 
    field vl-preuni         as dec
    field vl-merc-ori       as dec
    field vl-merc-liq       as dec
    field per-des-item      as dec
    field char-1            as char
    &IF "{&bf_dis_versao_ems}" >= "2.062" &THEN
    FIELD cod-unid-negoc    LIKE componente.cod-unid-negoc
    &ENDIF
    index codigo
          sequencia.

def temp-table tt-baixa-estoq-item-terc no-undo
    field sequencia    like componente.sequencia
    field it-codigo    like rat-lote.it-codigo
    field cod-depos    like rat-lote.cod-depos
    field cod-localiz  like rat-lote.cod-localiz
    field lote         like rat-lote.lote
    field dt-vali-lote like rat-lote.dt-vali-lote
    field quantidade   like rat-lote.quantidade
    field char-1       as char
    index codigo
          sequencia.

/*  BOIN404TE.I1  */
