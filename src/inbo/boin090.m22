PROCEDURE validateRecord :
/*------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    assign cType = pType.

    def buffer bf-estabelec          for estabelec. 
    def var    dt-mensal-ate     like param-estoq.mensal-ate no-undo.
    def var    h-boin060         as handle  no-undo.     
    def var    vl-tot-bruto-aux  as decimal no-undo.
    def var    de-peso-bruto-aux as decimal no-undo.
    def var    l-import          as log     no-undo.
    
    /*Variavel usada na geraá∆o do novo n£mero da nota - movido do programa boin090.m21*/
    def var c-nro-aux       as char     no-undo.    

    DEFINE VARIABLE i-cont-progs    AS INTEGER     NO-UNDO.
    DEFINE VARIABLE l-exec-reapi316 AS LOGICAL   NO-UNDO.

    DEF VAR c-liter-1 AS CHAR NO-UNDO.
    DEF VAR c-liter-2 AS CHAR NO-UNDO.
    DEF VAR c-texto-1 AS CHAR NO-UNDO.
    
    /*--- Utilize o parÅmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*--- Os valores poss–veis para o parÅmetro s∆o: Create, Delete e Update ---*/
    /*--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*--- Inclua aqui as validaá‰es ---*/
    
    /* GeraÁ„o do novo n˙mero da nota que foi movido do programa boin090.m21 */
    IF pType = "Create":U THEN DO:
        IF AVAIL natur-oper THEN DO:
            IF  NOT RowObject.rec-fisico
                AND RowObject.origem <> "AQR"
                AND RowObject.origem <> "i"
                AND RowObject.origem <> "XML"
                AND param-global.modulo-ft 
                AND natur-oper.imp-nota THEN DO:
                
                RUN calculateNumberInvoice ( OUTPUT c-nro-aux ).
                
                IF i-pais-impto-usuario = 1 THEN
                    ASSIGN RowObject.nro-docto = LEFT-TRIM(STRING(DEC(c-nro-aux), c-formato)).
                ELSE
                    ASSIGN RowObject.nro-docto = STRING(DEC(c-nro-aux)).
                    
            END.
        END.
    END.
    
    for first b-docum-est
        fields ( cod-emitente serie-docto nro-docto nat-operacao ce-atual dt-trans ind-sit-wms-ext)
        where b-docum-est.cod-emitente = RowObject.cod-emitente
          and b-docum-est.serie-docto  = RowObject.serie-docto
          and b-docum-est.nro-docto    = RowObject.nro-docto
          and b-docum-est.nat-operacao = RowObject.nat-operacao no-lock: end.
    

    if  avail b-docum-est
    and b-docum-est.ce-atual then do:
        DEFINE VARIABLE c-dt-trans-erro AS CHARACTER NO-UNDO.
        {utp/ut-liter.i "Data_Transaá∆o:" *}
        ASSIGN c-dt-trans-erro = TRIM(RETURN-VALUE) + " " + STRING(b-docum-est.dt-trans).
        {method/svc/errors/inserr.i
                            &ErrorNumber="19515" /*Nota fiscal j† atualizada*/
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U
                            &ErrorParameters="c-dt-trans-erro"}
    end.

    IF NOT RowObject.rec-fisico AND
       (RowObject.ind-sit-wms-ext  <> 0  and /*Digitada*/
        RowObject.ind-sit-wms-ext  <> 1  and /*N∆o Integra*/
        RowObject.ind-sit-wms-ext  <> 5  and /*Conferencia NOK*/
        RowObject.ind-sit-wms-ext  <> 6) then do: /*Inativado*/
        {method/svc/errors/inserr.i &ErrorNumber="57473"
                                    &ErrorType="EMS"
                                    &ErrorSubType="ERROR" }
    END.
    
    /***** Leitura Natureza Operaá∆o *****/
    run findNaturOper ( RowObject.nat-operacao ).


    /***** Leitura Emitente *****/
    run findEmitente ( RowObject.cod-emitente ).

    
    /***** Leitura Estabelec *****/
    run findEstabelec ( RowObject.cod-estabel ).


   /*=========== SuperGasbras/MinasGfindEstabelec†s ==================*/
     &IF DEFINED(BF_dis_natur_uf) &THEN
         IF CAN-FIND(funcao WHERE
                     funcao.cd-funcao = "fn-estab-natur-uf" AND
                     funcao.ativo     = YES) THEN DO:
            RUN verificaNaturUF ( INPUT RowObject.cod-estabel  ,
                                  INPUT RowObject.nat-operacao , 
                                  INPUT YES                    ). /*Yes = Mostrar erro, executa a method/svc/errors/inserr.i*/
         END.
     &ENDIF
   /*====================================================*/

    /***** Leitura Usuario *****/ 
    IF  RowObject.origem <> "G" 
    AND RowObject.origem <> "T" THEN
        ASSIGN RowObject.usuario = c-seg-usuario.
    run findUsuario ( RowObject.usuario ).
    

    /***** Seta Flags referentes CÆdigo Observaá∆o da Nota *****/
    run setFlagsNota ( RowObject.cod-observa,
                       ? ).


    /***** Validaá‰es Somente para CREATE *****/
    

    if  pType = "Create":U then 
        run validateCreateRecord.     
        

    else do:
        /***** Verifica exist™ncia de Documento para Alteraá∆o *****/
                      

        if   not avail {&TableName}
        or  {&TableName}.serie-docto  <> RowObject.serie-docto
        or  {&TableName}.cod-emitente <> RowObject.cod-emitente
        or  {&TableName}.nro-docto    <> RowObject.nro-docto 
        or  {&TableName}.nat-operacao <> RowObject.nat-operacao then do:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-documento-do-estoque AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Documento_do_Estoque" *}
            ASSIGN c-lbl-liter-documento-do-estoque = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                                &ErrorNumber="2"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U 
                                &ErrorParameters="c-lbl-liter-documento-do-estoque"}
        end.
    end.                                        


    IF  PTYPE <> "DELETE":U THEN DO:
        
        
        RUN alertaMesmaChaveAcesso.
        RUN ValidaDepFechado.
        RUN bloqueiaNfeComDiverg.
        
        IF RowObject.origem <> "XML":U THEN
            RUN bloqueiaDigitXML.

        /* VALIDAÄ«O ITENS CONTROLADOS PELA POLICIA FEDERAL */
        IF RowObject.nome-transp = "" THEN DO:
            IF NOT VALID-HANDLE(h-reapi007) THEN
                RUN rep/reapi007.p PERSISTENT SET h-reapi007.

            ASSIGN l-erro-item-pf = NO.        
            FOR EACH item-doc-est NO-LOCK
                WHERE item-doc-est.nro-docto    = RowObject.nro-docto 
                  AND item-doc-est.cod-emitente = RowObject.cod-emitente
                  AND item-doc-est.serie-docto  = RowObject.serie-docto
                  AND item-doc-est.nat-operacao = RowObject.nat-operacao:
                    
                IF CAN-FIND(FIRST item-orgao-control
                            WHERE item-orgao-control.it-codigo      = item-doc-est.it-codigo
                              AND item-orgao-control.log-item-agpf  = YES)                    THEN DO:

                    RUN setRowidDocumEst        IN h-reapi007 (INPUT ROWID(RowObject)).
                    RUN setRowidItemDocEst      IN h-reapi007 (INPUT ROWID(item-doc-est)).
                    RUN piRetornaMovtoEstPF     IN h-reapi007 (OUTPUT l-movto-est).

                    IF l-movto-est THEN DO:
                        ASSIGN l-erro-item-pf = YES.
                    END.
                END.                
            END.

            IF VALID-HANDLE(h-reapi007) THEN DO:
                DELETE PROCEDURE h-reapi007.
                ASSIGN h-reapi007 = ?.
            END.

            IF l-erro-item-pf THEN DO:
                {method/svc/errors/inserr.i &ErrorNumber="56562"
                                            &ErrorType="EMS":U
                                            &ErrorSubType="ERROR":U}
            END.
        END.
                               
        IF  RowObject.rec-fisico = NO   /* nao foi gerado via recebimento fisico */
        AND RowObject.mod-atual <> 1    /* nao Ç material agregado */
        AND CAN-FIND(FIRST doc-fisico
                     WHERE doc-fisico.cod-emitente = RowObject.cod-emitente
                       AND doc-fisico.nro-docto    = RowObject.nro-docto
                       AND doc-fisico.serie-docto  = RowObject.serie-docto
                       AND doc-fisico.dt-emissao   = RowObject.dt-emissao) THEN DO:
            {method/svc/errors/inserr.i &ErrorNumber="52849"
                &ErrorType="EMS":U
                &ErrorSubType="WARNING":U
                &ErrorParameters="RowObject.serie-docto + '~~~~' +
                                  STRING(RowObject.nro-docto) + '~~~~' +
                                  STRING(RowObject.cod-emitente) + '~~~~' +
                                  STRING(RowObject.dt-emissao)"}
        END.

        IF  avail natur-oper 
        AND natur-oper.terceiros
        AND natur-oper.tp-oper-terc = 5  /* Devoluá∆o de Consignaá∆o */
       &IF "{&mguni_version}" >= "2.08" &THEN
        AND natur-oper.idi-tip-devol-consig = 1
       &ELSE
        AND INT(SUBSTR(natur-oper.char-1,140,1)) = 1
       &ENDIF
        AND  NOT {cdp/cd0066.i2 RowObject.cod-estabel}
        THEN DO:
            {method/svc/errors/inserr.i &ErrorNumber="35109"
                                        &ErrorType="EMS":U
                                        &ErrorSubType="ERROR":U} 
        END.                        

        /***** Verifica CÆdigo de Observaá∆o X EspÇcie de Documento *****/
        

        run getEspDocto ( output RowObject.esp-docto ).
                          
        if  avail natur-oper 
            and natur-oper.nat-ativa = no then do:
                   {method/svc/errors/inserr.i
                          &ErrorNumber="26759"
                          &ErrorType="EMS":U
                          &ErrorSubType="ERROR":U}
        end.

        if  RowObject.esp-docto = 20        /* "NFD" */
        and avail natur-oper
        and natur-oper.tipo = 1             /* Entrada */
        and natur-oper.tipo-compra <> 8     /*DevoluÁ„o transferÍncia*/
        and RowObject.cod-observa  <> 3 
        and RowObject.cod-observa  <> 4 then do:
            {method/svc/errors/inserr.i
                                &ErrorNumber="15050"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U }
        end.    
        
        IF AVAIL natur-oper then do:
            if  l-spp-NT2024002 = no then do:
                if natur-oper.tipo-compra = 9 then do: /* nota de credito/debito */
                    {utp/ut-liter.i (NT2024002) * r }
                    ASSIGN c-liter-1 = TRIM(RETURN-VALUE).
                    {method/svc/errors/inserr.i
                                        &ErrorNumber="58156"
                                        &ErrorType="EMS":U
                                        &ErrorSubType="ERROR":U
                                        &ErrorParameters="c-liter-1"}
                end.
                                                
                /* Impede finalidade 5 para devoluá‰es (3 ou 8) com a funá∆o desativada */
                IF (natur-oper.tipo-compra = 3 OR natur-oper.tipo-compra = 8) 
                AND int(RowObject.cod-finalidade) = 5 THEN DO:
                                        
                    {utp/ut-liter.i A_finalidade_informada * r }
                    ASSIGN c-liter-1 = TRIM(RETURN-VALUE).
                    
                    {utp/ut-liter.i (NT2024002) * r }
                    ASSIGN c-liter-2 = TRIM(RETURN-VALUE).
                    
                    {method/svc/errors/inserr.i
                                        &ErrorNumber="58226"
                                        &ErrorType="EMS":U
                                        &ErrorSubType="ERROR":U
                                        &ErrorParameters="c-liter-1 + '~~~~' + c-liter-2"}
                END. 
                
            end.
            ELSE DO:
                /* Regra original para tipo-compra = 9 (CrÇdito/DÇbito) */
                IF natur-oper.tipo-compra = 9 THEN DO:
                    IF  int(RowObject.cod-finalidade) <> 5 //finalidade crÇdito
                    AND int(RowObject.cod-finalidade) <> 6 //finalidade dÇbito
                    THEN DO:
                        {utp/ut-liter.i Apenas_as_Finalidades_5(CrÇdito)_e_6(DÇbito)_s∆o_ * r }
                        ASSIGN c-liter-1 = TRIM(RETURN-VALUE).
                        {utp/ut-liter.i _para_Nota_de_CrÇdito/DÇbito * r }
                        ASSIGN c-liter-2 = TRIM(RETURN-VALUE).
                        {method/svc/errors/inserr.i
                                            &ErrorNumber="58152"
                                            &ErrorType="EMS":U
                                            &ErrorSubType="ERROR":U
                                            &ErrorParameters="c-liter-1 + '~~~~' + c-liter-2"}        
                    END.
                END.
                
                /* Tipos de nota espec°ficos para devoluá‰es (3 e 8) */
                IF (natur-oper.tipo-compra = 3 OR natur-oper.tipo-compra = 8) THEN DO:
                                                            
                    /* Se Finalidade = 5, exige Tipo Nota = 3, 4 ou 6 */
                    IF int(RowObject.cod-finalidade) = 5 AND 
                       int(RowObject.cod-tipo-nf-cred-deb) <> 3 AND
                       int(RowObject.cod-tipo-nf-cred-deb) <> 4 AND
                       int(RowObject.cod-tipo-nf-cred-deb) <> 6 THEN DO:
                        {utp/ut-liter.i CrÇdito * r }
                        ASSIGN c-liter-1 = TRIM(RETURN-VALUE).
                                                
                        {utp/ut-liter.i Para_devoluá‰es_com_finalidade_5,_s¢_pode_ser_utilizado_os_tipos_de_nota_3_(Retorno_por_recusa_ou_por_n∆o_localizaá∆o_destinat†rio_entrega),4_(Reduá∆o_de_valores_ou_quantidades)_ou_6_(Retorno_por_recusa_parcial_na_entrega). * r }
                        ASSIGN c-liter-2 = TRIM(RETURN-VALUE).
                        
                        {method/svc/errors/inserr.i
                                            &ErrorNumber="58227"
                                            &ErrorType="EMS":U
                                            &ErrorSubType="ERROR":U
                                            &ErrorParameters="c-liter-1 + '~~~~' + c-liter-2"} 
                    END.
                END.
            END.
            
            /* Regra Geral de Bloqueio da Finalidade 5 e 6 para as outras naturezas */
            IF (int(RowObject.cod-finalidade) = 5 
            AND natur-oper.tipo-compra <> 9 //nota de credito/debito
            AND natur-oper.tipo-compra <> 3 //devolucao cliente
            AND natur-oper.tipo-compra <> 8) //devolucao transferencia
             OR (int(RowObject.cod-finalidade) = 6
            AND natur-oper.tipo-compra <> 9) //nota de credito/debito
            THEN DO:
            
               IF int(RowObject.cod-finalidade) = 5 THEN DO:
                  {utp/ut-liter.i A_Finalidade_5(CrÇdito)_Ç_ * r }
                  ASSIGN c-liter-1 = TRIM(RETURN-VALUE).
                  {utp/ut-liter.i apenas_para_Nota_de_CrÇdito/DÇbito,_Devoluá∆o_de_Cliente_e_Devoluá∆o_de_Transferància. * r }
                  ASSIGN c-liter-2 = TRIM(RETURN-VALUE).
               END.
                
               IF int(RowObject.cod-finalidade) = 6 THEN DO:
                  {utp/ut-liter.i A_Finalidade_6(DÇbito)_Ç_ * r }
                  ASSIGN c-liter-1 = TRIM(RETURN-VALUE).
                  {utp/ut-liter.i apenas_para_Nota_de_CrÇdito/DÇbito. * r }
                  ASSIGN c-liter-2 = TRIM(RETURN-VALUE).
               END.
               
               {method/svc/errors/inserr.i
                                  &ErrorNumber="58151"
                                  &ErrorType="EMS":U
                                  &ErrorSubType="ERROR":U
                                  &ErrorParameters="c-liter-1 + '~~~~' + c-liter-2"}    
            END.
        END.

        if i-pais-impto-usuario = 1 then do:
            if  avail natur-oper then do:
                 
                if natur-oper.imp-nota then do:
        
                    &IF "{&bf_mat_versao_ems}" >= "2.062" &THEN     
                       /* Comando TRUNCATE porque a vari†vel "gc-peso-bruto-tot" tem 3 casas decimais, e a "tot-peso" 4 casas */   
                       if  truncate(decimal(gc-peso-bruto-tot),3) < truncate(rowObject.tot-peso,3) then do:   
                           assign de-peso-bruto-aux = decimal(gc-peso-bruto-tot).
                           
                    &ELSE
                       if  dec(SUBSTRING(RowObject.char-1,157,17)) < rowObject.tot-peso then do: 
                           assign de-peso-bruto-aux = dec(SUBSTRING(RowObject.char-1,157,17)).           
                    &ENDIF
                        
                        /* Inicio -- Projeto Internacional */
                        DEFINE VARIABLE c-lbl-liter-peso-total-bruto AS CHARACTER NO-UNDO.
                        {utp/ut-liter.i "Peso_Total_Bruto" *}
                        ASSIGN c-lbl-liter-peso-total-bruto = TRIM(RETURN-VALUE).
                        DEFINE VARIABLE c-lbl-liter-peso-total-liquido AS CHARACTER NO-UNDO.
                        {utp/ut-liter.i "Peso_Total_L°quido" *}
                        ASSIGN c-lbl-liter-peso-total-liquido = TRIM(RETURN-VALUE).
                        {method/svc/errors/inserr.i &ErrorNumber="25966"
                                                    &ErrorType="EMS":U
                                                    &ErrorSubType="ERROR":U
                                                    &ErrorParameters="c-lbl-liter-peso-total-bruto + string(de-peso-bruto-aux) + 
                                                                         '~~~~~' + c-lbl-liter-peso-total-liquido + string(rowObject.tot-peso)"}
                    end.
                               
                   for each  docto-estoq-embal
                       where docto-estoq-embal.cod-ser-docto    = rowObject.serie-docto  
                       and   docto-estoq-embal.cod-docto        = rowObject.nro-docto    
                       and   docto-estoq-embal.cdn-emitente     = rowObject.cod-emitente 
                       and   docto-estoq-embal.cod-natur-operac = rowObject.nat-operacao NO-LOCK:
                       assign vl-tot-bruto-aux  = vl-tot-bruto-aux  + docto-estoq-embal.val-peso-embal.
                   end.
        
                    &IF "{&bf_mat_versao_ems}" >= "2.062" &THEN     
                       if  truncate(decimal(gc-peso-bruto-tot),3) < truncate(vl-tot-bruto-aux,3) then do:   
                           assign de-peso-bruto-aux = decimal(gc-peso-bruto-tot).
                           
                    &ELSE
                       if  dec(SUBSTRING(RowObject.char-1,157,17)) < vl-tot-bruto-aux then do: 
                           assign de-peso-bruto-aux = dec(SUBSTRING(RowObject.char-1,157,17)).           
                    &ENDIF
        
                        /* Inicio -- Projeto Internacional */
                        DEFINE VARIABLE c-lbl-liter-peso-total-bruto-2 AS CHARACTER NO-UNDO.
                        {utp/ut-liter.i "Peso_Total_Bruto" *}
                        ASSIGN c-lbl-liter-peso-total-bruto-2 = TRIM(RETURN-VALUE).
                        DEFINE VARIABLE c-lbl-liter-peso-total-da-embalagem AS CHARACTER NO-UNDO.
                        {utp/ut-liter.i "Peso_Total_da_Embalagem" *}
                        ASSIGN c-lbl-liter-peso-total-da-embalagem = TRIM(RETURN-VALUE).
                        {method/svc/errors/inserr.i &ErrorNumber="25966"
                                                    &ErrorType="EMS":U
                                                    &ErrorSubType="ERROR":U
                                                    &ErrorParameters="c-lbl-liter-peso-total-bruto-2 + string(de-peso-bruto-aux) + 
                                                                      '~~~~~' + c-lbl-liter-peso-total-da-embalagem"}
                   end.
                        
                end.
            end.
        end. 
        
        if  avail emitente
        and emitente.identific = 1 /* Cliente */
       /* and RowObject.cod-observa <> 3
        and RowObject.cod-observa <> 4 */
        and avail natur-oper
        and natur-oper.emite-duplic then do:
       /* and natur-oper.tp-oper-terc <> 5*/  /* Devoluá∆o Consignaá∆o */
            {method/svc/errors/inserr.i
                                &ErrorNumber="27514"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U }
        end.

        if  RowObject.cod-observa = 3               /* Dev. Cliente */
        and RowObject.esp-docto <> 20 then do:      /* NFD */
            {method/svc/errors/inserr.i
                                &ErrorNumber="15050"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U }
        end.
    
        if  RowObject.cod-observa = 3               /* Dev. Cliente */
        and RowObject.esp-docto = 20                /* NFD */
        and avail natur-oper
        and natur-oper.tipo-compra <> 3 then do:
            {method/svc/errors/inserr.i
                                &ErrorNumber="27513"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U }
        end.
        

        /***** Verifica Datas de Emiss∆o e Transaá∆o *****/
    
        /* ****** In°cio EPC Crefisa ******** */
        for each tt-epc 
            where tt-epc.cod-event = "nao-valida-dt-trans":U:
            delete tt-epc.
        end.
        
       
        create tt-epc.
        assign tt-epc.cod-event     = "nao-valida-dt-trans":U
               tt-epc.cod-parameter = "dt-emissao":U
               tt-epc.val-parameter = string(RowObject.dt-emissao).

        create tt-epc.
        assign tt-epc.cod-event     = "nao-valida-dt-trans":U
               tt-epc.cod-parameter = "dt-trans":U
               tt-epc.val-parameter = string(RowObject.dt-trans).

        {include/i-epc201.i nao-valida-dt-trans}
        /* ***** Fim EPC Crefisa ***** */
        if not can-find(first tt-epc 
                        where tt-epc.cod-event     = "nao-valida-dt-trans":U
                        and   tt-epc.cod-parameter = "nao-valida":U
                        and   tt-epc.val-parameter = "NAO-VALIDA":U) then do:
        
            if  RowObject.dt-trans > today then do:
                {method/svc/errors/inserr.i
                                    &ErrorNumber="1788"
                                    &ErrorType="EMS":U
                                    &ErrorSubType="ERROR":U }
            end.    
        end.
            
        
        if  RowObject.dt-trans < RowObject.dt-emissao then do:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-data-transacao AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Data_Transaá∆o" *}
            ASSIGN c-lbl-liter-data-transacao = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-liter-data-emissao AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Data_Emiss∆o" *}
            ASSIGN c-lbl-liter-data-emissao = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                                &ErrorNumber="89"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U
                                &ErrorParameters="c-lbl-liter-data-transacao + '~~~~' + c-lbl-liter-data-emissao"  }
        end.                            
    

        /* Determina data do mÇdio */
        if  param-estoq.tp-fech = 1 then
            assign dt-mensal-ate = param-estoq.mensal-ate.
        else do:
            

            run findEstabelec ( RowObject.cod-estabel ).
                            

            if  avail estab-mat then 
                assign dt-mensal-ate = estab-mat.mensal-ate.
        end.                
        
    
        /*validaÁ„o para contabilizaÁ„o de documento do GFE com dia j· contabilizado*/
        IF RowObject.origem = "G" AND                                                        /*origem = GFE */  
           CAN-FIND(FIRST param-estoq WHERE SUBSTRING(param-estoq.char-1,29,1) = "S":U)  AND /*par‚metro da contabilizaÁ„o pelo recebimento ativado*/
           (AVAIL natur-oper AND NOT natur-oper.nota-rateio) THEN DO:                        /*natureza n„o È de rateio*/   
           
            IF CAN-FIND(FIRST ctbz-recebto WHERE ctbz-recebto.cod-estabel = RowObject.cod-estabel
                                             AND ctbz-recebto.dt-trans    = RowObject.dt-trans
                                             AND ctbz-recebto.log-ctbzdo) THEN DO:           /*dia j· foi contabilizado*/
            
                 /*&1 j  foi contabilizado(a)*/
                DEFINE VARIABLE c-liter AS CHARACTER NO-UNDO.
                {utp/ut-liter.i Data_do_documento *}
                ASSIGN c-liter = RETURN-VALUE.
                {method/svc/errors/inserr.i 
                            &ErrorNumber="33251"
                            &ErrorType="EMS"
                            &ErrorParameters="c-liter"}      
    
            END.
        /****************************************************************************/                        
        /* Natureza de Rateio n„o È permitida p a nova funcionalidade -> contabilizaÁ„o de Documentos de Frete, 
           deve-se selecionar a opÁ„o†2=Documento de Frete (Recebimento) dessa forma n„o deve-se levar em 
           consideraÁ„o a data do fechamento do mÈdio quando este par‚metro est· setado no GFE e a contabilizaÁ„o
           de frete pelo recebimento est· ativa no DATASUL. */
        END.
        ELSE DO:                                                                
            if  RowObject.dt-trans <= dt-mensal-ate then do:
                {method/svc/errors/inserr.i
                                    &ErrorNumber="1586"
                                    &ErrorType="EMS":U
                                    &ErrorSubType="ERROR":U }
            end.
        END.

        if  avail param-re then do:                      
            if  RowObject.dt-trans < ( today - param-re.var-atual ) then do:
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-data-transacao-2 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Data_Transaá∆o" *}
                ASSIGN c-lbl-liter-data-transacao-2 = TRIM(RETURN-VALUE).
                {method/svc/errors/inserr.i
                                    &ErrorNumber="8824"
                                    &ErrorType="EMS":U
                                    &ErrorSubType="ERROR":U
                                    &ErrorParameters="c-lbl-liter-data-transacao-2" }
            end.
    

            if  RowObject.dt-emissao < ( today - param-re.var-emis ) then do:
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-data-emissao-2 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Data_Emiss∆o" *}
                ASSIGN c-lbl-liter-data-emissao-2 = TRIM(RETURN-VALUE).
                {method/svc/errors/inserr.i
                                    &ErrorNumber="8824"
                                    &ErrorType="EMS":U
                                    &ErrorSubType="ERROR":U
                                    &ErrorParameters="c-lbl-liter-data-emissao-2" }
            end.
        end.
                
        if  avail natur-oper 
        and natur-oper.tipo-compra = 3 /* Dev. Cliente */
        and natur-oper.int-1       = 1 /* Nota Pr¢pria */      
        and natur-oper.imp-nota  /* Imp Nota Faturamento */  then do:
        
            if  not valid-handle(h-boin060) then
                run inbo/boin060.p persistent set h-boin060.
            
            if RowObject.dt-emissao <> RowObject.dt-trans then do:
                {method/svc/errors/inserr.i &ErrorNumber="33471"
                                            &ErrorType="EMS":U
                                            &ErrorSubType="WARNING":U 
                                            &ErrorParameters="''"}
            end.                                
            
            if valid-handle(h-boin060) then
                run updateConsistNota in h-boin060 ( RowObject.cod-emitente,
                                                     RowObject.serie-docto,
                                                     RowObject.nro-docto,
                                                     RowObject.nat-operacao,
                                                     0,   
                                                     RowObject.dt-emissao = RowObject.dt-trans, /* Datas iguais, elimina registro. Se diferentes, cria consistància */
                                                     0,
                                                     0,
                                                     33471,
                                                     2). /* Advertància */
                                                     
            if  valid-handle(h-boin060) then do:
                run destroy in h-boin060.
                assign h-boin060 = ?.
            end.    
        end.

        /***** Verifica Integraá∆o com Obrigaá‰es Fiscais *****/
        

        for first param-of
                fields ( dt-congela ) 
                where param-of.cod-estabel = RowObject.estab-fisc no-lock.
        end.
    

        if  avail param-of 
        and param-of.dt-congela <> ?
        and RowObject.dt-trans <= param-of.dt-congela then do:
            {method/svc/errors/inserr.i
                                &ErrorNumber="5137"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U}
        end.    
    
        if  avail param-global
        and param-global.modulo-bh 
        and avail natur-oper
        and natur-oper.ind-gera-of
        and can-find (first his-doc-fiscal 
                      where his-doc-fiscal.cod-estabel  = RowObject.estab-fisc
                        and his-doc-fiscal.serie        = RowObject.serie-docto 
                        and his-doc-fiscal.nr-doc-fis   = RowObject.nro-docto
                        and his-doc-fiscal.cod-emitente = RowObject.cod-emitente     
                        and his-doc-fiscal.nat-operacao = RowObject.nat-operacao) then do:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-documento-fiscal-com-mesma-cha AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Documento_Fiscal_com_mesma_chave" *}
            ASSIGN c-lbl-liter-documento-fiscal-com-mesma-cha = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                                &ErrorNumber="28152"
                                &ErrorType="EMS"
                                &ErrorSubType="ERROR"
                                &ErrorParameters="c-lbl-liter-documento-fiscal-com-mesma-cha" }
        end.
    
        /***** Verifica Entrada Transfer™ncia *****/
        

        if  l-transf then 
            run validateTransferencia.
    

        

        /***** Verifica Movimentaá∆o - Natureza Operaá∆o X Unidade Federaá∆o *****/
            

        run validateTypeMovto ( l-transf ).          /* Transferencia */
    
        /***** Verificar Modelo e serie eletronica *****/
         
        run validateDadosNFe.
    

        /***** Valida Conta Cont†bil *****/
    

        run validateContaTransit.
     
        /***** Valida Estabelecimento Fiscal *****/
        
        find first bf-estabelec no-lock
             where bf-estabelec.cod-estabel = RowObject.estab-fisc no-error.
        if not avail bf-estabelec then do:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-estabelecimento-fiscal AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Estabelecimento_Fiscal" *}
            ASSIGN c-lbl-liter-estabelecimento-fiscal = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                                &ErrorNumber="2"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U 
                                &ErrorParameters="c-lbl-liter-estabelecimento-fiscal"}
        end.
     
        /***** Valida Unidade Federaá∆o *****/
        

        if i-pais-impto-usuario <> 1 then do:
            
            define var level as int initial 1.
              repeat while program-name(level) <> ?.
                  if  program-name(level) matches "imp/im3100a.p":U then
                      ASSIGN l-import = YES.
                  assign level = level + 1.
              end.
            
        end.

        if  (not l-import and
            not can-find(unid-feder 
                            where unid-feder.pais  = emitente.pais
                              and unid-feder.estado = RowObject.uf )) or 
             (l-import and 
             not can-find(unid-feder 
                            where unid-feder.pais  = bf-estabelec.pais
                              and unid-feder.estado = RowObject.uf )) then do:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-unidade-de-federacao AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Unidade_de_Federaá∆o" *}
            ASSIGN c-lbl-liter-unidade-de-federacao = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                                &ErrorNumber="2"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U 
                                &ErrorParameters="c-lbl-liter-unidade-de-federacao"}
        end.
        
        &IF '{&mguni_version}' < '2.07' &THEN
        /* Validaá∆o do c¢digo de serviáo */ 
        IF param-global.modulo-tf AND CONNECTED('mgscm') THEN
        DO:
            if not valid-handle(h-bosc014) or
               h-bosc014:type      <> "PROCEDURE":U or
               h-bosc014:file-name <> "scbo/bosc014.p":U then
              run scbo/bosc014.p persistent set h-bosc014.
            RUN openQueryStatic IN h-bosc014(INPUT "Default").
            RUN goToKey IN h-bosc014(INPUT RowObject.cod-estabel).
            IF RETURN-VALUE = 'OK':U THEN
            DO:
                ASSIGN l-log-frete = NO.
                RUN getLogField IN h-bosc014(INPUT "log-frete-compra",
                                             OUTPUT l-log-frete).
                IF l-log-frete THEN
                DO:
                    if not valid-handle(h-bosc019) or
                       h-bosc019:type      <> "PROCEDURE":U or
                       h-bosc019:file-name <> "scbo/bosc019.p":U then
                       run scbo/bosc019.p persistent set h-bosc019.

                    RUN openQueryStatic IN h-bosc019(INPUT "Default":U).
                    &IF '{&bf_dis_versao_ems}' >= '2.05' &THEN
                        RUN goToKey IN h-bosc019(INPUT RowObject.cod-servico).
                    &ELSE
                        RUN goToKey IN h-bosc019(INPUT INT(SUBSTRING(RowObject.char-2,90,5))).
                    &ENDIF
                    IF RETURN-VALUE <> 'OK' THEN
                    DO:
                        {utp/ut-liter.i C¢digo_Serviáo * L}
                        {method/svc/errors/inserr.i
                                            &ErrorNumber="3549"
                                            &ErrorType="EMS"
                                            &ErrorSubType="ERROR"
                                            &ErrorParameters="return-value"}
                        RETURN "NOK".
                    END.
                END.
            END. 
        END.
        &ENDIF
        /* Valida Cod Entrega */
        &if '{&bf_dis_versao_ems}' >= '2.062' &then
        
          if  ptype =  "UPDATE":U then do:
            if rowObject.cod-entrega <> "" and avail emitente and
               not can-find(first loc-entr where
                                  loc-entr.nome-abrev  = emitente.nome-abrev    and
                                  loc-entr.cod-entrega = rowObject.cod-entrega) then do:
        
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-local-de-entrega AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Local_de_Entrega" *}
                    ASSIGN c-lbl-liter-local-de-entrega = TRIM(RETURN-VALUE).
                    {method/svc/errors/inserr.i
                                &ErrorNumber="2"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U 
                                &ErrorParameters="c-lbl-liter-local-de-entrega"}
            end.
            if rowObject.endereco = "" then do:
               /* Inicio -- Projeto Internacional */
               DEFINE VARIABLE c-lbl-liter-endereco AS CHARACTER NO-UNDO.
               {utp/ut-liter.i "Endereco" *}
               ASSIGN c-lbl-liter-endereco = TRIM(RETURN-VALUE).
               {method/svc/errors/inserr.i
                                &ErrorNumber="54"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U 
                                &ErrorParameters="c-lbl-liter-endereco"}
            end.
            /* FO 1610.994 - A validaá∆o abaixo foi comentada pois estava obrigando ao usu†rio informar 
               um valor no campo bairro. Entretanto, o campo Ç apenas documentacional, e n∆o Ç obrigat¢rio
               nem mesmo no cadastro de fornecedores (CD0401)
            
            if rowObject.bairro = "" 
            and emitente.natureza < 3  /*Pessoa F°sica ou Pessoa Jur°dica*/
            and i-pais-impto-usuario = 1 /*Brasil*/ then do:
                {method/svc/errors/inserr.i
                                &ErrorNumber="54"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U 
                                &ErrorParameters="'Bairro'"}
            end.  */
            
            if rowObject.cep = "" 
            and emitente.natureza < 3  /*Pessoa F°sica ou Pessoa Jur°dica*/
            and i-pais-impto-usuario = 1 /*Brasil*/ then do:
               /* Inicio -- Projeto Internacional */
               DEFINE VARIABLE c-lbl-liter-cep AS CHARACTER NO-UNDO.
               {utp/ut-liter.i "CEP" *}
               ASSIGN c-lbl-liter-cep = TRIM(RETURN-VALUE).
               {method/svc/errors/inserr.i
                                &ErrorNumber="54"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U 
                                &ErrorParameters="c-lbl-liter-cep"}
            end.
            if not can-find(first pais where
                                  pais.nome-pais = rowObject.pais)   then do:
        
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-pais AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Pa°s" *}
                    ASSIGN c-lbl-liter-pais = TRIM(RETURN-VALUE).
                    {method/svc/errors/inserr.i
                                &ErrorNumber="2"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U 
                                &ErrorParameters="c-lbl-liter-pais"}
            end.
          END.  
        &endif

        if  ptype =  "UPDATE":U then do:

            IF  l-spp-NT2024002 THEN
                RUN ValidaFatoGerador.

             run validateValues.

             FIND docum-est WHERE
                  docum-est.serie-docto  = rowObject.serie-docto  AND
                  docum-est.nro-docto    = rowObject.nro-docto    AND
                  docum-est.cod-emitente = rowObject.cod-emitente AND
                  docum-est.nat-operacao = rowObject.nat-operacao NO-LOCK NO-ERROR.
                    
             IF AVAIL docum-est and
                      docum-est.log-1 /*NF atualizada no Faturamento*/ then do:
                {method/svc/errors/inserr.i
                          &ErrorNumber="30845" /* Nota fiscal j† atualizada no Faturamento. */
                          &ErrorType="EMS":U
                          &ErrorSubType="WARNING":U}
             end.
             
             &if "{&bf_mat_versao_ems}":U >= "2.06":U &then
                if can-find(first dupli-apagar
                            where dupli-apagar.cod-emitente = rowObject.cod-emitente
                              and dupli-apagar.nat-operacao = rowObject.nat-operacao
                              and dupli-apagar.nro-docto    = rowObject.nro-docto   
                              and dupli-apagar.serie-docto  = rowObject.serie-docto
                              and (dupli-apagar.dt-emissao <> rowObject.dt-emissao
                               or dupli-apagar.dt-trans    <> rowObject.dt-trans)) then
                        {method/svc/errors/inserr.i
                          &ErrorNumber="33988" /* Data do documento difere da data da duplicata. */
                          &ErrorType="EMS":U
                          &ErrorSubType="WARNING":U}
            &endif.   
        end.

        /*******contrato leasing******/
        run ValidaLeasing.
        /*****************************/
        
        if  (RowObject.tipo-dfe-docto = rep.list.TipoDfeDoctoList:NFSeNacional
             or RowObject.tipo-dfe-docto = rep.list.TipoDfeDoctoList:NFSeLocacao)
        and avail natur-oper
        and natur-oper.log-nfse-nacional = false then do:
        
            {utp/ut-liter.i "Tipo_NFS-e" * r}
            assign c-texto-1 = trim(return-value).
            {utp/ut-liter.i "Para_informar_NFSe_Nacional_ou_NFSe_Locaá∆o_no_campo_tipo_NFS-e,_a_natureza_de_operaá∆o_deve_estar_marcada_como_NFS-e_Nacional" * r}
            {method/svc/errors/inserr.i &ErrorNumber="34626"
                                        &ErrorType="EMS":U
                                        &ErrorSubType="ERROR":U
                                        &ErrorParameters="c-texto-1 + '~~~~' + trim(return-value)"}
            
        
        
        end.

        if  (RowObject.tipo-dfe-docto = rep.list.TipoDfeDoctoList:NFSeMunicipal
             or RowObject.tipo-dfe-docto = rep.list.TipoDfeDoctoList:NFSeVia)
        and avail natur-oper
        and natur-oper.log-nfse-nacional = true then do:

            {utp/ut-liter.i "Tipo_NFS-e" * r}
            assign c-texto-1 = trim(return-value).
            {utp/ut-liter.i "Para_informar_NFSe_Municipal_ou_NFSe_Via_no_campo_tipo_NFS-e,_a_natureza_de_operaá∆o_n∆o_pode_estar_marcada_como_NFS-e_Nacional" * r}
            {method/svc/errors/inserr.i &ErrorNumber="34626"
                                        &ErrorType="EMS":U
                                        &ErrorSubType="ERROR":U
                                        &ErrorParameters="c-texto-1 + '~~~~' + trim(return-value)"}

        end.
        
        if  RowObject.esp-docto = 21             /* NFE */
        and avail natur-oper
        and natur-oper.tipo-compra = 2 then      /* Frete */
            assign RowObject.cod-ibge = RowObject.mod-frete + 4.
        /**************** EPC utilizada pela Grendene****************/
        {method/svc/custom/custom.i &Event = "validateRecord"}        
        /************************************************************/        
    END.    
    ELSE DO:  /* PTYPE = "DELETE" */
    
        FIND docum-est where 
             rowid(docum-est) = rowObject.r-rowid no-lock no-error.
        IF AVAIL docum-est then do:
             if docum-est.ce-atual /*NF atualizada no            Estoque*/ then do:
                 {method/svc/errors/inserr.i
                  &ErrorNumber="7183"
                  &ErrorType="EMS":U
                  &ErrorSubType="ERROR":U}
             end.
             if docum-est.log-1 /*NF atualizada no            Faturamento*/ then do:
                 {method/svc/errors/inserr.i
                  &ErrorNumber="15950"
                  &ErrorType="EMS":U
                  &ErrorSubType="ERROR":U}                                
             end.
        end. 


        /* EPC GRENDENE PARA VALIDAR SE EXISTE T÷TULO */
        {method/svc/custom/custom.i &Event = "validateRecordDel"}

        
         for first b-rat-docum
            fields ( nf-emitente nf-nat-oper nf-serie nf-nro )
             where b-rat-docum.nf-emitente = RowObject.cod-emitente
               and b-rat-docum.nf-nat-oper = RowObject.nat-operacao
               and b-rat-docum.nf-serie    = RowObject.serie-docto
               and b-rat-docum.nf-nro      = RowObject.nro-docto no-lock: end.
        if avail b-rat-docum then do:
            {method/svc/errors/inserr.i
                                &ErrorNumber="18401"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U}
        end.
    
        /** Importacao - Validacao no item do documento **/
        if  (not can-find(funcao where funcao.cd-funcao = "spp-drb-sld-terc":U and funcao.ativo))
        and param-global.modulo-07
        and param-global.modulo-ex
        &if "{&bf_dis_versao_ems}":U >= "2.06":U &then                                             
            and natur-oper.log-natur-operac-draw                                                       
            and param-global.log-modul-draw  /*Modulo Drawback*/
        &else                                                                                      
            and substring(natur-oper.char-1,94,1) = "1":U
            and substring(param-global.char-2,22,1) = "1" /*Modulo Drawback*/
        &endif
        and emitente.natureza > 2
        and emitente.pais <> estabelec.pais
        and substr(RowObject.char-1,90,1) = "1":U 
        and connected ("mgcex":U) then do:

            if  not valid-handle (h-bocx332) then 
                run cxbo/bocx332.p persistent set h-bocx332.

            for each item-doc-est
                where item-doc-est.serie-docto         = rowObject.serie-docto  
                and   item-doc-est.nro-docto           = rowObject.nro-docto    
                and   item-doc-est.cod-emitente        = rowObject.cod-emitente 
                and   item-doc-est.nat-operacao        = rowObject.nat-operacao
                and   item-doc-est.nr-ato-concessorio <> "":U no-lock:
                
                /** Apenas valida, nao efetiva eliminacao dos movimentos **/
                run eliminaMovtos in h-bocx332 (input rowid(item-doc-est),
                                                input no, /** Nao Elimina Movtos **/
                                                input no,  
                                                output table RowErrors append).
            end.

            if  valid-handle (h-bocx332) then do:
                delete procedure h-bocx332.
                assign h-bocx332 = ?.
            end.

        end.

    END.
    
    /*=========== UAA-CENTRAL ============================*/
    IF  c-nom-prog-dpc-mg97  <> ""
    OR  c-nom-prog-appc-mg97 <> ""
    OR  c-nom-prog-upc-mg97  <> "" THEN DO:
        FOR EACH tt-epc
           WHERE tt-epc.cod-event = "fimValidateRecord":U:
           DELETE tt-epc.
        END.

        CREATE tt-epc.
        ASSIGN tt-epc.cod-event     = "fimValidateRecord":U
               tt-epc.cod-parameter = "TipoValid":U
               tt-epc.val-parameter = cType.

        CREATE tt-epc.
        ASSIGN tt-epc.cod-event     = "fimValidateRecord":U
               tt-epc.cod-parameter = "NaturOper":U
               tt-epc.val-parameter = RowObject.nat-operacao.

        CREATE tt-epc.
        ASSIGN tt-epc.cod-event     = "fimValidateRecord":U
               tt-epc.cod-parameter = "CodObserva":U
               tt-epc.val-parameter = STRING(RowObject.cod-observa).

        {include/i-epc201.i fimValidateRecord}

        FIND FIRST tt-epc NO-LOCK
             WHERE tt-epc.cod-event      = "fimValidateRecord":U
               AND tt-epc.cod-parameter  = "retornaValida":U
               AND tt-epc.val-parameter <> "" NO-ERROR.
        IF  AVAIL tt-epc THEN DO:
            RUN _insertErrorManual (INPUT "17006",
                                    INPUT "EMS":U,
                                    INPUT "ERROR":U,
                                    INPUT tt-epc.val-parameter,
                                    INPUT tt-epc.val-parameter,
                                    INPUT "":U).
        END.
   END.
   /*====================================================*/
   
    /***** Atualiza os valores *****/
    run determineValueValid.    
    
    /*--- Verifica ocorr™ncia de erros ---*/
    
   DO  i-cont-progs = 2 TO 10:
       IF  PROGRAM-NAME(i-cont-progs) MATCHES "*reapi316*" THEN DO:
           ASSIGN l-exec-reapi316 = YES.
           LEAVE.
       END.
   END.
   
   
   
   IF l-exec-reapi316 THEN DO:
       IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U 
                     AND NOT (RowErrors.ErrorType = "INTERNAL":U 
                           AND   (RowErrors.ErrorNumber = 8  OR
                                  RowErrors.ErrorNumber = 10 OR
                                  RowErrors.ErrorNumber = 3
                                  )
                              )) THEN DO:
           RETURN "NOK":U.
       END.
   END.
   ELSE DO:
       IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
           RETURN "NOK":U.
   END.
   RETURN "OK":U.

END PROCEDURE.

PROCEDURE verificaNaturUF :
    DEF INPUT PARAMETER piCodEstabel  LIKE estabelec.cod-estabel   NO-UNDO.
    DEF INPUT PARAMETER piNatOperacao LIKE natur-oper.nat-operacao NO-UNDO.
    DEF INPUT PARAMETER lMostraErro   AS LOGICAL                   NO-UNDO.

    RUN cdp/cd8704.p (INPUT piNatOperacao,
                      INPUT piCodEstabel,
                      INPUT-OUTPUT l-erro-nat).

    IF l-erro-nat THEN DO:
        IF lMostraErro THEN DO:
            {method/svc/errors/inserr.i 
                &ErrorNumber="27868"
                &ErrorType="EMS"
                &ErrorSubType="Error"
                &ErrorParameters="''"}
        END.
        RETURN "NOK":U.
    END.

    RETURN "OK":U.        
END PROCEDURE.

PROCEDURE alertaMesmaChaveAcesso:

    def var c-nfs-mesma-chave as char  no-undo.
    
    IF RowObject.cod-chave-aces-nf-eletro <> "" AND 
       RowObject.cod-chave-aces-nf-eletro <> ? THEN DO: /* Soh valida quando foi informada chave acesso */
        FOR EACH b-docum-est FIELDS (cod-emitente serie-docto nro-docto nat-operacao dt-emissao dt-trans) NO-LOCK
           WHERE b-docum-est.cod-chave-aces-nf-eletro = RowObject.cod-chave-aces-nf-eletro:
            IF  b-docum-est.cod-emitente <> RowObject.cod-emitente
             OR b-docum-est.serie-docto  <> RowObject.serie-docto
             OR b-docum-est.nro-docto    <> RowObject.nro-docto
             OR b-docum-est.nat-operacao <> RowObject.nat-operacao THEN
                ASSIGN c-nfs-mesma-chave = c-nfs-mesma-chave + chr(10) + 
                                           "Docto: " + b-docum-est.nro-docto + 
                                           "  Serie: " + b-docum-est.serie-docto + 
                                           "  Emitente: " + string(b-docum-est.cod-emitente) +
                                           "  Natur: " + b-docum-est.nat-operacao + 
                                           "  DtEmis: " + string(b-docum-est.dt-emissao) +
                                           "  DtTrans: " + STRING(b-docum-est.dt-trans).
        END.
        
        IF NOT CAN-FIND(FIRST funcao WHERE funcao.cd-funcao = "spp-nao-valida-chave-duplic":U AND funcao.ativo = YES) THEN DO: 
            if avail natur-oper and natur-oper.tipo-compra <> 4 and c-nfs-mesma-chave <> "" then do:  /*Nao validar quando for nota de material agregado*/
                {method/svc/errors/inserr.i
                    &ErrorNumber="56394" /*Chave de acesso ja informada em outro(s) documento(s)!*/
                    &ErrorType="EMS":U
                    &ErrorSubType="WARNING":U
                    &ErrorParameters="RowObject.cod-chave-aces-nf-eletro + '~~~~' + c-nfs-mesma-chave"}
                   
                if not valid-handle (h_boin060) then
                    run inbo/boin060.p persistent set h_boin060.
           
                run updateConsistNota in h_boin060 (RowObject.cod-emitente,
                                                    RowObject.serie-docto,
                                                    RowObject.nro-docto,
                                                    RowObject.nat-operacao,
                                                    0,
                                                    no, 
                                                    0,
                                                    0,
                                                    56394,
                                                    2).
                if valid-handle (h_boin060) then do:
                    delete procedure h_boin060.
                    assign h_boin060 = ?.
                end.
            end.
        end.
    END.

END PROCEDURE.
PROCEDURE ValidaFatoGerador:

    find first ext-docum-est no-lock
         where ext-docum-est.serie-docto  = RowObject.serie-docto
           and ext-docum-est.nro-docto    = RowObject.nro-docto
           and ext-docum-est.cod-emitente = RowObject.cod-emitente
           and ext-docum-est.nat-operacao = RowObject.nat-operacao
           and ext-docum-est.cod-param    = "fatogeradorCBS-IBS":U no-error.
    if avail ext-docum-est then do:
        if  c-pais-fato-gerador = "" then
            assign c-pais-fato-gerador  = substring(ext-docum-est.cod-livre-3,1,20).
        if  c-uf-fato-gerador = "" then  
            assign c-uf-fato-gerador = substring(ext-docum-est.cod-livre-2,1,4).
        if  c-cidade-fato-gerador = "" then     
            assign c-cidade-fato-gerador =  substring(ext-docum-est.cod-livre-1,1,50). 
    end.
    
    if  c-pais-fato-gerador = "" then do:
        {utp/ut-liter.i "Pa°s_Fato_Gerador" *}
        {method/svc/errors/inserr.i &ErrorNumber="17386"
                                    &ErrorType="EMS":U
                                    &ErrorSubType="ERROR":U
                                    &ErrorParameters=TRIM(RETURN-VALUE)}
    end.
    else do:
        if  not can-find(first pais no-lock
                         where pais.nome-pais = c-pais-fato-gerador) then do:
            {utp/ut-liter.i "Pa°s_Fato_Gerador" *}
            {method/svc/errors/inserr.i
                        &ErrorNumber="2"
                        &ErrorType="EMS":U
                        &ErrorSubType="ERROR":U
                        &ErrorParameters=TRIM(RETURN-VALUE)}
        end.
    end.
    if  c-uf-fato-gerador = "" then do:
        {utp/ut-liter.i "Unidade_de_Federaá∆o_Fato_Gerador" *}
        {method/svc/errors/inserr.i &ErrorNumber="17386"
                                    &ErrorType="EMS":U
                                    &ErrorSubType="ERROR":U
                                    &ErrorParameters=TRIM(RETURN-VALUE)}
    end.
    else do:
        if  not can-find(first unid-feder no-lock
                         where unid-feder.pais   = c-pais-fato-gerador
                         and   unid-feder.estado = c-uf-fato-gerador) then do:
            {utp/ut-liter.i "Unidade_de_Federaá∆o_Fato_Gerador" *}
            {method/svc/errors/inserr.i &ErrorNumber="2"
                                        &ErrorType="EMS":U
                                        &ErrorSubType="ERROR":U
                                        &ErrorParameters=TRIM(RETURN-VALUE)}
        end.
    end.
    if  c-cidade-fato-gerador = "" then do:
        {utp/ut-liter.i "Cidade_Fato_Gerador" *}
        {method/svc/errors/inserr.i &ErrorNumber="17386"
                                    &ErrorType="EMS":U
                                    &ErrorSubType="ERROR":U
                                    &ErrorParameters=TRIM(RETURN-VALUE)}
    end.
    else do:
        if  not can-find(first cidade no-lock
                         where cidade.cidade = c-cidade-fato-gerador
                         and   cidade.estado = c-uf-fato-gerador
                         and   cidade.pais   = c-pais-fato-gerador) then do:
            {utp/ut-liter.i "Cidade_Fato_Gerador" *}
            {method/svc/errors/inserr.i &ErrorNumber="2"
                                        &ErrorType="EMS":U
                                        &ErrorSubType="ERROR":U
                                        &ErrorParameters=TRIM(RETURN-VALUE)}
        end.
    end.
    RETURN "OK":U.
END PROCEDURE.
PROCEDURE ValidaLeasing:
        DEF VAR    c-cnpj-arrendador AS CHAR    NO-UNDO.
        def var     h-api-leasing    as handle  no-undo.
        
        
        IF  AVAIL param-re
        AND SUBSTRING(param-re.char-1,27,1) = 'S' then do:
            EMPTY TEMP-TABLE tt_log_erros.
            
            if  c-arrendador       = ""
            and c-contrato-leasing = "" THEN DO:
                run DeletettExtDocumEst(INPUT "contrato-leasing":U).
            end.
            else do:
        
                if (   c-arrendador       <> ""
                    or c-contrato-leasing <> "") THEN DO:
                
                    run findEmitente (input rowObject.cod-emitente).
                    
                    run getDescriptionFields ( input "CGC":U,
                                               output c-cnpj-arrendador ).
                    
                    IF NOT VALID-HANDLE(h-api-leasing) THEN
                       RUN prgfin/fas/fas920za.py PERSISTENT SET h-api-leasing.
                                               
                    IF VALID-HANDLE(h-api-leasing) THEN DO:
                       
                    
                       RUN pi_valida_contrat_leas_api IN h-api-leasing (INPUT c-arrendador, /*arrendador*/
                                                                        INPUT c-contrato-leasing, /*Contrato leasing*/
                                                                        INPUT rowObject.dt-emissao,
                                                                        INPUT c-cnpj-arrendador,
                                                                        OUTPUT TABLE tt_log_erros).
                       if can-find (first tt_log_erros) then do:
                          assign  c-arrendador       = ""
                                  c-contrato-leasing = "".
                          
                          for each tt_log_erros:
                              {method/svc/errors/inserr.i
                                           &ErrorNumber="17006"
                                           &ErrorType="EMS":U
                                           &ErrorSubType="ERROR":U 
                                           &ErrorParameters="tt_log_erros.ttv_des_erro +  '('  + STRING(tt_log_erros.ttv_num_cod_erro) + ')' + '~~~~' + tt_log_erros.ttv_des_ajuda"}
                          END.
                       end.   
                       delete procedure h-api-leasing.
                       assign h-api-leasing = ?.
                    END.
                end.     
            end.        
        END.
END PROCEDURE.
PROCEDURE ValidaDepFechado:

    def buffer bf-estabelec-dep        for estabelec.  

   IF  avail natur-oper 
        AND natur-oper.terceiros
        AND natur-oper.tp-oper-terc = 8  THEN DO: /* Rem Deposito Fechado*/       
        
       for first bf-estabelec-dep
          where bf-estabelec-dep.cod-emitente = RowObject.cod-emitente no-lock:  /*Procura pelo estabelecimento do emitente da nota Fabrica*/
       end.

       IF NOT CAN-FIND (FIRST saldo-terc  
                        WHERE saldo-terc.serie-docto   = RowObject.serie-docto
                          AND saldo-terc.nro-docto     = RowObject.nro-docto
                          AND saldo-terc.cod-emitente  = estabelec.cod-emitente
                          AND saldo-terc.cod-estabel   = bf-estabelec-dep.cod-estabel
                          AND saldo-terc.tipo-sal-terc = 7 )THEN DO:  /*Sa°da Dep Fechado*/
                                 
          {method/svc/errors/inserr.i
                             &ErrorNumber="56824" /*Nota Fiscal de Remessa de Dep¢sito Fechado deve possuir o mesmo n£mero de documento, emitente e sÇrie da operaá∆o de remessa sa°da*/
                             &ErrorType="EMS":U
                             &ErrorSubType="WARNING":U
                             &ErrorParameters="''"}
          
           if not valid-handle (h_boin060) then
                run inbo/boin060.p persistent set h_boin060.
       
           run updateConsistNota in h_boin060 (RowObject.cod-emitente,
                                               RowObject.serie-docto,
                                               RowObject.nro-docto,
                                               RowObject.nat-operacao,
                                               0,
                                               no, 
                                               0,
                                               0,
                                               56824,
                                               2). /*Advertància*/
                                               
           if valid-handle (h_boin060) then do:
               delete procedure h_boin060.
               assign h_boin060 = ?.                  
           END. /*if valid-handle*/                                                              
       END. /*IF NOT CAN-FIND*/   
   END. /*IF  avail natur-oper*/
   
   RETURN "OK":U.       
         
END PROCEDURE.

PROCEDURE bloqueiaNfeComDiverg:
        
    DEF VAR h-boin01109  AS HANDLE NO-UNDO.
    
    IF NOT VALID-HANDLE(h-boin01109) THEN 
        run inbo/boin01109.p persistent set h-boin01109.
        
    RUN emptyRowErrors  IN h-boin01109.
        
    IF  RowObject.cod-chave-aces-nf-eletro <> "" 
    AND RowObject.cod-chave-aces-nf-eletro <> ? THEN /* Soh valida quando foi informada chave acesso */
        RUN bloqueiaEntradaNfeComDivergencia IN h-boin01109 (INPUT RowObject.cod-chave-aces-nf-eletro).
    ELSE
        RUN bloqueiaEntNfeComDivergChaveDocto IN h-boin01109 (INPUT RowObject.cod-emitente,
                                                              INPUT RowObject.cod-estabel,
                                                              INPUT RowObject.serie-docto, 
                                                              INPUT RowObject.nro-docto,
                                                              INPUT RowObject.dt-emissao).
    
    RUN getRowErrors    IN h-boin01109 (OUTPUT TABLE RowErrors APPEND).
       
    RETURN "OK":U.       
    FINALLY:
        DELETE PROCEDURE h-boin01109 NO-ERROR.
        ASSIGN h-boin01109 = ?.
    END FINALLY.
END PROCEDURE.

PROCEDURE bloqueiaDigitXML:
    DEFINE VARIABLE c-chave-aux     AS CHARACTER    NO-UNDO.
    DEFINE VARIABLE l-erro-aux      AS LOGICAL      NO-UNDO.
    
    IF CAN-FIND (FIRST param-estoq NO-LOCK
                 WHERE param-estoq.bloq-digit-xml) THEN DO:
                 
        IF  RowObject.cod-chave-aces-nf-eletro  <> ""
        AND RowObject.cod-chave-aces-nf-eletro  <> ?    THEN DO:
        
            IF CAN-FIND (FIRST doc-orig-nfe NO-LOCK
                         WHERE doc-orig-nfe.ch-acesso-comp-nfe = RowObject.cod-chave-aces-nf-eletro) THEN DO:
                ASSIGN l-erro-aux   = YES
                       c-chave-aux  = RowObject.cod-chave-aces-nf-eletro.                
            END.
            ELSE DO:
                IF CAN-FIND (FIRST doc-orig-nfe NO-LOCK
                             WHERE doc-orig-nfe.cod-emitente    = RowObject.cod-emitente
                               AND doc-orig-nfe.cod-estabel     = RowObject.cod-estabel
                               AND doc-orig-nfe.serie-docto     = RowObject.serie-docto
                               AND doc-orig-nfe.nro-docto       = RowObject.nro-docto
                               AND doc-orig-nfe.dt-emissao      = RowObject.dt-emissao) THEN DO:
                    ASSIGN l-erro-aux   = YES
                           c-chave-aux  = RowObject.cod-chave-aces-nf-eletro.                    
                END.
            END.
            
            IF NOT l-erro-aux THEN DO:
                IF CAN-FIND (FIRST docto-orig-cte NO-LOCK
                             WHERE docto-orig-cte.cod-aces-comp-nfe = RowObject.cod-chave-aces-nf-eletro) THEN DO:
                    ASSIGN l-erro-aux   = YES
                           c-chave-aux  = RowObject.cod-chave-aces-nf-eletro.                    
                END.
                ELSE DO:
                    IF CAN-FIND (FIRST docto-orig-cte NO-LOCK
                                 WHERE docto-orig-cte.cod-emitente  = RowObject.cod-emitente
                                   AND docto-orig-cte.cod-estabel   = RowObject.cod-estabel
                                   AND docto-orig-cte.serie-docto   = RowObject.serie-docto
                                   AND docto-orig-cte.nro-docto     = RowObject.nro-docto
                                   AND docto-orig-cte.dt-emissao    = RowObject.dt-emissao) THEN DO:
                        ASSIGN l-erro-aux   = YES
                               c-chave-aux  = RowObject.cod-chave-aces-nf-eletro.                    
                    END.
                END.
            END.
        END.
        
        IF l-erro-aux THEN DO:
            {method/svc/errors/inserr.i &ErrorNumber="57657"
                                        &ErrorType="EMS":U
                                        &ErrorSubType="ERROR":U
                                        &ErrorParameters="c-chave-aux"}            
        END.
        
    END.             
    
    RETURN "OK":U.
END PROCEDURE.
