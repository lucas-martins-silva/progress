PROCEDURE calculateTotalItem :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:   Executado apartir da procedure TransferTotalItensNota, com o objetivo 
           de totalizar os itens na temp-table tt-total-item, para que seja 
           enviado para boin090 atualizar no docum-est os totais.
------------------------------------------------------------------------------*/

    def input param pi-cod-emitente like docum-est.cod-emitente no-undo.
    def input param pi-serie-docto  like docum-est.serie-docto  no-undo.
    def input param pi-nro-docto    like docum-est.nro-docto    no-undo.
    def input param pi-nat-operacao like docum-est.nat-operacao no-undo.
    def output param table for tt-total-item.
    
    def buffer bf-docum-est    for docum-est.
    def var de-base-icm-it      as decimal  no-undo.
    def var de-base-icm-complem as decimal  no-undo.
    def var de-fundo-pobreza    as decimal  no-undo.
    def var de-base-ipi-it      as decimal  no-undo.
    def var de-base-iss         as decimal  no-undo.
    def var de-ipi-outras       as decimal  no-undo.
    def var de-val-pis          as decimal  no-undo.
    def var de-val-cofins       as decimal  no-undo.
    def var de-tot-desp-adic    as decimal  no-undo.
    def var de-tot-icms-diferim as decimal  no-undo.
    def var de-val-pedagio      as decimal  no-undo.
    def var de-vl-icm-trib      as decimal  no-undo.
    def var de-peso-bruto-tot   as decimal  no-undo.
    DEF VAR de-tot-valor-item   LIKE docum-est.tot-valor NO-UNDO.
    DEF VAR de-tot-valor-sum-aux LIKE docum-est.tot-valor NO-UNDO.
    def var de-valor-desc-icms   as dec      no-undo.
    def var de-tot-val-desc-icms as dec      no-undo.
    

    for each bf-item-doc-est 
        fields ( peso-liquido       desconto[1]     despesas[1] 
                 preco-total[1]     icm-complem[1]  quantidade
                 icm-outras[1]      ipi-outras[1]   iss-outras[1]
                 cd-trib-icm        base-icm[1]     valor-icm[1]
                 cd-trib-ipi        base-ipi[1]     valor-ipi[1]
                 cd-trib-iss        base-iss[1]     valor-iss[1]
                 base-subs[1]       vl-subs[1]      aliquota-ipi char-2
                 vl-pis-subs        vl-cofins-subs  pr-total-cmi
                 valor-pis          val-cofins      seq-comp
                 serie-comp         nro-comp        it-codigo 
                 nat-of             preco-total-me  cod-emitente
                 serie-docto        nro-docto       nat-operacao
                 sequencia)
       where bf-item-doc-est.cod-emitente = pi-cod-emitente
         and bf-item-doc-est.serie-docto  = pi-serie-docto
         and bf-item-doc-est.nro-docto    = pi-nro-docto 
         and bf-item-doc-est.nat-operacao = pi-nat-operacao 
       no-lock:
       
        
        accum bf-item-doc-est.peso-liquido       (total).
        accum bf-item-doc-est.desconto[1]        (total).
        accum bf-item-doc-est.despesas[1]        (total).
        accum bf-item-doc-est.preco-total[1]     (total).
        accum bf-item-doc-est.valor-ipi[1]       (total).
        accum bf-item-doc-est.valor-icm[1]       (total).
        accum bf-item-doc-est.icm-complem[1]     (total).
        accum bf-item-doc-est.base-subs[1]       (total).
        accum bf-item-doc-est.vl-subs[1]         (total).
        accum bf-item-doc-est.valor-iss[1]       (total).
        accum bf-item-doc-est.vl-pis-subs        (total).
        accum bf-item-doc-est.vl-cofins-subs     (total).
        accum bf-item-doc-est.pr-total-cmi       (total).
        accum bf-item-doc-est.preco-total-me     (total).

        
        assign de-base-icm-it  =   de-base-icm-it 
                               +  (bf-item-doc-est.base-icm[1] 
                               *  int(((bf-item-doc-est.cd-trib-icm = 1 /*T*/)   or
                                       (bf-item-doc-est.cd-trib-icm = 4 /*R*/)   or
                                       (bf-item-doc-est.cd-trib-icm = 5 /*D*/)))   
                                                 /**** int(can-do(1,4,9 /*"T,R,D"*/, item-doc-est.cd-trib-icm)) ***/
                               +  (bf-item-doc-est.icm-outras[1]
                               *  int(bf-item-doc-est.cd-trib-icm = 3 /*"O"*/)))
 

               de-base-ipi-it  =  de-base-ipi-it
                               +  (bf-item-doc-est.base-ipi[1] 
                               *  int(((bf-item-doc-est.cd-trib-ipi = 1 /*T*/)   or
                                       (bf-item-doc-est.cd-trib-ipi = 4 /*R*/)))
                                  /**** int(can-do("T,R", item-doc-est.cd-trib-ipi)))****/
                               +  (bf-item-doc-est.ipi-outras[1]
                               *  int(   bf-item-doc-est.cd-trib-ipi = 3 /*O*/
                                      or (    bf-item-doc-est.cd-trib-ipi = 1 /*T*/      
                                          and bf-item-doc-est.aliquota-ipi = 0 ) )))
 

               de-base-iss  =  de-base-iss
                            +  bf-item-doc-est.base-iss[1]
                            *  int(((bf-item-doc-est.cd-trib-iss = 1 /*T*/)   or
                                    (bf-item-doc-est.cd-trib-iss = 4 /*R*/)))
                               /**** int(can-do("T,R", item-doc-est.cd-trib-iss))****/
                            +  bf-item-doc-est.iss-outras[1]
                            *  int(bf-item-doc-est.cd-trib-iss = 3 /*"O"*/)
 

               de-ipi-outras =  de-ipi-outras
                             +  bf-item-doc-est.valor-ipi[1]
                             *  int(bf-item-doc-est.cd-trib-ipi = 3 /*"O"*/)
                             
               de-val-pis    = de-val-pis    + bf-item-doc-est.valor-pis
               de-val-cofins = de-val-cofins + bf-item-doc-est.val-cofins.
                
        assign de-tot-icms-diferim = de-tot-icms-diferim + decimal(substring(bf-item-doc-est.char-2,802,17)).
             
        assign de-val-pedagio = de-val-pedagio + dec(SUBSTR(bf-item-doc-est.char-2,819,13)). 
               
        assign de-vl-icm-trib = de-vl-icm-trib 
                                + (bf-item-doc-est.valor-icm[1] 
                                * int(((bf-item-doc-est.cd-trib-icm = 1 /*T*/) or
                                       (bf-item-doc-est.cd-trib-icm = 4 /*R*/) or
                                       (bf-item-doc-est.cd-trib-icm = 5 /*D*/))))
                                       
               de-base-icm-complem = de-base-icm-complem 
                                     + (decimal(substring(bf-item-doc-est.char-2,860,20))
                                     /** int(((bf-item-doc-est.cd-trib-icm = 1 /*T*/) or
                                            (bf-item-doc-est.cd-trib-icm = 3 /*O*/) or
                                            (bf-item-doc-est.cd-trib-icm = 4 /*R*/) or
                                            (bf-item-doc-est.cd-trib-icm = 5 /*D*/)))*/ )
                       
               de-fundo-pobreza = de-fundo-pobreza
                                  + (decimal(substring(bf-item-doc-est.char-2,888,20))
                                  * int(((bf-item-doc-est.cd-trib-icm = 1 /*T*/) or
                                         (bf-item-doc-est.cd-trib-icm = 3 /*O*/) or
                                         (bf-item-doc-est.cd-trib-icm = 4 /*R*/) or
                                         (bf-item-doc-est.cd-trib-icm = 5 /*D*/)))).      
            
        find first docum-est no-lock
             where docum-est.cod-emitente = pi-cod-emitente 
               and docum-est.serie-docto  = pi-serie-docto  
               and docum-est.nro-docto    = pi-nro-docto    
               and docum-est.nat-operacao = pi-nat-operacao no-error.
        if avail docum-est then 
           find first it-nota-fisc no-lock
                where it-nota-fisc.cod-estabel  = docum-est.cod-estabel
                  and it-nota-fisc.serie        = bf-item-doc-est.serie-comp   
                  and it-nota-fisc.nr-nota-fis  = bf-item-doc-est.nro-comp
                  and it-nota-fisc.it-codigo    = bf-item-doc-est.it-codigo
                  and it-nota-fisc.nr-seq-fat   = bf-item-doc-est.seq-comp   no-error.
        if avail it-nota-fisc then 
            assign de-peso-bruto-tot = de-peso-bruto-tot +
                                       IF it-nota-fisc.qt-faturada[1] <> 0 THEN  
                                         (bf-item-doc-est.quantidade * (it-nota-fisc.peso-bruto / it-nota-fisc.qt-faturada[1]))
                                       ELSE 0.  
        else do:
            run findItem (bf-item-doc-est.it-codigo).
            if  avail item then 
                assign de-peso-bruto-tot = de-peso-bruto-tot +
                                          (bf-item-doc-est.quantidade * item.peso-bruto).
        end.

        /* Se USA m£ltiplas naturezas no recebimento: */
        /*  calcula o total da nota tamb‚m (com base nos itens e suas naturezas) */
        IF  l-mult-natur-receb AND bf-item-doc-est.nat-of <> "":U THEN DO: /* l-mult-natur-receb -> def em cd9701.i */
            
            FIND FIRST b-natur-oper-item WHERE 
                b-natur-oper-item.nat-operacao = bf-item-doc-est.nat-of NO-LOCK no-error.

            IF  AVAIL b-natur-oper-item THEN
                /* Procedure auxiliar para calcular o valor total da nota */
                RUN calculaTotValorItem(OUTPUT de-tot-valor-sum-aux).

            ASSIGN de-tot-valor-item = de-tot-valor-item + de-tot-valor-sum-aux.

        END.
        
        /***ICMS Desonerado***/
        assign de-valor-desc-icms = 0.
        FOR FIRST ext-item-doc-est NO-LOCK
            WHERE ext-item-doc-est.serie-docto  = bf-item-doc-est.serie-docto 
              AND ext-item-doc-est.nro-docto    = bf-item-doc-est.nro-docto   
              AND ext-item-doc-est.cod-emitente = bf-item-doc-est.cod-emitente
              AND ext-item-doc-est.nat-operacao = bf-item-doc-est.nat-operacao
              AND ext-item-doc-est.sequencia    = bf-item-doc-est.sequencia
              AND ext-item-doc-est.cod-param    = "icms-deson":U
              AND ext-item-doc-est.log-livre-1  = yes: /*aplica como desconto*/
            ASSIGN de-valor-desc-icms = ext-item-doc-est.val-livre-2. /*valor desconto icms*/
        END.
        assign de-tot-val-desc-icms = de-tot-val-desc-icms + de-valor-desc-icms.
        /********************/
            
    END. /* END for each bf-item-doc-est  */
    
    find first tt-total-item exclusive-lock no-error.
    if  avail tt-total-item then
        delete tt-total-item.

    create tt-total-item.
    assign tt-total-item.tot-peso           = accum total bf-item-doc-est.peso-liquido
           tt-total-item.peso-bruto-tot     = de-peso-bruto-tot
           tt-total-item.tot-desconto       = accum total bf-item-doc-est.desconto[1]
           tt-total-item.despesa-nota       = accum total bf-item-doc-est.despesas[1]
           tt-total-item.valor-mercad       = accum total bf-item-doc-est.preco-total[1]
           tt-total-item.valor-mercad       = tt-total-item.valor-mercad - de-tot-val-desc-icms
           tt-total-item.base-ipi           = de-base-ipi-it
           tt-total-item.valor-ipi          = accum total bf-item-doc-est.valor-ipi[1]
           tt-total-item.base-icm           = de-base-icm-it
           tt-total-item.valor-icm          = accum total bf-item-doc-est.valor-icm[1]
           tt-total-item.base-iss           = de-base-iss
           tt-total-item.valor-iss          = accum total bf-item-doc-est.valor-iss[1]
           tt-total-item.base-subs          = accum total bf-item-doc-est.base-subs[1]
           tt-total-item.valor-subs         = accum total bf-item-doc-est.vl-subs[1]
           tt-total-item.base-icm-complem   = de-base-icm-complem
           tt-total-item.icm-complem        = accum total bf-item-doc-est.icm-complem[1]
           tt-total-item.fundo-pobreza      = de-fundo-pobreza
           tt-total-item.ipi-outras         = de-ipi-outras
           tt-total-item.valor-pis          = de-val-pis
           tt-total-item.valor-cofins       = de-val-cofins
           tt-total-item.total-pis-subst    = accum total bf-item-doc-est.vl-pis-subs
           tt-total-item.total-cofins-subs  = accum total bf-item-doc-est.vl-cofins-subs
           tt-total-item.total-icms-diferim = de-tot-icms-diferim
           tt-total-item.valor-frete        = accum total bf-item-doc-est.pr-total-cmi
           tt-total-item.valor-pedagio      = de-val-pedagio
           tt-total-item.valor-icm-trib     = de-vl-icm-trib
           tt-total-item.de-tot-valor-calc  = (de-tot-valor-item - de-tot-val-desc-icms). /* Total da nota com base nos itens e suas naturezas... */

   FOR EACH  item-docto-estoq-nfe-imp NO-LOCK 
        WHERE item-docto-estoq-nfe-imp.cdn-emitente     = pi-cod-emitente
        AND   item-docto-estoq-nfe-imp.cod-docto        = pi-nro-docto        
        AND   item-docto-estoq-nfe-imp.cod-ser-docto    = pi-serie-docto
        AND   item-docto-estoq-nfe-imp.cod-natur-operac = pi-nat-operacao:
        
        ASSIGN  de-tot-desp-adic     = de-tot-desp-adic  + ( item-docto-estoq-nfe-imp.val-impto-import + 
                                                             item-docto-estoq-nfe-imp.val-iof          +
                                                             item-docto-estoq-nfe-imp.val-despesa)
                de-tot-desp-adic     = de-tot-desp-adic  -  item-docto-estoq-nfe-imp.val-desc.
                
               
    END. 
    
    RETURN "OK":U.

END PROCEDURE.


PROCEDURE calculaTotValorItem :
/*------------------------------------------------------------------------------
  Purpose:    Auxiliar no c lculo do total da nota com base nos itens e suas
              naturezas.
  Parameters: <none>
  Notes: 
------------------------------------------------------------------------------*/

    DEF OUTPUT PARAMETER de-tot-valor-aux LIKE docum-est.tot-valor NO-UNDO.
    
    DEF BUFFER b-emitente-aux  FOR emitente.
    DEF BUFFER b-estabelec-aux FOR estabelec.

    DEF VARIABLE l-gera-cred-subs         AS LOGICAL               NO-UNDO.
    DEF VARIABLE l-fornec-fundap          AS LOGICAL INITIAL NO    NO-UNDO.
    DEF VARIABLE h-bocx250                AS HANDLE                NO-UNDO.
    DEF VARIABLE c-return                 AS CHAR                  NO-UNDO. 
    DEF VARIABLE l-inc-icms-tot-nf        AS LOGICAL               NO-UNDO.
    DEF VARIABLE l-pis-cofins-st-total    AS LOGICAL               NO-UNDO.

    {cdp/cd4300.i3}  /* Variaveis para CD4300.I4  */
    {cdp/cd0604.i50} /* Variaveis para CD0604     */

    /* l-ipi-tot-nota */      
    {cdp/cd4300.i4  YES b-natur-oper-item.char-2}
    {cdp/cd0604.i51 YES}
    
    assign l-pis-cofins-st-total = yes.
    if docum-est.cod-observa = 3 then do: /*devolu‡Æo*/
        for first item no-lock
            where item.it-codigo = bf-item-doc-est.it-codigo:
            assign l-pis-cofins-st-total = trim(substring(item.char-1,50,5)) = "Sim":U or 
                                           trim(substring(item.char-1,50,5)) = "":U.
        end.    
    end.
    
    /* Indica se Gera Cr‚dito para Substitui‡Æo Tribut ria */
    IF  NOT b-natur-oper-item.log-icms-substto-antecip THEN DO:
        ASSIGN l-gera-cred-subs = INT(SUBSTR(b-natur-oper-item.char-2,56,5)) = 1.
        
        ASSIGN de-tot-valor-aux = bf-item-doc-est.preco-total[1]
                                + bf-item-doc-est.despesas[1]
                                - bf-item-doc-est.desconto[1]
                                + bf-item-doc-est.vl-subs[1]
                                + (bf-item-doc-est.vl-pis-subs    * int(l-pis-cofins-st-total))
                                + (bf-item-doc-est.vl-cofins-subs * int(l-pis-cofins-st-total)).
                                
        FOR FIRST ext-item-doc-est NO-LOCK
            WHERE ext-item-doc-est.serie-docto  = bf-item-doc-est.serie-docto 
              AND ext-item-doc-est.nro-docto    = bf-item-doc-est.nro-docto   
              AND ext-item-doc-est.cod-emitente = bf-item-doc-est.cod-emitente
              AND ext-item-doc-est.nat-operacao = bf-item-doc-est.nat-operacao
              AND ext-item-doc-est.sequencia    = bf-item-doc-est.sequencia
              AND ext-item-doc-est.cod-param    = "fcp":U :
            ASSIGN de-tot-valor-aux = de-tot-valor-aux + ext-item-doc-est.val-livre-6. /*valor fcp ST*/ 
        END.
    END.     
    ELSE DO:
        ASSIGN de-tot-valor-aux = bf-item-doc-est.preco-total[1]
                                + bf-item-doc-est.despesas[1]
                                - bf-item-doc-est.desconto[1]
                                + (bf-item-doc-est.vl-pis-subs    * int(l-pis-cofins-st-total))
                                + (bf-item-doc-est.vl-cofins-subs * int(l-pis-cofins-st-total)).
    END.
    
    /* SOMA VALOR DO IPI */
    /*  l-industria               OR     l-devolucao*/ 
    IF  docum-est.cod-observa = 1 OR docum-est.cod-observa = 3 THEN DO:
    
        /* IPI Outras */
        if bf-item-doc-est.cd-trib-ipi = 3 and
        (b-natur-oper-item.terceiros or b-natur-oper-item.transf or docum-est.cod-observa = 3) then do:
           if (substr(b-natur-oper-item.char-2,16,5) = "1    ":U) then
                ASSIGN de-tot-valor-aux = de-tot-valor-aux + bf-item-doc-est.valor-ipi[1].
        end.        
        else /* IPI Tributado */
           ASSIGN de-tot-valor-aux = de-tot-valor-aux + bf-item-doc-est.valor-ipi[1].
        
    END.
        
    /* CALCULO DO ICMS SUBSTITUTO DAS NOTAS DE FRETE */
    IF  b-natur-oper-item.tipo-compra = 2 /* Frete */
        AND b-natur-oper-item.subs-trib THEN DO:
        
        IF  b-natur-oper-item.usa-nota-ent THEN
            ASSIGN de-tot-valor-aux = de-tot-valor-aux - docum-est.icm-fonte.
            
        IF  l-gera-cred-subs THEN
            ASSIGN de-tot-valor-aux = de-tot-valor-aux + (IF docum-est.icm-fonte > 0 THEN docum-est.icm-fonte ELSE bf-item-doc-est.valor-icm[1]).
    END.
    
    run validateImportacao.

    /* Integra‡Æo M¢dulo Importa‡Æo 
       Verifica parƒmetro "incide icms total da nota" do estabelecimento no parƒmetro de importa‡Æo */
    IF  l-imp THEN DO:

        FOR FIRST b-emitente-aux FIELDS (pais)
            WHERE b-emitente-aux.cod-emitente = docum-est.cod-emitente NO-LOCK:
            
            FOR FIRST b-estabelec-aux FIELDS (pais)
                WHERE b-estabelec-aux.cod-estabel = docum-est.cod-estabel NO-LOCK:
            
                IF  b-emitente-aux.pais = b-estabelec-aux.pais THEN
                    ASSIGN l-fornec-fundap = YES.

            END.
        END.

        IF  NOT l-fornec-fundap AND NOT b-natur-oper-item.nota-rateio THEN DO:
            IF  NOT VALID-HANDLE (h-bocx250) THEN
                RUN cxbo/bocx250.p PERSISTENT SET h-bocx250.
            RUN findCodigo IN h-bocx250 (INPUT docum-est.cod-estabel, OUTPUT c-return).

            IF  c-return = "":U THEN DO:
                RUN getLogfield IN h-bocx250 (INPUT "inc-icms-tot-nf":U, OUTPUT l-inc-icms-tot-nf).
               IF  docum-est.origem = "I" and not l-inc-icms-tot-nf then
                   assign de-tot-valor-aux = de-tot-valor-aux - bf-item-doc-est.valor-icm[1].
               else IF l-inc-icms-tot-nf and docum-est.origem <> "I" THEN
                   assign de-tot-valor-aux = de-tot-valor-aux + bf-item-doc-est.valor-icm[1].
                   
               /* ICMS Desonerado nÆo soma no total da nota */
               IF  docum-est.origem = "I" and l-inc-icms-tot-nf then do:
                   FOR FIRST ct-trib-item-doc-est NO-LOCK
                           WHERE ct-trib-item-doc-est.cdn-emitente     = bf-item-doc-est.cod-emitente
                             AND ct-trib-item-doc-est.cod-ser-docto    = bf-item-doc-est.serie-docto
                             AND ct-trib-item-doc-est.cod-docto        = bf-item-doc-est.nro-docto
                             AND ct-trib-item-doc-est.cod-natur-operac = bf-item-doc-est.nat-operacao
                             AND ct-trib-item-doc-est.num-seq          = bf-item-doc-est.sequencia
                             AND ct-trib-item-doc-est.cod-tip-trib     = "ICMS Desonerado":U:  
                       assign de-tot-valor-aux = de-tot-valor-aux - ct-trib-item-doc-est.val-trib.  
                   END.
               END.    
            END.
            IF  VALID-HANDLE (h-bocx250) THEN DO:
                DELETE PROCEDURE h-bocx250.
                ASSIGN h-bocx250 = ?.
            END.
        END.
        ELSE DO:
            IF  b-natur-oper-item.log-incid-icms-tot-nfr = NO 
            AND NOT b-natur-oper-item.nota-rateio    THEN
                ASSIGN de-tot-valor-aux = de-tot-valor-aux - docum-est.icm-deb-cre.
        END.
    END.
    
    /* Diminui valor de ICMS presumido */
    IF  b-natur-oper-item.log-icms-presmdo THEN
        ASSIGN de-tot-valor-aux = de-tot-valor-aux - (bf-item-doc-est.valor-icm[1]
                                                      * INT(bf-item-doc-est.cd-trib-icm = 1 /*T*/ OR
                                                            bf-item-doc-est.cd-trib-icm = 4 /*R*/ OR
                                                            bf-item-doc-est.cd-trib-icm = 5 /*D*/)).
    
    IF  de-tot-valor-aux < 0 THEN
        ASSIGN de-tot-valor-aux = 0.
    
    RETURN "OK":U.

END PROCEDURE.
