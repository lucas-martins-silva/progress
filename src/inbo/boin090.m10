
PROCEDURE beforeDeleteRecord :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

        def var l-contrato as logical                   no-undo.
        def var l-erro-co  as logical                   no-undo.
        def var de-qtd-max like item-doc-est.quantidade no-undo.
        def var i-total    as integer                   no-undo.
        def var h-boin871  as handle                    no-undo.
        def var h-boin874  as handle                    no-undo.
        def var l-valido   as logical                   no-undo.

        &IF "{&bf_dis_versao_ems}" >= "2.04" AND '{&mguni_version}' < '2.07' &THEN
            FIND FIRST param-global NO-LOCK NO-ERROR.

            IF param-global.modulo-tf AND CONNECTED('mgscm') THEN
            DO:
                if not valid-handle(h-bosc003) or
                  h-bosc003:type      <> "PROCEDURE":U or
                  h-bosc003:file-name <> "scbo/bosc003.p":U then
                  run scbo/bosc003.p persistent set h-bosc003.

                /* Desatualiza o conhecimento de fretes */
                FIND FIRST item-doc-est NO-LOCK
                     WHERE item-doc-est.serie-docto  = RowObject.serie-docto
                       AND item-doc-est.nro-docto    = RowObject.nro-docto
                       AND item-doc-est.cod-emitente = RowObject.cod-emitente
                       AND item-doc-est.nat-operacao = RowObject.nat-operacao NO-ERROR.

                FOR FIRST natur-oper NO-LOCK
                    WHERE natur-oper.nat-operacao = RowObject.nat-operacao:
                END.

                IF natur-oper.tipo-compra = 2 AND AVAIL item-doc-est THEN DO:
                    IF CAN-FIND(FIRST rat-docum no-lock
                        WHERE rat-docum.serie-docto = RowObject.serie-docto
                        AND   rat-docum.nro-docto   = RowObject.nro-docto
                        AND   rat-docum.cod-emitente = RowObject.cod-emitente
                        AND   rat-docum.nat-operacao = RowObject.nat-operacao) = YES THEN DO:
                        
                        FOR EACH rat-docum NO-LOCK 
                            WHERE rat-docum.serie-docto  = RowObject.serie-docto
                            AND   rat-docum.nro-docto    = RowObject.nro-docto
                            AND   rat-docum.cod-emitente = RowObject.cod-emitente
                            AND   rat-docum.nat-operacao = RowObject.nat-operacao:
                            FIND FIRST emitente NO-LOCK
                                 WHERE emitente.cod-emitente = rat-docum.cod-emitente NO-ERROR.


                            RUN setContabilizacao IN h-bosc003(INPUT emitente.nome-abrev,
                                                               INPUT RowObject.cod-estabel,
                                                               INPUT rat-docum.nf-serie,
                                                               INPUT rat-docum.nf-nro,
                                                               INPUT item-doc-est.valor-icm[1],
                                                               INPUT NO).


                        END.
                    END.
                    ELSE DO:
                        FIND FIRST emitente NO-LOCK
                             WHERE emitente.cod-emitente = RowObject.cod-emitente NO-ERROR.

                        RUN setContabilizacao IN h-bosc003(INPUT emitente.nome-abrev,
                                                           INPUT RowObject.cod-estabel,
                                                           INPUT RowObject.serie-docto,
                                                           INPUT RowObject.nro-docto,
                                                           INPUT item-doc-est.valor-icm[1],
                                                           INPUT NO).
                    END.
                END.
                IF VALID-HANDLE(h-bosc003) THEN
                DO:
                    DELETE PROCEDURE h-bosc003.
                    ASSIGN h-bosc003 = ?.
                END.
            END.
        &ENDIF
        
        /** Importacao - Eliminacao movto-ato **/
        if  (not can-find(funcao where funcao.cd-funcao = "spp-drb-sld-terc":U and funcao.ativo))
        and param-global.modulo-07
        and param-global.modulo-ex
        &if "{&bf_dis_versao_ems}":U >= "2.06":U &then                                             
            and natur-oper.log-natur-operac-draw                                                       
            and param-global.log-modul-draw  /*Modulo Drawback*/
        &else                                                                                      
            and substring(natur-oper.char-1,94,1) = "1":U
            and substring(param-global.char-2,22,1) = "1" /*Modulo Drawback*/
        &endif
        and emitente.natureza > 2
        and emitente.pais <> estabelec.pais
        and substr(RowObject.char-1,90,1) = "1":U 
        and connected ("mgcex":U) then do:

        if  not valid-handle (h-bocx332) then 
        run cxbo/bocx332.p persistent set h-bocx332.

            for each item-doc-est
                where item-doc-est.serie-docto         = rowObject.serie-docto  
                and   item-doc-est.nro-docto           = rowObject.nro-docto    
                and   item-doc-est.cod-emitente        = rowObject.cod-emitente 
                and   item-doc-est.nat-operacao        = rowObject.nat-operacao
                and   item-doc-est.nr-ato-concessorio <> "":U no-lock:

                /** Efetiva eliminacao dos movimentos **/
                run eliminaMovtos in h-bocx332 (input rowid(item-doc-est),
                                                input yes, /** Elimina Movtos **/
                                                input no,  
                                                output table RowErrors).
            end.

            if  valid-handle (h-bocx332) then do:
                delete procedure h-bocx332.
                assign h-bocx332 = ?.
            end.

        end.
        
        assign l-contrato    = no
               i-total       = 0.

        &IF "{&bf_mat_versao_ems}" >= "2.062" &THEN
            if  not avail param-global then
                find first param-global no-lock no-error.

            for first rat-ordem no-lock
                where rat-ordem.serie-docto         = rowObject.serie-docto  
                and   rat-ordem.nro-docto           = rowObject.nro-docto    
                and   rat-ordem.cod-emitente        = rowObject.cod-emitente 
                and   rat-ordem.nat-operacao        = rowObject.nat-operacao :

                if rat-ordem.numero-ordem <> 0 
                and avail param-global
                and param-global.modulo-cn then do:
                    run cnp/cn9174.p ( rat-ordem.numero-ordem,
                                       1,
                                       0,
                                       0,
                                       ?,
                                       output de-qtd-max,
                                       output l-erro-co,
                                       output l-contrato,
                                       output i-total,
                                       input-output table tt-erro).
                end.

            end.

            if  l-contrato then
                for each  rat-ordem no-lock
                    where rat-ordem.serie-docto         = rowObject.serie-docto  
                    and   rat-ordem.nro-docto           = rowObject.nro-docto    
                    and   rat-ordem.cod-emitente        = rowObject.cod-emitente 
                    and   rat-ordem.nat-operacao        = rowObject.nat-operacao: 
                    /* Desaloca */
                    run rep/re1001p2.p (input rowid(rat-ordem),
                                        input 0,
                                        input no).
    
                end.
        &ENDIF

        if  not valid-handle(h-boin367) then 
              run inbo/boin367.p persistent set h-boin367.   
        
        run atualizanNvInspbyNF in h-boin367(input rowObject.cod-emitente,
                                         input rowObject.nro-docto,
                                         input rowObject.nat-operacao,
                                         input rowObject.serie-docto,
                                         input rowObject.cod-estabel).
                                             
        if valid-handle(h-boin367) then do:
            delete procedure h-boin367.
            assign h-boin367 = ?.                
        end.
        
        def buffer bf-natur-oper-fut   for natur-oper.
        /*--- quando a nota eh fatura entrega futura grava a natureza complementar no item-doc-est ---*/
        find bf-natur-oper-fut where
             bf-natur-oper-fut.nat-operacao = rowObject.nat-operacao no-lock no-error.
             
        /*--- verifica se docum-est eh de nota de fatura faturamento ou fatura entrega futura ---*/
        {cdp/cd9700.i1 bf-natur-oper-fut}  
    
	/* Se for remessa de faturamento antecipado:
           Diminui a quantidade do documento a qtd-receb-fisic da sdo-fatur-antecip (bodi578) */
        IF l-remessa-fat-antecip OR (l-fatura-fat-antecip and rowObject.esp-docto = 20) THEN DO:
        
            IF NOT VALID-HANDLE(h-bodi578) THEN
                RUN dibo/bodi578.p PERSISTENT SET h-bodi578.  
        
            for each item-doc-est
               where item-doc-est.serie-docto  = rowObject.serie-docto  
                 and item-doc-est.nro-docto    = rowObject.nro-docto    
                 and item-doc-est.cod-emitente = rowObject.cod-emitente 
                 and item-doc-est.nat-operacao = rowObject.nat-operacao no-lock:
                FOR FIRST movto-fatur-antecip
                     WHERE movto-fatur-antecip.nr-nota-fis  = item-doc-est.nro-comp
                       AND movto-fatur-antecip.cod-estabel  = RowObject.cod-estabel 
                       AND movto-fatur-antecip.serie-docto  = item-doc-est.serie-comp 
                       AND movto-fatur-antecip.cod-emitente = item-doc-est.cod-emitente 
                       AND movto-fatur-antecip.nat-operacao = item-doc-est.nat-comp
                       AND movto-fatur-antecip.it-codigo    = item-doc-est.it-codigo
                       AND movto-fatur-antecip.cod-refer    = item-doc-est.cod-refer  
                       AND movto-fatur-antecip.num-seq      = item-doc-est.seq-comp             NO-LOCK:			
					RUN atualizaSaldoFisicoItem IN h-bodi578 (input movto-fatur-antecip.num-id-sdo,
															  input "",
															  input "",
															  input "",
															  input 0,
															  input "",
															  input "",
															  input 0,
															  input (item-doc-est.quantidade * -1)).       
				END.
            end.
            
            DELETE PROCEDURE h-bodi578.
            ASSIGN h-bodi578 = ?.
        END. 
		
        /*Atualiza a quantidade digitada no recebimento fisico para fatura entrega futura*/
	IF  l-fatura-ent-futura 
	and bf-natur-oper-fut.tipo-compra = 3 THEN DO:
            for each item-doc-est
               where item-doc-est.serie-docto  = rowObject.serie-docto  
                 and item-doc-est.nro-docto    = rowObject.nro-docto    
                 and item-doc-est.cod-emitente = rowObject.cod-emitente 
                 and item-doc-est.nat-operacao = rowObject.nat-operacao no-lock:
                 FOR FIRST nota-fiscal
                     WHERE nota-fiscal.nr-nota-fis  = item-doc-est.nro-comp
                       AND nota-fiscal.serie        = item-doc-est.serie-comp 
                       AND nota-fiscal.cod-estabel  = RowObject.cod-estabel NO-LOCK:
                       FOR FIRST bf-natur-oper-fut
                           WHERE bf-natur-oper-fut.nat-operacao = nota-fiscal.nat-operacao NO-LOCK:
                           /*** localiza o componente da nota de fatura para encontrar a saldo-terc ***/
                           FOR FIRST componente
                               WHERE componente.nro-docto     = item-doc-est.nro-comp
                                 AND componente.nat-operacao  = bf-natur-oper-fut.nat-comp
                                 AND componente.cod-emitente  = item-doc-est.cod-emitente
                                 AND componente.serie-docto   = item-doc-est.serie-comp
                                 AND componente.it-codigo     = item-doc-est.it-codigo    
                                 AND componente.sequencia     = item-doc-est.sequencia NO-LOCK:           /*14447 - Adicionado sequencia na clausula para notas com mesmo item em mais de uma sequencia*/
                               /*** Localiza a saldo-terc para atualizacao do saldo digitado ***/
                               FOR FIRST saldo-terc
                                   WHERE saldo-terc.nro-docto    = componente.nro-docto   				  
                                     AND saldo-terc.cod-emitente = componente.cod-emitente
                                     AND saldo-terc.serie-docto  = componente.serie-docto 
                                     AND saldo-terc.sequencia    = componente.sequencia   EXCLUSIVE-LOCK:
                                     assign saldo-terc.dec-1   = saldo-terc.dec-1 - item-doc-est.quantidade.								 
                               END. 

                               /*** localiza o rat-componente da nota de fatura para encontrar a rat-saldo-terc ***/
                               FOR EACH rat-componente
                                   WHERE rat-componente.nro-docto     = componente.nro-docto 
                                     AND rat-componente.nat-operacao  = componente.nat-operacao
                                     AND rat-componente.cod-emitente  = componente.cod-emitente
                                     AND rat-componente.serie-docto   = componente.serie-docto
                                     AND rat-componente.it-codigo     = componente.it-codigo 
                                     AND rat-componente.sequencia     = componente.sequencia      NO-LOCK:           /*14447 - Adicionado sequencia na clausula para notas com mesmo item em mais de uma sequencia*/
                                       /*** Localiza a rat-saldo-terc para atualizacao do saldo digitado ***/                                   
                                     FOR EACH rat-saldo-terc OF rat-componente EXCLUSIVE-LOCK:  
                                         ASSIGN rat-saldo-terc.qtd-aloc-trans  = rat-saldo-terc.qtd-aloc-trans - rat-componente.quantidade.
                                     END.           
                               END.    
                           END. 
                      END.
                 END.
            END.
        END.
		
        IF  CAN-FIND(FIRST funcao WHERE funcao.cd-funcao = "spp-conv-nfe-entrada":U AND funcao.ativo NO-LOCK) THEN DO:
            /* Conversor NFe */
            
            define variable c-chave-comp-nfe as character no-undo.
            define variable c-chave-comp-cte as character no-undo.
            
            FIND FIRST param-convrsr-nfe NO-LOCK NO-ERROR.

            /* NFSe **************************************************************/
            IF AVAIL param-convrsr-nfe AND param-convrsr-nfe.log-livre-2 THEN DO:
                IF NOT VALID-HANDLE(h-boin874)
                    OR h-boin874:TYPE      <> "PROCEDURE":U
                    OR h-boin874:FILE-NAME <> "inbo/boin874.p":U THEN
                    RUN inbo/boin874.p PERSISTENT SET h-boin874.
                    
                
                RUN atualizaSituacaoPeloDocumento IN h-boin874 (INPUT rowObject.cod-emitente,
                                                                INPUT rowObject.nro-docto,
                                                                INPUT rowObject.serie-docto,
                                                                INPUT rowObject.dt-emissao,
                                                                INPUT 4). /* Eliminada Receb. Fiscal */
            
                
                DELETE PROCEDURE h-boin874.
                ASSIGN h-boin874 = ?.                
            END.
            /*********************************************************************/


             /* log-livre-1 trocar por log-habilita-cte */
            IF AVAIL param-convrsr-nfe AND param-convrsr-nfe.log-livre-1 THEN DO:

                IF NOT VALID-HANDLE(h-boin871)
                OR h-boin871:TYPE      <> "PROCEDURE":U
                OR h-boin871:FILE-NAME <> "inbo/boin871.p":U THEN
                    RUN inbo/boin871.p PERSISTENT SET h-boin871.
                    
                assign c-chave-comp-cte = &IF "{&bf_mat_versao_ems}" < "2.07" &THEN
                                              TRIM(SUBSTRING(rowObject.char-1,93,60))
                                          &ELSE                                    
                                              if rowObject.cod-chave-aces-nf-eletro <> "" then
                                                 rowObject.cod-chave-aces-nf-eletro
                                              else
                                                 TRIM(SUBSTRING(rowObject.char-1,93,60))
                                          &ENDIF
                                          .
                                          
                IF  VALID-HANDLE(h-boin871)        AND
                    h-boin871:TYPE = "PROCEDURE":U AND
                    h-boin871:FILE-NAME = "inbo/boin871.p":U THEN DO:

                    assign l-valido = false.
                        
                    if LENGTH(c-chave-comp-cte) = 44 then do:
                        if substring(c-chave-comp-cte,21,2) = "57" or
                           substring(c-chave-comp-cte,21,2) = "67" then 
                            assign l-valido = true.
                    end.                
                    else do: 
                        if avail bf-natur-oper-fut and
                          (bf-natur-oper-fut.cod-model-nf-eletro = '57' or 
                           bf-natur-oper-fut.cod-model-nf-eletro = '67') then
                            assign l-valido = true.                        

                    end.                    
                    if l-valido then do:                                        
                    
                        RUN atualizaSituacaoEliminacaoDocumEst in h-boin871 (input c-chave-comp-cte,
                                                                             input rowObject.serie-docto,
                                                                             input rowObject.nro-docto,
                                                                             input rowObject.cod-emitente,
                                                                             input rowObject.cod-estabel,
                                                                             input rowObject.tipo-nota,
                                                                             input rowObject.nat-operacao).
            
                    end.
                    
                    DELETE PROCEDURE h-boin871.
                    ASSIGN h-boin871 = ?.
                END.
            END.

            /* Conversor NFe */
            
            if  not valid-handle(h-boin847) or
                h-boin847:type      <> "PROCEDURE":U or
                h-boin847:file-name <> "inbo/boin847.p":U then
                RUN inbo/boin847.p PERSISTENT SET h-boin847.
            
            assign c-chave-comp-nfe = &IF "{&bf_mat_versao_ems}" < "2.07" &THEN
                                          TRIM(SUBSTRING(rowObject.char-1,93,60))
                                      &ELSE                                    
                                          rowObject.cod-chave-aces-nf-eletro   
                                      &ENDIF  
                                      .
            assign l-valido  = false.                    
            
            if LENGTH(c-chave-comp-nfe)         = 44 then do: 
                if substring(c-chave-comp-nfe,21,2) = "55" then 
                    assign l-valido  = true. 
            end.
            else do:                   
                if avail bf-natur-oper-fut and
                   bf-natur-oper-fut.cod-model-nf-eletro = '55' then
                    assign l-valido  = true.                
            end.
            
            if  l-valido then do:              
            run atualizaSituacaoEliminacaoDocumEst in h-boin847 (input c-chave-comp-nfe,
                                                                 input rowObject.serie-docto,
                                                                 input rowObject.nro-docto,
                                                                 input rowObject.cod-emitente,
                                                                 input rowObject.tipo-nota,
                                                                 input rowObject.nat-operacao,
                                                                 INPUT RowObject.dt-emissao). 
            end.                                                               

            IF  VALID-HANDLE(h-boin847) THEN DO:
                RUN destroy IN h-boin847.
                ASSIGN h-boin847 = ?.
            END.
        END.
        
        RETURN "OK":U.
END PROCEDURE.





