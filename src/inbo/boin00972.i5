
    IF param-aquis-rural.cod-periodo = "" THEN 
        NEXT.

    ASSIGN i-mes = INT(SUBSTRING(param-aquis-rural.cod-periodo,1,2))
           i-ano = INT(SUBSTRING(param-aquis-rural.cod-periodo,3,4))
           dtUltimoDiaPeriodoFechado = DATE ( i-mes , 1 , i-ano ) 
           dtUltimoDiaPeriodoFechado = ADD-INTERVAL(DATE(dtUltimoDiaPeriodoFechado), 1, "months") - 1.
           
    CASE cAcao:
        WHEN "INIT":U THEN DO:
            if  lDesabilitaValUnit = no 
            and dtUltimoDiaPeriodoFechado >=  dt-ini then
                assign lDesabilitaValUnit = yes.
        END.
        WHEN "CREATE":U  OR WHEN "DELETE":U THEN DO:
            IF dt-ini <= dtUltimoDiaPeriodoFechado OR dt-fim <= dtUltimoDiaPeriodoFechado THEN DO:
                /* Não é possível incluir/alterar/eliminar regra para estabelecimento com período de cálculo fechado.  */
                {method/svc/errors/inserr.i &ErrorNumber="54817"
                                            &ErrorType="EMS" 
                                            &ErrorSubType="ERROR"}
                RETURN 'NOK':U. 
            END. 
        END.
        
        WHEN "UPDATE":U THEN DO:
            
            FOR FIRST bf{&TableName}
                WHERE ROWID(bf{&TableName}) = RowObject.r-rowid NO-LOCK:
            END.
           
            IF bf{&TableName}.dat-inic <> dt-ini THEN DO:
                IF bf{&TableName}.dat-inic <= dtUltimoDiaPeriodoFechado OR dt-ini <= dtUltimoDiaPeriodoFechado THEN DO:
                    /* Não é possível incluir/alterar/eliminar regra para estabelecimento com período de cálculo fechado.  */
                    {method/svc/errors/inserr.i &ErrorNumber="54817"
                                                &ErrorType="EMS" 
                                                &ErrorSubType="ERROR"}
                    RETURN 'NOK':U.
                END.
            END.  
            
            IF dt-fim < dtUltimoDiaPeriodoFechado THEN DO:
                /* Não é possível incluir/alterar/eliminar regra para estabelecimento com período de cálculo fechado.  */
                {method/svc/errors/inserr.i &ErrorNumber="54817"
                                            &ErrorType="EMS" 
                                            &ErrorSubType="ERROR"}
                RETURN 'NOK':U.
            END.
        END.
    END CASE.


