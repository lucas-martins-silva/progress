{cdp/cdcfgman.i}
{sfc/sf9999.i}

def var l-updateSplitOperac as log init no no-undo.
def var c-aux as char no-undo.
def var l-on-line as log init no no-undo.

/*************************************************************************************************
**
** PROCEDURE: ReabrirSplit
** Objetivo:  Efetua a reabertura do split da Operacao
** ParÉmetro: rowid split-operac
**      
*************************************************************************************************/
procedure ReabrirSplit:

     def input param r-split-operac as rowid no-undo.
     def output param table for rowErrors.
     
     empty temp-table rowErrors.
     
     /***VALIDACOES****/ 
     find first split-operac where rowid(split-operac) = r-split-operac no-lock no-error.

     if not avail split-operac then do:
        {utp/ut-liter.i Split_da_Operaá∆o *}
        run criaErro(input 47,
                     input return-value).   
        return "NOK":U.
     end.
     
     if not avail ord-prod or ord-prod.nr-ord-produ <> split-operac.nr-ord-produ then 
        FIND ord-prod WHERE ord-prod.nr-ord-produ = split-operac.nr-ord-produ  NO-LOCK NO-ERROR.
     IF ord-prod.estado >= 7  THEN do:
        run criaErro(input 32044,
                     input string(ord-prod.nr-ord-produ,">>>,>>>,>>9":U)).
         return "NOK":U.              
     end.   

     if split-operac.ind-estado-split <> 5 then do:
        /*Para que o split possa ser reaberto, o mesmo deve estar com o estado Finalizado*/
        run criaErro(input 32045,
                     input string(split-operac.nr-ord-produ,">>>,>>>,>>9":U) + "/":U + 
                           string(split-operac.op-codigo) + "/":U + 
                           string(split-operac.num-split-operac)).   
        return "NOK":U.      
     end.  
     
     /*EFETIVA TRANSACAO*/
     find current split-operac exclusive-lock no-error.
     find op-sfc where op-sfc.nr-ord-produ = split-operac.nr-ord-produ exclusive-lock no-error.

     if split-operac.qtd-operac-reptda <> 0 or split-operac.tempo-real-operac <> 0 then
         run alterarEstadoSplit(buffer split-operac,
                                input 4). /*Iniciado*/ 
     else do:
         if op-sfc.ind-estado-op = 1 /*Nao Iniciado*/ then 
             run alterarEstadoSplit(buffer split-operac,
                                    input 1). /*Nao Iniciado*/        
         else                                 
             run alterarEstadoSplit(buffer split-operac,
                                    input 3). /*Liberado*/    
     end.        
     
     if can-find(first rep-oper-ctrab 
                 where rep-oper-ctrab.nr-ord-produ = op-sfc.nr-ord-produ) then
         assign op-sfc.ind-estado-op = 3. /*Iniciada*/ 
     else do:
         if can-find(first split-operac 
                     where split-operac.nr-ord-produ     = op-sfc.nr-ord-produ
                       and split-operac.ind-estado-split > 1 /*Nao Iniciado*/ ) then do:
             assign op-sfc.ind-estado-op = 2. /*Liberada*/              
            
             /*** Gravar na Ordem SFC a Èltima data de liberaá∆o no Split ***/
             assign op-sfc.dat-liber-op = today.    
   
         end.
         else
             assign op-sfc.ind-estado-op = 1. /*Nao Iniciado*/
     end.    
            
     find current split-operac no-lock no-error.     
     find current op-sfc       no-lock no-error.      
     
return "OK":U.
end procedure.       


/*************************************************************************************************
**
** PROCEDURE: alocarCtrab
** Objetivo:  Efetua a alocaá∆o do Split para o gm e ctrab informados via parametros.
** ParÉmetro: rowid split-operac; gm-codigo; cod-ctrab; cod-ferr-prod; output rowErrors
              Obs.: Ferramenta Ç opcional. Quando passada como ?, n∆o Ç considerada no processo de alocaá∆o
**      
*************************************************************************************************/
procedure alocarCtrab:

     def input param r-split-operac as rowid no-undo.
     def input param c-novo-gm as char no-undo.
     def input param c-novo-ctrab as char no-undo. 
     def input param p-nova-ferram as char no-undo.        
     def output param table for rowErrors.
     
     def var h-boin533 as handle no-undo.
     def buffer bf-split-operac for split-operac.
     def var r-row-area as rowid no-undo.
     def var l-mudancas-sfc as log init no no-undo.
     def var c-gm-original as char no-undo.
     def var c-areas as char no-undo.
     
     empty temp-table rowErrors.
     
     find first split-operac where rowid(split-operac) = r-split-operac no-lock no-error.
     find first oper-ord no-lock
          where oper-ord.nr-ord-produ   = split-operac.nr-ord-produ 
            and oper-ord.num-operac-sfc = split-operac.num-operac-sfc no-error.
     
     /*l-updateSplitOperac indica que est† sendo chamada da updateSplitOperac, 
       ent∆o omite algumas validaá‰es, pois j† foram feitas.*/
     
     if l-updateSplitOperac = no then do:
     
         if not avail split-operac then do:
            {utp/ut-liter.i Split_da_Operaá∆o *}
            run criaErro(input 47,
                         input return-value).   
            return "NOK":U.
         end.   
         
         if split-operac.ind-estado-split >= 4 then do:
              /*Split da Operaá∆o n∆o pode ser alterado devido ao seu estado 32064*/
              run criaErro(input 32064,
                           input "":U).  
              return "NOK":U.             
         end.
         
         find first grup-maquina where                                                     
                    grup-maquina.gm-codigo = c-novo-gm no-lock no-error.                                                                 
         if not avail grup-maquina then do:                                                
             {utp/ut-table.i mgind grup-maquina 01}                                        
             run criaErro(input 56,
                          input return-value).                                                               
         end.  
                                                                                     
         find first ctrab where                                                         
                    ctrab.gm-codigo = c-novo-gm and 
                    ctrab.cod-ctrab = c-novo-ctrab no-lock no-error.                                                   
         if not avail ctrab and                                                         
            c-novo-ctrab <> "" then do:             
             {utp/ut-table.i mgind ctrab 01}    
             run criaErro(input 56,
                          input return-value).                                                  
         end. 
     end.

/*      &IF DEFINED(bf_man_204) &THEN                                                           */
/*          run sfc/sf9999.p(output l-mudancas-sfc).                                            */
/*          IF l-mudancas-sfc THEN DO:                                                          */
/*                                                                                              */
/*              if split-operac.gm-codigo <> c-novo-gm then do:                                 */
/*                                                                                              */
/*                  RELEASE operacao.                                                           */
/*                  RELEASE op-altern.                                                          */
/*                                                                                              */
/*                  IF oper-ord.op-altern = 0 THEN                                              */
/*                      FIND FIRST operacao NO-LOCK                                             */
/*                          WHERE operacao.num-id-operacao = oper-ord.num-id-operacao NO-ERROR. */
/*                  ELSE                                                                        */
/*                      FIND FIRST op-altern NO-LOCK                                            */
/*                          WHERE op-altern.num-id-operacao = oper-ord.num-id-operacao          */
/*                            AND op-altern.op-altern       = oper-ord.op-altern NO-ERROR.      */
/*                                                                                              */
/*                  IF (NOT AVAIL op-altern AND NOT AVAIL operacao) THEN                        */
/*                      ASSIGN c-gm-original = oper-ord.gm-codigo.                              */
/*                  ELSE DO:                                                                    */
/*                      IF AVAIL operacao THEN                                                  */
/*                          ASSIGN c-gm-original = operacao.gm-codigo.                          */
/*                      ELSE                                                                    */
/*                          ASSIGN c-gm-original = op-altern.gm-codigo.                         */
/*                  END.                                                                        */
/*                                                                                              */
/*                  IF c-gm-original <> c-novo-gm and                                           */
/*                     NOT CAN-FIND(FIRST grup-maq-alter                                        */
/*                                  WHERE grup-maq-altern.gm-codigo = c-gm-original              */
/*                                    AND grup-maq-altern.gm-altern = c-novo-gm) THEN DO:        */
/*                                                                                              */
/*                       run criaErro(input 32438,                                              */
/*                                    input "":U).                                              */
/*                  END.                                                                        */
/*              END.                                                                            */
/*          END. /*IF l-mudancas-sfc*/                                                          */
/*      &ENDIF                                                                                  */

     /*Valida ferramenta quando diferente de ?*/
     
     //ferramenta inativa  

    if p-nova-ferram <> ? and p-nova-ferram <> "":U and c-novo-ctrab <> ? and c-novo-ctrab <> "":U then do:
                  
      if can-find (first ctrab-ferram where
                          ctrab-ferram.cod-ctrab     = c-novo-ctrab and
                          ctrab-ferram.cod-ferr-prod = p-nova-ferram and
			              ctrab-ferram.log-ativo     = NO) then do:  

            {utp/ut-liter.i A_Ferramenta_  *}
            ASSIGN c-aux = RETURN-VALUE.
            {utp/ut-liter.i o_Centro_Trabalho_-_ *}                        
            run criaErro(input 17899,
                         input c-aux + string(p-nova-ferram) + " est† inativa ou"
                         + "~~":U + RETURN-VALUE + string(c-novo-ctrab)). 
        end.
    end.                                  
     
     if p-nova-ferram <> ? and p-nova-ferram <> "":U then do:        
         find first grup-maquina 
              where grup-maquina.gm-codigo = c-novo-gm no-lock no-error.         
        
         if  not can-find (first ferr-prod
                           where ferr-prod.cod-ferr-prod = p-nova-ferram) then do: 
            if not can-find (first equipto where                                   /* Adicionado para fazer consistencia nos equipamentos tambÇm*/
                                   equipto.cd-equipto = p-nova-ferram) then do:               
                    {utp/ut-table.i mgind ferr-prod 01}
                    ASSIGN c-aux = RETURN-VALUE.
                    run criaErro(input 47,
                                 input RETURN-VALUE).
            end.              
         end.
         ELSE DO:
          
             if c-novo-ctrab <> ? and c-novo-ctrab <> "":U then do:
                if  not can-find (first ctrab-ferram where
                                        ctrab-ferram.cod-ctrab     = c-novo-ctrab and
                                        ctrab-ferram.cod-ferr-prod = p-nova-ferram) then do:
                    {utp/ut-liter.i Ferramenta *}
                    ASSIGN c-aux = RETURN-VALUE.
                    {utp/ut-liter.i Centro_de_Trabalho *}                        
                    run criaErro(input 17899,
                                 input c-aux + "~~":U + RETURN-VALUE). 
                end.
             end.        
        
             if  not can-find (first op-ferram
                               where op-ferram.num-id-operacao = oper-ord.num-id-operacao
                                 AND op-ferram.op-altern       = oper-ord.op-altern
                                 and op-ferram.ferramenta      = p-nova-ferram) AND 
                 can-find(FIRST op-ferram 
                          WHERE op-ferram.num-id-operacao = oper-ord.num-id-operacao
                            AND op-ferram.op-altern       = oper-ord.op-altern)   then do:
        
                 {utp/ut-liter.i Ferramenta *}
                 ASSIGN c-aux = RETURN-VALUE.
                 {utp/ut-liter.i Operaá∆o *}                        
                 run criaErro(input 17899,
                              input c-aux + "~~":U + RETURN-VALUE).
             end.
         END.
     end.

     if can-find(first rowErrors) then 
          return "NOK":U.
     
     &if defined(bf_man_204) &then
     assign l-mudancas-sfc = l-glob-novo-sfc.

     /*Se estiver em uma atualizaá∆o de split, e se tratar de novo gm, valida a †rea de produá∆o*/
     if l-mudancas-sfc and l-updateSplitOperac and avail rowObject then do:
     
        find first ord-prod where ord-prod.nr-ord-produ = split-operac.nr-ord-produ no-lock no-error.   
        
        if c-novo-gm <> "":U then do:
             
             /*Se a †rea e o GM nao estiverem vinculados atravÇs de um area-produc-ctrab, emite msg com as †reas v†lidas*/
             if not can-find(first area-produc-ctrab no-lock
                             where area-produc-ctrab.gm-codigo       = trim(c-novo-gm)
                               and area-produc-ctrab.cod-area-produc = trim(rowObject.cod-area-produc)
                               and area-produc-ctrab.dat-inic-valid  <= today
                               and area-produc-ctrab.dat-fim-valid   >  today) then do:
                               
                  for each area-produc-ctrab no-lock
                     where area-produc-ctrab.gm-codigo       = c-novo-gm
                       and area-produc-ctrab.dat-inic-valid  <= today
                       and area-produc-ctrab.dat-fim-valid   >  today:
                       
                       find first area-produc no-lock
                            where area-produc.cod-area-produc = area-produc-ctrab.cod-area-produc no-error.
                       if avail area-produc and area-produc.cod-estabel = ord-prod.cod-estabel then
                             if lookup(area-produc-ctrab.cod-area-produc,c-areas) = 0 then do:
                                   assign c-areas = (if length(c-areas) = 0 then "" else (c-areas + ",")) + area-produc-ctrab.cod-area-produc.
                             end.
                  end.
                  
                  run criaErro(input 33375,
                               input c-novo-gm + "~~":U + rowObject.cod-area-produc + "~~":U + c-areas).
                  return "NOK":U.    
             end.
        end.             
                                 
        if c-novo-ctrab <> "":U then do:
        
             /*Se a †rea informada n∆o coincidir com a †rea vinculada ao ctrab pelo area-produc-ctrab, e estiver trabalhando online,
               emite pergunta se deseja alterar para a mesma area do ctrab. Se nao, emite msg de erro apenas.*/
             find first area-produc-ctrab no-lock
                  where area-produc-ctrab.cod-ctrab = c-novo-ctrab  
                    and area-produc-ctrab.dat-inic-valid <= today
                    and area-produc-ctrab.dat-fim-valid  >  today no-error.
                    
             if avail area-produc-ctrab and area-produc-ctrab.cod-area-produc <> rowObject.cod-area-produc then do:
             
                 /*On-line = emite pergunta*/
                 if l-on-line then do:

                      run utp/ut-msgs.p (input "show",
                                         input 33374,
                                         input c-novo-ctrab + "~~":U + 
                                               area-produc-ctrab.cod-area-produc + "~~":U +
                                               rowObject.cod-area-produc).
                      if return-value = "yes":U then 
                           assign rowObject.cod-area-produc = area-produc-ctrab.cod-area-produc.
                      else 
                          assign c-novo-ctrab = "":U.
                 end.
                 /*off-line = apenas emite mensagem de erro*/
                 else do:
                      
                      run criaErro(input 33565,
                                   input c-novo-ctrab + "~~":U + 
                                         area-produc-ctrab.cod-area-produc + "~~":U +
                                         rowObject.cod-area-produc). 
                      return "NOK":U.   

                 end.
             end.      
        end.

        find first area-produc no-lock 
             where area-produc.cod-area-produc = rowObject.cod-area-produc no-error.
        if not avail area-produc then do:     
             {utp/ut-liter.i µrea_de_Produá∆o *}
             run criaErro(input 2,
                          input return-value).
             return "NOK":U.                             
        end.  
        else
              if c-novo-ctrab = "":U and 
                 area-produc.cod-estabel <> ord-prod.cod-estabel then do:
                     run criaErro(input 33618,
                                  input ord-prod.cod-estabel + "~~":U + area-produc.cod-estabel).
                     return "NOK":U. 
              end.        

     end.
     &endif

     if c-novo-ctrab <> "":U then do:
         find first area-produc-ctrab where                                                                  
                    area-produc-ctrab.gm-codigo       = c-novo-gm and        
                    area-produc-ctrab.cod-ctrab       = c-novo-ctrab AND 
                    area-produc-ctrab.dat-inic-valid <= today  and                                           
                    area-produc-ctrab.dat-fim-valid   > today NO-LOCK NO-ERROR.   
         if not avail area-produc-ctrab then do:
             run criaErro(input 17562,
                          input "":U). 
             return "NOK":U.                    
         end.  
         else
             assign r-row-area = rowid(area-produc-ctrab).         
       
         IF l-mudancas-sfc THEN DO:

              find first area-produc 
                   where area-produc.cod-area-produc = area-produc-ctrab.cod-area-produc no-lock no-error. 
              find first ord-prod where ord-prod.nr-ord-produ = split-operac.nr-ord-produ no-lock no-error.     
              if area-produc.cod-estabel <> ord-prod.cod-estabel then do:
                  run criaErro(input 32495,
                               input ord-prod.cod-estabel). 
                  return "NOK":U.           
              end.             

              if not ord-prod.prototipo and
                  can-find(first ctrab-operac-aloc no-lock
                           where ctrab-operac-aloc.num-id-operacao = oper-ord.num-id-operacao
                             and ctrab-operac-aloc.op-altern       = oper-ord.op-altern)
                  and
                 not can-find(first ctrab-operac-aloc no-lock
                              where ctrab-operac-aloc.cod-ctrab       = c-novo-ctrab
                                and ctrab-operac-aloc.num-id-operacao = oper-ord.num-id-operacao
                                and ctrab-operac-aloc.op-altern       = oper-ord.op-altern) then do:
                    /*Centro de Trabalho n∆o Ç valido para a Operaá∆o.*/            
                    run criaErro(input 32544,                                                      
                                 input c-novo-ctrab).  
                    return "NOK":U. 
              end.
         end.        
     end.                          

     find current split-operac exclusive-lock no-error.                        
     run AlterarGrupoMaquinaSplit(buffer split-operac,
                                  input c-novo-gm).
                                
     if not avail area-produc-ctrab or rowid(area-produc-ctrab) <> r-row-area then
        find first area-produc-ctrab where rowid(area-produc-ctrab) = r-row-area no-lock no-error.
            
     if c-novo-ctrab <> "":U and avail area-produc-ctrab then 
         find first ctrab where ctrab.cod-ctrab = area-produc-ctrab.cod-ctrab no-lock no-error.     
                        
     assign split-operac.cod-ctrab       = c-novo-ctrab
            split-operac.cod-area-produc = (if (c-novo-ctrab <> "":U and avail area-produc-ctrab) then area-produc-ctrab.cod-area-produc else split-operac.cod-area-produc)
            split-operac.qtd-carga-batch = ctrab.qtd-carga-batch when (avail ctrab and avail area-produc-ctrab and c-novo-ctrab <> "":U)
            split-operac.cod-ferr-prod   = p-nova-ferram when p-nova-ferram <> ?.
            
     &if defined(bf_man_204) &then

     /*Se estiver em uma atualizaá∆o de split, no novo sfc, atribui a †rea de produá∆o definida e validada no c¢digo acima */
     if l-mudancas-sfc and l-updateSplitOperac and avail rowObject then
        assign split-operac.cod-area-produc = rowObject.cod-area-produc.
        
     &endif   
                        
     run inbo/boin533.p persistent set h-boin533.
     
     run VerificarOrdemSFC in h-boin533 (input split-operac.nr-ord-produ).  
     
     if valid-handle(h-boin533) then
        delete procedure h-boin533.
        
     find current split-operac no-lock no-error.  

      FIND FIRST oper-ord WHERE oper-ord.nr-ord-produ   = split-operac.nr-ord-produ
                            AND oper-ord.num-operac-sfc = split-operac.num-operac-sfc no-lock NO-ERROR.     

     if (oper-ord.gm-codigo  <> split-operac.gm-codigo or
         oper-ord.ferramenta <> split-operac.cod-ferr-prod 
        &if defined(bf_man_205) &then
          or  oper-ord.cod-recurso <> split-operac.cod-ctrab
        &elseif defined(bf_man_204) &then
          or  substring(oper-ord.char-1,60,16) <> split-operac.cod-ctrab
        &endif  )
        and 
        not can-find(first bf-split-operac 
                     where bf-split-operac.nr-ord-produ     = split-operac.nr-ord-produ
                       and bf-split-operac.num-operac-sfc   = split-operac.num-operac-sfc
                       and bf-split-operac.num-split-operac < split-operac.num-split-operac) then do:
                       
          /*Caso o split que est† sendo alocado seja o 1o da operaá∆o correspondente, 
            atualiza o gm e ctrab e ferramenta*/  
                     
          FIND current oper-ord exclusive-lock NO-ERROR.
          if avail oper-ord then do:
              assign oper-ord.gm-codigo  = split-operac.gm-codigo
                     oper-ord.ferramenta = split-operac.cod-ferr-prod.

              &if defined(bf_man_205) &then
                   assign oper-ord.cod-recurso = split-operac.cod-ctrab.
              &elseif defined(bf_man_204) &then
                   assign OVERLAY(oper-ord.char-1,60,16) = split-operac.cod-ctrab.
              &endif     
              
              find current oper-ord no-lock no-error.

          end. 
     end. /*if not can-find(first bf-split-operac */
     
return "OK":U.
end procedure.       

&IF DEFINED(bf_man_204) &THEN
/*************************************************************************************************
**
** PROCEDURE: updateSplitOperac
** Objetivo:  Efetua diversas validaá‰es e modifica os dados do split.
              Chamada inicialmente da tela sf0311c.w
** ParÉmetro: input rowObject; output rowErrors
**      
*************************************************************************************************/
{inbo/boin260.i tt-oper-ord}
procedure updateSplitOperac:

  def input  param table for rowObject.
  def output param table for rowErrors. 
  
  def var h-boin260 as handle no-undo.

  empty temp-table rowErrors.
  
  find first rowObject no-error.
  if not avail rowObject then
      return "NOK":U.
      
  if rowObject.ind-estado-split >= 4 then do:
       /*Split da Operaá∆o n∆o pode ser alterado devido ao seu estado 32064*/
       run criaErro(input 32064,
                    input "":U).  
       return "NOK":U.             
  end.

  /***********VALIDAÄÂES*************/
  /*PAGINA 1*/
  IF rowObject.gm-codigo = "":U THEN DO:
       /*Grupo de M†quina em branco*/
      {utp/ut-liter.i Grupo_de_M†quina *}
      run criaErro(input 3145,
                   input return-value).          
  END.
  ELSE DO:
      FIND FIRST grup-maquina WHERE grup-maquina.gm-codigo = rowObject.gm-codigo NO-LOCK NO-ERROR.
      IF NOT AVAIL grup-maquina THEN DO:
          /*Nao encontrado Grupo de M†quina para a chave informada*/
          {utp/ut-liter.i Grupo_de_M†quina *}
          run criaErro(input 56,
                       input return-value).               
      END.
      ELSE DO:
          IF rowObject.cod-ctrab <> "":U THEN DO:
              FIND FIRST ctrab WHERE ctrab.cod-ctrab = rowObject.cod-ctrab NO-LOCK NO-ERROR.
              IF NOT AVAIL ctrab THEN DO:
                  /*Nao encontrado ctrab para a chave informada*/
                  {utp/ut-liter.i Centro_de_Trabalho *}
                  run criaErro(input 56,
                               input return-value).                    
              END.
              ELSE DO:
                  IF rowObject.gm-codigo <> ctrab.gm-codigo THEN DO:
                      /*Centro de Trabalho n∆o pertence ao Grupo de M†quina informado 28533*/
                      run criaErro(input 28533,
                                   input "":U).                         
                  END.
              END.
          END.
          find first split-operac where
                split-operac.nr-ord-produ     = rowObject.nr-ord-produ     and
                split-operac.num-operac-sfc   = rowObject.num-operac-sfc and
                split-operac.num-split-operac = rowObject.num-split-operac no-lock no-error.
		  find first oper-ord no-lock
		   where oper-ord.nr-ord-produ = split-operac.nr-ord-produ
		   and oper-ord.it-codigo = split-operac.it-codigo no-error.
          if avail split-operac and
          split-operac.gm-codigo <> rowObject.gm-codigo and rowObject.gm-codigo <> oper-ord.gm-codigo then do:
                if not can-find(first grup-maq-altern where
                        grup-maq-altern.gm-codigo = split-operac.gm-codigo and
                        grup-maq-altern.gm-altern  = rowObject.gm-codigo) then do:
                        /* Grupo de maquina selecionado n∆o Ç alternativo do grupo de maquina anterior do split */
                        {utp/ut-liter.i Grupo_de_Maquina_Selecionado_n∆o_Ç_alternativo_do_anterior *}
                        run criaErro(input 17006,
                                     input return-value).
                end.
          end.
      END.
  END.
  
  /*PµGINA 3*/
  /********************Quadro IMC FMT*****************************/
  IF rowObject.dat-imc = ? THEN DO:
      /*Data in°cio mais cedo deve ser informada*/
      {utp/ut-liter.i Data_In°cio_Mais_Cedo *}
      run criaErro(input 31044,
                   input RETURN-VALUE).       
  END.

  IF rowObject.dat-fmt = ? THEN DO:
      /*Data fim mais tarde deve ser informada*/
      {utp/ut-liter.i Data_TÇrmino_Mais_Tarde *}
      run criaErro(input 31044,
                   input RETURN-VALUE).      
  END.

  IF rowObject.qtd-segs-imc = ? THEN DO:                                
      /*Hora inicio mais cedo deve ser informada*/          
      {utp/ut-liter.i Hora_In°cio_Mais_Cedo *}   
      run criaErro(input 31044,
                   input RETURN-VALUE).                    
  END.                                                      
                                                            
  IF rowObject.qtd-segs-fmt = ? THEN DO:                                
      /*Hora inicio mais cedo deve ser informada*/          
      {utp/ut-liter.i Hora_TÇrmino_Mais_Tarde *}            
      run criaErro(input 31044,
                   input RETURN-VALUE).                                    
  END.                                                      
                                                         
  IF rowObject.qtd-segs-imc > 86399 /*23.59*/ THEN DO:                            
      /*Hora inicio mais cedo deve ser menor q 24*/         
      {utp/ut-liter.i Hora_In°cio_Mais_Cedo *}  
      run criaErro(input 16445,
                   input RETURN-VALUE + "~~":U + "24:00":U).                                             
  END.                                                      
                                                            
  IF rowObject.qtd-segs-fmt > 86399 /*23.59*/ THEN DO:                            
      /*Hora inicio mais cedo deve ser menor q 24*/         
      {utp/ut-liter.i Hora_TÇrmino_Mais_Tarde *}   
      run criaErro(input 16445,
                   input RETURN-VALUE + "~~":U + "24:00":U).                                         
  END.       
  
  /********************Quadro In°cio Disponibilidade Alocacao********************/

  IF rowObject.dat-progda-inic-setup > rowObject.dat-progda-fim-operac THEN DO:
      {utp/ut-liter.i Data_TÇrmino_Disponibilidade(Alocaá∆o) *}
      ASSIGN c-aux = RETURN-VALUE.
      {utp/ut-liter.i Data_In°cio_Disponibilidade(Alocaá∆o) *}
      run criaErro(input 7395,
                   input c-aux + "~~":U + RETURN-VALUE).        
  END.                                                                                                      
                                                            
  IF rowObject.qtd-segs-progdo-inic-operac > 86399 /*23.59*/ THEN DO:                            
      /*Hora inicio mais cedo deve ser menor q 24*/         
      {utp/ut-liter.i Hora_In°cio_Disponibilidade(Alocaá∆o) *}  
      run criaErro(input 16445,
                   input RETURN-VALUE  + "~~":U +  "24:00":U).                                             
  END.                                                      

  IF rowObject.qtd-segs-progdo-fim-operac > 86399 /*23.59*/ THEN DO:                            
      /*Hora inicio mais cedo deve ser menor q 24*/         
      {utp/ut-liter.i Hora_TÇrmino_Disponibilidade(Alocaá∆o) *}   
      run criaErro(input 16445,
                   input RETURN-VALUE  + "~~":U +  "24:00":U).                                          
  END.       

  IF (rowObject.dat-progda-inic-setup <> ? or  rowObject.dat-progda-fim-operac <> ?) and
     (rowObject.dat-progda-inic-setup = rowObject.dat-progda-fim-operac AND 
      rowObject.qtd-segs-progdo-fim-operac <= rowObject.qtd-segs-progdo-inic-operac) THEN DO:
      /*Se a data for a mesma, a hora termino mais tarde dever† ser maior que a hora inicio mais cedo 1207*/
      {utp/ut-liter.i Hora_TÇrmino_Disponibilidade(Alocaá∆o) *}
      ASSIGN c-aux = RETURN-VALUE.
      {utp/ut-liter.i Hora_In°cio_Disponibilidade(Alocaá∆o) *}
      run criaErro(input 1207,
                   input c-aux + "~~":U + RETURN-VALUE).            
  END.
  
  if can-find(first rowErrors) then
      return "NOK":U.
      
  /*Grava os novos gm-codigo, cod-ctrab, ferramenta e cod-area-produc*/
  assign l-updateSplitOperac = yes. /*indica que a alocarCtrab vai ser chamada daqui, 
                                     ent∆o ir† fazer alguns tratamentos diferenciados.*/                               
  run alocarCtrab(input rowObject.r-rowid,
                  input rowObject.gm-codigo,
                  input rowObject.cod-ctrab,
                  input rowObject.cod-ferr-prod,
                  output table rowErrors).
                     
  if can-find(first rowErrors) then 
      return "NOK":U.

  /*Efetiva a gravaá∆o dos demais dados*/  
  find current split-operac exclusive-lock no-error.
  buffer-copy rowObject except gm-codigo cod-ctrab cod-area-produc cod-ferr-prod to split-operac.
  find current split-operac no-lock no-error.

  RUN inbo/boin260.p PERSISTENT SET h-boin260.
  RUN openQueryStatic IN h-boin260 (INPUT "Main":U).
  RUN goToKey IN h-boin260 (INPUT rowObject.nr-ord-produ,
                            INPUT rowObject.it-codigo,
                            INPUT rowObject.cod-roteiro,
                            INPUT rowObject.op-codigo).
                          
  IF RETURN-VALUE = "OK":U THEN DO:
      EMPTY TEMP-TABLE tt-oper-ord.
      RUN getRecord IN h-boin260 (OUTPUT TABLE tt-oper-ord).
      FIND FIRST tt-oper-ord  NO-ERROR.
      IF AVAIL tt-oper-ord THEN DO:
          &IF DEFINED(bf_man_207) &THEN
              ASSIGN tt-oper-ord.val-perc-refugo = rowObject.val-perc-refugo
                     tt-oper-ord.val-perc-retrab = rowObject.val-perc-retrab.
          &ELSE
              ASSIGN OVERLAY(tt-oper-ord.char-1,100,5) = SUBSTRING(rowObject.char-1,100,5)
                     OVERLAY(tt-oper-ord.char-1,105,5) = SUBSTRING(rowObject.char-1,105,5).
          &ENDIF
      END.
      RUN setRecord IN h-boin260 (INPUT TABLE tt-oper-ord).
      RUN updateRecord IN h-boin260.
  END.
  DELETE PROCEDURE h-boin260.

  return "OK":U.
end procedure.

procedure setaOnLine:
assign l-on-line = yes.

return "OK":U.
end procedure.

&endif. /*204*/
