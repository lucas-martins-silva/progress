
PROCEDURE consistNotaTerceiros :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input param piSerie        like nota-fiscal.serie          no-undo.
    def input param piNrNotaFis    like nota-fiscal.nr-nota-fis    no-undo.
    def input param piNatOperacao  like nota-fiscal.nat-operacao   no-undo.
    def input param piDtEmissao    like docum-est.dt-emissao       no-undo.
    
    def var i-tipo-sal-terc        as int                          no-undo.
    
    def buffer b-natur-oper for natur-oper.
    
    if  not avail RowObject then 
        RETURN "NOK":U.
       

    /* Se USA multiplas naturezas no recebimento... */
    IF  l-mult-natur-receb THEN DO: /* l-mult-natur-receb -> def em cd9701.i */

        run findNaturOper ( RowObject.nat-operacao ).
    
        /* Atualiza I-TIPO-SAL-TERC */
        {inbo/boin404.i2 natur-oper.tipo
                         natur-oper.tp-oper-terc
                         natur-oper.transf }

        FOR EACH saldo-terc
            FIELDS ( cod-emitente  nro-docto  serie-docto nat-operacao 
                     tipo-sal-terc dt-retorno it-codigo   sequencia 
                     cod-estabel log-entreg-fut)
            WHERE saldo-terc.cod-estabel  = RowObject.cod-estabel
              AND saldo-terc.cod-emitente = RowObject.cod-emitente
              AND saldo-terc.nro-docto    = piNrNotaFis
              AND saldo-terc.serie-docto  = piSerie NO-LOCK. /* N∆o consiste a natureza... */

            IF saldo-terc.tipo-sal-terc <> i-tipo-sal-terc THEN
                NEXT.
            ELSE DO:
                LEAVE.
            END.

        END.
    END.
    ELSE DO:
        FOR FIRST saldo-terc
            FIELDS ( cod-emitente  nro-docto  serie-docto nat-operacao 
                     tipo-sal-terc dt-retorno it-codigo   sequencia 
                     cod-estabel log-entreg-fut)
            WHERE saldo-terc.cod-estabel  = RowObject.cod-estabel
              AND saldo-terc.cod-emitente = RowObject.cod-emitente
              AND saldo-terc.nro-docto    = piNrNotaFis
              AND saldo-terc.serie-docto  = piSerie
              AND saldo-terc.nat-operacao = piNatOperacao NO-LOCK.
        END.
    END.

    if  not avail saldo-terc then do:
        /* Inicio -- Projeto Internacional */
        {utp/ut-table.i movind saldo-terc 1} /* Busca o label da tabela */
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U 
                            &ErrorParameters=TRIM(RETURN-VALUE)}
         RETURN "NOK":U.                             
    end.
    
    IF NOT CAN-FIND(FIRST movto-estoq
                WHERE movto-estoq.serie-docto  = saldo-terc.serie-docto          
                AND   movto-estoq.nro-docto    = saldo-terc.nro-docto           
                AND   movto-estoq.nat-operacao = saldo-terc.nat-operacao         
                AND   movto-estoq.cod-emitente = saldo-terc.cod-emitente 
                AND   movto-estoq.it-codigo    = saldo-terc.it-codigo    
                AND   movto-estoq.sequen-nf    = saldo-terc.sequencia) THEN DO:
        /* NECESSARIO ESSE FIND PARA ENCONTRAR O DOCUMENTO DE ORIGEM DA OPER. TRIANGULAR (POSICAO DE COMPRADOR) */
        FIND FIRST item-doc-est 
             WHERE item-doc-est.cod-emit-terc    = saldo-terc.cod-emitente
               AND item-doc-est.serie-terc       = saldo-terc.serie-docto
               AND item-doc-est.nro-docto-terc   = saldo-terc.nro-docto
               AND item-doc-est.nat-terc         = saldo-terc.nat-operacao
               AND item-doc-est.seq-terc         = saldo-terc.sequencia
               AND item-doc-est.it-codigo        = saldo-terc.it-codigo NO-LOCK NO-ERROR.
        IF AVAIL item-doc-est THEN DO:
            FIND FIRST docum-est 
                 WHERE docum-est.serie-docto  = item-doc-est.serie-docto
                   AND docum-est.nro-docto    = item-doc-est.nro-docto
                   AND docum-est.cod-emitente = item-doc-est.cod-emitente
                   AND docum-est.nat-operacao = item-doc-est.nat-operacao NO-LOCK NO-ERROR.
            IF AVAIL docum-est THEN DO:
                assign gl-natOperTr = piNatOperacao. 
                IF piDtEmissao < docum-est.dt-emissao THEN DO:
                    {method/svc/errors/inserr.i
                                       &ErrorNumber="35859"
                                       &ErrorType="EMS":U
                                       &ErrorSubType="ERROR":U 
                                       &ErrorParameters="STRING(piDtEmissao) + '~~~~' + STRING(docum-est.dt-emissao)"}
                     RETURN "NOK":U. 
                END.
            END.
        END.
        ELSE DO:

            /* procura se h· uma nota lanÁada com a natureza complementar */
            FIND FIRST item-doc-est WHERE
                       item-doc-est.serie-docto  = saldo-terc.serie-docto  AND
                       item-doc-est.nro-docto    = saldo-terc.nro-docto    AND
                       item-doc-est.cod-emitente = saldo-terc.cod-emitente AND
                       item-doc-est.sequencia    = saldo-terc.sequencia    AND
                       item-doc-est.it-codigo    = saldo-terc.it-codigo    AND
                       item-doc-est.nat-comp     = saldo-terc.nat-operacao NO-LOCK NO-ERROR.
            IF AVAIL item-doc-est THEN DO:
            
                FOR FIRST docum-est OF item-doc-est NO-LOCK:

                    /* SALDO TERC IMPLANTADO MANUALMENTE */
                    IF piDtEmissao < docum-est.dt-emissao THEN DO:
                         {method/svc/errors/inserr.i
                                            &ErrorNumber="35859"
                                            &ErrorType="EMS":U
                                            &ErrorSubType="ERROR":U 
                                            &ErrorParameters="STRING(piDtEmissao) + '~~~~' + STRING(docum-est.dt-emissao)"}
                         RETURN "NOK":U.
        
                    END.
                END. 
            END.
            ELSE IF piDtEmissao < saldo-terc.dt-retorno THEN DO: /* SALDO TERC IMPLANTADO MANUALMENTE */

                 {method/svc/errors/inserr.i
                                    &ErrorNumber="35859"
                                    &ErrorType="EMS":U
                                    &ErrorSubType="ERROR":U 
                                    &ErrorParameters="STRING(piDtEmissao) + '~~~~' + STRING(saldo-terc.dt-retorno)"}
                 RETURN "NOK":U.

            END.
        END.
    END.
    ELSE IF saldo-terc.nat-operacao BEGINS "1" OR
       saldo-terc.nat-operacao      BEGINS "2" OR
       saldo-terc.nat-operacao      BEGINS "3" THEN DO:
        /* SALDO TERC IMPLANTADO PELO RECEBIMENTO */
        FIND FIRST docum-est 
             WHERE docum-est.cod-emitente = saldo-terc.cod-emitente
               AND docum-est.serie-docto  = saldo-terc.serie-docto
               AND docum-est.nro-docto    = saldo-terc.nro-docto
               AND docum-est.nat-operacao = saldo-terc.nat-operacao NO-LOCK NO-ERROR.
        IF AVAIL docum-est THEN DO:
            IF piDtEmissao < docum-est.dt-emissao THEN DO:
                {method/svc/errors/inserr.i
                                   &ErrorNumber="35859"
                                   &ErrorType="EMS":U
                                   &ErrorSubType="ERROR":U 
                                   &ErrorParameters="STRING(piDtEmissao) + '~~~~' + STRING(docum-est.dt-emissao)"}
                 RETURN "NOK":U. 
            END.
        END.
        
    END.
    ELSE IF saldo-terc.nat-operacao BEGINS "5" OR
       saldo-terc.nat-operacao      BEGINS "6" OR
       saldo-terc.nat-operacao      BEGINS "7" THEN DO:
        /* SALDO TERC IMPLANTADO PELO FATURAMENTO */
        FIND FIRST nota-fiscal
             WHERE nota-fiscal.cod-estabel = saldo-terc.cod-estabel
               AND nota-fiscal.serie       = saldo-terc.serie-docto
               AND nota-fiscal.nr-nota-fis = saldo-terc.nro-docto NO-LOCK NO-ERROR.
        IF AVAIL nota-fiscal THEN DO:
            IF piDtEmissao < nota-fiscal.dt-emis-nota THEN DO:
                {method/svc/errors/inserr.i
                                   &ErrorNumber="35859"
                                   &ErrorType="EMS":U
                                   &ErrorSubType="ERROR":U 
                                   &ErrorParameters="STRING(piDtEmissao) + '~~~~' + STRING(nota-fiscal.dt-emis-nota)"}
                 RETURN "NOK":U. 
            END.
        END.

    END.


    run findNaturOper ( RowObject.nat-operacao ).
    

    /* Atualiza I-TIPO-SAL-TERC */
    {inbo/boin404.i2 natur-oper.tipo
                     natur-oper.tp-oper-terc
                     natur-oper.transf }
                             

    if  saldo-terc.tipo-sal-terc <> i-tipo-sal-terc then do:
        {method/svc/errors/inserr.i
                            &ErrorNumber="27614"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U}
        RETURN "NOK":U.                
    end.
    
    /*--- identifica se a natureza do docum-est eh fatura faturamento antecipado, 
          remessa faturamento antecipado, fatura ent futura ou remessa ent futura ---*/
    run defineFatAntecipEntFutura(buffer natur-oper,
                                  output l-fatura-fat-antecip,
                                  output l-remessa-fat-antecip,
                                  output l-fatura-ent-futura,
                                  output l-remessa-ent-futura).

    if  l-remessa-ent-futura 
    and saldo-terc.log-entreg-fut = no then do:
        /* Inicio -- Projeto Internacional */
        DEFINE VARIABLE c-lbl-liter-documento-informado-nao-e-uma AS CHARACTER NO-UNDO.
        {utp/ut-liter.i "Documento_informado_n∆o_Ç_uma_fatura_de_entrega_futura" *}
        ASSIGN c-lbl-liter-documento-informado-nao-e-uma = TRIM(RETURN-VALUE).
        {method/svc/errors/inserr.i
                           &ErrorNumber="17006"
                           &ErrorType="EMS":U
                           &ErrorSubType="ERROR":U 
                           &ErrorParameters="c-lbl-liter-documento-informado-nao-e-uma"}
         RETURN "NOK":U.             
    end.
    
    if  l-remessa-ent-futura = no
    and saldo-terc.log-entreg-fut then do:
        /* Inicio -- Projeto Internacional */
        DEFINE VARIABLE c-lbl-liter-documento-informado-nao-pode-s AS CHARACTER NO-UNDO.
        {utp/ut-liter.i "Documento_informado_n∆o_pode_ser_uma_fatura_de_entrega_futura" *}
        ASSIGN c-lbl-liter-documento-informado-nao-pode-s = TRIM(RETURN-VALUE).
        {method/svc/errors/inserr.i
                           &ErrorNumber="17006"
                           &ErrorType="EMS":U
                           &ErrorSubType="ERROR":U 
                           &ErrorParameters="c-lbl-liter-documento-informado-nao-pode-s"}
         RETURN "NOK":U. 
    end.

    RETURN "OK":U.                                

END PROCEDURE.





