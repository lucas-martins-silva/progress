&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice matriz
  Parameters:  
               recebe valor do campo nr-contrato
               recebe valor do campo ct-codigo e sc-codigo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pnr-contrato LIKE matriz-rat-contr.nr-contrato NO-UNDO.
    DEFINE INPUT PARAMETER pct-codigo   LIKE matriz-rat-contr.ct-codigo   NO-UNDO.
    DEFINE INPUT PARAMETER psc-codigo   LIKE matriz-rat-contr.sc-codigo   NO-UNDO.    

    FIND FIRST bfmatriz-rat-contr WHERE 
        bfmatriz-rat-contr.nr-contrato = pnr-contrato AND 
        bfmatriz-rat-contr.ct-codigo   = pct-codigo   AND
        bfmatriz-rat-contr.sc-codigo   = psc-codigo  NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfmatriz-rat-contr THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfmatriz-rat-contr)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

