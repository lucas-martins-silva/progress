PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice matriz
  Parameters:  
               retorna valor do campo nr-contrato
               retorna valor do campo ct-codigo e sc-codigo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pnr-contrato LIKE matriz-rat-contr.nr-contrato NO-UNDO.
    DEFINE OUTPUT PARAMETER pct-codigo   LIKE matriz-rat-contr.ct-codigo   NO-UNDO.
    DEFINE OUTPUT PARAMETER psc-codigo   LIKE matriz-rat-contr.sc-codigo   NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pnr-contrato = RowObject.nr-contrato
           pct-codigo   = RowObject.ct-codigo
           psc-codigo   = RowObject.sc-codigo.

    RETURN "OK":U.
END PROCEDURE.

