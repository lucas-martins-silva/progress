PROCEDURE setQtdeUnTributavelIS:
    DEFINE INPUT PARAMETER pQuantidade   LIKE item-doc-est.quantidade     NO-UNDO.
    DEFINE INPUT PARAMETER pSeqItemXml   LIKE item-doc-imp-nfe.seq-item   NO-UNDO.
    DEFINE INPUT PARAMETER pNatOf        LIKE item-doc-est.nat-of         NO-UNDO.
    
    DEF BUFFER b-natur-oper-fisc FOR natur-oper. 
    
    DEF VAR de-indice-is    AS DECIMAL INITIAL 1                    NO-UNDO.
    DEF VAR de-qtde-tribut  LIKE item-doc-est.quantidade            NO-UNDO.
    DEF VAR c-estabel       AS CHARACTER                            NO-UNDO.
    
    IF NOT AVAIL docum-est THEN
        RUN findDocumento ( RowObject.Cod-Emitente,
                            RowObject.Serie-Docto,
                            RowObject.Nro-Docto,
                            RowObject.Nat-Operacao ).

    IF NOT AVAIL item                                         OR
       (avail item and item.it-codigo <> RowObject.it-codigo) THEN
        RUN findItem (RowObject.it-codigo).
    
    /* Se usa multiplas naturezas no recebimento busca natureza fiscal do item */
    IF  l-mult-natur-receb THEN /* Natureza fiscal do Item */
        FIND FIRST b-natur-oper-fisc WHERE b-natur-oper-fisc.nat-operacao = pNatOf NO-LOCK NO-ERROR.
    
    /* Se nÆo usa multiplas naturezas ou usa mas a nota ‚ antiga (digit. antes de marcar o parƒm.) */
    IF  NOT AVAIL b-natur-oper-fisc THEN /* Natureza de opera‡Æo do documento */
        FIND FIRST b-natur-oper-fisc WHERE b-natur-oper-fisc.nat-operacao = RowObject.nat-operacao NO-LOCK NO-ERROR.

    ASSIGN l-utilizaImpostoMonitor = NO.
    
    RUN utilizaImpostosMonitorRecFiscal (INPUT RowObject.serie-docto,
                                         INPUT RowObject.nro-docto,
                                         INPUT RowObject.cod-emitente,
                                         INPUT RowObject.nat-operacao,
                                         INPUT pSeqItemXml,
                                         OUTPUT l-utilizaImpostoMonitor).
    
    IF NOT VALID-HANDLE (h-boin090) THEN 
       RUN getDocumEst (docum-est.cod-emitente,   
                        docum-est.serie-docto,
                        docum-est.nro-docto,
                        docum-est.nat-operacao).

    RUN isMultaJuros in h-boin090 ( INPUT b-natur-oper-fisc.nat-operacao,
                                   OUTPUT l-multa-juros).
    
    IF  l-NT2024002 AND
        NOT l-utilizaImpostoMonitor AND
        ((b-natur-oper-fisc.tipo-compra = 3 AND RowObject.nro-comp <> "") OR 
         b-natur-oper-fisc.tipo-compra = 8 OR /*devol transf*/
         b-natur-oper-fisc.transf OR
         b-natur-oper-fisc.tp-oper-terc = 2   OR /*Retorno Beneficiamento*/
         b-natur-oper-fisc.tp-oper-terc = 9   OR /*Retorno Dep Fechado*/
         b-natur-oper-fisc.tp-oper-terc = 4   OR /*faturamento consigna‡Æo da remessa consigna‡Æo*/
         b-natur-oper-fisc.tp-oper-terc = 5   OR /*Devolu‡Æo Consign‡Æo*/
         b-natur-oper-fisc.tp-oper-terc = 11) OR /*Retorno Armaz‚m Geral*/ 
        (l-multa-juros AND RowObject.nro-comp <> "") THEN DO:
        
        IF b-natur-oper-fisc.transf then  
            ASSIGN c-estabel = docum-est.estab-de-or.
        ELSE 
            ASSIGN c-estabel = docum-est.cod-estabel.
        
        RUN copiarQtdeUnTributISNFOrig (INPUT pQuantidade,
                                        INPUT b-natur-oper-fisc.tp-oper-terc,
                                        INPUT c-estabel).
    END.                  
    
    IF l-NT2024002 AND
       NOT l-utilizaImpostoMonitor  AND
       (SUBSTRING(item.char-1,289,1) = "S" AND   /*Incide IS*/
        SUBSTRING(item.char-1,290,2) <> "") AND  /*Unidade de medida tribut vel IS*/
       ((b-natur-oper-fisc.tipo-compra <> 3  AND 
         b-natur-oper-fisc.tipo-compra <> 8 AND /*devol transf*/
         NOT b-natur-oper-fisc.transf AND
         NOT l-multa-juros AND
         b-natur-oper-fisc.tp-oper-terc <> 2   AND /*Retorno Beneficiamento*/
         b-natur-oper-fisc.tp-oper-terc <> 9   AND /*Retorno Dep Fechado*/
         b-natur-oper-fisc.tp-oper-terc <> 4   AND /*faturamento consigna‡Æo da remessa consigna‡Æo*/
         b-natur-oper-fisc.tp-oper-terc <> 5   AND /*Devolu‡Æo Consign‡Æo*/
         b-natur-oper-fisc.tp-oper-terc <> 11) OR /*Retorno Armaz‚m Geral*/
        (b-natur-oper-fisc.tipo-compra = 3 AND RowObject.nro-comp = "") OR
        (l-multa-juros AND RowObject.nro-comp = "") ) THEN DO:    
        
        IF item.un <> SUBSTRING(item.char-1,290,2) THEN DO:
            FOR FIRST tab-conv-un NO-LOCK
                WHERE tab-conv-un.un           = item.un
                  AND tab-conv-un.unid-med-for = SUBSTRING(item.char-1,290,2):

                ASSIGN de-indice-is = tab-conv-un.fator-conver / IF tab-conv-un.num-casa-dec = 0 THEN 1
                                                                 ELSE EXP(10,tab-conv-un.num-casa-dec).
            
            END.
        END.
        
        ASSIGN de-qtde-tribut = pQuantidade * de-indice-is.
        
        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:QTDE-TRIBUT,   INPUT STRING(de-qtde-tribut)).
        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:UN-TRIBUT,     INPUT SUBSTRING(item.char-1,290,2)).
    END.
    
    RETURN "OK":U.
END.

/*------------------------------------------------------------------------
    Procedure: getQtdeUnTributavelIS
    Objetivo : Devolver a quantidade tributavel e unidade de medida 
               tributavel do IS do item gerado na temp-table tt-item-doc-est-tribut.
------------------------------------------------------------------------*/
PROCEDURE getQtdeUnTributavelIS:
    DEFINE OUTPUT PARAMETER pQtdeTribut  LIKE item-doc-est.quantidade   NO-UNDO.
    DEFINE OUTPUT PARAMETER pUnTribut    LIKE item-doc-est.un           NO-UNDO.
    
    ASSIGN pQtdeTribut = 0
           pUnTribut   = "".

    FOR EACH tt-item-doc-est-tribut NO-LOCK
       WHERE tt-item-doc-est-tribut.cod-serie-docto  = RowObject.serie-docto
         AND tt-item-doc-est-tribut.cod-num-docto    = RowObject.nro-docto
         AND tt-item-doc-est-tribut.cdn-emitente     = RowObject.cod-emitente
         AND tt-item-doc-est-tribut.cod-natur-operac = RowObject.nat-operacao
         AND tt-item-doc-est-tribut.num-seq          = RowObject.sequencia
         AND tt-item-doc-est-tribut.nom-trib         = rep.imp.Imposto:IS:
          
        CASE tt-item-doc-est-tribut.cod-campo:
            WHEN AtributoImposto:QTDE-TRIBUT THEN ASSIGN pQtdeTribut = DEC(tt-item-doc-est-tribut.cod-conteudo).
            WHEN AtributoImposto:UN-TRIBUT   THEN ASSIGN pUnTribut   = tt-item-doc-est-tribut.cod-conteudo.
        END CASE.
    END.
    RETURN "OK":U.
END.

PROCEDURE copiarQtdeUnTributISNFOrig:
    DEFINE INPUT PARAMETER pQuantidade   LIKE item-doc-est.quantidade     NO-UNDO.
    DEFINE INPUT PARAMETER pTpOperTerc   LIKE natur-oper.tp-oper-terc     NO-UNDO.
    DEFINE INPUT PARAMETER pEstabel      LIKE docum-est.cod-estabel       NO-UNDO.
            
    DEF VAR de-qtde-tribut  LIKE item-doc-est.quantidade            NO-UNDO.
    
    DEF BUFFER b-item-doc-est FOR item-doc-est. 
    
    ASSIGN de-qtde-tribut = 0.

    IF pTpOperTerc = 4  /*Faturamento de consigna‡Æo*/
    OR (l-multa-juros AND RowObject.nro-comp <> "") THEN DO:
        FOR FIRST item-doc-est-tribut NO-LOCK
            WHERE item-doc-est-tribut.cod-serie-docto  = RowObject.serie-comp 
              AND item-doc-est-tribut.cod-num-docto    = RowObject.nro-comp   
              AND item-doc-est-tribut.cdn-emitente     = RowObject.cod-emitente
              AND item-doc-est-tribut.cod-natur-operac = RowObject.nat-comp 
              AND item-doc-est-tribut.num-seq          = RowObject.seq-comp
              AND item-doc-est-tribut.nom-trib         = rep.imp.Imposto:IS
              AND item-doc-est-tribut.cod-campo        = AtributoImposto:QTDE-TRIBUT:
                   
            IF DEC(item-doc-est-tribut.cod-conteudo) > 0 THEN DO:
               FOR FIRST b-item-doc-est NO-LOCK
                   WHERE b-item-doc-est.serie-docto  = item-doc-est-tribut.cod-serie-docto
                     AND b-item-doc-est.nro-docto    = item-doc-est-tribut.cod-num-docto
                     AND b-item-doc-est.cod-emitente = item-doc-est-tribut.cdn-emitente
                     AND b-item-doc-est.nat-operacao = item-doc-est-tribut.cod-natur-operac
                     AND b-item-doc-est.sequencia    = item-doc-est-tribut.num-seq:
              
                  ASSIGN de-qtde-tribut = ROUND((DEC(item-doc-est-tribut.cod-conteudo) / b-item-doc-est.quantidade * pQuantidade), 2).
                   
                  RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:QTDE-TRIBUT, INPUT STRING(de-qtde-tribut)).
               END.
            END.
        END. 
        
        /*S¢ gravar a Unidade Tribut vel se tiver Qtde Tribut vel*/
        IF de-qtde-tribut > 0 THEN DO:
            FOR FIRST item-doc-est-tribut NO-LOCK
                WHERE item-doc-est-tribut.cod-serie-docto  = RowObject.serie-comp 
                  AND item-doc-est-tribut.cod-num-docto    = RowObject.nro-comp   
                  AND item-doc-est-tribut.cdn-emitente     = RowObject.cod-emitente
                  AND item-doc-est-tribut.cod-natur-operac = RowObject.nat-comp 
                  AND item-doc-est-tribut.num-seq          = RowObject.seq-comp
                  AND item-doc-est-tribut.nom-trib         = rep.imp.Imposto:IS
                  AND item-doc-est-tribut.cod-campo        = AtributoImposto:UN-TRIBUT:
                  
                RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:UN-TRIBUT, INPUT item-doc-est-tribut.cod-conteudo).
            END.
        END.

    END.
    ELSE DO:
        FOR FIRST it-nota-fisc-trib NO-LOCK 
            WHERE it-nota-fisc-trib.cod-estabel = pEstabel
              AND it-nota-fisc-trib.serie       = RowObject.serie-comp
              AND it-nota-fisc-trib.nr-nota-fis = RowObject.nro-comp
              AND it-nota-fisc-trib.nr-seq-fat  = RowObject.seq-comp
              AND it-nota-fisc-trib.it-codigo   = RowObject.it-codigo
              AND it-nota-fisc-trib.tip-tributo = 4:
             
            IF it-nota-fisc-trib.qtde-tribut > 0 THEN DO:
                FOR FIRST it-nota-fisc NO-LOCK
                    WHERE it-nota-fisc.cod-estabel = it-nota-fisc-trib.cod-estabel
                      AND it-nota-fisc.serie       = it-nota-fisc-trib.serie
                      AND it-nota-fisc.nr-nota-fis = it-nota-fisc-trib.nr-nota-fis
                      AND it-nota-fisc.nr-seq-fat  = it-nota-fisc-trib.nr-seq-fat
                      AND it-nota-fisc.it-codigo   = it-nota-fisc-trib.it-codigo:   

                    ASSIGN de-qtde-tribut = ROUND((it-nota-fisc-trib.qtde-tribut / it-nota-fisc.qt-faturada[1] * pQuantidade), 2).                 
                    
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:QTDE-TRIBUT,   INPUT STRING(de-qtde-tribut)).
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, INPUT AtributoImposto:UN-TRIBUT,     INPUT it-nota-fisc-trib.unid-med-tribut).
                    
                END.
            END.
        END.
    END.
    RETURN "OK":U.
END PROCEDURE.
