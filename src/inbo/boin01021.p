&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram  
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice peso_id2
  Parameters:  
               recebe valor do campo cod-estabel
               recebe valor do campo it-codigo
               recebe valor do campo cod-exame
               recebe valor do campo cod-comp
               recebe valor do campo cdn-seq
               recebe valor do campo cdn-period
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-estabel LIKE peso-period.cod-estabel NO-UNDO.
    DEFINE INPUT PARAMETER pit-codigo LIKE peso-period.it-codigo NO-UNDO.
    DEFINE INPUT PARAMETER pcod-exame LIKE peso-period.cod-exame NO-UNDO.
    DEFINE INPUT PARAMETER pcod-comp LIKE peso-period.cod-comp NO-UNDO.
    DEFINE INPUT PARAMETER pcdn-seq LIKE peso-period.cdn-seq NO-UNDO.
    DEFINE INPUT PARAMETER pcdn-period LIKE peso-period.cdn-period NO-UNDO.

    FIND FIRST bfpeso-period WHERE 
        bfpeso-period.cod-estabel = pcod-estabel AND 
        bfpeso-period.it-codigo = pit-codigo AND 
        bfpeso-period.cod-exame = pcod-exame AND 
        bfpeso-period.cod-comp = pcod-comp AND 
        bfpeso-period.cdn-seq = pcdn-seq AND 
        bfpeso-period.cdn-period = pcdn-period NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfpeso-period THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfpeso-period)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/
    
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

