&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getKey DBOProgram  
PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice peso_id2
  Parameters:  
               retorna valor do campo cod-estabel
               retorna valor do campo it-codigo
               retorna valor do campo cod-exame
               retorna valor do campo cod-comp
               retorna valor do campo cdn-seq
               retorna valor do campo cdn-period
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pcod-estabel LIKE peso-period.cod-estabel NO-UNDO.
    DEFINE OUTPUT PARAMETER pit-codigo LIKE peso-period.it-codigo NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-exame LIKE peso-period.cod-exame NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-comp LIKE peso-period.cod-comp NO-UNDO.
    DEFINE OUTPUT PARAMETER pcdn-seq LIKE peso-period.cdn-seq NO-UNDO.
    DEFINE OUTPUT PARAMETER pcdn-period LIKE peso-period.cdn-period NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pcod-estabel = RowObject.cod-estabel
           pit-codigo = RowObject.it-codigo
           pcod-exame = RowObject.cod-exame
           pcod-comp = RowObject.cod-comp
           pcdn-seq = RowObject.cdn-seq
           pcdn-period = RowObject.cdn-period.

    RETURN "OK":U.
END PROCEDURE.

