&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateSomaPesos DBOProgram 
PROCEDURE validateSomaPesos :
/*------------------------------------------------------------------------------
  Purpose: Validar se a soma dos pesos È 100    
  Parameters:  TT que ser· efetivada no banco
------------------------------------------------------------------------------*/
    
    DEFINE INPUT  PARAM TABLE FOR tt-peso-period.
    DEFINE VARIABLE i-soma AS INTEGER NO-UNDO.

    FOR EACH tt-peso-period:

        ASSIGN i-soma = i-soma + tt-peso-period.val-peso.

    END.
   
    IF i-soma = 100 THEN
        RETURN "OK":U.
    ELSE
        RETURN "NOK":U.    

END PROCEDURE.
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getTTByParent DBOProgram 
PROCEDURE getTTByParent :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

DEFINE INPUT  PARAM p-cod-estabel LIKE {&TableName}.cod-estabel NO-UNDO.
DEFINE INPUT  PARAM p-it-codigo   LIKE {&TableName}.it-codigo   NO-UNDO.
DEFINE INPUT  PARAM p-cod-exame   LIKE {&TableName}.cod-exame   NO-UNDO.
DEFINE INPUT  PARAM p-cod-comp    LIKE {&TableName}.cod-comp    NO-UNDO.
DEFINE INPUT  PARAM p-cdn-seq     LIKE {&TableName}.cdn-seq     NO-UNDO.
DEFINE OUTPUT PARAM TABLE FOR tt-peso-period.
    
    FOR EACH {&TableName} NO-LOCK
             WHERE {&TableName}.cod-estabel = p-cod-estabel
               AND {&TableName}.it-codigo   = p-it-codigo  
               AND {&TableName}.cod-exame   = p-cod-exame  
               AND {&TableName}.cod-comp    = p-cod-comp   
               AND {&TableName}.cdn-seq     = p-cdn-seq:

        CREATE tt-peso-period.
        ASSIGN tt-peso-period.cod-estabel = {&TableName}.cod-estabel
               tt-peso-period.it-codigo   = {&TableName}.it-codigo
               tt-peso-period.cod-exame   = {&TableName}.cod-exame
               tt-peso-period.cod-comp    = {&TableName}.cod-comp
               tt-peso-period.cdn-seq     = {&TableName}.cdn-seq
               tt-peso-period.cdn-period  = {&TableName}.cdn-period
               tt-peso-period.val-peso    = {&TableName}.val-peso.

    END.

    RETURN "OK":U.

END PROCEDURE.

