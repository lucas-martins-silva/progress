&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram  
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice oper-item-cons-pad
  Parameters:  
               recebe valor do campo nr-oper-pad
               recebe valor do campo it-consumo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pnr-oper-pad LIKE oper-item-cons-pad.nr-oper-pad NO-UNDO.
    DEFINE INPUT PARAMETER pit-consumo LIKE oper-item-cons-pad.it-consumo NO-UNDO.

    FIND FIRST bfoper-item-cons-pad WHERE 
        bfoper-item-cons-pad.nr-oper-pad = pnr-oper-pad AND 
        bfoper-item-cons-pad.it-consumo = pit-consumo NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfoper-item-cons-pad THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfoper-item-cons-pad)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
