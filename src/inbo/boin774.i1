/***********************************************************************************
* Temp-tables utilizadas na boin774.p e mla0170rp.p                                *
*                                                                                  *
* situacao: 'Mantido', 'Novo', 'Substitu¡do', 'Eliminado', 'Origem', 'Transferido' * 
* id-sit  :     1    ,    2  ,       3      ,       4    ,     5   ,       6       * 
* r-rowid : rowid do registro alterado,exclu¡do ou inserido.       ,               * 
***********************************************************************************/ 
DEFINE TEMP-TABLE tt-mla-perm-aprov-origem NO-UNDO LIKE mla-perm-aprov
    FIELD situacao AS CHAR FORMAT "x(20)"
    FIELD id-sit   AS INT
    FIELD r-rowid  AS ROWID
    INDEX codigo ep-codigo 
                 cod-estabel
                 cod-usuar 
                 cod-tip-doc  ASC
                 situacao.
                 
DEFINE TEMP-TABLE tt-mla-perm-aprov-destino NO-UNDO LIKE tt-mla-perm-aprov-origem.
