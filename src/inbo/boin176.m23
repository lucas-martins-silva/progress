PROCEDURE createItemOfPedido :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:   Cria o item da nota atrav²s do pedido/ordem de compra. 
           È executado apartir do re1001f.
------------------------------------------------------------------------------*/

    def input        param piConsDtEntrega  as logical          no-undo.
    def input-output param table            for tt-ordem-item.

    def var i-seq-aux           like item-doc-est.sequencia     no-undo.
    def var de-qtd-saldo        like item-doc-est.quantidade    no-undo.
    def var de-qtd-aux          like item-doc-est.quantidade    no-undo.
    def var i-num-ordem         like ordem-compra.numero-ordem  no-undo.
    def var i-num-pedido        like ordem-compra.num-pedido    no-undo.
    

    if  not avail docum-est then 
        RETURN "NOK":U.
        

    if  avail docum-est then    
        run findUsuario ( docum-est.usuario ).
    

    if  not avail param-re then 
        return "NOK":U.
    

    run openQueryStatic ( "Main" ).
    

    run emptyRowObject.             
 

    run getSeqItem ( output i-seq-aux ).

    bloco:
    do  trans on error undo, leave:

        for each tt-ordem-item 
           where tt-ordem-item.rw-item-doc-est = ? exclusive-lock:
        

            run findOrdemCompra ( input ?,
                                  input tt-ordem-item.rw-ordem-compra ).
                              

            run emptyRowObject.
                                              

            create RowObject.
            assign RowObject.num-pedido     = ordem-compra.num-pedido
                   RowObject.numero-ordem   = ordem-compra.numero-ordem
                   RowObject.cod-emitente   = docum-est.cod-emitente
                   RowObject.serie-docto    = docum-est.serie-docto
                   RowObject.nro-docto      = docum-est.nro-docto
                   RowObject.nat-operacao   = docum-est.nat-operacao
                   RowObject.sequencia      = i-seq-aux
                   RowObject.preco-total[1] = tt-ordem-item.preco-total
                   RowObject.aliquota-ipi   = tt-ordem-item.aliquota-ipi
                   RowObject.class-fiscal   = tt-ordem-item.class-fiscal
                   RowObject.cod-depos      = tt-ordem-item.cod-depos
                   i-seq-aux                = i-seq-aux + param-re.inc-seq.
            
            assign i-num-ordem  = ordem-compra.numero-ordem
                   i-num-pedido = ordem-compra.num-pedido.
            
            if  tt-ordem-item.quant-fornec <> 0 then 
                assign RowObject.qt-do-forn     = tt-ordem-item.quant-fornec.
            else                 
                assign RowObject.quantidade     = tt-ordem-item.quantidade.

            /* CHAMADA EPC - GRENDENE - UTILIZADA NOTA MATERIAL AGREGADO */
            {method/svc/custom/custom.i &Event = "beforeCreateItemOfPedido"}

            /* Seta Default Valores Ordem Compra */    
            run setDefaultsFields   in this-procedure.               
            

            /* Elimina Temp-Table de Erros */
            run emptyRowErrors      in this-procedure.
            

            /* Zera Informa»„es Ordem de Compra para Evitar Problemas na procedure 
                "validateRecord" e Calcula Fator de Convers’o */
                

            assign RowObject.int-2        = RowObject.numero-ordem /* consistencia unidade medida */
                   RowObject.num-pedido   = 0
                   RowObject.numero-ordem = 0   
                   RowObject.parcela      = 0
                   de-indice              = RowObject.qt-do-forn 
                                          / RowObject.quantidade 
                   de-indice              = if  de-indice = 0 or de-indice = ? then 1
                                            else de-indice.
                                          

     

            /* Cria ITEM-DOC-EST */
            run createRecord   in this-procedure.
            

            /* Desfaz o bloco e retorna com erro */
            if  return-value = "NOK":U then
                undo bloco, return "NOK":U.
    

            if  return-value = "OK":U then do:
                          

                find b-item-doc-est
                    where rowid(b-item-doc-est) = RowObject.r-rowid exclusive-lock no-error.
                

                if  avail b-item-doc-est then do:
                           

                    /* Altera ITEM-DOC-EST para Indicar que possui FIFO nas Ordens de Compra */
                    assign b-item-doc-est.log-1          = yes
                           de-qtd-saldo                  = b-item-doc-est.quantidade
                           tt-ordem-item.rw-item-doc-est = RowObject.r-rowid.
                    

                    if  tt-ordem-item.preco-total = 0 then 
                        assign tt-ordem-item.preco-total = RowObject.preco-total[1].
                    if  tt-ordem-item.quantidade = 0 then 
                        assign tt-ordem-item.quantidade = RowObject.quantidade.
                    if  tt-ordem-item.quant-fornec = 0 then 
                        assign tt-ordem-item.quant-fornec = RowObject.qt-do-forn.
        

                    for each prazo-compra  
                       fields ( numero-ordem    parcela         quant-saldo
                                situacao        data-entrega    dec-1
                                quant-rejeit     qtd-sal-forn     quantidade
                                quant-receb     cod-refer                   )
                        where prazo-compra.numero-ordem = i-num-ordem
                          and prazo-compra.situacao     =  2                       /* CONFIRMADA */
                          and ( prazo-compra.quant-saldo - prazo-compra.dec-1 ) > 0 no-lock :
                

                            if  piConsDtEntrega
                            and ( prazo-compra.data-entrega > docum-est.dt-trans + param-re.variacao) then
                                next.
                

                            assign de-qtd-aux = ( prazo-compra.quant-saldo - prazo-compra.dec-1 ).
                            if  de-qtd-aux > de-qtd-saldo then 
                                assign de-qtd-aux = de-qtd-saldo.
                                

                            if  de-qtd-aux <= 0 then 
                                next.                        
                            

                            create rat-ordem.
                            assign rat-ordem.cod-emitente = b-item-doc-est.cod-emitente
                                   rat-ordem.serie-docto  = b-item-doc-est.serie-docto
                                   rat-ordem.nro-docto    = b-item-doc-est.nro-docto
                                   rat-ordem.nat-operacao = b-item-doc-est.nat-operacao
                                   rat-ordem.sequencia    = b-item-doc-est.sequencia
                                   rat-ordem.num-pedido   = i-num-pedido
                                   rat-ordem.numero-ordem = i-num-ordem
                                   rat-ordem.parcela      = prazo-compra.parcela
                                   rat-ordem.quantidade   = de-qtd-aux
                                   rat-ordem.qtidade-forn = de-qtd-aux * de-indice
                                   de-qtd-saldo           = de-qtd-saldo - rat-ordem.quantidade.
        

                            run pi-aloca-ordem-cc ( input yes,
                                                    input rat-ordem.quantidade,
                                                    input rowid(prazo-compra) ).
                                   

                            if  de-qtd-saldo <= 0 then 
                                leave.
                    end.
                    

                    if  de-qtd-saldo > 0 then do:
                        find first rat-ordem
                             where rat-ordem.cod-emitente = b-item-doc-est.cod-emitente
                               and rat-ordem.serie-docto  = b-item-doc-est.serie-docto
                               and rat-ordem.nro-docto    = b-item-doc-est.nro-docto
                               and rat-ordem.nat-operacao = b-item-doc-est.nat-operacao
                               and rat-ordem.sequencia    = b-item-doc-est.sequencia 
                              exclusive-lock no-error.
                              

                        if  avail rat-ordem then do:

                            run findPrazoCompra ( rat-ordem.numero-ordem,
                                                  rat-ordem.parcela ).

                            run pi-aloca-ordem-cc ( input no,
                                                    input rat-ordem.quantidade,
                                                    input rowid(prazo-compra)).
                                                    

                            assign rat-ordem.quantidade   = rat-ordem.quantidade + de-qtd-saldo
                                   rat-ordem.qtidade-forn = rat-ordem.quantidade * de-indice.
                            

                            run pi-aloca-ordem-cc ( input yes,
                                                    input rat-ordem.quantidade,
                                                    input rowid(prazo-compra)).
                        end.  
                        find current rat-ordem no-lock no-error.
                    end.
                end.                              
            end.            
            else 
                assign tt-ordem-item.rw-item-doc-est = ?.

            {method/svc/custom/custom.i &Event = "aftercreateItemOfPedido"}
        

        end. /* for each */
    end. /* do trans */
    

    /* A variÿvel i-totaliza indica o que documento deverÿ ser totalizado */
    run getTotalizaNota ( 0 ).
    

    /* Calculo do ICMS, ICMS Subst, ICMS Complementar e totaliza a NF */
    run TransferTotalItensNota ( docum-est.cod-emitente,
                                 docum-est.serie-docto,
                                 docum-est.nro-docto,
                                 docum-est.nat-operacao ).

    RETURN "OK":U.

END PROCEDURE.




