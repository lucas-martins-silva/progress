/**********************************************************************************************
**
** PROCEDURE: pi-sfc-reporte-tempo
** OBJETIVO:  Calculo de tempo do reporte opera»’o  boin536 e parada boin530
              tempos auxiliares e dados do turno reportado
**
**********************************************************************************************/
PROCEDURE pi-sfc-reporte-tempo:

    def  Input param p-cod-ctrab        as char format "x(16)"                     no-undo.
    def  Input param p-dat-fim          as date format "99/99/9999"                no-undo.
    def  Input param p-qtd-segs-fim     as dec  format "->>>>,>>9.9999" decimals 4 no-undo.
    def  Input param p-dat-inic         as date format "99/99/9999"                no-undo.
    def  Input param p-qtd-segs-inic    as dec  format "->>>>,>>9.9999" decimals 4 no-undo.
    def output param p-qtd-tempo-proces as dec  format ">,>>>,>>9.99"   decimals 6 no-undo.
    def output param p-qtd-tempo-hext   as dec  format "->>>>,>>9.9999" decimals 4 no-undo.
    def output param p-cod-model-turno  as char format "x(8)"                      no-undo.
    def output param p-num-turno        as int  format ">>>>,>>9"                  no-undo.

    def var v-cod-calend    as char  format "x(8)"   no-undo.
    def var v-dat-aux       as date                  no-undo.
    def var v-num-dia       as int                   no-undo.
    def var v-num-hora-fim  as int                   no-undo.
    def var v-num-hora-inic as int                   no-undo.
    def var c-cod-area      as char                  no-undo.
    def var c-gm-codigo     as char                  no-undo. 
    
    def var h-boin469b as handle no-undo.
    
    /*** Variÿveis para n’o duplicar os tempos em hora extra em alguns casos onde o reporte inicia
         em dia n’o util e acaba antes do primeiro turno de um dia util ***/
    def var v-dat-extra                       as date              initial ?             no-undo. 
    def var v-num-hra-extra                   as integer                                 no-undo.
    
    if  not available grup-maquina then do:
        find ctrab 
            where ctrab.cod-ctrab = p-cod-ctrab no-lock no-error.
        find grup-maquina
            where grup-maquina.gm-codigo = ctrab.gm-codigo no-lock no-error.
    end.

    assign v-cod-calend = if avail grup-maquina
                          then  grup-maquina.cd-calen
                          else "" .

    if  v-cod-calend = ? 
    or  v-cod-calend = "" then do:
        find last param-sfc no-lock no-error.
        assign v-cod-calend = param-sfc.cd-calen.     
    end.

    find first area-produc-ctrab where 
               area-produc-ctrab.cod-ctrab       = p-cod-ctrab and 
               area-produc-ctrab.dat-inic-valid <= p-dat-inic  and 
               area-produc-ctrab.dat-fim-valid  >  p-dat-inic  no-lock no-error.
    
    if not available area-produc-ctrab then do:
        find first area-produc-ctrab where 
                   area-produc-ctrab.cod-ctrab       = p-cod-ctrab and 
                   area-produc-ctrab.dat-inic-valid <= p-dat-fim   and 
                   area-produc-ctrab.dat-fim-valid  >  p-dat-fim   no-lock no-error.    
        if avail area-produc-ctrab then
           assign p-dat-inic      = area-produc-ctrab.dat-inic-valid
                  p-qtd-segs-inic = 0.           
    end.

    if  not avail area-produc-ctrab then
        return "NOK":U.       

    /* ** Procura de modelo de turno vÿlido ***/

    find first gm-turno-crp
        where gm-turno-crp.gm-codigo   = area-produc-ctrab.gm-codigo
          and gm-turno-crp.dt-inicio  <= p-dat-inic
          and gm-turno-crp.dt-termino >  p-dat-inic no-lock no-error.

    if  not available gm-turno-crp then 
        find first gm-turno-crp
            where gm-turno-crp.gm-codigo   = '*'
              and gm-turno-crp.dt-inicio  <= p-dat-inic
              and gm-turno-crp.dt-termino >  p-dat-inic no-lock no-error.

    if  not avail gm-turno-crp then do:
        find first area-produc
            where area-produc.cod-area-produc = area-produc-ctrab.cod-area-produc no-lock no-error.

        if  not avail area-produc 
        or  area-produc.cod-model-turno = "" then do:
            find last param-sfc no-lock no-error.
            assign p-cod-model-turno = param-sfc.cod-model-turno.
        end.
        else
            assign p-cod-model-turno = area-produc.cod-model-turno.
            
        find model-turno-ctrab where 
             model-turno-ctrab.cod-ctrab = area-produc.cod-area-produc and
             model-turno-ctrab.dat-inic-valid <= p-dat-inic and
             model-turno-ctrab.dat-fim-valid  > p-dat-inic no-lock no-error.
        
        if available model-turno-ctrab then
             p-cod-model-turno = model-turno-ctrab.cod-model-turno.              
            
    end.
    else
        assign p-cod-model-turno = gm-turno-crp.cod-model-turno.

    /*** Determina tempo reportado fora de horas de turno e turno de produ»’o ***/
    /***********************************************************
    Todo este calculo abaixo foi substituido pela boin469d com uma nova procedure 
    que ‚ a pi-determina-tempo-evento-extra
    Mois‚s Martinelli Pereira - ksm339251
    O motivo deste refatoramento ‚ devido ao bug
    ** BUG: A data nÆo util afeta o dispon¡vel em periodos de virada i.e.
    **      de 22:00 at‚ 24:00 num turno de 22:00 at‚ 06:00 serÆo consideradas
    **      apenas 6 horas quando o dia antecessor for feriado (deveria ser 8).
    **      No mesmo caso quando se trata do terceiro turno quando o dia sucessor
    **      for feriado serÆo consideradas apenas 2 horas (deveria ser 8)
    **      Para mais detalhes falar com Jos‚ Carlos
    **
    **if can-find(first turno-dia where 
    **                  turno-dia.cod-model-turno = p-cod-model-turno) then do:
    **
    **    /*** Procura turno que se encaixe na hora in­cio reportada ***/
    **
    **    /*** Se n’o ² feriado p-dat-inic ***/
    **    if  not can-find(calen-data 
    **               where calen-data.cd-calen  = v-cod-calend
    **                 and calen-data.data      = p-dat-inic
    **                 and calen-data.tipo-dia >= 2 
    **                 and calen-data.tipo-dia <= 3) then 
    **        find first turno-dia
    **            where turno-dia.cod-model-turno = p-cod-model-turno
    **              and turno-dia.num-dia         = weekday(p-dat-inic)
    **              and turno-dia.qtd-hra-inicio <= p-qtd-segs-inic / 3600
    **              and turno-dia.qtd-hra-fim     > p-qtd-segs-inic / 3600 no-lock no-error.
    **
    **    if  not avail turno-dia then do:
    **
    **        /* ** Determina tempo extra antes do inicio do turno ***/
    **
    **        assign v-num-hora-inic = p-qtd-segs-inic
    **               v-num-hora-fim  = 86400.
    **
    **        blk-data-aux-1:       
    **        do v-dat-aux = p-dat-inic to p-dat-fim:
    **
    **            if v-dat-aux = p-dat-fim then
    **               assign v-num-hora-fim = p-qtd-segs-fim.
    **
    **            /* ** Se n’o ² feriado v-dat-aux ***/
    **            if not can-find(calen-data where calen-data.cd-calen = v-cod-calend and
    **                                             calen-data.data = v-dat-aux    and
    **                                             calen-data.tipo-dia >= 2       and
    **                                             calen-data.tipo-dia <= 3) then 
    **                find first turno-dia where 
    **                           turno-dia.cod-model-turno = p-cod-model-turno and
    **                           turno-dia.num-dia           = weekday(v-dat-aux)       and
    **                           turno-dia.qtd-hra-inicio   >= v-num-hora-inic / 3600   and 
    **                           turno-dia.qtd-hra-inicio   <= v-num-hora-fim / 3600 no-lock no-error.
    **                           
    **            if available turno-dia then do:
    **               assign p-qtd-tempo-hext   = p-qtd-tempo-hext + 
    **                                           turno-dia.qtd-hra-inicio * 3600 - v-num-hora-inic
    **                      p-num-turno        = turno-dia.num-turno
    **                      v-dat-extra        = v-dat-aux
    **                      v-num-hra-extra    = turno-dia.qtd-hra-inicio * 3600. 
    **               leave blk-data-aux-1.
    **            end.           
    **            
    **            assign p-qtd-tempo-hext = p-qtd-tempo-hext + v-num-hora-fim - v-num-hora-inic
    **                   v-num-hora-inic  = 0
    **                   v-dat-extra      = v-dat-aux
    **                   v-num-hra-extra  = v-num-hora-fim. 
    **
    **        end. /* ** blk-data-aux-1 ***/
    **
    **    end.
    **
    **    if avail turno-dia then do:
    **
    **        assign p-num-turno = turno-dia.num-turno. 
    **        
    **        release turno-dia.
    **        
    **        /*** Determina tempo extra apos hora final do turno ***/    
    **
    **        /*** Se n’o ² feriado p-dat-fim ***/
    **        if not can-find(calen-data where calen-data.cd-calen = v-cod-calend and
    **                                             calen-data.data = p-dat-fim    and
    **                                             calen-data.tipo-dia >= 2       and
    **                                             calen-data.tipo-dia <= 3) then 
    **            find first turno-dia where 
    **                       turno-dia.cod-model-turno = p-cod-model-turno and
    **                       turno-dia.num-dia         = weekday(p-dat-fim)      and
    **                       turno-dia.qtd-hra-inicio <  p-qtd-segs-fim / 3600   and
    **                       turno-dia.qtd-hra-fim    >= p-qtd-segs-fim / 3600 no-lock no-error.
    **
    **        if not avail turno-dia then do:
    **            assign v-dat-aux       = p-dat-fim
    **                   v-num-hora-inic = 0
    **                   v-num-hora-fim  = p-qtd-segs-fim.
    **
    **            blk-data-aux-2:
    **            repeat:
    **                if v-dat-aux              = p-dat-inic then 
    **                   assign v-num-hora-inic = p-qtd-segs-inic.
    **                
    **                if v-dat-extra <> ? and   
    **                   v-dat-aux        = v-dat-extra then 
    **                   assign v-num-hora-inic = v-num-hra-extra.                       
    **
    **                /*** Se n’o ² feriado v-dat-aux ***/
    **                if not can-find(calen-data where calen-data.cd-calen = v-cod-calend and
    **                                                 calen-data.data = v-dat-aux    and
    **                                                 calen-data.tipo-dia >= 2       and
    **                                                 calen-data.tipo-dia <= 3) then 
    **                    find last turno-dia where 
    **                              turno-dia.cod-model-turno = p-cod-model-turno and
    **                              turno-dia.num-dia         = weekday(v-dat-aux)      and
    **                              turno-dia.qtd-hra-inicio <= v-num-hora-fim / 3600   and 
    **                              turno-dia.qtd-hra-fim    <= v-num-hora-fim / 3600 no-lock no-error.
    **
    **                if  available turno-dia then do:
    **                    assign p-qtd-tempo-hext = p-qtd-tempo-hext + v-num-hora-fim - turno-dia.qtd-hra-fim * 3600.
    **                    if  p-num-turno <> turno-dia.num-turno then
    **                        assign p-num-turno = 9999. 
    **                    leave blk-data-aux-2.
    **                end.           
    **
    **                assign p-qtd-tempo-hext = p-qtd-tempo-hext + v-num-hora-fim - v-num-hora-inic 
    **                       v-dat-aux        = v-dat-aux - 1
    **                       v-num-hora-fim   = 86400.  
    **
    **                if v-dat-aux < p-dat-inic  then leave blk-data-aux-2.
    **
    **                if v-dat-extra <> ? and 
    **                   v-dat-aux < v-dat-extra then leave blk-data-aux-2.
    **
    **            end. /* ** blk-data-aux-2 ***/
    **
    **        end.
    **        else
    **           if p-num-turno <> turno-dia.num-turno then
    **              assign p-num-turno = 9999.
    **    end.
    **
    **    /* ** Se numero de turno ² 0 procura ultimo turno anterior a hora de inicio reportada ***/
    **
    **    if p-num-turno = 0 then do:
    **         find last turno-dia where 
    **                   turno-dia.cod-model-turno = p-cod-model-turno  and
    **                   turno-dia.num-dia         = weekday(v-dat-aux) and
    **                   turno-dia.qtd-hra-inicio  < p-qtd-segs-inic / 3600 no-lock no-error.
    **         if available turno-dia then 
    **            assign p-num-turno = turno-dia.num-turno.          
    **    end.
    **    if p-num-turno = 9999 then 
    **       assign p-num-turno = 0.
    **end.    
    **
    *** /** Avalia tempo entre datas/horas em tempo de turno normal ***/
    *************************************************************/
    
    assign c-cod-area           = area-produc-ctrab.cod-area-produc
           c-gm-codigo          = area-produc-ctrab.gm-codigo.
           
    run inbo/boin469b.p persistent set h-boin469b.
    
    run CalcularTemposCtrabExtra in h-boin469b (input-output c-cod-area,                 
                                                input-output c-gm-codigo,                
                                                input        area-produc-ctrab.cod-ctrab,
                                                input-output v-cod-calend,               
                                                Input-output p-dat-fim,                  
                                                Input-output p-qtd-segs-fim,             
                                                Input-output p-dat-inic,                 
                                                Input-output p-qtd-segs-inic,            
                                                input        p-cod-model-turno,        
                                                Input-output p-qtd-tempo-proces,
                                                output       p-qtd-tempo-hext,
                                                output       p-num-turno).
    
    delete procedure h-boin469b.

    /********************************************
    run inbo/boin469d.p (input-output c-cod-area,
                         input-output c-gm-codigo,
                         input        area-produc-ctrab.cod-ctrab,
                         input-output v-cod-calend,
                         Input-output p-dat-fim,
                         Input-output p-qtd-segs-fim,
                         Input-output p-dat-inic,
                         Input-output p-qtd-segs-inic,
                         Input-output p-qtd-tempo-proces).

   run inbo/boin469a.p (input area-produc-ctrab.gm-codigo,
                         Input v-cod-calend,
                         Input-output p-dat-fim,
                         Input-output p-qtd-segs-fim,
                         Input-output p-dat-inic,
                         Input-output p-qtd-segs-inic,
                         input-output p-qtd-tempo-proces).
    
    assign p-qtd-tempo-hext = p-qtd-tempo-hext / 3600.
    ********************************************/
    
END PROCEDURE. /* pi-sfc-reporte-tempo */


