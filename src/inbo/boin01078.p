&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram  
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice id1-chave
  Parameters:  
               recebe valor do campo numero-ordem
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER i-num-pedido LIKE envio-pedido-compr.num-pedido NO-UNDO.
    DEFINE INPUT PARAMETER i-seq        LIKE envio-pedido-compr.seq NO-UNDO.

    FIND FIRST bfenvio-pedido-compr WHERE 
        bfenvio-pedido-compr.num-pedido = i-num-pedido NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfenvio-pedido-compr THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atrav?s de rowid e verifica a ocorr?ncia de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfenvio-pedido-compr)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

