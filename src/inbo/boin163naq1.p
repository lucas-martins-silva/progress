    DEFINE OUTPUT PARAMETER ptipo-nota LIKE it-doc-fisico.tipo-nota NO-UNDO.
    DEFINE OUTPUT PARAMETER psequencia LIKE it-doc-fisico.sequencia NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
