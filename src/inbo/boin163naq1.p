&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice documento
  Parameters:  
               recebe valor do campo serie-docto
               recebe valor do campo nro-docto
               recebe valor do campo cod-emitente
               recebe valor do campo tipo-nota
               recebe valor do campo sequencia
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pserie-docto LIKE it-doc-fisico.serie-docto NO-UNDO.
    DEFINE INPUT PARAMETER pnro-docto LIKE it-doc-fisico.nro-docto NO-UNDO.
    DEFINE INPUT PARAMETER pcod-emitente LIKE it-doc-fisico.cod-emitente NO-UNDO.
    DEFINE INPUT PARAMETER ptipo-nota LIKE it-doc-fisico.tipo-nota NO-UNDO.
    DEFINE INPUT PARAMETER psequencia LIKE it-doc-fisico.sequencia NO-UNDO.

    FIND FIRST bfit-doc-fisico WHERE 
        bfit-doc-fisico.serie-docto = pserie-docto AND 
        bfit-doc-fisico.nro-docto = pnro-docto AND 
        bfit-doc-fisico.cod-emitente = pcod-emitente AND 
        bfit-doc-fisico.tipo-nota = ptipo-nota AND 
        bfit-doc-fisico.sequencia = psequencia NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfit-doc-fisico THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfit-doc-fisico)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryDocFisico DBOProgram 
PROCEDURE openQueryDocFisico :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    OPEN QUERY {&QueryName} FOR EACH {&TableName} NO-LOCK
        WHERE {&TableName}.serie-docto  = c-serie-docto
        AND   {&TableName}.nro-docto    = c-nro-docto
        AND   {&TableName}.cod-emitente = i-cod-emitente
        AND   {&TableName}.tipo-nota    = i-tipo-nota INDEXED-REPOSITION.

        
    RETURN "OK":U.

END PROCEDURE.

