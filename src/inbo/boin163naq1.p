&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getBatchRecordsTMS DBOProgram 
PROCEDURE getBatchRecordsTMS :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE OUTPUT PARAMETER TABLE FOR tt-it-doc-fisico.

    DEFINE VARIABLE iCont AS INTEGER    NO-UNDO.

    FOR EACH tt-it-doc-fisico EXCLUSIVE-LOCK:
        DELETE tt-it-doc-fisico.
    END.

    RUN getBatchRecords IN THIS-PROCEDURE (INPUT ?,
                                           INPUT NO,
                                           INPUT 999999,
                                           OUTPUT iCont,
                                           OUTPUT TABLE RowObject-aux).

    FOR EACH RowObject-aux NO-LOCK:
        CREATE tt-it-doc-fisico.
        BUFFER-COPY RowObject-aux TO tt-it-doc-fisico.
    END.

    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

