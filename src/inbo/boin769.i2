CASE pCod-tabela:
    WHEN 1 THEN
        FOR FIRST mla-chave-doc-aprov NO-LOCK
             WHERE ROWID(mla-chave-doc-aprov) = pRowid:

            CREATE mla-log-reg.
            ASSIGN mla-log-reg.ep-codigo   = mla-chave-doc-aprov.ep-codigo
                   mla-log-reg.cod-estabel = ""
                   mla-log-reg.cod-usuar   = c-seg-usuario
                   mla-log-reg.cod-tabela   = pCod-tabela
                   mla-log-reg.chave-reg   = STRING(mla-chave-doc-aprov.cod-tip-doc) + 
                                             " | " + string(mla-chave-doc-aprov.posicao-ini)
                   mla-log-reg.data-reg    = TODAY
                   mla-log-reg.hora-reg    = STRING(TIME, "hh:mm")
                   mla-log-reg.tipo-reg    = pTipo-reg
                   mla-log-reg.log-reg     = pLog-reg
                   r-rowid-log             = rowid(mla-log-reg).
                   
        END.
    WHEN 2 THEN
        FOR FIRST mla-emails NO-LOCK
            WHERE ROWID(mla-emails) = pRowid:

            CREATE mla-log-reg.
            ASSIGN mla-log-reg.ep-codigo   = mla-emails.ep-codigo    
                   mla-log-reg.cod-estabel = mla-emails.cod-estabel  
                   mla-log-reg.cod-usuar   = c-seg-usuario
                   mla-log-reg.cod-tabela  = pCod-tabela
                   mla-log-reg.chave-reg   = STRING(mla-emails.cod-tip-doc) +
                                             " | " + STRING(mla-emails.e-mail)
                   mla-log-reg.data-reg    = TODAY
                   mla-log-reg.hora-reg    = STRING(TIME, "hh:mm")
                   mla-log-reg.tipo-reg    = pTipo-reg
                   mla-log-reg.log-reg     = pLog-reg
                   r-rowid-log             = rowid(mla-log-reg).
        END.
    WHEN 3 THEN
        FOR FIRST mla-faixa-aprov NO-LOCK
            WHERE ROWID(mla-faixa-aprov) = pRowid:

            CREATE mla-log-reg.
            ASSIGN mla-log-reg.ep-codigo   = mla-faixa-aprov.ep-codigo    
                   mla-log-reg.cod-estabel = mla-faixa-aprov.cod-estabel  
                   mla-log-reg.cod-usuar   = c-seg-usuario
                   mla-log-reg.cod-tabela  = pCod-tabela
                   mla-log-reg.chave-reg   = string(mla-faixa-aprov.cod-lotacao) + 
                                             " | " + string(mla-faixa-aprov.cod-tip-doc) + 
                                             " | " + string(mla-faixa-aprov.num-faixa)
                   mla-log-reg.data-reg    = TODAY
                   mla-log-reg.hora-reg    = STRING(TIME, "hh:mm")
                   mla-log-reg.tipo-reg    = pTipo-reg
                   mla-log-reg.log-reg     = pLog-reg
                   r-rowid-log             = rowid(mla-log-reg).
        END.
    WHEN 4 THEN
