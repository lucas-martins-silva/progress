                                             " | " +  STRING(mla-usuar-padrao.cod-usuar)
                   mla-log-reg.data-reg    = TODAY
                   mla-log-reg.hora-reg    = STRING(TIME, "hh:mm")
                   mla-log-reg.tipo-reg    = pTipo-reg
                   mla-log-reg.log-reg     = pLog-reg
                   r-rowid-log             = rowid(mla-log-reg).
        END.
    WHEN 26 THEN
        FOR FIRST mla-verba-aprov NO-LOCK
            WHERE ROWID(mla-verba-aprov) = pRowid:

            CREATE mla-log-reg.
            ASSIGN mla-log-reg.ep-codigo   = mla-verba-aprov.ep-codigo  
                   mla-log-reg.cod-estabel = mla-verba-aprov.cod-estabel
                   mla-log-reg.cod-usuar   = c-seg-usuario
                   mla-log-reg.cod-tabela  = pCod-tabela
                   mla-log-reg.chave-reg   = STRING(mla-verba-aprov.cod-usuar) + 
                                             " | " + string(mla-verba-aprov.cod-tip-doc) + 
                                             " | " + STRING(mla-verba-aprov.periodo-ini)
                   mla-log-reg.data-reg    = TODAY
                   mla-log-reg.hora-reg    = STRING(TIME, "hh:mm")
                   mla-log-reg.tipo-reg    = pTipo-reg
                   mla-log-reg.log-reg     = pLog-reg
                   r-rowid-log             = rowid(mla-log-reg).
        END.
    WHEN 27 THEN
        FOR FIRST mla-configur-visual-usuar NO-LOCK
            WHERE ROWID(mla-configur-visual-usuar) = pRowid:

            CREATE mla-log-reg.
            ASSIGN mla-log-reg.ep-codigo   = ""
                   mla-log-reg.cod-estabel = ""
                   mla-log-reg.cod-usuar   = c-seg-usuario
                   mla-log-reg.cod-tabela  = pCod-tabela
                   mla-log-reg.chave-reg   = STRING(mla-configur-visual-usuar.cod-usuar) +  
                                             " | ":U + STRING(mla-configur-visual-usuar.idi-interfac)
                   mla-log-reg.data-reg    = TODAY
                   mla-log-reg.hora-reg    = STRING(TIME, "hh:mm")
                   mla-log-reg.tipo-reg    = pTipo-reg
                   mla-log-reg.log-reg     = pLog-reg
                   r-rowid-log             = rowid(mla-log-reg).
        END.   
    WHEN 28 THEN
        FOR FIRST mla-layout-usuar-doc NO-LOCK      
            WHERE ROWID(mla-layout-usuar-doc) = pRowid:

            CREATE mla-log-reg.
            ASSIGN mla-log-reg.ep-codigo   = ""
                   mla-log-reg.cod-estabel = ""
                   mla-log-reg.cod-usuar   = c-seg-usuario
                   mla-log-reg.cod-tabela  = pCod-tabela
                   mla-log-reg.chave-reg   = STRING(mla-layout-usuar-doc.cod-usuar) +  
                                             " | ":U + STRING(mla-layout-usuar-doc.cdn-docto) +
                                             " | ":U + STRING(mla-layout-usuar-doc.idi-interfac) +
                                             " | ":U + STRING(mla-layout-usuar-doc.cod-id-campo)
                   mla-log-reg.data-reg    = TODAY
                   mla-log-reg.hora-reg    = STRING(TIME, "hh:mm")
                   mla-log-reg.tipo-reg    = pTipo-reg
                   mla-log-reg.log-reg     = pLog-reg
                   r-rowid-log             = rowid(mla-log-reg).
        END.    
END CASE.
