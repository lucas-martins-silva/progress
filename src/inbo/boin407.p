            no-lock no-error.
        if not available tt-bo-erro then do:
            find serie where
                serie.serie = rowObject.serie
                no-lock no-error.
            if avail serie then do:
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-table.i mgind {&TABLE-NAME} 1}
                run utp/ut-msgs.p (input "msg",
                                   input 8,
                                   input return-value).
                create tt-bo-erro.
