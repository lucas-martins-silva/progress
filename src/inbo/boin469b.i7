/*****************************************************************************
** Procedure Interna.....: DeterminarCalendCtrab
** Objetivo..............: Determinar o calend rio a ser
                           utilizado pelo centro de trabalho.
** Parƒmetros ...........: io p-cod-area
                           io p-gm-codigo
                           io p-cod-ctrab
                           o p-cod-calend
*****************************************************************************/
/* Ativ. 164.087 */
PROCEDURE DeterminarCalendCtrab:

    def input-output param p-cod-area        as char  format "x(12)"  no-undo.
    def input-output param p-gm-codigo       as char  format "x(16)"  no-undo.
    def input        param p-cod-ctrab       as char  format "x(16)"  no-undo.
    def input        param p-dat-refer       as date  format "99/99/9999" no-undo.
    def output       param p-cod-calend      as char  format "x(8)"   no-undo.
    
    &IF DEFINED (bf_man_sfc_lc) &THEN
    if (p-gm-codigo = ? or p-gm-codigo = "") and p-cod-ctrab <> ? then do: 
    
       find first ctrab where
            ctrab.cod-ctrab = p-cod-ctrab no-lock no-error.
       if avail ctrab then
          assign p-gm-codigo   = ctrab.gm-codigo.
    end.
    &endif
    
    find grup-maquina
        where grup-maquina.gm-codigo = p-gm-codigo no-lock no-error.
    if available grup-maquina then DO:
       assign p-cod-calend = grup-maquina.cd-calen.
       &IF DEFINED (bf_man_sfc_lc) &THEN
       if p-cod-calend = ? or p-cod-calend = "" then do:
          find first area-produc 
             where area-produc.cod-area-produc = grup-maquina.cod-area-produc 
               and area-produc-ctrab.dat-inic-valid <= p-dat-refer 
               and area-produc-ctrab.dat-fim-valid   > p-dat-refer no-lock no-error.
          if avail area-produc then
             assign p-cod-calend = area-produc.cd-calen.
       end.
       &endif
    end.
    
    if not can-find (first calen-gener
                     where calen-gener.cd-calen = p-cod-calend) 
       then do:
        find last param-crp no-lock no-error.

        &IF DEFINED (bf_man_sfc_lc) &THEN
            find first param-sfc no-lock no-error.
            if  avail param-sfc then
                assign p-cod-calend = param-sfc.cd-calen.
            else if avail param-crp then
                assign p-cod-calend = param-crp.cod-calend-crp.
        &ELSE
            find last param-crp-ext no-lock no-error.
            assign p-cod-calend = param-crp-ext.cod-calend-crp.
        &ENDIF
    end.
END PROCEDURE.

/*****************************************************************************
** Procedure Interna.....: DeterminarModelTurnoCtrab
** Objetivo..............: Determinar o modelo de turno a ser 
                           utilizado pelo centro de trabalho.
** Parƒmetros ...........: i p-cod-area
                           i p-gm-codigo 
                           i p-cod-ctrab
                           i p-dat-refer
                           o p-dat-inicio   /*** inicio de validade ***/
                           o p-dat-fim      /*** fim de validade    ***/                        
                           o p-cod-model-turno
                           
*****************************************************************************/
PROCEDURE DeterminarModelTurnoCtrab:
    
    def input        param p-cod-area        as char  format "x(12)"  no-undo.
    def input        param p-gm-codigo       as char  format "x(9)"   no-undo.
    def input        param p-cod-ctrab       as char  format "x(16)"  no-undo.
    def input        param p-dat-refer       as date                  no-undo.
    def output       param p-dat-inicio      as date                  no-undo.
    def output       param p-dat-fim         as date                  no-undo.
    def output       param p-cod-turno       as char  format "x(8)"   no-undo.

    assign p-dat-inicio = date(1,1,1)
           p-dat-fim    = date(12,31,9999).

    &IF DEFINED (bf_man_sfc_lc) &THEN    
    if p-gm-codigo = ? or  p-gm-codigo = "" then do:
        find first ctrab where
             ctrab.cod-ctrab = p-cod-ctrab no-lock no-error.
        if avail ctrab then
          assign p-gm-codigo   = ctrab.gm-codigo.
    end.       
    else do:
       find first ctrab no-lock
            where ctrab.gm-codigo = p-gm-codigo no-error.
       if avail ctrab then
          assign p-cod-ctrab = if p-cod-ctrab = "" or p-cod-ctrab = ? 
                               then ctrab.cod-ctrab 
                               else p-cod-ctrab.
       else do: /*Se nÆo achou pode ser porque ele passou area de produ‡Æo no lugar de grupo de m quina*/
           find first area-produc no-lock
                where area-produc.cod-area-produc = p-gm-codigo no-error.
           if avail area-produc then do: /*Ativ. 164087 */
              assign p-cod-area = area-produc.cod-area-produc.
              find first area-produc-ctrab no-lock
                   where area-produc-ctrab.cod-area-produc = area-produc.cod-area-produc no-error.
              if avail area-produc-ctrab then
                   assign p-gm-codigo = area-produc-ctrab.gm-codigo.
           end.
       end.                        
    end.
    &endif
       
    find first gm-turno-crp
         where gm-turno-crp.gm-codigo  = p-gm-codigo
           and gm-turno-crp.dt-inicio <= p-dat-refer
           and gm-turno-crp.dt-termino > p-dat-refer no-lock no-error.
   
    if  not available gm-turno-crp then do: 
        &IF DEFINED (bf_man_sfc_lc) &THEN    
        if (p-cod-ctrab <> "" and p-cod-ctrab <> ?) and (p-cod-area = "" or p-cod-area = ?) then do:
           find first area-produc-ctrab no-lock 
             where area-produc-ctrab.cod-ctrab = p-cod-ctrab       
               and area-produc-ctrab.dat-inic-valid <= p-dat-refer 
               and area-produc-ctrab.dat-fim-valid  >  p-dat-refer no-error.
           if available area-produc-ctrab then 
              assign p-cod-area = area-produc-ctrab.cod-area-produc.     
        end.   
        
        /*A tabela model-turno-ctrab contem o relacionamento da  rea de produ‡Æo com o 
        modelo de turno. NÆo se influenciar pelo nome da tabela*/
        
        find first model-turno-ctrab 
             where model-turno-ctrab.cod-ctrab       = p-cod-area
               and model-turno-ctrab.dat-inic-valid <= p-dat-refer
               and model-turno-ctrab.dat-fim-valid   > p-dat-refer no-lock no-error.
        
        if available model-turno-ctrab then do:     
            assign p-cod-turno      = model-turno-ctrab.cod-model-turno
                   p-dat-inicio     = model-turno-ctrab.dat-inic-valid
                   p-dat-fim        = model-turno-ctrab.dat-fim-valid.
        end.
        else do:
         
             find first model-turno-ctrab                                                  
                  where model-turno-ctrab.cod-ctrab       = p-cod-area                     
                    and model-turno-ctrab.dat-inic-valid  > p-dat-refer no-lock no-error.
             if available model-turno-ctrab then  
                 assign p-dat-fim = model-turno-ctrab.dat-inic-valid.
        end.    
          
        if p-cod-turno = ? or p-cod-turno = "" then do:
            
            if not avail area-produc then          
                find first area-produc no-lock
                     where area-produc.cod-area-produc = p-cod-area no-error. 
               
            if avail area-produc then    
                assign p-cod-turno = area-produc.cod-model-turno.     
        end.               
        &endif
        
        /*** Determina novas data de inicio de validade ***/ 
        find last gm-turno-crp 
            where gm-turno-crp.gm-codigo = p-gm-codigo 
              and gm-turno-crp.dt-inicio < p-dat-refer no-lock no-error.
        if  avail gm-turno-crp then
                assign p-dat-inicio = max(gm-turno-crp.dt-termino, p-dat-inicio).

        /*** Determina novas data de fim de validade ***/ 
        find first gm-turno-crp
            where  gm-turno-crp.gm-codigo = p-gm-codigo
              and  gm-turno-crp.dt-inicio > p-dat-refer no-lock no-error.
        if  avail gm-turno-crp then
            assign p-dat-fim = min(gm-turno-crp.dt-inicio, p-dat-fim).   

    end.
    else do:
        assign p-cod-turno      = gm-turno-crp.cod-model-turno
               p-dat-inicio     = gm-turno-crp.dt-inicio
               p-dat-fim        = gm-turno-crp.dt-termino.
    end.           
    
    /*Ativ. 164087*/
    if not can-find (first model-turno-semana
                     where model-turno-semana.cod-model-turno = p-cod-turno) 
       then do:

        find last param-crp no-lock no-error.

        &IF DEFINED (bf_man_sfc_lc) &THEN
            find first param-sfc no-lock no-error.
            if  avail param-sfc then
                assign p-cod-turno = param-sfc.cod-model-turno.
            else if avail param-crp then
                assign p-cod-turno = param-crp.cod-model-turno.
        &ELSE
            find last param-crp-ext no-lock no-error.
            assign p-cod-turno = param-crp-ext.cod-model-turno.
        &ENDIF
    end.
END PROCEDURE.
