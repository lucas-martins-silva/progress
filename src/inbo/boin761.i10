/*Gera‡Æo autom tica dos campos para a BBM*/

    DEFINE INPUT  PARAMETER cod-tipo-lote LIKE campo-lote-pregao.cdn-tip-lote-pregao NO-UNDO.
    DEFINE OUTPUT PARAMETER TABLE FOR RowErrors.
    
    /*Alfanum‚ricos*/
    IF NOT CAN-FIND(FIRST campo-lote-pregao
                    WHERE campo-lote-pregao.cdn-tip-lote-pregao = cod-tipo-lote    
                      AND campo-lote-pregao.cod-campo           = "BBM-REGULAMENTO") THEN DO:
        CREATE campo-lote-pregao.
