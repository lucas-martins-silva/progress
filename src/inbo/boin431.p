&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*--- Inclua aqui as validaá‰es ---*/

    if pType = "Create":U then 
       IF CAN-FIND(bf{&TableName} where
                   bf{&TableName}.it-codigo  = RowObject.it-codigo  and
                   bf{&TableName}.tipo       = RowObject.tipo) THEN DO:
          /* Inicio -- Projeto Internacional */
          {utp/ut-table.i mgind texto 1} /* Busca o label da tabela */
          {method/svc/errors/inserr.i &ErrorNumber="1"
                                      &ErrorType="EMS"
                                      &ErrorSubtype="ERROR" 
                                      &ErrorParameters=TRIM(RETURN-VALUE)}
          END. 
    
    if pType = "Update":U then do:    
       IF NOT CAN-FIND(bf{&TableName} where
                   bf{&TableName}.it-codigo  = RowObject.it-codigo  and
                   bf{&TableName}.tipo       = RowObject.tipo) THEN DO:
          /* Inicio -- Projeto Internacional */
          {utp/ut-table.i mgind texto 1} /* Busca o label da tabela */
          {method/svc/errors/inserr.i &ErrorNumber="47"
                                      &ErrorType="EMS"
                                      &ErrorSubtype="ERROR" 
                                      &ErrorParameters=TRIM(RETURN-VALUE)}
          END. 
    end.
    
    if pType = "Delete":U then do:
       IF NOT CAN-FIND(bf{&TableName} where
                   bf{&TableName}.it-codigo  = RowObject.it-codigo  and
                   bf{&TableName}.tipo       = RowObject.tipo) THEN DO:
          /* Inicio -- Projeto Internacional */
          {utp/ut-table.i mgind texto 1} /* Busca o label da tabela */
          {method/svc/errors/inserr.i &ErrorNumber="47"
                                      &ErrorType="EMS"
                                      &ErrorSubtype="ERROR" 
                                      &ErrorParameters=TRIM(RETURN-VALUE)}
          END. 
    end.
    
    /*--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
