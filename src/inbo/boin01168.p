&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram  
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice pk_rastrea_compras_gesplan
  Parameters:  
               recebe valor do campo cod-estabel
               recebe valor do campo cod-modulo-dtsul
               recebe valor do campo cod-tabela
               recebe valor do campo dtz-ult-alteracao
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-estabel LIKE rastrea-compras-gesplan.cod-estabel NO-UNDO.
    DEFINE INPUT PARAMETER pcod-modulo-dtsul LIKE rastrea-compras-gesplan.cod-modulo-dtsul NO-UNDO.
    DEFINE INPUT PARAMETER pcod-tabela LIKE rastrea-compras-gesplan.cod-tabela NO-UNDO.
    DEFINE INPUT PARAMETER pdtz-ult-alteracao LIKE rastrea-compras-gesplan.dtz-ult-alteracao NO-UNDO.

    FIND FIRST bfrastrea-compras-gesplan WHERE 
        bfrastrea-compras-gesplan.cod-estabel = pcod-estabel AND 
        bfrastrea-compras-gesplan.cod-modulo-dtsul = pcod-modulo-dtsul AND 
        bfrastrea-compras-gesplan.cod-tabela = pcod-tabela AND 
        bfrastrea-compras-gesplan.dtz-ult-alteracao = pdtz-ult-alteracao NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfrastrea-compras-gesplan THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfrastrea-compras-gesplan)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/
    
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

