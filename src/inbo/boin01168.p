&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getKey DBOProgram  
PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice pk_rastrea_compras_gesplan
  Parameters:  
               retorna valor do campo cod-estabel
               retorna valor do campo cod-modulo-dtsul
               retorna valor do campo cod-tabela
               retorna valor do campo dtz-ult-alteracao
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pcod-estabel LIKE rastrea-compras-gesplan.cod-estabel NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-modulo-dtsul LIKE rastrea-compras-gesplan.cod-modulo-dtsul NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-tabela LIKE rastrea-compras-gesplan.cod-tabela NO-UNDO.
    DEFINE OUTPUT PARAMETER pdtz-ult-alteracao LIKE rastrea-compras-gesplan.dtz-ult-alteracao NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pcod-estabel = RowObject.cod-estabel
           pcod-modulo-dtsul = RowObject.cod-modulo-dtsul
           pcod-tabela = RowObject.cod-tabela
           pdtz-ult-alteracao = RowObject.dtz-ult-alteracao.

    RETURN "OK":U.
END PROCEDURE.

