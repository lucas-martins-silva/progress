&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getKey DBOProgram  
PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice idx_evento
  Parameters:  
               retorna valor do campo id-exec
               retorna valor do campo seq-evento
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pid-exec LIKE dta-agente-exec-evento.id-exec NO-UNDO.
    DEFINE OUTPUT PARAMETER pseq-evento LIKE dta-agente-exec-evento.seq-evento NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pid-exec = RowObject.id-exec
           pseq-evento = RowObject.seq-evento.

    RETURN "OK":U.
END PROCEDURE.

