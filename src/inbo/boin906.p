&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getCharField DBOProgram  
PROCEDURE getCharField :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valor de campos do tipo caracter
  Parameters:  
               recebe nome do campo
               retorna valor do campo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pFieldName AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldValue AS CHARACTER NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
        RETURN "NOK":U.

    CASE pFieldName:
        WHEN "cod-agrup":U THEN ASSIGN pFieldValue = RowObject.cod-agrup.
        WHEN "cod-situacao":U THEN ASSIGN pFieldValue = RowObject.cod-situacao.
        WHEN "cod-tipo":U THEN ASSIGN pFieldValue = RowObject.cod-tipo.
        WHEN "cod-usuario-alter":U THEN ASSIGN pFieldValue = RowObject.cod-usuario-alter.
        WHEN "cod-usuario-criacao":U THEN ASSIGN pFieldValue = RowObject.cod-usuario-criacao.
        WHEN "des-analise":U THEN ASSIGN pFieldValue = RowObject.des-analise.
        WHEN "des-evento":U THEN ASSIGN pFieldValue = RowObject.des-evento.
        WHEN "nom-titulo":U THEN ASSIGN pFieldValue = RowObject.nom-titulo.
        OTHERWISE RETURN "NOK":U.
    END CASE.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

