/*
** Include com validacoes e criacao da temp-table de pendencia para serem exibidas para aprovacao
*/
        
/* Necess†rio re-inicializar, pois pode ter seu valor alterado a cada processamento */
ASSIGN l-mestre         = l-aprovador-mestre.

IF NOT l-faixa-val-doc-default THEN DO: /* Caso deixe a faixa aberta de valor nao eh necessario converter os valores */
    IF l-necessita-conversao THEN DO:

        RUN pi-retorna-valor-convertido IN h-mlaapi019 (INPUT i-moeda-conversao,
                                                        INPUT IF i-tipo-conversao = 2 THEN {&TABLENAME}.dt-geracao ELSE TODAY,
                                                        INPUT {&TABLENAME}.valor-doc,
                                                        OUTPUT de-vl-doc-conv).

        IF de-vl-doc-conv < de-valor-ini OR de-vl-doc-conv > de-valor-fim THEN
            NEXT.
    END.
    ELSE DO:

        IF {&TABLENAME}.valor-doc < de-valor-ini OR {&TABLENAME}.valor-doc > de-valor-fim THEN
            NEXT.
    END.
END.

/* Usuario Mestre */
IF NOT l-mestre AND {&TABLENAME}.cod-usuar <> c-cod-usuar-trans THEN DO:
    
    IF l-assume-mestre-prin THEN DO:

        IF l-log-aprov-altern-data THEN DO:
            
            FOR FIRST tt-mla-alternativos-def
                WHERE tt-mla-alternativos-def.cod-usuar   = {&TABLENAME}.cod-usuar
                  AND tt-mla-alternativos-def.da-inicial <= {&TABLENAME}.dt-geracao
                  AND tt-mla-alternativos-def.da-final   >= {&TABLENAME}.dt-geracao:

                FIND FIRST tt-mla-usuar-aprov-pend
                     WHERE tt-mla-usuar-aprov-pend.cod-usuar = tt-mla-alternativos-def.cod-usuar NO-LOCK NO-ERROR.

                IF NOT AVAIL tt-mla-usuar-aprov-pend THEN DO:

                    RUN createTTmlaUsuarAprovPend (INPUT tt-mla-alternativos-def.cod-usuar, INPUT hmla-usuar-aprov).

                    FIND FIRST tt-mla-usuar-aprov-pend
                         WHERE tt-mla-usuar-aprov-pend.cod-usuar = tt-mla-alternativos-def.cod-usuar NO-LOCK NO-ERROR.
                    
                    /* Se o usu†rio para o qual ele Ç alternativo Ç mestre  */
                    IF AVAIL tt-mla-usuar-aprov-pend AND tt-mla-usuar-aprov-pend.usuar-mestre THEN 
                        ASSIGN l-mestre = YES.
                END.
                ELSE DO:
                    IF tt-mla-usuar-aprov-pend.usuar-mestre THEN
                        ASSIGN l-mestre = YES.
                END.
            END.
        END.
        ELSE DO:

            FOR FIRST tt-mla-alternativos-def
                WHERE tt-mla-alternativos-def.cod-usuar   = {&TABLENAME}.cod-usuar
                  AND tt-mla-alternativos-def.da-inicial <= TODAY
                  AND tt-mla-alternativos-def.da-final   >= TODAY:
                
                FIND FIRST tt-mla-usuar-aprov-pend
                     WHERE tt-mla-usuar-aprov-pend.cod-usuar = tt-mla-alternativos-def.cod-usuar NO-LOCK NO-ERROR.

                IF NOT AVAIL tt-mla-usuar-aprov-pend THEN DO:
                    
                    RUN createTTmlaUsuarAprovPend (INPUT tt-mla-alternativos-def.cod-usuar, INPUT hmla-usuar-aprov).

                    FIND FIRST tt-mla-usuar-aprov-pend
                         WHERE tt-mla-usuar-aprov-pend.cod-usuar = tt-mla-alternativos-def.cod-usuar NO-LOCK NO-ERROR.
                    
                    /* Se o usu†rio para o qual ele Ç alternativo Ç mestre  */
                    IF AVAIL tt-mla-usuar-aprov-pend AND tt-mla-usuar-aprov-pend.usuar-mestre THEN 
                        ASSIGN l-mestre = YES.
                END.
                ELSE DO:
                    IF tt-mla-usuar-aprov-pend.usuar-mestre THEN
                        ASSIGN l-mestre = YES.
                END.
            END.     
        END.
    END.
END.

/**  Somente Alternativo  **/
IF l-so-alternativos THEN DO:

    IF l-log-aprov-altern-data THEN
        FIND FIRST tt-mla-alternativos-def
             WHERE tt-mla-alternativos-def.cod-usuar   = {&TABLENAME}.cod-usuar
               AND tt-mla-alternativos-def.da-inicial <= {&TABLENAME}.dt-geracao
               AND tt-mla-alternativos-def.da-final   >= {&TABLENAME}.dt-geracao NO-LOCK NO-ERROR.
    ELSE
         FIND FIRST tt-mla-alternativos-def
              WHERE tt-mla-alternativos-def.cod-usuar   = {&TABLENAME}.cod-usuar
                AND tt-mla-alternativos-def.da-inicial <= TODAY
                AND tt-mla-alternativos-def.da-final   >= TODAY NO-LOCK NO-ERROR.

    IF NOT AVAIL tt-mla-alternativos-def THEN
        NEXT.
END.
ELSE DO:
    
    IF l-spp-allPendAprov = NO THEN
        IF NOT l-mestre AND {&TABLENAME}.cod-usuar <> c-cod-usuar-trans THEN
            NEXT.
END.

/**  Limite de Aprovaá∆o **/
ASSIGN l-limite = YES.

RUN goToKey IN hmla-perm-aprov (INPUT {&TABLENAME}.ep-codigo,
                                INPUT {&TABLENAME}.cod-estabel,
                                INPUT IF l-assume-permissoes-prin THEN {&TABLENAME}.cod-usuar ELSE c-cod-usuar-trans,
                                INPUT {&TABLENAME}.cod-tip-doc).

IF RETURN-VALUE = "OK":U THEN DO:
    RUN getPermAprovacao IN hmla-perm-aprov (INPUT {&TABLENAME}.valor-doc).
END.

IF RETURN-VALUE = "NOK" THEN DO:
    ASSIGN l-limite = NO.

    IF NOT l-sem-limite AND NOT l-mestre THEN
        NEXT.
END.

/**  Sem Permiss∆o na Lotaá∆o **/
ASSIGN l-lotacao = YES.

RUN emptyRowErrors  IN hmla-perm-lotacao.

RUN goToKey IN hmla-perm-lotacao (INPUT {&TABLENAME}.ep-codigo,
                                  INPUT c-cod-usuar-trans,
                                  INPUT {&TABLENAME}.cod-lotacao-doc).

RUN getPermLotacao IN hmla-perm-lotacao.

IF  RETURN-VALUE = "NOK":U AND c-cod-usuar-trans = {&TABLENAME}.cod-usuar THEN DO:
    ASSIGN l-lotacao = NO.
END.
ELSE
    IF RETURN-VALUE = "NOK":U THEN DO:

        /* Verifica se o usu†rio alternativo deve utilizar as permiss‰es de lotaá∆o do principal */
        IF c-cod-usuar-trans <> {&TABLENAME}.cod-usuar THEN DO:

            IF l-assume-lotacoes-prin THEN DO:

                RUN emptyRowErrors IN hmla-perm-lotacao.
                
                RUN goToKey IN hmla-perm-lotacao (INPUT {&TABLENAME}.ep-codigo,
                                                  INPUT {&TABLENAME}.cod-usuar, /* Utiliza o usu†rio principal*/
                                                  INPUT {&TABLENAME}.cod-lotacao-doc).

                IF  RETURN-VALUE = "NOK":U THEN
                    ASSIGN l-lotacao = NO.
                ELSE DO:
                    RUN getPermLotacao IN hmla-perm-lotacao.

                    IF  RETURN-VALUE = "NOK":U THEN
                        ASSIGN l-lotacao = NO.
                END.
            END.
            ELSE DO:
                ASSIGN l-lotacao = NO.
            END.
        END.
        ELSE DO:
            ASSIGN l-lotacao = NO.
        END.
    END.

IF NOT l-sem-lotacao AND NOT l-lotacao THEN
    NEXT.

/**  Cria temp-table **/
CREATE tt{&TABLENAME}.
BUFFER-COPY {&TABLENAME} TO tt{&TABLENAME}.
ASSIGN tt{&tablename}.situacao  = ENTRY({&TABLENAME}.ind-situacao, c-lista-situacao)
       tt{&TABLENAME}.rowid-doc = ROWID({&TABLENAME})
       tt{&TABLENAME}.limite    = l-limite
       tt{&TABLENAME}.lotacao   = l-lotacao
       tt{&TABLENAME}.hora-aprova  = SUBSTRING({&TABLENAME}.char-1,1,8)
       tt{&TABLENAME}.hora-rejeita  = SUBSTRING({&TABLENAME}.char-1,9,8)
       tt{&TABLENAME}.hora-reaprova  = SUBSTRING({&TABLENAME}.char-1,17,8).


/**  Nomes dos Usu†rios **/
FIND FIRST tt-mla-usuar-aprov-pend
     WHERE tt-mla-usuar-aprov-pend.cod-usuar = tt{&TABLENAME}.cod-usuar-trans NO-LOCK NO-ERROR.
IF NOT AVAIL tt-mla-usuar-aprov-pend THEN DO:

    RUN createTTmlaUsuarAprovPend (INPUT tt{&TABLENAME}.cod-usuar-trans, INPUT hmla-usuar-aprov).

    FOR FIRST tt-mla-usuar-aprov-pend 
        WHERE tt-mla-usuar-aprov-pend.cod-usuar = tt{&TABLENAME}.cod-usuar-trans NO-LOCK:

        ASSIGN tt{&TABLENAME}.nome-usuar-trans = tt-mla-usuar-aprov-pend.nome-usuar.
    END.
END.
ELSE
    ASSIGN tt{&TABLENAME}.nome-usuar-trans = tt-mla-usuar-aprov-pend.nome-usuar.


FIND FIRST tt-mla-usuar-aprov-pend
     WHERE tt-mla-usuar-aprov-pend.cod-usuar = tt{&TABLENAME}.cod-usuar-doc NO-LOCK NO-ERROR.
IF NOT AVAIL tt-mla-usuar-aprov-pend THEN DO:
    
    RUN createTTmlaUsuarAprovPend (INPUT tt{&TABLENAME}.cod-usuar-doc, INPUT hmla-usuar-aprov).

    FOR FIRST tt-mla-usuar-aprov-pend 
        WHERE tt-mla-usuar-aprov-pend.cod-usuar = tt{&TABLENAME}.cod-usuar-doc NO-LOCK:

        ASSIGN tt{&TABLENAME}.nome-usuar-doc = tt-mla-usuar-aprov-pend.nome-usuar.
    END.
END.
ELSE
    ASSIGN tt{&TABLENAME}.nome-usuar-doc = tt-mla-usuar-aprov-pend.nome-usuar.


FIND FIRST tt-mla-usuar-aprov-pend
     WHERE tt-mla-usuar-aprov-pend.cod-usuar = tt{&TABLENAME}.cod-usuar NO-LOCK NO-ERROR.
IF NOT AVAIL tt-mla-usuar-aprov-pend THEN DO:

   RUN createTTmlaUsuarAprovPend (INPUT tt{&TABLENAME}.cod-usuar, INPUT hmla-usuar-aprov).

   FOR FIRST tt-mla-usuar-aprov-pend 
       WHERE tt-mla-usuar-aprov-pend.cod-usuar = tt{&TABLENAME}.cod-usuar NO-LOCK:
       
       ASSIGN tt{&TABLENAME}.nome-usuar-aprov = tt-mla-usuar-aprov-pend.nome-usuar.
   END.
END.
ELSE
    ASSIGN tt{&TABLENAME}.nome-usuar-aprov = tt-mla-usuar-aprov-pend.nome-usuar.

FIND FIRST tt-mla-usuar-aprov-pend
     WHERE tt-mla-usuar-aprov-pend.cod-usuar = tt{&TABLENAME}.cod-usuar-altern NO-LOCK NO-ERROR.
IF NOT AVAIL tt-mla-usuar-aprov-pend THEN DO:
    
    RUN createTTmlaUsuarAprovPend (INPUT tt{&TABLENAME}.cod-usuar-altern, INPUT hmla-usuar-aprov).

    FOR FIRST tt-mla-usuar-aprov-pend 
        WHERE tt-mla-usuar-aprov-pend.cod-usuar = tt{&TABLENAME}.cod-usuar-altern NO-LOCK:
        
        ASSIGN tt{&TABLENAME}.nome-usuar-alter = tt-mla-usuar-aprov-pend.nome-usuar.
    END.
END.
ELSE
    ASSIGN tt{&TABLENAME}.nome-usuar-alter = tt-mla-usuar-aprov-pend.nome-usuar.

IF l-necessita-conversao THEN DO:
    ASSIGN tt{&TABLENAME}.vl-doc-conv = de-vl-doc-conv
           tt{&TABLENAME}.moeda-conv  = i-moeda-conversao.
END.
ELSE DO:
    ASSIGN tt{&TABLENAME}.vl-doc-conv = tt{&TABLENAME}.valor-doc
           tt{&TABLENAME}.moeda-conv  = tt{&TABLENAME}.mo-codigo.
END.


