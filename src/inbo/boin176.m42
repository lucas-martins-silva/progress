PROCEDURE validatePedidoOrdem :
    
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: Valida»’o do Pedido e Ordem de Compra      
------------------------------------------------------------------------------*/

    def var de-val-aux          as decimal  no-undo.
    def var l-pendente          as logical  no-undo.
    def var l-erro-multiplanta  as logical  no-undo.
    def var l-erro-co           as logical  no-undo.
    def var l-erro-refer        as logical  no-undo.
    def buffer b-item           for item. /*AAAUCP*/
	DEFINE VARIABLE h-re1008    AS HANDLE   NO-UNDO.
	define variable c-liter     as character no-undo.
    
    /* Leitura Ordem de Compra */

    run findOrdemCompra ( RowObject.numero-ordem,
                          input ? ).
    

    /* Leitura Pedido de Compra */
    

    run findPedido ( RowObject.num-pedido ).
    

    if  avail pedido-compr
    and pedido-compr.situacao = 3 then do:
        {method/svc/errors/inserr.i
                            &ErrorNumber="7169"  /*Pedido de compra eliminado*/
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"}
    end.
    

    if  avail pedido-compr then do:
		/*
		Valida bloqueio quando estabelecimento de entrega do pedido for diferente do estabelecimento do documento
		*/
		{utp/ut-liter.i "Seq:_" *}
		c-liter	= return-value  + string(rowObject.sequencia).
		run rep/re1008.p persistent set h-re1008.
		run pi-execute in h-re1008 (input RowObject.num-pedido,
									input docum-est.cod-estabel,
									input c-liter,
									OUTPUT TABLE RowErrors APPEND).
		delete procedure h-re1008.
		h-re1008 = ?.				
		if not can-find(first RowErrors where RowErrors.ErrorNumber = 57853) then
			if pedido-compr.end-entrega <> docum-est.cod-estabel then do:
				{method/svc/errors/inserr.i
									&ErrorNumber="18800"  /*Estabelecimento de entrega do pedido ý diferente do estabelecimento do documento.*/
									&ErrorType="EMS"
									&ErrorSubType="WARNING"}
			end.
    end.           

    if  avail pedido-compr then /*teste fornecedor do pedido e fornecedor mesma matriz*/
        run rep/re1007.p (input pedido-compr.cod-emitente,
                          input docum-est.cod-emitente,
                          input-output table RowErrors).
    
    if avail pedido-compr then do: /*AAAUCP*/
        find first b-item no-lock
             where b-item.it-codigo = RowObject.it-codigo no-error.
        if avail b-item
        and b-item.tipo-contr <> 4 then do:
            IF NOT CAN-FIND(FIRST item-fornec 
                            WHERE item-fornec.it-codigo    = item.it-codigo 
                              AND item-fornec.cod-emitente = rowObject.cod-emitente
                              AND item-fornec.ativo) THEN DO:
                {method/svc/errors/inserr.i
                                 &ErrorNumber="3306"
                                 &ErrorType="EMS"
                                 &ErrorSubType="ERROR"}
            END.
        end.
    end. /*AAAUCP*/

    if  avail ordem-compra
    and RowObject.num-pedido <> ordem-compra.num-pedido then do:
        {method/svc/errors/inserr.i
                            &ErrorNumber="7342"  /*Ordem de compra nÊo pertence ao pedido*/
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"}
    end.

    if  avail ordem-compra
    and RowObject.it-codigo <> ordem-compra.it-codigo then do:
        {method/svc/errors/inserr.i
                            &ErrorNumber="15187"  /*Item da ordem nÊo confere com item da nota fiscal*/
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"}
    end.

    if  avail ordem-compra
    and ordem-compra.situacao <> 2 
    and not docum-est.rec-fisico then do:
        {method/svc/errors/inserr.i
                            &ErrorNumber="15188"  /*Situa¯Êo da ordem nÊo permite movimenta¯Êo*/
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"}
    end.

    if  param-compra.log-1 then do:
        run cdp/cdapi172.p (input 4, input rowid(ordem-compra), output l-pendente).
        if  not l-pendente then
            run cdp/cdapi172.p (input 6, input rowid(ordem-compra), output l-pendente).
        if  l-pendente then do:
            {method/svc/errors/inserr.i
                            &ErrorNumber="17022"  /*Documento estÿ pendente de aprova»’o*/
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"}
        end.
    end.

    /* Leitura Parcela da Ordem de Compra */
    

    run findPrazoCompra ( RowObject.numero-ordem,
                          RowObject.parcela ).

    if  avail prazo-compra
    and prazo-compra.situacao <> 2 
    and not docum-est.rec-fisico then do:
        {method/svc/errors/inserr.i
                            &ErrorNumber="6897"  /*Situa¯Êo da parcela nÊo permite moviment¯Êo*/
                            &ErrorType="EMS"
                            &ErrorSubType="ERROR"}
    end.
    
    if  avail prazo-compra
    and prazo-compra.cod-refer <> RowObject.cod-refer then do:
    
        {method/svc/errors/inserr.i
                    &ErrorNumber="56951" /*Referencia da parcela da OC eh diferente do item da nota*/
                    &ErrorType="EMS"
                    &ErrorSubType="WARNING"}
                    
        assign l-erro-refer = yes.
    end.
    else 
        assign l-erro-refer = no.
    
    if can-find(funcao where
                funcao.cd-funcao = "spp-consist-refer-nf" and
                funcao.ativo) then do:
        run beforeValidateBoin060 (input 1). /* Instancia */
        run updateConsistNota in h-boin060 (RowObject.cod-emitente,
                                            RowObject.serie-docto,
                                            RowObject.nro-docto,
                                            RowObject.nat-operacao,
                                            RowObject.sequencia,
                                            (not l-erro-refer), /*elimina consit nota*/
                                            0,
                                            0,
                                            56951, /*Referencia da parcela da OC eh diferente do item da nota*/
                                            2). /*tipo 1=erro 2=advertencia*/
        run beforeValidateBoin060 (input 2). /* Elimina */ 
    end.

    if  avail ordem-compra 
    and ordem-compra.nr-contrato <> 0 
    and param-global.modulo-cn then do:
    
        run cnp/cn9174.p (RowObject.numero-ordem,
                          2,  
                          RowObject.int-1,
                          0,
                          docum-est.dt-emissao,
                          output de-val-aux,
                          output l-erro-co,
                          output l-contrato,
                          output i-total,
                          input-output table tt-erro).  
                          

        if  l-erro-co then do:
            for each tt-erro:                
                RUN _insertErrorManual IN THIS-PROCEDURE (INPUT tt-erro.cd-erro,
                                                          INPUT "EMS":U,
                                                          INPUT "ERROR":U,
                                                          INPUT tt-erro.mensagem,
                                                          INPUT tt-erro.mensagem,
                                                          INPUT "":U).
            end.                                          
        end.              
        
        /**** Verifica se contrato est  pendente de aprova‡Æo ****/
        if  param-compra.log-1  = yes 
        and param-contrat.log-1 = yes then do: 
             
            assign l-pendente = no.
                 
            if ordem-compra.num-seq-item <> 0 then do: 
                
               run findContrato (ordem-compra.nr-contrato).
               run findItemContrato (ordem-compra.nr-contrato, ordem-compra.num-seq-item).
                
              if avail contrato-for and contrato-for.dec-2     = 0 and
                 avail item-contrat and item-contrat.val-total = 0 then  
                       run cdp/cdapi172.p (8, rowid(ordem-compra), output l-pendente).
              else
                       run cdp/cdapi172.p (8, rowid(item-contrat), output l-pendente).
            end.
            else for each item-contrat no-lock
                    where item-contrat.nr-contrato = ordem-compra.nr-contrato: 
                
                       run cdp/cdapi172.p (8, rowid(item-contrat), output l-pendente).
                       if l-pendente = yes then leave.
            end.
                
            if l-pendente = yes then do:
                   {method/svc/errors/inserr.i
                               &ErrorNumber="16326"
                               &ErrorType="EMS"
                               &ErrorSubType="ERROR" 
                               &ErrorParameters="STRING(ordem-compra.numero-ordem) + '~~~~' + 
                                                 STRING(RowObject.it-codigo)       + '~~~~' + 
                                                 STRING(RowObject.quantidade)      + '~~~~' + 
                                                 STRING(ordem-compra.nr-contrato)  + '~~~~' + 
                                                 STRING(ordem-compra.cod-estabel) "} 
            end.
        end.      
        /**********************************************************/
        
    end.
    
    if  not l-contrato then do: 
        if  avail prazo-compra
        and (   prazo-compra.data-entrega > docum-est.dt-emissao + param-re.variacao 
             or prazo-compra.data-entrega < docum-est.dt-emissao - param-re.variacao) then do:
            {method/svc/errors/inserr.i
                                &ErrorNumber="18802"  /*Data de entrega da parcela esta fora da varia¯Êo.*/
                                &ErrorType="EMS"
                                &ErrorSubType="WARNING"}
        end.       
    end.
       
    return "OK":U.

END PROCEDURE.




