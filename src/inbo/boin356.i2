
/*****************************************************************************
  Include para Considerar apenas Dias Uteis na data da entrega

  BOIN356.I2

******************************************************************************/
                                             
assign i-cont = 1
       l-erro-calend = no.

/* s¢ executa se o novo parametro estiver marcado no param-compra  */

REPEAT WHILE i-cont <= dias-ressup.

    FIND FIRST calen-prod no-lock WHERE 
               calen-prod.cod-estabel = {1} AND 
               calen-prod.data  = nova-dt + 1 no-error.

    IF AVAIL calen-prod THEN DO:
       IF calen-prod.tipo-dia = 1 THEN  /* dia £til */ 
          ASSIGN i-cont = i-cont + 1.
    END. 
    ELSE DO:
       ASSIGN l-erro-calend = yes.
       LEAVE. /* erro: nÆo tem calen-prod cadastrado */ 
    END.
    
    ASSIGN nova-dt = nova-dt + 1. 
        
END.
