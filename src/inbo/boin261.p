&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQuery DBOProgram 
PROCEDURE openQuery :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
/* ------------------------ PROXIES BO 1.1 ----------------------------- */

    define input parameter i-abertura as integer no-undo.
       case i-abertura:
           when 1 then
              RUN openQueryStatic (input "Main":U). 
              
           when 2 then
              RUN openQueryStatic (input "ByFiltroOperPad":U).
           
           when 3 then
              RUN openQueryStatic (input "ByFiltroDescricao":U).
           
       end case.
    
    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryByFiltroDescricao DBOProgram 
PROCEDURE openQueryByFiltroDescricao :
/*------------------------------------------------------------------------------
  Purpose:     Busca conjunto de registros da tabela oper-pad, dentro 
               de uma faixa de descri‡Æo inicial e final. 
               Ordena por descri‡Æo.
      
------------------------------------------------------------------------------*/
 open query {&QUERYNAME} for each {&TABLENAME} where {&TABLENAME}.descricao >= c-inicial AND
                                                     {&TABLENAME}.descricao <= c-final
                                                      NO-LOCK by {&TABLENAME}.descricao INDEXED-REPOSITION.
                                          
    RETURN "OK":U.


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryByFiltroOperPad DBOProgram 
PROCEDURE openQueryByFiltroOperPad :
/*------------------------------------------------------------------------------
  Purpose:    Busca conjunto de registros da tabela oper-pad dentro
              de uma faixa de opera‡Æo padrÆo inicial e final. 
              Ordena por opera‡Æo padrÆo. 
      
------------------------------------------------------------------------------*/
  open query {&QUERYNAME} for each {&TABLENAME} where {&TABLENAME}.nr-oper-pad >= integer(c-inicial) and 
                                                      {&TABLENAME}.nr-oper-pad <= integer(c-final)
                                                       no-lock by {&TABLENAME}.nr-oper-pad INDEXED-REPOSITION.


   RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryMain DBOProgram 
PROCEDURE openQueryMain :
/*------------------------------------------------------------------------------
  Purpose:     Abertura da query principal do DBO
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH oper-pad NO-LOCK INDEXED-REPOSITION.

    RETURN "OK":U.
END PROCEDURE.

