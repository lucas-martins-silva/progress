PROCEDURE defaultContaTransit :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def output param pi-conta-transit   like docum-est.ct-transit no-undo.
    def output param pi-ccusto-transit  like docum-est.ct-transit no-undo.

    DEFINE VARIABLE c-char-2 AS CHARACTER  NO-UNDO.

    if avail RowObject then
        run setFlagsNota in this-procedure ( RowObject.cod-observa,
                                             RowObject.nat-operacao ).

    if  not avail natur-oper 
    or  not avail estab-mat then do:
        if avail RowObject then do:
            run findNaturOper in this-procedure (input RowObject.nat-operacao).
            run findEstabelec in this-procedure (input RowObject.cod-estabel).
        end.
        else
            RETURN "NOK":U.
    end.
    
    if  not avail natur-oper 
    or  not avail estab-mat then 
        RETURN "NOK":U.

    assign l-fatura-fat-antecip  = no
           l-fatura-ent-futura   = no
           l-remessa-fat-antecip = no
           l-remessa-ent-futura  = no.

    /*busca conta e cc no engine de regras*/
    IF CAN-FIND(FIRST config-operac 
                WHERE config-operac.cdn-empresa    = estabelec.ep-codigo
                  AND config-operac.cod-estab      = RowObject.cod-estabel
                  AND config-operac.cod-tip-operac = "re-conta-transit":U) THEN DO:
        RUN pi-engine-conta-transit IN THIS-PROCEDURE (OUTPUT pi-conta-transit,
                                                       OUTPUT pi-ccusto-transit).
    END.

    IF pi-conta-transit <> "":U THEN /*achou conta e/ou centro-de-custo do engine*/
        RETURN RETURN-VALUE.

    /*--- verifica se a nota eh uma REMESSA ent futura/fat antecipado ---*/
    run getFatAntecipEntFutura (INPUT  natur-oper.nat-operacao,
                                OUTPUT l-fatura-fat-antecip,
                                OUTPUT l-remessa-fat-antecip,
                                OUTPUT l-fatura-ent-futura,
                                OUTPUT l-remessa-ent-futura). 
                                
    if  l-remessa-fat-antecip
    or  l-remessa-ent-futura  then do:
        if  l-remessa-fat-antecip then
            assign pi-conta-transit  = estab-mat.cod-cta-faturam-antec
                   pi-ccusto-transit = estab-mat.cod-ccusto-faturam-antec.
         
        if  l-remessa-ent-futura then
            assign pi-conta-transit  = estab-mat.cod-cta-entreg-fut-unif    
                   pi-ccusto-transit = estab-mat.cod-ccusto-entreg-fut-unif.
    end.
    else 
        if  l-transf or natur-oper.tipo-compra = 8 then 
            assign pi-conta-transit  = estab-mat.cod-cta-transf-unif
                   pi-ccusto-transit = estab-mat.cod-ccusto-transf-unif.
        else
            if natur-oper.terceiros and
               natur-oper.tp-oper-terc <> 4 then do:       /* N∆o considera Faturamento Consignaá∆o */
                if  natur-oper.tp-oper-terc = 1 then                                        /* Entrada Benef */
                    assign pi-conta-transit  = estab-mat.cod-cta-e-benef-unif
                           pi-ccusto-transit = estab-mat.cod-ccusto-e-benef-unif.
                else
                    if natur-oper.tp-oper-terc = 2 then                                    /* Retorno Benef */
                        assign pi-conta-transit  = estab-mat.cod-cta-saida-benef-unif
                               pi-ccusto-transit = estab-mat.cod-ccusto-saida-benef-unif.
                    else
                        if natur-oper.tp-oper-terc = 5 then                                    /* Devol Consig  */
                            assign pi-conta-transit  = estab-mat.cod-cta-saida-consig-unif
                                   pi-ccusto-transit = estab-mat.cod-ccusto-saida-consig-unif.
                        else           
                            if natur-oper.tp-oper-terc = 8 then                                /* Remessa Dep Fechado */
                                assign pi-conta-transit  = estab-mat.cod-cta-entr-dep-fechado
                                       pi-ccusto-transit = estab-mat.cod-ccusto-entr-dep-fecha.
                            else          
                                if natur-oper.tp-oper-terc = 9 then                            /* Retorno Dep Fechado */
                                    assign pi-conta-transit  = estab-mat.cod-cta-saida-dep-fechado
                                           pi-ccusto-transit = estab-mat.cod-ccusto-saida-dep-fecha.
                                else            
                                    if natur-oper.tp-oper-terc = 10 then                       /* Remessa Armaz Geral */
                                        assign pi-conta-transit  = estab-mat.cod-cta-entr-arm-geral
                                               pi-ccusto-transit = estab-mat.cod-ccusto-entr-arm-geral.
                                    else
                                        if natur-oper.tp-oper-terc = 11 then                   /* Retorno Armaz Geral */
                                            assign pi-conta-transit  = estab-mat.cod-cta-saida-arm-geral
                                                   pi-ccusto-transit = estab-mat.cod-ccusto-saida-arm-geral.
                                        else 
                                            assign pi-conta-transit  = estab-mat.cod-cta-e-consig-unif /* Compra Consig */
                                                   pi-ccusto-transit = estab-mat.cod-ccusto-e-consig-unif.
            end.
            else 
                if  l-devolucao then 
                    assign pi-conta-transit  = estab-mat.cod-cta-devol-c-unif
                           pi-ccusto-transit = estab-mat.cod-ccusto-devol-c-unif.
                else 
                    if  natur-oper.tipo-compra = 2 then /* Nota de frete */
                        assign pi-conta-transit  = estab-mat.cod-cta-frete-unif
                               pi-ccusto-transit = estab-mat.cod-ccusto-frete-unif.
                    else
                        assign pi-conta-transit  = estab-mat.cod-cta-fornec-unif
                               pi-ccusto-transit = estab-mat.cod-ccusto-fornec-unif.

    ASSIGN RowObject.ct-transit = pi-conta-transit
           RowObject.sc-transit = pi-ccusto-transit. 

    RETURN "OK":U.

END PROCEDURE.


PROCEDURE pi-engine-conta-transit:

    DEFINE OUTPUT PARAMETER p-pi-conta-transit  LIKE docum-est.ct-transit NO-UNDO.
    DEFINE OUTPUT PARAMETER p-pi-ccusto-transit LIKE docum-est.sc-transit NO-UNDO.

    DEFINE VARIABLE h-cdapi034            AS HANDLE    NO-UNDO.
    DEFINE VARIABLE i-cod-regra-utilizada AS INTEGER   NO-UNDO.
    DEFINE VARIABLE c-empresa             AS CHARACTER NO-UNDO.
    DEFINE VARIABLE c-chave-docto         AS CHARACTER NO-UNDO.    
	
    RUN pi-carrega-var-engine (OUTPUT TABLE tt-variavel).

    FOR FIRST estabelec NO-LOCK
        WHERE estabelec.cod-estabel = RowObject.cod-estabel:
        ASSIGN c-empresa = estabelec.ep-codigo.
    END.

    IF NOT VALID-HANDLE(h-cdapi034) THEN
        RUN cdp/cdapi034.p PERSISTENT SET h-cdapi034 (INPUT c-empresa,
                                                      INPUT RowObject.cod-estabel,
                                                      INPUT "RE-Conta-Transit":U,
                                                      INPUT TABLE tt-variavel,
                                                      OUTPUT i-cod-regra-utilizada,
                                                      OUTPUT TABLE tt-retorno,
                                                      OUTPUT TABLE RowErrorsAux).

    ASSIGN c-chave-docto = STRING(RowObject.cod-emitente) + "|" + RowObject.serie-docto + "|" + RowObject.nro-docto + "|" + RowObject.nat-operacao.

    RUN set-constraint-log-execucao IN h-cdapi034(INPUT c-chave-docto,
                                                  INPUT 0,    /*seq item*/
                                                  INPUT "":U, /*conteudo original*/
                                                  INPUT 0).   /*tipo documento (NFe)*/

    RUN pi-inicializa IN h-cdapi034 (INPUT c-empresa,
                                     INPUT RowObject.cod-estabel,
                                     INPUT "RE-Conta-Transit":U,
                                     INPUT TABLE tt-variavel,
                                     OUTPUT i-cod-regra-utilizada,
                                     OUTPUT TABLE tt-retorno,
                                     OUTPUT TABLE RowErrorsAux).

    IF VALID-HANDLE(h-cdapi034) THEN DO:
        DELETE PROCEDURE h-cdapi034.
        ASSIGN h-cdapi034 = ?.
    END.

	/*desconsidera erro de regra n∆o encontrada, neste caso ele ir† gerar as notas com os parametros informados em tela*/
    FOR EACH RowErrorsAux
        WHERE RowErrorsAux.ErrorNumber = 25997:
            DELETE RowErrorsAux.
    END.
    IF CAN-FIND (FIRST RowErrorsAux
                 WHERE RowErrorsAux.ErrorNumber <> 25997) THEN DO:
                 {method/svc/errors/inserr.i
                            &ErrorNumber= RowErrorsAux.ErrorNumber
                            &ErrorType= RowErrorsAux.ErrorType
                            &ErrorSubType=RowErrorsAux.ErrorSubType
                            &ErrorParameters=RowErrorsAux.ErrorParameters
                            &ErrorDescription=RowErrorsAux.ErrorDescription
                            &ErrorHelp=RowErrorsAux.ErrorHelp}
       RETURN "NOK":U.
    END.
    
    /*Elimina conte£do das Variaveis*/
    ASSIGN p-pi-conta-transit  = "":U
           p-pi-ccusto-transit = "":U.
    
    /*passa os retornos do engine para as variaveis apropriadas*/
    FOR EACH tt-retorno:

        IF tt-retorno.campo-retorno = "conta-contabil":U THEN
            ASSIGN p-pi-conta-transit = tt-retorno.valor-retorno.
    
        IF tt-retorno.campo-retorno = "centro-de-custo":U THEN
            ASSIGN p-pi-ccusto-transit = tt-retorno.valor-retorno.
        
    END.

    IF p-pi-conta-transit <> "":U THEN DO:
        ASSIGN RowObject.ct-transit = p-pi-conta-transit
               RowObject.sc-transit = p-pi-ccusto-transit. 
        RETURN "OK":U.
    END.

    RETURN "NOK":U. /*se estiver tudo certo com o retorno, tera retornado "OK" na linha acima, caso contrario, nao encontrou cc e devera continuar buscando no CD0611*/

END PROCEDURE.


PROCEDURE defaultTipoOperacao :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT-OUTPUT PARAM i-idi-tip-operac  like docum-est.idi-tip-operac no-undo.
    DEFINE VARIABLE i-idi-tip-operac-aux AS INT  no-undo.

    IF NOT AVAIL RowObject THEN RETURN "NOK".

    IF oTipoOperacaoUtil = ? THEN oTipoOperacaoUtil = new rep.utils.TipoOperacaoUtil().

    ASSIGN i-idi-tip-operac = oTipoOperacaoUtil:defaultTipoOper(input RowObject.nat-operacao). /* Default do sistema */

    /* Engine de regras - RE-Tipo-Operacao
       Roda sempre pois a regra do usuario eh mais forte. Ex. Pode ter vindo do conversor como Compra e eh uma Doacao */
    RUN pi-engine-tipo-operacao (output i-idi-tip-operac-aux). /* Engine */
    IF oTipoOperacaoUtil:existeTipoOper(i-idi-tip-operac-aux) THEN
        ASSIGN i-idi-tip-operac = i-idi-tip-operac-aux. /* Retorna o que foi sugerido pelo engine */

    RETURN "OK":U.

    FINALLY:
        DELETE OBJECT oTipoOperacaoUtil NO-ERROR.
        ASSIGN oTipoOperacaoUtil = ?.
    END FINALLY.

END PROCEDURE.


PROCEDURE pi-engine-tipo-operacao:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAM i-idi-tip-operac  like docum-est.idi-tip-operac no-undo.

    DEFINE VARIABLE h-cdapi034            AS HANDLE    NO-UNDO.
    DEFINE VARIABLE i-cod-regra-utilizada AS INTEGER   NO-UNDO.
    DEFINE VARIABLE c-chave-docto         AS CHARACTER NO-UNDO.

    IF NOT AVAIL RowObject THEN RETURN "NOK".

    IF NOT AVAIL estabelec OR estabelec.cod-estabel <> RowObject.cod-estabel THEN
        FOR FIRST estabelec NO-LOCK WHERE estabelec.cod-estabel = RowObject.cod-estabel: END.

    IF NOT CAN-FIND(FIRST config-operac 
                    WHERE config-operac.cdn-empresa    = estabelec.ep-codigo
                      AND config-operac.cod-estab      = estabelec.cod-estabel
                      AND config-operac.cod-tip-operac = "RE-Tipo-Operacao":U) THEN RETURN "NOK".

    RUN pi-carrega-var-engine (OUTPUT TABLE tt-variavel).

    IF NOT VALID-HANDLE(h-cdapi034) THEN
        RUN cdp/cdapi034.p PERSISTENT SET h-cdapi034 (INPUT estabelec.ep-codigo,
                                                      INPUT RowObject.cod-estabel,
                                                      INPUT "RE-Tipo-Operacao":U,
                                                      INPUT TABLE tt-variavel,
                                                      OUTPUT i-cod-regra-utilizada,
                                                      OUTPUT TABLE tt-retorno,
                                                      OUTPUT TABLE RowErrorsAux).

    ASSIGN c-chave-docto = STRING(RowObject.cod-emitente) + "|" + RowObject.serie-docto + "|" + RowObject.nro-docto + "|" + RowObject.nat-operacao.

    RUN set-constraint-log-execucao IN h-cdapi034(INPUT c-chave-docto,
                                                  INPUT 0,                        /* seq item */
                                                  INPUT RowObject.idi-tip-operac, /* conteudo original */
                                                  INPUT 0).                       /* tipo documento */

    RUN pi-inicializa IN h-cdapi034 (INPUT estabelec.ep-codigo,
                                     INPUT RowObject.cod-estabel,
                                     INPUT "RE-Tipo-Operacao":U,
                                     INPUT TABLE tt-variavel,
                                     OUTPUT i-cod-regra-utilizada,
                                     OUTPUT TABLE tt-retorno,
                                     OUTPUT TABLE RowErrorsAux).

    IF VALID-HANDLE(h-cdapi034) THEN DO:
        DELETE PROCEDURE h-cdapi034.
        ASSIGN h-cdapi034 = ?.
    END.


    /*desconsidera erro de regra n∆o encontrada, neste caso ele ir† gerar as notas com os parametros informados em tela*/
    FOR EACH RowErrorsAux
        WHERE RowErrorsAux.ErrorNumber = 25997:
            DELETE RowErrorsAux.
    END.
    IF CAN-FIND (FIRST RowErrorsAux
                 WHERE RowErrorsAux.ErrorNumber <> 25997) THEN DO:
                 {method/svc/errors/inserr.i
                            &ErrorNumber=RowErrorsAux.ErrorNumber
                            &ErrorType=RowErrorsAux.ErrorType
                            &ErrorSubType=RowErrorsAux.ErrorSubType
                            &ErrorParameters=RowErrorsAux.ErrorParameters
                            &ErrorDescription=RowErrorsAux.ErrorDescription
                            &ErrorHelp=RowErrorsAux.ErrorHelp}
       RETURN "NOK":U.
    END.

    FOR EACH tt-retorno WHERE tt-retorno.campo-retorno = "RE-Tipo-Operacao":U:
        ASSIGN i-idi-tip-operac = INT(TRIM(tt-retorno.valor-retorno)) NO-ERROR.
        IF ERROR-STATUS:ERROR THEN DO: /* Retorno deve ser um inteiro */
            RETURN "NOK":U.
        END.
    END.

    RETURN "OK":U.

END PROCEDURE.

PROCEDURE defaultCodObserva :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER i-cod-observa-aux AS INTEGER NO-UNDO.
    
    IF NOT AVAIL RowObject THEN RETURN "NOK".

    /* Engine de regras - RE-Cod-Observa
       Roda somente para notas que nao sejam Devolucao/Comercio */
    RUN pi-engine-cod-observa (output i-cod-observa-aux). /* Engine */
    
    RETURN "OK":U.

END PROCEDURE.
   
PROCEDURE pi-engine-cod-observa:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
     DEFINE OUTPUT PARAMETER i-cod-observa-aux AS INTEGER NO-UNDO.

    DEFINE VARIABLE h-cdapi034            AS HANDLE    NO-UNDO.
    DEFINE VARIABLE i-cod-regra-utilizada AS INTEGER   NO-UNDO.
    DEFINE VARIABLE c-chave-docto         AS CHARACTER NO-UNDO.

    IF NOT AVAIL RowObject THEN RETURN "NOK".

    IF NOT AVAIL estabelec OR estabelec.cod-estabel <> RowObject.cod-estabel THEN
        FOR FIRST estabelec NO-LOCK WHERE estabelec.cod-estabel = RowObject.cod-estabel: END.

    IF NOT CAN-FIND(FIRST config-operac 
                    WHERE config-operac.cdn-empresa    = estabelec.ep-codigo
                      AND config-operac.cod-estab      = estabelec.cod-estabel
                      AND config-operac.cod-tip-operac = "RE-Cod-Observa":U) THEN RETURN "NOK".                      

    RUN pi-carrega-var-engine (OUTPUT TABLE tt-variavel).

    IF NOT VALID-HANDLE(h-cdapi034) THEN
        RUN cdp/cdapi034.p PERSISTENT SET h-cdapi034 (INPUT estabelec.ep-codigo,
                                                      INPUT RowObject.cod-estabel,
                                                      INPUT "RE-Cod-Observa":U,
                                                      INPUT TABLE tt-variavel,
                                                      OUTPUT i-cod-regra-utilizada,
                                                      OUTPUT TABLE tt-retorno,
                                                      OUTPUT TABLE RowErrorsAux).

    ASSIGN c-chave-docto = STRING(RowObject.cod-emitente) + "|" + RowObject.serie-docto + "|" + RowObject.nro-docto + "|" + RowObject.nat-operacao.

    RUN set-constraint-log-execucao IN h-cdapi034(INPUT c-chave-docto,
                                                  INPUT 0,                        /* seq item */
                                                  INPUT RowObject.cod-observa,    /* conteudo original */
                                                  INPUT 0).                       /* tipo documento */

    RUN pi-inicializa IN h-cdapi034 (INPUT estabelec.ep-codigo,
                                     INPUT RowObject.cod-estabel,
                                     INPUT "RE-Cod-Observa":U,
                                     INPUT TABLE tt-variavel,
                                     OUTPUT i-cod-regra-utilizada,
                                     OUTPUT TABLE tt-retorno,
                                     OUTPUT TABLE RowErrorsAux).

    IF VALID-HANDLE(h-cdapi034) THEN DO:
        DELETE PROCEDURE h-cdapi034.
        ASSIGN h-cdapi034 = ?.
    END.


    /*desconsidera erro de regra n∆o encontrada, neste caso ele ir† gerar as notas com os parametros informados em tela*/
    FOR EACH RowErrorsAux
        WHERE RowErrorsAux.ErrorNumber = 25997:
            DELETE RowErrorsAux.
    END.
    IF CAN-FIND (FIRST RowErrorsAux
                 WHERE RowErrorsAux.ErrorNumber <> 25997) THEN DO:
                 {method/svc/errors/inserr.i
                            &ErrorNumber=RowErrorsAux.ErrorNumber
                            &ErrorType=RowErrorsAux.ErrorType
                            &ErrorSubType=RowErrorsAux.ErrorSubType
                            &ErrorParameters=RowErrorsAux.ErrorParameters
                            &ErrorDescription=RowErrorsAux.ErrorDescription
                            &ErrorHelp=RowErrorsAux.ErrorHelp}
       RETURN "NOK":U.
    END.
  
    FOR EACH tt-retorno WHERE tt-retorno.campo-retorno = "RE-Cod-Observa":U:
        ASSIGN i-cod-observa-aux = INT(TRIM(tt-retorno.valor-retorno)) NO-ERROR.
        IF ERROR-STATUS:ERROR THEN DO: /* Retorno deve ser um inteiro */
            RETURN "NOK":U.
        END.
    END.

    RETURN "OK":U.

END PROCEDURE.

PROCEDURE pi-carrega-var-engine:

    DEFINE OUTPUT PARAMETER TABLE FOR tt-variavel.

    EMPTY TEMP-TABLE tt-variavel.

	IF NOT AVAIL RowObject THEN RETURN "NOK".

    /*Carrega variaveis para o engine de regras*/
    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "cod-observacao":U
           tt-variavel.valor-variavel    = STRING(RowObject.cod-observa).

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "data-emissao":U
           tt-variavel.valor-variavel    = STRING(RowObject.dt-emissao).

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "data-trans":U
           tt-variavel.valor-variavel    = STRING(RowObject.dt-trans).


    /*Conjunto vari·veis Emitente*/
    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "cod-emitente":U
           tt-variavel.valor-variavel    = STRING(RowObject.cod-emitente).

    FOR FIRST emitente NO-LOCK
        WHERE emitente.cod-emitente = RowObject.cod-emitente:

        CREATE tt-variavel.
        ASSIGN tt-variavel.cod-var-oper      = "matriz-emit":U
               tt-variavel.valor-variavel    = emitente.nome-matriz.

        CREATE tt-variavel.
        ASSIGN tt-variavel.cod-var-oper      = "cod-gr-forn":U
               tt-variavel.valor-variavel    = STRING(emitente.cod-gr-forn).

        CREATE tt-variavel.
        ASSIGN tt-variavel.cod-var-oper      = "cidade-emit":U
               tt-variavel.valor-variavel    = emitente.cidade.

        CREATE tt-variavel.
        ASSIGN tt-variavel.cod-var-oper      = "uf-emit":U
               tt-variavel.valor-variavel    = emitente.estado.
    END.

    /*Conjunto vari·veis Natureza OperaÁ„o*/
    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "nat-operacao":U
           tt-variavel.valor-variavel    = RowObject.nat-operacao.

    IF NOT AVAIL natur-oper OR natur-oper.nat-operacao <> RowObject.nat-operacao THEN
        FOR FIRST natur-oper WHERE natur-oper.nat-operacao = RowObject.nat-operacao NO-LOCK. END.

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "cod-cfop":U
           tt-variavel.valor-variavel    = natur-oper.cod-cfop.

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "tipo-compra":U
           tt-variavel.valor-variavel    = STRING(natur-oper.tipo-compra).

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "especie-doc":U
           tt-variavel.valor-variavel    = natur-oper.especie-doc.

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "modelo-eletr":U
           tt-variavel.valor-variavel    = natur-oper.cod-model-nf-eletro.

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "log-transf":U
           tt-variavel.valor-variavel    = STRING(natur-oper.transf).

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "log-terceiros":U
           tt-variavel.valor-variavel    = STRING(natur-oper.terceiros).

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "tipo-oper-terc":U
           tt-variavel.valor-variavel    = STRING(natur-oper.tp-oper-terc).

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "log-gera-nf-fat":U
           tt-variavel.valor-variavel    = STRING(natur-oper.imp-nota).

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "log-nf-rateio":U
           tt-variavel.valor-variavel    = STRING(natur-oper.nota-rateio).

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "log-nf-propria":U
           tt-variavel.valor-variavel    = STRING(natur-oper.ind-nota-propria = 1).

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "log-nf-comercio":U
           tt-variavel.valor-variavel    = STRING(natur-oper.log-2).

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "log-compra-ativo":U
           tt-variavel.valor-variavel    = STRING(natur-oper.venda-ativo).

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "log-emite-duplic":U
           tt-variavel.valor-variavel    = STRING(natur-oper.emite-duplic).

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "log-gera-of":U
           tt-variavel.valor-variavel    = STRING(natur-oper.ind-gera-of).

    RUN getFatAntecipEntFutura (INPUT  natur-oper.nat-operacao,
                                OUTPUT l-fatura-fat-antecip,
                                OUTPUT l-remessa-fat-antecip,
                                OUTPUT l-fatura-ent-futura,
                                OUTPUT l-remessa-ent-futura).

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "l-fat-fat-antec":U
           tt-variavel.valor-variavel    = STRING(l-fatura-fat-antecip).

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "l-rem-fat-antec":U
           tt-variavel.valor-variavel    = STRING(l-remessa-fat-antecip).

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "l-fat-ent-futura":U
           tt-variavel.valor-variavel    = STRING(l-fatura-ent-futura).

    CREATE tt-variavel.
    ASSIGN tt-variavel.cod-var-oper      = "l-rem-ent-futura":U
           tt-variavel.valor-variavel    = STRING(l-remessa-ent-futura).

    RETURN "OK":U.

END PROCEDURE.
