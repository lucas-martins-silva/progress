               retorna status do processo
  Notes:
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pnr-ord-produ LIKE pert-ordem.nr-ord-produ NO-UNDO.
    DEFINE OUTPUT PARAMETER pit-codigo LIKE pert-ordem.it-codigo NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-roteiro LIKE pert-ordem.cod-roteiro NO-UNDO.
    DEFINE OUTPUT PARAMETER pop-codigo LIKE pert-ordem.op-codigo NO-UNDO.
    DEFINE OUTPUT PARAMETER pit-predec LIKE pert-ordem.it-predec NO-UNDO.
    DEFINE OUTPUT PARAMETER prot-predec LIKE pert-ordem.rot-predec NO-UNDO.
    DEFINE OUTPUT PARAMETER pop-predec LIKE pert-ordem.op-predec NO-UNDO.

    /*--- Verifica se temptable RowObject estÿ dispon­vel, caso n’o esteja serÿ
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN
       RETURN "NOK":U.

    ASSIGN pnr-ord-produ = RowObject.nr-ord-produ.
    ASSIGN pit-codigo = RowObject.it-codigo.
    ASSIGN pcod-roteiro = RowObject.cod-roteiro.
    ASSIGN pop-codigo = RowObject.op-codigo.
    ASSIGN pit-predec = RowObject.it-predec.
    ASSIGN prot-predec = RowObject.rot-predec.
    ASSIGN pop-predec = RowObject.op-predec.

    RETURN "OK":U.
END PROCEDURE.

