&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE findPert DBOProgram 
PROCEDURE findPert :
/*------------------------------------------------------------------------------
  Purpose:    Procura pelo ¡ndice, caso nÆo ache, retorna
       	mensagem de erro padrÆo do  EMS
  Parameters: ipar1:i-nr-ord-produ:Ordem Produ‡Æo
              ipar2:c-it-codigo:Item
              ipar3:c-cod-roteiro:Roteiro
              ipar4:i-op-codigo:Opera‡Æo
              ipar5:c-it-predec:Item Predecessor
              ipar6:c-rot-predec:Roteiro Predecessor
              ipar7:i-op-predec:Opera‡Æo Predecessora
      
------------------------------------------------------------------------------*/
/* ------------------------ PROXIES BO 1.1 ----------------------------- */
    
    def input parameter i-nr-ord-produ as inte no-undo.
    def input parameter c-it-codigo as char no-undo.
    def input parameter c-cod-roteiro as char no-undo.
    def input parameter i-op-codigo as inte no-undo.
    def input parameter c-it-predec as char no-undo.
    def input parameter c-rot-predec as char no-undo.
    def input parameter i-op-predec as inte no-undo.
    def output parameter pcreturn as char no-undo.
        
        
    RUN openQueryStatic (input "Main":U).
    
    run goToKey (input i-nr-ord-produ,
                 input c-it-codigo,
                 input c-cod-roteiro,
                 input i-op-codigo,
                 input c-it-predec,
                 input c-rot-predec,
                 input i-op-predec).

    if return-value = "OK" then assign pcreturn = "".  /* esse e o valor esperado nas interfaces 1.1 */
    if return-value = "NOK" then do:
        {utp/ut-table.i movind {&TABLENAME} 1}
        run utp/ut-msgs.p (input "msg":U,
                           input 2,
                           input return-value).
        assign pcreturn =  return-value.  
        /* essa e a mensagem esperada nas interfaces 1.1  qdo n’o acha o registro */
    end.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getCharField DBOProgram 
PROCEDURE getCharField :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valor de campos do tipo caracter
  Parameters:
               recebe nome do campo
               retorna valor do campo
               retorna status do processo
  Notes:
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pFieldName AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldValue AS CHARACTER NO-UNDO.

    /*--- Verifica se temptable RowObject estÿ dispon­vel, caso n’o esteja serÿ
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN
        RETURN "NOK":U.

    CASE pFieldName:
        WHEN "rot-predec":U THEN ASSIGN pFieldValue = RowObject.rot-predec.
        WHEN "char-1":U THEN ASSIGN pFieldValue = RowObject.char-1.
        WHEN "char-2":U THEN ASSIGN pFieldValue = RowObject.char-2.
        WHEN "check-sum":U THEN ASSIGN pFieldValue = RowObject.check-sum.
        WHEN "cod-roteiro":U THEN ASSIGN pFieldValue = RowObject.cod-roteiro.
        WHEN "it-codigo":U THEN ASSIGN pFieldValue = RowObject.it-codigo.
        WHEN "it-predec":U THEN ASSIGN pFieldValue = RowObject.it-predec.
        OTHERWISE RETURN "NOK":U.
    END CASE.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

