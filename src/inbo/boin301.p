&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no ­ndice PERT
  Parameters:
               recebe valor dos campos do ­ndice PERT
               retorna status do processo
  Notes:
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pnr-ord-produ LIKE pert-ordem.nr-ord-produ NO-UNDO.
    DEFINE INPUT PARAMETER pit-codigo LIKE pert-ordem.it-codigo NO-UNDO.
    DEFINE INPUT PARAMETER pcod-roteiro LIKE pert-ordem.cod-roteiro NO-UNDO.
    DEFINE INPUT PARAMETER pop-codigo LIKE pert-ordem.op-codigo NO-UNDO.
    DEFINE INPUT PARAMETER pit-predec LIKE pert-ordem.it-predec NO-UNDO.
    DEFINE INPUT PARAMETER prot-predec LIKE pert-ordem.rot-predec NO-UNDO.
    DEFINE INPUT PARAMETER pop-predec LIKE pert-ordem.op-predec NO-UNDO.

    FIND FIRST bfpert-ordem WHERE
        bfpert-ordem.nr-ord-produ = pnr-ord-produ AND
        bfpert-ordem.it-codigo = pit-codigo AND
        bfpert-ordem.cod-roteiro = pcod-roteiro AND
        bfpert-ordem.op-codigo = pop-codigo AND
        bfpert-ordem.it-predec = pit-predec AND
        bfpert-ordem.rot-predec = prot-predec AND
        bfpert-ordem.op-predec = pop-predec
        NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro serÿ retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfpert-ordem THEN
        RETURN "NOK":U.

    /*--- Reposiciona query atrav²s de rowid e verifica a ocorr¼ncia de erros, caso
          existam erros serÿ retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfpert-ordem)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

