&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE setConstraintCodEstabel DBOProgram 
PROCEDURE setConstraintCodEstabel :
/*------------------------------------------------------------------------------
  Purpose:   Seta as vari veis de controle para queries contendo o estabelecimento.
  Parameters: pcod-estabel: Estabelecimento
              pgm-codigo: Grupo M quina
------------------------------------------------------------------------------*/
   define input parameter pcod-estabel as char no-undo.
   define input parameter pgm-codigo as char no-undo.
   
    assign c-cod-estabel = pcod-estabel
           c-gm-codigo = pgm-codigo.
 
 RETURN "OK":U.   
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE setConstraintgmEstab DBOProgram 
PROCEDURE setConstraintgmEstab :
/*------------------------------------------------------------------------------
  Purpose:     Seta as restri‡äes para a abertura da query
  Parameters:  p-gm-codigo
  Notes:       
------------------------------------------------------------------------------*/
DEFINE INPUT PARAMETER p-gm-codigo  LIKE gm-estab.gm-codigo NO-UNDO.
    
    ASSIGN  c-gm-codigo = p-gm-codigo.

    RETURN "OK":U.

END PROCEDURE.

