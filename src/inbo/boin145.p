&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no ¡ndice ID
  Parameters:
               recebe valor dos campos do ¡ndice ID
               retorna status do processo
  Notes:
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pgm-codigo LIKE gm-estab.gm-codigo NO-UNDO.
    DEFINE INPUT PARAMETER pcod-estabel LIKE gm-estab.cod-estabel NO-UNDO.

    FIND FIRST bfgm-estab WHERE
        bfgm-estab.gm-codigo = pgm-codigo AND
        bfgm-estab.cod-estabel = pcod-estabel
        NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser  retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfgm-estab THEN
        RETURN "NOK":U.

    /*--- Reposiciona query atrav‚s de rowid e verifica a ocorrˆncia de erros, caso
          existam erros ser  retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfgm-estab)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE linkTogmEstab DBOProgram 
PROCEDURE linkTogmEstab :
/*------------------------------------------------------------------------------
  Purpose:     Busca a chave da tabela para abrir a query
  Parameters:  pHandle = handle da BO 
  Notes:       
------------------------------------------------------------------------------*/
DEFINE INPUT PARAMETER pHandle AS HANDLE NO-UNDO.

    RUN getGmCodigo IN pHandle (OUTPUT c-gm-codigo).

    RUN setConstraintgmEstab IN THIS-PROCEDURE (INPUT c-gm-codigo).

    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryCodEstabel DBOProgram 
PROCEDURE openQueryCodEstabel :
/*------------------------------------------------------------------------------
  Purpose:    Busca conjunto de registros da tabela gm-estab, 
              conforme o estabelecimento.  
 
------------------------------------------------------------------------------*/
  open query {&QUERYNAME} for each {&TABLENAME} where 
                                   {&TABLENAME}.cod-estabel = c-cod-estabel and
                                   {&TABLENAME}.gm-codigo   >= c-gm-codigo
                                    NO-LOCK INDEXED-REPOSITION.
                                          
  RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQuerygmEstab DBOProgram 
PROCEDURE openQuerygmEstab :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
OPEN QUERY {&QueryName} FOR EACH {&TableName} WHERE 
                                 {&TableName}.gm-codigo = c-gm-codigo 
                                 NO-LOCK INDEXED-REPOSITION.

    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryMain DBOProgram 
PROCEDURE openQueryMain :
/*------------------------------------------------------------------------------
  Purpose:     Abertura da query principal do DBO
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH gm-estab NO-LOCK INDEXED-REPOSITION.

    RETURN "OK":U.
END PROCEDURE.

