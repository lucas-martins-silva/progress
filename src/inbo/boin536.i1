/******************************************************************************** 
**
** Procedure GerarRepOperCtrab
** Objetivo: Geraá∆o de reporte da operaá∆o do centro de trabalho
** InterfÉce dever† preencher os seguintes atributos na tempor†ria
             rep-oper-ctrab.qtd-operac-retrab 
             rep-oper-ctrab.qtd-operac-reptda 
             rep-oper-ctrab.qtd-operac-refgda 
             rep-oper-ctrab.qtd-operac-aprov
             rep-oper-ctrab.num-split-operac
             rep-oper-ctrab.num-operac-sfc
             rep-oper-ctrab.nr-ord-produ 
             rep-oper-ctrab.cod-operador
             rep-oper-ctrab.cod-equipe 
             rep-oper-ctrab.cod-ctrab

********************************************************************************/
def var de-tempo-tot-mob as decimal format "->>>,>>>,>>>,>>9.9999999999" no-undo.
PROCEDURE GerarRepOperCtrab:

    define input parameter table for tt-rep-oper-ctrab.
    define input parameter table for tt-rep-refugo-oper.
    define input parameter table for tt-rep-ic-oper.
    define input parameter table for tt-rep-ic-oper-tab.

    define buffer b-rep-oper-ctrab for rep-oper-ctrab.

    def var v-num-seq-rep      as integer no-undo.
    def var v-qtd-tempo-proces like split-operac.qtd-operac-aprov no-undo. 
    def var v-tempo-parada-ext like rep-oper-ctrab.qtd-tempo-parada no-undo.
    def var de-tempo-liquido   like rep-oper-ctrab.qtd-tempo-parada no-undo.
    def var i-segs-inic-cronom as integer no-undo.
    

    for each tt-rep-oper-ctrab no-lock:

        /*** Determinar o tempo operaá∆o fora do turno (extra)  
             Acumular o tempo de operaá∆o no split reportado ***/ 

        find last b-rep-oper-ctrab no-lock
            where b-rep-oper-ctrab.nr-ord-produ = tt-rep-oper-ctrab.nr-ord-produ no-error.

        if  available b-rep-oper-ctrab then 
            assign v-num-seq-rep = b-rep-oper-ctrab.num-seq-rep + 1.
        else     
            assign v-num-seq-rep = 1.

        /*** Geraá∆o do registro rep-oper-ctrab ***/     
        create rep-oper-ctrab.
        buffer-copy tt-rep-oper-ctrab to rep-oper-ctrab
        assign rep-oper-ctrab.num-seq-rep  = v-num-seq-rep.

        /*** Atualiza usu†rio data e hora de atualizaá∆o ***/
        assign rep-oper-ctrab.cod-usuar-ult-atualiz = v-cod-usuar-corren 
               rep-oper-ctrab.dat-ult-atualiz       = today. 
        run pi-sec-to-formatted-time (Input time, 
                                      output rep-oper-ctrab.hra-ult-atualiz).

        /*** Tempos do reporte em funá∆o do turno e centro de trabalho ***/ 
        run pi-converte-data-segs-valor (Input  rep-oper-ctrab.dat-inic-reporte,
                                         Input  rep-oper-ctrab.qtd-segs-inic-reporte,
                                         output rep-oper-ctrab.val-refer-inic-rep).
        run pi-converte-data-segs-valor (Input  rep-oper-ctrab.dat-fim-reporte,
                                         Input  rep-oper-ctrab.qtd-segs-fim-reporte,
                                         output rep-oper-ctrab.val-refer-fim-rep).

       /* if rep-oper-ctrab.qtd-operac-reptda <> 0 then do:
           /*** Atualiza o n£mero do reporte ***/
           find last ord-rep use-index ordem
               where ord-rep.nr-ord-produ = rep-oper-ctrab.nr-ord-produ no-lock no-error. 
           if  avail ord-rep then do:
               /*FO:1287.735 - Fitedi*/
               FIND FIRST ord-prod
                    WHERE ord-prod.nr-ord-produ = rep-oper-ctrab.nr-ord-produ NO-LOCK NO-ERROR.
               IF AVAIL ord-prod AND ord-prod.rep-prod = 1 THEN DO:
                  if  rep-oper-ctrab.num-operac-sfc <> ord-rep.op-seq then 
                        ASSIGN rep-oper-ctrab.nr-reporte = 0.
               END.
               /*FO:1287.735 - Fitedi*/
           end.
          
         end.*/
         
        validate rep-oper-ctrab.

        /*** Gravaá∆o de refugos ***/
        run GerarRepRefugoOper (buffer rep-oper-ctrab,
                                input table tt-rep-refugo-oper,
                                input tt-rep-oper-ctrab.num-seq-rep).

        run pi-sfc-reporte-tempo (input rep-oper-ctrab.cod-ctrab,  
                                  input rep-oper-ctrab.dat-fim-reporte, 
                                  input rep-oper-ctrab.qtd-segs-fim-reporte, 
                                  input rep-oper-ctrab.dat-inic-reporte, 
                                  input rep-oper-ctrab.qtd-segs-inic-reporte, 
                                  output v-qtd-tempo-proces, 
                                  output rep-oper-ctrab.qtd-tempo-extra, 
                                  output rep-oper-ctrab.cod-model-turno, 
                                  output rep-oper-ctrab.num-turno).
                                  
        IF RETURN-VALUE = "NOK":U THEN RETURN "NOK":U.

        find ctrab where
             ctrab.cod-ctrab = rep-oper-ctrab.cod-ctrab no-lock no-error. 
        find grup-maquina where
             grup-maquina.gm-codigo = ctrab.gm-codigo no-lock no-error.

        if grup-maquina.ind-tip-ctrab = 4 then 
            run pi-sfc-tempo-paradas-mod (input  rep-oper-ctrab.cod-ctrab,
                                          input  grup-maquina.gm-codigo,
                                          input  rep-oper-ctrab.cod-equipe,
                                          input  rep-oper-ctrab.val-refer-inic-rep,
                                          input  rep-oper-ctrab.val-refer-fim-rep,
                                          output rep-oper-ctrab.qtd-tempo-parada,
										  output v-tempo-parada-ext). 
        else 
            run pi-sfc-tempo-paradas-maq (input  rep-oper-ctrab.cod-ctrab,
                                          input  grup-maquina.gm-codigo,
                                          input  rep-oper-ctrab.val-refer-inic-rep,
                                          input  rep-oper-ctrab.val-refer-fim-rep,
                                          output rep-oper-ctrab.qtd-tempo-parada,
										  output v-tempo-parada-ext).   
        
        ASSIGN de-tempo-liquido = v-qtd-tempo-proces +  
                                  rep-oper-ctrab.qtd-tempo-extra - 
                                  rep-oper-ctrab.qtd-tempo-parada. 
                                                
        IF de-tempo-liquido < 0 THEN           
            ASSIGN de-tempo-liquido = 0.
               
         assign rep-oper-ctrab.qtd-tempo-reporte = de-tempo-liquido. 

	 if (rep-oper-ctrab.qtd-tempo-extra) > 0 and (rep-oper-ctrab.qtd-tempo-extra > v-tempo-parada-ext) then 
             assign rep-oper-ctrab.qtd-tempo-reporte = rep-oper-ctrab.qtd-tempo-reporte - v-tempo-parada-ext
	 	    rep-oper-ctrab.qtd-tempo-parada = rep-oper-ctrab.qtd-tempo-parada + v-tempo-parada-ext.
	        
	 if rep-oper-ctrab.qtd-tempo-extra > rep-oper-ctrab.qtd-tempo-reporte then
             assign rep-oper-ctrab.qtd-tempo-extra = rep-oper-ctrab.qtd-tempo-reporte.                

        if l-real-padrao or 
           de-tempo-mob-real = 0 then
            assign de-tempo-mob-real = rep-oper-ctrab.qtd-tempo-reporte.
        

	if de-tempo-mob-real > 0 then do:
	    case grup-maquina.ind-reporte-mod:
	    	/*** N∆o reporta tempos mod para operador ou equipe ***/ 
	    	when 1 then 
	    	    if  ctrab.num-operac-simult > 0 then
	    	    	assign rep-oper-ctrab.qtd-tempo-mod = rep-oper-ctrab.qtd-tempo-reporte *
	    	    					      ctrab.num-operador-ctrab / ctrab.num-operac-simult.
	    	    else                                                 
	    	    	assign rep-oper-ctrab.qtd-tempo-mod = rep-oper-ctrab.qtd-tempo-reporte *
	    	    					      ctrab.num-operador-ctrab.
	    	when 2 then
	    	    run pi-sfc-rep-mod-operador (buffer rep-oper-ctrab, 
	    	    				 input rep-oper-ctrab.cod-equipe).
	    	when 3 then
	    	    run pi-sfc-rep-mod-equipe (buffer rep-oper-ctrab).
	    end case. 
	end.
		
        /*** Atualiza datas do split reportado, operaá∆o e ordem de produá∆o ***/
        find split-operac exclusive-lock
            where split-operac.nr-ord-produ   = rep-oper-ctrab.nr-ord-produ
              and split-operac.num-operac-sfc = rep-oper-ctrab.num-operac-sfc
              and split-operac.num-split-operac = rep-oper-ctrab.num-split-operac no-error.

        /*** Atualizaá∆o do tempo de preparaá∆o no split (somente quando o split n∆o estiver iniciado) ***/

        if  split-operac.ind-estado-split <= 3 then do:
            assign split-operac.dat-inic-setup      = tt-rep-oper-ctrab.dat-inic-setup
                   split-operac.dat-fim-setup       = tt-rep-oper-ctrab.dat-fim-setup
                   split-operac.qtd-segs-inic-setup = tt-rep-oper-ctrab.qtd-segs-inic-setup
                   split-operac.qtd-segs-fim-setup  = tt-rep-oper-ctrab.qtd-segs-fim-setup
                   split-operac.cod-ferr-prod       = tt-rep-oper-ctrab.cod-ferr-prod
                   split-operac.cod-ctrab           = tt-rep-oper-ctrab.cod-ctrab
                   overlay(split-operac.char-1,1,8) = tt-rep-oper-ctrab.cod-equipe.
                   
            if (split-operac.dat-inic-setup <> split-operac.dat-fim-setup) or
               (split-operac.qtd-segs-inic-setup <> split-operac.qtd-segs-fim-setup) then do:
               run inbo/boin469a.p (Input split-operac.gm-codigo,
                                    Input ?,
                                    input-output split-operac.dat-fim-setup,
                                    input-output split-operac.qtd-segs-fim-setup,
                                    input-output split-operac.dat-inic-setup,
                                    input-output split-operac.qtd-segs-inic-setup,
                                    input-output v-qtd-tempo-proces).
               assign split-operac.tempo-real-prepar = v-qtd-tempo-proces.
            end.
        end.

        /*** Inicio real da operaá∆o ***/
        if  split-operac.dat-inic-operac = ? or 
            split-operac.dat-inic-operac > rep-oper-ctrab.dat-inic-reporte or 
           (split-operac.dat-inic-operac = rep-oper-ctrab.dat-inic-reporte and 
            split-operac.qtd-segs-inic-operac > rep-oper-ctrab.qtd-segs-inic-reporte) then
            assign split-operac.dat-inic-operac      = rep-oper-ctrab.dat-inic-reporte 
                   split-operac.qtd-segs-inic-operac = rep-oper-ctrab.qtd-segs-inic-reporte.

        /*** Acerto de data fim de setup ***/
        if split-operac.dat-fim-setup = ? or 
           split-operac.dat-fim-setup > split-operac.dat-inic-operac or
          (split-operac.dat-fim-setup = split-operac.dat-inic-operac and 
           split-operac.qtd-segs-fim-setup > split-operac.qtd-segs-inic-operac) then
            assign split-operac.dat-fim-setup      = split-operac.dat-inic-operac      
                   split-operac.qtd-segs-fim-setup = split-operac.qtd-segs-inic-operac.

        /*** Acerto de data inicio de setup ***/
        if split-operac.dat-inic-setup = ? or 
           split-operac.dat-inic-setup > split-operac.dat-fim-setup or
          (split-operac.dat-inic-setup = split-operac.dat-fim-setup and 
           split-operac.qtd-segs-inic-setup > split-operac.qtd-segs-fim-setup) then
            assign split-operac.dat-inic-setup      = split-operac.dat-fim-setup
                   split-operac.qtd-segs-inic-setup = split-operac.qtd-segs-fim-setup.

        /*** Atualiza os tempos real de operaá∆o e mod para o split ***/
        assign split-operac.tempo-real-mod  = split-operac.tempo-real-mod + rep-oper-ctrab.qtd-tempo-mod
               split-operac.tempo-real-maq  = split-operac.tempo-real-maq + rep-oper-ctrab.qtd-tempo-reporte
               split-operac.ind-estado-split = 4.
               
        if  split-operac.data-1 <> ? then do:
            find first param-sfc no-lock no-error.
            if  avail param-sfc and param-sfc.log-tipo-relogio then
                run pi-formatted-time-to-sec (input string(split-operac.dec-1, "9999") + "00",
                                              output i-segs-inic-cronom).
            else
                assign i-segs-inic-cronom = int(split-operac.dec-1) * 36.

            if  split-operac.data-1 < rep-oper-ctrab.dat-fim-reporte or
               (split-operac.data-1 = rep-oper-ctrab.dat-fim-reporte and
                i-segs-inic-cronom  < rep-oper-ctrab.qtd-segs-fim-reporte) then
                assign split-operac.data-1 = ?
                       split-operac.dec-1  = 0.
        end.

        /*** Posto manual utiliza tempo MOD como tempo do reporte da operaá∆o ***/
        if grup-maquina.ind-tip-ctrab = 4 then 
            assign split-operac.tempo-real-operac = split-operac.tempo-real-mod.
        else     
            assign split-operac.tempo-real-operac = split-operac.tempo-real-maq.    

        /*** Tratamento de cq da operaá∆o - futura release ***/
        /*** Quando o reporte pase pelo controle de qualidade dever† gerar uma pendencia para 
             a equipe CQ + e-mail e o rep-oper-ctrab.log-liberd-cq fica como n∆o ***/

        assign rep-oper-ctrab.log-liberd-cq = yes.

        if rep-oper-ctrab.log-liberd-cq then 
           run LiberarReporte (buffer rep-oper-ctrab).

        /*** Quantidade aprovada Ç igual a quantidade reportada - quantidade refugada ***/ 
        find current rep-oper-ctrab exclusive-lock no-error.
        assign rep-oper-ctrab.qtd-operac-reptda = rep-oper-ctrab.qtd-operac-aprov + 
                                                  rep-oper-ctrab.qtd-operac-refgda. 

        run GerarReporteItemControle (buffer rep-oper-ctrab,
                                      input table tt-rep-ic-oper,
                                      input table tt-rep-ic-oper-tab,
                                      input tt-rep-oper-ctrab.num-seq-rep).

        /*** Atualiza o estado das ordens do SFC e da produá∆o, pois quando a integraá∆o do m¢dulo Ç
             com o Magnus as ordens n∆o estavam sendo alteradas. ***/

        if  can-find(first op-sfc
                     where op-sfc.nr-ord-produ = tt-rep-oper-ctrab.nr-ord-produ
                       and op-sfc.ind-estado-op = 2) then do:

            find op-sfc exclusive-lock
                where op-sfc.nr-ord-produ = tt-rep-oper-ctrab.nr-ord-produ no-error.
            assign op-sfc.ind-estado-op = 3.

            find ord-prod exclusive-lock /*no-lock */
                where ord-prod.nr-ord-produ = tt-rep-oper-ctrab.nr-ord-produ no-error.
            if  ord-prod.estado < 6 then do:
                assign ord-prod.estado = 6.
            end.
            release op-sfc.
            release ord-prod.
        end.
        release rep-oper-ctrab.
        release split-operac.
    end.
    
    RETURN "OK":U.
    
END PROCEDURE.

/*******************************************************************************************************
**
** PROCEDURE: pi-sfc-rep-mod-equipe
** OBJETIVO:  Gera reportes mod para os membros da equipe
** PARAMETROS: buffer rep-oper-ctrab
**
*******************************************************************************************************/
PROCEDURE pi-sfc-rep-mod-equipe:

    define parameter buffer b-rep-oper-ctrab for rep-oper-ctrab.

    assign de-tempo-tot-mob = 0.
    
    for each equipe-operador where 
             equipe-operador.cod-equipe     =  b-rep-oper-ctrab.cod-equipe       and
             equipe-operador.dat-inic-valid <= b-rep-oper-ctrab.dat-inic-reporte and
             equipe-operador.dat-fim-valid  >  b-rep-oper-ctrab.dat-inic-reporte no-lock:

           run pi-sfc-rep-mod-operador (buffer b-rep-oper-ctrab,
                                        input equipe-operador.cod-operador).
    end.
    assign b-rep-oper-ctrab.qtd-tempo-mod = de-tempo-tot-mob.
END PROCEDURE.    


/*******************************************************************************************************
**
** PROCEDURE: pi-sfc-rep-mod-operador
** OBJETIVO:  Gera reportes mod para os membros da equipe
** PARAMETROS: buffer rep-oper-ctrab
**
*******************************************************************************************************/
PROCEDURE pi-sfc-rep-mod-operador:

    define parameter buffer b-rep-oper-ctrab for rep-oper-ctrab.
    define input parameter p-cod-operador  like rep-oper-ctrab.cod-operador.

    define buffer b-rep-oper-mod for rep-oper-mod.
    define buffer b-oper-ord     for oper-ord.

    def var v-seq-movto  as integer        no-undo.
    def var de-horas-mob like rep-oper-ctrab.qtd-tempo-mod init 0 no-undo.
    def var i-oper       as integer init 0 no-undo.

    find last b-rep-oper-mod where
              b-rep-oper-mod.nr-ord-produ = b-rep-oper-ctrab.nr-ord-produ and
              b-rep-oper-mod.num-seq-rep  = b-rep-oper-ctrab.num-seq-rep no-lock no-error. 

    if avail b-rep-oper-mod then 
        assign v-seq-movto = b-rep-oper-mod.num-seq-movto + 1.
    else     
        assign v-seq-movto = 1.

    find first b-oper-ord where b-oper-ord.nr-ord-produ    = b-rep-oper-ctrab.nr-ord-produ and
                                b-oper-ord.num-operac-sfc = b-rep-oper-ctrab.num-operac-sfc no-lock no-error.
                                
    find first ord-prod where ord-prod.nr-ord-produ      = b-rep-oper-ctrab.nr-ord-produ no-lock no-error.
    
    for each equipe-operador where equipe-operador.cod-equipe = b-rep-oper-ctrab.cod-equipe no-lock:
        assign i-oper = i-oper + 1.
    end.
    
    if i-oper = 0 then
        assign i-oper = 1.
                                
    run pi-calcula-tempo-homem (buffer b-oper-ord,
                                input ord-prod.reporte-mob,
                                input de-tempo-mob-real,
                                input ord-prod.qt-ordem * b-rep-oper-ctrab.qtd-operac-reptda / b-oper-ord.qtd-previs-operac,
                                output de-horas-mob).
                                
    create rep-oper-mod.
    assign rep-oper-mod.nr-ord-produ          = b-rep-oper-ctrab.nr-ord-produ
           rep-oper-mod.num-seq-rep           = b-rep-oper-ctrab.num-seq-rep
           rep-oper-mod.num-seq-movto         = v-seq-movto
           rep-oper-mod.cod-ctrab             = b-rep-oper-ctrab.cod-ctrab
           rep-oper-mod.cod-equipe            = b-rep-oper-ctrab.cod-equipe
           rep-oper-mod.cod-operador          = p-cod-operador
           rep-oper-mod.dat-fim-reporte       = b-rep-oper-ctrab.dat-fim-reporte
           rep-oper-mod.qtd-segs-fim-reporte  = b-rep-oper-ctrab.qtd-segs-fim-reporte
           rep-oper-mod.dat-inic-reporte      = b-rep-oper-ctrab.dat-inic-reporte
           rep-oper-mod.qtd-segs-inic-reporte = b-rep-oper-ctrab.qtd-segs-inic-reporte
           rep-oper-mod.cod-model-turno       = b-rep-oper-ctrab.cod-model-turno
           rep-oper-mod.num-turno             = b-rep-oper-ctrab.num-turno
           rep-oper-mod.qtd-tempo-extra       = b-rep-oper-ctrab.qtd-tempo-extra  
           rep-oper-mod.qtd-tempo-mod         = de-horas-mob / i-oper
           rep-oper-mod.qtd-tempo-parada      = b-rep-oper-ctrab.qtd-tempo-parada
           rep-oper-mod.val-refer-fim-rep     = b-rep-oper-ctrab.val-refer-fim-rep
           rep-oper-mod.val-refer-inic-rep    = b-rep-oper-ctrab.val-refer-inic-rep

           /*** Acumula tempo mod no reporte ***/
           b-rep-oper-ctrab.qtd-tempo-mod     = b-rep-oper-ctrab.qtd-tempo-mod + rep-oper-mod.qtd-tempo-mod
           de-tempo-tot-mob = de-tempo-tot-mob + (de-horas-mob / i-oper). 
    release rep-oper-mod.   

END PROCEDURE.    


/********************************************************************************
**
** Procedure: EliminarRepOperCtrab
** Objetivo:  Eliminaá∆o do reporte de operaá∆o + validaá‰es
** ParÉmetros: b-rep-oper-ctrab
**
**********************************************************************************/

PROCEDURE EliminarRepOperCtrab:

   define parameter buffer b-rep-oper-ctrab for rep-oper-ctrab.
   def output param table for tt-bo-erro.

   def var v-val-refer-1   like split-operac.qtd-operac-aprov no-undo.
   def var v-val-refer-2   like split-operac.qtd-operac-aprov no-undo.
   def var v-tempo-mod     like split-operac.qtd-operac-aprov no-undo.
   def var v-tempo-maq     like split-operac.qtd-operac-aprov no-undo.
   def var v-tempo-ext     like split-operac.qtd-operac-aprov no-undo.

   for each tt-bo-erro:
       delete tt-bo-erro.
   end.

    /*** Se reporte gerou movimentaá∆o de mod ou material n∆o ser† poss°vel a eliminaá∆o ***/
    if  b-rep-oper-ctrab.log-reporte-exp then do:

        {utp/ut-field.i movind rep-oper-ctrab cod-ctrab 1}

        create tt-bo-erro.
        assign i-seq-erro            = i-seq-erro + 1
               tt-bo-erro.i-sequen   = i-seq-erro
               tt-bo-erro.cd-erro    = 55
               tt-bo-erro.parametros = return-value.

        run utp/ut-msgs.p (input "msg",
                           input 55,
                           input return-value).
        assign tt-bo-erro.mensagem = return-value.
        return.
    end.

   /*** Se operaá∆o foi finalizada n∆o ser† poss°vel a eliminaá∆o ***/
   find split-operac no-lock where 
        split-operac.nr-ord-produ     = b-rep-oper-ctrab.nr-ord-produ    and 
        split-operac.num-operac-sfc   = b-rep-oper-ctrab.num-operac-sfc  and 
        split-operac.num-split-operac = b-rep-oper-ctrab.num-split-operac no-error.

   if  split-operac.ind-estado-split = 5 then do:

        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 17855,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 17855
               tt-bo-erro.mensagem     = return-value.
       return.
   end.

   assign b-rep-oper-ctrab.log-reporte-estordo = yes. /*** Artificio para o inverso da liberacao
                                                           tratar como estorno do reporte ***/

   /*** Inversa da liberaá∆o ***/
   if  b-rep-oper-ctrab.log-liberd-cq  then 
        run LiberarReporteInv (buffer b-rep-oper-ctrab).  

END PROCEDURE.

PROCEDURE GerarReporteItemControle:

    def parameter buffer b-rep-oper-ctrab for rep-oper-ctrab.
    def input param table for tt-rep-ic-oper.
    def input param table for tt-rep-ic-oper-tab.
    def input param i-seq-tt as int no-undo.

    for each tt-rep-ic-oper no-lock
        where tt-rep-ic-oper.nr-ord-produ = b-rep-oper-ctrab.nr-ord-produ
          and tt-rep-ic-oper.num-seq-rep  = i-seq-tt:

        create rep-ic-oper.
        buffer-copy tt-rep-ic-oper except num-seq-rep to rep-ic-oper
        assign rep-ic-oper.num-seq-rep = b-rep-oper-ctrab.num-seq-rep.

        for each tt-rep-ic-oper-tab no-lock
            where tt-rep-ic-oper-tab.nr-ord-produ = tt-rep-ic-oper.nr-ord-produ
              and tt-rep-ic-oper-tab.num-seq-rep  = tt-rep-ic-oper.num-seq-rep
              and tt-rep-ic-oper-tab.cod-ic       = tt-rep-ic-oper.cod-ic:

            create rep-ic-oper-tab.
            buffer-copy tt-rep-ic-oper-tab except num-seq-rep to rep-ic-oper-tab
            assign rep-ic-oper-tab.num-seq-rep = b-rep-oper-ctrab.num-seq-rep.
        end.
    end.
    release rep-ic-oper.
    release rep-ic-oper-tab.
END PROCEDURE.

procedure pi-recebe-tempo-mob:
def input param p-tempo-mob as dec no-undo.
def input param l-padrao    as log no-undo.

assign de-tempo-mob-real = p-tempo-mob
       l-real-padrao     = l-padrao.

return "ok":u.
end.

