        WHEN "vl-merc-fasb[2]":U THEN ASSIGN pFieldValue = RowObject.vl-merc-fasb[2].
        WHEN "vl-out-fasb[1]":U THEN ASSIGN pFieldValue = RowObject.vl-out-fasb[1].
        WHEN "vl-out-fasb[2]":U THEN ASSIGN pFieldValue = RowObject.vl-out-fasb[2].
        WHEN "vl-seg-fasb[1]":U THEN ASSIGN pFieldValue = RowObject.vl-seg-fasb[1].
        WHEN "vl-seg-fasb[2]":U THEN ASSIGN pFieldValue = RowObject.vl-seg-fasb[2].
        WHEN "vl-subs":U THEN ASSIGN pFieldValue = RowObject.vl-subs.
        WHEN "vl-subs-fasb[1]":U THEN ASSIGN pFieldValue = RowObject.vl-subs-fasb[1].
        WHEN "vl-subs-fasb[2]":U THEN ASSIGN pFieldValue = RowObject.vl-subs-fasb[2].
        WHEN "vl-tax-diversos":U THEN ASSIGN pFieldValue = RowObject.vl-tax-diversos.
        WHEN "vl-tax-frete":U THEN ASSIGN pFieldValue = RowObject.vl-tax-frete.
        WHEN "valor-tot-nf-rt":U THEN ASSIGN pFieldValue = RowObject.valor-tot-nf-rt.
        WHEN "valor-total-liq":U THEN ASSIGN pFieldValue = RowObject.valor-total-liq.
        when "peso-bruto-tot":U then assign pFieldValue = &IF "{&bf_mat_versao_ems}" >= "2.062" &THEN                
                                                            RowObject.peso-bruto-tot.
                                                          &ELSE
                                                            dec(SUBSTRING(RowObject.char-1,157,17)).
                                                          &ENDIF
        OTHERWISE RETURN "NOK":U.
    END CASE.
    

    RETURN "OK":U.
END PROCEDURE.




PROCEDURE getDescriptionFields :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input  param pFieldName        as char no-undo.
    def output param pDescription      as char no-undo.
    

    

    CASE pFieldName:
        WHEN "nome-abrev":U     THEN ASSIGN pDescription = if  avail emitente then 
                                                               emitente.nome-abrev
                                                           else "":U.
        WHEN "nome-emit":U      THEN ASSIGN pDescription = if  avail emitente then 
                                                               emitente.nome-emit
                                                           else "":U.
        WHEN "cgc":U            THEN ASSIGN pDescription = if  avail emitente then 
                                                               emitente.cgc
                                                           else "":U.
        WHEN "pais-emit":U      THEN ASSIGN pDescription = if  avail emitente then 
                                                               emitente.pais
                                                           else "":U.
        WHEN "desc-natur":U     THEN ASSIGN pDescription = if  avail natur-oper then 
                                                               natur-oper.denominacao
                                                           else "":U.
        WHEN "esp-natur":U      THEN ASSIGN pDescription = if  avail natur-oper then 
                                                               natur-oper.especie-doc
                                                           else "":U.
        &IF "{&bf_cex_versao_ems}" >= "2.062" &then 
            WHEN "log-memorando":U  THEN ASSIGN pDescription = if  avail natur-oper then 
                                                                   &IF "{&bf_dis_versao_ems}" >= "2.062" &THEN
                                                                       STRING(natur-oper.log-memorando)
                                                                   &ELSE
                                                                       IF  SUBSTR(natur-oper.char-1,104,1) = "1" 
                                                                           THEN "YES"
                                                                           ELSE "NO"
                                                                   &ENDIF                      
                                                               else "":U.
        &ENDIF
        WHEN "desc-estab":U     THEN ASSIGN pDescription = if  avail estabelec then 
                                                               estabelec.nome
                                                           else "":U.
        WHEN "pais-estab":U     THEN ASSIGN pDescription = if  avail estabelec then 
                                                               estabelec.pais
                                                           else "":U.
        WHEN "desc-uf":U        THEN ASSIGN pDescription = if  avail unid-feder then 
                                                               unid-feder.no-estado
                                                           else 
                                                               "":U.
        OTHERWISE RETURN "NOK":U.
        

    END CASE.

    RETURN "OK":U.
    


END PROCEDURE.




PROCEDURE getEspDocto :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    

    def output param pi-esp-docto    as   integer  no-undo.
    

    if  l-transf then 
        assign pi-esp-docto = 23.           /* NFT */
    else 
    if  l-devolucao or l-dev-transf then      
        assign pi-esp-docto = 20.           /* NFD */
    else 
        assign pi-esp-docto = 21.           /* NFE */        
    

    

    RETURN "OK":U.

END PROCEDURE.




PROCEDURE getFlagsNota :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def output param p-industria    as logical  no-undo.
    def output param p-comercio     as logical  no-undo.
    def output param p-devolucao    as logical  no-undo.
    def output param p-servicos     as logical  no-undo.
    def output param p-transf       as logical  no-undo.
    def output param p-ent-cons     as logical  no-undo.
    def output param p-retorno      as logical  no-undo.
    def output param p-ret-fat      as logical  no-undo.

    assign p-industria = l-industria
           p-comercio  = l-comercio
           p-devolucao = l-devolucao 
           p-servicos  = l-servicos
           p-transf    = l-transf 
           p-ent-cons  = l-ent-cons
           p-retorno   = l-retorno 
           p-ret-fat   = l-ret-fat.

END PROCEDURE.




