PROCEDURE getIntField :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valor de campos do tipo inteiro
  Parameters:  
               recebe nome do campo
               retorna valor do campo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pFieldName AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldValue AS INTEGER NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
        RETURN "NOK":U.

    CASE pFieldName:
        WHEN "cod-emitente":U THEN ASSIGN pFieldValue = RowObject.cod-emitente.
        WHEN "cod-ibge":U THEN ASSIGN pFieldValue = RowObject.cod-ibge.
        WHEN "cod-observa":U THEN ASSIGN pFieldValue = RowObject.cod-observa.
        WHEN "cod-ret-irf":U THEN ASSIGN pFieldValue = RowObject.cod-ret-irf.
        WHEN "cod-tax-div":U THEN ASSIGN pFieldValue = RowObject.cod-tax-div.
        WHEN "cod-tax-fre":U THEN ASSIGN pFieldValue = RowObject.cod-tax-fre.
        WHEN "dia-util-irf":U THEN ASSIGN pFieldValue = RowObject.dia-util-irf.
        WHEN "esp-docto":U THEN ASSIGN pFieldValue = RowObject.esp-docto.
        WHEN "estado":U THEN ASSIGN pFieldValue = RowObject.estado.
        WHEN "i-sequencia":U THEN ASSIGN pFieldValue = RowObject.i-sequencia.
        WHEN "idi-nf-simples-remes":U THEN ASSIGN pFieldValue = RowObject.idi-nf-simples-remes.
        WHEN "ind-orig-entrada":U THEN ASSIGN pFieldValue = RowObject.ind-orig-entrada.
        WHEN "ind-via-envio":U THEN ASSIGN pFieldValue = RowObject.ind-via-envio.
        WHEN "int-1":U THEN ASSIGN pFieldValue = RowObject.int-1.
        WHEN "int-2":U THEN ASSIGN pFieldValue = RowObject.int-2.
        WHEN "mo-codigo":U THEN ASSIGN pFieldValue = RowObject.mo-codigo.
        WHEN "mod-atual":U THEN ASSIGN pFieldValue = RowObject.mod-atual.
        WHEN "mod-frete":U THEN ASSIGN pFieldValue = RowObject.mod-frete.
        WHEN "nro-proc-entrada":U THEN ASSIGN pFieldValue = RowObject.nro-proc-entrada.
        WHEN "nro-proc-saida":U THEN ASSIGN pFieldValue = RowObject.nro-proc-saida.
        WHEN "ok-fornec":U THEN ASSIGN pFieldValue = RowObject.ok-fornec.
        WHEN "rateia-frete":U THEN ASSIGN pFieldValue = RowObject.rateia-frete.
        WHEN "sit-atual":U THEN ASSIGN pFieldValue = RowObject.sit-atual.
        WHEN "sit-docum":U THEN ASSIGN pFieldValue = RowObject.sit-docum.
        WHEN "sit-edi":U THEN ASSIGN pFieldValue = RowObject.sit-edi.
        WHEN "tipo-docto":U THEN ASSIGN pFieldValue = RowObject.tipo-docto.
        WHEN "tipo-nota":U THEN ASSIGN pFieldValue = RowObject.tipo-nota.
        WHEN "tp-rat-fret":U THEN ASSIGN pFieldValue = RowObject.tp-rat-fret.
        WHEN "via-transp":U THEN ASSIGN pFieldValue = RowObject.via-transp.
        WHEN "cod-tipo-oper-gov":U THEN ASSIGN pFieldValue = RowObject.cod-tipo-oper-gov.
        WHEN "cod-tipo-ente-gov":U THEN ASSIGN pFieldValue = RowObject.cod-tipo-ente-gov.
        OTHERWISE RETURN "NOK":U.
    END CASE.

    RETURN "OK":U.
END PROCEDURE.




PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice documento
  Parameters:  
               retorna valor do campo serie-docto
               retorna valor do campo nro-docto
               retorna valor do campo cod-emitente
               retorna valor do campo nat-operacao
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pcod-emitente LIKE docum-est.cod-emitente NO-UNDO.
    DEFINE OUTPUT PARAMETER pserie-docto LIKE docum-est.serie-docto NO-UNDO.
    DEFINE OUTPUT PARAMETER pnro-docto LIKE docum-est.nro-docto NO-UNDO.
    DEFINE OUTPUT PARAMETER pnat-operacao LIKE docum-est.nat-operacao NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pserie-docto = RowObject.serie-docto
           pnro-docto = RowObject.nro-docto
           pcod-emitente = RowObject.cod-emitente
           pnat-operacao = RowObject.nat-operacao.

    RETURN "OK":U.
END PROCEDURE.




PROCEDURE getLogField :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valor de campos do tipo l¢gico
  Parameters:  
               recebe nome do campo
               retorna valor do campo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pFieldName AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldValue AS LOGICAL NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
        RETURN "NOK":U.

    CASE pFieldName:
        WHEN "acresc-financ":U THEN ASSIGN pFieldValue = RowObject.acresc-financ.
        WHEN "ap-atual":U THEN ASSIGN pFieldValue = RowObject.ap-atual.
        WHEN "atual-ft":U THEN ASSIGN pFieldValue = RowObject.atual-ft.
        WHEN "atualiza-cr":U THEN ASSIGN pFieldValue = RowObject.atualiza-cr.
        WHEN "CE-atual":U THEN ASSIGN pFieldValue = RowObject.CE-atual.
        WHEN "cr-atual":U THEN ASSIGN pFieldValue = RowObject.cr-atual.
        WHEN "estorn-comis":U THEN ASSIGN pFieldValue = RowObject.estorn-comis.
        WHEN "ind-extrac":U THEN ASSIGN pFieldValue = RowObject.ind-extrac.
        WHEN "ind-rateio":U THEN ASSIGN pFieldValue = RowObject.ind-rateio.
        WHEN "ind-tipo-rateio":U THEN ASSIGN pFieldValue = RowObject.ind-tipo-rateio.
        WHEN "log-1":U THEN ASSIGN pFieldValue = RowObject.log-1.
        WHEN "log-2":U THEN ASSIGN pFieldValue = RowObject.log-2.
        WHEN "nf-emitida-est":U THEN ASSIGN pFieldValue = RowObject.nf-emitida-est.
        WHEN "nff":U THEN ASSIGN pFieldValue = RowObject.nff.
        WHEN "of-atual":U THEN ASSIGN pFieldValue = RowObject.of-atual.
        WHEN "rec-fisico":U THEN ASSIGN pFieldValue = RowObject.rec-fisico.
        WHEN "log-sumar":U THEN ASSIGN pFieldValue = RowObject.log-sumar.
        WHEN "log-ctbl-atual":U THEN ASSIGN pFieldValue = RowObject.log-ctbl-atual.
        OTHERWISE RETURN "NOK":U.
    END CASE.

    RETURN "OK":U.
END PROCEDURE.




PROCEDURE getRawField :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valor de campos do tipo raw
  Parameters:  
               recebe nome do campo
               retorna valor do campo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pFieldName AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldValue AS RAW NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
        RETURN "NOK":U.

    CASE pFieldName:
        OTHERWISE RETURN "NOK":U.
    END CASE.

    RETURN "OK":U.
END PROCEDURE.


PROCEDURE getPesoBruto :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: Utilizado pelo programa re2001z.w - recebimento f°sico.      
------------------------------------------------------------------------------*/

    DEFINE INPUT PARAMETER  pcod-emitente LIKE docum-est.cod-emitente NO-UNDO.
    DEFINE INPUT PARAMETER  pserie-docto  LIKE docum-est.serie-docto  NO-UNDO.
    DEFINE INPUT PARAMETER  pnro-docto    LIKE docum-est.nro-docto    NO-UNDO.
    DEFINE INPUT PARAMETER  pnat-operacao LIKE docum-est.nat-operacao NO-UNDO.
    DEFINE OUTPUT PARAMETER pPESOBruto    LIKE docum-est.tot-peso     NO-UNDO.
    

   for each docto-estoq-embal NO-LOCK
       WHERE docto-estoq-embal.cod-ser-docto    = pserie-docto
       AND   docto-estoq-embal.cod-docto        = pnro-docto
       AND   docto-estoq-embal.cdn-emitente     = pcod-emitente
       AND   docto-estoq-embal.cod-natur-operac = pnat-operacao:
 
        ASSIGN  pPESOBruto =  pPESOBruto + docto-estoq-embal.val-peso-embal.
            
    END.

    return "OK":U.
    

END PROCEDURE.


PROCEDURE getReabrePedido :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def output param piEnableReabrePd as logical no-undo.
    

    if  not avail RowObject then
        return "NOK":U.
        

    run findUsuario ( RowObject.usuario ).        
    

    assign piEnableReabrePd =     param-re.reabre-pd
                              and avail param-global
                              and param-global.modulo-pd.

END PROCEDURE.


PROCEDURE getConsideraEnderecoNF :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def output param l-enable as logical no-undo.
    def output param l-flag   as logical no-undo.
    
    if  not avail RowObject then
        return "NOK":U.
    &IF '{&bf_dis_versao_ems}' >= '2.062' &THEN
        ASSIGN l-flag = RowObject.log-consid-ender-nf-saida
               l-enable = yes.
        find first item-doc-est OF RowObject where item-doc-est.nro-comp <> "" NO-LOCK no-error. 
        if avail item-doc-est THEN
           ASSIGN l-enable = NO.
        else
           assign l-flag = yes.   
    &endif    

END PROCEDURE.


PROCEDURE consistEnderecoNF :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input param p-serie       like nota-fiscal.serie       no-undo.
    def input param p-nr-nota-fis like nota-fiscal.nr-nota-fis no-undo.
    
    if  not avail RowObject then
        return "NOK":U.
    &IF '{&bf_dis_versao_ems}' >= '2.062' &THEN

        find bf{&TableName} where bf{&TableName}.serie-docto  = RowObject.serie-docto
                              and bf{&TableName}.nro-docto    = RowObject.nro-docto
                              and bf{&TableName}.cod-emitente = RowObject.cod-emitente
                              and bf{&TableName}.nat-operacao = RowObject.nat-operacao
                              exclusive-lock no-error.
       
        /***** Leitura Natureza Operaªío *****/
        run findNaturOper ( RowObject.nat-operacao ).
        
        IF avail natur-oper AND 
           natur-oper.terceiros AND 
           natur-oper.tp-oper-terc = 4 then do: /* Faturamento de consignaá∆o */
           find first docum-est no-lock
                where docum-est.nro-docto   = p-nr-nota-fis
                  and docum-est.serie-docto = p-serie
                  and docum-est.cod-estabel = RowObject.cod-estabel no-error.
           if avail docum-est then do:
              assign bf{&TableName}.cod-entrega               = docum-est.cod-entrega
                     bf{&TableName}.endereco                  = docum-est.endereco
                     bf{&TableName}.bairro                    = docum-est.bairro
                     bf{&TableName}.cidade                    = docum-est.cidade
                     bf{&TableName}.uf                        = docum-est.uf
                     bf{&TableName}.pais                      = docum-est.pais
                     bf{&TableName}.cep                       = docum-est.cep
                     bf{&TableName}.log-consid-ender-nf-saida = yes.
           end.
        END.
        ELSE DO:
            find first nota-fiscal where nota-fiscal.cod-estabel = RowObject.cod-estabel
                                     and nota-fiscal.serie       = p-serie
                                     and nota-fiscal.nr-nota-fis = p-nr-nota-fis no-lock no-error.
            if avail nota-fiscal and 
               nota-fiscal.cod-emitente = RowObject.cod-emitente then do:
               if avail bf{&TableName} then do:                                 
                  assign bf{&TableName}.cod-entrega               = nota-fiscal.cod-entrega
                         bf{&TableName}.endereco                  = nota-fiscal.endereco
                         bf{&TableName}.bairro                    = nota-fiscal.bairro
                         bf{&TableName}.cidade                    = nota-fiscal.cidade
                         bf{&TableName}.uf                        = nota-fiscal.estado
                         bf{&TableName}.pais                      = nota-fiscal.pais
                         bf{&TableName}.cep                       = nota-fiscal.cep
                         bf{&TableName}.log-consid-ender-nf-saida = yes.
               end.       
            end. 
        END.   
        
        release bf{&TableName}.
    &endif    
    
    RETURN "OK":U.

END PROCEDURE.

PROCEDURE getTipoNotaDtTrans :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: Utilizado pelo programa re2001z.w - recebimento f°sico.      
------------------------------------------------------------------------------*/

    def input parameter piCodEmitente like docum-est.cod-emitente no-undo.
    def input parameter piSerieDocto  like docum-est.serie-docto  no-undo.
    def input parameter piNroDocto    like docum-est.nro-docto    no-undo.
    def input-output parameter piTipoNota as integer              no-undo.
    def output parameter piDtTrans    like docum-est.dt-trans     no-undo.
 
    for first doc-fisico 
        fields ( cod-emitente  serie-docto
                 nro-docto     situacao
                 dt-trans      tipo-nota )
        where doc-fisico.serie-docto  = piSerieDocto 
          and doc-fisico.nro-docto    = piNroDocto
          and doc-fisico.cod-emitente = piCodEmitente
          and doc-fisico.tipo-nota    = piTipoNota
          and doc-fisico.situacao     = 2 no-lock:
    end.          

    if  available doc-fisico then do:
        assign piDtTrans  = doc-fisico.dt-trans.
    end.
    else do:
        for first doc-fisico 
            fields ( cod-emitente  serie-docto
                     nro-docto     situacao
                     dt-trans      tipo-nota )
            where doc-fisico.serie-docto  = piSerieDocto 
              and doc-fisico.nro-docto    = piNroDocto
              and doc-fisico.cod-emitente = piCodEmitente
              and doc-fisico.situacao     = 2 no-lock:
            assign piTipoNota = doc-fisico.tipo-nota
                   piDtTrans  = doc-fisico.dt-trans.              
        end.     
    end.    

    return "OK":U.
    

END PROCEDURE.

PROCEDURE getUsuario :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters: pi-seg-usuario - retorna o usuario logado no sistema.
  Notes:       
------------------------------------------------------------------------------*/

    def output param pi-seg-usuario as char no-undo.
     

    assign pi-seg-usuario = c-seg-usuario.

    return "OK":U.

END PROCEDURE.




