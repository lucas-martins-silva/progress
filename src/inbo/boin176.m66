PROCEDURE validaNatOperItem :
/*------------------------------------------------------------------------------
  Purpose:     Valida a natureza fiscal (nat-of) informada para o item em relaá∆o 
               a natureza de operaá∆o do documento (nat-operacao).
  
  Parameters:  serie do documento ------------------> p-c-serie-docto;
               n£mero do documento -----------------> p-c-nro-docto;
               cod.emitente do documento -----------> p-i-cod-emitente;
               nat.operacao do documento -----------> p-c-nat-operacao;
               nat.fiscal do item a ser inclu°do ---> p-c-nat-of;
               C¢digo do item a ser inclu°do -------> p-c-it-codigo;
               Sequància do novo item --------------> p-i-sequencia;
               Sequància complementar (retorno/dev)-> p-i-seq-comp;
               UF do documento ---------------------> p-c-docum-est-uf;
               Indicador de natureza do emitente ---> p-i-emitente-natur;
               Cod. Estabelecimento ----------------> p-c-cod-estabel;
  Notes:       
------------------------------------------------------------------------------*/


    /* Recebe como parÉmetro a chave do documento e a natureza fiscal do item a ser inclu°do. */
    DEFINE INPUT PARAMETER p-c-serie-docto    LIKE item-doc-est.serie-docto  NO-UNDO.
    DEFINE INPUT PARAMETER p-c-nro-docto      LIKE item-doc-est.nro-docto    NO-UNDO.
    DEFINE INPUT PARAMETER p-i-cod-emitente   LIKE item-doc-est.cod-emitente NO-UNDO.
    DEFINE INPUT PARAMETER p-c-nat-operacao   LIKE item-doc-est.nat-operacao NO-UNDO.
    DEFINE INPUT PARAMETER p-c-nat-of         LIKE item-doc-est.nat-of       NO-UNDO.
    DEFINE INPUT PARAMETER p-c-it-codigo      LIKE item-doc-est.it-codigo    NO-UNDO. /* \  Recebidos como parÉmetro para */
    DEFINE INPUT PARAMETER p-i-sequencia      LIKE item-doc-est.sequencia    NO-UNDO. /*  > serem apresentados */
    DEFINE INPUT PARAMETER p-i-seq-comp       LIKE item-doc-est.seq-comp     NO-UNDO. /* /  nas mensagens de erro, caso ocorram... */
    /* parametros para a procedure 'validateTypeMovto' */
    DEFINE INPUT PARAMETER p-c-docum-est-uf   LIKE docum-est.uf              NO-UNDO.
    DEFINE INPUT PARAMETER p-i-emitente-natur LIKE emitente.natureza         NO-UNDO.
    DEFINE INPUT PARAMETER p-c-cod-estabel    LIKE docum-est.cod-estabel     NO-UNDO.

    DEFINE VARIABLE l-gera-ficha-auto         AS LOGICAL                     NO-UNDO.
    DEFINE VARIABLE l-ini-cred-auto           AS LOGICAL                     NO-UNDO.
    DEFINE VARIABLE l-gera-ficha-auto-add     AS LOGICAL                     NO-UNDO.
    DEFINE VARIABLE l-ini-cred-auto-add       AS LOGICAL                     NO-UNDO.
    DEFINE VARIABLE c-aux-titulo              AS CHARACTER                   NO-UNDO.
    DEFINE VARIABLE c-aux-help                AS CHARACTER                   NO-UNDO.
    
    DEFINE BUFFER b-natur-oper-doc  FOR natur-oper. /* Buffer para natureza de operaá∆o do documento, cabeáalho nota (nat-operacao). */
    DEFINE BUFFER b-natur-oper-item FOR natur-oper. /* Buffer para natureza fiscal do item (nat-of). */


    /* Busca a natureza de operaá∆o informada para o documento... */
    FIND b-natur-oper-doc WHERE b-natur-oper-doc.nat-operacao = p-c-nat-operacao NO-LOCK NO-ERROR.
    
    /* Valida se a natureza fiscal informada para Item Ç existente... */
    FIND b-natur-oper-item WHERE b-natur-oper-item.nat-operacao = p-c-nat-of NO-LOCK NO-ERROR.
    IF  AVAILABLE b-natur-oper-item THEN DO:
    
        /* Valida se a natureza fiscal informada est† ativa... */
        IF  b-natur-oper-item.nat-ativa = NO THEN DO: /* Natureza n∆o est† ativa... */
            /* S¢ podem ser usadas naturezas de entrada Ativas */
            {method/svc/errors/inserr.i 
                    &ErrorNumber     = 26759    /* msg: A natureza de operaá∆o n∆o est† ativa */ 
                    &ErrorType       = "EMS":U  
                    &ErrorSubType    = "ERROR":U}
            RETURN "NOK":U.
        END.
        
        RUN validateTypeMovto (INPUT p-c-docum-est-uf, INPUT p-i-emitente-natur, INPUT p-c-cod-estabel, INPUT b-natur-oper-item.nat-operacao).

        /* Valida se a natureza fiscal informada para Item Ç de entrada... */
        IF  b-natur-oper-item.tipo <> 1 THEN DO: /* n∆o Ç natureza de entrada... */
            /* S¢ podem ser usadas naturezas de entrada */
            {method/svc/errors/inserr.i 
                    &ErrorNumber     = 52831    /* msg: A natureza fiscal do item &1, sequància &2 n∆o Ç de entrada */ 
                    &ErrorType       = "EMS":U  /* help: Informe uma natureza fiscal do tipo 'entrada' para o item */
                    &ErrorSubType    = "ERROR":U 
                    &ErrorParameters = "p-c-it-codigo + '~~~~' + STRING((IF p-i-seq-comp <> 0 THEN p-i-seq-comp ELSE p-i-sequencia))"}
            RETURN "NOK":U.
        END.
        
        IF  b-natur-oper-item.tipo-compra <> b-natur-oper-doc.tipo-compra THEN DO:
            /* O tipo de compra da natureza fiscal deve ser igual ao tipo de compra da natureza do documento */
            {utp/ut-liter.i O_'tipo_compra'_da_natureza_fiscal_informada_para_o_item_deve_ser_igual_ao_'tipo_compra'_da_natureza_de_operaá∆o_do_documento *}
            {method/svc/errors/inserr.i 
                    &ErrorNumber     = 52832    /* msg:  Natureza fiscal do item &1, sequància &2 n∆o Ç compat°vel */ 
                    &ErrorType       = "EMS":U  /* help: O 'tipo compra' da natureza fiscal informada para o item deve ser igual ao 'tipo compra' da natureza de operaá∆o do documento. */
                    &ErrorSubType    = "ERROR":U 
                    &ErrorParameters = "p-c-it-codigo + '~~~~' + STRING((IF p-i-seq-comp <> 0 THEN p-i-seq-comp ELSE p-i-sequencia)) + '~~~~' + RETURN-VALUE"}
        END.

        IF  b-natur-oper-item.transf <> b-natur-oper-doc.transf THEN DO:
            /* 'Operaá∆o Tranferància' divergentes */
            {utp/ut-liter.i A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Operaá∆o_Tranferància'_como_a_natureza_do_documento *}
            {method/svc/errors/inserr.i 
                    &ErrorNumber     = 52832    /* msg:  Natureza fiscal do item &1, sequància &2 n∆o Ç compat°vel */ 
                    &ErrorType       = "EMS":U  /* help: A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Operaá∆o_Tranferància'_como_a_natureza_do_documento */
                    &ErrorSubType    = "ERROR":U
                    &ErrorParameters = "p-c-it-codigo + '~~~~' + STRING((IF p-i-seq-comp <> 0 THEN p-i-seq-comp ELSE p-i-sequencia)) + '~~~~' + RETURN-VALUE"}
        END.

        IF (b-natur-oper-item.tp-oper-terc <> b-natur-oper-doc.tp-oper-terc) OR (b-natur-oper-item.terceiros <> b-natur-oper-doc.terceiros) THEN DO:
            /* 'Tipo Oper Terceiros' divergentes */
            {utp/ut-liter.i A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_mesmo_'tipo_de_operaá∆o_com_terceiros'_da_natureza_do_documento *}
            {method/svc/errors/inserr.i 
                    &ErrorNumber     = 52832    /* msg:  Natureza fiscal do item &1, sequància &2 n∆o Ç compat°vel */ 
                    &ErrorType       = "EMS":U  /* help: A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_mesmo_'tipo_de_operaá∆o_com_terceiros'_da_natureza_do_documento */
                    &ErrorSubType    = "ERROR":U
                    &ErrorParameters = "p-c-it-codigo + '~~~~' + STRING((IF p-i-seq-comp <> 0 THEN p-i-seq-comp ELSE p-i-sequencia)) + '~~~~' + RETURN-VALUE"}
        END.

        IF  SUBSTRING(b-natur-oper-item.char-1,1,5) <> SUBSTRING(b-natur-oper-doc.char-1,1,5) /* tipo entrega */
            OR b-natur-oper-item.ind-entfut <> b-natur-oper-doc.ind-entfut                    /* nota faturamento */
            OR b-natur-oper-item.ind-est-qtd <> b-natur-oper-doc.ind-est-qtd THEN DO:         /* nota remessa */
            /* 'Operaá‰es de entrega futura/Faturamento antecipado' divergentes */
            {utp/ut-liter.i A_natureza_fiscal_informada_para_o_item_n∆o_possui_a_mesma_'Operaá∆o_de_entrega_futura/Faturamento_antecipado'_da_natureza_do_documento *}
            {method/svc/errors/inserr.i 
                    &ErrorNumber     = 52832    /* msg:  Natureza fiscal do item &1, sequància &2 n∆o Ç compat°vel */ 
                    &ErrorType       = "EMS":U  /* help: A_natureza_fiscal_informada_para_o_item_n∆o_possui_a_mesma_'Operaá∆o_de_entrega_futura/Faturamento_antecipado'_da_natureza_do_documento */
                    &ErrorSubType    = "ERROR":U
                    &ErrorParameters = "p-c-it-codigo + '~~~~' + STRING((IF p-i-seq-comp <> 0 THEN p-i-seq-comp ELSE p-i-sequencia)) + '~~~~' + RETURN-VALUE"}
        END.

        IF  b-natur-oper-item.int-1 <> b-natur-oper-doc.int-1 THEN DO:
            /* 'Nota Pr¢pria' divergentes */
            {utp/ut-liter.i A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Nota_Pr¢pria'_como_a_natureza_do_documento *}
            {method/svc/errors/inserr.i 
                    &ErrorNumber     = 52832    /* msg:  Natureza fiscal do item &1, sequància &2 n∆o Ç compat°vel */ 
                    &ErrorType       = "EMS":U  /* help: A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Nota_Pr¢pria'_como_a_natureza_do_documento */
                    &ErrorSubType    = "ERROR":U
                    &ErrorParameters = "p-c-it-codigo + '~~~~' + STRING((IF p-i-seq-comp <> 0 THEN p-i-seq-comp ELSE p-i-sequencia)) + '~~~~' + RETURN-VALUE"}
        END.

        IF  b-natur-oper-item.log-oper-triang <> b-natur-oper-doc.log-oper-triang THEN DO:
            /* 'Operaá∆o Tringular' divergentes */
            {utp/ut-liter.i A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Operaá∆o_Tringular'_como_a_natureza_do_documento *}
            {method/svc/errors/inserr.i 
                    &ErrorNumber     = 52832    /* msg:  Natureza fiscal do item &1, sequància &2 n∆o Ç compat°vel */ 
                    &ErrorType       = "EMS":U  /* help: A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Operaá∆o_Tringular'_como_a_natureza_do_documento */
                    &ErrorSubType    = "ERROR":U
                    &ErrorParameters = "p-c-it-codigo + '~~~~' + STRING((IF p-i-seq-comp <> 0 THEN p-i-seq-comp ELSE p-i-sequencia)) + '~~~~' + RETURN-VALUE"}
        END.
        
        IF  b-natur-oper-item.imp-nota <> b-natur-oper-doc.imp-nota THEN DO:
            /* Gerar Nota Faturamento */
            {utp/ut-liter.i A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Gerar_Nota_Faturamento'_como_a_natureza_do_documento *}
            {method/svc/errors/inserr.i 
                    &ErrorNumber     = 52832    /* msg:  Natureza fiscal do item &1, sequància &2 n∆o Ç compat°vel */ 
                    &ErrorType       = "EMS":U  /* help: A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Gerar_Nota_Faturamento'_como_a_natureza_do_documento */
                    &ErrorSubType    = "ERROR":U
                    &ErrorParameters = "p-c-it-codigo + '~~~~' + STRING((IF p-i-seq-comp <> 0 THEN p-i-seq-comp ELSE p-i-sequencia)) + '~~~~' + RETURN-VALUE"}
        END.

        IF  b-natur-oper-item.nota-rateio <> b-natur-oper-doc.nota-rateio THEN DO:
            /* Nota Rateio */
            {utp/ut-liter.i A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Nota_Rateio'_como_a_natureza_do_documento *}
            {method/svc/errors/inserr.i  
                    &ErrorNumber     = 52832    /* msg:  Natureza fiscal do item &1, sequància &2 n∆o Ç compat°vel */ 
                    &ErrorType       = "EMS":U  /* help: A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Nota_Rateio'_como_a_natureza_do_documento */
                    &ErrorSubType    = "ERROR":U
                    &ErrorParameters = "p-c-it-codigo + '~~~~' + STRING((IF p-i-seq-comp <> 0 THEN p-i-seq-comp ELSE p-i-sequencia)) + '~~~~' + RETURN-VALUE"}
        END.    

        IF  b-natur-oper-item.log-2 <> b-natur-oper-doc.log-2 THEN DO:
            /* Nota ComÇrcio */
            {utp/ut-liter.i A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Nota_ComÇrcio'_como_a_natureza_do_documento *}
            {method/svc/errors/inserr.i 
                    &ErrorNumber     = 52832    /* msg:  Natureza fiscal do item &1, sequància &2 n∆o Ç compat°vel */ 
                    &ErrorType       = "EMS":U  /* help: A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Nota_ComÇrcio'_como_a_natureza_do_documento */
                    &ErrorSubType    = "ERROR":U
                    &ErrorParameters = "p-c-it-codigo + '~~~~' + STRING((IF p-i-seq-comp <> 0 THEN p-i-seq-comp ELSE p-i-sequencia)) + '~~~~' + RETURN-VALUE"}
        END.

        IF  b-natur-oper-item.int-2 <> b-natur-oper-doc.int-2 THEN DO:
            /* Venda Ambulante */
            {utp/ut-liter.i A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Venda_Ambulante'_como_a_natureza_do_documento *}
            {method/svc/errors/inserr.i 
                    &ErrorNumber     = 52832    /* msg:  Natureza fiscal do item &1, sequància &2 n∆o Ç compat°vel */ 
                    &ErrorType       = "EMS":U  /* help: A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Venda_Ambulante'_como_a_natureza_do_documento */
                    &ErrorSubType    = "ERROR":U
                    &ErrorParameters = "p-c-it-codigo + '~~~~' + STRING((IF p-i-seq-comp <> 0 THEN p-i-seq-comp ELSE p-i-sequencia)) + '~~~~' + RETURN-VALUE"}
        END.

        IF  SUBSTR(b-natur-oper-item.char-2,88,5) <> SUBSTR(b-natur-oper-doc.char-2,88,5) THEN DO:
            /* Gerar Devol. Somente de Valor */
            {utp/ut-liter.i A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Gerar_Devol._Somente_de_Valor'_como_a_natureza_do_documento *}
            {method/svc/errors/inserr.i 
                    &ErrorNumber     = 52832    /* msg:  Natureza fiscal do item &1, sequància &2 n∆o Ç compat°vel */ 
                    &ErrorType       = "EMS":U  /* help: A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Gerar_Devol._Somente_de_Valor'_como_a_natureza_do_documento */
                    &ErrorSubType    = "ERROR":U
                    &ErrorParameters = "p-c-it-codigo + '~~~~' + STRING((IF p-i-seq-comp <> 0 THEN p-i-seq-comp ELSE p-i-sequencia)) + '~~~~' + RETURN-VALUE"}
        END.
        
        IF  b-natur-oper-item.log-natur-operac-draw <> b-natur-oper-doc.log-natur-operac-draw THEN DO:
            /* Natureza Drawback */
            {utp/ut-liter.i A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Natureza_Drawback'_como_a_natureza_do_documento *}
            {method/svc/errors/inserr.i 
                    &ErrorNumber     = 52832    /* msg:  Natureza fiscal do item &1, sequància &2 n∆o Ç compat°vel */ 
                    &ErrorType       = "EMS":U  /* help: A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Natureza_Drawback'_como_a_natureza_do_documento */
                    &ErrorSubType    = "ERROR":U
                    &ErrorParameters = "p-c-it-codigo + '~~~~' + STRING((IF p-i-seq-comp <> 0 THEN p-i-seq-comp ELSE p-i-sequencia)) + '~~~~' + RETURN-VALUE"}
        END.

        IF  b-natur-oper-item.log-memorando <> b-natur-oper-doc.log-memorando THEN DO:
            /* Memorando Exportaá∆o */
            {utp/ut-liter.i A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Memorando_Exportaá∆o'_como_a_natureza_do_documento *}
            {method/svc/errors/inserr.i 
                    &ErrorNumber     = 52832    /* msg:  Natureza fiscal do item &1, sequància &2 n∆o Ç compat°vel */
                    &ErrorType       = "EMS":U  /* help: A_natureza_fiscal_informada_para_o_item_n∆o_possui_o_indicador_'Memorando_Exportaá∆o'_como_a_natureza_do_documento */
                    &ErrorSubType    = "ERROR":U
                    &ErrorParameters = "p-c-it-codigo + '~~~~' + STRING((IF p-i-seq-comp <> 0 THEN p-i-seq-comp ELSE p-i-sequencia)) + '~~~~' + RETURN-VALUE"}
        END.
        
        /* Aquisiá∆o rural */
        IF  (SUBSTRING(b-natur-oper-item.char-1,176,1) <> "0") <> (SUBSTRING(b-natur-oper-doc.char-1,176,1) <> "0") THEN DO:
            {utp/ut-liter.i O_indicador_'Comercializaá∆o_Produá∆o_Rural'_deve_estar_configurado_da_mesma_forma_para_todas_as_naturezas_de_operaá∆o_do_documento_(CD0606) *}
            {method/svc/errors/inserr.i 
                    &ErrorNumber     = 52832    /* msg:  Natureza fiscal do item &1, sequància &2 n∆o Ç compat°vel */
                    &ErrorType       = "EMS":U  /* help: O_indicador_'ComercializaÁao_ProduÁao_Rural'_deve_estar_configurado_da_mesma_forma_para_todas_as_naturezas_de_operaÁao_do_documento_(CD0606) */
                    &ErrorSubType    = "ERROR":U
                    &ErrorParameters = "p-c-it-codigo + '~~~~' + STRING((IF p-i-seq-comp <> 0 THEN p-i-seq-comp ELSE p-i-sequencia)) + '~~~~' + RETURN-VALUE"}
        END.
        /*********************/
    END.
    ELSE DO:
        {method/svc/errors/inserr.i 
                &ErrorNumber  = 52830    /* msg: A natureza fiscal informada para o item n∆o foi encontrada */
                &ErrorType    = "EMS":U  /* help: Informe uma natureza fiscal v†lida para o item */
			    &ErrorSubType = "ERROR":U}
                
        RETURN "NOK":U.                                   
    END.
    
    /*--- Verifica ocorrencia de erros ---*/
    IF  CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN 
        RETURN "NOK":U.

    RETURN "OK":U.

END PROCEDURE.


PROCEDURE validateTypeMovto :
/*------------------------------------------------------------------------------
  Purpose:     Validar a natureza de operaá∆o em relaá∆o ao emitente/estabelecimento(UF)
  
  Parameters:  p-c-docum-est-uf ------> UF do documento;
               p-i-emitente-natur ----> Emitente do documento;
               p-c-cod-estabel -------> Cod. Estabelecimento do documento;
               p-c-item-nat-operacao -> Natureza de operaá∆o informada para o item;
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE INPUT PARAMETER p-c-docum-est-uf      LIKE docum-est.uf            NO-UNDO.
    DEFINE INPUT PARAMETER p-i-emitente-natur    LIKE emitente.natureza       NO-UNDO.
    DEFINE INPUT PARAMETER p-c-cod-estabel       LIKE docum-est.cod-estabel   NO-UNDO.
    DEFINE INPUT PARAMETER p-c-item-nat-operacao LIKE natur-oper.nat-operacao NO-UNDO.
    
    DEFINE VARIABLE        l-erro             AS LOGICAL                      NO-UNDO.
    DEFINE BUFFER          bf-estabelec       FOR estabelec.
   
    IF  i-pais-impto-usuario = 1 THEN  /**** Brasil *****/
        ASSIGN l-erro = YES.
    ELSE 
        RETURN "OK":U. 
    
    FIND FIRST bf-estabelec WHERE bf-estabelec.cod-estabel = p-c-cod-estabel NO-LOCK NO-ERROR.
    IF  AVAIL bf-estabelec THEN DO:

        IF  p-c-docum-est-uf = bf-estabelec.estado AND (p-c-item-nat-operacao BEGINS "1" OR p-c-item-nat-operacao BEGINS "5") THEN
            ASSIGN l-erro = NO.
        ELSE DO:

            IF  p-c-docum-est-uf <> bf-estabelec.estado AND p-i-emitente-natur = 3 /*"E"*/ 
                AND (p-c-item-nat-operacao BEGINS "3" OR p-c-item-nat-operacao BEGINS "7") THEN
                ASSIGN l-erro = NO.
            ELSE DO:
                IF  p-c-docum-est-uf <> bf-estabelec.estado AND p-i-emitente-natur <> 3 /*"E"*/
                    AND (p-c-item-nat-operacao BEGINS "2" OR p-c-item-nat-operacao BEGINS "6") THEN
                    ASSIGN l-erro = NO.
            END.
        END.

        IF  l-erro THEN DO:
            {method/svc/errors/inserr.i
                                &ErrorNumber="19235"
                                &ErrorType="EMS":U
                                &ErrorSubType="WARNING":U}
            RETURN "NOK":U.
        END.
    END.
    
    RETURN "OK":U.

END PROCEDURE.

PROCEDURE setNatOF :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEF INPUT PARAM pi-nat-of              LIKE item-doc-est.nat-of       NO-UNDO.
    DEF INPUT PARAM pi-class-fiscal        LIKE item-doc-est.class-fiscal NO-UNDO.
    DEF INPUT PARAM pi-alteracao-nat-oper  AS LOGICAL INITIAL NO          NO-UNDO.
    
    DEF VAR c-nat-of-old                   LIKE item-doc-est.nat-of       NO-UNDO.
    DEF VAR i-idi-tip-dado                 AS INTEGER                     NO-UNDO.
    DEF VAR h-bodi516                      AS HANDLE                      NO-UNDO.

    /* Alteraá∆o da natureza fiscal do item */
    ASSIGN c-nat-of-old           = RowObject.nat-of
           RowObject.nat-of       = pi-nat-of
           RowObject.class-fiscal = pi-class-fiscal
           l-alteracao-nat-oper   = pi-alteracao-nat-oper
           l-recalcula            = no.
           
    /* Volta aos valores iniciais os campos de ST, para que sejam sugeridos de acordo com a nova natureza*/
    ASSIGN RowObject.log-2        = no
           RowObject.base-subs    = 0
           RowObject.vl-subs      = 0.
           
    run findDocumento ( RowObject.cod-emitente,
                        RowObject.serie-docto,
                        RowObject.nro-docto,   
                        RowObject.nat-operacao ).
    
    if avail docum-est then do:
        /* Alteraá∆o dos registros das informaá‰es referentes ao Difal e ao FCP com a Nat-of antiga */            
        IF NOT VALID-HANDLE(h-bodi516) THEN
           RUN dibo/bodi516.p PERSISTENT SET h-bodi516.
        RUN openQueryStatic IN h-bodi516 (INPUT "Main":U).
        
        DO  i-idi-tip-dado = 24 TO 35:
            IF i-idi-tip-dado = 24 OR /*ICMS de Partilha - DIFAL*/
               i-idi-tip-dado = 25 OR /*FCP*/
               i-idi-tip-dado = 27 OR /*REINF - Serviáos Tomados*/
               i-idi-tip-dado = 33 OR /*REINF - Retená‰es na Fonte*/
               i-idi-tip-dado = 35 THEN DO: /*REINF - Aquisiá∆o Produá∆o Rural*/
               
                EMPTY TEMP-TABLE tt-item-nf-adc.
                RUN goToKey IN h-bodi516 (INPUT docum-est.cod-estabel,
                                          INPUT RowObject.serie-docto,
                                          INPUT RowObject.nro-docto,
                                          INPUT RowObject.cod-emitente,
                                          INPUT c-nat-of-old,
                                          INPUT i-idi-tip-dado, 
                                          INPUT RowObject.sequencia,
                                          INPUT RowObject.sequencia,
                                          INPUT RowObject.it-codigo).
                IF RETURN-VALUE = "OK":U THEN DO:
                    RUN getRecord IN h-bodi516 (OUTPUT TABLE tt-item-nf-adc).
                    FIND FIRST tt-item-nf-adc NO-LOCK NO-ERROR.
                    IF AVAIL tt-item-nf-adc THEN
                       ASSIGN tt-item-nf-adc.cod-natur-operac = RowObject.nat-of.
                    RUN setRecord IN h-bodi516 (INPUT TABLE tt-item-nf-adc).
                    RUN emptyRowErrors IN h-bodi516.
                    RUN updateRecord IN h-bodi516.  
                END.
            END.
        END.
      
        IF VALID-HANDLE(h-bodi516) THEN DO:
           DELETE PROCEDURE h-bodi516.
           ASSIGN h-bodi516 = ?.
        END.
    end.
    
    RETURN "OK":U.
  
END PROCEDURE.
