&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQuery DBOProgram 
PROCEDURE openQuery :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            RUN openQueryStatic (input "Main":U).
    end case.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryMain DBOProgram 
PROCEDURE openQueryMain :
/*------------------------------------------------------------------------------
  Purpose:     Abertura da query principal do DBO
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH gr-cmp-comprad NO-LOCK INDEXED-REPOSITION.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*------------------------------------------------------------------------------
  Purpose:     Valida temptable RowObject
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:
------------------------------------------------------------------------------*/

    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.

    /*--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do
          include: method/svc/errors/inserr.i ---*/
    /*--- Inclua aqui as validaá‰es ---*/

    /*--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getRowidGrupoCompra DBOProgram 
PROCEDURE getRowidGrupoCompra :
/*------------------------------------------------------------------------------
  Purpose:   Procura o primeiro comprador parametrizado relacionado ao grupo de compra
             do comprador, se n∆o encontrar acha o primeiro grupo de compra.
  Parameters:  
             ipar1 : prComprador   : rowid do comprador
             opar2 : prGrupoCompra : rowid do grupo de compra do comprador
  Notes:
------------------------------------------------------------------------------*/
    def input  param prComprador   as rowid no-undo.
    def output param prGrupoCompra as rowid no-undo.
    
    find comprador where
         rowid(comprador) = prComprador
         no-lock no-error.
         
    find first gr-cmp-comprad where
               gr-cmp-comprad.cod-comprado = comprador.cod-comprado
               no-lock no-error.
    if avail gr-cmp-comprad then do:
        assign prGrupoCompra = rowid(gr-cmp-comprad).
    end.    
                              
    RETURN "OK":U.
END PROCEDURE.

