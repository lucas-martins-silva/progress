&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*--- Inclua aqui as validaá‰es ---*/
    
    IF pType = "create":u THEN DO:

        IF NOT CAN-FIND (FIRST ITEM WHERE ITEM.it-codigo = RowObject.it-codigo) THEN DO:
            /* Inicio -- Projeto Internacional */
            {utp/ut-table.i mgind item 1} /* Busca o label da tabela */
            {method/svc/errors/inserr.i
                                 &ErrorNumber="47"
                                 &ErrorType="EMS"
                                 &ErrorParameters=TRIM(RETURN-VALUE)}
        END.
        
        IF NOT CAN-FIND (FIRST tab-unidade WHERE tab-unidade.un = RowObject.um-origem) THEN DO:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-unidade-de-medida-origem AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Unidade_de_Medida_Origem" *}
            ASSIGN c-lbl-liter-unidade-de-medida-origem = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                                 &ErrorNumber="47"
                                 &ErrorType="EMS"
                                 &ErrorParameters="c-lbl-liter-unidade-de-medida-origem"}
        END.

        IF NOT CAN-FIND (FIRST tab-unidade WHERE tab-unidade.un = RowObject.um-destino) THEN DO:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-unidade-de-medida-destino AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Unidade_de_Medida_Destino" *}
            ASSIGN c-lbl-liter-unidade-de-medida-destino = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                                 &ErrorNumber="47"
                                 &ErrorType="EMS"
                                 &ErrorParameters="c-lbl-liter-unidade-de-medida-destino"}
        END.

        IF RowObject.um-origem = RowObject.um-destino THEN DO:

            {method/svc/errors/inserr.i
                                 &ErrorNumber="27239"
                                 &ErrorType="EMS"
                                 &ErrorParameters="''"}

        END.

        IF CAN-FIND (FIRST conv-man-item WHERE
                           conv-man-item.it-codigo  = RowObject.it-codigo AND
                           conv-man-item.um-origem  = RowObject.um-origem AND
                           conv-man-item.um-destino = RowObject.um-destino) THEN DO:
            /* Inicio -- Projeto Internacional */
            {utp/ut-table.i mgind conv-man-item 1} /* Busca o label da tabela */
            {method/svc/errors/inserr.i
                                 &ErrorNumber="7"
                                 &ErrorType="EMS"
                                 &ErrorParameters=TRIM(RETURN-VALUE)}

        END.
        
        if RowObject.fator-conv <= 0 then do:

            {method/svc/errors/inserr.i
                                 &ErrorNumber="5465"
                                 &ErrorType="EMS"
                                 &ErrorParameters="''"}

        end.

    END.

    /*--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

