PROCEDURE calculate_ICMS_SubsTrib_ICMSComp :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: Executa a BO de impostos para calcular o ICMS, Substitui»’o Tributÿria
         e ICMS Complementar, atualizando os valores no item-doc-est.
------------------------------------------------------------------------------*/

    DEF BUFFER b-natur-oper-fiscal FOR natur-oper. 
    DEF VAR l-procedimento-ok AS LOGICAL  NO-UNDO.
    DEF VAR h-bodi516         AS HANDLE   NO-UNDO.
    DEF VAR l-grava-subs      AS LOGICAL  NO-UNDO.
    DEF VAR de-base-fcp       AS DECIMAL  NO-UNDO. 
    DEF VAR de-aliq-fcp       AS DECIMAL  NO-UNDO.
    DEF VAR de-valor-fcp      AS DECIMAL  NO-UNDO.
    DEF VAR de-base-fcp-st    AS DECIMAL  NO-UNDO.
    DEF VAR de-aliq-fcp-st    AS DECIMAL  NO-UNDO.
    DEF VAR de-valor-fcp-st   AS DECIMAL  NO-UNDO.
    DEF VAR l-ret-goToKey     AS LOGICAL  NO-UNDO.

    run findDocumento ( RowObject.Cod-Emitente,
                        RowObject.Serie-Docto,
                        RowObject.Nro-Docto,
                        RowObject.Nat-Operacao ).

    if  return-value <> "OK":U OR 
        not avail docum-est then
        return "NOK":U.
        
    /* Se usa m£ltiplas naturezas no recebimento */
    IF  l-mult-natur-receb THEN 
        FIND FIRST b-natur-oper-fiscal WHERE b-natur-oper-fiscal.nat-operacao = RowObject.nat-of NO-LOCK NO-ERROR.
    
    /* Se nÆo usa multiplas naturezas ou usa mas a nota ‚ antiga (digit. antes de marcar o parƒm.) */
    IF  NOT l-mult-natur-receb OR NOT AVAIL b-natur-oper-fiscal THEN
        FIND FIRST b-natur-oper-fiscal WHERE b-natur-oper-fiscal.nat-operacao = RowObject.nat-operacao NO-LOCK NO-ERROR.

    if  (docum-est.cod-observa = 3 or               /*Devolucao Cliente*/
        (avail b-natur-oper-fiscal and b-natur-oper-fiscal.tp-oper-terc = 5)) then  /*Devolucao Consignacao*/
        find first b-emit-estab no-lock 
             where b-emit-estab.cod-emitente = docum-est.cod-emitente no-error.
    else
        find first b-emit-estab no-lock 
             where b-emit-estab.cod-emitente = estabelec.cod-emitente no-error.
             
    find first tb-wt-docto exclusive-lock
         where tb-wt-docto.seq-wt-docto = 1 no-error.
        
    find first tb-wt-it-docto exclusive-lock
         where tb-wt-it-docto.nr-seq-nota  = 1
           and tb-wt-it-docto.nr-sequencia = RowObject.sequencia no-error.
    if  avail tb-wt-it-docto then       
        assign tb-wt-it-docto.vl-despes-it = if b-natur-oper-fiscal.log-icms-presmdo then 0 else RowObject.despesas[1]
               tb-wt-it-docto.vl-frete     = if b-natur-oper-fiscal.log-icms-presmdo then 0 else RowObject.pr-total-cmi.
    
    find tb-wt-it-imposto exclusive-lock 
        where tb-wt-it-imposto.seq-wt-docto    = 1
          and tb-wt-it-imposto.seq-wt-it-docto = RowObject.sequencia no-error.
    
    if  avail tb-wt-it-imposto 
    and avail b-natur-oper-fiscal 
    and b-natur-oper-fiscal.nota-rateio = no 
    /*Quando for Nota de Rateio nÆo atualizar a tb-wt-it-imposto, para que ela possa alimentar a Item-doc-est na boin366*/
    then 
       assign tb-wt-it-imposto.vl-bipi-it    = RowObject.base-ipi[1]    
              tb-wt-it-imposto.vl-ipint-it   = RowObject.ipi-ntrib[1]       
              tb-wt-it-imposto.vl-ipiou-it   = RowObject.ipi-outras[1]
              tb-wt-it-imposto.vl-ipi-outras = RowObject.ipi-outras[2]
              tb-wt-it-imposto.vl-ipi-it     = RowObject.valor-ipi[1].
    
    if  docum-est.cod-observa  = 3  and
        RowObject.nro-comp <> "" then do:
        for first nota-fiscal FIELDS (cidade-cif)
            where nota-fiscal.nr-nota-fis = RowObject.nro-comp
              and nota-fiscal.serie       = RowObject.serie-comp 
              and nota-fiscal.cod-estabel = docum-est.cod-estabel no-lock:
              assign tb-wt-docto.cidade-cif = nota-fiscal.cidade-cif.
        end.
    end.

    if  not avail tb-wt-docto
    or  not avail tb-wt-it-docto
    or  not avail tb-wt-it-imposto then
         return "NOK":U. 
 
    if  valid-handle(h_bodi317im2bra) then do:
        run enviaTbWtDocto  in h_bodi317im2bra (input table tb-wt-docto).
        run localizaWtDocto in h_bodi317im2bra (input 1,
                                                output l-procedimento-ok).
        if  not l-procedimento-ok then 
            RETURN "NOK":U.

        run enviaTbWtItDocto in h_bodi317im2bra ( input table tb-wt-it-docto ) .
        run localizaWtItDocto in h_bodi317im2bra ( input 1,
                                                   input tb-wt-it-docto.seq-wt-it-docto,
                                                   output l-procedimento-ok ).
        IF  not l-procedimento-ok then 
            RETURN "NOK":U.
    
        run enviaTbWtItImposto in h_bodi317im2bra ( input table tb-wt-it-imposto ) .    
        run localizaWtItImposto in h_bodi317im2bra ( input 1,
                                                     input tb-wt-it-docto.seq-wt-it-docto,
                                                     output l-procedimento-ok ).        
        IF  not l-procedimento-ok then 
            RETURN "NOK":U.
            
        RUN calculaICMS in h_bodi317im2bra ( input  1,
                                             output l-procedimento-ok) .

        RUN calculaICMSComplementar in h_bodi317im2bra ( input  1,
                                                         output l-procedimento-ok) .
                                                     
        /* Retorna novamente para a tabela tb-wt-docto os dados para que sejam calculados novamente o ICMS substituto corretamente */
        if  docum-est.cod-observa = 3
        or  ( natur-oper.terceiros and natur-oper.tp-oper-terc = 5 ) then 
            assign tb-wt-docto.cidade       = emitente.cidade
                   tb-wt-docto.estado       = emitente.estado
                   tb-wt-docto.pais         = emitente.pais.
        else
            assign tb-wt-docto.cidade       = estabelec.cidade
                   tb-wt-docto.estado       = estabelec.estado
                   tb-wt-docto.pais         = estabelec.pais.
                   
        if  valid-handle(h_bodi317im2bra) then do:
             run enviaTbWtDocto  in h_bodi317im2bra ( input table tb-wt-docto ) .
             run localizaWtDocto in h_bodi317im2bra ( input 1,
                                                      output l-procedimento-ok ).
        end.
        
        if  natur-oper.tipo-compra <> 2 then do:  /* Frete */   
            RUN calculaICMSSubstituto in h_bodi317im2bra ( input  1,
                                                           ( if avail b-emit-estab
                                                             then b-emit-estab.insc-subs-trib
                                                             else " " ),
                                                           output l-procedimento-ok) .
        end.
        
        RUN retornaTbWtItImposto in h_bodi317im2bra (output table tb-wt-it-imposto).
        
        
        if  valid-handle(h_bodi317im2bra) then
            run enviaTbWtItImposto in h_bodi317im2bra ( input table tb-wt-it-imposto ) .            
                       
        RUN retornaTbWtItImposto in h_bodi317im2bra (output table tb-wt-it-imposto).
    end.

    find tb-wt-it-imposto
        where tb-wt-it-imposto.seq-wt-docto    = 1
          and tb-wt-it-imposto.seq-wt-it-docto = RowObject.sequencia exclusive-lock no-error.
    if  avail tb-wt-it-imposto and
        not l-recalcula then do: /* Somente para recalculo do imposto */ 
        
        assign RowObject.valor-icm              = tb-wt-it-imposto.vl-icms-it
               RowObject.base-icm               = tb-wt-it-imposto.vl-bicms-it
               RowObject.icm-ntrib              = tb-wt-it-imposto.vl-icmsnt-it
               RowObject.icm-outras[1]          = tb-wt-it-imposto.vl-icmsou-it
               RowObject.icm-outras[2]          = tb-wt-it-imposto.vl-icms-outras                   
               RowObject.icm-complem            = tb-wt-it-imposto.icm-complem
               overlay(RowObject.char-2,796,6)  = string(tb-wt-it-imposto.val-perc-icms-diferim)
               overlay(RowObject.char-2,802,17) = string(tb-wt-it-imposto.val-diferim-icms-item)
               overlay(RowObject.char-2,860,20) = substring(tb-wt-it-imposto.char-1,296,20)  /*base icms complementar*/
               overlay(RowObject.char-2,880,8)  = substring(tb-wt-it-imposto.char-1,316,8)   /*aliquota FCP*/
               overlay(RowObject.char-2,888,20) = substring(tb-wt-it-imposto.char-1,324,20). /*valor FCP*/
               
         case substring(tb-wt-it-imposto.char-1,97,1): /*mod BC ST*/
              when "S" then assign overlay(RowObject.char-2,910,1) = "S":U.
              when "N" then assign overlay(RowObject.char-2,910,1) = "N":U.
              when "V" then assign overlay(RowObject.char-2,910,1) = "V":U.
              otherwise assign overlay(RowObject.char-2,910,1) = "N":U.
         end case.
         
        /*** Altera‡Æo TSVZHV - Isoeste -  Soma ICMS no Total da Nota ***/
        {cdp/cd4300.i3}
        {rep/re1001a.i50}  /* variaveis e informacoes utilizadas pelo re1001a.i51 */    
        
        if param-global.modulo-07 and
           emitente.pais <> estabelec.pais and
           (emitente.natureza = 3 or emitente.natureza = 4) and 
           docum-est.origem <> "I" then do:
            
            {cdp/cd4300.i4   "yes" docum-est.char-1}
            {rep/re1001a.i51 "yes"}
            
            if c-embarque <> "" and
              (SUBSTR(natur-oper.char-2,145,1) = "1" OR  SUBSTR(natur-oper.char-2,146,1) = "1") AND 
                natur-oper.nota-rateio THEN
                   ASSIGN RowObject.despesas[1] = RowObject.despesas[1] + RowObject.valor-icm[1].
        end.
        
        assign l-grava-subs = yes.
              
        /*PONTO UPC UNIMED NORDESTE - SSIM TEXZ13*/
        IF c-nom-prog-upc-mg97 <> "" THEN DO:
            FOR EACH tt-epc
               WHERE tt-epc.cod-event = "Grava-Subs-Trib":
               DELETE tt-epc.
            END.
               
            {include/i-epc200.i2 &CodEvent='"Grava-Subs-Trib"'
                                 &CodParameter='"Handle-RowObject"'
                                 &ValueParameter="STRING(BUFFER RowObject:HANDLE)"}
               
            {include/i-epc200.i2 &CodEvent='"Grava-Subs-Trib"'
                                 &CodParameter='"Rowid-item-doc-est"'
                                 &ValueParameter="string(rowid(RowObject))"}
                     
            {include/i-epc201.i "Grava-Subs-Trib"}
            
            FIND FIRST tt-epc 
                 WHERE tt-epc.cod-event     = "Grava-Subs-Trib"
                   AND tt-epc.cod-parameter = "Retorno-upc"
                   AND tt-epc.val-parameter = "NO" NO-LOCK NO-ERROR.
            
            IF AVAIL tt-epc THEN
                ASSIGN l-grava-subs = NO.
        END.
           
        if l-grava-subs = yes then do:
           IF b-natur-oper-fiscal.log-icms-substto-antecip /*Cr²d Subst Trib Antecip*/
           OR b-natur-oper-fiscal.log-contrib-st-antec THEN DO:
                if RowObject.nro-comp = " " or /*Sem nota relacionada*/
                   natur-oper.tipo-compra <> 3 then /* Devol Cli */  
                assign RowObject.base-subs =  if RowObject.base-subs[1] <> 0 then RowObject.base-subs[1]  else  tb-wt-it-imposto.vl-bsubs-it 
                       RowObject.vl-subs   =  if RowObject.vl-subs[1]  <> 0 then  RowObject.vl-subs[1]    else  tb-wt-it-imposto.vl-icmsub-it.  
           END.            
           ELSE
               assign RowObject.base-subs = tb-wt-it-imposto.vl-bsubs-it    when RowObject.nro-comp = " " or natur-oper.tipo-compra <> 3 /* Devol Cli */
                      RowObject.vl-subs   = tb-wt-it-imposto.vl-icmsub-it   when RowObject.nro-comp = " " or natur-oper.tipo-compra <> 3. /* Devol Cli */
        end.


        /********************************* Gravacao aliquota ICMS Substituto *********************************/
        find first tb-wt-it-imposto
             where tb-wt-it-imposto.seq-wt-docto    = 1
               and tb-wt-it-imposto.seq-wt-it-docto = RowObject.sequencia no-lock no-error.
        if  avail tb-wt-it-imposto and 
            decimal(substring(tb-wt-it-imposto.char-1,71,6)) > 0 then do: 
            

            
            if not valid-handle(h-bodi516) then
               RUN dibo/bodi516.p PERSISTENT SET h-bodi516.
            RUN openQueryStatic IN h-bodi516 (INPUT "Main":U).
            
            RUN goToKey IN h-bodi516 (input docum-est.cod-estabel,
                                      input RowObject.serie-docto,
                                      input RowObject.nro-docto,
                                      input RowObject.cod-emitente,
                                      input RowObject.nat-operacao,
                                      input 1,
                                      input 1,
                                      input RowObject.sequencia,
                                      input RowObject.it-codigo).
            
            EMPTY TEMP-TABLE tt-item-nf-adc.
            
            create  tt-item-nf-adc.
            assign  tt-item-nf-adc.cod-estab             = docum-est.cod-estabel
                    tt-item-nf-adc.cod-serie             = RowObject.serie-docto
                    tt-item-nf-adc.cod-nota-fisc         = RowObject.nro-docto
                    tt-item-nf-adc.cdn-emitente          = RowObject.cod-emitente
                    tt-item-nf-adc.cod-natur-operac      = RowObject.nat-operacao
                    tt-item-nf-adc.idi-tip-dado          = 1
                    tt-item-nf-adc.num-seq               = 1
                    tt-item-nf-adc.num-seq-item-nf       = RowObject.sequencia
                    tt-item-nf-adc.cod-item              = RowObject.it-codigo
                    tt-item-nf-adc.val-aliq-icms-st      = decimal(substring(tb-wt-it-imposto.char-1,71,6)) 
                    tt-item-nf-adc.val-livre-1           = if substring(tb-wt-it-imposto.char-1,97,1) <> 'S' then tb-wt-it-imposto.dec-1 else 0 /* % MVA  */     
		    tt-item-nf-adc.val-livre-2           = dec(trim(substring(tb-wt-it-imposto.char-1,344,7))). /* % Red BC ST*/

            /*Se for devolu‡Æo com origem buscar o %MVA da nota de
             de venda */
            if  docum-est.cod-observa  = 3  and
                RowObject.nro-comp <> "" then do:
                for first  it-nota-fisc no-lock
                    where  it-nota-fisc.cod-estabel = docum-est.cod-estabel
                    and    it-nota-fisc.serie       = RowObject.serie-comp
                    and    it-nota-fisc.nr-nota-fis = RowObject.nro-comp
                    and    it-nota-fisc.nr-seq-fat  = RowObject.seq-comp 
                    and    it-nota-fisc.it-codigo   = RowObject.it-codigo :
                    
                    assign tt-item-nf-adc.val-livre-1 = dec(substring(it-nota-fisc.char-2,338,8)). /*% de MVA*/
                end.
                
            end.

            IF RETURN-VALUE = "NOK":U THEN DO:
                RUN setRecord IN h-bodi516 (INPUT TABLE tt-item-nf-adc).
                RUN createRecord IN h-bodi516.
            END.
            ELSE DO:
                RUN setRecord IN h-bodi516 (INPUT TABLE tt-item-nf-adc).
                RUN updateRecord IN h-bodi516.  
            END.
            
            RUN emptyRowErrors IN h-bodi516.
            
            if valid-handle(h-bodi516) then
                delete procedure h-bodi516.
            assign h-bodi516 = ?.
        end.
        /*****************************************************************************************************/
    end.             

    if RowObject.cd-trib-icm = 1 and        //Tributado
       avail b-natur-oper-fiscal and
       b-natur-oper-fiscal.log-livre-6 then //Convˆnio 109/24
        assign RowObject.base-icm     = 0
               RowObject.icm-ntrib    = 0
               RowObject.icm-outras   = 0
               RowObject.aliquota-icm = 0.

    RETURN "OK":U.
END PROCEDURE.
