/***********************************************************************************
* Temp-tables utilizadas na boin793.p e mla0170rp.p                                *
*                                                                                  *
* situacao: 'Mantido', 'Novo', 'Substitu¡do', 'Eliminado', 'Origem', 'Transferido' * 
* id-sit  :     1    ,    2  ,       3      ,       4    ,     5   ,       6       * 
* r-rowid : rowid do registro alterado,exclu¡do ou inserido.                       * 
***********************************************************************************/ 
DEFINE TEMP-TABLE tt-mla-hierarquia-faixa-origem NO-UNDO LIKE mla-hierarquia-faixa
    FIELD situacao AS CHAR FORMAT "x(20)"
    FIELD id-sit   AS INT
    FIELD r-rowid  AS ROWID
    INDEX codigo   ep-codigo  
                   cod-estabel
                   cod-lotacao
                   cod-tip-doc
                   num-faixa   ASC 
                   cod-usuar
                   situacao.    

DEFINE TEMP-TABLE tt-mla-hierarquia-faixa-destino NO-UNDO LIKE tt-mla-hierarquia-faixa-origem.





