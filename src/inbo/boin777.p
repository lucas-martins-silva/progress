&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice referencia
  Parameters:  
               recebe valor do campo ep-codigo
               recebe valor do campo cod-tip-doc
               recebe valor do campo codigo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pep-codigo LIKE mla-referencia.ep-codigo NO-UNDO.
    DEFINE INPUT PARAMETER pcod-tip-doc LIKE mla-referencia.cod-tip-doc NO-UNDO.
    DEFINE INPUT PARAMETER pcodigo LIKE mla-referencia.codigo NO-UNDO.

    FIND FIRST bfmla-referencia WHERE 
        bfmla-referencia.ep-codigo = pep-codigo AND 
        bfmla-referencia.cod-tip-doc = pcod-tip-doc AND 
        bfmla-referencia.codigo = pcodigo NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfmla-referencia THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfmla-referencia)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

