&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/

    IF pType = "CREATE":U OR pType = "UPDATE":U THEN DO:

        IF pType = "CREATE":U
        AND CAN-FIND(FIRST mla-referencia
                     WHERE mla-referencia.ep-codigo = RowObject.ep-codigo
                       AND mla-referencia.cod-tip-doc = RowObject.cod-tip-doc
                       AND mla-referencia.codigo = RowObject.codigo) THEN DO:
            {utp/ut-liter.i "referàncias_de_Aprovaá∆o"}
            {method/svc/errors/inserr.i
                    &ErrorNumber="1"
                    &ErrorType="EMS"
                    &ErrorSubType="ERROR" 
                    &ErrorParameters=RETURN-VALUE}
        END.

        /* Existància da empresa */
        IF NOT CAN-FIND (FIRST empresa
                         WHERE empresa.ep-codigo = RowObject.ep-codigo) THEN DO:
            {utp/ut-liter.i "empresa"}
            {method/svc/errors/inserr.i
                    &ErrorNumber="2"
                    &ErrorType="EMS"
                    &ErrorSubType="ERROR" 
                    &ErrorParameters=RETURN-VALUE}
        END.

        /* Existància do documento */
        IF NOT CAN-FIND (FIRST mla-tipo-doc-aprov
                         WHERE mla-tipo-doc-aprov.ep-codigo   = RowObject.ep-codigo
                           AND mla-tipo-doc-aprov.cod-tip-doc = RowObject.cod-tip-doc) THEN DO:
            {utp/ut-liter.i "documento"}
            {method/svc/errors/inserr.i
                    &ErrorNumber="2"
                    &ErrorType="EMS"
                    &ErrorSubType="ERROR" 
                    &ErrorParameters=RETURN-VALUE}
        END.
    END.
    ELSE DO:
        DEFINE VARIABLE c-lbl-referencia AS CHARACTER   NO-UNDO.
        {utp/ut-liter.i "referància"}
        ASSIGN c-lbl-referencia = RETURN-VALUE.

        IF CAN-FIND(FIRST mla-tipo-aprov-ref
                    WHERE mla-tipo-aprov-ref.ep-codigo   = RowObject.ep-codigo
                      AND mla-tipo-aprov-ref.cod-tip-doc = RowObject.cod-tip-doc
                      AND mla-tipo-aprov-ref.codigo      = RowObject.codigo) THEN DO:
            DEFINE VARIABLE c-lbl-tipo-aprovacao AS CHARACTER   NO-UNDO.
            {utp/ut-liter.i "tipos_de_aprovaá∆o"}
            ASSIGN c-lbl-tipo-aprovacao = RETURN-VALUE.
            {method/svc/errors/inserr.i
                    &ErrorNumber="29776"
                    &ErrorType="EMS"
                    &ErrorSubType="ERROR" 
                    &ErrorParameters="c-lbl-tipo-aprovacao + '~~~~' + c-lbl-referencia"}
        END.

        IF CAN-FIND(FIRST mla-lista-aprov-ref 
                    WHERE mla-lista-aprov-ref.ep-codigo   = RowObject.ep-codigo
                      AND mla-lista-aprov-ref.cod-tip-doc = RowObject.cod-tip-doc
                      AND mla-lista-aprov-ref.codigo      = RowObject.codigo) THEN DO:
            DEFINE VARIABLE c-lbl-lista-aprovacao AS CHARACTER   NO-UNDO.
            {utp/ut-liter.i "listas_de_aprovaá∆o"}
            ASSIGN c-lbl-lista-aprovacao = RETURN-VALUE.
            {method/svc/errors/inserr.i
                    &ErrorNumber="29776"
                    &ErrorType="EMS"
                    &ErrorSubType="ERROR" 
                    &ErrorParameters="c-lbl-lista-aprovacao + '~~~~' + c-lbl-referencia"}
        END.
    END.

    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

