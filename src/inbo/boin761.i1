        ELSE IF rowObject.cod-campo = "BBM-TP-PREGAO" THEN DO:
            IF LENGTH(rowObject.dsl-conteudo) > 1 THEN DO:
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-conteudo-do-campo-5 AS CHARACTER NO-UNDO.
