                       &ErrorType="EMS":U
                       &ErrorSubType="Error":U
                       &ErrorParameters = "c-lbl-inserr-conteudo-do-campo-6-rowo"}
               END.
            END.
        END.
        ELSE IF rowObject.cod-campo = "BBM-GARANTIA" AND
                LENGTH(rowObject.dsl-conteudo) > 50 THEN DO:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-conteudo-do-campo-7 AS CHARACTER NO-UNDO.
