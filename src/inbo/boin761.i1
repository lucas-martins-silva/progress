                &ErrorParameters = "c-lbl-inserr-conteudo-do-campo-13-row"}
        END.
        ELSE IF rowObject.cod-campo = "BBM-TP-OFERTA" THEN DO:
            IF LENGTH(rowObject.dsl-conteudo) > 1 THEN DO:
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-conteudo-do-campo-14 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Conte£do_do_campo" *}
                ASSIGN c-lbl-liter-conteudo-do-campo-14 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-bbm-9 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "BBM" *}
                ASSIGN c-lbl-liter-bbm-9 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-pela-bbm-maximo-1-caracter-2 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "pela_BBM_maximo_1_caracter" *}
                ASSIGN c-lbl-liter-pela-bbm-maximo-1-caracter-2 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-inserr-conteudo-do-campo-14-row AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-inserr-conteudo-do-campo-14-row = c-lbl-liter-conteudo-do-campo-14 + ' ' + rowObject.cod-campo + '~~~~' + ' ' + c-lbl-liter-bbm-9 + '.' + '~~~~' + c-lbl-liter-pela-bbm-maximo-1-caracter-2.
                {method/svc/errors/inserr.i
                    &ErrorNumber="32854"
                    &ErrorType="EMS":U
                    &ErrorSubType="ERROR":U
                    &ErrorParameters = "c-lbl-inserr-conteudo-do-campo-14-row"}
            END.
            IF rowObject.dsl-conteudo <> "C" THEN DO:
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-conteudo-do-campo-15 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Conte£do_do_campo" *}
                ASSIGN c-lbl-liter-conteudo-do-campo-15 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-a-regra-bbm-6 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "a_regra_BBM" *}
                ASSIGN c-lbl-liter-a-regra-bbm-6 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-ser-c-referente-a-compra AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "ser_C,_referente_a_compra" *}
                ASSIGN c-lbl-liter-ser-c-referente-a-compra = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-inserr-conteudo-do-campo-15-row AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-inserr-conteudo-do-campo-15-row = c-lbl-liter-conteudo-do-campo-15 + ' ' + rowObject.cod-campo + '~~~~' + ' ' + c-lbl-liter-a-regra-bbm-6 + '.' + '~~~~' + c-lbl-liter-ser-c-referente-a-compra + '.'.
                {method/svc/errors/inserr.i
                    &ErrorNumber="32853"
                    &ErrorType="EMS":U
                    &ErrorSubType="Error":U
                    &ErrorParameters = "c-lbl-inserr-conteudo-do-campo-15-row"}
            END.
        END.        
        ELSE IF rowObject.cod-campo = "BBM-ANEXO-NOME" AND
                LENGTH(rowObject.dsl-conteudo) > 50 THEN DO:        
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-conteudo-do-campo-16 AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Conte£do_do_campo" *}
            ASSIGN c-lbl-liter-conteudo-do-campo-16 = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-liter-bbm-10 AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "BBM" *}
            ASSIGN c-lbl-liter-bbm-10 = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-liter-pela-bbm-maximo-50-caracteres-8 AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "pela_BBM_maximo_50_caracteres" *}
            ASSIGN c-lbl-liter-pela-bbm-maximo-50-caracteres-8 = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-inserr-conteudo-do-campo-16-row AS CHARACTER NO-UNDO.
            ASSIGN c-lbl-inserr-conteudo-do-campo-16-row = c-lbl-liter-conteudo-do-campo-16 + ' ' + rowObject.cod-campo + '~~~~' + ' ' + c-lbl-liter-bbm-10 + '.' + '~~~~' + c-lbl-liter-pela-bbm-maximo-50-caracteres-8.
            {method/svc/errors/inserr.i
                    &ErrorNumber="32702"
                    &ErrorType="EMS":U
                    &ErrorSubType="Error":U
                    &ErrorParameters = "c-lbl-inserr-conteudo-do-campo-16-row"}
        END.
        ELSE IF rowObject.cod-campo = "BBM-REGRA-DESEM" AND 
                rowObject.dsl-conteudo <> "Sim" THEN DO:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-conteudo-do-campo-17 AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Conte£do_do_campo" *}
            ASSIGN c-lbl-liter-conteudo-do-campo-17 = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-liter-a-regra-bbm-7 AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "a_regra_BBM" *}
            ASSIGN c-lbl-liter-a-regra-bbm-7 = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-liter-ser-sim AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "ser_""""sim""""" *}
            ASSIGN c-lbl-liter-ser-sim = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-inserr-conteudo-do-campo-17-row AS CHARACTER NO-UNDO.
            ASSIGN c-lbl-inserr-conteudo-do-campo-17-row = c-lbl-liter-conteudo-do-campo-17 + ' ' + rowObject.cod-campo + '~~~~' + ' ' + c-lbl-liter-a-regra-bbm-7 + '.' + '~~~~' + c-lbl-liter-ser-sim + ' '.
            {method/svc/errors/inserr.i
                &ErrorNumber="32823"
                &ErrorType="EMS":U
                &ErrorSubType="Error":U
                &ErrorParameters = "c-lbl-inserr-conteudo-do-campo-17-row"}
        END.
        ELSE IF rowObject.cod-campo = "BBM-ANEXO-TIPO"         AND 
               (rowObject.dsl-conteudo <> "application/msword" AND
                rowObject.dsl-conteudo <> "application/pdf"    AND
                rowObject.dsl-conteudo <> "application/x-zip-compressed") THEN DO:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-conteudo-do-campo-18 AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Conte£do_do_campo" *}
            ASSIGN c-lbl-liter-conteudo-do-campo-18 = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-liter-a-regra-bbm-8 AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "a_regra_BBM" *}
            ASSIGN c-lbl-liter-a-regra-bbm-8 = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-liter-ser-applicationmsword-applicat AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "ser_""""application/msword"""",_""""application/pdf""""_ou_""""application/x-zip-compressed""""" *}
            ASSIGN c-lbl-liter-ser-applicationmsword-applicat = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-inserr-conteudo-do-campo-18-row AS CHARACTER NO-UNDO.
            ASSIGN c-lbl-inserr-conteudo-do-campo-18-row = c-lbl-liter-conteudo-do-campo-18 + ' ' + rowObject.cod-campo + '~~~~' + ' ' + c-lbl-liter-a-regra-bbm-8 + '.' + '~~~~' + c-lbl-liter-ser-applicationmsword-applicat.
            {method/svc/errors/inserr.i
                    &ErrorNumber="32853"
                    &ErrorType="EMS":U
                    &ErrorSubType="Error":U
                    &ErrorParameters = "c-lbl-inserr-conteudo-do-campo-18-row"}
        END.
        ELSE IF rowObject.cod-campo = "BBM-ANEXO-TIPO"  AND
                LENGTH(rowObject.dsl-conteudo) > 50 THEN DO:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-conteudo-do-campo-19 AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Conte£do_do_campo" *}
            ASSIGN c-lbl-liter-conteudo-do-campo-19 = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-liter-bbm-11 AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "BBM" *}
            ASSIGN c-lbl-liter-bbm-11 = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-liter-pela-bbm-maximo-50-caracteres-9 AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "pela_BBM_maximo_50_caracteres" *}
            ASSIGN c-lbl-liter-pela-bbm-maximo-50-caracteres-9 = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-inserr-conteudo-do-campo-19-row AS CHARACTER NO-UNDO.
            ASSIGN c-lbl-inserr-conteudo-do-campo-19-row = c-lbl-liter-conteudo-do-campo-19 + ' ' + rowObject.cod-campo + '~~~~' + ' ' + c-lbl-liter-bbm-11 + '.' + '~~~~' + c-lbl-liter-pela-bbm-maximo-50-caracteres-9.
            {method/svc/errors/inserr.i
                    &ErrorNumber="32702"
                    &ErrorType="EMS":U
                    &ErrorSubType="Error":U
                    &ErrorParameters = "c-lbl-inserr-conteudo-do-campo-19-row"}
        END.
        ELSE IF rowObject.cod-campo = "BBM-ANEXO-ARQ" AND
                rowObject.dsl-conteudo <> "" THEN DO:
            IF SEARCH(rowObject.dsl-conteudo) = ? THEN DO:
                {method/svc/errors/inserr.i
                       &ErrorNumber="27066"
                       &ErrorType="EMS":U
                       &ErrorSubType="Error":U}
            END.
        END.
        ELSE IF rowObject.cod-campo = "BBM-ICMS-INVEST" AND
               (rowObject.dsl-conteudo <> "-1" AND
                rowObject.dsl-conteudo <> "0"  AND
                rowObject.dsl-conteudo <> "1") THEN DO:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-conteudo-do-campo-20 AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Conte£do_do_campo" *}
            ASSIGN c-lbl-liter-conteudo-do-campo-20 = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-liter-a-regra-bbm-9 AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "a_regra_BBM" *}
            ASSIGN c-lbl-liter-a-regra-bbm-9 = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-liter-ser-1-0-ou-1 AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "ser_-1,_0_ou_1" *}
            ASSIGN c-lbl-liter-ser-1-0-ou-1 = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-inserr-conteudo-do-campo-20-row AS CHARACTER NO-UNDO.
            ASSIGN c-lbl-inserr-conteudo-do-campo-20-row = c-lbl-liter-conteudo-do-campo-20 + ' ' + rowObject.cod-campo + '~~~~' + ' ' + c-lbl-liter-a-regra-bbm-9 + '.' + '~~~~' + c-lbl-liter-ser-1-0-ou-1.
            {method/svc/errors/inserr.i
                    &ErrorNumber="32853"
                    &ErrorType="EMS":U
                    &ErrorSubType="Error":U
                    &ErrorParameters = "c-lbl-inserr-conteudo-do-campo-20-row"}
        END.
        ELSE IF rowObject.cod-campo = "BBM-ICMS-DEST" THEN DO: 
            IF DEC(rowObject.dsl-conteudo) > 100 THEN DO:
                {method/svc/errors/inserr.i
                        &ErrorNumber="5638"
                        &ErrorType="EMS":U
                        &ErrorSubType="Error":U}
            END.                        
            IF DEC(rowObject.dsl-conteudo) < 0 THEN DO:
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-conteudo-do-campo-21 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Conte£do_do_campo" *}
                ASSIGN c-lbl-liter-conteudo-do-campo-21 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-inserr-conteudo-do-campo-21-row AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-inserr-conteudo-do-campo-21-row = c-lbl-liter-conteudo-do-campo-21 + ' ' + rowObject.cod-campo + '~~~~' + '0'.
                {method/svc/errors/inserr.i
                        &ErrorNumber="416"
                        &ErrorType="EMS":U
                        &ErrorSubType="Error":U
                        &ErrorParameters = "c-lbl-inserr-conteudo-do-campo-21-row"}
            END.
            ASSIGN rowObject.dsl-conteudo = STRING(DEC(rowObject.dsl-conteudo)).
        END.
