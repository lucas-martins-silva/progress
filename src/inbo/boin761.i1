                    ASSIGN c-lbl-liter-ser-p-referente-a-preco-ou-d-r = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-inserr-conteudo-do-campo-6-rowo AS CHARACTER NO-UNDO.
