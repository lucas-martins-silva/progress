        
        /*guarda valores de datas e horas iniciais para validar as finais*/
        FIND FIRST {1} NO-LOCK
             WHERE {1}.cdn-tip-lote-pregao = pi-cod-tipo-lote    
               AND {1}.cod-campo           = "BBM-DT-AMOS-INI" NO-ERROR.
        IF AVAIL {1} THEN
            ASSIGN dt-amos-ini = date({1}.dsl-conteudo).

        FIND FIRST {1} NO-LOCK
             WHERE {1}.cdn-tip-lote-pregao = pi-cod-tipo-lote    
               AND {1}.cod-campo           = "BBM-HR-AMOS-INI" NO-ERROR.
        IF AVAIL {1} THEN
            ASSIGN hr-amos-ini = {1}.dsl-conteudo.
        
        FIND FIRST {1} NO-LOCK
             WHERE {1}.cdn-tip-lote-pregao = pi-cod-tipo-lote    
               AND {1}.cod-campo           = "BBM-DT-CAD-INI" NO-ERROR.
        IF AVAIL {1} THEN
            ASSIGN dt-cad-ini = date({1}.dsl-conteudo).
        
        FIND FIRST {1} NO-LOCK
             WHERE {1}.cdn-tip-lote-pregao = pi-cod-tipo-lote    
               AND {1}.cod-campo           = "BBM-HR-CAD-INI" NO-ERROR.
        IF AVAIL {1} THEN
            ASSIGN hr-cad-ini = {1}.dsl-conteudo.

        FIND FIRST {1} NO-LOCK
             WHERE {1}.cdn-tip-lote-pregao = pi-cod-tipo-lote    
               AND {1}.cod-campo           = "BBM-DT-ABER-INI" NO-ERROR.
        IF AVAIL {1} THEN
            ASSIGN dt-aber-ini = date({1}.dsl-conteudo).

        FIND FIRST {1} NO-LOCK
             WHERE {1}.cdn-tip-lote-pregao = pi-cod-tipo-lote    
               AND {1}.cod-campo           = "BBM-HR-ABER-INI" NO-ERROR.
        IF AVAIL {1} THEN
            ASSIGN hr-aber-ini = {1}.dsl-conteudo.
        
        FIND FIRST {1} NO-LOCK
             WHERE {1}.cdn-tip-lote-pregao = pi-cod-tipo-lote    
               AND {1}.cod-campo           = "BBM-DT-PREG-INI" NO-ERROR.
        IF AVAIL {1} THEN
            ASSIGN dt-preg-ini = date({1}.dsl-conteudo).

        FIND FIRST {1} NO-LOCK
             WHERE {1}.cdn-tip-lote-pregao = pi-cod-tipo-lote    
               AND {1}.cod-campo           = "BBM-HR-PREG-INI" NO-ERROR.
        IF AVAIL {1} THEN
            ASSIGN hr-preg-ini = {1}.dsl-conteudo.
            
        FIND FIRST {1} NO-LOCK
             WHERE {1}.cdn-tip-lote-pregao = pi-cod-tipo-lote    
               AND {1}.cod-campo           = "BBM-DT-PREG-INI" NO-ERROR.
        IF AVAIL {1} THEN
            ASSIGN dt-preg-ini = DATE({1}.dsl-conteudo).

        /*valida‡Æo do campo enviado*/
        IF rowObject.cod-campo = "BBM-REGULAMENTO" AND
           rowObject.dsl-conteudo <> "Privado" THEN DO:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-conteudo-do-campo AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Conte£do_do_campo" *}
            ASSIGN c-lbl-liter-conteudo-do-campo = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-liter-a-regra-bbm AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "a_regra_BBM" *}
            ASSIGN c-lbl-liter-a-regra-bbm = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-liter-ser-privado AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "ser_privado" *}
            ASSIGN c-lbl-liter-ser-privado = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-inserr-conteudo-do-campo-rowobj AS CHARACTER NO-UNDO.
            ASSIGN c-lbl-inserr-conteudo-do-campo-rowobj = c-lbl-liter-conteudo-do-campo + ' ' + rowObject.cod-campo + '~~~~' + ' ' + c-lbl-liter-a-regra-bbm + '.' + '~~~~' + c-lbl-liter-ser-privado.
            {method/svc/errors/inserr.i
                &ErrorNumber="32823"
                &ErrorType="EMS":U
                &ErrorSubType="Error":U
                &ErrorParameters = "c-lbl-inserr-conteudo-do-campo-rowobj"}
        END.
        ELSE IF rowObject.cod-campo = "BBM-USA-REGRA-10" AND 
                rowObject.dsl-conteudo = "Sim" THEN DO:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-conteudo-do-campo-2 AS CHARACTER NO-UNDO.
