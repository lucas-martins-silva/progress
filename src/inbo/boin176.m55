
PROCEDURE getFatAntecipEntFutura :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    def input  param  pc-nat-operacao        as char no-undo.
    def output param  pl-fatura-fat-antecip  as log  no-undo.
    def output param  pl-remessa-fat-antecip as log  no-undo.
    def output param  pl-fatura-ent-futura   as log  no-undo.
    def output param  pl-remessa-ent-futura  as log  no-undo.
    def buffer b-natur-oper for natur-oper.
    
    find b-natur-oper where
         b-natur-oper.nat-operacao = pc-nat-operacao no-lock no-error.
         
    if  not avail b-natur-oper then
        return "NOK":U.

   /*--- include que contem a logica para identificar se a natureza do docum-est eh fatura faturamento 
         antecipado, remessa faturamento antecipado, fatura ent futura ou remessa ent futura ---*/
    {cdp/cd9700.i1 b-natur-oper}                         

    assign pl-fatura-fat-antecip  = l-fatura-fat-antecip
           pl-remessa-fat-antecip = l-remessa-fat-antecip
           pl-fatura-ent-futura   = l-fatura-ent-futura
           pl-remessa-ent-futura  = l-remessa-ent-futura.
                                                        
    RETURN "OK":U.                                

END PROCEDURE.





