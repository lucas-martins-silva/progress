def temp-table ttReservas no-undo
    field nr-ord-produ as int
    field item-pai     as char
    field cod-roteiro  as char
    field op-codigo    as int
    field it-codigo    as char
    field quant-orig   as dec
    field quant-aloc   as dec
    field quant-atend  as dec
    field quant-falta  as dec
    field dt-reserva   as date
    field tipo-con-est as int
    field modifica     as log
    field rowid        as rowid
&IF DEFINED (bf_man_per_ppm) &THEN
    field per-ppm      as dec
    field tipo-formula as int
    field qt-aloc-lote as dec
    field veiculo      as log
&ENDIF
&IF DEFINED (bf_man_sfc_lc) &THEN
    field cod-refer    as char
    field desc-item    as char
    index id is primary unique nr-ord-produ item-pai cod-roteiro
                               op-codigo it-codigo cod-refer
&ELSE
    index id is primary unique nr-ord-produ item-pai cod-roteiro
                               op-codigo it-codigo
&ENDIF
    index mod modifica.

def temp-table ttSaldoEstoq no-undo
    field cod-estabel      as char
    field cod-depos        as char
    field cod-localiz      as char
    field lote             as char
    field it-codigo        as char
    field cod-refer        as char
    field qt-aloc-prod     as dec
    field qtidade-atu      as dec
    field saldo-disp       as dec
    field dt-vali-lote     as date
    field modifica         as log
    field rowid            as rowid
&IF DEFINED (bf_man_per_ppm) &THEN
    field per-ppm          as dec
    field qt-aloc-prod-fis as dec
    field qtidade-atu-fis  as dec
    field saldo-disp-fis   as dec
&ENDIF
    index id is unique cod-estabel cod-depos cod-localiz
                       lote it-codigo cod-refer
    index codigo is primary it-codigo cod-refer 
    index mod modifica.
