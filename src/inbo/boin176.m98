PROCEDURE pi-gravar-dados-cfg-trib :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input param p-c-cod-serie   like docum-est.serie-docto      no-undo.
    def input param p-c-embarque    like docum-est.embarque         no-undo.
    
    find first tb-wt-docto no-lock
         where tb-wt-docto.seq-wt-docto = 1 no-error.
         
    FOR EACH tb-wt-it-docto NO-LOCK:
        /**************************************************
        ** eliminar tributos do item do documento
        **************************************************/
        FOR EACH ct-trib-item-doc-est EXCLUSIVE-LOCK
            WHERE ct-trib-item-doc-est.cdn-emitente      = tb-wt-docto.cod-emitente
              AND ct-trib-item-doc-est.cod-ser-docto     = p-c-cod-serie
              AND ct-trib-item-doc-est.cod-docto         = tb-wt-docto.nr-nota      
              AND ct-trib-item-doc-est.cod-natur-operac  = tb-wt-docto.nat-operacao
              AND ct-trib-item-doc-est.num-seq           = tb-wt-it-docto.seq-wt-it-docto: 
              DELETE ct-trib-item-doc-est.
        END.
    
        FOR EACH tb-ct-trib-wt-item-docto NO-LOCK 
            WHERE tb-ct-trib-wt-item-docto.num-seq-wt-docto      = tb-wt-it-docto.seq-wt-docto
              AND tb-ct-trib-wt-item-docto.num-seq-wt-item-docto = tb-wt-it-docto.seq-wt-it-docto:
              
            /**************************************************
            ** gravar tributos do item do documento
            **************************************************/
            FOR FIRST ct-trib-item-doc-est EXCLUSIVE-LOCK
                WHERE ct-trib-item-doc-est.cdn-emitente      = tb-wt-docto.cod-emitente
                  AND ct-trib-item-doc-est.cod-ser-docto     = p-c-cod-serie
                  AND ct-trib-item-doc-est.cod-docto         = tb-wt-docto.nr-nota
                  AND ct-trib-item-doc-est.cod-natur-operac  = tb-wt-docto.nat-operacao
                  AND ct-trib-item-doc-est.num-seq           = tb-wt-it-docto.seq-wt-it-docto
                  AND ct-trib-item-doc-est.cod-item          = tb-wt-it-docto.it-codigo
                  AND ct-trib-item-doc-est.cod-tip-trib      = tb-ct-trib-wt-item-docto.cod-tip-trib
                  AND ct-trib-item-doc-est.cod-configur-trib = tb-ct-trib-wt-item-docto.cod-configur-trib:
            END.
            
            IF NOT AVAIL ct-trib-item-doc-est THEN DO:

                CREATE ct-trib-item-doc-est.
                ASSIGN ct-trib-item-doc-est.cdn-emitente              = tb-wt-docto.cod-emitente   
                       ct-trib-item-doc-est.cod-ser-docto             = p-c-cod-serie              
                       ct-trib-item-doc-est.cod-docto                 = tb-wt-docto.nr-nota        
                       ct-trib-item-doc-est.cod-natur-operac          = tb-wt-docto.nat-operacao   
                       ct-trib-item-doc-est.num-seq                   = tb-wt-it-docto.seq-wt-it-docto
                       ct-trib-item-doc-est.cod-item                  = tb-wt-it-docto.it-codigo
                       ct-trib-item-doc-est.num-ct-trib               = tb-ct-trib-wt-item-docto.num-seq
                       ct-trib-item-doc-est.cod-tip-trib              = tb-ct-trib-wt-item-docto.cod-tip-trib
                       ct-trib-item-doc-est.cod-configur-trib         = tb-ct-trib-wt-item-docto.cod-configur-trib
                       ct-trib-item-doc-est.cod-estab                 = tb-wt-docto.cod-estabel
                       ct-trib-item-doc-est.cod-embarq                = p-c-embarque
                       ct-trib-item-doc-est.num-ordem                 = tb-wt-it-docto.numero-ordem
                       ct-trib-item-doc-est.num-parcela               = tb-wt-it-docto.parcela
                       OVERLAY(ct-trib-item-doc-est.cod-livre-1,1,6)  = tb-wt-it-docto.nat-operacao. 
            END.
                                                                  
            ASSIGN ct-trib-item-doc-est.cod-chave-cenar           = tb-ct-trib-wt-item-docto.cod-chave-cenar
                   ct-trib-item-doc-est.idi-cod-tributac          = tb-ct-trib-wt-item-docto.idi-cod-tributac
                   ct-trib-item-doc-est.val-aliq                  = tb-ct-trib-wt-item-docto.val-aliq
                   ct-trib-item-doc-est.val-base                  = tb-ct-trib-wt-item-docto.val-base-calc
                   ct-trib-item-doc-est.val-trib                  = tb-ct-trib-wt-item-docto.val-trib
                   ct-trib-item-doc-est.val-perc-reduc            = tb-ct-trib-wt-item-docto.val-perc-reduc
                   ct-trib-item-doc-est.val-fix-trib              = tb-ct-trib-wt-item-docto.val-fix-trib
                   ct-trib-item-doc-est.val-quant-fix             = tb-ct-trib-wt-item-docto.val-quant-fix
                   ct-trib-item-doc-est.cod-sit-tributar          = tb-ct-trib-wt-item-docto.cod-sit-tributar
                   ct-trib-item-doc-est.cdn-msg-faturam           = tb-ct-trib-wt-item-docto.num-livre-2  /*cod mensag p/ observ nota MFT*/
                   ct-trib-item-doc-est.cdn-msg-of                = tb-ct-trib-wt-item-docto.num-livre-3. /*cod mensag p/ observ nota MOF*/
                                                                  
            ASSIGN ct-trib-item-doc-est.cod-memo-calc-base        = tb-ct-trib-wt-item-docto.cod-memo-calc-base
                   ct-trib-item-doc-est.cod-memo-calc-trib        = tb-ct-trib-wt-item-docto.cod-memo-calc-trib
                   ct-trib-item-doc-est.dat-ult-atualiz           = TODAY
                   ct-trib-item-doc-est.hra-ult-atualiz           = STRING(TIME,"HH:MM:SS":U)
                   ct-trib-item-doc-est.cod-usuar-ult-atualiz     = c-seg-usuario.
            
            FOR FIRST ct-configur-trib NO-LOCK
                WHERE ct-configur-trib.cod-configur-trib = tb-ct-trib-wt-item-docto.cod-configur-trib:
                ASSIGN ct-trib-item-doc-est.cod-formul-base-calc  = ct-configur-trib.cod-formul-base-calc
                       ct-trib-item-doc-est.cod-formul-trib       = ct-configur-trib.cod-formul-trib.
            END.
        END. /*FOR EACH tb-ct-trib-wt-item-docto*/   
    END. /*FOR EACH tb-wt-it-docto*/

END PROCEDURE.
