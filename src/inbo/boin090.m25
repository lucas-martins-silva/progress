PROCEDURE validateValues :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes: Criaá∆o/Eliminaá∆o do Consist-Nota.  
------------------------------------------------------------------------------*/

    def var de-tot-valor      like docum-est.tot-valor  no-undo.
    def var l-elimina-boin060   as logical              no-undo.
    def var l-elimina-boin176   as logical              no-undo.
    def var vl-bicms-compl      as decimal              no-undo. 
    
    if  not valid-handle(h_boin060) then do:
        run inbo/boin060.p persistent set h_boin060.
        assign l-elimina-boin060 = yes.
    end.
    
    if  not valid-handle(h_boin176) then do:
        run inbo/boin176.p persistent set h_boin176.
        assign l-elimina-boin176 = yes.
    end.
    
    run findUsuario ( RowObject.usuario ).
    

    if  return-value = "NOK":U then
        return "NOK":U.
    

    find first tt-total-item no-lock no-error.
        

    if  not avail tt-total-item then do:
        run calculateTotalItem in h_boin176 ( input RowObject.cod-emitente,
                                              input RowObject.serie-docto,
                                              input RowObject.nro-docto,
                                              input RowObject.nat-operacao,
                                              output table tt-total-item ).
        find first tt-total-item no-lock no-error.
    end.

    if  avail tt-total-item then do:     

        run calculateTotalNota ( output de-tot-valor ).

        IF  l-transf
        AND CAN-FIND(FIRST doc-orig-nfe 
                     WHERE doc-orig-nfe.ch-acesso-comp-nfe = docum-est.cod-chave-aces-nf-eletro
                       AND doc-orig-nfe.idi-orig-trad      = 2
                       AND doc-orig-nfe.idi-situacao       = 3) /* Atualizada Recebimento Fiscal */ THEN
            ASSIGN tt-total-item.tot-peso = RowObject.tot-peso.

        /* Diferenca no Peso Total */
        if  i-pais-impto-usuario = 1 then do:

            run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                                 RowObject.serie-docto,
                                                 RowObject.nro-docto,
                                                 RowObject.nat-operacao,
                                                 0,   
                                                 RowObject.tot-peso = tt-total-item.tot-peso, /*ser for igual elimina sen∆o cria*/
                                                 tt-total-item.tot-peso,
                                                 RowObject.tot-peso,
                                                 5501,
                                                 1).
        end.

        /* Diferenca no Desconto Total */
        run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                             RowObject.serie-docto,
                                             RowObject.nro-docto,
                                             RowObject.nat-operacao,
                                             0,   
                                             RowObject.tot-desconto = tt-total-item.tot-desconto, /*ser for igual elimina sen∆o cria*/
                                             tt-total-item.tot-desconto,
                                             RowObject.tot-desconto,
                                             5511,
                                             1).

        /* Diferenca no Despesa Total */
        run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                             RowObject.serie-docto,
                                             RowObject.nro-docto,
                                             RowObject.nat-operacao,
                                             0,   
                                             RowObject.despesa-nota = tt-total-item.despesa-nota, /*ser for igual elimina sen∆o cria*/
                                             tt-total-item.despesa-nota,
                                             RowObject.despesa-nota,
                                             5500,
                                             1).

        /* Diferenca no Valor da Mercadoria */
        run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                             RowObject.serie-docto,
                                             RowObject.nro-docto,
                                             RowObject.nat-operacao,
                                             0,   
                                             RowObject.valor-mercad = tt-total-item.valor-mercad, /*ser for igual elimina sen∆o cria*/
                                             tt-total-item.valor-mercad,
                                             RowObject.valor-mercad,
                                             5502,
                                             1).

        /* Diferenca no Total da Nota */
        run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                             RowObject.serie-docto,
                                             RowObject.nro-docto,
                                             RowObject.nat-operacao,
                                             0,   
                                             RowObject.tot-valor = de-tot-valor, /*ser for igual elimina sen∆o cria*/
                                             de-tot-valor,
                                             RowObject.tot-valor,
                                             5962,
                                             1).
        if not RowObject.log-1 then do:
                /* Diferenca na Base do IPI */
                run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                                     RowObject.serie-docto,
                                                     RowObject.nro-docto,
                                                     RowObject.nat-operacao,
                                                     0,   
                                                     RowObject.base-ipi = tt-total-item.base-ipi, /*ser for igual elimina sen∆o cria*/
                                                     tt-total-item.base-ipi,
                                                     RowObject.base-ipi,
                                                     6414,
                                                     ( if abs(RowObject.base-ipi - tt-total-item.base-ipi) > param-re.dec-1 /* diferenáa maior que par¸metro */
                                                       then 1                                                            /* ent∆o erro sen∆o advert∆ncia */    
                                                       else 2 ) ).
        
                /* Diferenca no Valor do IPI */
                run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                                     RowObject.serie-docto,
                                                     RowObject.nro-docto,
                                                     RowObject.nat-operacao,
                                                     0,   
                                                     RowObject.ipi-deb-cre = tt-total-item.valor-ipi, /*ser for igual elimina sen∆o cria*/
                                                     tt-total-item.valor-ipi,
                                                     RowObject.ipi-deb-cre,
                                                     6416,
                                                     ( if abs(RowObject.ipi-deb-cre - tt-total-item.valor-ipi) > param-re.dec-1 /* diferenáa maior que par¸metro */
                                                       then 1                                                                /* ent∆o erro sen∆o advert∆ncia */    
                                                       else 2 ) ).
        
                /* Diferenca na Base do ICM */
                run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                                     RowObject.serie-docto,
                                                     RowObject.nro-docto,
                                                     RowObject.nat-operacao,
                                                     0,   
                                                     RowObject.base-icm = tt-total-item.base-icm, /*ser for igual elimina sen∆o cria*/       
                                                     tt-total-item.base-icm,
                                                     RowObject.base-icm,
                                                     5508,
                                                     ( if abs(RowObject.base-icm - tt-total-item.base-icm) > param-re.dec-1 /* diferenáa maior que par¸metro */
                                                       then 1                                                            /* ent∆o erro sen∆o advert∆ncia */    
                                                       else 2 ) ).
        
                /* Diferenca no Valor do ICM */
                run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                                     RowObject.serie-docto,
                                                     RowObject.nro-docto,
                                                     RowObject.nat-operacao,
                                                     0,   
                                                     RowObject.icm-deb-cre = tt-total-item.valor-icm, /*ser for igual elimina sen∆o cria*/
                                                     tt-total-item.valor-icm,
                                                     RowObject.icm-deb-cre,
                                                     5509,
                                                     ( if abs(RowObject.icm-deb-cre - tt-total-item.valor-icm) > param-re.dec-1 /* diferenáa maior que par¸metro */
                                                       then 1                                                                /* ent∆o erro sen∆o advert∆ncia */    
                                                       else 2 ) ).
        
                /* Diferenca na Base do ISS */
                run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                                     RowObject.serie-docto,
                                                     RowObject.nro-docto,
                                                     RowObject.nat-operacao,
                                                     0,   
                                                     RowObject.base-iss = tt-total-item.base-iss, /*ser for igual elimina sen∆o cria*/
                                                     tt-total-item.base-iss,
                                                     RowObject.base-iss,
                                                     5504,
                                                     ( if abs(RowObject.base-iss - tt-total-item.base-iss) > param-re.dec-1 /* diferenáa maior que par¸metro */
                                                       then 1                                                            /* ent∆o erro sen∆o advert∆ncia */    
                                                       else 2 ) ).
        
                /* Diferenca no Valor do ISS */
                run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                                     RowObject.serie-docto,
                                                     RowObject.nro-docto,
                                                     RowObject.nat-operacao,
                                                     0,   
                                                     RowObject.iss-deb-cre = tt-total-item.valor-iss, /*ser for igual elimina sen∆o cria*/
                                                     tt-total-item.valor-iss,
                                                     RowObject.iss-deb-cre,
                                                     5505,
                                                     ( if abs(RowObject.iss-deb-cre - tt-total-item.valor-iss) > param-re.dec-1 /* diferenáa maior que par¸metro */
                                                       then 1                                                                /* ent∆o erro sen∆o advert∆ncia */    
                                                       else 2 ) ).
        
                /* Diferenca na Base da Substituiá∆o Tribut†ria */
                run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                                     RowObject.serie-docto,
                                                     RowObject.nro-docto,
                                                     RowObject.nat-operacao,
                                                     0,   
                                                     RowObject.base-subs = tt-total-item.base-subs, /*ser for igual elimina sen∆o cria*/
                                                     tt-total-item.base-subs,
                                                     RowObject.base-subs,
                                                     5515,
                                                     ( if abs(RowObject.base-subs - tt-total-item.base-subs) > param-re.dec-1 /* diferenáa maior que par¸metro */
                                                       then 1                                                              /* ent∆o erro sen∆o advert∆ncia */    
                                                       else 2 ) ).
        
                /* Diferenca no Valor da Substituiá∆o Tribut†ria */
                run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                                     RowObject.serie-docto,
                                                     RowObject.nro-docto,
                                                     RowObject.nat-operacao,
                                                     0,   
                                                     RowObject.vl-subs = tt-total-item.valor-subs, /*ser for igual elimina sen∆o cria*/
                                                     tt-total-item.valor-subs,
                                                     RowObject.vl-subs,
                                                     5516,
                                                     ( if abs(RowObject.vl-subs - tt-total-item.valor-subs) > param-re.dec-1 /* diferenáa maior que par¸metro */
                                                       then 1                                                             /* ent∆o erro sen∆o advert∆ncia */    
                                                       else 2 ) ).
                                                       
                /* Diferenca no Valor da Base do ICMS Complementar */
                assign vl-bicms-compl = decimal(trim(substring(RowObject.char-2,191,20))). 
                run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                                     RowObject.serie-docto,
                                                     RowObject.nro-docto,
                                                     RowObject.nat-operacao,
                                                     0,   
                                                     vl-bicms-compl = tt-total-item.base-icm-complem, /*ser for igual elimina sen∆o cria*/
                                                     tt-total-item.base-icm-complem,
                                                     vl-bicms-compl,
                                                     54695,
                                                     ( if abs(vl-bicms-compl - tt-total-item.base-icm-complem) > param-re.dec-1 /* diferenáa maior que par¸metro */
                                                       then 1                                                                  /* ent∆o erro sen∆o advert∆ncia */    
                                                       else 2 ) ).
        
                /* Diferenca no Valor do ICMS Complementar */
                run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                                     RowObject.serie-docto,
                                                     RowObject.nro-docto,
                                                     RowObject.nat-operacao,
                                                     0,   
                                                     RowObject.icm-complem = tt-total-item.icm-complem, /*ser for igual elimina sen∆o cria*/
                                                     tt-total-item.icm-complem,
                                                     RowObject.icm-complem,
                                                     5499,
                                                     ( if abs(RowObject.icm-complem - tt-total-item.icm-complem) > param-re.dec-1 /* diferenáa maior que par¸metro */
                                                       then 1                                                                  /* ent∆o erro sen∆o advert∆ncia */    
                                                       else 2 ) ).
        
                /* Diferenca no Valor do Pis Substituto */
                run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                                     RowObject.serie-docto,
                                                     RowObject.nro-docto,
                                                     RowObject.nat-operacao,
                                                     0,   
                                                     RowObject.vl-pis-subs = tt-total-item.total-pis-subst, /*ser for igual elimina sen∆o cria*/
                                                     tt-total-item.total-pis-subst,
                                                     RowObject.vl-pis-subs,
                                                     32409,
                                                     ( if abs(RowObject.vl-pis-subs - tt-total-item.total-pis-subst) > param-re.dec-1 /* diferenáa maior que par¸metro */
                                                       then 1                                                                         /* ent∆o erro sen∆o advert∆ncia */    
                                                       else 2 ) ).
                                                       
                /* Diferenca no Valor do Confins Substituto */
                run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                                     RowObject.serie-docto,
                                                     RowObject.nro-docto,
                                                     RowObject.nat-operacao,
                                                     0,   
                                                     RowObject.vl-cofins-subs = tt-total-item.total-cofins-subs, /*ser for igual elimina sen∆o cria*/
                                                     tt-total-item.total-cofins-subs,
                                                     RowObject.vl-cofins-subs,
                                                     32410,
                                                     ( if abs(RowObject.vl-cofins-subs - tt-total-item.total-cofins-subs) > param-re.dec-1 /* diferenáa maior que par¸metro */
                                                       then 1                                                                              /* ent∆o erro sen∆o advert∆ncia */    
                                                       else 2 ) ).
        end.
        
        delete tt-total-item.
    end.

    FIND docum-est WHERE
                  docum-est.serie-docto  = rowObject.serie-docto  AND
                  docum-est.nro-docto    = rowObject.nro-docto    AND
                  docum-est.cod-emitente = rowObject.cod-emitente AND
                  docum-est.nat-operacao = rowObject.nat-operacao NO-LOCK NO-ERROR.
                    
     IF AVAIL docum-est and
              docum-est.log-1 /*NF atualizada no Faturamento*/ then do:

        run updateConsistNota in h_boin060 ( RowObject.cod-emitente,
                                             RowObject.serie-docto,
                                             RowObject.nro-docto,
                                             RowObject.nat-operacao,
                                             0,   
                                             no,
                                             0,
                                             0,
                                             30845,
                                             2).
                                             
    end.

    if  l-elimina-boin060 then do:
        run destroy in h_boin060.
        assign l-elimina-boin060 = no
               h_boin060 = ?.
    end.
    
    if  l-elimina-boin176 then do:
        run destroy in h_boin176.
        assign l-elimina-boin176 = no
               h_boin176 = ?.
    end.
     

    return "OK":U.
    

END PROCEDURE.




