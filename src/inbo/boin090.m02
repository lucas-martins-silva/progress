PROCEDURE retornaCCAtualiza :
/*------------------------------------------------------------------------------
  Purpose: Posiciona a tabela item-doc-est ou rad-ordem atrav‚s dos campos chave
           da tabela docum-est. Retorna YES/NO para o campo CC Atualizado.     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

def input  param pc-nro-docto    as char no-undo.
def input  param pi-cod-emitente as int  no-undo.
def input  param pc-serie-docto  as char no-undo.
def input  param pc-nat-operacao as char no-undo.
def output param pl-cc-atualiza  as log  no-undo.

  assign c-serie-docto  = pc-serie-docto
         i-cod-emitente = pi-cod-emitente
         c-nro-docto    = pc-nro-docto
         c-nat-operacao = pc-nat-operacao.

  find first item-doc-est 
       where item-doc-est.serie-docto  = c-serie-docto
         and item-doc-est.nro-docto    = c-nro-docto
         and item-doc-est.cod-emitente = i-cod-emitente 
         and item-doc-est.nat-operacao = c-nat-operacao 
         and item-doc-est.num-pedido   > 0 no-lock no-error.

  if  not avail item-doc-est then
      find first rat-ordem       
           where rat-ordem.serie-docto  = pc-serie-docto
             and rat-ordem.nro-docto    = pc-nro-docto
             and rat-ordem.cod-emitente = pi-cod-emitente 
             and rat-ordem.nat-operacao = pc-nat-operacao no-lock no-error.

  assign pl-cc-atualiza = avail item-doc-est or avail rat-ordem.      
  

  END PROCEDURE.




PROCEDURE retornaDocumentoImportado :
/*------------------------------------------------------------------------------
  Purpose: Caso docum-est.orgiem = "I" retorna Yes para o campo Documento importado
           SenÆo retorna no.     
  Parameters: ipar1 : pc-origem    : recebe o valor corrente do campo docum-est.origem
              opar2 : pl-docum0imp : retorna o valor para o campo documento importado. 
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE INPUT  PARAM  pc-origem    AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAM  pl-docum-imp AS LOGICAL   NO-UNDO.

    IF pc-origem = "I" then
       assign pl-docum-imp = yes.
    else
       assign pl-docum-imp = no.   


END PROCEDURE.




PROCEDURE returnFormatParamGlobal :
/*------------------------------------------------------------------------------
  Parameters: c-campo   - recebe o nome do campo com o formato desejado.
              c-formato - retorna o formato do campo recebido como parümetro.
  Notes: Retorna o formato parametrizado nos parametros globais (cd0101), do 
         campo recebido como parametro.       
------------------------------------------------------------------------------*/
    def input  param c-campo   as char no-undo.
    def output param c-formato as char no-undo.
    

    find first param-global no-lock no-error.
    

    if  not avail param-global then
        return "NOK":U.

    case c-campo:
         when "formato-cep":U then 
              assign c-formato = param-global.formato-cep.
         when "formato-id-estadual":U then
              assign c-formato = param-global.formato-id-estadual.         
         when "formato-id-federal":U then
              assign c-formato = param-global.formato-id-federal.         
         when "formato-id-pessoal":U then
              assign c-formato = param-global.formato-id-pessoal.         
         when "formato-nr-nota":U then
              assign c-formato = param-global.formato-nr-nota.
         otherwise return "NOK":U.
    end case.
 

    return "OK":U.

END PROCEDURE.




PROCEDURE returnPessoaEmitente :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input  param piCodEmitente   like docum-est.cod-emitente no-undo.
    def output param piPessoa        like emitente.natureza      no-undo.
    run findEmitente ( input piCodEmitente).
    

    if  return-value <> "OK":U then
        return "NOK":U.  
   

    assign piPessoa = emitente.natureza.
    

    return "OK":U.
    

END PROCEDURE.




