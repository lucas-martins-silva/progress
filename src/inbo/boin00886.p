&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE pi-retorna-fornecedores-familia DBOProgram 
PROCEDURE pi-retorna-fornecedores-familia :
/*------------------------------------------------------------------------------
  Purpose:     Retornar os fornecedores das fam°lias de fornecedores do 
                clicbusiness
  Parameters:  tt-familia - c¢digo da fam°lia para fazer filtros
               tt-fornec-clicbusiness - retorno do das informaá‰es dos 
               fornecedores das fam°lias
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER TABLE FOR tt-familia.
    DEFINE OUTPUT PARAMETER TABLE FOR tt-fornec-clicbusiness.

    /*Para cada c¢digo de fam°lia que vier como parÉmetro buscar os fornecedores da fam°lia e retornar suas informaá‰es*/
    FOR EACH tt-familia NO-LOCK:
        FOR EACH fornec-clicbusiness NO-LOCK
            WHERE trim(fornec-clicbusiness.cod-familia) = trim(tt-familia.cod-familia):
            IF NOT CAN-FIND (FIRST tt-fornec-clicbusiness
                             WHERE tt-fornec-clicbusiness.cod-cgc = fornec-clicbusiness.cod-cgc) THEN DO:
                CREATE tt-fornec-clicbusiness.
                ASSIGN tt-fornec-clicbusiness.cod-cgc           = fornec-clicbusiness.cod-cgc            /*CNPJ*/
                       tt-fornec-clicbusiness.nom-razao-social  = fornec-clicbusiness.nom-razao-social   /*Raz∆o Social*/
                       tt-fornec-clicbusiness.des-e-mail        = fornec-clicbusiness.des-e-mail         /*E-mail*/
                       tt-fornec-clicbusiness.cdd-reputacao     = fornec-clicbusiness.cdd-reputacao      /*Reputaá∆o*/
                       tt-fornec-clicbusiness.cod-familia       = trim(fornec-clicbusiness.cod-familia). /*Fam°lia*/
            END.
        END.
    END.

    RETURN "OK":U.
END PROCEDURE.

