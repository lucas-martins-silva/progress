/*****************************************************************************
**
** PROCEDURE: pi-gera-tt-turno
** OBJETIVO:  Geracao de temporaria de turno corrente para ser considerada no 
**            CRP
** PARAMETROS: Entrada: Grupo de maquina, data de referencia
**             Saida:   data inicio de validade para o turno e
**                      data fim de validade para o turno
**
******************************************************************************/

PROCEDURE pi-gera-tt-turno:

    def Input  param p-cod-area        as char format "x(8)" no-undo.
    def Input  param p-cod-grp-maq     as char format "x(9)" no-undo.
    def Input  param p-cod-ctrab       as char format "x(16)" no-undo.
    def Input  param p-dat-refer-valid as date format "99/99/9999" no-undo.
    def output param p-dat-inic-valid  as date format "99/99/9999" no-undo.
    def output param p-dat-fim-valid   as date format "99/99/9999" no-undo.

    def var v-cod-turno  as character  format "x(8)"  no-undo.
    def var v-num-dia    as integer                   no-undo.

    if p-cod-ctrab <> ? then
        run DeterminarModelTurnoCtrab (input  p-cod-area,
                                       input  p-cod-grp-maq,
                                       input  p-cod-ctrab,
                                       input  p-dat-refer-valid,
                                       output p-dat-inic-valid,
                                       output p-dat-fim-valid,
                                       output v-cod-turno).
                                       
    else 
        if p-cod-grp-maq <> ? then
            run DeterminarModelTurnoGrpArea (input p-cod-grp-maq,
                                             input p-dat-refer-valid,
                                             output p-dat-inic-valid,
                                             output p-dat-fim-valid,
                                             output v-cod-turno).
        else
            run DeterminarModelTurnoGrpArea (input p-cod-area,
                                             input p-dat-refer-valid,
                                             output p-dat-inic-valid,
                                             output p-dat-fim-valid,
                                             output v-cod-turno).
       
    /*** Geracao da temporaria do turno ***/
    inicializa-tt:
    for each tt-turno-semana exclusive-lock.
        delete  tt-turno-semana.
    end.

    assign v-qtd-tempo-dispon-dia = 0.
    for each turno-dia
        where turno-dia.cod-model-turno = v-cod-turno no-lock:
        
        if not can-find(first tt-turno-semana no-lock
                        where tt-turno-semana.num-dia-sema       = turno-dia.num-dia
                        and   tt-turno-semana.qtd-segs-fim-turno = round(turno-dia.qtd-hra-fim * 60, 0) * 60) then do:
                 
            create tt-turno-semana.
            assign tt-turno-semana.num-dia-sema                   = turno-dia.num-dia
                   tt-turno-semana.num-turno-produc               = turno-dia.num-turno
                   tt-turno-semana.qtd-tempo-dispon-turno         = (turno-dia.qtd-hra-fim - turno-dia.qtd-hra-inicio - turno-dia.qtd-tempo-interrup) * 3600
                   tt-turno-semana.qtd-segs-inic-turno            = round(turno-dia.qtd-hra-inicio * 60, 0) * 60
                   tt-turno-semana.qtd-segs-fim-turno             = round(turno-dia.qtd-hra-fim    * 60, 0) * 60
                   tt-turno-semana.num-dia-turno                  = turno-dia.int-1
                   v-qtd-tempo-dispon-dia[turno-dia.num-dia]      = v-qtd-tempo-dispon-dia[turno-dia.num-dia] + tt-turno-semana.qtd-tempo-dispon-turno. 
        end.
    end.
    
    /* Cria tt-turno-semana distribu°do, quando n∆o for criado nunhum registro
       no for each de cima, para que o programa n∆o entre em loop. */

    find first tt-turno-semana no-error.
    if  not avail tt-turno-semana then do v-num-dia = 1 to 7:
    
        if not can-find(first tt-turno-semana no-lock
                        where tt-turno-semana.num-dia-sema       = v-num-dia
                        and   tt-turno-semana.qtd-segs-fim-turno = 86400) then do:
            create tt-turno-semana.
            assign tt-turno-semana.num-dia-sema              = v-num-dia
                   tt-turno-semana.num-turno-produc          = 1
                   tt-turno-semana.qtd-tempo-dispon-turno    = 86400
                   tt-turno-semana.qtd-segs-inic-turno       = 0
                   tt-turno-semana.qtd-segs-fim-turno        = 86400
                   v-qtd-tempo-dispon-dia[v-num-dia]         = 86400.
       end.
   end.
      
END PROCEDURE.

