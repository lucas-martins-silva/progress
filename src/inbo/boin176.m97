    def var l-calc-pis-cofins  as log no-undo.
    def var de-aliquota-pis    as dec no-undo.
    def var de-aliquota-cofins as dec no-undo.
    def var i-sequencia        as int no-undo.
    
    ASSIGN l-calc-pis-cofins          = NO
           de-aliquota-pis            = 0
           de-aliquota-cofins         = 0.
           
    RUN recupera-aliquotas IN h-cdapi995 (INPUT "item-doc-est",
                                          INPUT {1}.serie-docto + "/" + 
                                                {1}.nro-docto + "/" + 
                                                STRING({1}.cod-emitente) + "/" + 
                                                {1}.nat-operacao + "/" + 
                                                STRING({1}.sequencia), 
                                          OUTPUT de-aliquota-pis, 
                                          OUTPUT de-aliquota-cofins).

    IF de-aliquota-pis    = 0 THEN ASSIGN de-aliquota-pis    = {1}.val-aliq-pis.
    IF de-aliquota-cofins = 0 THEN ASSIGN de-aliquota-cofins = {1}.val-aliq-cofins.
    
    assign l-utilizaImpostoMonitor = no.                       
    RUN utilizaImpostosMonitorRecFiscal (INPUT  {1}.serie-docto,
                                         INPUT  {1}.nro-docto,
                                         INPUT  {1}.cod-emitente,
                                         INPUT  {1}.nat-operacao,
                                         INPUT  INT(SUBSTRING({1}.char-2,832,5)),
                                         OUTPUT l-utilizaImpostoMonitor).

    EMPTY TEMP-TABLE tt-ext-item-doc-est.
    
    IF NOT VALID-HANDLE(h-boin01017) THEN 
       RUN inbo/boin01017.p PERSISTENT SET h-boin01017.        
       
    {inbo/boin176.m73 "{1}.it-codigo"}       
    
    FOR EACH tb-wt-it-imposto NO-LOCK
       WHERE tb-wt-it-imposto.seq-wt-docto    = 1
         AND tb-wt-it-imposto.seq-wt-it-docto = {1}.sequencia,      
        EACH tb-ct-trib-wt-item-docto NO-LOCK
       WHERE tb-ct-trib-wt-item-docto.num-seq-wt-docto      = tb-wt-it-imposto.seq-wt-docto
         AND tb-ct-trib-wt-item-docto.num-seq-wt-item-docto = tb-wt-it-imposto.seq-wt-it-docto:
         
        find first tb-wt-it-docto no-lock 
                where tb-wt-it-docto.seq-wt-docto = tb-wt-it-imposto.seq-wt-docto no-error.     
                
        if "{1}" = "item-doc-est":U then
           assign i-sequencia = tb-wt-it-imposto.seq-wt-it-docto.
        else 
           assign i-sequencia = {1}.sequencia.
           
        CASE tb-ct-trib-wt-item-docto.cod-tip-trib:
            WHEN "IPI" THEN
                ASSIGN {1}.cd-trib-ipi   = tb-wt-it-imposto.cd-trib-ipi
                       {1}.aliquota-ipi  = tb-wt-it-imposto.aliquota-ipi
                       {1}.base-ipi[1]   = tb-wt-it-imposto.vl-bipi-it     
                       {1}.ipi-ntrib[1]  = tb-wt-it-imposto.vl-ipint-it        
                       {1}.ipi-outras[1] = tb-wt-it-imposto.vl-ipiou-it
                       {1}.ipi-outras[2] = tb-wt-it-imposto.vl-ipi-outras
                       {1}.valor-ipi[1]  = tb-wt-it-imposto.vl-ipi-it.
                       
            WHEN "IPI_ValUnit" THEN DO:
                IF tb-ct-trib-wt-item-docto.val-trib <> 0 THEN
                    ASSIGN de-valor-ipi-unid = tb-ct-trib-wt-item-docto.val-trib.                     
            END.

            WHEN "ISS" THEN
                ASSIGN {1}.cd-trib-iss    = tb-wt-it-imposto.cd-trib-iss 
                       {1}.aliquota-iss   = tb-wt-it-imposto.aliquota-iss
                       {1}.base-iss[1]    = tb-wt-it-imposto.vl-biss-it
                       {1}.valor-iss[1]   = tb-wt-it-imposto.vl-iss-it
                       {1}.iss-ntrib[1]   = tb-wt-it-imposto.vl-issnt-it
                       {1}.iss-outras[1]  = tb-wt-it-imposto.vl-issou-it.

            WHEN "FCP" THEN DO:            
                {inbo/boin176.m102 "{1}"}   /*Posiciona/Cria na ext-item-doc-est para FCP*/
                IF AVAIL tt-ext-item-doc-est THEN DO:
                    ASSIGN tt-ext-item-doc-est.val-livre-1 = tb-ct-trib-wt-item-docto.val-base-calc WHEN {1}.nro-comp = " " OR natur-oper.tipo-compra <> 3  /*Base FCP*/
                           tt-ext-item-doc-est.val-livre-2 = tb-ct-trib-wt-item-docto.val-aliq      WHEN {1}.nro-comp = " " OR natur-oper.tipo-compra <> 3  /*Aliq FCP*/
                           tt-ext-item-doc-est.val-livre-3 = tb-ct-trib-wt-item-docto.val-trib      WHEN {1}.nro-comp = " " OR natur-oper.tipo-compra <> 3. /*Valor FCP*/
                     
                    /*Zera a aliquota quando nío tiver valor de FCP*/
                    IF tt-ext-item-doc-est.val-livre-3 = 0 THEN
                        ASSIGN tt-ext-item-doc-est.val-livre-2 = 0.
                END.                
            END.

            WHEN "FCP_PercDif" THEN DO:
                {inbo/boin176.m102 "{1}"}   /*Posiciona/Cria na ext-item-doc-est para FCP*/
                IF AVAIL tt-ext-item-doc-est THEN DO:
                    if ({1}.nro-comp = " " OR natur-oper.tipo-compra <> 3) then 
                       ASSIGN OVERLAY(tt-ext-item-doc-est.cod-livre-1,21,8) = STRING(tb-ct-trib-wt-item-docto.val-trib).
                END.                       
            END.

            WHEN "FCP_ValDif" THEN DO:
                {inbo/boin176.m102 "{1}"}   /*Posiciona/Cria na ext-item-doc-est para FCP*/
                IF AVAIL tt-ext-item-doc-est THEN DO:
                    if ({1}.nro-comp = " " OR natur-oper.tipo-compra <> 3) then 
                       ASSIGN OVERLAY(tt-ext-item-doc-est.cod-livre-1,1,20) = STRING(tb-ct-trib-wt-item-docto.val-trib).
                END.                       
            END.

            WHEN "FCP ST" THEN DO:
                {inbo/boin176.m102 "{1}"}   /*Posiciona/Cria na ext-item-doc-est para FCP*/
                IF AVAIL tt-ext-item-doc-est THEN DO:
                    ASSIGN tt-ext-item-doc-est.val-livre-4 = tb-ct-trib-wt-item-docto.val-base-calc WHEN {1}.nro-comp = " " OR natur-oper.tipo-compra <> 3  /*Base FCP ST*/ 
                           tt-ext-item-doc-est.val-livre-5 = tb-ct-trib-wt-item-docto.val-aliq      WHEN {1}.nro-comp = " " OR natur-oper.tipo-compra <> 3  /*Aliq FCP ST*/ 
                           tt-ext-item-doc-est.val-livre-6 = tb-ct-trib-wt-item-docto.val-trib      WHEN {1}.nro-comp = " " OR natur-oper.tipo-compra <> 3. /*Valor FCP ST*/
                           
                    /*Zera a aliquota quando nío tiver valor de FCP ST*/
                    IF tt-ext-item-doc-est.val-livre-6 = 0 THEN
                        ASSIGN tt-ext-item-doc-est.val-livre-5 = 0.
                END.                        
            END.
    
            WHEN "ICMS" THEN DO:
                 ASSIGN {1}.aliquota-icm           = tb-wt-it-imposto.aliquota-icm 
                        {1}.valor-icm              = tb-wt-it-imposto.vl-icms-it
                        {1}.base-icm               = tb-wt-it-imposto.vl-bicms-it
                        {1}.icm-ntrib              = tb-wt-it-imposto.vl-icmsnt-it
                        {1}.icm-outras[1]          = tb-wt-it-imposto.vl-icmsou-it
                        {1}.icm-outras[2]          = tb-wt-it-imposto.vl-icms-outras
                        OVERLAY({1}.char-2,796,6)  = STRING(tb-wt-it-imposto.val-perc-icms-diferim)
                        OVERLAY({1}.char-2,802,17) = STRING(tb-wt-it-imposto.val-diferim-icms-item).
                                       
                 if {1}.cd-trib-icm  <> 5 THEN  /*Somente busca tributaá∆o da formula se a Tributaá∆o for diferente de "Diferido"*/
                   ASSIGN {1}.cd-trib-icm            = tb-wt-it-imposto.cd-trib-icm.                      
                        
            END.            

            WHEN "ICMS COMP" THEN ASSIGN {1}.icm-complem            = tb-wt-it-imposto.icm-complem
                                         OVERLAY({1}.char-2,860,20) = SUBSTRING(tb-wt-it-imposto.char-1,296,20). /*base icms complementar*/
    
            WHEN "ICMS ST" THEN ASSIGN {1}.base-subs = tb-wt-it-imposto.vl-bsubs-it  WHEN tb-wt-it-docto.nro-comp = " " OR natur-oper.tipo-compra <> 3 /* Devol Cli */
                                       {1}.vl-subs   = tb-wt-it-imposto.vl-icmsub-it WHEN tb-wt-it-docto.nro-comp = " " OR natur-oper.tipo-compra <> 3. /* Devol Cli */
                                       
                                       
            WHEN "ICMS ST_ModBC" THEN ASSIGN overlay({1}.char-2,910,1)  = substring(tb-wt-it-imposto.char-1,97,1). /*Base ST - Tipo*/  
            

            WHEN "PIS" THEN
                 ASSIGN {1}.idi-tributac-pis = tb-ct-trib-wt-item-docto.idi-cod-tributac
                        {1}.val-aliq-pis     = IF tb-ct-trib-wt-item-docto.val-aliq <> 0 THEN 
                                                           tb-ct-trib-wt-item-docto.val-aliq
                                                        ELSE DEC(SUBSTRING(tb-wt-it-docto.char-1,100,7))
                        {1}.base-pis         = tb-ct-trib-wt-item-docto.val-base-calc
                        {1}.valor-pis        = tb-ct-trib-wt-item-docto.val-trib
                        de-aliquota-pis               = IF tb-ct-trib-wt-item-docto.val-aliq <> 0 THEN 
                                                           tb-ct-trib-wt-item-docto.val-aliq
                                                        ELSE DEC(SUBSTRING(tb-wt-it-docto.char-1,100,7)) /* de-aliquota-pis tem mais de 2 decimais */
                        l-calc-pis-cofins             = YES.
           
            WHEN "COFINS" THEN
                 ASSIGN {1}.idi-tributac-cofins  = tb-ct-trib-wt-item-docto.idi-cod-tributac
                        {1}.val-aliq-cofins      = IF tb-ct-trib-wt-item-docto.val-aliq <> 0 THEN 
                                                               tb-ct-trib-wt-item-docto.val-aliq
                                                            ELSE DEC(SUBSTRING(tb-wt-it-docto.char-1,107,7))
                        {1}.base-cofins-subs          = tb-ct-trib-wt-item-docto.val-base-calc
                        {1}.val-base-calc-cofins = tb-ct-trib-wt-item-docto.val-base-calc
                        {1}.val-cofins           = tb-ct-trib-wt-item-docto.val-trib
                        de-aliquota-cofins                = IF tb-ct-trib-wt-item-docto.val-aliq <> 0 THEN 
                                                               tb-ct-trib-wt-item-docto.val-aliq
                                                            ELSE DEC(SUBSTRING(tb-wt-it-docto.char-1,107,7)) /* de-aliquota-cofins tem mais de 2 decimais */
                        l-calc-pis-cofins                 = YES.
                                      
            WHEN "PIS_ValUnit" THEN DO:
                IF tb-ct-trib-wt-item-docto.val-trib <> 0 THEN
                    ASSIGN {1}.val-aliq-pis         = 0
                           {1}.base-pis             = 0
                           de-aliquota-pis          = 0
                           de-valor-un-pis          = tb-ct-trib-wt-item-docto.val-trib
                           l-calc-pis-cofins        = YES.
            END.
                                                                           
            WHEN "COFINS_ValUnit" THEN DO:
                IF tb-ct-trib-wt-item-docto.val-trib <> 0 THEN
                    ASSIGN {1}.val-aliq-cofins      = 0
                           {1}.val-base-calc-cofins = 0
                           de-aliquota-cofins       = 0
                           de-valor-un-cofins       = tb-ct-trib-wt-item-docto.val-trib
                           l-calc-pis-cofins        = YES.
            END.
            
			WHEN "CBS" THEN DO:
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN DO:
                
                    IF lSujTribMonofasica THEN DO:
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                      INPUT AtributoImposto:BASE-MONO,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)). 
                        
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                      INPUT AtributoImposto:ALIQ-MONO,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-aliq)).

                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                      INPUT AtributoImposto:VALOR-MONO,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).
                                                      
                        /*Caso n∆o tenha f¢rmula para c†lculo do mono retená∆o (CBS_Reten), ir† retornar zerado a al°quota*/
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                      INPUT AtributoImposto:ALIQ-MONO-RET,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-4)).
                                                      
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                      INPUT AtributoImposto:ALIQ-COMBPETRO,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-1)).
                                                      
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                      INPUT AtributoImposto:VREF-COMBPETRO,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-3)).
                    END.
                    ELSE DO:
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                      INPUT AtributoImposto:COD-TRIB,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.idi-cod-tributac)).                                                   

                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                      INPUT AtributoImposto:BASE,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)). 
                                                      
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                      INPUT AtributoImposto:ALIQUOTA,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-aliq)). 
                                                      
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                      INPUT AtributoImposto:ALIQ-RED,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-perc-reduc)).
                        
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                      INPUT AtributoImposto:ALIQ-EFETIVA,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-2)).
                    
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                      INPUT AtributoImposto:VALOR,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).
                    END.
                END.
            END.
            WHEN "CBS_Reg" THEN DO:
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:BASE-REG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)). 
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:ALIQUOTA-REG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-aliq)).                                                  
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:ALIQ-RED-REG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-perc-reduc)).
                    
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:ALIQ-EFETIVA-REG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-2)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:VALOR-REG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).   
                END.
            END.              
			WHEN "CBS_PercDif" THEN DO:
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no  THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:PERC-DIFER,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)). 
            END.
            WHEN "CBS_ValDif" THEN DO:
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no  THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:VALOR-DIFER,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)). 
            END.
            WHEN "IBS ValCP"  THEN DO:
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no  THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:BASE-CP,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)). 
                                                  
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:VALOR-CP,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).                                                   
                END.
            END.
            WHEN "IBS PercCP" THEN DO:
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no  THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:PERC-CP,
                                                  INPUT STRING( tb-ct-trib-wt-item-docto.val-trib)). 
            END.
            WHEN "CBS ValCP"  THEN DO:
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no  THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:BASE-CP,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)). 
                                                  
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:VALOR-CP,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).                                                   
                END.
            END.
            WHEN "CBS PercCP" THEN DO:
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no  THEN 
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:PERC-CP,
                                                  INPUT STRING( tb-ct-trib-wt-item-docto.val-trib)). 
            END.
            WHEN "CBS_GOV" THEN DO:
            
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:BASE-GOV,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:ALIQ-GOV,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-aliq)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:PERC-RED-GOV,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-3)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:ALIQ-EFETIVA-GOV,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-2)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:VALOR-GOV,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).
                END.
            END.
            WHEN "CBS_ALCZFM" THEN DO:
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:BASE-ALCZFM,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)).

                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:ALIQ-EFETIVA-ALCZFM,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-aliq)).

                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:VALOR-ALCZFM,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).
                END.
            END.
            WHEN "CBS_Reten" THEN DO:
            
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:BASE-MONO-RET,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:ALIQ-MONO-RET,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-aliq)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:VALOR-MONO-RET,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).
                END.
            END.
            WHEN "BioDifer_CBS" THEN DO:
            
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:BASE-BIODIFER,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:VALOR-BIODIFER,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:ALIQ-BIOCOMB,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-1)).

                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:VREF-BIOCOMB,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-3)).
                END.
            END.
            WHEN "qBioComb" THEN DO:
            
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:QTDE-BIOCOMB,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:QTDE-BIOCOMB,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).

                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:PERC-MISTURA,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-1)).

                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:PERC-MISTURA,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-1)).

                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:PERC-MISTURA-OBRIG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-2)).

                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:PERC-MISTURA-OBRIG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-2)).
                END.
            END.
            WHEN "qCombPetro" THEN DO:
            
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS,
                                                  INPUT AtributoImposto:QTDE-COMBPETRO,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:QTDE-COMBPETRO,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).
                END.
            END.
            
            WHEN "IBSUF" THEN DO:
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN DO:
                    IF lSujTribMonofasica THEN DO:
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                      INPUT AtributoImposto:BASE-MONO,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)). 

                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                      INPUT AtributoImposto:ALIQ-MONO,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-aliq)).

                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                      INPUT AtributoImposto:VALOR-MONO,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).
                                                      
                        /*Caso n∆o tenha f¢rmula para c†lculo do mono retená∆o (IBS_Reten), ir† retornar zerado a al°quota*/
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                      INPUT AtributoImposto:ALIQ-MONO-RET,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-4)).
                                                      
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                      INPUT AtributoImposto:ALIQ-COMBPETRO,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-1)).
                                                      
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                      INPUT AtributoImposto:VREF-COMBPETRO,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-3)).
                    END.
                    ELSE DO:
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                      INPUT AtributoImposto:COD-TRIB,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.idi-cod-tributac)).                                                                                                     
                                                      
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                      INPUT AtributoImposto:BASE,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)).                                                
                                                      
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                      INPUT AtributoImposto:ALIQUOTA,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-aliq)). 
                                                      
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                      INPUT AtributoImposto:ALIQ-RED,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-perc-reduc)).
                                                      
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                      INPUT AtributoImposto:ALIQ-EFETIVA,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-2)).
                    
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                      INPUT AtributoImposto:VALOR,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)). 
                    END.
                END.
            END.
            WHEN "IBSUF_Reg" THEN DO:
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:BASE-REG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)). 
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:ALIQUOTA-REG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-aliq)).                                                  
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:ALIQ-RED-REG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-perc-reduc)).
                    
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:ALIQ-EFETIVA-REG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-2)).                                                  
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:VALOR-REG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).
                                                  
                END.
            END.
            WHEN "IBSUF_PercDif" THEN DO:
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:PERC-DIFER,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)). 
            END.

            WHEN "IBSUF_ValDif" THEN DO:
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN            
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:VALOR-DIFER,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)). 
            END.
            WHEN "IBSUF_GOV" THEN DO:
            
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:BASE-GOV,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:ALIQ-GOV,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-aliq)).

                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:PERC-RED-GOV,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-3)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:ALIQ-EFETIVA-GOV,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-2)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:VALOR-GOV,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).
                END.
            END.
            WHEN "IBS_Reten" THEN DO:
            
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:BASE-MONO-RET,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:ALIQ-MONO-RET,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-aliq)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:VALOR-MONO-RET,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).
                END.
            END.
            WHEN "BioDifer_IBS" THEN DO:
            
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:BASE-BIODIFER,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:VALOR-BIODIFER,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).

                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:ALIQ-BIOCOMB,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-1)).

                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF,
                                                  INPUT AtributoImposto:VREF-BIOCOMB,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-3)).
                END.
            END.
			
            WHEN "IBSMun" THEN DO:
            
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN DO:
                    IF lSujTribMonofasica THEN DO:
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                      INPUT AtributoImposto:BASE-MONO,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)). 

                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                      INPUT AtributoImposto:ALIQ-MONO,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-aliq)).

                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                      INPUT AtributoImposto:VALOR-MONO,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).
                    END.
                    ELSE DO:
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                      INPUT AtributoImposto:COD-TRIB,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.idi-cod-tributac)).                                                                                                     
                                                      
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                      INPUT AtributoImposto:BASE,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)). 
                                                      
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                      INPUT AtributoImposto:ALIQUOTA,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-aliq)). 
                                                      
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                      INPUT AtributoImposto:ALIQ-RED,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-perc-reduc)).
                                                      
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                      INPUT AtributoImposto:ALIQ-EFETIVA,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-2)). 
                                                      
                        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                      INPUT AtributoImposto:VALOR,
                                                      INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)). 
                    END.
                END.
            END.
            WHEN "IBSMUN_Reg" THEN DO:
            
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                  INPUT AtributoImposto:BASE-REG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)). 
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                  INPUT AtributoImposto:ALIQUOTA-REG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-aliq)).                                                  
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                  INPUT AtributoImposto:ALIQ-RED-REG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-perc-reduc)).
                    
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                  INPUT AtributoImposto:ALIQ-EFETIVA-REG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-2)).                                                  
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                  INPUT AtributoImposto:VALOR-REG,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).   
                END.
            END.
            WHEN "IBSMUN_PercDif" THEN DO:
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                  INPUT AtributoImposto:PERC-DIFER,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)). 
            END.
			
            WHEN "IBSMUN_ValDif" THEN DO:
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN            
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                  INPUT AtributoImposto:VALOR-DIFER,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)). 
            END.
            WHEN "IBSMUN_GOV" THEN DO:
            
                IF l-NT2024002 and  l-utilizaImpostoMonitor = no THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                  INPUT AtributoImposto:BASE-GOV,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                  INPUT AtributoImposto:ALIQ-GOV,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-aliq)).

                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                  INPUT AtributoImposto:PERC-RED-GOV,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-3)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                  INPUT AtributoImposto:ALIQ-EFETIVA-GOV,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-2)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN,
                                                  INPUT AtributoImposto:VALOR-GOV,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)).
                END.
            END.
            
            WHEN "IS" THEN DO:
                IF l-NT2024002 AND l-utilizaImpostoMonitor = no THEN DO:
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS,
                                                  INPUT AtributoImposto:COD-TRIB,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.idi-cod-tributac)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS,
                                                  INPUT AtributoImposto:BASE,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-base-calc)). 
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS,
                                                  INPUT AtributoImposto:ALIQUOTA,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-aliq)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS,
                                                  INPUT AtributoImposto:ALIQ-ESPEC-UN,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-2)).
                                                  
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS,
                                                  INPUT AtributoImposto:QTDE-TRIBUT,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-livre-3)).

                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS,
                                                  INPUT AtributoImposto:VALOR,
                                                  INPUT STRING(tb-ct-trib-wt-item-docto.val-trib)). 
                END.
            END.             
            
        END CASE.

    END. /* for each tb-ct-trib-wt-item-docto */
    
    /* FCP ********************************************************/
    FIND FIRST tt-ext-item-doc-est EXCLUSIVE-LOCK
         WHERE tt-ext-item-doc-est.serie-docto  = {1}.serie-docto
           AND tt-ext-item-doc-est.nro-docto    = {1}.nro-docto
           AND tt-ext-item-doc-est.cod-emitente = {1}.cod-emitente
           AND tt-ext-item-doc-est.nat-operacao = {1}.nat-operacao
           AND tt-ext-item-doc-est.sequencia    = i-sequencia
           AND tt-ext-item-doc-est.cod-param    = "fcp":U NO-ERROR.
    IF AVAIL tt-ext-item-doc-est THEN DO:
    
        /*1-FCP Normal, 2-FCP Subst. Trib., 3-FCP Subst. Trib. Antecip*/
        ASSIGN tt-ext-item-doc-est.num-livre-2 = 1.
        IF  AVAIL b-natur-oper AND b-natur-oper.subs-trib THEN
            ASSIGN tt-ext-item-doc-est.num-livre-2 = 2.
        ELSE IF AVAIL b-natur-oper AND NOT b-natur-oper.terceiros AND
                (b-natur-oper.log-contrib-st-antec or b-natur-oper.log-icms-substto-antecip) THEN
            ASSIGN tt-ext-item-doc-est.num-livre-2 = 3.

        RUN goToKey IN h-boin01017 (INPUT {1}.serie-docto, 
                                    INPUT {1}.nro-docto,   
                                    INPUT {1}.cod-emitente,
                                    INPUT {1}.nat-operacao,
                                    INPUT i-sequencia,   
                                    INPUT "fcp":U). 

        IF  RETURN-VALUE = "OK":U THEN DO:
            RUN emptyRowErrors IN h-boin01017.
            RUN setRecord IN h-boin01017 (INPUT TABLE tt-ext-item-doc-est).
            RUN updateRecord IN h-boin01017.  
        END.    
        ELSE DO:
            RUN emptyRowErrors IN h-boin01017.
            RUN setRecord IN h-boin01017 (INPUT TABLE tt-ext-item-doc-est).
            RUN createRecord IN h-boin01017.
        END.
    end.
    /* FCP ********************************************************/

    IF VALID-HANDLE(h-boin01017) THEN DO:
        DELETE PROCEDURE h-boin01017.
        ASSIGN h-boin01017 = ?.
    END.
    
    
    
    IF l-utilizaImpostoMonitor = no and de-valor-ipi-unid <> 0 THEN DO:
        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IPI,
                                      INPUT AtributoImposto:VALOR-UNID,
                                      INPUT STRING(de-valor-ipi-unid)).        
                                   
        RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IPI,
                                      INPUT AtributoImposto:QUANT-UNID,
                                      INPUT STRING({1}.quantidade)).
    END.
        
    /* PIS / COFINS Atualiza Aliquota *****************************/
    IF l-utilizaImpostoMonitor = no and l-calc-pis-cofins THEN DO:

        RUN grava-aliquotas IN h-cdapi995 (INPUT "item-doc-est",
                                           INPUT {1}.serie-docto + "/" + 
                                                 {1}.nro-docto + "/" + 
                                                 STRING({1}.cod-emitente) + "/" + 
                                                 {1}.nat-operacao + "/" + 
                                                 STRING({1}.sequencia), 
                                           INPUT de-aliquota-pis, 
                                           INPUT de-aliquota-cofins).
                                           
                                           
        /*PIS/COFINS por unidade - valor*/
        IF de-valor-un-pis <> 0 THEN DO:
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:PIS,
                                          INPUT AtributoImposto:VALOR-UNID,
                                          INPUT de-valor-un-pis).
                                          
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:PIS,
                                          INPUT AtributoImposto:QUANT-UNID,
                                          INPUT STRING({1}.quantidade)).
        END.        
        IF de-valor-un-cofins <> 0 THEN DO:
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:COFINS,
                                          INPUT AtributoImposto:VALOR-UNID,
                                          INPUT de-valor-un-cofins).
                                          
            RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:COFINS,
                                          INPUT AtributoImposto:QUANT-UNID,
                                          INPUT STRING({1}.quantidade)).                                          
        END.         
        
      
        
     END.   
    /**************************************************************/                                       

    if {1}.cd-trib-icm = 1 and     //Tributado
       avail natur-oper and 
       natur-oper.log-livre-6 then //Convànio 109/24
        assign {1}.base-icm     = 0
               {1}.icm-ntrib    = 0
               {1}.icm-outras   = 0
               {1}.aliquota-icm = 0.

    if "{1}" <> "item-doc-est":U then
       run pi-gravar-dados-cfg-trib (input docum-est.serie-docto, input "").
