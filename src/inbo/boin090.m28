PROCEDURE pi-criaDocumentoFiscal :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters: 
  Notes: Criaá∆o de documentos de entrada que geraram NF-e em OF, quando essas 
         notas s∆o rejeitadas pela SEFAZ e devem ser inutilizadas.
------------------------------------------------------------------------------*/
   DEFINE INPUT PARAM prw-nota-fiscal AS ROWID NO-UNDO.
   
   DEFINE BUFFER b-docum-est    FOR docum-est.
   DEFINE BUFFER b-nota-fiscal  FOR nota-fiscal.
   DEFINE BUFFER b-param-of     FOR param-of.
   DEFINE BUFFER b-doc-fiscal   FOR doc-fiscal.
   DEFINE BUFFER b-item-doc-est FOR item-doc-est. /* Buffer para realizar busca da natureza fiscal do item... */
   
   DEFINE VARIABLE da-ult-livro AS DATE    NO-UNDO.
   DEFINE VARIABLE l-erro-of-re AS LOGICAL NO-UNDO.

   FOR FIRST b-nota-fiscal NO-LOCK
       WHERE ROWID(b-nota-fiscal) = prw-nota-fiscal:
   END.
   
   IF  NOT AVAIL b-nota-fiscal THEN
       RETURN "NOK".
                   
   FOR FIRST b-docum-est NO-LOCK
       WHERE b-docum-est.serie-docto  = b-nota-fiscal.serie
         AND b-docum-est.nro-docto    = b-nota-fiscal.nr-nota-fis
         AND b-docum-est.cod-emitente = b-nota-fiscal.cod-emitente
         AND b-docum-est.nat-operacao = b-nota-fiscal.nat-operacao:
   END.
    /* Se nota propria emitente Ç o proprio estabelecimento, por isso buscar pela chave de acesso */
    IF NOT AVAIL b-docum-est THEN
    FOR FIRST b-docum-est EXCLUSIVE-LOCK
        WHERE b-docum-est.cod-chave-aces-nf-eletro = b-nota-fiscal.cod-chave-aces-nf-eletro:
    END.

   IF  NOT AVAIL b-docum-est THEN
       RETURN "NOK".

   FIND FIRST b-param-of 
        WHERE b-param-of.cod-estabel = b-docum-est.estab-fisc NO-LOCK NO-ERROR.
   
   IF  NOT AVAIL b-param-of THEN
       RETURN "NOK".

   IF  NOT b-docum-est.of-atual               AND 
       CAN-FIND(FIRST param-global 
                WHERE param-global.modulo-of) AND 
       CAN-FIND(FIRST natur-oper 
                WHERE natur-oper.nat-operacao = b-docum-est.nat-operacao
                  AND natur-oper.ind-gera-of) THEN DO:    
                                                              
       ASSIGN da-ult-livro = IF DAY(b-docum-est.dt-trans) < 11                         
                             THEN  DATE(MONTH(b-docum-est.dt-trans),1,                 
                                        YEAR(b-docum-est.dt-trans))                    
                             ELSE                                                      
                             IF DAY(b-docum-est.dt-trans) < 21                         
                             THEN  DATE(MONTH(b-docum-est.dt-trans),11,                
                                        YEAR(b-docum-est.dt-trans))                    
                             ELSE                                                      
                                   DATE(MONTH(b-docum-est.dt-trans),21,                
                                        YEAR(b-docum-est.dt-trans)).                   
                                        
       ASSIGN l-erro-of-re = NO.                                 
       
       FIND FIRST contr-livros                                                          
            WHERE contr-livros.cod-estabel = b-docum-est.estab-fisc                     
              AND contr-livros.dt-ult-emi  = da-ult-livro                               
              AND contr-livros.livro       = 1 NO-LOCK NO-ERROR.
              
       IF  AVAIL contr-livros THEN DO:
       
           ASSIGN l-erro-of-re = YES.
           
           CREATE ret-nf-eletro.                                                                                                                          
           ASSIGN ret-nf-eletro.cod-estabel = b-docum-est.cod-estabel                                                         
                  ret-nf-eletro.cod-serie   = b-docum-est.serie-docto                                                         
                  ret-nf-eletro.nr-nota-fis = b-docum-est.nro-docto
                  ret-nf-eletro.cod-msg     = "6515":U                                                                          
                  ret-nf-eletro.cod-livre-2 = "Registro de Entrada deve ser re-emitido.":U         
                  ret-nf-eletro.dat-ret     = TODAY                                                                           
                  ret-nf-eletro.hra-ret     = REPLACE(STRING(TIME, "HH:MM:SS"),":","")
                  ret-nf-eletro.log-ativo   = YES
                  &if "{&bf_dis_versao_ems}":U < "2.07" &then
                      ret-nf-eletro.cod-livre-1 = SUBSTRING(b-nota-fiscal.char-1,97,15)
                  &else
                      ret-nf-eletro.cod-protoc  = b-nota-fiscal.cod-protoc
                  &endif
                  .
       END.
       
       IF b-param-of.dt-congela = ? OR
          b-docum-est.dt-trans >= b-param-of.dt-congela THEN DO:
          
           find first emitente no-lock 
                where emitente.cod-emitente = b-docum-est.cod-emitente no-error.
          
           if can-find(first natur-oper 
                       where natur-oper.nat-operacao = b-docum-est.nat-operacao
                         and natur-oper.int-1 = 1) and /*nota propria*/  
              b-docum-est.cod-observa = 3 and /*devolucao cliente*/
              b-docum-est.nf-emitida-est then do: /*NF emitida estab*/
              find first estabelec no-lock 
                   where estabelec.cod-estabel = b-docum-est.cod-estabel no-error.
              find first emitente no-lock 
                   where emitente.cod-emitente = estabelec.cod-emitente no-error.
           end.        
           
           IF  l-mult-natur-receb THEN DO: /* Var def em cd9701.i -> Se usa m£ltiplas naturezas */
               
               /* Utilizando m£ltiplas naturezas no recebimento, poder∆o existir v†rias doc-fiscal (uma para cada */
               /* natureza fiscal (nat-of) diferente existente na nota). Sendo assim, Ç necess†rio buscar os itens */
               /* para somente depois consistir a doc-fiscal utilizando a natureza fiscal do item (nat-of) */
               FOR EACH b-item-doc-est NO-LOCK
                    WHERE b-item-doc-est.serie-docto  = b-docum-est.serie-docto AND
                          b-item-doc-est.nro-docto    = b-docum-est.nro-docto AND
                          b-item-doc-est.cod-emitente = b-docum-est.cod-emitente AND
                          b-item-doc-est.nat-operacao = b-docum-est.nat-operacao
                          BREAK BY b-item-doc-est.nat-of:
    
                   IF  FIRST-OF(b-item-doc-est.nat-of) THEN DO: 
                       /* Se NF antiga (nat-of sem valores) agrupar† pelo vazio (""), ou seja: vai entrar uma vez nesse bloco. */
                       /* Se NF nova (digitada ap¢s marcar o parÉm) poder† entrar v†rias vezes nesse bloco: conforme qtd de nat-of na NF. */
                       
                       FIND FIRST doc-fiscal
                            WHERE doc-fiscal.cod-estabel  = b-docum-est.estab-fisc                  
                              AND doc-fiscal.serie        = b-docum-est.serie-docto                       
                              AND doc-fiscal.nr-doc-fis   = b-docum-est.nro-docto                   
                              AND doc-fiscal.cod-emitente = emitente.cod-emitente
                              AND doc-fiscal.nat-operacao = b-item-doc-est.nat-of /* Natureza fiscal (Item) */
                              NO-LOCK NO-ERROR.
                              /* Busca doc-fiscal com a natureza fiscal do item (nat-of) */

                       IF  NOT AVAIL doc-fiscal THEN
                           /* b-item-doc-est.nat-of = vazio = "" */
                           /* Provavelmente Ç uma nota antiga (digitada antes de marcar o parÉm), ent∆o seguir† o */
                           /* fluxo antigo como se n∆o usasse m£ltiplas naturezas no recebimento */
                           FIND FIRST doc-fiscal
                                WHERE doc-fiscal.cod-estabel  = b-docum-est.estab-fisc
                                  AND doc-fiscal.serie        = b-docum-est.serie-docto
                                  AND doc-fiscal.nr-doc-fis   = b-docum-est.nro-docto
                                  AND doc-fiscal.cod-emitente = emitente.cod-emitente
                                  AND doc-fiscal.nat-operacao = b-docum-est.nat-operacao /* Natureza de operaá∆o (Nota) */
                                  NO-LOCK NO-ERROR.
                                  /* Busca doc-fiscal com a natureza de operaá∆o da nota (nat-operacao) */
                    
                       IF AVAIL doc-fiscal THEN DO:
                           CREATE ret-nf-eletro.
                           ASSIGN ret-nf-eletro.cod-estabel = b-docum-est.cod-estabel
                                  ret-nf-eletro.cod-serie   = b-docum-est.serie-docto
                                  ret-nf-eletro.nr-nota-fis = b-docum-est.nro-docto
                                  ret-nf-eletro.cod-msg     = "6497":U
                                  ret-nf-eletro.cod-livre-2 = "Documento fiscal j† cadastrado no m¢dulo de obrigaá‰es fiscais.":U
                                  ret-nf-eletro.dat-ret     = TODAY
                                  ret-nf-eletro.hra-ret     = REPLACE(STRING(TIME, "HH:MM:SS"),":","")
                                  ret-nf-eletro.log-ativo   = YES
                                  &if "{&bf_dis_versao_ems}":U < "2.07" &then
                                      ret-nf-eletro.cod-livre-1 = SUBSTRING(b-nota-fiscal.char-1,97,15)
                                  &else
                                      ret-nf-eletro.cod-protoc  = b-nota-fiscal.cod-protoc
                                  &endif
                                  l-erro-of-re = YES.    
                       END.

                   END. /* IF FIRST-OF(b-item-doc-est.nat-of) */
               END. /* END FOR EACH b-item-doc-est */
           END. /* END IF l-mult-natur-receb */
           ELSE DO:
               /* N∆o usa m£ltiplas naturezas no recebimento */
               FIND FIRST doc-fiscal
                    WHERE doc-fiscal.cod-estabel  = b-docum-est.estab-fisc
                      AND doc-fiscal.serie        = b-docum-est.serie-docto
                      AND doc-fiscal.nr-doc-fis   = b-docum-est.nro-docto
                      AND doc-fiscal.cod-emitente = emitente.cod-emitente
                      AND doc-fiscal.nat-operacao = b-docum-est.nat-operacao /* Natureza de operaá∆o (Nota) */
                      NO-LOCK NO-ERROR.
                      /* Busca doc-fiscal com a natureza de operaá∆o da nota (nat-operacao) */
            
               IF AVAIL doc-fiscal THEN DO:
                   CREATE ret-nf-eletro.
                   ASSIGN ret-nf-eletro.cod-estabel = b-docum-est.cod-estabel
                          ret-nf-eletro.cod-serie   = b-docum-est.serie-docto
                          ret-nf-eletro.nr-nota-fis = b-docum-est.nro-docto
                          ret-nf-eletro.cod-msg     = "6497":U
                          ret-nf-eletro.cod-livre-2 = "Documento fiscal j† cadastrado no m¢dulo de obrigaá‰es fiscais.":U
                          ret-nf-eletro.dat-ret     = TODAY
                          ret-nf-eletro.hra-ret     = REPLACE(STRING(TIME, "HH:MM:SS"),":","")
                          ret-nf-eletro.log-ativo   = YES
                          &if "{&bf_dis_versao_ems}":U < "2.07" &then
                              ret-nf-eletro.cod-livre-1 = SUBSTRING(b-nota-fiscal.char-1,97,15)
                          &else
                              ret-nf-eletro.cod-protoc  = b-nota-fiscal.cod-protoc
                          &endif
                          l-erro-of-re = YES.    
               END.
           END.

           IF  NOT l-erro-of-re THEN DO:
               RUN cdp/cd4395.p (ROWID(b-docum-est),                                      
                                 NO,                                                      
                                 INPUT TABLE tt-rateio).
               
               IF  l-mult-natur-receb THEN DO: /* Var def em cd9701.i -> Se usa m£ltiplas naturezas */
                   /* Utilizando m£ltiplas naturezas no recebimento, poder∆o existir v†rias doc-fiscal (uma para cada */
                   /* natureza fiscal (nat-of) diferente existente na nota). Sendo assim, Ç necess†rio buscar os itens */
                   /* para somente depois consistir a doc-fiscal utilizando a natureza fiscal do item (nat-of) */
                   FOR EACH b-item-doc-est NO-LOCK
                       WHERE b-item-doc-est.serie-docto  = b-docum-est.serie-docto AND 
                             b-item-doc-est.nro-docto    = b-docum-est.nro-docto AND
                             b-item-doc-est.cod-emitente = b-docum-est.cod-emitente AND
                             b-item-doc-est.nat-operacao = b-docum-est.nat-operacao 
                             BREAK BY b-item-doc-est.nat-of:

                       IF  FIRST-OF(b-item-doc-est.nat-of) THEN DO:
                           /* Se NF antiga (nat-of sem valores) agrupar† pelo vazio (""), ou seja: vai entrar uma vez nesse bloco. */
                           /* Se NF nova (digitada ap¢s marcar o parÉm) poder† entrar v†rias vezes nesse bloco: conforme qtd de nat-of na NF. */
                           FIND FIRST doc-fiscal                                                       
                                WHERE doc-fiscal.cod-estabel  = b-docum-est.estab-fisc
                                  AND doc-fiscal.serie        = b-docum-est.serie-docto
                                  AND doc-fiscal.nr-doc-fis   = b-docum-est.nro-docto
                                  AND doc-fiscal.cod-emitente = emitente.cod-emitente
                                  AND doc-fiscal.nat-operacao = b-item-doc-est.nat-of /* Natureza fiscal (item) */
                                  EXCLUSIVE-LOCK NO-ERROR.
                                  /* Busca doc-fiscal com a natureza fiscal do item (nat-of) */

                           IF  NOT AVAIL doc-fiscal THEN
                               /* b-item-doc-est.nat-of = vazio = "" */
                               /* Provavelmente Ç uma nota antiga (digitada antes de marcar o parÉm), ent∆o seguir† o */
                               /* fluxo antigo como se n∆o usasse m£ltiplas naturezas no recebimento */
                               FIND FIRST doc-fiscal
                                   WHERE doc-fiscal.cod-estabel  = b-docum-est.estab-fisc
                                     AND doc-fiscal.serie        = b-docum-est.serie-docto
                                     AND doc-fiscal.nr-doc-fis   = b-docum-est.nro-docto
                                     AND doc-fiscal.cod-emitente = emitente.cod-emitente
                                     AND doc-fiscal.nat-operacao = b-docum-est.nat-operacao /* Natureza de operaá∆o (Nota) */
                                     EXCLUSIVE-LOCK NO-ERROR.
                                     /* Busca doc-fiscal com a natureza de operaá∆o da nota (nat-operacao) */

                           IF  AVAIL doc-fiscal THEN DO:
                               ASSIGN doc-fiscal.ind-sit-doc = 2.

                               FIND FIRST b-nota-fiscal 
                                    WHERE b-nota-fiscal.cod-estabel = doc-fiscal.cod-estabel 
                                      AND b-nota-fiscal.serie       = doc-fiscal.serie 
                                      AND b-nota-fiscal.nr-nota-fis = doc-fiscal.nr-doc-fis EXCLUSIVE-LOCK NO-ERROR.
                               IF AVAIL b-nota-fiscal THEN
                                   ASSIGN b-nota-fiscal.dt-at-ofest = TODAY.
                               FIND CURRENT b-nota-fiscal NO-LOCK NO-ERROR.
                           END.

                       END.
                   END. 
               END.
               ELSE DO:
                   /* N∆o usa m£ltiplas naturezas no recebimento */
                   FIND FIRST doc-fiscal
                        WHERE doc-fiscal.cod-estabel  = b-docum-est.estab-fisc
                          AND doc-fiscal.serie        = b-docum-est.serie-docto
                          AND doc-fiscal.nr-doc-fis   = b-docum-est.nro-docto
                          AND doc-fiscal.cod-emitente = emitente.cod-emitente
                          AND doc-fiscal.nat-operacao = b-docum-est.nat-operacao /* Busca doc-fiscal com a natureza de operaá∆o (nota) */
                         EXCLUSIVE-LOCK NO-ERROR.
                   
                   IF  AVAIL doc-fiscal THEN DO:
                       ASSIGN doc-fiscal.ind-sit-doc = 2.

                       FIND FIRST b-nota-fiscal 
                            WHERE b-nota-fiscal.cod-estabel = doc-fiscal.cod-estabel 
                              AND b-nota-fiscal.serie       = doc-fiscal.serie 
                              AND b-nota-fiscal.nr-nota-fis = doc-fiscal.nr-doc-fis EXCLUSIVE-LOCK NO-ERROR.
                       IF AVAIL b-nota-fiscal THEN
                           ASSIGN b-nota-fiscal.dt-at-ofest = TODAY.
                       FIND CURRENT b-nota-fiscal NO-LOCK NO-ERROR.
                   END.

               END.

           END. /* END IF NOT l-erro-of-re */
           
       END. /* IF  b-param-of.dt-congela <> ?  */
       
   END. /* IF  AVAIL b-param-of */
   
   RELEASE doc-fiscal NO-ERROR.
 
   RETURN "OK":U.
 
END PROCEDURE.
