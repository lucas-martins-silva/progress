PROCEDURE consistNotaDevolCli :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    def input param piSerie      like nota-fiscal.serie          no-undo.
    def input param piNrNotaFis  like nota-fiscal.nr-nota-fis    no-undo.
    def input param piitem       like it-nota-fisc.it-codigo     no-undo.
    def input param piseqitem    like it-nota-fisc.nr-seq-fat    no-undo.
    def output param piRwNotaFis as rowid                        no-undo.
    def var         c-msg-liter  as char format "x(20)"          no-undo.
    def var i-idi-sit-nf-eletro  as integer                      no-undo.
	
	DEFINE VARIABLE c-aux-titulo        AS CHARACTER NO-UNDO.
    DEFINE VARIABLE c-aux-help          AS CHARACTER NO-UNDO.
    DEFINE VARIABLE l-saldo-terc-aberto AS LOGICAL   NO-UNDO.
    DEFINE VARIABLE l-ent-fat-ent-futur AS LOGICAL   NO-UNDO.
    DEFINE VARIABLE l-ent-rem-ent-futur AS LOGICAL   NO-UNDO.
    DEFINE BUFFER bf-natur-oper FOR natur-oper.
    
    if  not avail RowObject then 
        RETURN "NOK":U.
        

    find nota-fiscal
        where nota-fiscal.cod-estabel   = RowObject.cod-estabel 
          and nota-fiscal.serie         = piSerie
          and nota-fiscal.nr-nota-fis   = piNrNotaFis
        no-lock no-error.
        
    if  not avail nota-fiscal then do:
        /* Inicio -- Projeto Internacional */
        DEFINE VARIABLE c-lbl-liter-nota-fiscal AS CHARACTER NO-UNDO.
        {utp/ut-liter.i "Nota_Fiscal" *}
        ASSIGN c-lbl-liter-nota-fiscal = TRIM(RETURN-VALUE).
        {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="EMS":U
                            &ErrorSubType="ERROR":U 
                            &ErrorParameters="c-lbl-liter-nota-fiscal"}
         RETURN "NOK":U.                             
    end.        
    ELSE DO:
	
        ASSIGN l-ent-fat-ent-futur = l-fatura-ent-futura.  /* natureza da nota de entrada Ç fatura de entrega futura ou n∆o. */
        ASSIGN l-ent-rem-ent-futur = l-remessa-ent-futura. /* natureza da nota de entrada Ç remessa de entrega futura ou n∆o. */

        IF &IF '{&bf_dis_versao_ems}' >= '2.07' &THEN
          nota-fiscal.cod-chave-aces-nf-eletro
          &ELSE
          SUBSTRING(nota-fiscal.char-2,3,60)
          &ENDIF <> "" THEN DO:
              &IF "{&bf_dis_versao_ems}":U >= "2.07":U &THEN
                  ASSIGN i-idi-sit-nf-eletro = nota-fiscal.idi-sit-nf-eletro.
              &ELSE
                   FOR FIRST sit-nf-eletro FIELDS(idi-sit-nf-eletro) WHERE
                             sit-nf-eletro.cod-estabel   = nota-fiscal.cod-estabel AND
                             sit-nf-eletro.cod-serie     = nota-fiscal.serie       AND
                             sit-nf-eletro.cod-nota-fisc = nota-fiscal.nr-nota-fis  NO-LOCK:
                       ASSIGN i-idi-sit-nf-eletro        = sit-nf-eletro.idi-sit-nf-eletro.
                   END.
              &ENDIF
              
              IF i-idi-sit-nf-eletro <> 3 /*<> Uso Autorizado*/ THEN DO:
                  {method/svc/errors/inserr.i
                                &ErrorNumber="53854"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U }
                  return "NOK":U.
              END.

        END.


        if nota-fiscal.dt-emis-nota > RowObject.dt-emissao then do:
            {utp/ut-liter.i "Data_de_emiss∆o_da_nota_de_sa°da" * R}
            assign c-msg-liter = return-value.
            {utp/ut-liter.i "data_de_emiss∆o_da_devoluá∆o" * R}
            
            {method/svc/errors/inserr.i
                                &ErrorNumber="17085"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U 
                                &ErrorParameters="c-msg-liter + '~~~~' + return-value"}
            RETURN "NOK":U.
        end.
        if  nota-fiscal.cod-emitente <> docum-est.cod-emitente then do:
        

            {method/svc/errors/inserr.i
                                &ErrorNumber="15683"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U 
                                &ErrorParameters="nota-fiscal.nr-nota-fis + '~~~~' + string(docum-est.cod-emitente)"}
            RETURN "NOK":U.                                
        end.
        

        if  nota-fiscal.dt-confirma = ? then do:
            {method/svc/errors/inserr.i
                                &ErrorNumber="6328"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U }
            RETURN "NOK":U.                                
        end.
        

        if  nota-fiscal.dt-cancela <> ? then do:
            {method/svc/errors/inserr.i
                                &ErrorNumber="7151"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U }
            RETURN "NOK":U.                                
        end.
        

        if  nota-fiscal.ind-tip-nota = 8 then do: 
            {method/svc/errors/inserr.i
                                &ErrorNumber="25332" /* Nota selecionada Ç de entrada. N∆o pode ser devolvida*/
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U }
            RETURN "NOK":U.                                
        end.
        

        run findNaturOper ( nota-fiscal.nat-operacao ).
        

        if  return-value <> "OK":U then
            return "NOK":U.

        if l-item then do:

            find first it-nota-fisc             
                where  it-nota-fisc.cod-estabel  = nota-fiscal.cod-estabel 
                and    it-nota-fisc.serie        = nota-fiscal.serie       
                and    it-nota-fisc.nr-nota-fis  = nota-fiscal.nr-nota-fis 
                and    it-nota-fisc.nr-seq-fat   = piseqitem
                and    it-nota-fisc.it-codigo    = piitem   no-lock no-error.
                
            find first natur-oper 
                where natur-oper.nat-operacao = it-nota-fisc.nat-operacao no-lock no-error.
                
        end.
        
        if avail natur-oper and natur-oper.transf and l-dev-transf = no then do: /* N∆o pode ser utilizada para devoluá∆o */
                {method/svc/errors/inserr.i
                                &ErrorNumber="30034"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U}
        end.
        
        if avail natur-oper and natur-oper.transf = no and l-dev-transf = yes then do: /*NF de sa°da inv†lida para devoluá∆o de transferància*/
                {method/svc/errors/inserr.i
                                &ErrorNumber="57952"
                                &ErrorType="EMS":U
                                &ErrorSubType="ERROR":U}
        end.

        assign piRwNotaFis = rowid(nota-fiscal)
               rw-nota-fis = rowid(nota-fiscal).
               
        FIND bf-natur-oper WHERE bf-natur-oper.nat-operacao = RowObject.nat-operacao NO-LOCK NO-ERROR.

        /* include que contem a logica para identificar se a natureza da nota de sa°da Ç fatura faturamento antecipado, 
           remessa faturamento antecipado, fatura entrega futura ou remessa entrega futura */
        {cdp/cd9700.i1 bf-natur-oper}

        IF AVAIL(bf-natur-oper)
            AND l-ent-fat-ent-futur                    /* A natureza de entrada Ç fatura de entrega futura */
            AND bf-natur-oper.especie-doc = "NFD"      /* EspÇcie do documento Ç de devoluá∆o */
            AND bf-natur-oper.tipo-compra = 3 THEN DO: /* 'Tipo compra' da natureza Ç 'Devoluá∆o cliente' */   
            /* Ç devoluá∆o de fatura de entrega futura... */           

            IF  NOT l-fatura-ent-futura THEN DO: /* nota de sa°da n∆o Ç fatura com entrega futura */
                {utp/ut-liter.i Nota_fiscal_informada_n∆o_Ç_do_tipo_'Fatura_Entrega_Futura'. *}
                ASSIGN c-aux-titulo = RETURN-VALUE.
                {utp/ut-liter.i A_nota_fiscal_informada_para_devoluá∆o_deve_ser_do_tipo_'Fatura_Entrega_Futura'. *}
                ASSIGN c-aux-help = RETURN-VALUE.
                {method/svc/errors/inserr.i 
                        &ErrorNumber     = 17006
                        &ErrorType       = "EMS"
                        &ErrorSubType    = "ERROR"
                        &ErrorParameters = " c-aux-titulo + '~~~~' + c-aux-help"}.
            END.

            /* Verifica se existe saldo em poder de terceiros */
            ASSIGN l-saldo-terc-aberto = NO.
            FOR EACH nota-fiscal 
                WHERE nota-fiscal.cod-estabel = RowObject.cod-estabel
                AND nota-fiscal.serie         = piSerie
                AND nota-fiscal.nr-nota-fis   = piNrNotaFis NO-LOCK,
                EACH it-nota-fisc OF nota-fiscal NO-LOCK,
                FIRST saldo-terc
                WHERE saldo-terc.nro-docto = it-nota-fisc.nr-nota-fis
                AND saldo-terc.cod-estabel = it-nota-fisc.cod-estabel
                AND saldo-terc.serie-docto = it-nota-fisc.serie
                AND saldo-terc.sequencia   = it-nota-fisc.nr-seq-fat
                AND saldo-terc.it-codigo   = it-nota-fisc.it-codigo 
                AND saldo-terc.quantidade  > 0 NO-LOCK:
                
                /* Assim que achar o primeiro j† encerra o laáo de repetiá∆o (Existe saldo em terceiros)*/
                ASSIGN l-saldo-terc-aberto = YES.
                LEAVE.
            END.
            
            IF  l-saldo-terc-aberto = NO THEN DO:
                {utp/ut-liter.i A_nota_fiscal_de_'Fatura_Entrega_Futura'_informada_n∆o_possui_saldo_em_aberto_para_devoluá∆o. *}
                ASSIGN c-aux-titulo = RETURN-VALUE.
                {utp/ut-liter.i A_nota_fiscal_de_'Fatura_Entrega_Futura'_informada_deve_possuir_saldo_em_aberto_para_realizar_a_devoluá∆o. *}
                ASSIGN c-aux-help = RETURN-VALUE. 
                {method/svc/errors/inserr.i 
                        &ErrorNumber     = 17006
                        &ErrorType       = "EMS"
                        &ErrorSubType    = "ERROR"
                        &ErrorParameters = " c-aux-titulo + '~~~~' + c-aux-help"}.
            END.
        END.
        ELSE DO:
            /*14447 - Validaá∆o alterada, removido a especie-doc = "NFD" e l-ent-rem-ent-futur para natureza de retorno beneficiamento*/
            IF  NOT (bf-natur-oper.tipo-compra = 3)               /* 'Tipo compra' da natureza Ç 'Devoluá∆o cliente'  */        
                AND (l-fatura-ent-futura OR l-remessa-ent-futura) /* nota de sa°da Ç 'entrega futura'                 */
		THEN DO:
                IF AVAIL(natur-oper)
                   AND natur-oper.terceiros
                   AND natur-oper.tp-oper-terc <> 4  /* Faturamento Consignaá∆o */  
                   AND natur-oper.tp-oper-terc <> 7  /* Drawback */ 
                   AND natur-oper.tp-oper-terc <> 2  /* 14447 - Retorno Beneficiamento - fatura entrega futura */ THEN DO: 
                        {method/svc/errors/inserr.i
                                                                &ErrorNumber="25331"
                                                                &ErrorType="EMS":U
                                                                &ErrorSubType="ERROR":U}
                        RETURN "NOK":U.
                END.
            END.              			
        END.
    END.

    {method/svc/custom/custom.i &Event = "AfterConsistNotaDevolCli"}        

    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN 
        RETURN "NOK":U.
    

    RETURN "OK":U.                                
        


END PROCEDURE.




procedure setconstraintnotafiscal:
    def input param p-l-item as log no-undo.

    assign l-item = p-l-item.

end procedure.
