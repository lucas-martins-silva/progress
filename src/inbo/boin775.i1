/***********************************************************************************
* Temp-tables utilizadas na boin775.p e mla0170rp.p                                *
*                                                                                  *
* situacao: 'Mantido', 'Novo', 'Substitu¡do', 'Eliminado', 'Origem', 'Transferido' * 
* id-sit  :     1    ,    2  ,       3      ,       4    ,     5   ,       6       * 
* r-rowid : rowid do registro alterado,exclu¡do ou inserido.       ,               * 
***********************************************************************************/ 
DEFINE TEMP-TABLE tt-mla-perm-lotacao-origem NO-UNDO LIKE mla-perm-lotacao 
    FIELD situacao AS CHAR FORMAT "x(20)"                                
    FIELD id-sit   AS INT                                   
    FIELD r-rowid  AS ROWID                                 
    INDEX codigo ep-codigo                                  
                 cod-usuar                                  
                 cod-lotacao  ASC                           
                 situacao.     

DEFINE TEMP-TABLE tt-mla-perm-lotacao-destino NO-UNDO LIKE tt-mla-perm-lotacao-origem.
