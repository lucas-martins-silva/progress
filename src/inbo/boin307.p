    DEFINE OUTPUT PARAMETER pcod-evento LIKE evento-trib-fila.cod-evento NO-UNDO.
    DEFINE OUTPUT PARAMETER pseq-evento LIKE evento-trib-fila.seq-evento NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
