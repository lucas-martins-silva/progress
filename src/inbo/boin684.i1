/*** Include:    BOIN684.I1 (adaptada da trigger TWIN172.I1)
     Objetivo:   Valida‡Æo de Grava‡Æo do item-uni-estab

     Parƒmetros: {1} - Item Anterior … Grava‡Æo (na trigger cont‚m b-old-item
                 {2} - Item atual (na trigger cont‚m item)
                 {3} - Indicador de novo registro (cont‚m "not available")      */

/*** Valida‡äes do item ***/

PROCEDURE pi-validate-item:

    /*** Cria‡Æo do item ***/
    if  not avail param-global then 
        return 'parglb'.
 
    if avail {2} then do:
 
        /*** Valida‡äes programa cdp/cd1112 ***/
        
        find item
            where item.it-codigo = {2}.it-codigo no-lock no-error.
        
        if  {1}.lote-multipl <> {2}.lote-multipl 
        and {2}.lote-multipl <> truncate({2}.lote-multipl,0) 
        and not item.fraciona  then 
            return 'itfrac':U.
         
        if ({1}.politica     <> {2}.politica      
        or  {1}.periodo-fixo <> {2}.periodo-fixo  
        or  {1}.lote-economi <> {2}.lote-economi) then do:
            
            if  {2}.politica = 2
            and {2}.lote-economi = 0 then
                return 'pol-le':U.
        end.    
        
        if  param-global.modulo-co = yes 
        and can-find(first modelo-cf 
                     where modelo-cf.item-criado = {1}.it-codigo) then do:
           if  {1}.politica <> {2}.politica 
           and {2}.politica <> 5 then 
               return 'pol-cf':U. 

            /******
           if  {1}.tipo-con-est <> {2}.tipo-con-est 
           and {2}.tipo-con-est <> 4 then   
               return 'tce-cf':U. 
        **************/
        end.
        
        /*** Se controle de planejamento ‚ da manuten‡Æo industrial
             a pol¡tica s¢ poder  ser per¡odo fixo o lote econ“mico ***/
        if  {1}.politica   <> {2}.politica 
        and {2}.contr-plan  = 2          
        and {2}.politica    > 2 then 
            return 'polpmi':U. 
         
        /*** Tipo de reporte por item nÆo permite tipo de controle debito direto nem
             outra pol¡tica diferente a periodo fixo ou lote econ¢mico ***/
               
        if  {2}.rep-prod   = 4 then do:
                    
            if ({1}.politica  <> {2}.politica  
            or  {2}.rep-prod  <> {1}.rep-prod) 
            and {2}.politica  <>  1           
            and {2}.politica  <>  2 then
                 return 'rp4pol':U.
        end.
        
        /*** Tempo de resuprimento do item nÆo pode ser menor que nenhum tempo de reserva 
             de nenhuma estrutura ativa ou a ser ativada ***/
        find first estrutura 
            where estrutura.it-codigo     = {2}.it-codigo     
              and estrutura.tempo-reserv <> ?                
              and estrutura.tempo-reserv  > item.ressup-fabri 
              and estrutura.data-termino  > today no-lock no-error.
        if  available estrutura then
            return 'resfab':U.           
    end.
     
 /************
    /*** Valida a altera‡Æo do tipo-con-est ***/
    if  {1}.tipo-con-est <> {2}.tipo-con-est
    and can-find(first saldo-estoq 
                 where saldo-estoq.cod-estabel = {1}.cod-estabel
                   and saldo-estoq.it-codigo   = {1}.it-codigo) then
        return 'con-est'.
*************/
   
    return 'ok':U.

END PROCEDURE. /*** pi-validate-item ***/

/* Fim do include */
