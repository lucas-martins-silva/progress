/* Defini‡Æo das vari veis necess rias ao setConstraint2 */
def var c-inicial as char no-undo.

/* Defini‡Æo das vari veis necess rias ao setConstraint3 */
def var c-cd-produto-ini as char no-undo.

procedure setConstraint1:
end procedure.

procedure setConstraint2:
 def input parameter p-inicial as char.
 assign c-inicial = p-inicial.
end procedure.
 
procedure setConstraint3:
 def input param p-cd-produto-ini as char.
   assign c-cd-produto-ini = p-cd-produto-ini.
end procedure.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock INDEXED-REPOSITION.
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where 
            produto.descricao >= c-inicial no-lock INDEXED-REPOSITION.            
	    when 3 then 
			open query {&QUERY-NAME} for each {&TABLE-NAME} where 
			produto.cd-produto >= c-cd-produto-ini no-lock INDEXED-REPOSITION.            
    end case.
    assign l-query = true
           i-bo-query = i-abertura.
end procedure.
 
