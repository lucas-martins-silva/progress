&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram  
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice codigo
  Parameters:  
               recebe valor do campo mo-codigo
               recebe valor do campo sequencia
               recebe valor do campo it-codigo
               recebe valor do campo fm-codigo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pmo-codigo LIKE estr-modelo.mo-codigo NO-UNDO.
    DEFINE INPUT PARAMETER psequencia LIKE estr-modelo.sequencia NO-UNDO.
    DEFINE INPUT PARAMETER pit-codigo LIKE estr-modelo.it-codigo NO-UNDO.
    DEFINE INPUT PARAMETER pfm-codigo LIKE estr-modelo.fm-codigo NO-UNDO.

    FIND FIRST bfestr-modelo WHERE 
        bfestr-modelo.mo-codigo = pmo-codigo AND 
        bfestr-modelo.sequencia = psequencia AND 
        bfestr-modelo.it-codigo = pit-codigo AND 
        bfestr-modelo.fm-codigo = pfm-codigo NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfestr-modelo THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfestr-modelo)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

