PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice codigo
  Parameters:  
               retorna valor do campo mo-codigo
               retorna valor do campo sequencia
               retorna valor do campo it-codigo
               retorna valor do campo fm-codigo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pmo-codigo LIKE estr-modelo.mo-codigo NO-UNDO.
    DEFINE OUTPUT PARAMETER psequencia LIKE estr-modelo.sequencia NO-UNDO.
    DEFINE OUTPUT PARAMETER pit-codigo LIKE estr-modelo.it-codigo NO-UNDO.
    DEFINE OUTPUT PARAMETER pfm-codigo LIKE estr-modelo.fm-codigo NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pmo-codigo = RowObject.mo-codigo
           psequencia = RowObject.sequencia
           pit-codigo = RowObject.it-codigo
           pfm-codigo = RowObject.fm-codigo.

    RETURN "OK":U.
