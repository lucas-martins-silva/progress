/*Variaveis usadas na comunicacao da FecharOperacao e FecharSplit com a SetaParametros*/
def var l-fechar-operacao-online              as log init no  no-undo.
def var l-encerra-ordem-ultima-operacao       as log init no  no-undo.
def var l-encer-ordem-operac-incompl          as log init no  no-undo.
def var l-oper-ante-encerrada                 as log init no  no-undo.
def var l-msg-finaliza-split-operac-BO        as log init no  no-undo.
def var l-msg-finaliza-operac-BO              as log init no  no-undo.
def var i-regra-finaliza-como-BO              as int init 1   no-undo.
def var i-regra-finaliza-quando-quant-BO      as int init 3   no-undo.
def var de-qtd-validada-BO                    as dec init 0   no-undo.
def var l-ja-respondeu                        as log init no  no-undo.


def var de-val-apont-max                      as decimal     no-undo.
def var h-cpapi301 as handle no-undo.

{cdp/cdcfgman.i}   /*preprocessadores manufatura*/
{cpp/cpapi301.i}   /*temp-tables da cpapi301, apenas para possibilitar execucao persistente*/ 
{inbo/boin536.i11} /*temp-table de parametros tt-param-split*/

/*******************************************************************************************************
**
** PROCEDURE:  FecharSplit
** OBJETIVO:   Finalizaá∆o do Split de Operaá∆o
** PARAMETROS: buffer b-split-operac
**
*******************************************************************************************************/
PROCEDURE FecharSplit:
   define parameter buffer b-split-operac for split-operac.

    IF CAN-FIND(FIRST funcao
                WHERE funcao.cd-funcao = "spp-UsaRegraFinalizacaoAntiga"  // a liberaá∆o desta funá∆o ser† apenas emergencial, conforme o suporte vir necessidade.
                  AND funcao.ativo     = YES) 
    THEN DO:
        if log-manager:logging-level > 2 then 
               LOG-MANAGER:WRITE-MESSAGE ("***Ponto999 BOIN536 pi-FecharSplit-Antigo","RegraFinal").

        RUN pi-FecharSplit-Antigo (BUFFER b-split-operac).
    END.
    ELSE DO:
        if log-manager:logging-level > 2 then 
               LOG-MANAGER:WRITE-MESSAGE ("***Ponto998 BOIN536 pi-FecharSplit-Novo","RegraFinal").

        RUN pi-FecharSplit-Novo (BUFFER b-split-operac).
    END.
    
   return "OK":U.
end procedure.    


/*******************************************************************************************************
**
** PROCEDURE:  pi-FecharSplit-Antigo
** OBJETIVO:   Finalizaá∆o do Split de Operaá∆o
** PARAMETROS: buffer b-split-operac
**
*******************************************************************************************************/
PROCEDURE pi-FecharSplit-Antigo:
   define parameter buffer b-split-operac for split-operac.
   
   define buffer bfb-split-operac for split-operac.
   define buffer b1-split-operac for split-operac.
   
   if avail b-split-operac then do:

       if not can-find(first bfb-split-operac 
                       where bfb-split-operac.nr-ord-produ     = b-split-operac.nr-ord-produ
                         and bfb-split-operac.num-operac-sfc   = b-split-operac.num-operac-sfc
                         and bfb-split-operac.ind-estado-split < 5
                         and rowid(bfb-split-operac)           <> rowid(b-split-operac)) then do:
                         
             /**Este Split Ç o £nico ainda aberto para a operaá∆o, ent∆o chama a procedure de Fechar Operaá∆o******/            
             find first oper-ord exclusive-lock
                  where oper-ord.nr-ord-produ   = b-split-operac.nr-ord-produ
                    and oper-ord.num-operac-sfc = b-split-operac.num-operac-sfc no-error.
             run FecharOperacao(buffer oper-ord).
             if return-value = "NOK":U then
                 return "NOK":U.
       end.
       else do:
             if l-fechar-operacao-online then                                                                
                 /*Confirma encerramento do Split de Operaá∆o &1?*/
                 
                 run utp/ut-msgs.p (input "show":U,                                                          
                                    input 32472,                                                             
                                    input trim(string(b-split-operac.nr-ord-produ,">>>,>>>,>>9":U)) + " / ":U +  
                                          trim(b-split-operac.it-codigo) + " / ":U +                             
                                          trim(b-split-operac.cod-roteiro) + " / ":U +                           
                                          trim(string(b-split-operac.op-codigo)) + " / ":U +
                                          trim(string(b-split-operac.num-split-operac))).
             if l-fechar-operacao-online = no or return-value = 'yes':U then do:
                 find first split-operac where rowid(split-operac) = rowid(b-split-operac) exclusive-lock no-error.
                 assign split-operac.ind-estado-split = 5.
                 
                 find first oper-ord where
                        oper-ord.nr-ord-produ = split-operac.nr-ord-produ and
                        oper-ord.it-codigo   = split-operac.it-codigo    and
                        oper-ord.cod-roteiro = split-operac.cod-roteiro  and
                        oper-ord.op-codigo   = split-operac.op-codigo    no-lock no-error.
                 if can-find(first oper-ord where
                        oper-ord.nr-ord-produ = split-operac.nr-ord-produ and
                        oper-ord.it-codigo   = split-operac.it-codigo    and
                        oper-ord.cod-roteiro = split-operac.cod-roteiro and
                        oper-ord.op-codigo   = split-operac.op-codigo and
                        (oper-ord.qtd-previs-operac <= (oper-ord.qtd-reptda-sfc + oper-ord.qtd-refgda-sfc + oper-ord.qtd-retrab-sfc) or
                        (de-val-apont-max <= (oper-ord.qtd-reptda-sfc + oper-ord.qtd-refgda-sfc + oper-ord.qtd-retrab-sfc) and
                        l-oper-ante-encerrada = yes))) then do:
                         if can-find(first b1-split-operac where
                                b1-split-operac.nr-ord-produ      = split-operac.nr-ord-produ     and
                                b1-split-operac.num-operac-sfc    = split-operac.num-operac-sfc   and
                                b1-split-operac.num-split-operac <> split-operac.num-split-operac and
                                b1-split-operac.ind-estado-split <> 5)                            and 
                                l-fechar-operacao-online then do:
                                
                                {utp/ut-liter.i Deseja_tambÇm_encerrar_os_outros_splits_dessa_mesma_operaá∆o_? *}
                                run utp/ut-msgs.p (input "show":U,
                                                   input 27100,
                                                   input return-value).
                                if return-value = "yes" then do:
                                        for each b1-split-operac where
                                                b1-split-operac.nr-ord-produ      = split-operac.nr-ord-produ     and
                                                b1-split-operac.num-operac-sfc    = split-operac.num-operac-sfc   and
                                                b1-split-operac.num-split-operac <> split-operac.num-split-operac and
                                                b1-split-operac.ind-estado-split <> 5 exclusive-lock:
                                                assign b1-split-operac.ind-estado-split = 5.
                                                
                                        end.
                                        find first oper-ord exclusive-lock where
                                                oper-ord.nr-ord-produ   = split-operac.nr-ord-produ and
                                                oper-ord.num-operac-sfc = split-operac.num-operac-sfc no-error.
                                            run FecharOperacao(buffer oper-ord).
                                end.
                         end.       
                 end.
             end.
       end.
   end.
   else
       return "NOK":U.
       
   release split-operac.
   release oper-ord.
   
   return "OK":U.
end procedure.


/*******************************************************************************************************
**
** PROCEDURE:  pi-FecharSplit-Novo
** OBJETIVO:   Finalizaá∆o do Split de Operaá∆o
** PARAMETROS: buffer b-split-operac
**
*******************************************************************************************************/
PROCEDURE pi-FecharSplit-Novo:
   define parameter buffer b-split-operac for split-operac.
   
   define buffer bfb-split-operac for split-operac.
   define buffer b1-split-operac  for split-operac.
   define buffer bs-oper-ord      for oper-ord.
   
   define var    l-perguntou      as logical init NO NO-UNDO.
   
   if avail (b-split-operac) then do:
   
       // REGRA Finalizaá∆o
       CASE i-regra-finaliza-quando-quant-BO:
           WHEN 1 THEN
               ASSIGN de-qtd-validada-BO = b-split-operac.qtd-operac-reptda.
           WHEN 2 THEN
               ASSIGN de-qtd-validada-BO = b-split-operac.qtd-operac-aprov.
           WHEN 3 THEN DO:
               ASSIGN de-qtd-validada-BO = b-split-operac.qtd-previs-operac.
           END.
       END CASE.

       assign l-perguntou = NO.  // Controlar se houve pergunta
       
       if (l-fechar-operacao-online       and 
           i-regra-finaliza-como-BO = 2   and
           l-msg-finaliza-split-operac-BO and
           de-qtd-validada-BO >= b-split-operac.qtd-previs-operac) then do:                                                               
         /*Confirma encerramento do Split de Operaá∆o &1?*/
         
         assign l-perguntou = YES.  // Controlar se houve pergunta
         
         run utp/ut-msgs.p (input "show":U,                                                          
                            input 32472,                                                             
                            input trim(string(b-split-operac.nr-ord-produ,">>>,>>>,>>9":U)) + " / ":U +  
                                  trim(b-split-operac.it-codigo) + " / ":U +                             
                                  trim(b-split-operac.cod-roteiro) + " / ":U +                           
                                  trim(string(b-split-operac.op-codigo)) + " / ":U +
                                  trim(string(b-split-operac.num-split-operac))).
         
       end.
       
       if l-perguntou = yes and return-value = 'no':U 
          then RETURN "OK":U.  // Se respondeu n∆o pro split j† retorna       


       if log-manager:logging-level > 2 then 
          LOG-MANAGER:WRITE-MESSAGE ( "***Ponto001 BOIN536 FecharSplit" + 
                                      ", l-fechar-operacao-online: " + STRING (l-fechar-operacao-online) +
                                      ", Finaliza Ordem l-encerra-ordem-ultima-operacao: " + STRING (l-encerra-ordem-ultima-operacao) +
                                      ", l-msg-finaliza-split-operac-BO: " + STRING (l-msg-finaliza-split-operac-BO) +
                                      ", l-msg-finaliza-operac-BO: " + STRING (l-msg-finaliza-operac-BO) + 
                                      ", i-regra-finaliza-como-BO: " + STRING (i-regra-finaliza-como-BO) + 
                                      ", i-regra-finaliza-quando-quant-BO: " + STRING (i-regra-finaliza-quando-quant-BO) +
                                      ", de-qtd-validada-BO: " + STRING (de-qtd-validada-BO) +
                                      ", b-split-operac.qtd-previs-operac: " + STRING (b-split-operac.qtd-previs-operac),"RegraFinal").
      
       if ( (l-fechar-operacao-online = no  OR (l-perguntou = no and l-fechar-operacao-online = yes)) AND
            (de-qtd-validada-BO >= b-split-operac.qtd-previs-operac AND l-msg-finaliza-split-operac-BO)  AND l-perguntou = no) OR  
          (l-perguntou = yes and return-value = 'yes':U) then do:
          
          find first split-operac where rowid(split-operac) = rowid(b-split-operac) exclusive-lock no-error.
          assign split-operac.ind-estado-split = 5.
          
       end.
       
       if (l-msg-finaliza-operac-BO = NO AND l-encerra-ordem-ultima-operacao = NO) AND
          l-fechar-operacao-online = no then RETURN "OK":U.  // Se n∆o Ç pra encerrar a Operaá∆o e Ordem, j† volta daqui.

       find first bs-oper-ord 
            where bs-oper-ord.nr-ord-produ    = b-split-operac.nr-ord-produ 
              and bs-oper-ord.num-operac-sfc = b-split-operac.num-operac-sfc no-lock no-error. // tornar exclusive-lock dentro do FecharOperacao

       if not avail (bs-oper-ord) then do:
          run criaErro(input 437,
                       input "":U).
          RETURN "NOK":U.
       end.
       
       // REGRA Finalizaá∆o
       CASE i-regra-finaliza-quando-quant-BO:
           WHEN 1 THEN
               ASSIGN de-qtd-validada-BO = bs-oper-ord.qtd-reptda-sfc.  // na operaá∆o o reportado Ç a soma de aprovada e refugada
           WHEN 2 THEN
               ASSIGN de-qtd-validada-BO = bs-oper-ord.qtd-aprov-sfc.
           WHEN 3 THEN
               ASSIGN de-qtd-validada-BO = bs-oper-ord.qtd-previs-operac. // verificar se quando aponta Zero vai fechar... n∆o deveria
       END CASE.

       if log-manager:logging-level > 2 then 
          LOG-MANAGER:WRITE-MESSAGE ("***Ponto002 BOIN536 FecharSplit" + 
                                     ", Saldo Operacao Anterior de-val-apont-max: " + STRING (de-val-apont-max) +
                                     ", l-encer-ordem-operac-incompl: " + STRING (l-encer-ordem-operac-incompl) +
                                     ", Finaliza Ordem l-encerra-ordem-ultima-operacao: " + STRING (l-encerra-ordem-ultima-operacao) +
                                     ", bs-oper-ord.qtd-reptda-sfc: " + STRING (bs-oper-ord.qtd-reptda-sfc) +
                                     ", l-msg-finaliza-operac-BO: " + STRING (l-msg-finaliza-operac-BO) + 
                                     ", l-oper-ante-encerrada: " + STRING (l-oper-ante-encerrada) + 
                                     ", i-regra-finaliza-quando-quant-BO: " + STRING (i-regra-finaliza-quando-quant-BO) +
                                     ", de-qtd-validada-BO: " + STRING (de-qtd-validada-BO) +
                                     ", bs-oper-ord.qtd-previs-operac: " + STRING (bs-oper-ord.qtd-previs-operac),"RegraFinal").

       IF de-val-apont-max > 0 AND l-encer-ordem-operac-incompl = NO  // Valida se tem saldo ainda em operacao anterior
       THEN RETURN "OK":U.

       if not can-find(first bfb-split-operac 
                       where bfb-split-operac.nr-ord-produ     = b-split-operac.nr-ord-produ
                         and bfb-split-operac.num-operac-sfc   = b-split-operac.num-operac-sfc
                         and bfb-split-operac.ind-estado-split < 5
                         and rowid(bfb-split-operac)           <> rowid(b-split-operac)) then do:
             
            /**Este Split Ç o £nico ainda aberto para a operaá∆o, ent∆o chama a procedure de Fechar Operaá∆o******/   
            if log-manager:logging-level > 2 then 
               LOG-MANAGER:WRITE-MESSAGE ("***Ponto002A BOIN536 FecharSplit" + 
                                          ", Saldo Operacao Anterior de-val-apont-max: " + STRING (de-val-apont-max) +
                                          ", l-encer-ordem-operac-incompl: " + STRING (l-encer-ordem-operac-incompl) +
                                          ", bs-oper-ord.qtd-previs-operac: " + STRING (bs-oper-ord.qtd-previs-operac),"RegraFinal").
         
                  
            if (bs-oper-ord.qtd-previs-operac <= de-qtd-validada-BO and 
                (l-msg-finaliza-operac-BO OR (l-encerra-ordem-ultima-operacao AND bs-oper-ord.log-operac-final))) OR 
               l-encer-ordem-operac-incompl then do:
               run FecharOperacao(buffer bs-oper-ord). // Aqui o NOK Ç s¢ pra sair n∆o Ç um erro...
               if return-value = "NOK":U then
                   return "OK":U.
            end.
       end.
       else do:

            if (bs-oper-ord.qtd-previs-operac <= de-qtd-validada-BO AND l-oper-ante-encerrada = yes) OR 
               (l-encerra-ordem-ultima-operacao AND bs-oper-ord.log-operac-final) OR
               l-encer-ordem-operac-incompl then do:
                               
                if log-manager:logging-level > 2 then 
                   LOG-MANAGER:WRITE-MESSAGE ("***Ponto002B BOIN536 FecharSplit" + 
                                              ", Saldo Operacao Anterior de-val-apont-max: " + STRING (de-val-apont-max) +
                                              ", l-encer-ordem-operac-incompl: " + STRING (l-encer-ordem-operac-incompl) +
                                              ", bs-oper-ord.qtd-previs-operac: " + STRING (bs-oper-ord.qtd-previs-operac),"RegraFinal").

           
                assign l-perguntou    = NO  // Controlar se houve pergunta
                       l-ja-respondeu = NO. // Verificar se j† respondeu a pergunta 27100 pra n∆o fazer a pergunta 17989
                
                if can-find(first b1-split-operac 
                            where b1-split-operac.nr-ord-produ      = b-split-operac.nr-ord-produ     
                              and b1-split-operac.num-operac-sfc    = b-split-operac.num-operac-sfc   
                              and b1-split-operac.num-split-operac <> b-split-operac.num-split-operac 
                              and b1-split-operac.ind-estado-split <> 5)                              
                   AND (l-fechar-operacao-online     AND 
                        i-regra-finaliza-como-BO = 2 AND
                        l-msg-finaliza-operac-BO     AND
                        de-qtd-validada-BO >= bs-oper-ord.qtd-previs-operac) then do: // Regra Finalizaá∆o
                       
                       assign l-perguntou    = YES  // Controlar se houve pergunta
                              l-ja-respondeu = YES. // Verificar se j† respondeu a pergunta 27100 pra n∆o fazer a pergunta 17989

                       {utp/ut-liter.i Confirma_encerrar_esta_Operaá∆o_e_todos_os_seus_splits_? *}
                       run utp/ut-msgs.p (input "show":U,
                                          input 27100,
                                          input return-value).
                end.
                
                if l-perguntou = yes and return-value = 'no':U
                   then RETURN "OK":U.  // Se respondeu n∆o j† retorna
                
                if ( (l-fechar-operacao-online = no  OR (l-perguntou = no and l-fechar-operacao-online = yes)) AND
                     (de-qtd-validada-BO >= bs-oper-ord.qtd-previs-operac AND (l-msg-finaliza-operac-BO OR (l-encerra-ordem-ultima-operacao AND bs-oper-ord.log-operac-final)))  AND l-perguntou = no) OR  
                   (l-perguntou = yes and return-value = 'yes':U) then do:
               
                   if ( (l-fechar-operacao-online = no  OR (l-perguntou = no and l-fechar-operacao-online = yes)) AND
                        (de-qtd-validada-BO >= bs-oper-ord.qtd-previs-operac AND (l-msg-finaliza-operac-BO ))  AND l-perguntou = no) OR  
                      (l-perguntou = yes and return-value = 'yes':U) then do:       // Fechar splits apenas se deseja fechar Operaá∆o, pois caso precise fechar a Ordem a pergunta ainda n∆o foi feita

                           for each b1-split-operac where
                                    b1-split-operac.nr-ord-produ      = b-split-operac.nr-ord-produ     and
                                    b1-split-operac.num-operac-sfc    = b-split-operac.num-operac-sfc   and
                                    b1-split-operac.num-split-operac <> b-split-operac.num-split-operac and
                                    b1-split-operac.ind-estado-split <> 5 exclusive-lock:
        
                               assign b1-split-operac.ind-estado-split = 5.
                                   
                           end.
                   end.
                   
                   run FecharOperacao(buffer bs-oper-ord).   // chamar apenas fecha a Operaá∆o OU a Ordem
                end.
                           
            end.
       end.
   end.
   else do:
       run criaErro(input 27260,
                    input "":U).
       return "NOK":U.
   end.
       
   release split-operac.
   release oper-ord.
   
   return "OK":U.
end procedure.

/*******************************************************************************************************
**
** PROCEDURE:  FecharOperacao
** OBJETIVO:   Finalizaá∆o da operaá∆o da ordem
** PARAMETROS: buffer b-oper-ord
**
*******************************************************************************************************/
PROCEDURE FecharOperacao:
    define parameter buffer b-oper-ord for oper-ord.
    

    IF CAN-FIND(FIRST funcao
                WHERE funcao.cd-funcao = "spp-UsaRegraFinalizacaoAntiga"  // a liberaá∆o desta funá∆o ser† apenas emergencial, conforme o suporte vir necessidade.
                  AND funcao.ativo     = YES) 
    THEN DO:
        if log-manager:logging-level > 2 then 
               LOG-MANAGER:WRITE-MESSAGE ("***Ponto999 BOIN536 pi-FecharOperacao-Antigo","RegraFinal").
       
        RUN pi-FecharOperacao-Antigo (BUFFER b-oper-ord).
    END.
    ELSE DO:
        if log-manager:logging-level > 2 then 
               LOG-MANAGER:WRITE-MESSAGE ("***Ponto998 BOIN536 pi-FecharOperacao-Novo","RegraFinal").

        RUN pi-FecharOperacao-Novo (BUFFER b-oper-ord).
    END.

return "OK":U.
END PROCEDURE.

/*******************************************************************************************************
**
** PROCEDURE:  pi-FecharOperacao-Antigo
** OBJETIVO:   Finalizaá∆o da operaá∆o da ordem
** PARAMETROS: buffer b-oper-ord
**
*******************************************************************************************************/
PROCEDURE pi-FecharOperacao-Antigo:
    define parameter buffer b-oper-ord for oper-ord.

    def buffer b2-oper-ord for oper-ord.
    
    def var v-log-erro as logical no-undo.
    def var l-encerra-op as log init no no-undo.
    DEF VAR dt-ult-rep              AS DATE   NO-UNDO.
    DEF VAR c-hr-ult-rep            AS CHAR   NO-UNDO.
    DEF VAR rw-ult-rep              AS ROWID  NO-UNDO.    
    
    find first param-sfc no-lock no-error.    
    
    /*Faz verificaá‰es / alertas ao usu†rio, sobre encerramento da ordem quando se trata da £ltima operacao e, conforme opcao
      do usu†rio, faz o encerramento da referida ordem
      Esta parte do c¢digo estava na b02in535.w, do sf0303*/
      
    if l-fechar-operacao-online              or
       l-encerra-ordem-ultima-operacao       then do:

        find ord-prod where 
             ord-prod.nr-ord-produ = b-oper-ord.nr-ord-produ no-LOCK no-error.
        if  b-oper-ord.log-operac-final then do:
            /* Altera estado da ordem para terminada/finalizada? */
            find first param-global no-lock no-error.
            ASSIGN l-encerra-op = (ord-prod.estado < 7).
            /*Ponto UPC CRISTALIA*/
            if  c-nom-prog-dpc-mg97  <> ""
            or  c-nom-prog-upc-mg97  <> ""
            or  c-nom-prog-appc-mg97 <> "" then do:
        
                for each tt-epc
                    where tt-epc.cod-event = "ANTES-FINALIZA-ORDEM".
                    delete tt-epc.
                end.
        
                {include/i-epc200.i2 &CodEvent='"ANTES-FINALIZA-ORDEM"'
                                     &CodParameter='"inibe-pergunta"'
                                     &ValueParameter='""'}
        
                {include/i-epc201.i "ANTES-FINALIZA-ORDEM"}
        
                find first tt-epc
                    where tt-epc.cod-event     = "ANTES-FINALIZA-ORDEM"
                      and tt-epc.cod-parameter = "inibe-pergunta" no-error.
        
                if  avail tt-epc THEN 
                    IF tt-epc.val-parameter = "INIBE":U THEN
                        ASSIGN l-encerra-op    = NO.
        
                for each tt-epc
                    where tt-epc.cod-event = "ANTES-FINALIZA-ORDEM".
                    delete tt-epc.
                end.
            end.
            /***************************/
            
            IF l-encerra-op THEN DO:
                if l-fechar-operacao-online then do:
                     run utp/ut-msgs.p (input "show":U,
                                        input (if not param-global.modulo-cs 
                                               then 5603
                                               else 5604),
                                        input trim(string(b-oper-ord.nr-ord-produ,">>>,>>>,>>9":U))).
                     ASSIGN l-encerra-op = (RETURN-VALUE = "YES").
                end.
                else
                    assign l-encerra-op = l-encerra-ordem-ultima-operacao.
            END.
            if  l-encerra-op then do:
                /* Verifica se existe operaá∆o n∆o reportada por completo */

                if l-fechar-operacao-online = yes or l-encer-ordem-operac-incompl = no then do:
                    &IF DEFINED(bf_man_206b) &THEN
                    
                        case ord-prod.rep-prod:
                             when 1 then do:
                                    FOR EACH b2-oper-ord
                                        WHERE b2-oper-ord.nr-ord-produ     = b-oper-ord.nr-ord-produ
                                        and   b2-oper-ord.log-operac-final = no 
                                        and   b2-oper-ord.val-perc-avanco  < b-oper-ord.val-perc-avanco
                                        AND   b2-oper-ord.tipo-oper        = 1 NO-LOCK:
                
                                        FIND grup-maquina WHERE grup-maquina.gm-codigo = b2-oper-ord.gm-codigo NO-LOCK NO-ERROR.
                                        IF AVAIL grup-maquina AND grup-maquina.log-pto-control = TRUE THEN DO:
                                            if l-fechar-operacao-online then do:
                                                run utp/ut-msgs.p (input "show":U,
                                                                   input 17987,
                                                                   input trim(string(b-oper-ord.nr-ord-produ,">>>,>>>,>>9":U))).
                        
                                                if  return-value = "no" THEN
                                                    return "nok":U.
                                            end.
                                            else 
                                                return "nok":U.
                                        END.
                                    END.                             
                             end. /*when 1 */
                             when 2 then do:
                                    if  can-find(first b2-oper-ord
                                                 where b2-oper-ord.nr-ord-produ     = b-oper-ord.nr-ord-produ
                                                   and b2-oper-ord.log-operac-final = no 
                                                   and b2-oper-ord.val-perc-avanco  < b-oper-ord.val-perc-avanco
                                                   AND b2-oper-ord.tipo-oper        = 1) then do:
                                        if l-fechar-operacao-online then do:   
                                            run utp/ut-msgs.p (input "show":U,
                                                               input 17987,
                                                               input trim(string(b-oper-ord.nr-ord-produ,">>>,>>>,>>9":U))).
                        
                                            if  return-value = "no":U THEN
                                                return "nok":U.
                                        end.
                                        else 
                                            return "nok":U.
                                    END.                          
                             end. /*when 2*/
                             when 3 then do:
                                    if  can-find(first b2-oper-ord
                                                 where b2-oper-ord.nr-ord-produ      = b-oper-ord.nr-ord-produ
                                                   and b2-oper-ord.log-operac-final  = no 
                                                   and b2-oper-ord.val-perc-avanco   < b-oper-ord.val-perc-avanco
                                                   AND b2-oper-ord.tipo-oper         = 1
                                                   AND b2-oper-ord.pto-controle     <> 0) then do:
                                        if l-fechar-operacao-online then do:        
                                            run utp/ut-msgs.p (input "show":U,
                                                               input 17987,
                                                               input trim(string(b-oper-ord.nr-ord-produ,">>>,>>>,>>9":U))).
                        
                                            if  return-value = "no":U THEN
                                                return "NOK":U.
                                        end.
                                        else 
                                            return "nok":U.                                
                                    END.                                
                             end. /*when 3*/
                        end case.
                        
                    &ELSE /*bf_man_206b*/
        
                        if  can-find(first b2-oper-ord
                                     where b2-oper-ord.nr-ord-produ     = b-oper-ord.nr-ord-produ
                                       and b2-oper-ord.log-operac-final = no 
                                       and b2-oper-ord.val-perc-avanco  < b-oper-ord.val-perc-avanco) then do:
                               if l-fechar-operacao-online then do:         
                                     run utp/ut-msgs.p (input "show":U,
                                                        input (if  param-sfc.log-consid-rede-pert = yes 
                                                               then 17988
                                                               else 17987),
                                                        input trim(string(b-oper-ord.nr-ord-produ,">>>,>>>,>>9":U))).
                        
                                     if  param-sfc.log-consid-rede-pert = no and 
                                         return-value = "no" then
                                         return "NOK":U.
                               end.
                               else
                                     if  param-sfc.log-consid-rede-pert = no then
                                         return "NOK":U.  
                        end.
        
                    &ENDIF /*else bf_man_206b*/
                end. /*if l-fechar-operacao-online or l-encer-ordem-operac-incompl = no */

                if not valid-handle (h-cpapi301) then
                    run cpp/cpapi301.p persistent set h-cpapi301 (input-output table tt-ord-prod,
                                                                  input-output table tt-reapro,
                                                                  input-output table tt-erro,
                                                                  input yes).
                                                                  
                find current ord-prod exclusive-lock no-error.

                run pi-finalizar-ordem-producao in h-cpapi301 (buffer ord-prod,
                                                               input yes). /* Altera estado da ordem */
                
                find current ord-prod no-lock no-error.                
                                               
                return "OK":U.                                               

                /**************************************************************************************************************/
                /*A chamada da bo para integraá∆o com SFC foi movida para a procedure pi-finalizar-ordem-producao, na cpapi301*/
                /**************************************************************************************************************/

            end. /*if  l-encerra-op*/
        end. /*if  b-oper-ord.log-operac-final*/   
    end. /*if l-fechar-operacao-online or l-encerra-ordem-ultima-operacao*/
    
    /*Ponto UPC CRISTALIA*/
    if  c-nom-prog-dpc-mg97  <> ""
    or  c-nom-prog-upc-mg97  <> ""
    or  c-nom-prog-appc-mg97 <> "" then do:

        for each tt-epc
            where tt-epc.cod-event = "ANTES-FINALIZA-OPER".
            delete tt-epc.
        end.

        {include/i-epc200.i2 &CodEvent='"ANTES-FINALIZA-OPER"'
                             &CodParameter='"inibe-pergunta"'
                             &ValueParameter='""'}

        {include/i-epc201.i "ANTES-FINALIZA-OPER"}

        find first tt-epc
            where tt-epc.cod-event     = "ANTES-FINALIZA-OPER"
              and tt-epc.cod-parameter = "inibe-pergunta" no-error.

        if  avail tt-epc THEN 
            IF tt-epc.val-parameter                = "INIBE":U THEN
                ASSIGN l-fechar-operacao-online    = NO.

        for each tt-epc
            where tt-epc.cod-event = "ANTES-FINALIZA-OPER".
            delete tt-epc.
        end.
    end.
    /********************/
    if l-fechar-operacao-online then
        run utp/ut-msgs.p (input "show":U,
                           input 17989,
                           input trim(string(b-oper-ord.nr-ord-produ,">>>,>>>,>>9":U)) + " / ":U + 
                                 trim(b-oper-ord.it-codigo) + " / ":U + 
                                 trim(b-oper-ord.cod-roteiro) + " / ":U + 
                                 trim(string(b-oper-ord.op-codigo))).
        
    if l-fechar-operacao-online = no or return-value = 'yes':U then do:  
    
        RUN FecharOperacaoCascata(buffer b-oper-ord).
    end. /*if l-fechar-operacao-online = no or return-value = 'yes':U*/
    
    IF VALID-HANDLE(h-cpapi301) THEN
		DELETE PROCEDURE h-cpapi301.
    ELSE
        return "NOK":U.

return "OK":U.
END PROCEDURE.


/*******************************************************************************************************
**
** PROCEDURE:  pi-FecharOperacao-Novo
** OBJETIVO:   Finalizaá∆o da operaá∆o da ordem
** PARAMETROS: buffer b-oper-ord
**
*******************************************************************************************************/
PROCEDURE pi-FecharOperacao-Novo:
    define parameter buffer b-oper-ord for oper-ord.

    def buffer b2-oper-ord for oper-ord.
    
    def var v-log-erro              as logical         no-undo.
    def var l-encerra-op            as logical init no no-undo.
    def var l-perguntou             as logical init NO NO-UNDO.
    def var l-inibe-pergunta        as logical init NO NO-UNDO.

    find first param-sfc no-lock no-error.    
    
    /*Ponto UPC CRISTALIA*/
    if  c-nom-prog-dpc-mg97  <> ""
    or  c-nom-prog-upc-mg97  <> ""
    or  c-nom-prog-appc-mg97 <> "" then do:

        for each tt-epc
            where tt-epc.cod-event = "ANTES-FINALIZA-OPER".
            delete tt-epc.
        end.

        {include/i-epc200.i2 &CodEvent='"ANTES-FINALIZA-OPER"'
                             &CodParameter='"inibe-pergunta"'
                             &ValueParameter='""'}

        {include/i-epc201.i "ANTES-FINALIZA-OPER"}

        find first tt-epc
            where tt-epc.cod-event     = "ANTES-FINALIZA-OPER"
              and tt-epc.cod-parameter = "inibe-pergunta" no-error.

        if  avail tt-epc THEN 
            IF tt-epc.val-parameter     = "INIBE":U THEN
                ASSIGN l-inibe-pergunta = YES.

        for each tt-epc
            where tt-epc.cod-event = "ANTES-FINALIZA-OPER".
            delete tt-epc.
        end.
    end.
    /********************/
    
    // REGRA Finalizaá∆o
    CASE i-regra-finaliza-quando-quant-BO:
        WHEN 1 THEN
            ASSIGN de-qtd-validada-BO = b-oper-ord.qtd-reptda-sfc.  // na operaá∆o o reportado Ç a soma de aprovada e refugada
        WHEN 2 THEN
            ASSIGN de-qtd-validada-BO = b-oper-ord.qtd-aprov-sfc.
        WHEN 3 THEN DO:
            ASSIGN de-qtd-validada-BO = b-oper-ord.qtd-previs-operac.
        END.
    END CASE.
    
    assign l-perguntou = NO.  // Controlar se houve pergunta


    if (l-fechar-operacao-online       and 
        i-regra-finaliza-como-BO = 2   and
        l-msg-finaliza-operac-BO       and
        de-qtd-validada-BO >= b-oper-ord.qtd-previs-operac) AND 
       l-ja-respondeu = NO AND  // Verificar se j† respondeu a pergunta 27100 pra n∆o fazer a pergunta 17989 
       l-inibe-pergunta = NO then do: 
    
        assign l-perguntou = YES.  // Controlar se houve pergunta

        run utp/ut-msgs.p (input "show":U,
                           input 17989,
                           input trim(string(b-oper-ord.nr-ord-produ,">>>,>>>,>>9":U)) + " / ":U + 
                                 trim(b-oper-ord.it-codigo) + " / ":U + 
                                 trim(b-oper-ord.cod-roteiro) + " / ":U + 
                                 trim(string(b-oper-ord.op-codigo))).
    end.
    
    if l-ja-respondeu = NO AND l-perguntou = yes AND return-value = 'no':U 
       then RETURN "OK":U.  // Se respondeu n∆o j† retorna

    assign l-ja-respondeu = NO. // Limpar pra pr¢xima chamada
  
    if log-manager:logging-level > 2 then 
       LOG-MANAGER:WRITE-MESSAGE ("***Ponto003 BOIN536 FecharOperacao" + 
                                  ", de-qtd-validada-BO: " + STRING (de-qtd-validada-BO) +
                                  ", b-oper-ord.qtd-previs-operac: " + STRING (b-oper-ord.qtd-previs-operac) +
                                  ", l-msg-finaliza-operac-BO: " + STRING (l-msg-finaliza-operac-BO)
                                  ,"RegraFinal").
                                  
    if ( (l-fechar-operacao-online = NO  OR (l-perguntou = NO AND l-fechar-operacao-online = YES) ) AND
         (de-qtd-validada-BO >= b-oper-ord.qtd-previs-operac  AND l-msg-finaliza-operac-BO = YES)   AND l-perguntou = NO) OR
       (l-perguntou = YES and return-value = 'yes':U) then do:
    
        if log-manager:logging-level > 2 then 
           LOG-MANAGER:WRITE-MESSAGE ("***Ponto004 BOIN536 FecharOperacao" + 
                                      ", Finaliza Ordem l-encerra-ordem-ultima-operacao: " + STRING (l-encerra-ordem-ultima-operacao) +
                                      ", l-msg-finaliza-operac-BO: " + STRING (l-msg-finaliza-operac-BO),"RegraFinal").

        find current b-oper-ord exclusive-lock no-error.
        
        RUN FecharOperacaoCascata(buffer b-oper-ord).
        
        find current b-oper-ord no-lock no-error.
        
    end.

    /*Faz verificaá‰es / alertas ao usu†rio, sobre encerramento da ordem quando se trata da £ltima operacao e, conforme opcao
      do usu†rio, faz o encerramento da referida ordem
      Esta parte do c¢digo estava na b02in535.w, do sf0303*/
      
    if log-manager:logging-level > 2 then 
       LOG-MANAGER:WRITE-MESSAGE ("***Ponto005 BOIN536 FecharOperacao" + 
                                  ", l-fechar-operacao-online: " + STRING (l-fechar-operacao-online) +
                                  ", Finaliza Ordem l-encerra-ordem-ultima-operacao: " + STRING (l-encerra-ordem-ultima-operacao) +
                                  ", l-encer-ordem-operac-incompl: " + STRING (l-encer-ordem-operac-incompl) +
                                  ", b-oper-ord.log-operac-final: " + STRING (b-oper-ord.log-operac-final),"RegraFinal").
      
    if l-fechar-operacao-online        or
       l-encerra-ordem-ultima-operacao then do:
        
        if  b-oper-ord.log-operac-final OR l-encer-ordem-operac-incompl //mjp parei aqui
        then do:
            /* Altera estado da ordem para terminada/finalizada? */
            find first ord-prod 
                 where ord-prod.nr-ord-produ = b-oper-ord.nr-ord-produ no-LOCK no-error.
                 
            if not avail ord-prod then do:
               if log-manager:logging-level > 2 then 
                  LOG-MANAGER:WRITE-MESSAGE ("***Ponto006 BOIN536 FecharOperacao" + ", Perdeu Ordem: " + STRING (b-oper-ord.nr-ord-produ),"RegraFinal").
               RETURN "NOK":U.
            end.

            find first param-global no-lock no-error.
            ASSIGN l-encerra-op = (ord-prod.estado < 7).
            /*Ponto UPC CRISTALIA*/
            if  c-nom-prog-dpc-mg97  <> ""
            or  c-nom-prog-upc-mg97  <> ""
            or  c-nom-prog-appc-mg97 <> "" then do:
        
                for each tt-epc
                    where tt-epc.cod-event = "ANTES-FINALIZA-ORDEM".
                    delete tt-epc.
                end.
        
                {include/i-epc200.i2 &CodEvent='"ANTES-FINALIZA-ORDEM"'
                                     &CodParameter='"inibe-pergunta"'
                                     &ValueParameter='""'}
        
                {include/i-epc201.i "ANTES-FINALIZA-ORDEM"}
        
                find first tt-epc
                    where tt-epc.cod-event     = "ANTES-FINALIZA-ORDEM"
                      and tt-epc.cod-parameter = "inibe-pergunta" no-error.
        
                if  avail tt-epc THEN 
                    IF tt-epc.val-parameter = "INIBE":U THEN
                        ASSIGN l-encerra-op    = NO.
        
                for each tt-epc
                    where tt-epc.cod-event = "ANTES-FINALIZA-ORDEM".
                    delete tt-epc.
                end.
            end.
            /***************************/
            
            IF l-encerra-op THEN DO:

                if l-fechar-operacao-online and i-regra-finaliza-como-BO = 2 and
                   l-encerra-ordem-ultima-operacao then do:  // Visto Regra Finalizaá∆o OK
                     
                     run utp/ut-msgs.p (input "show":U,
                                        input (if not param-global.modulo-cs 
                                               then 5603
                                               else 5604),
                                        input trim(string(b-oper-ord.nr-ord-produ,">>>,>>>,>>9":U))).
                     ASSIGN l-encerra-op = (RETURN-VALUE = "YES").
                end.
                else
                    assign l-encerra-op = l-encerra-ordem-ultima-operacao.
            END.
            if  l-encerra-op then do:
                /* Verifica se existe operaá∆o n∆o reportada por completo */
                
                // REGRA Finalizaá∆o
                CASE i-regra-finaliza-quando-quant-BO:
                    WHEN 1 THEN
                        ASSIGN de-qtd-validada-BO = ord-prod.qt-produzida.                         // na Ordem Ç a soma de aprovada e refugada
                    WHEN 2 THEN
                        ASSIGN de-qtd-validada-BO = ord-prod.qt-produzida - ord-prod.qt-refugada.  // apenas aprovada
                    WHEN 3 THEN
                        ASSIGN de-qtd-validada-BO = ord-prod.qt-ordem.                             // N∆o valida quantidade
                END CASE.
                
                if log-manager:logging-level > 2 then 
                   LOG-MANAGER:WRITE-MESSAGE ("***Ponto007 BOIN536 FecharOperacao" + 
                                              ", l-fechar-operacao-online: " + STRING (l-fechar-operacao-online) +
                                              ", Finaliza Ordem l-encerra-ordem-ultima-operacao: " + STRING (l-encerra-ordem-ultima-operacao) +
                                              ", l-encer-ordem-operac-incompl: " + STRING (l-encer-ordem-operac-incompl) +
                                              ", de-qtd-validada-BO: " + STRING (de-qtd-validada-BO),"RegraFinal").

                if NOT (ord-prod.qt-ordem <= de-qtd-validada-BO) then RETURN "OK":U. 


                if l-fechar-operacao-online = yes or l-encer-ordem-operac-incompl = no then do:

                   if log-manager:logging-level > 2 then 
                      LOG-MANAGER:WRITE-MESSAGE ("***Ponto008 BOIN536 FecharOperacao" + 
                                                 ", l-fechar-operacao-online: " + STRING (l-fechar-operacao-online) +
                                                 ", l-encer-ordem-operac-incompl: " + STRING (l-encer-ordem-operac-incompl) +
                                                 ", ord-prod.rep-prod: " + STRING (ord-prod.rep-prod),"RegraFinal").

                   case ord-prod.rep-prod:
                        when 1 then do:
                               FOR EACH b2-oper-ord
                                   WHERE b2-oper-ord.nr-ord-produ     = b-oper-ord.nr-ord-produ
                                   and   b2-oper-ord.log-operac-final = no 
                                   and   b2-oper-ord.val-perc-avanco  < b-oper-ord.val-perc-avanco
                                   AND   b2-oper-ord.tipo-oper        = 1 NO-LOCK:
                
                                   FIND grup-maquina WHERE grup-maquina.gm-codigo = b2-oper-ord.gm-codigo NO-LOCK NO-ERROR.
                                   IF AVAIL grup-maquina AND grup-maquina.log-pto-control = TRUE THEN DO:
                                       if l-fechar-operacao-online and i-regra-finaliza-como-BO = 2 then do:
                                           run utp/ut-msgs.p (input "show":U,
                                                              input 17987,
                                                              input trim(string(b-oper-ord.nr-ord-produ,">>>,>>>,>>9":U))).
                   
                                           if  return-value = "NO" THEN
                                               return "NOK":U. // NOK s¢ pra voltar
                                       end.
                                       else 
                                           return "NOK":U. // NOK s¢ pra voltar
                                   END.
                               END.                             
                        end. /*when 1 */
                        when 2 then do:
                               if  can-find(first b2-oper-ord
                                            where b2-oper-ord.nr-ord-produ     = b-oper-ord.nr-ord-produ
                                              and b2-oper-ord.log-operac-final = no 
                                              and b2-oper-ord.val-perc-avanco  < b-oper-ord.val-perc-avanco
                                              AND b2-oper-ord.tipo-oper        = 1) then do:
                                   if l-fechar-operacao-online and i-regra-finaliza-como-BO = 2 then do:   
                                       run utp/ut-msgs.p (input "show":U,
                                                          input 17987,
                                                          input trim(string(b-oper-ord.nr-ord-produ,">>>,>>>,>>9":U))).
                   
                                       if  return-value = "NO":U THEN
                                           return "NOK":U. // NOK s¢ pra voltar
                                   end.
                                   else 
                                       return "NOK":U. // NOK s¢ pra voltar
                               END.                          
                        end. /*when 2*/
                        when 3 then do:
                               if  can-find(first b2-oper-ord
                                            where b2-oper-ord.nr-ord-produ      = b-oper-ord.nr-ord-produ
                                              and b2-oper-ord.log-operac-final  = no 
                                              and b2-oper-ord.val-perc-avanco   < b-oper-ord.val-perc-avanco
                                              AND b2-oper-ord.tipo-oper         = 1
                                              AND b2-oper-ord.pto-controle     <> 0) then do:
                                   if l-fechar-operacao-online and i-regra-finaliza-como-BO = 2 then do:        
                                       run utp/ut-msgs.p (input "show":U,
                                                          input 17987,
                                                          input trim(string(b-oper-ord.nr-ord-produ,">>>,>>>,>>9":U))).
                   
                                       if  return-value = "NO":U THEN
                                           return "NOK":U. // NOK s¢ pra voltar
                                   end.
                                   else 
                                       return "NOK":U. // NOK s¢ pra voltar
                               END.                                
                        end. /*when 3*/
                   end case.
                   
                end. /*if l-fechar-operacao-online or l-encer-ordem-operac-incompl = no */
      
                if not valid-handle (h-cpapi301) then
                    run cpp/cpapi301.p persistent set h-cpapi301 (input-output table tt-ord-prod,
                                                                  input-output table tt-reapro,
                                                                  input-output table tt-erro,
                                                                  input yes).
                                                                  
                if log-manager:logging-level > 2 then 
                   LOG-MANAGER:WRITE-MESSAGE ("***Ponto009 BOIN536 FecharOperacao" + 
                                              ", l-fechar-operacao-online: " + STRING (l-fechar-operacao-online) +
                                              ", l-encer-ordem-operac-incompl: " + STRING (l-encer-ordem-operac-incompl),"RegraFinal").
                           
                find current ord-prod exclusive-lock no-error.

                run pi-finalizar-ordem-producao in h-cpapi301 (buffer ord-prod,
                                                               input yes). /* Altera estado da ordem */
                
                find current ord-prod no-lock no-error.                
                
                return "OK":U.                                               
       
                /**************************************************************************************************************/
                /*A chamada da bo para integraá∆o com SFC foi movida para a procedure pi-finalizar-ordem-producao, na cpapi301*/
                /**************************************************************************************************************/

            end. /*if  l-encerra-op*/
        end. /*if  b-oper-ord.log-operac-final*/   
    end. /*if l-fechar-operacao-online or l-encerra-ordem-ultima-operacao*/
 
    IF VALID-HANDLE(h-cpapi301) THEN
        DELETE PROCEDURE h-cpapi301.
    ELSE
        return "OK":U.

return "OK":U.
END PROCEDURE.


/*******************************************************************************************************
**
** PROCEDURE:  FecharOperacaoCascata
** OBJETIVO:   Finalizaá∆o da operaá∆o cascata da ordem
** PARAMETROS: buffer b-oper-ord
**
*******************************************************************************************************/
PROCEDURE FecharOperacaoCascata:
   DEF PARAMETER BUFFER b-oper-ord FOR oper-ord.

    IF CAN-FIND(FIRST funcao
                WHERE funcao.cd-funcao = "spp-UsaRegraFinalizacaoAntiga"  // a liberaá∆o desta funá∆o ser† apenas emergencial, conforme o suporte vir necessidade.
                  AND funcao.ativo     = YES) 
    THEN DO:
        if log-manager:logging-level > 2 then 
               LOG-MANAGER:WRITE-MESSAGE ("***Ponto999 BOIN536 pi-FecharOperacaoCascata-Antigo","RegraFinal").
       
        RUN pi-FecharOperacaoCascata-Antigo (BUFFER b-oper-ord).
    END.
    ELSE DO:
        if log-manager:logging-level > 2 then 
               LOG-MANAGER:WRITE-MESSAGE ("***Ponto998 BOIN536 pi-FecharOperacaoCascata-Novo","RegraFinal").

        RUN pi-FecharOperacaoCascata-Novo (BUFFER b-oper-ord).
    END.
END PROCEDURE.

/*******************************************************************************************************
**
** PROCEDURE:  pi-FecharOperacaoCascata-Antigo
** OBJETIVO:   Finalizaá∆o da operaá∆o cascata da ordem
** PARAMETROS: buffer b-oper-ord
**
*******************************************************************************************************/
PROCEDURE pi-FecharOperacaoCascata-Antigo:
   DEF PARAMETER BUFFER b-oper-ord FOR oper-ord.
   
   DEF BUFFER b2-oper-ord FOR oper-ord.
   def var v-log-erro as log no-undo.
   DEF VAR dt-ult-rep              AS DATE   NO-UNDO.
   DEF VAR c-hr-ult-rep            AS CHAR   NO-UNDO.
   DEF VAR rw-ult-rep              AS ROWID  NO-UNDO.    
   
   
        /*Caso n∆o tenha ocorrido finalizacao da Ordem, ent∆o fecha a operacao neste trecho do programa*/

        for each split-operac where  
                 split-operac.nr-ord-produ     =  b-oper-ord.nr-ord-produ   and 
                 split-operac.num-operac-sfc   =  b-oper-ord.num-operac-sfc and 
                 split-operac.ind-estado-split < 5 exclusive-lock:
                 
            assign split-operac.ind-estado-split = 5. /** Finalizado **/         
        end. 
        
        find ord-prod 
                where ord-prod.nr-ord-produ = b-oper-ord.nr-ord-produ
                no-lock no-error. 
   
        assign b-oper-ord.log-operac-finaliz = yes.
        
        /*** Verifica e fecha operaá‰es antecessoras ***/
        blk-pert-ordem:
        for each pert-ordem where 
                 pert-ordem.nr-ord-produ     = b-oper-ord.nr-ord-produ   and
                 pert-ordem.num-operac-suces = b-oper-ord.sequencia  no-lock:
        
            find b2-oper-ord where
                 b2-oper-ord.nr-ord-produ   = pert-ordem.nr-ord-produ and
                 b2-oper-ord.sequencia      = pert-ordem.num-operac-predec exclusive-lock no-error.
                 
            if  not avail b2-oper-ord then
                next.
        
            if b2-oper-ord.estado = 3 then next.
        
            find grup-maquina where
                 grup-maquina.gm-codigo = b2-oper-ord.gm-codigo no-lock no-error.
        
            if b2-oper-ord.tipo-oper = 1    and
               grup-maquina.log-pto-control and 
          (ord-prod.rep-prod = 3         and
          b2-oper-ord.pto-controle <> 0) and  
               not b2-oper-ord.log-operac-finaliz then do:    
               assign v-log-erro = yes.
            end.
            else do:
           run FecharOperacaoCascata (buffer b2-oper-ord).
                if b2-oper-ord.estado < 3 then 
                    assign v-log-erro = yes.
            end.        
        end.
        
        if not v-log-erro then 
           assign b-oper-ord.estado = 3. 
           
        /********************************************************************************/
        /***L¢gica que estava na tela b02in535.w, no final da chamada desta procedure.***/
        /********************************************************************************/
        &IF DEFINED(bf_man_204) &THEN

             ASSIGN dt-ult-rep   = ?
                    c-hr-ult-rep = "":U
                    rw-ult-rep   = ?.
        
             FOR EACH split-operac 
                 WHERE split-operac.nr-ord-produ  = b-oper-ord.nr-ord-produ
                 AND   split-operac.it-codigo     = b-oper-ord.it-codigo
                 AND   split-operac.cod-roteiro   = b-oper-ord.cod-roteiro
                 AND   split-operac.op-codigo     = b-oper-ord.op-codigo NO-LOCK:
        
                 FOR EACH rep-oper-ctrab
                     WHERE rep-oper-ctrab.nr-ord-produ     = split-operac.nr-ord-produ
                     AND   rep-oper-ctrab.num-operac-sfc   = split-operac.num-operac-sfc
                     AND   rep-oper-ctrab.num-split-operac = split-operac.num-split-operac NO-LOCK:
        
                     IF rep-oper-ctrab.dat-fim-reporte > dt-ult-rep OR dt-ult-rep = ? THEN
                         ASSIGN dt-ult-rep   = rep-oper-ctrab.dat-fim-reporte
                                c-hr-ult-rep = string(rep-oper-ctrab.qtd-segs-fim-reporte, "99999999")
                                rw-ult-rep   = ROWID(rep-oper-ctrab).
        
                     IF rep-oper-ctrab.dat-fim-reporte = dt-ult-rep AND
                       (rep-oper-ctrab.qtd-segs-fim-reporte) > dec(c-hr-ult-rep) THEN
                         ASSIGN c-hr-ult-rep = string(rep-oper-ctrab.qtd-segs-fim-reporte, "99999999")
                                rw-ult-rep   = ROWID(rep-oper-ctrab).
                 END.
             END.
        
             FIND rep-oper-ctrab WHERE ROWID(rep-oper-ctrab) = rw-ult-rep NO-LOCK NO-ERROR.
             
             /* O comando abaixo foi inserido, pois devido a um problema com o 
             Smart a sentenáa acima com NO-ERROR n∆o est† funcionando corretamente. */
             
             def var l-aux as log no-undo.
             assign l-aux = no no-error.
             
             /* O comando acima foi inserido, pois devido a um problema com o 
             Smart a sentenáa com FIND acima com NO-ERROR n∆o est† funcionando corretamente. */
        
             IF AVAIL rep-oper-ctrab THEN DO:
                 find first oper-ord where rowid(oper-ord) = rowid(b-oper-ord) no-lock no-error.
                 if avail oper-ord then do:
                      {sfc/sf0303a.i3}
                 end.
             END.             
        
        &endif /*204*/
        
     release split-operac.
     release b2-oper-ord.
     
END PROCEDURE.


/*******************************************************************************************************
**
** PROCEDURE:  pi-FecharOperacaoCascata-Novo
** OBJETIVO:   Finalizaá∆o da operaá∆o cascata da ordem
** PARAMETROS: buffer b-oper-ord
**
*******************************************************************************************************/
PROCEDURE pi-FecharOperacaoCascata-Novo:
     DEF PARAMETER BUFFER b-oper-ord FOR oper-ord.
     
     DEF BUFFER b2-oper-ord          FOR oper-ord.
     
     DEF var v-log-erro              as log    no-undo.
     DEF VAR dt-ult-rep              AS DATE   NO-UNDO.
     DEF VAR c-hr-ult-rep            AS CHAR   NO-UNDO.
     DEF VAR rw-ult-rep              AS ROWID  NO-UNDO.    

     /*Caso n∆o tenha ocorrido finalizacao da Ordem, ent∆o fecha a operacao neste trecho do programa*/


     if log-manager:logging-level > 2 then 
        LOG-MANAGER:WRITE-MESSAGE ("***Ponto010 BOIN536 FecharOperacaoCascata" + 
                                   ", b-oper-ord.nr-ord-produ: " + STRING (b-oper-ord.nr-ord-produ) +
                                   ", b-oper-ord.num-operac-sfc: " + STRING (b-oper-ord.num-operac-sfc),"RegraFinal").

     for each split-operac where  
              split-operac.nr-ord-produ     =  b-oper-ord.nr-ord-produ   and 
              split-operac.num-operac-sfc   =  b-oper-ord.num-operac-sfc and 
              split-operac.ind-estado-split < 5 exclusive-lock:
              
         assign split-operac.ind-estado-split = 5. /** Finalizado **/         
     end. 
     
     assign b-oper-ord.log-operac-finaliz = yes.
     
     /*** Verifica e fecha operaá‰es antecessoras ***/
     blk-pert-ordem:
     for each pert-ordem where 
              pert-ordem.nr-ord-produ     = b-oper-ord.nr-ord-produ   and
              pert-ordem.num-operac-suces = b-oper-ord.sequencia  no-lock:
     
         find first b2-oper-ord 
              where b2-oper-ord.nr-ord-produ = pert-ordem.nr-ord-produ 
                and b2-oper-ord.sequencia    = pert-ordem.num-operac-predec no-lock no-error.
              
         if not avail b2-oper-ord  then next.
     
         if b2-oper-ord.estado = 3 then next.
     
         find grup-maquina where
              grup-maquina.gm-codigo = b2-oper-ord.gm-codigo no-lock no-error.
     
         if b2-oper-ord.tipo-oper = 1       and
            grup-maquina.log-pto-control    and 
            (can-find (first ord-prod 
                       where ord-prod.nr-ord-produ = b-oper-ord.nr-ord-produ 
                         and ord-prod.rep-prod = 3) and
             b2-oper-ord.pto-controle <> 0) and  
            not b2-oper-ord.log-operac-finaliz  then do:    
            
            assign v-log-erro = yes.
            
         end.
         else do:
         
            if log-manager:logging-level > 2 then 
               LOG-MANAGER:WRITE-MESSAGE ("***Ponto011 BOIN536 FecharOperacaoCascata" + 
                                          ", b2-oper-ord.nr-ord-produ: " + STRING (b2-oper-ord.nr-ord-produ) +
                                          ", b2-oper-ord.num-operac-sfc: " + STRING (b2-oper-ord.num-operac-sfc),"RegraFinal").

            find current b2-oper-ord exclusive-lock no-error.

            run FecharOperacaoCascata (buffer b2-oper-ord).
            
            find current b2-oper-ord no-lock no-error.

            if b2-oper-ord.estado < 3 then 
                 assign v-log-erro = yes.
         end.        
     end.
     
     if not v-log-erro then 
        assign b-oper-ord.estado = 3. 
        
     /********************************************************************************/
     /***L¢gica que estava na tela b02in535.w, no final da chamada desta procedure.***/
     /********************************************************************************/

     ASSIGN dt-ult-rep   = ?
            c-hr-ult-rep = "":U
            rw-ult-rep   = ?.
     
     FOR EACH split-operac 
        WHERE split-operac.nr-ord-produ  = b-oper-ord.nr-ord-produ
          AND split-operac.it-codigo     = b-oper-ord.it-codigo
          AND split-operac.cod-roteiro   = b-oper-ord.cod-roteiro
          AND split-operac.op-codigo     = b-oper-ord.op-codigo NO-LOCK:
     
         FOR EACH rep-oper-ctrab
            WHERE rep-oper-ctrab.nr-ord-produ     = split-operac.nr-ord-produ
              AND rep-oper-ctrab.num-operac-sfc   = split-operac.num-operac-sfc
              AND rep-oper-ctrab.num-split-operac = split-operac.num-split-operac NO-LOCK:
     
             IF rep-oper-ctrab.dat-fim-reporte > dt-ult-rep OR dt-ult-rep = ? THEN
                 ASSIGN dt-ult-rep   = rep-oper-ctrab.dat-fim-reporte
                        c-hr-ult-rep = string(rep-oper-ctrab.qtd-segs-fim-reporte, "99999999") // usa pra nada
                        rw-ult-rep   = ROWID(rep-oper-ctrab).
     
             IF rep-oper-ctrab.dat-fim-reporte = dt-ult-rep AND
               (rep-oper-ctrab.qtd-segs-fim-reporte) > dec(c-hr-ult-rep) THEN
                 ASSIGN c-hr-ult-rep = string(rep-oper-ctrab.qtd-segs-fim-reporte, "99999999") // usa pra nada
                        rw-ult-rep   = ROWID(rep-oper-ctrab).
         END.
     END.
     
     FIND FIRST rep-oper-ctrab WHERE ROWID(rep-oper-ctrab) = rw-ult-rep NO-LOCK NO-ERROR.
     
     /* O comando abaixo foi inserido, pois devido a um problema com o 
     Smart a sentenáa acima com NO-ERROR n∆o est† funcionando corretamente. */
     
     def var l-aux as log no-undo.
     assign l-aux = no no-error.
     
     /* O comando acima foi inserido, pois devido a um problema com o 
     Smart a sentenáa com FIND acima com NO-ERROR n∆o est† funcionando corretamente. */
     
     IF AVAIL rep-oper-ctrab THEN DO:
         find first oper-ord 
              where rowid(oper-ord) = rowid(b-oper-ord) no-lock no-error.
         if avail oper-ord then do:
              {sfc/sf0303a.i3}
         end.
     END.
        
     release split-operac.
     release b2-oper-ord.
     
END PROCEDURE.

/*******************************************************************************************************
**
** PROCEDURE:  ReabrirOperacao
** OBJETIVO:   Reabertura da operaá∆o da ordem
** PARAMETROS: buffer b-oper-ord
**
*******************************************************************************************************/
PROCEDURE ReabrirOperacao:

    define parameter buffer b-oper-ord for oper-ord.

    def buffer b2-oper-ord for oper-ord.

    def var v-log-erro as logical no-undo.

    assign b-oper-ord.estado = 2.

    /*** Verifica e abre operaá‰es sucessoras ***/
    blk-pert-ordem:
    for each pert-ordem where 
             pert-ordem.nr-ord-produ      = b-oper-ord.nr-ord-produ   and
             pert-ordem.num-operac-predec = b-oper-ord.sequencia no-lock:

        find b2-oper-ord where
             b2-oper-ord.nr-ord-produ   = pert-ordem.nr-ord-produ and
             b2-oper-ord.sequencia      = pert-ordem.num-operac-suces exclusive-lock no-error.

        if  not avail b2-oper-ord or b2-oper-ord.estado < 3 
           then next.
        run ReabrirOperacao (buffer b2-oper-ord).
    end.

    if b-oper-ord.val-perc-avanco < 100 then 
       assign b-oper-ord.log-operac-finaliz = no.

END PROCEDURE.

/*******************************************************************************************************
**
** PROCEDURE:  SetaParametros
** OBJETIVO:   Indica que a FecharOperacao ser† executada online, ou seja, poder∆o ser emitidas
               mensagens (perguntas) diretamente de dentro da BO. Quando a execuá∆o n∆o for online,
               os demais parÉmetros indicam a resposta default para as perguntas que seriam emitidas
               caso fosse online.
               Chamada pelos programas: sf0303 (b02in535.w), sf0308, sfapi009
** PARAMETROS: Passados atravÇs da tt-param-split:
               l-fechar-operacao-online: yes = on-line, no = batch, default batch
                 **Respostas default para quando a execucao eh em batch. Neste caso, como Ç online,  
                   n∆o influenciam em nada.                                                       
               l-encerra-ordem-ultima-operacao: Encerra ordem quando ultima operacao est† sendo encerrada
               l-encer-ordem-operac-incompl: Encerra OPs com operacoes nao reportadas por completo               
**
*******************************************************************************************************/
procedure SetaParametros:
    def input-output param table for tt-param-split.
    
    IF CAN-FIND(FIRST funcao
                WHERE funcao.cd-funcao = "spp-UsaRegraFinalizacaoAntiga"  // a liberaá∆o desta funá∆o ser† apenas emergencial, conforme o suporte vir necessidade.
                  AND funcao.ativo     = YES) 
    THEN DO:
        if log-manager:logging-level > 2 then 
               LOG-MANAGER:WRITE-MESSAGE ("***Ponto999 BOIN536 SetaParametros-Antigo","RegraFinal").
       
            assign l-fechar-operacao-online         = can-find(first tt-param-split 
                                                               where tt-param-split.cod-param = "l-fechar-operacao-online":U 
                                                                 and tt-param-split.log-1)             
                   l-encerra-ordem-ultima-operacao  = can-find(first tt-param-split                                              
                                                               where tt-param-split.cod-param = "l-encerra-ordem-ultima-operacao":U     
                                                                 and tt-param-split.log-1)                                       
                   l-encer-ordem-operac-incompl     = can-find(first tt-param-split                                              
                                                               where tt-param-split.cod-param = "l-encer-ordem-operac-incompl":U     
                                                                 and tt-param-split.log-1)
                   l-oper-ante-encerrada            = can-find(first tt-param-split                                              
                                                               where tt-param-split.cod-param = "l-log-fechada":U     
                                                                 and tt-param-split.log-1).          
            find first tt-param-split
                 where tt-param-split.cod-param = "de-val-max-apont" no-lock no-error.
            if available tt-param-split then 
                 assign de-val-apont-max = tt-param-split.dec-1.
            else assign de-val-apont-max = 999999999.
        
    END.
    ELSE DO:
        if log-manager:logging-level > 2 then 
               LOG-MANAGER:WRITE-MESSAGE ("***Ponto998 BOIN536 SetaParametros-Novo","RegraFinal").
               
                for first tt-param-split 
                    where tt-param-split.cod-param = "l-fechar-operacao-online":U no-lock: 
                    assign l-fechar-operacao-online = tt-param-split.log-1.
                end.
                
                for first tt-param-split 
                    where tt-param-split.cod-param = "l-encerra-ordem-ultima-operacao":U no-lock: 
                    assign l-encerra-ordem-ultima-operacao = tt-param-split.log-1.
                end.
                
                for first tt-param-split 
                    where tt-param-split.cod-param = "l-encer-ordem-operac-incompl":U no-lock: 
                    assign l-encer-ordem-operac-incompl = tt-param-split.log-1.
                end.
                
                for first tt-param-split 
                    where tt-param-split.cod-param = "l-log-fechada":U no-lock: 
                    assign l-oper-ante-encerrada = tt-param-split.log-1.
                end.
                
                for first tt-param-split 
                    where tt-param-split.cod-param = "l-msg-finaliza-split-operac-BO":U no-lock: 
                    assign l-msg-finaliza-split-operac-BO = tt-param-split.log-1.
                end.
                
                 for first tt-param-split 
                    where tt-param-split.cod-param = "l-msg-finaliza-operac-BO":U no-lock: 
                    assign l-msg-finaliza-operac-BO = tt-param-split.log-1.
                end.
                
                
                ASSIGN i-regra-finaliza-como-BO = IF CAN-FIND(FIRST tt-param-split 
                               WHERE tt-param-split.cod-param = "i-regra-finaliza-como-BO":U 
                                 AND tt-param-split.int-1 = 1) 
                            THEN 1 ELSE 2.   // 1-Automaticamente 2-Perguntando       
                                                                              
                                                                    
            find first tt-param-split
                 where tt-param-split.cod-param = "i-regra-finaliza-quando-quant-BO":U no-lock no-error.  
                 
            if avail (tt-param-split) then
               assign i-regra-finaliza-quando-quant-BO = tt-param-split.int-1.    // 1-Produzida 2-Aprovada 3-N∆o valida Quantidade 
        
            find first tt-param-split
                 where tt-param-split.cod-param = "de-val-max-apont" no-lock no-error.
            if available tt-param-split then 
                 assign de-val-apont-max = tt-param-split.dec-1.
            else assign de-val-apont-max = 0.  // considera Zero, pois se n∆o foi informado, n∆o importa na validaá∆o.
            
            if log-manager:logging-level > 2 then 
               LOG-MANAGER:WRITE-MESSAGE ("***Ponto012 BOIN536 SetaParametros" + 
                                          ", l-fechar-operacao-online: " + STRING (l-fechar-operacao-online) +
                                          ", Finaliza Ordem l-encerra-ordem-ultima-operacao: " + STRING (l-encerra-ordem-ultima-operacao) +
                                          ", l-msg-finaliza-split-operac-BO: " + STRING (l-msg-finaliza-split-operac-BO) +
                                          ", l-msg-finaliza-operac-BO: " + STRING (l-msg-finaliza-operac-BO) + 
                                          ", i-regra-finaliza-como-BO: " + STRING (i-regra-finaliza-como-BO) + 
                                          ", i-regra-finaliza-quando-quant-BO: " + STRING (i-regra-finaliza-quando-quant-BO) +
                                          ", l-encer-ordem-operac-incompl: " + STRING (l-encer-ordem-operac-incompl) +
                                          ", l-oper-ante-encerrada: " + STRING (l-oper-ante-encerrada) +
                                          ", de-val-apont-max: " + STRING (de-val-apont-max),"RegraFinal").
    END.
     

return "OK":U.
end procedure.


procedure SetaParametrosVar:
    def input parameter p-fecha-operacao-online          as log no-undo.
    def input parameter p-fencerra-ordem-ultima-operacao as log no-undo.
    def input parameter p-encer-ordem-operac-incompl     as log no-undo.
    def input parameter p-msg-finaliza-split-operac-BO   as log no-undo.
    def input parameter p-msg-finaliza-operac-BO         as log no-undo.
    def input parameter p-regra-finaliza-como-BO         as int no-undo.
    def input parameter p-regra-finaliza-quando-quant-BO as int no-undo.
    
    assign l-fechar-operacao-online         = p-fecha-operacao-online         
           l-encerra-ordem-ultima-operacao  = p-fencerra-ordem-ultima-operacao
           l-encer-ordem-operac-incompl     = p-encer-ordem-operac-incompl
           l-msg-finaliza-split-operac-BO   = p-msg-finaliza-split-operac-BO
           l-msg-finaliza-operac-BO         = p-msg-finaliza-operac-BO        
           i-regra-finaliza-como-BO         = p-regra-finaliza-como-BO        
           i-regra-finaliza-quando-quant-BO = p-regra-finaliza-quando-quant-BO.

return "OK":U.
end procedure.



