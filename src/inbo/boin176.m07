PROCEDURE afterCreateRecord :
/*------------------------------------------------------------------------------ 
  Purpose:     
  Parameters:  <none>
  Notes: - Alocaªao da ordem de compra e saldo em poder de terceiros.
         - Criaªao dos dados para estoque (rat-lote), somente um registro, com
         os dados vindos da procedure setDefaultsEstoque.
         - Geraªao do FIFO das ordens de compra, atrav≤s do programa re1001p.p.
         - Criaªao das unidades de negΩcio para a nota fiscal, atrav≤s do programa
         cd9760.p.
------------------------------------------------------------------------------*/
    def var l-unid-neg as logical                   no-undo.
    def var h-re1001p  as handle                    no-undo.
    def var l-erro-co  as logical                   no-undo.
    def var de-qtd-max like item-doc-est.quantidade no-undo.

    def var h-boin404    as handle    no-undo.
    def var h-bodi516    as handle    no-undo.
    def var h-bocx315    as handle    no-undo.
    def var de-val-erro  as decimal   no-undo.         
    def var l-contrato   as logical   no-undo. 
    def var i-total      as int       no-undo. 
    def var l-erro       as log       no-undo.    
    def var l-orig-ativo as log       no-undo.    
    def var l-valida-inv as log       no-undo.
    def var i-id-saldo   as int       no-undo.
    
    def buffer bf-natur-oper-fut   for natur-oper.
    def buffer bf-item-doc-est-fut for item-doc-est.
    def buffer bf-docum-est-fut    for docum-est.
    def buffer bf-natur-oper-item  for natur-oper.  /* buffer aux. para buscar a natureza do item */

    def var de-qtd-rat-acum as dec       no-undo.
    def var i-cont-rat-lote as int       no-undo.   
    def var p-origem-it     as int       no-undo.
    def var p-cod-cst       as int       no-undo.
    def var l-ret-goToKey   as logical   no-undo. 
    def var c-erro-desc     as char      no-undo.
    
    DEF VAR l-calc-exclusao-bc-pis-cofins   AS LOGICAL NO-UNDO.
    
    &IF "{&bf_mat_versao_ems}" >= "2.062" &THEN
        run openQueryStatic in h-boiv029 (INPUT "Main":U).
    &ENDIF            

    /*--- quando a nota eh fatura entrega futura grava a natureza complementar no item-doc-est ---*/
    find bf-natur-oper-fut where
         bf-natur-oper-fut.nat-operacao = rowObject.nat-operacao no-lock no-error.
         
    /*--- verifica se docum-est eh de nota de fatura faturamento ou fatura entrega futura ---*/
    {cdp/cd9700.i1 bf-natur-oper-fut}

    /* Se fatura de Fat. Antecip. ou Fat. de Entrega Fut. verifica se o 
       item Ç diferente de controle total e emite uma mensagem [item.tipo-contr <> 2] */
    IF  l-fatura-fat-antecip OR l-fatura-ent-futura THEN DO:
        FIND FIRST item WHERE item.it-codigo = RowObject.it-codigo NO-LOCK NO-ERROR.
        IF AVAIL item AND item.tipo-contr <> 2 THEN DO:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-operacoes-de-entrega-futura-e AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Operaá‰es_de_Entrega_Futura_e_Faturamento_Antecipado_somente_s∆o_poss°veis_com_itens_de_controle_total" *}
            ASSIGN c-lbl-liter-operacoes-de-entrega-futura-e = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                               &ErrorNumber="17006"
                               &ErrorType="EMS"
                               &ErrorSubType="ERROR"
                               &ErrorParameters="c-lbl-liter-operacoes-de-entrega-futura-e"}
            return "NOK":U.        
        END.
    END.

    IF  l-fatura-fat-antecip 
    OR  l-fatura-ent-futura 
    OR  l-remessa-ent-futura THEN DO:

        FIND bf-item-doc-est-fut {cdp/cd8900.i bf-item-doc-est-fut rowObject}
             AND bf-item-doc-est-fut.it-codigo = RowObject.it-codigo
             AND bf-item-doc-est-fut.sequencia = RowObject.sequencia EXCLUSIVE-LOCK NO-ERROR.
    
        IF  AVAIL bf-item-doc-est-fut THEN DO:
            IF  l-remessa-ent-futura THEN
                ASSIGN bf-item-doc-est-fut.nat-terc = bf-item-doc-est-fut.nat-comp.
            IF  AVAIL bf-natur-oper-fut 
            AND bf-natur-oper-fut.nat-comp <> "" 
            AND l-remessa-ent-futura = NO THEN
                ASSIGN bf-item-doc-est-fut.nat-terc = bf-natur-oper-fut.nat-comp
                       bf-item-doc-est-fut.nat-comp = bf-natur-oper-fut.nat-comp.
            IF  l-fatura-fat-antecip THEN           
                ASSIGN bf-item-doc-est-fut.baixa-ce = NO.

        END.

    END.
    
    for first bf-docum-est-fut
        {cdp/cd8900.i bf-docum-est-fut rowObject} exclusive-lock: end.
        
    if  avail bf-docum-est-fut
    and bf-docum-est-fut.esp-docto = 20 /* NFD */ then do:
    
        /*--- se for devolucao de cliente, verifica se esta devolvendo uma venda de entrega futura ---*/
        find bf-natur-oper-fut where
             bf-natur-oper-fut.nat-operacao = rowObject.nat-comp no-lock no-error.
                 
        /*--- verifica se docum-est eh de nota de fatura faturamento ou fatura entrega futura ---*/
        if avail bf-natur-oper-fut then do:
             {cdp/cd9700.i1 bf-natur-oper-fut}    
         
             if  l-fatura-ent-futura then
                 assign bf-docum-est-fut.cod-natur-vincul = bf-natur-oper-fut.nat-comp.   
        end.
    end.

    run cnp/cn9174.p (input RowObject.numero-ordem,
                      input 1,
                      input 0,
                      input 0,
                      input ?,
                      output de-val-erro,
                      output l-erro-co,
                      output l-contrato,
                      output i-total,
                      input-output table tt-erro). 

    for first docum-est 
        fields ( cod-emitente  nro-docto
                 serie-docto   nat-operacao
                 rec-fisico    log-2
                 cod-estabel   char-2       cod-observa)
        where docum-est.cod-emitente = RowObject.cod-emitente
          and docum-est.serie-docto  = RowObject.serie-docto
          and docum-est.nro-docto    = RowObject.nro-docto
          and docum-est.nat-operacao = RowObject.nat-operacao NO-LOCK:
    end.          
    /*=========== SuperGasbras/MinasG†s ===========*/                           
    FIND FIRST para-fat NO-LOCK NO-ERROR.
    ASSIGN i-nr-linhas-nota = para-fat.nr-item-nota.

    &IF DEFINED(BF_dis_param_estab) &THEN
        IF CAN-FIND(funcao WHERE
                    funcao.cd-funcao = "fn-estab-nr-linhas-nota" AND
                    funcao.ativo     = YES) THEN DO:

           RUN cdp/cd8701.p (INPUT docum-est.cod-estabel,
                             INPUT-OUTPUT i-nr-linhas-nota).
        END.
    &ENDIF
   /*==============================================*/
                     

    for first item-doc-est 
        fields ( cod-emitente  serie-docto
                 nro-docto     nat-operacao
                 sequencia     dec-1
                 quantidade    it-codigo   char-2)
                 

        where item-doc-est.serie-docto  = RowObject.serie-docto
          and item-doc-est.nro-docto    = RowObject.nro-docto
          and item-doc-est.cod-emitente = RowObject.cod-emitente
          and item-doc-est.nat-operacao = RowObject.nat-operacao 
          and item-doc-est.sequencia    = RowObject.sequencia exclusive-lock:
    end. 
    
    /* Alocaªao Ordem Compra */
    if  RowObject.numero-ordem <> 0 then do:
        

        for first prazo-compra
            fields ( numero-ordem    parcela         quant-saldo
                     situacao        data-entrega    dec-1
                     quant-rejeit     qtd-sal-forn     quantidade
                     quant-receb     cod-refer                   )
            where prazo-compra.numero-ordem = RowObject.numero-ordem
              and prazo-compra.parcela      = RowObject.parcela exclusive-lock:
        end.
 
        if  not docum-est.rec-fisico
        and avail prazo-compra 
        and i-total <> 1                   /* Contrato por Total Contratado */
        and i-total <> 2                   /* Contrato por Medicao */
        and i-total <> 3  then do:         /* Contrato Limite de Custo */
            run pi-aloca-ordem-cc (input yes,
                                   input item-doc-est.quantidade,
                                   input rowid(prazo-compra)).
            assign item-doc-est.dec-1 = prazo-compra.dec-1.                                   
        end.
            
        /* ### Cristiano - 21/02/2002 ### */
        IF  AVAIL prazo-compra THEN
            RELEASE prazo-compra.
    end.
    

    &IF "{&bf_mat_versao_ems}" >= "2.062" &THEN
        assign l-evento = no.
        if  RowObject.numero-ordem <> 0 
        and avail param-global
        and param-global.modulo-cn then do:
            run cnp/cn9071.p (RowObject.numero-ordem,
                              0,
                              4,
                              output l-evento,
                              output l-erro-co,
                              input-output table tt-erro).
        end.
        if  not l-evento then
            assign item-doc-est.int-1 = 0.
    &ENDIF

    /* Alocaªao Saldo Terceiros */
    if  natur-oper.tp-oper-terc = 2          /* Retorno Beneficiamento */
    or  natur-oper.tp-oper-terc = 4          /* Faturamento Consignacao  */
    or  natur-oper.tp-oper-terc = 5          /* Devolucao Consignacao  */
    or  natur-oper.tp-oper-terc = 9          /* Retorno Dep Fechado */
    or  natur-oper.tp-oper-terc = 11         /* Retorno Armaz Geral */
    or (natur-oper.tipo-compra = 3 and l-fatura-ent-futura) then do: /*Devolucao de Fatura Entrega Futura*/

        find first saldo-terc 
            where saldo-terc.cod-emitente = RowObject.cod-emitente
              and saldo-terc.nro-docto    = RowObject.nro-comp
              and saldo-terc.serie-docto  = RowObject.serie-comp
              and saldo-terc.nat-operacao = RowObject.nat-comp
              and saldo-terc.it-codigo    = RowObject.it-codigo
              and saldo-terc.cod-refer    = RowObject.cod-refer
              and saldo-terc.sequencia    = RowObject.seq-comp
            exclusive-lock no-error.

        /* Devoluá∆o Simbolica Consignaá∆o */
        IF  AVAIL saldo-terc
            	AND {cdp/cd0066.i2 saldo-terc.cod-estabel}
        AND natur-oper.tp-oper-terc = 4 THEN DO: /* Faturamento Consignacao  */
            RUN inbo/boin404.p PERSISTENT SET h-boin404.
            RUN updateFifoDevolucaoSimbolica
                        IN h-boin404 (YES,
                                      YES,
                                      ROWID(saldo-terc),
                                      RowObject.quantidade).
            DELETE PROCEDURE h-boin404.
        END.
        else do:
            if  avail saldo-terc 
            and avail item-doc-est then
                assign saldo-terc.dec-1   = saldo-terc.dec-1 + item-doc-est.quantidade
                       item-doc-est.dec-2 = item-doc-est.quantidade.     
            else do: /*fatura entrega futura*/
                /*Atualiza a quantidade digitada no recebimento fisico*/
                FOR FIRST nota-fiscal
                    WHERE nota-fiscal.nr-nota-fis = item-doc-est.nro-comp
                       AND nota-fiscal.serie       = item-doc-est.serie-comp 
                       AND nota-fiscal.cod-estabel = docum-est.cod-estabel NO-LOCK:
                    FOR FIRST bf-natur-oper-fut 
                        WHERE bf-natur-oper-fut.nat-operacao = nota-fiscal.nat-operacao NO-LOCK:
                        /*** localiza o componente da nota de fatura para encontrar a saldo-terc ***/
                        FOR FIRST componente 
                            WHERE componente.nro-docto     = item-doc-est.nro-comp
                              AND componente.nat-operacao  = bf-natur-oper-fut.nat-comp
                              AND componente.cod-emitente  = item-doc-est.cod-emitente
                              AND componente.serie-docto   = item-doc-est.serie-comp
                              AND componente.sequencia     = item-doc-est.seq-comp    NO-LOCK:
                              /*** Localiza a saldo-terc para atualizacao do saldo digitado ***/
                              FOR FIRST saldo-terc
                                  WHERE saldo-terc.nro-docto    = componente.nro-docto   				  
                                    AND saldo-terc.cod-emitente = componente.cod-emitente
                                    AND saldo-terc.serie-docto  = componente.serie-docto 
                                    AND saldo-terc.sequencia    = componente.sequencia   EXCLUSIVE-LOCK:
                                    assign saldo-terc.dec-1   = saldo-terc.dec-1 + item-doc-est.quantidade
                                           item-doc-est.dec-2 = item-doc-est.quantidade.     
                              END.
                        END.
                    END.
                END.
            end.
        end.
        		
        find current saldo-terc no-lock no-error.			
    end.
    
    /* Criacao dos dados para atualizacao do estoque */
    IF  l-cria-rat-lote           AND
        RowObject.quantidade <> 0 AND
        RowObject.baixa-ce        THEN DO:
      
        find first item-uni-estab 
             where item-uni-estab.it-codigo = RowObject.it-codigo
               and item-uni-estab.cod-estabel = docum-est.cod-estabel no-lock no-error.
        ASSIGN l-vinc-rot-pend = if avail item-uni-estab then item-uni-estab.log-rotei-pend else no.
        
        If l-vinc-rot-pend then do:
        
            /*associa automaticamente ficha com chave do documento cadastrado*/
            FIND FIRST ficha-cq 
                 WHERE ficha-cq.serie-docto  = RowObject.serie-docto  
                   AND ficha-cq.nro-docto    = RowObject.nro-docto    
                   AND ficha-cq.cod-emitente = RowObject.cod-emitente 
                   AND ficha-cq.dat-emis-nf  = docum-est.dt-emissao
                   and ficha-cq.it-codigo    = RowObject.it-codigo
                   and ficha-cq.lote         = RowObject.lote 
                   AND ficha-cq.situacao     <> 4 exclusive-lock NO-ERROR.
            IF NOT AVAIL ficha-cq THEN
                FIND FIRST ficha-cq 
                     WHERE ficha-cq.serie-docto  = RowObject.serie-docto  
                       AND ficha-cq.nro-docto    = RowObject.nro-docto    
                       AND ficha-cq.cod-emitente = RowObject.cod-emitente 
                       and ficha-cq.it-codigo    = RowObject.it-codigo
                       AND ficha-cq.dat-emis-nf  = docum-est.dt-emissao
                       AND ficha-cq.situacao     <> 4 exclusive-lock NO-ERROR.
  
            IF AVAIL ficha-cq THEN DO:
                RUN createRatLote (input-output de-qtd-rat-acum,
                                   input-output i-cont-rat-lote).
                if return-value = "OK":U then
                     assign ficha-cq.situacao = 4. /*Atualiza ficha para terminado*/    
            END.
            else do:
                /*Contagem de Fichas para ratear a quantidade da rat-lote*/    
                assign i-cont-cq = 0.
                For each ficha-cq no-lock
                   Where ficha-cq.idi-orig-restdo = 2
                     and ficha-cq.it-codigo       = RowObject.it-codigo
                     and ficha-cq.cod-emitente    = RowObject.cod-emitente 
                     and ficha-cq.dt-ficha       <= d-data-corte-cq:
                     
                    if ficha-cq.log-dia-sem-fornec then
                        next.
                        
                    /*n∆o associa roteiro com chave cadastrada*/
                    IF  ficha-cq.serie-docto  <> ""
                    AND ficha-cq.nro-docto    <> ""
                    AND ficha-cq.dat-emis-nf  <> ? THEN 
                        NEXT.    
                    
                    if ficha-cq.situacao = 6 then
                        assign i-cont-cq = i-cont-cq + 1.                 
                end.                       
                
                if i-cont-cq > 0 then do:
                    For each ficha-cq exclusive-lock
                       Where ficha-cq.idi-orig-restdo = 2
                         and ficha-cq.it-codigo       = RowObject.it-codigo
                         and ficha-cq.cod-emitente    = RowObject.cod-emitente 
                         and ficha-cq.dt-ficha       <= d-data-corte-cq:
                         
                        if ficha-cq.log-dia-sem-fornec then
                           next.
                           
                        /*n∆o associa roteiro com chave cadastrada*/
                        IF  ficha-cq.serie-docto  <> ""
                        AND ficha-cq.nro-docto    <> ""
                        AND ficha-cq.dat-emis-nf  <> ? THEN 
                            NEXT.    
                        
                        if ficha-cq.situacao = 6 then do:
                            RUN createRatLote (input-output de-qtd-rat-acum,
                                               input-output i-cont-rat-lote).
                            if return-value = "OK":U then
                                assign ficha-cq.situacao = 4. /*Atualiza ficha para terminado*/    	    
                        end.                               
                    end.
                end.    
                else
                   RUN createRatLote (input-output de-qtd-rat-acum,
                                      input-output i-cont-rat-lote).
            end.           
        end.
        else do:
            RUN createRatLote (input-output de-qtd-rat-acum,
                               input-output i-cont-rat-lote).
        end.
        
        IF  RETURN-VALUE <> "OK":U THEN
            RETURN "NOK":U.
    END.

    /* FIFO ordem de compra */
    if avail item-doc-est           and
       RowObject.log-1              and /*FIFO*/
       (docum-est.origem = "i":U    or 
        docum-est.origem = "XML":U) and       
       l-executar-fifo-re1001p      then do:            
            
        run rep/re1001p.p persisten set h-re1001p ( input rowid (item-doc-est) ).
        
        run piRetornaErros in h-re1001p (output table RowErrors).
        
        /*--- Verifica ocorrància de erros ---*/
        IF  CAN-FIND(FIRST RowErrors
                     WHERE RowErrors.ErrorSubType = "ERROR":U
                       AND RowErrors.ErrorType   <> "INTERNAL":U) THEN
            RETURN "NOK":U.
        
        delete procedure h-re1001p.
        assign h-re1001p = ?.
            
        /* Sugest∆o de conta cont†bil para o item da nota conforme ordens selecionadas para o FIFO */        
        for each rat-ordem no-lock {cdp/cd8900.i rat-ordem item-doc-est}
                         and rat-ordem.sequencia = item-doc-est.sequencia:
                           
            /* Caso exista alguma ordem selecionada pelo FIFO n∆o possua conta, n∆o ser† sugerida */                           
            if can-find(first ordem-compra where ordem-compra.numero-ordem = rat-ordem.numero-ordem and
                                                 ordem-compra.ct-codigo = "") then do:            
                leave.
            end.
            else do:
                /* Ser† sugerida a conta da primeira ordem encontrada do FIFO */ 
                find first ordem-compra where ordem-compra.numero-ordem = rat-ordem.numero-ordem and
                                              ordem-compra.ct-codigo    <> "" no-lock no-error.
                                                    
                if avail ordem-compra then do:                                                       
                    assign item-doc-est.ct-codigo      = if l-fatura-ent-futura then item-doc-est.ct-codigo else ordem-compra.ct-codigo
                           rowObject.ct-codigo         = item-doc-est.ct-codigo /* necessario atualizar a RowObject senao nao cria a unid-neg-nota na procedure returnUnidNegCriacaoMatrizRateio */
                           item-doc-est.sc-codigo      = if l-fatura-ent-futura then item-doc-est.sc-codigo else ordem-compra.sc-codigo
                           item-doc-est.nr-ord-produ   = ordem-compra.ordem-servic
                           item-doc-est.num-ord-inv    = if  l-fatura-fat-antecip then 0 else ordem-compra.num-ord-inv
                           item-doc-est.cod-unid-negoc = ordem-compra.cod-unid-negoc WHEN l-mat-unid-negoc.
                    leave.                    
                end.
            end.        
        end.            
    end.                                                       

    assign l-contrato = no.
    if  i-numero-ordem <> 0 
    and avail param-global
    and param-global.modulo-cn then do:
        run cnp/cn9174.p ( i-numero-ordem,
                           1,
                           0,
                           0,
                           ?,
                           output de-qtd-max,
                           output l-erro-co,
                           output l-contrato,
                           output i-total,
                           input-output table tt-erro).
    end.
    if  avail item-doc-est
    and l-contrato then do:
        run rep/re1001p1.p (input rowid(item-doc-est)).
        assign item-doc-est.num-pedido   = 0
               item-doc-est.numero-ordem = 0
               item-doc-est.parcela      = 0.
    END.

    if  item-doc-est.num-pedido   = 0 
    or  item-doc-est.numero-ordem = 0
    or  item-doc-est.parcela      = 0 then 
        assign item-doc-est.num-pedido = 0
               item-doc-est.numero-ordem = 0
               item-doc-est.parcela = 0.

    //fatura faturamento antecipado nao deve integrar com investimentos, pois a integracao
    //ocorrera nas notas de remessa faturamento antecipado
    if  l-fatura-fat-antecip then
        assign item-doc-est.num-ord-inv = 0.
               
    /* Unidade de negΩcio */
    
    run returnUnidNegCriacaoMatrizRateio ( output l-unid-neg ).

    if  l-unid-neg  /* Possui Unidades de Negocio */
    and avail item-doc-est then do:
    
        /* Geracao das Unidades de Negocio */
        &IF '{&bf_mat_versao_ems}' >= '2.062' &THEN
        if l-mat-unid-negoc
            and not l-ent-cons and not l-retorno and not l-ret-fat
            and not l-devolucao
            /* and not natur-oper.log-oper-triang */ then
        &ENDIF
            run cdp/cd9760.p ( 3,   /* item-doc-est */
                               item-doc-est.it-codigo,
                               rowid(item-doc-est) ).
    end.

    &IF "{&bf_mat_versao_ems}" >= "2.062" &THEN
        find first ordem-compra no-lock
             where ordem-compra.numero-ordem = RowObject.numero-ordem no-error.
        if avail ordem-compra then do:
    
            if not can-find(FIRST matriz-rat-med
                            WHERE matriz-rat-med.nr-contrato     = ordem-compra.nr-contrato
                              AND matriz-rat-med.num-seq-item    = ordem-compra.num-seq-item
                              AND matriz-rat-med.numero-ordem    = ordem-compra.numero-ordem
                              AND matriz-rat-med.num-seq-event   = 0
                              AND matriz-rat-med.num-seq-medicao = 0) and
               RowObject.num-ord-inv <> 0 and
               not RowObject.log-1        and
               avail param-global         and
               param-global.modulo-in     and   
               not l-contrato             then do:
               
                empty temp-table tt-matriz.
                for each unid-neg-nota no-lock
                   where unid-neg-nota.nro-docto    = RowObject.nro-docto
                     and unid-neg-nota.serie-docto  = RowObject.serie-docto
                     and unid-neg-nota.cod-emitente = RowObject.cod-emitente
                     and unid-neg-nota.nat-operacao = RowObject.nat-operacao
                     and unid-neg-nota.sequencia    = RowObject.sequencia 
                     by unid-neg-nota.cod_unid_negoc:                    
    
                    find first tt-matriz no-lock 
                         where tt-matriz.cod-unid-neg = unid-neg-nota.cod_unid_negoc no-error.
                    if not avail tt-matriz then do:
                        create tt-matriz.
                        assign tt-matriz.cod-unid-neg = unid-neg-nota.cod_unid_negoc.
                    end.
                    assign tt-matriz.perc-rateio = tt-matriz.perc-rateio + unid-neg-nota.perc-unid-neg.
                end.
    
                assign l-valida-inv = yes.
                find item where item.it-codigo = rowObject.it-codigo no-lock no-error.
                if item.tipo-contr = 2 and rowObject.ct-codigo = "" then
                    assign l-valida-inv = no.
                if RowObject.cod-unid-negoc <> "" and natur-oper.log-oper-triang then
                     assign l-valida-inv = no. 
    
                empty temp-table tt-erro.
                if l-valida-inv then do:
                    if not avail param-global then
                       find first param-global no-lock no-error.
                    if not avail estabelec 
                    or (avail estabelec and estabelec.cod-estabel <> ordem-compra.cod-estabel) then
                       find first estabelec where estabelec.cod-estabel = ordem-compra.cod-estabel no-lock no-error.
                    &IF "{&mguni_version}" >= "2.071" &THEN
                    assign iempresa = if avail estabelec and estabelec.ep-codigo <> "" then estabelec.ep-codigo else param-global.empresa-prin.
                    &ELSE
                    assign iempresa = if avail estabelec and estabelec.ep-codigo <> 0 then estabelec.ep-codigo else param-global.empresa-prin.
                    &ENDIF   
                    if valid-handle(h-boiv029) then do:
                       RUN recebeEmpresa IN h-boiv029 (INPUT iempresa).
                       
                        find FIRST ord-prod
                            WHERE ord-prod.nr-ord-produ = RowObject.nr-ord-produ no-lock no-error.
                         
                        if avail ord-prod and ord-prod.origem = "MV" and l-unidade-negocio then do:
                            IF NOT VALID-HANDLE(hMMVUnidNegoc) THEN
                                RUN frbo/bofr134.p PERSISTENT SET hMmvUnidNegoc.

                            RUN canFindMatrizMMV IN hMMVUnidNegoc (INPUT ord-prod.nr-ord-produ).

                            IF RETURN-VALUE = "NOK":U THEN DO:
                            
                                run ValidateMatrizUnidNegoc in h-boiv029 (input  table tt-matriz, 
                                                                          input  RowObject.num-ord-inv, 
                                                                          output table tt-erro).
                            END.

                            DELETE OBJECT hMMVUnidNegoc.
                       end.
                       else do: 

                               FIND FIRST unid-negoc-om 
                                   WHERE unid-negoc-om.num-ord-manut = RowObject.nr-ord-produ NO-LOCK NO-ERROR.
                                   
                               if avail ord-prod and ord-prod.origem = "MI" and avail unid-negoc-om and l-unidade-negocio then do:
                               end.
                               else do:    
        
                                   run ValidateMatrizUnidNegoc in h-boiv029 (input  table tt-matriz, 
                                                                             input  RowObject.num-ord-inv, 
                                                                             output table tt-erro).
                               end.
                       end.
                    end.
                end.                    
                               
                /*ponto upc Schulz - N∆o validar Matriz UN quando informado ordem manutená∆o*/
                IF c-nom-prog-upc-mg97 <> "" THEN DO:
                
                    empty temp-table tt-epc.
                    
                    {include/i-epc200.i2 &CodEvent='"elimina-tt-erro"'
                                         &CodParameter='"handle-tt-erro"'
                                         &ValueParameter="string(TEMP-TABLE tt-erro:HANDLE)"}
    
                    {include/i-epc200.i2 &CodEvent='"elimina-tt-erro"'
                                         &CodParameter='"nr-ord-produ"'
                                         &ValueParameter="string(RowObject.nr-ord-produ)"}
    
                    {include/i-epc201.i "elimina-tt-erro"}
                END.
                /****************************************************************************/            
                                   
                if can-find (first tt-erro) then do:       
                    for each tt-erro no-lock:
        
                        create RowErrors.            
                        assign RowErrors.ErrorNumber      = tt-erro.cd-erro
                               RowErrors.ErrorDescription = tt-erro.mensagem
                               RowErrors.ErrorType        = "EMS"
                               RowErrors.ErrorSubType     = "ERROR"
                               RowErrors.ErrorHelp        = "".
                    end.
                    
                    return "NOK":U.
                end.
            end.            
        end.
    &ENDIF

    /***********************************************************
    **                   Produto Frotas                       **
    ***********************************************************/
    if l-frota-implantado then do:
        run piFrotas in this-procedure (input 1). /* Inclus∆o */
        if return-value <> "OK":U then
            return "NOK":U. 
    end.
    /**********************************************************/    

    /* Se for remessa de faturamento antecipado:
       Soma a quantidade do documento a qtd-receb-fisic da sdo-fatur-antecip (bodi578) */
    IF  l-remessa-fat-antecip OR (l-fatura-fat-antecip and bf-docum-est-fut.esp-docto = 20) THEN DO:
        IF NOT VALID-HANDLE(h-bodi578) THEN
            RUN dibo/bodi578.p PERSISTENT SET h-bodi578.
            
        FIND FIRST movto-fatur-antecip
	     WHERE movto-fatur-antecip.nr-nota-fis  = RowObject.nro-comp
	       AND movto-fatur-antecip.cod-estabel  = docum-est.cod-estabel 
	       AND movto-fatur-antecip.serie-docto  = RowObject.serie-comp 
	       AND movto-fatur-antecip.cod-emitente = RowObject.cod-emitente 
	       AND movto-fatur-antecip.nat-operacao = RowObject.nat-comp
	       AND movto-fatur-antecip.it-codigo    = RowObject.it-codigo
	       AND movto-fatur-antecip.cod-refer    = RowObject.cod-refer  
	       AND movto-fatur-antecip.num-seq      = RowObject.seq-comp             NO-LOCK NO-ERROR.
	      	
	if AVAIL movto-fatur-antecip THEN DO:
	  	RUN atualizaSaldoFisicoItem IN h-bodi578 (input movto-fatur-antecip.num-id-sdo,
	    					  input "",
	    					  input "",
	    					  input "",
	    					  input 0,
	    					  input "",
	    					  input "",
	    					  input 0,
	    					  input RowObject.quantidade). 
	END.
        
        DELETE PROCEDURE h-bodi578.          
    END.
        
    /* Atualiza saldo de alocaá∆o do Drawback */
    IF RowObject.nr-ato-concessorio <> "" and l-validar THEN DO:
       if not valid-handle(h-bocx315) then
          run cxbo/bocx315.p persistent set h-bocx315.
       
       RUN openQueryStatic IN h-bocx315 (INPUT "Main":U) NO-ERROR.
        
       IF NOT AVAIL docum-est THEN DO:
             for first docum-est 
                fields ( cod-emitente  nro-docto
                         serie-docto   nat-operacao
                         rec-fisico    log-2
                         cod-estabel )
                where docum-est.cod-emitente = RowObject.cod-emitente
                  and docum-est.serie-docto  = RowObject.serie-docto
                  and docum-est.nro-docto    = RowObject.nro-docto
                  and docum-est.nat-operacao = RowObject.nat-operacao NO-LOCK:
            end.    
       END.
       
       if not avail emitente then
           find first emitente no-lock 
               where emitente.cod-emitente = RowObject.cod-emitente no-error.
                           
       if not avail estabelec then
           find first estabelec no-lock
               where estabelec.cod-estabel = docum-est.cod-estabel no-error.
    
       IF  emitente.natureza > 2 
       and emitente.pais <> estabelec.pais THEN
           assign i-IntNac = 1. /* internacional */
       ELSE
           assign i-IntNac = 2. /* nacional */
       
       
       /* aloca no ato concessorio */
       FOR FIRST pedido-drb NO-LOCK
           WHERE pedido-drb.cod-estabel        = docum-est.cod-estabel
             AND pedido-drb.nr-ato-concessorio = RowObject.nr-ato-concessorio,
           FIRST pedido-drb-item NO-LOCK
           WHERE pedido-drb-item.cod-estabel   = pedido-drb.cod-estabel
             AND pedido-drb-item.nr-pedido-drb = pedido-drb.nr-pedido-drb
             AND pedido-drb-item.it-codigo     = RowObject.it-codigo:
               
               create tt-pedido-drb-item.
               IF i-IntNac = 1 THEN DO: /* internacional */
                  buffer-copy pedido-drb-item to tt-pedido-drb-item.
                  ASSIGN tt-pedido-drb-item.qtd-alocada-import = pedido-drb-item.qtd-alocada-import + RowObject.quantidade
                         tt-pedido-drb-item.r-rowid            = rowid(pedido-drb-item).
               END.
               ELSE DO: /* nacional */
                  buffer-copy pedido-drb-item to tt-pedido-drb-item.
                  ASSIGN tt-pedido-drb-item.qtd-alocada-nac = pedido-drb-item.qtd-alocada-nac + RowObject.quantidade
                         tt-pedido-drb-item.r-rowid         = rowid(pedido-drb-item).
               END.
               RUN goToKey IN h-bocx315 (INPUT tt-pedido-drb-item.cod-estabel,
                                         INPUT tt-pedido-drb-item.nr-pedido-drb,
                                         INPUT tt-pedido-drb-item.it-codigo).
               if return-value = "OK":U then do:
                  RUN emptyRowErrors  IN h-bocx315.
                  RUN emptyRowObject  IN h-bocx315.
                  RUN setRecord       IN h-bocx315 (INPUT TABLE tt-pedido-drb-item).
                  RUN updateRecord    IN h-bocx315.
               end.
               delete tt-pedido-drb-item.
       END.
       
       if valid-handle(h-bocx315) then do:
          delete procedure h-bocx315.
          assign h-bocx315 = ?.
       end.
    END.
    
    /* ------------------------------- */

    /* NT2015/003 - Copia das informaá‰es do ICMS de Partilha - DIFAL */
    IF RowObject.nro-comp <> "" and 
       not natur-oper.transf THEN DO:

        FOR FIRST it-nota-fisc 
            WHERE it-nota-fisc.cod-estabel = docum-est.cod-estabel
              AND it-nota-fisc.serie       = RowObject.serie-comp   
              AND it-nota-fisc.nr-nota-fis = RowObject.nro-comp
              AND it-nota-fisc.nr-seq-fat  = RowObject.seq-comp
              AND it-nota-fisc.it-codigo   = RowObject.it-codigo NO-LOCK. END.

        FOR EACH item-nf-adc NO-LOCK 
          WHERE item-nf-adc.cod-estab        = it-nota-fisc.cod-estabel 
             AND item-nf-adc.cod-serie        = it-nota-fisc.serie       
             AND item-nf-adc.cod-nota-fisc    = it-nota-fisc.nr-nota-fis 
             AND item-nf-adc.cdn-emitente     = RowObject.cod-emitente
             AND item-nf-adc.cod-natur-operac = it-nota-fisc.nat-operacao
             AND item-nf-adc.num-seq          = it-nota-fisc.nr-seq-fat
             AND item-nf-adc.num-seq-item-nf  = it-nota-fisc.nr-seq-fat
             AND item-nf-adc.cod-item         = it-nota-fisc.it-codigo:

            IF item-nf-adc.idi-tip-dado <> 24 AND item-nf-adc.idi-tip-dado <> 25 AND item-nf-adc.idi-tip-dado <> 39 THEN NEXT.
             
            EMPTY TEMP-TABLE tt-item-nf-adc.
            CREATE tt-item-nf-adc.
            ASSIGN tt-item-nf-adc.cod-estab        = docum-est.cod-estabel
                   tt-item-nf-adc.cod-serie        = RowObject.serie-docto
                   tt-item-nf-adc.cod-nota-fisc    = RowObject.nro-docto
                   tt-item-nf-adc.cdn-emitente     = RowObject.cod-emitente
                   tt-item-nf-adc.cod-natur-operac = (if RowObject.nat-of <> "" then RowObject.nat-of else RowObject.nat-operacao)
                   tt-item-nf-adc.num-seq          = RowObject.sequencia
                   tt-item-nf-adc.num-seq-item-nf  = RowObject.sequencia
                   tt-item-nf-adc.cod-item         = RowObject.it-codigo.

            CASE item-nf-adc.idi-tip-dado:
                /* NT2015/003 - Copia das informaªÑes do ICMS de Partilha - DIFAL */
                WHEN 24 THEN DO:
                    ASSIGN tt-item-nf-adc.idi-tip-dado = 24
                           tt-item-nf-adc.cod-livre-1  = item-nf-adc.cod-livre-1   /*Aliq UF Dest*/
                           tt-item-nf-adc.cod-livre-2  = item-nf-adc.cod-livre-2   /*Aliq Inter*/
                           tt-item-nf-adc.val-livre-2  = item-nf-adc.val-livre-2   /*% ICMS FCP*/
                           tt-item-nf-adc.num-livre-1  = item-nf-adc.num-livre-1   /*ICMSInterPart*/
                           tt-item-nf-adc.val-livre-1  = ROUND((item-nf-adc.val-livre-1 / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2)  /*Vl BC UF Dest*/
                           tt-item-nf-adc.cod-livre-4  = STRING(ROUND((DEC(item-nf-adc.cod-livre-4) / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2))  /*Vl ICMS FCP*/
                           tt-item-nf-adc.val-livre-3  = ROUND((item-nf-adc.val-livre-4 / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2)  /* VL ICMS UF Dest inverte Devol */ 
                           tt-item-nf-adc.val-livre-4  = ROUND((item-nf-adc.val-livre-3 / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2). /* VL ICMS UF Orig inverte Devol */ 

                    ASSIGN OVERLAY(tt-item-nf-adc.cod-livre-3,1,2)   = SUBSTRING(item-nf-adc.cod-livre-3,3,2)    /* Devolucao UF Destino passa p/ Origem   */ 
                           OVERLAY(tt-item-nf-adc.cod-livre-3,3,2)   = SUBSTRING(item-nf-adc.cod-livre-3,1,2)    /* Devolucao UF Origem passa p/ Destino   */
                           OVERLAY(tt-item-nf-adc.cod-livre-3,5,100) = SUBSTRING(item-nf-adc.cod-livre-3,5,100)  /* Grava os demais parametros desse campo */
                           OVERLAY(tt-item-nf-adc.cod-livre-3,41,20) = STRING(ROUND((DEC(TRIM(SUBSTRING(item-nf-adc.cod-livre-3,41,20)))/ it-nota-fisc.qt-faturada[1] * RowObject.quantidade),2)). /* Vl BC FCP UF Dest*/

                END.
                /* Copia das informaªÑes de FCP */
                WHEN 25 THEN DO:
                    
                    ASSIGN tt-item-nf-adc.idi-tip-dado = 25
                           tt-item-nf-adc.log-livre-1  = item-nf-adc.log-livre-1  /*YES = FCP majorou ST, NO = FCP majorou ICMS*/
                           tt-item-nf-adc.log-livre-2  = item-nf-adc.log-livre-2  /*Quando o FCP e FCP ST for junto no mesmo item da nota ser† = ?*/
                           
                           tt-item-nf-adc.val-livre-1  = ROUND((item-nf-adc.val-livre-1 / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2) /*Base FCP ST*/
                           tt-item-nf-adc.val-livre-2  = item-nf-adc.val-livre-2  /*Aliquota FCP ST*/
                           tt-item-nf-adc.cod-livre-4  = STRING(ROUND((DEC(item-nf-adc.cod-livre-4) / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2)) /*Valor FCP ST*/
                           tt-item-nf-adc.num-livre-1  = item-nf-adc.num-livre-1  /*Cod. mensagem FCP ST observ. nota*/
                           
                           tt-item-nf-adc.val-livre-3 = ROUND((item-nf-adc.val-livre-3 / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2) /*Base FCP*/
                           tt-item-nf-adc.val-livre-4 = item-nf-adc.val-livre-4   /*Aliquota FCP*/
                           tt-item-nf-adc.cod-livre-3 = STRING(ROUND((DEC(item-nf-adc.cod-livre-3) / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2)) /*Valor FCP*/
                           tt-item-nf-adc.num-livre-2 = item-nf-adc.num-livre-2.  /*Cod. mensagem FCP    */   
                           
                    IF DEC(SUBSTRING(item-nf-adc.cod-livre-2,1,20)) > 0 THEN     /*Valor FCP Diferido*/
                        ASSIGN OVERLAY(tt-item-nf-adc.cod-livre-2,1,20) = STRING(ROUND((DEC(SUBSTRING(item-nf-adc.cod-livre-2,1,20)) / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2)).   /*Valor FCP Diferido*/                                                                          
                       
                    IF DEC(SUBSTRING(item-nf-adc.cod-livre-2,21,8)) > 0 THEN     /*Percentual FCP Diferido*/
                        ASSIGN OVERLAY(tt-item-nf-adc.cod-livre-2,21,8) = SUBSTRING(item-nf-adc.cod-livre-2,21,8).   /*Percentual FCP Diferido*/                                       
            
                    ASSIGN OVERLAY(RowObject.char-2,880,8)  = STRING(tt-item-nf-adc.val-livre-2) /*Aliquota FCP*/
                           OVERLAY(RowObject.char-2,888,20) = STRING(tt-item-nf-adc.cod-livre-4) /*Valor FCP*/.
            
                    if item-nf-adc.log-livre-1 and /*FCP Majorou ST*/
                       substr(natur-oper.char-1,168,1) = "S":U then /*Deduzir ICMS ST Devol. Cliente*/
                         assign tt-item-nf-adc.cod-livre-4       = STRING(0)
                                OVERLAY(RowObject.char-2,888,20) = STRING(0).
                    
                    EMPTY TEMP-TABLE tt-ext-item-doc-est.
                    
                    IF NOT VALID-HANDLE(h-boin01017) THEN
                        RUN inbo/boin01017.p PERSISTENT SET h-boin01017.
                        
                    RUN openQueryStatic IN h-boin01017 (INPUT "Main":U) NO-ERROR.
                  
                    RUN goToKey IN h-boin01017 (INPUT RowObject.serie-docto, 
                                                INPUT RowObject.nro-docto,   
                                                INPUT RowObject.cod-emitente,
                                                INPUT RowObject.nat-operacao,
                                                INPUT RowObject.sequencia,   
                                                INPUT "fcp":U).
                                                
                    IF  RETURN-VALUE = "OK":U THEN DO:
			            ASSIGN l-ret-goToKey = YES.
                        RUN emptyRowErrors IN h-boin01017.
                        RUN getRecord IN h-boin01017 (OUTPUT TABLE tt-ext-item-doc-est).
                        FIND FIRST tt-ext-item-doc-est EXCLUSIVE-LOCK NO-ERROR.
                    END.
                    ELSE DO:
                        ASSIGN l-ret-goToKey = NO.
                        CREATE tt-ext-item-doc-est.
                        ASSIGN tt-ext-item-doc-est.serie-docto  = RowObject.serie-docto
                               tt-ext-item-doc-est.nro-docto    = RowObject.nro-docto
                               tt-ext-item-doc-est.cod-emitente = RowObject.cod-emitente
                               tt-ext-item-doc-est.nat-operacao = RowObject.nat-operacao
                               tt-ext-item-doc-est.sequencia    = RowObject.sequencia
                               tt-ext-item-doc-est.cod-param    = "fcp":U.
                    END.                   
                    
                    ASSIGN tt-ext-item-doc-est.val-livre-1  = tt-item-nf-adc.val-livre-3        /*Base FCP*/
                           tt-ext-item-doc-est.val-livre-2  = tt-item-nf-adc.val-livre-4        /*Aliq FCP*/
                           tt-ext-item-doc-est.val-livre-3  = DEC(tt-item-nf-adc.cod-livre-3).  /*Valor FCP*/
                           
                    IF DEC(SUBSTRING(tt-item-nf-adc.cod-livre-2,1,20)) > 0 THEN     /*Valor FCP Diferido*/
                        ASSIGN OVERLAY(tt-ext-item-doc-est.cod-livre-1,1,20) = SUBSTRING(tt-item-nf-adc.cod-livre-2,1,20).   /*Valor FCP Diferido*/
                       
                    IF DEC(SUBSTRING(tt-item-nf-adc.cod-livre-2,21,8)) > 0 THEN     /*Percentual FCP Diferido*/
                        ASSIGN OVERLAY(tt-ext-item-doc-est.cod-livre-1,21,8) = SUBSTRING(tt-item-nf-adc.cod-livre-2,21,8).   /*Percentual FCP Diferido*/                              
                           
                    /* Se usa m£ltiplas naturezas no recebimento */
                    IF l-mult-natur-receb THEN /* Var def em cd9701.i */
                        FIND FIRST bf-natur-oper-item WHERE bf-natur-oper-item.nat-operacao = RowObject.nat-of NO-LOCK NO-ERROR.
                    
                    /* Se n∆o usa multiplas naturezas ou usa mas a nota Ç antiga (digit. antes de marcar o parÉm.) */
                    IF NOT l-mult-natur-receb OR NOT AVAIL bf-natur-oper-item THEN
                        FIND FIRST bf-natur-oper-item WHERE bf-natur-oper-item.nat-operacao = RowObject.nat-operacao NO-LOCK NO-ERROR.

                    IF AVAIL bf-natur-oper-item AND substr(bf-natur-oper-item.char-1,168,1) <> "S":U THEN DO:
                        ASSIGN tt-ext-item-doc-est.val-livre-4  = tt-item-nf-adc.val-livre-1        /*Base FCP ST*/ 
                               tt-ext-item-doc-est.val-livre-5  = tt-item-nf-adc.val-livre-2        /*Aliq FCP ST*/ 
                               tt-ext-item-doc-est.val-livre-6  = DEC(tt-item-nf-adc.cod-livre-4).  /*Valor FCP ST*/
                    END.
                  
                    /*1-FCP Normal, 2-FCP Subst. Trib., 3-FCP Subst. Trib. Antecip*/
                    ASSIGN tt-ext-item-doc-est.num-livre-2 = 1.
                  
                    IF AVAIL bf-natur-oper-item AND bf-natur-oper-item.subs-trib THEN
                        ASSIGN tt-ext-item-doc-est.num-livre-2 = 2.
                    ELSE IF AVAIL bf-natur-oper-item AND 
                           (bf-natur-oper-item.log-contrib-st-antec or bf-natur-oper-item.log-icms-substto-antecip) AND 
                            NOT bf-natur-oper-item.terceiros THEN  
                        ASSIGN tt-ext-item-doc-est.num-livre-2 = 3.
                                              
                    IF l-ret-goToKey THEN DO:
                        RUN emptyRowErrors IN h-boin01017.
                        RUN setRecord IN h-boin01017 (INPUT TABLE tt-ext-item-doc-est).
                        RUN updateRecord IN h-boin01017.  
                    END.    
                    ELSE DO:
                        RUN emptyRowErrors IN h-boin01017.
                        RUN setRecord IN h-boin01017 (INPUT TABLE tt-ext-item-doc-est).
                        RUN createRecord IN h-boin01017.
                    END.
                  
                    IF VALID-HANDLE(h-boin01017) THEN DO:
                       DELETE PROCEDURE h-boin01017.
                       ASSIGN h-boin01017 = ?.
                    END.
                END.
                WHEN 39 THEN DO:
                    ASSIGN tt-item-nf-adc.idi-tip-dado = 39
                           tt-item-nf-adc.cod-livre-1  = item-nf-adc.cod-livre-1   /*fundo*/
                           tt-item-nf-adc.val-livre-1  = ROUND((item-nf-adc.val-livre-1 / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2)    /*base fundo*/
                           tt-item-nf-adc.val-livre-2  = item-nf-adc.val-livre-2                                                                    /*% fundo*/
                           tt-item-nf-adc.val-livre-3  = ROUND((item-nf-adc.val-livre-3 / it-nota-fisc.qt-faturada[1] * RowObject.quantidade), 2).  /*Valor fundo*/
                END.
            END CASE.
                   
            IF NOT VALID-HANDLE(h-bodi516) THEN
               RUN dibo/bodi516.p PERSISTENT SET h-bodi516.
            RUN openQueryStatic IN h-bodi516 (INPUT "Main":U).
            RUN goToKey IN h-bodi516 (INPUT docum-est.cod-estabel,
                                      INPUT RowObject.serie-docto,
                                      INPUT RowObject.nro-docto,
                                      INPUT RowObject.cod-emitente,
                                      INPUT (if RowObject.nat-of <> "" then RowObject.nat-of else RowObject.nat-operacao),
                                      INPUT tt-item-nf-adc.idi-tip-dado,
                                      INPUT RowObject.sequencia,
                                      INPUT RowObject.sequencia,
                                      INPUT RowObject.it-codigo).
            IF RETURN-VALUE = "NOK":U THEN do:
               RUN setRecord IN h-bodi516 (INPUT TABLE tt-item-nf-adc).
               RUN emptyRowErrors IN h-bodi516.
               RUN createRecord IN h-bodi516.
            END.   
            ELSE do:
               RUN setRecord IN h-bodi516 (INPUT TABLE tt-item-nf-adc).
               RUN emptyRowErrors IN h-bodi516.
               RUN updateRecord IN h-bodi516.  
            END.
            IF VALID-HANDLE(h-bodi516) THEN
                DELETE PROCEDURE h-bodi516.
            ASSIGN h-bodi516 = ?.
        END.    
    END.
    
    /* Base Originaá∆o de Gr∆os Conectada e Parametro Originaá∆o de Gr∆os Marcado */
    RUN cdp/cd0032.p (OUTPUT l-orig-ativo).
    IF  l-orig-ativo THEN DO:
        DEF VAR h-GG1022 AS HANDLE NO-UNDO.
        RUN ggp/gg1022.p PERSISTENT SET h-GG1022.
        RUN piAtzChaveCtrItemRec IN h-GG1022 ( BUFFER item-doc-est ).
        DELETE PROCEDURE h-GG1022.
    END.


    /* Alerta - Nota Devoluá∆o n∆o permite vincular Nota Oper. Terceiros */
    if natur-oper.tipo-compra = 3 and /*Devolucao Cliente*/
       SUBSTRING(natur-oper.char-1,159,1) <> "S" and /*NF de Estorno*/
       (not l-fatura-ent-futura  and not l-remessa-ent-futura and
        not l-fatura-fat-antecip and not l-remessa-fat-antecip) then do:
        
        find first saldo-terc no-lock 
             where saldo-terc.cod-emitente = RowObject.cod-emitente
               and saldo-terc.serie-docto  = RowObject.serie-comp
               and saldo-terc.nro-docto    = RowObject.nro-comp
               and saldo-terc.nat-operacao = RowObject.nat-comp
               and saldo-terc.it-codigo    = RowObject.it-codigo
               and saldo-terc.cod-refer    = RowObject.cod-refer
               and saldo-terc.sequencia    = RowObject.seq-comp no-error.
        if avail saldo-terc then do:
            {utp/ut-liter.i "Seq" *}
            assign c-erro-desc = RETURN-VALUE + ": " + string(RowObject.sequencia).
        
            /* Alerta - Nota Devoluá∆o n∆o permite vincular Nota Oper. Terceiros */
            {method/svc/errors/inserr.i &ErrorNumber="56798"
                                        &ErrorType="EMS"
                                        &ErrorSubType="INFORMATION"
                                        &ErrorParameters="c-erro-desc"}
                                        
            run beforeValidateBoin060 (input 1). /* Instancia */
            run updateConsistNota in h-boin060 ( RowObject.cod-emitente,
                                                 RowObject.serie-docto,
                                                 RowObject.nro-docto,
                                                 RowObject.nat-operacao,
                                                 RowObject.sequencia,
                                                 no,
                                                 0,
                                                 0,
                                                 56798,
                                                 2).
            run beforeValidateBoin060 (input 2). /* Elimina Instancia */  
        end. /*if avail saldo-terc then*/        
    end. /*if natur-oper.tipo-compra = 3*/
    /*********************************************************************/
    
    RUN pi-calc-exclusao-bc-pis-cofins(INPUT docum-est.cod-chave-aces-nf-eletro,
                                       INPUT docum-est.origem,
                                       INPUT INT(SUBSTRING(RowObject.char-2,832,5))).
  
    /* Sugest∆o de CST no Recebimento*/
    RUN sugereCST (INPUT "CREATE":U).
    
    /*******************************************************/
    if can-find(first tt-item-doc-est-tribut) then do:
       IF NOT valid-handle(h-boin01091) THEN
          RUN inbo/boin01091.p persistent set h-boin01091.
          
          empty temp-table tt-item-doc-est-tribut-aux.
          
          FOR EACH tt-item-doc-est-tribut
             WHERE tt-item-doc-est-tribut.cod-serie-docto   = RowObject.serie-docto
               AND tt-item-doc-est-tribut.cod-num-docto     = RowObject.nro-docto
               AND tt-item-doc-est-tribut.cdn-emitente      = RowObject.cod-emitente
               AND tt-item-doc-est-tribut.cod-natur-operac  = RowObject.nat-operacao
               AND tt-item-doc-est-tribut.num-seq           = RowObject.sequencia :
               
             if  tt-item-doc-est-tribut.cod-conteudo = "" then do:
                                                                    
                  RUN setConstraintOfItemDocEst IN h-boin01091 (INPUT tt-item-doc-est-tribut.cod-serie-docto,
                                                                INPUT tt-item-doc-est-tribut.cod-num-docto,    
                                                                INPUT tt-item-doc-est-tribut.cdn-emitente,     
                                                                INPUT tt-item-doc-est-tribut.cod-natur-operac,
                                                                INPUT tt-item-doc-est-tribut.num-seq). 
                  RUN openQueryStatic in h-boin01091 (INPUT "OfItemDocEst":U). 
                                                              
                  RUN goToKey IN h-boin01091 (INPUT tt-item-doc-est-tribut.cod-serie-docto,
                                              INPUT tt-item-doc-est-tribut.cod-num-docto,    
                                              INPUT tt-item-doc-est-tribut.cdn-emitente,     
                                              INPUT tt-item-doc-est-tribut.cod-natur-operac,
                                              INPUT tt-item-doc-est-tribut.num-seq,
                                              INPUT tt-item-doc-est-tribut.nom-trib,         
                                              INPUT tt-item-doc-est-tribut.cod-campo). 
                 
                  IF RETURN-VALUE = "OK":U THEN DO:
                     RUN emptyRowErrors IN h-boin01091.
                     RUN deleteRecord IN h-boin01091.  
                  END.                                        
                  delete tt-item-doc-est-tribut.
             end.
             else do:
                 create tt-item-doc-est-tribut-aux.
                 buffer-copy tt-item-doc-est-tribut to tt-item-doc-est-tribut-aux.
             end.    
          end.
          
          RUN emptyRowObject  IN h-boin01091.
            
          RUN salvaRegistros IN h-boin01091 ( INPUT  TABLE tt-item-doc-est-tribut-aux,
                                              OUTPUT TABLE RowErrors APPEND).
                                              
          FOR EACH tt-item-doc-est-tribut EXCLUSIVE-LOCK
             WHERE tt-item-doc-est-tribut.cod-serie-docto   = RowObject.serie-docto
               AND tt-item-doc-est-tribut.cod-num-docto     = RowObject.nro-docto
               AND tt-item-doc-est-tribut.cdn-emitente      = RowObject.cod-emitente
               AND tt-item-doc-est-tribut.cod-natur-operac  = RowObject.nat-operacao
               AND tt-item-doc-est-tribut.num-seq           = RowObject.sequencia:
             DELETE tt-item-doc-est-tribut.
          END.     
          
       IF valid-handle(h-boin01091) THEN
          delete procedure h-boin01091.
    end.
    /*******************************************************/
    
    IF CAN-FIND(FIRST tt-ext-item-doc-est) THEN DO:
        IF NOT VALID-HANDLE(h-boin01017) THEN
            RUN inbo/boin01017.p PERSISTENT SET h-boin01017.

        RUN openQueryStatic IN h-boin01017 (INPUT "Main":U) NO-ERROR.

        FOR EACH tt-ext-item-doc-est:
            EMPTY TEMP-TABLE tt-ext-item-doc-est-aux.
            BUFFER-COPY tt-ext-item-doc-est TO tt-ext-item-doc-est-aux.

            RUN goToKey IN h-boin01017 (INPUT RowObject.serie-docto, 
                                        INPUT RowObject.nro-docto,   
                                        INPUT RowObject.cod-emitente,
                                        INPUT RowObject.nat-operacao,
                                        INPUT RowObject.sequencia,   
                                        INPUT tt-ext-item-doc-est.cod-param).

            IF RETURN-VALUE = "NOK":U THEN do:
                RUN emptyRowErrors IN h-boin01017.
                RUN setRecord IN h-boin01017 (INPUT TABLE tt-ext-item-doc-est-aux).
                RUN createRecord IN h-boin01017.
            END.   
            ELSE do:
                RUN emptyRowErrors IN h-boin01017.
                RUN setRecord IN h-boin01017 (INPUT TABLE tt-ext-item-doc-est-aux).
                RUN updateRecord IN h-boin01017.  
            END.
        END.
    END.

    IF CAN-FIND(FIRST tt-item-nf-adc) THEN DO:
        IF NOT VALID-HANDLE(h-bodi516) THEN
            RUN dibo/bodi516.p PERSISTENT SET h-bodi516.
        RUN openQueryStatic IN h-bodi516 (INPUT "Main":U).

        FOR EACH tt-item-nf-adc:
            EMPTY TEMP-TABLE tt2-item-nf-adc.
            BUFFER-COPY tt-item-nf-adc TO tt2-item-nf-adc.
            RUN goToKey IN h-bodi516 (INPUT tt-item-nf-adc.cod-estab,
                                      INPUT tt-item-nf-adc.cod-serie,
                                      INPUT tt-item-nf-adc.cod-nota-fisc,
                                      INPUT tt-item-nf-adc.cdn-emitente,
                                      INPUT tt-item-nf-adc.cod-natur-operac,
                                      INPUT tt-item-nf-adc.idi-tip-dado,
                                      INPUT tt-item-nf-adc.num-seq,
                                      INPUT tt-item-nf-adc.num-seq-item-nf,
                                      INPUT tt-item-nf-adc.cod-item).
            IF RETURN-VALUE = "NOK":U THEN do:
                RUN setRecord IN h-bodi516 (INPUT TABLE tt2-item-nf-adc).
                RUN emptyRowErrors IN h-bodi516.
                RUN createRecord IN h-bodi516.
            END.   
            ELSE do:
                RUN setRecord IN h-bodi516 (INPUT TABLE tt2-item-nf-adc).
                RUN emptyRowErrors IN h-bodi516.
                RUN updateRecord IN h-bodi516.  
            END.
        END.
    END.

    /*** REINF R-2055 CD4035 - Aquisiá∆o Produá∆o Rural ***/
    IF AVAIL emitente AND SUBSTRING(emitente.char-2,104,8) = "PR Rural":U AND
       AVAIL natur-oper AND SUBSTRING(natur-oper.char-1,176,1) <> "0" AND /*Comercializacao Producao Rural*/
       natur-oper.emite-duplic AND         /*Gerar Duplicatas*/
       docum-est.cod-observa <> 3 AND      /*Devoluá∆o Cliente*/
       docum-est.cod-observa <> 4 THEN DO: /*Serviáo*/
       
       EMPTY TEMP-TABLE tt-item-nf-adc.
       
       IF NOT VALID-HANDLE(h-bodi516) THEN
          RUN dibo/bodi516.p PERSISTENT SET h-bodi516.
       RUN openQueryStatic IN h-bodi516 (INPUT "Main":U).
       
       CREATE tt-item-nf-adc.
       ASSIGN tt-item-nf-adc.cod-estab        = docum-est.cod-estabel
              tt-item-nf-adc.cod-serie        = RowObject.serie-docto 
              tt-item-nf-adc.cod-nota-fisc    = RowObject.nro-docto   
              tt-item-nf-adc.cdn-emitente     = RowObject.cod-emitente
              tt-item-nf-adc.cod-natur-operac = RowObject.nat-of
              tt-item-nf-adc.idi-tip-dado     = 35 /*REINF R-2055*/
              tt-item-nf-adc.num-seq          = RowObject.sequencia
              tt-item-nf-adc.num-seq-item-nf  = RowObject.sequencia
              tt-item-nf-adc.cod-item         = RowObject.it-codigo
              tt-item-nf-adc.val-livre-1      = (RowObject.preco-total[1] + RowObject.despesas[1] - RowObject.desconto[1]).
              
        RUN goToKey IN h-bodi516 (INPUT docum-est.cod-estabel,       
                                  INPUT RowObject.serie-docto,       
                                  INPUT RowObject.nro-docto,   
                                  INPUT RowObject.cod-emitente,    
                                  INPUT RowObject.nat-of,
                                  INPUT 35, /*REINF R-2055*/
                                  INPUT RowObject.sequencia,
                                  INPUT RowObject.sequencia,
                                  INPUT RowObject.it-codigo).
        IF RETURN-VALUE <> "OK":U THEN DO:
            RUN setRecord      IN h-bodi516 (INPUT TABLE tt-item-nf-adc).
            RUN emptyRowErrors IN h-bodi516.
            RUN createRecord   IN h-bodi516.
        END.
    END.
    /******************************************************/

    return "OK":U.

    FINALLY:
        DELETE PROCEDURE h-bodi516 NO-ERROR.
        DELETE PROCEDURE h-boin01017 NO-ERROR.
        ASSIGN h-bodi516 = ?
               h-boin01017 = ?.
    END FINALLY.

END PROCEDURE.
