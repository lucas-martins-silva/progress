&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice prmsqdtb-ix2
  Parameters:  
               recebe valor do campo cod-estabel-dest
               recebe valor do campo cod-estabel-orig
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-estabel-dest LIKE seq-estab-calc-med.cod-estabel-dest NO-UNDO.
    DEFINE INPUT PARAMETER pcod-estabel-orig LIKE seq-estab-calc-med.cod-estabel-orig NO-UNDO.

    FIND FIRST bfseq-estab-calc-med WHERE 
        bfseq-estab-calc-med.cod-estabel-dest = pcod-estabel-dest AND 
        bfseq-estab-calc-med.cod-estabel-orig = pcod-estabel-orig NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfseq-estab-calc-med THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfseq-estab-calc-med)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE linkToOrigem DBOProgram 
PROCEDURE linkToOrigem :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE INPUT PARAMETER pHandle AS HANDLE NO-UNDO.

    DEFINE VARIABLE c-cod-estabel AS CHARACTER   NO-UNDO.
    
    RUN getKey IN pHandle (OUTPUT c-cod-estabel).
   
    RUN setConstraintOrigem IN THIS-PROCEDURE (INPUT c-cod-estabel).

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

