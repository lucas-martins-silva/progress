&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE piVerificaLooping DBOProgram 
PROCEDURE piVerificaLooping :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE INPUT PARAMETER p-cod-estabel    LIKE estab-mat.cod-estabel  NO-UNDO.

    FOR EACH seq-estab-calc-med
        WHERE seq-estab-calc-med.cod-estabel-orig = p-cod-estabel NO-LOCK:

        IF seq-estab-calc-med.cod-estabel-dest = RowObject.cod-estabel-orig THEN
            RETURN "LOOP".

        RUN piVerificaLooping (INPUT seq-estab-calc-med.cod-estabel-dest).
        IF RETURN-VALUE = "LOOP" THEN
            RETURN RETURN-VALUE.
    END.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

