&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/

    IF pType <> "DELETE" THEN DO:

        IF RowObject.cod-estabel-orig = RowObject.cod-estabel-dest THEN DO:

            {method/svc/errors/inserr.i &ErrorNumber="56537"
                                        &ErrorType="EMS"
                                        &ErrorSubType="ERROR"
                                        &ErrorParameters="''"}
        END.

        IF NOT CAN-FIND(FIRST estab-mat
                        WHERE estab-mat.cod-estabel = RowObject.cod-estabel-orig) THEN DO:

            {utp/ut-liter.i "Estabelecimento_Origem" *}            
            {method/svc/errors/inserr.i &ErrorNumber="2"
                                        &ErrorType="EMS"
                                        &ErrorSubType="ERROR"
                                        &ErrorParameters="return-value"}
        END.

        IF NOT CAN-FIND(FIRST estab-mat
                        WHERE estab-mat.cod-estabel = RowObject.cod-estabel-dest) THEN DO:

            {utp/ut-liter.i "Estabelecimento_Destino" *}            
            {method/svc/errors/inserr.i &ErrorNumber="2"
                                        &ErrorType="EMS"
                                        &ErrorSubType="ERROR"
                                        &ErrorParameters="return-value"}
        END.

        IF CAN-FIND(FIRST seq-estab-calc-med
                    WHERE seq-estab-calc-med.cod-estabel-dest = RowObject.cod-estabel-dest
                    AND   seq-estab-calc-med.cod-estabel-orig = RowObject.cod-estabel-orig) THEN DO:

            {utp/ut-liter.i "Relacionamento_Estabelecimentos" *}        
            {method/svc/errors/inserr.i &ErrorNumber="1"
                                        &ErrorType="EMS"
                                        &ErrorSubType="ERROR"
                                        &ErrorParameters="RETURN-VALUE"}
        END.

        RUN piVerificaLooping (INPUT RowObject.cod-estabel-dest).
        IF RETURN-VALUE = "LOOP" THEN DO:

            {method/svc/errors/inserr.i &ErrorNumber="56537"
                                        &ErrorType="EMS"
                                        &ErrorSubType="ERROR"
                                        &ErrorParameters="''"}
        END.
    END.                        
    
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

