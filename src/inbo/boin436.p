&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQuery DBOProgram 
PROCEDURE openQuery :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
/* ------------------------ PROXIES BO 1.1 ----------------------------- */

    define input parameter i-abertura as integer no-undo.
       case i-abertura:
           when 1 then
              RUN openQueryStatic (input "Main":U). 
              
           when 2 then
              RUN openQueryStatic (input "ByFiltroTipoPer":U).
           
                    
       end case.
    
    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryByFiltroTipoPer DBOProgram 
PROCEDURE openQueryByFiltroTipoPer :
/*------------------------------------------------------------------------------
  Purpose:    Busca conjunto de registros da tabela tipo-per, considerando
              uma faixa de tipo de per¡odo inicial e final.
              Ordena por tipo de per¡odo. 
  ------------------------------------------------------------------------------*/
  open query {&QUERYNAME} for each {&TABLENAME} where {&TABLENAME}.cd-tipo >= integer(c-inicial) AND
                                                      {&TABLENAME}.cd-tipo <= integer(c-final)
                                                       NO-LOCK by {&TABLENAME}.cd-tipo INDEXED-REPOSITION.
                                          
    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryMain DBOProgram 
PROCEDURE openQueryMain :
/*------------------------------------------------------------------------------
  Purpose:     Abertura da query principal do DBO
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH tipo-per NO-LOCK INDEXED-REPOSITION.

    RETURN "OK":U.
END PROCEDURE.

