def new global shared var v_cod_usuar_corren   like usuar_mestre.cod_usuario no-undo.
{cdp/cdcfgmat.i}
{cdp/cdcfgman.i}

/****************************************************************************
** Procedures evento delete / ex-trigger 
*****************************************************************************/
PROCEDURE EliminarReporteParada: 
    
    def param buffer b-rep-parada-ctrab for rep-parada-ctrab.
    
    def var v-cod-ctrab       like ctrab.cod-ctrab.
    def var v-val-refer-inic like rep-parada-ctrab.val-refer-inic-parada.
    def var v-val-refer-fim  like rep-parada-ctrab.val-refer-inic-parada.
    def var v-cod-equipe     like rep-parada-ctrab.cod-equipe.
    def var l-funcao-ativa   as log init no no-undo.

    /*** Elimina‡Æo em cascata da tabela filho: rep-parada-mod, e atualiza‡Æo
         da manuten‡Æo programada (man-progda-ctrab) para estado 'ativo'. ***/
     /*Moises - Altera‡Æo devido a forma de cria‡Æo da tabela rep-parada-ctrab
     quando para um centro de trabalho que tenha o processador manual e seja
     reportado na mesma data e hora de inicio ele grava no campo val-refer-inic-parada
     segundos a mais por problemas de indice.
     Alterado para verificar tamb‚m o centro de trabalho do rep-parada-mod, pois nos casos 
     de reporte de parada geral, ocorre a criacao de v rios reportes de parada no mesmo hor rio para
     o mesmo operador.*/
     run pi-converte-data-segs-valor (Input b-rep-parada-ctrab.dat-inic-parada,
                                      Input b-rep-parada-ctrab.qtd-segs-inic,
                                      output v-val-refer-inic).
    IF CAN-FIND (FIRST funcao WHERE
        funcao.cd-funcao = "SPP-SFC-MODIFIC":U AND 
        funcao.ativo = YES) THEN DO:
                if not avail param-estoq then
                        find first param-estoq no-lock no-error.
                if b-rep-parada-ctrab.dat-inic-parada <= param-estoq.ult-fech-dia or
                   b-rep-parada-ctrab.dat-fim-parada  <= param-estoq.ult-fech-dia then do:
                   create tt-erro.
                   /* Inicio -- Projeto Internacional */
                   {utp/ut-liter.i "NÆo_‚_poss¡vel_eliminar_parada_pertencente_a_um_per¡odo_j _finalizado" *}
                   assign tt-erro.mensagem = RETURN-VALUE.
                   assign tt-erro.cd-erro = 17006.
                   run cdp/cd0666.w (input table tt-erro).
                   delete tt-erro.
                   return "NOK":U.
                end.
    end.
   
    for each rep-parada-mod
        where rep-parada-mod.cod-equipe             = b-rep-parada-ctrab.cod-equipe
          and rep-parada-mod.val-refer-inic-parada >= v-val-refer-inic
          and rep-parada-mod.val-refer-inic-parada <= b-rep-parada-ctrab.val-refer-fim-parada exclusive-lock:
          if rep-parada-mod.cod-ctrab = b-rep-parada-ctrab.cod-ctrab then
                delete rep-parada-mod.          
    end. 
    
    for each rep-parada-mod 
       where rep-parada-mod.cod-operador           = b-rep-parada-ctrab.cod-equipe
         and rep-parada-mod.val-refer-inic-parada >= v-val-refer-inic
         and rep-parada-mod.val-refer-inic-parada <= b-rep-parada-ctrab.val-refer-fim-parada exclusive-lock:
          if rep-parada-mod.cod-ctrab = b-rep-parada-ctrab.cod-ctrab then 
                delete rep-parada-mod.  
    end. 

    /* Mudan‡as do ChÆo de F brica */
        FIND FIRST param-global NO-LOCK NO-ERROR.
        IF AVAIL param-global AND param-global.modulo-mi = TRUE THEN DO:
        
            if can-find(FIRST funcao
                        WHERE funcao.cd-funcao = "sfc-mudancas":U
                          AND funcao.ativo     = TRUE) then assign l-funcao-ativa = yes. else assign l-funcao-ativa = no.
            
            assign l-funcao-ativa = yes.    
                
            IF l-funcao-ativa THEN DO:
                FOR FIRST reporte-parada-ctrab-mi
                    WHERE reporte-parada-ctrab-mi.cod-ctrab             = b-rep-parada-ctrab.cod-ctrab
                    AND   reporte-parada-ctrab-mi.val-refer-inic-parada = b-rep-parada-ctrab.val-refer-inic-parada EXCLUSIVE-LOCK:
                    DELETE reporte-parada-ctrab-mi.
                END.
            END.
        END.
    
    /* Atualiza o estado da manuten‡Æo programada para 'ativa' (nÆo reportada) */
    if  b-rep-parada-ctrab.num-om-progda <> 0 then do:
        find man-progda-ctrab
            where man-progda-ctrab.cod-ctrab     = b-rep-parada-ctrab.cod-ctrab
              and man-progda-ctrab.num-om-progda = b-rep-parada-ctrab.num-om-progda
            exclusive-lock no-error.
        if  avail man-progda-ctrab then 
            assign man-progda-ctrab.log-man-ativa = yes.
    end.

    assign v-cod-ctrab      = b-rep-parada-ctrab.cod-ctrab
           /*v-val-refer-inic = b-rep-parada-ctrab.val-refer-inic-parada*/
           v-val-refer-fim  = b-rep-parada-ctrab.val-refer-fim-parada
           v-cod-equipe     = b-rep-parada-ctrab.cod-equipe.
    
    delete b-rep-parada-ctrab.
    
    run AtualizarReportesRelacionados (input v-cod-ctrab, 
                                       input v-cod-equipe, 
                                       input v-val-refer-inic, 
                                       input v-val-refer-fim).
                                       
    run atualizaMovtoGGFMOB(input v-cod-ctrab,        
                         input v-val-refer-inic,  
                         input v-val-refer-fim,
                         input "soma":U).

END PROCEDURE.


PROCEDURE AtualizarReportesRelacionados:

    def input parameter p-cod-ctrab      like rep-parada-ctrab.cod-ctrab.
    def input parameter p-cod-equipe     like rep-parada-ctrab.cod-equipe.
    def input parameter p-val-refer-inic like rep-parada-ctrab.val-refer-inic-parada.
    def input parameter p-val-refer-fim  like rep-parada-ctrab.val-refer-fim-parada.
    
    /**** run atualizar-carga-ctrab - Fun‡Æo SFC ainda nÆo implementada ***/
    
    /*** Altera‡Æo de tempo de reportes de opera‡Æo que contem parada eliminada ***/
    find ctrab
        where ctrab.cod-ctrab = p-cod-ctrab no-lock.
    
    if  ctrab.ind-tip-ctrab <> 4 /* Manual */ then do:
    
        find last rep-oper-ctrab use-index ctrab-i
            where rep-oper-ctrab.cod-ctrab           = ctrab.cod-ctrab
              and rep-oper-ctrab.val-refer-inic-rep  < p-val-refer-fim no-lock no-error.
            
        repeat:
            if  not available rep-oper-ctrab
            or  rep-oper-ctrab.val-refer-fim-rep  < p-val-refer-inic then
                leave.
            
            run AtualizarTempoRepOper (buffer rep-oper-ctrab).            
    
            find prev rep-oper-ctrab use-index ctrab-i
                where rep-oper-ctrab.cod-ctrab = ctrab.cod-ctrab no-lock no-error.
        end.
    end.    
    else do:
    
        find last rep-oper-ctrab
            where rep-oper-ctrab.cod-ctrab             = ctrab.cod-ctrab 
              and rep-oper-ctrab.val-refer-inic-rep    < p-val-refer-fim 
              and rep-oper-ctrab.cod-equipe            = p-cod-equipe no-lock no-error.
            
        repeat:
            if  not available rep-oper-ctrab
            or  rep-oper-ctrab.val-refer-fim-rep  < p-val-refer-inic then
                leave.
    
            run AtualizarTempoRepOper (buffer rep-oper-ctrab).
                
            find prev rep-oper-ctrab use-index ctrab-i
                where rep-oper-ctrab.cod-ctrab  = ctrab.cod-ctrab 
                  and rep-oper-ctrab.cod-equipe = p-cod-equipe no-lock no-error.
        end.
    end.

END PROCEDURE.

PROCEDURE iniciarRepParadaCtrabPrev:

    def input param p-cod-ctrab       like rep-parada-ctrab.cod-ctrab no-undo.
    def input param p-num-om-progda   like rep-parada-ctrab.num-om-progda no-undo.
    def input param p-dat-inic-parada like rep-parada-ctrab.dat-inic-parada no-undo.
    def input param p-hra-inic-parada as char format "99:99:99" no-undo.
    def input param p-dat-fim-parada  like rep-parada-ctrab.dat-inic-parada no-undo.
    def input param p-hra-fim-parada  as integer                       no-undo.
    def input param p-cod-parada      like rep-parada-ctrab.cod-parada no-undo.
    def input param p-cod-operador    like rep-oper-ctrab.cod-operador no-undo.
    def input param p-equipe          like rep-parada-ctrab.cod-equipe no-undo.
    
    find ctrab 
        where ctrab.cod-ctrab = p-cod-ctrab no-lock no-error.

    find first param-sfc no-lock no-error.
    
    create rep-parada-ctrab.
    assign rep-parada-ctrab.cod-ctrab       = p-cod-ctrab
           rep-parada-ctrab.cod-parada      = p-cod-parada
           rep-parada-ctrab.dat-inic-parada = p-dat-inic-parada
           rep-parada-ctrab.num-om-progda   = p-num-om-progda
           rep-parada-ctrab.dat-fim-parada  = date(12,31,9998)
           rep-parada-ctrab.data-1          = p-dat-fim-parada
           rep-parada-ctrab.int-1           = p-hra-fim-parada.

    if  param-sfc.log-tipo-relogio then do:
        run pi-formatted-time-to-sec ( input p-hra-inic-parada,
                                      output rep-parada-ctrab.qtd-segs-inic).
    end.
    else
        assign rep-parada-ctrab.qtd-segs-inic = int(p-hra-inic-parada) * 36.

    run pi-converte-data-segs-valor (input rep-parada-ctrab.dat-inic-parada,
                                     input rep-parada-ctrab.qtd-segs-inic,
                                     output rep-parada-ctrab.val-refer-inic-parada).

    run pi-converte-data-segs-valor (input date(12,31,9998),
                                     input 86400,
                                     output rep-parada-ctrab.val-refer-fim-parada).
                                     
    if  ctrab.ind-reporte-mod = 2 /* Reporta Operador */ then
        assign rep-parada-ctrab.cod-equipe = p-cod-operador.
    else
        assign rep-parada-ctrab.cod-equipe = p-equipe.
    
    assign rep-parada-ctrab.cod-usuar-reporte = v_cod_usuar_corren.
	
    run atualizaMovtoGGFMOB(input p-cod-ctrab,        
                         input rep-parada-ctrab.val-refer-inic-parada,  
                         input rep-parada-ctrab.val-refer-fim-parada,
                         input "subtrai":U).
END.

PROCEDURE iniciarRepParadaCtrab:

    def input param p-cod-ctrab       like rep-parada-ctrab.cod-ctrab no-undo.
    def input param p-num-om-progda   like rep-parada-ctrab.num-om-progda no-undo.
    def input param p-dat-inic-parada like rep-parada-ctrab.dat-inic-parada no-undo.
    def input param p-hra-inic-parada as char format "99:99:99" no-undo.
    def input param p-cod-parada      like rep-parada-ctrab.cod-parada no-undo.
    def input param p-cod-operador    like rep-oper-ctrab.cod-operador no-undo.
    def input param p-equipe          like rep-parada-ctrab.cod-equipe no-undo.
    
    RUN iniciarRepParadaCtrabPrev(p-cod-ctrab,      
                                  p-num-om-progda,  
                                  p-dat-inic-parada,
                                  p-hra-inic-parada,
                                  12/31/9999,
                                  86399,
                                  p-cod-parada,     
                                  p-cod-operador,
                                  p-equipe).
END PROCEDURE.

PROCEDURE finalizarRepParadaCtrab:

    def input param p-dat-fim-parada like rep-parada-ctrab.dat-fim-parada no-undo.
    def input param p-hra-fim-parada as char format "99:99:99" no-undo.
    def input param p-rw-rep-parada  as rowid no-undo.
    
    find first param-sfc no-lock no-error.
    
    find rep-parada-ctrab
        where rowid(rep-parada-ctrab) = p-rw-rep-parada exclusive-lock no-error.
    
    assign rep-parada-ctrab.dat-fim-parada = p-dat-fim-parada.
    
    if length(p-hra-fim-parada) < 6 then 
        assign p-hra-fim-parada = fill("0":u, 6 - length(p-hra-fim-parada)) + p-hra-fim-parada.
        
    if  param-sfc.log-tipo-relogio then do:
        run pi-formatted-time-to-sec (input p-hra-fim-parada,
                                      output rep-parada-ctrab.qtd-segs-fim).
    end.
    else
        assign rep-parada-ctrab.qtd-segs-fim = int(p-hra-fim-parada) * 36.

    run pi-converte-data-segs-valor (input rep-parada-ctrab.dat-fim-parada,
                                     input rep-parada-ctrab.qtd-segs-fim,
                                     output rep-parada-ctrab.val-refer-fim-parada).
									 
    assign rep-parada-ctrab.cod-usuar-reporte = v_cod_usuar_corren.									 

END PROCEDURE.


procedure atualizaMovtoGGFMOB:

    def input param p-cod-ctrab       like ctrab.cod-ctrab                        no-undo.
    def input param p-val-refer-inic  like rep-parada-ctrab.val-refer-inic-parada no-undo.
    def input param p-val-refer-fim   like rep-parada-ctrab.val-refer-inic-parada no-undo.
    def input param p-acao            as char no-undo.

    DEF VAR data-medio LIKE param-estoq.mensal-ate NO-UNDO.
                               
    DEF VAR var-ini-intervalo  LIKE rep-oper-ctrab.val-refer-inic-rep NO-UNDO.
    DEF VAR var-fim-intervalo  LIKE rep-oper-ctrab.val-refer-inic-rep NO-UNDO.
    DEF VAR var-data-ini       AS DATE NO-UNDO.
    DEF VAR var-data-fim       AS DATE NO-UNDO.
    DEF VAR var-hora-ini       AS DEC format "->>>>,>>9.9999" decimals 4 no-undo.
    DEF VAR var-hora-fim       AS DEC format "->>>>,>>9.9999" decimals 4 no-undo.
    DEFINE VARIABLE i-num-dias AS INTEGER    NO-UNDO.
    
    DEF VAR var-hora-aux       AS DEC format "->>>>,>>9.9999" decimals 4 no-undo.
    DEF VAR var-hora-auxa      AS DEC format "->>>>,>>9.9999" decimals 4 no-undo.
    DEF VAR var-hora-auxb      AS DEC format "->>>>,>>9.9999" decimals 4 no-undo.
    
    def var i-num-oper         as integer                                no-undo.
    def var i-nr-reporte       as integer                                no-undo.
                                   
    /*GUARARAPES*/
    FIND FIRST param-sfc NO-LOCK NO-ERROR.
    if  param-sfc.log-parada-atualiza-ggf
    AND param-sfc.log-gera-ggf-autom = YES 
    THEN DO:
        FOR EACH rep-oper-ctrab
           WHERE rep-oper-ctrab.cod-ctrab           = p-cod-ctrab     
            AND  rep-oper-ctrab.val-refer-fim-rep  >= p-val-refer-inic
            AND  rep-oper-ctrab.val-refer-inic-rep <= p-val-refer-fim   NO-LOCK:
           
           run pi-retorna-equipe(buffer rep-oper-ctrab,output i-num-oper).  
           
           if rep-oper-ctrab.qtd-operac-reptda = 0 then 
              assign i-nr-reporte = 0.
           else
              assign i-nr-reporte = rep-oper-ctrab.nr-reporte.
           
           FOR EACH movto-ggf use-index ordem
              WHERE movto-ggf.nr-ord-produ = rep-oper-ctrab.nr-ord-produ
               AND  movto-ggf.nr-reporte  = i-nr-reporte EXCLUSIVE-LOCK:
               
               if (i-nr-reporte = 0 and movto-ggf.num-seq-rep <> rep-oper-ctrab.num-seq-rep) or 
                  (i-nr-reporte = 0 and movto-ggf.log-estorno <> no)                       then next.
               for first ord-prod fields(nr-ord-produ reporte-ggf estado rep-prod)
                    where ord-prod.nr-ord-produ = movto-ggf.nr-ord-produ NO-LOCK:
               end.     
               IF AVAIL ord-prod /*AND ord-prod.reporte-ggf = 1*/ AND ord-prod.estado < 8 AND ord-prod.rep-prod < 4 THEN DO:
                   for first estabelec fields(cod-estabel usa-on-line usa-padrao)
                       where estabelec.cod-estabel = movto-ggf.cod-estabel NO-LOCK:
                   end.
                   IF AVAIL estabelec AND estabelec.usa-on-line = NO AND estabelec.usa-padrao = NO THEN DO:
                       find first param-estoq no-lock no-error.
                            IF param-estoq.tp-fech = 2 THEN DO:
                               for first estab-mat fields(cod-estabel mensal-ate) 
                                   where estab-mat.cod-estabel = movto-ggf.cod-estabel no-lock:
                               end.
                               IF AVAIL estab-mat  THEN
                                   ASSIGN data-medio = estab-mat.mensal-ate.
                            END.
                            ELSE ASSIGN data-medio = param-estoq.mensal-ate.
                        
			IF movto-ggf.dt-trans > data-medio THEN DO:
                           /*Calcula o tempo da intersec‡Æo entre a parada e o reporte*/

                            ASSIGN var-ini-intervalo = MAX(rep-oper-ctrab.val-refer-inic-rep,p-val-refer-inic)
                                   var-fim-intervalo = MIN(rep-oper-ctrab.val-refer-fim-rep,p-val-refer-fim).

                            IF var-ini-intervalo < var-fim-intervalo THEN DO:
                                RUN pi-converte-valor-data-segs(INPUT var-ini-intervalo,
                                                                OUTPUT var-data-ini,
                                                                OUTPUT var-hora-ini).

                                RUN pi-converte-valor-data-segs(INPUT var-fim-intervalo,
                                                                OUTPUT var-data-fim,
                                                                OUTPUT var-hora-fim).

                                IF var-data-ini = var-data-fim THEN 
                                    ASSIGN var-hora-ini = var-hora-fim - var-hora-ini
                                           var-hora-ini  = var-hora-ini * i-num-oper. /*Quando ‚ reporte por equipe*/
                                ELSE
                                    /*tratamento caso nao seja a mesma data*/
                                    ASSIGN i-num-dias = INTEGER(var-data-fim - var-data-ini) /*pega o numero de dias de diferen‡a entre o inicial e final.*/
                                           var-hora-aux = (24 * 60 * 60) - var-hora-ini /*numero de segundos entre o final do 1o dia e a hora inicial*/
                                           var-hora-auxa = (24 * 60 * 60) * (i-num-dias - 1) /*numero de segundos nos dias entre o 1o e o ultimo*/
                                           var-hora-auxb = var-hora-fim
                                           var-hora-ini  = var-hora-aux + var-hora-auxa + var-hora-auxb
                                           var-hora-ini  = var-hora-ini * i-num-oper. /*Quando ‚ reporte por equipe*/
                              
                                
                                /*neste ponto, o var-hora-ini tem q qtd de segundos da parada. Tenho que transformar isso em hora decimal*/
                                if p-acao = "subtrai":U then                               /*transforma em decimal o tempo em segundos*/
                                     ASSIGN movto-ggf.horas-report = if (movto-ggf.horas-report - (var-hora-ini / 60 / 60)) < 0 then 0 else movto-ggf.horas-report - (var-hora-ini / 60 / 60).
                                else
                                     ASSIGN movto-ggf.horas-report = movto-ggf.horas-report + (var-hora-ini / 60 / 60).        

/*                                 ASSIGN movto-ggf.horas-report = rep-oper-ctrab.qtd-tempo-reporte. */
                            END.
                        END.
                   END.
               END.
           END.
        END.
    END.
    
    if  substring(param-sfc.CHAR-1, 34, 1) = "S"
    AND param-sfc.log-gera-mod-autom = YES 
    THEN DO:
        FOR EACH rep-oper-ctrab
           WHERE rep-oper-ctrab.cod-ctrab           = p-cod-ctrab     
            AND  rep-oper-ctrab.val-refer-fim-rep  >= p-val-refer-inic
            AND  rep-oper-ctrab.val-refer-inic-rep <= p-val-refer-fim   NO-LOCK:
           
           run pi-retorna-equipe(buffer rep-oper-ctrab,output i-num-oper).  
           
           if rep-oper-ctrab.qtd-operac-reptda = 0 then 
              assign i-nr-reporte = 0.
           else
              assign i-nr-reporte = rep-oper-ctrab.nr-reporte.
           
           FOR EACH movto-dir use-index ordem
              WHERE movto-dir.nr-ord-produ = rep-oper-ctrab.nr-ord-produ
               AND  movto-dir.nr-reporte  = i-nr-reporte EXCLUSIVE-LOCK:
               
               if (i-nr-reporte = 0 and movto-dir.num-seq-rep <> rep-oper-ctrab.num-seq-rep) or 
                  (i-nr-reporte = 0 and movto-dir.log-estorno <> no)                       then next.
               
               for first ord-prod fields(nr-ord-produ reporte-mob estado rep-prod)
                    where ord-prod.nr-ord-produ = movto-dir.nr-ord-produ NO-LOCK:
               end.     
               IF AVAIL ord-prod /*AND ord-prod.reporte-mob = 1*/ AND ord-prod.estado < 8 AND ord-prod.rep-prod < 4 THEN DO:
                   for first estabelec fields(cod-estabel usa-on-line usa-padrao)
                       where estabelec.cod-estabel = movto-dir.cod-estabel NO-LOCK:
                   end.
                   IF AVAIL estabelec AND estabelec.usa-on-line = NO AND estabelec.usa-padrao = NO THEN DO:
                       find first param-estoq no-lock no-error.
                            IF param-estoq.tp-fech = 2 THEN DO:
                               for first estab-mat fields(cod-estabel mensal-ate) 
                                   where estab-mat.cod-estabel = movto-dir.cod-estabel no-lock:
                               end.
                               IF AVAIL estab-mat  THEN
                                   ASSIGN data-medio = estab-mat.mensal-ate.
                            END.
                            ELSE ASSIGN data-medio = param-estoq.mensal-ate.
                        
			IF movto-dir.dt-trans > data-medio THEN DO:
                           /*Calcula o tempo da intersec‡Æo entre a parada e o reporte*/

                            ASSIGN var-ini-intervalo = MAX(rep-oper-ctrab.val-refer-inic-rep,p-val-refer-inic)
                                   var-fim-intervalo = MIN(rep-oper-ctrab.val-refer-fim-rep,p-val-refer-fim).

                            IF var-ini-intervalo < var-fim-intervalo THEN DO:
                                RUN pi-converte-valor-data-segs(INPUT var-ini-intervalo,
                                                                OUTPUT var-data-ini,
                                                                OUTPUT var-hora-ini).

                                RUN pi-converte-valor-data-segs(INPUT var-fim-intervalo,
                                                                OUTPUT var-data-fim,
                                                                OUTPUT var-hora-fim).

                                IF var-data-ini = var-data-fim THEN 
                                    ASSIGN var-hora-ini = var-hora-fim - var-hora-ini
                                           var-hora-ini  = var-hora-ini * i-num-oper. /*Quando ‚ reporte por equipe*/
                                ELSE
                                    /*tratamento caso nao seja a mesma data*/
                                    ASSIGN i-num-dias = INTEGER(var-data-fim - var-data-ini) /*pega o numero de dias de diferen‡a entre o inicial e final.*/
                                           var-hora-aux = (24 * 60 * 60) - var-hora-ini /*numero de segundos entre o final do 1o dia e a hora inicial*/
                                           var-hora-auxa = (24 * 60 * 60) * (i-num-dias - 1) /*numero de segundos nos dias entre o 1o e o ultimo*/
                                           var-hora-auxb = var-hora-fim
                                           var-hora-ini  = var-hora-aux + var-hora-auxa + var-hora-auxb
                                           var-hora-ini  = var-hora-ini * i-num-oper. /*Quando ‚ reporte por equipe*/
                              
                                
                                /*neste ponto, o var-hora-ini tem q qtd de segundos da parada. Tenho que transformar isso em hora decimal*/
                                if p-acao = "subtrai":U then                               /*transforma em decimal o tempo em segundos*/
                                     ASSIGN movto-dir.tempo-homem =  IF (movto-dir.tempo-homem - (var-hora-ini / 60 / 60))  < 0 THEN 0 ELSE movto-dir.tempo-homem - (var-hora-ini / 60 / 60)
                                            movto-dir.horas-report = movto-dir.tempo-homem .
                                else
                                     ASSIGN movto-dir.tempo-homem =  movto-dir.tempo-homem + (var-hora-ini / 60 / 60)
                                            movto-dir.horas-report = movto-dir.tempo-homem .

                            END.
                        END.
                   END.
               END.
           END.
        END.
    END.


    /*GUARARAPES*/
end procedure.


procedure pi-retorna-equipe:
   def parameter buffer b-rep-oper-ctrab for rep-oper-ctrab.
   
   def var l-req-eq-ggf-dir as log init yes no-undo.
   
   def output parameter i-num-oper as integer init 1 no-undo.
   
   find equipe-prod no-lock
        where equipe-prod.cod-equipe = b-rep-oper-ctrab.cod-equipe no-error.
        
   assign i-num-oper = 1.
   if avail equipe-prod and l-req-eq-ggf-dir then do:
        ASSIGN i-num-oper = 0.
        for each equipe-operador 
            where equipe-operador.cod-equipe     =  b-rep-oper-ctrab.cod-equipe
              AND equipe-operador.dat-inic-valid <= b-rep-oper-ctrab.dat-inic-reporte
              AND equipe-operador.dat-fim-valid  >  b-rep-oper-ctrab.dat-fim-reporte no-lock:
            ASSIGN i-num-oper = i-num-oper + 1.
        END.
        if i-num-oper = 0 then assign i-num-oper = 1.
   end.
   
   return "OK":U.
end.
