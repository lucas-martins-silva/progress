&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE beforeCreateRecord DBOProgram 
PROCEDURE beforeCreateRecord :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

RUN pi-log-alteracao.

def buffer b-af-excecao for af-excecao.
def var i-seq like af-excecao.nr-trans no-undo.
 
blk-1:
repeat: 
    assign i-seq = next-value(seq-af-excecao,emsdca).
    if  not can-find(b-af-excecao
               where b-af-excecao.nr-trans = i-seq) then
        leave blk-1.
end.
assign RowObject.nr-trans = i-seq.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

