&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice ep-fornecedor
  Parameters:  
               recebe valor do campo ep-codigo
               recebe valor do campo cod-emitente
               recebe valor do campo ind-tipo-doc
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pep-codigo LIKE af-excecao.ep-codigo NO-UNDO.
    DEFINE INPUT PARAMETER pcod-emitente LIKE af-excecao.cod-emitente NO-UNDO.
    DEFINE INPUT PARAMETER pind-tipo-doc LIKE af-excecao.ind-tipo-doc NO-UNDO.

    FIND FIRST bfaf-excecao WHERE 
        bfaf-excecao.ep-codigo = pep-codigo AND 
        bfaf-excecao.cod-emitente = pcod-emitente AND 
        bfaf-excecao.ind-tipo-doc = pind-tipo-doc NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfaf-excecao THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfaf-excecao)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryByCodEmitente DBOProgram 
PROCEDURE openQueryByCodEmitente :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    OPEN QUERY {&QueryName} FOR EACH {&TableName} 
                               WHERE {&TableName}.ep-codigo = i-ep-codigo-usuario
                                 AND {&TableName}.cod-emitente >= i-cod-emitente-ini
                                 AND {&TableName}.cod-emitente <= i-cod-emitente-fin NO-LOCK 
        BY {&TableName}.cod-emitente
        BY {&tablename}.ind-tipo-doc
        BY {&TableName}.dt-implantacao.

    RETURN "OK":U.


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

