def temp-table tt-dt-periodo-aval no-undo
   field dt-periodo-ini   like af-periodo-aval.dt-periodo-ini[1]
   field dt-periodo-fim   like af-periodo-aval.dt-periodo-fim[1]
   field ano-avaliacao    like af-periodo-aval.ano-avaliacao
   field des-periodo-aval like af-periodo-aval.des-periodo-aval[1]
   field log-fechado      like af-periodo-aval.log-fechado[1]
index tt-dt-periodo-aval as primary dt-periodo-ini.

   
