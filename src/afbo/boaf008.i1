/* ***************************  Definitions  **************************** */

DEFINE TEMP-TABLE tt-notas NO-UNDO
    FIELD cod-estabel  like af-contr-indice.cod-estabel
    field cod-emitente like af-contr-indice.cod-emitente
    field it-codigo    like af-contr-indice.it-codigo
    field nr-controle  like af-contr-indice.nr-controle
    field dt-indice    like af-contr-indice.dt-indice 
    field dt-indice-ini like af-periodo-aval.dt-periodo-ini[1] COLUMN-LABEL "Dt ini"
    field dt-indice-fim like af-periodo-aval.dt-periodo-fim[1] COLUMN-LABEL "Dt fim"
    field ano-avaliacao like af-periodo-aval.ano-avaliacao COLUMN-LABEL "Ano"
    FIELD des-periodo-aval LIKE af-periodo-aval.des-periodo-aval[1] COLUMN-LABEL "Per¡odo"
    field cod-grp-resp like af-item-contr-estab-form.cod-grp-resp
    field fm-codigo    like item.fm-codigo
    field ge-codigo    like item.ge-codigo
    field cod-gr-forn  like emitente.cod-gr-forn
    field indice       as   dec label "Öndice"
    field percentual   as   dec label "Percentual"
    field nota         as   dec label "Nota"
    field tipo         as   char label "Tipo"
    field nome-abrev   like emitente.nome-abrev
    field nome-emit    like emitente.nome-emit
    field desc-item    like item.desc-item
    field usuar-alter  like af-contr-indice.usuar-alter
    field descricao    like af-controle.descricao
    field narrativa    like af-contr-indice.narrativa
    FIELD movimento    LIKE af-contr-indice.movimento 

index ch-nota cod-estabel
              cod-emitente
              it-codigo
              nr-controle
              dt-indice-fim
              tipo
              
index ch-tipo tipo
              cod-estabel
              cod-emitente
              it-codigo
              nr-controle
              dt-indice-fim.

