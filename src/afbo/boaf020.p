&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getKey DBOProgram  
PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice ep-grupo-usuario
  Parameters:  
               retorna valor do campo cod-grp-resp
               retorna valor do campo cod-usuario
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pcod-grp-resp LIKE af-grp-resp-usuario.cod-grp-resp NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-usuario LIKE af-grp-resp-usuario.cod-usuario NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pcod-grp-resp = RowObject.cod-grp-resp
           pcod-usuario = RowObject.cod-usuario.

    RETURN "OK":U.
END PROCEDURE.

