&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram  
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice ep-grupo-usuario
  Parameters:  
               recebe valor do campo cod-grp-resp
               recebe valor do campo cod-usuario
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-grp-resp LIKE af-grp-resp-usuario.cod-grp-resp NO-UNDO.
    DEFINE INPUT PARAMETER pcod-usuario LIKE af-grp-resp-usuario.cod-usuario NO-UNDO.

    FIND FIRST bfaf-grp-resp-usuario WHERE 
        bfaf-grp-resp-usuario.ep-codigo = i-ep-codigo-usuario AND 
        bfaf-grp-resp-usuario.cod-grp-resp = pcod-grp-resp AND 
        bfaf-grp-resp-usuario.cod-usuario = pcod-usuario NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfaf-grp-resp-usuario THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfaf-grp-resp-usuario)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE linkToGrupoResponsavel DBOProgram 
PROCEDURE linkToGrupoResponsavel :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    define input parameter pHandle as handle no-undo.

    run GetKey in phandle (output c-cod-grp-resp).

    return "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryByGrupoResponsavel DBOProgram 
PROCEDURE openQueryByGrupoResponsavel :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    open query {&QueryName}
        for each  {&TableName} 
            where {&TableName}.ep-codigo    = i-ep-codigo-usuario
            and   {&TableName}.cod-grp-resp = c-cod-grp-resp no-lock indexed-reposition.

    return "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

