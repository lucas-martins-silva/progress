DEFINE {1} TEMP-TABLE tt-transfer-serial-wms
   /* Info de Tela - Referente a Login */
   FIELD cod-usuario      AS CHARACTER  FORMAT 'x(14)':U          LABEL 'Usuario' 
   FIELD cod-coletor      AS CHARACTER  FORMAT 'x(14)':U          LABEL 'Coletor' 
   FIELD cod-equipamento  AS CHARACTER  FORMAT 'x(14)':U          LABEL 'Equipamento' 
   /* Info de Tela - Referente a Transferˆncia */
   FIELD cod-serial       AS DECIMAL    FORMAT '>>>>>>>>>>>>>9':U LABEL 'Serial'
   FIELD cod-depos-orig   AS CHARACTER  FORMAT 'x(3)':U           LABEL 'Deposito Origem'
   FIELD cod-local-orig   AS CHARACTER  FORMAT 'x(20)':U          LABEL 'Localizacao Origem'
   FIELD cod-depos-dest   AS CHARACTER  FORMAT 'x(3)':U           LABEL 'Deposito Destino' 
   FIELD cod-local-dest   AS CHARACTER  FORMAT 'x(20)':U          LABEL 'Localizacao Destino'
   FIELD tipo-equipamento AS INTEGER    FORMAT '>9':U             LABEL 'Tipo Equipamento' 
   FIELD cod-item	        AS CHARACTER  FORMAT 'x(16)':U	         LABEL 'Item'
   FIELD qtd-item	        AS DECIMAL    FORMAT '>>>>>>>>9.9999':U LABEL 'Qtde'
   /* Campos extras padräes do Data Collection */
   FIELD data-atualizacao AS DATE       FORMAT '99/99/9999':U     LABEL 'Atualizacao'
   FIELD data-transacao   AS DATE       FORMAT '99/99/9999':U     LABEL 'Transacao'
   FIELD cod-lote         AS CHARACTER  FORMAT 'x(40)':U          LABEL 'Nr. S‚rie / Lote'
   FIELD num-docto-transf AS INTEGER    FORMAT ">>>>>>,>>9":U     LABEL 'Nr. Docto Transf'
   FIELD cod-estabel      LIKE estabelec.cod-estabel              LABEL 'Estabelecimento'
   FIELD cod-livre-1      AS CHARACTER  FORMAT 'x(300)':U         LABEL 'Cod Livre 1'
   FIELD cod-livre-2      AS CHARACTER  FORMAT 'x(40)':U          LABEL 'Cod Livre 2'
   FIELD cod-livre-3      AS CHARACTER  FORMAT 'x(40)':U          LABEL 'Cod Livre 3'
   FIELD cod-livre-4      AS CHARACTER  FORMAT 'x(40)':U          LABEL 'Cod Livre 4'
   FIELD cod-livre-5      AS CHARACTER  FORMAT 'x(40)':U          LABEL 'Cod Livre 5'
   FIELD num-livre-1      AS INTEGER    FORMAT '>>>>>>>9':U       LABEL 'Num Livre 1'
   FIELD num-livre-2      AS INTEGER    FORMAT '>>>>>>>9':U       LABEL 'Num Livre 2'     
   FIELD num-livre-3      AS INTEGER    FORMAT '>>>>>>>9':U       LABEL 'Num Livre 3'
   FIELD num-livre-4      AS INTEGER    FORMAT '>>>>>>>9':U       LABEL 'Num Livre 4'
   FIELD num-livre-5      AS INTEGER    FORMAT '>>>>>>>9':U                LABEL 'Num Livre 5'
   FIELD dec-livre-1      AS DECIMAL    FORMAT '>>>>>>9.9999':U DECIMALS 4 LABEL 'Dec Livre 1'
   FIELD dec-livre-2      AS DECIMAL    FORMAT '>>>>>>9.9999':U DECIMALS 4 LABEL 'Dec Livre 2'
   FIELD dec-livre-3      AS DECIMAL    FORMAT '>>>>>>9.9999':U DECIMALS 4 LABEL 'Dec Livre 3'
   FIELD dec-livre-4      AS DECIMAL    FORMAT '>>>>>>9.9999':U DECIMALS 4 LABEL 'Dec Livre 4'
   FIELD dec-livre-5      AS DECIMAL    FORMAT '>>>>>>9.9999':U DECIMALS 4 LABEL 'Dec Livre 5'
   FIELD log-livre-1      AS LOGICAL    FORMAT 'Sim/NÆo':U        LABEL 'Log Livre 1'
   FIELD log-livre-2      AS LOGICAL    FORMAT 'Sim/NÆo':U        LABEL 'Log Livre 2'
   FIELD log-livre-3      AS LOGICAL    FORMAT 'Sim/NÆo':U        LABEL 'Log Livre 3'
   FIELD log-livre-4      AS LOGICAL    FORMAT 'Sim/NÆo':U        LABEL 'Log Livre 4'
   FIELD log-livre-5      AS LOGICAL    FORMAT 'Sim/NÆo':U        LABEL 'Log Livre 5'
   FIELD dat-livre-1      AS DATE       FORMAT '99/99/9999':U     LABEL 'DataLivre 1'
   FIELD dat-livre-2      AS DATE       FORMAT '99/99/9999':U     LABEL 'DataLivre 2'
   FIELD dat-livre-3      AS DATE       FORMAT '99/99/9999':U     LABEL 'DataLivre 3'
   FIELD dat-livre-4      AS DATE       FORMAT '99/99/9999':U     LABEL 'DataLivre 4'
   FIELD dat-livre-5      AS DATE       FORMAT '99/99/9999':U     LABEL 'DataLivre 5'
   FIELD opcao            AS INTEGER    FORMAT '9':U              LABEL 'Processo'
   INDEX ID IS PRIMARY cod-serial.
