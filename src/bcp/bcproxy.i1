/*********************************  bcproxy.i1  *********************************/
Define temp-table ttReturnMessages no-undo
    Field CodErro      as Integer format '99999'
    Field DesErro      as Char    format 'x(60)'
    Field Local        as Integer format '9' /* 1=Proxy, 2=API_Magnus, 3=BO_EMS_2 */
    Field Type         as Integer format '9' /* 1=Error, 2=Warning, 3=Information */
    Field Parameters   as Char    format 'x(2000)'.

DEF VAR vLocalList           AS Character init 'Proxy,Magnus_BO,EMS_2_BO'          no-undo.
DEF VAR vTypeList            AS Character init 'Error,Warning,Information'         no-undo.
DEF VAR vAcessModeList       AS Character init 'Current,First,Prev,Next,Last,Each' no-undo.

/*********************************  bcproxy.i1  *********************************/

