/********************************************************************************/
PROCEDURE pi-verifica-item-for :
def input param c-cod-item-ini      as char format "X(16)"      no-undo.
def input param c-cod-item-fim      as char format "X(16)"      no-undo.
def input param c-cod-emitente-ini  as int  format ">>>>>>>>9"  no-undo.
def input param c-cod-emitente-fim  as int  format ">>>>>>>>9"  no-undo.
def input param c-acess-mode        as integer                  no-undo.
def input param c-record-frase      as integer              no-undo.


    for each ttParamItem-Fornec:
        delete ttParamItem-Fornec.
    end.
    for each ttReturnMessages:
        delete ttReturnMessages.
    end.


    Create  ttParamItem-Fornec.
    Assign  ttParamItem-Fornec.it-codigo-ini    = c-cod-Item-ini
            ttParamItem-Fornec.it-codigo-fim    = c-cod-Item-fim
            ttParamItem-Fornec.cod-emitente-ini = c-cod-emitente-ini
            ttParamItem-Fornec.cod-emitente-fim = c-cod-emitente-fim
            ttParamItem-Fornec.acess-mode       = c-acess-mode   /* Ser  retornado o valor corrente */
            ttParamItem-Fornec.record-phrase    = c-record-frase.    /* Valor utilizado somente quando o acess-mode for = 5 (for each) */

    run bcp/bc8113.p (Input  Table ttParamItem-Fornec,
                      Output Table ttItem-Fornec,
                      Output Table ttReturnMessages).

    find first ttReturnMessages
         where ttReturnMessages.type = 1    /* Tipo = 1-Error, 2-Warning, 3-Information */
         no-error.

    if  not avail ttReturnMessages then release ttItem-Fornec.

    find first ttItem-Fornec no-error.

END PROCEDURE.

