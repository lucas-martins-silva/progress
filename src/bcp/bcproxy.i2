    find first ttSaldo-Estoq no-error.

END PROCEDURE.


/********************************************************************************/
PROCEDURE pi-verifica-conta-contab :
def input param i-ep-codigo-ini     as char  format "x(3)"    no-undo.
def input param i-ep-codigo-fim     as char  format "x(3)"    no-undo.
def input param c-conta-contab-ini  as char format "X(17)"  no-undo.
def input param c-conta-contab-fim  as char format "X(17)"  no-undo.
def input param c-acess-mode        as integer              no-undo.
def input param c-record-frase      as integer              no-undo.

    for each ttParamConta-Contab:
        delete ttParamConta-Contab.
    end.
    for each ttReturnMessages:
        delete ttReturnMessages.
    end.

    Create  ttParamConta-Contab.
    Assign  ttParamConta-Contab.ep-codigo-ini      = i-ep-codigo-ini
            ttParamConta-Contab.ep-codigo-fim      = i-ep-codigo-fim
            ttParamConta-Contab.titulo-ini         = c-conta-contab-ini
            ttParamConta-Contab.titulo-fim         = c-conta-contab-fim
            ttParamConta-Contab.acess-mode         = c-acess-mode       /* Ser  each (mas ser  considerado como find */
            ttParamConta-Contab.record-phrase      = c-record-frase      /* Valor utilizado somente quando o acess-mode for = 5 (for each) */
            ttParamConta-Contab.num-of-rec         = 30.    /* Valor utilizado somente quando o acess-mode for = 5 (for each) */

    find first param-bc no-lock no-error.
    if  avail param-bc
    &if '{&mgcld_version}' <= '2.04' &then
        and param-bc.int-2 = 1 then do:
    &else
        and param-bc.ind-sistema = 1 then do:
    &endif

        run cdp/cdapi523.p persistent set h-cdapi523.

        assign ttParamConta-Contab.ct-codigo-ini      = substring(c-conta-contab-ini,1,length(ct-format()))
               ttParamConta-Contab.sc-codigo-ini      = substring(c-conta-contab-ini,length(ct-format()) + 1,length(sc-format()))
               ttParamConta-Contab.ct-codigo-fim      = substring(c-conta-contab-fim,1,length(ct-format()))
               ttParamConta-Contab.sc-codigo-fim      = substring(c-conta-contab-fim,length(ct-format()) + 1,length(sc-format())).
               
        delete procedure h-cdapi523.
    end.
    else do:
        assign ttParamConta-Contab.ct-codigo-ini      = substring(c-conta-contab-ini,1,8)
               ttParamConta-Contab.sc-codigo-ini      = substring(c-conta-contab-ini,9,5)
               ttParamConta-Contab.ct-codigo-fim      = substring(c-conta-contab-fim,1,8)
               ttParamConta-Contab.sc-codigo-fim      = substring(c-conta-contab-fim,9,5).
    end.

    run bcp/bc8102.p (Input  Table ttParamConta-Contab,
                      Output Table ttConta-contab,
                      Output Table ttReturnMessages).

    find first ttReturnMessages
         where ttReturnMessages.type = 1    /* Tipo = 1-Error, 2-Warning, 3-Information */
         no-error.

    if  not avail ttReturnMessages then release ttConta-contab.

    find first ttConta-contab no-error.

END PROCEDURE.


