PROCEDURE pi-verifica-Embalag:
def input param c-embalagem-ini  as char format "X(10)" no-undo.
def input param c-embalagem-fim  as char format "X(10)" no-undo.
def input param c-sigla-emb-ini  as char format "!XX"   no-undo.
def input param c-sigla-emb-fim  as char format "!XX"   no-undo.
def input param c-acess-mode     as integer             no-undo.
def input param c-record-frase   as integer             no-undo.


    for each ttParamEmbalag:
        delete ttParamEmbalag.
    end.
    for each ttReturnMessages:
        delete ttReturnMessages.
    end.

    Create  ttParamEmbalag.
    Assign  ttParamEmbalag.embalagem-ini   = c-embalagem-ini
            ttParamEmbalag.embalagem-fim   = c-embalagem-fim
            ttParamEmbalag.sigla-emb-ini   = c-sigla-emb-ini
            ttParamEmbalag.sigla-emb-fim   = c-sigla-emb-fim
            ttParamEmbalag.acess-mode     = c-acess-mode       /* Serÿ retornado o valor corrente */
            ttParamEmbalag.record-phrase  = c-record-frase     /* Valor utilizado somente quando o acess-mode for = 5 (for each) */
            ttParamEmbalag.num-of-rec     = 30.                /* Numero de Registros Iniciado */

    run bcp/bc8117.p (Input  Table ttParamEmbalag,
                      Output Table ttEmbalag,
                      Output Table ttReturnMessages).

    find first ttReturnMessages
         where ttReturnMessages.type = 1    /* Tipo = 1-Error, 2-Warning, 3-Information */
         no-error.

    if  not avail ttReturnMessages then release ttEmbalag.

    find first ttEmbalag no-error.

END PROCEDURE.
