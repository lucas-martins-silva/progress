/********************************************************************************/
PROCEDURE pi-verifica-Emitente :
def input param c-nome-abrev-ini    as char format "X(12)"      no-undo.
def input param c-nome-abrev-fim    as char format "X(12)"      no-undo.
def input param i-cod-emitente-ini  as int  format ">>>>>>>>9"  no-undo.
def input param i-cod-emitente-fim  as int  format ">>>>>>>>9"  no-undo.
def input param c-acess-mode        as integer                  no-undo.
def input param c-record-frase      as integer                  no-undo.


    for each ttParamEmitente:
        delete ttParamEmitente.
    end.
    for each ttReturnMessages:
        delete ttReturnMessages.
    end.

    Create  ttParamEmitente.
    Assign  ttParamEmitente.cod-emitente-ini   = i-cod-Emitente-ini
            ttParamEmitente.nome-abrev-ini     = c-nome-abrev-ini
            ttParamEmitente.cod-emitente-fim   = i-cod-Emitente-fim
            ttParamEmitente.nome-abrev-fim     = c-nome-abrev-fim
            ttParamEmitente.acess-mode         = c-acess-mode       /* Ser  retornado o valor corrente */
            ttParamEmitente.record-phrase      = c-record-frase     /* Valor utilizado somente quando o acess-mode for = 5 (for each) */
            ttParamEmitente.num-of-rec         = 30.                /* Numero de Registros Iniciado */

    run bcp/bc8103.p (Input  Table ttParamEmitente,
                      Output Table ttEmitente,
                      Output Table ttReturnMessages).

    find first ttReturnMessages
         where ttReturnMessages.type = 1    /* Tipo = 1-Error, 2-Warning, 3-Information */
         no-error.
    
    if  not avail ttReturnMessages then release ttEmitente.
    
    find first ttEmitente no-error.

END PROCEDURE.

