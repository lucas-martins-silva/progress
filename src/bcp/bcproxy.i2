/********************************************************************************/
PROCEDURE pi-verifica-deposito :
def input param c-cod-depos-ini as char format "X(10)"  no-undo.
def input param c-cod-depos-fim as char format "X(10)"  no-undo.
def input param c-acess-mode    as integer              no-undo.
def input param c-record-frase  as integer              no-undo.

    for each ttParamDeposito:
        delete ttParamDeposito.
    end.
    for each ttReturnMessages:
        delete ttReturnMessages.
    end.

    Create  ttParamDeposito.
    Assign  ttParamDeposito.cod-depos-ini      = c-cod-depos-ini
            ttParamDeposito.cod-depos-fim      = c-cod-depos-fim
            ttParamDeposito.nome-ini           = c-cod-depos-ini
            ttParamDeposito.nome-fim           = c-cod-depos-fim
            ttParamDeposito.acess-mode         = c-acess-mode   /* Ser  retornado o valor corrente */
            ttParamDeposito.record-phrase      = c-record-frase.    /* Valor utilizado somente quando o acess-mode for = 5 (for each) */

    run bcp/bc8106.p (Input  Table ttParamDeposito,
                      Output Table ttDeposito,
                      Output Table ttReturnMessages).

    find first ttReturnMessages
         where ttReturnMessages.type = 1    /* Tipo = 1-Error, 2-Warning, 3-Information */
         no-error.

    if  not avail ttReturnMessages then release ttDeposito.

    find first ttDeposito no-error.

END PROCEDURE.


