/************************************************************
    Vari veis de trabalho do WMSai009
************************************************************/

DEFINE {1} SHARED TEMP-TABLE ttWork NO-UNDO LIKE {&TempTable}.

DEFINE {1} SHARED TEMP-TABLE ttwm-docto-itens NO-UNDO LIKE wm-docto-itens.

DEFINE {1} SHARED TEMP-TABLE ttwm-box NO-UNDO LIKE wm-box
                       FIELD RowNum  AS INTEGER INITIAL 1
                       FIELD r-Rowid AS ROWID. 

DEFINE {1} SHARED TEMP-TABLE ttwm-box-aux NO-UNDO LIKE wm-box
                       FIELD RowNum          AS INTEGER INITIAL 1
                       FIELD r-Rowid         AS ROWID
                       FIELD log-pend-ressup AS LOGICAL.

DEFINE {1} SHARED TEMP-TABLE ttWm-box-movto-idx      LIKE wm-box-movto
                       FIELD val-prioridade  AS INTEGER
                       FIELD r-rowid         AS ROWID
                       INDEX idx-prioridade val-prioridade DESC
                       INDEX idx-movto id-movto ASC.

DEFINE {1} SHARED TEMP-TABLE ttWm-box-movto-idx-picking  NO-UNDO LIKE wm-box-movto
                       FIELD val-prioridade AS INTEGER
                       FIELD nr-pedcli      LIKE wm-docto-itens-ped.nr-pedcli
                       FIELD nome-abrev     LIKE wm-docto-itens-ped.nome-abrev
                       INDEX idx-prioridade nr-pedcli
                                            nome-abrev
                                            val-prioridade DESC.
    
DEF BUFFER bttWm-box-movto-idx-picking FOR ttWm-box-movto-idx-picking.

DEFINE {1} SHARED TEMP-TABLE bttWm-box-movto  LIKE wm-box-movto
                       FIELD val-prioridade  AS INTEGER
                       INDEX idx-prioridade val-prioridade DESC.

DEFINE TEMP-TABLE RowErrors NO-UNDO 
            FIELD ErrorSequence    AS INTEGER 
            FIELD ErrorNumber      AS INTEGER 
            FIELD ErrorDescription AS CHARACTER 
            FIELD ErrorParameters  AS CHARACTER 
            FIELD ErrorType        AS CHARACTER 
            FIELD ErrorHelp        AS CHARACTER 
            FIELD ErrorSubType     AS CHARACTER.

DEFINE {1} SHARED TEMP-TABLE ttSerialQtd
                       FIELD id-etiqueta         LIKE wm-etiqueta.id-etiqueta
                       FIELD qtd-item-retirado   LIKE wm-etiqueta.qtd-item-retirado.

DEFINE {1} SHARED TEMP-TABLE tt-leitura
                       FIELD id-docto            LIKE wm-docto-itens.id-docto
                       FIELD num-seq-item        LIKE wm-docto-itens.num-seq-item
                       FIELD ind-tipo-movto      LIKE wm-box-movto.ind-tipo-movto
                       FIELD id-movto            LIKE wm-box-movto.id-movto           
                       FIELD id-box-lido         LIKE wm-box-movto.id-box 
                       FIELD cod-item-lido       LIKE wm-docto-itens.cod-item
                       FIELD qtd-item-lido       LIKE wm-docto-itens.qtd-item
                       FIELD cod-embalagem-lido  LIKE wm-box-movto.cod-embalagem
                       FIELD qti-embalagem-lido  LIKE wm-box-movto.qti-embalagem
                       FIELD qtd-item-picking    LIKE wm-box-movto.qtd-item-picking.
                    
DEFINE {1} SHARED TEMP-TABLE tt-box-movto LIKE wm-box-movto.

/************************************************************/

/* Variaveis de trabalho ---                                */              
DEFINE {1} SHARED VARIABLE vIdBox                  LIKE wm-box-movto.id-box                 NO-UNDO.
DEFINE {1} SHARED VARIABLE vCodOpcao               AS CHARACTER                 INITIAL ''  NO-UNDO.
DEFINE {1} SHARED VARIABLE vCodTipoEquip           AS CHARACTER                 INITIAL ''  NO-UNDO.
DEFINE {1} SHARED VARIABLE vCodEmbalagem           AS CHARACTER                 INITIAL ''  NO-UNDO.
DEFINE {1} SHARED VARIABLE vCodItem                AS CHARACTER                 INITIAL ''  NO-UNDO.
DEFINE {1} SHARED VARIABLE vNumCont                AS INTEGER                   INITIAL 0   NO-UNDO.
DEFINE {1} SHARED VARIABLE vNumItensSerial         AS DECIMAL                   INITIAL 0   NO-UNDO.
DEFINE {1} SHARED VARIABLE vLogValidaMovto         AS LOGICAL                   INITIAL YES NO-UNDO.
DEFINE {1} SHARED VARIABLE vNumBoxMovto            AS INTEGER                   INITIAL 0   NO-UNDO.
DEFINE {1} SHARED VARIABLE vNumSaldo               AS INTEGER                   INITIAL 0   NO-UNDO.
DEFINE {1} SHARED VARIABLE vNumDoca                AS INTEGER    FORMAT '>>>>>' INITIAL 0   NO-UNDO.
DEFINE {1} SHARED VARIABLE vNumSeq                 AS INTEGER                   INITIAL 0   NO-UNDO.
DEFINE {1} SHARED VARIABLE vLogOk                  AS LOGICAL                   INITIAL NO  NO-UNDO.
DEFINE {1} SHARED VARIABLE vLogAtivo               AS LOGICAL                   INITIAL NO  NO-UNDO.
DEFINE {1} SHARED VARIABLE vLogProcesso            AS LOGICAL                   INITIAL NO  NO-UNDO.
DEFINE {1} SHARED VARIABLE v-log-abre-embalagem    AS LOGICAL                   INITIAL NO  NO-UNDO.
DEFINE {1} SHARED VARIABLE vLogEmProcesso          AS LOGICAL                   INITIAL NO  NO-UNDO.
DEFINE {1} SHARED VARIABLE vLogIniciado            AS LOGICAL                   INITIAL NO  NO-UNDO.
DEFINE {1} SHARED VARIABLE v-cod-estabel           AS CHARACTER                             NO-UNDO.
DEFINE {1} SHARED VARIABLE v-cod-local             AS CHARACTER                             NO-UNDO.

DEFINE VARIABLE vLogUtilizaColetor      AS LOGICAL                 INITIAL NO  NO-UNDO.
DEFINE VARIABLE vLogAprovaFatura        AS LOGICAL                 INITIAL NO  NO-UNDO.
DEFINE VARIABLE vLogControlaLogin       AS LOGICAL                 INITIAL NO  NO-UNDO.

