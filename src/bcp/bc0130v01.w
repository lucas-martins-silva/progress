&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE pi-validate V-table-Win 
PROCEDURE pi-validate :
/*------------------------------------------------------------------------------
  Purpose:Validar a viewer     
  Parameters:  <none>
  Notes: NÆo fazer assign aqui. Nesta procedure
  devem ser colocadas apenas valida‡äes, pois neste ponto do programa o registro 
  ainda nÆo foi criado.       
------------------------------------------------------------------------------*/

    DEFINE INPUT  PARAMETER ipcAction AS CHARACTER  NO-UNDO.

    DEFINE BUFFER bfBCTipTransEqpto FOR bc-tip-trans-eqpto.

    {include/i-vldfrm.i} /* Valida‡Æo de dicion rio */

/*/*    Segue um exemplo de valida‡Æo de programa */
 *     find tabela where tabela.campo1 = c-variavel and
 *                       tabela.campo2 > i-variavel no-lock no-error.
 *     
 *     /* Este include deve ser colocado sempre antes do ut-msgs.p */
 *     {include/i-vldprg.i}
 *     run utp/ut-msgs.p (input "show":U, input 7, input return-value).
 *     return 'ADM-ERROR':U.*/

    IF ipcAction = "Del":U THEN DO:
        FIND FIRST bfBCTipTransEqpto NO-LOCK
             WHERE bfBCTipTransEqpto.cod-eqpto = (bc-eqpto.cod-eqpto:SCREEN-VALUE IN FRAME {&FRAME-NAME}) NO-ERROR.
        IF AVAIL bfBCTipTransEqpto THEN DO:
            {include/i-vldprg.i}

            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-equipamento AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Equipamento" *}
            ASSIGN c-lbl-liter-equipamento = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-liter-transacoes-do-equipamento AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Transa‡äes_do_Equipamento" *}
            ASSIGN c-lbl-liter-transacoes-do-equipamento = TRIM(RETURN-VALUE).
            RUN utp/ut-msgs.p (INPUT "show":U,
                               INPUT 5,
                               INPUT c-lbl-liter-equipamento + "~~" + c-lbl-liter-transacoes-do-equipamento).

            RETURN 'ADM-ERROR':U.
        END.
    END.

END PROCEDURE.

