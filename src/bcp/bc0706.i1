&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE insertError DBOTempTable 
PROCEDURE insertError :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE INPUT  PARAMETER ipcCodServid   AS CHARACTER  NO-UNDO.
    DEFINE INPUT  PARAMETER ipcCdTrans     AS CHARACTER  NO-UNDO.
    DEFINE INPUT  PARAMETER ipcCodEqpto    AS CHARACTER  NO-UNDO.
    DEFINE INPUT  PARAMETER ipcCodVarDtsul AS CHARACTER  NO-UNDO.
    DEFINE INPUT  PARAMETER ipcCodVarEqpto AS CHARACTER  NO-UNDO.
    DEFINE INPUT  PARAMETER ipiNumErro     AS INTEGER    NO-UNDO.
    DEFINE INPUT  PARAMETER ipcDslMsgErro  AS CHARACTER  NO-UNDO.
    DEFINE INPUT  PARAMETER ipcDslDetMsg   AS CHARACTER  NO-UNDO.

    DEFINE VARIABLE hQuery    AS HANDLE     NO-UNDO.
    DEFINE VARIABLE hTTBuffer AS HANDLE     NO-UNDO.

    DEFINE VARIABLE iErrorSeq AS INTEGER    NO-UNDO
        INITIAL 1.

    ASSIGN hTTBuffer = hTTServerError:DEFAULT-BUFFER-HANDLE.

    CREATE QUERY hQuery.
    hQuery:ADD-BUFFER(hTTBuffer).
    hQuery:QUERY-PREPARE("for each tt-server-error no-lock by tt-server-error.num-seq-erro").
    hQuery:QUERY-OPEN().

    IF hQuery:GET-LAST(NO-LOCK) THEN
        ASSIGN iErrorSeq = hTTBuffer:BUFFER-FIELD("num-seq-erro"):BUFFER-VALUE + 1.

    hTTBuffer:BUFFER-CREATE().

    ASSIGN
        hTTBuffer:BUFFER-FIELD("num-seq-erro"):BUFFER-VALUE = iErrorSeq
        hTTBuffer:BUFFER-FIELD("cod-servid"):BUFFER-VALUE = ipcCodServid
        hTTBuffer:BUFFER-FIELD("cd-trans"):BUFFER-VALUE = ipcCdTrans
        hTTBuffer:BUFFER-FIELD("cod-eqpto"):BUFFER-VALUE = ipcCodEqpto
        hTTBuffer:BUFFER-FIELD("cod-var-dtsul"):BUFFER-VALUE = ipcCodVarDtsul
        hTTBuffer:BUFFER-FIELD("cod-var-eqpto"):BUFFER-VALUE = ipcCodVarEqpto
        hTTBuffer:BUFFER-FIELD("num-erro"):BUFFER-VALUE = ipiNumErro
        hTTBuffer:BUFFER-FIELD("dsl-msg-erro"):BUFFER-VALUE = ipcDslMsgErro
        hTTBuffer:BUFFER-FIELD("dsl-det-msg"):BUFFER-VALUE = ipcDslDetMsg.

    hTTBuffer:BUFFER-RELEASE().

    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
