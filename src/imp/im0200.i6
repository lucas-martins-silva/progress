/**************************************************************************************
**
** IM0200.I6 - Definiá‰es Frames e vari†veis        
**
***************************************************************************************/

def var c-nr-proc-imp-aux like processo-imp.nr-proc-imp no-undo. /*Manuela*/
def var c-processo as char format "x(18)" no-undo.
def var c-embarq   as char format "x(18)" no-undo.
def var c-desemb   as char format "x(18)" no-undo.    
def var i-aux      as int                 no-undo.
def var i-cont     as int                 no-undo.
def var c-desc-embarq as char format "x(30)" no-undo.
def var c-desc-desemb as char format "x(30)" no-undo.
     
def var c-lb-tit-par    as char no-undo.
def var c-lb-reemite    as char no-undo.
def var c-lb-tit-sel    as char no-undo.
def var c-lb-processo   as char no-undo.
def var c-lb-embarque   as char no-undo.
def var c-lb-declaracao as char no-undo.
def var c-lb-itinerario as char no-undo.
def var c-lb-data       as char no-undo.
def var c-lb-pto-contr  as char no-undo.
def var c-lb-tit-imp    as char format "x(15)" no-undo.
def var c-lb-destino    as char format "x(10)" no-undo.
def var c-lb-usuario    as char format "x(10)" no-undo.
def var c-erros         as char format "x(60)" no-undo.

FORM emitente.cod-emitente COLON 20 "-"
     emitente.nome-emit    NO-LABEL FORMAT "X(40)":U SKIP
     emitente.endereco     COLON 20                  SKIP
     emitente.bairro       COLON 20                  SKIP
     emitente.cep          COLON 20 "-"
     emitente.cidade       NO-LABEL                  SKIP
     emitente.estado       COLON 20 "-"
     emitente.pais         NO-LABEL                  SKIP
     SKIP(2)
     WITH STREAM-IO NO-BOX SIDE-LABEL DOWN WIDTH 80 FRAME f-declaracao.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-declaracao:HANDLE).

     
form
     c-processo                 at 5 ": "
     c-nr-proc-imp-aux          at 30
     with stream-io no-box no-label down width 80 frame f-lbl-processo.

form
     c-nr-proc-imp              at 30
     with stream-io no-box no-label down width 100 frame f-nr-processo.

form
     c-processo                 at 5 ": "
     processo-imp.nr-proc-imp   at 30
     c-embarq                   at 5 ": "
     itinerario.pto-embarque    at 26 " - "
     c-desc-embarq              skip
     c-desemb                   at 5 ": "
     itinerario.pto-desembarque at 26 " - "
     c-desc-desemb
     skip(3)
     with stream-io no-box no-labels down width 80 frame f-processo.

form 
     c-embarq                   at 5 ": " 
     itinerario.pto-embarque    at 26 " - "
     c-desc-embarq              skip
     c-desemb                   at 5 ": "
     itinerario.pto-desembarque at 26 " - "
     c-desc-desemb
     skip(3)     
     with stream-io no-box no-labels down width 80 frame f-processo2.

form 
     c-processo                 at 5 ": "
     processo-imp.nr-proc-imp   at 26 
     c-embarq                   at 5 ": " 
     itinerario.pto-embarque    at 26 " - "
     c-desc-embarq              skip
     c-desemb                   at 5 ": "
     itinerario.pto-desembarque at 26 " - "
     c-desc-desemb
     skip(3)     
     with stream-io no-box no-labels down width 80 frame f-processo3.


form     
    tt-editor.conteudo format "x(75)" at 05
    with no-labels down width 80 no-box stream-io frame f-decl-texto.

form     
    tt-editor.conteudo format "x(75)" at 05
    with no-labels down width 80 no-box stream-io frame f-decl-texto-aux.    

form 
    c-nro-invoice-label  at 05
    c-parcela-label      at 18
    c-dt-vencim-label    at 27
    c-vl-invoice-label   at 42
    with stream-io no-box no-labels down width 80 frame f-fatura-label.    
    
form 
    c-nro-invoice-aux  at 05
    c-parcela-aux      at 23
    c-dt-vencim-aux    at 27
    de-vl-invoice-aux  at 39
    with stream-io no-box no-labels down width 80 frame f-fatura.
     
form 
/*Seleá∆o*/
     skip(1)                                   
     c-lb-tit-sel                           no-label skip(1) 
     tt-param.c-proc-ini                    colon 30
     "|< >|"                                      at 50
     tt-param.c-proc-fim                    no-label
     tt-param.c-emb-ini                    colon 30
     "|< >|"                                      at 50
     tt-param.c-emb-fim                    no-label
     tt-param.i-decl-ini                       colon 30
     "|< >|"                                      at 50
     tt-param.i-decl-fim                       no-label
     tt-param.i-itiner-ini                     colon 30
     "|< >|"                                      at 50
     tt-param.i-itiner-fim                     no-label     
     tt-param.da-data-ini format "99/99/9999"  colon 30
     "|< >|"                                      at 50
     tt-param.da-data-fim format "99/99/9999"  no-label
     tt-param.i-pto-con-ini                    colon 30
     "|< >|"                                      at 50
     tt-param.i-pto-con-fim                    no-label
/*impress∆o*/
     skip(1)
     c-lb-tit-imp                               no-label skip(1)
     c-lb-destino                               at 19 no-label ": " 
     tt-param.destino  no-label                   
     " - " 
     tt-param.arquivo                           no-label skip 
     c-lb-usuario                               at 19 no-label ": "
     tt-param.usuario                           no-label skip(1) 
     with width 80 side-labels frame f-param stream-io. 
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-param:HANDLE).
   
  
{utp/ut-liter.i Processo_Imp * r}
assign c-processo = trim(return-value).
{utp/ut-liter.i Pto_Embarque * r}
assign c-embarq = trim(return-value).
{utp/ut-liter.i Pto_Nacionalizaá∆o * r}
assign c-desemb = trim(return-value).

{utp/ut-liter.i PAR∂METRO * r}
assign c-lb-tit-par = trim(return-value).
{utp/ut-liter.i Reemite * r}
assign c-lb-reemite = trim(return-value).
{utp/ut-liter.i SELEÄ«O * r}
assign c-lb-tit-sel = trim(return-value).
{utp/ut-liter.i Processo * r}
assign c-lb-processo = trim(return-value).
{utp/ut-liter.i Embarque * r}
assign c-lb-embarque = trim(return-value).
{utp/ut-liter.i Declaraá∆o * r}
assign c-lb-declaracao = trim(return-value).
{utp/ut-liter.i Itiner†rio * r}
assign c-lb-itinerario = trim(return-value).
{utp/ut-liter.i Data * r}
assign c-lb-data = trim(return-value).
{utp/ut-liter.i Ponto_Contr * r}
assign c-lb-pto-contr = trim(return-value).
{utp/ut-liter.i IMPRESS«O * r}
assign c-lb-tit-imp = trim(return-value).
{utp/ut-liter.i Destino * r}
assign c-lb-destino = trim(return-value).
{utp/ut-liter.i Usu†rio * r}
assign c-lb-usuario = trim(return-value).
     
{utp/ut-liter.i Emitente * r}
assign emitente.cod-emitente:label in frame f-declaracao = trim(return-value).
assign emitente.cod-emitente:label in frame f-declaracao = trim(return-value).
{utp/ut-liter.i Erro * r }
assign c-erros = trim(return-value).       
            
/* IM0200.I6 */
