   "Classifica‡Æo:"             colon 1  skip(1)
   tt-param.desc-classifica     no-label colon 20 skip(1)

   "Parƒmetros:"                colon 1  skip(1)
   tt-param.moeda               colon 35 " - " c-desc-moeda no-label
   tt-param.da-dt-conv          colon 35
   tt-param.l-dt-nacional       colon 35
   tt-param.l-orc-real          colon 35
   c-consider-calc              colon 35 label "Considera para c lculo %"
   tt-param.l-desp-imposto      colon 35
   tt-param.l-itens             colon 35
   c-custo-item                 colon 35
