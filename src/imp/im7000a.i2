/*****************************************************************
** im7000a.i2 - grava os valores das palavras chave na duimp-docto
*****************************************************************/
    EMPTY TEMP-TABLE tt-duimp-docto-aux2.
    CREATE tt-duimp-docto-aux2.
    ASSIGN tt-duimp-docto-aux2.cod-duimp-dts  = de-cod-duimp-dts
           tt-duimp-docto-aux2.documento      = 1 /* Documento Instru‡Æo */
           tt-duimp-docto-aux2.seq-docto      = i-seq-docto
           tt-duimp-docto-aux2.cod-tipo-docto = cb-tipo-docto:INPUT-VALUE
           tt-duimp-docto-aux2.cod-chave      = tt-siscomex-chave.cod-chave
           tt-duimp-docto-aux2.valor          = IF "{2}" = "lista" THEN cb-lista:INPUT-VALUE 
                                                ELSE c-valor-{1}:SCREEN-VALUE.
    RUN piValidaCriaDocto.
    IF RETURN-VALUE = "NOK":U THEN DO:
        UNDO, RETURN "NOK":U.
    END.
