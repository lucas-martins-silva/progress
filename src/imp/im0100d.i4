END.

ON LEAVE OF tt-ordens-desemb.de-aliq-CBS IN BROWSE brSon4
DO:
    FOR FIRST class-trib NO-LOCK
        WHERE class-trib.cod-cclass-trib = tt-ordens-desemb.cClassTrib-CBS:SCREEN-VALUE IN BROWSE brSon4
          AND class-trib.ind-tributo  = 1 /* IBS/CBS */ 
          AND class-trib.trib-regular = 1:
        IF DEC(tt-ordens-desemb.de-aliq-CBS:SCREEN-VALUE IN BROWSE brSon4) <> 0 THEN
            ASSIGN tt-ordens-desemb.de-aliq-Reg-CBS:SCREEN-VALUE IN BROWSE brSon4 = STRING(tt-ordens-desemb.de-aliq-CBS:SCREEN-VALUE IN BROWSE brSon4).
    END.
END.

ON LEAVE OF tt-ordens-desemb.cClassTrib-IBSUF IN BROWSE brSon4
DO:
    IF tt-ordens-desemb.cClassTrib-IBSUF:SCREEN-VALUE IN BROWSE brSon4 <> "" THEN DO:
        FIND FIRST class-trib NO-LOCK
             WHERE class-trib.cod-cclass-trib = tt-ordens-desemb.cClassTrib-IBSUF:SCREEN-VALUE IN BROWSE brSon4
               AND class-trib.ind-tributo = 1 /* IBS/CBS */ NO-ERROR.
        IF NOT AVAIL class-trib THEN DO:
            RUN utp/ut-msgs.p (INPUT "show":U,
                               INPUT 2,
                               INPUT "Class Trib":U + "~~" + tt-ordens-desemb.cClassTrib-IBSUF:SCREEN-VALUE IN BROWSE brSon4).
            RETURN NO-APPLY.
        END.
        ELSE DO:
            ASSIGN tt-ordens-desemb.cCST-IBSUF:SCREEN-VALUE IN BROWSE brSon4 = SUBSTRING(tt-ordens-desemb.cClassTrib-IBSUF:SCREEN-VALUE IN BROWSE brSon4,1,3).
            IF class-trib.trib-regular = 1 THEN DO:
                ASSIGN tt-ordens-desemb.cClassTribReg-IBSUF:READ-ONLY IN BROWSE brSon4 = NO
                       tt-ordens-desemb.cCSTReg-IBSUF:READ-ONLY IN BROWSE brSon4 = NO.
                       
                IF DEC(tt-ordens-desemb.de-aliq-IBSUF:SCREEN-VALUE IN BROWSE brSon4) <> 0 THEN 
                    ASSIGN tt-ordens-desemb.de-aliq-Reg-IBSUF:SCREEN-VALUE IN BROWSE brSon4 = STRING(tt-ordens-desemb.de-aliq-IBSUF:SCREEN-VALUE IN BROWSE brSon4).
            END.
            ELSE
                ASSIGN tt-ordens-desemb.de-aliq-Reg-IBSUF:SCREEN-VALUE IN BROWSE brSon4 = "0"
                       tt-ordens-desemb.cClassTribReg-IBSUF:SCREEN-VALUE IN BROWSE brSon4 = ""
                       tt-ordens-desemb.cCSTReg-IBSUF:SCREEN-VALUE IN BROWSE brSon4 = ""
                       tt-ordens-desemb.cClassTribReg-IBSUF:READ-ONLY IN BROWSE brSon4 = YES
                       tt-ordens-desemb.cCSTReg-IBSUF:READ-ONLY IN BROWSE brSon4 = YES.
        END.
    END.
END.

