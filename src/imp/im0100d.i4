ON LEAVE OF tt-ordens-desemb.de-aliq-IBSUF IN BROWSE brSon4
DO:
    FOR FIRST class-trib NO-LOCK
        WHERE class-trib.cod-cclass-trib = tt-ordens-desemb.cClassTrib-IBSUF:SCREEN-VALUE IN BROWSE brSon4
          AND class-trib.ind-tributo  = 1 /* IBS/CBS */ 
          AND class-trib.trib-regular = 1:
        IF DEC(tt-ordens-desemb.de-aliq-IBSUF:SCREEN-VALUE IN BROWSE brSon4) <> 0 THEN
            ASSIGN tt-ordens-desemb.de-aliq-Reg-IBSUF:SCREEN-VALUE IN BROWSE brSon4 = STRING(tt-ordens-desemb.de-aliq-IBSUF:SCREEN-VALUE IN BROWSE brSon4).
    END.
END.

ON LEAVE OF tt-ordens-desemb.de-aliq-IBSMun IN BROWSE brSon4
DO:
    FOR FIRST class-trib NO-LOCK
        WHERE class-trib.cod-cclass-trib = tt-ordens-desemb.cClassTrib-IBSMun:SCREEN-VALUE IN BROWSE brSon4
          AND class-trib.ind-tributo  = 1 /* IBS/CBS */ 
          AND class-trib.trib-regular = 1:
