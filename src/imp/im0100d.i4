                       tt-ordens-desemb-acum-adicao.cCSTReg-IBSUF:READ-ONLY IN BROWSE brSon6 = YES.
        END.
    END.
END.

ON LEAVE OF tt-ordens-desemb-acum-adicao.cClassTrib-IBSMun IN BROWSE brSon6
DO:
    IF tt-ordens-desemb-acum-adicao.cClassTrib-IBSMun:SCREEN-VALUE IN BROWSE brSon6 <> "" THEN DO:
        FIND FIRST class-trib NO-LOCK
             WHERE class-trib.cod-cclass-trib = tt-ordens-desemb-acum-adicao.cClassTrib-IBSMun:SCREEN-VALUE IN BROWSE brSon6
               AND class-trib.ind-tributo = 1 /* IBS/CBS */ NO-ERROR.
        IF NOT AVAIL class-trib THEN DO:
            RUN utp/ut-msgs.p (INPUT "show":U,
                               INPUT 2,
                               INPUT "Class Trib":U + "~~" + tt-ordens-desemb-acum-adicao.cClassTrib-IBSMun:SCREEN-VALUE IN BROWSE brSon6).
            RETURN NO-APPLY.
        END.
        ELSE DO:
            ASSIGN tt-ordens-desemb-acum-adicao.cCST-IBSMun:SCREEN-VALUE IN BROWSE brSon6 = SUBSTRING(tt-ordens-desemb-acum-adicao.cClassTrib-IBSMun:SCREEN-VALUE IN BROWSE brSon6,1,3).
            IF class-trib.trib-regular = 1 THEN DO:
                ASSIGN tt-ordens-desemb-acum-adicao.cClassTribReg-IBSMun:READ-ONLY IN BROWSE brSon6 = NO
                       tt-ordens-desemb-acum-adicao.cCSTReg-IBSMun:READ-ONLY IN BROWSE brSon6 = NO.
                
                IF DEC(tt-ordens-desemb-acum-adicao.de-aliq-IBSMun:SCREEN-VALUE IN BROWSE brSon6) <> 0 THEN 
                    ASSIGN tt-ordens-desemb-acum-adicao.de-aliq-Reg-IBSMun:SCREEN-VALUE IN BROWSE brSon6 = STRING(tt-ordens-desemb-acum-adicao.de-aliq-IBSMun:SCREEN-VALUE IN BROWSE brSon6).
            END.
            ELSE
                ASSIGN tt-ordens-desemb-acum-adicao.de-aliq-Reg-IBSMun:SCREEN-VALUE IN BROWSE brSon6 = "0"
                       tt-ordens-desemb-acum-adicao.cClassTribReg-IBSMun:SCREEN-VALUE IN BROWSE brSon6 = ""
                       tt-ordens-desemb-acum-adicao.cCSTReg-IBSMun:SCREEN-VALUE IN BROWSE brSon6 = ""
                       tt-ordens-desemb-acum-adicao.cClassTribReg-IBSMun:READ-ONLY IN BROWSE brSon6 = YES
                       tt-ordens-desemb-acum-adicao.cCSTReg-IBSMun:READ-ONLY IN BROWSE brSon6 = YES.
        END.
    END.
END.

