/* im0100d.i4 - main-block do im0100d */

/* brSon4 */
ON ENTRY OF tt-ordens-desemb.cdn-adicao IN BROWSE brSon4
DO:
   ASSIGN i-cdn-adicao-ant = INPUT BROWSE brSon4 tt-ordens-desemb.cdn-adicao.
END.

ON LEAVE OF tt-ordens-desemb.cdn-adicao IN BROWSE brSon4
DO:
    RUN pi-leave-cdn-adicao-brSon4.
    IF RETURN-VALUE = "NOK":U THEN
        RETURN NO-APPLY.
END.

ON f5 OF tt-ordens-desemb.c-nat-fiscal IN BROWSE brSon4
OR mouse-select-dblclick OF tt-ordens-desemb.c-nat-fiscal IN BROWSE brSon4 DO:
    /* guarda a linha que foi acionado o zoom para foráar as validaá‰es do leave do campo.
      Problema: quando acionava o zoom 2 vezes seguidas n∆o estava fazendo as validaá‰es do leave do campo */
    ASSIGN i-linha-zoom = brSon4:FOCUSED-ROW IN FRAME fPage2.
    {include/zoomvar.i &prog-zoom=inzoom/z01in245.w
                       &campo=tt-ordens-desemb.c-nat-fiscal
                       &campozoom=nat-operacao
                       &ExcludeVar=yes
                       &browse=brSon4}.
END.

ON LEAVE OF tt-ordens-desemb.c-class-fiscal IN BROWSE brson4
DO:
    IF c-nom-prog-upc-mg97 <> "" THEN DO:
        RUN VALUE(c-nom-prog-upc-mg97) (INPUT "leaveNcm":U, 
                                        INPUT "":U, 
                                        INPUT THIS-PROCEDURE, 
                                        INPUT FRAME fPage2:HANDLE, 
                                        INPUT STRING(TEMP-TABLE tt-ordens-desemb:HANDLE) + ",":U 
                                           + tt-ordens-desemb.numero-ordem  :SCREEN-VALUE IN BROWSE brson4 + ",":U
                                           + tt-ordens-desemb.parcela       :SCREEN-VALUE IN BROWSE brson4 + ",":U
                                           + tt-ordens-desemb.c-class-fiscal:SCREEN-VALUE IN BROWSE brson4,
                                        INPUT ?) NO-ERROR. 
    END.
END.

ON LEAVE OF tt-ordens-desemb.c-nat-fiscal IN BROWSE brSon4
DO:
    RUN pi-leave-nat-fiscal-brSon4.
    IF RETURN-VALUE = "NOK":U THEN
        RETURN NO-APPLY.
END.

