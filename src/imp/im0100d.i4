/* brSon6 */
ON f5 OF tt-ordens-desemb-acum-adicao.c-nat-fiscal IN BROWSE brSon6
OR mouse-select-dblclick OF tt-ordens-desemb-acum-adicao.c-nat-fiscal IN BROWSE brSon6 DO:
    ASSIGN i-linha-zoom = brSon6:FOCUSED-ROW IN FRAME fPage2.
    {include/zoomvar.i &prog-zoom=inzoom/z01in245.w
                       &campo=tt-ordens-desemb-acum-adicao.c-nat-fiscal
                       &campozoom=nat-operacao
                       &BROWSE=brSon6}.
END.

ON LEAVE OF tt-ordens-desemb-acum-adicao.c-nat-fiscal IN BROWSE brSon6
DO:
    RUN pi-leave-nat-fiscal-brSon6.
    IF RETURN-VALUE = "NOK":U THEN
        RETURN NO-APPLY.
END.
        
ON ENTRY OF tt-ordens-desemb-acum-adicao.de-taxa-siscomex IN BROWSE brSon6
DO:
   ASSIGN de-tx-siscomex-ant = INPUT BROWSE brSon6 tt-ordens-desemb-acum-adicao.de-taxa-siscomex.
END.

ON LEAVE OF tt-ordens-desemb-acum-adicao.de-taxa-siscomex IN BROWSE brSon6
DO:
    IF INPUT BROWSE brSon6 tt-ordens-desemb-acum-adicao.de-taxa-siscomex <> de-tx-siscomex-ant THEN
        ASSIGN l-atualizar-despesa = YES.
   
    ASSIGN de-tx-siscomex2     = de-tx-siscomex2 + (INPUT BROWSE brSon6 tt-ordens-desemb-acum-adicao.de-taxa-siscomex - de-tx-siscomex-ant)
           de-tx-siscomex-ant = INPUT BROWSE brSon6 tt-ordens-desemb-acum-adicao.de-taxa-siscomex.

    DISP de-tx-siscomex2 WITH FRAME fpage2.
    
    FOR EACH tt-ordens-desemb EXCLUSIVE-LOCK
        WHERE tt-ordens-desemb.cdn-adicao     = tt-ordens-desemb-acum-adicao.cdn-adicao
          AND tt-ordens-desemb.c-class-fiscal = tt-ordens-desemb-acum-adicao.c-class-fiscal:
        ASSIGN tt-ordens-desemb.de-taxa-siscomex = INPUT BROWSE brSon6 tt-ordens-desemb-acum-adicao.de-taxa-siscomex.
    END.
END.

