PROCEDURE setTTitens:
/*------------------------------------------------------------------------------
  Purpose: Carrega tt-itens com valores das ordens-embarque e cria registro
           com as ordens relacionadas aos embarques filhos 
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER TABLE FOR tt-itens.
    
    IF l-gera-prim-nf-remes-mae THEN DO:

        FOR EACH tt-itens:

            IF NOT CAN-FIND(FIRST tt-embarque-oc
                            WHERE tt-embarque-oc.numero-ordem = tt-itens.numero-ordem
                              AND tt-embarque-oc.parcela      = tt-itens.parcela
                              AND tt-embarque-oc.sequencia    = tt-itens.sequencia) THEN DO:

                CREATE tt-embarque-oc.
                ASSIGN tt-embarque-oc.numero-ordem             = tt-itens.numero-ordem
                       tt-embarque-oc.parcela                  = tt-itens.parcela
                       tt-embarque-oc.sequencia                = tt-itens.sequencia
                       tt-embarque-oc.l-gera-prim-nf-remes-mae = tt-itens.l-gera-prim-nf-remes-mae.
            END.              
        END.
   END.

END PROCEDURE.


PROCEDURE setNotaAjuste:
/*------------------------------------------------------------------------------
  Purpose: Carrega variavel l-nota-ajuste e l-gera-prim-nf-remes-mae
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER p-nota-ajuste            AS LOGICAL NO-UNDO.
    DEFINE INPUT PARAMETER p-gera-prim-nf-remes-mae AS LOGICAL NO-UNDO.
    
    ASSIGN l-nota-ajuste            = p-nota-ajuste
           l-gera-prim-nf-remes-mae = p-gera-prim-nf-remes-mae.

END PROCEDURE.

PROCEDURE geradiferencavalores:
/*------------------------------------------------------------------------------
  Purpose: 
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER TABLE FOR tt-itens-rateio. 


    FOR EACH tt-desp-rateio NO-LOCK:
        
        FIND FIRST tt-ordens-totais 
             WHERE tt-ordens-totais.numero-ordem = tt-desp-rateio.numero-ordem 
               AND tt-ordens-totais.parcela      = tt-desp-rateio.parcela NO-LOCK NO-ERROR.
        
        IF AVAIL tt-ordens-totais THEN DO:
            
            FOR EACH tt-itens 
               WHERE tt-itens.numero-ordem = tt-desp-rateio.numero-ordem 
                 AND tt-itens.parcela      = tt-desp-rateio.parcela      NO-LOCK:

                CREATE tt-itens-rateio.
                ASSIGN tt-itens-rateio.numero-ordem = tt-desp-rateio.numero-ordem
                       tt-itens-rateio.parcela      = tt-desp-rateio.parcela
                       tt-itens-rateio.seq          = tt-itens.seq
                       tt-itens-rateio.cod-desp     = tt-desp-rateio.cod-desp
                       tt-itens-rateio.quantidade   = tt-itens.quantidade
                       tt-itens-rateio.val-desp     = (tt-desp-rateio.val-desp * tt-itens.quantidade) 
                                                      / tt-ordens-totais.quantidade.
    
            END.
        END.
    END.

END PROCEDURE.

PROCEDURE ordenaTtOrdensDesp:
/*------------------------------------------------------------------------------
  Purpose:    Ordernas as despesas das ordens de modo que fiquem               
              da seguinte forma:                                               
              1.  As despesas rateadas por peso, quantidade, cubagem           
                  e as despesas rateadas por valor sem incoterm de rateio      
                  (com exceá∆o dos impostos) dever∆o possuir as primeiras      
                  seqÅàncias.                                                  
              2.  As pr¢ximas despesas a serem seqÅenciadas, ser∆o as          
                  despesas rateadas por valor com incoterm de rateio.          
              3.  As £ltimas despesas a serem seqÅenciadas ser∆o os Impostos   
                  nesta ordem: Imposto de Importaá∆o, IPI, PIS, COFINS e ICMS. 
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE VARIABLE i-sequencia AS INTEGER NO-UNDO.

    /* despesas que nao sao impostos e nao possuem incoterm */
    FOR EACH  tt-ordens-desp
       WHERE tt-ordens-desp.sequencia = 0
         AND tt-ordens-desp.cod-incoterm = "":
        
        FOR FIRST param-imp FIELDS(char-1 cdn-despes-impto-ipi cdn-despes-impto-pis cdn-despes-impto-cofins cdn-despes-impto-icms) 
            WHERE param-imp.cod-estabel = tt-ordens-desp.cod-estabel NO-LOCK: END.
        
        FIND FIRST param-imp-trib
             WHERE param-imp-trib.cod-estabel = tt-ordens-desp.cod-estabel NO-LOCK NO-ERROR.

        IF  AVAIL param-imp
        AND tt-ordens-desp.cod-desp <> int(substr(param-imp.char-1,21,20))
        AND tt-ordens-desp.cod-desp <> param-imp.cdn-despes-impto-ipi
        AND tt-ordens-desp.cod-desp <> param-imp.cdn-despes-impto-pis
        AND tt-ordens-desp.cod-desp <> param-imp.cdn-despes-impto-cofins
        AND tt-ordens-desp.cod-desp <> param-imp.cdn-despes-impto-icms THEN
            
            IF  l-nt2024002 
            AND AVAIL param-imp-trib 
            AND (   tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-ibsuf
                 OR tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-ibsmun
                 OR tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-cbs
                 OR tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-is) THEN.
            ELSE
                ASSIGN i-sequencia              = i-sequencia + 1
                       tt-ordens-desp.sequencia = i-sequencia.
    END.

    /* despesas que nao sao impostos e possuem incoterm */
    FOR EACH  tt-ordens-desp
       WHERE tt-ordens-desp.sequencia = 0
         AND tt-ordens-desp.cod-incoterm <> "":
        
        FOR FIRST param-imp FIELDS(char-1 cdn-despes-impto-ipi cdn-despes-impto-pis cdn-despes-impto-cofins cdn-despes-impto-icms) 
            WHERE param-imp.cod-estabel = tt-ordens-desp.cod-estabel NO-LOCK: END.

        IF  AVAIL param-imp
        AND tt-ordens-desp.cod-desp <> int(substr(param-imp.char-1,21,20))
        AND tt-ordens-desp.cod-desp <> param-imp.cdn-despes-impto-ipi
        AND tt-ordens-desp.cod-desp <> param-imp.cdn-despes-impto-pis
        AND tt-ordens-desp.cod-desp <> param-imp.cdn-despes-impto-cofins
        AND tt-ordens-desp.cod-desp <> param-imp.cdn-despes-impto-icm THEN

            IF  l-nt2024002 
            AND AVAIL param-imp-trib 
            AND (   tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-ibsuf
                 OR tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-ibsmun
                 OR tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-cbs
                 OR tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-is) THEN.
            ELSE
                ASSIGN i-sequencia              = i-sequencia + 1
                       tt-ordens-desp.sequencia = i-sequencia.
    END.
   
    /* Imposto de Importacao */
    FOR EACH  tt-ordens-desp
       WHERE tt-ordens-desp.sequencia = 0:
        
        FOR FIRST param-imp FIELDS(char-1) 
            WHERE param-imp.cod-estabel = tt-ordens-desp.cod-estabel NO-LOCK: END.

        IF  AVAIL param-imp
        AND tt-ordens-desp.cod-desp = int(substr(param-imp.char-1,21,20)) THEN
            ASSIGN i-sequencia              = i-sequencia + 1
                   tt-ordens-desp.sequencia = i-sequencia.
    END.

    /* IPI */
    FOR EACH tt-ordens-desp
       WHERE tt-ordens-desp.sequencia = 0:
        
        FOR FIRST param-imp FIELDS(cdn-despes-impto-ipi) 
            WHERE param-imp.cod-estabel = tt-ordens-desp.cod-estabel NO-LOCK: END.

        IF  AVAIL param-imp
        AND tt-ordens-desp.cod-desp = param-imp.cdn-despes-impto-ipi THEN
            ASSIGN i-sequencia              = i-sequencia + 1
                   tt-ordens-desp.sequencia = i-sequencia.
    END.

    /* PIS */
    FOR EACH tt-ordens-desp
       WHERE tt-ordens-desp.sequencia = 0:
        
        FOR FIRST param-imp FIELDS(cdn-despes-impto-pis) 
            WHERE param-imp.cod-estabel = tt-ordens-desp.cod-estabel NO-LOCK: END.

        IF  AVAIL param-imp
        AND tt-ordens-desp.cod-desp = param-imp.cdn-despes-impto-pis THEN
            ASSIGN i-sequencia              = i-sequencia + 1
                   tt-ordens-desp.sequencia = i-sequencia.
    END.

    /* COFINS */
    FOR EACH tt-ordens-desp
       WHERE tt-ordens-desp.sequencia = 0:
        
        FOR FIRST param-imp FIELDS(cdn-despes-impto-cofins) 
            WHERE param-imp.cod-estabel = tt-ordens-desp.cod-estabel NO-LOCK: END.

        IF  AVAIL param-imp
        AND tt-ordens-desp.cod-desp = param-imp.cdn-despes-impto-cofins THEN
            ASSIGN i-sequencia              = i-sequencia + 1
                   tt-ordens-desp.sequencia = i-sequencia.
    END.

    /* ICMS */
    FOR EACH tt-ordens-desp
       WHERE tt-ordens-desp.sequencia = 0:

        FOR FIRST param-imp FIELDS(cdn-despes-impto-icms) 
            WHERE param-imp.cod-estabel = tt-ordens-desp.cod-estabel NO-LOCK: END.

        IF  AVAIL param-imp
        AND tt-ordens-desp.cod-desp = param-imp.cdn-despes-impto-icms THEN
            ASSIGN i-sequencia              = i-sequencia + 1
                   tt-ordens-desp.sequencia = i-sequencia.
    END.
    
    IF l-nt2024002 THEN DO:
        /* IBS UF */
        FOR EACH tt-ordens-desp
           WHERE tt-ordens-desp.sequencia = 0:

            FIND FIRST param-imp-trib  
                 WHERE param-imp-trib.cod-estabel = tt-ordens-desp.cod-estabel NO-LOCK NO-ERROR.

            IF  AVAIL param-imp-trib
            AND tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-ibsuf THEN
                ASSIGN i-sequencia              = i-sequencia + 1
                       tt-ordens-desp.sequencia = i-sequencia.
        END.

        /* IBS Mun */
        FOR EACH tt-ordens-desp
            WHERE tt-ordens-desp.sequencia = 0:

            FIND FIRST param-imp-trib  
                 WHERE param-imp-trib.cod-estabel = tt-ordens-desp.cod-estabel NO-LOCK NO-ERROR.

            IF  AVAIL param-imp-trib
            AND tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-ibsmun THEN
                ASSIGN i-sequencia              = i-sequencia + 1
                       tt-ordens-desp.sequencia = i-sequencia.
        END.
        
        /* CBS */
        FOR EACH tt-ordens-desp
           WHERE tt-ordens-desp.sequencia = 0:

            FIND FIRST param-imp-trib
                 WHERE param-imp-trib.cod-estabel = tt-ordens-desp.cod-estabel NO-LOCK NO-ERROR.

            IF  AVAIL param-imp-trib
            AND tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-cbs THEN
                ASSIGN i-sequencia              = i-sequencia + 1
                       tt-ordens-desp.sequencia = i-sequencia.
        END.
        
        /* IS */
        FOR EACH tt-ordens-desp
           WHERE tt-ordens-desp.sequencia = 0:

            FIND FIRST param-imp-trib
                 WHERE param-imp-trib.cod-estabel = tt-ordens-desp.cod-estabel NO-LOCK NO-ERROR.

            IF  AVAIL param-imp-trib
            AND tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-is THEN
                ASSIGN i-sequencia              = i-sequencia + 1
                       tt-ordens-desp.sequencia = i-sequencia.
        END.
    END.
    
END PROCEDURE.

PROCEDURE piIICompoeBaseEstatistica:
/*------------------------------------------------------------------------------
  Purpose: 
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/

    IF i-pais-impto-usuario <> 2 THEN
        RETURN "".
        
    FOR EACH tt-desp-rateio    
        WHERE tt-desp-rateio.cod-desp = i-cod-desp-ii,
        FIRST desp-imp NO-LOCK
        WHERE desp-imp.cod-desp = i-cod-desp-ii
        AND   desp-imp.log-incid-base-tax-estatis:

        ASSIGN tt-ordens-totais.base-est    = tt-ordens-totais.base-est    + 
                                              tt-desp-rateio.val-desp
               tt-ordens-totais.base-est-mo = tt-ordens-totais.base-est-mo + 
                                              tt-desp-rateio.val-desp-mo.
    END.  

END PROCEDURE.

PROCEDURE piBuscaNumAdicao:
/*------------------------------------------------------------------------------
  Purpose: 
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAM p-numero-ordem LIKE ordens-embarque.numero-ordem    NO-UNDO.
    DEFINE INPUT  PARAM p-parcela      LIKE ordens-embarque.parcela         NO-UNDO.
    DEFINE INPUT  PARAM p-cod-desp     LIKE desp-embarque.cod-desp          NO-UNDO.
    DEFINE OUTPUT PARAM p-num-adicao     AS INTEGER INITIAL 0               NO-UNDO.
    
    IF param-imp.log-tax-siscomex AND param-imp.cdn-despes-siscomex = p-cod-desp THEN DO:
        
        FOR FIRST ordens-embarque NO-LOCK
            WHERE ordens-embarque.numero-ordem     = p-numero-ordem
              AND ordens-embarque.parcela          = p-parcela
              AND ordens-embarque.val-tax-siscomex > 0:

            ASSIGN p-num-adicao = ordens-embarque.num-adic.
        END.
     END.
     
END PROCEDURE.

PROCEDURE rateioEmbarquesComplementar:
/*------------------------------------------------------------------------------
  Purpose: 
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAM TABLE FOR tt-selecao-embarque.
    DEFINE INPUT PARAM TABLE FOR tt-desp-embarque.
    
    DEFINE VARIABLE i-cod-itiner    LIKE itinerario.cod-itiner      NO-UNDO.
    DEFINE VARIABLE de-val-desp     LIKE cotacao-item-cex.val-desp  NO-UNDO.
    DEFINE VARIABLE c-desp-incoterm LIKE desp-embarque.cod-incoterm NO-UNDO.
    DEFINE VARIABLE d-val-desp-orig LIKE desp-embarque.val-desp     NO-UNDO.

    ASSIGN l-nacionalizacao = NO.

    FOR EACH tt-selecao-embarque
       WHERE tt-selecao-embarque.marca = "X":U :
        
        ASSIGN c-cod-estabel-aux = tt-selecao-embarque.cod-estabel
               c-embarque-aux    = tt-selecao-embarque.embarque .

        FIND FIRST embarque-imp
             WHERE embarque-imp.cod-estabel = tt-selecao-embarque.cod-estabel
               AND embarque-imp.embarque    = tt-selecao-embarque.embarque NO-LOCK NO-ERROR.
        
        IF NOT AVAIL embarque-imp THEN DO:

            ASSIGN i-seq-erro = i-seq-erro + 1.
            {utp/ut-table.i mgcex embarque-imp 1}
            CREATE tt-bo-erro.
            ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + tt-selecao-embarque.embarque.

            RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).

            ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = RETURN-VALUE.
            UNDO, LEAVE.
        END.
        
        FIND FIRST historico-embarque
             WHERE historico-embarque.cod-estabel = embarque-imp.cod-estabel
               AND historico-embarque.embarque    = embarque-imp.embarque NO-LOCK NO-ERROR.
              
        IF NOT AVAIL historico-embarque THEN DO:

            ASSIGN i-seq-erro = i-seq-erro + 1.
            {utp/ut-table.i mgcex historico-embarque 1}
            CREATE tt-bo-erro.
            ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + embarque-imp.embarque.

            RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).

            ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = RETURN-VALUE.
            UNDO, LEAVE.
        END.
        
        FIND FIRST itinerario
             WHERE itinerario.cod-itiner = historico-embarque.cod-itiner NO-LOCK NO-ERROR.
            
        IF NOT AVAIL itinerario THEN DO:

            ASSIGN i-seq-erro = i-seq-erro + 1.
            {utp/ut-table.i mgcex itinerario 1}
            CREATE tt-bo-erro.
            ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + STRING(historico-embarque.cod-itiner).
            
            RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
            
            ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = RETURN-VALUE.
            UNDO, LEAVE.
        END.
        
        ASSIGN i-cod-itiner = historico-embarque.cod-itiner.
       
        FOR EACH ordens-embarque
           WHERE ordens-embarque.cod-estabel = tt-selecao-embarque.cod-estabel
             AND ordens-embarque.embarque   = tt-selecao-embarque.embarque NO-LOCK:

            RUN geraOrdenstotais (INPUT ordens-embarque.numero-ordem,
                                  INPUT ordens-embarque.parcela,
                                  INPUT ?,
                                  INPUT ?,
                                  INPUT ?,
                                  INPUT ordens-embarque.quantidade,
                                  INPUT ordens-embarque.qt-do-forn).
        END.
    END.

    EMPTY TEMP-TABLE tt-desp-totais-incoterm.
    
    IF l-existe-incoterm THEN
        FOR EACH inco-cx NO-LOCK:
            CREATE tt-desp-totais-incoterm.
            ASSIGN tt-desp-totais-incoterm.cod-incoterm = inco-cx.cod-incoterm.
        END.
        
    FOR EACH tt-desp-embarque NO-LOCK,
       FIRST desp-embarque NO-LOCK
       WHERE desp-embarque.cod-estabel = tt-desp-embarque.cod-estabel
         AND desp-embarque.embarque    = tt-desp-embarque.embarque:

        ASSIGN da-data-cotacao = desp-embarque.data-implant.
        
        FIND FIRST desp-imp
             WHERE desp-imp.cod-desp = tt-desp-embarque.cod-desp NO-LOCK NO-ERROR.

        IF NOT AVAIL desp-imp THEN
            NEXT.

        ASSIGN c-desp-incoterm = desp-embarque.cod-incoterm
               d-val-desp-orig = desp-embarque.val-desp.    
      
        FIND FIRST param-imp
             WHERE param-imp.cod-estabel = tt-desp-embarque.cod-estabel NO-LOCK NO-ERROR.

        IF NOT AVAIL param-imp THEN
            NEXT.
        
        ASSIGN de-val-desp    = tt-desp-embarque.val-desp.       
        
        RUN geraOrdensdespesa (INPUT tt-desp-embarque.cod-desp,
                               INPUT tt-desp-embarque.embarque,
                               INPUT i-cod-itiner,
                               INPUT de-val-desp,
                               INPUT d-val-desp-orig,
                               INPUT 0,
                               INPUT 0,
                               INPUT YES,
                               INPUT tt-desp-embarque.cod-emitente-desp,
                               INPUT tt-desp-embarque.cond-pagto,
                               INPUT tt-desp-embarque.moeda,
                               INPUT tt-desp-embarque.cod-pto-contr,
                               INPUT c-desp-incoterm,
                               INPUT l-existe-incoterm).
    END.
    
    RUN ordenaTtOrdensDesp.

    EMPTY TEMP-TABLE tt-ordens-totais-incoterm.

    IF l-existe-incoterm THEN
        FOR EACH inco-cx NO-LOCK:
            CREATE tt-ordens-totais-incoterm.
            ASSIGN tt-ordens-totais-incoterm.cod-incoterm = inco-cx.cod-incoterm.
        END.

    RUN geraRateiodespesas.

END PROCEDURE.

PROCEDURE piCriaDespEmbRateio:
/*------------------------------------------------------------------------------
  Purpose: 
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAM TABLE FOR tt-desp-embarque-rateio.
    
    DEFINE BUFFER bftt-desp-embarque FOR tt-desp-embarque.

    EMPTY TEMP-TABLE tt-desp-embarque-rateio.

    FOR EACH tt-desp-rateio NO-LOCK:

        FOR FIRST ordens-embarque NO-LOCK
            WHERE ordens-embarque.numero-ordem = tt-desp-rateio.numero-ordem
              AND ordens-embarque.parcela      = tt-desp-rateio.parcela:

            IF NOT CAN-FIND(FIRST tt-desp-embarque-rateio
                            WHERE tt-desp-embarque-rateio.cod-estabel = ordens-embarque.cod-estabel
                            AND   tt-desp-embarque-rateio.embarque    = ordens-embarque.embarque
                            AND   tt-desp-embarque-rateio.cod-desp    = tt-desp-rateio.cod-desp) THEN DO:
                
                IF NOT CAN-FIND(FIRST desp-embarque
                                WHERE desp-embarque.cod-estabel = ordens-embarque.cod-estabel
                                AND   desp-embarque.embarque    = ordens-embarque.embarque
                                AND   desp-embarque.cod-desp    = tt-desp-rateio.cod-desp) THEN DO:
                    
                    /*Buscando a Despesa original para criar a rateada com os mesmos dados exceto embarque, estabelecimento e valor*/                            
                    FOR FIRST tt-desp-embarque NO-LOCK
                        WHERE tt-desp-embarque.cod-desp = tt-desp-rateio.cod-desp:
                        
                        find first historico-embarque where historico-embarque.cod-estabel = ordens-embarque.cod-estabel
                                                      and   historico-embarque.embarque    = ordens-embarque.embarque
                                                      no-lock no-error.
                        CREATE tt-desp-embarque-rateio.
                        ASSIGN tt-desp-embarque-rateio.embarque      = ordens-embarque.embarque
                               tt-desp-embarque-rateio.cod-estabel   = ordens-embarque.cod-estabel
                               tt-desp-embarque-rateio.cod-itiner    = if avail historico-embarque then historico-embarque.cod-itiner else tt-desp-embarque.cod-itiner
                               tt-desp-embarque-rateio.cod-pto-contr = tt-desp-embarque.cod-pto-contr
                               tt-desp-embarque-rateio.val-desp      = tt-desp-rateio.val-desp.

                        BUFFER-COPY tt-desp-embarque EXCEPT val-desp embarque cod-estabel cod-itiner cod-pto-contr TO tt-desp-embarque-rateio.                           
                    END.
                END.
                ELSE DO:
                    FOR FIRST desp-embarque NO-LOCK
                        WHERE desp-embarque.cod-estabel = ordens-embarque.cod-estabel
                        AND   desp-embarque.embarque    = ordens-embarque.embarque
                        AND   desp-embarque.cod-desp    = tt-desp-rateio.cod-desp:

                        CREATE tt-desp-embarque-rateio.
                        BUFFER-COPY desp-embarque EXCEPT val-desp TO tt-desp-embarque-rateio.
                        ASSIGN tt-desp-embarque-rateio.val-desp = tt-desp-rateio.val-desp.
                    END.
                END.
            END.
            ELSE DO:
                
                FOR FIRST tt-desp-embarque-rateio
                    WHERE tt-desp-embarque-rateio.cod-estabel = ordens-embarque.cod-estabel
                    AND   tt-desp-embarque-rateio.embarque    = ordens-embarque.embarque
                    AND   tt-desp-embarque-rateio.cod-desp    = tt-desp-rateio.cod-desp:

                    ASSIGN tt-desp-embarque-rateio.val-desp = tt-desp-embarque-rateio.val-desp + tt-desp-rateio.val-desp.
                END.
            END.
        END.
    END.

END PROCEDURE.

PROCEDURE setTTembarquesFilhos:
/*------------------------------------------------------------------------------
  Purpose: Seta temp-table com os embarques filhos relacionados ao embarque m∆e
           que gera primeira remessa. Executado pelo programa im7777.i11 
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER TABLE FOR tt-embarque-filho-aux.
    
    RETURN "OK":U.
END PROCEDURE.

PROCEDURE pigeraDespesasAux:
/*------------------------------------------------------------------------------
  Purpose: Procedure respons†vel por totalizar os valores das Despesas quando 
           a primeira remessa est† sendo gerado com a nota M∆e 
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pc-cod-estabel-orig LIKE embarque-imp.cod-estabel NO-UNDO.
    DEFINE INPUT PARAMETER pc-embarque-orig    LIKE embarque-imp.embarque    NO-UNDO.
    DEFINE INPUT PARAMETER pc-cod-estabel      LIKE embarque-imp.cod-estabel NO-UNDO.
    DEFINE INPUT PARAMETER pc-embarque         LIKE embarque-imp.embarque    NO-UNDO.
    DEFINE INPUT PARAMETER pi-cod-itiner       LIKE itinerario.cod-itiner    NO-UNDO.
    
    DEFINE VARIABLE de-val-desp LIKE cotacao-item-cex.val-desp NO-UNDO.
 
    FOR EACH desp-embarque 
       WHERE desp-embarque.cod-estabel = pc-cod-estabel
         AND desp-embarque.embarque    = pc-embarque    NO-LOCK:
        
        FIND FIRST desp-imp
             WHERE desp-imp.cod-desp = desp-embarque.cod-desp NO-LOCK NO-ERROR.
        
        IF NOT AVAIL desp-imp THEN
           NEXT.

        IF l-nacionalizacao THEN DO:
            IF  NOT desp-imp.inc-val-frete 
            AND NOT desp-imp.inc-val-seguro 
            AND NOT desp-imp.inc-val-embal 
            AND NOT desp-imp.inc-val-outras-desp THEN
                NEXT.
        END.

        FIND FIRST param-imp
             WHERE param-imp.cod-estabel = desp-embarque.cod-estabel NO-LOCK NO-ERROR.

        FIND FIRST param-imp-trib
             WHERE param-imp-trib.cod-estabel = desp-embarque.cod-estabel NO-LOCK NO-ERROR.

        IF NOT AVAIL param-imp THEN
            NEXT.
       
        IF desp-embarque.cod-desp = i-cod-desp-ii THEN
            ASSIGN l-cod-desp-ii = YES.
          
        IF desp-embarque.cod-desp = param-imp.cdn-despes-impto-ipi THEN
            ASSIGN l-cod-desp-ipi = YES.
        
        IF desp-embarque.cod-desp = param-imp.cdn-despes-impto-pis THEN
            ASSIGN l-cod-desp-pis = yes.
        
        IF desp-embarque.cod-desp = param-imp.cdn-despes-impto-cofins THEN
            ASSIGN l-cod-desp-cofins = YES.
        
        IF desp-embarque.cod-desp = param-imp.cdn-despes-impto-icms THEN
            ASSIGN l-cod-desp-icms = YES.
        
        IF i-pais-impto-usuario = 2 AND desp-embarque.cod-desp = i-cod-desp-est THEN
            ASSIGN l-cod-desp-est = YES.
        
        IF l-nt2024002 
        AND AVAIL param-imp-trib
        AND desp-embarque.cod-desp = param-imp-trib.cdn-despes-impto-ibsuf THEN
            ASSIGN l-cod-desp-ibsuf = YES.

        IF l-nt2024002 
        AND AVAIL param-imp-trib
        AND desp-embarque.cod-desp = param-imp-trib.cdn-despes-impto-ibsmun THEN
            ASSIGN l-cod-desp-ibsmun = YES.
            
        IF l-nt2024002 
        AND AVAIL param-imp-trib
        AND desp-embarque.cod-desp = param-imp-trib.cdn-despes-impto-cbs THEN
            ASSIGN l-cod-desp-cbs = YES.
            
        IF l-nt2024002 
        AND AVAIL param-imp-trib
        AND desp-embarque.cod-desp = param-imp-trib.cdn-despes-impto-is THEN
            ASSIGN l-cod-desp-is = YES.
            
        FIND FIRST historico-embarque 
             WHERE historico-embarque.cod-estabel   = pc-cod-estabel-orig
               AND historico-embarque.embarque      = pc-embarque-orig
               AND historico-embarque.cod-itiner    = pi-cod-itiner
               AND historico-embarque.cod-pto-contr = desp-embarque.cod-pto-contr NO-LOCK NO-ERROR.
          
        if i-pais-impto-usuario = 1 or not l-nota-filha then do:
                IF NOT AVAIL historico-embarque 
                OR (historico-embarque.sequencia > tt-itiner-emb.i-seq-pto-desemb AND NOT l-todas-despesas) THEN
                    NEXT.
        end.
        else do:
           IF NOT AVAIL historico-embarque or           
             (historico-embarque.sequencia > tt-itiner-emb.i-seq-pto-desemb and not desp-embarque.log-despes-ja-recbda) THEN next.
        end.

        ASSIGN de-val-desp = desp-embarque.val-desp.
        
        FIND FIRST ordens-embarque NO-LOCK
             WHERE ordens-embarque.cod-estabel = pc-cod-estabel
               AND ordens-embarque.embarque    = pc-embarque NO-ERROR.
               
        FIND FIRST ordem-compra NO-LOCK
             WHERE ordem-compra.numero-ordem = ordens-embarque.numero-ordem NO-ERROR.
        
        IF desp-embarque.mo-codigo <> 0 THEN DO:
            if d-cotacao = 0 
            or not avail ordem-compra
            or ordem-compra.mo-codigo <> desp-embarque.mo-codigo
            then
                RUN cdp/cd0812.p (INPUT  desp-embarque.mo-codigo,
                                  INPUT  0,
                                  INPUT  desp-embarque.val-desp,
                                  INPUT  da-data-cotacao,
                                  OUTPUT de-val-desp).                                          
            else
                RUN cdp/cd0812a.p (INPUT  desp-embarque.mo-codigo,
                                   INPUT  0,
                                   INPUT  desp-embarque.val-desp,
                                   INPUT  d-cotacao,
                                   OUTPUT de-val-desp).                                                      
        END.
        
        IF i-pais-impto-usuario <> 1 and l-nota-filha and historico-embarque.sequencia > tt-itiner-emb.i-seq-pto-desemb THEN DO:
           /* Pega a cotaá∆o da nota m∆e complementar */
           RUN pi-busca-nota-mae-comp (INPUT pc-cod-estabel-orig,
                                       INPUT pc-embarque-orig,
                                       input desp-embarque.cod-emitente-desp,
                                       input desp-embarque.cod-desp,
                                       OUTPUT r-rowid-mae).
           
           IF r-rowid-mae <> ? THEN DO:

              FOR FIRST b-docum-est-2 NO-LOCK
                  WHERE ROWID(b-docum-est-2) = r-rowid-mae:

                  /* a desp-embarque sempre ser† na mesma moeda do docto complementar */
                  IF desp-embarque.mo-codigo <> 0 THEN
                        assign de-val-desp = desp-embarque.val-desp * b-docum-est-2.cotacao-dia.
                                
                  FOR FIRST item-doc-est-cex NO-LOCK          
                      WHERE item-doc-est-cex.serie-docto       = b-docum-est-2.serie-docto    
                        AND item-doc-est-cex.nro-docto         = b-docum-est-2.nro-docto      
                        AND item-doc-est-cex.cod-emitente      = b-docum-est-2.cod-emitente  
                        AND item-doc-est-cex.nat-operacao      = b-docum-est-2.nat-operacao     
                        AND item-doc-est-cex.cod-emitente-desp = desp-embarque.cod-emitente-desp
                        AND item-doc-est-cex.cod-desp          = desp-embarque.cod-desp:                                                                      
                          create tt-desp-comp.
                          assign tt-desp-comp.cod-desp  = desp-embarque.cod-desp
                                 tt-desp-comp.mo-codigo = desp-embarque.mo-codigo
                                 tt-desp-comp.dt-cotac  = item-doc-est-cex.dat-cotac
                                 tt-desp-comp.cotacao   = b-docum-est-2.cotacao-dia.
                  END.                  
              END.
           END.                                      
        END.


        IF PROGRAM-NAME(6) = "pi-executar imp/im0100.w":U THEN DO:
            
            /*Include i-epc200.i2: Criacao de registro para temp-table tt-epc */
            {include/i-epc200.i2 &CodEvent='"ConverteDespesa"'
                                 &CodParameter='"cod-estabel"'
                                 &ValueParameter="string(desp-embarque.cod-estabel)"}
            {include/i-epc200.i2 &CodEvent='"ConverteDespesa"'
                                 &CodParameter='"embarque"'
                                 &ValueParameter="string(desp-embarque.embarque)"}
            {include/i-epc200.i2 &CodEvent='"ConverteDespesa"'
                                 &CodParameter='"cod-desp"'
                                 &ValueParameter="string(desp-embarque.cod-desp)"}
            {include/i-epc200.i2 &CodEvent='"ConverteDespesa"'
                                 &CodParameter='"moeda"'
                                 &ValueParameter="string(desp-embarque.mo-codigo)"}
            {include/i-epc200.i2 &CodEvent='"ConverteDespesa"'
                                 &CodParameter='"val-desp"'
                                 &ValueParameter="string(desp-embarque.val-desp)"}
                                 
            {include/i-epc200.i2 &CodEvent='"ConverteDespesa"'
                                 &CodParameter='"nacionalizacao"'
                                 &ValueParameter="string(l-nacionalizacao)"}
                                 
            {include/i-epc200.i2 &CodEvent='"ConverteDespesa"'
                                 &CodParameter='"val-desp-conv"'
                                 &ValueParameter="string(de-val-desp)"}
                                 
            /*Include i-epc201.i: Chamada do programa de EPC */
            {include/i-epc201.i "ConverteDespesa"}
        END.
        
        IF c-nom-prog-dpc-mg97  <> "" 
        OR c-nom-prog-appc-mg97 <> "" 
        OR c-nom-prog-upc-mg97  <> "" THEN DO:
            
            FIND FIRST tt-epc 
                 WHERE tt-epc.cod-event = "ConverteDespesa":U 
                   AND tt-epc.cod-parameter = "val-desp-conv" NO-ERROR.

            IF AVAIL tt-epc THEN
                ASSIGN de-val-desp = DEC(tt-epc.val-parameter).
        
            EMPTY TEMP-TABLE tt-epc.
        END.
          
        FIND FIRST tt-desp-embarque-aux
             WHERE tt-desp-embarque-aux.cod-estabel       = pc-cod-estabel-orig
               AND tt-desp-embarque-aux.embarque          = pc-embarque-orig
               AND tt-desp-embarque-aux.cod-itiner        = desp-embarque.cod-itiner       
               AND tt-desp-embarque-aux.cod-pto-contr     = desp-embarque.cod-pto-contr    
               AND tt-desp-embarque-aux.cod-desp          = desp-embarque.cod-desp         
               AND tt-desp-embarque-aux.cod-emitente-desp = desp-embarque.cod-emitente-desp NO-LOCK NO-ERROR.

        IF NOT AVAIL tt-desp-embarque-aux THEN DO:
            
            CREATE tt-desp-embarque-aux.
            BUFFER-COPY desp-embarque EXCEPT val-desp TO tt-desp-embarque-aux.
            ASSIGN tt-desp-embarque-aux.cod-estabel = pc-cod-estabel-orig
                   tt-desp-embarque-aux.embarque    = pc-embarque-orig.                   

        END.
                
        ASSIGN tt-desp-embarque-aux.val-desp    = tt-desp-embarque-aux.val-desp    + desp-embarque.val-desp
               tt-desp-embarque-aux.de-val-desp = tt-desp-embarque-aux.de-val-desp + de-val-desp. 
    END.
    
    RETURN "OK":U.
END PROCEDURE.


PROCEDURE pi-busca-nota-mae-comp:
   
    DEF INPUT  PARAM pc-estab    AS CHAR  NO-UNDO.
    DEF INPUT  PARAM pc-embarq   AS CHAR  NO-UNDO.
    DEF INPUT  PARAM pi-cod-emitente-desp AS int  NO-UNDO.
    DEF INPUT  PARAM pi-cod-desp AS int  NO-UNDO.
    DEF OUTPUT PARAM pr-rowid    AS ROWID NO-UNDO.

    DEF VAR l-sair AS LOG NO-UNDO.
    DEF VAR c-prox-embarq AS CHAR NO-UNDO.

    ASSIGN l-sair        = NO
           c-prox-embarq = pc-embarq.   

    REPEAT WHILE l-sair = NO:        

         /* N∆o encontrou nota para o embarque relacionado */
         IF NOT CAN-FIND(FIRST b-embarq-import-docto 
                   WHERE b-embarq-import-docto.cod-estab  = pc-estab 
                   AND   b-embarq-import-docto.cod-embarq = c-prox-embarq) THEN DO:   
            FOR FIRST b-embarque-imp NO-LOCK                                                                                                           
                WHERE b-embarque-imp.cod-estab = pc-estab                                                                    
                AND   b-embarque-imp.embarque  = c-prox-embarq:                  
                ASSIGN c-prox-embarq = SUBSTRING(b-embarque-imp.char-1,21,20).    
            END. 
         END.


         FOR EACH b-embarq-import-docto FIELDS(cod-estab cod-embarq cod-ser-docto cod-docto cdn-emitente cod-natur-operac)
            WHERE b-embarq-import-docto.cod-estab  = pc-estab 
            AND   b-embarq-import-docto.cod-embarq = c-prox-embarq  NO-LOCK:


             /* verifica se Ç a nota m∆e */ 
             FOR FIRST b-docum-est-2 FIELDS(serie-docto nro-docto cod-emitente nat-operacao idi-nf-simples-remes embarque) 
                 WHERE b-docum-est-2.serie-docto  = b-embarq-import-docto.cod-ser-docto             
                   AND b-docum-est-2.nro-docto    = b-embarq-import-docto.cod-docto                 
                   AND b-docum-est-2.cod-emitente = b-embarq-import-docto.cdn-emitente              
                   AND b-docum-est-2.nat-operacao = b-embarq-import-docto.cod-natur-operac NO-LOCK:
             END. 
             /* se for nota filha grava o embarque de origem para pr¢xima busca */
             IF b-docum-est-2.idi-nf-simples-remes   = 2 THEN DO:
                FOR FIRST b-embarque-imp NO-LOCK                                                                                                           
                    WHERE b-embarque-imp.cod-estab = b-embarq-import-docto.cod-estab                                                                    
                    AND   b-embarque-imp.embarque  = c-prox-embarq:                  
                    ASSIGN c-prox-embarq = SUBSTRING(b-embarque-imp.char-1,21,20).    
                END.
             END. 
    
             IF b-docum-est-2.idi-nf-simples-remes   <> 1    THEN NEXT. /* Nota M∆e idi-nf-simples-remes = 1 */
             IF b-docum-est-2.embarque <> b-embarq-import-docto.cod-embarq THEN NEXT.
           
             FOR EACH  item-doc-est NO-LOCK
                 WHERE item-doc-est.serie-comp   = b-docum-est-2.serie-docto
                   AND item-doc-est.nro-comp     = b-docum-est-2.nro-docto
                   AND item-doc-est.cod-emitente = pi-cod-emitente-desp
                   AND item-doc-est.nat-comp     = b-docum-est-2.nat-operacao,                    
                 FIRST item-doc-est-cex NO-LOCK          
                 WHERE item-doc-est-cex.serie-docto       = item-doc-est.serie-docto    
                   AND item-doc-est-cex.nro-docto         = item-doc-est.nro-docto      
                   AND item-doc-est-cex.cod-emitente      = item-doc-est.cod-emitente  
                   AND item-doc-est-cex.nat-operacao      = item-doc-est.nat-operacao     
                   AND item-doc-est-cex.cod-emitente-desp = pi-cod-emitente-desp
                   AND item-doc-est-cex.cod-desp          = pi-cod-desp:
    
                   FOR FIRST b-docum-est-3 NO-LOCK
                       WHERE b-docum-est-3.serie-docto  = item-doc-est.serie-docto 
                         AND b-docum-est-3.nro-docto    = item-doc-est.nro-docto   
                         AND b-docum-est-3.cod-emitente = item-doc-est.cod-emitente
                         AND b-docum-est-3.nat-operacao = item-doc-est.nat-operacao:

                        ASSIGN pr-rowid = ROWID(b-docum-est-3).
                   END.

                   LEAVE.

             END.

             ASSIGN l-sair = YES.
           
         END.

         IF c-prox-embarq = "" THEN
            ASSIGN l-sair = YES. 
    END.

    RETURN "OK":U.
END.

PROCEDURE setaValorCotacao:

    DEFINE INPUT PARAMETER p-d-cotacao AS DECIMAL NO-UNDO.
    
    ASSIGN d-cotacao = p-d-cotacao.

    RETURN "OK":U.
END PROCEDURE.

