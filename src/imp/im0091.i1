DEFINE TEMP-TABLE tt-taxa-rateio NO-UNDO
    FIELD cod-incoterm LIKE inco-cx.cod-incoterm
    FIELD numero-ordem LIKE ordem-compra.numero-ordem
    FIELD val-desp-tot LIKE desp-imp.val-desp
    FIELD taxa-rateio AS DECIMAL.
    
DEFINE TEMP-TABLE tt-embarque-oc NO-UNDO
    FIELD numero-ordem             LIKE ordens-embarque.numero-ordem
    FIELD parcela                  LIKE ordens-embarque.parcela
    FIELD sequencia                AS   INTEGER
    FIELD l-gera-prim-nf-remes-mae AS   LOGICAL.

DEFINE TEMP-TABLE tt-embarque-filho-aux NO-UNDO
    FIELD cod-estabel   LIKE embarque-imp.cod-estabel
    FIELD embarque      LIKE embarque-imp.embarque.

DEFINE TEMP-TABLE tt-desp-embarque-aux NO-UNDO LIKE desp-embarque    
   FIELD de-val-desp LIKE desp-embarque.val-desp.
   
/* Temp-table utilizada para acerto de residuos quando a nacionalizacao da nota mae carrega a primeira remessa */
DEFINE TEMP-TABLE tt-ordens-desp-aux NO-UNDO LIKE tt-ordens-desp
    FIELD de-val-desp              AS DECIMAL
    FIELD de-val-desp-round        AS DECIMAL
    FIELD de-val-desp-isento       AS DECIMAL
    FIELD de-val-desp-isento-round AS DECIMAL.      
   
DEFINE TEMP-TABLE tt-ext-item-doc-est NO-UNDO LIKE ext-item-doc-est
    FIELD r-Rowid AS ROWID.

DEFINE TEMP-TABLE tt-desconto-icms NO-UNDO 
       FIELD numero-ordem       LIKE ordens-embarque.numero-ordem
       FIELD parcela            LIKE ordens-embarque.parcela
       FIELD de-perc-desc-icms  AS DECIMAL             
       FIELD l-aplica-desc-icms AS LOGICAL .

DEFINE TEMP-TABLE tt-desp-comp NO-UNDO
       FIELD cod-desp  AS INT
       FIELD mo-codigo AS INT
       FIELD dt-cotac  AS DATE
       FIELD cotacao   AS DEC.

