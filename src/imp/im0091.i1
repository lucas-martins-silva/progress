                   tt-bo-erro.mensagem = RETURN-VALUE.
            UNDO, LEAVE.
        END.
    END.
    
END PROCEDURE.

PROCEDURE setaValorinicialPisCofins:
/*------------------------------------------------------------------------------
  Purpose: Seta valores iniciais para o programa 
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER p-data-cotacao AS DATE                    NO-UNDO.
    DEFINE INPUT PARAMETER p-cod-estabel  LIKE estabelec.cod-estabel NO-UNDO.
    DEFINE INPUT PARAMETER p-l-pis        AS LOGICAL                 NO-UNDO.

    {cxbo/bocx250.i50} /* include tratamento atributo livre */
    
    ASSIGN da-data-cotacao  = p-data-cotacao
           c-cod-estabel    = p-cod-estabel
           l-nacionalizacao = NO
           l-grupodeordens  = NO
           l-cod-desp-ii    = NO /*Verificar se o imposto de importaªío foi informado no acompanhamento de embarque(im0055)*/
           l-pis            = p-l-pis. 
    
    FIND FIRST param-imp
         WHERE param-imp.cod-estabel = c-cod-estabel NO-LOCK NO-ERROR.
    IF NOT AVAIL param-imp THEN DO:

        ASSIGN i-seq-erro = i-seq-erro + 1.
        {utp/ut-table.i mgcex param-imp 1}
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + c-cod-estabel.
        
        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    
    IF  p-l-pis THEN
        ASSIGN i-cod-desp-pis-cofins = param-imp.cdn-despes-impto-pis
               i-cod-desp-pis        = param-imp.cdn-despes-impto-pis
               i-cod-emitente-pis    = param-imp.cdn-fornec-pis.
    ELSE
        ASSIGN i-cod-desp-pis-cofins = param-imp.cdn-despes-impto-cofins
               i-cod-desp-cofins     = param-imp.cdn-despes-impto-cofins
               i-cod-emitente-cofins = param-imp.cdn-fornec-cofins.
           
    IF i-cod-desp-pis-cofins <> 0 THEN DO:
        IF NOT CAN-FIND(FIRST desp-imp 
                        WHERE desp-imp.cod-desp = i-cod-desp-pis-cofins) THEN DO:

            ASSIGN i-seq-erro = i-seq-erro + 1.
            IF p-l-pis THEN DO:
                {utp/ut-liter.i Despesa_PIS * L}
            END.
            ELSE DO:
                {utp/ut-liter.i Despesa_COFINS * L}
            END.
            CREATE tt-bo-erro.
            ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + STRING(i-cod-desp-pis-cofins).
            
            RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
            ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = RETURN-VALUE.
            UNDO, LEAVE.
        END.
    END.

END PROCEDURE.

PROCEDURE setaValorInternac:
/*------------------------------------------------------------------------------
  Purpose: Seta parÉmetros para o internacional
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEF INPUT PARAM p-de-cot-var-cambial AS DEC NO-UNDO.
    def input param p-nota-filha         as log no-undo.
    
    ASSIGN de-cot-var-cambial = p-de-cot-var-cambial
           l-nota-filha       = p-nota-filha.

    RETURN "OK":U.
END PROCEDURE.

PROCEDURE rateioGrupoordens:
/*------------------------------------------------------------------------------
  Purpose: Rateia Despesas para Cotaªío por Grupo de Ordens
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER p-cod-agrup   LIKE cot-ordem.cod-agrup  NO-UNDO.
    DEFINE INPUT  PARAMETER p-mapa-ordem  LIKE cot-ordem.mapa-ordem NO-UNDO.
    DEFINE INPUT  PARAMETER p-cod-despesa LIKE desp-imp.cod-desp    NO-UNDO.
    DEFINE OUTPUT PARAMETER TABLE FOR tt-desp-rateio.
    
    DEFINE VARIABLE de-quantidade  LIKE prazo-compra.quantidade   NO-UNDO.
    DEFINE VARIABLE i-cod-itiner   LIKE itinerario.cod-itiner     NO-UNDO.
    DEFINE VARIABLE de-val-desp    LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE VARIABLE de-qtd-desp    LIKE prazo-compra.quantidade   NO-UNDO.
    
    ASSIGN l-grupodeordens = YES
           i-cod-despesa   = p-cod-despesa
           c-cod-agrup     = p-cod-agrup
           i-mapa-ordem    = p-mapa-ordem.

    FOR EACH cot-ordem
       WHERE cot-ordem.cod-agrup  = p-cod-agrup
         AND cot-ordem.mapa-ordem = p-mapa-ordem NO-LOCK:

        ASSIGN i-cod-itiner = cot-ordem.cod-itiner.

        FOR EACH prazo-compra
           WHERE prazo-compra.numero-ordem = cot-ordem.numero-ordem NO-LOCK:
                
            RUN geraOrdenstotais (INPUT cot-ordem.numero-ordem,
                                  INPUT prazo-compra.parcela,
                                  INPUT cot-ordem.cod-emitente,
                                  INPUT cot-ordem.data-1,
                                  INPUT cot-ordem.seq-cotac,
                                  INPUT prazo-compra.quantidade,
                                  INPUT prazo-compra.quantidade). /* passa a unidade de medida interna porque nesse momento a cotacao nao estara aprovada */
        END.
    END.
    
    FIND FIRST itinerario
         WHERE itinerario.cod-itiner = i-cod-itiner NO-LOCK NO-ERROR.
        
    IF NOT AVAIL itinerario THEN DO:

        ASSIGN i-seq-erro = i-seq-erro + 1.
        {utp/ut-table.i mgcex itinerario 1}
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + STRING(historico-embarque.cod-itiner).

        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.

    CREATE tt-itiner-emb.
    ASSIGN tt-itiner-emb.cod-itiner        = i-cod-itiner
           tt-itiner-emb.i-pto-desembarque = itinerario.pto-desembarque.    
    
    ASSIGN l-existe-incoterm = CAN-FIND(FIRST desp-cot-ordem 
                                        WHERE desp-cot-ordem.cod-agrup  = p-cod-agrup
                                          AND desp-cot-ordem.mapa-ordem = p-mapa-ordem
                                          AND desp-cot-ordem.cod-incoterm-rat <> "").
    
    EMPTY TEMP-TABLE tt-desp-totais-incoterm.

    IF l-existe-incoterm THEN
        FOR EACH inco-cx NO-LOCK:
            CREATE tt-desp-totais-incoterm.
            ASSIGN tt-desp-totais-incoterm.cod-incoterm = inco-cx.cod-incoterm.
        END.

    FOR EACH desp-cot-ordem 
       WHERE desp-cot-ordem.cod-agrup  = p-cod-agrup
         AND desp-cot-ordem.mapa-ordem = p-mapa-ordem NO-LOCK:
        
        ASSIGN de-val-desp = desp-cot-ordem.val-desp.

        IF desp-cot-ordem.mo-codigo <> 0 THEN DO:
            if d-cotacao = 0 then
                RUN cdp/cd0812.p (INPUT  desp-cot-ordem.mo-codigo,
                                  INPUT  0,
                                  INPUT  desp-cot-ordem.val-desp,
                                  INPUT  da-data-cotacao,
                                  OUTPUT de-val-desp).
            else
                RUN cdp/cd0812a.p (INPUT  desp-cot-ordem.mo-codigo,
                                   INPUT  0,
                                   INPUT  desp-cot-ordem.val-desp,
                                   INPUT  d-cotacao,
                                   OUTPUT de-val-desp).            
        END.        
        RUN geraOrdensdespesa (INPUT desp-cot-ordem.cod-desp,
                               INPUT "",
                               INPUT i-cod-itiner,
                               INPUT de-val-desp,
                               INPUT desp-cot-ordem.val-desp,
                               INPUT 0,
                               INPUT 0,
                               INPUT NO,
                               INPUT desp-cot-ordem.cod-emitente-desp,
                               INPUT desp-cot-ordem.cod-cond-pag,
                               INPUT desp-cot-ordem.mo-codigo,
                               INPUT desp-cot-ordem.cod-pto-contr,
                               INPUT desp-cot-ordem.cod-incoterm-rat,
                               INPUT l-existe-incoterm).
    END.
    
    RUN ordenaTtOrdensDesp.

    EMPTY TEMP-TABLE tt-ordens-totais-incoterm.

    IF l-existe-incoterm THEN
        FOR EACH inco-cx NO-LOCK:
            CREATE tt-ordens-totais-incoterm.
            ASSIGN tt-ordens-totais-incoterm.cod-incoterm = inco-cx.cod-incoterm.
        END.

    RUN geraRateiodespesas. 
    
END PROCEDURE.

PROCEDURE rateioEmbarque:
/*------------------------------------------------------------------------------
  Purpose: Rateia Despesas para Despesas do Embarque
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER p-cod-estabel  LIKE estabelec.cod-estabel   NO-UNDO.    
    DEFINE INPUT  PARAMETER p-embarque     LIKE embarque-imp.embarque   NO-UNDO.
    DEFINE INPUT  PARAMETER p-nat-operacao LIKE natur-oper.nat-operacao NO-UNDO.    
    DEFINE OUTPUT PARAMETER TABLE FOR tt-desp-rateio.

    ASSIGN l-nacionalizacao = YES
           c-nat-operacao   = p-nat-operacao.
    
    FIND FIRST natur-oper
         WHERE natur-oper.nat-operacao = p-nat-operacao NO-LOCK NO-ERROR.
    IF NOT AVAIL natur-oper THEN DO:

        ASSIGN i-seq-erro = i-seq-erro + 1.
        {utp/ut-table.i mgind natur-oper 1}
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + p-nat-operacao.

        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    
    ASSIGN i-trib-ii-nat = INTEGER(SUBSTRING(natur-oper.char-1,10,2)).

    IF i-pais-impto-usuario = 2 THEN DO:
        /*Leitura da extens∆o da tabela de natureza de operaá∆o do internacional*/
        FOR FIRST natur-operac-internac NO-LOCK
            WHERE natur-operac-internac.cod-natur-operac = natur-oper.nat-operacao:
            ASSIGN i-trib-taxa-est = natur-operac-internac.idi-trib-tax-estatis.
        END.
    END.

    ASSIGN l-todas-despesas = NO.
    
    RUN rateioEmbarque-Acompanhamento (INPUT p-cod-estabel, INPUT p-embarque).    
                                       
END PROCEDURE.

PROCEDURE rateioAcompanhamento:
/*------------------------------------------------------------------------------
  Purpose: Cria Temp-table de rateio das despesas do acompanhamento.
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER p-cod-estabel LIKE estabelec.cod-estabel NO-UNDO.
    DEFINE INPUT  PARAMETER p-embarque    LIKE embarque-imp.embarque NO-UNDO.
    DEFINE OUTPUT PARAMETER TABLE FOR tt-desp-rateio.
    
    ASSIGN i-trib-ii-nat    = 1
           l-todas-despesas = YES.

    RUN rateioEmbarque-Acompanhamento (INPUT p-cod-estabel, INPUT p-embarque).

END PROCEDURE.

procedure rateioEmbarque-Acompanhamento:
/*------------------------------------------------------------------------------
  Purpose: Rateio principal para as procedures rateioEmbarque-Acompanhamento
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER p-cod-estabel LIKE estabelec.cod-estabel NO-UNDO.
    DEFINE INPUT PARAMETER p-embarque    LIKE embarque-imp.embarque NO-UNDO.
    
    DEFINE VARIABLE i-cod-itiner LIKE itinerario.cod-itiner NO-UNDO.

    ASSIGN l-desembarque     = YES 
           c-cod-estabel-aux = p-cod-estabel
           c-embarque-aux    = p-embarque.

    FIND FIRST embarque-imp
         WHERE embarque-imp.cod-estabel = p-cod-estabel
           AND embarque-imp.embarque    = p-embarque NO-LOCK NO-ERROR.
    
    IF NOT AVAIL embarque-imp THEN DO:
        
        ASSIGN i-seq-erro = i-seq-erro + 1.
        {utp/ut-table.i mgcex embarque-imp 1}
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = return-value + "~~":U + p-embarque.

        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    
    FIND FIRST historico-embarque
         WHERE historico-embarque.cod-estabel = embarque-imp.cod-estabel
           AND historico-embarque.embarque    = embarque-imp.embarque NO-LOCK NO-ERROR.
          
    IF NOT AVAIL historico-embarque THEN DO:

        ASSIGN i-seq-erro = i-seq-erro + 1.
        {utp/ut-table.i mgcex historico-embarque 1}
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + embarque-imp.embarque.
        
        run utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    
    FIND FIRST itinerario
         WHERE itinerario.cod-itiner = historico-embarque.cod-itiner NO-LOCK NO-ERROR.
        
    IF NOT AVAIL itinerario THEN DO:

        ASSIGN i-seq-erro = i-seq-erro + 1.
        {utp/ut-table.i mgcex itinerario 1}
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + STRING(historico-embarque.cod-itiner).
        
        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    
    ASSIGN i-cod-itiner = historico-embarque.cod-itiner.
        
    FIND FIRST historico-embarque
         WHERE historico-embarque.cod-estabel   = embarque-imp.cod-estabel
           AND historico-embarque.embarque      = embarque-imp.embarque
           AND historico-embarque.cod-itiner    = i-cod-itiner
           AND historico-embarque.cod-pto-contr = embarque-imp.cdn-pto-desembar NO-LOCK NO-ERROR.
        
    CREATE tt-itiner-emb.
    ASSIGN tt-itiner-emb.cod-itiner        = historico-embarque.cod-itiner
           tt-itiner-emb.i-pto-desembarque = historico-embarque.cod-pto-contr
           tt-itiner-emb.i-seq-pto-desemb  = historico-embarque.sequencia.
    
    FOR EACH ordens-embarque
       WHERE ordens-embarque.cod-estabel = embarque-imp.cod-estabel
         AND ordens-embarque.embarque    = embarque-imp.embarque NO-LOCK:

        RUN geraOrdenstotais (INPUT ordens-embarque.numero-ordem,
                              INPUT ordens-embarque.parcela,
                              INPUT ?,
                              INPUT ?,
                              INPUT ?,
                              INPUT ordens-embarque.quantidade,
                              INPUT ordens-embarque.qt-do-forn).
    END.

    IF l-gera-prim-nf-remes-mae THEN DO:
        
        FOR EACH tt-embarque-oc
           WHERE NOT tt-embarque-oc.l-gera-prim-nf-remes-mae: /*desconsidera as ordens de compra da nota m∆e*/
            
            FIND FIRST ordens-embarque
                 WHERE ordens-embarque.numero-ordem = tt-embarque-oc.numero-ordem
                   AND ordens-embarque.parcela      = tt-embarque-oc.parcela NO-LOCK NO-ERROR.

            IF AVAIL ordens-embarque THEN DO:
                
                RUN geraOrdenstotais (INPUT ordens-embarque.numero-ordem,
                                      INPUT ordens-embarque.parcela,
                                      INPUT ?,
                                      INPUT ?,
                                      INPUT ?,
                                      INPUT ordens-embarque.quantidade,
                                      INPUT ordens-embarque.qt-do-forn).
            END.
        END.
    END.

    ASSIGN l-existe-incoterm = CAN-FIND(FIRST desp-embarque 
                                        WHERE desp-embarque.cod-estabel = embarque-imp.cod-estabel
                                          AND desp-embarque.embarque    = embarque-imp.embarque
                                          AND desp-embarque.cod-incoterm-rat <> "").

    EMPTY TEMP-TABLE tt-desp-totais-incoterm.

    IF l-existe-incoterm THEN
        FOR EACH inco-cx NO-LOCK:
            CREATE tt-desp-totais-incoterm.
            ASSIGN tt-desp-totais-incoterm.cod-incoterm = inco-cx.cod-incoterm.
        END.
        

    RUN pigeraDespesasAux (INPUT embarque-imp.cod-estabel,
                           INPUT embarque-imp.embarque,
                           INPUT embarque-imp.cod-estabel,
                           INPUT embarque-imp.embarque,
                           INPUT i-cod-itiner).
      
    IF l-gera-prim-nf-remes-mae THEN DO:

        FOR EACH tt-embarque-filho-aux:
            
            RUN pigeraDespesasAux (INPUT embarque-imp.cod-estabel,
                                   INPUT embarque-imp.embarque,
                                   INPUT tt-embarque-filho-aux.cod-estabel,
                                   INPUT tt-embarque-filho-aux.embarque,
                                   INPUT i-cod-itiner).
        END.
    END.
    
    FOR EACH tt-desp-embarque-aux:

        RUN geraOrdensdespesa (INPUT tt-desp-embarque-aux.cod-desp,
                               INPUT p-embarque,
                               INPUT i-cod-itiner,
                               INPUT tt-desp-embarque-aux.de-val-desp,
                               INPUT tt-desp-embarque-aux.val-desp,
                               INPUT 0,
                               INPUT 0,
                               INPUT YES,
                               INPUT tt-desp-embarque-aux.cod-emitente-desp,
                               INPUT tt-desp-embarque-aux.cod-cond-pag,
                               INPUT tt-desp-embarque-aux.mo-codigo,
                               INPUT tt-desp-embarque-aux.cod-pto-contr,
                               INPUT tt-desp-embarque-aux.cod-incoterm-rat,
                               INPUT l-existe-incoterm).
    END.
    
    RUN ordenaTtOrdensDesp.

    EMPTY TEMP-TABLE tt-ordens-totais-incoterm.

    IF l-existe-incoterm THEN
        FOR EACH inco-cx NO-LOCK:
            CREATE tt-ordens-totais-incoterm.
            ASSIGN tt-ordens-totais-incoterm.cod-incoterm = inco-cx.cod-incoterm.
        END.

    RUN geraRateiodespesas.
    
    RETURN "OK":U.
END PROCEDURE.

PROCEDURE rateioDocumento:
/*------------------------------------------------------------------------------
  Purpose: Rateia despesas complementares de um documento jˇ atualizado
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER p-cod-estabel        LIKE estabelec.cod-estabel  NO-UNDO.
    DEFINE INPUT  PARAMETER p-cod-estabel-aux    LIKE estabelec.cod-estabel  NO-UNDO.
    DEFINE INPUT  PARAMETER p-embarque           LIKE embarque-imp.embarque  NO-UNDO.
    DEFINE INPUT  PARAMETER p-serie-docto        LIKE docum-est.serie-docto  NO-UNDO.
    DEFINE INPUT  PARAMETER p-nro-docto          LIKE docum-est.nro-docto    NO-UNDO.
    DEFINE INPUT  PARAMETER p-cod-emitente       LIKE docum-est.cod-emitente NO-UNDO.
    DEFINE INPUT  PARAMETER p-nat-operacao       LIKE docum-est.nat-operacao NO-UNDO.
    DEFINE INPUT  PARAMETER p-cod-emitente-desp  LIKE emitente.cod-emitente  NO-UNDO.
    DEFINE INPUT  PARAMETER p-agrupar-unico-forn AS   LOGICAL                NO-UNDO.
    DEFINE OUTPUT PARAMETER TABLE FOR tt-desp-rateio.
    
    DEFINE VARIABLE i-cod-itiner                    LIKE itinerario.cod-itiner     NO-UNDO.
    DEFINE VARIABLE de-val-desp                     LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE VARIABLE de-val-desp-recebida            LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE VARIABLE de-val-desp-recebida-aux        LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE VARIABLE de-saldo-val-desp               LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE VARIABLE de-val-desp-isento              LIKE cotacao-item-cex.val-desp NO-UNDO. 
    DEFINE VARIABLE de-saldo-val-desp-isento        LIKE cotacao-item-cex.val-desp NO-UNDO. 
    DEFINE VARIABLE de-val-desp-recebida-isento     LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE VARIABLE de-val-desp-recebida-isento-aux LIKE cotacao-item-cex.val-desp NO-UNDO.
    
    ASSIGN c-cod-estabel-aux = p-cod-estabel-aux
           c-embarque-aux    = p-embarque.
           
    ASSIGN l-desembarque  = YES
           l-documento    = YES
           i-trib-ii-nat  = 2
           c-serie-docto  = p-serie-docto
           c-nro-docto    = p-nro-docto
           i-cod-emitente = p-cod-emitente
           c-nat-operacao = p-nat-operacao.

    FIND FIRST embarque-imp
         WHERE embarque-imp.cod-estabel = p-cod-estabel-aux
           AND embarque-imp.embarque    = p-embarque NO-LOCK NO-ERROR.

    IF NOT AVAIL embarque-imp THEN DO:

        ASSIGN i-seq-erro = i-seq-erro + 1.
        {utp/ut-table.i mgcex embarque-imp 1}
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + p-embarque.

        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    
    FIND FIRST historico-embarque
         WHERE historico-embarque.cod-estabel = embarque-imp.cod-estabel
           AND historico-embarque.embarque    = embarque-imp.embarque NO-LOCK NO-ERROR.
    IF NOT AVAIL historico-embarque THEN DO:

        ASSIGN i-seq-erro = i-seq-erro + 1.
        {utp/ut-table.i mgcex historico-embarque 1}
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + embarque-imp.embarque.

        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    
    FIND FIRST itinerario
         WHERE itinerario.cod-itiner = historico-embarque.cod-itiner NO-LOCK NO-ERROR.
    IF NOT AVAIL itinerario THEN DO:

        ASSIGN i-seq-erro = i-seq-erro + 1.
        {utp/ut-table.i mgcex itinerario 1}
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~" + STRING(historico-embarque.cod-itiner).
        
        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    
    ASSIGN i-cod-itiner = historico-embarque.cod-itiner.
        
    FIND FIRST historico-embarque
         WHERE historico-embarque.cod-estabel   = embarque-imp.cod-estabel
           AND historico-embarque.embarque      = embarque-imp.embarque
           AND historico-embarque.cod-itiner    = i-cod-itiner
           AND historico-embarque.cod-pto-contr = embarque-imp.cdn-pto-desembar NO-LOCK NO-ERROR.
        
    CREATE tt-itiner-emb.
    ASSIGN tt-itiner-emb.cod-itiner        = historico-embarque.cod-itiner
           tt-itiner-emb.i-pto-desembarque = historico-embarque.cod-pto-contr
           tt-itiner-emb.i-seq-pto-desemb  = historico-embarque.sequencia.
    
    IF i-pais-impto-usuario <> 1 THEN DO: /* para quando executado via im0301a.p (nota de rateio do internacional)*/
       
        FIND FIRST b-docum-est NO-LOCK
             WHERE b-docum-est.serie-docto  = c-serie-docto
               AND b-docum-est.nro-docto    = c-nro-docto
               AND b-docum-est.cod-emitente = i-cod-emitente
               AND b-docum-est.nat-operacao = c-nat-operacao NO-ERROR.

        IF b-docum-est.idi-nf-simples-remes = 1 /* nota m∆e */ then do:
        
                FOR EACH item-doc-est
                  WHERE item-doc-est.serie-docto  = c-serie-docto
                    AND item-doc-est.nro-docto    = c-nro-docto
                    AND item-doc-est.cod-emitente = i-cod-emitente
                    AND item-doc-est.nat-operacao = c-nat-operacao NO-LOCK:
                    
                    /* achar a ordens embarque correspondente para pegar a qtd ainda n∆o nacionalizadas */                    
                    FOR FIRST ordens-embarque NO-LOCK
                        WHERE ordens-embarque.cod-estabel  = embarque-imp.cod-estabel 
                          AND ordens-embarque.embarque     = embarque-imp.embarque 
                          and ordens-embarque.numero-ordem = item-doc-est.num-ord-import
                          AND ordens-embarque.parcela      = item-doc-est.num-parc-import:
                    
                    RUN geraOrdenstotais (INPUT ordens-embarque.numero-ordem,
                                          INPUT ordens-embarque.parcela,
                                          INPUT ?,
                                          INPUT ?,
                                          INPUT ?,
                                          INPUT ordens-embarque.quantidade,
                                          INPUT ordens-embarque.qt-do-forn).
                    end.
                END.
        END.
        else do:

                FOR EACH item-doc-est
                  WHERE item-doc-est.serie-docto  = c-serie-docto
                    AND item-doc-est.nro-docto    = c-nro-docto
                    AND item-doc-est.cod-emitente = i-cod-emitente
                    AND item-doc-est.nat-operacao = c-nat-operacao NO-LOCK:
                    
                    RUN geraOrdenstotais (INPUT item-doc-est.numero-ordem,
                                          INPUT item-doc-est.parcela,
                                          INPUT ?,
                                          INPUT ?,
                                          INPUT ?,
                                          INPUT item-doc-est.quantidade,
                                          INPUT item-doc-est.qt-do-forn).
                END.
        end.
    END.
    ELSE DO: /*Se nota de remessa m„e E gera primeira remessa */

        FIND FIRST b-docum-est NO-LOCK
             WHERE b-docum-est.serie-docto  = c-serie-docto
               AND b-docum-est.nro-docto    = c-nro-docto
               AND b-docum-est.cod-emitente = i-cod-emitente
               AND b-docum-est.nat-operacao = c-nat-operacao NO-ERROR.

        IF b-docum-est.idi-nf-simples-remes = 1 AND SUBSTRING(b-docum-est.char-1,209,1) = "S":U THEN DO:

            FOR EACH item-doc-est
               WHERE item-doc-est.serie-docto  = b-docum-est.serie-docto 
                 AND item-doc-est.nro-docto    = b-docum-est.nro-docto   
                 AND item-doc-est.cod-emitente = b-docum-est.cod-emitente
                 AND item-doc-est.nat-operacao = b-docum-est.nat-operacao NO-LOCK:
                
                IF TRIM(SUBSTRING(item-doc-est.char-2,940,1)) <> "S":U  THEN NEXT.
        
                RUN geraOrdenstotais (INPUT item-doc-est.numero-ordem,
                                      INPUT item-doc-est.parcela,
                                      INPUT ?,
                                      INPUT ?,
                                      INPUT ?,
                                      INPUT item-doc-est.quantidade,
                                      INPUT item-doc-est.qt-do-forn).
              
             END.
        END.
        ELSE DO:
            
            FOR EACH item-doc-est
               WHERE item-doc-est.serie-docto  = c-serie-docto
                 AND item-doc-est.nro-docto    = c-nro-docto
                 AND item-doc-est.cod-emitente = i-cod-emitente
                 AND item-doc-est.nat-operacao = c-nat-operacao NO-LOCK:

                RUN geraOrdenstotais (INPUT item-doc-est.numero-ordem,
                                      INPUT item-doc-est.parcela,
                                      INPUT ?,
                                      INPUT ?,
                                      INPUT ?,
                                      INPUT item-doc-est.quantidade,
                                      INPUT item-doc-est.qt-do-forn).
            END.
        END.
    END.

    ASSIGN l-existe-incoterm = CAN-FIND(FIRST desp-embarque 
                                        WHERE desp-embarque.cod-estabel = embarque-imp.cod-estabel
                                          AND desp-embarque.embarque    = embarque-imp.embarque
                                          AND desp-embarque.cod-incoterm-rat <> "").
  
    EMPTY TEMP-TABLE tt-desp-totais-incoterm.
    
    IF l-existe-incoterm THEN
        FOR EACH inco-cx NO-LOCK:
            CREATE tt-desp-totais-incoterm.
            ASSIGN tt-desp-totais-incoterm.cod-incoterm = inco-cx.cod-incoterm.
        END.

    /** Calcula valor das despesas **/
    FOR EACH tt-selecao-despesa
       WHERE tt-selecao-despesa.cod-estabel = embarque-imp.cod-estabel
         AND tt-selecao-despesa.embarque    = embarque-imp.embarque:
        
        FIND FIRST desp-embarque 
             WHERE desp-embarque.cod-estabel       = tt-selecao-despesa.cod-estabel
               AND desp-embarque.embarque          = tt-selecao-despesa.embarque 
               AND desp-embarque.cod-itiner        = tt-selecao-despesa.cod-itiner 
               AND desp-embarque.cod-pto-contr     = tt-selecao-despesa.cod-pto-contr 
               AND desp-embarque.cod-desp          = tt-selecao-despesa.cod-desp
               AND desp-embarque.cod-emitente-desp = tt-selecao-despesa.cod-emitente-desp NO-LOCK NO-ERROR.
    
        /** Despesa ja recebida **/
        IF desp-embarque.log-despes-ja-recbda THEN
            NEXT.

        FIND FIRST despes-embarq-internac 
             WHERE despes-embarq-internac.cod-estabel       = desp-embarque.cod-estabel
               AND despes-embarq-internac.embarque          = desp-embarque.embarque
               AND despes-embarq-internac.cod-itiner        = desp-embarque.cod-itiner
               AND despes-embarq-internac.cod-pto-contr     = desp-embarque.cod-pto-contr
               AND despes-embarq-internac.cod-desp          = desp-embarque.cod-desp
               AND despes-embarq-internac.cod-emitente-desp = desp-embarque.cod-emitente-desp NO-LOCK NO-ERROR.

        /** Validacoes das despesas **/
        {imp/im0091.i2}

        ASSIGN de-val-desp-recebida        = 0
               de-val-desp-recebida-isento = 0.
        
        FOR EACH item-doc-est-cex
           WHERE item-doc-est-cex.cod-estabel = desp-embarque.cod-estabel
             AND item-doc-est-cex.embarque    = desp-embarque.embarque
             AND item-doc-est-cex.cod-desp    = desp-embarque.cod-desp NO-LOCK:
            
            IF i-pais-impto-usuario = 9 /* Paraguai */ THEN DO:
                
                FIND FIRST item-doc-est-cex-internac OF item-doc-est-cex NO-LOCK NO-ERROR.

                IF AVAIL item-doc-est-cex-internac THEN DO:
                    
                    RUN cdp/cd0812.p (INPUT  item-doc-est-cex.mo-codigo,
                                      INPUT  desp-embarque.mo-codigo,
                                      INPUT  item-doc-est-cex-internac.val-preco-unit,
                                      INPUT  item-doc-est-cex.dat-cotac,
                                      OUTPUT de-val-desp-recebida-aux).

                    ASSIGN de-val-desp-recebida = de-val-desp-recebida + de-val-desp-recebida-aux.                     

                    RUN cdp/cd0812.p (INPUT  item-doc-est-cex.mo-codigo,
                                      INPUT  desp-embarque.mo-codigo,
                                      INPUT  item-doc-est-cex-internac.val-preco-unit-isento,
                                      INPUT  item-doc-est-cex.dat-cotac,
                                      OUTPUT de-val-desp-recebida-isento-aux).

                    ASSIGN de-val-desp-recebida-isento = de-val-desp-recebida-isento + de-val-desp-recebida-isento-aux.                        
                END.
            END.
            ELSE DO:
                
                RUN cdp/cd0812.p (INPUT  item-doc-est-cex.mo-codigo,
                                  INPUT  desp-embarque.mo-codigo,
                                  INPUT  item-doc-est-cex.val-desp,
                                  INPUT  item-doc-est-cex.dat-cotac,
                                  OUTPUT de-val-desp-recebida-aux).

                ASSIGN de-val-desp-recebida = de-val-desp-recebida + de-val-desp-recebida-aux.
            END.
        END.
                           
        IF i-pais-impto-usuario = 9 /* Paraguai */ AND AVAIL despes-embarq-internac THEN
            ASSIGN de-saldo-val-desp        = despes-embarq-internac.val-preco-unit - de-val-desp-recebida /** saldo **/
                   de-val-desp              = de-saldo-val-desp
                   de-saldo-val-desp-isento = despes-embarq-internac.val-preco-unit-isento - de-val-desp-recebida-isento /** saldo **/
                   de-val-desp-isento       = de-saldo-val-desp-isento.
        ELSE
            ASSIGN de-saldo-val-desp  = desp-embarque.val-desp - de-val-desp-recebida /** saldo **/
                   de-val-desp        = de-saldo-val-desp
                   de-val-desp-isento = 0.
               
        IF (de-saldo-val-desp + de-val-desp-isento) <= 0 THEN DO:
            
            FIND FIRST item-doc-est-cex
                 WHERE item-doc-est-cex.cod-estabel = desp-embarque.cod-estabel
                   AND item-doc-est-cex.embarque    = desp-embarque.embarque   
                   AND item-doc-est-cex.cod-desp    = desp-embarque.cod-desp NO-LOCK NO-ERROR.
            
            IF AVAIL item-doc-est-cex THEN DO:

                ASSIGN i-seq-erro = i-seq-erro + 1.
                CREATE tt-bo-erro.
                ASSIGN tt-bo-erro.parametros = STRING(item-doc-est-cex.cod-desp)          + "~~":U + 
                                               STRING(item-doc-est-cex.nro-docto)         + "~~":U + 
                                               STRING(item-doc-est-cex.serie-docto)       + "~~":U +
                                               STRING(item-doc-est-cex.cod-emitente)      + "~~":U +
                                               STRING(item-doc-est-cex.nat-operacao)      + "~~":U +
                                               STRING(item-doc-est-cex.cod-emitente-desp) + "~~":U +
                                               STRING(item-doc-est-cex.cod-desp).

                RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 31619, INPUT tt-bo-erro.parametros).

                ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 31619
                       tt-bo-erro.mensagem = RETURN-VALUE.
                UNDO, LEAVE.
            END.
        END.
        
        IF desp-embarque.mo-codigo <> 0 THEN DO:

            if d-cotacao = 0 then
                RUN cdp/cd0812.p (INPUT  desp-embarque.mo-codigo,
                                  INPUT  0,
                                  INPUT  de-saldo-val-desp,
                                  INPUT  da-data-cotacao,
                                  OUTPUT de-val-desp).
            else
                RUN cdp/cd0812a.p (INPUT  desp-embarque.mo-codigo,
                                   INPUT  0,
                                   INPUT  de-saldo-val-desp,
                                   INPUT  d-cotacao,
                                   OUTPUT de-val-desp).
                
            IF i-pais-impto-usuario = 9 /* Paraguai */ THEN do:
                if d-cotacao = 0 then
                    RUN cdp/cd0812.p (INPUT  desp-embarque.mo-codigo,
                                      INPUT  0,
                                      INPUT  de-saldo-val-desp-isento,
                                      INPUT  da-data-cotacao,
                                      OUTPUT de-val-desp-isento).
                else
                    RUN cdp/cd0812a.p (INPUT  desp-embarque.mo-codigo,
                                       INPUT  0,
                                       INPUT  de-saldo-val-desp-isento,
                                       INPUT  d-cotacao,
                                       OUTPUT de-val-desp-isento).                
            end.                      
        END.

        IF PROGRAM-NAME(5) = "pi-executar imp/im0101.w":U THEN DO:
            /*Include i-epc200.i2: Criacao de registro para temp-table tt-epc */
            {include/i-epc200.i2 &CodEvent='"ConverteDespesaComplementar"'
                                 &CodParameter='"cod-estabel"'
                                 &ValueParameter="string(desp-embarque.cod-estabel)"}
            {include/i-epc200.i2 &CodEvent='"ConverteDespesaComplementar"'
                                 &CodParameter='"embarque"'
                                 &ValueParameter="string(desp-embarque.embarque)"}
            {include/i-epc200.i2 &CodEvent='"ConverteDespesaComplementar"'
                                 &CodParameter='"cod-desp"'
                                 &ValueParameter="string(desp-embarque.cod-desp)"}
            {include/i-epc200.i2 &CodEvent='"ConverteDespesaComplementar"'
                                 &CodParameter='"moeda"'
                                 &ValueParameter="string(desp-embarque.mo-codigo)"}
            {include/i-epc200.i2 &CodEvent='"ConverteDespesaComplementar"'
                                 &CodParameter='"val-desp"'
                                 &ValueParameter="string(desp-embarque.val-desp)"}
            
            /*Include i-epc201.i: Chamada do programa de EPC */
            {include/i-epc201.i "ConverteDespesaComplementar"}
        END.
        
        IF c-nom-prog-dpc-mg97  <> "" 
        OR c-nom-prog-appc-mg97 <> ""
        OR c-nom-prog-upc-mg97  <> "" THEN DO:
            
            FIND FIRST tt-epc
                 WHERE tt-epc.cod-event     = "ConverteDespesaComplementar":U
                   AND tt-epc.cod-parameter = "val-desp-conv":U NO-ERROR.
            
            IF AVAIL tt-epc THEN
                ASSIGN de-val-desp = DEC(tt-epc.val-parameter).
        
            EMPTY TEMP-TABLE tt-epc.
        END.

        RUN geraOrdensdespesa (INPUT desp-embarque.cod-desp,
                               INPUT p-embarque,
                               INPUT i-cod-itiner,
                               INPUT de-val-desp,
                               INPUT de-saldo-val-desp,
                               INPUT de-val-desp-isento,
                               INPUT de-saldo-val-desp-isento,
                               INPUT YES,
                               INPUT desp-embarque.cod-emitente-desp,
                               INPUT desp-embarque.cod-cond-pag,
                               INPUT desp-embarque.mo-codigo,
                               INPUT desp-embarque.cod-pto-contr,
                               INPUT desp-embarque.cod-incoterm-rat,
                               INPUT l-existe-incoterm).
    END.
   
    RUN ordenaTtOrdensDesp.
    
    EMPTY TEMP-TABLE tt-ordens-totais-incoterm.

    IF l-existe-incoterm THEN
        FOR EACH inco-cx NO-LOCK:
            CREATE tt-ordens-totais-incoterm.
            ASSIGN tt-ordens-totais-incoterm.cod-incoterm = inco-cx.cod-incoterm.
        END.

    RUN geraRateiodespesas.

END PROCEDURE.

PROCEDURE rateioDespesasPedido:
/*------------------------------------------------------------------------------
  Purpose: 
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER pi-num-pedido LIKE pedido-compr.num-pedido NO-UNDO.
    DEFINE INPUT  PARAMETER TABLE FOR tt-ordem-compra.
    DEFINE INPUT  PARAMETER TABLE FOR tt-despesas.
    DEFINE OUTPUT PARAMETER TABLE FOR tt-desp-rateio.

    DEFINE VARIABLE de-val-desp-conv LIKE tt-despesas.val-desp NO-UNDO.
    
    ASSIGN l-grupodeordens = YES.

    FOR EACH tt-ordem-compra,
       FIRST ordem-compra FIELDS(numero-ordem it-codigo)
       WHERE ordem-compra.numero-ordem = tt-ordem-compra.numero-ordem NO-LOCK,
       FIRST cotacao-item
       WHERE cotacao-item.numero-ordem = ordem-compra.numero-ordem
         AND cotacao-item.it-codigo    = ordem-compra.it-codigo
         AND cotacao-item.cot-aprovada = YES NO-LOCK,
       EACH prazo-compra
       WHERE prazo-compra.numero-ordem = ordem-compra.numero-ordem
         AND prazo-compra.situacao <> 4 /* eliminada */ NO-LOCK:

        RUN geraOrdenstotais (INPUT tt-ordem-compra.numero-ordem,
                              INPUT prazo-compra.parcela,
                              INPUT cotacao-item.cod-emitente,
                              INPUT cotacao-item.data-cotacao,
                              INPUT cotacao-item.seq-cotac,
                              INPUT prazo-compra.quantidade,
                              INPUT prazo-compra.qtd-do-forn).
    END.

    IF pi-num-pedido <> 0 THEN
        FIND FIRST processo-imp 
             WHERE processo-imp.num-pedido = pi-num-pedido NO-LOCK NO-ERROR.

    ASSIGN l-existe-incoterm = CAN-FIND(FIRST tt-despesas 
                                        WHERE tt-despesas.cod-incoterm-rat <> "").

    EMPTY TEMP-TABLE tt-desp-totais-incoterm.

    IF l-existe-incoterm THEN
        FOR EACH inco-cx NO-LOCK:
            CREATE tt-desp-totais-incoterm.
            ASSIGN tt-desp-totais-incoterm.cod-incoterm = inco-cx.cod-incoterm.
        END.

    FOR EACH tt-despesas:
        
        IF tt-despesas.mo-codigo <> 0 THEN
            RUN cdp/cd0812.p (INPUT tt-despesas.mo-codigo,
                              INPUT 0,
                              INPUT tt-despesas.val-desp,
                              INPUT TODAY,
                              OUTPUT de-val-desp-conv).
        ELSE
            ASSIGN de-val-desp-conv = tt-despesas.val-desp.

        RUN geraOrdensdespesa (INPUT tt-despesas.cod-desp,
                               INPUT "",
                               INPUT IF pi-num-pedido <> 0 AND AVAIL processo-imp THEN processo-imp.cod-itiner ELSE 0,
                               INPUT de-val-desp-conv,
                               INPUT tt-despesas.val-desp,
                               INPUT 0,
                               INPUT 0,
                               INPUT NO,
                               INPUT tt-despesas.cod-emitente-desp,
                               INPUT tt-despesas.cod-cond-pag,
                               INPUT tt-despesas.mo-codigo,
                               INPUT tt-despesas.cod-pto-contr,
                               INPUT tt-despesas.cod-incoterm-rat,
                               INPUT l-existe-incoterm).
    END.

    RUN ordenaTtOrdensDesp.

    EMPTY TEMP-TABLE tt-ordens-totais-incoterm.

    IF l-existe-incoterm THEN
        FOR EACH inco-cx NO-LOCK:
            CREATE tt-ordens-totais-incoterm.
            ASSIGN tt-ordens-totais-incoterm.cod-incoterm = inco-cx.cod-incoterm.
        END.

    RUN geraRateiodespesas.

    RETURN "OK":U.
END PROCEDURE.

PROCEDURE geraRateiodespesas:
/*------------------------------------------------------------------------------
  Purpose: Gera valores rateados para as despesas
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE VARIABLE l-create-desp-rateio       AS LOGICAL                     NO-UNDO.
    DEFINE VARIABLE l-desp-valor-fixo          AS LOGICAL                     NO-UNDO.
    DEFINE VARIABLE de-valor-rateado           LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE VARIABLE de-valor-rateado-mo        LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE VARIABLE de-valor-rateado-isento    LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE VARIABLE de-valor-rateado-isento-mo LIKE cotacao-item-cex.val-desp NO-UNDO.
    
    def var l-comp as log no-undo.

    ASSIGN de-tot-siscomex-cif    = 0
           de-tot-siscomex-cif-mo = 0.

    EMPTY TEMP-TABLE tt-desp-cif.
    EMPTY TEMP-TABLE tt-ordens-desp-aux.

    FOR EACH tt-ordens-desp BY tt-ordens-desp.sequencia:
        
        ASSIGN de-val-desp           = 0
               de-val-desp-mo        = 0
               de-val-desp-isento    = 0
               de-val-desp-isento-mo = 0
               l-create-desp-rateio  = YES
               l-desp-valor-fixo     = NO.

        FIND FIRST tt-ordens-totais 
             WHERE tt-ordens-totais.numero-ordem = tt-ordens-desp.numero-ordem
               AND tt-ordens-totais.parcela      = tt-ordens-desp.parcela NO-ERROR.

        FIND FIRST param-imp
             WHERE param-imp.cod-estabel = tt-ordens-desp.cod-estabel NO-LOCK NO-ERROR.

        FIND FIRST param-imp-trib
             WHERE param-imp-trib.cod-estabel = tt-ordens-desp.cod-estabel NO-LOCK NO-ERROR.
             
        IF NOT AVAIL param-imp THEN DO:

            ASSIGN i-seq-erro = i-seq-erro + 1.
            {utp/ut-table.i mgcex param-imp 1}
            CREATE tt-bo-erro.
            ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + STRING(tt-ordens-desp.cod-estabel).
            
            RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
            ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = RETURN-VALUE.
            UNDO, LEAVE.
        END.
        
        RUN piBuscaNumAdicao (INPUT  tt-ordens-desp.numero-ordem,
                              INPUT  tt-ordens-desp.parcela,
                              INPUT  tt-ordens-desp.cod-desp,
                              OUTPUT i-num-adicao).

        FIND FIRST tt-desp-totais
             WHERE tt-desp-totais.cod-desp   = tt-ordens-desp.cod-desp
               AND tt-desp-totais.num-adic   = i-num-adicao NO-ERROR.
        
        IF NOT AVAIL tt-desp-totais THEN
            NEXT.

        FIND FIRST desp-imp
             WHERE desp-imp.cod-desp = tt-ordens-desp.cod-desp NO-LOCK NO-ERROR.
        
        FIND FIRST desp-imp-trib
             WHERE desp-imp-trib.cod-desp = tt-ordens-desp.cod-desp NO-LOCK NO-ERROR.
             
        IF NOT AVAIL desp-imp THEN DO:

            ASSIGN i-seq-erro = i-seq-erro + 1.
            {utp/ut-table.i mgcex desp-imp 1}
            CREATE tt-bo-erro.
            ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + STRING(tt-ordens-desp.cod-desp).
            
            RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
            ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = RETURN-VALUE.
            UNDO, LEAVE.
        END.       


        FIND FIRST tt-ordens-desp-cot
             WHERE tt-ordens-desp-cot.numero-ordem = tt-ordens-desp.numero-ordem
               AND tt-ordens-desp-cot.parcela      = tt-ordens-desp.parcela
               AND tt-ordens-desp-cot.cod-desp     = tt-ordens-desp.cod-desp NO-ERROR.
        
        IF AVAIL tt-ordens-desp-cot THEN DO:

            ASSIGN de-val-desp    = (tt-ordens-desp-cot.val-desp * tt-desp-totais.val-desp)
                                  / tt-desp-totais.val-desp-cot
                   de-val-desp-mo = (tt-ordens-desp-cot.val-desp-mo * tt-desp-totais.val-desp-mo)
                                  / tt-desp-totais.val-desp-cot-mo.
        END.
        ELSE
            /* Imposto Importaªío */
            IF desp-imp.cod-desp = i-cod-desp-ii THEN DO:

                IF l-cod-desp-ii THEN DO: /*Verificar se o imposto de importaªío foi informado no acompanhamento de embarque(im0055)*/
                     ASSIGN de-val-desp    = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp)
                                             / tt-desp-totais.preco-total
                            de-val-desp-mo = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp-mo)
                                             / tt-desp-totais.preco-total. 
                                             
                     IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                         ASSIGN de-val-desp-isento    = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp-isento)
                                                        / tt-desp-totais.preco-total
                                de-val-desp-isento-mo = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp-isento-mo)
                                                        / tt-desp-totais.preco-total.
                END.
                ELSE DO:
                     RUN geraDespII.
                     ASSIGN l-create-desp-rateio = NO.
                END.
            END.
            ELSE IF  i-pais-impto-usuario = 2 AND (desp-imp.cod-desp = i-cod-desp-est)  AND l-nacionalizacao THEN DO:

                 IF l-cod-desp-est THEN /*Verificar se a taxa de estat°stica foi informada no acompanhamento de embarque(im0055)*/
                     ASSIGN de-val-desp    = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp)
                                             / tt-desp-totais.preco-total
                            de-val-desp-mo = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp-mo)
                                             / tt-desp-totais.preco-total.
                 ELSE DO:
                     RUN geraTaxaEstatistica.
                     ASSIGN l-create-desp-rateio = NO.
                 END.
            END. 
            ELSE IF desp-imp.cod-desp = param-imp.cdn-despes-impto-ipi
                 OR desp-imp.cod-desp = param-imp.cdn-despes-impto-icms THEN DO: 
                 
                IF l-cod-desp-ipi OR l-cod-desp-icms THEN /*Verificar se o IPI ou ICMS foi informado no acompanhamento de embarque(im0055)*/
                     ASSIGN de-val-desp    = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp)
                                             / tt-desp-totais.preco-total
                            de-val-desp-mo = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp-mo)
                                             / tt-desp-totais.preco-total.
                 ELSE IF NOT l-desembarque THEN DO:
                     RUN geraDespIpiIcms.
                     ASSIGN l-create-desp-rateio = NO.
                 END.     
            END.
            ELSE IF desp-imp.cod-desp = param-imp.cdn-despes-impto-cofins
                 OR desp-imp.cod-desp = param-imp.cdn-despes-impto-pis THEN DO:
                 
                 IF l-cod-desp-pis OR l-cod-desp-cofins THEN /*Verificar se o pis ou cofins foram informados no acompanhamento de embarque(im0055)*/
                     ASSIGN de-val-desp    = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp)
                                             / tt-desp-totais.preco-total
                            de-val-desp-mo = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp-mo)
                                             / tt-desp-totais.preco-total.
                 ELSE IF NOT l-desembarque THEN DO:
                     RUN geraDespPisCofins.
                     ASSIGN l-create-desp-rateio = NO.
                 END.
            END.
            ELSE IF l-nt2024002 AND AVAIL param-imp-trib
                 AND (   desp-imp.cod-desp = param-imp-trib.cdn-despes-impto-ibsuf
                      OR desp-imp.cod-desp = param-imp-trib.cdn-despes-impto-ibsmun
                      OR desp-imp.cod-desp = param-imp-trib.cdn-despes-impto-cbs
                      OR desp-imp.cod-desp = param-imp-trib.cdn-despes-impto-is) THEN DO:
                 
                 IF l-cod-desp-ibsuf OR l-cod-desp-ibsmun OR l-cod-desp-cbs OR l-cod-desp-is THEN /*Verificar se o IBS UF, IBS Mun, CBS ou IS foram informados no acompanhamento de embarque(im0055)*/
                     ASSIGN de-val-desp    = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp)
                                             / tt-desp-totais.preco-total
                            de-val-desp-mo = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp-mo)
                                             / tt-desp-totais.preco-total.
                 ELSE IF NOT l-desembarque THEN DO:
                     RUN geraDespIBS-CBS.
                     ASSIGN l-create-desp-rateio = NO.
                 END.
            END.
            ELSE 
                /* Rateio */
                CASE desp-imp.tipo:                                     
                    /* Valor Fixo */
                    WHEN 1 THEN DO:
                        ASSIGN l-desp-valor-fixo   = YES
                               de-valor-rateado    = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp)
                                                   / tt-desp-totais.preco-total
                               de-valor-rateado-mo = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp-mo)
                                                   / tt-desp-totais.preco-total.
                        IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                            ASSIGN de-valor-rateado-isento    = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp-isento)
                                                              / tt-desp-totais.preco-total
                                   de-valor-rateado-isento-mo = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp-isento-mo)
                                                              / tt-desp-totais.preco-total.                                                         

                        IF l-desembarque THEN DO:
                            ASSIGN de-val-desp = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp)
                                               / tt-desp-totais.preco-total
                                   de-val-desp-mo = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp-mo)
                                               / tt-desp-totais.preco-total.                        
                                               
                            IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                                ASSIGN de-val-desp-isento    = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp-isento)
                                                             / tt-desp-totais.preco-total
                                       de-val-desp-isento-mo = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp-isento-mo)
                                                             / tt-desp-totais.preco-total.                                               

                        END.
                        ELSE DO:
                            ASSIGN de-val-desp    = tt-desp-totais.val-desp
                                   de-val-desp-mo = tt-desp-totais.val-desp-mo.
                                   
                            IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                                ASSIGN de-val-desp-isento    = tt-desp-totais.val-desp-isento
                                       de-val-desp-isento-mo = tt-desp-totais.val-desp-isento-mo.
                        END.
                    END.
                    /* Peso */
                    WHEN 3 THEN DO:
                        ASSIGN de-val-desp    = (tt-ordens-totais.peso-total * tt-desp-totais.val-desp)
                                              / tt-desp-totais.peso-total
                               de-val-desp-mo = (tt-ordens-totais.peso-total * tt-desp-totais.val-desp-mo)
                                              / tt-desp-totais.peso-total.
                                              
                        IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                            ASSIGN de-val-desp-isento    = (tt-ordens-totais.peso-total * tt-desp-totais.val-desp-isento)
                                                         / tt-desp-totais.peso-total
                                   de-val-desp-isento-mo = (tt-ordens-totais.peso-total * tt-desp-totais.val-desp-isento-mo)
                                                         / tt-desp-totais.peso-total.
                    END.
                    /* Quantidade */
                    WHEN 6 THEN DO:
                        ASSIGN de-val-desp    = (tt-ordens-totais.quantidade * tt-desp-totais.val-desp)
                                              / tt-desp-totais.quantidade
                               de-val-desp-mo = (tt-ordens-totais.quantidade * tt-desp-totais.val-desp-mo)
                                              / tt-desp-totais.quantidade.
                                              
                        IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                            ASSIGN de-val-desp-isento = (tt-ordens-totais.quantidade * tt-desp-totais.val-desp-isento)
                                                      / tt-desp-totais.quantidade
                                de-val-desp-isento-mo = (tt-ordens-totais.quantidade * tt-desp-totais.val-desp-isento-mo)
                                                      / tt-desp-totais.quantidade.
                    END.
                    /* Cubagem */ 
                    WHEN 9 THEN DO:

                        IF l-nacionalizacao OR l-documento THEN DO:
                            ASSIGN de-val-desp    = (tt-ordens-totais.peso-total * tt-desp-totais.val-desp)
                                                  / tt-desp-totais.peso-total
                                   de-val-desp-mo = (tt-ordens-totais.peso-total * tt-desp-totais.val-desp-mo)
                                                  / tt-desp-totais.peso-total.
                            IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                                ASSIGN de-val-desp-isento    = (tt-ordens-totais.peso-total * tt-desp-totais.val-desp-isento)
                                                             / tt-desp-totais.peso-total
                                       de-val-desp-isento-mo = (tt-ordens-totais.peso-total * tt-desp-totais.val-desp-isento-mo)
                                                             / tt-desp-totais.peso-total.
                        END.
                        ELSE DO:
                           ASSIGN de-val-desp    = (tt-ordens-totais.cubagem-total * tt-desp-totais.val-desp) 
                                                    / tt-desp-totais.cubagem-total
                                  de-val-desp-mo = (tt-ordens-totais.cubagem-total * tt-desp-totais.val-desp-mo)
                                                    / tt-desp-totais.cubagem-total.
                                                    
                           IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                               ASSIGN de-val-desp-isento    = (tt-ordens-totais.cubagem-total * tt-desp-totais.val-desp-isento) 
                                                            / tt-desp-totais.cubagem-total
                                      de-val-desp-isento-mo = (tt-ordens-totais.cubagem-total * tt-desp-totais.val-desp-isento-mo)
                                                            / tt-desp-totais.cubagem-total.
                        END.
                    END.
                    /* Valor */
                    OTHERWISE DO:
                        ASSIGN de-val-desp    = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp)
                                              / tt-desp-totais.preco-total
                               de-val-desp-mo = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp-mo)
                                              / tt-desp-totais.preco-total.
                                              
                        IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                            ASSIGN de-val-desp-isento    = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp-isento)
                                                         / tt-desp-totais.preco-total
                                   de-val-desp-isento-mo = (tt-ordens-totais.preco-total * tt-desp-totais.val-desp-isento-mo)
                                                        / tt-desp-totais.preco-total.
                    END.
                END CASE.

        IF i-pais-impto-usuario = 9 /* Paraguai */ THEN DO:
            IF de-val-desp = 0 AND de-val-desp-isento = 0 THEN DELETE tt-ordens-desp.
            IF de-val-desp = 0 AND de-val-desp-isento = 0 THEN NEXT.            
        END.
        ELSE DO:
            IF de-val-desp = 0 THEN DELETE tt-ordens-desp.
            IF de-val-desp = 0 THEN NEXT.
        END.
        
        IF l-create-desp-rateio THEN DO:
            CREATE tt-desp-rateio.
            ASSIGN tt-desp-rateio.numero-ordem       = tt-ordens-desp.numero-ordem
                   tt-desp-rateio.parcela            = tt-ordens-desp.parcela
                   tt-desp-rateio.cod-desp           = tt-ordens-desp.cod-desp
                   tt-desp-rateio.num-adic           = i-num-adicao
                   tt-desp-rateio.it-codigo          = tt-ordens-totais.it-codigo
                   tt-desp-rateio.val-desp           = de-val-desp
                   tt-desp-rateio.val-desp-mo        = de-val-desp-mo
                   tt-desp-rateio.val-desp-isento    = de-val-desp-isento
                   tt-desp-rateio.val-desp-isento-mo = de-val-desp-isento-mo
                   tt-desp-rateio.val-desp-unit      = de-val-desp / tt-ordens-totais.qtd-do-forn
                   tt-desp-rateio.val-desp-unit-mo   = de-val-desp-mo / tt-ordens-totais.qtd-do-forn.
        END.
            
        /* Acerto de residuos por item */
        IF l-gera-prim-nf-remes-mae THEN DO:

            FIND FIRST tt-ordens-desp-aux
                WHERE tt-ordens-desp-aux.numero-ordem = tt-ordens-desp.numero-ordem
                  AND tt-ordens-desp-aux.cod-desp     = tt-ordens-desp.cod-desp      EXCLUSIVE-LOCK NO-ERROR.

            IF AVAIL tt-ordens-desp-aux THEN
                ASSIGN tt-ordens-desp-aux.de-val-desp       = tt-ordens-desp-aux.de-val-desp       + tt-desp-rateio.val-desp
                       tt-ordens-desp-aux.de-val-desp-round = tt-ordens-desp-aux.de-val-desp-round + ROUND(tt-desp-rateio.val-desp,2).
            ELSE DO:
                CREATE tt-ordens-desp-aux.
                ASSIGN tt-ordens-desp-aux.numero-ordem      = tt-ordens-desp.numero-ordem
                       tt-ordens-desp-aux.cod-desp          = tt-ordens-desp.cod-desp
                       tt-ordens-desp-aux.de-val-desp       = tt-desp-rateio.val-desp
                       tt-ordens-desp-aux.de-val-desp-round = ROUND(tt-desp-rateio.val-desp,2).
            END.
            
            IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                ASSIGN tt-ordens-desp-aux.de-val-desp-isento       = tt-ordens-desp-aux.de-val-desp-isento       + tt-desp-rateio.val-desp-isento
                       tt-ordens-desp-aux.de-val-desp-isento-round = tt-ordens-desp-aux.de-val-desp-isento-round + ROUND(tt-desp-rateio.val-desp-isento,2).
        END.
            
        /*
        ** Despesa do tipo valor fixo
        */               
        IF desp-imp.tipo = 1 THEN DO:
            IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                ASSIGN tt-desp-rateio.val-desp-unit    = de-val-desp + de-val-desp-isento
                       tt-desp-rateio.val-desp-unit-mo = de-val-desp-mo + de-val-desp-isento-mo.
            ELSE
                ASSIGN tt-desp-rateio.val-desp-unit    = de-val-desp
                       tt-desp-rateio.val-desp-unit-mo = de-val-desp-mo.
        END.
                       
        IF desp-imp.inc-val-embal 
        OR desp-imp.inc-val-frete 
        OR desp-imp.inc-val-outras-desp 
        OR desp-imp.inc-val-seguro THEN DO:

            if de-cot-var-cambial <> 0 then do:
                assign de-valor-rateado = de-valor-rateado-mo * de-cot-var-cambial
                       de-val-desp      = de-val-desp-mo * de-cot-var-cambial.
            end.
            
            /* N∆o deve incidir se a origem for uma despesa complementar */
            if  i-pais-impto-usuario <> 1 AND l-nota-filha then do:
                if can-find(first tt-desp-comp
                            where tt-desp-comp.cod-desp = desp-imp.cod-desp) then 
                   assign de-valor-rateado = 0
                          de-val-desp      = 0. 
            end.

            /* Incide Base II */
            IF desp-imp.log-2 THEN
                ASSIGN tt-ordens-totais.base-ii    = tt-ordens-totais.base-ii    + 
                                                     IF l-desp-valor-fixo THEN de-valor-rateado
                                                     ELSE de-val-desp
                       tt-ordens-totais.base-ii-mo = tt-ordens-totais.base-ii-mo + 
                                                     IF l-desp-valor-fixo THEN de-valor-rateado-mo
                                                     ELSE de-val-desp-mo.
        
            /* Incide Base IPI */
            IF desp-imp.inc-base-ipi THEN
                ASSIGN tt-ordens-totais.base-ipi    = tt-ordens-totais.base-ipi    + 
                                                      IF l-desp-valor-fixo THEN de-valor-rateado
                                                      ELSE de-val-desp
                       tt-ordens-totais.base-ipi-mo = tt-ordens-totais.base-ipi-mo + 
                                                      IF l-desp-valor-fixo THEN de-valor-rateado-mo
                                                      ELSE de-val-desp-mo.
            
            /* Incide Base PIS */
            IF desp-imp.log-incid-base-pis-val 
            OR desp-imp.log-incid-base-pis-despes THEN
                ASSIGN tt-ordens-totais.base-pis    = tt-ordens-totais.base-pis    + 
                                                      IF l-desp-valor-fixo THEN de-valor-rateado
                                                      ELSE de-val-desp
                       tt-ordens-totais.base-pis-mo = tt-ordens-totais.base-pis-mo + 
                                                      IF l-desp-valor-fixo THEN de-valor-rateado-mo
                                                      ELSE de-val-desp-mo.

            /* Incide Base PIS */
            IF desp-imp.log-incid-base-cofins-val 
            OR desp-imp.log-incid-base-cofins-despes THEN
                ASSIGN tt-ordens-totais.base-cofins    = tt-ordens-totais.base-cofins    + 
                                                         IF l-desp-valor-fixo THEN de-valor-rateado
                                                         ELSE de-val-desp
                       tt-ordens-totais.base-cofins-mo = tt-ordens-totais.base-cofins-mo +
                                                         IF l-desp-valor-fixo THEN de-valor-rateado-mo
                                                         ELSE de-val-desp-mo.

            /* Incide Base ICMS */
            IF desp-imp.inc-base-icms THEN
                ASSIGN tt-ordens-totais.base-icms    = tt-ordens-totais.base-icms    + 
                                                       IF l-desp-valor-fixo THEN de-valor-rateado
                                                       ELSE de-val-desp
                       tt-ordens-totais.base-icms-mo = tt-ordens-totais.base-icms-mo + 
                                                       IF l-desp-valor-fixo THEN de-valor-rateado-mo
                                                       ELSE de-val-desp-mo.
                                                       
            IF i-pais-impto-usuario = 2 AND desp-imp.log-incid-base-tax-estatis THEN
                ASSIGN tt-ordens-totais.base-est    = tt-ordens-totais.base-est    + 
                                                      IF l-desp-valor-fixo THEN de-valor-rateado
                                                      ELSE de-val-desp
                       tt-ordens-totais.base-est-mo = tt-ordens-totais.base-est-mo + 
                                                      IF l-desp-valor-fixo THEN de-valor-rateado-mo
                                                      ELSE de-val-desp-mo.
        END.

        /*--- verifica se foi informada incoterm para alguma despesa ---*/
        IF l-existe-incoterm THEN DO:
            
            /* Logica pra ratear as despesas que tem incoterm - CIF */
            IF CAN-FIND(FIRST desp-imp 
                        WHERE desp-imp.cod-desp       = tt-ordens-desp.cod-desp
                          AND (   desp-imp.inc-val-frete  
                               OR desp-imp.inc-val-seguro 
                               OR desp-imp.inc-val-embal)) THEN DO:
                
                FIND FIRST tt-desp-cif
                     WHERE tt-desp-cif.numero-ordem = tt-ordens-desp.numero-ordem
                       AND tt-desp-cif.parcela      = tt-ordens-desp.parcela EXCLUSIVE-LOCK NO-ERROR.

                IF NOT AVAIL tt-desp-cif THEN DO:
                    CREATE tt-desp-cif.
                    ASSIGN tt-desp-cif.numero-ordem = tt-ordens-desp.numero-ordem
                           tt-desp-cif.parcela      = tt-ordens-desp.parcela
                           tt-desp-cif.val-desp     = tt-desp-rateio.val-desp    + tt-ordens-totais.preco-total  /*Valor da Mercadoria*/ 
                           tt-desp-cif.val-desp-mo  = tt-desp-rateio.val-desp-mo + tt-ordens-totais.preco-total
                           de-tot-siscomex-cif      = de-tot-siscomex-cif        + tt-desp-cif.val-desp
                           de-tot-siscomex-cif-mo   = de-tot-siscomex-cif-mo     + tt-desp-cif.val-desp-mo. 
                           
                    IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                        ASSIGN tt-desp-cif.val-desp-isento    = tt-desp-rateio.val-desp-isento 
                               tt-desp-cif.val-desp-isento-mo = tt-desp-rateio.val-desp-isento-mo 
                               de-tot-siscomex-cif            = de-tot-siscomex-cif     + tt-desp-rateio.val-desp-isento 
                               de-tot-siscomex-cif-mo         = de-tot-siscomex-cif-mo  + tt-desp-rateio.val-desp-isento-mo.
                END.
                ELSE DO:
                    ASSIGN tt-desp-cif.val-desp     = tt-desp-cif.val-desp    + tt-desp-rateio.val-desp
                           tt-desp-cif.val-desp-mo  = tt-desp-cif.val-desp-mo + tt-desp-rateio.val-desp-mo
                           de-tot-siscomex-cif      = de-tot-siscomex-cif     + tt-desp-rateio.val-desp
                           de-tot-siscomex-cif-mo   = de-tot-siscomex-cif-mo  + tt-desp-rateio.val-desp-mo.
                           
                    IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                        ASSIGN tt-desp-cif.val-desp-isento     = tt-desp-cif.val-desp-isento + tt-desp-rateio.val-desp-isento
                               tt-desp-cif.val-desp-isento-mo  = tt-desp-cif.val-desp-isento-mo + tt-desp-rateio.val-desp-isento-mo
                               de-tot-siscomex-cif             = de-tot-siscomex-cif     + tt-desp-rateio.val-desp-isento
                               de-tot-siscomex-cif-mo          = de-tot-siscomex-cif-mo  + tt-desp-rateio.val-desp-isento-mo.
                END.
            END.
            
            FOR EACH tt-ordens-totais-incoterm:

                /*--- se a despesa que foi calculada fizer parte das despesas cadastradas para a incoterm,
                      encontra a taxa de rateio(tt-taxa-rateio.taxa-rateio) que ser† utilizada para calcular 
                      o novo valor da despesa que possui este incoterm. A taxa de rateio eh encontrada com base
                      na nova base de calculo, que eh o valor da mercadoria + despesa da incoterm ---*/
                IF  CAN-FIND(FIRST desp-incoterm
                             WHERE desp-incoterm.cod-incoterm = tt-ordens-totais-incoterm.cod-incoterm
                               AND desp-incoterm.cod-desp     = tt-ordens-desp.cod-desp) THEN DO:
                    
                    FIND FIRST tt-desp-totais-incoterm 
                         WHERE tt-desp-totais-incoterm.cod-incoterm = tt-ordens-totais-incoterm.cod-incoterm NO-ERROR.
                    
                    IF NOT AVAIL tt-desp-totais-incoterm THEN
                        NEXT.

                    FIND FIRST tt-taxa-rateio
                         WHERE tt-taxa-rateio.cod-incoterm = tt-ordens-totais-incoterm.cod-incoterm
                           AND tt-taxa-rateio.numero-ordem = tt-desp-rateio.numero-ordem NO-ERROR.       

                    IF NOT AVAIL tt-taxa-rateio THEN
                        CREATE tt-taxa-rateio.

                    ASSIGN tt-taxa-rateio.cod-incoterm = tt-ordens-totais-incoterm.cod-incoterm
                           tt-taxa-rateio.numero-ordem = tt-desp-rateio.numero-ordem
                           tt-taxa-rateio.val-desp-tot = tt-taxa-rateio.val-desp-tot   + tt-desp-rateio.val-desp.
                           
                    IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                        ASSIGN tt-taxa-rateio.val-desp-tot = tt-taxa-rateio.val-desp-tot  + tt-desp-rateio.val-desp-isento.
                        
                    ASSIGN tt-taxa-rateio.taxa-rateio  = (tt-ordens-totais.preco-total + tt-taxa-rateio.val-desp-tot) /
                                                         (tt-desp-totais.preco-total   + tt-desp-totais-incoterm.val-incoterm).

                END.
                /*--- verifica se na despesa calculada foi informado o mesmo incoterm de rateio que esta sendo
                      calculado. Despesas do tipo Valor Fixo nao serao rateadas, cfme orientacao da engenharia ---*/
                ELSE IF tt-ordens-desp.cod-incoterm = tt-ordens-totais-incoterm.cod-incoterm AND NOT l-desp-valor-fixo THEN DO:
                    
                    FIND FIRST tt-taxa-rateio 
                         WHERE tt-taxa-rateio.cod-incoterm = tt-ordens-totais-incoterm.cod-incoterm
                           AND tt-taxa-rateio.numero-ordem = tt-desp-rateio.numero-ordem NO-ERROR.
                           
                    IF AVAIL tt-taxa-rateio THEN DO:

                        ASSIGN tt-desp-rateio.val-desp         = tt-desp-totais.val-desp * tt-taxa-rateio.taxa-rateio
                               tt-desp-rateio.val-desp-mo      = tt-desp-totais.val-desp-mo * tt-taxa-rateio.taxa-rateio.
                               
                        IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                            ASSIGN tt-desp-rateio.val-desp-isento    = tt-desp-totais.val-desp-isento * tt-taxa-rateio.taxa-rateio
                                   tt-desp-rateio.val-desp-isento-mo = tt-desp-totais.val-desp-isento-mo * tt-taxa-rateio.taxa-rateio
                                   tt-desp-rateio.val-desp-unit      = (tt-desp-rateio.val-desp + tt-desp-rateio.val-desp-isento) / tt-ordens-totais.qtd-do-forn
                                   tt-desp-rateio.val-desp-unit-mo   = (tt-desp-rateio.val-desp-mo + tt-desp-rateio.val-desp-isento-mo) / tt-ordens-totais.qtd-do-forn.
                    
                        ELSE
                            ASSIGN tt-desp-rateio.val-desp-unit    = tt-desp-rateio.val-desp / tt-ordens-totais.qtd-do-forn
                                   tt-desp-rateio.val-desp-unit-mo = tt-desp-rateio.val-desp-mo / tt-ordens-totais.qtd-do-forn.
                    END.
                END.
            END.
        END.
    END.

    /* Logica pra ratear as despesas que tem incoterm - CIF 
    ** (Valor CIF do item / Soma dos Valores CIF dos itens) * Valor da Despesa
    ** Valor CIF = valor da mercadoria + seguro + frete + embalagem
    **/
    IF l-existe-incoterm THEN DO:

        FOR EACH tt-desp-rateio EXCLUSIVE-LOCK:
            
            IF CAN-FIND(FIRST tt-ordens-desp
                        WHERE tt-ordens-desp.cod-desp      = tt-desp-rateio.cod-desp
                          AND tt-ordens-desp.cod-incoterm  = "CIF":U)THEN DO:
                
                IF CAN-FIND(FIRST desp-imp
                            WHERE desp-imp.cod-desp = tt-desp-rateio.cod-desp
                              AND (    desp-imp.inc-val-frete 
                                   OR desp-imp.inc-val-seguro
                                   OR desp-imp.inc-val-embal
                                   OR desp-imp.tipo = 1 /*valor fixo*/)) THEN NEXT.

               FIND FIRST tt-desp-cif
                    WHERE tt-desp-cif.numero-ordem = tt-desp-rateio.numero-ordem
                      AND tt-desp-cif.parcela      = tt-desp-rateio.parcela NO-LOCK NO-ERROR.

               RUN piBuscaNumAdicao (INPUT  tt-desp-rateio.numero-ordem,
                                     INPUT  tt-desp-rateio.parcela,
                                     INPUT  tt-desp-rateio.cod-desp,
                                     OUTPUT i-num-adicao).
                              
               FIND FIRST tt-desp-totais
                    WHERE tt-desp-totais.cod-desp = tt-desp-rateio.cod-desp
                      AND tt-desp-totais.num-adic = i-num-adicao NO-ERROR.

               IF AVAIL tt-desp-cif AND AVAIL tt-desp-totais THEN DO:
                   ASSIGN tt-desp-rateio.val-desp    = (tt-desp-cif.val-desp / de-tot-siscomex-cif) * tt-desp-totais.val-desp
                          tt-desp-rateio.val-desp-mo = (tt-desp-cif.val-desp-mo / de-tot-siscomex-cif-mo) * tt-desp-totais.val-desp-mo.
                          
                   IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                       ASSIGN tt-desp-rateio.val-desp-isento    = (tt-desp-cif.val-desp-isento / de-tot-siscomex-cif) * tt-desp-totais.val-desp-isento
                              tt-desp-rateio.val-desp-isento-mo = (tt-desp-cif.val-desp-isento-mo / de-tot-siscomex-cif-mo) * tt-desp-totais.val-desp-isento-mo.
               END.
            END.
            ELSE NEXT.
        END.
    END.
        
    FIND FIRST tt-ordens-desp
         WHERE tt-ordens-desp.cod-desp = i-cod-desp-ii NO-ERROR.
    IF NOT AVAIL tt-ordens-desp THEN
        FOR EACH tt-ordens-totais:
            
            IF l-nacionalizacao THEN DO:

                RUN geraDespII.
                IF i-pais-impto-usuario = 2 THEN
                    RUN geraTaxaEstatistica.                
            END.
        END.

    IF l-gera-prim-nf-remes-mae THEN DO:

        FOR EACH tt-ordens-desp-aux NO-LOCK:
            
            IF  tt-ordens-desp-aux.de-val-desp-round <> ROUND(tt-ordens-desp-aux.de-val-desp,2) 
            AND (ROUND(tt-ordens-desp-aux.de-val-desp,2) - tt-ordens-desp-aux.de-val-desp-round) <=  0.05
            AND (ROUND(tt-ordens-desp-aux.de-val-desp,2) - tt-ordens-desp-aux.de-val-desp-round) >= -0.05 THEN DO:

                FIND LAST tt-desp-rateio
                    WHERE tt-desp-rateio.numero-ordem = tt-ordens-desp-aux.numero-ordem
                      AND tt-desp-rateio.cod-desp     = tt-ordens-desp-aux.cod-desp EXCLUSIVE-LOCK NO-ERROR.

                IF AVAIL tt-desp-rateio THEN 
                    ASSIGN tt-desp-rateio.val-desp = tt-desp-rateio.val-desp + (ROUND(tt-ordens-desp-aux.de-val-desp,2) - tt-ordens-desp-aux.de-val-desp-round).
            END.
            
            IF i-pais-impto-usuario = 9 /* Paraguai */ THEN DO:
                 IF  tt-ordens-desp-aux.de-val-desp-isento-round <> ROUND(tt-ordens-desp-aux.de-val-desp-isento,2) 
                 AND (ROUND(tt-ordens-desp-aux.de-val-desp-isento,2) - tt-ordens-desp-aux.de-val-desp-isento-round) <=  0.05
                 AND (ROUND(tt-ordens-desp-aux.de-val-desp-isento,2) - tt-ordens-desp-aux.de-val-desp-isento-round) >= -0.05 THEN DO:
                     
                     FIND LAST tt-desp-rateio
                         WHERE tt-desp-rateio.numero-ordem = tt-ordens-desp-aux.numero-ordem
                           AND tt-desp-rateio.cod-desp     = tt-ordens-desp-aux.cod-desp EXCLUSIVE-LOCK NO-ERROR.
        
                     IF AVAIL tt-desp-rateio THEN 
                         ASSIGN tt-desp-rateio.val-desp-isento = tt-desp-rateio.val-desp-isento + (ROUND(tt-ordens-desp-aux.de-val-desp-isento,2) - tt-ordens-desp-aux.de-val-desp-isento-round).
                 END.
            END.
        END.
    END.
        
    IF NOT l-grupodeordens THEN
        RUN geraRateiodif.
    
END PROCEDURE.

PROCEDURE geraOrdensdespesa:
/*------------------------------------------------------------------------------
  Purpose: Gera relacionamento entre ordens x despesas
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER p-cod-desp           LIKE desp-imp.cod-desp         NO-UNDO.
    DEFINE INPUT PARAMETER p-embarque           LIKE embarque-imp.embarque     NO-UNDO.
    DEFINE INPUT PARAMETER p-cod-itiner         LIKE itinerario.cod-itiner     NO-UNDO.
    DEFINE INPUT PARAMETER p-val-desp           LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE INPUT PARAMETER p-val-desp-mo        LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE INPUT PARAMETER p-val-desp-isento    LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE INPUT PARAMETER p-val-desp-isento-mo LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE INPUT PARAMETER p-desembarque        AS   LOGICAL                   NO-UNDO.
    DEFINE INPUT PARAMETER p-cod-emitente-desp  LIKE emitente.cod-emitente     NO-UNDO.
    DEFINE INPUT PARAMETER p-cod-cond-pag       LIKE cond-pagto.cod-cond-pag   NO-UNDO.
    DEFINE INPUT PARAMETER p-mo-codigo          LIKE moeda.mo-codigo           NO-UNDO.
    DEFINE INPUT PARAMETER p-cod-pto-contr      LIKE pto-contr.cod-pto-contr   NO-UNDO.
    DEFINE INPUT PARAMETER p-cod-incoterm       AS   CHARACTER                 NO-UNDO.
    DEFINE INPUT PARAMETER p-existe-incoterm    AS   LOGICAL                   NO-UNDO.
    
    {ccp/cc9019.i50} /* include tratamento atributo livre cotacao-item.char-1 */
    
    DEFINE VARIABLE c-return-value AS   CHARACTER               NO-UNDO.
    DEFINE VARIABLE de-cotacao     LIKE docum-est-cex.cotacao   NO-UNDO. 
    
    FIND FIRST desp-imp
         WHERE desp-imp.cod-desp = p-cod-desp NO-LOCK NO-ERROR.
    
    FOR EACH tt-ordens-totais:
    
        ASSIGN i-tp-despesa = 0.
        
        FIND FIRST ordem-compra
             WHERE ordem-compra.numero-ordem = tt-ordens-totais.numero-ordem NO-LOCK NO-ERROR.

        IF p-desembarque THEN DO:
            
            FOR EACH cotacao-item FIELDS(cotacao-item.cot-aprovada cotacao-item.char-1 cotacao-item.data-cotacao cotacao-item.seq-cotac) 
               WHERE cotacao-item.numero-ordem = ordem-compra.numero-ordem
                 AND cotacao-item.cod-emitente = ordem-compra.cod-emitente
                 AND cotacao-item.it-codigo    = ordem-compra.it-codigo NO-LOCK:

                IF cotacao-item.cot-aprovada THEN DO:
                    
                    {cdp/cd4300.i4 "yes" cotacao-item.char-1}
                    {ccp/cc9019.i51 "yes"}
                  
                    FIND FIRST cotacao-item-cex
                         WHERE cotacao-item-cex.numero-ordem = tt-ordens-totais.numero-ordem
                           AND cotacao-item-cex.cod-emitente = ordem-compra.cod-emitente
                           AND cotacao-item-cex.it-codigo    = ordem-compra.it-codigo
                           AND cotacao-item-cex.seq-cotac    = cotacao-item.seq-cotac
                           AND cotacao-item-cex.data-cotacao = cotacao-item.data-cotacao
                           AND cotacao-item-cex.mapa-cotacao = i-mapa-cotacao-i50
                           AND cotacao-item-cex.cod-desp     = p-cod-desp NO-LOCK NO-ERROR.
                        
                    IF AVAIL cotacao-item-cex THEN DO:
                        ASSIGN i-tp-despesa = cotacao-item-cex.tp-despesa.
                    END.

                    IF  AVAIL cotacao-item-cex
                    AND AVAIL desp-imp
                    AND NOT desp-imp.inc-val-frete
                    AND desp-imp.tipo <> 3 THEN DO:
                        
                        CREATE tt-ordens-desp-cot.
                        ASSIGN tt-ordens-desp-cot.numero-ordem = tt-ordens-totais.numero-ordem
                               tt-ordens-desp-cot.parcela      = tt-ordens-totais.parcela
                               tt-ordens-desp-cot.cod-desp     = p-cod-desp
                               tt-ordens-desp-cot.val-desp     = cotacao-item-cex.val-desp
                                                               * tt-ordens-totais.qtd-do-forn
                               tt-ordens-desp-cot.val-desp-mo  = cotacao-item-cex.val-desp
                                                               * tt-ordens-totais.qtd-do-forn.
                                                               
                        IF cotacao-item-cex.mo-codigo <> 0 THEN do: 
                            if d-cotacao = 0 then
                                RUN cdp/cd0812.p (INPUT  cotacao-item-cex.mo-codigo,
                                                  INPUT  0,
                                                  INPUT  tt-ordens-desp-cot.val-desp,
                                                  INPUT  da-data-cotacao,
                                                  OUTPUT tt-ordens-desp-cot.val-desp).
                            else
                                RUN cdp/cd0812a.p (INPUT  cotacao-item-cex.mo-codigo,
                                                   INPUT  0,
                                                   INPUT  tt-ordens-desp-cot.val-desp,
                                                   INPUT  d-cotacao,
                                                   OUTPUT tt-ordens-desp-cot.val-desp).                                
                        end.
                        
                        {include/i-epc200.i2 &CodEvent='"ConverteDespesa2"'
                                             &CodParameter='"val-desp"'
                                             &ValueParameter="string(tt-ordens-desp-cot.val-desp)"}

                        {include/i-epc200.i2 &CodEvent='"ConverteDespesa2"'
                                             &CodParameter='"mo-codigo"'
                                             &ValueParameter="string(cotacao-item-cex.mo-codigo)"}
                                             
                        {include/i-epc200.i2 &CodEvent='"ConverteDespesa2"'
                                             &CodParameter='"data-cotacao"'
                                             &ValueParameter="string(da-data-cotacao)"}
                                             
                        {include/i-epc200.i2 &CodEvent='"ConverteDespesa2"'
                                             &CodParameter='"val-desp-conv"'
                                             &ValueParameter='""'}
                                             
                        /*Include i-epc201.i: Chamada do programa de EPC */
                        {include/i-epc201.i "ConverteDespesa2"}

                        IF c-nom-prog-dpc-mg97  <> "" 
                        OR c-nom-prog-appc-mg97 <> "" 
                        OR c-nom-prog-upc-mg97  <> "" THEN DO:

                            FIND FIRST tt-epc 
                                 WHERE tt-epc.cod-event = "ConverteDespesa2":U 
                                   AND tt-epc.cod-parameter = "val-desp":U NO-ERROR.
                            IF AVAIL tt-epc THEN
                                ASSIGN tt-ordens-desp-cot.val-desp = DEC(tt-epc.val-parameter).
                                
                            EMPTY TEMP-TABLE tt-epc.
                        END.
                    END.
                END.
            END.
        END. /* p-desembarque */
        ELSE DO:
            
            FIND FIRST desp-item
                 WHERE desp-item.it-codigo  = tt-ordens-totais.it-codigo
                   AND desp-item.cod-itiner = p-cod-itiner
                   AND desp-item.cod-desp   = p-cod-desp NO-LOCK NO-ERROR.
        END.

        IF AVAIL desp-item AND desp-item.exclui THEN
            NEXT.
        
        IF NOT l-cod-desp-ii THEN /*Verificar se o imposto de importaªío foi informado no acompanhamento de embarque(im0055)*/
           IF p-cod-desp = i-cod-desp-ii AND tt-ordens-totais.aliquota-ii = 0 THEN
               NEXT.

        IF i-pais-impto-usuario = 2 and l-nacionalizacao THEN
            IF NOT l-cod-desp-est THEN /*Verificar se a TAXA DE ESTAT÷STICA foi informada no acompanhamento de embarque(im0055)*/
                IF p-cod-desp = i-cod-desp-est AND tt-ordens-totais.aliquota-est = 0 THEN
                    NEXT.
                
        IF l-nota-ajuste AND i-cod-desp-ii <> p-cod-desp THEN NEXT.
           
        FIND FIRST tt-ordens-desp
             WHERE tt-ordens-desp.cod-desp      = p-cod-desp                   
               AND tt-ordens-desp.numero-ordem  = tt-ordens-totais.numero-ordem
               AND tt-ordens-desp.parcela       = tt-ordens-totais.parcela     NO-ERROR.

        IF NOT AVAIL tt-ordens-desp THEN
            CREATE tt-ordens-desp.

        ASSIGN tt-ordens-desp.cod-desp      = p-cod-desp
               tt-ordens-desp.numero-ordem  = tt-ordens-totais.numero-ordem
               tt-ordens-desp.parcela       = tt-ordens-totais.parcela
               tt-ordens-desp.cod-incoterm  = p-cod-incoterm
               tt-ordens-desp.cod-estabel   = ordem-compra.cod-estabel.
        
        RUN piBuscaNumAdicao (INPUT  tt-ordens-desp.numero-ordem,
                              INPUT  tt-ordens-desp.parcela,
                              INPUT  tt-ordens-desp.cod-desp,
                              OUTPUT i-num-adicao).
                              
        FIND FIRST tt-desp-totais
             WHERE tt-desp-totais.cod-desp = p-cod-desp
               AND tt-desp-totais.num-adic = i-num-adicao NO-ERROR.
            
        IF NOT AVAIL tt-desp-totais THEN DO:            
            
            IF p-mo-codigo <> 0 THEN DO:

                if  d-cotacao <> 0 
                and avail ordem-compra
                and ordem-compra.mo-codigo = p-mo-codigo
                then
                    assign de-cotacao = d-cotacao.
                else do:
                    FIND FIRST cotacao
                         where cotacao.mo-codigo                           = p-mo-codigo
                           and cotacao.ano-periodo                         = STRING(YEAR(da-data-cotacao)) + STRING(MONTH(da-data-cotacao),"99":U)
                           and cotacao.cotacao[INT(DAY(da-data-cotacao))] <> 0 NO-LOCK NO-ERROR.

                    IF NOT AVAIL cotacao THEN DO:
                        
                        ASSIGN i-seq-erro = i-seq-erro + 1.
                        CREATE tt-bo-erro.
                        ASSIGN tt-bo-erro.parametros = STRING(p-mo-codigo) + "~~":U + STRING(da-data-cotacao).
                        
                        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 27566, INPUT tt-bo-erro.parametros).

                        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                               tt-bo-erro.cd-erro  = 27566
                               tt-bo-erro.mensagem = RETURN-VALUE.
                        UNDO, LEAVE.
                    END.
                    ASSIGN de-cotacao = cotacao.cotacao[INT(DAY(da-data-cotacao))].
                end.    
            END.
            ELSE
                ASSIGN de-cotacao = 1.
            
            CREATE tt-desp-totais.
            ASSIGN tt-desp-totais.cod-desp           = p-cod-desp
                   tt-desp-totais.cod-emitente-desp  = p-cod-emitente-desp
                   tt-desp-totais.cod-cond-pag       = p-cod-cond-pag
                   tt-desp-totais.val-desp           = p-val-desp
                   tt-desp-totais.val-desp-mo        = p-val-desp-mo                   
                   tt-desp-totais.mo-codigo          = p-mo-codigo
                   tt-desp-totais.cotacao            = de-cotacao
                   tt-desp-totais.cod-pto-contr      = p-cod-pto-contr
                   tt-desp-totais.num-adic           = i-num-adicao.
                   
            IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                ASSIGN tt-desp-totais.val-desp-isento    = p-val-desp-isento
                       tt-desp-totais.val-desp-isento-mo = p-val-desp-isento-mo.
                   
            IF i-num-adicao <> 0 THEN DO:

                FOR FIRST ordens-embarque NO-LOCK
                    WHERE ordens-embarque.numero-ordem = tt-ordens-desp.numero-ordem
                      AND ordens-embarque.parcela      = tt-ordens-desp.parcela:
                    
                    ASSIGN p-val-desp    = ordens-embarque.val-tax-siscomex
                           p-val-desp-mo = ordens-embarque.val-tax-siscomex.                    
                    
                    IF p-mo-codigo <> 0 THEN do:
                        if d-cotacao = 0 then
                            RUN cdp/cd0812.p (INPUT  p-mo-codigo,
                                              INPUT  0,
                                              INPUT  p-val-desp,
                                              INPUT  da-data-cotacao,
                                              OUTPUT p-val-desp).
                        else
                            RUN cdp/cd0812a.p (INPUT  p-mo-codigo,
                                               INPUT  0,
                                               INPUT  p-val-desp,
                                               INPUT  d-cotacao,
                                               OUTPUT p-val-desp).                        
                    end.
                    
                    ASSIGN tt-desp-totais.val-desp    = p-val-desp
                           tt-desp-totais.val-desp-mo = p-val-desp-mo.
                END.
            END.

            /*--- se existir pelo menos uma despesa com incoterm ---*/
            IF p-existe-incoterm THEN DO:

                /*--- armazena o valor da despesa para o incoterm ---*/
                FOR EACH tt-desp-totais-incoterm:

                    IF CAN-FIND(FIRST desp-incoterm
                                WHERE desp-incoterm.cod-incoterm = tt-desp-totais-incoterm.cod-incoterm
                                  AND desp-incoterm.cod-desp     = tt-ordens-desp.cod-desp) THEN DO:

                        ASSIGN tt-desp-totais-incoterm.val-incoterm    = tt-desp-totais-incoterm.val-incoterm
                                                                         + tt-desp-totais.val-desp
                               tt-desp-totais-incoterm.val-incoterm-mo = tt-desp-totais-incoterm.val-incoterm-mo
                                                                         + tt-desp-totais.val-desp-mo.
                    END.
                END.
            END.

            IF i-tp-despesa = 0 THEN DO:
                
                FOR FIRST b-desp-imp FIELDS (tp-despesa)
                    WHERE b-desp-imp.cod-desp = p-cod-desp NO-LOCK: END.

                IF AVAIL b-desp-imp AND b-desp-imp.tp-despesa > 0 THEN
                    ASSIGN i-tp-despesa = b-desp-imp.tp-despesa.
                ELSE DO:

                    IF NOT AVAIL emitente OR emitente.cod-emitente <> p-cod-emitente-desp THEN

                        FOR FIRST emitente FIELDS (cod-emitente tp-desp-padrao)
                            WHERE emitente.cod-emitente = p-cod-emitente-desp NO-LOCK: END.

                    IF AVAIL emitente THEN
                        ASSIGN i-tp-despesa = emitente.tp-desp-padrao.
                END.
            END.

            ASSIGN tt-desp-totais.tp-despesa = i-tp-despesa.
       END.
        
       ASSIGN tt-desp-totais.quantidade    = tt-desp-totais.quantidade  + tt-ordens-totais.quantidade
              tt-desp-totais.qtd-do-forn   = tt-desp-totais.qtd-do-forn + tt-ordens-totais.qtd-do-forn
              tt-desp-totais.preco-total   = tt-desp-totais.preco-total + tt-ordens-totais.preco-total
              tt-desp-totais.peso-total    = tt-desp-totais.peso-total  + tt-ordens-totais.peso-total
              tt-desp-totais.cubagem-total = tt-desp-totais.cubagem-total + tt-ordens-totais.cubagem-total.
              
               
        IF desp-imp.tipo = 3 AND tt-desp-totais.peso-total = 0 THEN DO:

            ASSIGN i-seq-erro = i-seq-erro + 1.
            CREATE tt-bo-erro.
            {utp/ut-liter.i Peso_do_item * L}
            ASSIGN tt-bo-erro.parametros = TRIM(RETURN-VALUE) + " ":U + STRING(tt-ordens-totais.it-codigo).
            
            RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 7965, INPUT tt-bo-erro.parametros).

            ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 7965
                   tt-bo-erro.mensagem = RETURN-VALUE.
            UNDO, LEAVE.
        END.
        
        IF desp-imp.tipo = 9 AND tt-desp-totais.cubagem-total = 0 THEN DO:

            ASSIGN i-seq-erro = i-seq-erro + 1.
            CREATE tt-bo-erro.
            {utp/ut-liter.i Altura_Largura_e_Comprimento * L}

            ASSIGN tt-bo-erro.parametros = TRIM(RETURN-VALUE) + " ":U + STRING(tt-ordens-totais.it-codigo)
                   c-return-value        = TRIM(return-value) + " ":U + STRING(tt-ordens-totais.it-codigo).
            
            RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 7965, INPUT c-return-value).

            ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 7965
                   tt-bo-erro.mensagem = RETURN-VALUE.
            UNDO, LEAVE.
        END.
        
        FIND FIRST tt-ordens-desp-cot
             WHERE tt-ordens-desp-cot.numero-ordem = tt-ordens-totais.numero-ordem
               AND tt-ordens-desp-cot.parcela      = tt-ordens-totais.parcela
               AND tt-ordens-desp-cot.cod-desp     = p-cod-desp NO-ERROR.

        IF AVAIL tt-ordens-desp-cot THEN
            ASSIGN tt-desp-totais.val-desp-cot    = tt-desp-totais.val-desp-cot
                                                  + tt-ordens-desp-cot.val-desp
                   tt-desp-totais.val-desp-cot-mo = tt-desp-totais.val-desp-cot-mo 
                                                  + tt-ordens-desp-cot.val-desp-mo.
    END. /* FOR EACH tt-ordens-totais */
    	

    /* 
    ** Se a despesa foi previamente cotada para determinada ordem, gera despesa exclusiva para esta ordem 
    */
    IF p-desembarque THEN DO:
        
        FOR EACH tt-ordens-desp EXCLUSIVE-LOCK:

            IF CAN-FIND(FIRST tt-ordens-desp-cot
                        WHERE tt-ordens-desp-cot.cod-desp = tt-ordens-desp.cod-desp) THEN

                IF NOT CAN-FIND(FIRST tt-ordens-desp-cot
                                WHERE tt-ordens-desp-cot.numero-ordem = tt-ordens-desp.numero-ordem
                                  AND tt-ordens-desp-cot.parcela      = tt-ordens-desp.parcela
                                  AND tt-ordens-desp-cot.cod-desp     = tt-ordens-desp.cod-desp) THEN DO:

                    FIND FIRST tt-ordens-totais
                         WHERE tt-ordens-totais.numero-ordem = tt-ordens-desp.numero-ordem 
                           AND tt-ordens-totais.parcela      = tt-ordens-desp.parcela NO-LOCK NO-ERROR.
                    
                    RUN piBuscaNumAdicao (INPUT  tt-ordens-desp.numero-ordem,
                                          INPUT  tt-ordens-desp.parcela,
                                          INPUT  tt-ordens-desp.cod-desp,
                                          OUTPUT i-num-adicao).
                    
                    FIND FIRST tt-desp-totais
                         WHERE tt-desp-totais.cod-desp = tt-ordens-desp.cod-desp
                           AND tt-desp-totais.num-adic = i-num-adicao EXCLUSIVE-LOCK NO-ERROR.
                        
                    ASSIGN tt-desp-totais.quantidade    = tt-desp-totais.quantidade  
                                                        - tt-ordens-totais.quantidade
                           tt-desp-totais.qtd-do-forn   = tt-desp-totais.qtd-do-forn
                                                        - tt-ordens-totais.qtd-do-forn
                           tt-desp-totais.preco-total   = tt-desp-totais.preco-total 
                                                        - tt-ordens-totais.preco-total
                           tt-desp-totais.peso-total    = tt-desp-totais.peso-total 
                                                        - tt-ordens-totais.peso-total
                           tt-desp-totais.cubagem-total = tt-desp-totais.cubagem-total 
                                                        - tt-ordens-totais.cubagem-total.
                           
                    DELETE tt-ordens-desp.
                END.
        END.
    END.
    
END PROCEDURE.

PROCEDURE calculaQuantidadeordem:
/*------------------------------------------------------------------------------
  Purpose: Calcula total da quantidade da ordem de compra
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER p-numero-ordem LIKE ordem-compra.numero-ordem NO-UNDO.
    DEFINE OUTPUT PARAMETER p-quantidade   LIKE prazo-compra.quantidade   NO-UNDO.
    
    FOR EACH prazo-compra
       WHERE prazo-compra.numero-ordem = p-numero-ordem NO-LOCK:
        ASSIGN p-quantidade = p-quantidade + prazo-compra.quantidade.        
    END.
    
END PROCEDURE.

PROCEDURE geraOrdenstotais:
/*------------------------------------------------------------------------------
  Purpose: Calcula os valores totais de peso/quantidade/valor das ordens informadas
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER p-numero-ordem LIKE ordem-compra.numero-ordem NO-UNDO.
    DEFINE INPUT PARAMETER p-parcela      LIKE prazo-compra.parcela      NO-UNDO.
    DEFINE INPUT PARAMETER p-cod-emitente LIKE emitente.cod-emitente     NO-UNDO.
    DEFINE INPUT PARAMETER p-data-cotacao LIKE cotacao-item.data-cotacao NO-UNDO.
    DEFINE INPUT PARAMETER p-seq-cotac    AS   INTEGER                   NO-UNDO. /* cotacao-item.seq-cotac */
    DEFINE INPUT PARAMETER p-quantidade   LIKE prazo-compra.quantidade   NO-UNDO.
    DEFINE INPUT PARAMETER p-qtd-do-forn  LIKE prazo-compra.qtd-do-forn  NO-UNDO.
    
    DEFINE VARIABLE i-mo-codigo          LIKE cotacao-item.mo-codigo    NO-UNDO.    
    DEFINE VARIABLE de-pre-unit-for      LIKE cotacao-item.pre-unit-for NO-UNDO.
    DEFINE VARIABLE de-preco-total       LIKE cotacao-item.preco-unit   NO-UNDO.
    DEFINE VARIABLE de-preco-total-mo    LIKE cotacao-item.preco-unit   NO-UNDO.
    DEFINE VARIABLE de-preco-total-ii    LIKE cotacao-item.preco-unit   NO-UNDO.
    
    DEFINE VARIABLE de-peso-bruto     AS   DECIMAL FORMAT ">>>,>>>,>>9.99999":U NO-UNDO.
    DEFINE VARIABLE de-peso-liquido   AS   DECIMAL FORMAT ">>>,>>>,>>9.99999":U NO-UNDO.
    DEFINE VARIABLE de-cotacao-dia    AS   DECIMAL FORMAT ">>>,>9.99999999":U   NO-UNDO.
    
    {cxbo/bocx225e.i1} /*definicao dos pesos*/
    {ccp/cc9019.i50} /* include tratamento atributo livre */

    /*
    ** Verifica se peso/II foi informado na ordens-embarque
    */
    IF l-nacionalizacao THEN
        FIND FIRST tt-itens
            WHERE tt-itens.numero-ordem      = p-numero-ordem
              AND tt-itens.parcela           = p-parcela 
              AND tt-itens.l-ordens-embarque NO-LOCK NO-ERROR.
    
    FIND FIRST ordem-compra 
         WHERE ordem-compra.numero-ordem = p-numero-ordem NO-LOCK NO-ERROR.
                
    IF NOT AVAIL ordem-compra THEN DO:

        ASSIGN i-seq-erro = i-seq-erro + 1.
        {utp/ut-table.i mgind ordem-compra 1}
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + STRING(p-numero-ordem).
        
        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    
    IF p-cod-emitente = ? THEN
        FOR EACH cotacao-item FIELDS (cotacao-item.cot-aprovada cotacao-item.char-1
                                      cotacao-item.mo-codigo    cotacao-item.aliquota-ipi
                                      cotacao-item.pre-unit-for cotacao-item.seq-cotac cod-emitente   )
           WHERE cotacao-item.numero-ordem = ordem-compra.numero-ordem
             AND cotacao-item.cod-emitente = ordem-compra.cod-emitente
             AND cotacao-item.it-codigo    = ordem-compra.it-codigo NO-LOCK:

            IF cotacao-item.cot-aprovada THEN DO:
                
                {cdp/cd4300.i4 "yes" cotacao-item.char-1}
                {ccp/cc9019.i51 "yes"}
              
                ASSIGN i-mo-codigo    = cotacao-item.mo-codigo                       
                       de-aliquota-ii = de-aliq-ii-i50
                       de-pre-unit-for = (cotacao-item.pre-unit-for * 100) / (100 + cotacao-item.aliquota-ipi). /** preco sem ipi **/
                LEAVE.
            END.
        END.
    ELSE
        FIND FIRST cotacao-item
             WHERE cotacao-item.numero-ordem = p-numero-ordem
               AND cotacao-item.cod-emitente = p-cod-emitente
               AND cotacao-item.it-codigo    = ordem-compra.it-codigo
               AND cotacao-item.seq-cotac    = p-seq-cotac NO-LOCK NO-ERROR.
    
    IF NOT AVAIL cotacao-item THEN DO:

        ASSIGN i-seq-erro = i-seq-erro + 1.
        {utp/ut-table.i mgind cotacao-item 1}
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + STRING(ordem-compra.numero-ordem).
        
        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    ELSE DO:
        {cdp/cd4300.i4 "yes" cotacao-item.char-1}
        {ccp/cc9019.i51 "yes"}                
        
        ASSIGN i-mo-codigo    = cotacao-item.mo-codigo
               de-aliquota-ii = de-aliq-ii-i50
               de-pre-unit-for = (cotacao-item.pre-unit-for * 100) / (100 + cotacao-item.aliquota-ipi). /** preco sem ipi **/

        IF l-documento THEN
            ASSIGN i-mo-codigo = 0.
    END.

    ASSIGN de-preco-total    = de-pre-unit-for * p-qtd-do-forn
           de-preco-total-mo = de-pre-unit-for * p-qtd-do-forn.

    if de-cot-var-cambial <> 0 then 
        assign de-preco-total-ii = de-preco-total * de-cot-var-cambial.
        

    /* chamada UPC */
    FOR EACH tt-epc  
        WHERE tt-epc.cod-event = "CalculoPrecoUnitario":U:
         DELETE tt-epc.
    END.
                   
    CREATE tt-epc.
    ASSIGN tt-epc.cod-event     = "CalculoPrecoUnitario":U
           tt-epc.cod-parameter = "RowidOrdemCompra":U
           tt-epc.val-parameter = STRING(ROWID(ordem-compra)).

    CREATE tt-epc.
    ASSIGN tt-epc.cod-event     = "CalculoPrecoUnitario":U
           tt-epc.cod-parameter = "de-preco-total":U
           tt-epc.val-parameter = STRING(de-preco-total).

    {include/i-epc201.i "CalculoPrecoUnitario"} 
    
    FIND FIRST tt-epc
         WHERE tt-epc.cod-event     = "CalculoDespesasOutras":U
           AND tt-epc.cod-parameter = "DespOutras":U NO-ERROR.
    IF AVAIL tt-epc THEN DO:
        ASSIGN de-preco-total    = DEC(tt-epc.val-parameter)
               de-preco-total-mo = DEC(tt-epc.val-parameter).
    END.

    FIND FIRST tt-epc
         WHERE tt-epc.cod-event     = "CalculoDespesasOutras":U
           AND tt-epc.cod-parameter = "DespOutras":U NO-ERROR.
    IF AVAIL tt-epc THEN DO:
        DELETE tt-epc.
    END.
    
    FIND FIRST tt-epc
         WHERE tt-epc.cod-event     = "CalculoPrecoUnitario":U
           AND tt-epc.cod-parameter = "AlteraCotacao":U NO-ERROR.
           
    IF AVAIL tt-epc THEN DO:
        ASSIGN de-cotacao-dia    = DEC(tt-epc.val-parameter)
               de-preco-total    = de-preco-total    * de-cotacao-dia.
    END.
    ELSE DO:
         IF i-mo-codigo <> 0 THEN DO:
             if d-cotacao = 0 then
                 RUN cdp/cd0812.p (INPUT  i-mo-codigo,
                                   INPUT  0,
                                   INPUT  de-preco-total,
                                   INPUT  da-data-cotacao,
                                   OUTPUT de-preco-total).
             else
                 RUN cdp/cd0812a.p (INPUT  i-mo-codigo,
                                    INPUT  0,
                                    INPUT  de-preco-total,
                                    INPUT  d-cotacao,
                                    OUTPUT de-preco-total).             
                
             IF de-preco-total = ? THEN DO:
                 
                 ASSIGN i-seq-erro = i-seq-erro + 1.
                 
                 CREATE tt-bo-erro.
                 ASSIGN tt-bo-erro.parametros = STRING(i-mo-codigo) + "~~":U + STRING(da-data-cotacao).
             
                 RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 27566, INPUT tt-bo-erro.parametros).
             
                 ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                        tt-bo-erro.cd-erro  = 27566
                        tt-bo-erro.mensagem = RETURN-VALUE.
             
                 UNDO, LEAVE.
             END.             
         END.
    END.
    
    if de-preco-total-ii = 0 then
        assign de-preco-total-ii = de-preco-total.
    
    FIND FIRST item 
         WHERE item.it-codigo = ordem-compra.it-codigo NO-LOCK NO-ERROR.
    IF NOT AVAIL ITEM THEN DO:

        ASSIGN i-seq-erro = i-seq-erro + 1.
        {utp/ut-table.i mgind item 1}
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + ordem-compra.it-codigo.
        
        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).

        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    
    IF i-pais-impto-usuario = 2 AND AVAIL item THEN
        ASSIGN de-aliquota-est = DECIMAL(SUBSTRING(item.char-2,270,6)).          

    FIND FIRST tt-ordens-totais 
         WHERE tt-ordens-totais.numero-ordem = ordem-compra.numero-ordem 
           AND tt-ordens-totais.parcela      = p-parcela NO-ERROR.

    IF NOT AVAIL tt-ordens-totais THEN DO:
        
        CREATE tt-ordens-totais.
        ASSIGN tt-ordens-totais.numero-ordem = ordem-compra.numero-ordem
               tt-ordens-totais.parcela      = p-parcela
               tt-ordens-totais.it-codigo    = item.it-codigo
               tt-ordens-totais.preco-unit   = de-preco-total / p-qtd-do-forn /** preco unitario do fornecedor **/
               tt-ordens-totais.aliquota-ii  = de-aliquota-ii
               tt-ordens-totais.mo-codigo    = i-mo-codigo
               tt-ordens-totais.i-trib-ii    = INTEGER(SUBSTRING(item.char-2,20,2))
               tt-ordens-totais.seq-cotac    = cotacao-item.seq-cotac
               tt-ordens-totais.cod-emitente = cotacao-item.cod-emitente.
        
        IF i-pais-impto-usuario = 2 THEN
            ASSIGN tt-ordens-totais.aliquota-est = de-aliquota-est
                   tt-ordens-totais.i-trib-est   = INTEGER(SUBSTRING(item.char-2,276,2)).

    
    
        if not valid-handle(h-boin356) then
           run inbo/boin356ab.p persistent set h-boin356.

        if not valid-handle(h-bodi425) then
           RUN dibo/bodi425.p   PERSISTENT SET h-bodi425.

         FIND FIRST prazo-compra
              WHERE prazo-compra.numero-ordem = tt-ordens-totais.numero-ordem
                AND prazo-compra.parcela      = tt-ordens-totais.parcela NO-LOCK NO-ERROR.

         IF AVAIL prazo-compra AND VALID-HANDLE(h-boin356) AND VALID-HANDLE(h-bodi425) THEN DO:
             
             RUN piRetornaQtdeEmbalagem IN h-bodi425(INPUT p-quantidade, 
                                                     INPUT prazo-compra.it-codigo, 
                                                     INPUT ordem-compra.cod-emitente,
                                                     OUTPUT d-qtd-embal).
            
             RUN retornaPesoTotal IN h-boin356 (INPUT ROWID(prazo-compra), 
                                                INPUT p-quantidade, 
                                                INPUT d-qtd-embal, 
                                                OUTPUT de-peso-total).
                             
             IF d-qtd-embal > 0 THEN
                 RUN retornaVolumeTotal IN h-boin356 (INPUT ROWID(prazo-compra), 
                                                      INPUT d-qtd-embal, 
                                                      OUTPUT de-volume-total).
             ELSE
                 RUN retornaVolumeTotal IN h-boin356 (INPUT ROWID(prazo-compra), 
                                                      INPUT p-quantidade, 
                                                      OUTPUT de-volume-total).
             
             ASSIGN de-peso-bruto   = de-peso-total
                    de-peso-liquido = item.peso-liquido * p-quantidade
                    tt-ordens-totais.val-cub-tot = de-volume-total.
         END.

        /*
        ** Quando informada peso/II nas ordens-embarque
        */
        
        IF l-nacionalizacao THEN DO:
            
            IF AVAIL tt-itens THEN DO:
                
                ASSIGN tt-ordens-totais.aliquota-ii = tt-itens.aliquota-ii
                       tt-ordens-totais.i-trib-ii   = tt-itens.cd-trib-ii
                       tt-ordens-totais.val-cub-tot = tt-itens.val-cub-tot
                       de-peso-bruto                = tt-itens.peso-bruto
                       de-peso-liquido              = tt-itens.peso-liquido.
            END.
            ELSE DO:
                /* Busca peso da tt-itens mesmo quando n∆o foi gravada as informaá‰es de impostos nas ordens-embarque, pois o
                ** peso sempre Ç gravado, mesmo n∆o entrando no IM0045a*/
              FIND FIRST tt-itens
                  WHERE tt-itens.numero-ordem = p-numero-ordem
                    AND tt-itens.parcela      = p-parcela  NO-LOCK NO-ERROR.

              IF AVAIL tt-itens THEN
                  ASSIGN de-peso-bruto   = tt-itens.peso-bruto
                         de-peso-liquido = tt-itens.peso-liquido.
            END.
        END.
        ELSE DO:
            IF NOT l-nacionalizacao THEN DO:
                
                IF AVAIL ordens-embarque THEN DO:
                    
                    {cxbo/bocx225e.i2 NO ordens-embarque}
                        
                    IF de-peso-bruto-i1 <> 0 THEN
                        ASSIGN de-peso-bruto   = de-peso-bruto-i1.
                    IF de-peso-liquido-i1 <> 0 THEN
                        ASSIGN de-peso-liquido = de-peso-liquido-i1.
                END.
                ELSE DO:

                    IF l-desembarque THEN DO:
                        
                        FIND FIRST ordens-embarque
                             WHERE ordens-embarque.cod-estabel  = embarque-imp.cod-estabel 
                               AND ordens-embarque.embarque     = embarque-imp.embarque 
                               AND ordens-embarque.numero-ordem = p-numero-ordem 
                               AND ordens-embarque.parcela      = p-parcela NO-LOCK NO-ERROR.

                        IF AVAIL ordens-embarque THEN DO:
                            
                            {cxbo/bocx225e.i2 NO ordens-embarque}
                                   
                            IF de-peso-bruto-i1 <> 0 THEN
                                ASSIGN de-peso-bruto   = de-peso-bruto-i1.
                            
                            IF de-peso-liquido-i1 <> 0 THEN
                                ASSIGN de-peso-liquido = de-peso-liquido-i1.
                        END.
                    END.
                END. 
            END.
        END.
        
        IF l-desembarque THEN
            IF NOT l-documento THEN
                ASSIGN tt-ordens-totais.peso-unit = de-peso-liquido.
            ELSE
                ASSIGN tt-ordens-totais.peso-unit = item-doc-est.peso-liquido.
        ELSE
            ASSIGN tt-ordens-totais.peso-unit = de-peso-bruto.
    END.

    FOR FIRST tt-desconto-icms
        WHERE tt-desconto-icms.numero-ordem = p-numero-ordem  
          AND tt-desconto-icms.parcela      = p-parcela : END.
       
    IF AVAIL tt-desconto-icms THEN DO:
        IF tt-desconto-icms.de-perc-desc-icms > 0 AND tt-desconto-icms.l-aplica-desc-icms THEN
            ASSIGN de-preco-total = de-preco-total - (de-preco-total * (tt-desconto-icms.de-perc-desc-icms / 100)).
    END.
     
    ASSIGN tt-ordens-totais.quantidade       = tt-ordens-totais.quantidade
                                             + p-quantidade
           tt-ordens-totais.qtd-do-forn      = tt-ordens-totais.qtd-do-forn 
                                             + p-qtd-do-forn
           tt-ordens-totais.preco-total      = tt-ordens-totais.preco-total
                                             + de-preco-total
           tt-ordens-totais.base-ii          = tt-ordens-totais.base-ii
                                             + de-preco-total-ii   
           tt-ordens-totais.base-ipi         = tt-ordens-totais.base-ipi
                                             + de-preco-total
           tt-ordens-totais.base-pis         = tt-ordens-totais.base-pis
                                             + de-preco-total
           tt-ordens-totais.base-cofins      = tt-ordens-totais.base-cofins
                                             + de-preco-total
           tt-ordens-totais.base-icms        = tt-ordens-totais.base-icms
                                             + de-preco-total
           tt-ordens-totais.base-ii-mo       = tt-ordens-totais.base-ii-mo
                                             + de-preco-total-mo
           tt-ordens-totais.base-ipi-mo      = tt-ordens-totais.base-ipi
                                             + de-preco-total-mo
           tt-ordens-totais.base-pis-mo      = tt-ordens-totais.base-pis
                                             + de-preco-total-mo
           tt-ordens-totais.base-cofins-mo   = tt-ordens-totais.base-cofins
                                             + de-preco-total-mo
           tt-ordens-totais.base-icms-mo     = tt-ordens-totais.base-icms
                                             + de-preco-total-mo
           tt-ordens-totais.peso-total       = tt-ordens-totais.peso-total
                                             + tt-ordens-totais.peso-unit
           tt-ordens-totais.cubagem-total    = tt-ordens-totais.cubagem-total
                                             + tt-ordens-totais.val-cub-tot.

    IF i-pais-impto-usuario = 2 THEN
        ASSIGN tt-ordens-totais.base-est    = tt-ordens-totais.base-est
                                              + de-preco-total-ii
               tt-ordens-totais.base-est-mo = tt-ordens-totais.base-est
                                              + de-preco-total-mo.

    IF VALID-HANDLE(h-boin356) THEN DO:
       DELETE PROCEDURE h-boin356.
       ASSIGN h-boin356 = ?.
    END.
    IF VALID-HANDLE(h-bodi425) THEN DO:
       DELETE PROCEDURE h-bodi425.
       ASSIGN h-bodi425 = ?.
    END.

END PROCEDURE.

PROCEDURE geraDespII:
/*------------------------------------------------------------------------------
  Purpose: Gera imposto de importaªío automaticamente
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE VARIABLE i-cod-cond-pag LIKE cond-pagto.cod-cond-pag   NO-UNDO.
      
    IF  PROGRAM-NAME(3) <> "rateiogrupoordens imp/im0091.p":U 
    AND PROGRAM-NAME(3) <> "rateioDespesasPedido imp/im0091.p":U THEN DO:
        
        {include/i-epc200.i2 &CodEvent='"FornecIINacionalizacao"'
                             &CodParameter='"cod-estabel"'
                             &ValueParameter="string(embarque-imp.cod-estabel)"}
    
        {include/i-epc200.i2 &CodEvent='"FornecIINacionalizacao"'
                             &CodParameter='"embarque"'
                             &ValueParameter="string(embarque-imp.embarque)"}
        
        /*Include i-epc201.i: Chamada do programa de EPC */
        {include/i-epc201.i "FornecIINacionalizacao"}
        if c-nom-prog-dpc-mg97  <> "" 
        OR c-nom-prog-appc-mg97 <> "" 
        OR c-nom-prog-upc-mg97  <> "" THEN DO:
            
            FIND FIRST tt-epc 
                 WHERE tt-epc.cod-event = "RetornaFornecIINacionalizacao":U   
                   AND tt-epc.cod-parameter = "fornecedor-ii":U NO-ERROR.

            IF AVAIL tt-epc THEN
                ASSIGN i-cod-emitente-ii = INT(tt-epc.val-parameter).

            EMPTY TEMP-TABLE tt-epc.
        END.
    END.
    
    
    FIND FIRST emitente
         WHERE emitente.cod-emitente = i-cod-emitente-ii NO-LOCK NO-ERROR.
    
    IF (NOT AVAIL emitente) OR (AVAIL emitente AND emitente.cod-emitente = 0) THEN DO:

        ASSIGN i-seq-erro = i-seq-erro + 1.
        {utp/ut-liter.i Fornecedor_Imposto_Importaªío * L}
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + STRING(i-cod-emitente-ii).

        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).

        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    
    ASSIGN i-cod-cond-pag = emitente.cod-cond-pag.
    
    FIND FIRST tt-itiner-emb NO-ERROR.
    
    /*
    ** Verifica se o II foi informado nas ordens-embarque
    */
    IF l-nacionalizacao THEN 
        FIND FIRST tt-itens
             WHERE tt-itens.numero-ordem = tt-ordens-totais.numero-ordem
               AND tt-itens.parcela      = tt-ordens-totais.parcela
               AND tt-itens.l-ordens-embarque NO-LOCK NO-ERROR.
    
    IF l-nacionalizacao AND AVAIL tt-itens THEN
        ASSIGN i-trib-ii-nat = tt-itens.cd-trib-ii.

    IF i-trib-ii-nat = 2 THEN 
        RETURN. /* Isento do Imposto de Importaªío */
    
    IF NOT l-cod-desp-ii THEN /*Verificar se o imposto de importaªío foi informado no acompanhamento de embarque(im0055)*/
       IF tt-ordens-totais.aliquota-ii = 0 THEN 
           RETURN. /* Isento do Imposto de Importaªío */
    
    IF tt-ordens-totais.i-trib-ii = 2 THEN 
        RETURN. /* Item Isento */
        
    if i-pais-impto-usuario <> 1 and
       l-nacionalizacao and
       l-cod-desp-ii then
       return. /* Foi criado a despesa de II no IM0055 - n∆o criar registro de II nesse ponto */
    
    /******************************************************
    * A localizacao do registro na temp-table tt-itens de *
    * ve ocorrer independente da alteracao das informaco- *
    * es do embarque (tt-itens.l-ordens-embarque = YES)   *
    ******************************************************/
    FIND FIRST tt-itens
         WHERE tt-itens.numero-ordem = tt-ordens-totais.numero-ordem 
           AND tt-itens.parcela      = tt-ordens-totais.parcela      NO-LOCK NO-ERROR.

    IF AVAIL tt-itens AND tt-itens.suspensao-II THEN 
        RETURN.

    IF l-nacionalizacao THEN
        FIND FIRST tt-itens
             WHERE tt-itens.numero-ordem      = tt-ordens-totais.numero-ordem 
               AND tt-itens.parcela           = tt-ordens-totais.parcela      
               AND tt-itens.l-ordens-embarque = YES                           NO-LOCK NO-ERROR.
    

    FIND FIRST tt-desp-rateio                                           
         WHERE tt-desp-rateio.numero-ordem  = tt-ordens-totais.numero-ordem
           AND tt-desp-rateio.parcela       = tt-ordens-totais.parcela     
           AND tt-desp-rateio.cod-desp      = tt-ordens-desp.cod-desp NO-ERROR.

    IF  NOT AVAIL tt-desp-rateio THEN
        CREATE tt-desp-rateio.        
    
    ASSIGN tt-desp-rateio.numero-ordem  = tt-ordens-totais.numero-ordem
           tt-desp-rateio.parcela       = tt-ordens-totais.parcela
           tt-desp-rateio.cod-desp      = i-cod-desp-ii 
           tt-desp-rateio.it-codigo     = tt-ordens-totais.it-codigo
           tt-desp-rateio.val-desp      = tt-ordens-totais.base-ii * (tt-ordens-totais.aliquota-ii / 100)
           tt-desp-rateio.val-desp-unit = (tt-ordens-totais.base-ii * (tt-ordens-totais.aliquota-ii / 100))
                                          / tt-ordens-totais.qtd-do-forn
           de-val-desp                  = tt-desp-rateio.val-desp
           de-val-desp-mo               = tt-desp-rateio.val-desp-mo.

    ASSIGN tt-desp-rateio.val-desp-mo      = tt-desp-rateio.val-desp
           tt-desp-rateio.val-desp-unit-mo = tt-desp-rateio.val-desp-unit.
    /*
    ** Verifica se despesa jˇ estˇ cadastrada para o Embarque 
    */
    FIND FIRST tt-desp-totais 
         WHERE tt-desp-totais.cod-desp = i-cod-desp-ii NO-ERROR. 
         
    IF NOT AVAIL tt-desp-totais THEN DO:
        
        CREATE tt-desp-totais.
        ASSIGN tt-desp-totais.cod-desp          = i-cod-desp-ii 
               tt-desp-totais.cod-emitente-desp = i-cod-emitente-ii
               tt-desp-totais.cod-cond-pag      = i-cod-cond-pag
               tt-desp-totais.mo-codigo         = 0                           /* Imposto nío sofre variaªío cambial, sempre moeda 0 */
               tt-desp-totais.cod-pto-contr     = IF  AVAIL tt-itiner-emb THEN tt-itiner-emb.i-pto-desembarque ELSE 0.

        
        FOR FIRST desp-imp FIELDS (tp-despesa)
            WHERE desp-imp.cod-desp = tt-ordens-desp.cod-desp NO-LOCK: END.

        IF AVAIL desp-imp AND desp-imp.tp-despesa > 0 THEN
            ASSIGN tt-desp-totais.tp-despesa = desp-imp.tp-despesa.
        ELSE
            ASSIGN tt-desp-totais.tp-despesa = emitente.tp-desp-padrao.
    END.
    
    ASSIGN tt-desp-totais.val-desp    = tt-desp-totais.val-desp 
                                      + tt-desp-rateio.val-desp
           tt-desp-totais.val-desp-mo = tt-desp-totais.val-desp-mo
                                      + tt-desp-rateio.val-desp-mo.      
                                      
    RETURN "OK":U.
END PROCEDURE.

PROCEDURE geraTaxaEstatistica:
/*------------------------------------------------------------------------------
  Purpose: Gera TAXA DE ESTAT÷STICA automaticamente
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/

    IF i-pais-impto-usuario <> 2 THEN
        RETURN.
    
    DEFINE VARIABLE i-cod-cond-pag LIKE cond-pagto.cod-cond-pag   NO-UNDO.

    FIND FIRST emitente
         WHERE emitente.cod-emitente = i-cod-emitente-est NO-LOCK NO-ERROR.
    
    IF (NOT AVAIL emitente) OR (AVAIL emitente AND emitente.cod-emitente = 0) THEN DO:

        ASSIGN i-seq-erro = i-seq-erro + 1.
        {utp/ut-liter.i Fornecedor_Taxa_Est°stica * L}
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + STRING(i-cod-emitente-ii).

        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).

        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    
    ASSIGN i-cod-cond-pag = emitente.cod-cond-pag.
    
    FIND FIRST tt-itiner-emb NO-ERROR.
    
    IF i-pais-impto-usuario = 2 AND i-trib-taxa-est = 1 THEN
        RETURN.
           
    IF NOT l-cod-desp-est THEN /*Verificar se a taxa estat°stica foi informada no acompanhamento de embarque(im0055)*/
       IF tt-ordens-totais.aliquota-est = 0 THEN 
           RETURN. /* Isento da Taxa de Estat°stica */
    
    IF tt-ordens-totais.i-trib-pis = 1 THEN
        RETURN. /* Item Isento */
    
    RUN piIICompoeBaseEstatistica.
    
    FIND FIRST tt-desp-rateio                                           
         WHERE tt-desp-rateio.numero-ordem  = tt-ordens-totais.numero-ordem
           AND tt-desp-rateio.parcela       = tt-ordens-totais.parcela     
           AND tt-desp-rateio.cod-desp      = tt-ordens-desp.cod-desp NO-ERROR.

    IF NOT AVAIL tt-desp-rateio THEN
        CREATE tt-desp-rateio.        

    ASSIGN tt-desp-rateio.numero-ordem  = tt-ordens-totais.numero-ordem
           tt-desp-rateio.parcela       = tt-ordens-totais.parcela
           tt-desp-rateio.cod-desp      = i-cod-desp-est
           tt-desp-rateio.it-codigo     = tt-ordens-totais.it-codigo
           tt-desp-rateio.val-desp      = tt-ordens-totais.base-est * (tt-ordens-totais.aliquota-est / 100)
           tt-desp-rateio.val-desp-unit = (tt-ordens-totais.base-est * (tt-ordens-totais.aliquota-est / 100))
                                          / tt-ordens-totais.qtd-do-forn
           de-val-desp                  = tt-desp-rateio.val-desp
           de-val-desp-mo               = tt-desp-rateio.val-desp-mo.

    ASSIGN tt-desp-rateio.val-desp-mo      = tt-desp-rateio.val-desp
           tt-desp-rateio.val-desp-unit-mo = tt-desp-rateio.val-desp-unit.
           
    RUN aplicaFaixaImpto.

    /*
    ** Verifica se despesa jˇ estˇ cadastrada para o Embarque 
    */
    FIND FIRST tt-desp-totais 
         WHERE tt-desp-totais.cod-desp = i-cod-desp-est NO-ERROR.
         
    IF NOT AVAIL tt-desp-totais THEN DO:

        CREATE tt-desp-totais.
        ASSIGN tt-desp-totais.cod-desp          = i-cod-desp-est 
               tt-desp-totais.cod-emitente-desp = i-cod-emitente-est
               tt-desp-totais.cod-cond-pag      = i-cod-cond-pag
               tt-desp-totais.mo-codigo         = 0                           /* Imposto nío sofre variaªío cambial, sempre moeda 0 */
               tt-desp-totais.cod-pto-contr     = IF  AVAIL tt-itiner-emb THEN tt-itiner-emb.i-pto-desembarque ELSE 0.                                                     

        
        FOR FIRST desp-imp FIELDS (tp-despesa)
            WHERE desp-imp.cod-desp = tt-ordens-desp.cod-desp NO-LOCK: END.

        IF AVAIL desp-imp AND desp-imp.tp-despesa > 0 THEN 
            ASSIGN tt-desp-totais.tp-despesa = desp-imp.tp-despesa.
        ELSE
            ASSIGN tt-desp-totais.tp-despesa = emitente.tp-desp-padrao.
    END.
    
    ASSIGN tt-desp-totais.val-desp    = tt-desp-totais.val-desp 
                                      + tt-desp-rateio.val-desp
           tt-desp-totais.val-desp-mo = tt-desp-totais.val-desp-mo
                                      + tt-desp-rateio.val-desp-mo.     
                                      
    RETURN "OK":U.
END PROCEDURE.

PROCEDURE aplicaFaixaImpto:
    
    IF NOT VALID-HANDLE(h-bocx00454) THEN
        RUN cxbo/bocx00454.p PERSISTENT SET h-bocx00454.
    
    IF d-cotacao <> 0 THEN
        RUN setaValorCotacao IN h-bocx00454 (INPUT d-cotacao).
    
    RUN pi-calcula-impto-faixa IN h-bocx00454 (INPUT  param-imp.cod-estabel,
                                               INPUT  tt-ordens-totais.base-est,
                                               INPUT  tt-desp-rateio.val-desp,
                                               INPUT  da-data-cotacao,
                                               OUTPUT d-val-impto-ret).
    IF d-val-impto-ret <> 0 THEN DO:
        
        ASSIGN tt-desp-rateio.val-desp      = d-val-impto-ret
               tt-desp-rateio.val-desp-mo   = d-val-impto-ret
               tt-desp-rateio.val-desp-unit = tt-desp-totais.val-desp / tt-ordens-totais.qtd-do-forn
               de-val-desp                  = tt-desp-rateio.val-desp
               de-val-desp-mo               = tt-desp-rateio.val-desp-mo.               
    END.

    IF VALID-HANDLE(h-bocx00454) THEN DO:
        RUN destroy IN h-bocx00454.
        ASSIGN h-bocx00454 = ?.
    END.
    
    RETURN "OK":U.
END PROCEDURE.

PROCEDURE geraDespIpiIcms:
/*------------------------------------------------------------------------------
  Purpose: Gera IPI ou ICMS automaticamente
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE VARIABLE i-cod-cond-pag LIKE cond-pagto.cod-cond-pag NO-UNDO.
    
    IF AVAIL param-imp THEN
        ASSIGN i-cod-emitente-ipi  = param-imp.cdn-fornec-ipi
               i-cod-emitente-icms = param-imp.cdn-fornec-icms.

    FIND FIRST emitente
         WHERE emitente.cod-emitente = IF desp-imp.cod-desp = param-imp.cdn-despes-impto-ipi THEN 
                                           i-cod-emitente-ipi 
                                       ELSE 
                                           i-cod-emitente-icms NO-LOCK NO-ERROR.
    

    IF (NOT AVAIL emitente) OR (AVAIL emitente AND emitente.cod-emitente = 0) THEN DO:

        ASSIGN i-seq-erro = i-seq-erro + 1.
        IF tt-ordens-desp.cod-desp = param-imp.cdn-despes-impto-ipi THEN DO:
            {utp/ut-liter.i Fornecedor_IPI * L}
        END.
        ELSE DO:
            {utp/ut-liter.i Fornecedor_ICMS * L}
        END.
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + IF tt-ordens-desp.cod-desp = param-imp.cdn-despes-impto-ipi THEN
                                                                 STRING(i-cod-emitente-ipi)
                                                             ELSE
                                                                 STRING(i-cod-emitente-icms).
        
        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
        
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    
    ASSIGN i-cod-cond-pag = emitente.cod-cond-pag.
    
    FIND FIRST tt-itiner-emb NO-ERROR.
        
    /*--- calcula valor do IPI ---*/
    RUN imp/imapi007.p(INPUT BUFFER tt-ordens-totais:HANDLE,
                       INPUT tt-ordens-desp.cod-desp,
                       INPUT c-cod-agrup,                         
                       INPUT i-mapa-ordem,
                       OUTPUT de-valor-despesa).

    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    IF de-valor-despesa = 0 THEN 
        RETURN.

    CREATE tt-desp-rateio.
    ASSIGN tt-desp-rateio.numero-ordem     = tt-ordens-totais.numero-ordem
           tt-desp-rateio.parcela          = tt-ordens-totais.parcela
           tt-desp-rateio.cod-desp         = tt-ordens-desp.cod-desp
           tt-desp-rateio.it-codigo        = tt-ordens-totais.it-codigo
           tt-desp-rateio.val-desp         = de-valor-despesa
           tt-desp-rateio.val-desp-mo      = tt-desp-rateio.val-desp
           de-val-desp                     = tt-desp-rateio.val-desp
           de-val-desp-mo                  = tt-desp-rateio.val-desp-mo
           tt-desp-rateio.val-desp-unit    = de-valor-despesa / tt-ordens-totais.qtd-do-forn
           tt-desp-rateio.val-desp-unit-mo = tt-desp-rateio.val-desp-unit.
    /*
    ** Verifica se despesa ja esta cadastrada para o Embarque
    */
    IF NOT AVAIL tt-desp-totais THEN DO:
        
        CREATE tt-desp-totais.
        ASSIGN tt-desp-totais.cod-desp          = tt-ordens-desp.cod-desp
               tt-desp-totais.cod-emitente-desp = i-cod-emitente-ipi
               tt-desp-totais.cod-cond-pag      = i-cod-cond-pag
               tt-desp-totais.mo-codigo         = 0                           /* Imposto nío sofre variaªío cambial, sempre moeda 0 */
               tt-desp-totais.cod-pto-contr     = tt-itiner-emb.i-pto-desemb.
    END.

    ASSIGN tt-desp-totais.val-desp    = tt-desp-totais.val-desp
                                      + tt-desp-rateio.val-desp
           tt-desp-totais.val-desp-mo = tt-desp-totais.val-desp-mo
                                      + tt-desp-rateio.val-desp-mo.

    RETURN "OK":U.    
END PROCEDURE.

PROCEDURE geraDespPisCofins:
/*------------------------------------------------------------------------------
  Purpose: Gera PIS ou COFINS automaticamente
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE VARIABLE i-cod-cond-pag LIKE cond-pagto.cod-cond-pag   NO-UNDO.

    ASSIGN i-cod-emitente-pis    = param-imp.cdn-fornec-pis
           i-cod-emitente-cofins = param-imp.cdn-fornec-cofins.

    FIND FIRST emitente
         WHERE emitente.cod-emitente = IF  tt-ordens-desp.cod-desp = param-imp.cdn-despes-impto-pis THEN
                                           i-cod-emitente-pis 
                                       ELSE
                                           i-cod-emitente-cofins NO-LOCK NO-ERROR.
    
    IF (NOT AVAIL emitente) OR (AVAIL emitente AND emitente.cod-emitente = 0) THEN DO:
        
        ASSIGN i-seq-erro = i-seq-erro + 1.

        IF tt-ordens-desp.cod-desp = param-imp.cdn-despes-impto-pis THEN DO:

            {utp/ut-liter.i Fornecedor_PIS * L}
            CREATE tt-bo-erro.
            ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + STRING(i-cod-emitente-pis).

            RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).

            ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = RETURN-VALUE.
            UNDO, LEAVE.
        END.
        ELSE DO:

            {utp/ut-liter.i Fornecedor_COFINS * L}
            CREATE tt-bo-erro.
            ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + STRING(i-cod-emitente-cofins).

            RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).

            ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = RETURN-VALUE.
            UNDO, LEAVE.
        END.            
    END.
    
    ASSIGN i-cod-cond-pag = emitente.cod-cond-pag.
    
    FIND FIRST tt-itiner-emb NO-ERROR.
        
    /*--- calcula valores das despesas dos impostos PIS ou COFINS. ---*/
    RUN imp/imapi008.p(INPUT BUFFER tt-ordens-totais:HANDLE,
                       INPUT tt-ordens-desp.cod-desp,
                       INPUT 0,
                       INPUT c-cod-agrup,
                       INPUT i-mapa-ordem,
                       OUTPUT de-valor-despesa).

    IF  RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    CREATE tt-desp-rateio.
    ASSIGN tt-desp-rateio.numero-ordem     = tt-ordens-totais.numero-ordem
           tt-desp-rateio.parcela          = tt-ordens-totais.parcela
           tt-desp-rateio.cod-desp         = tt-ordens-desp.cod-desp
           tt-desp-rateio.it-codigo        = tt-ordens-totais.it-codigo
           tt-desp-rateio.val-desp         = de-valor-despesa
           tt-desp-rateio.val-desp-mo      = tt-desp-rateio.val-desp
           de-val-desp                     = tt-desp-rateio.val-desp
           de-val-desp-mo                  = tt-desp-rateio.val-desp-mo
           tt-desp-rateio.val-desp-unit    = de-valor-despesa / tt-ordens-totais.qtd-do-forn
           tt-desp-rateio.val-desp-unit-mo = tt-desp-rateio.val-desp-unit. 

    /*
    ** Verifica se despesa ja esta cadastrada para o Embarque
    */
    IF NOT AVAIL tt-desp-totais THEN DO:

        CREATE tt-desp-totais.
        ASSIGN tt-desp-totais.cod-desp          = tt-ordens-desp.cod-desp
               tt-desp-totais.cod-emitente-desp = IF tt-ordens-desp.cod-desp = param-imp.cdn-despes-impto-pis THEN
                                                      i-cod-emitente-pis
                                                  ELSE
                                                      i-cod-emitente-cofins
               tt-desp-totais.cod-cond-pag      = i-cod-cond-pag
               tt-desp-totais.mo-codigo         = 0                           /* Imposto nío sofre variaªío cambial, sempre moeda 0 */
               tt-desp-totais.cod-pto-contr     = tt-itiner-emb.i-pto-desemb.
    END.

    ASSIGN tt-desp-totais.val-desp    = tt-desp-totais.val-desp
                                      + tt-desp-rateio.val-desp
           tt-desp-totais.val-desp-mo = tt-desp-totais.val-desp-mo
                                      + tt-desp-rateio.val-desp-mo.

END PROCEDURE.

PROCEDURE geraDespIBS-CBS:
/*------------------------------------------------------------------------------
  Purpose: Gera IPI ou ICMS automaticamente
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE VARIABLE i-cod-cond-pag LIKE cond-pagto.cod-cond-pag NO-UNDO.
    
    IF AVAIL param-imp-trib THEN
        ASSIGN i-cod-emitente-ibsuf  = param-imp-trib.cdn-fornec-ibsuf
               i-cod-emitente-ibsmun = param-imp-trib.cdn-fornec-ibsmun
               i-cod-emitente-cbs    = param-imp-trib.cdn-fornec-cbs
               i-cod-emitente-is     = param-imp-trib.cdn-fornec-is.

    FIND FIRST emitente
         WHERE emitente.cod-emitente = IF desp-imp.cod-desp = param-imp-trib.cdn-despes-impto-ibsuf THEN 
                                           i-cod-emitente-ibsuf 
                                       ELSE 
                                       IF desp-imp.cod-desp = param-imp-trib.cdn-despes-impto-ibsmun THEN
                                           i-cod-emitente-ibsmun
                                       ELSE 
                                       IF desp-imp.cod-desp = param-imp-trib.cdn-despes-impto-is THEN
                                           i-cod-emitente-is
                                       ELSE
                                           i-cod-emitente-cbs NO-LOCK NO-ERROR.
    

    IF (NOT AVAIL emitente) OR (AVAIL emitente AND emitente.cod-emitente = 0) THEN DO:

        ASSIGN i-seq-erro = i-seq-erro + 1.
        IF tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-ibsuf THEN DO:
            {utp/ut-liter.i Fornecedor_IBS_UF * L}
        END.
        ELSE
        IF tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-ibsmun THEN DO:
            {utp/ut-liter.i Fornecedor_IBS_Mun * L}
        END.
        ELSE
        IF tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-is THEN DO:
            {utp/ut-liter.i Fornecedor_IS * L}
        END.
        ELSE DO:
            {utp/ut-liter.i Fornecedor_CBS * L}
        END.
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + IF tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-ibsuf THEN
                                                                  STRING(i-cod-emitente-ibsuf)
                                                               ELSE
                                                               IF tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-ibsmun THEN
                                                                  STRING(i-cod-emitente-ibsmun)
                                                               ELSE
                                                               IF tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-is THEN
                                                                  STRING(i-cod-emitente-is)
                                                               ELSE
                                                                  STRING(i-cod-emitente-cbs).
        
        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
        
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    
    ASSIGN i-cod-cond-pag = emitente.cod-cond-pag.
    
    FIND FIRST tt-itiner-emb NO-ERROR.
        
    IF tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-ibsuf THEN
        /*--- calcula valor da despesa do IBS UF ---*/
        RUN imp/imapi014.p(INPUT BUFFER tt-ordens-totais:HANDLE,
                           INPUT tt-ordens-desp.cod-desp,
                           INPUT c-cod-agrup,                         
                           INPUT i-mapa-ordem,
                           OUTPUT de-valor-despesa).
    ELSE
    IF tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-ibsmun THEN
        /*--- calcula valor da despesa do IBS Mun ---*/
        RUN imp/imapi016.p(INPUT BUFFER tt-ordens-totais:HANDLE,
                           INPUT tt-ordens-desp.cod-desp,
                           INPUT c-cod-agrup,                         
                           INPUT i-mapa-ordem,
                           OUTPUT de-valor-despesa).
    ELSE
    IF tt-ordens-desp.cod-desp = param-imp-trib.cdn-despes-impto-is THEN
        /*--- calcula valor da despesa do IS ---*/
        RUN imp/imapi021.p(INPUT BUFFER tt-ordens-totais:HANDLE,
                           INPUT tt-ordens-desp.cod-desp,
                           INPUT c-cod-agrup,                         
                           INPUT i-mapa-ordem,
                           OUTPUT de-valor-despesa).
    ELSE
        /*--- calcula valor da despesa do CBS. ---*/
        RUN imp/imapi015.p(INPUT BUFFER tt-ordens-totais:HANDLE,
                           INPUT tt-ordens-desp.cod-desp,
                           INPUT 0,
                           INPUT c-cod-agrup,
                           INPUT i-mapa-ordem,
                           OUTPUT de-valor-despesa).
     
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    IF de-valor-despesa = 0 THEN 
        RETURN.

    CREATE tt-desp-rateio.
    ASSIGN tt-desp-rateio.numero-ordem     = tt-ordens-totais.numero-ordem
           tt-desp-rateio.parcela          = tt-ordens-totais.parcela
           tt-desp-rateio.cod-desp         = tt-ordens-desp.cod-desp
           tt-desp-rateio.it-codigo        = tt-ordens-totais.it-codigo
           tt-desp-rateio.val-desp         = de-valor-despesa
           tt-desp-rateio.val-desp-mo      = tt-desp-rateio.val-desp
           de-val-desp                     = tt-desp-rateio.val-desp
           de-val-desp-mo                  = tt-desp-rateio.val-desp-mo
           tt-desp-rateio.val-desp-unit    = de-valor-despesa / tt-ordens-totais.qtd-do-forn
           tt-desp-rateio.val-desp-unit-mo = tt-desp-rateio.val-desp-unit.
    /*
    ** Verifica se despesa ja esta cadastrada para o Embarque
    */
    IF NOT AVAIL tt-desp-totais THEN DO:
        
        CREATE tt-desp-totais.
        ASSIGN tt-desp-totais.cod-desp          = tt-ordens-desp.cod-desp
               tt-desp-totais.cod-emitente-desp = IF desp-imp.cod-desp = param-imp-trib.cdn-despes-impto-ibsuf THEN 
                                                     i-cod-emitente-ibsuf 
                                                  ELSE 
                                                  IF desp-imp.cod-desp = param-imp-trib.cdn-despes-impto-ibsmun THEN 
                                                     i-cod-emitente-ibsmun
                                                  ELSE
                                                  IF desp-imp.cod-desp = param-imp-trib.cdn-despes-impto-is THEN 
                                                     i-cod-emitente-is
                                                  ELSE
                                                     i-cod-emitente-cbs
               tt-desp-totais.cod-cond-pag      = i-cod-cond-pag
               tt-desp-totais.mo-codigo         = 0                           /* Imposto nío sofre variaªío cambial, sempre moeda 0 */
               tt-desp-totais.cod-pto-contr     = tt-itiner-emb.i-pto-desemb.
    END.

    ASSIGN tt-desp-totais.val-desp    = tt-desp-totais.val-desp
                                      + tt-desp-rateio.val-desp
           tt-desp-totais.val-desp-mo = tt-desp-totais.val-desp-mo
                                      + tt-desp-rateio.val-desp-mo.

    RETURN "OK":U.    
END PROCEDURE.


PROCEDURE geraRateioDif:
/*------------------------------------------------------------------------------
  Purpose: Rateia a diferenªa do valor total
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE VARIABLE de-val-desp            LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE VARIABLE de-val-desp-dif        LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE VARIABLE de-val-desp-isento-dif LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE VARIABLE de-val-maior           LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE VARIABLE de-val-isento-maior    LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEFINE VARIABLE i-ordem-maior          LIKE ordem-compra.numero-ordem NO-UNDO.
    DEFINE VARIABLE i-parcela-maior        LIKE prazo-compra.parcela      NO-UNDO.
    DEFINE VARIABLE i-desp-maior           LIKE desp-imp.cod-desp         NO-UNDO.
    DEFINE VARIABLE i-adic-maior           AS   INTEGER                   NO-UNDO.
    
    IF l-desembarque THEN DO:
        
        FOR EACH tt-desp-totais:

            ASSIGN tt-desp-totais.val-desp = ROUND(tt-desp-totais.val-desp,2).
            
            IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                ASSIGN tt-desp-totais.val-desp-isento = ROUND(tt-desp-totais.val-desp-isento,2).
        END.

        FOR EACH tt-desp-rateio:

            ASSIGN tt-desp-rateio.val-desp = ROUND(tt-desp-rateio.val-desp,2).            
            
            IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                ASSIGN tt-desp-rateio.val-desp-isento = ROUND(tt-desp-rateio.val-desp-isento,2).
        END.
    END.
    
    FOR EACH tt-desp-totais:
    
        /*
        ** Despesas do tipo valor fixo nío precisam sofrer rateio
        */ 
        
        FIND FIRST desp-imp
             WHERE desp-imp.cod-desp = tt-desp-totais.cod-desp NO-LOCK NO-ERROR.

        IF l-grupodeordens THEN
            IF desp-imp.tipo = 1 THEN 
                NEXT.
                
        ASSIGN de-val-desp            = 0
               de-val-desp-isento     = 0
               i-ordem-maior          = 0
               i-desp-maior           = 0
               i-adic-maior           = 0
               de-val-desp-dif        = 0
               de-val-desp-isento-dif = 0
               de-val-maior           = 0
               de-val-isento-maior    = 0.
        
        FOR EACH tt-desp-rateio
           WHERE tt-desp-rateio.cod-desp = tt-desp-totais.cod-desp
             AND tt-desp-rateio.num-adic = tt-desp-totais.num-adic:
            
            IF l-desembarque THEN DO:
                
                IF ROUND(tt-desp-rateio.val-desp,2) > ROUND(de-val-maior,2) 
                OR (i-pais-impto-usuario = 9 AND ROUND(tt-desp-rateio.val-desp-isento,2) > ROUND(de-val-isento-maior,2)) THEN DO:
                    
                    ASSIGN i-ordem-maior   = tt-desp-rateio.numero-ordem
                           i-parcela-maior = tt-desp-rateio.parcela
                           i-desp-maior    = tt-desp-rateio.cod-desp
                           i-adic-maior    = tt-desp-rateio.num-adic
                           de-val-maior    = ROUND(tt-desp-rateio.val-desp,2).
                END.

                ASSIGN de-val-desp = de-val-desp + tt-desp-rateio.val-desp.
                
                IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                    ASSIGN de-val-desp-isento = de-val-desp-isento + tt-desp-rateio.val-desp-isento.            
            END.
            ELSE DO:
                
                IF tt-desp-rateio.val-desp > de-val-maior THEN
                    ASSIGN i-ordem-maior   = tt-desp-rateio.numero-ordem
                           i-parcela-maior = tt-desp-rateio.parcela
                           i-desp-maior    = tt-desp-rateio.cod-desp
                           i-adic-maior    = tt-desp-rateio.num-adic
                           de-val-maior    = tt-desp-rateio.val-desp.
                
                ASSIGN de-val-desp = de-val-desp + tt-desp-rateio.val-desp.
            END.
        END.
        
        IF l-desembarque THEN DO:
            
            ASSIGN de-val-desp-dif = ROUND(tt-desp-totais.val-desp,2) - ROUND(de-val-desp,2).
            
            IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                ASSIGN de-val-desp-isento-dif = ROUND(tt-desp-totais.val-desp-isento,2) - ROUND(de-val-desp-isento,2).
        END.
        ELSE DO:

            ASSIGN de-val-desp-dif = tt-desp-totais.val-desp - de-val-desp.        
            
            IF i-pais-impto-usuario = 9 /* Paraguai */ THEN
                ASSIGN de-val-desp-isento-dif = tt-desp-totais.val-desp-isento - de-val-desp-isento.    
        END.
        
        IF de-val-desp-dif <> 0 AND de-val-desp-dif <> ? THEN DO:

            FOR EACH tt-ordens-totais 
               WHERE tt-ordens-totais.numero-ordem = i-ordem-maior 
                 AND tt-ordens-totais.parcela  = i-parcela-maior:
            END.

            FIND FIRST tt-ordens-totais 
                 WHERE tt-ordens-totais.numero-ordem = i-ordem-maior 
                   AND tt-ordens-totais.parcela      = i-parcela-maior NO-ERROR.
            
            FIND FIRST tt-desp-rateio
                 WHERE tt-desp-rateio.numero-ordem = i-ordem-maior
                   AND tt-desp-rateio.parcela      = i-parcela-maior
                   AND tt-desp-rateio.cod-desp     = i-desp-maior
                   AND tt-desp-rateio.num-adic     = i-adic-maior NO-ERROR.

            IF AVAIL tt-desp-rateio AND AVAIL tt-ordens-totais THEN
                
                IF l-desembarque THEN DO:
                    
                    ASSIGN tt-desp-rateio.val-desp      = ROUND(tt-desp-rateio.val-desp,2)
                                                        + ROUND(de-val-desp-dif,2)
                           tt-desp-rateio.val-desp-unit = ROUND(tt-desp-rateio.val-desp-unit,2)
                                                        + (de-val-desp-dif / tt-ordens-totais.qtd-do-forn).
                END.
                ELSE DO:
                    
                    ASSIGN tt-desp-rateio.val-desp      = tt-desp-rateio.val-desp
                                                        + de-val-desp-dif
                           tt-desp-rateio.val-desp-unit = tt-desp-rateio.val-desp-unit
                                                        + (de-val-desp-dif / tt-ordens-totais.qtd-do-forn).
                END.
        END.
        
        IF i-pais-impto-usuario = 9 /* Paraguai */ THEN DO:

            IF de-val-desp-isento-dif <> 0 AND de-val-desp-isento-dif <> ? THEN DO:

                FOR EACH tt-ordens-totais 
                   WHERE tt-ordens-totais.numero-ordem = i-ordem-maior 
                     AND tt-ordens-totais.parcela  = i-parcela-maior:
                END.

                FIND FIRST tt-ordens-totais 
                     WHERE tt-ordens-totais.numero-ordem = i-ordem-maior 
                       AND tt-ordens-totais.parcela      = i-parcela-maior NO-ERROR.
                
                FIND FIRST tt-desp-rateio
                     WHERE tt-desp-rateio.numero-ordem = i-ordem-maior
                       AND tt-desp-rateio.parcela      = i-parcela-maior
                       AND tt-desp-rateio.cod-desp     = i-desp-maior
                       AND tt-desp-rateio.num-adic     = i-adic-maior NO-ERROR.

                IF AVAIL tt-desp-rateio AND AVAIL tt-ordens-totais THEN

                    IF l-desembarque THEN DO:
                        
                        ASSIGN tt-desp-rateio.val-desp-isento  = ROUND(tt-desp-rateio.val-desp-isento,2)
                                                               + ROUND(de-val-desp-isento-dif,2)
                               tt-desp-rateio.val-desp-unit = ROUND(tt-desp-rateio.val-desp-unit,2)
                                                            + (de-val-desp-isento-dif / tt-ordens-totais.qtd-do-forn).
                    END.
                    ELSE DO:
                            
                        ASSIGN tt-desp-rateio.val-desp-isento = tt-desp-rateio.val-desp-isento
                                                              + de-val-desp-isento-dif
                               tt-desp-rateio.val-desp-unit = tt-desp-rateio.val-desp-unit
                                                            + (de-val-desp-isento-dif / tt-ordens-totais.qtd-do-forn).
                    END.
            END.
        END.
    END.

END PROCEDURE.

PROCEDURE getDespII:
/*------------------------------------------------------------------------------
  Purpose: Retorna o valor total do imposto de importaªío
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER p-val-desp-ii LIKE cotacao-item-cex.val-desp NO-UNDO.
    
    FOR EACH tt-desp-rateio:
        
        IF tt-desp-rateio.cod-desp = i-cod-desp-ii THEN
            ASSIGN p-val-desp-ii = p-val-desp-ii + tt-desp-rateio.val-desp.
    END.
        
END PROCEDURE.
        
