PROCEDURE setaValorinicial:
/*------------------------------------------------------------------------------
  Purpose: Seta valores iniciais para o programa     
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER p-data-cotacao AS DATE                    NO-UNDO.
    DEFINE INPUT PARAMETER p-cod-estabel  LIKE estabelec.cod-estabel NO-UNDO.
	
	EMPTY TEMP-TABLE tt-bo-erro.
    EMPTY TEMP-TABLE tt-itiner-emb.
    EMPTY TEMP-TABLE tt-desp-rateio   .
    EMPTY TEMP-TABLE tt-desp-totais   .
    EMPTY TEMP-TABLE tt-ordens-totais .
    EMPTY TEMP-TABLE tt-ordens-desp   .
    EMPTY TEMP-TABLE tt-taxa-rateio   .
    
    {cxbo/bocx250.i50} /* include tratamento atributo livre */
    
    ASSIGN da-data-cotacao   = p-data-cotacao
           c-cod-estabel     = p-cod-estabel
           l-nacionalizacao  = NO
           l-grupodeordens   = NO
           l-cod-desp-ii     = NO  /*Verificar se o imposto de importaªío foi informado no acompanhamento de embarque(im0055)*/
           l-cod-desp-ipi    = NO  /*Verificar se o IPI foi informado no acompanhamento de embarque(im0055)*/
           l-cod-desp-icms   = NO  /*Verificar se o ICMS foi informado no acompanhamento de embarque(im0055)*/
           l-cod-desp-pis    = NO  /*Verificar se o PIS foi informado no acompanhamento de embarque(im0055)*/
           l-cod-desp-cofins = NO  /*Verificar se o COFINS foi informado no acompanhamento de embarque(im0055)*/
           l-cod-desp-ibsuf  = NO  /*Verificar se o IBS UF foi informado no acompanhamento de embarque(im0055)*/
           l-cod-desp-ibsmun = NO  /*Verificar se o IBS Mun foi informado no acompanhamento de embarque(im0055)*/
           l-cod-desp-cbs    = NO  /*Verificar se o CBS foi informado no acompanhamento de embarque(im0055)*/
           l-cod-desp-is     = NO. /*Verificar se o IS foi informado no acompanhamento de embarque(im0055)*/

    FIND FIRST param-imp
         WHERE param-imp.cod-estabel = c-cod-estabel NO-LOCK NO-ERROR.
    IF NOT AVAIL param-imp THEN DO:
        
        ASSIGN i-seq-erro = i-seq-erro + 1.
        {utp/ut-table.i mgcex param-imp 1}
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + c-cod-estabel.

        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    
    {cdp/cd4300.i4 "yes" param-imp.char-1}
    {cxbo/bocx250.i51 "yes"}
    
    ASSIGN i-cod-desp-ii     = i-desp-ii-i50
           i-cod-emitente-ii = i-emitente-ii-i50.
           
    IF i-cod-desp-ii <> 0 THEN DO:
        
        IF NOT CAN-FIND(FIRST desp-imp 
                        WHERE desp-imp.cod-desp = i-cod-desp-ii) THEN DO:

            ASSIGN i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Despesa_Imposto_Importaªío * L}
            CREATE tt-bo-erro.
            ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~" + STRING(i-cod-desp-ii).

            RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
            ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = RETURN-VALUE.
            UNDO, LEAVE.
        END.
    END.

    IF i-pais-impto-usuario = 2 THEN DO:

        ASSIGN i-cod-desp-est     = param-imp.cdn-despes-tax-estatis
               i-cod-emitente-est = param-imp.cdn-emit-tax-estatis
               l-cod-desp-est     = NO /*Verificar se a taxa de estat°stica foi informada no acompanhamento de embarque(im0055)*/ .
               
        IF i-cod-desp-est <> 0 THEN DO:

            IF NOT CAN-FIND(FIRST desp-imp 
                            WHERE desp-imp.cod-desp = i-cod-desp-est) THEN DO:

                ASSIGN i-seq-erro = i-seq-erro + 1.
                {utp/ut-liter.i Despesa_Taxa_Estat°stica * L}
                CREATE tt-bo-erro.
                ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + STRING(i-cod-desp-est).
                
                RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
                ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 2
                       tt-bo-erro.mensagem = RETURN-VALUE.
                UNDO, LEAVE.
            END.
        END.
    END.

END PROCEDURE.

PROCEDURE setaValorinicialIPI:
/*------------------------------------------------------------------------------
  Purpose: Seta valores iniciais para o programa 
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER p-data-cotacao AS   DATE                   NO-UNDO.
    DEFINE INPUT PARAMETER p-cod-estabel  LIKE estabelec.cod-estabel  NO-UNDO.
    
    {cxbo/bocx250.i50} /* include tratamento atributo livre */
    
    ASSIGN da-data-cotacao  = p-data-cotacao
           c-cod-estabel    = p-cod-estabel
           l-nacionalizacao = NO
           l-grupodeordens  = NO
           l-cod-desp-ii    = NO. /*Verificar se o imposto de importaªío foi informado no acompanhamento de embarque(im0055)*/
    
    FIND FIRST param-imp
         WHERE param-imp.cod-estabel = c-cod-estabel NO-LOCK NO-ERROR.
    IF NOT AVAIL param-imp THEN DO:

        ASSIGN i-seq-erro = i-seq-erro + 1.
        {utp/ut-table.i mgcex param-imp 1}
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + c-cod-estabel.
        
        RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = RETURN-VALUE.
        UNDO, LEAVE.
    END.
    
    ASSIGN i-cod-desp-ipi     = param-imp.cdn-despes-impto-ipi
           i-cod-emitente-ipi = param-imp.cdn-fornec-ipi.
           
    IF i-cod-desp-ipi <> 0 THEN DO:

        IF NOT CAN-FIND(FIRST desp-imp 
                        WHERE desp-imp.cod-desp = i-cod-desp-ipi) THEN DO:

            ASSIGN i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Despesa_IPI * L}
            CREATE tt-bo-erro.
            ASSIGN tt-bo-erro.parametros = RETURN-VALUE + "~~":U + STRING(i-cod-desp-ipi).

            RUN utp/ut-msgs.p (INPUT "msg":U, INPUT 2, INPUT tt-bo-erro.parametros).
            ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = RETURN-VALUE.
            UNDO, LEAVE.
        END.
    END.

END PROCEDURE.

PROCEDURE setaValorinicialICMS:
/*------------------------------------------------------------------------------
