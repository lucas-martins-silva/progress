/**********************************************************************************
**
** IM0080.I1 - include definicao temp-tables comuns im0080.p/im0080a.w/im0080rp.p 
** 
**
**********************************************************************************/

DEFINE TEMP-TABLE tt-dupli no-undo
    field dt-vencimen  as date
    field tp-despesa   as integer
    field vl-apagar    as decimal format "->>>>>>>,>>9.99" initial 0
    field vl-apagar-mo as decimal format "->>>,>>>,>>>,>>9.99" initial 0.

def temp-table tt-retorno-erro no-undo
    field embarque          like embarque-imp.embarque
    field cod-estabel       like embarque-imp.cod-estabel
    field cod-erro          as integer     format ">>>>>>>>9" label "C¢digo"
    field mensagem          as character   format "x(103)" label "Mensagem"
    field sequen            as integer     
    field tipo-erro         as character
    INDEX codigo IS PRIMARY embarque
                            cod-estabel
                            sequen.

def temp-table tt-embarque-contab no-undo
    field embarque          like embarque-imp.embarque
    field cod-estabel       like lin-i-ap.cod-estabel
    field ep-codigo         like lin-i-ap.ep-codigo
    field cod-esp           like lin-i-ap.cod-esp
    field serie             like lin-i-ap.serie
    field nr-docto          like lin-i-ap.nr-docto
    field parcela           like lin-i-ap.parcela
    field cod-fornec        like lin-i-ap.cod-fornec.

DEFINE TEMP-TABLE tt-ordens no-undo
    field numero-ordem like ordem-compra.numero-ordem
    field valor    as decimal format "->>>>>>>,>>9.99" initial 0
    field valor-mo as decimal format "->>>,>>>,>>>,>>9.99" initial 0
    INDEX ordem IS PRIMARY numero-ordem.
    
DEFINE TEMP-TABLE tt-ordens-dupli no-undo
    field numero-ordem like ordem-compra.numero-ordem
    field dt-vencim    as date
    field vl-apagar    as decimal format "->>>>>>>,>>9.99" initial 0
    field vl-apagar-mo as decimal format "->>>,>>>,>>>,>>9.99" initial 0
    INDEX codigo IS PRIMARY numero-ordem dt-vencim.        
    
       
def temp-table tt-param
    field data-ini            as date
    field data-fim            as date
    field destino             as integer
    field arquivo             as char
    field diretorio           as char
    field usuario             as char
    field data-exec           as date
    field hora-exec           as integer
    field classifica          as integer
    field desc-classifica     as char format "x(60)"
    field parametro           as logical init yes
    field c-destino           as char
    field formato             as integer
    field l-desemb-parcial    as logical init no.
                  
 def temp-table tt-raw-digita
    field raw-digita as raw.

    /* im0080.i1 */
