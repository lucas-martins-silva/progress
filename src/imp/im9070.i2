
/*******************************************************************************
**
** IM9070.i2 - Configurador de Tributos Importa‡Æo
** 
*******************************************************************************/

{inbo/boin176.m98} /* pi-gravar-dados-cfg-trib */

{utp/ut-liter.i Preparando_dados_para_o_Configurador_de_Tributos * }
ASSIGN c-lbl-acomp  = TRIM(RETURN-VALUE).

{utp/ut-liter.i Gerando_dados_Configurador_de_Tributos * }
ASSIGN c-lbl-acomp2 = TRIM(RETURN-VALUE).

{utp/ut-liter.i Item * }
ASSIGN c-lbl-item = TRIM(RETURN-VALUE).

ASSIGN l-nt2024002 = CAN-FIND(FIRST funcao NO-LOCK
                              WHERE funcao.cd-funcao = "spp-NT2024002":U AND funcao.ativo).
         
PROCEDURE pi-config-tributos-embarque:
/*------------------------------------------------------------------------------
    ** Procedure respons vel pela chamada do Configurador de tributos
    ** realizada pelas BO's do recebimento e atualiza‡Æo dos dados 
    ** dos Itens da nota com rela‡Æo aos valores do ICMS
-------------------------------------------------------------------------------*/

    IF NOT VALID-HANDLE(h-imapi017) THEN
       RUN imp/imapi017.p PERSISTENT SET h-imapi017.
    
    IF AVAIL docum-est THEN DO:
    
       FOR FIRST b-natur-oper                                                          
           WHERE b-natur-oper.nat-operacao = docum-est.nat-operacao NO-LOCK:                                                                                             
           ASSIGN l-nota-rateio = b-natur-oper.nota-rateio.                                                                                                            
       END.  
                                                                          
       RUN pi-inicializar IN h-acomp (INPUT c-lbl-acomp).       
       RUN pi-acompanhar IN h-acomp (INPUT c-lbl-acomp2).       
       /*cria‡Æo registro wt-docto para carregar informa‡äes da configura‡Æo de tributo*/
       RUN createTbWtDocto (INPUT docum-est.serie-docto, 
                            INPUT docum-est.nro-docto,   
                            INPUT docum-est.cod-emitente,
                            INPUT docum-est.nat-operacao).       
       
       FIND FIRST wt-docto NO-LOCK
            WHERE wt-docto.seq-wt-docto < 0 no-error.
       ASSIGN i-seq-wt-docto-aux = IF AVAIL wt-docto THEN wt-docto.seq-wt-docto - 1 else -1.
       
       ASSIGN de-base-icm         = 0
              de-vl-icm           = 0
              de-base-ipi         = 0
              de-vl-ipi           = 0
              de-base-subs        = 0
              de-vl-subs          = 0
              de-vl-icm-old       = 0
              de-tot-icms-old     = 0.

       ASSIGN docum-est.valor-outras = docum-est.valor-outras - docum-est.icm-deb-cre WHEN NOT l-nota-rateio
              docum-est.despesa-nota = docum-est.despesa-nota - docum-est.icm-deb-cre WHEN NOT l-nota-rateio.
            
       RUN pi-recebe-handle IN h_bodi317im2bra (INPUT "h-bodi613calc2", INPUT h-bodi613calc2).
       RUN pi-recebe-handle IN h_bodi317im2bra (INPUT "h-cdcfgfiscal", INPUT h-cdcfgfiscal).
       
       RUN pi-recebe-handle IN h-bodi613calc2 (INPUT "h-cdcfgfiscal", INPUT h-cdcfgfiscal).
    
       FOR EACH tt-it-docto NO-LOCK                                  
          WHERE tt-it-docto.cod-emitente  = docum-est.cod-emitente 
            AND tt-it-docto.nr-nota       = docum-est.nro-docto    
            AND tt-it-docto.serie         = docum-est.serie-docto        
            AND tt-it-docto.cod-estabel   = docum-est.cod-estabel  
            AND tt-it-docto.nat-operacao  = docum-est.nat-operacao:
          RUN pi-exec-config-tributos.
       END.
       
       RUN piAtualizaValoresNota.
                          
    END.
    
    IF VALID-HANDLE(h-imapi017) THEN DO:
        DELETE PROCEDURE h-imapi017.
        ASSIGN h-imapi017 = ?.
    END.

    RETURN "OK":U.
END PROCEDURE.


PROCEDURE pi-exec-config-tributos:
/*------------------------------------------------------------------------------    
    Retira de Outras Despesas e Despesas da Nota o valor antigo do ICMS
------------------------------------------------------------------------------*/
    
    FOR FIRST item-doc-est EXCLUSIVE-LOCK
        WHERE item-doc-est.serie-docto  = tt-it-docto.serie  
        AND   item-doc-est.nro-docto    = tt-it-docto.nr-nota    
        AND   item-doc-est.cod-emitente = tt-it-docto.cod-emitente 
        AND   item-doc-est.nat-operacao = tt-it-docto.nat-operacao 
        AND   item-doc-est.sequencia    = tt-it-docto.nr-sequencia:
        
        RUN createTbWtItDoctoImposto. 

        {inbo/boin176.m99} /*executa configurador de tributos*/
         
        if l-nota-rateio then
           run retornaTbWtItDocto in h-bodi613calc2 (output table tb-wt-it-docto).
    
        ASSIGN de-vl-icm-old      = item-doc-est.valor-icm[1]
               de-tot-icms-old    = de-tot-icms-old + item-doc-est.valor-icm[1].
    
        RUN pi-acompanhar IN h-acomp (INPUT c-lbl-item + ": " + STRING(item-doc-est.it-codigo)).
        
        {inbo/boin176.m97 "item-doc-est"} /* retorno configurador de tributos*/        
    
        ASSIGN item-doc-est.despesas[1] = item-doc-est.despesas[1] - de-vl-icm-old + item-doc-est.valor-icm[1] WHEN NOT l-nota-rateio
                                                                                                                   /*atualiza a despesa do item com o valor 
                                                                                                                 atualizado do ICMS calculado pelo configurador de tributos*/
               de-base-icm              = de-base-icm
                                        +  (item-doc-est.base-icm[1]
                                        *  int(can-do("1,4,5", STRING(item-doc-est.cd-trib-icm))))
                                        +  (item-doc-est.icm-outras[1]
                                        *  int(item-doc-est.cd-trib-icm = 3))
               de-vl-icm                = de-vl-icm
                                        + item-doc-est.valor-icm[1]
               de-base-ipi              =  de-base-ipi
                                        +  (item-doc-est.base-ipi[1]
                                        *  int(can-do("1,4", STRING(item-doc-est.cd-trib-ipi))))
                                        +  (item-doc-est.ipi-outras[1]
                                        *  int( item-doc-est.cd-trib-ipi = 3
                                           or ( item-doc-est.cd-trib-ipi = 1
                                           and item-doc-est.aliquota-ipi = 0)))
               de-vl-ipi                = de-vl-ipi
                                        + item-doc-est.valor-ipi[1]
               de-base-subs             = de-base-subs
                                        + item-doc-est.base-subs[1]
               de-vl-subs               = de-vl-subs
                                        + item-doc-est.vl-subs[1].

        RUN pi-gravar-dados-cfg-trib (input item-doc-est.serie-docto, input docum-est.embarque).

        find first tb-wt-it-docto NO-LOCK NO-ERROR.
        IF  AVAIL tb-wt-it-docto THEN DO:

            IF  NOT CAN-FIND(FIRST tb-ct-trib-wt-item-docto NO-LOCK 
                             WHERE tb-ct-trib-wt-item-docto.num-seq-wt-docto      = tb-wt-it-docto.seq-wt-docto
                               AND tb-ct-trib-wt-item-docto.num-seq-wt-item-docto = tb-wt-it-docto.seq-wt-it-docto
                               AND tb-ct-trib-wt-item-docto.cod-tip-trib          = "CBS":U) THEN DO:

                IF CAN-FIND(FIRST ordens-embarque-trib
                            WHERE ordens-embarque-trib.cod-estabel  = docum-est.cod-estabel
                              AND ordens-embarque-trib.embarque     = docum-est.embarque
                              AND ordens-embarque-trib.numero-ordem = item-doc-est.numero-ordem
                              AND ordens-embarque-trib.parcela      = item-doc-est.parcela
                              AND (   ordens-embarque-trib.nom-trib = "IBSUF":U
                                   OR ordens-embarque-trib.nom-trib = "IBSMUN":U
                                   OR ordens-embarque-trib.nom-trib = "CBS":U
                                   OR ordens-embarque-trib.nom-trib = "IS":U)
                              AND (   ordens-embarque-trib.cod-campo = "C-CLASS-TRIB":U
                                   OR ordens-embarque-trib.cod-campo = "CST":U
                                   OR ordens-embarque-trib.cod-campo = "UN-TRIBUT":U)
                              AND ordens-embarque-trib.cod-conteudo <> "" ) THEN DO:
                              
                    RUN createTtItemDocEstTributAux (INPUT "",
                                                     INPUT "",
                                                     INPUT "").
                END.
                ELSE DO:
                    RUN createTtItemDocEstTributAux (INPUT rep.imp.Imposto:IBS-MUN, 
                                                     INPUT "",
                                                     INPUT "").

                    RUN createTtItemDocEstTributAux (INPUT rep.imp.Imposto:IBS-UF, 
                                                     INPUT "",
                                                     INPUT "").

                    RUN createTtItemDocEstTributAux (INPUT rep.imp.Imposto:CBS, 
                                                     INPUT "",
                                                     INPUT "").
                    
                    RUN createTtItemDocEstTributAux (INPUT rep.imp.Imposto:IS, 
                                                     INPUT "",
                                                     INPUT "").
                END.
            END.
        END.
    END.    
    
    RETURN "OK":U.
END PROCEDURE.
  
PROCEDURE piAtualizaValoresNota:
/*------------------------------------------------------------------------------
    Procedure respons vel pela atualiza‡Æo dos valores da nota ap¢s 
    rec lculo dos impostos via Configurador de Tributos (boin090.m19)
------------------------------------------------------------------------------*/

    /* FCP */
    ASSIGN de-tot-val-fcp     = 0
           de-tot-base-fcp    = 0
           de-tot-val-fcp-st  = 0
           de-tot-base-fcp-st = 0.

    FOR EACH ext-item-doc-est NO-LOCK
       WHERE ext-item-doc-est.serie-docto  = docum-est.serie-docto 
         AND ext-item-doc-est.nro-docto    = docum-est.nro-docto   
         AND ext-item-doc-est.cod-emitente = docum-est.cod-emitente
         AND ext-item-doc-est.nat-operacao = docum-est.nat-operacao
         AND ext-item-doc-est.cod-param    = "FCP":U,
        FIRST item-doc-est EXCLUSIVE-LOCK
        WHERE item-doc-est.serie-docto  = ext-item-doc-est.serie-docto 
         AND  item-doc-est.nro-docto    = ext-item-doc-est.nro-docto   
         AND  item-doc-est.cod-emitente = ext-item-doc-est.cod-emitente
         AND  item-doc-est.nat-operacao = ext-item-doc-est.nat-operacao
         AND  item-doc-est.sequencia    = ext-item-doc-est.sequencia:

        /* Quando possui FCP, retira do valor e aliquota do ICMS o correspondente ao FCP para que o valor do ICMS nao fique "duplicado".*/
        /* Retirado a atualiza‡Æo para deixar igual as rotinas de nacionaliza‡Æo via DI/DUIMP e recebimento */ 
        /* ASSIGN item-doc-est.aliquota-icm = item-doc-est.aliquota-icm - ext-item-doc-est.val-livre-2
        *       item-doc-est.valor-icm[1] = item-doc-est.valor-icm[1] - ext-item-doc-est.val-livre-3. */

        ASSIGN de-tot-base-fcp    = de-tot-base-fcp    + ext-item-doc-est.val-livre-1
               de-tot-val-fcp     = de-tot-val-fcp     + ext-item-doc-est.val-livre-3
               de-tot-base-fcp-st = de-tot-base-fcp-st + ext-item-doc-est.val-livre-4
               de-tot-val-fcp-st  = de-tot-val-fcp-st  + ext-item-doc-est.val-livre-6.
    END.
    
    IF de-tot-base-fcp    <> 0 OR
       de-tot-val-fcp     <> 0 OR
       de-tot-base-fcp-st <> 0 OR
       de-tot-val-fcp-st  <> 0 THEN DO:

       FIND FIRST ext-docum-est EXCLUSIVE-LOCK
            WHERE ext-docum-est.serie-docto  = docum-est.serie-docto
              AND ext-docum-est.nro-docto    = docum-est.nro-docto
              AND ext-docum-est.cod-emitente = docum-est.cod-emitente
              AND ext-docum-est.nat-operacao = docum-est.nat-operacao
              AND ext-docum-est.cod-param    = "fcp":U NO-ERROR.
       IF NOT AVAIL ext-docum-est THEN DO:
           CREATE ext-docum-est.
           ASSIGN ext-docum-est.serie-docto  = docum-est.serie-docto
                  ext-docum-est.nro-docto    = docum-est.nro-docto
                  ext-docum-est.cod-emitente = docum-est.cod-emitente
                  ext-docum-est.nat-operacao = docum-est.nat-operacao
                  ext-docum-est.cod-param    = "fcp":U.
       END.

       ASSIGN ext-docum-est.val-livre-1  = de-tot-base-fcp    /*base fcp*/
              ext-docum-est.val-livre-3  = de-tot-val-fcp     /*valor fcp*/
              ext-docum-est.val-livre-4  = de-tot-base-fcp-st /*base fcp ST*/  
              ext-docum-est.val-livre-6  = de-tot-val-fcp-st. /*valor fcp ST*/ 
    END.
    /* FCP */

    /*Atualiza‡Æo dos impostos no documento de entrada*/
     ASSIGN docum-est.base-icm     = de-base-icm
            docum-est.icm-deb-cre  = de-vl-icm
            docum-est.base-ipi     = de-base-ipi
            docum-est.ipi-deb-cre  = de-vl-ipi
            docum-est.base-subs    = de-base-subs
            docum-est.vl-subs      = de-vl-subs
            docum-est.valor-outras = docum-est.valor-outras + docum-est.icm-deb-cre WHEN NOT l-nota-rateio
            docum-est.despesa-nota = docum-est.despesa-nota + docum-est.icm-deb-cre WHEN NOT l-nota-rateio
            docum-est.icm-deb-cre  = de-vl-icm - de-tot-val-fcp /* descontar o fcp so depois de utilizar para somar nas despesas */
            docum-est.tot-valor    = docum-est.valor-mercad
                                   + docum-est.despesa-nota
                                   + de-vl-ipi
                                   - docum-est.tot-desconto
                                   + de-vl-subs 
                                   + de-tot-val-fcp-st
                                   + docum-est.vl-pis-subs
                                   + docum-est.vl-cofins-subs.
                                           
    /*Retira do total da nota o valor do ICMS caso o parƒmetro "ICMS Tot NFe" 
      dos parƒmetros de importa‡Æo (IM0000) nÆo estiver marcado*/
    RUN imp/im9000.p( ROWID(docum-est) ).

    RETURN "OK":U.
END PROCEDURE.

PROCEDURE piInicializaHandle:
/*------------------------------------------------------------------------------
    Inicializa handles 
------------------------------------------------------------------------------*/
    IF NOT VALID-HANDLE(h_bodi317im2bra) THEN 
    RUN dibo/bodi317im2bra.p PERSISTENT SET h_bodi317im2bra.
    
    IF NOT VALID-HANDLE(h-cdcfgfiscal) then 
       run cdp/cdcfgfiscal.p persistent set h-cdcfgfiscal. 
    
    IF NOT VALID-HANDLE(h-bodi613calc2) THEN
        RUN dibo/bodi613calc2.p PERSISTENT SET h-bodi613calc2. 

    IF NOT VALID-HANDLE(h-boin01017) THEN 
       RUN inbo/boin01017.p PERSISTENT SET h-boin01017.
       
    IF NOT VALID-HANDLE(h-boin176) THEN
       RUN inbo/boin176.p PERSISTENT SET h-boin176.  
       
    IF NOT VALID-HANDLE(h-cdapi995) THEN 
       RUN cdp/cdapi995.p PERSISTENT SET h-cdapi995.
        
    RETURN "OK":U.
END PROCEDURE.

PROCEDURE piFinalizaHandle:
/*------------------------------------------------------------------------------
    Finaliza handles 
------------------------------------------------------------------------------*/
    IF VALID-HANDLE(h_bodi317im2bra) THEN DO:
       DELETE PROCEDURE h_bodi317im2bra.
       ASSIGN h_bodi317im2bra = ?.
    END.      
    
    IF VALID-HANDLE(h-bodi613calc2) THEN DO:
       DELETE PROCEDURE h-bodi613calc2.
       ASSIGN h-bodi613calc2 = ?.
    END. 
    
    IF VALID-HANDLE(h-cdcfgfiscal) THEN DO:
       DELETE PROCEDURE h-cdcfgfiscal.
       ASSIGN h-cdcfgfiscal = ?.
    END.

    IF VALID-HANDLE(h-boin01017) THEN DO:
       DELETE PROCEDURE h-boin01017.
       ASSIGN h-boin01017 = ?.
    END.

    IF VALID-HANDLE(h-boin176) THEN DO:
        DELETE PROCEDURE h-boin176.
        ASSIGN h-boin176 = ?.
    END.   
    
    IF VALID-HANDLE(h-cdapi995) THEN DO:
       DELETE PROCEDURE h-cdapi995.
       ASSIGN h-cdapi995 = ?.
    END.            
            
    RETURN "OK":U.
END PROCEDURE.
              
PROCEDURE createTbWtDocto :
/*------------------------------------------------------------------------------
Criacao da temp-table tb-wt-docto para calculo dos impostos.      
------------------------------------------------------------------------------*/
       DEF INPUT PARAM p-serie-docto   LIKE docum-est.serie-docto   NO-UNDO.
       DEF INPUT PARAM p-nro-docto     LIKE docum-est.nro-docto     NO-UNDO.
       DEF INPUT PARAM p-cod-emitente  LIKE docum-est.cod-emitente  NO-UNDO.
       DEF INPUT PARAM p-nat-operacao  LIKE docum-est.nat-operacao  NO-UNDO.
       
       EMPTY TEMP-TABLE tb-wt-docto.
       FOR FIRST tt-docto
            WHERE tt-docto.serie           = p-serie-docto 
              AND tt-docto.nr-nota         = p-nro-docto   
              AND tt-docto.cod-emitente    = p-cod-emitente
              AND tt-docto.nat-operacao    = p-nat-operacao NO-LOCK:
       END.
       FIND FIRST tb-wt-docto
            WHERE tb-wt-docto.seq-wt-docto = 1 NO-LOCK NO-ERROR.
       IF NOT AVAIL tb-wt-docto THEN DO:
           CREATE tb-wt-docto.
           BUFFER-COPY tt-docto TO tb-wt-docto.
           ASSIGN tb-wt-docto.seq-wt-docto = 1.
       END.
  
    RETURN "OK":U.
END PROCEDURE.

PROCEDURE createTbWtItDoctoImposto :
/*------------------------------------------------------------------------------
Criacao da temp-table tb-wt-it-docto e tb-wt-it-imposto para calculo dos impostos.      
------------------------------------------------------------------------------*/

    EMPTY TEMP-TABLE tb-wt-it-docto.
    EMPTY TEMP-TABLE tb-wt-it-imposto.
    EMPTY TEMP-TABLE tb-ct-trib-wt-item-docto.
        
    FIND FIRST tb-wt-it-docto
         WHERE tb-wt-it-docto.seq-wt-docto    = 1
           AND tb-wt-it-docto.seq-wt-it-docto = tt-it-docto.nr-sequencia NO-LOCK NO-ERROR.
    IF NOT AVAIL tb-wt-it-docto THEN DO:  
        CREATE tb-wt-it-docto.
        BUFFER-COPY tt-it-docto 
               EXCEPT tt-it-docto.desconto 
                      tt-it-docto.nat-operacao TO tb-wt-it-docto.
        ASSIGN tb-wt-it-docto.seq-wt-docto        = 1                        
               tb-wt-it-docto.seq-wt-it-docto     = tt-it-docto.nr-sequencia
               tb-wt-it-docto.desconto[1]         = tt-it-docto.desconto
               overlay(tb-wt-it-docto.char-1,1,6) = "IM7777":U
               tb-wt-it-docto.nat-operacao        = IF l-mult-natur-receb 
                                                    AND tt-it-docto.nat-of <> "" THEN /* Se usa Multi. Naturezas e ela foi informada: usa ela */
                                                       tt-it-docto.nat-of 
                                                    ELSE tt-it-docto.nat-operacao. /* SenÆo usa a natureza da nota. */
                                                
    END.
  
    /*cria‡Æo registro wt-it-imposto para carregar informa‡äes da configura‡Æo de tributo*/
    FOR FIRST tt-it-imposto
        WHERE tt-it-imposto.seq-tt-it-docto = tt-it-docto.seq-tt-it-docto NO-LOCK:
        FIND FIRST tb-wt-it-imposto
             WHERE tb-wt-it-imposto.seq-wt-docto    = 1
               AND tb-wt-it-imposto.seq-wt-it-docto = tt-it-docto.nr-sequencia NO-LOCK NO-ERROR.
        IF NOT AVAIL tb-wt-it-imposto THEN DO:
            CREATE tb-wt-it-imposto.
            BUFFER-COPY tt-it-imposto TO tb-wt-it-imposto.
            ASSIGN tb-wt-it-imposto.seq-wt-docto    = 1
                   tb-wt-it-imposto.seq-wt-it-docto = tt-it-docto.nr-sequencia.
                                      
        END.
    END.
    
    /* Reforma Tribut ria */
    if l-nt2024002 then do:
        FIND tb-wt-it-impostoCBSIBS EXCLUSIVE-LOCK 
            WHERE tb-wt-it-impostoCBSIBS.seq-wt-docto    = 1
              AND tb-wt-it-impostoCBSIBS.seq-wt-it-docto = tt-it-docto.nr-sequencia NO-ERROR.
        IF NOT AVAIL tb-wt-it-impostoCBSIBS THEN DO:
            CREATE tb-wt-it-impostoCBSIBS.
            ASSIGN tb-wt-it-impostoCBSIBS.seq-wt-docto    = 1
                   tb-wt-it-impostoCBSIBS.seq-wt-it-docto = tt-it-docto.nr-sequencia.
        END.
    end.
  
    RETURN "OK":U.
END PROCEDURE.


PROCEDURE createTtItemDocEstTribut:
    DEFINE INPUT PARAMETER pNomTribut AS CHARACTER   NO-UNDO.
    DEFINE INPUT PARAMETER pCodCampo  AS CHARACTER   NO-UNDO.
    DEFINE INPUT PARAMETER pconteudo  AS CHARACTER   NO-UNDO.

    FIND FIRST tt-item-doc-est-tribut EXCLUSIVE-LOCK
         WHERE tt-item-doc-est-tribut.cod-serie-docto    = item-doc-est.serie-docto    
         AND   tt-item-doc-est-tribut.cod-num-docto      = item-doc-est.nro-docto      
         AND   tt-item-doc-est-tribut.cdn-emitente       = item-doc-est.cod-emitente   
         AND   tt-item-doc-est-tribut.cod-natur-operac   = item-doc-est.nat-operacao   
         AND   tt-item-doc-est-tribut.num-seq            = item-doc-est.sequencia      
         AND   tt-item-doc-est-tribut.nom-trib           = pNomTribut               
         AND   tt-item-doc-est-tribut.cod-campo          = pCodCampo  NO-ERROR.
    IF NOT AVAIL tt-item-doc-est-tribut THEN DO:
       CREATE tt-item-doc-est-tribut.
       ASSIGN tt-item-doc-est-tribut.cod-serie-docto     = item-doc-est.serie-docto
              tt-item-doc-est-tribut.cod-num-docto       = item-doc-est.nro-docto
              tt-item-doc-est-tribut.cdn-emitente        = item-doc-est.cod-emitente
              tt-item-doc-est-tribut.cod-natur-operac    = item-doc-est.nat-operacao
              tt-item-doc-est-tribut.num-seq             = item-doc-est.sequencia
              tt-item-doc-est-tribut.nom-trib            = pNomTribut
              tt-item-doc-est-tribut.cod-campo           = pCodCampo.
    END.
    
    ASSIGN tt-item-doc-est-tribut.cod-conteudo = pconteudo.
    
    IF l-nt2024002
    AND (   pNomTribut = rep.imp.Imposto:IBS-UF
         OR pNomTribut = rep.imp.Imposto:IBS-MUN
         OR pNomTribut = rep.imp.Imposto:CBS
         OR pNomTribut = rep.imp.Imposto:IS)
    AND pCodCampo <> rep.imp.AtributoImposto:C-CLASS-TRIB
    AND pCodCampo <> rep.imp.AtributoImposto:CST
    AND pCodCampo <> rep.imp.AtributoImposto:C-CLASS-TRIB-REG
    AND pCodCampo <> rep.imp.AtributoImposto:CST-REG
    AND NOT CAN-FIND(FIRST tt-item-doc-est-tribut 
                     WHERE tt-item-doc-est-tribut.cod-serie-docto  = item-doc-est.serie-docto    
                       AND tt-item-doc-est-tribut.cod-num-docto    = item-doc-est.nro-docto      
                       AND tt-item-doc-est-tribut.cdn-emitente     = item-doc-est.cod-emitente   
                       AND tt-item-doc-est-tribut.cod-natur-operac = item-doc-est.nat-operacao   
                       AND tt-item-doc-est-tribut.num-seq          = item-doc-est.sequencia      
                       AND tt-item-doc-est-tribut.nom-trib         = pNomTribut
                       AND tt-item-doc-est-tribut.cod-campo        = rep.imp.AtributoImposto:C-CLASS-TRIB) THEN DO:

        RUN createTtItemDocEstTributAux (INPUT pNomTribut,
                                         INPUT pCodCampo,
                                         INPUT pconteudo).
    END.
    
    RETURN "OK":U.
END PROCEDURE.    

PROCEDURE createTtItemDocEstTributAux:
    DEFINE INPUT PARAMETER pNomTribut AS CHARACTER   NO-UNDO.
    DEFINE INPUT PARAMETER pCodCampo  AS CHARACTER   NO-UNDO.
    DEFINE INPUT PARAMETER pconteudo  AS CHARACTER   NO-UNDO.

    DEFINE VARIABLE pcClassTrib       AS CHAR        NO-UNDO.
    DEFINE VARIABLE pcCST             AS CHAR        NO-UNDO.
    DEFINE VARIABLE pcClassTribReg    AS CHAR        NO-UNDO.
    DEFINE VARIABLE pcCSTReg          AS CHAR        NO-UNDO.
    DEFINE VARIABLE c-cod-nbs         AS CHAR        NO-UNDO.

    IF CAN-FIND(FIRST ordens-embarque-trib
                WHERE ordens-embarque-trib.cod-estabel  = docum-est.cod-estabel
                  AND ordens-embarque-trib.embarque     = docum-est.embarque
                  AND ordens-embarque-trib.numero-ordem = item-doc-est.numero-ordem
                  AND ordens-embarque-trib.parcela      = item-doc-est.parcela
                  AND (   ordens-embarque-trib.nom-trib = "IBSUF":U
                       OR ordens-embarque-trib.nom-trib = "IBSMUN":U
                       OR ordens-embarque-trib.nom-trib = "CBS":U
                       OR ordens-embarque-trib.nom-trib = "IS":U)
                  AND (   ordens-embarque-trib.cod-campo = "C-CLASS-TRIB":U
                       OR ordens-embarque-trib.cod-campo = "CST":U
                       OR ordens-embarque-trib.cod-campo = "UN-TRIBUT":U)
                  AND ordens-embarque-trib.cod-conteudo <> "" ) THEN DO:
        
        FOR EACH ordens-embarque-trib NO-LOCK
           WHERE ordens-embarque-trib.cod-estabel  = docum-est.cod-estabel
             AND ordens-embarque-trib.embarque     = docum-est.embarque
             AND ordens-embarque-trib.numero-ordem = item-doc-est.numero-ordem
             AND ordens-embarque-trib.parcela      = item-doc-est.parcela
             AND (   ordens-embarque-trib.nom-trib = "IBSUF":U
                  OR ordens-embarque-trib.nom-trib = "IBSMUN":U
                  OR ordens-embarque-trib.nom-trib = "CBS":U
                  OR ordens-embarque-trib.nom-trib = "IS":U)
             AND (   ordens-embarque-trib.cod-campo = "C-CLASS-TRIB":U
                  OR ordens-embarque-trib.cod-campo = "CST":U
                  OR ordens-embarque-trib.cod-campo = "C-CLASS-TRIB-REG":U
                  OR ordens-embarque-trib.cod-campo = "CST-REG":U
                  OR ordens-embarque-trib.cod-campo = "UN-TRIBUT":U):
            
            IF ordens-embarque-trib.nom-trib = "IBSUF":U THEN DO:
                IF ordens-embarque-trib.cod-campo = "C-CLASS-TRIB":U THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, 
                                                  INPUT rep.imp.AtributoImposto:C-CLASS-TRIB,
                                                  INPUT ordens-embarque-trib.cod-conteudo).
                IF ordens-embarque-trib.cod-campo = "CST":U THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, 
                                                  INPUT rep.imp.AtributoImposto:CST,
                                                  INPUT ordens-embarque-trib.cod-conteudo).
                IF ordens-embarque-trib.cod-campo = "C-CLASS-TRIB-REG":U THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, 
                                                  INPUT rep.imp.AtributoImposto:C-CLASS-TRIB-REG,
                                                  INPUT ordens-embarque-trib.cod-conteudo).
                IF ordens-embarque-trib.cod-campo = "CST-REG":U THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-UF, 
                                                  INPUT rep.imp.AtributoImposto:CST-REG,
                                                  INPUT ordens-embarque-trib.cod-conteudo).
            END.
            IF ordens-embarque-trib.nom-trib = "IBSMUN":U THEN DO:
                IF ordens-embarque-trib.cod-campo = "C-CLASS-TRIB":U THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, 
                                                  INPUT rep.imp.AtributoImposto:C-CLASS-TRIB,
                                                  INPUT ordens-embarque-trib.cod-conteudo).
                IF ordens-embarque-trib.cod-campo = "CST":U THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, 
                                                  INPUT rep.imp.AtributoImposto:CST,
                                                  INPUT ordens-embarque-trib.cod-conteudo).
                IF ordens-embarque-trib.cod-campo = "C-CLASS-TRIB-REG":U THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, 
                                                  INPUT rep.imp.AtributoImposto:C-CLASS-TRIB-REG,
                                                  INPUT ordens-embarque-trib.cod-conteudo).
                IF ordens-embarque-trib.cod-campo = "CST-REG":U THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IBS-MUN, 
                                                  INPUT rep.imp.AtributoImposto:CST-REG,
                                                  INPUT ordens-embarque-trib.cod-conteudo).
            END.
            IF ordens-embarque-trib.nom-trib = "CBS":U THEN DO:
                IF ordens-embarque-trib.cod-campo = "C-CLASS-TRIB":U THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, 
                                                  INPUT rep.imp.AtributoImposto:C-CLASS-TRIB,
                                                  INPUT ordens-embarque-trib.cod-conteudo).
                IF ordens-embarque-trib.cod-campo = "CST":U THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, 
                                                  INPUT rep.imp.AtributoImposto:CST,
                                                  INPUT ordens-embarque-trib.cod-conteudo).
                IF ordens-embarque-trib.cod-campo = "C-CLASS-TRIB-REG":U THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, 
                                                  INPUT rep.imp.AtributoImposto:C-CLASS-TRIB-REG,
                                                  INPUT ordens-embarque-trib.cod-conteudo).
                IF ordens-embarque-trib.cod-campo = "CST-REG":U THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:CBS, 
                                                  INPUT rep.imp.AtributoImposto:CST-REG,
                                                  INPUT ordens-embarque-trib.cod-conteudo).
            END.
            IF ordens-embarque-trib.nom-trib = "IS":U THEN DO:
                IF ordens-embarque-trib.cod-campo = "C-CLASS-TRIB":U THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, 
                                                  INPUT rep.imp.AtributoImposto:C-CLASS-TRIB,
                                                  INPUT ordens-embarque-trib.cod-conteudo).
                IF ordens-embarque-trib.cod-campo = "CST":U THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, 
                                                  INPUT rep.imp.AtributoImposto:CST,
                                                  INPUT ordens-embarque-trib.cod-conteudo).
                IF ordens-embarque-trib.cod-campo = "UN-TRIBUT":U THEN
                    RUN createTtItemDocEstTribut (INPUT rep.imp.Imposto:IS, 
                                                  INPUT rep.imp.AtributoImposto:UN-TRIBUT,
                                                  INPUT ordens-embarque-trib.cod-conteudo).
            END.
        END.
    END.
    ELSE DO:
        ASSIGN c-cod-nbs = "".

        IF  CAN-FIND(FIRST natur-oper NO-LOCK
                     WHERE natur-oper.nat-operacao = item-doc-est.nat-operacao
                     AND  (natur-oper.cod-model-nf-eletro = "56" OR natur-oper.log-nfse-nacional)) THEN DO:

            ASSIGN c-cod-nbs = TRIM(SUBSTR(item-doc-est.char-2,956,20)).

            IF  c-cod-nbs = "" OR c-cod-nbs = ? THEN DO:
                for first item no-lock
                    where item.it-codigo = item-doc-est.it-codigo:
                end.
                FOR FIRST cotacao-item NO-LOCK
                    WHERE cotacao-item.numero-ordem = item-doc-est.numero-ordem 
                      AND cotacao-item.cot-aprovada = YES:
                END.
                ASSIGN c-cod-nbs = IF AVAIL cotacao-item AND TRIM(SUBSTRING(cotacao-item.char-1,101,20)) <> ""
                                   THEN TRIM(SUBSTRING(cotacao-item.char-1,101,20))
                                   ELSE IF AVAIL item AND SUBSTRING(item.char-1,342,20) <> ?
                                   THEN SUBSTRING(item.char-1,342,20)
                                   ELSE "".
                       c-cod-nbs = IF c-cod-nbs <> ""
                                   THEN c-cod-nbs
                                   ELSE '*'.
            END.
        END.

        IF NOT VALID-HANDLE(h-imapi017) THEN
            RUN imp/imapi017.p PERSISTENT SET h-imapi017.

        RUN piEnviaCodNBS IN h-imapi017 (INPUT c-cod-nbs).
        RUN pi-sugere-cClassTrib IN h-imapi017 (INPUT docum-est.cod-estabel,
                                                INPUT item-doc-est.nat-operacao,
                                                INPUT item-doc-est.it-codigo,
                                                INPUT item-doc-est.cod-emitente,
                                                OUTPUT pcClassTrib,
                                                OUTPUT pcCST,
                                                OUTPUT pcClassTribReg,
                                                OUTPUT pcCSTReg).
                                                
        FIND FIRST item NO-LOCK
             WHERE item.it-codigo = item-doc-est.it-codigo NO-ERROR.
             
        IF (pNomTribut = "IS" AND SUBSTRING(item.char-1,289,1) = "S" /* Incide IS */ )
        OR pNomTribut <> "IS" THEN DO:
            RUN createTtItemDocEstTribut (INPUT pNomTribut, 
                                          INPUT rep.imp.AtributoImposto:C-CLASS-TRIB,
                                          INPUT pcClassTrib).

            RUN createTtItemDocEstTribut (INPUT pNomTribut, 
                                          INPUT rep.imp.AtributoImposto:CST,
                                          INPUT pcCST).
            IF pNomTribut = "IS" THEN
                RUN createTtItemDocEstTribut (INPUT pNomTribut, 
                                              INPUT rep.imp.AtributoImposto:UN-TRIBUT,
                                              INPUT SUBSTRING(item.char-1,290,2)).
        END.
        
        IF  pNomTribut <> "IS" 
        AND pcClassTribReg <> "":U THEN DO:
            RUN createTtItemDocEstTribut (INPUT pNomTribut, 
                                          INPUT rep.imp.AtributoImposto:C-CLASS-TRIB-REG,
                                          INPUT pcClassTribReg).
                  
            RUN createTtItemDocEstTribut (INPUT pNomTribut, 
                                          INPUT rep.imp.AtributoImposto:CST-REG,
                                          INPUT pcCSTReg).
        END.
    END.
    
    RETURN "OK":U.
END PROCEDURE.    

