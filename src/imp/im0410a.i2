    FIELD c-class-trib-ibs-uf-reg           LIKE decla-import-ord-trib.cod-conteudo
    FIELD c-cst-ibs-uf-reg                  LIKE decla-import-ord-trib.cod-conteudo
    FIELD de-aliq-ibs-uf-reg                LIKE decla-import-ord-trib.cod-conteudo
    FIELD c-class-trib-ibs-mun-reg          LIKE decla-import-ord-trib.cod-conteudo
    FIELD c-cst-ibs-mun-reg                 LIKE decla-import-ord-trib.cod-conteudo
    FIELD de-aliq-ibs-mun-reg               LIKE decla-import-ord-trib.cod-conteudo
    FIELD c-class-trib-cbs-reg              LIKE decla-import-ord-trib.cod-conteudo
    FIELD c-cst-cbs-reg                     LIKE decla-import-ord-trib.cod-conteudo
    FIELD de-aliq-cbs-reg                   LIKE decla-import-ord-trib.cod-conteudo.
