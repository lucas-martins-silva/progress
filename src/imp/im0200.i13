/************************************************************************************
**
** IM0200.i13 - Verifica quais declara‡äes devem ser impressas (Importa‡Æo) - 
**
*************************************************************************************/

/* Parametros ***********************************************************************
{1} - historico-proc-imp/historico-proc-emb
{2} - proc-imp/embarq-imp
*************************************************************************************/

/* int-1 -> emite-decl-docum
   int-2 -> dias-tolerancia */
   
assign l-imprime     = no
       i-dt-ult-prev = 0.   

case decl-hist-{2}.int-1:
    /* Processo/Embarque Atrasado */    
    when 1 then do:
        if {1}.dt-efetiva <> ? then do:
            if ({1}.dt-ult-previsao + decl-hist-{2}.int-2) < {1}.dt-efetiva then 
                assign l-imprime = yes.
        end.        
        else do:
             if ({1}.dt-ult-previsao + decl-hist-{2}.int-2) < today then
                 assign l-imprime = yes.
        end.         
    end.
    /* Processo/Embarque Adiantado */
    when 2 then do:
        if {1}.dt-efetiva < ({1}.dt-ult-previsao - decl-hist-{2}.int-2) then
            assign l-imprime = yes.
    end.    
    /* Processo/Embarque no Prazo */
    when 3 then do:
        if {1}.dt-efetiva <> ? then do:
           if   {1}.dt-efetiva < {1}.dt-ult-previsao then do:
                assign i-dt-ult-prev = {1}.dt-ult-previsao - {1}.dt-efetiva.
                if i-dt-ult-prev < 0 then
                   assign i-dt-ult-prev = i-dt-ult-prev * (- 1).
                   
                if i-dt-ult-prev <= decl-hist-{2}.int-2 then
                   assign l-imprime = yes.
           end.        
           else do:
                assign i-dt-ult-prev = {1}.dt-efetiva - {1}.dt-ult-previsao.
                if i-dt-ult-prev < 0 then
                   assign i-dt-ult-prev = i-dt-ult-prev * (- 1).
                   
                if i-dt-ult-prev <= decl-hist-{2}.int-2 then
                    assign l-imprime = yes.
           end.
        end.
        else do:
            assign i-dt-ult-prev = {1}.dt-ult-previsao - today.
            
            if i-dt-ult-prev < 0 then
                assign i-dt-ult-prev = i-dt-ult-prev * (- 1).

            if i-dt-ult-prev <= decl-hist-{2}.int-2 then
                assign l-imprime = yes.
        end.
    end.          
    /* Processo/Embarque fora do Prazo */   
    when 4 then do:       
        if   {1}.dt-efetiva <> ? then do:
            if   {1}.dt-efetiva < {1}.dt-ult-previsao then do:
                 assign i-dt-ult-prev = {1}.dt-ult-previsao - {1}.dt-efetiva.
                 if i-dt-ult-prev < 0 then
                    assign i-dt-ult-prev = i-dt-ult-prev * (- 1).
                    
                 if i-dt-ult-prev > decl-hist-{2}.int-2 then
                    assign l-imprime = yes.
            end.        
            else do:
                 if {1}.dt-efetiva - {1}.dt-ult-previsao > decl-hist-{2}.int-2 then
                     assign l-imprime = yes.
            end.
        end.     
        else do:
             assign i-dt-ult-prev = {1}.dt-ult-previsao - today.
             if i-dt-ult-prev < 0 then
                assign i-dt-ult-prev = i-dt-ult-prev * (- 1).
                
             if i-dt-ult-prev > decl-hist-{2}.int-2 then
                 assign l-imprime = yes.
        end.
    end.   
    /* Sempre Emite */
    when 5 then do:
       if {1}.dt-efetiva <> ? then
          assign l-imprime = yes.
    end.    
end case.            

/* IM0200.I13 */

