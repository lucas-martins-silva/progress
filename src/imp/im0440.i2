/*-------------------------------------------------------------------------------------------------------------------------------------------------------------------*/    
    /*cabecalho principal*/
    DISP tt-decla-import.num-di-ems
         tt-decla-import.cod-estab                                                 
         tt-decla-import.cod-di-siscomex                                  
         tt-decla-import.dat-di                                             
         tt-decla-import.dat-retif                                          
         tt-decla-import.idi-motiv-retif    
        WITH FRAME f_cabec1.     
    
    PUT UNFORMATTED fill("-", 132) format "x(132)".
    /*fim cabecalho principal*/

    /*Principal DI*/
    VIEW FRAME f-cabecPrinDi. 
    
    FOR FIRST estabelec 
        WHERE estabelec.cod-estabel = tt-decla-import.cod-estab NO-LOCK:
        ASSIGN c-cgc = estabelec.cgc
               c-cgc = STRING(c-cgc,param-global.formato-id-federal).
    END.

    FOR FIRST emitente 
        WHERE emitente.cod-emitente = tt-decla-import.cdn-consign NO-LOCK:
        ASSIGN c-consig   = string(tt-decla-import.cdn-consign) + " - " + string(emitente.nome-abrev)
               c-cgc-emit = emitente.cgc
               c-cgc-emit = STRING(c-cgc-emit,param-global.formato-id-federal).
    END.
    IF NOT AVAIL emitente THEN
        ASSIGN c-consig = string(tt-decla-import.cdn-consign).

    IF  INT(SUBSTRING(tt-decla-import.cod-livre-1,3,9)) <> 0 THEN DO:
        FOR FIRST emitente FIELDS (nome-abrev)
            WHERE emitente.cod-emitente = int(substring(tt-decla-import.cod-livre-1,3,9)) NO-LOCK:
            ASSIGN c-desp   = trim(substring(tt-decla-import.cod-livre-1,3,9)) + " - " + string(emitente.nome-abrev).
        END.
        IF NOT AVAIL emitente THEN
            ASSIGN c-desp = substring(tt-decla-import.cod-livre-1,3,9).
    END.
    ELSE DO:
        ASSIGN c-desp = "":U.
    END.
 
    FOR FIRST natur-oper 
        WHERE natur-oper.nat-operacao = tt-decla-import.cod-natur-operac NO-LOCK:
        ASSIGN c-natur-opera = tt-decla-import.cod-natur-operac + " - " + natur-oper.denominacao.
    END.
    IF NOT AVAIL natur-oper THEN
        ASSIGN c-natur-opera = tt-decla-import.cod-natur-operac.
        
    ASSIGN c-tipo-decla     = {cxinc/i02cx383.i 04 tt-decla-import.idi-tip-decla-import}
           c-carac-oper     = {cxinc/i03cx383.i 04 tt-decla-import.idi-caract-operac}   
           c-modal-despach  = {cxinc/i04cx383.i 04 tt-decla-import.idi-modalid-despch}.
    
    DISP c-cgc                      
         c-tipo-decla               
         c-carac-oper               
         c-consig when tt-decla-import.cdn-consign > 0                  
         c-cgc-emit when tt-decla-import.idi-caract-operac <> 1 OR tt-decla-import.cdn-consign > 0
         c-desp                
         tt-decla-import.log-fundap 
         c-modal-despach            
         tt-decla-import.num-adicoes
         c-natur-opera             
        WITH FRAME f-PrinDi.
    /*fim Principal DI*/
    
    /*Observacoes*/
    IF  l-Obervacoes <> NO THEN DO:
        VIEW FRAME f-cabecObsDi.
       
        ASSIGN c-observacao = TRIM(tt-decla-import.cod-inf-compltar).
        RUN pi-print-editor(c-observacao, 132).
        FOR EACH tt-editor:
            PUT UNFORMATTED tt-editor.conteudo FORMAT "X(132)" AT 001.
        END.
    END.
    /*fim observacoes*/

    /*Basicas DI e Cotacoes*/
    VIEW FRAME f-cabecBasiCota.
    
    DISP lb-moeda                           
         lb-cotacao                         
         tt-decla-import.cdn-urf-entr       
         tt-decla-import.cdn-urf-despch    
         "------------------ ----------------" @ lb-separador
        WITH FRAME f-BasiCota.
    
    
    FOR EACH tt-decla-imp-cotac WHERE tt-decla-imp-cotac.num-di-ems       = tt-decla-import.num-di-ems
                                and   tt-decla-imp-cotac.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts:
        
        ASSIGN c-moeda = string(tt-decla-imp-cotac.cdn-moed).
        FIND FIRST moeda 
            WHERE moeda.mo-codigo = tt-decla-imp-cotac.cdn-moed NO-LOCK NO-ERROR.
        ASSIGN c-moeda = c-moeda + " - " + moeda.descricao WHEN AVAIL moeda.

        DISP c-moeda
             tt-decla-imp-cotac.val-cotac
            WITH FRAME f-moeda.
            DOWN WITH FRAME f-moeda.
    END.
    /*Fim Basicas DI e Cotacoes*/

    /*Processo Vinculado*/
    IF CAN-FIND(FIRST tt-decla-import-proc
                WHERE tt-decla-import-proc.num-di-ems       = tt-decla-import.num-di-ems
                and   tt-decla-import-proc.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts) THEN DO:

        VIEW FRAME f-cabecProcVinc.
        FOR EACH tt-decla-import-proc
            WHERE tt-decla-import-proc.num-di-ems       = tt-decla-import.num-di-ems
            and   tt-decla-import-proc.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts:
    
            IF AVAIL tt-decla-import-proc THEN DO:
                CASE tt-decla-import-proc.desc-tipo:
                    WHEN "1" THEN
                        ASSIGN tt-decla-import-proc.desc-tipo = "Administrativo".
                    WHEN "2" THEN
                        ASSIGN tt-decla-import-proc.desc-tipo = "Judicial".
                    WHEN "3" THEN
                        ASSIGN tt-decla-import-proc.desc-tipo = "Declara‡Æo Preliminar".
                    WHEN "4" THEN
                        ASSIGN tt-decla-import-proc.desc-tipo = "Judicial Exclusivo DARF".
                END CASE.
            END.
    
            DISP tt-decla-import-proc.desc-tipo 
                 tt-decla-import-proc.cod-proces-vincul          
                WITH FRAME f-ProcVinc.
                DOWN WITH FRAME f-ProcVinc.
        END.
    END.
    /*fim processo vinculado*/

    
    
    /*Transporte DI*/
    IF  tt-param.l-transporte <> NO THEN DO:
        find first pais 
                where cod-pais = tt-decla-import.cdn-pais-proceden no-lock no-error.
        if avail pais then
                assign c-pais-transp = pais.nome-pais.
        else
                assign c-pais-transp = "".
        VIEW FRAME f-cabecTransDi.
        DISP {cxinc/i06cx383.i 04 tt-decla-import.idi-docto-carg}    @ c-doc-cheg-carg                    
             {adinc/i01ad268.i 04 tt-decla-import.idi-via-transp-di} @ c-via-transp                       
             tt-decla-import.cod-identif        
             tt-decla-import.cdn-transp when tt-decla-import.cdn-transp > 0
             {cxinc/i07cx383.i 04 tt-decla-import.idi-tip-conhecto}  @ c-tipo-conhe-transp                
             c-pais-transp /*tt-decla-import.cdn-pais-proceden  */
             tt-decla-import.cod-conhecto-master
             {cxinc/i08cx383.i 04 tt-decla-import.idi-ind-utiliz}    @ tt-decla-import.idi-ind-utiliz     
             tt-decla-import.cod-conhecto-house 
            WITH FRAME f-transDi.
    END.
    /*fim transporte DI*/


    /*####### Pagina 2 ###########*/

    /*Carga DI*/
    VIEW FRAME f-cabecCargaDi.
    
    find first pais 
        where  pais.cod-pais = tt-decla-import.cdn-pais-proceden no-lock no-error.
    if  avail pais then
        assign c-pais-proceden = string(tt-decla-import.cdn-pais-proceden) + " - " + pais.nome-pais + "(" + string(pais.cod-pais-siscomex) + ")".
    else
        assign c-pais-proceden = "".     
        
    find first emitente
        where  emitente.cod-emitente = tt-decla-import.cdn-agent-carg-import no-lock no-error.
    if  avail emitente then
        assign c-agent-transp = substring(emitente.nome-emit,1,50)
               c-cnpj-agente-transp = STRING(emitente.cgc,param-global.formato-id-federal).
    else
        assign c-agent-transp = "".
    
    DISP c-pais-proceden
         c-agent-transp
         tt-decla-import.val-peso-liq-di     
         c-cnpj-agente-transp
         tt-decla-import.val-peso-brut-merc  
         tt-decla-import.cdn-recinto-alfand  
         tt-decla-import.val-peso-embal-di   
         tt-decla-import.cdn-setor-armaz     
         tt-decla-import.val-peso-brut-tot-di
      WITH FRAME f-cargaDi.
    /*fim carga di*/

    /*Embalagem*/
    IF CAN-FIND(FIRST tt-decla-imp-embal
                WHERE tt-decla-imp-embal.num-di-ems       = tt-decla-import.num-di-ems
                and   tt-decla-imp-embal.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts) THEN DO:
        VIEW FRAME f-cabecEmbalagem.
        
        FOR EACH tt-decla-imp-embal
            WHERE tt-decla-imp-embal.num-di-ems       = tt-decla-import.num-di-ems
            and   tt-decla-imp-embal.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts:
            FIND FIRST embalag WHERE embalag.sigla-emb = tt-decla-imp-embal.cod-sig-embal NO-LOCK NO-ERROR.
            DISP tt-decla-imp-embal.qtd-vol-embal  
                 tt-decla-imp-embal.cod-sig-embal  
                 embalag.descricao
               with frame f-embalagem.
               DOWN WITH FRAME f-embalagem.
        END.
     END.
    /*Fim embalagem*/
    
    /*Itiner rio DI*/
    IF tt-param.l-Itinerario <> NO THEN DO:
        IF CAN-FIND(FIRST tt-histor-di
                    WHERE tt-histor-di.num-di-ems       = tt-decla-import.num-di-ems
                    and   tt-histor-di.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts) THEN DO:
            
            VIEW FRAME f-cabecItinDi.
            FOR EACH tt-histor-di 
                WHERE tt-histor-di.num-di-ems       = tt-decla-import.num-di-ems
                and   tt-histor-di.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts:
                    
                FIND FIRST pto-contr WHERE pto-contr.cod-pto-contr = tt-histor-di.cdn-pto-control NO-LOCK NO-ERROR.
                FOR FIRST histor-decla-import fields(descricao) no-lock
                    WHERE histor-decla-import.num-di-ems       = tt-decla-import.num-di-ems
                      and histor-decla-import.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts
                      AND histor-decla-import.cdn-pto-contr    = tt-histor-di.cdn-pto-control:
                end. 
                ASSIGN c-dsl-obs = tt-histor-di.dsl-obs
                       c-pto-desc = if avail histor-decla-import and histor-decla-import.descricao <> "":U then histor-decla-import.descricao else if avail pto-contr then pto-contr.descricao else "":U.
        
                DISP tt-histor-di.num-seq         
                     tt-histor-di.cdn-pto-control 
                     c-pto-desc                   
                     tt-histor-di.dat-prev-origin 
                     tt-histor-di.dat-ult-prev    
                     tt-histor-di.dat-efetiva                      
                     tt-histor-di.cod-meio-transp 
                     c-dsl-obs
                WITH FRAME f-itinDi.
                DOWN WITH FRAME f-itinDi.
            END.
        END.
    END.
    /*fim Itiner rio DI*/

    IF tt-param.l-despesas <> NO THEN DO:
        /*Despesas DI*/

        IF  CAN-FIND(FIRST tt-despes-decla-import
                     WHERE tt-despes-decla-import.num-di-ems       = tt-decla-import.num-di-ems
                     and   tt-despes-decla-import.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts
                     AND   tt-despes-decla-import.i-tipo           = 1) THEN DO:

            FOR FIRST decla-import-embarq fields(cod-embarq cod-estab) no-lock
                WHERE decla-import-embarq.num-di-ems       = tt-decla-import.num-di-ems
                and   decla-import-embarq.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts: end.

            /* Reforma Tribut ria - Novos Tributos (DBACKRTDTS-798) */
            IF  l-nt2024002 THEN DO:
                VIEW FRAME f-cabecDespDiCbsIbs.
            END.
            /* FIM -- Reforma Tribut ria - Novos Tributos (DBACKRTDTS-798) */
            ELSE DO:
                VIEW FRAME f-cabecDespDi.
            END.
            
            FOR EACH tt-despes-decla-import
                    WHERE tt-despes-decla-import.num-di-ems       = tt-decla-import.num-di-ems
                    and   tt-despes-decla-import.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts
                    AND   tt-despes-decla-import.i-tipo           = 1
                BREAK BY tt-despes-decla-import.cdn-pto-control:
        
                IF FIRST-OF(tt-despes-decla-import.cdn-pto-control) THEN DO:
                    ASSIGN d-tot-pto-contr = 0.
                END.
        
                FIND FIRST pto-contr WHERE pto-contr.cod-pto-contr = tt-despes-decla-import.cdn-pto-control NO-LOCK NO-ERROR.
                
                FOR FIRST histor-decla-import fields(descricao) no-lock
                    WHERE histor-decla-import.num-di-ems       = tt-decla-import.num-di-ems
                      and histor-decla-import.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts
                      AND histor-decla-import.cdn-pto-control  = tt-despes-decla-import.cdn-pto-control:
                end.   

                ASSIGN c-desc-pto-control = if avail histor-decla-import and histor-decla-import.descricao <> "":U then histor-decla-import.descricao else if avail pto-contr then pto-contr.descricao else "":U.
        
                FIND FIRST desp-imp NO-LOCK WHERE desp-imp.cod-desp = tt-despes-decla-import.cdn-despes NO-ERROR.
                
                FOR FIRST desp-embarque FIELDS(descricao)
                    WHERE desp-embarque.cod-estabel = decla-import-embarq.cod-estab
                      AND desp-embarque.embarque = decla-import-embarq.cod-embarq
                      AND desp-embarque.cod-desp = tt-despes-decla-import.cdn-despes NO-LOCK: END.
                IF  AVAIL desp-imp THEN DO:
                    ASSIGN c-desc-desp   = "-" + if avail desp-embarque and desp-embarque.descricao <> "":U then desp-embarque.descricao else desp-imp.descricao
                           l-duplic      = desp-imp.inc-val-dupli
                           l-ii          = desp-imp.log-2
                           l-ipi         = desp-imp.inc-base-ipi
                           l-icms        = desp-imp.inc-base-icms
                           l-pis-adu     = desp-imp.log-incid-base-pis-val
                           l-pis-desp    = desp-imp.log-incid-base-pis-despes
                           l-cofins-adu  = desp-imp.log-incid-base-cofins-val
                           l-cofins-desp = desp-imp.log-incid-base-cofins-despes.
                           c-tipo-despes = {cxinc/i01cx010.i 04 desp-imp.tipo}. 
                END.
                
                /* Reforma Tribut ria - Novos Tributos (DBACKRTDTS-798) */
                IF  l-nt2024002 THEN DO:
                    FIND FIRST desp-imp-trib NO-LOCK
                        WHERE  desp-imp-trib.cod-desp = tt-despes-decla-import.cdn-despes NO-ERROR.
                    IF  AVAIL  desp-imp-trib THEN DO:
                        ASSIGN l-ibs-uf  = desp-imp-trib.log-incide-base-IBSUF
                               l-ibs-mun = desp-imp-trib.log-incide-base-IBSMun
                               l-cbs     = desp-imp-trib.log-incide-base-CBS-vladu.
                    END.
                    ELSE DO:
                        ASSIGN l-ibs-uf  = NO
                               l-ibs-mun = NO
                               l-cbs     = NO.
                    END.
                END.
                /* FIM -- Reforma Tribut ria - Novos Tributos (DBACKRTDTS-798) */
                
                RUN busca-desc-moeda(INPUT tt-despes-decla-import.cdn-moeda,
                                     OUTPUT c-desp-moeda).
        
                FIND FIRST emitente WHERE emitente.cod-emitente = tt-despes-decla-import.cdn-emit-despes NO-LOCK NO-ERROR.
                ASSIGN c-desc-emitente = "-" + emitente.nome-abrev.
        
                FIND FIRST cond-pagto WHERE cond-pagto.cod-cond-pag = tt-despes-decla-import.cdn-cond-pagto NO-LOCK NO-ERROR.
                ASSIGN c-desc-cond-pagto = "-" + cond-pagto.descricao WHEN AVAIL cond-pagto.
                                         
                /*converte a moeda */
                IF tt-despes-decla-import.cdn-moeda <> 0 THEN DO:
                    RUN valor-cotado(INPUT  tt-despes-decla-import.num-di-ems,
                                     INPUT  tt-despes-decla-import.cdd-siscomex-dts,
                                     INPUT  tt-despes-decla-import.cdn-moed,
                                     INPUT  tt-decla-import.dat-di,
                                     INPUT  tt-despes-decla-import.val-despes,
                                     OUTPUT d-valor-cotado,
                                     OUTPUT d-cotacao).
                    ASSIGN d-valor-me  = tt-despes-decla-import.val-despes
                           d-valor-mn  = d-valor-cotado
                           d-taxa-camb = d-cotacao.
                END.
                ELSE DO:
                    ASSIGN d-valor-me  = 0
                           d-valor-mn  = tt-despes-decla-import.val-despes
                           d-taxa-camb = 0.
                END.
                /*FIM converte a moeda */
        
                ASSIGN d-tot-pto-contr = d-tot-pto-contr + d-valor-mn. /*calcula o total do ponto de controle*/
                
                /* Reforma Tribut ria - Novos Tributos (DBACKRTDTS-798) */
                IF  l-nt2024002 THEN DO:
                    DISP tt-despes-decla-import.cdn-pto-control                 
                         c-desc-pto-control                                     
                         tt-despes-decla-import.cdn-despes                      
                         c-desc-desp                                            
                         c-desp-moeda                                            
                         d-taxa-camb                                            
                         tt-despes-decla-import.log-forma-preco-compra          
                         c-tipo-despes                                         
                         tt-despes-decla-import.cod-incoterm-rat               
                         
                         tt-despes-decla-import.cdn-emit-despes                 
                         c-desc-emitente                                        
                         tt-despes-decla-import.cdn-cond-pagto
                         c-desc-cond-pagto
                         l-duplic      
                         l-ii          
                         l-ipi         
                         l-icms        
                         l-pis-adu     
                         l-pis-desp    
                         l-cofins-adu  
                         
                         l-cofins-desp                                           
                         d-valor-me                                             
                         d-valor-mn 
                         
                         l-ibs-uf
                         l-ibs-mun
                         l-cbs
                       WITH FRAME f-despDiCbsIbs.
                       DOWN WITH FRAME f-despDiCbsIbs.
                END.
                /* FIM -- Reforma Tribut ria - Novos Tributos (DBACKRTDTS-798) */
                ELSE DO:
                    DISP tt-despes-decla-import.cdn-pto-control                 
                         c-desc-pto-control                                     
                         tt-despes-decla-import.cdn-despes                      
                         c-desc-desp                                            
                         c-desp-moeda                                            
                         d-taxa-camb                                            
                         tt-despes-decla-import.log-forma-preco-compra          
                         c-tipo-despes                                         
                         tt-despes-decla-import.cod-incoterm-rat               
                         
                         tt-despes-decla-import.cdn-emit-despes                 
                         c-desc-emitente                                        
                         tt-despes-decla-import.cdn-cond-pagto
                         c-desc-cond-pagto
                         l-duplic      
                         l-ii          
                         l-ipi         
                         l-icms        
                         l-pis-adu     
                         l-pis-desp    
                         l-cofins-adu  
                         
                         l-cofins-desp                                           
                         d-valor-me                                             
                         d-valor-mn  
                       WITH FRAME f-despDi.
                       DOWN WITH FRAME f-despDi.
                END.
    
                /*Poem o total acumulado por ponto de controle*/
                IF LAST-OF(tt-despes-decla-import.cdn-pto-control) THEN DO:
                    DISP d-tot-pto-contr
                        WITH FRAME f-totPtoContr.
                END.
                /*FIM Poem o total acumulado por ponto de controle*/
            END.
            ASSIGN l-mostra-desp-di = YES.
        END.
        ELSE
            ASSIGN l-mostra-desp-di = NO.
        /*Fim Despesas DI*/
    
    
    
        /*Despesas EMBARQUE*/
        IF CAN-FIND(FIRST tt-despes-decla-import
                        WHERE tt-despes-decla-import.num-di-ems       = tt-decla-import.num-di-ems
                        and   tt-despes-decla-import.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts
                        AND   tt-despes-decla-import.i-tipo = 2) THEN DO:
            FOR FIRST decla-import-embarq fields(cod-embarq cod-estab) no-lock
                WHERE decla-import-embarq.num-di-ems       = tt-decla-import.num-di-ems
                and   decla-import-embarq.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts: end.


            VIEW FRAME f-cabecDespEmbarq.
            FOR EACH tt-despes-decla-import
                    WHERE tt-despes-decla-import.num-di-ems       = tt-decla-import.num-di-ems
                    and   tt-despes-decla-import.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts
                    AND   tt-despes-decla-import.i-tipo = 2
                    BREAK BY tt-despes-decla-import.cdn-pto-control:
        
                IF FIRST-OF(tt-despes-decla-import.cdn-pto-control) THEN DO:
                    ASSIGN d-tot-pto-contr = 0.
                END.
        
                FIND FIRST pto-contr WHERE pto-contr.cod-pto-contr = tt-despes-decla-import.cdn-pto-control NO-LOCK NO-ERROR.
                FOR FIRST histor-decla-import fields(descricao) no-lock
                    WHERE histor-decla-import.num-di-ems       = tt-decla-import.num-di-ems
                      and histor-decla-import.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts
                      AND histor-decla-import.cdn-pto-control = tt-despes-decla-import.cdn-pto-control:
                end. 
                ASSIGN c-desc-pto-control = if avail histor-decla-import and histor-decla-import.descricao <> "":U then histor-decla-import.descricao else if avail pto-contr then pto-contr.descricao else "":U.
        
                FIND FIRST desp-imp NO-LOCK WHERE desp-imp.cod-desp = tt-despes-decla-import.cdn-despes NO-ERROR.
                
                FOR FIRST desp-embarque FIELDS(descricao)
                    WHERE desp-embarque.cod-estabel = decla-import-embarq.cod-estab
                      AND desp-embarque.embarque = decla-import-embarq.cod-embarq
                      AND desp-embarque.cod-desp = tt-despes-decla-import.cdn-despes NO-LOCK: END.
                      
                IF AVAIL desp-imp THEN DO:
                    ASSIGN c-desc-desp   = "-" + if avail desp-embarque and desp-embarque.descricao <> "":U then desp-embarque.descricao else desp-imp.descricao
                           l-duplic      = desp-imp.inc-val-dupli
                           l-ii          = desp-imp.log-2
                           l-ipi         = desp-imp.inc-base-ipi
                           l-icms        = desp-imp.inc-base-icms
                           l-pis-adu     = desp-imp.log-incid-base-pis-val
                           l-pis-desp    = desp-imp.log-incid-base-pis-despes
                           l-cofins-adu  = desp-imp.log-incid-base-cofins-val
                           l-cofins-desp = desp-imp.log-incid-base-cofins-despes.
                           c-tipo-despes = {cxinc/i01cx010.i 04 desp-imp.tipo}. 
                END.
            
                /*FIND FIRST moeda WHERE moeda.mo-codigo = tt-despes-decla-import.cdn-moeda NO-LOCK NO-ERROR.
                ASSIGN c-desp-moeda = moeda.descricao WHEN AVAIL moeda.*/
                RUN busca-desc-moeda(INPUT tt-despes-decla-import.cdn-moeda,
                                     OUTPUT c-desp-moeda).
        
                FIND FIRST emitente WHERE emitente.cod-emitente = tt-despes-decla-import.cdn-emit-despes NO-LOCK NO-ERROR.
                ASSIGN c-desc-emitente = "-" + emitente.nome-abrev.
        
                FIND FIRST cond-pagto WHERE cond-pagto.cod-cond-pag = tt-despes-decla-import.cdn-cond-pagto NO-LOCK NO-ERROR.
                ASSIGN c-desc-cond-pagto = "-" + cond-pagto.descricao WHEN AVAIL cond-pagto.
                                         
        
                IF tt-despes-decla-import.cdn-moeda <> 0 THEN DO:
                    RUN valor-cotado(INPUT  tt-despes-decla-import.num-di-ems,
                                     INPUT  tt-despes-decla-import.cdd-siscomex-dts,
                                     INPUT  tt-despes-decla-import.cdn-moed,
                                     INPUT  tt-decla-import.dat-di,
                                     INPUT  tt-despes-decla-import.val-despes,
                                     OUTPUT d-valor-cotado,
                                     OUTPUT d-cotacao).
                    ASSIGN d-valor-me  = tt-despes-decla-import.val-despes
                           d-valor-mn  = d-valor-cotado
                           d-taxa-camb = d-cotacao.
                END.
                ELSE DO:
                    ASSIGN d-valor-me  = 0
                           d-valor-mn  = tt-despes-decla-import.val-despes
                           d-taxa-camb = 0.
                END.
        
        
                ASSIGN d-tot-pto-contr = d-tot-pto-contr + d-valor-mn. /*calcula o total do ponto de controle*/
        
                DISP tt-despes-decla-import.cdn-pto-control                   
                     c-desc-pto-control                                       
                     tt-despes-decla-import.cdn-despes                        
                     c-desc-desp                                              
                     c-desp-moeda                                             
                     d-taxa-camb                                              
                     tt-despes-decla-import.log-forma-preco-compra            
                     c-tipo-despes                                            
                     tt-despes-decla-import.cod-incoterm-rat                  
                                                                              
                     tt-despes-decla-import.cdn-emit-despes                   
                     c-desc-emitente                                          
                     tt-despes-decla-import.cdn-cond-pagto                    
                     c-desc-cond-pagto                                        
                     l-duplic                                                 
                     l-ii                                                     
                     l-ipi                                                    
                     l-icms                                                   
                     l-pis-adu                                                
                     l-pis-desp                                               
                     l-cofins-adu                                             
                                                                              
                     l-cofins-desp                                            
                     d-valor-me                                               
                     d-valor-mn                                               
                   WITH FRAME f-despEmbarq.
                   DOWN WITH FRAME f-despEmbarq.
        
                   /*Poem o total acumulado por ponto de controle*/
                   IF LAST-OF(tt-despes-decla-import.cdn-pto-control) THEN DO:
                       DISP d-tot-pto-contr
                           WITH FRAME f-totPtoContr.
                   END.
                   /*FIM Poem o total acumulado por ponto de controle*/
            END.
             ASSIGN l-mostra-desp-embarq = YES.
        END.
        ELSE
            ASSIGN l-mostra-desp-embarq = NO.
        /*Fim Despesas EMBARQUE*/
    
    
        /*Calculo dos totais das despesas*/
        IF l-mostra-desp-di = YES OR l-mostra-desp-embarq = YES THEN DO:
        
            FOR FIRST histor-decla-import NO-LOCK
                WHERE histor-decla-import.num-di-ems       = tt-decla-import.num-di-ems
                  and histor-decla-import.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts:
        
                ASSIGN i-pto-control-nacionaliz = histor-decla-import.cdn-pto-nacionaliz.
                
            END.
            
            ASSIGN d-val-tot-despes = 0
                   d-tot-pto-nac    = 0.
        
            FOR EACH decla-import-embarq NO-LOCK
                WHERE decla-import-embarq.num-di-ems       = tt-decla-import.num-di-ems
                  and decla-import-embarq.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts:
        
                ASSIGN d-val-tot-despes = 0.
        
                FOR FIRST historico-embarque NO-LOCK
                    WHERE historico-embarque.cod-estabel     = decla-import-embarq.cod-estab
                    AND   historico-embarque.embarque        = decla-import-embarq.cod-embarq
                    AND   historico-embarque.cod-pto-contr   = i-pto-control-nacionaliz:
        
                    FOR EACH  bf-historico-embarque NO-LOCK
                        WHERE bf-historico-embarque.cod-estabel = decla-import-embarq.cod-estab
                        AND   bf-historico-embarque.embarque    = decla-import-embarq.cod-embarq
                        AND   bf-historico-embarque.sequencia  <= historico-embarque.sequencia,
                            EACH  desp-embarque
                            WHERE desp-embarque.cod-estabel   = bf-historico-embarque.cod-estabel
                            AND   desp-embarque.embarque      = bf-historico-embarque.embarque   
                            AND   desp-embarque.cod-pto-contr = bf-historico-embarque.cod-pto-contr:
                        /*ConversÆo da moeda*/
                        IF tt-despes-decla-import.cdn-moeda <> 0 THEN DO:
                            RUN valor-cotado(INPUT  decla-import-embarq.num-di-ems,
                                             INPUT  decla-import-embarq.cdd-siscomex-dts,
                                             INPUT  desp-embarque.mo-codigo,
                                             INPUT  tt-decla-import.dat-di,
                                             INPUT  desp-embarque.val-desp,
                                             OUTPUT d-valor-cotado,
                                             OUTPUT d-cotacao).
                            ASSIGN d-val-tot-despes = d-val-tot-despes + d-valor-cotado.
                        END.
                        ELSE DO:
                            ASSIGN d-val-tot-despes = d-val-tot-despes + desp-embarque.val-desp.
                        END.
                        /*FIM ConversÆo da moeda*/
                    END.
                    ASSIGN d-tot-pto-nac = d-tot-pto-nac + d-val-tot-despes.
                END.
            END.
            /* fim dos c lculos das despesas  */
        
            ASSIGN d-tot-geral-desp = 0.
            /*totais das despesas*/
            FOR EACH tt-despes-decla-import
                    WHERE tt-despes-decla-import.num-di-ems       = tt-decla-import.num-di-ems
                      and tt-despes-decla-import.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts:
        
                ASSIGN d-valor-me     = 0
                       d-valor-mn     = 0
                       d-taxa-camb    = 0
                       d-cotacao      = 0
                       d-valor-cotado = 0.
        
                /*calculo do valor*/
                IF tt-despes-decla-import.cdn-moeda <> 0 THEN DO:
                    /*se o cod. da moeda for diferente de 0, significa que ‚ uma moeda estrangeira. 
                     * Ou seja, o campo Valor ME recebe o valor da despesa (tt-despes-decla-import.val-despes) e o campo Valor MN precisa ser calculado.
                     * Calculo do Valor MN =  Valor ME * cotacaoû.
                     * û: o valor da cotacao deve ser buscado do im0400c
                     *      se nÆo achar pega do cd0103
                     *      se nÆo achar, atribui o valor da cotacao = 1.
                    */
                    
                        RUN valor-cotado(INPUT  tt-despes-decla-import.num-di-ems,
                                         INPUT  tt-despes-decla-import.cdd-siscomex-dts,
                                         INPUT  tt-despes-decla-import.cdn-moed,
                                         INPUT  tt-decla-import.dat-di,
                                         INPUT  tt-despes-decla-import.val-despes,
                                         OUTPUT d-valor-cotado,
                                         OUTPUT d-cotacao).            
                    
                        ASSIGN d-valor-me  = tt-despes-decla-import.val-despes
                               d-valor-mn  = d-valor-me * d-cotacao
                               d-taxa-camb = d-cotacao.
                        
                    /* FIM FUN€ÇO QUE BUSCA COTA€ÇO*/
                END.
                ELSE DO:
                    ASSIGN d-valor-me  = 0
                           d-valor-mn  = tt-despes-decla-import.val-despes
                           d-taxa-camb = 0.
                END.
        
                /*fim calculo do valor*/
                ASSIGN d-tot-geral-desp = d-tot-geral-desp + d-valor-mn.
            END.
            VIEW FRAME f-cabecTotDesp.
            DISP d-tot-pto-nac   
                 d-tot-geral-desp
                WITH FRAME f-totDesp.
            /*FIM totais das despesas*/
        END.
    END.
    
    
    FIND FIRST tt-valores-decla-import WHERE tt-valores-decla-import.num-di-ems       = tt-decla-import.num-di-ems
                                       and   tt-valores-decla-import.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts
                                       NO-LOCK NO-ERROR.
    
    assign de-v-base-fcp           = 0
           de-v-susp-fcp           = 0
           de-v-recolhe-fcp        = 0
           de-v-outros-fcp         = 0
           de-v-base-fcp-st        = 0
           de-v-susp-fcp-st        = 0
           de-v-recolhe-fcp-st     = 0
           de-v-outros-fcp-st      = 0
           de-v-base-icms-st       = 0
           de-v-susp-icms-st       = 0
           de-v-recolhe-icms-st    = 0
           de-v-outros-icms-st     = 0
           de-v-base-icms-compl    = 0
           de-v-susp-icms-compl    = 0
           de-v-recolhe-icms-compl = 0
           de-v-outros-icms-compl  = 0.  
    
    FOR EACH decla-import-adic-itens NO-LOCK
       WHERE decla-import-adic-itens.num-di-ems       = tt-decla-import.num-di-ems
         and decla-import-adic-itens.cdd-siscomex-dts = tt-decla-import.cdd-siscomex-dts:
    
        ASSIGN de-v-base-fcp           = de-v-base-fcp        + decla-import-adic-itens.val-base-fcp
               de-v-base-fcp-st        = de-v-base-fcp-st     + decla-import-adic-itens.val-base-fcp-substto
               de-v-base-icms-st       = de-v-base-icms-st    + decla-import-adic-itens.val-base-icms-substto
               de-v-base-icms-compl    = de-v-base-icms-compl + decla-import-adic-itens.val-base-icms-compltar.
    
        /*Os Impostos ICMS ST, ICMS Complementar e taxas FCP e FCP ST, sempre seguem a mesma tributa‡Æo do imposto do ICMS*/
        /*Suspenso*/
        IF tt-decla-import.val-icms-nao-tribut <> 0 THEN
           ASSIGN de-v-susp-fcp        = de-v-susp-fcp              + decla-import-adic-itens.val-fcp
                  de-v-susp-fcp-st     = de-v-susp-fcp-st           + decla-import-adic-itens.val-fcp-substto
                  de-v-susp-icms-st    = de-v-susp-icms-st          + decla-import-adic-itens.val-icms-substto
                  de-v-susp-icms-compl = de-v-susp-icms-compl       + decla-import-adic-itens.val-icms-compltar.
    
        /*A Recolher*/
        IF tt-decla-import.val-icms-db-cr <> 0 THEN
           ASSIGN de-v-recolhe-fcp        = de-v-recolhe-fcp        + decla-import-adic-itens.val-fcp           
                  de-v-recolhe-fcp-st     = de-v-recolhe-fcp-st     + decla-import-adic-itens.val-fcp-substto     
                  de-v-recolhe-icms-st    = de-v-recolhe-icms-st    + decla-import-adic-itens.val-icms-substto    
                  de-v-recolhe-icms-compl = de-v-recolhe-icms-compl + decla-import-adic-itens.val-icms-compltar.
    
        /*Outros*/
        IF tt-decla-import.val-icms-outras <> 0 THEN
           ASSIGN de-v-outros-fcp        = de-v-outros-fcp          + decla-import-adic-itens.val-fcp            
                  de-v-outros-fcp-st     = de-v-outros-fcp-st       + decla-import-adic-itens.val-fcp-substto   
                  de-v-outros-icms-st    = de-v-outros-icms-st      + decla-import-adic-itens.val-icms-substto  
                  de-v-outros-icms-compl = de-v-outros-icms-compl   + decla-import-adic-itens.val-icms-compltar.
    END.

    IF AVAIL tt-valores-decla-import THEN DO:
    
        /* VALORES*/
        ASSIGN lb-frete  = "Frete:"
               lb-seguro = "Seguro:"
               lb-vmle   = "VMLE:"
               lb-vmld   = "VMLD:"
               lb-vmcv   = "VMCV:".
        VIEW FRAME f-cabecValores.
    
        DISP lb-frete
             tt-valores-decla-import.frete-moeda    
             tt-valores-decla-import.frete-valor-me 
             tt-valores-decla-import.frete-valor-mn 
             
             lb-seguro                   
             tt-valores-decla-import.seguro-moeda   
             tt-valores-decla-import.seguro-valor-me
             tt-valores-decla-import.seguro-valor-mn
             
             lb-vmle                     
             tt-valores-decla-import.vmle-moeda     
             tt-valores-decla-import.vmle-valor-me  
             tt-valores-decla-import.vmle-valor-mn  
             
             lb-vmld                     
             tt-valores-decla-import.vmld-moeda     
             tt-valores-decla-import.vmld-valor-me  
             tt-valores-decla-import.vmld-valor-mn  
             
             lb-vmcv                     
             tt-valores-decla-import.vmcv-moeda     
             tt-valores-decla-import.vmcv-valor-me  
             tt-valores-decla-import.vmcv-valor-mn  
            WITH FRAME f-valores.
        /* FIM VALORES */
    
    
        /* IMPOSTOS */
        ASSIGN lb-ii         = "II:"
               lb-ipi        = "IPI:"
               lb-pis        = "PIS:"
               lb-cofins     = "COFINS:"
               lb-icms       = "ICMS:"
               lb-totais     = "Totais:"
               lb-fcp        = "FCP:"
               lb-fcp-st     = "FCP ST:"
               lb-icms-st    = "ICMS ST:"
               lb-icms-compl = "ICMS Compl:".
    
        ASSIGN d-tot-base       = tt-valores-decla-import.val-base-ii             + 
                                  tt-valores-decla-import.val-base-ipi            + 
                                  tt-valores-decla-import.val-base-pis            + 
                                  tt-valores-decla-import.val-base-cofins         + 
                                  tt-valores-decla-import.val-base-icms           +
                                  de-v-base-fcp                                   +
                                  de-v-base-fcp-st                                +
                                  de-v-base-icms-st                               +
                                  de-v-base-icms-compl
    
               d-tot-nao-tribut = tt-valores-decla-import.val-ii-nao-tribut       +
                                  tt-valores-decla-import.val-ipi-nao-tributad    +
                                  tt-valores-decla-import.val-pis-nao-tributad    + 
                                  tt-valores-decla-import.val-cofins-nao-tributad +
                                  tt-valores-decla-import.val-icms-nao-tributad   +
                                  de-v-susp-fcp                                   +
                                  de-v-susp-fcp-st                                + 
                                  de-v-susp-icms-st                               +
                                  de-v-susp-icms-compl   
            
               d-tot-db-cr      = tt-valores-decla-import.val-ii-db-cr            +
                                  tt-valores-decla-import.val-ipi-db-cr           +
                                  tt-valores-decla-import.val-pis-db-cr           +
                                  tt-valores-decla-import.val-cofins-db-cr        +
                                  tt-valores-decla-import.val-icms-db-cr          +
                                  de-v-recolhe-fcp                                +
                                  de-v-recolhe-fcp-st                             +
                                  de-v-recolhe-icms-st                            +
                                  de-v-recolhe-icms-compl
            
               d-tot-outras     = tt-valores-decla-import.val-ii-outras           +   
                                  tt-valores-decla-import.val-ipi-outras          +
                                  tt-valores-decla-import.val-pis-outras          +
                                  tt-valores-decla-import.val-cofins-outras       +
                                  tt-valores-decla-import.val-icms-outras         +
                                  de-v-outros-fcp                                 +
                                  de-v-outros-fcp-st                              +
                                  de-v-outros-icms-st                             +
                                  de-v-outros-icms-compl.
    
        VIEW FRAME f-cabecImpostos.
        
        /* Reforma Tribut ria - Novos Tributos (DBACKRTDTS-798) */
        IF  l-nt2024002 THEN DO:
            ASSIGN lb-ibs-uf      = "IBS UF:"
                   lb-ibs-mun     = "IBS Mun:"
                   lb-cbs         = "CBS:"
                   lb-ibs-uf-reg  = "IBS UF Reg:"
                   lb-ibs-mun-reg = "IBS Mun Reg:"
                   lb-cbs-reg     = "CBS Reg:".
                   
            // Acrescenta os novos impostos nos totais
            ASSIGN d-tot-base       = d-tot-base + tt-valores-decla-import.val-base-ibs-uf 
                                                 + tt-valores-decla-import.val-base-ibs-mun 
                                                 + tt-valores-decla-import.val-base-cbs
                                                 + tt-valores-decla-import.val-base-ibs-uf-reg
                                                 + tt-valores-decla-import.val-base-ibs-mun-reg
                                                 + tt-valores-decla-import.val-base-cbs-reg
                   d-tot-nao-tribut = d-tot-nao-tribut + tt-valores-decla-import.val-ibs-uf-nao-tributad 
                                                       + tt-valores-decla-import.val-ibs-mun-nao-tributad
                                                       + tt-valores-decla-import.val-cbs-nao-tributad
                   d-tot-db-cr      = d-tot-db-cr + tt-valores-decla-import.val-ibs-uf-db-cr
                                                  + tt-valores-decla-import.val-ibs-mun-db-cr
                                                  + tt-valores-decla-import.val-cbs-db-cr
                   d-tot-outras     = d-tot-outras + tt-valores-decla-import.val-ibs-uf-outras
                                                   + tt-valores-decla-import.val-ibs-mun-outras
                                                   + tt-valores-decla-import.val-cbs-outras
                                                   + tt-valores-decla-import.val-ibs-uf-outras-reg
                                                   + tt-valores-decla-import.val-ibs-mun-outras-reg
                                                   + tt-valores-decla-import.val-cbs-outras-reg.
            
            DISP lb-ii
                 tt-valores-decla-import.val-base-ii
                 tt-valores-decla-import.val-ii-nao-tribut      
                 tt-valores-decla-import.val-ii-db-cr           
                 tt-valores-decla-import.val-ii-outras          
                 
                 lb-ipi
                 tt-valores-decla-import.val-base-ipi
                 tt-valores-decla-import.val-ipi-nao-tributad   
                 tt-valores-decla-import.val-ipi-db-cr          
                 tt-valores-decla-import.val-ipi-outras         
                 
                 lb-pis
                 tt-valores-decla-import.val-base-pis
                 tt-valores-decla-import.val-pis-nao-tributad   
                 tt-valores-decla-import.val-pis-db-cr          
                 tt-valores-decla-import.val-pis-outras         
                 
                 lb-cofins
                 tt-valores-decla-import.val-base-cofins
                 tt-valores-decla-import.val-cofins-nao-tributad
                 tt-valores-decla-import.val-cofins-db-cr       
                 tt-valores-decla-import.val-cofins-outras      
                 
                 lb-icms
                 tt-valores-decla-import.val-base-icms
                 tt-valores-decla-import.val-icms-nao-tributad  
                 tt-valores-decla-import.val-icms-db-cr         
                 tt-valores-decla-import.val-icms-outras  
                 
                 lb-fcp 
                 de-v-base-fcp          
                 de-v-susp-fcp          
                 de-v-recolhe-fcp       
                 de-v-outros-fcp        
                 
                 lb-fcp-st           
                 de-v-base-fcp-st       
                 de-v-susp-fcp-st       
                 de-v-recolhe-fcp-st    
                 de-v-outros-fcp-st     
                 
                 lb-icms-st           
                 de-v-base-icms-st      
                 de-v-susp-icms-st      
                 de-v-recolhe-icms-st   
                 de-v-outros-icms-st    
                   
                 lb-icms-compl         
                 de-v-base-icms-compl   
                 de-v-susp-icms-compl   
                 de-v-recolhe-icms-compl
                 de-v-outros-icms-compl
       
                 lb-ibs-uf
                 tt-valores-decla-import.val-base-ibs-uf
                 tt-valores-decla-import.val-ibs-uf-nao-tributad
                 tt-valores-decla-import.val-ibs-uf-db-cr
                 tt-valores-decla-import.val-ibs-uf-outras

                 lb-ibs-mun
                 tt-valores-decla-import.val-base-ibs-mun
                 tt-valores-decla-import.val-ibs-mun-nao-tributad
                 tt-valores-decla-import.val-ibs-mun-db-cr
                 tt-valores-decla-import.val-ibs-mun-outras
                 
                 lb-cbs
                 tt-valores-decla-import.val-base-cbs
                 tt-valores-decla-import.val-cbs-nao-tributad
                 tt-valores-decla-import.val-cbs-db-cr
                 tt-valores-decla-import.val-cbs-outras
                    
                 lb-ibs-uf-reg
                 tt-valores-decla-import.val-base-ibs-uf-reg
                 tt-valores-decla-import.val-ibs-uf-outras-reg

                 lb-ibs-mun-reg
                 tt-valores-decla-import.val-base-ibs-mun-reg
                 tt-valores-decla-import.val-ibs-mun-outras-reg
                 
                 lb-cbs-reg
                 tt-valores-decla-import.val-base-cbs-reg
                 tt-valores-decla-import.val-cbs-outras-reg

                 lb-totais          
                 d-tot-base
                 d-tot-nao-tribut
                 d-tot-db-cr  
                 d-tot-outras 
            WITH FRAME f-impostosCbsIbs.
        END.
        /* FIM -- Reforma Tribut ria - Novos Tributos (DBACKRTDTS-798) */
        ELSE DO:
            DISP lb-ii
                 tt-valores-decla-import.val-base-ii
                 tt-valores-decla-import.val-ii-nao-tribut      
                 tt-valores-decla-import.val-ii-db-cr           
                 tt-valores-decla-import.val-ii-outras          
                 
                 lb-ipi
                 tt-valores-decla-import.val-base-ipi
                 tt-valores-decla-import.val-ipi-nao-tributad   
                 tt-valores-decla-import.val-ipi-db-cr          
                 tt-valores-decla-import.val-ipi-outras         
                 
                 lb-pis
                 tt-valores-decla-import.val-base-pis
                 tt-valores-decla-import.val-pis-nao-tributad   
                 tt-valores-decla-import.val-pis-db-cr          
                 tt-valores-decla-import.val-pis-outras         
                 
                 lb-cofins
                 tt-valores-decla-import.val-base-cofins
                 tt-valores-decla-import.val-cofins-nao-tributad
                 tt-valores-decla-import.val-cofins-db-cr       
                 tt-valores-decla-import.val-cofins-outras      
                 
                 lb-icms
                 tt-valores-decla-import.val-base-icms
                 tt-valores-decla-import.val-icms-nao-tributad  
