/******************************************************************************
**
**  IM0045.I51 - Grava/Regrava o conteudo das variaveis geradas a patir de uma 
**               outra variavel. Essa quebra foi feita no CD4300.i4.
**
**  Significados do parametro:
**
**  {1} - Caso seja yes, grava o conteudo de aux-c-char nas variaveis criadas;
**        Caso seja no, grava o conteudo das variaveis criadas em aux-c-char;
**
******************************************************************************/

if {1} then 
    assign c-meio-transporte   = aux-c-char[1]
           c-embarque-orig-i50 = aux-c-char[2].

else
    assign aux-c-char[1]  = c-meio-transporte
           aux-c-char[2]  = c-embarque-orig-i50.

/*  IM0045.I51  */ 

