                      tt-processo-imp-aux3.prc-fornec-bru-total-ped-mo-cor    = tt-processo-imp-aux3.prc-fornec-bru-total-ped-mo-cor  + de-preco-fornec-bru-total-ped 
                      tt-processo-imp-aux3.prc-interno-bru-total-ped-mo-cor   = tt-processo-imp-aux3.prc-interno-bru-total-ped-mo-cor + de-preco-interno-bru-total-ped
                      tt-processo-imp-aux3.ocupacao-total-ped                 = tt-processo-imp-aux3.ocupacao-total-ped                    + de-ocupacao-total-ped         
