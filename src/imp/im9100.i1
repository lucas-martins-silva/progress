                      tt-ncm-fabr-ped-compr-emb.prc-intern-liq-total-ncm-mo-cor  = tt-ncm-fabr-ped-compr-emb.prc-intern-liq-total-ncm-mo-cor + de-preco-interno-liq-total-ncm
                      tt-ncm-fabr-ped-compr-emb.prc-fornec-bru-total-ncm-mo-cor  = tt-ncm-fabr-ped-compr-emb.prc-fornec-bru-total-ncm-mo-cor + de-preco-fornec-bru-total-ncm 
                      tt-ncm-fabr-ped-compr-emb.prc-intern-bru-total-ncm-mo-cor  = tt-ncm-fabr-ped-compr-emb.prc-intern-bru-total-ncm-mo-cor + de-preco-interno-bru-total-ncm
                      tt-ncm-fabr-ped-compr-emb.ocupacao-total-ncm               = tt-ncm-fabr-ped-compr-emb.ocupacao-total-ncm + de-ocupacao-total-ncm         
