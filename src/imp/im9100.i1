                      tt-ncm-fabr-ped-compr-emb.qt-estatistica-total-ncm         = tt-ncm-fabr-ped-compr-emb.qt-estatistica-total-ncm + de-qt-estatistica-total-ncm.
                      
               
           &endif
           
           assign de-peso-liq-total-ncm           = 0
                  de-peso-bruto-total-ncm         = 0
                  de-preco-fornec-liq-total-ncm   = 0
                  de-preco-interno-liq-total-ncm  = 0
                  de-preco-fornec-bru-total-ncm   = 0
                  de-preco-interno-bru-total-ncm  = 0
                  de-ocupacao-total-ncm           = 0
                  de-quantidade-total-ncm         = 0
                  de-qt-do-forn-total-ncm         = 0
                  de-qt-estatistica-total-ncm     = 0.

       end.
       
       if last-of({2}.cod-fabricante) or last-of({2}.num-pedido) then do:

           &if "{2}" = "tt-ordem-ncm-fabr-processo-imp" &then
           
               find first tt-fabr-processo-imp                
                    where tt-fabr-processo-imp.cod-estabel    = {2}.cod-estabel   
                      and tt-fabr-processo-imp.nr-proc-imp    = {2}.nr-proc-imp
                      and tt-fabr-processo-imp.num-pedido     = {2}.num-pedido
                      and tt-fabr-processo-imp.cod-fabricante = {2}.cod-fabricante no-error.
                      
               assign tt-fabr-processo-imp.peso-liquido-total-fabr           = tt-fabr-processo-imp.peso-liquido-total-fabr + de-peso-liq-total-fabr         
