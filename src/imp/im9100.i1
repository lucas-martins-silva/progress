                      tt-pedido-compr-emb-aux3.ocupacao-total-ped               = tt-pedido-compr-emb-aux3.ocupacao-total-ped               + de-ocupacao-total-ped         
                      tt-pedido-compr-emb-aux3.quantidade-total-ped             = tt-pedido-compr-emb-aux3.quantidade-total-ped             + de-quantidade-total-ped       
                      tt-pedido-compr-emb-aux3.qt-do-forn-total-ped             = tt-pedido-compr-emb-aux3.qt-do-forn-total-ped             + de-qt-do-forn-total-ped       
                      tt-pedido-compr-emb-aux3.qt-estatistica-total-ped         = tt-pedido-compr-emb-aux3.qt-estatistica-total-ped         + de-qt-estatistica-total-ped.

               assign de-peso-liq-total-ped          = 0
                      de-peso-bruto-total-ped        = 0
                      de-preco-fornec-liq-total-ped  = 0
                      de-preco-interno-liq-total-ped = 0
                      de-preco-fornec-bru-total-ped  = 0
                      de-preco-interno-bru-total-ped = 0
                      de-ocupacao-total-ped          = 0
                      de-quantidade-total-ped        = 0
                      de-qt-do-forn-total-ped        = 0
                      de-qt-estatistica-total-ped    = 0.

           end.

       &endif
       
       &if "{2}" = "tt-ordem-ncm-fabr-processo-imp" &then
           
