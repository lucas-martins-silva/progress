               de-qt-do-forn-total-emb         = de-qt-do-forn-total-emb  + {2}.qt-do-forn                           
               de-qt-estatistica-total-emb     = de-qt-estatistica-total-emb + {2}.qt-estatistica.                  


       if last-of({2}.ncm) or last-of({2}.cod-fabricante) or last-of({2}.num-pedido) then do:
       
           
           &if "{2}" = "tt-ordem-ncm-fabr-processo-imp" &then
           
               find first tt-ncm-fabr-processo-imp                
                    where tt-ncm-fabr-processo-imp.cod-estabel    = {2}.cod-estabel   
                      and tt-ncm-fabr-processo-imp.nr-proc-imp    = {2}.nr-proc-imp   
                      and tt-ncm-fabr-processo-imp.num-pedido     = {2}.num-pedido    
                      and tt-ncm-fabr-processo-imp.cod-fabricante = {2}.cod-fabricante
                      and tt-ncm-fabr-processo-imp.cod-ncm        = {2}.ncm no-error.
                      
               assign tt-ncm-fabr-processo-imp.peso-liquido-total-ncm           = tt-ncm-fabr-processo-imp.peso-liquido-total-ncm + de-peso-liq-total-ncm         
                      tt-ncm-fabr-processo-imp.peso-bruto-total-ncm             = tt-ncm-fabr-processo-imp.peso-bruto-total-ncm + de-peso-bruto-total-ncm       
                      tt-ncm-fabr-processo-imp.prc-fornec-liq-total-ncm-mo-cor  = tt-ncm-fabr-processo-imp.prc-fornec-liq-total-ncm-mo-cor + de-preco-fornec-liq-total-ncm 
                      tt-ncm-fabr-processo-imp.prc-intern-liq-total-ncm-mo-cor  = tt-ncm-fabr-processo-imp.prc-intern-liq-total-ncm-mo-cor + de-preco-interno-liq-total-ncm
                      tt-ncm-fabr-processo-imp.prc-fornec-bru-total-ncm-mo-cor  = tt-ncm-fabr-processo-imp.prc-fornec-bru-total-ncm-mo-cor + de-preco-fornec-bru-total-ncm 
                      tt-ncm-fabr-processo-imp.prc-intern-bru-total-ncm-mo-cor  = tt-ncm-fabr-processo-imp.prc-intern-bru-total-ncm-mo-cor + de-preco-interno-bru-total-ncm
                      tt-ncm-fabr-processo-imp.ocupacao-total-ncm               = tt-ncm-fabr-processo-imp.ocupacao-total-ncm + de-ocupacao-total-ncm         
                      tt-ncm-fabr-processo-imp.quantidade-total-ncm             = tt-ncm-fabr-processo-imp.quantidade-total-ncm + de-quantidade-total-ncm       
