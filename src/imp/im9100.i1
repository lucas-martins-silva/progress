                      tt-fabr-processo-imp.prc-intern-liq-total-fabr-mo-cor  = tt-fabr-processo-imp.prc-intern-liq-total-fabr-mo-cor + de-preco-interno-liq-total-fabr
                      tt-fabr-processo-imp.prc-fornec-bru-total-fabr-mo-cor  = tt-fabr-processo-imp.prc-fornec-bru-total-fabr-mo-cor + de-preco-fornec-bru-total-fabr 
                      tt-fabr-processo-imp.prc-intern-bru-total-fabr-mo-cor  = tt-fabr-processo-imp.prc-intern-bru-total-fabr-mo-cor + de-preco-interno-bru-total-fabr
                      tt-fabr-processo-imp.ocupacao-total-fabr               = tt-fabr-processo-imp.ocupacao-total-fabr + de-ocupacao-total-fabr         
