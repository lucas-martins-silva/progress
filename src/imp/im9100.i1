&IF "{1}" = "tt-fabr-processo-imp"
OR  "{1}" = "tt-fabr-ped-compr-emb" &THEN

    RUN getFabricantePedido IN h-imapi009 (INPUT {1}.cod-fabricante,
                                           OUTPUT TABLE tt-emitente).
    FIND FIRST tt-emitente NO-ERROR.
    if avail tt-emitente then
        ASSIGN {1}.nome-fabric	        = tt-emitente.nome-emit
               {1}.endereco-fabric      = tt-emitente.endereco
               {1}.bairro-fabric        = tt-emitente.bairro
               {1}.cidade-fabric        = tt-emitente.cidade
               {1}.pais-fabric	        = tt-emitente.pais
               {1}.cep-fabric	        = tt-emitente.cep
               {1}.cgc-fabric           = tt-emitente.cgc
               {1}.estado-fabric        = tt-emitente.estado
               {1}.ins-estadual-fabric  = tt-emitente.ins-estadual
               {1}.ins-municipal-fabric = tt-emitente.ins-municipal
               {1}.caixa-postal-fabric  = tt-emitente.caixa-postal
               {1}.e-mail-fabric	= tt-emitente.e-mail
               {1}.telefone1-fabric	= tt-emitente.telefone[1]
               {1}.telefone2-fabric	= tt-emitente.telefone[2]
               {1}.ramal1-fabric	= tt-emitente.ramal[1]
               {1}.ramal2-fabric	= tt-emitente.ramal[2]
               {1}.home-page-fabric	= tt-emitente.home-page
               {1}.telefax-fabric       = tt-emitente.telefax
               {1}.ramal-fax-fabric	= tt-emitente.ramal-fax
               {1}.telef-fac-fabric	= tt-emitente.telef-fac
               {1}.ramal-fac-fabric	= tt-emitente.ramal-fac
               {1}.telef-modem-fabric   = tt-emitente.telef-modem
               {1}.ramal-modem-fabric   = tt-emitente.ramal-modem.

    empty temp-table tt-emitente.

&ENDIF

&IF "{1}" = "tt-ncm-fabr-processo-imp" 
OR  "{1}" = "tt-ncm-fabr-ped-compr-emb" &THEN

    RUN getNCMFabricantePedido IN h-imapi009 (INPUT {1}.cod-ncm,
                                              OUTPUT TABLE tt-classif-fisc).
                                              


    FIND FIRST tt-classif-fisc NO-ERROR.
    if avail tt-classif-fisc then
        ASSIGN {1}.desc-ncm	 = tt-classif-fisc.descricao
               {1}.aliquota-ipi  = tt-classif-fisc.aliquota-ipi
               {1}.unidade       = tt-classif-fisc.unidade
               {1}.cod-unidade   = tt-classif-fisc.cod-unidade
               {1}.suspens-ipi   = tt-classif-fisc.log-1
               {1}.cod-un-ibge   = tt-classif-fisc.cod-un-ibge
               {1}.un-abr-ibge   = tt-classif-fisc.un-abr-ibge
               {1}.cod-naladi    = tt-classif-fisc.cod-naladi
               {1}.cod-naladi-sh = tt-classif-fisc.cod-naladi-sh
               {1}.cod-mercosul  = tt-classif-fisc.cod-mercosul
               {1}.ncm-codigo    = tt-classif-fisc.cod-ncm
               {1}.pis-import    = SUBSTRING(tt-classif-fisc.char-1,31,6)
               {1}.cofins-import = SUBSTRING(tt-classif-fisc.char-1,37,6)
               {1}.aliquota-ii   = SUBSTRING(tt-classif-fisc.char-1,10,6).
               
    empty temp-table tt-classif-fisc.
    
&ENDIF

&IF "{1}" = "tt-ordem-ncm-fabr-processo-imp"  
OR  "{1}" = "tt-ordem-ncm-fabr-ped-compr-emb" &THEN

    RUN setConstraintOrdensCompra IN h-imapi009 (INPUT {1}.r-rowid-ordem-compra).
    
    RUN getOrdensCompra in h-imapi009 (output table tt-ordens).
    
    FIND FIRST tt-ordens NO-ERROR.
    if avail tt-ordens then do:
    
        RUN cdp/cd0812.p (INPUT tt-ordens.mo-codigo,
                      INPUT 0,
                      INPUT tt-ordens.valor-descto,
                      INPUT TODAY,
                      OUTPUT de-valor-descto-conv).
                      
        ASSIGN {1}.it-codigo              = tt-ordens.it-codigo
           {1}.data-emissao  	      = tt-ordens.data-emissao
           {1}.narrat-ordem	      = tt-ordens.narrativa
           {1}.data-cotacao           = tt-ordens.data-cotacao
           {1}.mo-codigo	      = tt-ordens.mo-codigo
           {1}.aliquota-ipi-ordem     = tt-ordens.aliquota-ipi
           {1}.taxa-financ	      = string(tt-ordens.taxa-financ, "Sim/NÆo")
           {1}.valor-taxa	      = tt-ordens.valor-taxa
           {1}.perc-descto	      = tt-ordens.perc-descto
           {1}.prazo-entreg	      = tt-ordens.prazo-entreg
           {1}.contato	              = tt-ordens.contato
           {1}.comentarios	      = tt-ordens.comentarios
           {1}.data-atualiz	      = tt-ordens.data-atualiz
           {1}.hora-atualiz	      = tt-ordens.hora-atualiz
           {1}.cod-refer              = tt-ordens.cod-refer
           {1}.valor-descto	      = tt-ordens.valor-descto
           {1}.nr-dias-taxa	      = tt-ordens.nr-dias-taxa
           {1}.loc-entrega	      = tt-ordens.loc-entrega
           {1}.valor-descto-mo-corren = de-valor-descto-conv.
    
    end.
    
    empty temp-table tt-ordens.

    RUN getCotacaoItem IN h-imapi009 (OUTPUT table tt-cotacao-item).
    FIND FIRST tt-cotacao-item NO-ERROR.
    if avail tt-cotacao-item then
        ASSIGN {1}.cod-pto-contr-base = SUBSTRING(tt-cotacao-item.char-1,41,20)
               {1}.aliquota-ii	      = dec(SUBSTRING(tt-cotacao-item.char-1,61,20))
               {1}.regime-import      = SUBSTRING(tt-cotacao-item.char-2,61,20)
               {1}.un-fornec	      = tt-cotacao-item.un
               {1}.cdn-pais-orig      = tt-cotacao-item.cdn-pais-orig.

    empty temp-table tt-cotacao-item.
    
    RUN getPtoControle IN h-imapi009 (OUTPUT table tt-pto-contr).
    FIND FIRST tt-pto-contr NO-ERROR.
    if avail tt-pto-contr then
        ASSIGN {1}.desc-pto-contr-base = tt-pto-contr.descricao.

    empty temp-table tt-pto-contr.
    
    RUN getPais IN h-imapi009 (OUTPUT table tt-pais).
    FIND FIRST tt-pais NO-ERROR.
    if avail tt-pais then
        ASSIGN {1}.nome-pais-orig = tt-pais.nome-pais.

    empty temp-table tt-pais.
    
    RUN getAliquotasImpostos IN h-imapi009 (OUTPUT table tt-ord-aliquotas).
    FIND FIRST tt-ord-aliquotas NO-ERROR.
    if avail tt-ord-aliquotas then
        ASSIGN {1}.aliquota-ipi        = tt-ord-aliquotas.aliquota-ipi
               {1}.aliquota-icms       = tt-ord-aliquotas.aliquota-icm
               {1}.aliquota-pis-ext    = tt-ord-aliquotas.aliquota-pis
               {1}.aliquota-cofins-ext = tt-ord-aliquotas.aliquota-cofins
               {1}.trib-ipi	       = tt-ord-aliquotas.trib-ipi
               {1}.trib-icms	       = tt-ord-aliquotas.trib-icm
               {1}.trib-pis	       = tt-ord-aliquotas.trib-pis
               {1}.trib-cofins	       = tt-ord-aliquotas.trib-cofins
               {1}.trib-ii	       = tt-ord-aliquotas.trib-ii
               {1}.aliquota-ii         = tt-ord-aliquotas.aliquota-ii.         
               
    empty temp-table tt-ord-aliquotas.
    
    RUN getMoeda IN h-imapi009 (OUTPUT table tt-moeda).
    FIND FIRST tt-moeda NO-ERROR.
    if avail tt-moeda then
        ASSIGN {1}.desc-moeda	= tt-moeda.descricao
               {1}.sigla-moeda	= tt-moeda.sigla.

    empty temp-table tt-moeda.
    
    
    RUN getItem IN h-imapi009 (OUTPUT table tt-item).
    FIND FIRST tt-item NO-ERROR.
    if avail tt-item then
    
        ASSIGN {1}.desc-item    = tt-item.desc-item
               {1}.peso-liquido = tt-item.peso-liquido
               {1}.peso-bruto   = tt-item.peso-bruto
               {1}.altura	= tt-item.altura
               {1}.comprim	= tt-item.comprim
               {1}.largura	= tt-item.largura
               {1}.ge-codigo    = tt-item.ge-codigo
               {1}.fm-codigo    = tt-item.fm-codigo
               {1}.fm-cod-com   = tt-item.fm-cod-com
               {1}.un	        = tt-item.un.

    empty temp-table tt-item.

    RUN getNarrativa IN h-imapi009 (OUTPUT table tt-narrativa).
    FIND FIRST tt-narrativa NO-ERROR.
    if avail tt-narrativa then
        ASSIGN {1}.narrativa = tt-narrativa.descricao.

    empty temp-table tt-narrativa.
    
    RUN getTraducaoItemFornecedor IN h-imapi009 (INPUT {1}.it-codigo,
                                                 OUTPUT c-desc-item-traduzido).
    
    ASSIGN {1}.desc-item-fornec = c-desc-item-traduzido.

    RUN getGrupoEstoque IN h-imapi009 (OUTPUT table tt-grup-estoq).
    FIND FIRST tt-grup-estoq NO-ERROR.
    if avail tt-grup-estoq then
        ASSIGN {1}.desc-grup-estoq = tt-grup-estoq.descricao.

    empty temp-table tt-grup-estoq.
    
    RUN getFamilia IN h-imapi009 (OUTPUT table tt-familia).
    FIND FIRST tt-familia NO-ERROR.
    if avail tt-familia then
        ASSIGN {1}.desc-familia	= tt-familia.descricao.

    empty temp-table tt-familia.

    RUN getFamComerc IN h-imapi009 (OUTPUT table tt-fam-comerc).
    FIND FIRST tt-fam-comerc NO-ERROR.
    if avail tt-fam-comerc then
        ASSIGN {1}.desc-fam-comerc = tt-fam-comerc.descricao.

    empty temp-table tt-fam-comerc.

    RUN getItemFornec IN h-imapi009 (OUTPUT table tt-item-fornec).
    FIND FIRST tt-item-fornec NO-ERROR.
    if avail tt-item-fornec then
        ASSIGN {1}.item-fornec	      = tt-item-fornec.item-do-forn
               {1}.cod-embal	      = tt-item-fornec.cod-embal
               {1}.fator-conver	      = tt-item-fornec.fator-conver
               {1}.num-casa-dec	      = tt-item-fornec.num-casa-dec
               {1}.narrat-item-fornec = tt-item-fornec.narrativa.

    empty temp-table tt-item-fornec.

    RUN getUN IN h-imapi009 (OUTPUT table tt-un).
    FIND FIRST tt-un NO-ERROR.
    if avail tt-un then
        ASSIGN {1}.desc-un-interno = tt-un.desc-un-interno
               {1}.desc-un-fornec  = tt-un.desc-un-fornec.

    empty temp-table tt-un.

    RUN getEmbalag IN h-imapi009 (OUTPUT table tt-embalag).
    FIND FIRST tt-embalag NO-ERROR.
    if avail tt-embalag then 
        ASSIGN {1}.sigla-embalag = tt-embalag.sigla-emb
               {1}.desc-embalag	 = tt-embalag.descricao
               {1}.desc-embalag	 = tt-embalag.descricao
               {1}.peso-embalag	 = tt-embalag.peso-embal.

    empty temp-table tt-embalag.

    &IF "{1}" = "tt-ordem-ncm-fabr-ped-compr-emb" &THEN
    
            find first bf-embarque-imp
                 where bf-embarque-imp.cod-estabel = {1}.cod-estabel
                   and bf-embarque-imp.embarque    = {1}.embarque no-lock no-error.
            
            RUN setConstraintEmbarqueImp IN h-imapi009 (INPUT rowid(embarque-imp)).
        
            RUN getOrdensEmbarque in h-imapi009 (output table tt-ordens-embarque).
            for each tt-ordens-embarque where tt-ordens-embarque.numero-ordem = {1}.numero-ordem:
        
                find ordem-compra 
               where ordem-compra.numero-ordem = tt-ordens-embarque.numero-ordem no-lock no-error.
        
                find item where item.it-codigo = ordem-compra.it-codigo no-lock no-error.
        
                assign {1}.quantidade     = {1}.quantidade + tt-ordens-embarque.quantidade
                       {1}.qt-do-forn     = {1}.qt-do-forn + tt-ordens-embarque.qt-do-forn.
                       {1}.qt-estatistica = {1}.qt-estatistica + (tt-ordens-embarque.quantidade * item.fator-conver).
                
            end.
            
            assign l-ordem-embarque = no.
            
            find first tt-ordens-embarque 
                where  tt-ordens-embarque.embarque     = {1}.embarque
                  and  tt-ordens-embarque.numero-ordem = {1}.numero-ordem no-error.
            if avail tt-ordens-embarque then do:
                 find first ordens-embarque 
                      WHERE ordens-embarque.embarque = {1}.embarque 
                        and ordens-embarque.numero-ordem = {1}.numero-ordem no-lock no-error.
                 if avail ordens-embarque then do:
                 
                     if ordens-embarque.cd-trib-icms        <> 0 OR 
                        ordens-embarque.cd-trib-ipi         <> 0 OR       
                        ordens-embarque.aliquota-icms       <> 0 OR
                        ordens-embarque.aliquota-ipi        <> 0 OR 
                        ordens-embarque.aliquota-ii         <> 0 OR
                        ordens-embarque.cd-trib-ii          <> 0 OR
                        ordens-embarque.idi-tributac-pis    <> 0 OR
                        ordens-embarque.idi-tributac-cofins <> 0 OR
                        ordens-embarque.val-aliq-ext-pis    <> 0 OR 
                        ordens-embarque.val-aliq-ext-cofins <> 0 OR
                        ordens-embarque.peso-liquido        <> 0 OR
                        ordens-embarque.peso-bruto          <> 0 then do:
                        
                         assign {1}.trib-icms           = {ininc/i01in245.i 04 tt-ordens-embarque.cd-trib-icms} 
                                {1}.trib-ipi            = {ininc/i10in172.i 04 tt-ordens-embarque.cd-trib-ipi}
                                {1}.aliquota-icms       = tt-ordens-embarque.aliquota-icms
                                {1}.aliquota-ipi        = tt-ordens-embarque.aliquota-ipi 
                                {1}.aliquota-ii         = tt-ordens-embarque.aliquota-ii
                                {1}.trib-ii             = {ininc/i10in172.i 04 tt-ordens-embarque.cd-trib-ii}  
                                {1}.trib-pis            = {ininc/i04in176.i 04 tt-ordens-embarque.idi-tributac-pis} 
                                {1}.trib-cofins         = {ininc/i04in176.i 04 tt-ordens-embarque.idi-tributac-cofins}
                                {1}.aliquota-pis-ext    = tt-ordens-embarque.val-aliq-ext-pis 
                                {1}.aliquota-cofins-ext = tt-ordens-embarque.val-aliq-ext-cofins
                                {1}.peso-liquido        = tt-ordens-embarque.peso-liquido 
                                {1}.peso-bruto          = tt-ordens-embarque.peso-bruto
                                l-ordem-embarque        = yes.
                        
                     end.
                 end.
            end.
            
            empty temp-table tt-ordens-embarque.
        
            run getCalculosOrdemCompraEmbarque IN h-imapi009 (INPUT {1}.r-rowid-ordens-emb,
                                                              output table tt-calculos-ordem-compra-emb).
                                                             
            find first tt-calculos-ordem-compra-emb no-error.
            if avail tt-calculos-ordem-compra-emb then do:
            
                if {1}.peso-liquido = 0 then
                   assign {1}.peso-liquido-total = tt-calculos-ordem-compra-emb.peso-liquido-total.
                if {1}.peso-bruto   = 0 then
                   assign {1}.peso-bruto-total = tt-calculos-ordem-compra-emb.peso-bruto-total.
                   
                assign {1}.prc-fornec-liq        = tt-calculos-ordem-compra-emb.preco-fornec-liq
                       {1}.prc-interno-liq       = tt-calculos-ordem-compra-emb.preco-interno-liq
                       {1}.prc-fornec-bru        = tt-calculos-ordem-compra-emb.preco-fornec-bru
                       {1}.prc-interno-bru       = tt-calculos-ordem-compra-emb.preco-interno-bru
                       {1}.prc-fornec-liq-total  = tt-calculos-ordem-compra-emb.preco-fornec-liq-total
                       {1}.prc-interno-liq-total = tt-calculos-ordem-compra-emb.preco-interno-liq-total
                       {1}.prc-fornec-bru-total  = tt-calculos-ordem-compra-emb.preco-fornec-bru-total
                       {1}.prc-interno-bru-total = tt-calculos-ordem-compra-emb.preco-interno-bru-total
                       {1}.ocupacao-total        = tt-calculos-ordem-compra-emb.ocupacao-total.
            
            end.  
            
            if l-ordem-embarque then
                 assign {1}.peso-liquido-total = tt-calculos-ordem-compra-emb.peso-liquido-total  
                        {1}.peso-bruto-total   = {1}.peso-bruto.   
                        

            empty temp-table tt-calculos-ordem-compra-emb.
    
    &endif
    
    &IF "{1}" = "tt-ordem-ncm-fabr-processo-imp" &THEN 
    
            RUN setConstraintOrdensCompra IN h-imapi009 (INPUT {1}.r-rowid-ordem-compra).
            
            RUN getPrazoCompra in h-imapi009 (output table tt-parcelas).
            
            find ordem-compra 
               where ordem-compra.numero-ordem = {1}.numero-ordem no-lock no-error.
        
            find item 
                 where item.it-codigo = ordem-compra.it-codigo no-lock no-error.
                
            for each tt-parcelas:
            
                assign {1}.quantidade     = {1}.quantidade + tt-parcelas.quantidade
                       {1}.qt-do-forn     = {1}.qt-do-forn + tt-parcelas.qtd-do-forn.
                       {1}.qt-estatistica = {1}.qt-estatistica + (tt-parcelas.quantidade * item.fator-conver).
                
            end.
            
            empty temp-table tt-parcelas.
        
            run getCalculosOrdemCompra IN h-imapi009 (output table tt-calculos-ordem).
            find first tt-calculos-ordem no-error.
            if avail tt-calculos-ordem then
                
                assign {1}.peso-liquido-total      = tt-calculos-ordem.peso-liquido-total
                       {1}.peso-bruto-total        = tt-calculos-ordem.peso-bruto-total  
                       {1}.prc-fornec-liq        = tt-calculos-ordem.preco-fornec-liq
                       {1}.prc-interno-liq       = tt-calculos-ordem.preco-interno-liq
                       {1}.prc-fornec-bru        = tt-calculos-ordem.preco-fornec-bru
                       {1}.prc-interno-bru       = tt-calculos-ordem.preco-interno-bru
                       {1}.prc-fornec-liq-total  = tt-calculos-ordem.preco-fornec-liq-total
                       {1}.prc-interno-liq-total = tt-calculos-ordem.preco-interno-liq-total
                       {1}.prc-fornec-bru-total  = tt-calculos-ordem.preco-fornec-bru-total
                       {1}.prc-interno-bru-total = tt-calculos-ordem.preco-interno-bru-total
                       {1}.ocupacao-total          = tt-calculos-ordem.ocupacao-total.
        
            empty temp-table tt-calculos-ordem.
            
    &endif
    
    RUN cdp/cd0812.p (INPUT {1}.mo-codigo,
                      INPUT 0,
                      INPUT {1}.prc-fornec-liq,
                      INPUT TODAY,
                      OUTPUT de-valor-preco-fornec-liq).

    RUN cdp/cd0812.p (INPUT {1}.mo-codigo,
                      INPUT 0,
                      INPUT {1}.prc-interno-liq,
                      INPUT TODAY,
                      OUTPUT de-valor-preco-interno-liq).

    RUN cdp/cd0812.p (INPUT {1}.mo-codigo,
                      INPUT 0,
                      INPUT {1}.prc-fornec-bru,
                      INPUT TODAY,
                      OUTPUT de-valor-preco-fornec-bru).

    RUN cdp/cd0812.p (INPUT {1}.mo-codigo,
                      INPUT 0,
                      INPUT {1}.prc-interno-bru,
                      INPUT TODAY,
                      OUTPUT de-valor-preco-interno-bru).
                      
    RUN cdp/cd0812.p (INPUT {1}.mo-codigo,
                      INPUT 0,
                      INPUT {1}.prc-fornec-liq-total,
                      INPUT TODAY,
                      OUTPUT de-valor-preco-fornec-liq-total).
                      
    RUN cdp/cd0812.p (INPUT {1}.mo-codigo,
                      INPUT 0,
                      INPUT {1}.prc-interno-liq-total,
                      INPUT TODAY,
                      OUTPUT de-valor-preco-interno-liq-total).

    RUN cdp/cd0812.p (INPUT {1}.mo-codigo,
                      INPUT 0,
                      INPUT {1}.prc-fornec-bru-total,
                      INPUT TODAY,
                      OUTPUT de-valor-preco-fornec-bru-total).

    RUN cdp/cd0812.p (INPUT {1}.mo-codigo,
                      INPUT 0,
                      INPUT {1}.prc-interno-bru-total,
                      INPUT TODAY,
                      OUTPUT de-valor-preco-interno-bru-total).
                      
    assign {1}.prc-fornec-liq-mo-cor         = de-valor-preco-fornec-liq        
           {1}.prc-interno-liq-mo-cor        = de-valor-preco-interno-liq
           {1}.prc-fornec-bru-mo-cor         = de-valor-preco-fornec-bru
           {1}.prc-interno-bru-mo-cor        = de-valor-preco-interno-bru
           {1}.prc-fornec-liq-total-mo-cor   = de-valor-preco-fornec-liq-total
           {1}.prc-interno-liq-total-mo-cor  = de-valor-preco-interno-liq-total
           {1}.prc-fornec-bru-total-mo-cor   = de-valor-preco-fornec-bru-total
           {1}.prc-interno-bru-total-mo-cor  = de-valor-preco-interno-bru-total.
           
    
&ENDIF

&IF "{1}" = "total" and "{2}" = "tt-ordem-ncm-fabr-processo-imp" or 
    "{1}" = "total" and "{2}" = "tt-ordem-ncm-fabr-ped-compr-emb" &then
        
        
        assign de-peso-liq-total-ncm           = de-peso-liq-total-ncm + {2}.peso-liquido-total
               de-peso-bruto-total-ncm         = de-peso-bruto-total-ncm + {2}.peso-bruto-total
               de-preco-fornec-liq-total-ncm   = de-preco-fornec-liq-total-ncm + {2}.prc-fornec-liq-total-mo-cor 
               de-preco-interno-liq-total-ncm  = de-preco-interno-liq-total-ncm + {2}.prc-interno-liq-total-mo-cor
               de-preco-fornec-bru-total-ncm   = de-preco-fornec-bru-total-ncm + {2}.prc-fornec-bru-total-mo-cor  
               de-preco-interno-bru-total-ncm  = de-preco-interno-bru-total-ncm + {2}.prc-interno-bru-total-mo-cor
               de-ocupacao-total-ncm           = de-ocupacao-total-ncm + {2}.ocupacao-total
               de-quantidade-total-ncm         = de-quantidade-total-ncm + {2}.quantidade
               de-qt-do-forn-total-ncm         = de-qt-do-forn-total-ncm + {2}.qt-do-forn
               de-qt-estatistica-total-ncm     = de-qt-estatistica-total-ncm + {2}.qt-estatistica. 
               
        assign de-peso-liq-total-fabr          = de-peso-liq-total-fabr + {2}.peso-liquido-total
               de-peso-bruto-total-fabr        = de-peso-bruto-total-fabr + {2}.peso-bruto-total
               de-preco-fornec-liq-total-fabr  = de-preco-fornec-liq-total-fabr + {2}.prc-fornec-liq-total-mo-cor 
               de-preco-interno-liq-total-fabr = de-preco-interno-liq-total-fabr + {2}.prc-interno-liq-total-mo-cor
