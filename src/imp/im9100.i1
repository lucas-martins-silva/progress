                      and tt-fabr-ped-compr-emb.num-pedido     = {2}.num-pedido
                      and tt-fabr-ped-compr-emb.embarque       = {2}.embarque
                      and tt-fabr-ped-compr-emb.cod-fabricante = {2}.cod-fabricante no-error.


               assign tt-fabr-ped-compr-emb.peso-liquido-total-fabr           = tt-fabr-ped-compr-emb.peso-liquido-total-fabr + de-peso-liq-total-fabr         
                      tt-fabr-ped-compr-emb.peso-bruto-total-fabr             = tt-fabr-ped-compr-emb.peso-bruto-total-fabr + de-peso-bruto-total-fabr       
                      tt-fabr-ped-compr-emb.prc-fornec-liq-total-fabr-mo-cor  = tt-fabr-ped-compr-emb.prc-fornec-liq-total-fabr-mo-cor + de-preco-fornec-liq-total-fabr 
                      tt-fabr-ped-compr-emb.prc-intern-liq-total-fabr-mo-cor  = tt-fabr-ped-compr-emb.prc-intern-liq-total-fabr-mo-cor + de-preco-interno-liq-total-fabr
                      tt-fabr-ped-compr-emb.prc-fornec-bru-total-fabr-mo-cor  = tt-fabr-ped-compr-emb.prc-fornec-bru-total-fabr-mo-cor + de-preco-fornec-bru-total-fabr 
                      tt-fabr-ped-compr-emb.prc-intern-bru-total-fabr-mo-cor  = tt-fabr-ped-compr-emb.prc-intern-bru-total-fabr-mo-cor + de-preco-interno-bru-total-fabr
                      tt-fabr-ped-compr-emb.ocupacao-total-fabr               = tt-fabr-ped-compr-emb.ocupacao-total-fabr + de-ocupacao-total-fabr         
                      tt-fabr-ped-compr-emb.quantidade-total-fabr             = tt-fabr-ped-compr-emb.quantidade-total-fabr + de-quantidade-total-fabr       
