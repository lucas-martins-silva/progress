                  de-preco-fornec-liq-total-fabr   = 0
                  de-preco-interno-liq-total-fabr  = 0
                  de-preco-fornec-bru-total-fabr   = 0
                  de-preco-interno-bru-total-fabr  = 0
                  de-ocupacao-total-fabr           = 0
                  de-quantidade-total-fabr         = 0
                  de-qt-do-forn-total-fabr         = 0
                  de-qt-estatistica-total-fabr     = 0.

       end.
       
           
       &if "{2}" = "tt-ordem-ncm-fabr-ped-compr-emb" &then
           
