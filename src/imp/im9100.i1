       assign  de-peso-liq-total-emb           = de-peso-liq-total-emb + {2}.peso-liquido-total                     
               de-peso-bruto-total-emb         = de-peso-bruto-total-emb + {2}.peso-bruto-total                     
               de-preco-fornec-liq-total-emb   = de-preco-fornec-liq-total-emb + {2}.prc-fornec-liq-total-mo-cor    
               de-preco-interno-liq-total-emb  = de-preco-interno-liq-total-emb + {2}.prc-interno-liq-total-mo-cor  
               de-preco-fornec-bru-total-emb   = de-preco-fornec-bru-total-emb + {2}.prc-fornec-bru-total-mo-cor    
               de-preco-interno-bru-total-emb  = de-preco-interno-bru-total-emb + {2}.prc-interno-bru-total-mo-cor  
               de-ocupacao-total-emb           = de-ocupacao-total-emb + {2}.ocupacao-total                         
