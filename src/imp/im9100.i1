&if "{1}" = "tt-desp-embarque" &then

    RUN setConstraintCotacaoItemCex IN h-imapi009 (INPUT {1}.r-cotacao-it-cex).

    empty temp-table tt-despesa-emb.
    
    RUN cdp/cd0812.p (INPUT {1}.mo-codigo,
                      INPUT 0,
                      INPUT {1}.val-desp,
                      INPUT TODAY,
                      OUTPUT de-val-desp-mo-corren).

    assign {1}.val-desp-mo-corren = de-val-desp-mo-corren.
    
    find first ordens-embarque 
         where ordens-embarque.cod-estabel = {1}.cod-estabel
           and ordens-embarque.embarque    = {1}.embarque no-lock no-error.
           
    if avail ordens-embarque then do:
        find first ordem-compra 
             where ordem-compra.numero-ordem = ordens-embarque.numero-ordem no-lock no-error.
        if avail ordem-compra then do:
              RUN cdp/cd0812.p (INPUT {1}.mo-codigo,
                                INPUT ordem-compra.mo-codigo,
                                INPUT {1}.val-desp,
                                INPUT TODAY,
                                OUTPUT de-val-desp-mo-ordem). 
        end.
    end.
    
    assign {1}.val-desp-mo-ordem = de-val-desp-mo-ordem.

    RUN getEmitenteDesp IN h-imapi009 (OUTPUT table tt-emitente).
    FIND FIRST tt-emitente NO-ERROR.
    if avail tt-emitente then
        assign {1}.nome-emit-desp	       = tt-emitente.nome-emit
               {1}.endereco-emit-desp      = tt-emitente.endereco
               {1}.bairro-emit-desp	       = tt-emitente.bairro
               {1}.cidade-emit-desp	       = tt-emitente.cidade
               {1}.pais-emit-desp	       = tt-emitente.pais
               {1}.cep-emit-desp	       = tt-emitente.cep
               {1}.cgc-emit-desp           = tt-emitente.cgc
               {1}.estado-emit-desp	       = tt-emitente.estado
               {1}.ins-estadual-emit-desp  = tt-emitente.ins-estadual
               {1}.ins-municipal-emit-desp = tt-emitente.ins-municipal
               {1}.caixa-postal-emit-desp  = tt-emitente.caixa-postal
               {1}.e-mail-emit-desp	       = tt-emitente.e-mail
               {1}.cod-aba-emit-desp       = tt-emitente.cod-aba
               {1}.telefone1-emit-desp     = tt-emitente.telefone[1]
               {1}.telefone2-emit-desp     = tt-emitente.telefone[2]
               {1}.ramal1-emit-desp	       = tt-emitente.ramal[1]
               {1}.ramal2-emit-desp	       = tt-emitente.ramal[2]
               {1}.home-page-emit-desp     = tt-emitente.home-page
               {1}.telefax-emit-desp       = tt-emitente.telefax
               {1}.ramal-fax-emit-desp     = tt-emitente.ramal-fax
               {1}.telef-fac-emit-desp     = tt-emitente.telef-fac
               {1}.ramal-fac-emit-desp     = tt-emitente.ramal-fac
               {1}.telef-modem-emit-desp   = tt-emitente.telef-modem
               {1}.ramal-modem-emit-desp   = tt-emitente.ramal-modem.

    empty temp-table tt-emitente.

    RUN getMoeda IN h-imapi009 (OUTPUT table tt-moeda).
    FIND FIRST tt-moeda NO-ERROR.
    if avail tt-moeda then
        assign {1}.desc-moeda  = tt-moeda.descricao
               {1}.sigla-moeda = tt-moeda.sigla.

    empty temp-table tt-moeda.

    RUN getDespImp IN h-imapi009 (OUTPUT table tt-desp).
    FIND FIRST tt-desp NO-ERROR.
    if avail tt-desp then
        assign {1}.desc-despesa	= tt-desp.descricao.

    RUN getPtoControle IN h-imapi009 (OUTPUT table tt-pto-contr).
    FIND FIRST tt-pto-contr NO-ERROR.
    if avail tt-pto-contr then
        assign {1}.desc-pto-contr = tt-pto-contr.descricao.

    RUN getCondicaoPagamento IN h-imapi009 (OUTPUT table tt-cond-pagto).
    FIND FIRST tt-cond-pagto NO-ERROR.
    if avail tt-cond-pagto then
        assign {1}.desc-cond-pagto = tt-cond-pagto.descricao.

    
&endif

&if "{1}" = "tt-desp-pedido" &then

    RUN setConstraintCotacaoItemCex IN h-imapi009 (INPUT {1}.r-cotacao-it-cex).

    RUN cdp/cd0812.p (INPUT {1}.mo-codigo,
                      INPUT 0,
                      INPUT {1}.val-desp,
                      INPUT TODAY,
                      OUTPUT de-val-desp-mo-corren).

    assign {1}.val-desp-mo-corren = de-val-desp-mo-corren.
    
    find FIRST ordem-compra
         WHERE ordem-compra.numero-ordem = {1}.numero-ordem NO-LOCK.
    if avail ordem-compra then do:     
         RUN cdp/cd0812.p (INPUT {1}.mo-codigo,
                           INPUT ordem-compra.mo-codigo,
                           INPUT {1}.val-desp,
                           INPUT TODAY,
                           OUTPUT de-val-desp-mo-ordem).
    end.     
    
    assign {1}.val-desp-mo-ordem = de-val-desp-mo-ordem.

    RUN getEmitenteDesp IN h-imapi009 (OUTPUT table tt-emitente).
    FIND FIRST tt-emitente NO-ERROR.
    if avail tt-emitente then
        assign {1}.nome-emit-desp          = tt-emitente.nome-emit
               {1}.endereco-emit-desp      = tt-emitente.endereco
               {1}.bairro-emit-desp	       = tt-emitente.bairro
               {1}.cidade-emit-desp	       = tt-emitente.cidade
               {1}.pais-emit-desp	       = tt-emitente.pais
               {1}.cep-emit-desp	       = tt-emitente.cep
               {1}.cgc-emit-desp	       = tt-emitente.cgc
               {1}.estado-emit-desp	       = tt-emitente.estado
               {1}.ins-estadual-emit-desp  = tt-emitente.ins-estadual
               {1}.ins-municipal-emit-desp = tt-emitente.ins-municipal
               {1}.caixa-postal-emit-desp  = tt-emitente.caixa-postal
               {1}.e-mail-emit-desp        = tt-emitente.e-mail
               {1}.cod-aba-emit-desp       = tt-emitente.cod-aba
               {1}.telefone1-emit-desp     = tt-emitente.telefone[1]
               {1}.telefone2-emit-desp     = tt-emitente.telefone[2]
               {1}.ramal1-emit-desp        = tt-emitente.ramal[1]
               {1}.ramal2-emit-desp        = tt-emitente.ramal[2]
               {1}.home-page-emit-desp     = tt-emitente.home-page
               {1}.telefax-emit-desp       = tt-emitente.telefax
               {1}.ramal-fax-emit-desp     = tt-emitente.ramal-fax
               {1}.telef-fac-emit-desp     = tt-emitente.telef-fac
               {1}.ramal-fac-emit-desp     = tt-emitente.ramal-fac
               {1}.telef-modem-emit-desp   = tt-emitente.telef-modem
               {1}.ramal-modem-emit-desp   = tt-emitente.ramal-modem.

    empty temp-table tt-emitente.
    
    RUN getMoeda IN h-imapi009 (OUTPUT table tt-moeda).
    FIND FIRST tt-moeda NO-ERROR.
    if avail tt-moeda then
        assign {1}.desc-moeda  = tt-moeda.descricao
               {1}.sigla-moeda = tt-moeda.sigla.

    empty temp-table tt-moeda.
    
    empty temp-table tt-desp.
    
    RUN getDespImp IN h-imapi009 (OUTPUT table tt-desp).
    FIND FIRST tt-desp NO-ERROR.
    if avail tt-desp then
        assign {1}.desc-despesa = tt-desp.descricao.

    RUN getPtoControle IN h-imapi009 (OUTPUT table tt-pto-contr).
    FIND FIRST tt-pto-contr NO-ERROR.
    if avail tt-pto-contr then
        assign {1}.desc-pto-contr = tt-pto-contr.descricao.

    RUN getCondicaoPagamento IN h-imapi009 (OUTPUT table tt-cond-pagto).
    FIND FIRST tt-cond-pagto NO-ERROR.
    if avail tt-cond-pagto then
         assign {1}.desc-cond-pagto = tt-cond-pagto.descricao.

    
&endif


    
    


