               de-quantidade-total-fabr        = de-quantidade-total-fabr + {2}.quantidade
               de-qt-do-forn-total-fabr        = de-qt-do-forn-total-fabr + {2}.qt-do-forn
               de-qt-estatistica-total-fabr    = de-qt-estatistica-total-fabr + {2}.qt-estatistica.
               
       assign  de-peso-liq-total-ped           = de-peso-liq-total-ped + {2}.peso-liquido-total
               de-peso-bruto-total-ped         = de-peso-bruto-total-ped + {2}.peso-bruto-total
               de-preco-fornec-liq-total-ped   = de-preco-fornec-liq-total-ped + {2}.prc-fornec-liq-total-mo-cor 
               de-preco-interno-liq-total-ped  = de-preco-interno-liq-total-ped + {2}.prc-interno-liq-total-mo-cor
               de-preco-fornec-bru-total-ped   = de-preco-fornec-bru-total-ped  + {2}.prc-fornec-bru-total-mo-cor  
