                      tt-ncm-fabr-processo-imp.qt-estatistica-total-ncm         = tt-ncm-fabr-processo-imp.qt-estatistica-total-ncm + de-qt-estatistica-total-ncm.
                    
                
           &endif                                            
           
           &if "{2}" = "tt-ordem-ncm-fabr-ped-compr-emb" &then
           
