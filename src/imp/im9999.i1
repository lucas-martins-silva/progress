/*******************************************************************************
**
**     Programa: IM9999.i1 - Procura traducao para mensagem.
**                           {1} - Texto a ser traduzido
**                           {2} - campo/vari vel a receber tradu‡Æo como label
**                           {3} - tabela que possui o c¢digo do idioma a ser traduzido
**                           {4} - frame  
**
*******************************************************************************/

  find trad-gerais use-index pk-tr-texto
     where trad-gerais.texto      =  "{1}"
     and   trad-gerais.cod-idioma =   {3}.cod-idioma
     no-lock no-error.
  if  avail trad-gerais then
      assign {2}:label in frame {4} = trim(trad-gerais.texto-trad).
  else     
      assign {2}:label in frame {4} = "{1}".
