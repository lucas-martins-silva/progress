{include/i_dbvers.i}
/********************************************************************************
**
** IM0657.i1 - Defini‡Æo temp-table tt-param.
**
********************************************************************************/

define temp-table tt-param
&IF "{&mguni_version}" >= "2.071" &THEN
    field ep-codigo            LIKE empresa.ep-codigo
&ELSE
    field ep-codigo            as integer
&ENDIF
    field destino              as integer   /* IMPRESSORA - 1, ARQUIVO - 2, E-MAIL - 3 */
    field arquivo              as char format "x(30)"   /* Nome do Arquivo */
    field diretorio            as char      /* Diretorio do arquivo */
    field usuario              as char      /* Usuario */
    field data-exec            as date      /* Data execu‡Æo */
    field hora-exec            as integer   /* Hora execu‡Æo */
    field i-cod-itiner-ini     like historico-embarque.cod-itiner /* Itiner rio Inicial */
    field i-cod-itiner-fim     as integer   /* Itinerario Final */
    field i-cod-pto-ini        like historico-embarque.cod-pto-contr /* Ponto de Controle Inicial */
    field i-cod-pto-fim        like historico-embarque.cod-pto-contr   /* Ponto de Controle Final */
    field c-nome-abrev-ini     as char format "x(12)"  /* Fornecedor Inicial */    
    field c-nome-abrev-fim     as char format "x(12)"   /* Fornecedor Final */
    field d-data-ini           as date   format "99/99/9999" /* Data Inicial */
    field d-data-fim           as date   format "99/99/9999" /* Data Final */
    field i-percentual         as integer format ">>>9" label "Percentual de Erro"
    field l-imprime            as logical   /* Imprime P gina Parƒmetros */
    field c-destino            as char      /* Cliente Servidor */
    field c-endmail            as char.     /* Endere‡o e-mail remetente - Magnus */
