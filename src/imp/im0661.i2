/****************************************************************************************
***  IM0658.I2 - Logica do programa de Controle de Importacao
***
***  Obs.: {1} - Controla a ordenacao.
***
*****************************************************************************************/

assign   i-cont-1 = 1.

for each tt-item no-lock
         break by tt-item.it-codigo
               by tt-item.cod-emitente
               by year(tt-item.dt-emissao)
               by month(tt-item.dt-emissao):
         
         assign dt-nacionalizacao = tt-param.data-cotacao.
         
         if tt-param.l-dtnacion = yes then do:

             find embarque-imp where
                  embarque-imp.cod-estabel = tt-item.cod-estabel and
                  embarque-imp.embarque    = tt-item.embarque     no-lock no-error. 
             if avail embarque-imp then
                     if embarque-imp.data-1 <> ? then
                          assign dt-nacionalizacao = embarque-imp.data-1.
                     else 
                          assign dt-nacionalizacao = tt-param.data-cotacao.
         end. 
         
         if line-counter < 7 then do:
                disp c-lb-item
                     c-lb-descr
                     c-lb-un
                     c-lb-mes[1]
                     c-lb-mes[2]
                     c-lb-mes[3]
                     c-lb-mes[4]
                     c-lb-mes[5]
                     c-lb-mes[6]
                     c-lb-mes[7]
                     c-lb-mes[8]
                     c-lb-mes[9]
                     c-lb-mes[10]
                     c-lb-mes[11]
                     c-lb-mes[12] 
                     c-lb-totais skip
                     "----------------------" 
                     "------"  when c-lb-mes[1] <> "" 
                     "-------" when c-lb-mes[2] <> "" 
                     "-------" when c-lb-mes[3] <> ""
                     "-------" when c-lb-mes[4] <> ""
                     "-------" when c-lb-mes[5] <> ""
                     "-------" when c-lb-mes[6] <> ""
                     "-------" when c-lb-mes[7] <> ""
                     "-------" when c-lb-mes[8] <> ""
                     "-------" when c-lb-mes[9] <> ""
                     "-------" when c-lb-mes[10] <> ""
                     "-------" when c-lb-mes[11] <> ""
                     "-------" when c-lb-mes[12] <> ""                     
                     "----------" when c-lb-totais <> ""
                     c-lb-fornecedor   
                     c-lb-moeda
                with frame f-lab-cabecalho.         
         end.
         
         /*** converte valores ***/
         run cdp/cd0812.p (input tt-item.mo-codigo,
                           input tt-param.mo-codigo,
                           input tt-item.preco,
                           input dt-nacionalizacao,
                           output de-preco-convertido).
         
         assign de-quant       = de-quant + tt-item.quantidade
                de-preco-total = de-preco-total + de-preco-convertido
                de-preco-convertido = 0.
        
         if last-of(month(tt-item.dt-emissao)) then do:
            REPEAT ON ENDKEY UNDO, RETRY:
                if month(tt-item.dt-emissao) <> i-mes-faixa then do:
                   assign de-quant-mes[i-cont-1] = 0
                          de-preco-total-mes[i-cont-1] = 0. 
                   if i-mes-faixa <> 12 then
                       assign i-mes-faixa = i-mes-faixa + 1.
                   else 
                       assign i-mes-faixa = 1.
                   if i-cont-1 = 12 then do:
                      assign i-cont-1 = 1.
                      leave.
                   end.
                   assign i-cont-1 = i-cont-1 + 1.
                end.
            
                if month(tt-item.dt-emissao) = i-mes-faixa then do:
                  assign de-quant-mes[i-cont-1] = de-quant
                         de-preco-total-mes[i-cont-1] = de-preco-total.
                  if i-mes-faixa <> 12 then
                     assign i-mes-faixa = i-mes-faixa + 1.
                  else 
                     assign i-mes-faixa = 1.
                  if i-cont-1 = 12 then do:
                     assign i-cont-1 = 1.
                     leave.
                  end.
                  assign i-cont-1 = i-cont-1 + 1.
                  leave.
                end.
            end. 
            
            assign de-total-quant = de-total-quant + de-quant
                   de-total-preco = de-total-preco + de-preco-total
                   de-quant = 0
                   de-preco-total = 0.
         end.
          
         if first-of(tt-item.it-codigo) then do:
         
            disp tt-item.it-codigo
                 tt-item.desc-item
            with frame f-item.
         end.
         
         if last-of(tt-item.cod-emitente) then do:
            
            disp tt-item.nome-abrev
                 tt-item.un
                 de-quant-mes[1] when de-quant-mes[1] <> 0
                 de-quant-mes[2] when de-quant-mes[2] <> 0
                 de-quant-mes[3] when de-quant-mes[3] <> 0
                 de-quant-mes[4] when de-quant-mes[4] <> 0
                 de-quant-mes[5] when de-quant-mes[5] <> 0
                 de-quant-mes[6] when de-quant-mes[6] <> 0
                 de-quant-mes[7] when de-quant-mes[7] <> 0
                 de-quant-mes[8] when de-quant-mes[8] <> 0
                 de-quant-mes[9] when de-quant-mes[9] <> 0
                 de-quant-mes[10] when de-quant-mes[10] <> 0
                 de-quant-mes[11] when de-quant-mes[11] <> 0
                 de-quant-mes[12] when de-quant-mes[12] <> 0
                 de-total-quant when de-total-quant <> 0
                 tt-item.sigla                 
                 de-preco-total-mes[1] when de-preco-total-mes[1] <> 0
                 de-preco-total-mes[2] when de-preco-total-mes[2] <> 0
                 de-preco-total-mes[3] when de-preco-total-mes[3] <> 0
                 de-preco-total-mes[4] when de-preco-total-mes[4] <> 0
                 de-preco-total-mes[5] when de-preco-total-mes[5] <> 0
                 de-preco-total-mes[6] when de-preco-total-mes[6] <> 0
                 de-preco-total-mes[7] when de-preco-total-mes[7] <> 0
                 de-preco-total-mes[8] when de-preco-total-mes[8] <> 0
                 de-preco-total-mes[9] when de-preco-total-mes[9] <> 0
                 de-preco-total-mes[10] when de-preco-total-mes[10] <> 0
                 de-preco-total-mes[11] when de-preco-total-mes[11] <> 0
                 de-preco-total-mes[12] when de-preco-total-mes[12] <> 0
                 de-total-preco when de-total-preco <> 0                 
            with frame f-detalhe.
            down with frame f-detalhe.
            
            do aux = 1 to  12:
               assign de-quant-mes[aux] = 0
                      de-preco-total-mes[aux] = 0.
            end.            
            assign de-total-quant = 0
                   de-total-preco = 0
                   i-cont-1 = 1
                   i-mes-faixa = i-mes-faixa-bck.
            if last-of(tt-item.it-codigo) then do:
                put skip(1).         
            end.
                   
            if line-counter  > (page-size - 3) then
               page.
             
         end.
end.
