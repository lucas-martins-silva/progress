/*configurar impressao da pagina de parametros*/

def var c-especie       as char extent 4               no-undo.
def var c-rec-fis       as char format "x(11)" init "" no-undo.

{utp/ut-liter.i SELE€ÇO * r}
assign c-lb-sel = trim(return-value).
{utp/ut-liter.i PAR¶METROS * r}
assign c-lb-par = trim(return-value).
{utp/ut-liter.i IMPRESSÇO * r}
assign c-lb-imp = trim(return-value).
{utp/ut-liter.i Destino * r}
assign c-lb-dest = trim(return-value).
{utp/ut-liter.i Usu rio * r}
assign c-lb-usu = trim(return-value).
{utp/ut-liter.i Imprimir_P gina_de_Parƒmetros * r}
assign c-lb-imprime-param = trim(return-value).

/*variaveis folder selecao*/
{utp/ut-liter.i Estabelecimento * r}
assign c-lb-estabel = trim(return-value).
{utp/ut-liter.i Embarque * r}
assign c-lb-embarque = trim(return-value).
{utp/ut-liter.i "DI-SISCOMEX" * r}
assign c-lb-di-siscomex = trim(return-value).
{utp/ut-liter.i Data_de_Nacionaliza‡Æo * r}
assign c-lb-dt-nacionaliza = trim(return-value).
{utp/ut-liter.i Emitente * r}
assign c-lb-emite = trim(return-value).
{utp/ut-liter.i S‚rie * r}
assign c-lb-serie = trim(return-value).
{utp/ut-liter.i Documento * r}
assign c-lb-docto = trim(return-value).
{utp/ut-liter.i Nat_Opera‡Æo * r}
assign c-lb-natur = trim(return-value).
{utp/ut-liter.i Data_de_EmissÆo * r}
assign c-lb-dt-emissao = trim(return-value).
/*variaveis folder parametro*/
{utp/ut-liter.i Imprime * r}
assign c-lb-imprime = trim(return-value).
{utp/ut-liter.i Despesas * r}
assign c-lb-despesa = trim(return-value).
{utp/ut-liter.i Duplicatas * r}
assign c-lb-duplicata = trim(return-value).
{utp/ut-liter.i Detalhes_do_Itiner rio * r}
assign c-lb-itiner = trim(return-value).
{utp/ut-liter.i Itens_da_Nota * r}
assign c-lb-item = trim(return-value).
{utp/ut-liter.i Despesas_dos_Itens * r}
assign c-lb-desp-item = trim(return-value).
{utp/ut-liter.i Considera_somente_Notas_Fiscais_Atualizadas_no_Estoque * r}
assign c-lb-nfe-ce = trim(return-value).
{utp/ut-liter.i Detalha_NF_Complementar * r}
assign c-lb-nfc = trim(return-value).
{utp/ut-liter.i Considera_somente_NF_Complementar_Atualizada_no_Estoque * r}
assign c-lb-nfc-ce = trim(return-value).
    

form docum-est.cod-emitente colon 24
     docum-est.serie-docto  colon 62
     c-embarque-imp         colon 105
     emitente.nome-abrev    colon 24
     docum-est.nro-docto    colon 62
     c-nota-simples-remessa colon 105
     emitente.cgc           colon 24
     docum-est.nat-operacao colon 62 "-"
     natur-oper.especie-doc no-label
     c-embarque-orig        colon 105
     with stream-io no-box side-label overlay row 3 width 132 frame f-nota.

     
RUN utp/ut-trfrrp.p (INPUT FRAME f-nota:HANDLE).

form docum-est.cod-emitente colon 24
     docum-est.serie-docto  colon 62
     c-embarque-imp         colon 105
     emitente.nome-abrev    colon 24
     docum-est.nro-docto    colon 62
     c-nota-simples-remessa colon 105
     emitente.cgc           colon 24
     docum-est.nat-operacao colon 62 "-"
     natur-oper.especie-doc no-label
     c-gera-nf-mae-filha    colon 105
     c-embarque-orig        colon 105
     with stream-io no-box side-label overlay row 3 width 132 frame f-nota-bra.

     
RUN utp/ut-trfrrp.p (INPUT FRAME f-nota-bra:HANDLE).

{utp/ut-liter.i Nota_Fiscal_de_Devolu‡Æo * r}
assign c-especie[1] = trim(return-value).
{utp/ut-liter.i Nota_Fiscal_de_Entrada * r}
assign c-especie[2] = trim(return-value).
{utp/ut-liter.i Nota_Fiscal_de_Beneficiamento * r}
assign c-especie[3] = trim(return-value).
{utp/ut-liter.i Nota_Fiscal_de_Transferˆncia * r}
assign c-especie[4] = trim(return-value).

{utp/ut-liter.i "Embarque" *}
assign c-embarque-imp:label in frame f-nota = trim(return-value)
       c-embarque-imp:label in frame f-nota-bra = trim(return-value).

{utp/ut-liter.i "Nota_Fiscal_Simples_Remessa" *}
assign c-nota-simples-remessa:label in frame f-nota = trim(return-value)
       c-nota-simples-remessa:label in frame f-nota-bra = trim(return-value).

{utp/ut-liter.i "Embarque_Origem" *}
assign c-embarque-orig:label in frame f-nota = trim(return-value)
       c-embarque-orig:label in frame f-nota-bra = trim(return-value).
       
form skip(1)
     c-esp-docto               colon 24 format "x(3)"  "-"
     c-especie[1]              no-label format "x(32)" skip
     docum-est.cod-observa     colon 24 "-"
     c-observa                 no-label format "x(20)"
     docum-est.cod-estabel     colon 24
     docum-est.base-iss        colon 62
     docum-est.vl-pis-subs     COLON 101
     docum-est.estab-fisc      colon 24
     docum-est.iss-deb-cre     colon 62 
     docum-est.vl-cofins-subs  COLON 101
     docum-est.dt-emissao      colon 24
     docum-est.base-ipi        colon 62
     da-ven-icm                colon 101
     docum-est.dt-trans        colon 24
     docum-est.ipi-deb-cre     colon 62
     da-ven-ipi                colon 101
     l-docto-imp               colon 24       
     docum-est.icm-fonte       colon 62 label "Vl Subs Frete"
     da-ven-iss                colon 101
     docum-est.via-transp      colon 24 "-"
     c-transp                  no-label format "x(15)"
     docum-est.base-subs       colon 62 label "Base_ICMS_Subs" 
     docum-est.usuario         colon 101
     c-ct-transit              colon 24 label "Conta Transit" FORMAT "X(20)"
     docum-est.vl-subs         colon 62
     l-memorando-exportacao    colon 101 LABEL "Memor Exporta‡Æo"
     c-sc-transit              colon 24 label "Centro Custo" FORMAT "X(20)"
     docum-est.base-icm        colon 62 label "Base_do_ICMS"
     docum-est.ce-atual        colon 101 format "Atualizado/NÆo Atualizado"
     docum-est.tot-peso        colon 24
     docum-est.icm-deb-cre     colon 62
     l-compras                 colon 101 format "Atualizado/NÆo Atualizado"
     docum-est.peso-bruto-tot  COLON 24 LABEL "Peso Bruto Total"
     de-base-pis               colon 62 format ">>>>>,>>>,>>9.99"
     docum-est.of-atual        colon 101 label "OF Atualizado"
                               format "Atualizado/NÆo Atualizado" "-"
     l-of-online               no-label
     docum-est.tot-desconto    colon 24
     de-pis                    colon 62 format ">>>>>,>>>,>>9.99" 
     docum-est.ap-atual        colon 101 format "Atualizado/NÆo Atualizado" "-"
     l-ap-online               no-label
     docum-est.valor-mercad    colon 24
     de-base-cofins            colon 62 format ">>>>>,>>>,>>9.99"
     docum-est.cr-atual        colon 101 label "Contas a Receber" format "Atualizado/NÆo Atualizado" "-"
     l-cr-online               no-label 
     docum-est.despesa-nota    colon 24
     de-cofins                 colon 62 format ">>>>>,>>>,>>9.99"
     docum-est.log-2           colon 101 label "WMS" format "Atualizado/NÆo Atualizado"     
     docum-est.tot-valor       colon 24 format ">>>>,>>>,>>>,>>9.99" 
     with stream-io no-box side-label row 6 width 132 frame f-corpo-rel.
RUN utp/ut-trfrrp.p (INPUT FRAME f-corpo-rel:HANDLE).

form skip(1)
     c-esp-docto               colon 24 format "x(3)"  "-"
     c-especie[1]              no-label format "x(32)" skip
     docum-est.cod-observa     colon 24 "-"
