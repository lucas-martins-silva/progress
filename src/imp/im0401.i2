form 
    bf-historico-embarque.sequencia       at 01
    bf-historico-embarque.cod-pto-contr   at 05
    c-descricao                           at 15
    bf-historico-embarque.dt-previsao     at 46 
    bf-historico-embarque.dt-ult-previsao at 57
    bf-historico-embarque.dt-efetiva      at 68
    i-diferenca-pto                       at 79
    bf-historico-embarque.id-meio-transp  at 95 
    with down width 132 no-box stream-io frame f-det-embarque.
    
RUN utp/ut-trfrrp.p (INPUT FRAME f-det-embarque:HANDLE).

{utp/ut-liter.i Diferen‡a * r}
assign i-diferenca-pto:label in frame f-det-embarque = trim(return-value).
{utp/ut-liter.i Descri‡Æo * r}
assign c-descricao:label in frame f-det-embarque = trim(return-value).

form 
     skip(3)
     embarque-imp.cod-estabel            colon 30
     embarque-imp.embarque               colon 91
     i-cod-exportador                    colon 30
     " - " c-nome-abrev                  no-label 
     embarque-imp.cod-incoterm           colon 91
     i-pto-solic-li                      colon 30 
     "- " c-pto-solic-li                 no-label
     c-situacao-embarque                 colon 91
     embarque-imp.cdn-pto-embarq         colon 30
     "- " c-pto-emb                      no-label
     historico-embarque.cod-itiner       colon 91
     "-" itinerario.descricao          no-label 
     embarque-imp.cdn-pto-desembar       colon 30
     "- " c-pto-des                      no-label
     embarque-imp.declaracao-import      colon 30
     embarque-imp.cod-conhecto-master    colon 91 
     with side-labels width 132 no-box stream-io frame f-cab-embarque.
     
form
    embarque-imp.data-di             colon 30 
    embarque-imp.cod-conhecto-house  colon 91
    embarque-imp.data-1              colon 30
    de-cotacao-dia                   colon 91 
    with side-labels width 132 no-box stream-io frame f-cab-embarque-aux.
    
{utp/ut-liter.i Itiner rio * r}
assign historico-embarque.cod-itiner:label in frame f-cab-embarque = trim(return-value).
{utp/ut-liter.i Fornecedor * r}
assign i-cod-exportador:label in frame f-cab-embarque = trim(return-value).
{utp/ut-liter.i Ponto_Nacionaliza‡Æo * R}
assign embarque-imp.cdn-pto-desembar:label in frame f-cab-embarque = trim(return-value).
{utp/ut-liter.i Situa‡Æo_Embarque * R}
assign c-situacao-embarque:label in frame f-cab-embarque = trim(return-value).
{utp/ut-liter.i Incoterm * r}
assign embarque-imp.cod-incoterm:label in frame f-cab-embarque = trim(return-value).


{utp/ut-liter.i Data_Cota‡Æo_Nacionaliz * r}
assign embarque-imp.data-1:label in frame f-cab-embarque-aux = trim(return-value).
{utp/ut-liter.i "Cota‡Æo_Nacionaliza‡Æo" * r}
assign de-cotacao-dia:label in frame f-cab-embarque-aux = trim(return-value).

form c-lb-tit-docs format "x(132)" skip(1)
     with stream-io no-box no-label width 132 frame f-tit-docs.
     
{utp/ut-liter.i DOCUMENTOS_DE_ENTRADA_RELACIONADOS * r}
assign c-lb-tit-docs = " *" + fill("-", 47) + " "
                            + trim(return-value)
                            + " "  + fill("-", 61) + "* ".

