{utp/ut-liter.i Cidade * r}
assign docum-est.cidade:label in frame f-endereco = trim(return-value).
{utp/ut-liter.i UF * r}
assign docum-est.uf:label in frame f-endereco = trim(return-value).
{utp/ut-liter.i Pais * r}
