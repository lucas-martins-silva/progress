     bf-docum-est.icm-deb-cre     colon 62
     l-compras                    colon 101 format "Atualizado/NÆo Atualizado"
     docum-est.peso-bruto-tot     COLON 24 LABEL "Peso Bruto Total"
     de-base-pis                  colon 62 format ">>>>>,>>>,>>9.99"
     bf-docum-est.of-atual        colon 101 label "OF Atualizado" format "Atualizado/NÆo Atualizado" "-"
     l-of-online                  no-label
     bf-docum-est.tot-desconto    colon 24
     de-pis                       colon 62 format ">>>>>,>>>,>>9.99" 
     bf-docum-est.ap-atual        colon 101 format "Atualizado/NÆo Atualizado" "-"
     l-ap-online                  no-label
     bf-docum-est.valor-mercad    colon 24
     de-base-cofins               colon 62 format ">>>>>,>>>,>>9.99"
     bf-docum-est.cr-atual        colon 101 label "Contas a Receber" format "Atualizado/NÆo Atualizado" "-"
     l-cr-online                  no-label 
     bf-docum-est.despesa-nota    colon 24
     de-cofins                    colon 62 format ">>>>>,>>>,>>9.99"
     bf-docum-est.log-2           colon 101 label "WMS" format "Atualizado/NÆo Atualizado"
     /*====================== Impostos Reforma Tribut ria ============================*/
     de-base-cbs                  colon 24  label "Base CBS"
     de-base-ibs-uf               colon 62  label "Base IBS UF"
     de-base-ibs-mun              colon 101 label "Base IBS Mun"
     de-valor-cbs                 colon 24  label "Valor CBS"
     de-valor-ibs-uf              colon 62  label "Valor IBS UF"
     de-valor-ibs-mun             colon 101 label "Valor IBS Mun"
     de-base-cbs-reg              colon 24  label "Base CBS Reg"
     de-base-ibs-uf-reg           colon 62  label "Base IBS UF Reg"
     de-base-ibs-mun-reg          colon 101 label "Base IBS Mun Reg"
     de-valor-cbs-reg             colon 24  label "Valor CBS Reg"
     de-valor-ibs-uf-reg          colon 62  label "Valor IBS UF Reg"
     de-valor-ibs-mun-reg         colon 101 label "Valor IBS Mun Reg"     
     de-base-is                   colon 24  label "Base IS"
     de-valor-is                  colon 24  label "Valor IS"
     bf-docum-est.valor-tot-nf-rt colon 101  label "Total Nota RTC"     
     /*===============================================================================*/
     bf-docum-est.tot-valor       colon 24 format ">>>>,>>>,>>>,>>9.99" 
     with stream-io no-box side-label row 6 width 132 frame f-corpo-nfc-RT.

RUN utp/ut-trfrrp.p (INPUT FRAME f-corpo-nfc-RT:HANDLE).

IF  l-spp-NT2024002 THEN DO:
    {utp/ut-liter.i Esp‚cie * r}
    assign c-esp-docto:label in frame f-corpo-nfc-RT = trim(return-value).
    {utp/ut-liter.i Base_do_ISS * r}
