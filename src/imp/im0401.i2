    {utp/ut-liter.i Total_da_Nota * r}
    assign docum-est.tot-valor:label in frame f-corpo-rel-RT = trim(return-value).
    assign docum-est.valor-tot-nf-rt:label in frame f-corpo-rel-RT = "Total Nota RTC".
    {utp/ut-liter.i Conta_Transitoria * r}
    assign c-ct-transit:label in frame f-corpo-rel-RT = trim(return-value).
    {utp/ut-liter.i Centro_Custo * r}
    assign c-sc-transit:label in frame f-corpo-rel-RT = trim(return-value).
    {utp/ut-liter.i Docto_Importado * r}
    assign l-docto-imp:label in frame f-corpo-rel-RT = trim(return-value).
    {utp/ut-liter.i Sim/NÆo * r}
    assign l-docto-imp:format in frame f-corpo-rel-RT = trim(return-value).
    {utp/ut-liter.i Base_do_Pis * r}
    assign de-base-pis:label in frame f-corpo-rel-RT = trim(return-value).
    {utp/ut-liter.i Valor_Pis * r}
    assign de-pis:label in frame f-corpo-rel-RT = trim(return-value).
    {utp/ut-liter.i Base_Cofins * r}
