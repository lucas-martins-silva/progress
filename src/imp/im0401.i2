    assign bf-docum-est.valor-tot-nf-rt:label in frame f-corpo-nfc-RT = "Total Nota RTC".
    {utp/ut-liter.i Conta_Transitoria * r}
    assign c-ct-transit:label in frame f-corpo-nfc-RT = trim(return-value).
    {utp/ut-liter.i Centro_Custo * r}
