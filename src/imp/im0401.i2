form c-lb-tit-end format "x(132)"
     with stream-io no-box no-label width 132 frame f-tit-end.
{utp/ut-liter.i ENDERE€O * R}
assign c-lb-tit-end = " *" + fill("-", 58) + " "
                        + trim(return-value)
                        + " "  + fill("-", 60) + "* ".
form skip(1)
     docum-est.cod-entrega               colon 24 
     docum-est.log-consid-ender-nf-saida COLON 101
     docum-est.endereco                  colon 24
     docum-est.cep                       COLON 101
     docum-est.bairro                    colon 24
     docum-est.cidade    format "x(30)"  colon 101
     docum-est.uf                        colon 24
     docum-est.pais                      COLON 101 SKIP(1)
     with stream-io no-box side-label row 6 width 132 frame f-endereco.

RUN utp/ut-trfrrp.p (INPUT FRAME f-endereco:HANDLE).

{utp/ut-liter.i Local_Entrega * r}
assign docum-est.cod-entrega:label in frame f-endereco = trim(return-value).
{utp/ut-liter.i Endereco_NF_Origem * r}
