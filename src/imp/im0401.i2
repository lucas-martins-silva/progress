    {utp/ut-liter.i Compras * r}
    assign l-compras:label in frame f-corpo-rel-RT = trim(return-value).
    {utp/ut-liter.i Valor_ICMS_Subs * r}
    assign docum-est.vl-subs:label in frame f-corpo-rel-RT = trim(return-value).
    {utp/ut-liter.i Valor_Subs_Trib * r}
    assign docum-est.vl-subs:label in frame f-corpo-rel-RT = trim(return-value).
    {utp/ut-liter.i Base_do_ICMS * r}
