    {utp/ut-liter.i Sim/NÆo * r}
    assign l-docto-imp:format in frame f-corpo-nfc-RT = trim(return-value).
    {utp/ut-liter.i Base_do_Pis * r}
    assign de-base-pis:label in frame f-corpo-nfc-RT = trim(return-value).
    {utp/ut-liter.i Valor_Pis * r}
    assign de-pis:label in frame f-corpo-nfc-RT = trim(return-value).
    {utp/ut-liter.i Base_Cofins * r}
    assign de-base-cofins:label in frame f-corpo-nfc-RT = trim(return-value).
    {utp/ut-liter.i Valor_Cofins * r}
    assign de-cofins:label in frame f-corpo-nfc-RT = trim(return-value).
    {utp/ut-liter.i Valor_Pis_Subs * r}
    assign bf-docum-est.vl-pis-subs:label in frame f-corpo-nfc-RT = trim(return-value).
    {utp/ut-liter.i Valor_Cofins_Subs * r}
    assign bf-docum-est.vl-cofins-subs:label in frame f-corpo-nfc-RT = trim(return-value).
    {utp/ut-liter.i Memorando_Exp}
    assign l-memorando-exportacao:label in frame f-corpo-nfc-RT = trim(return-value).
    {utp/ut-liter.i Sim/NÆo * r}
    assign l-memorando-exportacao:format in frame f-corpo-nfc-RT = trim(return-value).  
END.
/* FIM -- Reforma Tribut ria - Novos Tributos (DBACKRTDTS-2671) */
