/***************************************************************************
**
** IM9014A.I1 - Integra‡Æo com RE0401 - Listagem Conferencia de Documentos
**
** Objetivo: Retorna valor total duplicatas do fornecedor do material e data de partida
**
****************************************************************************/
{cdp/cdcfgmat.i} /* Defini‡Æo de pr‚-processadores */


def var r-cotacao-item as rowid no-undo.

procedure return_valor_desp:

        def input  parameter r-rowid          as rowid no-undo.
        def output parameter p-valor-despesa  like docum-est-cex.val-desp no-undo.
        def output parameter p-dt-partida     like historico-embarque.dt-efetiva no-undo.

        /* busca valor do embarque no documento de importacao */
        find docum-est
            where rowid(docum-est) = r-rowid no-lock no-error.
        
        {cdp/cd4300.i3}
        
        {rep/re1001a.i50}
        
        &if defined(bf-mat-comex) &then
            assign c-embarque = substring(docum-est.char-1,2,12).
        &else
            {cdp/cd4300.i4 yes docum-est.char-1}
            {rep/re1001a.i51 yes}
        &endif
        
        for each docum-est-cex
            where docum-est-cex.serie-docto       = docum-est.serie-docto
                &if defined(bf-mat-comex) &then                
              and docum-est-cex.nro-docto         = string(docum-est.nro-docto)
                &else
              and docum-est-cex.nro-docto         = docum-est.nro-docto
                &endif    
              and docum-est-cex.cod-emitente      = docum-est.cod-emitente
              and docum-est-cex.nat-operacao      = docum-est.nat-operacao 
              and docum-est-cex.cod-emitente-desp = docum-est.cod-emitente no-lock:
            find desp-imp 
                where desp-imp.cod-desp = docum-est-cex.cod-desp no-lock no-error.
            if avail desp-imp and 
               desp-imp.inc-val-duplic then 
                assign p-valor-despesa = p-valor-despesa + 
                                         docum-est-cex.val-desp.
        end.
        
        {ccp/cc9019.i50}
        
        find embarque-imp
            where embarque-imp.cod-estabel = docum-est.cod-estabel
              and embarque-imp.embarque    = c-embarque            no-lock no-error.
        if avail embarque-imp then do:
            find first ordens-embarque of embarque-imp no-lock no-error.
            for each cotacao-item fields(cot-aprovada char-1)
                where cotacao-item.numero-ordem = ordens-embarque.numero-ordem no-lock:
                if cotacao-item.cot-aprovada then do:
                    &if defined(bf-mat-comex) &then
                        assign i-cod-pto-contr-i50 = int(substring(cotacao-item.char-1,11,5)).
                    &else
                        {cdp/cd4300.i4 yes cotacao-item.char-1}
                        {ccp/cc9019.i51 yes}
                    &endif
                end.
            end.
            find historico-embarque
                where historico-embarque.cod-estabel   = docum-est.cod-estabel
                  and historico-embarque.embarque      = embarque-imp.embarque
                  and historico-embarque.cod-pto-contr = i-cod-pto-contr-i50 no-lock no-error.
            assign p-dt-partida = historico-embarque.dt-efetiva.
        end.
end procedure.

/* IM9014.I1 */
