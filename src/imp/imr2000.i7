for each pedido-drb WHERE pedido-drb.nr-ato-concessorio >= tt-param.nr-ato-concessorio and
                          pedido-drb.nr-ato-concessorio <= tt-param.nr-ato-concessorio-fim and
                          pedido-drb.nr-pedido-drb      >= tt-param.nr-pedido-drb-ini and
                          pedido-drb.nr-pedido-drb      <= tt-param.nr-pedido-drb-fim and
                          pedido-drb.modalidade         = 2 /* Isen‡Æo */ NO-LOCK:

    FOR EACH movto-ato WHERE movto-ato.cod-estabel   = pedido-drb.cod-estabel AND
                             movto-ato.nr-pedido-drb = pedido-drb.nr-pedido-drb and
                             movto-ato.idi-tip-movto = 1 /*entrada*/ and
                             &IF "{&bf_dis_versao_ems}":U >= "2.09":U &THEN
                                movto-ato.idi-tip-item-movto = 1
                             &ELSE
                                movto-ato.num-livre-1 = 1
                             &ENDIF NO-LOCK:    

        FIND ITEM WHERE ITEM.it-codigo = movto-ato.it-codigo NO-LOCK NO-ERROR.

        IF NOT AVAIL ITEM THEN NEXT.

        Find moeda where moeda.mo-codigo = movto-ato.mo-codigo no-lock no-error.

        If not avail moeda then next.        

        /* cria dados de entrada */
        CREATE tt-unificado-di.
        ASSIGN tt-unificado-di.declaracao-import    = movto-ato.declaracao-import
               tt-unificado-di.data-di              = movto-ato.dat-decla-import
               tt-unificado-di.nr-nota-fis          = movto-ato.nro-docto
               tt-unificado-di.data-nf              = movto-ato.dat-nf
               tt-unificado-di.class-fiscal         = movto-ato.cdd-ncm
               tt-unificado-di.peso                 = movto-ato.val-peso
               tt-unificado-di.sigla                = moeda.sigla
               tt-unificado-di.valor                = movto-ato.val-movto-ato-me
               tt-unificado-di.descricao            = item.descricao-1 + item.descricao-2
               tt-unificado-di.dat-cotac            = movto-ato.dat-cotac .

        If tt-param.imprime-un-ncm = yes then do:
            Assign tt-unificado-di.quantidade = movto-ato.val-quant-movto-ato * item.fator-conver.
            find first classif-fisc where classif-fisc.class-fiscal = movto-ato.cdd-ncm no-lock no-error.
            if avail classif-fisc then
                assign tt-unificado-di.un = classif-fisc.unidade.
        end.
        Else
            Assign tt-unificado-di.quantidade = movto-ato.val-quant-movto-ato
                   tt-unificado-di.un = movto-ato.un.

        /*procura no sistema qual ‚ a moeda d¢lar*/
        Find moeda where moeda.cod-decex = 220 no-lock no-error.

        IF AVAIL moeda THEN DO:
           run cdp/cd0812.p (input movto-ato.mo-codigo, /*moeda da RE */
                             input moeda.mo-codigo, /*moeda dolar */
                             input tt-unificado-di.valor,
                             input tt-unificado-di.dat-cotac,
                             output de-val-me).
           
           ASSIGN tt-unificado-di.valor-me = de-val-me.
        END.
        ELSE 
           ASSIGN tt-unificado-di.valor-me = ? .
        
    end.
    
    if can-find(first tt-unificado-di) then do:
    
        IF AVAIL moeda THEN
           assign c-moeda-tot = "(" + moeda.sigla + ")".

        DISP c-moeda-tot
             c-empresa-prin
             c-empresa-cgc
             c-nr-ato-con + pedido-drb.nr-ato-concessorio @ c-nr-ato-con
             with  width 190 frame f-cabecalho.
    
        /* Inicio -- Projeto Internacional */
        DEFINE VARIABLE c-lbl-liter-notas-de-importacao-imr2000i7 AS CHARACTER FORMAT "X(21)" NO-UNDO.
        {utp/ut-liter.i "Notas_de_Importa‡Æo" *}
        ASSIGN c-lbl-liter-notas-de-importacao-imr2000i7 = TRIM(RETURN-VALUE).
        put c-lbl-liter-notas-de-importacao-imr2000i7 format "x(20)" at 4 fill("-",108) format "x(108)" skip.
        
        for each tt-unificado-di:
    
            /*run cdp/cd0812.p (input 0,
                              input tt-param.i-moeda,
                              input tt-unificado-di.valor,
                              input tt-unificado-di.dat-cotac,
                              output de-val-desp).*/
    
            disp  tt-unificado-di.declaracao-import
                  tt-unificado-di.data-di
                  tt-unificado-di.nr-nota-fis
                  tt-unificado-di.data-nf
                  tt-unificado-di.class-fiscal @ tt-unificado-di.cod-ncm
                  tt-unificado-di.peso
                  tt-unificado-di.quantidade
                  tt-unificado-di.un
                  tt-unificado-di.sigla
                  tt-unificado-di.valor
                  /*de-val-desp @*/ tt-unificado-di.valor-me
                  with width 132 frame f-unificado-di.
    
            put tt-unificado-di.descricao at 63 skip.
    
        end.
    
        page.

    end.

    for each item-re where item-re.cod-estabel   = pedido-drb.cod-estabel and
                           item-re.nr-pedido-drb = pedido-drb.nr-pedido-drb no-lock :

        find pedido-drb-re where pedido-drb-re.cod-estabel = item-re.cod-estabel and
                                 pedido-drb-re.nr-pedido-drb = item-re.nr-pedido-drb and    
                                 pedido-drb-re.nr-re = item-re.num-re no-lock no-error.

        Find moeda where moeda.mo-codigo = &if "{&bf_dis_versao_ems}" <= "2.05" &then pedido-drb-re.int-1 &else pedido-drb-re.mo-codigo &endif no-lock no-error. 

        If not avail moeda then next.

        FIND ITEM WHERE ITEM.it-codigo = item-re.it-codigo NO-LOCK NO-ERROR.

        IF NOT AVAIL ITEM THEN NEXT.

        /* cria dados de baixa */
        CREATE tt-unificado-re.
        
        ASSIGN tt-unificado-re.nr-re        = item-re.num-re
               tt-unificado-re.data-re      = &if "{&bf_dis_versao_ems}" <= "2.05" &then pedido-drb-re.data-1 &else pedido-drb-re.dat-reg-export &endif
               tt-unificado-re.nr-nota-fis  = item-re.cod-nota-fis
               tt-unificado-re.data-nf      = item-re.dat-nf
               tt-unificado-re.class-fiscal = item-re.cdd-ncm
               tt-unificado-re.peso         = item-re.val-peso
               tt-unificado-re.sigla        = moeda.sigla
               tt-unificado-re.valor        = item-re.val-item-re
               tt-unificado-re.descricao    = item.descricao-1 + item.descricao-2.

        find first nota-fiscal
             where nota-fiscal.cod-estabel  = item-re.cod-estabel 
               AND nota-fiscal.nr-nota-fis  = item-re.cod-nota-fisc
               and nota-fiscal.serie        = item-re.serie NO-LOCK NO-ERROR.         
        if avail nota-fiscal then do:
            if nota-fiscal.nr-siscomex <> "" then
                assign tt-unificado-re.nr-re = nota-fiscal.nr-siscomex.
            else do:
                &if "{&bf_cex_versao_ems}" >= "2.062" &then
                        find first reg-export-item
                             WHERE reg-export-item.cod-estabel = proc-ped-ent.cod-estabel
                               AND reg-export-item.nr-proc-exp = proc-ped-ent.nr-proc-exp
                               AND reg-export-item.nr-pedcli   = proc-ped-ent.nr-pedcli  
                               AND reg-export-item.num-seq     = proc-ped-ent.nr-sequencia
                               AND reg-export-item.it-codigo   = proc-ped-ent.it-codigo  
                               AND reg-export-item.cod-refer   = proc-ped-ent.cod-refer  
                               AND reg-export-item.nr-entrega  = proc-ped-ent.nr-entrega 
                               AND reg-export-item.nome-abrev  = proc-ped-ent.nome-abrev no-lock NO-ERROR.
                        IF AVAIL reg-export-item THEN do:
                            FIND FIRST reg-export OF reg-export-item no-lock NO-ERROR.
                                IF AVAIL reg-export THEN
                                    assign tt-unificado-re.nr-re = reg-export.nr-re-siscomex.
                        end.
                &endif
            end.
        end.
        find movto-ato where movto-ato.cod-estabel = item-re.cod-estabel and
                             movto-ato.nr-pedido-drb = item-re.nr-pedido-drb no-lock no-error.
       
       If tt-param.imprime-un-ncm = yes then do:
          if pedido-drb.modalidade = 2 then /*Isencao nao possui movto-ato pra RE*/
             Assign tt-unificado-re.quantidade = item-re.val-quant-item-reg-export * item.fator-conver
                    tt-unificado-re.dat-cotac  = item-re.dat-nf.
          else
             if avail movto-ato then
                Assign tt-unificado-re.quantidade = movto-ato.val-quant-movto-ato * item.fator-conver.
          
          find first classif-fisc where classif-fisc.class-fiscal = movto-ato.cdd-ncm no-lock no-error.
          if avail classif-fisc then
              assign tt-unificado-re.un = classif-fisc.unidade.
       end.
       Else do:
           if pedido-drb.modalidade = 2 then
              Assign tt-unificado-re.quantidade = item-re.val-quant-item-reg-export
                     tt-unificado-re.un = item-re.un
                     tt-unificado-re.dat-cotac = item-re.dat-nf.
           else
              if avail movto-ato then
                 Assign tt-unificado-re.quantidade = movto-ato.val-quant-movto-ato 
                        tt-unificado-re.un = movto-ato.un.
       end.
       
        if avail movto-ato then
          assign tt-unificado-re.dat-cotac = movto-ato.dat-cotac.
       
        /*procura no sistema qual ‚ a moeda d¢lar*/
        Find moeda where moeda.cod-decex = 220 no-lock no-error.

        IF AVAIL moeda THEN DO:
           run cdp/cd0812.p (input &if "{&bf_dis_versao_ems}" <= "2.05" &then pedido-drb-re.int-1 &else pedido-drb-re.mo-codigo &endif,
                             input moeda.mo-codigo, /*moeda dolar */
                             input tt-unificado-re.valor,
                             input tt-unificado-re.dat-cotac,
                             output de-val-me).

           ASSIGN tt-unificado-re.valor-me = de-val-me.
        END.
        ELSE 
           ASSIGN tt-unificado-re.valor-me = ? .
           
    END.

    if can-find(first tt-unificado-re) then do:
    
       IF AVAIL moeda THEN
          assign c-moeda-tot = "(" + moeda.sigla + ")".

        DISP c-moeda-tot
             c-empresa-prin
             c-empresa-cgc
             c-nr-ato-con + pedido-drb.nr-ato-concessorio @ c-nr-ato-con
             with  width 190 frame f-cabecalho.
    
        /* Inicio -- Projeto Internacional */
        DEFINE VARIABLE c-lbl-liter-notas-de-exportacao-imr2000i7 AS CHARACTER FORMAT "X(21)" NO-UNDO.
        {utp/ut-liter.i "Notas_de_Exporta‡Æo" *}
        ASSIGN c-lbl-liter-notas-de-exportacao-imr2000i7 = TRIM(RETURN-VALUE).
        put c-lbl-liter-notas-de-exportacao-imr2000i7 format "x(20)" at 4 fill("-",108) format "x(108)" skip.
    
        for each tt-unificado-re:
    
            /*run cdp/cd0812.p (input 0,
                              input tt-param.i-moeda,
                              input tt-unificado-re.valor,
                              input tt-unificado-re.dat-cotac,
                              output de-val-desp).*/
    
            disp tt-unificado-re.nr-re  
                 tt-unificado-re.data-re
                 tt-unificado-re.nr-nota-fis 
                 tt-unificado-re.data-nf   
                 tt-unificado-re.class-fiscal @ tt-unificado-re.cod-ncm   
                 tt-unificado-re.peso      
                 tt-unificado-re.quantidade
                 tt-unificado-re.un
                 tt-unificado-re.sigla
                 tt-unificado-re.valor
                 /*de-val-desp @*/ tt-unificado-re.valor-me 
                 with width 132 frame f-unificado-re.
    
            put tt-unificado-re.descricao at 63 skip.
    
        end.
    
        page.

    end.

END.


