&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE pi-atualiza-ordens wWindow 
PROCEDURE pi-atualiza-ordens :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

IF NOT VALID-HANDLE(h-bocx404) THEN
    RUN cxbo\bocx404.p PERSISTENT SET h-bocx404.

RUN getNaturOper              IN h-bocx383 (OUTPUT c-natureza).
                                          
RUN pi-altera-natureza-ordens IN h-bocx404 (INPUT i-num-di-ems,
                                            INPUT c-natureza,
                                            INPUT de-cdd-siscomex-dts,
                                            INPUT INPUT FRAME fPage0 rs-natur-oper).

RETURN "OK":U.
END PROCEDURE.

