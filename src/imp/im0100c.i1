FOR EACH tt-ordens-desemb exclusive-lock
    BREAK BY tt-ordens-desemb.cdn-adicao:

    IF FIRST-OF(tt-ordens-desemb.cdn-adicao) THEN DO:
        CREATE tt-ordens-desemb-acum-adicao.
        BUFFER-COPY tt-ordens-desemb TO tt-ordens-desemb-acum-adicao.
        ASSIGN de-qtde-acum              = 0
               de-qt-do-forn-acum        = 0
               de-quantidade-acum        = 0
               de-peso-bruto-unit-acum   = 0
               de-peso-bruto-acum        = 0
               de-peso-liquido-unit-acum = 0
               de-peso-liquido-acum      = 0.
    END.
    
    // Como ir† criar o registro do acumulado, ent∆o precisa sempre considerar o total.
    // Neste caso, foráa ent∆o a atualizaá∆o da vari†vel, pois a visualizaá∆o pode estar pelo valor unit†rio e precisa ser sempre o total
    ASSIGN tt-ordens-desemb.de-cubagem = tt-ordens-desemb.val-cub-tot.

    FIND FIRST item
         WHERE item.it-codigo = tt-ordens-desemb.c-it-codigo NO-LOCK NO-ERROR.
    FIND FIRST classif-fisc
         where classif-fisc.class-fiscal = item.class-fiscal no-lock no-error.
         
    IF tt-ordens-desemb.c-un <> classif-fisc.unidade THEN DO:
        ASSIGN de-qtde-acum              = de-qtde-acum              + tt-ordens-desemb.quantidade
               de-qt-do-forn-acum        = de-qt-do-forn-acum        + tt-ordens-desemb.qt-do-forn
               de-quantidade-acum        = de-quantidade-acum        + (tt-ordens-desemb.de-quantidade / item.fator-conver)
               de-peso-bruto-unit-acum   = de-peso-bruto-unit-acum   + tt-ordens-desemb.de-peso-bruto-unit
               de-peso-bruto-acum        = de-peso-bruto-acum        + tt-ordens-desemb.de-peso-bruto
               de-peso-liquido-unit-acum = de-peso-liquido-unit-acum + tt-ordens-desemb.de-peso-liquido-unit
               de-peso-liquido-acum      = de-peso-liquido-acum      + tt-ordens-desemb.de-peso-liquido.
               
    END.
    ELSE
        ASSIGN de-qtde-acum              = de-qtde-acum              + tt-ordens-desemb.quantidade
               de-qt-do-forn-acum        = de-qt-do-forn-acum        + tt-ordens-desemb.qt-do-forn
               de-quantidade-acum        = de-quantidade-acum        + tt-ordens-desemb.de-quantidade
               de-peso-bruto-unit-acum   = de-peso-bruto-unit-acum   + tt-ordens-desemb.de-peso-bruto-unit
               de-peso-bruto-acum        = de-peso-bruto-acum        + tt-ordens-desemb.de-peso-bruto
               de-peso-liquido-unit-acum = de-peso-liquido-unit-acum + tt-ordens-desemb.de-peso-liquido-unit
               de-peso-liquido-acum      = de-peso-liquido-acum      + tt-ordens-desemb.de-peso-liquido
              &IF "{&bf_mat_versao_ems}" >= "2.062" &THEN
               de-peso-embal-acum        = de-peso-embal-acum        + tt-ordens-desemb.de-peso-embal
              &ENDIF
               de-cubagem-unit-acum      = de-cubagem-unit-acum      + tt-ordens-desemb.val-cub-unit
               de-cubagem-tot-acum       = de-cubagem-tot-acum       + tt-ordens-desemb.val-cub-tot
               de-cubagem-acum           = de-cubagem-acum           + tt-ordens-desemb.de-cubagem.
    
            

    IF LAST-OF(tt-ordens-desemb.cdn-adicao) THEN DO:
        ASSIGN tt-ordens-desemb-acum-adicao.quantidade           = de-qtde-acum
               tt-ordens-desemb-acum-adicao.qt-do-forn           = de-qt-do-forn-acum
               tt-ordens-desemb-acum-adicao.de-quantidade        = de-quantidade-acum  
               tt-ordens-desemb-acum-adicao.de-peso-bruto-unit   = de-peso-bruto-unit-acum
               tt-ordens-desemb-acum-adicao.de-peso-bruto        = de-peso-bruto-acum  
               tt-ordens-desemb-acum-adicao.de-peso-liquido-unit = de-peso-liquido-unit-acum
               tt-ordens-desemb-acum-adicao.de-peso-liquido      = de-peso-liquido-acum
               tt-ordens-desemb-acum-adicao.val-cub-unit         = de-cubagem-unit-acum
               tt-ordens-desemb-acum-adicao.val-cub-tot          = de-cubagem-tot-acum
               tt-ordens-desemb-acum-adicao.de-peso-embal        = de-peso-embal-acum
               tt-ordens-desemb-acum-adicao.de-cubagem           = de-cubagem-acum.
        
        IF tt-ordens-desemb.c-un <> classif-fisc.unidade THEN 
            ASSIGN tt-ordens-desemb-acum-adicao.c-un             = classif-fisc.unidade.
    END.
               
END.      
