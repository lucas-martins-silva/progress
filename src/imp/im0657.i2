/**************************************************************************************
**
** IM0657.I2 - Defini‡äes Frames
**
***************************************************************************************/

def var c-lb-tit-sel    as char no-undo.
def var c-lb-tit-imp    as char format "x(15)" no-undo.
def var c-lb-destino    as char format "x(10)" no-undo.
def var c-lb-tit-par    as char format "x(10)" no-undo.
def var c-lb-usuario    as char format "x(10)" no-undo.


form
     tt-ponto.cod-pto-contr at 05
     tt-ponto.descricao     at 15
     tt-ponto.num-ocorren   at 49
     tt-ponto.media-prev    at 54
     tt-ponto.media-efetiva at 60
     tt-ponto.diferenca     at 67
     tt-ponto.percentual    at 73
     with stream-io no-box no-label down width 90 frame f-ponto.

    
form 
     lb-cod-pto-contr    at 05
     lb-descricao        at 15 
     lb-i-num-ocorren    at 45 
     lb-i-media-prev     at 55
     lb-i-media-efetiva  at 61
     lb-i-diferenca      at 67
     lb-i-percentual     at 74
     with stream-io no-box no-label down width 90 frame f-ponto-label.
          
form
    lb-itiner              at 05 
    tt-itiner.cod-itiner   at 17
    "-"
    tt-itiner.descricao    at 26     
    with stream-io no-box no-label down width 90 frame f-itiner.
    
    
form 
/*Sele‡Æo*/
     skip(1)                                   
     c-lb-tit-sel                    no-label skip(1) 
     tt-param.i-cod-itiner-ini       colon 30
     "|< >|"                         at 50
     tt-param.i-cod-itiner-fim       no-label
     tt-param.i-cod-pto-ini          colon 30
     "|< >|"                         at 50
     tt-param.i-cod-pto-fim          no-label
     tt-param.c-nome-abrev-ini       colon 30
     "|< >|"                         at 50
     tt-param.c-nome-abrev-fim       no-label     
     tt-param.d-data-ini             colon 30
     "|< >|"                         at 50
     tt-param.d-data-fim             no-label
/*Parƒmetros*/
     skip(1)
     c-lb-tit-par                    no-label skip(1)
     tt-param.i-percentual           colon 30
/*impressÆo*/
     skip(1)
     c-lb-tit-imp                    no-label skip(1)
     c-lb-destino                    at 19 no-label ": " 
     tt-param.destino  no-label                   
     " - " 
     tt-param.arquivo                no-label skip 
     c-lb-usuario                    at 19 no-label ": "
     tt-param.usuario                no-label skip(1) 
     with width 80 side-labels frame f-param stream-io.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-param:HANDLE).

