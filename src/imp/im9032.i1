/*
**
** IM9032.P - Integracao Importacao para calculo IPI/ICMS
**            Retorna o valor das despesas de importacao incidente no valor do IPI e valor do ICMS
**
*/
def input parameter p-serie-docto  like item-doc-est-cex.serie-docto  no-undo.
def input parameter p-nro-docto    like item-doc-est-cex.nro-docto    no-undo.
def input parameter p-cod-emitente like item-doc-est-cex.cod-emitente no-undo.
def input parameter p-nat-operacao like item-doc-est-cex.nat-operacao no-undo.
def input parameter p-sequencia    like item-doc-est-cex.sequencia    no-undo.
def output parameter p-valor-icms  like item-doc-est-cex.val-desp     no-undo.
def output parameter p-valor-ipi   like item-doc-est-cex.val-desp     no-undo.

{cdp/cdcfgmat.i} /* include pre-processadores */

/*
** Paras as notas de rateio as despesas j  estÆo inclu¡das no valor do material
*/
for first natur-oper fields(&if defined(bf-mat-comex) &then log-1 &else nota-rateio &endif)
    where natur-oper.nat-operacao = p-nat-operacao no-lock:
    &if defined(bf-mat-comex) &then
        if natur-oper.log-1 then
            RETURN "":U.
    &else
        if natur-oper.nota-rateio then
            RETURN "":U.
    &endif
end.

/*
** Verifica as despeass que incidem na base do IPI e ICMS
*/
for each item-doc-est-cex
    where item-doc-est-cex.serie-docto  = p-serie-docto
      and item-doc-est-cex.nro-docto    = p-nro-docto
      and item-doc-est-cex.cod-emitente = p-cod-emitente
      and item-doc-est-cex.nat-operacao = p-nat-operacao
      and item-doc-est-cex.sequencia    = p-sequencia
      no-lock:
    
    find desp-imp
        where desp-imp.cod-desp = item-doc-est-cex.cod-desp
        no-lock no-error.
    if desp-imp.inc-base-icms then
        assign p-valor-icms = p-valor-icms + item-doc-est-cex.val-desp.
    if desp-imp.inc-base-ipi  then
        assign p-valor-ipi  = p-valor-ipi  + item-doc-est-cex.val-desp.

end.

/*
** Verifica se o PIS e o COFINS fazem parte da base de c lculo do ICMS
*/
find item-doc-est
    where item-doc-est.serie-docto  = p-serie-docto
    &if defined(bf-mat-comex) &then
      and item-doc-est.nro-docto    = integer(p-nro-docto)
    &else
      and item-doc-est.nro-docto    = p-nro-docto
    &endif      
      and item-doc-est.cod-emitente = p-cod-emitente
      and item-doc-est.nat-operacao = p-nat-operacao 
      AND item-doc-est.sequencia    = p-sequencia no-lock no-error.
IF AVAIL item-doc-est THEN DO:

    FIND docum-est OF item-doc-est NO-LOCK NO-ERROR.      
                                                    
    FIND param-imp
        WHERE param-imp.cod-estabel = docum-est.cod-estabel NO-LOCK NO-ERROR.

    {cxbo/bocx250.i2} /* variaveis para tratamento campos livres param-imp */
    {cxbo/bocx250.i3 param-imp} /* busca valores dos campos livres param-imp */
    
    IF l-inc-pis-base-icm-param-imp THEN
    &if defined(bf-mat-comex) &then
        ASSIGN p-valor-icms = p-valor-icms + decimal(substring(item-doc-est.char-1,120,13)).
    &else
        &if "{&bf_mat_versao_ems}":U >= "2.06":U &then
           ASSIGN p-valor-icms = p-valor-icms + item-doc-est.valor-pis.
        &else
           ASSIGN p-valor-icms = p-valor-icms + decimal(substring(item-doc-est.char-2,41,14)). 
        &endif
    &endif
        
    IF l-inc-cofins-base-icm-param-imp THEN
    &if defined(bf-mat-comex) &then
        ASSIGN p-valor-icms = p-valor-icms + decimal(substring(item-doc-est.char-1,152,13)).
    &else
        &if "{&bf_mat_versao_ems}":U >= "2.06":U &then
             ASSIGN p-valor-icms = p-valor-icms + item-doc-est.val-cofins.    
        &else
             ASSIGN p-valor-icms = p-valor-icms + decimal(substring(item-doc-est.char-2,103,14)).    
        &endif
    &endif
        
END.

       
/* IM9032.I1 */
