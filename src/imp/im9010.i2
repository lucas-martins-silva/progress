{include/i_dbvers.i}
/*****************************************************************************
**
** IM9010.i2 - Integra‡Æo entre Importa‡Æo e Contas … Pagar ( EMS )
**
** Objetivo: Concilia‡Æo dos valores das duplicatas de despesas.
**
******************************************************************************/

def temp-table t-temp-aux no-undo
    field t-registro as char  format "x(76)"
    index codigo t-registro.                 
    
def input        parameter rw-docto as rowid.
def input-output parameter table for t-temp-aux.

def var de-valor       as decimal format ">>>>>>>>>>>>>9" no-undo.    

{cdp/cd4300.i3} /* vari veis utilizadas pelo cd4300.i4 */

find first docum-est
    where rowid(docum-est) = rw-docto no-lock no-error.
    
{rep/re1001a.i50} /* vari veis e informa‡äes utilizadas pelo re1001a.i51 */     
    
{cdp/cd4300.i4  "yes" docum-est.char-1} 

{rep/re1001a.i51 "yes"}    

/* Atualiza nro-docto para NF Complementar */
if trim(docum-est.cod-finalidade) = "2" then
    assign c-embarque = docum-est.nro-docto.

for each dupli-apagar no-lock where 
    dupli-apagar.serie-docto  = docum-est.serie-docto and
    dupli-apagar.nro-docto    = docum-est.nro-docto and
    dupli-apagar.cod-emitente = docum-est.cod-emitente and
    dupli-apagar.nat-operacao = docum-est.nat-operacao:
         
   /************************************************/   
     FOR EACH  tt-epc
         WHERE tt-epc.cod-event = "AlteraEmbarque":U:
         DELETE tt-epc.
     END.
    
     /* Criacao temp-table tt-epc */
     create tt-epc.
     assign tt-epc.cod-event     = "AlteraEmbarque":U
            tt-epc.cod-parameter = "r-dupli-apagar":U
            tt-epc.val-parameter = STRING(ROWID(dupli-apagar)).
            
     /* Chamada EPC */
       {include/i-epc201.i "AlteraEmbarque"}
     
     FOR FIRST tt-epc WHERE tt-epc.cod-event     = "AlteraEmbarque":U
                        AND tt-epc.cod-parameter = "retorno-embarque":U :                               
         ASSIGN c-embarque = tt-epc.val-parameter.
         
     END.
     
     for each tt-epc WHERE tt-epc.cod-event     = "AlteraEmbarque":
          delete tt-epc.
     end.
   /************************************************/   
    assign de-valor = dupli-apagar.vl-a-pagar * 100.
 
    create t-temp-aux.
    assign t-temp-aux.t-registro =
        '"'            
        + " " + string(dupli-apagar.dt-trans            ,"99/99/9999") 
        + " " + string(docum-est.cod-estabel            ,"x(05)")  
        + " " + string(dupli-apagar.cod-esp             ,"x(02)")  
        + " " + string(dupli-apagar.serie-docto         ,"x(05)")
        + " " + string(c-embarque                       ,"x(16)")
        + " " + string(dupli-apagar.parcela             ,"x(02)")
        + " " + string(dupli-apagar.cod-emitente        ,"999999999")
        + " " + string(de-valor                         ,"99999999999999") 
        + " " + string(dupli-apagar.nat-operacao        ,"x(06)")
        + " " + 
        '"'.
end.

for each dupli-apagar-cex  
    where dupli-apagar-cex.serie-docto  = docum-est.serie-docto
      and dupli-apagar-cex.nro-docto    = docum-est.nro-docto
      and dupli-apagar-cex.cod-emitente = docum-est.cod-emitente
      and dupli-apagar-cex.nat-operacao = docum-est.nat-operacao no-lock:
         
     assign de-valor = dupli-apagar-cex.vl-a-pagar * 100.
     
     create t-temp-aux.
     assign t-temp-aux.t-registro =
         '"'            
          + " " + string(dupli-apagar-cex.dt-trans         ,"99/99/9999") 
          + " " + string(docum-est.cod-estabel             ,"x(05)")  
          + " " + string(dupli-apagar-cex.cod-esp          ,"x(02)")  
          + " " + string(dupli-apagar-cex.serie-docto      ,"x(05)")          
          + " " + string(c-embarque                        ,"x(16)")
          + " " + string(dupli-apagar-cex.parcela          ,"x(02)")
          + " " + string(dupli-apagar-cex.cod-emitente-desp,"999999999")
          + " " + string(de-valor                          ,"99999999999999") 
          + " " + string(dupli-apagar-cex.nat-operacao     ,"x(06)")
          + " " + 
          '"'.
end.
