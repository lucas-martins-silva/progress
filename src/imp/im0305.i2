/******************************************* Frames ***********************************************/

form header 
     c-traco[1] at 3
     c-traco[2] at 43
     c-traco[3] at 83
     c-nome[1]  at 5
     c-nome[2]  at 45
     c-nome[3]  at 85
     c-cargo[1] at 5
     c-cargo[2] at 45
     c-cargo[3] at 85
     with no-box page-bottom no-label width 132 stream-io frame f-assinatura.
     
form header
     fill("-", 94)       format "x(94)" skip
     c-lb-tot-ped     at 52  space(0) ":" 
     de-tot-ger       format ">>>>>,>>>,>>9.99" at 70 skip
     c-lb-tot-desp    at 52  space(0) ":"
     de-tot-desp      format ">>>>>,>>>,>>9.99" at 70 skip
     c-lb-total       at 52  space(0) ":"
     de-tot-total     format ">>>>>,>>>,>>9.99" at 70 skip(1) 
     with no-box page-bottom no-label width 95 stream-io frame f-total2.
     
form header
     fill("-", 94)       format "x(94)" skip
     c-lb-tot-ped     at 52 space(0) ":" 
     de-tot-ger       format ">>>>>,>>>,>>9.999" at 70 skip
     c-lb-tot-desp    at 52 space(0) ":"
     de-tot-desp      format ">>>>>,>>>,>>9.999" at 70 skip
     c-lb-total       at 52 space(0) ":"
     de-tot-total     format ">>>>>,>>>,>>9.999" at 70 skip(1) 
     with no-box page-bottom no-label width 95 stream-io frame f-total3.     
     
form header
     fill("-", 94)       format "x(94)" skip
     c-lb-tot-ped     at 52 space(0) ":" 
     de-tot-ger       format ">>>>>,>>>,>>9.9999" at 70 skip
     c-lb-tot-desp    at 52 space(0) ":"
     de-tot-desp      format ">>>>>,>>>,>>9.9999" at 70 skip
     c-lb-total       at 52 space(0) ":"
     de-tot-total     format ">>>>>,>>>,>>9.9999" at 70 skip(1) 
     with no-box page-bottom no-label width 95 stream-io frame f-total4.     
     
form header
     fill("-", 94)       format "x(94)" skip
     c-lb-tot-ped     at 52 space(0) ":" 
     de-tot-ger       format ">>>>>,>>>,>>9.99999" at 70 skip
     c-lb-tot-desp    at 52 space(0) ":"
     de-tot-desp      format ">>>>>,>>>,>>9.99999" at 70 skip
     c-lb-total       at 52 space(0) ":"
     de-tot-total     format ">>>>>,>>>,>>9.99999" at 70 skip(1) 
     with no-box page-bottom no-label width 95 stream-io frame f-total5.     
     
form header
     c-msg         at 72 skip
     with no-box page-bottom no-label width 95 stream-io frame f-msg.     

form with no-box no-label 1 down width 95 stream-io frame f-lb-ped.

form 
     /* Informacoes do Pedido */
     c-lb-processo                at 10 ":" at 32 processo-imp.nr-proc-imp
     c-lb-pedido-c                at 70 ":" at 92 processo-imp.num-pedido skip
     
     c-lb-dt-ped                  at 10 ":" at 32 c-dt-pedido           
     c-lb-dt-emb                  at 70 ":" at 92 c-prev-emb            skip
     
     c-lb-incoterm                at 10 ":" at 32 c-cod-incoterm-i50    
     c-lb-frete                   at 70 ":" at 92 c-frete               skip
     
     c-lb-via-transp              at 10 ":" at 32 c-via-transp          
     c-lb-cond-pag                at 70 ":" at 92 c-cod-cond-pag "-"
                                                  c-cond-descricao             skip
     c-lb-natureza                at 10 ":" at 32 c-natureza             
     c-lb-transp                  at 70 ":" at 92 c-cod-transp "-"
                                                  transporte.nome-abrev        skip
     c-lb-banco                   at 10 ":" at 32 c-cod-banco "-"
                                                  c-banco
     c-lb-despac                  at 70 ":" at 92 c-cod-despachante "-" 
                                                  c-nome-desp skip
     c-lb-embarque                at 10 ":" at 32 c-pto-embarque "-"
                                                  c-embarque
     c-lb-desembarque             at 70 ":" at 92 c-pto-desembarque  "-" 
                                                  c-desembarque skip(1)
                                                  
     /* Informacoes do emitente */                                                         
     c-lb-codigo                  at 2  ": " at 17    c-cod-exportador  "-" 
                                                      emitente.nome-emit                    "-" 
                                                      emitente.nome-abrev                                skip
     c-lb-endereco                at 2  ": " at 17    emitente.endereco      
     c-lb-bairro                  at 63 ":"  at 70    emitente.bairro                                    skip 
     c-lb-cidade                  at 2  ": " at 17    emitente.cidade       
     c-lb-estado                  ":"        at 54    emitente.estado              
     c-lb-pais                    ":"        at 69    emitente.pais                                      skip
     c-lb-cep                     at 2 ": "  at 17    emitente.cep          
     c-lb-cx-postal               at 33 ":"  at 48    emitente.caixa-postal                              skip
     c-lb-telefone                at 2 ": "  at 17    emitente.telefone[1]  
         emitente.ramal[1] "-"            
         emitente.telefone[2]         
         emitente.ramal[2]          space(1)
     c-lb-telefax                 ":"        at 73    emitente.telefax                                   skip(1)
     
     /* Estabelecimento */
     c-lb-estabel                 at 2 ": " at 17    estabelec.cod-estabel
                                                     estabelec.nome                                     skip
     c-lb-endereco2               at 2 ": " at 17    estabelec.endereco   
     c-lb-bairro2                 at 63 ":" at 70    estabelec.bairro                                   skip
     c-lb-cidade2                 at 2 ": " at 17    estabelec.Cidade     
     c-lb-estado2                 ":"       at 54    estabelec.estado              
     c-lb-pais2                   ":"       at 69    estabelec.pais                                     skip
     c-lb-cep2                    at 2 ": " at 17    estabelec.cep        
     c-lb-cx-postal2              at 33 ":" at 48    caixa-postal-estab                              skip
     c-lb-telefone2               at 2 ": "  at 17   telefone-estab1      
         ramal-estab1 "-"
         telefone-estab2         
         ramal-estab2          space(1)
     c-lb-telefax2                ":"        at 73   telefax-estab                                      skip(1)
                                                     
     /* Agente Cargas */
     c-lb-codigo-agente           at 2  ": " at 17   c-cod-agente-cargas  
         nome-emit-agente           "-" 
         nome-abrev-agente          skip
     c-lb-endereco-agente         at 2 ": " at 17  endereco-agente        
     c-lb-bairro-agente           at 63 ":" at 70  bairro-agente                                        skip
     c-lb-cidade-agente           at 2 ": " at 17  cidade-agente          
     c-lb-estado-agente           ":"       at 54  estado-agente              
     c-lb-pais-agente             ":"       at 69  pais-agente                                          skip
     c-lb-cep-agente              at 2 ": " at 17  cep-agente             
     c-lb-cx-postal-agente        at 33 ":" at 48  caixa-postal-agente        skip
     c-lb-telefone-agente         at 2 ": " at 17  telefone-agente1       
                                                   ramal-agente1 "-"           
                                                   telefone-agente2
                                                   ramal-agente2              space(1)
     c-lb-telefax-agente          ":"       at 73  telefax-agente                                       skip(2)
     with no-box no-label 1 down width 132 stream-io frame f-pedido.
     
form c-lb-ordem      at 1
     c-lb-item-for   at 11
     c-lb-item       at 32 
     c-lb-desc       at 49
     c-lb-pa         at 5
     c-lb-qtde       at 13
     c-lb-un         at 24
     c-lb-moeda      at 27 
     c-lb-prc-unit   at 49 
     c-lb-prc-tot    at 68 
     c-lb-data-entrega at 84 
     "---------------------------------------------------------------------------------------------------" at 1
     with no-box no-label width 132 stream-io frame f-labels.
     
form c-lb-desp at 4
     c-lb-descr at 12
     c-lb-forn at 43
     c-lb-val  at 56 skip
     "-------" at 4 space(1)
     "------------------------------" space(1)
     "------------" space(1)
     "-------------------" skip     
     with no-box no-label width 132 stream-io frame f-lb-desp.

def var c-lb-alter as char format "x(22)" no-undo.
    
{utp/ut-liter.i Altera‡äes_do_Pedido * r}
assign c-lb-alter = trim(return-value).
     
form
   tt-desp.cod-desp   at 4
   tt-desp.desc-desp  at 12
   tt-desp.forn-desp  at 43
   tt-desp.total-desp at 56
   with no-box no-label width 132 stream-io frame f-despesa.

form tt-editor.conteudo at 4
     with no-box no-label width 132 stream-io frame f-narrativa.

form c-texto-follow at 4
     with no-box no-label width 132 stream-io frame f-narrativa-1.
     
form
    prazo-compra.parcela      at 2 space(0)
    prazo-compra.qtd-sal-forn format ">>>>>>>,>>9.9999" space(1)
    cotacao-item.un           space(1)
    c-moeda                   /*space(1)*/
    &if defined(bf-mat-comex) &then    
        de-preco-unit             to 57
        de-preco-total            to 77 
    &else
        de-preco-unit             to 58
        de-preco-total            to 78 
    &endif
    c-dt-entrega              at 84 
    with no-box no-label width 132 stream-io frame f-parcela-5.

form
    prazo-compra.parcela      at 2 space(0)
    prazo-compra.qtd-sal-forn format ">>>>>>>,>>9.9999" space(1)
    cotacao-item.un           space(1)
    c-moeda                   space(1)
    &if defined(bf-mat-comex) &then    
        de-preco-unit             to 58
        de-preco-total            to 78 
    &else
        de-preco-unit             to 59
        de-preco-total            to 79 
    &endif             
    c-dt-entrega              at 84
    with no-box no-label width 132 stream-io frame f-parcela-4.

form
    prazo-compra.parcela      at 2 space(0)
    prazo-compra.qtd-sal-forn format ">>>>>>>,>>9.9999" space(1)
    cotacao-item.un           space(1)
    c-moeda                   space(1)
    de-preco-unit             to 60
    de-preco-total            to 80 
    &if defined(bf-mat-comex) &then    
        de-preco-unit             to 59
        de-preco-total            to 79 
    &else
        de-preco-unit             to 60
        de-preco-total            to 80 
    &endif             
    c-dt-entrega              at 84
    with no-box no-label width 132 stream-io frame f-parcela-3.

form
    prazo-compra.parcela      at 2 space(0)
    prazo-compra.qtd-sal-forn format ">>>>>>>,>>9.9999" space(1)
    cotacao-item.un           space(1)
    c-moeda                   space(1)
    &if defined(bf-mat-comex) &then    
        de-preco-unit             to 60
        de-preco-total            to 80 
    &else
        de-preco-unit             to 61
        de-preco-total            to 81 
    &endif             
    c-dt-entrega              at 84  
    with no-box no-label width 132 stream-io frame f-parcela-2.


form 
/*Sele‡Æo*/
     skip(1)                                   
     c-lb-tit-sel skip  
     c-lb-ped  at 5 ": " space(1)
     tt-param.i-pedi-i  "|< >|" at 40  space(1)
     tt-param.i-pedi-f                 
/*parƒmetros*/
     skip(1)
     c-lb-tit-par  at 1 skip
     c-lb-narra  at 5 ": "
     tt-param.l-narrativa
     c-lb-alteracoes at 5 ": "
     tt-param.l-alteracoes
     c-lb-formato at 5 ": "
     c-formato-data
     c-lb-cb-round at 5 ": "
     c-cb-round
     
/*impressÆo*/
     skip(1)
     c-lb-tit-imp     at 1 skip     
     c-lb-destino     at 5 ": " 
     tt-param.c-destino " - " tt-param.arquivo format "x(20)" skip
     c-lb-usuario     at 5 ": " 
     tt-param.usuario format "x(20)"
     
/*parƒmetros da impressÆo*/
     skip(1)
     c-lb-tit-par-imp at 1 skip
     c-lb-traduz      at 5 ": " 
     tt-param.l-traduz
     c-lb-par-imp     at 5 ": "
     tt-param.l-impressao
     with width 132 no-labels stream-io frame f-param.     
     
