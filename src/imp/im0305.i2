def temp-table tt-desp no-undo
     field cod-desp   like cotacao-item-cex.cod-desp
     field desc-desp  like desp-imp.descricao
     field forn-desp  like emitente.nome-abrev
     field desc-moeda like moeda.descricao
     field total-desp like cotacao-item-cex.val-desp 
     index despesa cod-desp.

