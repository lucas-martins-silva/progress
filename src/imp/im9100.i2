           {1}-aux3.ins-estadual-emit-estab-fis  = tt-emitente.ins-estadual
           {1}-aux3.ins-municipal-emit-estab-fis = tt-emitente.ins-municipal
           {1}-aux3.caixa-postal-emit-estab-fis  = tt-emitente.caixa-postal
           {1}-aux3.e-mail-emit-estab-fis	 = tt-emitente.e-mail
           {1}-aux3.cod-aba-emit-estab-fis	 = tt-emitente.cod-aba
           {1}-aux3.telefone1-emit-estab-fis	 = tt-emitente.telefone[1]
           {1}-aux3.telefone2-emit-estab-fis	 = tt-emitente.telefone[2]
           {1}-aux3.ramal1-emit-estab-fis	 = tt-emitente.ramal[1]
           {1}-aux3.ramal2-emit-estab-fis	 = tt-emitente.ramal[2]
           {1}-aux3.home-page-emit-estab-fis	 = tt-emitente.home-page
           {1}-aux3.telefax-emit-estab-fis	 = tt-emitente.telefax
           {1}-aux3.ramal-fax-emit-estab-fis	 = tt-emitente.ramal-fax
           {1}-aux3.telef-fac-emit-estab-fis	 = tt-emitente.telef-fac
           {1}-aux3.ramal-fac-emit-estab-fis	 = tt-emitente.ramal-fac
           {1}-aux3.telef-modem-emit-estab-fis   = tt-emitente.telef-modem
           {1}-aux3.ramal-modem-emit-estab-fis   = tt-emitente.ramal-modem.

    empty temp-table tt-emitente.

    RUN getPontosControleItiner IN h-imapi009 (OUTPUT TABLE tt-emb-pto-contr).
    FOR EACH tt-emb-pto-contr:                       
        CASE tt-emb-pto-contr.tp-pto-contr:
            WHEN 1 THEN DO:    
                ASSIGN {1}-aux3.pto-despacho	         = tt-emb-pto-contr.pto-contr               
                       {1}-aux3.desc-pto-despacho	 = tt-emb-pto-contr.desc-pto-contr          
                       {1}-aux3.data-prev-despacho       = tt-emb-pto-contr.data-prev-pto-contr     
                       {1}-aux3.data-efet-despacho       = tt-emb-pto-contr.data-efet-pto-contr     
                       {1}-aux3.data-ult-prev-despacho   = tt-emb-pto-contr.data-ult-prev-pto-contr 
                       {1}-aux3.ufr-despacho	         = tt-emb-pto-contr.unid-referencial.
            END.
            WHEN 2 THEN DO:
                ASSIGN {1}-aux3.pto-embarque	         = tt-emb-pto-contr.pto-contr               
                       {1}-aux3.desc-pto-embarque	 = tt-emb-pto-contr.desc-pto-contr          
                       {1}-aux3.data-prev-embarque       = tt-emb-pto-contr.data-prev-pto-contr     
                       {1}-aux3.data-efet-embarque       = tt-emb-pto-contr.data-efet-pto-contr     
                       {1}-aux3.data-ult-prev-embarque   = tt-emb-pto-contr.data-ult-prev-pto-contr 
                       {1}-aux3.ufr-embarque	         = tt-emb-pto-contr.unid-referencial.
            END.
            WHEN 3 THEN DO:
                ASSIGN {1}-aux3.pto-nacionaliz	         = tt-emb-pto-contr.pto-contr                
                       {1}-aux3.desc-pto-nacionaliz      = tt-emb-pto-contr.desc-pto-contr           
                       {1}-aux3.data-prev-nacionaliz     = tt-emb-pto-contr.data-prev-pto-contr      
                       {1}-aux3.data-efet-nacionaliz     = tt-emb-pto-contr.data-efet-pto-contr      
                       {1}-aux3.data-ult-prev-nacionaliz = tt-emb-pto-contr.data-ult-prev-pto-contr  
                       {1}-aux3.ufr-nacionaliz	         = tt-emb-pto-contr.unid-referencial.
            END.
            WHEN 5 THEN DO:
                ASSIGN {1}-aux3.pto-chegada	         = tt-emb-pto-contr.pto-contr               
                       {1}-aux3.desc-pto-chegada	 = tt-emb-pto-contr.desc-pto-contr          
                       {1}-aux3.data-prev-chegada	 = tt-emb-pto-contr.data-prev-pto-contr     
                       {1}-aux3.data-efet-chegada	 = tt-emb-pto-contr.data-efet-pto-contr     
                       {1}-aux3.data-ult-prev-chegada    = tt-emb-pto-contr.data-ult-prev-pto-contr 
                       {1}-aux3.ufr-chegada	         = tt-emb-pto-contr.unid-referencial.  
            END.                                                            
        END CASE.
    END.         
    empty temp-table tt-emb-pto-contr.
    
    
&ENDIF     
