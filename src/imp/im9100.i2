&IF "{1}" = "tt-processo-imp"
OR  "{1}" = "tt-pedido-compr-emb" &THEN

    empty temp-table tt-pedido.

    RUN getPedidoCompra IN h-imapi009 (OUTPUT TABLE tt-pedido).
    FIND FIRST tt-pedido NO-ERROR.
    if avail tt-pedido then
        ASSIGN {1}.num-ped-benef  = tt-pedido.num-ped-benef
           {1}.data-pedido	  = tt-pedido.data-pedido
           {1}.desc-situacao	  = {ininc/i02in295.i 4 tt-pedido.situacao}
           {1}.cod-emitente       = tt-pedido.cod-emitente
           {1}.end-entrega        = tt-pedido.end-entrega
           {1}.end-cobranca       = tt-pedido.end-cobranca
           {1}.cod-cond-pag       = tt-pedido.cod-cond-pag
           {1}.cod-mens-ped       = tt-pedido.cod-mensagem
           {1}.comentarios	  = tt-pedido.comentarios
           {1}.compl-entrega	  = tt-pedido.compl-entrega
           {1}.cod-estabel-gestor = tt-pedido.cod-estab-gestor
           {1}.cod-emit-terc	  = tt-pedido.cod-emit-terc.
     
    empty temp-table tt-emitente.  

    RUN getEmitenteEntrega IN h-imapi009 (OUTPUT TABLE tt-emitente).
    FIND FIRST tt-emitente NO-ERROR.
    if avail tt-emitente then
        ASSIGN {1}.nome-emit-entr	   = tt-emitente.nome-emit
               {1}.endereco-emit-entr      = tt-emitente.endereco
               {1}.bairro-emit-entr	   = tt-emitente.bairro
               {1}.cidade-emit-entr	   = tt-emitente.cidade
               {1}.pais-emit-entr	   = tt-emitente.pais
               {1}.cep-emit-entr	   = tt-emitente.cep
               {1}.cgc-emit-entr	   = tt-emitente.cgc
               {1}.estado-emit-entr	   = tt-emitente.estado
               {1}.ins-estadual-emit-entr  = tt-emitente.ins-estadual
               {1}.ins-municipal-emit-entr = tt-emitente.ins-municipal
               {1}.caixa-postal-emit-entr  = tt-emitente.caixa-postal
               {1}.e-mail-emit-entr	   = tt-emitente.e-mail
               {1}.cod-aba-emit-entr       = tt-emitente.cod-aba
               {1}.telefone1-emit-entr     = tt-emitente.telefone[1]
               {1}.telefone2-emit-entr     = tt-emitente.telefone[2]
               {1}.ramal1-emit-entr	   = tt-emitente.ramal[1]
               {1}.ramal2-emit-entr	   = tt-emitente.ramal[2]
               {1}.home-page-emit-entr     = tt-emitente.home-page
               {1}.telefax-emit-entr       = tt-emitente.telefax
               {1}.ramal-fax-emit-entr     = tt-emitente.ramal-fax
               {1}.telef-fac-emit-entr     = tt-emitente.telef-fac
               {1}.ramal-fac-emit-entr     = tt-emitente.ramal-fac
               {1}.telef-modem-emit-entr   = tt-emitente.telef-modem
               {1}.ramal-modem-emit-entr   = tt-emitente.ramal-modem.
           
    empty temp-table tt-estabelec.

    RUN getEstabelecimentoEntrega IN h-imapi009 (OUTPUT TABLE tt-estabelec).
    FIND FIRST tt-estabelec NO-ERROR.
    if avail tt-estabelec then
        ASSIGN {1}.nome-estab-entr	    = tt-estabelec.nome
               {1}.endereco-estab-entr	    = tt-estabelec.endereco
               {1}.bairro-estab-entr	    = tt-estabelec.bairro
               {1}.cidade-estab-entr	    = tt-estabelec.cidade
               {1}.pais-estab-entr	    = tt-estabelec.pais
               {1}.cep-estab-entr	    = tt-estabelec.cep
               {1}.cgc-estab-entr	    = tt-estabelec.cgc
               {1}.estado-estab-entr	    = tt-estabelec.estado
               {1}.ins-estadual-estab-entr  = tt-estabelec.ins-estadual
               {1}.ins-municipal-estab-entr = tt-estabelec.ins-municipal
               {1}.cod-suframa-estab-entr   = tt-estabelec.cod-suframa
               {1}.cod-emit-estab-entr	    = tt-estabelec.cod-emitente.
           
    empty temp-table tt-emitente.

    RUN getEmitenteEstabEntrega IN h-imapi009 (OUTPUT TABLE tt-emitente).
    FIND FIRST tt-emitente NO-ERROR.
    if avail tt-emitente then
        ASSIGN {1}.nome-emit-estab-entr	         = tt-emitente.nome-emit
               {1}.endereco-emit-estab-entr	 = tt-emitente.endereco
               {1}.bairro-emit-estab-entr	 = tt-emitente.bairro
               {1}.cidade-emit-estab-entr	 = tt-emitente.cidade
               {1}.pais-emit-estab-entr          = tt-emitente.pais
               {1}.cep-emit-estab-entr	         = tt-emitente.cep
               {1}.cgc-emit-estab-entr	         = tt-emitente.cgc
               {1}.estado-emit-estab-entr	 = tt-emitente.estado
               {1}.ins-estadual-emit-estab-entr	 = tt-emitente.ins-estadual
               {1}.ins-municipal-emit-estab-entr = tt-emitente.ins-municipal
               {1}.caixa-postal-emit-estab-entr  = tt-emitente.caixa-postal
               {1}.e-mail-emit-estab-entr	 = tt-emitente.e-mail
               {1}.cod-aba-emit-estab-entr	 = tt-emitente.cod-aba
               {1}.telefone1-emit-estab-entr     = tt-emitente.telefone[1]
               {1}.telefone2-emit-estab-entr     = tt-emitente.telefone[2]
               {1}.ramal1-emit-estab-entr	 = tt-emitente.ramal[1]
               {1}.ramal2-emit-estab-entr        = tt-emitente.ramal[2]
               {1}.home-page-emit-estab-entr     = tt-emitente.home-page
               {1}.telefax-emit-estab-entr	 = tt-emitente.telefax
               {1}.ramal-fax-emit-estab-entr     = tt-emitente.ramal-fax
               {1}.telef-fac-emit-estab-entr     = tt-emitente.telef-fac
               {1}.ramal-fac-emit-estab-entr     = tt-emitente.ramal-fac
               {1}.telef-modem-emit-estab-entr   = tt-emitente.telef-modem
               {1}.ramal-modem-emit-estab-entr   = tt-emitente.ramal-modem.

    empty temp-table tt-estabelec.
    
    RUN getEstabelecimentoCobranca IN h-imapi009 (OUTPUT TABLE tt-estabelec).
    
    &IF "{1}" = "tt-processo-imp" &THEN
        if not can-find({1}-aux where {1}-aux.cod-estabel = {1}.cod-estabel
                                 and  {1}-aux.embarque    = {1}.embarque   
                                 and  {1}-aux.num-pedido  = {1}.num-pedido
                                 and  {1}-aux.nr-proc-imp = {1}.nr-proc-imp) then do:
                                 
                create {1}-aux.
                assign {1}-aux.cod-estabel = {1}.cod-estabel
                       {1}-aux.embarque    = {1}.embarque   
                       {1}-aux.num-pedido  = {1}.num-pedido 
                       {1}-aux.r-rowid     = {1}.r-rowid
                       {1}-aux.nr-proc-imp = {1}.nr-proc-imp.
        end.   
    
    &ENDIF
    
    &IF "{1}" = "tt-pedido-compr-emb" &THEN
        if not can-find({1}-aux where {1}-aux.cod-estabel = {1}.cod-estabel
                                 and  {1}-aux.embarque    = {1}.embarque   
                                 and  {1}-aux.num-pedido  = {1}.num-pedido) then do:
                                 
                create {1}-aux.
                assign {1}-aux.cod-estabel = {1}.cod-estabel
                       {1}-aux.embarque    = {1}.embarque   
                       {1}-aux.num-pedido  = {1}.num-pedido 
                       {1}-aux.r-rowid     = {1}.r-rowid.
        end.   
    
    &ENDIF
    
    FIND FIRST tt-estabelec NO-ERROR.
    ASSIGN {1}.nome-estab-cobr	        = tt-estabelec.nome
           {1}.endereco-estab-cobr      = tt-estabelec.endereco
           {1}.bairro-estab-cobr        = tt-estabelec.bairro
           {1}.cidade-estab-cobr        = tt-estabelec.cidade.
    
    assign {1}-aux.pais-estab-cobr          = tt-estabelec.pais
           {1}-aux.cep-estab-cobr	    = tt-estabelec.cep
           {1}-aux.cgc-estab-cobr	    = tt-estabelec.cgc
           {1}-aux.estado-estab-cobr        = tt-estabelec.estado
           {1}-aux.ins-estadual-estab-cobr  = tt-estabelec.ins-estadual
           {1}-aux.ins-municipal-estab-cobr = tt-estabelec.ins-municipal
           {1}-aux.cod-suframa-estab-cobr   = tt-estabelec.cod-suframa
           {1}-aux.cod-emit-estab-cobr	    = tt-estabelec.cod-emitente.

    empty temp-table tt-emitente.

    RUN getEmitenteEstabCobr IN h-imapi009 (OUTPUT TABLE tt-emitente).
    FIND FIRST tt-emitente NO-ERROR.
    if avail tt-emitente then
        ASSIGN {1}-aux.nome-emit-estab-cobr	         = tt-emitente.nome-emit
               {1}-aux.endereco-emit-estab-cobr	 = tt-emitente.endereco
               {1}-aux.bairro-emit-estab-cobr	 = tt-emitente.bairro
               {1}-aux.cidade-emit-estab-cobr	 = tt-emitente.cidade
               {1}-aux.pais-emit-estab-cobr	         = tt-emitente.pais
               {1}-aux.cep-emit-estab-cobr	         = tt-emitente.cep
               {1}-aux.cgc-emit-estab-cobr	         = tt-emitente.cgc
               {1}-aux.estado-emit-estab-cobr	 = tt-emitente.estado
               {1}-aux.ins-estadual-emit-estab-cobr  = tt-emitente.ins-estadual
               {1}-aux.ins-municipal-emit-estab-cobr = tt-emitente.ins-municipal
               {1}-aux.caixa-postal-emit-estab-cobr  = tt-emitente.caixa-postal
               {1}-aux.e-mail-emit-estab-cobr	 = tt-emitente.e-mail
               {1}-aux.cod-aba-emit-estab-cobr	 = tt-emitente.cod-aba
               {1}-aux.telefone1-emit-estab-cobr     = tt-emitente.telefone[1]
               {1}-aux.telefone2-emit-estab-cobr     = tt-emitente.telefone[2]
               {1}-aux.ramal1-emit-estab-cobr	 = tt-emitente.ramal[1]
               {1}-aux.ramal2-emit-estab-cobr	 = tt-emitente.ramal[2]
               {1}-aux.home-page-emit-estab-cobr     = tt-emitente.home-page
               {1}-aux.telefax-emit-estab-cobr	 = tt-emitente.telefax
               {1}-aux.ramal-fax-emit-estab-cobr     = tt-emitente.ramal-fax
               {1}-aux.telef-fac-emit-estab-cobr     = tt-emitente.telef-fac
               {1}-aux.ramal-fac-emit-estab-cobr     = tt-emitente.ramal-fac
               {1}-aux.telef-modem-emit-estab-cobr   = tt-emitente.telef-modem
               {1}-aux.ramal-modem-emit-estab-cobr   = tt-emitente.ramal-modem.
           
    empty temp-table tt-estabelec.
           
    RUN getEstabelecimentoGestor IN h-imapi009 (OUTPUT TABLE tt-estabelec).
    
    FIND FIRST tt-estabelec NO-ERROR.
    if avail tt-estabelec then
        ASSIGN {1}-aux.nome-estab-gest	    = tt-estabelec.nome
               {1}-aux.endereco-estab-gest	    = tt-estabelec.endereco
               {1}-aux.bairro-estab-gest	    = tt-estabelec.bairro
               {1}-aux.cidade-estab-gest	    = tt-estabelec.cidade
               {1}-aux.pais-estab-gest	    = tt-estabelec.pais
               {1}-aux.cep-estab-gest	    = tt-estabelec.cep
               {1}-aux.cgc-estab-gest	    = tt-estabelec.cgc
               {1}-aux.estado-estab-gest	    = tt-estabelec.estado
               {1}-aux.ins-estadual-estab-gest  = tt-estabelec.ins-estadual
               {1}-aux.ins-municipal-estab-gest = tt-estabelec.ins-municipal
               {1}-aux.cod-suframa-estab-gest   = tt-estabelec.cod-suframa
               {1}-aux.cod-emit-estab-gest	    = tt-estabelec.cod-emitente. 

    empty temp-table tt-emitente.
    
    RUN getEmitenteEstabGest IN h-imapi009 (OUTPUT TABLE tt-emitente).
    FIND FIRST tt-emitente NO-ERROR.
    if avail tt-emitente then
        ASSIGN {1}-aux.nome-emit-estab-gest	         = tt-emitente.nome-emit
               {1}-aux.endereco-emit-estab-gest      = tt-emitente.endereco
               {1}-aux.bairro-emit-estab-gest        = tt-emitente.bairro
               {1}-aux.cidade-emit-estab-gest        = tt-emitente.cidade
               {1}-aux.pais-emit-estab-gest	         = tt-emitente.pais
               {1}-aux.cep-emit-estab-gest	         = tt-emitente.cep
               {1}-aux.cgc-emit-estab-gest	         = tt-emitente.cgc
               {1}-aux.estado-emit-estab-gest        = tt-emitente.estado
               {1}-aux.ins-estadual-emit-estab-gest  = tt-emitente.ins-estadual
               {1}-aux.ins-municipal-emit-estab-gest = tt-emitente.ins-municipal
               {1}-aux.caixa-postal-emit-estab-gest  = tt-emitente.caixa-postal
               {1}-aux.e-mail-emit-estab-gest	 = tt-emitente.e-mail
               {1}-aux.cod-aba-emit-estab-gest	 = tt-emitente.cod-aba
               {1}-aux.telefone1-emit-estab-gest     = tt-emitente.telefone[1]
               {1}-aux.telefone2-emit-estab-gest     = tt-emitente.telefone[2]
               {1}-aux.ramal1-emit-estab-gest	 = tt-emitente.ramal[1]
               {1}-aux.ramal2-emit-estab-gest	 = tt-emitente.ramal[2]
               {1}-aux.home-page-emit-estab-gest     = tt-emitente.home-page
               {1}-aux.telefax-emit-estab-gest	 = tt-emitente.telefax
               {1}-aux.ramal-fax-emit-estab-gest     = tt-emitente.ramal-fax
               {1}-aux.telef-fac-emit-estab-gest     = tt-emitente.telef-fac
               {1}-aux.ramal-fac-emit-estab-gest     = tt-emitente.ramal-fac
               {1}-aux.telef-modem-emit-estab-gest   = tt-emitente.telef-modem
               {1}-aux.ramal-modem-emit-estab-gest   = tt-emitente.ramal-modem.
           
    empty temp-table tt-cond-pagto.
    
    RUN getCondicaoPagamento IN h-imapi009 (OUTPUT TABLE tt-cond-pagto).
    
    FIND FIRST tt-cond-pagto NO-ERROR.
    if avail tt-cond-pagto then
        ASSIGN {1}-aux.desc-cond-pagto = tt-cond-pagto.descricao.

    empty temp-table tt-mensagens.

    RUN getMensagem IN h-imapi009 (OUTPUT TABLE tt-mensagens).
    FIND FIRST tt-mensagens NO-ERROR.
    if avail tt-mensagens then
        ASSIGN {1}-aux.desc-mensagem-ped = tt-mensagens.descricao
               {1}-aux.texto-mensag-ped  = tt-mensagens.texto-mensag.

    FOR FIRST bf-processo-imp FIELDS(num-pedido)
        WHERE bf-processo-imp.num-pedido = tt-pedido.num-pedido NO-LOCK: END.
        
    RUN setConstraintProcessoImp IN h-imapi009 (INPUT ROWID(bf-processo-imp)).
    
    empty temp-table tt-processo.

    RUN getProcessoImportacao IN h-imapi009 (OUTPUT TABLE tt-processo).
    FIND FIRST tt-processo NO-ERROR.
    if avail tt-processo then 
        ASSIGN {1}-aux.nr-proc-imp	          = tt-processo.nr-proc-imp
               {1}-aux.cod-itiner	          = tt-processo.cod-itiner
               {1}-aux.dt-emissao	          = tt-processo.dt-emissao
               {1}-aux.dt-implantacao	          = tt-processo.dt-implantacao
               {1}-aux.dt-autorizacao	          = tt-processo.dt-autorizacao
               {1}-aux.cod-despachante	          = tt-processo.cod-despachante
               {1}-aux.cod-exportador	          = tt-processo.cod-exportador
               {1}-aux.cod-consignatario          = tt-processo.cod-consignatario
               {1}-aux.cod-transportador          = tt-processo.cod-transportador
               {1}-aux.cod-estabel	          = tt-processo.cod-estabel
               {1}-aux.carta-credito	          = tt-processo.carta-credito
               {1}-aux.narrativa                  = tt-processo.narrativa
               {1}-aux.cod-banco	          = tt-processo.cod-banco
               {1}-aux.nr-rof	                  = tt-processo.nr-rof
               {1}-aux.desc-via-transp	          = {adinc/i01ad268.i 4 tt-processo.via-transp}
               {1}-aux.estab-fisc	          = tt-processo.estab-fisc
               {1}-aux.contrato-cambio	          = tt-processo.contrato-cambio
               {1}-aux.cod-idioma	          = tt-processo.cod-idioma
               {1}-aux.situacao-proc-imp          = {cxinc/i01cx140.i 4 tt-processo.situacao}
               {1}-aux.cod-agente	          = tt-processo.cod-agente
               {1}-aux.cod-mens-proc-imp          = tt-processo.cod-mensagem
               {1}-aux.texto-mens-proc-imp        = tt-processo.texto-mensag
               {1}-aux.destino-documentacao       = tt-processo.destino-documentacao
               {1}-aux.cdn-corretor-cambio-import = tt-processo.cdn-corretor-cambio-import
               {1}-aux.cdn-despa-exter-import     = tt-processo.cdn-despa-exter-import
               {1}-aux.cdn-segurad-import	  = tt-processo.cdn-segurad-import
               {1}-aux.cdn-corretor-import	  = tt-processo.cdn-corretor-import.

    empty temp-table tt-estabelec.

    RUN getImportador IN h-imapi009 (OUTPUT TABLE tt-estabelec).
    FIND FIRST tt-estabelec NO-ERROR.
    if avail tt-estabelec then
        ASSIGN {1}-aux.nome-import	        = tt-estabelec.nome
           {1}-aux.endereco-import	= tt-estabelec.endereco
           {1}-aux.bairro-import	= tt-estabelec.bairro
           {1}-aux.cidade-import	= tt-estabelec.cidade
           {1}-aux.pais-import	        = tt-estabelec.pais
           {1}-aux.cep-import	        = tt-estabelec.cep
           {1}-aux.cgc-import	        = tt-estabelec.cgc
           {1}-aux.estado-import	= tt-estabelec.estado
           {1}-aux.ins-estadual-import	= tt-estabelec.ins-estadual
           {1}-aux.ins-municipal-import	= tt-estabelec.ins-municipal
           {1}-aux.cod-suframa-import	= tt-estabelec.cod-suframa
           {1}-aux.cod-emit-import	= tt-estabelec.cod-emitente.
           
    empty temp-table tt-emitente.
    
    RUN getEmitenteImportador IN h-imapi009 (OUTPUT TABLE tt-emitente).
    
    &IF "{1}" = "tt-processo-imp" &THEN
        if not can-find({1}-aux2 where {1}-aux2.cod-estabel = {1}.cod-estabel
                                  and  {1}-aux2.embarque    = {1}.embarque   
                                  and  {1}-aux2.num-pedido  = {1}.num-pedido
                                  and  {1}-aux2.nr-proc-imp = {1}.nr-proc-imp) then do:
                                 
                create {1}-aux2.
                assign {1}-aux2.cod-estabel = {1}.cod-estabel
                       {1}-aux2.embarque    = {1}.embarque   
                       {1}-aux2.num-pedido  = {1}.num-pedido 
                       {1}-aux2.r-rowid     = {1}.r-rowid
                       {1}-aux2.nr-proc-imp = {1}.nr-proc-imp.
        end.   
    
    &ENDIF
    
    &IF "{1}" = "tt-pedido-compr-emb" &THEN
        if not can-find({1}-aux2 where {1}-aux2.cod-estabel = {1}.cod-estabel
                                   and {1}-aux2.embarque    = {1}.embarque   
                                   and {1}-aux2.num-pedido  = {1}.num-pedido) then do:
                                 
                create {1}-aux2.
                assign {1}-aux2.cod-estabel = {1}.cod-estabel
                       {1}-aux2.embarque    = {1}.embarque   
                       {1}-aux2.num-pedido  = {1}.num-pedido 
                       {1}-aux2.r-rowid     = {1}.r-rowid.
        end.   
    
    &ENDIF
    
    FIND FIRST tt-emitente NO-ERROR.
    if avail tt-emitente then
    ASSIGN {1}-aux2.nome-emit-import	        = tt-emitente.nome-emit
           {1}-aux2.endereco-emit-import        = tt-emitente.endereco
           {1}-aux2.bairro-emit-import	        = tt-emitente.bairro
           {1}-aux2.cidade-emit-import	        = tt-emitente.cidade
           {1}-aux2.pais-emit-import            = tt-emitente.pais
           {1}-aux2.cep-emit-import             = tt-emitente.cep
           {1}-aux2.cgc-emit-import             = tt-emitente.cgc
           {1}-aux2.estado-emit-import	        = tt-emitente.estado
           {1}-aux2.ins-estadual-emit-import    = tt-emitente.ins-estadual
           {1}-aux2.ins-municipal-emit-import   = tt-emitente.ins-municipal
           {1}-aux2.caixa-postal-emit-import    = tt-emitente.caixa-postal
           {1}-aux2.e-mail-emit-import	        = tt-emitente.e-mail
           {1}-aux2.cod-aba-emit-import	        = tt-emitente.cod-aba
           {1}-aux2.telefone1-emit-import       = tt-emitente.telefone[1]
           {1}-aux2.telefone2-emit-import       = tt-emitente.telefone[2]
           {1}-aux2.ramal1-emit-import	        = tt-emitente.ramal[1]
           {1}-aux2.ramal2-emit-import	        = tt-emitente.ramal[2]
           {1}-aux2.home-page-emit-import       = tt-emitente.home-page
           {1}-aux2.telefax-emit-import	        = tt-emitente.telefax
           {1}-aux2.ramal-fax-emit-import       = tt-emitente.ramal-fax
           {1}-aux2.telef-fac-emit-import       = tt-emitente.telef-fac
           {1}-aux2.ramal-fac-emit-import       = tt-emitente.ramal-fac
           {1}-aux2.telef-modem-emit-import     = tt-emitente.telef-modem
           {1}-aux2.ramal-modem-emit-import     = tt-emitente.ramal-modem.
           
    empty temp-table tt-emitente.
    
    RUN getExportador IN h-imapi009 (OUTPUT TABLE tt-emitente).
    FIND FIRST tt-emitente NO-ERROR.
    if avail tt-emitente then
        ASSIGN {1}-aux2.nome-emit-export	     = tt-emitente.nome-emit
               {1}-aux2.endereco-emit-export      = tt-emitente.endereco
               {1}-aux2.bairro-emit-export        = tt-emitente.bairro
               {1}-aux2.cidade-emit-export        = tt-emitente.cidade
               {1}-aux2.pais-emit-export          = tt-emitente.pais
               {1}-aux2.cep-emit-export           = tt-emitente.cep
               {1}-aux2.cgc-emit-export           = tt-emitente.cgc
               {1}-aux2.estado-emit-export	     = tt-emitente.estado
               {1}-aux2.ins-estadual-emit-export	 = tt-emitente.ins-estadual
               {1}-aux2.ins-municipal-emit-export = tt-emitente.ins-municipal
