/************************************************************************
**
** imp/im7777.i2 - Include de consistˆncia dos dados dos itens.
**
************************************************************************/

find last tt-item-doc-est no-lock
    where tt-item-doc-est.cod-emitente = tt-docum-est.cod-emitente
      and tt-item-doc-est.nat-operacao = tt-docum-est.nat-operacao
      and tt-item-doc-est.serie-docto  = tt-docum-est.serie-docto
      and tt-item-doc-est.nro-docto    = tt-docum-est.nro-docto no-error.
              
if avail tt-item-doc-est then
   assign i-seq = tt-item-doc-est.sequencia + param-re.inc-seq.
else
   assign i-seq = param-re.seq-item-um.   
      
find first ordem-compra
    where ordem-compra.numero-ordem = tt-itens.numero-ordem no-lock  no-error.    
       
if  not avail ordem-compra then do:
    assign i-msg = 123
           c-msg = string(tt-itens.numero-ordem)
           c-char= "".
    run pi-gera-erro.
end.        
        
else do:
    find first item
        where item.it-codigo = ordem-compra.it-codigo no-lock no-error.

    if  not avail item then do:
        assign i-msg = 90
               c-msg = ordem-compra.it-codigo 
               c-char= "".
        run pi-gera-erro.
    end.    
      
    find first pedido-compr
        where pedido-compr.num-pedido = ordem-compra.num-pedido no-lock no-error.
    if  not avail pedido-compr then do:
        assign i-msg = 6363
               c-msg = ""
               c-char= " " + string(ordem-compra.num-pedido).
        run pi-gera-erro.        
    end.        
    find cotacao-item   
        where cotacao-item.numero-ordem = ordem-compra.numero-ordem
          and cotacao-item.cod-emitente = ordem-compra.cod-emitente
          and cotacao-item.it-codigo    = ordem-compra.it-codigo
          and cotacao-item.cot-aprovada = yes no-lock no-error.        
          
    if  not avail cotacao-item then do:
        assign i-msg = 2667
               c-msg = string(ordem-compra.numero-ordem)
               c-char= "".
        run pi-gera-erro.               
    end.
    
    if avail item then do:
        assign c-class-fiscal = item.class-fiscal.

      /* Item branco e d‚bito direto */    
      &if defined(bf-mat-comex) &then
        if item.it-codigo = "" and item.tipo-contr = "D" then do:
            if avail cotacao-item then do:
                assign c-class-fiscal = substring(cotacao-item.char-1,23,10).
            end.
        end.         
      &else
        if item.it-codigo = "" and item.tipo-contr = 4 then do:
            if avail cotacao-item then do:
                {cdp/cd4300.i4 "yes" cotacao-item.char-1}
                {ccp/cc9019.i51 "yes"}
                if c-class-fiscal-i50 <> "" then
                    assign c-class-fiscal = c-class-fiscal-i50.
            end.
        end.
      &endif
        find classif-fisc       
            where classif-fisc.class-fiscal = c-class-fiscal
            no-lock no-error.
        if not avail classif-fisc then do:            
            {utp/ut-table.i mgind classif-fisc 1}
            assign c-return = trim(return-value).
            {utp/ut-liter.i do_item * L}
            assign c-return1 = trim(return-value).
            assign i-msg = 6361
                   c-msg = c-return + " " + string(c-class-fiscal) + " " + c-return1 + " " + string(item.it-codigo)
                   c-char= "".
            run pi-gera-erro.                                                
        end.
    end.           
    
    else do:
        find cotacao
            where cotacao.mo-codigo   = cotacao-item.mo-codigo
              and cotacao.ano-periodo = string(year(cotacao-item.data-cotacao)) + string(month(cotacao-item.data-cotacao),"99")
              and cotacao.cotacao[int(day(cotacao-item.data-cotacao))] <> 0 no-lock no-error.
             
        if  not avail cotacao and cotacao-item.mo-codigo <> 0 then do:       
            assign i-msg = 1847
                   c-msg = string(cotacao-item.mo-codigo)
                   c-char= string(cotacao-item.data-cotacao).
            run pi-gera-erro.                      
        end.   
           
        find cotacao
            where cotacao.mo-codigo   = cotacao-item.mo-codigo
              and cotacao.ano-periodo = string(year(tt-docum-est.dt-emissao)) + string(month(tt-docum-est.dt-emissao),"99")
              and cotacao.cotacao[int(day(tt-docum-est.dt-emissao))] <> 0 no-lock no-error.
             
        if  not avail cotacao and cotacao-item.mo-codigo <> 0 then do:       
            assign i-msg = 1847
                   c-msg = string(cotacao-item.mo-codigo)
                   c-char= string(tt-docum-est.dt-emissao).
            run pi-gera-erro.
        end.                      
    end.
end.    

/* im7777.i2 */
