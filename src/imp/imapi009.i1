DEFINE TEMP-TABLE tt-invoice no-undo           LIKE invoice-emb-imp
    FIELD mo-desc                              LIKE moeda.descricao LABEL "Descri‡Æo"
    FIELD r-rowid                              AS ROWID.

DEFINE TEMP-TABLE tt-pd-fecha-camb NO-UNDO     
    FIELD cod-estabel                          LIKE invoice-emb-imp.cod-estabel
    FIELD embarque                             LIKE invoice-emb-imp.embarque   
    FIELD nr-invoice                           LIKE invoice-emb-imp.nr-invoice 
    FIELD parcela                              LIKE invoice-emb-imp.parcela    
    FIELD mo-desc                              LIKE moeda.descricao
    FIELD vl-desp                              as decimal  format ">>>>,999"
    FIELD des-meio-transporte                  AS CHAR
    FIELD vl-merc                              LIKE cotacao-item.preco-unit 
    FIELD vl-total                             LIKE cotacao-item.preco-unit   
    FIELD dt-embarque                          AS DATE                
    FIELD dt-nacionaliz                        AS DATE.

DEFINE TEMP-TABLE tt-comprador no-undo         LIKE comprador.

