/* **********************  Internal Procedures  *********************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE pi-filtro wWindow 
PROCEDURE pi-filtro :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

IF INPUT FRAME fPage0 rs-filtro = 1 THEN
    RUN pi-seta-param-ativo IN phCaller (INPUT YES).
ELSE
    RUN pi-seta-param-ativo IN phCaller (INPUT NO).

RETURN "OK":U.
END PROCEDURE.

