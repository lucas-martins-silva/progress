/*
**
** IMAPI001.I2 - Validacoes para geracao automatica de despesas
**
*/

procedure createDespesa:
    /*
    ** Cria despesa para o Mapa de Cotaá∆o de Despesas Adicionais 
    */
    
    def input parameter p-cod-desp      like desp-imp.cod-desp        no-undo.
    def input parameter p-cod-pto-contr like pto-contr.cod-pto-contr  no-undo.
    &if '{&bf_mat_versao_ems}' >= '2.062' &then
       def input parameter p-cod-itiner    like itiner.cod-itiner     no-undo.
       def input parameter p-cod-incoterm  like inco-cx.cod-incoterm  no-undo.
    &endif
    def input parameter p-formula       as logical                    no-undo.
    
    &if '{&bf_mat_versao_ems}' >= '2.062' &then
       def var c-fornec-desp    like desp-itiner.cod-emitente no-undo.
       def var c-nr-tab         like desp-tb-pr-cex.nr-tab    no-undo.
       def var l-desp-infl-out  as logical                    no-undo.
    &endif        
    
    find desp-imp where desp-imp.cod-desp = p-cod-desp no-lock no-error.
    if avail desp-imp then do:
        if not can-find(tt-despesas-im001 where tt-despesas-im001.cod-desp = desp-imp.cod-desp) then do:
            if can-find(desp-item where desp-item.it-codigo  = tt-cotacao-im001.it-codigo and
                                        desp-item.cod-desp   = desp-imp.cod-desp and
                                        desp-item.cod-itiner = tt-cotacao-im001.cod-itiner and
                                        desp-item.exclui     = yes) then do:
                leave.
            end.
            if can-find(desp-item where desp-item.it-codigo  = tt-cotacao-im001.it-codigo and
                                        desp-item.cod-desp   = desp-imp.cod-desp and
                                        desp-item.cod-itiner = 0 and
                                        desp-item.exclui     = yes) then do:
                leave.
            end.
            if tt-emitente-im001.despesas-inclusas and
               can-find(desp-incoterm where desp-incoterm.cod-incoterm = tt-cotacao-im001.cod-incoterm and
                                            desp-incoterm.cod-desp     = desp-imp.cod-desp) then do:
                leave.
            end.
            
            &if '{&bf_mat_versao_ems}' >= '2.062' &then
                run getFornecTabela (input  desp-imp.cod-desp,
                                     input  tt-cotacao-im001.cod-itiner,
                                     input  tt-cotacao-im001.cod-incoterm,
                                     output c-fornec-desp,
                                     output c-nr-tab,
                                     output l-desp-infl-out,
                                     output table tt-desp-vinc).
            &endif
                                 
            &if '{&bf_mat_versao_ems}' >= '2.062' &then
                /* Vari†vel setada na include imapi001.i4 */
                if l-desp-infl-out = yes then do:
            &else
                if desp-imp.tipo = 8 and not p-formula then do:
            &endif    
                    find tt-parametros-im001 no-lock where
                        tt-parametros-im001.cod-desp = desp-imp.cod-desp no-error.
                    if not available tt-parametros-im001 then do:
                        create tt-parametros-im001.
                        assign tt-parametros-im001.cod-versao-integracao  = tt-cotacao-im001.cod-versao-integracao
                                tt-parametros-im001.cod-desp              = desp-imp.cod-desp
                                tt-parametros-im001.cod-incoterm          = tt-cotacao-im001.cod-incoterm
                                tt-parametros-im001.it-codigo             = tt-cotacao-im001.it-codigo
                                tt-parametros-im001.cod-itiner            = tt-cotacao-im001.cod-itiner
                                tt-parametros-im001.cod-emitente          = tt-cotacao-im001.cod-emitente
                                tt-parametros-im001.cod-pto-contr         = p-cod-pto-contr
                                tt-parametros-im001.primeira-vez          = yes.
                                
                        run imp/imapi001a.p(input        table tt-parametros-im001,
                                            input-output table tt-despesas-im001,
                                            input        table tt-cotacao-im001,                                     
                                            input        table tt-emitente-im001,
                                            &if '{&bf_mat_versao_ems}' >= '2.062' &then
                                               input table tt-desp-vinc,
                                            &endif
                                            output       table tt-erro-im001).
                                            
                        find last tt-despesas-im001 no-error.
                        if avail tt-despesas-im001 then
                            assign i-seq = tt-despesas-im001.seq.
                     end.
                end.          
                else do:
                    if not can-find(tt-despesas-im001 where tt-despesas-im001.cod-desp = desp-imp.cod-desp) then do:
                        assign i-seq = i-seq + 1.
    
                        create tt-despesas-im001.
                        assign tt-despesas-im001.seq           = i-seq
                               tt-despesas-im001.cod-desp      = desp-imp.cod-desp
                               &if '{&bf_mat_versao_ems}' >= '2.062' &then
                                   tt-despesas-im001.cod-emitente  = c-fornec-desp
                                   tt-despesas-im001.nr-tab        = c-nr-tab
                               &endif
                               tt-despesas-im001.cod-pto-contr = p-cod-pto-contr.
                               
                    end.               
                end.
        end.
    end.
end procedure.

&if '{&bf_mat_versao_ems}' >= '2.062' &then
    {imp/imapi001.i3} /* Procedure Pesquisa Fornecedor e Tabela Preáo Padr∆o - getFornecTabela */
&endif

/* IMAPI001.I2 */
