    FIELD preco-interno-liq-mo-inf      LIKE cotacao-item.preco-fornec /*item.preco-base*/
    FIELD preco-fornec-bru-mo-inf       LIKE cotacao-item.preco-fornec /*item.preco-base*/
    FIELD preco-interno-bru-mo-inf      LIKE cotacao-item.preco-fornec /*item.preco-base*/
    FIELD peso-liquido-total            LIKE ITEM.peso-liquido
    FIELD peso-bruto-total              LIKE ITEM.peso-bruto
    FIELD preco-fornec-liq-total        LIKE cotacao-item.preco-fornec /*item.preco-base*/
    FIELD preco-interno-liq-total       LIKE cotacao-item.preco-fornec /*item.preco-base*/
    FIELD preco-fornec-bru-total        LIKE cotacao-item.preco-fornec /*item.preco-base*/
    FIELD preco-interno-bru-total       LIKE cotacao-item.preco-fornec /*item.preco-base*/
    FIELD ocupacao-total                LIKE ITEM.volume
    field class-fiscal                  as char format "9999.99.99" 
    INDEX ch-primary IS PRIMARY UNIQUE numero-ordem parcela.

DEFINE TEMP-TABLE tt-despesa no-undo
    FIELD num-pedido                      LIKE pedido-compr.num-pedido
    FIELD numero-ordem                    LIKE cotacao-item-cex.numero-ordem     
    FIELD it-codigo                       LIKE cotacao-item-cex.it-codigo        
    FIELD seq-cotac                       LIKE cotacao-item-cex.seq-cotac        
    FIELD data-cotacao                    LIKE cotacao-item-cex.data-cotacao     
    FIELD mapa-cotacao                    LIKE cotacao-item-cex.mapa-cotacao     
    FIELD cod-incoterm                    LIKE cotacao-item-cex.cod-incoterm     
    FIELD cod-itiner                      LIKE cotacao-item-cex.cod-itiner       
    FIELD sequencia                       LIKE cotacao-item-cex.sequencia        
    FIELD cod-emitente-desp               LIKE cotacao-item-cex.cod-emitente-desp
    FIELD cod-desp                        LIKE cotacao-item-cex.cod-desp
    FIELD val-desp	                      LIKE cotacao-item-cex.val-desp
    FIELD cod-cond-pag	                  LIKE cotacao-item-cex.cod-cond-pag
    FIELD data-cotacao-desp	              LIKE cotacao-item-cex.data-cotacao-desp
    FIELD mo-codigo	                      LIKE cotacao-item-cex.mo-codigo
    FIELD cod-pto-contr	                  LIKE cotacao-item-cex.cod-pto-contr
    FIELD val-desp-mo-inf                 LIKE desp-imp.val-desp
    FIELD nome-emit-desp	              LIKE emitente.nome-emit
    FIELD endereco-emit-desp              LIKE emitente.endereco
    FIELD bairro-emit-desp	              LIKE emitente.bairro
    FIELD cidade-emit-desp	              LIKE emitente.cidade
    FIELD pais-emit-desp	              LIKE emitente.pais
    FIELD cep-emit-desp	                  LIKE emitente.cep
    FIELD cgc-emit-desp	                  LIKE emitente.cgc
    FIELD estado-emit-desp	              LIKE emitente.estado
    FIELD ins-estadual-emit-desp          LIKE emitente.ins-estadual
    FIELD ins-municipal-emit-desp         LIKE emitente.ins-municipal
    FIELD caixa-postal-emit-desp          LIKE emitente.caixa-postal
    FIELD e-mail-emit-desp	              LIKE emitente.e-mail
    FIELD cod-aba-emit-desp	              LIKE emitente-cex.cod-aba
    FIELD telefone1-emit-desp	          LIKE emitente.telefone[1]
    FIELD telefone2-emit-desp	          LIKE emitente.telefone[2]
    FIELD ramal1-emit-desp	              LIKE emitente.ramal[1]
    FIELD ramal2-emit-desp	              LIKE emitente.ramal[2]
    FIELD home-page-emit-desp	          LIKE emitente.home-page
    FIELD telefax-emit-desp	              LIKE emitente.telefax
    FIELD ramal-fax-emit-desp	          LIKE emitente.ramal-fax
    FIELD telef-fac-emit-desp	          LIKE emitente.telef-fac
    FIELD ramal-fac-emit-desp	          LIKE emitente.ramal-fac
    FIELD telef-modem-emit-desp	          LIKE emitente.telef-modem
    FIELD ramal-modem-emit-desp	          LIKE emitente.ramal-modem
    FIELD desc-despesa	                  LIKE despesa.des-despesa
    FIELD desc-pto-contr-base	          LIKE pto-contr.descricao
    FIELD desc-cond-pagto	              LIKE cond-pagto.descricao
    FIELD narrativa-cond-pagto            LIKE narrativa.descricao
    FIELD desc-moeda	                  LIKE moeda.descricao
    FIELD sigla-moeda	                  LIKE moeda.sigla
    INDEX ch-primary IS PRIMARY UNIQUE 
          mo-codigo   
          cod-cond-pag
          cod-pto-contr
          cod-desp.

DEFINE TEMP-TABLE tt-texto-follow-up no-undo
    FIELD ind-tip-doc       LIKE texto-follow-up.ind-tip-doc  
    FIELD nr-requisicao     LIKE texto-follow-up.nr-requisicao
    FIELD sequencia         LIKE texto-follow-up.sequencia    
    FIELD it-codigo         LIKE texto-follow-up.it-codigo     
    FIELD numero-ordem      LIKE texto-follow-up.numero-ordem  
    FIELD num-pedido        LIKE texto-follow-up.num-pedido    
    FIELD cod-emitente      LIKE texto-follow-up.cod-emitente  
    FIELD des-narrativa     LIKE texto-follow-up.des-narrativa 
    FIELD char-1            LIKE texto-follow-up.char-1        
    FIELD char-2            LIKE texto-follow-up.char-2        
    FIELD dec-1             LIKE texto-follow-up.dec-1         
    FIELD dec-2             LIKE texto-follow-up.dec-2         
    FIELD int-1             LIKE texto-follow-up.int-1         
    FIELD int-2             LIKE texto-follow-up.int-2         
    FIELD log-1             LIKE texto-follow-up.log-1         
    FIELD log-2             LIKE texto-follow-up.log-2         
    FIELD data-1            LIKE texto-follow-up.data-1        
    FIELD data-2            LIKE texto-follow-up.data-2        
    FIELD nr-trans          LIKE texto-follow-up.nr-trans      
    FIELD parcela           LIKE texto-follow-up.parcela       
    FIELD seq-narra         LIKE texto-follow-up.seq-narra     
    INDEX texto-follow-up IS PRIMARY
        ind-tip-doc
        nr-requisicao
        sequencia
        it-codigo
    INDEX texto-follow-up-u  IS UNIQUE
        nr-trans.
