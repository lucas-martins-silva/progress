    "-------"                                           AT 045 
    "----------"                                        AT 053 
   WITH WIDTH 132 NO-LABEL NO-BOX STREAM-IO FRAME f-cabecDigita.

/* f-digita */
FORM
    tt-digita.num-di-ems                                AT 035
    tt-digita.cod-di-siscomex                           AT 050
    tt-digita.data-di                                   AT 053
   WITH DOWN WIDTH 132 NO-LABEL NO-BOX STREAM-IO FRAME f-digita.



/* Realiza a Traducao das forms/frames, caso necessario */

IF NOT v_cod_dialet_corren = "pt":U THEN DO:
    RUN utp/ut-trfrrp.p (INPUT FRAME f_cabec1:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-cabecPrinDi:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-PrinDi:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-cabecObsDi:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-cabecBasiCota:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-BasiCota:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-cabecProcVinc:HANDLE).
    IF tt-param.l-transporte <> NO THEN DO:
        RUN utp/ut-trfrrp.p (INPUT FRAME f-cabecTransDi:HANDLE).
        RUN utp/ut-trfrrp.p (INPUT FRAME f-transDi:HANDLE).
    END.
    RUN utp/ut-trfrrp.p (INPUT FRAME f-cabecCargaDi:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-cargaDi:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-cabecEmbalagem:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-embalagem:HANDLE).
    IF tt-param.l-Itinerario <> NO THEN DO:
        RUN utp/ut-trfrrp.p (INPUT FRAME f-cabecItinDi:HANDLE).
        RUN utp/ut-trfrrp.p (INPUT FRAME f-itinDi:HANDLE).
    END.
    IF tt-param.l-despesas <> NO THEN DO:
        RUN utp/ut-trfrrp.p (INPUT FRAME f-cabecDespDi:HANDLE).
        RUN utp/ut-trfrrp.p (INPUT FRAME f-despDi:HANDLE).
        RUN utp/ut-trfrrp.p (INPUT FRAME f-cabecDespEmbarq:HANDLE).
        RUN utp/ut-trfrrp.p (INPUT FRAME f-despEmbarq:HANDLE).
    END.
    RUN utp/ut-trfrrp.p (INPUT FRAME f-totPtoContr:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-cabecTotDesp:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-totDesp:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-cabecValores:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-valores:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-cabecImpostos:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-impostos:HANDLE).
    IF tt-param.l-cus-nacio <> NO THEN DO:
        RUN utp/ut-trfrrp.p (INPUT FRAME f-cabecCustNacInt:HANDLE).
        RUN utp/ut-trfrrp.p (INPUT FRAME f-custNacInt:HANDLE).
    END.
    RUN utp/ut-trfrrp.p (INPUT FRAME f-param:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-cabecDigita:HANDLE).
    RUN utp/ut-trfrrp.p (INPUT FRAME f-digita:HANDLE).
END.
