/* Cabecalho Geral - f_cabec1 */
FORM tt-decla-import.num-di-ems         LABEL "Nr.DI-EMS"        FORMAT ">>>>>>>>>9":U AT 001
     tt-decla-import.cod-estab          LABEL "Estabelecimento"  FORMAT "X(5)":U       AT 031
     tt-decla-import.cod-di-siscomex    LABEL "Nr. Di Siscomex"  FORMAT "X(13)":U      AT 056
     tt-decla-import.dat-di             LABEL "Data Di"          FORMAT "99/99/9999":U AT 088
     tt-decla-import.dat-retif          LABEL "Data Retif."      FORMAT "99/99/9999":U AT 110 SKIP
     tt-decla-import.idi-motiv-retif    LABEL "Motivo Retif."    FORMAT "99":U         AT 001     
    WITH WIDTH 132 SIDE-LABEL NO-BOX STREAM-IO FRAME f_cabec1.


/*Principal DI - f-cabecPrinDi*/
FORM HEADER 
     SKIP(2) "*" TRIM(fill("-", 57)) FORMAT "x(57)":U
     "PRINCIPAL DI" 
     FILL("-", 57) FORMAT "x(57)":U
     "*" SKIP
    WITH DOWN WIDTH 132 SIDE-LABEL NO-BOX STREAM-IO FRAME f-cabecPrinDi. 

/* f-PrinDi */
FORM c-cgc                                                 FORMAT "X(19)":U   COLON 043 SKIP
     c-tipo-decla                 LABEL "Tipo Declara‡Æo"  FORMAT "X(80)":U   COLON 043 SKIP /*buscar include - idi-tip-decla-import*/
     c-carac-oper                 LABEL "Caract Opera‡Æo"  FORMAT "X(30)":U   COLON 043 SKIP /*idi-caract-operac*/
     c-consig                     LABEL "Consignat rio"                       COLON 043 SKIP /*cdn-consign*/
     c-cgc-emit                                            FORMAT "X(19)":U   COLON 043 SKIP
     c-desp                       LABEL "Despachante"      FORMAT "x(30)":U   COLON 043 SKIP
     tt-decla-import.log-fundap                            FORMAT "Sim/NÆo"   COLON 043 SKIP
     c-modal-despach              LABEL "Modalid Despacho"                    COLON 043 SKIP /*idi-modalid-despch*/ 
     tt-decla-import.num-adicoes                           FORMAT ">>9":U     COLON 043 SKIP
     c-natur-opera                LABEL "Natur Opera‡Æo"                      COLON 043 SKIP /*cod-natur-operac (mgind.natur-oper)*/
    WITH WIDTH 132 SIDE-LABEL NO-BOX STREAM-IO FRAME f-PrinDi. 

/*Observacoes DI - f-cabecObsDi */
FORM HEADER 
     SKIP(2) "*" TRIM(FILL("-":U, 56)) FORMAT "x(56)":U
     "OBSERVA€åES DI" 
     FILL("-", 56) FORMAT "x(56)":U
     "*"
    WITH DOWN WIDTH 132 SIDE-LABEL NO-BOX STREAM-IO FRAME f-cabecObsDi.


/* B sicas DI e Cota‡äes - f-cabecBasiCota */
FORM HEADER
    SKIP(1) 
    "*":U FILL("-":U,23) FORMAT "X(23)":U "BµSICAS DI" FILL("-":U,23) FORMAT "X(23)":U "*":U
    FILL(" ",16) FORMAT "X(16)":U
    "*":U FILL("-":U,11) FORMAT "X(11)":U "COTA€åES" FILL("-":U,11) FORMAT "X(11)":U "*":U
    WITH DOWN WIDTH 132 SIDE-LABEL NO-BOX STREAM-IO FRAME f-cabecBasiCota.


/* f-BasiCota */
FORM lb-moeda                           NO-LABEL                    FORMAT "x(10)":U   AT 081
     lb-cotacao                         NO-LABEL                    FORMAT "x(10)":U   AT 109 SKIP
     tt-decla-import.cdn-urf-entr       LABEL "URF Entrada Pa¡s"    FORMAT ">>>>>>9":U AT 002
     tt-decla-import.cdn-urf-despch     LABEL "URF de Despacho"     FORMAT ">>>>>>9":U AT 038
     lb-separador                       NO-LABEL                    FORMAT "X(35)":U   AT 081
    WITH DOWN WIDTH 132 SIDE-LABEL NO-BOX STREAM-IO FRAME f-BasiCota.



/* f-moeda */
FORM c-moeda                      FORMAT "X(18)":U             AT 081
     tt-decla-imp-cotac.val-cotac FORMAT "->>>,>>9.99999999":U AT 99
    WITH DOWN WIDTH 132 NO-LABEL NO-BOX STREAM-IO FRAME f-moeda.


/* Processo Vinculado - f-cabecProcVinc */
FORM HEADER 
    FILL("-":U,13) FORMAT "X(13)":U AT 006
    "Processo Vinculado"            AT 020
    FILL("-":U,14) FORMAT "X(14)":U AT 039 SKIP
    "Tipo"                          AT 006 
    "Processo Vinculado"            AT 033 SKIP
    FILL("-":U,26) FORMAT "X(26)":U AT 006
    FILL("-":U,20) FORMAT "X(20)":U AT 033
   WITH DOWN WIDTH 132 SIDE-LABEL NO-BOX STREAM-IO FRAME f-cabecProcVinc.

/* f-ProcVinc */
FORM tt-decla-import-proc.desc-tipo             FORMAT "X(25)":U AT 006
     tt-decla-import-proc.cod-proces-vincul     FORMAT "X(20)":U AT 033
    WITH DOWN WIDTH 132 NO-LABEL NO-BOX STREAM-IO FRAME f-ProcVinc.

/*Transporte DI*/
IF tt-param.l-transporte <> NO THEN DO:
    
    /* f-cabecTransDi */
    FORM HEADER
        SKIP(2)
        "*":U FILL("-":U,56) FORMAT "X(56)":U "TRANSPORTE DI" FILL("-":U,57) FORMAT "X(57)":U "*":U
        WITH DOWN WIDTH 132 SIDE-LABEL NO-BOX STREAM-IO FRAME f-cabecTransDi.

    
    /* f-transDi */
    FORM c-doc-cheg-carg                     LABEL "Doc.Cheg.Carga"         FORMAT "X(20)":U          COLON 21
         c-via-transp                        LABEL "Via de Transporte"      FORMAT "X(20)":U          COLON 69 SKIP
         tt-decla-import.cod-identif         LABEL "Identifica‡Æo"          FORMAT "X(15)":U          COLON 21
         tt-decla-import.cdn-transp          LABEL "Transportador"          FORMAT "999999999":U      COLON 69 SKIP
         c-tipo-conhe-transp                 LABEL "Tipo Conhec.Transp."    FORMAT "X(7)":U           COLON 21
         c-pais-transp                       LABEL "Pa¡s Transp."           FORMAT "X(20)":U          COLON 69 SKIP
         tt-decla-import.cod-conhecto-master LABEL "Conhecimento Master"    FORMAT "X(25)":U          COLON 21    
         tt-decla-import.idi-ind-utiliz      LABEL "Utiliza‡Æo"             FORMAT ">9":U             COLON 69 SKIP
         tt-decla-import.cod-conhecto-house  LABEL "Conhecimento House"     FORMAT "X(25)":U          COLON 21
        WITH WIDTH 132 SIDE-LABEL NO-BOX STREAM-IO FRAME f-transDi.

END.

/*Carga DI - f-cabecCargaDi */
FORM HEADER
    SKIP(2)
    "*":U FILL("-":U,59) FORMAT "X(59)":U "CARGA DI":U FILL("-":U,59) FORMAT "X(59)":U "*":U
    WITH DOWN WIDTH 132 NO-LABEL NO-BOX STREAM-IO FRAME f-cabecCargaDi.

/* f-cargaDi */
FORM c-pais-proceden                          LABEL "Pa¡s Procedˆncia"       FORMAT "X(20)":U                      COLON 21  
     c-agent-transp                           LABEL "Agente Transportador"   FORMAT "X(50)":U                      COLON 79  
     tt-decla-import.val-peso-liq-di          LABEL "Peso Liq. TOTAL (Kg)"   FORMAT "->>,>>>,>>>,>>9.9999999999":U COLON 21  
     c-cnpj-agente-transp                     LABEL "CNPJ Agente Transp"     FORMAT "x(18)":U                      COLON 79  
     tt-decla-import.val-peso-brut-merc       LABEL "Peso Bruto Merc.(Kg)"   FORMAT "->>,>>>,>>>,>>9.9999999999":U COLON 21  
     tt-decla-import.cdn-recinto-alfand       LABEL "Recinto Alfandegado"    FORMAT ">>>>>>9":U                    COLON 79  
     tt-decla-import.val-peso-embal-di        LABEL "Peso Bru. Embal (kg)"   FORMAT "->>,>>>,>>>,>>9.9999999999":U COLON 21  
     tt-decla-import.cdn-setor-armaz          LABEL "Setor Armazenamento"    FORMAT ">>9":U                        COLON 79  
     tt-decla-import.val-peso-brut-tot-di     LABEL "Peso Bruto TOTAL(Kg)"   FORMAT "->>,>>>,>>>,>>9.9999999999":U COLON 21
   WITH WIDTH 132 SIDE-LABEL NO-BOX STREAM-IO FRAME f-cargaDi.


/* f-cabecEmbalagem */
FORM HEADER 
    SKIP(1)
    "Qtde"        AT 037
    "Sigla"       AT 044
    "Embalagem"   AT 051 SKIP
    "-----  -----  ------------------------------" AT 037
  WITH WIDTH 132 NO-LABEL NO-BOX STREAM-IO FRAME f-cabecEmbalagem.

/* f-embalagem */
FORM tt-decla-imp-embal.qtd-vol-embal  FORMAT ">>>,>>9":U AT 035
     tt-decla-imp-embal.cod-sig-embal  FORMAT "!xx":U     AT 045
     embalag.descricao                 FORMAT "X(30)":U   AT 051
   WITH DOWN WIDTH 132 NO-LABEL NO-BOX STREAM-IO FRAME f-embalagem.

/*Itinierario DI*/
IF tt-param.l-Itinerario <> NO THEN DO:

    /* f-cabecItinDi */
    FORM HEADER 
        SKIP(1)
        "*":U FILL("-":U,57) FORMAT "X(57)":U "ITINERµRIO DI" FILL("-":U,56) FORMAT "X(56)":U "*":U SKIP
        "Seq"              /*tt-histor-di.num-seq            */  AT 002
        "Pto.Cont"         /*tt-histor-di.cdn-pto-control    */  AT 006
        "Descri‡Æo"        /*c-pto-desc                      */  AT 015
        "PrevisÆo"         /*tt-histor-di.dat-prev-origin    */  AT 047
        "Ult.Prev."        /*tt-histor-di.dat-ult-prev       */  AT 058
        "Efetiva"          /*tt-histor-di.dat-efetivo        */  AT 069
        "Ve¡culo Transp."  /*tt-histor-di.cod-meio-transp    */  AT 083
        "Observa‡Æo"       /*tt-histor-di.dsl-observacao     */  AT 107
        WITH WIDTH 132 NO-LABEL NO-BOX STREAM-IO FRAME f-cabecItinDi.
    
    /* f-itinDi */
    FORM tt-histor-di.num-seq              AT 002
         tt-histor-di.cdn-pto-control      AT 006
         c-pto-desc                        AT 015
         tt-histor-di.dat-prev-origin      AT 047
         tt-histor-di.dat-ult-prev         AT 058
         tt-histor-di.dat-efetiva          AT 069  
         tt-histor-di.cod-meio-transp      AT 083
         c-dsl-obs  format "X(25)"         AT 107
       WITH DOWN WIDTH 132 NO-LABEL NO-BOX STREAM-IO FRAME f-itinDi.
END.

/*Despesas DI*/
IF tt-param.l-despesas <> NO THEN DO:

    /* f-cabecDespDi */
    FORM HEADER
        SKIP(2)
        "*":U FILL("-":U,57) FORMAT "X(57)":U "DESPESAS DI" FILL("-":U,58) FORMAT "X(58)":U "*":U
        SKIP
        "Despesa"          AT 007
        "Moeda"            AT 040
        "Taxa Cƒmbio"      AT 059
        "Forma Pre."       AT 074
        "Tipo Despesa"     AT 086
        "Incoterm"         AT 110 
       SKIP
        "Fornecedor"       AT 007
        "Condi‡Æo Pagto"   AT 040
        "Dupl"             AT 067
        "II"               AT 074
        "IPI"              AT 080
        "ICMS"             AT 086
        "PIS-ADU"          AT 093
        "PIS-DESP"         AT 102
        "COFINS-ADU"       AT 112
        SKIP
        "COFINS-DESP"      AT 007 
        "Valor-ME"         AT 040
        "Valor-MN"         AT 072
        FILL("-":U,130) FORMAT "X(130)":U AT 002
        WITH WIDTH 132 NO-LABEL NO-BOX STREAM-IO FRAME f-cabecDespDi.

    /* f-despDi */
    FORM "Ponto de Controle: "                                  AT 002
         tt-despes-decla-import.cdn-pto-control                 AT 021
         "-"                                                    AT 028
         c-desc-pto-control                                     AT 030
        SKIP(1)                                                
         tt-despes-decla-import.cdn-despes                      AT 007
         c-desc-desp                                            AT 013
         c-desp-moeda                                           AT 040
         d-taxa-camb                                            AT 053
         tt-despes-decla-import.log-forma-preco-compra          AT 074
         c-tipo-despes                                          AT 086
         tt-despes-decla-import.cod-incoterm-rat                AT 110
        SKIP                                                    
         tt-despes-decla-import.cdn-emit-despes                 AT 007
         c-desc-emitente                                        AT 016
         tt-despes-decla-import.cdn-cond-pagto                  AT 040
         c-desc-cond-pagto                                      AT 044
         l-duplic                                               AT 067
         l-ii                                                   AT 074
         l-ipi                                                  AT 080
         l-icms                                                 AT 086
         l-pis-adu                                              AT 093
         l-pis-desp                                             AT 102
         l-cofins-adu                                           AT 113
        SKIP
         l-cofins-desp                                          AT 007
         d-valor-me                                             AT 024
         d-valor-mn                                             AT 056
        SKIP(2)
       WITH DOWN WIDTH 132 NO-LABEL NO-BOX STREAM-IO FRAME f-despDi.
       
       
    /* Reforma Tribut ria - Novos Tributos (DBACKRTDTS-798) */
    /* f-cabecDespDiCbsIbs */
    FORM HEADER
        SKIP(2)
        "*":U FILL("-":U,57) FORMAT "X(57)":U "DESPESAS DI" FILL("-":U,58) FORMAT "X(58)":U "*":U
        SKIP
        "Despesa"          AT 007
        "Moeda"            AT 040
        "Taxa Cƒmbio"      AT 059
        "Forma Pre."       AT 074
        "Tipo Despesa"     AT 086
        "Incoterm"         AT 110 
       SKIP
        "Fornecedor"       AT 007
        "Condi‡Æo Pagto"   AT 040
        "Dupl"             AT 067
        "II"               AT 074
        "IPI"              AT 080
        "ICMS"             AT 086
        "PIS-ADU"          AT 093
        "PIS-DESP"         AT 102
        "COFINS-ADU"       AT 112
        SKIP
        "COFINS-DESP"      AT 007 
        "Valor-ME"         AT 040
        "Valor-MN"         AT 072
        SKIP
        "IBS UF"           AT 007
        "IBS Mun"          AT 017
        "CBS"              AT 027
        FILL("-":U,130) FORMAT "X(130)":U AT 002
        WITH WIDTH 132 NO-LABEL NO-BOX STREAM-IO FRAME f-cabecDespDiCbsIbs.
        
    /* f-despDiCbsIbs */
    FORM "Ponto de Controle: "                                  AT 002
         tt-despes-decla-import.cdn-pto-control                 AT 021
         "-"                                                    AT 028
         c-desc-pto-control                                     AT 030
        SKIP(1)                                                
         tt-despes-decla-import.cdn-despes                      AT 007
         c-desc-desp                                            AT 013
         c-desp-moeda                                           AT 040
         d-taxa-camb                                            AT 053
         tt-despes-decla-import.log-forma-preco-compra          AT 074
         c-tipo-despes                                          AT 086
         tt-despes-decla-import.cod-incoterm-rat                AT 110
        SKIP                                                    
         tt-despes-decla-import.cdn-emit-despes                 AT 007
         c-desc-emitente                                        AT 016
         tt-despes-decla-import.cdn-cond-pagto                  AT 040
         c-desc-cond-pagto                                      AT 044
         l-duplic                                               AT 067
         l-ii                                                   AT 074
         l-ipi                                                  AT 080
         l-icms                                                 AT 086
         l-pis-adu                                              AT 093
         l-pis-desp                                             AT 102
         l-cofins-adu                                           AT 113
        SKIP
         l-cofins-desp                                          AT 007
         d-valor-me                                             AT 024
         d-valor-mn                                             AT 056
        SKIP
         l-ibs-uf                                               AT 007
         l-ibs-mun                                              AT 017
         l-cbs                                                  AT 027
        SKIP(2)
       WITH DOWN WIDTH 132 NO-LABEL NO-BOX STREAM-IO FRAME f-despDiCbsIbs.
    /* FIM -- Reforma Tribut ria - Novos Tributos (DBACKRTDTS-798) */

    
    /*Despesas Embarque - f-cabecDespEmbarq */
    FORM HEADER
        SKIP(2)
        "*":U FILL("-":U,54) FORMAT "X(54)":U "DESPESAS EMBARQUE" FILL("-":U,55) FORMAT "X(55)":U "*":U
        SKIP
        "Despesa"          AT 007           
        "Moeda"            AT 040           
        "Taxa Cƒmbio"      AT 059           
        "Forma Pre."       AT 074           
        "Tipo Despesa"     AT 086           
        "Incoterm"         AT 110           
        SKIP                                 
        "Fornecedor"       AT 007           
        "Condi‡Æo Pagto"   AT 040           
        "Dupl"             AT 067           
        "II"               AT 074           
        "IPI"              AT 080           
        "ICMS"             AT 086           
        "PIS-ADU"          AT 093           
        "PIS-DESP"         AT 102           
        "COFINS-ADU"       AT 112           
        SKIP                                
        "COFINS-DESP"      AT 007           
        "Valor-ME"         AT 040           
        "Valor-MN"         AT 072           
        FILL("-":U,130) FORMAT "X(130)":U AT 002
        WITH WIDTH 132 NO-LABEL NO-BOX STREAM-IO FRAME f-cabecDespEmbarq.

    /* f-despEmbarq */
    FORM "Ponto de Controle: "                                  AT 002 
         tt-despes-decla-import.cdn-pto-control                 AT 021 
         "-"                                                    AT 028 
         c-desc-pto-control                                     AT 030 
        SKIP(1)                                                        
         tt-despes-decla-import.cdn-despes                      AT 007 
         c-desc-desp                                            AT 013 
         c-desp-moeda                                           AT 040 
         d-taxa-camb                                            AT 053 
         tt-despes-decla-import.log-forma-preco-compra          AT 074 
         c-tipo-despes                                          AT 086 
         tt-despes-decla-import.cod-incoterm-rat                AT 110 
        SKIP                                                           
         tt-despes-decla-import.cdn-emit-despes                 AT 007 
         c-desc-emitente                                        AT 016 
         tt-despes-decla-import.cdn-cond-pagto                  AT 040 
         c-desc-cond-pagto                                      AT 044 
         l-duplic                                               AT 067 
         l-ii                                                   AT 074 
         l-ipi                                                  AT 080 
         l-icms                                                 AT 086 
         l-pis-adu                                              AT 093 
         l-pis-desp                                             AT 102 
         l-cofins-adu                                           AT 113 
        SKIP                                                           
         l-cofins-desp                                          AT 007 
         d-valor-me                                             AT 024 
         d-valor-mn                                             AT 056 
        WITH DOWN WIDTH 132 NO-LABEL NO-BOX STREAM-IO FRAME f-despEmbarq.
END.

/*Total das despesas quebradas pelo ponto de controle - f-totPtoContr*/
