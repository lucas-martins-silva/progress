{include/i_dbvers.i}

    define variable c-destino           as character format "x(08)"       no-undo.
    define variable h-imapi009          as handle                         no-undo.
    define variable i-cont              as integer                        no-undo.
    define variable c-arquivo-final     as character                      no-undo.
    define variable c-arquivo-final-aux as character format "x(70)":U     no-undo.
    define variable l-imprime-doc       as logical initial yes            no-undo.
    define variable l-imprime-erro      as logical initial yes            no-undo.
    define variable c-agrupar           as char format "x(12)"            no-undo.
    define variable c-orientacao        as char format "x(08)"            no-undo.
    define variable c-traducao          as char format "x(18)"            no-undo.    
    define variable c-par               as char format "x(09)"            no-undo.
    define variable c-sel               as char format "x(07)"            no-undo.
    define variable c-imp               as char format "x(09)"            no-undo.
    define variable c-erro              as char format "x(70)"           no-undo.
    

    DEFINE TEMP-TABLE tt-bco-exp        no-undo    LIKE banco.

    DEFINE TEMP-TABLE tt-corretor no-undo   LIKE tt-emitente.
       

    def temp-table tt-raw-digita
        field raw-digita as raw.

    define temp-table tt-erro no-undo 
&IF "{&mguni_version}" >= "2.071" &THEN
        field cod-estabel AS character format "x(05)":U
&ELSE
        field cod-estabel AS character format "x(03)":U
&ENDIF
        field nome-abrev  AS character format "x(12)":U 
        field embarque    like embarque-imp.embarque
        field nr-invoice  AS character format "x(12)":U 
        field parcela     AS character format "x(02)":U 
        field cd-erro     as integer 
        field mensagem    as character format "X(280)".
        
    define temp-table tt-erro-geracao no-undo 
&IF "{&mguni_version}" >= "2.071" &THEN
        field cod-estabel AS character format "x(05)":U
&ELSE
        field cod-estabel AS character format "x(03)":U
&ENDIF
        field nome-abrev  AS character format "x(12)":U 
        field embarque    like embarque-imp.embarque
        field nr-invoice  AS character format "x(12)":U 
        field parcela     AS character format "x(02)":U 
        field cd-erro     as integer 
        field mensagem    as character format "X(70)":U.

    DO:
    form 
        "DOCUMENTOS IMPRESSOS"  at  1  skip(1) 
        with width 132 stream-io frame f-titulo-documentos.

    /* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
    RUN utp/ut-trfrrp.p (INPUT FRAME f-titulo-documentos:HANDLE).
    
    END. 
    
    form
        embarque-imp.cod-estabel at  1 column-label "Est"
        tt-emitente.nome-abrev   at  5 column-label "Exportador"
        embarque-imp.embarque    at 18 column-label "Embarque"
        c-arquivo-final-aux      at 35 column-label "Destino" format "x(70)"
        with down width 132 no-box stream-io frame f-documentos-impressos-emb.

    /* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
    RUN utp/ut-trfrrp.p (INPUT FRAME f-documentos-impressos-emb:HANDLE).
    
    
    form
        embarque-imp.cod-estabel at  1 column-label "Est"
        tt-emitente.nome-abrev   at  5 column-label "Exportador"
        embarque-imp.embarque    at 18 column-label "Embarque"
        tt-invoice.nr-invoice    at 35 column-label "Fatura"   
        c-arquivo-final-aux      at 49 column-label "Destino" format "x(70)"
        with down width 132 no-box stream-io frame f-documentos-impressos-inv.

    /* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
    RUN utp/ut-trfrrp.p (INPUT FRAME f-documentos-impressos-inv:HANDLE).
    
    
    form 
        skip (2)
        "ERROS"  at  1 
        skip(1) 
        with width 132 stream-io frame f-titulo-erros.

    /* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
    RUN utp/ut-trfrrp.p (INPUT FRAME f-titulo-erros:HANDLE).
    
    
    form
        tt-erro.cod-estabel      at  1 column-label "Est"
        tt-erro.nome-abrev       at  5 column-label "Exportador"
        tt-erro.embarque         at 18 column-label "Embarque"
        tt-erro.cd-erro          at 35 column-label "Nr Mensag" format ">>>>>>>>9":U
        c-erro                   at 45 column-label "Mensagem"  format "x(70)":U
        with down width 132 no-box stream-io frame f-erros-emb.

    /* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
    RUN utp/ut-trfrrp.p (INPUT FRAME f-erros-emb:HANDLE).
    
        
    form
        tt-erro.cod-estabel      at  1 column-label "Est"
        tt-erro.nome-abrev       at  5 column-label "Exportador"
        tt-erro.embarque         at 18 column-label "Embarque"
        tt-erro.nr-invoice       at 35 column-label "Fatura"   
        tt-erro.cd-erro          at 48 column-label "Nr Mensag" format ">>>>>>>>9":U
        c-erro                   at 58 column-label "Mensagem"  format "x(70)":U
        with down width 132 no-box stream-io frame f-erros-inv. 
    /* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
    RUN utp/ut-trfrrp.p (INPUT FRAME f-erros-inv:HANDLE).
       
    
    form 
    /*Selecao*/
        skip(1)                                   
        c-sel                                       no-label
        skip(1)                                    
        tt-param.cod-est-ini                        colon 19
        "|< >|"                                        at 48
        tt-param.cod-est-fim                        no-label
        tt-param.c-emb-ini                          colon 19
        "|< >|"                                        at 48
        tt-param.c-emb-fim                          no-label
        tt-param.nr-inv-ini                         colon 19
        "|< >|"                                        at 48
        tt-param.nr-inv-fim                         no-label
        tt-param.dt-vencim-ini                      colon 19
        "|< >|"                                        at 48
        tt-param.dt-vencim-fim                      no-label
        tt-param.c-master-ini                       colon 19
        "|< >|"                                        at 48
        tt-param.c-master-fim                       no-label
        tt-param.c-house-ini                        colon 19
        "|< >|"                                     at 48
        tt-param.c-house-fim                        no-label
        skip(1)                                    
    /*parametros*/                                 
        c-par                                       no-label
        skip(1)                                    
        tt-param.l-envia-docto-exportador           colon 45 
        skip                                       
        tt-param.l-envia-docto-corretor             colon 45
        skip                                       
        tt-param.c-arquivo-copia  format "x(30)"    colon 45
        skip                                       
        tt-param.l-layout-pad-fornec                colon 45
        skip                             
        tt-param.c-layout-pad-fornec format "x(30)" colon 45
        skip                             
        tt-param.l-sobrepor                         colon 45
        skip                             
        tt-param.c-dir-destino format "x(30)"       colon 45
        skip                             
        c-agrupar                                   colon 45
        skip                             
        c-orientacao                                colon 45
        skip                             
        c-traducao                                  colon 45
     /*impressao*/                          
         skip(1)
         c-imp                                      no-label
         skip(1)
         c-destino                                  colon 30 
         skip
         tt-param.usuario                           colon 30 
         skip(1)
         with width 132 side-labels frame f-param stream-io.

    /* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
    RUN utp/ut-trfrrp.p (INPUT FRAME f-param:HANDLE).
    

{utp/ut-liter.i Usu†rio * l}
assign tt-param.usuario:label in frame f-param = trim(return-value).
{utp/ut-liter.i Destino * l}
assign c-destino:label in frame f-param = trim(return-value).
{utp/ut-liter.i PAR∂METROS * r}
assign c-par = return-value.
{utp/ut-liter.i SELEÄ«O * r}
assign c-sel = return-value.
{utp/ut-liter.i IMPRESS«O * r}
assign c-imp = return-value.
{utp/ut-liter.i Estabelecimento * r}
assign tt-param.cod-est-ini:label in frame f-param = trim(return-value).
{utp/ut-liter.i Embarque * r}
assign tt-param.c-emb-ini:label in frame f-param = trim(return-value).
{utp/ut-liter.i Fatura * r}
assign tt-param.nr-inv-ini:label in frame f-param = trim(return-value).
{utp/ut-liter.i Vencimento * r}
assign tt-param.dt-vencim-ini:label in frame f-param = trim(return-value).
{utp/ut-liter.i Envia_Docto_Para_Exportador * r}
assign tt-param.l-envia-docto-exportador:label in frame f-param = trim(return-value).
{utp/ut-liter.i Envia_Docto_Para_Corretor_CÉmbio * r}
assign tt-param.l-envia-docto-corretor:label in frame f-param = trim(return-value).
{utp/ut-liter.i Copia_para * r}
assign tt-param.c-arquivo-copia:label in frame f-param = trim(return-value).
{utp/ut-liter.i Utilizar_Layout_padr∆o_do_Corretor_CÉmbio * r}
assign tt-param.l-layout-pad-fornec:label in frame f-param = trim(return-value).
{utp/ut-liter.i Layout_Padr∆o * r}
assign tt-param.c-layout-pad-fornec:label in frame f-param = trim(return-value).
{utp/ut-liter.i Sobrepor_Arquivos_j†_Existentes * r}
assign tt-param.l-sobrepor:label in frame f-param = trim(return-value).
{utp/ut-liter.i Diret¢rio * r}
assign tt-param.c-dir-destino:label in frame f-param = trim(return-value).
{utp/ut-liter.i Agrupar * r}
assign c-agrupar:label in frame f-param = trim(return-value).
{utp/ut-liter.i Orientaá∆o * r}
assign c-orientacao:label in frame f-param = trim(return-value).
{utp/ut-liter.i Traduá∆o * r}
assign c-traducao:label in frame f-param = trim(return-value).
{utp/ut-liter.i "Conhecto Master" * r}
assign tt-param.c-master-ini:label in frame f-param  = trim(return-value).
{utp/ut-liter.i "Conhecto House" * r}
assign tt-param.c-house-ini:label in frame f-param = trim(return-value).
{utp/ut-liter.i "Conhecimento Master" * r}
