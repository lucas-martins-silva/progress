{include/i_dbvers.i}
/*******************************************************************
***  
***   IM0664.I2 - Defini‡Æo das Forms
***
*******************************************************************/

form c-lb-eadi                at 01
     tt-embarque-imp.desc-eadi at 06 skip(1)
     with down width 132 no-label no-box stream-io frame f-pto-eadi.
     
form c-lb-quant                at 32
     d-quantidade              at 73 skip(1)
     with down width 132 no-label no-box stream-io frame f-quant.     
     
form c-lb-saldo                at 32
     d-quant-a-nac             at 73 skip(2)
     with down width 132 no-label no-box stream-io frame f-saldo.     
     
form c-lb-item                 at 01
     tt-embarque-imp.it-codigo at 06 
     " - "c-desc-item          at 26
     c-lb-un                   at 104
     tt-embarque-imp.un        at 107 skip(1)
     with down width 132 no-label no-box stream-io frame f-it-codigo.     

form c-lb-processo          at 01
     c-lb-embarque          at 14 
     c-lb-est               at 31
     c-lb-fatura            at 36
     c-lb-dt-vencto         at 49
     c-lb-dt-eadi           at 66 
     c-lb-quantidade        at 87
     c-lb-dt-nacionaliz     at 92
     c-lb-observacao        at 108

     "------------"         at 01
     "----------------"     at 14
     "---"                  at 31
     "------------"         at 36
     "----------------"     at 49
     "------------"         at 66
     "------------"         at 79
     "---------------"      at 92
     "-------------------------" at 108     
     with down width 132 no-label no-box stream-io frame f-lab-cabecalho.

form 
     tt-embarque-imp.nr-proc-imp            at 01
     tt-embarque-imp.embarque               at 14
     tt-embarque-imp.cod-estabel            at 31
     tt-embarque-imp.fatura                 at 36
     tt-embarque-imp.dt-vencim              at 49
     tt-embarque-imp.dt-efetiva-eadi        at 66
     tt-embarque-imp.quantidade             at 77
     tt-embarque-imp.dt-nacionaliz          at 92
     tt-embarque-imp.observacao             at 108
     with down width 132 no-box no-label stream-io frame f-embarque-imp.

form 
/*Sele‡Æo*/
     skip(1)                                   
     c-lb-tit-sel                    no-label skip(1) 
&IF "{&mguni_version}" >= "2.071" &THEN
     tt-param.cod-estabel-ini        format "x(05)" colon 30
&ELSE
     tt-param.cod-estabel-ini        format "x(03)" colon 30
&ENDIF
     "|< >|"                         at 50
&IF "{&mguni_version}" >= "2.071" &THEN
     tt-param.cod-estabel-fim        format "x(05)" no-label
&ELSE
     tt-param.cod-estabel-fim        format "x(03)" no-label
&ENDIF
     tt-param.embarque-ini           format "x(16)" colon 30
     "|< >|"                         at 50
     tt-param.embarque-fim           format "x(16)" no-label
     tt-param.processo-ini           format "x(12)" colon 30
     "|< >|"                         at 50
     tt-param.processo-fim           format "x(12)" no-label
     tt-param.cod-pto-ini            colon 30
     "|< >|"                         at 50
     tt-param.cod-pto-fim            no-label
     tt-param.it-codigo-ini          format "x(16)" colon 30
     "|< >|"                         at 50
     tt-param.it-codigo-fim          format "x(16)" no-label     
     tt-param.dt-efetiva-eadi-ini    colon 30
     "|< >|"                         at 50
     tt-param.dt-efetiva-eadi-fim    no-label     
     tt-param.fatura-ini             format "x(12)" colon 30
     "|< >|"                         at 50
     tt-param.fatura-fim             format "x(12)" no-label     
/*Classifica‡Æo*/
     skip(1)
     c-lb-tit-cla                    no-label skip(1)
     c-classificacao                 colon 30
/*Parƒmetros*/
     skip(1)
     c-lb-tit-par                    no-label skip(1)
     c-considera                     colon 30 skip
     c-lb-opcao                      at 10 no-label

/*impressÆo*/
     skip(1)
     c-lb-tit-imp                    no-label skip(1)
     c-lb-destino                    at 19 no-label ": " 
     tt-param.destino  no-label                   
     " - " 
     tt-param.arquivo                no-label skip 
     c-lb-usuario                    at 19 no-label ": "
     tt-param.usuario                no-label skip(1) 
     with width 132 side-labels frame f-param stream-io.

/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-param:HANDLE).


