
/* Detalhe do embarque */     
DO:
form 
    historico-embarque.sequencia       at 01
    historico-embarque.cod-pto-contr   at 05
    c-descricao                        at 15
    historico-embarque.dt-previsao     at 46 
    historico-embarque.dt-ult-previsao at 57
    historico-embarque.dt-efetiva      at 68
    i-diferenca                        at 79
    historico-embarque.id-meio-transp  at 91 
    with down width 132 no-box stream-io frame f-det-embarque.

/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-det-embarque:HANDLE).

END. 
    
def var c-it-codigo1 like item.it-codigo no-undo.
def var c-descricao1 like item.descricao-1 no-undo.
def var de-preco-unit1 like cotacao-item.preco-unit no-undo.
def var i-mo-codigo1 like moeda.mo-codigo no-undo.
def var i-qtde like ordens-embarque.quantidade no-undo.
def var c-un like cotacao-item.un no-undo.
def var c-un-pc like cotacao-item.un no-undo.
def var c-unqtd as char format "x(55)" no-undo.
def var i-qtde-pc like ordens-embarque.quantidade no-undo.

/* Ordens do embarque */         
form
    ordens-embarque.nr-proc-imp
    ordens-embarque.numero-ordem
    c-it-codigo1
    c-descricao1    
    ordens-embarque.parcela
    i-qtde
    c-un                                 
    i-mo-codigo1
    de-preco-unit1
    i-mo-cotacao                 to 110  column-label "Mo Cotac"
    de-preco-cotac-sem-ipi               column-label "Pre‡o Unit" skip
    with down no-label width 132 no-box stream-io frame f-ord-embarque.

/* Ordens do embarque a partir EMS 2.05*/         
form 
    ordens-embarque.nr-proc-imp
    ordens-embarque.numero-ordem
    c-it-codigo1
    ordens-embarque.parcela
    i-qtde-pc                               
    c-un-pc                                 
    de-peso-liq
    de-peso-bruto
    de-cubagem
    with down no-label width 132 no-box stream-io frame f-ord-embarque-pc.
form 
    c-lb-processo        at 01
    c-lb-ordem           at 18
    c-lb-item            at 24
    c-lb-desc-item       at 41  
    c-lb-parc            at 57
    c-lb-quantidade      AT 65
    c-lb-un              at 77
    c-lb-moeda           at 80
    c-lb-preco-unit      at 88
    c-lb-mo-orig         at 103
    c-lb-preco-orig      at 121 skip
    c-lb-identificacao   at 01  skip
    "------------"
    "---------"
    "----------------"
    "---------------"
    "----"
    "--------------"
    "--"
    "--"
    "-------------------"
    "--------"
    "-------------------"
    with down no-label width 132 no-box stream-io frame f-label-ord-embarque.   
    
form skip (1) 
    c-lb-peso-cub        at 49 skip (1)
    c-lb-processo        at 01
    c-lb-ordem           at 18
    c-lb-item            at 24
    c-lb-parc            at 41 
    c-lb-quantidade      AT 49
    c-lb-un              at 61
    c-lb-peso-liq        at 69
    c-lb-peso-bruto      at 87
    c-lb-cubagem         at 111
    "------------"
    "---------"
    "----------------"
    "----"
    "--------------"
    "--"
    "-------------------"
    "-------------------"
    "--------------------"
    with down no-label width 132 no-box stream-io frame f-label-ord-embarque-pc.   

form 
    "-------------------"   at 64 
    "-------------------"   
    "--------------------"  
    c-lb-tit-tot      at 56
    de-peso-liq-tot   
    de-peso-bruto-tot 
    de-cubagem-tot    
    with down no-label width 132 no-box stream-io frame f-ord-embarque-pc-tot.
def var c-nome-abrev2 like emitente.nome-abrev no-undo.
def var c-descricao2  like desp-imp.descricao no-undo.
def var c-descricao3  like moeda.descricao no-undo.
     
&if "{&BF_DIS_VERSAO_EMS}" >= "2.04" &then

    /* Label das Despesas do Embarque */
    form skip(1)
        c-fornecedor                     at  01
        c-nome-abrev-2                   at  11 format "x(10)"
        c-cod-pto                        at  24
        c-cod-desp                       at  34
        c-descricao-2                    at  42
        c-recebda                        at  73 
        c-cod-pag                        at  78 format "x(4)"
        c-valor-desp                     at  83 format "x(13)"
        c-mo-desp-orig                   at 104 format "x(7)"
        c-valor-desp-orig                at 112 skip 
        "---------"                      at  01
        "------------" 
        "---------" 
        "-------" 
        "------------------------------"
        "----" 
        "----"
        "--------------------" 
        "-------"        
        "--------------------" 
        with down no-label width 132 no-box stream-io frame f-label-embarque.
         
    /* Despesas do embarque */
    form 
        c-cod-emitente-desp              at  01
        c-nome-abrev2                    at  11 format "x(12)"           
        desp-embarque.cod-pto-contr      at  27 format ">>,>>9"          
        desp-embarque.cod-desp           at  35                          
        c-descricao2                     at  42 format "x(30)"           
        c-recebda2                       at  74                          
        desp-embarque.cod-cond-pag       at  79 format ">>9"             
        de-valor-desp-conv               at  83 format ">>,>>>,>>>,>>9.99999"
        desp-embarque.mo-codigo          at 109 format ">9"              
        desp-embarque.val-desp           at 112 format ">>,>>>,>>>,>>9.99999"
        with down width 132 no-labels no-box stream-io frame f-desp-embarque2.
        
    form skip (1)
        c-lb-adic-embarque      at 53 skip
        c-lb-num-adic           at 01
        c-seq-item-ad           at 11
        c-lb-val-tax-siscome    at 23
        c-lb-processo           at 39
        c-lb-ordem              at 52
        c-lb-item               at 63
        c-lb-desc-item          at 80
        c-lb-qtde               at 99
        c-lb-tot-val-tax-sis    at 114 skip
        "---------"
        "-----------"
        "---------------"
        "------------"
        "----------"
        "----------------"
        "------------------"
        "--------------"
        "-------------------" 
        with down no-label width 132 no-box stream-io frame f-label-adicao.
        
    form
        tt-ordens-embarq.i-num-adic          to  09
        tt-ordens-embarq.seq-item-ad         at  11
        tt-ordens-embarq.i-val-tax-siscomex  to  37
        tt-ordens-embarq.nr-proc-imp         to  50
        tt-ordens-embarq.numero-ordem        at  51
        tt-ordens-embarq.it-codigo           at  63
        tt-ordens-embarq.c-descricao         at  80
        tt-ordens-embarq.quantidade          to  112
        i-tot-val-tax-sis                    to  132
        with down width 132 no-label no-box stream-io frame f-adic-embarque.
       
    form
        "-------------------" at 114
        c-lb-total            at 107
        i-tot-por-embarq      to 132
        with down width 132 no-labels no-box stream-io frame f-adic-emb-total.
&else

    /* Label das Despesas do Embarque */
    form 
        skip(1)
        c-fornecedor                     at  01          
        c-nome-abrev-2                   at  11              
        c-cod-pto                        at  24              
        c-cod-desp                       at  34              
        c-descricao-2                    at  42              
        c-cod-pag                        at  73              
        c-valor-desp                     at  83              
        c-mo-desp-orig                   at 104              
        c-valor-desp-orig                at 112 skip         
        "---------"                      at  01              
        "------------"                   at  11
        "---------"                      at  24
        "-------"                        at  34
        "------------------------------" at  42
        "---------"                      at  73
        "--------------------"           at  83
        "-------"                        at 104
        "--------------------"           at 112 
        with down no-label width 132 no-box stream-io frame f-label-embarque.

    /* Despesas do embarque */
    form 
        c-cod-emitente-desp              at 01
        c-nome-abrev2                    at 11
        desp-embarque.cod-pto-contr      at 27
        desp-embarque.cod-desp           at 35
        c-descricao2                     at 42
        desp-embarque.cod-cond-pag       at 79  format ">>9"
        de-valor-desp-conv               at 83  format ">>,>>>,>>>,>>9.99999"
        desp-embarque.mo-codigo          at 109 format ">9"
        desp-embarque.val-desp           at 112 format ">>,>>>,>>>,>>9.99999"
        with down width 132 no-labels no-box stream-io frame f-desp-embarque2.
&endif
     
/* Total das Despesas */
form 
    skip(1)
    tot-de-valor-desp-conv format ">>>>,>>>,>>>,>>9.99999" colon 94
    with down width 132 side-labels no-box stream-io frame f-tot-desp-embarque. 
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-tot-desp-embarque:HANDLE).
   

             
/* Faturas do Embarque */        
form 
    invoice-emb-imp.nr-invoice at 07
    invoice-emb-imp.parcela    at 21
    invoice-emb-imp.dt-vencim  at 26
    de-vl-invoice at 37
    invoice-emb-imp.mo-codigo at 54
    invoice-emb-imp.vl-invoice at 60 column-label "Valor Original"
    with down width 132 no-box stream-io frame f-fat-embarque.

/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-fat-embarque:HANDLE).

   
form 
/*Selecao*/
    skip(1)                                   
    c-sel                                              no-label
    skip(1)
    tt-param.c-est-ini                                 colon 50
    "|< >|"                                      at 73
    tt-param.c-est-fim                                 no-label     
    tt-param.c-embarque-ini                            colon 50
    "|< >|"                                      at 73
    tt-param.c-embarque-fim                            no-label     
    tt-param.c-proc-ini                                colon 50
    "|< >|"                                      at 73
    tt-param.c-proc-fim                                no-label 
    tt-param.i-exp-ini                                 colon 50
    "|< >|"                                      at 73
    tt-param.i-exp-fim                                 no-label
    tt-param.i-itiner-ini                              colon 50
    "|< >|"                                      at 73
    tt-param.i-itiner-fim                              no-label
    &IF "{&BF_MAT_VERSAO_EMS}" >= "2.062" &THEN
       tt-param.iPtoSolicLiIni                         COLON 50
       "|< >|"                                   AT 73
       tt-param.iPtoSolicLiFim                         NO-LABEL
    &ENDIF                                                     
    tt-param.i-pto-emb-ini                             colon 50
    "|< >|"                                      at 73
    tt-param.i-pto-emb-fim                             no-label
    tt-param.i-pto-des-ini                             colon 50
    "|< >|"                                      at 73
    tt-param.i-pto-des-fim                             no-label
    tt-param.i-grupo-ini                               colon 50
    "|< >|"                                      at 73
    tt-param.i-grupo-fim                               no-label
    tt-param.c-fam-ini                                 colon 50
    "|< >|"                                      at 73
    tt-param.c-fam-fim                                 no-label
    tt-param.c-item-ini                                colon 50
    "|< >|"                                      at 73
    tt-param.c-item-fim                                no-label 
    tt-param.c-fatura-ini                              colon 50
    "|< >|"                                      at 73
    tt-param.c-fatura-fim                              no-label 
    &if "{&bf_cex_versao_ems}" >= "2.062" &then
        &if "{&bf_dis_versao_ems}" >= "2.04" &then
            tt-param.nr-conhecto-master-ini                    colon 50 LABEL "Conhecimento Master"
            "|< >|"                                   at 73
            tt-param.nr-conhecto-master-fim                    no-label 
            tt-param.nr-conhecto-house-ini                     colon 50 LABEL "Conhecimento House"
            "|< >|"                                      at 73
            tt-param.nr-conhecto-house-fim                    no-label 
        &endif
    &else
       &IF "{&bf_dis_versao_ems}" >= "2.05" &THEN
           tt-param.nr-conhecto-master-ini                    colon 50 LABEL "Conhecimento Master"
           "|< >|"                                   at 73
           tt-param.nr-conhecto-master-fim                    no-label 
           tt-param.nr-conhecto-house-ini                     colon 50 LABEL "Conhecimento House"
           "|< >|"                                      at 73
           tt-param.nr-conhecto-house-fim                    no-label 
       &ELSE
           tt-param.nr-conhecimento-ini                     colon 50 label "Conhecimento Transp"
           "|< >|"                                      at 73
           tt-param.nr-conhecimento-fim                     no-label 
       &ENDIF   
    &endif
    
    &IF "{&BF_MAT_VERSAO_EMS}" >= "2.062" &THEN
        tt-param.veiculo-transp-ini                      colon 50 label "Veiculo Transp"
        "|< >|"                                      at 73
        tt-param.veiculo-transp-fim                      no-label 
        tt-param.declar-import-ini                       colon 50 label "Declara‡Æo Importa‡Æo" 
        "|< >|"                                      at 73
        tt-param.declar-import-fim                       no-label 
        tt-param.cLicencImportIni                        COLON 50
        "|< >|"                                      AT 73
        tt-param.cLicencImportFim                        NO-LABEL
    &ELSE
        tt-param.declar-import-ini                       colon 50 label "Declara‡Æo Import" 
        "|< >|"                                      at 73
        tt-param.declar-import-fim                       no-label 
        tt-param.veiculo-transp-ini                      colon 50 label "Veiculo Transp"
        "|< >|"                                      at 73
        tt-param.veiculo-transp-fim                      no-label 
    &ENDIF
    c-via-transp-ini                                     colon 50
    "|< >|"                                          at 73
    c-via-transp-fim                                     no-label    
     with width 132 side-labels frame f-param-sel stream-io.

/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-param-sel:HANDLE).

form
   /*parametros*/
   c-par                                                            no-label skip(1)
   i-local                                  colon 50 skip
   tt-param.moeda       colon 50 " - "   c-moeda-desc               no-label skip
   tt-param.dt-cotacao  label "Data Cota‡Æo" colon 50                        skip
   tt-param.da-data-ini colon 50 "|< >|" at 73 tt-param.da-data-fim no-label skip
   c-sit-emb                                colon 50                         skip
   c-atraso                                 colon 50                         skip
   c-situacao                               colon 50                         skip
   c-unqtd              no-label   colon 10                               skip
   tt-param.l-tipo                 colon 50                               skip
   tt-param.l-observacao           colon 50                               skip
   tt-param.l-ordens               colon 50                               skip
   tt-param.l-peso-cub             COLON 50                               skip 
   tt-param.lDetalhaLi             COLON 50                               SKIP
   tt-param.l-desp                 colon 50                               skip
   c-detalhe-desp no-label         colon 50                               skip
   tt-param.l-detalha-desp         colon 50 label "Detalha Dados das Despesas" skip
   tt-param.l-adic-embarq          colon 50                               skip
   tt-param.lantecipacao           colon 50                               skip(1)
   /*impressao*/
   c-imp               no-label                                          skip(1)
   c-destino                      colon 50 "-" tt-param.arquivo no-label skip
   tt-param.usuario               colon 50                               skip
   with width 132 side-labels frame f-param-antecip stream-io.


/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-param-antecip:HANDLE).
   
form
    /*parametros*/
    c-par                                                            no-label skip(1)
    i-local                                  colon 50 skip
    tt-param.moeda       colon 50 " - "   c-moeda-desc               no-label skip
    tt-param.dt-cotacao  label "Data Cota‡Æo" colon 50                        skip
    tt-param.da-data-ini colon 50 "|< >|" at 73 tt-param.da-data-fim no-label skip
    c-sit-emb                                colon 50                         skip
    c-atraso                                 colon 50                         skip
    c-situacao                               colon 50                         skip
    c-unqtd              no-label   colon 10                               skip
    tt-param.l-tipo                 colon 50                               skip
    tt-param.l-observacao           colon 50                               skip
    tt-param.l-ordens               colon 50                               skip
    tt-param.l-peso-cub             COLON 50                               skip 
    tt-param.lDetalhaLi             COLON 50                               SKIP
    tt-param.l-desp                 colon 50                               skip
    c-detalhe-desp no-label         colon 50                               skip
    tt-param.l-detalha-desp         colon 50 label "Detalha Dados das Despesas" skip
    tt-param.l-adic-embarq          colon 50                               skip(1)
    /*impressao*/
    c-imp               no-label                                          skip(1)
    c-destino                      colon 50 "-" tt-param.arquivo no-label skip
    tt-param.usuario               colon 50                               skip
    with width 132 side-labels frame f-param stream-io.


/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-param:HANDLE).


form c-lb-tipo-desp    at 42 c-tipo-desp    format "x(21)" at 56
     c-lb-incoterm-rat at 78 c-incoterm-rat format "x(3)"  at 98
     with down width 132 no-labels no-box stream-io frame f-detalha-desp.
     
&IF "{&BF_MAT_VERSAO_EMS}" >= "2.062" &THEN
    FORM 
        skip(2)
        c-li                 at 40 
        skip(1)
        c-lb-processo        at 01
        c-lb-ordem           at 14
        c-lb-item            at 25
        c-lb-parc            at 41
        c-lb-sit-parc        at 47
        c-lb-class-fiscal    at 67
        c-lb-nec-li          at 88
        c-lb-nr-li           at 101 
        "------------"       at 01
        "---------"
        "----------------"
        "-----"
        "-------------------"
        "--------------------"
        "------------"
        "--------------------" skip
        with down no-label width 132 no-box stream-io frame f-label-licenc-import.
        
    form
        ordens-embarque.nr-proc-imp         
        ordens-embarque.numero-ordem        
        c-it-codigo1                        
        tt-licenc-import.parcela                
        tt-licenc-import.sit-parcela        
        c-lb-class-fiscal               
        item.log-necessita-li
        tt-licenc-import.licenca-import
        with down no-label width 132 no-box stream-io frame f-licenc-import.
&ENDIF

form 
     skip(2)
     c-antecip               at 40 
     skip(1)
     c-lb-id                 at 01
     c-lb-est-ap             at 15 
     c-lb-espec-ap           at 22
     c-lb-serie-ap           at 31 
     c-lb-titulo-ap          at 41 
     c-lb-parc-ap            at 52 
     c-lb-refer-ap           at 55
     c-lb-fornec-ap          at 73
     c-lb-nome-abrev-ap      at 84
     c-lb-moeda-ap           at 100
     c-lb-data-trans-ap      at 109
     
     c-lb-saldo-tit-ap       at 06
     c-lb-vl-orig-ap         at 24
     c-lb-cotac-tit-ap       at 44
     c-lb-vl-vinc-emb        at 68
     c-lb-dtm-criac          at 89
     c-lb-usuar-criac        at 110
     
     c-lb-serie-docto        at 01
     c-lb-nro-docto          at 07
     c-lb-emitente           at 24
     c-lb-nome-abrev         at 34
     c-lb-nat-oper           at 49
     c-lb-vl-cotac           at 59
     c-lb-dat-cotac          at 79
     c-lb-vl-ifric22         at 101  skip
     "-----------------------------------------------------------------------------------------------------------------------------------":U skip
with down no-label width 132 no-box stream-io frame f-lbl-antecip.
RUN utp/ut-trfrrp.p (INPUT FRAME f-lbl-antecip:HANDLE).

form 
    antecip-import.cdd-id-antecip             at 01  
    antecip-import.cod-estab-ap               at 15  
    antecip-import.cod-espec-docto-ap         at 22  
    antecip-import.cod-ser-docto-ap           at 31  
    antecip-import.cod-tit-ap                 at 41  
    antecip-import.cod-parc-ap                at 52  
    antecip-import.cod-refer-antecip-ap       at 55  
    antecip-import.cdn-emitente-ap            at 73  
    antecip-import.nom-abrev-ap               at 84  
    antecip-import.cod-moed-ap                at 100 
    antecip-import.dat-transacao              at 109 
    antecip-import.val-sdo-tit-ap             at 03 
    antecip-import.val-origin-tit-ap          at 26  
    antecip-import.val-cotac-tit              at 44
    antecip-import.val-vinc-embarq            at 72  
    antecip-import.dtm-criac                  at 89  format "99/99/9999 HH:MM:SS":U
    antecip-import.cod-usuar-criac            at 110 
    antecip-import.serie-docto                at 01 
    antecip-import.nro-docto                  at 07 
    antecip-import.cdn-emitente               at 24 
    c-nome-abrev-docto                        at 34
    antecip-import.nat-operacao               at 49 
    antecip-import.val-cotac-nacionaliz       at 59 
    antecip-import.dat-cotac-nacionaliz       at 79
    de-valor-ifric22                          at 100 format "->>>,>>>,>>9.99"
    
with down no-label width 132 no-box stream-io frame f-antecip.
RUN utp/ut-trfrrp.p (INPUT FRAME f-antecip:HANDLE).
                
