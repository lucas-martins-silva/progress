/************************************************************************
**
** IM7777.I1 - Include de defini»’o da tabela temporÿria.
**
************************************************************************/
{cdp/cdcfgmat.i}
def temp-table tt-nota no-undo          
    field cod-emitente             like docum-est.cod-emitente
    field cod-estabel              like docum-est.cod-estabel  
    field dt-emissao               like docum-est.dt-emissao
    field dt-trans                 like docum-est.dt-trans
    field dt-venc-icm              like docum-est.dt-venc-icm
    field dt-venc-ipi              like docum-est.dt-venc-ipi
    field estab-fisc               like docum-est.estab-fisc
    field nat-operacao             like docum-est.nat-operacao
    field nro-docto                like docum-est.nro-docto
    field serie-docto              like docum-est.serie-docto
    field observacao               like docum-est.observacao
    field usuario                  like docum-est.usuario
    field tot-desconto             like docum-est.tot-desconto
    field embarque                 like ordens-embarque.embarque
    field ct-transit               like docum-est.ct-transit
    field sc-transit               like docum-est.sc-transit
    field pais-impto-usuario       as   integer
    field ph-acomp                 as   handle    
    field pl-acomp                 as   logical
    field da-cotacao               like docum-est.dt-emissao
    field via-transp               like docum-est.via-transp
    field cotacao-dia              as   decimal format ">>>,>9.99999999"
    field cod-pto-contr-base       like pto-contr.cod-pto-contr
    field cod-itiner               like itinerario.cod-itiner
    field mo-codigo                like moeda.mo-codigo
    field cod-cond-pag             like cond-pagto.cod-cond-pag
    field l-icms-diferido          as   logical
    field l-nf-ajuste              as   logical
    field l-nf-simples-remessa     as   logical
    field idi-nf-simples-remes     as   integer 
    field l-gera-prim-nf-remes-mae as   logical         
    field ct-codigo	           as char format "x(20)":U
    field sc-codigo		   as char format "x(20)":U
    field d-cotacao                as   dec
    index codigo is unique primary
        serie-docto
        nro-docto
        cod-emitente
        nat-operacao.
     
def temp-table tt-itens no-undo
    field numero-ordem          like ordens-embarque.numero-ordem 
    field parcela               like ordens-embarque.parcela
    field seq                   as   integer
    field sequencia             as   integer    
    field it-codigo             like item.it-codigo
    field nr-proc-imp           like ordens-embarque.nr-proc-imp    
    field quantidade            like ordens-embarque.quantidade
    field lote                  like item-doc-est.lote           
    field dt-vali-lote          like item-doc-est.dt-vali-lote
    field cod-refer             like item-doc-est.cod-refer
    field encerra-pa            like item-doc-est.encerra-pa
    field seq-aux               as   integer
    field class-fiscal          like classif-fisc.class-fiscal
    field nat-fiscal            like natur-oper.nat-operacao
    field nr-ato-concessorio    as   char                         format "x(20)"
    field preco-unit            like item-doc-est.preco-unit  extent 0
    field preco-total           like item-doc-est.preco-total extent 0
    field preco-unit-mo         like item-doc-est.preco-unit  extent 0
    field preco-total-mo        like item-doc-est.preco-total extent 0
    field desconto              like item-doc-est.desconto    extent 0
    field num-pedido            like pedido-compr.num-pedido
    field tp-despesa            like ordem-compra.tp-despesa
    field cod-depos             like ordem-compra.dep-almoxar
    FIELD peso-bruto            AS   DECIMAL FORMAT ">>>,>>>,>>9.99999"
    FIELD peso-liquido          AS   DECIMAL FORMAT ">>>,>>>,>>9.99999"
    &if '{&bf_mat_versao_ems}' >= '2.05' &then
        &if '{&bf_mat_versao_ems}' >= '2.062' &then
            field val-cub-tot   as dec format ">>>>>,>>>,>>9.999999"
            &if '{&bf_lote_avancado_liberado}' = 'yes' &then /*Campos Projeto FDA*/
                field cod-lote-fabrican             like item-doc-est.cod-lote-fabrican
                field dat-fabricc-lote              like item-doc-est.dat-fabricc-lote
                field dat-valid-lote-fabrican       like item-doc-est.dat-valid-lote-fabrican
                field nom-fabrican                  like item-doc-est.nom-fabrican
            &ENDIF
        &else
            field val-cub-uni   as dec format ">>>>>,>>>,>>9.999999"
        &endif    
    &endif
    FIELD cd-trib-ii            AS   INTEGER
    FIELD cd-trib-ipi           AS   INTEGER
    FIELD cd-trib-icms          AS   INTEGER
    FIELD aliquota-ii           AS   DECIMAL FORMAT ">>9.9999"
    FIELD aliquota-ipi          AS   DECIMAL FORMAT ">>9.99"
    FIELD aliquota-icms         AS   DECIMAL FORMAT ">>9.99"
    FIELD l-ordens-embarque     AS   LOGICAL
    FIELD l-regime              AS   LOGICAL INITIAL NO

    /******************************************************
    * Engenharia IPI Suspensao Incorporar Base PIS COFINS *
    ******************************************************/
    &IF DEFINED(bf-mat-comex) &THEN
    &ELSE
        FIELD suspensao-II  AS LOGICAL
        FIELD suspensao-IPI AS LOGICAL
    &ENDIF
    field l-gera-prim-nf-remes-mae as logical
    field nro-comp              like item-doc-est.nro-comp
    field nat-comp              like item-doc-est.nat-comp
    field serie-comp            like item-doc-est.serie-comp
    field seq-comp              like item-doc-est.seq-comp
    index codigo is unique
        numero-ordem
        parcela
        seq.
        
DEFINE TEMP-TABLE tt-tot-desp-mo NO-UNDO 
        FIELD mo-codigo         LIKE dupli-apagar-cex.mo-codigo
        FIELD tot-vl-a-pagar    LIKE dupli-apagar.vl-a-pagar 
        FIELD tot-vl-a-pagar-mo LIKE dupli-apagar.vl-a-pagar.
        
/* IM7777.I1 */
