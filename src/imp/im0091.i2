/**                                                                              **
**  Programa: imp/im0091.i2                                                      **
**  Objetivo: Validacoes das despesas do embarque. Criada p/ nao duplicar codigo **
**                                                                               **/    

    find desp-imp
        where desp-imp.cod-desp = desp-embarque.cod-desp no-lock no-error.
    if  not avail desp-imp then
        next.
    
    if  not desp-imp.inc-val-frete and 
        not desp-imp.inc-val-seguro and
        not desp-imp.inc-val-embal and
        not desp-imp.inc-val-outras-desp then
        next.           
    
    if  not p-agrupar-unico-forn
    and desp-embarque.cod-emitente-desp <> p-cod-emitente-desp then 
        next.          
        
    if  desp-embarque.cod-desp = i-cod-desp-ii then 
        assign l-cod-desp-ii = yes.
    
    find historico-embarque 
        where historico-embarque.cod-estabel   = embarque-imp.cod-estabel
        and historico-embarque.embarque        = embarque-imp.embarque
        and historico-embarque.cod-itiner      = i-cod-itiner
        and historico-embarque.cod-pto-contr   = desp-embarque.cod-pto-contr no-lock no-error.
    if  not avail historico-embarque
    or  (historico-embarque.sequencia <= tt-itiner-emb.i-seq-pto-desemb)
    or  (historico-embarque.dt-efetiva = ?) then
        next.

/** im0091.i2 **/
