    FIELD contrato-cambio               LIKE processo-imp.contrato-cambio
    FIELD via-transp                    LIKE processo-imp.via-transp
    FIELD situacao                      LIKE processo-imp.situacao
    FIELD nome-estabel                  LIKE estabelec.nome
    FIELD des-itiner                    LIKE itinerario.descricao
    FIELD nome-ab-transp                LIKE transporte.nome-abrev
    FIELD nome-corretor-cambio          LIKE emitente.nome-abrev
    FIELD nome-despa-exter              LIKE emitente.nome-abrev
    FIELD nome-segurad                  LIKE emitente.nome-abrev
    FIELD nome-corretor	                LIKE emitente.nome-abrev
    FIELD nome-despachante              LIKE emitente.nome-abrev
    FIELD nome-consignatario            LIKE emitente.nome-abrev
    FIELD nome-agente                   LIKE emitente.nome-abrev
