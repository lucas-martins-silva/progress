/* Temp-Tables Dados */

/* Pedido de Compra */
DEFINE TEMP-TABLE tt-pedido-compr NO-UNDO
    FIELD num-pedido     LIKE pedido-compr.num-pedido
    FIELD cod-emitente   LIKE pedido-compr.cod-emitente
    FIELD cod-estabel    LIKE pedido-compr.cod-estabel
    FIELD data-pedido    LIKE pedido-compr.data-pedido
    FIELD situacao       LIKE pedido-compr.situacao
    FIELD cod-emit-terc  LIKE pedido-compr.cod-emit-terc
    FIELD nr-processo    LIKE pedido-compr.nr-processo
    FIELD cod-transp     LIKE pedido-compr.cod-transp
    FIELD cod-cond-pag   LIKE pedido-compr.cod-cond-pag
    FIELD responsavel    LIKE pedido-compr.responsavel
    FIELD nr-contrato    LIKE pedido-compr.nr-contrato
    FIELD via-transp     LIKE pedido-compr.via-transp
    FIELD nome-estabel   LIKE estabelec.nome
    FIELD nome-ab-terc   LIKE emitente.nome-abrev
    FIELD nome-ab-transp LIKE transporte.nome-abrev
    FIELD des-cond-pag   LIKE cond-pagto.descricao
    FIELD des-via-transp AS CHARACTER
    FIELD r-rowid        AS ROWID
    INDEX numero AS PRIMARY UNIQUE
          num-pedido.

