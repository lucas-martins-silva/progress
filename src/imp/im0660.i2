/* Vari veis e literais  tt-pd-fecha-camb */

def var c-lit-cod-estabel-fecCambio         as char no-undo.
def var c-lit-embarque-fecCambio            as char no-undo.
def var c-lit-nr-invoice-fecCambio          as char no-undo.
def var c-lit-parcela-fecCambio             as char no-undo.
def var c-lit-mo-desc-fecCambio             as char no-undo.
def var c-lit-vl-desp-fecCambio             as char no-undo.
def var c-lit-des-meio-transp-fecCambio     as char no-undo.
def var c-lit-vl-merc-fecCambio             as char no-undo.
def var c-lit-vl-total-fecCambio            as char no-undo.
def var c-lit-dt-embarque-fecCambio         as char no-undo.
def var c-lit-dt-nacionaliz-fecCambio       as char no-undo.
def var c-lit-cotacao-ped-fecCambio         as char no-undo.
def var c-lit-cod-aba                       as char no-undo.
def var c-lit-ped-fecCambio                 as char no-undo.
def var c-lit-corretor-cambio               as char no-undo.
def var c-lit-condicao-pagamento            as char no-undo.
def var c-lit-dados-deposito                as char no-undo.
def var c-lit-agencia                       as char no-undo.

{utp/ut-field.i mgcex invoice-emb-imp cod-estabel 1}
assign c-lit-cod-estabel-fecCambio = trim(return-value).

{utp/ut-field.i mgcex invoice-emb-imp embarque 1}
assign c-lit-embarque-fecCambio = trim(return-value).

{utp/ut-field.i mgcex invoice-emb-imp nr-invoice 1}
assign c-lit-nr-invoice-fecCambio = trim(return-value).

{utp/ut-field.i mgcex invoice-emb-imp parcela 1}
assign c-lit-parcela-fecCambio = trim(return-value).

{utp/ut-field.i mguni moeda descricao 1}
assign c-lit-mo-desc-fecCambio = trim(return-value).

{utp/ut-field.i mgcex emitente-cex cod-aba 1}
assign c-lit-cod-aba = trim(return-value).

{utp/ut-liter.i Valor_Despesas * L}
assign c-lit-vl-desp-fecCambio = trim(return-value).

{utp/ut-liter.i Meio_Transporte * L}
assign c-lit-des-meio-transp-fecCambio = trim(return-value).

{utp/ut-liter.i  Valor_Mercadoria * L}
assign c-lit-vl-merc-fecCambio = trim(return-value).

{utp/ut-liter.i Valor_Total * L}
assign c-lit-vl-total-fecCambio = trim(return-value).

{utp/ut-liter.i Data_Embarque * L}
assign c-lit-dt-embarque-fecCambio = trim(return-value).

{utp/ut-liter.i Data_Nacionaliza‡Æo * L}
assign c-lit-dt-nacionaliz-fecCambio = trim(return-value).

{utp/ut-liter.i COTA€ÇO_PARA_FECHAMENTO_DE_C¶MBIO * L}
assign c-lit-cotacao-ped-fecCambio = trim(return-value).

{utp/ut-liter.i PEDIDO_DE_FECHAMENTO_DE_C¶MBIO * L}
assign c-lit-ped-fecCambio = trim(return-value).

{utp/ut-liter.i Corretor_Cƒmbio * L}
assign c-lit-corretor-cambio = trim(return-value).

{utp/ut-liter.i Condi‡Æo_de_Pagamento * L}
assign c-lit-condicao-pagamento = trim(return-value).

{utp/ut-liter.i Dados_para_dep¢sito * L}
assign c-lit-dados-deposito = trim(return-value).

{utp/ut-liter.i Agˆncia * L}
assign c-lit-agencia = trim(return-value).

PROCEDURE pi-traduz-literais-pd-fecha-camb:

    RUN pi-Traducao (INPUT-OUTPUT c-lit-cod-estabel-fecCambio).
    RUN pi-Traducao (INPUT-OUTPUT c-lit-embarque-fecCambio).
    RUN pi-Traducao (INPUT-OUTPUT c-lit-nr-invoice-fecCambio).
    RUN pi-Traducao (INPUT-OUTPUT c-lit-parcela-fecCambio).            
    RUN pi-Traducao (INPUT-OUTPUT c-lit-mo-desc-fecCambio).
    RUN pi-Traducao (INPUT-OUTPUT c-lit-vl-desp-fecCambio).
    RUN pi-Traducao (INPUT-OUTPUT c-lit-des-meio-transp-fecCambio).
    RUN pi-Traducao (INPUT-OUTPUT c-lit-vl-merc-fecCambio).          
    RUN pi-Traducao (INPUT-OUTPUT c-lit-vl-total-fecCambio).
    RUN pi-Traducao (INPUT-OUTPUT c-lit-dt-embarque-fecCambio).
    RUN pi-Traducao (INPUT-OUTPUT c-lit-dt-nacionaliz-fecCambio).
    RUN pi-Traducao (INPUT-OUTPUT c-lit-cotacao-ped-fecCambio).
    RUN pi-Traducao (INPUT-OUTPUT c-lit-ped-fecCambio).
    RUN pi-Traducao (INPUT-OUTPUT c-lit-corretor-cambio).
    RUN pi-Traducao (INPUT-OUTPUT c-lit-condicao-pagamento).
    RUN pi-Traducao (INPUT-OUTPUT c-lit-dados-deposito).
    RUN pi-Traducao (INPUT-OUTPUT c-lit-agencia).
    
END PROCEDURE.

/* Vari veis e literais  tt-invoice */
def var c-lit-mo-desc-inv         as char no-undo.

{utp/ut-field.i mguni moeda descricao 1}
assign c-lit-mo-desc-inv = trim(return-value).

/* Vari veis e literais  tt-pedido */
def var c-lit-desc-cond-pagto-ped as char no-undo.

{utp/ut-field.i mgadm cond-pagto descricao 1}
assign c-lit-desc-cond-pagto-ped = trim(return-value).



