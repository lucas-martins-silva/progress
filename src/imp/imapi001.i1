/*******************************************************************************
**
**  IMAPI001.i1 - Cria automaticamente despesas para o mapa de cotacao(cotacao-item-cex) de 
**                acordo com as despesas cadastradas para o item, itinerario e
**                incoterm
**
*******************************************************************************/
{cdp/cdcfgmat.i} /* Pr‚-processador de importa‡Æo */

/****************** Definicao Tabelas Temporarias ******************************/
{imp/imapi001.i}
        
&if '{&bf_mat_versao_ems}' >= '2.062' &then
    {cdp/cdapi020.i}
    {imp/imapi006.i}  /** defini‡äes de temp-tables  **/
&endif

/****************** Definicao Parametros **************************************/
def input  parameter table for tt-cotacao-im001.
def output parameter table for tt-despesas-im001.
def output parameter table for tt-erro-im001.

/****************** Definicao Vari veis ****************************************/
def var i-seq               as integer init 0      no-undo.
def var d-valor-despesa     as decimal             no-undo.
def var l-despesas-inclusas as logical initial yes no-undo.
DEF VAR l-nt2024002         AS LOGICAL             NO-UNDO.

/****************** Execucao ***************************************************/

ASSIGN l-nt2024002 = CAN-FIND(FIRST funcao NO-LOCK
                              WHERE funcao.cd-funcao = "spp-NT2024002" AND funcao.ativo).

find first tt-cotacao-im001 no-error.

if tt-cotacao-im001.cod-versao-integracao <> 2 then do:
    run utp/ut-msgs.p (input "msg",
                       input 3941,
                       input "").
    create tt-erro-im001.
    assign tt-erro-im001.i-sequen = 1
           tt-erro-im001.cd-erro  = 3941
           tt-erro-im001.mensagem = return-value.    
    return.           
end.

/* Verifica Emitente */
create tt-emitente-im001.
assign tt-emitente-im001.cod-emitente = tt-cotacao-im001.cod-emitente.
find emitente-cex where emitente-cex.cod-emitente = tt-cotacao-im001.cod-emitente no-lock no-error.
if avail emitente-cex then do:
    assign tt-emitente-im001.despesas-inclusas = emitente-cex.log-1.
end.

/* Despesas do Item */
for each desp-item where desp-item.it-codigo  = tt-cotacao-im001.it-codigo and
                         desp-item.cod-itiner = tt-cotacao-im001.cod-itiner no-lock:
    run createDespesa (input desp-item.cod-desp,
                       input desp-item.cod-pto-contr,
                       &if '{&bf_mat_versao_ems}' >= '2.062' &then
                           input tt-cotacao-im001.cod-itiner,
                           input tt-cotacao-im001.cod-incoterm,
                       &endif
                       input no).
end.

/* Procura por Despesas do Item com Itinerario 0 */
if not can-find(first desp-item where desp-item.it-codigo  = tt-cotacao-im001.it-codigo and
                                      desp-item.cod-itiner = tt-cotacao-im001.cod-itiner) then
    for each desp-item where desp-item.it-codigo  = tt-cotacao-im001.it-codigo and
                             desp-item.cod-itiner = 0 no-lock:
        run createDespesa(input desp-item.cod-desp,
                          input desp-item.cod-pto-contr,
                          &if '{&bf_mat_versao_ems}' >= '2.062' &then
                              input tt-cotacao-im001.cod-itiner,
                              input tt-cotacao-im001.cod-incoterm,
                          &endif    
                          input no).
    end.

/* Despesas do Itinerario */
for each desp-itiner where desp-itiner.cod-itiner = tt-cotacao-im001.cod-itiner no-lock:
    run createDespesa(input desp-itiner.cod-desp,
                      input desp-itiner.cod-pto-contr,
                      &if '{&bf_mat_versao_ems}' >= '2.062' &then
                          input tt-cotacao-im001.cod-itiner,
                          input tt-cotacao-im001.cod-incoterm,
                      &endif
                      input no).  
end.

/* Despesas do Incoterm */
if not tt-emitente-im001.despesas-inclusas then 
    for each desp-incoterm where desp-incoterm.cod-incoterm = tt-cotacao-im001.cod-incoterm no-lock:
        run createDespesa (input desp-incoterm.cod-desp,
                           input 0,
                           &if '{&bf_mat_versao_ems}' >= '2.062' &then
                               input tt-cotacao-im001.cod-itiner,
                               input tt-cotacao-im001.cod-incoterm,
                           &endif    
                           input no).
    end.    
    
&if '{&bf_mat_versao_ems}':U >= '2.062':U &then
for first ordem-compra
    where ordem-compra.numero-ordem = tt-cotacao-im001.numero-ordem no-lock: end.
if  avail ordem-compra then do:
    /* Despesas Referente a Impostos */
    find first param-imp 
         where param-imp.cod-estabel = ordem-compra.cod-estabel no-lock no-error.
    if  avail param-imp then do:

        for first itinerario fields (pto-desembarque)
            where itinerario.cod-itiner = tt-cotacao-im001.cod-itiner no-lock: end.
           
        if  param-imp.log-cotac-autom-impto-import then
            run createDespesa (input int(substr(param-imp.char-1,21,20)),
                               input itinerario.pto-desembarque,
                               &if '{&bf_mat_versao_ems}' >= '2.062' &then
                                   input tt-cotacao-im001.cod-itiner,
                                   input tt-cotacao-im001.cod-incoterm,
                               &endif
                               input no).

        if  param-imp.log-cotac-autom-ipi then 
            run createDespesa (input param-imp.cdn-despes-impto-ipi,
                               input itinerario.pto-desembarque,
                               &if '{&bf_mat_versao_ems}' >= '2.062' &then
                                   input tt-cotacao-im001.cod-itiner,
                                   input tt-cotacao-im001.cod-incoterm,
                               &endif
                               input no).

        if  param-imp.log-cotac-autom-pis then
            run createDespesa (input param-imp.cdn-despes-impto-pis,
                               input itinerario.pto-desembarque,
                               &if '{&bf_mat_versao_ems}' >= '2.062' &then
                                   input tt-cotacao-im001.cod-itiner,
                                   input tt-cotacao-im001.cod-incoterm,
                               &endif
                               input no).

        if  param-imp.log-cotac-autom-cofins then
            run createDespesa (input param-imp.cdn-despes-impto-cofins,
                               input itinerario.pto-desembarque,
                               &if '{&bf_mat_versao_ems}' >= '2.062' &then
                                   input tt-cotacao-im001.cod-itiner,
                                   input tt-cotacao-im001.cod-incoterm,
                               &endif
                               input no).

        if  param-imp.log-cotac-autom-icms then
            run createDespesa (input param-imp.cdn-despes-impto-icms,
                               input itinerario.pto-desembarque,
                               &if '{&bf_mat_versao_ems}' >= '2.062' &then
                                   input tt-cotacao-im001.cod-itiner,
                                   input tt-cotacao-im001.cod-incoterm,
                               &endif
                               input no).
    end.
        
    if l-nt2024002 then do:
        find first param-imp-trib 
             where param-imp-trib.cod-estabel = ordem-compra.cod-estabel no-lock no-error.
        if avail param-imp-trib then do:
            if  param-imp-trib.log-cotac-autom-CBS then
                run createDespesa (input param-imp-trib.cdn-despes-impto-CBS,
                                   input itinerario.pto-desembarque,
                                   &if '{&bf_mat_versao_ems}' >= '2.062' &then
                                       input tt-cotacao-im001.cod-itiner,
                                       input tt-cotacao-im001.cod-incoterm,
                                   &endif
                                   input no).
                                   
            if  param-imp-trib.log-cotac-autom-IBSUF then
                run createDespesa (input param-imp-trib.cdn-despes-impto-IBSUF,
                                   input itinerario.pto-desembarque,
                                   &if '{&bf_mat_versao_ems}' >= '2.062' &then
                                       input tt-cotacao-im001.cod-itiner,
                                       input tt-cotacao-im001.cod-incoterm,
                                   &endif
                                   input no).
                                   
            if  param-imp-trib.log-cotac-autom-IBSMun then
                run createDespesa (input param-imp-trib.cdn-despes-impto-IBSMun,
                                   input itinerario.pto-desembarque,
                                   &if '{&bf_mat_versao_ems}' >= '2.062' &then
                                       input tt-cotacao-im001.cod-itiner,
                                       input tt-cotacao-im001.cod-incoterm,
                                   &endif
                                   input no).

            if  param-imp-trib.log-cotac-autom-IS then
                run createDespesa (input param-imp-trib.cdn-despes-impto-IS,
                                   input itinerario.pto-desembarque,
                                   &if '{&bf_mat_versao_ems}' >= '2.062' &then
                                       input tt-cotacao-im001.cod-itiner,
                                       input tt-cotacao-im001.cod-incoterm,
                                   &endif
                                   input no).
        end.
    end.
end.
&endif
    
{imp/imapi001.i2} /* Procedure Create Despesas - createDespesa */

