/*
** 
** IM9025.I2 - Calcula quantidade disponivel do Fornecedor para embarque de determinada ordem
** 
*/

procedure pi-calculaQtdeDisponivelFornec:
/*
** Calculo do saldo disponivel para Embarque da ordem requisitada
*/
def input  parameter p-numero-ordem like ordem-compra.numero-ordem no-undo.
def output parameter de-quant-disp  like prazo-compra.qtd-do-forn  no-undo.

def var de-quant-ordem  like prazo-compra.qtd-do-forn no-undo.
def var de-quant-embarq like prazo-compra.qtd-do-forn no-undo.

for each prazo-compra fields(qtd-sal-forn parcela qtd-do-forn) where
  &if defined(bf-mat-comex) &then
    prazo-compra.situacao = "C" and
  &else
    prazo-compra.situacao = 2   and
  &endif
    prazo-compra.numero-ordem = p-numero-ordem no-lock:
    
    assign de-quant-ordem = de-quant-ordem + /*prazo-compra.qtd-sal-forn*/ prazo-compra.qtd-do-forn.
    
    for each ordens-embarque fields(qt-do-forn)
        where ordens-embarque.numero-ordem = p-numero-ordem
        and   ordens-embarque.parcela      = prazo-compra.parcela no-lock:
        assign de-quant-embarq = de-quant-embarq + ordens-embarque.qt-do-forn.
    end.    
end.

assign de-quant-disp = de-quant-ordem - de-quant-embarq.


end procedure.

/* IM9025.I2 */
