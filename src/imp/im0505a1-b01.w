&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE disable_UI B-table-Win _DEFAULT-DISABLE
PROCEDURE disable_UI :
/*------------------------------------------------------------------------------
  Purpose:     DISABLE the User Interface
  Parameters:  <none>
  Notes:       Here we clean-up the user-interface by deleting
               dynamic widgets we have created and/or hide 
               frames.  This procedure is usually called when
               we are ready to "clean-up" after running.
------------------------------------------------------------------------------*/
  /* Hide all frames. */
  HIDE FRAME F-Main.
  IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-open-query B-table-Win 
PROCEDURE local-open-query :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

for each tt-cotac-cex exclusive-lock:
  delete tt-cotac-cex.
end.  
     
for each b-cotacao-item-cex where 
    b-cotacao-item-cex.numero-ordem = cotacao-item-cex.numero-ordem and
    b-cotacao-item-cex.cod-emitente = cotacao-item-cex.cod-emitente and
    b-cotacao-item-cex.it-codigo    = cotacao-item-cex.it-codigo    and
    b-cotacao-item-cex.seq-cotac    = cotacao-item-cex.seq-cotac    and
    b-cotacao-item-cex.mapa-cotacao = cotacao-item-cex.mapa-cotacao and
    b-cotacao-item-cex.cod-incoterm = cotacao-item-cex.cod-incoterm and
    b-cotacao-item-cex.cod-itiner   = cotacao-item-cex.cod-itiner no-lock:        
    create tt-cotac-cex.
    assign tt-cotac-cex.sequencia         = b-cotacao-item-cex.sequencia
           tt-cotac-cex.cod-desp          = b-cotacao-item-cex.cod-desp
           tt-cotac-cex.cod-emitente-desp = b-cotacao-item-cex.cod-emitente-desp
           tt-cotac-cex.val-desp          = b-cotacao-item-cex.val-desp
           tt-cotac-cex.cod-cond-pag      = b-cotacao-item-cex.cod-cond-pag.
    find desp-imp where 
          desp-imp.cod-desp = b-cotacao-item-cex.cod-desp no-lock no-error. 
       if avail desp-imp then
          assign tt-cotac-cex.descricao = desp-imp.descricao.                                         
end.                   

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'open-query':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

END PROCEDURE.

