PROCEDURE GeraCampos:

    define variable cNomeCampo as character no-undo.

    /***   Embarque   ***/
    /* Inicio -- Projeto Internacional */
    {utp/ut-liter.i "Gera_Valores_Embarque" *}
    RUN pi-acompanhar in h-acomp (RETURN-VALUE).
    ASSIGN hTable  = BUFFER tt-embarque:HANDLE
           prefixo = "#emb-".
    RUN substitui-valores.
    
    /***   Processo   ***/   
    /* Inicio -- Projeto Internacional */
    {utp/ut-liter.i "Gera_Valores_Processo" *}
    RUN pi-acompanhar in h-acomp (RETURN-VALUE).
    ASSIGN hTable  = BUFFER tt-processo:HANDLE
           prefixo = "#proc-".
    RUN substitui-valores.

    /***   Pedido   ***/
    /* Inicio -- Projeto Internacional */
    {utp/ut-liter.i "Gera_Valores_Pedido" *}
    RUN pi-acompanhar in h-acomp (RETURN-VALUE).
    ASSIGN hTable  = BUFFER tt-pedido:HANDLE
           prefixo = "#ped-".
    RUN substitui-valores.

    /***   CondPagto   ***/
    /* Inicio -- Projeto Internacional */
    {utp/ut-liter.i "Gera_Valores_Condi‡Æo_Pagamento" *}
    RUN pi-acompanhar in h-acomp (RETURN-VALUE).
    ASSIGN hTable  = BUFFER tt-cond-pagto:HANDLE
           prefixo = "#cond-pagto-".
    RUN substitui-valores.

    /***   Banco   ***/
    FIND FIRST tt-banco NO-ERROR.
    IF AVAIL tt-banco THEN DO:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "Gera_Valores_Banco" *}
        RUN pi-acompanhar in h-acomp (RETURN-VALUE).
        ASSIGN hTable  = BUFFER tt-banco:HANDLE
               prefixo = "#bco-".
        RUN substitui-valores.
    END.

    /***   BcoExp   ***/
    FIND FIRST tt-bco-Exp NO-ERROR.
    IF AVAIL tt-bco-Exp THEN DO:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "Gera_Valores_Bco-Exp" *}
        RUN pi-acompanhar in h-acomp (RETURN-VALUE).
        ASSIGN hTable  = BUFFER tt-bco-exp:HANDLE
               prefixo = "#bco-exp-".
        RUN substitui-valores.
    END.

    /***   AgExp   ***/
    FIND FIRST tt-agencia   NO-ERROR.
    IF AVAIL tt-agencia THEN DO:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "Gera_Valores_Ag-Exp" *}
        RUN pi-acompanhar in h-acomp (RETURN-VALUE).
        ASSIGN hTable  = BUFFER tt-agencia:HANDLE
               prefixo = "#ag-exp-".
        RUN substitui-valores.
    END.

    /***   Importador   ***/
    /* Inicio -- Projeto Internacional */
    {utp/ut-liter.i "Gera_Valores_Importador" *}
    RUN pi-acompanhar in h-acomp (RETURN-VALUE).
    ASSIGN hTable  = BUFFER tt-estabelec:HANDLE
           prefixo = "#imp-".
    RUN substitui-valores.

    /***   Exportador   ***/
    /* Inicio -- Projeto Internacional */
    {utp/ut-liter.i "Gera_Valores_Exportador" *}
    RUN pi-acompanhar in h-acomp (RETURN-VALUE).
    ASSIGN hTable  = BUFFER tt-emitente:HANDLE
           prefixo = "#exp-".
    RUN substitui-valores.

    /*** Corretor   ***/
    /* Inicio -- Projeto Internacional */
    {utp/ut-liter.i "Gera_Valores_Corretor" *}
    RUN pi-acompanhar in h-acomp (RETURN-VALUE).
    ASSIGN hTable  = BUFFER tt-corretor:HANDLE
           prefixo = "#corret-".
    RUN substitui-valores.

    /***   Comprador   ***/
    /* Inicio -- Projeto Internacional */
    {utp/ut-liter.i "Gera_Valores_Comprador" *}
    RUN pi-acompanhar in h-acomp (RETURN-VALUE).
    ASSIGN hTable  = BUFFER tt-comprador:HANDLE
           prefixo = "#comp-".
    RUN substitui-valores.

    /***   Invoice   ***/
    /* Inicio -- Projeto Internacional */
    {utp/ut-liter.i "Gera_Valores_Invoice" *}
    RUN pi-acompanhar in h-acomp (RETURN-VALUE).
    ASSIGN hTable  = BUFFER tt-invoice:HANDLE
           prefixo = "#inv-".
    RUN substitui-valores.

    /***   FecCambio   ***/
    /* Inicio -- Projeto Internacional */
    {utp/ut-liter.i "Gera_Valores_Fec-Cambio" *}
    RUN pi-acompanhar in h-acomp (RETURN-VALUE).
    ASSIGN hTable  = BUFFER tt-pd-fecha-camb:HANDLE
           prefixo = "#feccambio-".
    RUN substitui-valores.

    /***   OutrasLiterais   ***/
    IF tt-ficha.c-linha MATCHES "*#lit*"  
    OR tt-ficha.c-linha MATCHES "*#feccambio-today*" THEN DO:
        /* Inicio -- Projeto Internacional */
        {utp/ut-liter.i "Gera_Outras_Literais" *}
        RUN pi-acompanhar in h-acomp (RETURN-VALUE).
        
        ASSIGN tt-ficha.c-linha = REPLACE(tt-ficha.c-linha,'#feccambio-today', STRING(today)).
        
        RUN piCriarTTTokens (INPUT "#lit-",
                             INPUT tt-ficha.c-linha,
                             OUTPUT TABLE tt-token).

        FOR EACH tt-token:
            
            IF  tt-matriz-ficha.c-linha MATCHES ('*' + tt-token.token + '*') THEN DO:
            
                ASSIGN cNomeCampo = TRIM(REPLACE(tt-token.token,'#lit-', ' ')) 
                       cNomeCampo = TRIM(REPLACE(cNomeCampo,'-', '_')).
    
                RUN utp/ut-liter.p (INPUT cNomeCampo,
                                    INPUT "",
                                    INPUT "") NO-ERROR.
                
                ASSIGN cNomeCampo = RETURN-VALUE.
                
                RUN pi-Traducao (INPUT-OUTPUT cNomeCampo).
                
                ASSIGN tt-ficha.c-linha = REPLACE(tt-ficha.c-linha, tt-token.token, cNomeCampo).
            END.
        END.
    END.
    
END PROCEDURE.

PROCEDURE substitui-valores:
    
    define var cValor as char no-undo.
    
    DO i-cont = 1 TO hTable:NUM-FIELDS:
    
        ASSIGN hField = hTable:BUFFER-FIELD(i-cont).
        
        IF hField:EXTENT > 0 THEN DO:
            DO i-cont-2 = 1 TO hField:EXTENT:
                ASSIGN searchStr = prefixo + hField:NAME + "-" + STRING(i-cont-2).
                
                IF tt-ficha.c-linha MATCHES ('*' + searchStr + '*') THEN do:
                        IF hField:BUFFER-VALUE(i-cont-2) = ? THEN
                             assign cValor = "".
                        ELSE IF hField:DATA-TYPE = "logical" then
                             assign cValor = STRING(hField:BUFFER-VALUE(i-cont-2), "Sim/NÆo").
                        ELSE 
                             assign cValor = hField:BUFFER-VALUE(i-cont-2).

                end.             
                
                IF tt-param.i-traducao <> 1 and (CValor <> "" or CValor <> ?) THEN
                    RUN pi-Traducao (INPUT-OUTPUT cValor).
                
                IF tt-ficha.c-linha MATCHES ('*' + searchStr + '*') THEN
                    ASSIGN tt-ficha.c-linha = REPLACE(tt-ficha.c-linha, searchStr, cValor).
            END.
        END.
        ELSE DO:
            ASSIGN searchStr = prefixo + hField:NAME.
            
            IF tt-ficha.c-linha MATCHES ('*' + searchStr + '*') THEN DO:
                IF hField:data-type = "DECIMAL" THEN DO:
                    FIND FIRST tt-traduz-tt
                        WHERE  tt-traduz-tt.campo-tt = prefixo + hField:NAME NO-ERROR.
                    IF AVAIL tt-traduz-tt THEN
                        ASSIGN tt-ficha.c-linha = REPLACE(tt-ficha.c-linha, searchStr, String(hField:BUFFER-VALUE,tt-traduz-tt.formato)).
                    ELSE do:
                        FIND FIRST tt-traduz-tt
                             WHERE tt-traduz-tt.campo-tt = hField:NAME NO-ERROR.
                        if avail tt-traduz-tt then
                            ASSIGN tt-ficha.c-linha = REPLACE(tt-ficha.c-linha, searchStr, String(hField:BUFFER-VALUE,tt-traduz-tt.formato)).
                        else    
                            ASSIGN tt-ficha.c-linha = REPLACE(tt-ficha.c-linha, searchStr, hField:BUFFER-VALUE).
                    end.
                        
                END.
                ELSE IF hField:data-type = "logical" THEN DO: 
                    
                    assign cValor = STRING(hField:BUFFER-VALUE, "Sim/NÆo").
                        
                    IF tt-param.i-traducao <> 1 and (CValor <> "" or CValor <> ?) THEN
                        RUN pi-Traducao (INPUT-OUTPUT cValor).
                        
                    ASSIGN tt-ficha.c-linha = REPLACE(tt-ficha.c-linha, searchStr, cValor).    

                end.
                ELSE
                    ASSIGN tt-ficha.c-linha = REPLACE(tt-ficha.c-linha, searchStr, hField:BUFFER-VALUE).
            END.
        END.                                                                                             
    END.
END PROCEDURE.


