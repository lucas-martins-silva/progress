/************************************************************************************
**
** IM0200.I10 - Verifica quais declara‡äes devem ser impressas (Importa‡Æo/Exporta‡Æo) 
**
*************************************************************************************/

/* Parametros ***********************************************************************
{1} - historico-proc-imp/historico-proc-emb/historico-proc-exp
{2} - proc-imp/embarq-imp/proc-exp
*************************************************************************************/

/* int-1 -> emite-decl-docum
   int-2 -> dias-tolerancia */

case decl-hist-{2}.int-1:
    /* Processo/Embarque Atrasado */    
    when 1 then do:
        if {1}.dt-efetiva <> ? then do:
            if ({1}.dt-previsao + decl-hist-{2}.int-2) < {1}.dt-efetiva then 
                assign l-imprime = yes.
        end.        
        else do:
             if ({1}.dt-previsao + decl-hist-{2}.int-2) < today then
                 assign l-imprime = yes.
        end.         
    end.
    /* Processo/Embarque Adiantado */
    when 2 then do:
        if {1}.dt-efetiva < ({1}.dt-previsao - decl-hist-{2}.int-2) then
            assign l-imprime = yes.
    end.    
    /* Processo/Embarque no Prazo */
    when 3 then do:
        if   {1}.dt-efetiva < {1}.dt-previsao then do:
             if {1}.dt-previsao - dt-efetiva <= decl-hist-{2}.int-2 then
                assign l-imprime = yes.
        end.        
        else do:
             if {1}.dt-efetiva - dt-previsao <= decl-hist-{2}.int-2 then
                 assign l-imprime = yes.
        end.
    end.          
    /* Processo/Embarque fora do Prazo */   
    when 4 then do:       
        if   {1}.dt-efetiva < {1}.dt-previsao then do:
             if {1}.dt-previsao - dt-efetiva > decl-hist-{2}.int-2 then
                assign l-imprime = yes.
        end.        
        else do:
             if {1}.dt-efetiva - dt-previsao > decl-hist-{2}.int-2 then
                 assign l-imprime = yes.
        end.
    end.   
    /* Sempre Emite */
    when 5 then do:
       if {1}.dt-efetiva <> ? then
          assign l-imprime = yes.
    end.    
end case.            

/* IM0200.I10 */
