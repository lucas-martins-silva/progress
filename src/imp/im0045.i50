assign aux-i-num-var[1] = 2   /* Sempre que for criada uma nova variavel nesse */
                              /* programa, devera  ser  acrescentado  um  para */ 
                              /* essa  variavel.                               */

       aux-i-tamanho[1] = 20. /* espaco padrao utilizado na quebra do atributo char-1 */

