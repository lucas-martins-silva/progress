/*
** 
** IM9025.I1 - Calcula quantidade disponivel para embarque de determinada ordem
** 
*/

procedure pi-calculaQtdeDisponivel:
/*
** Calculo do saldo disponivel para Embarque da ordem requisitada
*/
def input  parameter p-numero-ordem like ordem-compra.numero-ordem no-undo.
def output parameter de-quant-disp  like prazo-compra.quantidade   no-undo.

def var de-quant-ordem  like prazo-compra.quantidade no-undo.
def var de-quant-embarq like prazo-compra.quantidade no-undo.

for each prazo-compra fields(quant-saldo parcela quantidade) where
  &if defined(bf-mat-comex) &then
    prazo-compra.situacao = "C" and
  &else
    prazo-compra.situacao = 2   and
  &endif
    prazo-compra.numero-ordem = p-numero-ordem no-lock:
    


    assign de-quant-ordem = de-quant-ordem + /*prazo-compra.quant-saldo*/ prazo-compra.quantidade .
    
    for each ordens-embarque fields(quantidade)
        where ordens-embarque.numero-ordem = p-numero-ordem
        and   ordens-embarque.parcela      = prazo-compra.parcela no-lock:
        assign de-quant-embarq = de-quant-embarq + ordens-embarque.quantidade.
    end.    
end.

assign de-quant-disp = de-quant-ordem - de-quant-embarq.


end procedure.

/* IM9025.I1 */
