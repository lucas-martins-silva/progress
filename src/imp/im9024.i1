{include/i_fncrowid.i}

def temp-table tt_tit_ap_vl_compdo no-undo
    field tta_cod_estab            as character format "x(3)"
    field tta_cdn_fornecedor       as integer   format ">>>,>>>,>>9" initial 0 
    field tta_cod_espec_docto      as character format "x(3)" 
    field tta_cod_ser_docto        as character format "x(3)" 
    field tta_cod_tit_ap           as character format "x(10)" 
    field tta_cod_parcela          as character format "x(02)" 
    field tta_val_comprtdo_tit_ap  as decimal   format "->>>,>>>,>>9.99" decimals 2 initial 0 
    field tta_val_sdo_tit_ap       as decimal   format "->>>,>>>,>>9.99" decimals 2 initial 0
    field ttv_log_existe_tit       as logical   initial no.    
    
def new shared temp-table tt_tit_ap_alteracao_base_1 no-undo
    field ttv_cod_usuar_corren             as character format "x(12)"
    field tta_cod_empresa                  as character format "x(3)" 
    field tta_cod_estab                    as character format "x(3)" 
    field tta_num_id_tit_ap                as integer format "9999999999" initial 0 
    field ttv_rec_tit_ap                   as &IF {&ROWID_READY} = YES &THEN 
                                                ROWID
                                              &ELSE 
                                                RECID format ">>>>>>9" initial ?
                                              &ENDIF
    
    field tta_cdn_fornecedor               as Integer format ">>>,>>>,>>9" initial 0 
    field tta_cod_espec_docto              as character format "x(3)" 
    field tta_cod_ser_docto                as character format "x(3)" 
    field tta_cod_tit_ap                   as character format "x(10)" 
    field tta_cod_parcela                  as character format "x(02)" 
    field ttv_dat_transacao                as date format "99/99/9999" 
    field ttv_cod_refer                    as character format "x(10)" 
    field tta_val_sdo_tit_ap               as decimal format "->>>,>>>,>>9.99" decimals 2 initial 0 
    field tta_dat_emis_docto               as date format "99/99/9999" initial today
    field tta_dat_vencto_tit_ap            as date format "99/99/9999" initial today
    field tta_dat_prev_pagto               as date format "99/99/9999" initial today
    field tta_dat_ult_pagto                as date format "99/99/9999" initial ? 
    field tta_num_dias_atraso              as integer format ">9" initial 0 
    field tta_val_perc_multa_atraso        as decimal format ">9.99" decimals 2 initial 00.00
    field tta_val_juros_dia_atraso         as decimal format "->>>,>>>,>>9.99" decimals 2 initial 0
    field tta_val_perc_juros_dia_atraso    as decimal format ">9.999999" decimals 6 initial 00.00
    field tta_dat_desconto                 as date format "99/99/9999" initial ?
    field tta_val_perc_desc                as decimal format ">9.9999" decimals 4 initial 0
    field tta_val_desconto                 as decimal format "->>>,>>>,>>9.99" decimals 2 initial 0 
    field tta_cod_portador                 as character format "x(5)"
    field ttv_cod_portador_mov             as character format "x(5)"
    field tta_log_pagto_bloqdo             as logical format "Sim/N’o" initial no
    field tta_cod_seguradora               as character format "x(8)"
    field tta_cod_apol_seguro              as character format "x(12)"
    field tta_cod_arrendador               as character format "x(6)" 
    field tta_cod_contrat_leas             as character format "x(12)"
    field tta_ind_tip_espec_docto          as character format "X(17)" initial "Normal" 
    field tta_cod_indic_econ               as character format "x(8)"
    field tta_num_seq_refer                as integer format ">>>9" initial 0 
    field ttv_ind_motiv_alter_val_tit_ap   as character format "X(09)" initial "Altera‡Æo"
    field ttv_wgh_lista                    as widget-handle extent 15 format ">>>>>>9"
    field ttv_log_gera_ocor_alter_valores  as logical format "Sim/NÆo" initial no
    field tta_cb4_tit_ap_bco_cobdor        as Character format "x(50)" 
    field tta_cod_histor_padr              as character format "x(8)" 
    field tta_des_histor_padr              as character format "x(40)"
    field tta_ind_sit_tit_ap               as character format "X(13)"
    field tta_cod_forma_pagto              as character format "x(3)" 
    field tta_cod_estab_ext                as character format "x(8)" 
    index tt_titap_id                     
          tta_cod_estab                    ascending
          tta_cdn_fornecedor               ascending
          tta_cod_espec_docto              ascending
          tta_cod_ser_docto                ascending
          tta_cod_tit_ap                   ascending
          tta_cod_parcela                  ascending.
    
def new shared temp-table tt_tit_ap_alteracao_rateio no-undo
    field ttv_rec_tit_ap                   as &IF {&ROWID_READY} = YES &THEN 
                                                ROWID
                                              &ELSE 
                                                RECID format ">>>>>>9" initial ?
                                              &ENDIF
    
    field tta_cod_estab                    as character format "x(3)" 
    field tta_cod_refer                    as character format "x(10)"
    field tta_num_seq_refer                as integer format ">>>9" initial 0 
    field tta_cod_tip_fluxo_financ         as character format "x(12)" 
    field tta_cod_plano_cta_ctbl           as character format "x(8)" 
    field tta_cod_cta_ctbl                 as character format "x(20)" 
    field tta_cod_unid_negoc               as character format "x(3)" 
    field tta_cod_plano_ccusto             as character format "x(8)" 
    field tta_cod_ccusto                   as Character format "x(11)"
    field tta_val_aprop_ctbl               as decimal format "->>>,>>>,>>9.99" decimals 2 initial 0
    field ttv_ind_tip_rat                  as character format "X(08)"
    field tta_num_id_tit_ap                as integer format "9999999999" initial 0
    field tta_num_id_aprop_ctbl_ap         as integer format "9999999999" initial 0
    index tt_aprpctba_id                   is primary unique
          tta_cod_estab                    ascending
          tta_cod_refer                    ascending
          tta_num_seq_refer                ascending
          tta_cod_plano_cta_ctbl           ascending
          tta_cod_cta_ctbl                 ascending
          tta_cod_unid_negoc               ascending
          tta_cod_plano_ccusto             ascending
          tta_cod_ccusto                   ascending
          tta_cod_tip_fluxo_financ         ascending
          ttv_rec_tit_ap                   ascending.

def new shared temp-table tt_log_erros_tit_ap_alteracao no-undo
    field tta_cod_estab                    as character format "x(3)" 
    field tta_cdn_fornecedor               as Integer format ">>>,>>>,>>9" initial 0 
