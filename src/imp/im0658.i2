/****************************************************************************************
***  IM0658.I2 - Logica do programa de Controle de Importacao
***
***  Obs.: {1} - Controla a ordenacao.
***
*****************************************************************************************/

for each tt-imprime-registro no-lock
         by {1}
         by tt-imprime-registro.embarque:
         
         if line-counter < 5 then do:
         
                disp c-lb-embarque          
                     c-lb-desembarque   
                     c-lb-chegada       
                     c-lb-ped-compr       
                     c-lb-dt-ped          
                     c-lb-item            
                     c-lb-quantidade      
                     c-lb-exportador      
                     c-lb-embarque2       
                     c-lb-dt-prev         
                     c-lb-dt-prev2        
                     c-lb-local           
                     c-lb-dt-prev3        
                     c-lb-proc-imp        
                     c-lb-un              
                     c-lb-descricao
                     c-lb-fabricante      
                     c-lb-n-fab           
                     c-lb-dt-ult         
                     c-lb-dt-ult2        
                     c-lb-quantidade2     
                     c-lb-dt-ult3
                     c-lb-dt-efet
                     c-lb-dt-efet2
                     c-lb-dt-efet3
                 with frame f-lab-cabecalho.         
         end.
         
         disp tt-imprime-registro.proc-imp
              tt-imprime-registro.dt-ped            
              tt-imprime-registro.quant-prazo       
              tt-imprime-registro.nome-exportador    
              tt-imprime-registro.embarque          
              tt-imprime-registro.dt-prev-embar     
              tt-imprime-registro.dt-prev-desem     
              tt-imprime-registro.local             
              tt-imprime-registro.dt-prev-cheg      

              
              tt-imprime-registro.ped-compr          
              tt-imprime-registro.it-codigo         
              tt-imprime-registro.un                
              tt-imprime-registro.nome-fabricante    
              tt-imprime-registro.n-fab             
              tt-imprime-registro.dt-ult-embar    
              tt-imprime-registro.dt-ult-desem    
              tt-imprime-registro.quant-embarque   
              tt-imprime-registro.dt-ult-cheg     
              
              tt-imprime-registro.desc-item  format "x(34)"       
              tt-imprime-registro.dt-efet-embar
              tt-imprime-registro.dt-efet-desem
              tt-imprime-registro.dt-efet-cheg
              
         with frame f-det-proc.
         down with frame f-det-proc.
         
end.
