/* ac1001.i2 */

    find {1} exclusive-lock
         where {1}.cod-estabel     = par-cota.cod-estabel
         and   {1}.cod-canal-venda = (if par-cota.cont-canal-venda then ped-venda.cod-canal-venda else 0)
         and   {1}.cod-gr-cli      = (if par-cota.cont-gr-cli      then ped-venda.cod-gr-cli      else 0)
         and   {1}.nome-abrev      = (if par-cota.cont-cliente     then ped-venda.nome-abrev      else "")        
         and   {1}.nome-ab-reg     = (if par-cota.cont-ab-reg      then repres.nome-ab-reg        else "")
         and   {1}.nome-mic-reg    = (if par-cota.cont-mic-reg     then emitente.nome-mic-reg     else "")
         and   {1}.cod-rep         = repres.cod-rep
         and   {1}.cd-produto      = c-it-codigo
         and   {1}.codigo          = tt-param.codigo
         no-error.
      
    if not avail {1} then do:
       create {1}.
       assign {1}.cod-estabel     = par-cota.cod-estabel
              {1}.cod-canal-venda = if par-cota.cont-canal-venda then ped-venda.cod-canal-venda else 0
              {1}.cod-gr-cli      = if par-cota.cont-gr-cli      then ped-venda.cod-gr-cli      else 0
              {1}.nome-abrev      = if par-cota.cont-cliente     then ped-venda.nome-abrev      else ""
              {1}.nome-ab-reg     = if par-cota.cont-ab-reg      then repres.nome-ab-reg        else ""
              {1}.nome-mic-reg    = if par-cota.cont-mic-reg     then emitente.nome-mic-reg     else ""
              {1}.cod-rep         = repres.cod-rep
              {1}.cd-produto      = c-it-codigo
              {1}.codigo          = tt-param.codigo
              {1}.quantidade      = de-valor-aux.
    end.
    else
       assign {1}.quantidade  = {1}.quantidade + de-valor-aux.
