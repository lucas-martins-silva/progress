/*******************************************************************************
**
** ac0504.i2  : Include para somar quantidades.
** Parƒmetros : {1} e {2} Qtde/Valor Cotas prevista, pedida, faturada,
**              pedida cancelada, pedida faturada, pedida suspensa,
**        
** Soma a quantidade/valor pedido reprovado na 2.03.
********************************************************************************/
 de-qtde-tot = de-qtde-tot +
               if par-cota.tipo-controle = 2 then {2}
                                                else {1}.  


