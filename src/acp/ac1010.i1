/* ac1010.i1 - Faz o balanceamento da Qt Prevista na Cota com o maior valor 
   para todos os n¡veis controlados. */

 assign de-maior-qt-prev = 0
        de-total-qt-prevista = 0.
 for each cotas no-lock
       where cotas.cod-estabel      = tt-estabel.cod-estabel
         {&condicao}
         and cotas.cd-produto      >= tt-param.produto-ini
         and cotas.cd-produto      <= tt-param.produto-fim
         and cotas.dt-inicial       = tt-param.dt-periodo-ini
         {&quebra}:
      run pi-acompanhar in h-acomp (input cotas.cd-produto).
      if  par-cota.tipo-controle = 2 then do:
          if  cotas.vl-previsto > de-maior-qt-prev then
              assign de-maior-qt-prev = cotas.vl-previsto
                     r-id-cotas       = rowid(cotas).
          assign de-total-qt-prevista = de-total-qt-prevista + cotas.vl-previsto.
      end.
      else do:
          if  cotas.qt-prevista > de-maior-qt-prev then
              assign de-maior-qt-prev = cotas.qt-prevista
                     r-id-cotas       = rowid(cotas).
          assign de-total-qt-prevista = de-total-qt-prevista + cotas.qt-prevista.
      end.
      if  last-of({&last}) then do:
          assign c-cod-estabel = cotas.cod-estabel
                 c-cd-produto = cotas.cd-produto
                 da-dt-inicial = cotas.dt-inicial.
                 
          {acp/ac9005.i &cond-base-cota="{&cond-base-cota}"
                         &cond-cotas="{&cond-cotas}"}.
          find b-cotas where
               rowid(b-cotas) = r-id-cotas exclusive-lock no-error.
          if  l-erro-base-cota = no and
              de-total-qt-prevista <> de-valor-base then do:
              if  par-cota.tipo-controle  = 2 then do:
                  if  de-valor-base > de-total-qt-prevista then 
                      assign b-cotas.vl-previsto = b-cotas.vl-previsto + (de-valor-base - de-total-qt-prevista).
                  else 
                      assign b-cotas.vl-previsto = b-cotas.vl-previsto - (de-total-qt-prevista - de-valor-base).
              end.
              else do:
                  if  de-valor-base > de-total-qt-prevista then 
                      assign b-cotas.qt-prevista = b-cotas.qt-prevista + (de-valor-base - de-total-qt-prevista).
                  else 
                      assign b-cotas.qt-prevista = b-cotas.qt-prevista - (de-total-qt-prevista - de-valor-base).
              end.
          end.
          assign de-maior-qt-prev = 0
                 de-total-qt-prevista = 0.
      end.
  end.
