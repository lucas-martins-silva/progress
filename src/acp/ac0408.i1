
/*************************************************************************
* Include : acp/ac0408.i1 
* Objetivo: For each do programa com varia‡Æo do Break By (atu-cota.nome-abrev)
**************************************************************************/

for each atu-cota no-lock 
   where atu-cota.cod-estabel       >= tt-param.cod-estab-ini
     and atu-cota.cod-estabel       <= tt-param.cod-estab-fim
     and ((atu-cota.cod-canal-venda >= tt-param.cod-canal-venda-ini
     and atu-cota.cod-canal-venda   <= tt-param.cod-canal-venda-fim)
      or atu-cota.cod-canal-venda   = ? )
     and ((atu-cota.cod-gr-cli      >= tt-param.cod-gr-cli-ini
     and atu-cota.cod-gr-cli        <= tt-param.cod-gr-cli-fim)
      or atu-cota.cod-gr-cli        = ? )
     and ((atu-cota.nome-abrev      >= tt-param.nome-abrev-ini
     and atu-cota.nome-abrev        <= tt-param.nome-abrev-fim)
      or atu-cota.nome-abrev        = ? )          
     and ((atu-cota.nome-ab-reg     >= tt-param.nome-ab-reg-ini
     and atu-cota.nome-ab-reg       <= tt-param.nome-ab-reg-fim)
      or atu-cota.nome-ab-reg       = ? ) 
     and ((atu-cota.nome-mic-reg    >= tt-param.nome-mic-reg-ini
     and atu-cota.nome-mic-reg      <= tt-param.nome-mic-reg-fim)
      or atu-cota.nome-mic-reg      = ? )
     and atu-cota.cod-rep           >= tt-param.cod-rep-ini
     and atu-cota.cod-rep           <= tt-param.cod-rep-fim
     and atu-cota.cd-produto        >= tt-param.cd-produto-ini
     and atu-cota.cd-produto        <= tt-param.cd-produto-fim
     and atu-cota.dt-inicial        >= tt-param.dt-inicial
     and atu-cota.dt-inicial        <= tt-param.dt-final
   break by atu-cota.cod-estabel
         by atu-cota.cod-canal-venda
         by atu-cota.cod-gr-cli
         {1}
         by atu-cota.nome-ab-reg
         by atu-cota.nome-mic-reg
         by atu-cota.cod-rep:

run pi-acompanhar in h-acomp (atu-cota.cd-produto).

    find first par-cota where 
               par-cota.cod-estabel = atu-cota.cod-estabel no-lock no-error.

    if first-of(atu-cota.cod-estabel) then 
         assign l-imprime = yes.

    if l-imprime = yes then do:
         disp c-estabel with stream-io frame f-estab.
         find estabelec no-lock where estabelec.cod-estabel = atu-cota.cod-estabel no-error.
         if avail estabelec then
              disp estabelec.nome with stream-io frame f-estab.
         assign l-imprime = no.   
    end.    


    if first-of(atu-cota.cod-canal-venda) or first-of(atu-cota.cod-gr-cli)   or
       first-of(atu-cota.nome-ab-reg)  or
       first-of(atu-cota.nome-mic-reg)    or first-of(atu-cota.cod-rep) then do:

    /* ImpressÆo do cabe‡alho:
        Canal Venda   :                                          Grupo Cliente :
        Cliente       :                                          RegiÆo        :
        MicrorregiÆo  :                                          Representante :
    */           
       disp c-canal-venda with stream-io frame f-atu-cota.
       find canal-venda no-lock where canal-venda.cod-canal-venda = atu-cota.cod-canal-venda no-error.
       if avail canal-venda then 
             disp canal-venda.descricao with stream-io frame f-atu-cota.         

       disp c-representante with stream-io frame f-atu-cota.
       find repres no-lock where repres.cod-rep = atu-cota.cod-rep no-error.
       if avail repres then 
             disp repres.nome-abrev with stream-io frame f-atu-cota.         

       disp c-gr-cli with stream-io frame f-atu-cota.
       find gr-cli no-lock where gr-cli.cod-gr-cli = atu-cota.cod-gr-cli no-error.
       if avail gr-cli then 
             disp gr-cli.descricao with stream-io frame f-atu-cota.             

       if par-cota.cont-cliente then 
             disp c-nome-abrev atu-cota.nome-abrev with frame f-atu-cota.         
       else 
             disp c-nome-abrev with frame f-atu-cota.         

       disp c-ab-reg with stream-io frame f-atu-cota.
       find regiao no-lock where regiao.nome-ab-reg = atu-cota.nome-ab-reg no-error.
       if avail regiao then 
            assign c-desc-regiao = regiao.nome-regiao.             
       disp c-desc-regiao with stream-io frame f-atu-cota.

       disp c-mic-reg with stream-io frame f-atu-cota.
       find micro-reg no-lock where micro-reg.nome-mic-reg = atu-cota.nome-mic-reg no-error.
       if avail micro-reg then
            assign c-nome-mic-reg = micro-reg.nome-mic-reg.
       disp c-nome-mic-reg with stream-io frame f-atu-cota.

       /*ImpressÆo do cabe‡alho
        "Pedido       Cliente      Dt Inicial Produto/Item                Pedida          Prevista       % Realizada SKIP 
        "------------ ------------ ---------- ---------------- ----------------- ----------------- ----------------- 
       */

       if par-cota.tipo-controle = 1 then do:
             {utp/ut-liter.i Qtde_Prevista * L}
             assign c-prevista = fill(" ",17 - length(trim(return-value))) + trim(return-value).
             {utp/ut-liter.i Qtde_Pedida * L}
             assign c-qt-pedido = fill(" ",17 - length(trim(return-value))) + trim(return-value).
       end.
       else 
       if par-cota.tipo-controle = 2 then do:
            {utp/ut-liter.i Valor_Previsto * L}
            assign c-prevista = fill(" ",17 - length(trim(return-value))) + trim(return-value).
            {utp/ut-liter.i Valor_Pedido * L}
            assign c-qt-pedido = fill(" ",17 - length(trim(return-value))) + trim(return-value).
       end.
       else do:
           {utp/ut-liter.i Pontos_Previsto * L}
           assign c-prevista = fill(" ",17 - length(trim(return-value))) + trim(return-value).
           {utp/ut-liter.i Pontos_Pedido * L}
           assign c-qt-pedido = fill(" ",17 - length(trim(return-value))) + trim(return-value).
       end.

       disp c-nr-pedido     
            c-cliente       
            c-periodo       
            c-produto
            c-prevista
            c-qt-pedido
            c-realizado 
          with stream-io frame f-cab1.                   

    end. /* if first-of() ...*/

    find first cotas 
         where cotas.cod-estabel     = atu-cota.cod-estabel 
           and cotas.cod-canal-venda = atu-cota.cod-canal-venda 
           and cotas.cod-gr-cli      = atu-cota.cod-gr-cli 
           and cotas.nome-abrev      = (if par-cota.cont-cliente then atu-cota.nome-abrev else "")
           and cotas.nome-ab-reg     = atu-cota.nome-ab-reg 
           and cotas.nome-mic-reg    = atu-cota.nome-mic-reg 
           and cotas.cod-rep         = atu-cota.cod-rep 
           and cotas.cd-produto      = atu-cota.cd-produto 
           and cotas.dt-inicial     <= atu-cota.dt-inicial 
           and cotas.dt-final        = atu-cota.dt-final  no-lock no-error.
    if not avail cotas then do:
        find emitente where emitente.nome-abrev = atu-cota.nome-abrev no-lock no-error.
        
        if avail emitente then
                find first cotas 
                 where cotas.cod-estabel     = atu-cota.cod-estabel 
                   and cotas.cod-canal-venda = atu-cota.cod-canal-venda 
                   and cotas.cod-gr-cli      = atu-cota.cod-gr-cli 
                   and cotas.nome-abrev      = (if par-cota.cont-cliente then emitente.nome-matriz else "")
                   and cotas.nome-ab-reg     = atu-cota.nome-ab-reg 
                   and cotas.nome-mic-reg    = atu-cota.nome-mic-reg 
                   and cotas.cod-rep         = atu-cota.cod-rep 
                   and cotas.cd-produto      = atu-cota.cd-produto 
                   and cotas.dt-inicial     <= atu-cota.dt-inicial 
                   and cotas.dt-final        = atu-cota.dt-final  no-lock no-error.
    end.

    if par-cota.tipo-controle <> 2 then                     
        assign de-tot-ped-qt  = de-tot-ped-qt + atu-cota.qt-pedida.
    else                                                     
        assign de-tot-ped-vl  = de-tot-ped-vl + atu-cota.vl-pedido.

    run pi-acompanhar in h-acomp (atu-cota.cd-produto).

    put atu-cota.nr-pedcli  at 01
        atu-cota.nome-abrev at 14
        atu-cota.dt-inicial format "99/99/99" at 27
        atu-cota.cd-produto at 36.

    if avail cotas then
        if par-cota.tipo-controle <> 2 then
            put cotas.qt-prevista format ">>>>,>>>,>>9.9999" at 53.
        else
            put cotas.vl-previsto format ">>>>,>>>,>>9.9999" at 53.


    if par-cota.tipo-controle <> 2 then do: 
       assign de-perc = (atu-cota.qt-pedida * 100) / cotas.qt-prevista.
       put atu-cota.qt-pedida  format ">>>>,>>>,>>9.9999" at 71.
    end.
    else do: 
       assign de-perc = (atu-cota.vl-pedido * 100) / cotas.vl-previsto.
       put atu-cota.vl-pedido  format ">>>>,>>>,>>9.9999" at 71.
    end.

    if de-perc = ? then
       assign de-perc = 0.

    put de-perc format ">>>,>>9.99" at 92.


    if last-of(atu-cota.cod-canal-venda) or last-of(atu-cota.cod-gr-cli)   or
       last-of(atu-cota.nome-ab-reg)  or
       last-of(atu-cota.nome-mic-reg)    or last-of(atu-cota.cod-rep) then do:

           put "-----------------" at 71
               c-total             at 64
               ":":U .

           if par-cota.tipo-controle <> 2 then
              put de-tot-ped-qt format ">>>>,>>>,>>9.9999" at 71.
           else
              put de-tot-ped-vl format ">>>>,>>>,>>9.9999" at 71.

           assign de-tot-ped-qt  = 0
                  de-tot-ped-vl  = 0.

    end.

   if last-of(atu-cota.cod-estabel) then 
       page.

end.

/* Fim include ac0408.i1 */


