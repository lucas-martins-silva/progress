/********************************************************************************
 * Include : acp/acapi006.i1                                                    * 
 * Objetivo: Include de criaá∆o da temp table tt-erros-api, com montagem da chave   *
 ********************************************************************************/
  
  /***
   * N«O RETIRAR O "IF"
   * Quando n∆o Ç informada a data inicial, a chave da TT de erros (tt-erros-api.chave)
   * recebe interroga, n∆o apresentando o erro.
   ***/
  if tt-cotas.dt-inicial = ? then
      assign tt-cotas.dt-inicial = 01/01/01.
  
  assign tt-erros-api.num-sequencia-erro = i-conta-msg
         tt-erros-api.cod-erro           = {1}
         tt-erros-api.des-erro           = return-value
         tt-erros-api.chave              = (tt-cotas.cod-estabel            + "~~" +
                                       (if tt-cotas.cod-canal-venda = ? then
                                          c-interroga 
                                          else 
                                          string(tt-cotas.cod-canal-venda)) + "~~" +  
                                       (if tt-cotas.cod-gr-cli = ? then
                                          c-interroga
                                          else
                                          string(tt-cotas.cod-gr-cli))      + "~~" + 
                                       (if tt-cotas.nome-abrev = ? then
                                          c-interroga
                                          else
                                          tt-cotas.nome-abrev)              + "~~" +
                                       (if tt-cotas.nome-ab-reg = ? then
                                          c-interroga
                                          else
                                          tt-cotas.nome-ab-reg)             + "~~" +       
                                       (if tt-cotas.nome-mic-reg = ? then
                                          c-interroga
                                          else
                                          tt-cotas.nome-mic-reg)            + "~~" + 
                                       string(tt-cotas.cod-rep)             + "~~" +          
                                       tt-cotas.cd-produto                  + "~~" +        
                                       string(tt-cotas.dt-inicial)).
