/*******************************************************************************
* acapi004.i1 -  Leitura das cotas 
*******************************************************************************/


if can-find(last cotas where 
   cotas.cod-estabel     = estab   and
   cotas.cod-canal-venda = canal   and
   cotas.cod-gr-cli      = grcli   and
   cotas.nome-abrev      = cliente and
   cotas.nome-ab-reg     = {1}     and  /* regiao */
   cotas.nome-mic-reg    = {2}     and  /* micro-regiao */
   cotas.cod-rep         = repres  and
   cotas.cd-produto      = produto and
   cotas.dt-inicial     <= dt-inicial  and
   cotas.dt-final       >= dt-inicial no-lock) then do:
   find last 
         cotas where 
         cotas.cod-estabel     = estab   and
         cotas.cod-canal-venda = canal   and
         cotas.cod-gr-cli      = grcli   and
         cotas.nome-abrev      = cliente and
         cotas.nome-ab-reg     = {1}     and  /* regiao */
         cotas.nome-mic-reg    = {2}     and  /* micro-regiao */
         cotas.cod-rep         = repres  and
         cotas.cd-produto      = produto and
         cotas.dt-inicial     <= dt-inicial and
         cotas.dt-final       >= dt-inicial no-lock no-error.
         assign r-cotas = rowid(cotas).
         return "ok".
end.

return "nok".

/* acapi004.i1 */

