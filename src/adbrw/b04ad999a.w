PROCEDURE pi-retorna-valor :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

DEFINE INPUT PARAMETER P-CAMP AS CHARACTER NO-UNDO.
DEFINE VARIABLE P-VALOR AS CHAR INIT "" NO-UNDO.
IF AVAIL tt-cod-ir THEN DO:
   assign p-valor = string(tt-cod-ir.c-cod).
   return p-valor.
END.
END PROCEDURE.

