PROCEDURE local-initialize :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  run cdp/cd8889.p (output table tt-cod-ir).

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .

  /* Code placed here will execute AFTER standard behavior.    */


  {utp/ut-liter.i C¢digo * R}
  assign i-inicial:label       in frame  {&frame-name}  = return-value
         tt-cod-ir.c-cod:label in browse {&browse-name} = return-value.
  {utp/ut-liter.i Descri‡Æo * R}
  assign tt-cod-ir.c-desc:label in browse {&browse-name} = return-value.
  {utp/ut-liter.i Pessoa * R}
  assign c-pessoa:label in browse {&browse-name} = return-value.
