&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-open-query B-table-Win 
PROCEDURE local-open-query :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */
  for each b-emitente where b-emitente.nome-matriz eq emitente.nome-abrev:
    create tt-emitente.
    assign 
      tt-emitente.cod-emitente = b-emitente.cod-emitente
      tt-emitente.nome-abrev   = b-emitente.nome-abrev
      tt-emitente.categoria    = b-emitente.categoria
      tt-emitente.lim-credito  = b-emitente.lim-credito
      tt-emitente.dt-lim-cre   = b-emitente.dt-lim-cred
      tt-emitente.cod-gr-cli   = b-emitente.cod-gr-cli
      tt-emitente.ind-cre-cli  = b-emitente.ind-cre-cli.
  end.

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'open-query':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-row-available B-table-Win 
PROCEDURE local-row-available :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */
  for each tt-emitente:
    delete tt-emitente.
  end.

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'row-available':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

END PROCEDURE.

