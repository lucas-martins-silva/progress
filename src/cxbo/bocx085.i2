/*
**
** BOCX085.I2 - Validacao Tabela de Preco comun na BOCX085.P
**
*/

/*
Parametros utilizados:
1 - Tabela de Preco
2 - Emitente da despesa
3 - Itinerario
4 - Incoterm
5 - Despesa
6 - Condi‡Æo de pagamento
*/

if {1} <> "":U then do:
    find tb-pr-cex no-lock
        where tb-pr-cex.cod-emitente = {2}
          and tb-pr-cex.cod-itiner   = {3}
          and tb-pr-cex.cod-incoterm = {4}
          and tb-pr-cex.nr-tab       = {1}
          no-error.
    if not avail tb-pr-cex then
        find tb-pr-cex no-lock
            where tb-pr-cex.cod-emitente = {2}
              and tb-pr-cex.cod-itiner   = {3}
              and tb-pr-cex.cod-incoterm = "":U
              and tb-pr-cex.nr-tab       = {1}
              no-error.
    if not avail tb-pr-cex then
        find tb-pr-cex no-lock
            where tb-pr-cex.cod-emitente = {2}
              and tb-pr-cex.cod-itiner   = 0
              and tb-pr-cex.cod-incoterm = {4}
              and tb-pr-cex.nr-tab       = {1}
              no-error.
    if not avail tb-pr-cex then
        find tb-pr-cex no-lock
            where tb-pr-cex.cod-emitente = {2}
              and tb-pr-cex.cod-itiner   = 0
              and tb-pr-cex.cod-incoterm = ""
              and tb-pr-cex.nr-tab       = {1}
              no-error.
    if not avail tb-pr-cex then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
        
        if "{&VALIDA-DESPESA}" <> "NO" then do:
            {utp/ut-table.i mgcex tb-pr-cex 1}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = TRIM(RETURN-VALUE).
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input TRIM(RETURN-VALUE)).
                               
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                   
        end.                       
        else do:
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            /* Inicio -- Projeto Internacional */
            {utp/ut-liter.i "Tabela_de_pre‡o_padrÆo_inv lida_para_chave_informada" *}
            run utp/ut-msgs.p (input "msg":U,
                               input 25997,
                               input RETURN-VALUE).     
                               
            /* Inicio -- Projeto Internacional */
            ASSIGN c-lbl-liter-2 = TRIM(RETURN-VALUE).            
            {utp/ut-liter.i "NÆo_encontrada_tabela_de_pre‡o_padrÆo_ou_tabela_informada_nÆo_associada_ao_itiner rio_e_incoterm_padrÆo_do_fornecedor" *}
            ASSIGN c-lbl-liter-nao-encontrada-tabela-de-preco = TRIM(RETURN-VALUE).
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 25997
                   tt-bo-erro.mensagem = c-lbl-liter-2
                   tt-bo-erro.parametros = c-lbl-liter-2 + '~~' + 
                   c-lbl-liter-nao-encontrada-tabela-de-preco + '.'.
        end. 
        
    end.
    else do:
        if tb-pr-cex.dt-inicio > today or
           tb-pr-cex.dt-termino < today then do:
            assign i-seq-erro = i-seq-erro + 1.
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg":U,
                               input 4432,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 4432
                   tt-bo-erro.mensagem     = return-value.
        end.
        if tb-pr-cex.situacao = 2 then do:
            assign i-seq-erro = i-seq-erro + 1.
            run utp/ut-msgs.p (input "msg":U,
                               input 1024,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 1024
                   tt-bo-erro.mensagem     = return-value.
        end.
        
        if "{&VALIDA-DESPESA}" <> "NO" then do:
            if not can-find(desp-tb-pr-cex 
                            where desp-tb-pr-cex.cod-emitente = tb-pr-cex.cod-emitente and
                                  desp-tb-pr-cex.cod-itiner   = tb-pr-cex.cod-itiner and
                                  desp-tb-pr-cex.cod-incoterm = tb-pr-cex.cod-incoterm and
                                  desp-tb-pr-cex.nr-tab       = tb-pr-cex.nr-tab and
                                  desp-tb-pr-cex.cod-desp     = {5} and
                                  desp-tb-pr-cex.cod-cond-pag = {6} and
                                  desp-tb-pr-cex.situacao = 1) then do:
                assign i-seq-erro = i-seq-erro + 1.
                /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
                {utp/ut-table.i mgcex desp-imp 1}
                assign c-return1 = return-value.
                {utp/ut-table.i mgcex tb-pr-cex 1}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = c-return1 + "~~" + return-value.
                run utp/ut-msgs.p (input "msg":U,
                                   input 7850,
                                   input c-return1 + "~~" + return-value).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 7850
                       tt-bo-erro.mensagem     = return-value.
            end.
        end.    
    end.
end.

/* BOCX085.I3 */
