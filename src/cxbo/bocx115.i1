            {utp/ut-table.i mgcex historico-proc-exp 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 5,
                               input c-tabela + "~~" + return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen  = i-seq-erro
                   tt-bo-erro.cd-erro   = 5
                   tt-bo-erro.mensagem  = return-value.
        end.
        if can-find(first historico-proc-imp where historico-proc-imp.cod-itiner = {&table-name}.cod-itiner) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex itinerario 1}
            /******************************************/
            assign c-tabela = return-value.            
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex historico-proc-imp 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 5,
                               input c-tabela + "~~" + return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen  = i-seq-erro
                   tt-bo-erro.cd-erro   = 5
                   tt-bo-erro.mensagem  = return-value.
        end.
        if can-find(first historico-embarque where historico-embarque.cod-itiner = {&table-name}.cod-itiner) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex itinerario 1}
            /******************************************/
            assign c-tabela = return-value.            
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex desp-item 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 5,
                               input c-tabela + "~~" + return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen  = i-seq-erro
                   tt-bo-erro.cd-erro   = 5
                   tt-bo-erro.mensagem  = return-value.
        end.
        if can-find(first incoterm-itiner where incoterm-itiner.cod-itiner = {&table-name}.cod-itiner) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex itinerario 1}
            /******************************************/
            assign c-tabela = return-value.            
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex incoterm-itiner 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 5,
                               input c-tabela + "~~" + return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen  = i-seq-erro
                   tt-bo-erro.cd-erro   = 5
                   tt-bo-erro.mensagem  = return-value.
        end.
        if can-find(first emitente-cex where emitente-cex.cod-itiner-exp = {&table-name}.cod-itiner 
                                          or emitente-cex.cod-itiner-imp = {&table-name}.cod-itiner) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex itinerario 1}
            /******************************************/
            assign c-tabela = trim(return-value).
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex emitente-cex 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = c-tabela + "~~" + trim(return-value).
            run utp/ut-msgs.p (input "msg",
                               input 5,
                               input c-tabela + "~~" + return-value).
            assign tt-bo-erro.i-sequen  = i-seq-erro
                   tt-bo-erro.cd-erro   = 5
                   tt-bo-erro.mensagem  = return-value.
        end.
        find first tt-bo-erro no-error.
  	 if not avail tt-bo-erro then do:
  	     run cxbo/bocx120.p persistent set h-bocx120.
            for each pto-itiner exclusive-lock
                where pto-itiner.cod-itiner = {&table-name}.cod-itiner:
                assign r-pto-itiner = rowid(pto-itiner).
                run validateDelete in h-bocx120 (input-output r-pto-itiner, output table tt-bo-erro).            
            end.
            delete procedure h-bocx120.
        end.
        
        find first tt-bo-erro no-error.
        if not avail tt-bo-erro then do:
        	run executeDelete.
          	find next {&TABLE-NAME} no-lock no-error.
          	if not avail {&TABLE-NAME} then
            	find prev {&TABLE-NAME} no-lock no-error.
          	assign r-chave = rowid({&TABLE-NAME}).
          	return "".
        end.
    end.

  	run endMethod ("ValidateDelete").

end procedure.

procedure validateCreate:
    /*
    **  Valida criacao da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.
    
    def var i-auto-num as integer no-undo.

    run initializeValidate.

    run startMethod ("validateCreate").

    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

    find first rowObject no-lock no-error.        
    assign rowObject.nr-dias = 0. /* valor inicial da base esta 1 */

    if rowObject.cod-itiner = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex itinerario cod-itiner 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.

    run validateFields.

    if not can-find(first tt-bo-erro) then do:    
        find itinerario where
             itinerario.cod-itiner = rowObject.cod-itiner
             no-lock no-error.
        if  avail itinerario then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex itinerario 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 8,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 8
                   tt-bo-erro.mensagem     = return-value.
        end.
    end.
    
    find first tt-bo-erro no-lock no-error.
    if not avail tt-bo-erro then do:
        run executeCreate.
        assign r-chave = to-rowid(return-value).
    end.

    run endMethod ("validateCreate").
end procedure.

procedure validateCreate2:
    /*
    **  Valida criacao da tabela/duplicidade de registro.
    */
    def input parameter  c-param as char.
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.
    def var i-auto-num as integer no-undo.

    run initializeValidate.

    run startMethod ("validateCreate").

    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

    find first rowObject
        no-lock no-error.

    assign rowObject.nr-dias = 0. /* valor inicial da base esta 1 */       

    if rowObject.cod-itiner = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex itinerario cod-itiner 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.

    run validateFields.

    if not can-find(first tt-bo-erro) then do:
    
        find itinerario where
             itinerario.cod-itiner = rowObject.cod-itiner
             no-lock no-error.
        if  avail itinerario then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex itinerario 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 8,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 8
                   tt-bo-erro.mensagem     = return-value.
        end.
    end.

    find first tt-bo-erro
        no-lock no-error.

    if not avail tt-bo-erro then do:
       if c-param = "add" then
          run executeCreate.
       else run executeCreate1.
       assign r-chave = to-rowid(return-value).
    end.

    run endMethod ("validateCreate").

end procedure.

procedure autoNumber:
    
    def output parameter i-auto-num as integer no-undo.
    def var i-cont as integer init 1 no-undo. /** variavel de contador **/
    def output parameter table for tt-bo-erro.

    {include/boautonum.i "99999" "cod-itiner"}

end procedure.

procedure executeCreate:
    /*
    **  Cria registro na tabela.
    */

    create {&TABLE-NAME}.
    buffer-copy RowObject except r-rowid pto-chegada pto-desembarque pto-despacho pto-embarque 
        to {&TABLE-NAME}.

    return string(rowid({&TABLE-NAME})).

end procedure.

procedure executeCreate1:
    /*
    **  Cria registro na tabela.
    */

    create {&TABLE-NAME}.
    buffer-copy RowObject except r-rowid 
        to {&TABLE-NAME}.
    
    return string(rowid({&TABLE-NAME})).

end procedure.

procedure executeCopy:
    def input parameter r-chave as rowid no-undo.
    def input parameter i-cod-itiner as integer no-undo.
    
    def buffer b-itinerario for itinerario.
    
    find {&table-name} 
        where rowid({&table-name}) = r-chave no-lock no-error.    
    if avail {&table-name} then do:
        find b-itinerario
            where b-itinerario.cod-itiner = i-cod-itiner exclusive-lock no-error.
        if avail b-itinerario then
            assign b-itinerario.nr-dias   = {&table-name}.nr-dias
                   b-itinerario.distancia = {&table-name}.distancia.                                        
        for each pto-itiner of {&table-name} no-lock:
            create tt-pto-itiner.
            assign tt-pto-itiner.cod-itiner = i-cod-itiner.
            buffer-copy pto-itiner except pto-itiner.cod-itiner to tt-pto-itiner.
        end.
        for each tt-pto-itiner:
            create pto-itiner.
            buffer-copy tt-pto-itiner to pto-itiner.
            for each desp-itiner no-lock
                where desp-itiner.cod-itiner = {&table-name}.cod-itiner 
                  and desp-itiner.cod-pto-contr = tt-pto-itiner.cod-pto-contr:
                create tt-desp-itiner.
                assign tt-desp-itiner.cod-itiner    = i-cod-itiner
                       tt-desp-itiner.cod-pto-contr = tt-pto-itiner.cod-pto-contr
                       tt-desp-itiner.cod-desp      = desp-itiner.cod-desp.
                buffer-copy desp-itiner except desp-itiner.cod-desp desp-itiner.cod-pto-contr desp-itiner.cod-itiner to tt-desp-itiner.
            end.
            for each tt-desp-itiner:
                create desp-itiner.
                buffer-copy tt-desp-itiner to desp-itiner.
                delete tt-desp-itiner.
            end.
            
            for each decl-itiner no-lock
                where decl-itiner.cod-itiner = {&table-name}.cod-itiner 
                  and decl-itiner.cod-pto-contr = tt-pto-itiner.cod-pto-contr:
                create tt-decl-itiner.
                assign tt-decl-itiner.cod-itiner    = i-cod-itiner
                       tt-decl-itiner.cod-pto-contr = tt-pto-itiner.cod-pto-contr
                       tt-decl-itiner.de-codigo      = decl-itiner.de-codigo.
                buffer-copy decl-itiner except decl-itiner.cod-pto-contr decl-itiner.cod-itiner decl-itiner.de-codigo to tt-decl-itiner.
            end.
            for each tt-decl-itiner:
                create decl-itiner.
                buffer-copy tt-decl-itiner to decl-itiner.
                delete tt-decl-itiner.
            end.
            
            for each incoterm-itiner no-lock
               where incoterm-itiner.cod-itiner    = {&table-name}.cod-itiner
                 and incoterm-itiner.cod-pto-contr = tt-pto-itiner.cod-pto-contr:
                 create tt-incoterm-itiner.
                 assign tt-incoterm-itiner.cod-itiner    = i-cod-itiner
                        tt-incoterm-itiner.cod-pto-contr = tt-pto-itiner.cod-pto-contr
                        tt-incoterm-itiner.cod-incoterm  = incoterm-itiner.cod-incoterm.
                 buffer-copy incoterm-itiner except incoterm-itiner.cod-itiner incoterm-itiner.cod-pto-contr incoterm-itiner.cod-incoterm 
                             to tt-incoterm-itiner.
             end.
             for each tt-incoterm-itiner:
                 create incoterm-itiner.
                 buffer-copy tt-incoterm-itiner to incoterm-itiner.
                 delete tt-incoterm-itiner.
             end.

        end.                                               
    end.
    
    for each tt-decl-itiner :
        delete tt-decl-itiner.
    end.
    for each tt-pto-itiner :
        delete tt-pto-itiner.
    end.
    for each tt-desp-itiner :
        delete tt-desp-itiner.
    end.
    for each tt-incoterm-itiner:
        delete tt-incoterm-itiner.
    end.
         
end procedure.

procedure atualizarDiasDistanciaitinerario:
/*
** Atualiza os campos dias/distancia do itinerario conforme modificacao dos pontos itinerario
*/
    def input parameter p-cod-itiner     as integer no-undo.
    def input parameter p-cod-pto-contr  as integer no-undo.
    def input parameter p-acao           as char no-undo. /* add - mod */ 
    def input parameter p-mod-nr-dias    like pto-itiner.nr-dias no-undo. /* quando mod - nr-dias antigo */
    def input parameter p-mod-distancia  like pto-itiner.distancia no-undo. /* quando mod - distancia antigo */    

    find {&TABLE-NAME} where {&TABLE-NAME}.cod-itiner = p-cod-itiner exclusive-lock no-error no-wait.
    if avail {&TABLE-NAME} then do:
        find pto-itiner where pto-itiner.cod-itiner = {&TABLE-NAME}.cod-itiner and
                              cod-pto-contr         = p-cod-pto-contr no-lock no-error.
        if not avail pto-itiner then leave.
        case p-acao:
            when "add" then 
                assign {&TABLE-NAME}.distancia = {&TABLE-NAME}.distancia + pto-itiner.distancia
                       {&TABLE-NAME}.nr-dias   = {&TABLE-NAME}.nr-dias   + pto-itiner.nr-dias.
            when "mod" then
                assign {&TABLE-NAME}.distancia = {&TABLE-NAME}.distancia + 
                                                 (pto-itiner.distancia - p-mod-distancia)
                       {&TABLE-NAME}.nr-dias   = {&TABLE-NAME}.nr-dias + 
                                                 (pto-itiner.nr-dias - p-mod-nr-dias).
            when "del" then
                assign {&TABLE-NAME}.distancia = {&TABLE-NAME}.distancia - pto-itiner.distancia
                       {&TABLE-NAME}.nr-dias   = {&TABLE-NAME}.nr-dias   - pto-itiner.nr-dias.                                                                 
        end case.
    end.

end procedure.

procedure getCharField:
    define input  parameter c-field as char.
    define output parameter c-value as char.

    case c-field:
        when "char-1" then c-value = RowObject.char-1.
        when "char-2" then c-value = RowObject.char-2.
        when "check-sum" then c-value = RowObject.check-sum.
        when "descricao" then c-value = RowObject.descricao.
        when "narrativa" then c-value = RowObject.narrativa.
        otherwise return error.
    end case.
end procedure.

procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.

    case c-field:
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        when "nr-dias" then c-value = RowObject.nr-dias.
        otherwise return error.
    end case.
end procedure.

procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.

    case c-field:
        when "cod-itiner" then c-value = RowObject.cod-itiner.
        when "distancia" then c-value = RowObject.distancia.
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.
        when "pto-chegada" then c-value = RowObject.pto-chegada.
        when "pto-desembarque" then c-value = RowObject.pto-desembarque.
        when "pto-despacho" then c-value = RowObject.pto-despacho.
        when "pto-embarque" then c-value = RowObject.pto-embarque.
        otherwise return error.
    end case.
end procedure.

procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.

    case c-field:
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.
        otherwise return error.
    end case.
end procedure.

procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.

    case c-field:
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.
        otherwise return error.
    end case.
end procedure.

