/*******************************************************************************
**  BOCX115.i1 - Itinerario
** 
*******************************************************************************/

{cdp/cdcfgmat.i} /* definicao de pre-processador */

&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.005
&scoped-define FIRST-TABLE-IN-QUERY itinerario
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME itinerario


def var c-desc-itiner-ini as char no-undo.
def var c-desc-itiner-fim as char no-undo.
def var c-cod-itiner-ini as integer no-undo.
def var c-cod-itiner-fim as integer no-undo.
{include/boini.i}

{cxbo/bocx115.i RowObject}

DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

def temp-table tt-pto-itiner      no-undo like pto-itiner.
def temp-table tt-desp-itiner     no-undo like desp-itiner.
def temp-table tt-decl-itiner     no-undo like decl-itiner.
def temp-table tt-incoterm-itiner no-undo like incoterm-itiner.

define temp-table tt-pto-controle no-undo
    field pto_despacho 		as integer
    field pto_embarque 		as integer
    field pto_desembarque   as integer
    field pto_chegada       as integer.

def var i-cod-itiner as integer no-undo.

procedure setConstraint1:

end procedure.

procedure setConstraint2:
    def input parameter p-itiner as char no-undo.

    assign i-cod-itiner = int(p-itiner).
end procedure.

/*procedure setConstraint3:
 *     def input parameter r-chave as rowid no-undo.
 *     find pto-itiner no-lock where rowid(pto-itiner) = r-chave no-error.
 * end procedure. */

procedure setConstraint4:
def input parameter p-cod-itiner-ini as char no-undo.
def input parameter p-cod-itiner-fim as char no-undo.

assign c-cod-itiner-ini = integer(p-cod-itiner-ini)
       c-cod-itiner-fim = integer(p-cod-itiner-fim). 
end procedure.

procedure setConstraint5:
def input parameter p-desc-itiner-ini as char no-undo.
def input parameter p-desc-itiner-fim as char no-undo.

assign c-desc-itiner-ini = p-desc-itiner-ini
       c-desc-itiner-fim = p-desc-itiner-fim. 
end procedure.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where itinerario.cod-itiner >= i-cod-itiner no-lock by itinerario.cod-itiner.
        when 4 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where itinerario.cod-itiner >= c-cod-itiner-ini and
                                                                  itinerario.cod-itiner <= c-cod-itiner-fim no-lock 
                                                                      by itinerario.cod-itiner.
        when 5 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where itinerario.descricao >= c-desc-itiner-ini and
                                                                  itinerario.descricao <= c-desc-itiner-fim no-lock
                                                                      by itinerario.descricao 
                                                                         by itinerario.cod-itiner.
                                                                                                                                
   end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.

{include/bostrmet.i}
{include/boendmet.i}
&if defined(bf-mat-comex) &then    
