procedure initializeValidate:
    /*
    **  Inicializa Validate
    */

    run startMethod ("initializeValidade").

    run endMethod   ("initializeValidade").
end procedure.

procedure findCodigo:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    def input  parameter i-cod-itiner as inte no-undo.
    def output parameter c-return as char no-undo.
 
    run startMethod ("findCodigo").


    find itinerario where
        itinerario.cod-itiner = i-cod-itiner
        no-lock no-error.
    
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
        pre-processador em chamada de includes */
        {utp/ut-table.i mgcex itinerario 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
        run setCurrent.
    end.
    run endMethod ("findCodigo").

end procedure.

procedure findItinerario:
    /*
    **  retorna itinerario
    */
    def input  parameter i-cod-itiner as inte no-undo.
	def output param table for tt-pto-controle. 
 
    run startMethod ("findItinerario").

	find first itinerario where
		itinerario.cod-itiner = i-cod-itiner
		no-lock no-error.
	
	if avail itinerario then do:
		create tt-pto-controle.
		assign tt-pto-controle.pto_despacho = itinerario.pto-despacho
			   tt-pto-controle.pto_embarque = itinerario.pto-embarque
			   tt-pto-controle.pto_desembarque = itinerario.pto-desembarque
			   tt-pto-controle.pto_chegada = itinerario.pto-chegada.
	end.
	
   run endMethod ("findItinerario").

end procedure.

procedure validateFields:
    /*
    **  Valida Fields
    */

    def var c-return as char no-undo.
    def var i-seqdespacho as integer no-undo.
    def var i-seqembarque as integer no-undo.
    def var i-seqdesembarque as integer no-undo.
    def var i-seqchegada as integer no-undo.

    run startMethod ("ValidadeFielsd").

    if rowObject.descricao = "" then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex itinerario descricao 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.

    /******************************
    if rowObject.pto-despacho <> 0 then do:
    
       if not can-find(pto-itiner where pto-itiner.cod-itiner    = rowObject.cod-itiner and
                                        pto-itiner.cod-pto-contr = rowObject.pto-despacho) then do:
          assign i-seq-erro = i-seq-erro + 1.
          /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
             pre-processador em chamada de includes */
          {utp/ut-field.i mgcex itinerario pto-despacho 1}
          /******************************************/
          assign c-return = return-value.
          {utp/ut-liter.i Pontos_do_Itinerario * 1}
          run utp/ut-msgs.p (input "msg",
                             input 15839,
                             input c-return + "~~" + return-value ).
          create tt-bo-erro.
          assign tt-bo-erro.i-sequen = i-seq-erro
                 tt-bo-erro.cd-erro  = 15839
                 tt-bo-erro.mensagem = return-value.
       end.
    
    end.

    if rowObject.pto-embarque <> 0 then do:
     
       if not can-find(pto-itiner where pto-itiner.cod-itiner = rowObject.cod-itiner and
                                        pto-itiner.cod-pto-contr = rowObject.pto-embarque) then do:
          assign i-seq-erro = i-seq-erro + 1.
          /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
             pre-processador em chamada de includes */
          {utp/ut-field.i mgcex itinerario pto-embarque 1}
          /******************************************/
          assign c-return = return-value.
          {utp/ut-liter.i Pontos_do_Itinerario * 1}
          run utp/ut-msgs.p (input "msg",
                             input 15839,
                             input c-return + "~~" + return-value ).
          create tt-bo-erro.
          assign tt-bo-erro.i-sequen = i-seq-erro
                 tt-bo-erro.cd-erro  = 15839
                 tt-bo-erro.mensagem = return-value.
       end.
    
    end.

    if rowObject.pto-desembarque <> 0 then do:
    
       if not can-find(pto-itiner where pto-itiner.cod-itiner    = rowObject.cod-itiner and
                                        pto-itiner.cod-pto-contr = rowObject.pto-desembarque) then do:
          assign i-seq-erro = i-seq-erro + 1.
          /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
             pre-processador em chamada de includes */
          {utp/ut-field.i mgcex itinerario pto-embarque 1}
          /******************************************/
          assign c-return = return-value.
          {utp/ut-liter.i Pontos_do_Itinerario * 1}
          run utp/ut-msgs.p (input "msg",
                             input 15839,
                             input c-return + "~~" + return-value ).
          create tt-bo-erro.
          assign tt-bo-erro.i-sequen = i-seq-erro
                 tt-bo-erro.cd-erro  = 15839
                 tt-bo-erro.mensagem = return-value.
       end.
    
    end.

    if rowObject.pto-chegada <> 0 then do:
     
       if not can-find(pto-itiner where pto-itiner.cod-itiner    = rowObject.cod-itiner and
                                        pto-itiner.cod-pto-contr = rowObject.pto-chegada) then do:
          assign i-seq-erro = i-seq-erro + 1.
          /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
             pre-processador em chamada de includes */
          {utp/ut-field.i mgcex itinerario pto-embarque 1}
          /******************************************/
          assign c-return = return-value.
          {utp/ut-liter.i Pontos_do_Itinerario * 1}          
          run utp/ut-msgs.p (input "msg",
                             input 15839,
                             input c-return + "~~" + return-value ).
          create tt-bo-erro.
          assign tt-bo-erro.i-sequen = i-seq-erro
                 tt-bo-erro.cd-erro  = 15839
                 tt-bo-erro.mensagem = return-value.
       end.
   
    end.
    ******************************/

    if not can-find(first tt-bo-erro) then do:
       find pto-itiner where pto-itiner.cod-itiner    = rowObject.cod-itiner and
                             pto-itiner.cod-pto-contr = rowObject.pto-despacho no-lock no-error.
       if avail pto-itiner then
         assign i-seqdespacho = pto-itiner.sequencia.
       find pto-itiner where pto-itiner.cod-itiner   = rowObject.cod-itiner and
                             pto-itiner.cod-pto-contr = rowObject.pto-embarque no-lock no-error.
       if avail pto-itiner then
         assign i-seqembarque  = pto-itiner.sequencia.
       find pto-itiner where pto-itiner.cod-itiner    = rowObject.cod-itiner and
                             pto-itiner.cod-pto-contr = rowObject.pto-desembarque no-lock no-error.
       if avail pto-itiner then
         assign i-seqdesembarque = pto-itiner.sequencia.
       find pto-itiner where pto-itiner.cod-itiner    = rowObject.cod-itiner and
                             pto-itiner.cod-pto-contr = rowObject.pto-chegada no-lock no-error.
       if avail pto-itiner then
         assign i-seqchegada = pto-itiner.sequencia.

       if i-seqdespacho <> 0 then
         if ((i-seqdespacho > i-seqembarque and i-seqembarque <> 0) or
             (i-seqdespacho > i-seqdesembarque and i-seqdesembarque <> 0) or
             (i-seqdespacho > i-seqchegada and i-seqchegada <> 0)) then do:
           assign i-seq-erro = i-seq-erro + 1.
           {utp/ut-liter.i Sequencia_ponto_despacho }
           run utp/ut-msgs.p (input "msg",
                              input 7975,
                              input return-value ).
           create tt-bo-erro.
           assign tt-bo-erro.i-sequen = i-seq-erro
                  tt-bo-erro.cd-erro  = 7975
                  tt-bo-erro.mensagem = return-value.
         end.

       if i-seqembarque <> 0 then
         if ((i-seqembarque < i-seqdespacho and i-seqdespacho <> 0) or
             (i-seqembarque > i-seqdesembarque and i-seqdesembarque <> 0) or
             (i-seqembarque > i-seqchegada and i-seqchegada <> 0)) then do:
           assign i-seq-erro = i-seq-erro + 1.
           {utp/ut-liter.i Sequencia_ponto_embarque }
           run utp/ut-msgs.p (input "msg",
                              input 7975,
                              input return-value ).
           create tt-bo-erro.
           assign tt-bo-erro.i-sequen = i-seq-erro
                  tt-bo-erro.cd-erro  = 7975
                  tt-bo-erro.mensagem = return-value.
         end.

       if i-seqdesembarque <> 0 then
         if ((i-seqdesembarque < i-seqdespacho and i-seqdespacho <> 0) or
             (i-seqdesembarque < i-seqembarque and i-seqembarque <> 0) or
             (i-seqdesembarque > i-seqchegada and i-seqchegada <> 0)) then do:
           assign i-seq-erro = i-seq-erro + 1.
           {utp/ut-liter.i Sequencia_ponto_deembarque }
           run utp/ut-msgs.p (input "msg",
                              input 7975,
                              input return-value ).
           create tt-bo-erro.
           assign tt-bo-erro.i-sequen = i-seq-erro
                  tt-bo-erro.cd-erro  = 7975
                  tt-bo-erro.mensagem = return-value.
         end.

       if i-seqchegada <> 0 then
         if ((i-seqchegada < i-seqdespacho and i-seqdespacho <> 0) or
             (i-seqchegada < i-seqembarque and i-seqembarque <> 0) or
             (i-seqchegada < i-seqdesembarque and i-seqdesembarque <> 0)) then do:
           assign i-seq-erro = i-seq-erro + 1.
           {utp/ut-liter.i Sequencia_ponto_chegada }
           run utp/ut-msgs.p (input "msg",
                              input 7975,
                              input return-value ).
           create tt-bo-erro.
           assign tt-bo-erro.i-sequen = i-seq-erro
                  tt-bo-erro.cd-erro  = 7975
                  tt-bo-erro.mensagem = return-value.
         end.
    end.
  
    run endMethod ("validateFields").
end procedure.

procedure validateUpdate:
    /*
    **  Valida Update
    */
    
    def input parameter table for RowObject.
    def input parameter r-chave as rowid no-undo.
    def output parameter table for tt-bo-erro.
    find first rowObject
        no-lock no-error.

    run InitializeValidate.
 
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    run validateFields.

    find first tt-bo-erro
        no-lock no-error.
    if not avail tt-bo-erro then do:
        find {&TABLE-NAME} exclusive-lock where
            rowid({&TABLE-NAME}) = r-chave no-error no-wait.
        if locked({&table-name}) then do:
            assign i-seq-erro = i-seq-erro + 1.    
            run utp/ut-msgs.p (input "msg",
	                       input 16096,
 			       input "").
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen = i-seq-erro
  	           tt-bo-erro.cd-erro  = 16096
 	           tt-bo-erro.mensagem = return-value.                
        end.
        else 
	    if avail {&table-name} then
                run executeUpdate.    
    end.
    
end procedure.

procedure validateDelete:
    /*
    **  Valida Delete
    */
    def input-output parameter r-chave as rowid.
    def output parameter table for tt-bo-erro.
        
    def var r-pto-itiner as rowid no-undo.
    def var h-bocx120 as handle no-undo.
    def var c-tabela as char no-undo.

    run startMethod ("ValidateDelete").

    run InitializeValidate.
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

    find {&TABLE-NAME} exclusive-lock
         where rowid({&TABLE-NAME}) = r-chave no-error no-wait.
    if locked({&table-name}) then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
	                    input 16096,
	                    input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen  = i-seq-erro
               tt-bo-erro.cd-erro   = 16096
               tt-bo-erro.mensagem  = return-value.
    end.

    if avail {&table-name} then do:                
        if can-find(first cotacao-item-cex where cotacao-item-cex.cod-itiner = {&table-name}.cod-itiner) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex itinerario 1}
            /******************************************/
            assign c-tabela = return-value.            
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex cotacao-item-cex 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 5,
                               input c-tabela + "~~" + return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen  = i-seq-erro
                   tt-bo-erro.cd-erro   = 5
                   tt-bo-erro.mensagem  = return-value.
        end.
        if can-find(first desp-item where desp-item.cod-itiner = {&table-name}.cod-itiner) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex itinerario 1}
            /******************************************/
            assign c-tabela = return-value.                        
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex desp-item 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 5,
                               input c-tabela + "~~" + return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen  = i-seq-erro
                   tt-bo-erro.cd-erro   = 5
                   tt-bo-erro.mensagem  = return-value.
        end.
        if can-find(first tb-pr-cex where tb-pr-cex.cod-itiner = {&table-name}.cod-itiner) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex itinerario 1}
            /******************************************/
            assign c-tabela = return-value.             
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex tb-pr-cex 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 5,
                               input c-tabela + "~~" + return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen  = i-seq-erro
                   tt-bo-erro.cd-erro   = 5
                   tt-bo-erro.mensagem  = return-value.
        end.            
        if can-find(first processo-imp where processo-imp.cod-itiner = {&table-name}.cod-itiner) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
