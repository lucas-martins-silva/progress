DEF VAR c-formula-pis-param-imp      AS CHAR NO-UNDO.

DEF VAR i-trib-cofins-param-imp         AS INTEGER NO-UNDO.
DEF VAR da-ini-cofins-param-imp         AS DATE FORMAT "99/99/9999" NO-UNDO.
DEF VAR l-inc-cofins-base-icm-param-imp AS LOGICAL NO-UNDO.
DEF VAR c-formula-cofins-param-imp      AS CHAR NO-UNDO.
