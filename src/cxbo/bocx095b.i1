/*
**
**  BOCX095B.i1 - Calcula o valor das despesas de importacao (desp-imp)
**
*/
{cdp/cdcfgmat.i} /* include preprocessadores magnus */

/*********************** Definicao Tabelas Temporarias ***************************/
{cxbo/bocx095b.i}
{cxbo/bocx095a.i} 

/*********************** Definicao Parametros ************************************/
def input  parameter table for tt-parametros.
def input  parameter table for tt-parametros-imp.
def input  parameter table for tt-parametros-exp.
def output parameter d-valor-despesa like desp-imp.val-desp no-undo.
def output parameter table for tt-erro.

&if "{&bf_mat_versao_ems}":U < "2.062":U &then

/*********************** Definicao Variaveis *************************************/
{cdp/cd4300.i3}     /* include tratamento atributo livre */
{cxbo/bocx250.i50}  /* include tratamento atributo livre */

def var i-seq            as   integer           no-undo.
def var d-quantidade     as   decimal           no-undo.
def var d-formula1       like desp-imp.val-desp no-undo.
def var d-formula2       like desp-imp.val-desp no-undo.
def var d-formula3       like desp-imp.val-desp no-undo.
def var d-formula4       like desp-imp.val-desp no-undo.
def var d-formula5       like desp-imp.val-desp no-undo.
def var d-val-desp-temp  like desp-imp.val-desp no-undo.
def var i-cont           as   integer           no-undo.
def var i-cod-desp-temp  like desp-imp.cod-desp no-undo.
def var de-val-desp-conv like cotacao-item-cex.val-desp no-undo.
def var de-val-desp      like cotacao-item-cex.val-desp no-undo.
def var de-quant-total   like prazo-compra.quantidade no-undo.

/*********************** Execucao ************************************************/
find first tt-parametros     no-error.
find first tt-parametros-imp no-error.
find first tt-parametros-exp no-error.

main-block:
do:
    /*
    ** Valida versÆo de integra‡Æo
    */
    if tt-parametros.cod-versao-integracao <> 2 then do:
        create tt-erro.    
        run utp/ut-msgs.p (input "msg":U,
                           input 3941,
                           input "":U).
        assign tt-erro.i-sequen = 1
               tt-erro.cd-erro  = 3941
               tt-erro.mensagem = return-value.
        undo, return.
    end.    
    
    if avail tt-parametros then do:
    
        find desp-imp 
            where desp-imp.cod-desp = tt-parametros.cod-desp no-lock no-error.            
                
        if avail desp-imp then do:
        
            /* 
            ** Tratamento Imposto de Importa‡Æo, IPI, ICMS, PIS e COFINS 
            */
            if  substr(tt-parametros.modulo,1,3) = "imp":U then do:
            
                find ordem-compra
                    where ordem-compra.numero-ordem = tt-parametros-imp.numero-ordem no-lock no-error.
                if avail ordem-compra then
                    find param-imp 
                        where param-imp.cod-estabel = ordem-compra.cod-estabel no-lock no-error.
                if avail param-imp then do:

                    {cdp/cd4300.i4 "yes" param-imp.char-1}
                    {cxbo/bocx250.i51 "yes"}

                    if tt-parametros.cod-desp = i-desp-ii-i50 then do:

                        find cotacao-item
                            where cotacao-item.numero-ordem = tt-parametros-imp.numero-ordem 
                              and cotacao-item.cod-emitente = tt-parametros.cod-emitente
                              and cotacao-item.it-codigo    = tt-parametros-imp.it-codigo
                            &if defined(bf-mat-comex) &then
                              and cotacao-item.data-cotacao = tt-parametros-imp.data no-lock no-error.
                            &else
                              and cotacao-item.seq-cotac    = tt-parametros-imp.seq-cotac no-lock no-error.
                            &endif
                        /*
                        ** C lculo Imposto Importa‡Æo Unit rio
                        */

                        run imp/im0090.p (input tt-parametros.cod-desp,
                                          input rowid(cotacao-item),
                                          input tt-parametros-imp.mapa-cotacao,
                                          output d-valor-despesa,
                                          output table tt-erro).
                        return.
                    end.
                    /*--- Eng geracao Impto Padrao ---*/
                    &if "{&bf_mat_versao_ems}":U >= "2.062":U &then
                  
                    /*--- calcula valor do IPI ou ICMS ---*/
                    else 
                        if  tt-parametros.cod-desp = param-imp.cdn-despes-impto-ipi
                        or  tt-parametros.cod-desp = param-imp.cdn-despes-impto-icms then do:

                            if  num-entries(tt-parametros.modulo,"|") > 1 then do:
                                find cotacao-item-cex 
                                    where rowid(cotacao-item-cex) = to-rowid(entry(2,tt-parametros.modulo,"|")) no-lock no-error.
                                if  avail cotacao-item-cex then
                                    /*--- calcula valor do IPI ou ICMS ---*/
                                    run imp/imapi007.p (input buffer cotacao-item-cex:handle,
                                                        input tt-parametros.cod-desp,
                                                        input 0,
                                                        input 0,
                                                        output d-valor-despesa).
                            end.
                            else
                                run imp/imapi007.p (input buffer tt-parametros-imp:handle,
                                                    input tt-parametros.cod-desp,
                                                    input 0,
                                                    input 0,
                                                    output d-valor-despesa).
    
                            return.
                        end.
                        /*--- calcula PIS ou COFINS ---*/
                        else 
                            if  tt-parametros.cod-desp = param-imp.cdn-despes-impto-pis 
                            or  tt-parametros.cod-desp = param-imp.cdn-despes-impto-cofins then do:
    
                                if  num-entries(tt-parametros.modulo,"|") > 1 then do:

                                    find cotacao-item-cex 
                                        where rowid(cotacao-item-cex) = to-rowid(entry(2,tt-parametros.modulo,"|")) no-lock no-error.
                                    if  avail cotacao-item-cex then
                                        /*--- calcula valores das despesas dos
                                              impostos PIS ou COFINS. ---*/
                                        run imp/imapi008.p (input buffer cotacao-item-cex:handle,
                                                            input tt-parametros.cod-desp,
                                                            input tt-parametros.cod-emitente,
                                                            input 0,
                                                            input 0,
                                                            output d-valor-despesa).
                                end.
                                else
                                     run imp/imapi008.p (input buffer tt-parametros-imp:handle,
                                                         input tt-parametros.cod-desp,
                                                         input tt-parametros.cod-emitente,
                                                         input 0,
                                                         input 0,
                                                         output d-valor-despesa).
                                return.
                            end.
                    &endif
                end.
            end.
            
            /*
            ** Tratamento despesa do tipo f¢rmula
            */                    
            if desp-imp.tipo = 8 then do:
                assign i-cod-desp-temp = tt-parametros.cod-desp.
                for each form-desp-imp no-lock
                    where form-desp-imp.cod-desp = i-cod-desp-temp 
                      and not can-find(first tt-erro):                                          
                    assign i-cont          = 1
                           d-valor-despesa = 0.
                    do while i-cont < 6 and not can-find(first tt-erro):                                                     
                        assign d-valor-despesa = 0.
                                                
                        find desp-imp no-lock
                            where desp-imp.cod-desp = form-desp-imp.cod-desp-form[i-cont] no-error.
                        if not avail desp-imp then do:
                            /*
                            ** S¢ cria erro se componente da f¢rmula for diferente de 0 e nÆo existir
                            */
                            if form-desp-imp.cod-desp-form[i-cont] <> 0 then do:
                                /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
                                {utp/ut-table.i mgcex desp-imp 1}
                                assign i-seq = i-seq + 1.
                                create tt-erro.
                                assign tt-erro.parametros = trim(return-value) + "~~" + string(form-desp-imp.cod-desp-form[i-cont]).
                                run utp/ut-msgs.p (input "msg":U,
                                                   input 2,
                                                   input tt-erro.parametros).
                                assign tt-erro.i-sequen     = i-seq
                                       tt-erro.cd-erro      = 2
                                       tt-erro.mensagem     = return-value.
                            end.                                       
                        end.
                        else do:
                            assign tt-parametros.cod-desp = desp-imp.cod-desp.                           
                            if desp-imp.tipo = 8 then do:
                                if can-find(first tt-pendentes-095 where tt-pendentes-095.cod-desp = tt-parametros.cod-desp) then do:
                                    assign i-seq = i-seq + 1.  
                                    create tt-erro.
                                    assign tt-erro.parametros = string(desp-imp.cod-desp).
                                    run utp/ut-msgs.p (input "msg":U,
                                                       input 17110,
                                                       input tt-erro.parametros).                                    
                                    assign tt-erro.i-sequen     = i-seq
                                           tt-erro.cd-erro      = 17110
                                           tt-erro.mensagem     = return-value.               
                                end.       
                                else do:
                                    create tt-pendentes-095.
                                    assign tt-pendentes-095.cod-desp = tt-parametros.cod-desp.        
                                    run cxbo/bocx095b.p(input table tt-parametros,
                                                        input table tt-parametros-imp,
                                                        input table tt-parametros-exp,
                                                        output d-valor-despesa,
                                                        output table tt-erro).
                                    if d-valor-despesa = ? then
                                        assign d-valor-despesa = 0.
                                end.
                                find tt-pendentes-095 where tt-pendentes-095.cod-desp = tt-parametros.cod-desp no-error.
                                if avail tt-pendentes-095 then 
                                    delete tt-pendentes-095.                                    
                            end. /* desp-imp.tipo = 8 */
                            else do:
                                create tt-pendentes-095.
                                assign tt-pendentes-095.cod-desp = tt-parametros.cod-desp.
                                run cxbo/bocx095b.p(input table tt-parametros,
                                                    input table tt-parametros-imp,
                                                    input table tt-parametros-exp,
                                                    output d-valor-despesa,
                                                    output table tt-erro).
                                if d-valor-despesa = ? then
                                    assign d-valor-despesa = 0.
                                find tt-pendentes-095 where tt-pendentes-095.cod-desp = tt-parametros.cod-desp no-error.
                                if avail tt-pendentes-095 then 
                                    delete tt-pendentes-095.
                            end.
                        end. /* else do:*/
                        case i-cont:
                            when 1 then if form-desp-imp.cod-desp-form[1] = 0 then assign d-formula1 = 0.
                                        else assign d-formula1 = d-valor-despesa.                     
                            when 2 then if form-desp-imp.cod-desp-form[2] = 0 then assign d-formula2 = 0.
                                        else assign d-formula2 = d-valor-despesa.                               
                            when 3 then if form-desp-imp.cod-desp-form[3] = 0 then assign d-formula3 = 0.
                                        else assign d-formula3 = d-valor-despesa.                     
                            when 4 then if form-desp-imp.cod-desp-form[4] = 0 then assign d-formula4 = 1.
                                        else assign d-formula4 = d-valor-despesa.                              
                            when 5 then if form-desp-imp.cod-desp-form[5] = 0 then assign d-formula5 = 1.
                                        else assign d-formula5 = d-valor-despesa.                     
                        end.                    
                        assign i-cont = i-cont + 1.
                    end. /* do while i-cont */                 
                    assign d-val-desp-temp = d-val-desp-temp + 
                            (( ((d-formula1 + d-formula2 - d-formula3) * d-formula4) / d-formula5 ) 
                            * form-desp-imp.fat-ponder).
                end. /*for each form-desp-imp*/
            
                if not can-find(first tt-erro) then do:
                    assign tt-parametros.cod-desp = i-cod-desp-temp.
                    find desp-imp no-lock 
                        where desp-imp.cod-desp = tt-parametros.cod-desp no-error.
                    if avail desp-imp then
                        assign d-val-desp-temp = d-val-desp-temp * desp-imp.fat-ponder 
                               d-valor-despesa = d-val-desp-temp.
                end. /* if not can-find */
                                
            end. /* if desp-imp.tipo = 8 */
            else do:
            
                if tt-parametros.modulo = "exp":U then do:
                    find first tb-pr-cex no-lock
                        where tb-pr-cex.cod-emitente = tt-parametros.cod-emitente 
                          and tb-pr-cex.cod-itiner   = tt-parametros.cod-itiner 
                          and tb-pr-cex.cod-incoterm = tt-parametros.cod-incoterm 
                          no-error.
                    if not avail tb-pr-cex then
                        find first tb-pr-cex no-lock
                            where tb-pr-cex.cod-emitente = tt-parametros.cod-emitente 
                              and tb-pr-cex.cod-incoterm = tt-parametros.cod-incoterm 
                              no-error.
                        if not avail tb-pr-cex then 
                            find first tb-pr-cex no-lock
                                where tb-pr-cex.cod-emitente = tt-parametros.cod-emitente 
                                  and tb-pr-cex.cod-itiner   = tt-parametros.cod-itiner 
                                  no-error.
                        if not avail tb-pr-cex then                            
                            find first tb-pr-cex no-lock
                                where tb-pr-cex.cod-itiner   = tt-parametros.cod-itiner 
                                  and tb-pr-cex.cod-incoterm = tt-parametros.cod-incoterm 
                                  no-error.
                        if not avail tb-pr-cex then leave main-block.           
                end.
                
                if substring(tt-parametros.modulo,1,3) = "imp":U then do:
                    find first tt-parametros-imp 
                        no-lock no-error.
                        
                    /*
                    ** Verifica se a despesa foi cotada anteriormente
                    */                        
                    find cotacao-item-cex
                        where cotacao-item-cex.numero-ordem = tt-parametros-imp.numero-ordem
                          and cotacao-item-cex.cod-emitente = tt-parametros.cod-emitente 
                        &if defined(bf-mat-comex) &then                          
                          and cotacao-item-cex.data-cotacao = tt-parametros-imp.data
                        &else
                          and cotacao-item-cex.seq-cotac    = tt-parametros-imp.seq-cotac
                        &endif 
                          and cotacao-item-cex.it-codigo    = tt-parametros-imp.it-codigo
                          and cotacao-item-cex.mapa-cotacao = tt-parametros-imp.mapa-cotacao
                          and cotacao-item-cex.cod-desp     = tt-parametros.cod-desp
                          no-lock no-error.
                    if avail cotacao-item-cex then do:
                        assign de-val-desp-conv = cotacao-item-cex.val-desp.
                        if cotacao-item-cex.mo-codigo <> 0 then do:
                            run cdp/cd0812.p (input cotacao-item-cex.mo-codigo,
                                              input 0,
                                              input cotacao-item-cex.val-desp,
                                              input today,
                                              output de-val-desp-conv).
                            if de-val-desp-conv = 0 or
                               de-val-desp-conv = ? then
                                assign de-val-desp-conv = cotacao-item-cex.val-desp.
                        end.
                        assign d-valor-despesa = de-val-desp-conv.
                    end.
                    
                    if d-valor-despesa = 0 then do:
                        for each prazo-compra
                           where prazo-compra.numero-ordem = tt-parametros-imp.numero-ordem no-lock:
                               assign de-quant-total = de-quant-total + prazo-compra.quantidade.
                        end.
                        find cot-ordem
                            where cot-ordem.numero-ordem = tt-parametros-imp.numero-ordem
                              and cot-ordem.cod-emitente = tt-parametros.cod-emitente
                            &if defined(bf-mat-comex) &then
                              and cot-ordem.data-1       = tt-parametros-imp.data
                            &else                              
                              and cot-ordem.seq-cotac    = tt-parametros-imp.seq-cotac
                            &endif
                              and cot-ordem.mapa-ordem   = tt-parametros-imp.mapa-cotacao
                              no-lock no-error.
                        if avail cot-ordem then                              
                            find desp-cot-ordem
                                where desp-cot-ordem.cod-agrup         = cot-ordem.cod-agrup
                                  and desp-cot-ordem.mapa-ordem        = cot-ordem.mapa-ordem
                                  and desp-cot-ordem.cod-desp          = tt-parametros.cod-desp
                                  no-lock no-error.
                        if avail desp-cot-ordem then do:
                            assign de-val-desp-conv = desp-cot-ordem.val-desp.
                            find desp-imp where 
                                 desp-imp.cod-desp = desp-cot-ordem.cod-desp no-lock no-error.
                            if avail desp-imp then do:
                               if desp-imp.tipo = 1 or desp-imp.tipo = 8 then 
                                   assign de-val-desp = de-val-desp-conv.
                               else
                                   assign de-val-desp = de-val-desp-conv / de-quant-total.
                            end.
                            if desp-cot-ordem.mo-codigo <> 0 then do:
                                run cdp/cd0812.p (input desp-cot-ordem.mo-codigo,
                                                  input 0,
                                                  input de-val-desp,
                                                  input today,
                                                  output de-val-desp-conv).
                                if de-val-desp-conv = 0 or
                                   de-val-desp-conv = ? then
                                    assign de-val-desp-conv = de-val-desp.
                            end.
                            assign d-valor-despesa = de-val-desp-conv.
                        end.
                    end.
                    if d-valor-despesa = 0 
                    AND NOT CAN-FIND(FIRST tt-pendentes-095) then
                        /*
                        ** Verifica valor na tabela de pre‡o
                        */ 
                        find tb-pr-cex no-lock
                            where tb-pr-cex.cod-emitente = tt-parametros.cod-emitente-desp 
                              and tb-pr-cex.cod-itiner   = tt-parametros.cod-itiner 
                              and tb-pr-cex.cod-incoterm = tt-parametros.cod-incoterm 
                              and tb-pr-cex.nr-tab       = tt-parametros.nr-tab 
                              no-error.
                        if not avail tb-pr-cex then
                            find tb-pr-cex no-lock
                                where tb-pr-cex.cod-emitente = tt-parametros.cod-emitente-desp 
                                  and tb-pr-cex.cod-itiner   = tt-parametros.cod-itiner 
                                  and tb-pr-cex.cod-incoterm = ""
                                  and tb-pr-cex.nr-tab       = tt-parametros.nr-tab 
                                  no-error.
                        if not avail tb-pr-cex then
                            find tb-pr-cex no-lock
                                where tb-pr-cex.cod-emitente = tt-parametros.cod-emitente-desp 
                                  and tb-pr-cex.cod-itiner   = 0
                                  and tb-pr-cex.cod-incoterm = tt-parametros.cod-incoterm
                                  and tb-pr-cex.nr-tab       = tt-parametros.nr-tab 
                                  no-error.
                        if not avail tb-pr-cex then
                            find tb-pr-cex no-lock
                                where tb-pr-cex.cod-emitente = tt-parametros.cod-emitente-desp 
                                  and tb-pr-cex.cod-itiner   = 0
                                  and tb-pr-cex.cod-incoterm = ""
                                  and tb-pr-cex.nr-tab       = tt-parametros.nr-tab 
                                  no-error.
                end.
             
                if avail tb-pr-cex then do:             
                    assign d-valor-despesa = 0.
                    find desp-tb-pr-cex no-lock
                        where desp-tb-pr-cex.cod-emitente = tb-pr-cex.cod-emitente 
                          and desp-tb-pr-cex.cod-itiner   = tb-pr-cex.cod-itiner 
                          and desp-tb-pr-cex.cod-incoterm = tb-pr-cex.cod-incoterm 
                          and desp-tb-pr-cex.nr-tab       = tb-pr-cex.nr-tab 
                          and desp-tb-pr-cex.cod-desp     = tt-parametros.cod-desp 
                          no-error.
                    if not avail desp-tb-pr-cex and tt-parametros.modulo = "exp":U then do:
                        find first desp-tb-pr-cex no-lock
                            where desp-tb-pr-cex.cod-itiner   = tb-pr-cex.cod-itiner 
                              and desp-tb-pr-cex.cod-incoterm = tb-pr-cex.cod-incoterm 
                              and desp-tb-pr-cex.nr-tab       = tb-pr-cex.nr-tab 
                              and desp-tb-pr-cex.cod-desp     = tt-parametros.cod-desp 
                              no-error.
                        if not avail desp-tb-pr-cex then leave main-block. 
                    end.
                    if avail desp-tb-pr-cex then 
                        if desp-tb-pr-cex.situacao = 1 then do:
                            assign de-val-desp-conv = desp-tb-pr-cex.val-desp.
                            if substring(tt-parametros.modulo,1,3) = "imp":U then
                                if tb-pr-cex.mo-codigo <> 0 then do:
                                    run cdp/cd0812.p (input tb-pr-cex.mo-codigo,
                                                      input 0,
                                                      input desp-tb-pr-cex.val-desp,
                                                      input today,
                                                      output de-val-desp-conv).
                                    if de-val-desp-conv = 0 or
                                       de-val-desp-conv = ? then
                                        assign de-val-desp-conv = desp-tb-pr-cex.val-desp.
                                end.
                            assign d-valor-despesa = de-val-desp-conv.
                    end.
                end.
              
                if can-find(first tt-pendentes-095) then leave.
            
                find desp-imp no-lock where desp-imp.cod-desp = tt-parametros.cod-desp no-error.
                case desp-imp.tipo:
                    /* Valor Fixo */
                    when 1 then
                         assign d-valor-despesa = d-valor-despesa * desp-imp.fat-ponder.
                    /* Taxa sobre peso */
                    when 3 then
                         assign d-valor-despesa = d-valor-despesa * tt-parametros.peso * desp-imp.fat-ponder.
                    /* Taxa sobre distancia */
                    when 4 then do:
                         find itinerario no-lock
                              where itinerario.cod-itiner = tt-parametros.cod-itiner no-error.
                         if avail itinerario then 
                            assign d-valor-despesa = d-valor-despesa * itinerario.distancia * desp-imp.fat-ponder.
                    end.             
                    /* Taxa sobre dias */              
                    when 5 then do:
                         find itinerario no-lock
                              where itinerario.cod-itiner = tt-parametros.cod-itiner no-error.
                         if avail itinerario then
                            assign d-valor-despesa = d-valor-despesa * itinerario.nr-dias * desp-imp.fat-ponder.
                    end.
                    /* Taxa sobre quantidade */
                    when 6 then
                         assign d-valor-despesa = d-valor-despesa * desp-imp.fat-ponder.
                    /* Adicional sobre valor */
                    when 7 then
                         assign d-valor-despesa = tt-parametros.valor * desp-imp.fat-ponder.
                    /* Taxa sobre cubagem */                         
                    when 9 then
                         assign d-valor-despesa = d-valor-despesa * tt-parametros.volume * desp-imp.fat-ponder.
                end case. /* case desp-imp.tipo */                
                
                /*********************************************************************
                * Na Exportacao e Importacao, se  o valor do calculo da  despesa for *
                * menor que o  valor minimo na tabela  de precos, entao              *
                * o fornecedor pagara o valor minimo determinado.                    *
                *********************************************************************/
                
                if avail desp-tb-pr-cex then do:
                    if d-valor-despesa < desp-tb-pr-cex.val-min-desp then
                        assign d-valor-despesa = desp-tb-pr-cex.val-min-desp.
                end.
                
            end. /*else do */
            
        end. /* avail desp-imp */            
        else do: /* avail desp-imp */                
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
            {utp/ut-table.i mgcex desp-imp 1}
            /*********************************/
            assign i-seq = i-seq + 1.
            create tt-erro.
            assign tt-erro.parametros = trim(return-value) + "~~" + string(tt-parametros.cod-desp).
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input tt-erro.parametros).
            assign tt-erro.i-sequen     = i-seq
                   tt-erro.cd-erro      = 2
                   tt-erro.mensagem     = return-value.
        end. /* else do */
        
    end. /* if avail tt-parametros*/
    
end. /* do main-block */

&endif  /* "{&bf_mat_versao_ems}":U < "2.062":U */

