&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getKey DBOProgram  
PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice dtmdct_id2
  Parameters:  
               retorna valor do campo cdd-due-ems
               retorna valor do campo num-versao-due
               retorna valor do campo num-seq-it-due
               retorna valor do campo idi-tip-docto
               retorna valor do campo cod-docto
               retorna valor do campo cod-adic
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pcdd-due-ems LIKE due-item-docto.cdd-due-ems NO-UNDO.
    DEFINE OUTPUT PARAMETER pnum-versao-due LIKE due-item-docto.num-versao-due NO-UNDO.
    DEFINE OUTPUT PARAMETER pnum-seq-it-due LIKE due-item-docto.num-seq-it-due NO-UNDO.
    DEFINE OUTPUT PARAMETER pidi-tip-docto LIKE due-item-docto.idi-tip-docto NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-docto LIKE due-item-docto.cod-docto NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-adic LIKE due-item-docto.cod-adic NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pcdd-due-ems = RowObject.cdd-due-ems
           pnum-versao-due = RowObject.num-versao-due
           pnum-seq-it-due = RowObject.num-seq-it-due
           pidi-tip-docto = RowObject.idi-tip-docto
           pcod-docto = RowObject.cod-docto
           pcod-adic = RowObject.cod-adic.

    RETURN "OK":U.
END PROCEDURE.

