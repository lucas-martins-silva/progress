**  BOCX155A.P
**
**  emitente-cex - Emitente Comercio Exterior - Clientes
*********************************************************************************/

&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.000
&scoped-define FIRST-TABLE-IN-QUERY emitente-cex
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME emitente-cex

{cdp/cdcfgdis.i}
{cdp/cdcfgmat.i}
{cdp/cdcfgcex.i}

&IF INTEGER(ENTRY(1,PROVERSION,".")) >= 9 &THEN
   &GLOBAL-DEFINE v9indrep 
&endif

{include/boini.i}
{cxbo/bocx155.i RowObject}

def var i-cod-emitente-ini like emitente.cod-emitente no-undo.
def var i-cod-emitente-fim like emitente.cod-emitente no-undo.
def var l-create-folder as logical init no no-undo.
def var i-identific as integer no-undo.
def var i-program-aux as integer initial 0 no-undo.

/* DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling. */

DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME},
    emitente fields (cod-emitente identific) scrolling.

procedure setConstraint1:
end procedure.

procedure setConstraint2:
def input parameter p-cod-emitente-ini as char no-undo.
def input parameter p-cod-emitente-fim as char no-undo.

assign i-cod-emitente-ini = integer(p-cod-emitente-ini)
       i-cod-emitente-fim = integer(p-cod-emitente-fim).
    
end procedure.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock,
                each emitente no-lock where 
                     emitente.cod-emitente = {&TABLE-NAME}.cod-emitente
                     {&v9indrep}.
        when 2 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock where
                       {&TABLE-NAME}.cod-emitente >= i-cod-emitente-ini and
                       {&TABLE-NAME}.cod-emitente <= i-cod-emitente-fim ,
                 first emitente no-lock where 
                       emitente.cod-emitente = {&TABLE-NAME}.cod-emitente and
                       &if defined(bf-dis-comex) &then 
                           (emitente.identific = "C" or emitente.identific = "A")
                       &else
                           (emitente.identific = 1 or emitente.identific = 3)
                       &endif {&v9indrep}.
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.
 
{include/bostrmet.i}
{include/boendmet.i}
&if defined(bf-dis-comex) &then
&else
    {include/bocomver.i}
    {include/bogetver.i}
&endif
{include/bonav.i}
{include/bofind.i}
{include/bosetcur.i}
{include/bogetcur.i}
{include/bosersen.i}
{include/boprebro.i}
{include/boexedel.i}
{include/bovaldel.i}

procedure setEmitente:
/* 
** Seta se o emitente ‚ cliente ou fornecedor para a visualiza‡Æo.
*/
def input parameter p-identific as integer no-undo.

assign i-identific = p-identific.

end procedure.

procedure initializeValidate:
    /*
    **  Inicializa Validate
    */
     
    run startMethod ("initializeValidade").
 
    run endMethod   ("initializeValidade").
    
end procedure.

procedure returnNome-abrev:
    def input parameter p-chave as rowid no-undo.
    def output parameter p-nome-abrev like emitente.nome-abrev no-undo.    
    def var h-boad098 as handle no-undo.
    
    run findRowid(input p-chave).
    run adbo/boad098.p persistent set h-boad098.    
    run findCodigo in h-boad098(input rowObject.cod-emitente,output c-return).
    if c-return = "" then
        run getCharfield in h-boad098(input "nome-abrev",output p-nome-abrev).
    delete procedure h-boad098.    
end procedure.

procedure getCharField:
       define input parameter c-field as char.
       define output parameter c-value as char.
	
       case c-field:
	   when "cod-idioma" then c-value = RowObject.cod-idioma.
	   when "cod-incoterm-imp" then c-value = RowObject.cod-incoterm-imp.
	   when "cod-incoterm-exp" then c-value = RowObject.cod-incoterm-exp.
	   when "char-1" then c-value     = RowObject.char-1.
	   when "char-2" then c-value     = RowObject.char-2.
	   when "check-sum" then c-value  = RowObject.check-sum.
	   otherwise return error.
       end case.		
end procedure.
 
procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.
 
    case c-field:
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        otherwise return error.
    end case.
end procedure.

procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.
 
    case c-field:
        when "cod-emitente" then c-value = RowObject.cod-emitente.
        when "cod-repres" then c-value = RowObject.cod-repres.
	 when "cod-itiner-imp" then c-value = RowObject.cod-itiner-imp.    
	 when "cod-itiner-exp" then c-value = RowObject.cod-itiner-exp.
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.        
        otherwise return error.
    end case.
end procedure.
 
procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.
 
    case c-field:
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.        
        otherwise return error.
    end case.
end procedure.

procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.
 
    case c-field:
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.        
        otherwise return error.
    end case.
end procedure.
procedure findPk-emitente:
    
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    def input parameter i-cod-emitente as inte no-undo.
    def output parameter c-return as char no-undo.
               
    run startMethod("find":U).
 
    find {&TABLE-NAME} where {&TABLE-NAME}.cod-emitente = i-cod-emitente no-lock no-error.
    if not avail {&TABLE-NAME} then do:
       {utp/ut-table.i mgcex emitente-cex 1}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.                            
    end.
    else do:
        run setCurrent.
    end.
    run endMethod("find":U).
end procedure.

procedure validateCreate:
      /*
    ** Chama Procedimento que Valida cria‡Æo da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.
    def var h-bocx155 as handle no-undo. 

    run cxbo/bocx155.p persistent set h-bocx155.
    &if defined(bf-mat-comex) &then                                    
       run setEmitente in h-bocx155 (input "C"). /* Fornecedor */
    &else
       run setEmitente in h-bocx155 (input 1). /* Fornecedor */
    &endif
       
    &if "{&bf_cex_versao_ems}" >= "2.062" &then
        run flagProgram in h-bocx155 (input i-program-aux).
    &endif
    run validaEmitente in h-bocx155 (input yes).
    run validateCreate in h-bocx155(input table rowObject,output table tt-bo-erro,output r-chave).
    delete procedure h-bocx155.
end.

procedure validateUpdate:
/*Chama o procedimento que valida a altera‡Æo de registros na bocx155*/

    def input parameter table for RowObject.
    def input parameter r-chave as rowid no-undo.
    def output parameter table for tt-bo-erro.    
    def var h-bocx155 as handle no-undo. 
    
    run cxbo/bocx155.p persistent set h-bocx155.

    run verifica_validacao in h-bocx155 (input yes
                                         &IF "{&bf_cex_versao_ems}" >= "2.062" &THEN      
                                         , input 2
                                         &endif
                                         ).
    run validaEmitente in h-bocx155 (input yes).
    run validateUpdate in h-bocx155(input table rowObject,input r-chave,output table tt-bo-erro).
    delete procedure h-bocx155.
end.

procedure findEmitenteCex:
    /*
    **  Procura pelo indice verificando se o emitente ‚ Cliente ou Ambos, 
    **  caso nao ache, retorna mensagem de erro padrao do EMS.
    */
    define input  parameter i-cod-emitente as integer   no-undo.
    define output parameter c-return       as character no-undo.
    
    run startMethod("find":U).
    
    find {&table-name} where
         {&table-name}.cod-emitente = i-cod-emitente no-lock no-error.
    if not avail {&table-name} or 
       not can-find (first emitente 
                     where emitente.cod-emitente = {&table-name}.cod-emitente 
                       and &if defined(bf-mat-comex) &then                                                         
                               (emitente.identific = "C" or emitente.identific = "A"))
                           &else
                               (emitente.identific = 1 or emitente.identific = 3))
                           &endif then do:
           {utp/ut-table.i mgcex emitente-cex 1}
           run utp/ut-msgs.p (input "msg":U,
                              input 2,
                              input return-value).
           assign c-return = return-value.
    end.
    else do:
         run setCurrent.
    end.
    
    run endMethod("find":U).
    
end procedure.

procedure flagProgramAux:

   def input parameter p-program-aux as integer no-undo.

   assign i-program-aux = p-program-aux.

end procedure.
