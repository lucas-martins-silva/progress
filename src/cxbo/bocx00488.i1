/*TT com os parametros do filtro para busca de ordens a vincular*/
DEFINE TEMP-TABLE tt-param-exec NO-UNDO
    FIELD cod-estabel-ini    LIKE estabelec.cod-estabel 
    FIELD cod-estabel-fim    LIKE estabelec.cod-estabel
    FIELD embarque-ini       LIKE embarque-imp.embarque
    FIELD embarque-fim       LIKE embarque-imp.embarque
    FIELD num-pedido-ini     LIKE pedido-compr.num-pedido
    FIELD num-pedido-fim     LIKE pedido-compr.num-pedido
    FIELD numero-ordem-ini   LIKE ordem-compra.numero-ordem
    FIELD numero-ordem-fim   LIKE ordem-compra.numero-ordem
    FIELD nr-proc-ini        LIKE processo-imp.nr-proc-imp
    FIELD nr-proc-fim        LIKE processo-imp.nr-proc-imp.

    
/*TT com as ordens a serem vinculadas a DUIMP*/
DEFINE TEMP-TABLE tt-ordens-embarque-duimp NO-UNDO
    FIELD embarque          LIKE ordens-embarque.embarque
    FIELD cod-estabel       LIKE ordens-embarque.cod-estabel
    FIELD numero-ordem      LIKE ordens-embarque.numero-ordem
    FIELD cod-item          LIKE ordem-compra.it-codigo
    FIELD cod-emitente      LIKE ordem-compra.cod-emitente
    FIELD nr-proc-imp       like ordens-embarque.nr-proc-imp.


