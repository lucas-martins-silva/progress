&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram  
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice adntdspe_id2
  Parameters:  
               recebe valor do campo cod-estabel
               recebe valor do campo cdd-adiant
               recebe valor do campo num-seq-lista
               recebe valor do campo num-seq-det
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-estabel LIKE adiant-despes-lista-det.cod-estabel NO-UNDO.
    DEFINE INPUT PARAMETER pcdd-adiant LIKE adiant-despes-lista-det.cdd-adiant NO-UNDO.
    DEFINE INPUT PARAMETER pnum-seq-lista LIKE adiant-despes-lista-det.num-seq-lista NO-UNDO.
    DEFINE INPUT PARAMETER pnum-seq-det LIKE adiant-despes-lista-det.num-seq-det NO-UNDO.

    FIND FIRST bfadiant-despes-lista-det WHERE 
        bfadiant-despes-lista-det.cod-estabel = pcod-estabel AND 
        bfadiant-despes-lista-det.cdd-adiant = pcdd-adiant AND 
        bfadiant-despes-lista-det.num-seq-lista = pnum-seq-lista AND 
        bfadiant-despes-lista-det.num-seq-det = pnum-seq-det NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfadiant-despes-lista-det THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfadiant-despes-lista-det)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

