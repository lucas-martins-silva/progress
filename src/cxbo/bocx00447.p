&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE piVerificaOrdensEmbarque DBOProgram 
PROCEDURE piVerificaOrdensEmbarque :
/*:T------------------------------------------------------------------------------
  Purpose:     Verifica se a ordens-embarque j† pertence a uma lista de adiantamento
  Parameters:  sa°da: l-existe
  Notes:
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER pc-cod-estabel  LIKE ordens-embarque.cod-estabel   NO-UNDO.
    DEFINE INPUT  PARAMETER pc-embarque     LIKE ordens-embarque.embarque      NO-UNDO.
    DEFINE INPUT  PARAMETER pc-nr-proc-imp  LIKE ordens-embarque.nr-proc-imp   NO-UNDO.
    DEFINE INPUT  PARAMETER pi-numero-ordem LIKE ordens-embarque.numero-ordem  NO-UNDO.
    DEFINE INPUT  PARAMETER pi-parcela      LIKE ordens-embarque.parcela       NO-UNDO.
    DEFINE OUTPUT PARAMETER l-existe        AS   LOGICAL                       NO-UNDO.

    ASSIGN l-existe = CAN-FIND(FIRST adiant-despes-lista-det
                               WHERE adiant-despes-lista-det.cod-estabel  = pc-cod-estabel
                                 AND adiant-despes-lista-det.cod-embarq   = pc-embarque
                                 AND adiant-despes-lista-det.nr-proc-imp  = pc-nr-proc-imp
                                 AND adiant-despes-lista-det.numero-ordem = pi-numero-ordem
                                 AND adiant-despes-lista-det.cod-desp     = pi-parcela).

    RETURN "OK":U.
END PROCEDURE.

