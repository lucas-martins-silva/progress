{cdp/cdcfgmat.i} /* defini‡Æo de pr‚-processador */

&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.001
&scoped-define FIRST-TABLE-IN-QUERY form-desp-imp
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME form-desp-imp


{include/boini.i}

{cxbo/bocx105.i RowObject}

DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

procedure setConstraint1:

end procedure.

procedure setConstraint2:
    def input parameter r-chave as rowid no-undo.
    find desp-imp no-lock where rowid(desp-imp) = r-chave no-error.
end procedure.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where of desp-imp no-lock by form-desp-imp.cod-desp.

    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.

