procedure executeUpdate:
    /*
    **  Executa Update
    */
    buffer-copy RowObject except r-rowid cod-desp sequencia to form-desp-imp.
end procedure.


procedure initializeValidate:
    /*
    **  Inicializa Validate
    */

    run startMethod ("initializeValidade").

    run endMethod   ("initializeValidade").
end procedure.

procedure findCodigo:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter i-cod-desp as inte no-undo.
    def input parameter i-sequencia as inte no-undo.
    def output parameter c-return as char no-undo.

    find form-desp-imp where
        form-desp-imp.cod-desp = i-cod-desp
        and form-desp-imp.sequencia = i-sequencia
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex form-desp-imp 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.

procedure validateFields:
    /*
    **  Valida Fields
    */
    def var i as integer init 1 no-undo.

    find first rowObject
        no-lock no-error.

    run startMethod ("validateFields").  
	
    find first rowObject
        no-lock no-error.    
    
    if rowObject.cod-desp-form[01] = 0 and
       rowObject.cod-desp-form[02] = 0 and
       rowObject.cod-desp-form[03] = 0 and
       rowObject.cod-desp-form[04] = 0 and
       rowObject.cod-desp-form[05] = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex form-desp-imp cod-desp-form 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 17324,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 17324
               tt-bo-erro.mensagem     = return-value.
    end.
    
    do while i <= 5:
        if rowObject.cod-desp-form[i] <> 0 then do:
            if not can-find(desp-imp where desp-imp.cod-desp = rowObject.cod-desp-form[i]) then do:
                assign i-seq-erro = i-seq-erro + 1.
                /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                   pre-processador em chamada de includes */
                {utp/ut-table.i mgcex desp-imp 1}
                /******************************************/
                run utp/ut-msgs.p (input "msg",
                                   input 47,
                                   input return-value).
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 47
                       tt-bo-erro.mensagem     = return-value.
            end.
            if rowObject.cod-desp-form[i] = rowObject.cod-desp then do:
                assign i-seq-erro = i-seq-erro + 1.
                run utp/ut-msgs.p (input "msg",
                                   input 17107,
                                   input "").
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 17107
                       tt-bo-erro.mensagem     = return-value.         
            end. 
            if can-find(first tt-bo-erro) then assign i = 6.
        end.            
        assign i = i + 1.
    end.  
 
    if rowObject.fat-ponder = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex form-desp-imp fat-ponder 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.	

    run endMethod ("validateFields").

end procedure.

procedure validateCreate:
    /*
    **  Valida cria‡Æo da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.
    def var i-auto-num as integer no-undo.
    def var i-cont as int.

    run initializeValidate.
    run startMethod ("validateCreate").

    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

	find first rowObject no-error.
    
    run autoNumber(output i-auto-num, output table tt-bo-erro).
    if not can-find(first tt-bo-erro) then 
        assign rowObject.sequencia = i-auto-num.
        
    run validateFields.
    
    if can-find(first form-desp-imp where
                      form-desp-imp.cod-desp  = rowObject.cod-desp and
                      form-desp-imp.sequencia = rowObject.sequencia) then do:                      
       assign i-seq-erro = i-seq-erro + 1.
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-table.i mgcex form-desp-imp 1}
       /******************************************/
       run utp/ut-msgs.p (input "msg",
                          input 8,
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen     = i-seq-erro
              tt-bo-erro.cd-erro      = 8
              tt-bo-erro.mensagem     = return-value.
    end.

    find first tt-bo-erro
        no-lock no-error.
    if not available tt-bo-erro then do:
        find form-desp-imp where
            form-desp-imp.cod-desp = rowObject.cod-desp
        and form-desp-imp.sequencia = rowObject.sequencia
            no-lock no-error.
        if avail form-desp-imp then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex form-desp-imp 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 8,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 8
                   tt-bo-erro.mensagem     = return-value.
        end.
    end.

    if not avail tt-bo-erro then do:
       	run executeCreate.
      	assign r-chave = to-rowid(return-value).
    end.
    	run endMethod ("validateCreate").
	 
end procedure.

procedure validateCodigo:
    def input-output parameter c-cod-desp-form-01          as char no-undo.
    def input-output parameter c-cod-desp-form-02          as char no-undo.
    def input-output parameter c-cod-desp-form-03          as char no-undo.
    def input-output parameter c-cod-desp-form-04          as char no-undo.
    def input-output parameter c-cod-desp-form-05          as char no-undo.
    def input-output parameter c-fat-ponder                as char no-undo.
    def output parameter table for tt-bo-erro.
    def var i-teste1 as integer no-undo.
    def var i-teste2 as integer no-undo.
    def var i-teste3 as integer no-undo.
    def var i-teste4 as integer no-undo.
    def var i-teste5 as integer no-undo.

    assign i-teste1 = int(c-cod-desp-form-01) no-error.
    if  error-status:error then do:
       assign i-seq-erro = i-seq-erro + 1
              c-cod-desp-form-01 = "0".
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-field.i mgcex form-desp-imp fat-ponder 1}
       /******************************************/
       run utp/ut-msgs.p (input "msg",
                          input 16963,
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen     = i-seq-erro
              tt-bo-erro.cd-erro      = 16963
              tt-bo-erro.mensagem     = return-value.
    end.

    assign i-teste2 = int(c-cod-desp-form-02) no-error.
    if  error-status:error then do:
       assign i-seq-erro = i-seq-erro + 1
              c-cod-desp-form-02 = "0".
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */       
       {utp/ut-field.i mgcex form-desp-imp fat-ponder 1}
       /******************************************/
       run utp/ut-msgs.p (input "msg",
                          input 16963,
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen     = i-seq-erro
              tt-bo-erro.cd-erro      = 16963
              tt-bo-erro.mensagem     = return-value.
    end.

    assign i-teste3 = int(c-cod-desp-form-03) no-error.
    if  error-status:error then do:
       assign i-seq-erro = i-seq-erro + 1
              c-cod-desp-form-03 = "0".
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-field.i mgcex form-desp-imp fat-ponder 1}
       /******************************************/
       run utp/ut-msgs.p (input "msg",
                          input 16963,
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen     = i-seq-erro
              tt-bo-erro.cd-erro      = 16963
              tt-bo-erro.mensagem     = return-value.
    end.

    assign i-teste4 = int(c-cod-desp-form-04) no-error.
    if  error-status:error then do:
       assign i-seq-erro = i-seq-erro + 1
              c-cod-desp-form-04 = "0".
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-field.i mgcex form-desp-imp fat-ponder 1}
       /******************************************/
       run utp/ut-msgs.p (input "msg",
                          input 16963,
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen     = i-seq-erro
              tt-bo-erro.cd-erro      = 16963
              tt-bo-erro.mensagem     = return-value.
    end.

    assign i-teste5 = int(c-cod-desp-form-05) no-error.
    if  error-status:error then do:
       assign i-seq-erro = i-seq-erro + 1
              c-cod-desp-form-05 = "0".
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-field.i mgcex form-desp-imp fat-ponder 1}
       /******************************************/
       run utp/ut-msgs.p (input "msg",
                          input 16963,
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen     = i-seq-erro
              tt-bo-erro.cd-erro      = 16963
              tt-bo-erro.mensagem     = return-value.
    end.

end procedure.

procedure autoNumber:
    def output parameter i-auto-num as integer no-undo.
    def var i-cont as integer init 1 no-undo. /** variável de contador **/
    def output parameter table for tt-bo-erro.
	
    find last form-desp-imp where form-desp-imp.cod-desp = rowObject.cod-desp no-lock no-error.
    if avail form-desp-imp then do:	    
        assign i-auto-num = form-desp-imp.sequencia + 1.
    end.

end procedure.

procedure getCharField:
    define input  parameter c-field as char.
    define output parameter c-value as char.

    case c-field:
        when "char-1" then c-value = RowObject.char-1.
        when "char-2" then c-value = RowObject.char-2.
        when "check-sum" then c-value = RowObject.check-sum.
        otherwise return error.
    end case.
end procedure.

procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.

    case c-field:
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        when "fat-ponder" then c-value = RowObject.fat-ponder.
        otherwise return error.
    end case.
end procedure.

procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.

    case c-field:
        when "cod-desp" then c-value = RowObject.cod-desp.
        when "cod-desp-form[1]" then c-value = RowObject.cod-desp-form[1].
        when "cod-desp-form[2]" then c-value = RowObject.cod-desp-form[2].
        when "cod-desp-form[3]" then c-value = RowObject.cod-desp-form[3].
        when "cod-desp-form[4]" then c-value = RowObject.cod-desp-form[4].
        when "cod-desp-form[5]" then c-value = RowObject.cod-desp-form[5].
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.
        when "sequencia" then c-value = RowObject.sequencia.
        otherwise return error.
    end case.
end procedure.

procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.

    case c-field:
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.
        otherwise return error.
    end case.
end procedure.

procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.

    case c-field:
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.
        otherwise return error.
    end case.
end procedure.

