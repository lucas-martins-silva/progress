/******************************************************************************
**
**  bocx250.i51 - Grava/Regrava o conteudo das variaveis geradas
**               a patir de uma outra variavel. Essa quebra foi feita no
**               CD4300.i4.
**
**  Significados do parametro:
**
**  {1} - Caso seja yes, grava o conteudo de aux-c-char nas variaveis criadas;
**        Caso seja no, grava o conteudo das variaveis criadas em aux-c-char;
******************************************************************************/

if {1} then 
    assign i-emitente-ii-i50   = integer(aux-c-char[1])
           i-desp-ii-i50       = integer(aux-c-char[2]).
else 
    assign aux-c-char[1]  = string(i-emitente-ii-i50)
           aux-c-char[2]  = string(i-desp-ii-i50).

/* bocx250.i51 */
