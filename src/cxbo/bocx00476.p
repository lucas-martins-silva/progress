&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    DEF VAR c-liter AS CHAR NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/

    IF (pType = "CREATE":U OR pType = "UPDATE") THEN DO:  

        IF  RowObject.cdn-despes-saida-div <> 0 THEN DO:
            IF NOT CAN-FIND(FIRST desp-imp
                            WHERE desp-imp.cod-desp = RowObject.cdn-despes-saida-div) THEN DO:

                IF  i-pais-impto-usuario = 2 THEN
                    {utp/ut-liter.i Imposto_Pa°s *}
                ELSE
                    {utp/ut-liter.i Imposto_ISD *}
                {METHOD/svc/errors/inserr.i
                                &ErrorNumber="2" /* C¢digo Imposto n∆o cadastrado */
                                &ErrorType="EMS"
                                &ErrorSubType="ERROR"
                                &ErrorParameters="RETURN-VALUE" }
            END.
            
            /* Fornecedor do Imposto Pa°s ARG */    
            IF  i-pais-impto-usuario = 2 THEN DO:
            
                find emitente 
                    where emitente.cod-emitente = RowObject.num-livre-1 no-lock no-error.
                if  not avail emitente
                OR  emitente.cod-emitente = 0 then do:            
                    {utp/ut-liter.i fornecedor_do_Imposto_Pa°s *}
                    {METHOD/svc/errors/inserr.i
                                    &ErrorNumber="2" /* C¢digo Imposto n∆o cadastrado */
                                    &ErrorType="EMS"
                                    &ErrorSubType="ERROR"
                                    &ErrorParameters="RETURN-VALUE" }            
                end.
                else do:
                    /** Emitente deve ser fornecedor **/
                    if  emitente.identific = 1 then do: 
                        {utp/ut-liter.i "Emitente_do_Imposto_Pa°s" *} ASSIGN c-liter = TRIM(RETURN-VALUE).
                        {utp/ut-liter.i fornecedor *}
                        {METHOD/svc/errors/inserr.i
                                        &ErrorNumber="17195"
                                        &ErrorType="EMS"
                                        &ErrorSubType="ERROR"
                                        &ErrorParameters="c-liter + '~~~~' + trim(return-value)" }
                    end.
                end.        
            END.
        END.        
    END.
    
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

