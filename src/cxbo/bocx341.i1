/*
     objetivo - criar cotacao-item-cex e atualizar despesas
                influenciadas atraves do imapi006.p
*/
                    FIND LAST  cotacao-item-cex
                         WHERE cotacao-item-cex.numero-ordem = cotacao-item.numero-ordem
                           AND cotacao-item-cex.it-codigo    = cotacao-item.it-codigo
                           AND cotacao-item-cex.cod-emitente = cotacao-item.cod-emitente
                           AND cotacao-item-cex.seq-cotac    = cotacao-item.seq-cotac NO-LOCK NO-ERROR.
                    
                    /*--- carrega o valor do novo mapa da cotacao, caso este
                          ainda nao existir. Carrega tambem o valor da sequencia 
                          da nova despesa ---*/
                    IF  INTEGER(SUBSTRING(cotacao-item.char-1,1,20)) = 0 THEN DO:
                        IF  AVAIL cotacao-item-cex THEN
                            ASSIGN OVERLAY(cotacao-item.char-1,1,20) = STRING(cotacao-item-cex.mapa-cotacao + 1)
                                   i-sequencia                       = cotacao-item-cex.sequencia + 1.
                        ELSE
                            ASSIGN OVERLAY(cotacao-item.char-1,1,20) = "1"
                                   i-sequencia                       = 1.
                    END.
                    ELSE DO:
                        IF  AVAIL cotacao-item-cex THEN
                            ASSIGN i-sequencia = cotacao-item-cex.sequencia + 1.
                        ELSE
                            ASSIGN i-sequencia = 1.
                    END.
                    
                    /*-- converte para a moeda da despesa ---*/
                    IF  tt-desp-param.mo-codigo <> 0 THEN
                        RUN cdp/cd0812.p (INPUT 0, 
                                          INPUT tt-desp-param.mo-codigo,
                                          INPUT tt-desp-rateio.val-desp-unit,
                                          INPUT TODAY,
                                          OUTPUT tt-desp-rateio.val-desp-unit).
                                          
                    FIND FIRST cotacao-item-cex
                         WHERE cotacao-item-cex.numero-ordem      = cotacao-item.numero-ordem                    AND
                               cotacao-item-cex.cod-emitente      = cotacao-item.cod-emitente                    AND
                               cotacao-item-cex.it-codigo         = cotacao-item.it-codigo                       AND
                               cotacao-item-cex.seq-cotac         = cotacao-item.seq-cotac                       AND
                               cotacao-item-cex.data-cotacao      = cotacao-item.data-cotacao                    AND
                               cotacao-item-cex.mapa-cotacao      = INTEGER(SUBSTRING(cotacao-item.char-1,1,20)) AND
                               cotacao-item-cex.cod-incoterm      = TRIM(SUBSTRING(cotacao-item.char-1,21,20))   AND
                               cotacao-item-cex.cod-itiner        = processo-imp.cod-itiner                      AND
                               cotacao-item-cex.sequencia         = i-sequencia                                  AND
                               cotacao-item-cex.cod-emitente-desp = tt-desp-param.cod-emitente-desp              AND
                               cotacao-item-cex.cod-desp          = tt-desp-param.cod-desp                       EXCLUSIVE-LOCK NO-ERROR.
                               
                    IF  NOT AVAIL cotacao-item-cex THEN DO:
                        CREATE cotacao-item-cex.
                        ASSIGN cotacao-item-cex.numero-ordem      = cotacao-item.numero-ordem
                               cotacao-item-cex.cod-emitente      = cotacao-item.cod-emitente
                               cotacao-item-cex.it-codigo         = cotacao-item.it-codigo
                               cotacao-item-cex.seq-cotac         = cotacao-item.seq-cotac
                               cotacao-item-cex.data-cotacao      = cotacao-item.data-cotacao
                               cotacao-item-cex.mapa-cotacao      = INTEGER(SUBSTRING(cotacao-item.char-1,1,20))
                               cotacao-item-cex.cod-incoterm      = TRIM(SUBSTRING(cotacao-item.char-1,21,20))
                               cotacao-item-cex.cod-itiner        = processo-imp.cod-itiner
                               cotacao-item-cex.sequencia         = i-sequencia
                               cotacao-item-cex.cod-emitente-desp = tt-desp-param.cod-emitente-desp
                               cotacao-item-cex.cod-desp          = tt-desp-param.cod-desp.
                    END.
                    
                    ASSIGN cotacao-item-cex.val-desp          = tt-desp-rateio.val-desp-unit
                           cotacao-item-cex.nr-tab            = ""
                           cotacao-item-cex.cod-pto-contr     = tt-desp-param.cod-pto-contr
                           cotacao-item-cex.cod-cond-pag      = tt-desp-param.cod-cond-pag
                           cotacao-item-cex.data-cotacao-desp = TODAY
                           cotacao-item-cex.mo-codigo         = tt-desp-param.mo-codigo
                           cotacao-item-cex.taxa-financ       = YES
                           cotacao-item-cex.perc-taxa         = 0
                           cotacao-item-cex.perc-descto       = 0
                           cotacao-item-cex.contato           = cotacao-item.contato
                           cotacao-item-cex.cod-comprado      = cotacao-item.cod-comprado
                           cotacao-item-cex.aprovador         = ""
                           cotacao-item-cex.usuario           = c-seg-usuario
                           cotacao-item-cex.data-atualiz      = TODAY
                           cotacao-item-cex.hora-atualiz      = STRING(TIME,"HH:MM:SS")
                           cotacao-item-cex.motivo-apr        = ""
                           cotacao-item-cex.dias-validade     = 30
                           cotacao-item-cex.nr-dias-taxa      = 30
                           cotacao-item-cex.tp-despesa        = tt-desp-param.tp-despesa.
                           
                    FIND desp-imp WHERE
                         desp-imp.cod-desp = cotacao-item-cex.cod-desp NO-LOCK NO-ERROR.
                    IF  AVAIL desp-imp
                    AND desp-imp.tipo = 1 /* Valor fixo */ THEN DO:

                        FIND FIRST tt-desp-param 
                             WHERE tt-desp-param.cod-desp = desp-imp.cod-desp NO-LOCK NO-ERROR.

                        IF  AVAIL tt-desp-param THEN
                            ASSIGN cotacao-item-cex.val-desp = tt-desp-param.val-desp.
                    END.

                {&END}

                RUN retornaValorTotalDespCotada IN h-bocx085 (INPUT  ROWID(cotacao-item-cex),
                                                              OUTPUT de-valor-tot-desp).   
                                                              
                assign l-desp-imposto = no.
                
                RUN retornaDespesaImposto (INPUT  tt-pedidos.num-pedido,
                                           INPUT  cotacao-item-cex.cod-desp,
                                           INPUT  "",
                                           INPUT  "",
                                           INPUT  1,
                                           OUTPUT l-desp-imposto).

                if  l-desp-imposto then do: 
                    FIND FIRST despes-ped-compra
                         WHERE despes-ped-compra.num-pedido        = tt-pedidos.num-pedido
                           AND despes-ped-compra.cod-desp          = cotacao-item-cex.cod-desp
                           AND despes-ped-compra.mo-codigo         = cotacao-item-cex.mo-codigo
                           AND despes-ped-compra.cod-emitente-desp = cotacao-item-cex.cod-emitente-desp
                           AND despes-ped-compra.cod-cond-pag      = cotacao-item-cex.cod-cond-pag
                           AND despes-ped-compra.cod-pto-contr     = cotacao-item-cex.cod-pto-contr
                           AND despes-ped-compra.tp-despesa        = cotacao-item-cex.tp-despesa EXCLUSIVE-LOCK NO-ERROR.
                                       
                    IF  AVAIL despes-ped-compra THEN
                        assign despes-ped-compra.val-desp = despes-ped-compra.val-desp + de-valor-tot-desp.
                end.
                
                /*--- atualiza despesa do pedido quando for enviado 
                      mais de um pedido pela tt-pedidos ---*/                                              
                IF  i-qtd-pedidos = 2 THEN DO:

                    RUN retornaValorDespesa (INPUT tt-pedidos.num-pedido, 
                                             INPUT cotacao-item-cex.cod-desp,
                                             INPUT cotacao-item-cex.mo-codigo,
                                             INPUT cotacao-item-cex.cod-emitente-desp,
                                             INPUT cotacao-item-cex.cod-cond-pag,
                                             INPUT cotacao-item-cex.cod-pto-contr,
                                             INPUT cotacao-item-cex.tp-despesa,
                                             OUTPUT rw-despes-ped-compra,
                                             OUTPUT de-vl-tot-desp-pedido).

                    IF  de-vl-tot-desp-pedido <> 0 THEN DO:
                        /*--- atualiza despes-ped-compra na base ---*/    
                        RUN emptyRowObject IN THIS-PROCEDURE.
                        RUN emptyRowErrors IN THIS-PROCEDURE.
                        RUN openQueryStatic IN THIS-PROCEDURE (INPUT "main":U).
                        RUN repositionRecord IN THIS-PROCEDURE (INPUT rw-despes-ped-compra).
                        IF RETURN-VALUE = "NOK":U THEN NEXT.
                        RUN getRecord IN THIS-PROCEDURE (OUTPUT TABLE rowObject).
                        FIND FIRST rowObject NO-ERROR.
                        IF NOT AVAIL rowObject THEN NEXT.
                        FIND desp-imp WHERE
                             desp-imp.cod-desp = cotacao-item-cex.cod-desp NO-LOCK NO-ERROR.
                        IF  AVAIL desp-imp
                        AND desp-imp.tipo = 1 /* Valor fixo */ THEN
                            ASSIGN rowObject.val-desp = de-valor-tot-desp.
                        ELSE
                            ASSIGN rowObject.val-desp = de-valor-tot-desp + de-vl-tot-desp-pedido.
                        RUN updateRecord IN THIS-PROCEDURE.
                        /*--- fim atualizacao despes-ped-compra ---*/
                    END.
                    ELSE DO:
                        /*--- cria despes-ped-compra na base ---*/    
                        RUN openQueryStatic IN THIS-PROCEDURE (INPUT "main":U).                        
                        RUN emptyRowObject IN THIS-PROCEDURE.
                        RUN emptyRowErrors IN THIS-PROCEDURE.
                        CREATE rowObject.
                        ASSIGN rowObject.num-pedido        = tt-pedidos.num-pedido
                               rowObject.cod-desp          = cotacao-item-cex.cod-desp
                               rowObject.cod-emitente-desp = cotacao-item-cex.cod-emitente-desp
                               rowObject.cod-incoterm-rat  = tt-desp-param.cod-incoterm-rat
                               rowObject.cod-pto-contr     = cotacao-item-cex.cod-pto-contr
                               rowObject.cod-cond-pag      = cotacao-item-cex.cod-cond-pag
                               rowObject.mo-codigo         = cotacao-item-cex.mo-codigo
                               rowObject.tp-despesa        = cotacao-item-cex.tp-despesa
                               rowObject.val-desp          = de-valor-tot-desp.
                        RUN sugereSeqDespesa IN THIS-PROCEDURE (INPUT rowObject.num-pedido,
                                                                OUTPUT rowObject.sequencia).
                        RUN setRecord IN THIS-PROCEDURE (INPUT TABLE rowObject).
                        RUN createRecord IN THIS-PROCEDURE.
                        /*--- fim criacao despes-ped-compra ---*/
                    END.

                END.

                /*--- atualiza despesas influenciadas ---*/
                IF  AVAIL cotacao-item-cex THEN
                    run imp/imapi006.p(input "cotacao-item-cex":U,  
                                       input rowid(cotacao-item-cex),
                                       input cotacao-item-cex.cod-desp,
                                       input 0,
                                       input table tt-cotacao-item-cex,
                                       input-output table tt-desp-ja-recalc).
