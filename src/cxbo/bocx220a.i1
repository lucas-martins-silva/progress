PROCEDURE pi-recebe-tp-nacionaliz:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
   DEFINE INPUT PARAMETER p-tp-nacionaliz AS INTEGER NO-UNDO.

   ASSIGN i-tp-nacionaliz = p-tp-nacionaliz
          i-tipo-geracao  = p-tp-nacionaliz.

   RETURN "OK":U.
END PROCEDURE.


PROCEDURE pi-recebe-valores-di:
