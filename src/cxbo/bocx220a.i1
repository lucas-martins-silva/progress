PROCEDURE ValidaNotaFiscalAjuste:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER  ccod-estabel      AS CHARACTER     NO-UNDO.
    DEFINE INPUT  PARAMETER  cembarque         AS CHARACTER     NO-UNDO.
    DEFINE OUTPUT PARAMETER TABLE FOR tt-bo-erro.
    
    DEFINE VARIABLE dtotal-doc-mae    AS DECIMAL NO-UNDO.
    DEFINE VARIABLE dtotal-doc-filha  AS DECIMAL NO-UNDO.
    DEFINE VARIABLE dsaldo            AS DECIMAL NO-UNDO.
    
    EMPTY TEMP-TABLE tt-embarque-pai.
    EMPTY TEMP-TABLE tt-embarque-filho. 
    
    /* Cria temp-table dos embarques relacionados */
    FIND FIRST embarque-imp
         WHERE embarque-imp.cod-estabel = ccod-estabel
           AND embarque-imp.embarque    = cembarque NO-LOCK NO-ERROR. 
    
    IF AVAIL embarque-imp THEN DO:        
       IF TRIM(substring(embarque-imp.char-1,21,20)) <> " " THEN DO: 
          CREATE tt-embarque-pai.
          ASSIGN tt-embarque-pai.embarque     = TRIM(substring(embarque-imp.char-1,21,20))
                 tt-embarque-pai.cod-estabel  = embarque-imp.cod-estabel.    
       END.
       ELSE DO:     
          CREATE tt-embarque-pai.
          ASSIGN tt-embarque-pai.embarque     = embarque-imp.embarque
                 tt-embarque-pai.cod-estabel  = embarque-imp.cod-estabel.      
       END.
       
       FIND FIRST tt-embarque-pai NO-LOCK NO-ERROR. 

       /* cria registro para os outros filhos*/
       FOR EACH b-embarque-imp
          WHERE b-embarque-imp.cod-estabel = tt-embarque-pai.cod-estabel
            AND TRIM(substring(b-embarque-imp.char-1,21,20)) = tt-embarque-pai.embarque:          

           FIND FIRST tt-embarque-filho
                WHERE tt-embarque-filho.embarque    = b-embarque-imp.embarque
                  AND tt-embarque-filho.cod-estabel = b-embarque-imp.cod-estabel NO-ERROR.

           IF NOT AVAIL tt-embarque-filho THEN DO:                    
              CREATE tt-embarque-filho.
              ASSIGN tt-embarque-filho.embarque     = b-embarque-imp.embarque
                     tt-embarque-filho.cod-estabel  = b-embarque-imp.cod-estabel.
          END.
       END.
    END.
  
    /* Verifica NF relacionadas aos embarques */    
    ASSIGN de-total-mae    = 0
           de-total-filhas = 0
           de-total-saldo  = 0.
    
    FOR EACH tt-embarque-pai:    
        RUN busca-total-documentos (INPUT  tt-embarque-pai.embarque, 
                                    INPUT  tt-embarque-pai.cod-estabel, 
                                    OUTPUT dtotal-doc-mae, 
                                    OUTPUT dtotal-doc-filha, 
                                    OUTPUT dsaldo).

        ASSIGN de-total-mae    = de-total-mae + dtotal-doc-mae
               de-total-filhas = de-total-filhas + dtotal-doc-filha.      
    END.

    FOR EACH tt-embarque-filho:
        RUN busca-total-documentos (INPUT  tt-embarque-filho.embarque, 
                                    INPUT  tt-embarque-filho.cod-estabel, 
                                    OUTPUT dtotal-doc-mae, 
                                    OUTPUT dtotal-doc-filha, 
                                    OUTPUT dsaldo).

        ASSIGN de-total-filhas = de-total-filhas + dtotal-doc-filha.     
               de-total-saldo  = de-total-saldo + dsaldo.          
    END.  
    
    IF de-total-mae > de-total-filhas THEN /* Saldo da nota m∆e maior que saldos das filhas - Verificar filhas pendentes  */
        RUN criaTTBoErro(55090, "").
    ELSE DO:
       IF de-total-mae < de-total-filhas THEN /* Saldo das filhas maior que o da m∆e - Deve efetuar ajuste manual */
           RUN criaTTBoErro(55091, "").
    END.
    
    RETURN "OK":U.
END PROCEDURE.


PROCEDURE busca-total-documentos:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER  cembarque        AS CHARACTER     NO-UNDO.
    DEFINE INPUT  PARAMETER  cestabel         AS CHARACTER     NO-UNDO.
    DEFINE OUTPUT PARAMETER dtotal-doc-mae    AS DECIMAL       NO-UNDO.
    DEFINE OUTPUT PARAMETER dtotal-doc-filha  AS DECIMAL       NO-UNDO.
    DEFINE OUTPUT PARAMETER dsaldo            AS DECIMAL       NO-UNDO.
     
    FOR EACH embarq-import-docto FIELDS (cod-estab cod-embarq cod-ser-docto cod-docto cdn-emitente cod-natur-operac)
       WHERE embarq-import-docto.cod-estab   = cestabel
         AND embarq-import-docto.cod-embarq  = cembarque NO-LOCK,
       FIRST docum-est 
       WHERE docum-est.serie-docto  = embarq-import-docto.cod-ser-docto   
         AND docum-est.nro-docto    = embarq-import-docto.cod-docto       
         AND docum-est.cod-emitente = embarq-import-docto.cdn-emitente    
         AND docum-est.nat-operacao = embarq-import-docto.cod-natur-operac NO-LOCK:

        FOR EACH item-doc-est 
           WHERE item-doc-est.serie-docto  = docum-est.serie-docto 
             AND item-doc-est.nro-docto    = docum-est.nro-docto   
             AND item-doc-est.cod-emitente = docum-est.cod-emitente
             AND item-doc-est.nat-operacao = docum-est.nat-operacao NO-LOCK:
            
            IF docum-est.idi-nf-simples-remes   = 1 THEN DO:   /* Nota m∆e */
                
                ASSIGN dtotal-doc-mae = dtotal-doc-mae + item-doc-est.quantidade.
                
                /* Acumula quantidade da nota m∆e que gerou primeira remessa pra baixar estoque */
                IF TRIM(SUBSTRING(item-doc-est.char-2,940,1)) = "S":U THEN 
                    ASSIGN dtotal-doc-filha = dtotal-doc-filha + item-doc-est.quantidade.
            END.
            ELSE
                IF docum-est.idi-nf-simples-remes = 2 THEN DO: /* Nota filha */
                    ASSIGN dtotal-doc-filha = dtotal-doc-filha + item-doc-est.quantidade. 
                    
                    FOR FIRST ordens-embarque 
                        WHERE ordens-embarque.cod-estabel  = embarq-import-docto.cod-estab
                          AND ordens-embarque.embarque     = embarq-import-docto.cod-embarq
                          AND ordens-embarque.numero-ordem = item-doc-est.numero-ordem
                          AND ordens-embarque.parcela      = item-doc-est.parcela  NO-LOCK:
                    END.

                    FIND FIRST prazo-compra  
                         WHERE prazo-compra.numero-ordem = ordens-embarque.numero-ordem
                           AND prazo-compra.parcela = item-doc-est.parcela NO-LOCK NO-ERROR.

                    IF AVAIL prazo-compra THEN
                        ASSIGN dsaldo = dsaldo + prazo-compra.quant-saldo.                    
                END.
        END.
    END.
    
    RETURN "OK":U.
END PROCEDURE.


PROCEDURE retornaSaldoOrdem:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER  pordem   LIKE ordem-compra.numero-ordem NO-UNDO.
    DEFINE INPUT  PARAMETER  pparcela LIKE prazo-compra.parcela      NO-UNDO.
    DEFINE OUTPUT PARAMETER pvalor    LIKE prazo-compra.quant-saldo  NO-UNDO.
    
    FOR FIRST prazo-compra FIELDS(numero-ordem parcela quant-saldo dec-1) NO-LOCK
        WHERE prazo-compra.numero-ordem = pordem
          AND prazo-compra.parcela      = pparcela:
        
        ASSIGN pvalor = prazo-compra.quant-saldo - prazo-compra.dec-1.
    END.

    RETURN "OK":U.
END PROCEDURE.


PROCEDURE piSetaTTEmbarque:
/*------------------------------------------------------------------------------
  Purpose:     seta as temp-tables tt-embarque-pai e tt-embarque-filho
               criadas atravÇs da procedure piBuscaItensNotasRemessa  
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER TABLE FOR tt-embarque-pai.
    DEFINE INPUT PARAMETER TABLE FOR tt-embarque-filho.
    
    RETURN "OK":U.
END PROCEDURE.


PROCEDURE gerarItensDesembarqueAux:
/*------------------------------------------------------------------------------
  Purpose:     Procedure auxiliar da gerarItensDesembarque                                         
               Necessidade de desmembrar devido Ö funcionalidade "Gera Primeira Remessa com NF M∆e"
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pc-cod-estabel            LIKE embarque-imp.cod-estabel NO-UNDO.
    DEFINE INPUT PARAMETER pc-embarque               LIKE embarque-imp.embarque    NO-UNDO.
    DEFINE INPUT PARAMETER pl-gera-prim-nf-remes-mae AS   LOGICAL                  NO-UNDO.
    
    define variable        de-preco-total-mo         as decimal                    no-undo.
    
    FOR EACH ordens-embarque 
       WHERE ordens-embarque.cod-estabel = pc-cod-estabel 
         AND ordens-embarque.embarque    = pc-embarque NO-LOCK
         BREAK BY ordens-embarque.numero-ordem:
        
        /* N∆o possui divergància de saldo - verificar saldo das ordens */
        IF tt-parametros.l-nf-ajuste THEN DO:
            
            RUN retornaSaldoOrdem (INPUT  ordens-embarque.numero-ordem, 
                                   INPUT  ordens-embarque.parcela, 
                                   OUTPUT psaldorestante).

            IF psaldorestante <= 0 THEN NEXT. /*saldo fica negativo quando gera primeira remessa com nf m∆e, ent∆o desconsidera este registro tb*/
        END.
        
        FOR EACH tt-epc  
           WHERE tt-epc.cod-event = "ClassFiscalEsp":U:
            DELETE tt-epc.
        END.
         
        CREATE tt-epc.
        ASSIGN tt-epc.cod-event     = "ClassFiscalEsp":U
               tt-epc.cod-parameter = "cod-estabel":U
               tt-epc.val-parameter = ordens-embarque.cod-estabel.
        CREATE tt-epc.
        ASSIGN tt-epc.cod-event     = "ClassFiscalEsp":U
               tt-epc.cod-parameter = "embarque":U
               tt-epc.val-parameter = ordens-embarque.embarque.
        CREATE tt-epc.
        ASSIGN tt-epc.cod-event     = "ClassFiscalEsp":U
               tt-epc.cod-parameter = "numero-ordem":U
               tt-epc.val-parameter = STRING(ordens-embarque.numero-ordem).
        CREATE tt-epc.
        ASSIGN tt-epc.cod-event     = "ClassFiscalEsp":U
               tt-epc.cod-parameter = "parcela":U
               tt-epc.val-parameter = STRING(ordens-embarque.parcela).
        CREATE tt-epc.
         
        {include/i-epc201.i "ClassFiscalEsp"} 
         
        FOR FIRST tt-epc 
            WHERE tt-epc.cod-event     = "ClassFiscalEsp":U
            AND   tt-epc.cod-parameter = "class-fiscal-esp":U:
        
            ASSIGN c-class-fiscal-esp = tt-epc.val-parameter.
        END.
         
        ASSIGN de-preco-unit-mo      = 0
               de-preco-total        = 0
               de-preco-total-mo     = 0 
               de-preco-total-aux    = 0               
               de-preco-total-mo-aux = 0
               c-class-fiscal        = "".
    
        /* Processo de importaá∆o */
        FIND FIRST processo-imp
             WHERE processo-imp.cod-estabel = ordens-embarque.cod-estabel
               AND processo-imp.nr-proc-imp = ordens-embarque.nr-proc-imp NO-LOCK NO-ERROR.

        IF NOT AVAIL processo-imp THEN DO:

            {utp/ut-liter.i Processo_Importaá∆o * L}
            RUN criaTTBoErro(2, TRIM(RETURN-VALUE) + "~~":U + ordens-embarque.nr-proc-imp).
        END.
        ELSE DO:
            
            ASSIGN i-cod-via-transp = embarque-imp.cod-via-transp
                   i-cod-itiner     = processo-imp.cod-itiner.
            
            /* Verifica se usu†rio recebe pedido de outro fornecedor/estabelecimento */
            EMPTY TEMP-TABLE RowErrors.
            RUN rep/re1007.p (INPUT tt-parametros.cod-emitente,
                              INPUT processo-imp.cod-exportador,
                              INPUT-OUTPUT TABLE RowErrors).  

            FIND FIRST RowErrors WHERE RowErrors.ErrorNumber = 8851 NO-LOCK NO-ERROR.
            IF AVAIL RowErrors OR
               /* Verifica se usuario recebe pedido de outro estabelecimento */
               (AVAIL param-re AND NOT param-re.rec-out-for 
                  AND processo-imp.estab-fisc <> tt-parametros.estab-fisc) THEN DO:

                RUN criaTTBoErro(26099, processo-imp.nr-proc-imp).
            END.
        END.
    
        /* Ordem de compra */
        FIND FIRST ordem-compra 
             WHERE ordem-compra.numero-ordem = ordens-embarque.numero-ordem NO-LOCK NO-ERROR.
        
        IF NOT AVAIL ordem-compra THEN DO:
            
            {utp/ut-liter.i Ordem_Compra * L}
            RUN criaTTBoErro(2, RETURN-VALUE + "~~":U + STRING(ordens-embarque.numero-ordem)).
        END.
        ELSE DO:
            
            ASSIGN i-mo-codigo    = ordem-compra.mo-codigo
                   i-cod-cond-pag = ordem-compra.cod-cond-pag.

            /* Pedido de compra */
            FIND FIRST pedido-compr
                 WHERE pedido-compr.num-pedido = ordem-compra.num-pedido NO-LOCK NO-ERROR.

            IF NOT AVAIL pedido-compr THEN DO:
                {utp/ut-liter.i Pedido_Compra * L}
                RUN criaTTBoErro(2, RETURN-VALUE + "~~":U + STRING(ordem-compra.num-pedido)).
            END.
            
            /* Cotaá∆o do item */
            FIND FIRST cotacao-item 
                 WHERE cotacao-item.numero-ordem = ordem-compra.numero-ordem
                   AND cotacao-item.cod-emitente = ordem-compra.cod-emitente
                   AND cotacao-item.it-codigo    = ordem-compra.it-codigo
                   AND cotacao-item.cot-aprovada NO-LOCK NO-ERROR.

            IF NOT AVAIL cotacao-item THEN DO:
                {utp/ut-liter.i Cotaá∆o_Item * L}
                RUN criaTTBoErro(2, RETURN-VALUE + "~~":U + STRING(ordens-embarque.numero-ordem)).
            END.
            ELSE DO:
                
                ASSIGN l-regime        = NO
                       de-aliquota-ipi = 0.
             
                /* Cotaá∆o da moeda da ordem de compra */
                IF i-pais-impto-usuario = 1 /* Brasil */ THEN DO:
                    FIND FIRST cotacao
                         WHERE cotacao.mo-codigo   = cotacao-item.mo-codigo
                           AND cotacao.ano-periodo = STRING(YEAR(tt-parametros.da-cotacao)) + STRING(MONTH(tt-parametros.da-cotacao),"99":U)
                           AND cotacao.cotacao[INT(DAY(tt-parametros.da-cotacao))] <> 0 NO-LOCK NO-ERROR.

                    IF NOT AVAIL cotacao THEN DO:
                        IF cotacao-item.mo-codigo <> 0 THEN
                            RUN criaTTBoErro(1847, STRING(cotacao-item.mo-codigo) + "~~":U + STRING(tt-parametros.da-cotacao)).
                        ELSE
                            ASSIGN de-cotacao-dia = 1.                               
                    END.
                    ELSE
                        ASSIGN de-cotacao-dia = cotacao.cotacao[INT(DAY(tt-parametros.da-cotacao))].                                             
                        
                    /*  C†lculo Preáo Unit†rio */
                    RUN rep/re1908.p (ROWID(ordem-compra),
                                      embarque-imp.data-1,
                                      OUTPUT de-preco-unit-mo,  
                                      OUTPUT de-desconto-cc,
                                      OUTPUT de-taxa).
                END. 
                ELSE DO:
                    IF cotacao-item.mo-codigo <> 0 THEN
                        ASSIGN de-cotacao-dia = tt-parametros.d-cotacao.
                    ELSE
                        ASSIGN de-cotacao-dia = 1.
                        
                    /*  C†lculo Preáo Unit†rio */
                    RUN rep/re1908int.p (ROWID(ordem-compra),
                                         embarque-imp.dec-1,
                                         OUTPUT de-preco-unit-mo,  
                                         OUTPUT de-desconto-cc,
                                         OUTPUT de-taxa).    
                END.
                    
                /* Calcula valor s/ IPI */                    
                ASSIGN de-preco-unit-mo = cotacao-item.pre-unit-for.
                
                /* UPC - evento CalculoPrecoUnitario */
                IF c-nom-prog-dpc-mg97  <> "" 
                OR c-nom-prog-appc-mg97 <> "" 
                OR c-nom-prog-upc-mg97  <> "" THEN DO:
                    
                    FOR EACH tt-epc  
                       WHERE tt-epc.cod-event = "CalculoPrecoUnitario":U:
                        DELETE tt-epc.
                    END.
              
                    CREATE tt-epc.
                    ASSIGN tt-epc.cod-event     = "CalculoPrecoUnitario":U
                           tt-epc.cod-parameter = "cod-estabel":U
                           tt-epc.val-parameter = embarque-imp.cod-estabel.
                    CREATE tt-epc.
                    ASSIGN tt-epc.cod-event     = "CalculoPrecoUnitario":U
                           tt-epc.cod-parameter = "embarque":U
                           tt-epc.val-parameter = embarque-imp.embarque.
                    CREATE tt-epc.
                    ASSIGN tt-epc.cod-event     = "CalculoPrecoUnitario":U
                           tt-epc.cod-parameter = "numero-ordem":U
                           tt-epc.val-parameter = STRING(ordens-embarque.numero-ordem).
                    CREATE tt-epc.
                    ASSIGN tt-epc.cod-event     = "CalculoPrecoUnitario":U
                           tt-epc.cod-parameter = "parcela":U
                           tt-epc.val-parameter = STRING(ordens-embarque.parcela).
                    CREATE tt-epc.
                    ASSIGN tt-epc.cod-event     = "CalculoPrecoUnitario":U
                           tt-epc.cod-parameter = "de-preco-unit-mo":U
                           tt-epc.val-parameter = STRING(de-preco-unit-mo).
                    CREATE tt-epc.
                    ASSIGN tt-epc.cod-event     = "CalculoPrecoUnitario":U
                           tt-epc.cod-parameter = "RowidOrdemCompra":U
                           tt-epc.val-parameter = STRING(ROWID(ordem-compra)).
            
                    {include/i-epc201.i "CalculoPrecoUnitario"} 
                
                    FIND FIRST tt-epc 
                         WHERE tt-epc.cod-event     = "CalculoPrecoUnitario":U no-error.
                          
                    IF tt-epc.cod-parameter = "retorno":U THEN
                       ASSIGN de-preco-unit-mo = DEC(tt-epc.val-parameter).
                END.
            
                ASSIGN de-preco-unit-mo      = (de-preco-unit-mo * 100) / (100 + cotacao-item.aliquota-ipi)
                       de-preco-unit         = de-preco-unit-mo
                       de-preco-total-mo     = de-preco-unit-mo  * ordens-embarque.qt-do-forn
                       de-preco-total-mo-aux = de-preco-unit-mo  * ordens-embarque.qt-do-forn
                       de-preco-total        = de-preco-total-mo
                       de-preco-total-aux    = de-preco-total-mo
                       de-desconto-cc        = de-desconto-cc    * ordens-embarque.qt-do-forn.
                
                FIND FIRST tt-epc
                     WHERE tt-epc.cod-parameter = "AlteraCotacao":U NO-ERROR.
                
                IF AVAIL tt-epc THEN DO:
                    ASSIGN de-cotacao-dia     = DEC(tt-epc.val-parameter)
                           de-preco-total     = de-preco-total     * de-cotacao-dia
                           de-preco-total-aux = de-preco-total-aux * de-cotacao-dia.
                END.
                ELSE DO:
                    
                    IF cotacao-item.mo-codigo <> 0 THEN DO:
                        IF i-pais-impto-usuario = 1 /* Brasil */ THEN DO:
                            RUN cdp/cd0812.p (INPUT  cotacao-item.mo-codigo,
                                              INPUT  0,
                                              INPUT  de-preco-total-mo,
                                              INPUT  tt-parametros.da-cotacao,
                                              OUTPUT de-preco-total).
                                              
                            RUN cdp/cd0812.p (INPUT  cotacao-item.mo-codigo,
                                              INPUT  0,
                                              INPUT  de-preco-total-mo-aux,
                                              INPUT  tt-parametros.da-cotacao,
                                              OUTPUT de-preco-total-aux).
                
                            RUN cdp/cd0812.p(INPUT  cotacao-item.mo-codigo,
                                             INPUT  0,
                                             INPUT  de-preco-unit-mo,
                                             INPUT  tt-parametros.da-cotacao,
                                             OUTPUT de-preco-unit).
                                         
                        END.
                        ELSE DO:
                            ASSIGN de-preco-total     = de-preco-total-mo * tt-parametros.d-cotacao
                                   de-preco-total-aux = de-preco-total-mo-aux * tt-parametros.d-cotacao
                                   de-preco-unit      = de-preco-unit-mo * tt-parametros.d-cotacao.    
                        END.             
                    END.
                END.
                
                IF c-nom-prog-dpc-mg97  <> "" 
                OR c-nom-prog-appc-mg97 <> ""  
                OR c-nom-prog-upc-mg97  <> "" THEN DO:
                    
                    {include/i-epc200.i2 &CodEvent='"BuscaRwOrdensEmbarque"'
                                         &CodParameter='"rw-ordens-embarque"'
                                         &ValueParameter=string(rowid(ordens-embarque))}
            
                    {include/i-epc201.i "buscarwordensembarque"}
                    
                    {include/i-epc200.i2 &CodEvent='"ConverteValorMercadoria"'
                                         &CodParameter='"cod-estabel"'
                                         &ValueParameter="string(tt-parametros.cod-estabel)"}
                    
                    {include/i-epc200.i2 &CodEvent='"ConverteValorMercadoria"'
                                         &CodParameter='"embarque"'
                                         &ValueParameter="string(tt-parametros.embarque)"}
                    
                    {include/i-epc200.i2 &CodEvent='"ConverteValorMercadoria"'
                                         &CodParameter='"preco-total-mo"'
                                         &ValueParameter="string(de-preco-total-mo)"}
                    
                    {include/i-epc200.i2 &CodEvent='"ConverteValorMercadoria"'
                                         &CodParameter='"cotacao-dia"'
                                         &ValueParameter="string(de-cotacao-dia)"}
                    
                    {include/i-epc200.i2 &CodEvent='"ConverteValorMercadoria"'
                                         &CodParameter='"preco-total"'
                                         &ValueParameter="string(de-preco-total)"}
                    
                    {include/i-epc201.i "convertevalormercadoria"}
            
                    FOR EACH tt-epc
                       WHERE tt-epc.cod-event = "ConverteValorMercadoria":U:

                        IF tt-epc.cod-parameter = "cotacao-dia":U THEN
                            ASSIGN de-cotacao-dia = DEC(tt-epc.val-parameter). 
                        ELSE
                            IF tt-epc.cod-parameter = "preco-total":U  THEN
                                ASSIGN de-preco-total = DEC(tt-epc.val-parameter).
                    END.

                    EMPTY TEMP-TABLE tt-epc.
                END.

                {ccp/cc9019.i50} /* include tratamento atributo livre cotacao-item.char-1 */
                {cdp/cd4300.i4 "yes" cotacao-item.char-1}
                {ccp/cc9019.i51 "yes"}

                ASSIGN i-pto-contr-base = i-cod-pto-contr-i50.
                
                {ocp/oc0201.i50}
                {cdp/cd4300.i4 "yes" cotacao-item.char-2}
                {ocp/oc0201.i51 "yes"}
                  
                /* Se regime de importaá∆o for informado, ent∆o busca al°quota do IPI da Cotaá∆o de Compra */
                IF  i-regime-import-i50 <> 0 
                AND i-regime-import-i50 <> ? THEN DO:
                    
                    ASSIGN l-regime = YES.
            
                    FIND FIRST item
                         WHERE item.it-codigo = cotacao-item.it-codigo NO-LOCK NO-ERROR.

                    IF AVAIL item THEN DO:
                        
                        FIND FIRST pais-aliquota
                             WHERE pais-aliquota.cod-pais      = cotacao-item.cdn-pais-orig
                             AND   pais-aliquota.regime-import = i-regime-import-i50 
                             AND   pais-aliquota.class-fiscal  = IF c-class-fiscal-esp <> "" THEN c-class-fiscal-esp
                                                                 ELSE
                                                                     IF item.tipo-contr = 4 THEN
                                                                         SUBSTRING(cotacao-item.char-1,81,20)
                                                                     ELSE
                                                                         item.class-fiscal no-lock no-error.
                        IF  AVAIL pais-aliquota
                        AND pais-aliquota.log-ipi-especial THEN DO:
            
                            FIND FIRST param-imp
                                 WHERE param-imp.cod-estabel = ordem-compra.cod-estabel NO-LOCK NO-ERROR.
                    
                            IF  pais-aliquota.cod-natur-operac-ipi <> "" 
                            AND pais-aliquota.aliquota-ipi       = 0 THEN DO:
                                
                                IF  AVAIL param-imp
                                AND param-imp.log-cotac-autom-ipi THEN DO:

                                    IF item.tipo-contr = 4 THEN DO:
                                        FIND FIRST classif-fisc
                                             WHERE classif-fisc.class-fiscal = IF c-class-fiscal-esp <> "" THEN c-class-fiscal-esp ELSE item.class-fiscal NO-LOCK NO-ERROR.

                                        IF AVAIL classif-fisc THEN
                                            ASSIGN de-aliquota-ipi = classif-fisc.aliquota-ipi.
                                    END.
                                    ELSE
                                        ASSIGN de-aliquota-ipi = item.aliquota-ipi.
                                END.
                                ELSE
                                    ASSIGN de-aliquota-ipi = cotacao-item.aliquota-ipi.
                            END.
                            ELSE DO:

                                IF  AVAIL param-imp 
                                AND param-imp.log-cotac-autom-ipi THEN
                                    ASSIGN de-aliquota-ipi = pais-aliquota.aliquota-ipi.
                                ELSE
                                    ASSIGN de-aliquota-ipi = cotacao-item.aliquota-ipi.
                            END.
                        END.
                        ELSE DO:

                            IF item.tipo-contr = 4 THEN DO:

                                FIND FIRST classif-fisc
                                     WHERE classif-fisc.class-fiscal = IF c-class-fiscal-esp <> "" THEN c-class-fiscal-esp ELSE item.class-fiscal NO-LOCK NO-ERROR.

                                IF AVAIL classif-fisc THEN
                                    ASSIGN de-aliquota-ipi = classif-fisc.aliquota-ipi.
                            END.
                            ELSE
                                ASSIGN de-aliquota-ipi = item.aliquota-ipi.
                        END.
                    END.
                END.
                ELSE
                    ASSIGN de-aliquota-ipi = cotacao-item.aliquota-ipi.
             
            END. /* Avail cotacao-item */
        END. /* Avail ordem-compra */
    
        IF AVAIL ordem-compra THEN
            FIND FIRST item
                 WHERE item.it-codigo = ordem-compra.it-codigo NO-LOCK NO-ERROR.

        IF NOT AVAIL item THEN DO:
            {utp/ut-liter.i Item * L}
            RUN criaTTBoErro(2, RETURN-VALUE + " " + item.it-codigo).
        END.
        ELSE DO:
            
            FIND FIRST item-uni-estab
                 WHERE item-uni-estab.it-codigo   = ordem-compra.it-codigo
                   AND item-uni-estab.cod-estabel = ordem-compra.cod-estabel NO-LOCK NO-ERROR.
           
            IF AVAIL item-uni-estab THEN
                ASSIGN c-deposito-pad = item-uni-estab.deposito-pad
                       c-cod-localiz  = item-uni-estab.cod-localiz.
            ELSE
                ASSIGN c-deposito-pad = item.deposito-pad
                       c-cod-localiz  = item.cod-localiz.
            
            ASSIGN c-class-fiscal = IF c-class-fiscal-esp <> "" THEN c-class-fiscal-esp ELSE item.class-fiscal.
            
            /* Item branco e dÇbito direto */
            IF item.tipo-contr = 4 THEN DO:
            
                IF AVAIL cotacao-item THEN DO:
                    IF c-class-fiscal-i50 <> "" THEN
                        ASSIGN c-class-fiscal = IF c-class-fiscal-esp <> "" THEN c-class-fiscal-esp ELSE TRIM(c-class-fiscal-i50).
                END.
            END.
            
            FIND FIRST classif-fisc
                 WHERE classif-fisc.class-fiscal = IF c-class-fiscal-esp <> "" THEN c-class-fiscal-esp ELSE c-class-fiscal NO-LOCK NO-ERROR.
            
            IF NOT AVAIL classif-fisc THEN DO:
            
                {utp/ut-liter.i Classificaá∆o_Fiscal * L}
                ASSIGN c-return-value = TRIM(RETURN-VALUE).
                {utp/ut-liter.i do_item * L}
                RUN criaTTBoErro(6361, c-return-value + " " + STRING(c-class-fiscal) + " " + RETURN-VALUE + " " + STRING(item.it-codigo)).
            END.
            
            IF i-pais-impto-usuario <> 1 /* Brasil */ THEN DO:
                
                ASSIGN c-cod-depos = "".
                                     
                FIND FIRST item-uni-estab 
                     WHERE item-uni-estab.it-codigo   = ordem-compra.it-codigo 
                       AND item-uni-estab.cod-estabel = ordem-compra.cod-estabel NO-LOCK NO-ERROR.
            
                IF SUBSTRING(ordens-embarque.char-1,1,20) <> "" /* Ato Concess¢rio */ THEN DO:
                    
                    FIND FIRST param-imp WHERE param-imp.cod-estabel = ordem-compra.cod-estabel NO-LOCK NO-ERROR.
                        
                    IF AVAIL param-imp AND param-imp.log-trata-depos-draw THEN DO:
                        
                        IF AVAIL item-uni-estab AND SUBSTRING(item-uni-estab.char-2,34,3) <> "" THEN
                            ASSIGN c-cod-depos = SUBSTRING(item-uni-estab.char-2,34,3).
                        ELSE
                            ASSIGN c-cod-depos = SUBSTRING(item.char-2,316,3).
                    END.
                END.
                           
                IF c-cod-depos = "" AND l-dep-ext THEN DO:
                    
                    IF AVAIL item-uni-estab AND SUBSTRING(item-uni-estab.char-2,31,3) <> "" THEN
                        ASSIGN c-cod-depos = SUBSTRING(item-uni-estab.char-2,31,3).
                    ELSE
                        ASSIGN c-cod-depos = SUBSTRING(item.char-2,313,3).
                END.
                
                IF c-cod-depos = "" THEN DO:
                    
                    IF ordem-compra.dep-almoxar <> "" THEN
                        ASSIGN c-cod-depos = ordem-compra.dep-almoxar.
                    ELSE
                        ASSIGN c-cod-depos = c-deposito-pad.
                END.
            END.
            ELSE DO:
                
                IF ordem-compra.dep-almoxar <> "" THEN
                    ASSIGN c-cod-depos = ordem-compra.dep-almoxar.
                ELSE
                    ASSIGN c-cod-depos = c-deposito-pad.
            END.
        END.

        IF NOT CAN-FIND (FIRST tt-bo-erro) THEN DO:
           
            {imp/im0045ab.i50} /* Include tratamento atributo livre ordens-embarque.char-1 */            
            
            /* Drawback - 2.03 - tratamento n£mero ato concess¢rio */
            {cdp/cd4300.i4 "yes" ordens-embarque.char-1} 
            {imp/im0045ab.i51 "yes"}
            
            ASSIGN i-cont = 0.
            
            IF AVAIL item AND NOT tt-parametros.l-chama-carregado THEN DO:
                
                FOR FIRST prazo-compra FIELDS (cod-refer) 
                     WHERE prazo-compra.numero-ordem = ordens-embarque.numero-ordem
                       AND prazo-compra.parcela      = ordens-embarque.parcela NO-LOCK:
                    
                    ASSIGN c-pzo-com-refer = prazo-compra.cod-refer.
                END.
            
                IF NOT l-create-itens THEN DO:
                
                    CREATE tt-itens-aux.
                    ASSIGN tt-itens-aux.numero-ordem             = ordens-embarque.numero-ordem
                           tt-itens-aux.parcela                  = ordens-embarque.parcela
                           tt-itens-aux.nr-proc-imp              = ordens-embarque.nr-proc-imp                           
                           tt-itens-aux.quantidade               = IF tt-parametros.l-nf-ajuste AND psaldorestante <> 0 THEN psaldorestante ELSE ordens-embarque.quantidade
                           tt-itens-aux.encerra-pa               = NO
                           tt-itens-aux.it-codigo                = item.it-codigo
                           tt-itens-aux.tipo-con-est             = item.tipo-con-est                               
                           tt-itens-aux.sequencial               = 1
                           tt-itens-aux.class-fiscal             = IF c-class-fiscal-esp <> "" THEN c-class-fiscal-esp ELSE SUBSTRING(c-class-fiscal,1,8)
                           tt-itens-aux.nat-fiscal               = IF ordens-embarque.cod-natur-of <> "" AND ordens-embarque.cod-natur-of <> ? THEN 
                                                                       ordens-embarque.cod-natur-of
                                                                   ELSE
                                                                       tt-parametros.nat-operacao
                           tt-itens-aux.nr-ato-concessorio       = c-nr-ato-concessorio
                           tt-itens-aux.preco-unit               = de-preco-unit      
                           tt-itens-aux.preco-unit-mo            = de-preco-unit-mo
                           tt-itens-aux.preco-total              = de-preco-total
                           tt-itens-aux.preco-total-mo           = de-preco-total-mo
                           tt-itens-aux.preco-total-dec          = de-preco-total-mo
                           tt-itens-aux.desconto                 = de-desconto-cc
                           tt-itens-aux.num-pedido               = ordem-compra.num-pedido
                           tt-itens-aux.tp-despesa               = ordem-compra.tp-despesa
                           tt-itens-aux.cod-refer                = c-pzo-com-refer
                           tt-itens-aux.cod-depos                = c-cod-depos
                           tt-itens-aux.l-regime                 = l-regime
                           tt-itens-aux.aliquota-ipi             = de-aliquota-ipi
                           tt-itens-aux.un                       = item.un
                           tt-itens-aux.qtd-do-forn              = ordens-embarque.qt-do-forn
                           tt-itens-aux.un-fornec                = cotacao-item.un
                           tt-itens-aux.l-gera-prim-nf-remes-mae = pl-gera-prim-nf-remes-mae
                           tt-itens-aux.r-rowid                  = ROWID(ordens-embarque). 

                    IF tt-itens-aux.preco-total > de-val-maior THEN
                        ASSIGN r-rowid-item = rowid(tt-itens-aux)
                               de-val-maior = tt-itens-aux.preco-total.
            
                    IF LAST (ordens-embarque.numero-ordem) AND NOT tt-parametros.l-gera-prim-nf-remes-mae THEN
                        RUN pi-acerta-residuo(INPUT r-rowid-item).
                       
                    IF tt-itens-aux.tipo-con-est  = 1 THEN
                        ASSIGN tt-itens-aux.situacao = YES.
                    ELSE
                        ASSIGN tt-itens-aux.situacao = NO.
                END.
                        
                FIND FIRST tt-itens-aux
                     WHERE tt-itens-aux.numero-ordem = ordens-embarque.numero-ordem
                       AND tt-itens-aux.parcela      = ordens-embarque.parcela
                       AND tt-itens-aux.sequencial   = 1 EXCLUSIVE-LOCK NO-ERROR.
                
                IF AVAIL tt-itens-aux THEN DO:

                    IF l-create-itens THEN
                        ASSIGN tt-itens-aux.preco-total        = de-preco-total
                               tt-itens-aux.preco-total-mo     = de-preco-total-mo
                               tt-itens-aux.desconto           = de-desconto-cc.
            
                    {cxbo/bocx225e.i2 no ordens-embarque} /* busca valores atributos livres */
                    
                    /* Verifica se j† foram informados valores para o item nas ordens de embarque */
                    {cxbo/bocx225e.i4 no ordens-embarque} /* busca valores atributos livres */
                     
                    ASSIGN l-gravado                 = l-ja-gravado
                           tt-itens-aux.peso-bruto   = de-peso-bruto-i1   
                           tt-itens-aux.peso-liquido = de-peso-liquido-i1 
                           tt-itens-aux.val-cub-tot  = ordens-embarque.val-cub-tot.
            
                    IF l-gravado THEN
                        ASSIGN tt-itens-aux.cd-trib-ii        = i-trib-ii-i1
                               tt-itens-aux.cd-trib-ipi       = i-trib-ipi-i1
                               tt-itens-aux.cd-trib-icms      = i-trib-icms-i1
                               tt-itens-aux.aliquota-ii       = de-aliq-ii-i1
                               tt-itens-aux.aliquota-ipi      = de-aliq-ipi-i1
                               tt-itens-aux.aliquota-icms     = de-aliq-icms-i1
                               tt-itens-aux.l-ordens-embarque = YES.
                   
                    IF tt-itens-aux.l-ordens-embarque THEN DO:
                        ASSIGN tt-itens-aux.suspensao-II  = ordens-embarque.log-suspens-impto-import
                               tt-itens-aux.suspensao-IPI = ordens-embarque.log-suspens-ipi-import.
                    END.
                    ELSE DO:
                        
                        IF AVAIL tt-parametros THEN
                            FIND FIRST natur-oper
                                 WHERE natur-oper.nat-operacao = tt-parametros.nat-operacao NO-LOCK NO-ERROR.
                         
                        IF AVAIL natur-oper THEN
                            ASSIGN tt-itens-aux.suspensao-II  = natur-oper.log-suspens-impto-import
                                   tt-itens-aux.suspensao-IPI = natur-oper.log-suspens-ipi-import.
                        
                        IF NOT tt-itens-aux.suspensao-II
                        OR NOT tt-itens-aux.suspensao-IPI THEN DO:
                            
                            FIND FIRST item-mat
                                 WHERE item-mat.it-codigo = item.it-codigo NO-LOCK NO-ERROR.
                        
                            IF AVAIL item-mat THEN DO:
                        
                                IF NOT tt-itens-aux.suspensao-II  THEN
                                    ASSIGN tt-itens-aux.suspensao-II  = item-mat.log-suspens-impto-import.
                           
                                IF NOT tt-itens-aux.suspensao-IPI THEN
                                    ASSIGN tt-itens-aux.suspensao-IPI = item-mat.log-suspens-ipi-import.
                            END.
                        END.
                    END.
                END. 
            END.
        END.
    END.

    RETURN "OK":U.
END PROCEDURE.


PROCEDURE piValidaImpostosInformados:
/*------------------------------------------------------------------------------
  Purpose:    caso n∆o tenha sido informada tributaá∆o dos impostos para                              
              todos os embarques relacionados Ö nota m∆e/remessa, n∆o permite a geraá∆o da nota fiscal
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
   DEFINE INPUT  PARAMETER pc-cod-estabel LIKE ordens-embarque.cod-estabel NO-UNDO.
   DEFINE INPUT  PARAMETER pc-embarque    LIKE ordens-embarque.embarque    NO-UNDO.
   DEFINE INPUT  PARAMETER l-cria-lista   AS   LOGICAL                     NO-UNDO.
   DEFINE OUTPUT PARAMETER pl-emite-erro  AS   LOGICAL                     NO-UNDO.
   
   DEFINE VARIABLE c-param1 AS CHARACTER NO-UNDO.
   
   ASSIGN pl-emite-erro = NO.

   FOR EACH ordens-embarque
      WHERE ordens-embarque.cod-estabel = pc-cod-estabel
        AND ordens-embarque.embarque    = pc-embarque NO-LOCK:
       
       {cxbo/bocx225e.i4 no ordens-embarque} /* busca valores atributos livres */
       ASSIGN l-gravado = l-ja-gravado.
        
       IF NOT l-gravado THEN DO:
           
           ASSIGN pl-emite-erro = YES.
           
           IF l-cria-lista THEN DO:
               
               IF NOT CAN-FIND(FIRST tt-lista-embarque) THEN
                   CREATE tt-lista-embarque.
               
               IF AVAIL tt-lista-embarque THEN
                   ASSIGN tt-lista-embarque.embarques = tt-lista-embarque.embarques + (IF tt-lista-embarque.embarques <> "":U THEN ", ":U ELSE "":U) 
                                                      + ordens-embarque.embarque.
           END.
       END.
   END.
    
   RETURN "OK":U.
END PROCEDURE.


PROCEDURE ValidaPrimRemesComNfMae:
/*------------------------------------------------------------------------------
  Purpose:     Respons†vel pelas validaá‰es da geraá∆o da Primeira Remessa com a NF M∆e
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
   DEFINE INPUT  PARAMETER ccod-estabel LIKE embarque-imp.cod-estabel NO-UNDO.
   DEFINE INPUT  PARAMETER cembarque    LIKE embarque-imp.embarque    NO-UNDO.
   DEFINE OUTPUT PARAMETER TABLE FOR tt-bo-erro.
   
   DEFINE VARIABLE c-param1        AS CHARACTER NO-UNDO.
   DEFINE VARIABLE c-param2        AS CHARACTER NO-UNDO.
   DEFINE VARIABLE c-param3        AS CHARACTER NO-UNDO.
   DEFINE VARIABLE l-warning-filho AS LOGICAL   NO-UNDO.
   DEFINE VARIABLE l-emite-erro    AS LOGICAL   NO-UNDO.
   DEFINE VARIABLE l-erro-pai      AS LOGICAL   NO-UNDO.
   
   RUN piBuscaEmbarquesRelacionados (INPUT  ccod-estabel,
                                     INPUT  cembarque,
                                     OUTPUT TABLE tt-embarque-pai,
                                     OUTPUT TABLE tt-embarque-filho).
   
   FIND FIRST embarque-imp 
        WHERE embarque-imp.cod-estabel = ccod-estabel 
          AND embarque-imp.embarque    = cembarque NO-LOCK NO-ERROR.
    
   IF AVAIL embarque-imp THEN DO:
       
       FIND FIRST tt-embarque-pai NO-LOCK NO-ERROR. 
       
       IF AVAIL tt-embarque-pai THEN DO:
           
           ASSIGN l-warning-filho = YES.

           IF NOT (tt-embarque-pai.cod-estabel  = ccod-estabel AND tt-embarque-pai.embarque = cembarque) THEN DO:
               
               {utp/ut-liter.i Embarque * r}
               ASSIGN c-param1 = TRIM(RETURN-VALUE).
               {utp/ut-liter.i Para_este_tipo_de_documento,_dever†_ser_informado_o_embarque_de_origem:  * r}

               RUN criaTTBoErro(158, c-param1 + "~~":U + RETURN-VALUE + " " + tt-embarque-pai.embarque).
          END.
          
          if i-pais-impto-usuario = 1 /* Brasil */ then do:

                  RUN piValidaImpostosInformados (INPUT  tt-embarque-pai.cod-estabel,
                                                  INPUT  tt-embarque-pai.embarque,
                                                  INPUT  NO,
                                                  OUTPUT l-erro-pai).
                                                  
                  ASSIGN l-emite-erro = l-erro-pai.
          
          end.          
        
          IF NOT CAN-FIND(FIRST tt-embarque-filho) THEN DO:

              {utp/ut-liter.i Embarque * r}     
              ASSIGN c-param1 = TRIM(RETURN-VALUE).
              {utp/ut-liter.i Para_que_a_primeira_remessa_seja_gerada_junto_com_a_nota_m∆e,_deve_existir_ao_menos_um_embarque_relacionado_ao_embarque_da_nota_m∆e * r}

              RUN criaTTBoErro(158, c-param1 + "~~":U + RETURN-VALUE).
          END.
          ELSE DO:
              
              if i-pais-impto-usuario = 1 /* Brasil */ then do:
                      FOR EACH tt-embarque-filho:
                          
                          RUN piValidaImpostosInformados (INPUT  tt-embarque-filho.cod-estabel,
                                                          INPUT  tt-embarque-filho.embarque,
                                                          INPUT  YES,
                                                          OUTPUT l-erro-pai).
                       END.
               end.
          END.

          IF (l-emite-erro OR l-warning-filho) AND i-pais-impto-usuario = 1 /* Brasil */ THEN DO:
              
              IF  l-emite-erro 
              AND CAN-FIND(FIRST tt-embarque-filho) THEN DO:

                  {utp/ut-liter.i Verifique_os_dados_de_Impostos_(Tributaá∆o_e_Al°quota)_para_esta_Nota_Fiscal!* L}
                  ASSIGN c-param1 = TRIM(RETURN-VALUE).
                  {utp/ut-liter.i Acessar_bot∆o_"Impostos"_na_rotina_IM0045_e/ou_IM0100_para_preenchimento * l}
                  ASSIGN c-param2 = TRIM(RETURN-VALUE).
                  {utp/ut-liter.i Maiores_informaá‰es,_consultar_Base_de_Conhecimento(TDN):_DMIM0097_Œ_Funcionalidade_'Gera_Primeira_Remessa_com_NF_M∆e'_no_IM0100 * L}

                  RUN criaTTBoErro(55488, c-param1 + "~~":U + c-param2 + " " + CHR(13) + CHR(13) + TRIM(RETURN-VALUE)).
              END.

              IF l-warning-filho THEN DO:

                  FOR FIRST tt-lista-embarque NO-LOCK: END.

                  IF AVAIL tt-lista-embarque THEN DO:
                      
                      {utp/ut-liter.i os_dados_de_Impostos_(Tributaá∆o_e_Al°quota) * L}
                      ASSIGN c-param1 = TRIM(RETURN-VALUE).
                      {utp/ut-liter.i Caso_necess†rio,_acessar_bot∆o_"Impostos"_na_rotina_IM0045_para_preenchimento * l}       
                      ASSIGN c-param2 = TRIM(RETURN-VALUE).
                      {utp/ut-liter.i Maiores_informaá‰es,_consultar_Base_de_Conhecimento(TDN):_DMIM0097_+_Funcionalidade_'Gera_Primeira_Remessa_com_NF_M∆e'_no_IM0100 * L}
                      
                      RUN criaTTBoErro(55489, c-param1 + "~~" + tt-lista-embarque.embarques + "~~":U + CHR(13) + CHR(13) + c-param2 + "~~":U + CHR(13) + CHR(13) + RETURN-VALUE).
                  END.
              END.
           END.
       END.
    END.
    
    RETURN "OK":U.
END PROCEDURE.
     

PROCEDURE piBuscaEmbarquesRelacionados:
/*------------------------------------------------------------------------------
  Purpose:     Procedure respons†vel por realizar a busca dos desembarques parciais
               realizados pelo im0099                                              
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER pccod-estabel LIKE embarque-imp.cod-estabel NO-UNDO.
    DEFINE INPUT  PARAMETER pcembarque    LIKE embarque-imp.embarque    NO-UNDO.
    DEFINE OUTPUT PARAMETER TABLE FOR tt-embarque-pai.
    DEFINE OUTPUT PARAMETER TABLE FOR tt-embarque-filho.
    
    define variable vlExisteFilho         as logical    initial yes     no-undo.
    define variable vcEmbarque            as character                  no-undo.
   
    empty temp-table tt-embarque-pai.
    empty temp-table tt-embarque-filho.
    
    FIND FIRST embarque-imp WHERE embarque-imp.cod-estabel = pccod-estabel 
                            AND embarque-imp.embarque      = pcembarque
                            NO-LOCK NO-ERROR.
    IF AVAIL embarque-imp THEN DO:
       IF TRIM(SUBSTRING(embarque-imp.char-1,21,20)) <> "" THEN DO: /*embarque pai*/
          CREATE tt-embarque-pai.
          ASSIGN tt-embarque-pai.embarque     = TRIM(substring(embarque-imp.char-1,21,20))
                 tt-embarque-pai.cod-estabel  = embarque-imp.cod-estabel.    
       END.
       ELSE DO:     
          CREATE tt-embarque-pai.
          ASSIGN tt-embarque-pai.embarque     = embarque-imp.embarque
                 tt-embarque-pai.cod-estabel  = embarque-imp.cod-estabel.      
       END.
    END.
    
    FIND FIRST tt-embarque-pai NO-LOCK NO-ERROR.
    IF AVAIL tt-embarque-pai THEN DO:
        assign vcEmbarque = tt-embarque-pai.embarque.
        
        repeat while vlExisteFilho:
            run piBuscaEmbarquesFilho(input tt-embarque-pai.cod-estabel,
                                      input vcEmbarque).
            if return-value = "NOK" then
                assign vlExisteFilho = no.
            else
                assign vcEmbarque = return-value.
        end.
    end.
    
    RETURN "OK":U.
END PROCEDURE.

procedure piBuscaEmbarquesFilho:
    DEFINE INPUT  PARAMETER vpCodEstabel  LIKE embarque-imp.cod-estabel NO-UNDO.
    DEFINE INPUT  PARAMETER vpEmbarque    LIKE embarque-imp.embarque    NO-UNDO.
    
    define variable vcRetorno             as character  initial "NOK"   no-undo.
    
    /* Cria registro para os outros filhos*/
    FOR EACH b-embarque-imp WHERE b-embarque-imp.cod-estabel                   = vpCodEstabel
                            AND   TRIM(substring(b-embarque-imp.char-1,21,20)) = vpEmbarque
                            NO-LOCK:
        FIND FIRST tt-embarque-filho WHERE tt-embarque-filho.embarque    = b-embarque-imp.embarque
                                     AND   tt-embarque-filho.cod-estabel = b-embarque-imp.cod-estabel
                                     NO-ERROR.
        IF NOT AVAIL tt-embarque-filho THEN DO:
            CREATE tt-embarque-filho.
            ASSIGN tt-embarque-filho.embarque     = b-embarque-imp.embarque
                   tt-embarque-filho.cod-estabel  = b-embarque-imp.cod-estabel
                   vcRetorno                      = b-embarque-imp.embarque.
        end.
    END.
    
    return vcRetorno.
END.


PROCEDURE piBuscaItensNotasRemessa:
/*------------------------------------------------------------------------------
  Purpose:     Procedure respons†vel por localizar os embarques relacionados atravÇs
               de uma faixa de dados
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER pccod-estabel LIKE embarque-imp.cod-estabel NO-UNDO.
    DEFINE INPUT  PARAMETER pcembarque    LIKE embarque-imp.embarque    NO-UNDO.
    DEFINE OUTPUT PARAMETER TABLE FOR tt-embarque-pai.
    DEFINE OUTPUT PARAMETER TABLE FOR tt-embarque-filho.
    
    RUN piBuscaEmbarquesRelacionados (INPUT  pccod-estabel,
                                      INPUT  pcembarque,
                                      OUTPUT TABLE tt-embarque-pai,
                                      OUTPUT TABLE tt-embarque-filho).
   
    RETURN "OK":U.
END PROCEDURE.


PROCEDURE isTransfDrawback:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER TABLE FOR tt-parametros.
    DEFINE OUTPUT PARAMETER p-is-transf-drawback LIKE embarque-imp.log-embarq-transf-draw NO-UNDO.
    
    ASSIGN p-is-transf-drawback = NO.
    
    FOR FIRST tt-parametros,
        FIRST b-embarque-imp NO-LOCK
        WHERE b-embarque-imp.cod-estabel = tt-parametros.cod-estabel
        AND   b-embarque-imp.embarque    = tt-parametros.embarque:

        ASSIGN p-is-transf-drawback = b-embarque-imp.log-embarq-transf-draw.
    END.

    RETURN "OK":U.
END PROCEDURE.


PROCEDURE atualizaDoctoInternac:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAM TABLE FOR tt-docto-estoq-internac.

    RETURN "OK":U.
END PROCEDURE.


PROCEDURE criaTTBoErro:
/*------------------------------------------------------------------------------
  Purpose: Criacao da temp-table de erros retornada na execucao das procedures
  Parameters: INPUT - pi-cod-error (integer) - codigo do erro
              INPUT - pc-parameters (character) - parametros da mensagem de erro
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pi-cod-error  AS INTEGER    NO-UNDO.
    DEFINE INPUT PARAMETER pc-parameters AS CHARACTER  NO-UNDO.

    ASSIGN i-seq-erro = i-seq-erro + 1.
    
    RUN utp/ut-msgs.p (INPUT "msg":U, INPUT pi-cod-error, INPUT pc-parameters).

    CREATE tt-bo-erro.
    ASSIGN tt-bo-erro.i-sequen   = i-seq-erro
           tt-bo-erro.cd-erro    = pi-cod-error
           tt-bo-erro.mensagem   = RETURN-VALUE
           tt-bo-erro.parametros = pc-parameters
           tt-bo-erro.errortype  = "EMS":U.

    RUN utp/ut-msgs.p (INPUT "help":U, INPUT pi-cod-error, INPUT pc-parameters).

    ASSIGN tt-bo-erro.errorhelp = RETURN-VALUE.

    RUN utp/ut-msgs.p (INPUT "CodType":U, INPUT pi-cod-error, INPUT pc-parameters).
    
    CASE RETURN-VALUE:
        WHEN '1':U THEN
            ASSIGN tt-bo-erro.errorsubtype = "ERROR":U.
        WHEN '2':U THEN
            ASSIGN tt-bo-erro.errorsubtype = "WARNING":U.
        WHEN '3':U THEN
            ASSIGN tt-bo-erro.errorsubtype = "QUESTION":U.
        WHEN '4':U THEN
            ASSIGN tt-bo-erro.errorsubtype = "INFORMATION":U.
    END CASE.

    RETURN "OK":U.
END PROCEDURE.

