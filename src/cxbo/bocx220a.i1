{cdp/cd9701.i} /* M˙ltiplas naturezas no recebimento */


PROCEDURE validarParametrosdesembarque:
/*------------------------------------------------------------------------------
  Purpose:     Valida valores informados para o desembarque/geraá∆o documentos
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER TABLE FOR tt-parametros. 
    DEFINE OUTPUT PARAMETER TABLE FOR tt-bo-erro.
    
    DEFINE VARIABLE l-valida-data-di AS LOGICAL NO-UNDO.

    IF NOT AVAIL param-global THEN
        FIND FIRST param-global NO-LOCK NO-ERROR.
    
    {cxbo/bocx220a.i2} /* Validaá‰es ParÉmetros */       
    
    IF  i-tp-nacionaliz <> 2 /* DI */
    and i-tp-nacionaliz <> 3 /* DUIMP */ 
    AND CAN-FIND(FIRST decla-import-embarq
                 WHERE decla-import-embarq.cod-estab  = tt-parametros.cod-estabel 
                   AND decla-import-embarq.cod-embarq = tt-parametros.embarque    ) THEN DO:

        RUN criaTTBoErro(54555, tt-parametros.embarque).
    END.

    /* Data di */        
    IF tt-parametros.da-di = ? THEN DO:
        {utp/ut-liter.i Data_DI * L}
        RUN criaTTBoErro(265, TRIM(RETURN-VALUE)).
    END.
    

    IF tt-parametros.cod-emitente = 0 OR tt-parametros.cod-emitente = ? THEN DO:
        
        {utp/ut-liter.i Emitente * L}
        RUN criaTTBoErro(6189, TRIM(RETURN-VALUE)).
    END.
    
    ASSIGN c-cod-estabel-im0100 = tt-parametros.cod-estabel.

    /* Verifica data efetiva do embarque */
    FIND FIRST ordens-embarque
         WHERE ordens-embarque.cod-estabel = tt-parametros.cod-estabel
           AND ordens-embarque.embarque    = tt-parametros.embarque NO-LOCK NO-ERROR.

    IF AVAIL ordens-embarque THEN DO:
        
        FIND FIRST historico-embarque
             WHERE historico-embarque.cod-estabel = ordens-embarque.cod-estabel
               AND historico-embarque.embarque    = ordens-embarque.embarque NO-LOCK NO-ERROR.

        IF AVAIL historico-embarque THEN DO:

            FOR FIRST embarque-imp FIELDS(cdn-pto-desembar log-embarq-transf-draw) NO-LOCK
                WHERE embarque-imp.cod-estabel = ordens-embarque.cod-estabel
                  AND embarque-imp.embarque = ordens-embarque.embarque: END.
            
            FIND FIRST historico-embarque 
                 WHERE historico-embarque.cod-estabel   = ordens-embarque.cod-estabel 
                   AND historico-embarque.embarque      = ordens-embarque.embarque    
                   AND historico-embarque.cod-itiner    = historico-embarque.cod-itiner  
                   AND historico-embarque.cod-pto-contr = embarque-imp.cdn-pto-desembar NO-LOCK NO-ERROR.

            IF AVAIL historico-embarque THEN DO:

                IF historico-embarque.dt-efetiva = ? THEN DO:

                    {utp/ut-liter.i Dt_Efetiva_de_Desembarque_do_Embarque} 
                    RUN criaTTBoErro(3553, TRIM(RETURN-VALUE) + " " + historico-embarque.embarque).
                END.
            END.
            ELSE DO:

                {utp/ut-liter.i ponto_de_desembarque * L}
                ASSIGN c-return1 = TRIM(RETURN-VALUE) + " " + STRING(embarque-imp.cdn-pto-desembar).
                {utp/ut-liter.i Historico_Embarque * L}

                RUN criaTTBoErro(16381, c-return1 + "~~":U + RETURN-VALUE).
            END.
        END.
        ELSE DO: /* N∆o existe processo de importaá∆o */

            {utp/ut-liter.i Processo_Importaá∆o * L}
            RUN criaTTBoErro(2, trim(return-value) + "~~":U + STRING(ordens-embarque.nr-proc-imp)).
            
        END.

        IF i-pais-impto-usuario <> 1 THEN DO:
                       
            FIND FIRST natur-operac-internac NO-LOCK
                 WHERE natur-operac-internac.cod-natur-operac = tt-parametros.nat-operacao NO-ERROR.
            
            IF  (embarque-imp.log-embarq-transf-draw AND NOT AVAIL natur-operac-internac) OR
                (AVAIL natur-operac-internac AND embarque-imp.log-embarq-transf-draw <> natur-operac-internac.log-transf-draw) THEN DO:
                
                /* A natureza n∆o Ç do tipo transferància drawback */
                RUN criaTTBoErro(55805, "").
            END.
        END.

    END.
    ELSE DO: /* N∆o existem ordens para o desembarque */

        {utp/ut-liter.i Ordens_Embarque * L}
        RUN criaTTBoErro(2, TRIM(RETURN-VALUE)).
    END.
    
    /* Se n∆o houver erros, atualiza informaá‰es no embarque */
    FIND FIRST tt-bo-erro NO-ERROR.
    IF NOT AVAIL tt-bo-erro THEN DO:

        FIND FIRST b-embarque-imp
             WHERE b-embarque-imp.embarque    = tt-parametros.embarque
               AND b-embarque-imp.cod-estabel = tt-parametros.cod-estabel EXCLUSIVE-LOCK NO-ERROR.

        IF AVAIL b-embarque-imp THEN
            ASSIGN b-embarque-imp.declaracao-import = tt-parametros.declaracao-import
                   b-embarque-imp.data-DI           = tt-parametros.da-di
                   b-embarque-imp.data-1            = tt-parametros.da-cotacao
                   b-embarque-imp.dec-1             = tt-parametros.d-cotacao.
        RELEASE b-embarque-imp.                                                
    END.

    RETURN "OK":U.
END PROCEDURE.


PROCEDURE ValidaEmitenteEmbarque:
/*------------------------------------------------------------------------------
  Purpose:     Procedure criada para verificar se o emitente da nacionalizaá∆o Ç diferente 
               do emitente do pedido.
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
   DEFINE INPUT  PARAMETER TABLE FOR tt-parametros.
   DEFINE OUTPUT PARAMETER l-emit-diferente AS LOGICAL NO-UNDO.
   DEFINE OUTPUT PARAMETER l-fornec-fundap  AS LOGICAL NO-UNDO.
      
   FIND FIRST tt-parametros NO-LOCK NO-ERROR.
   
   ASSIGN l-emit-diferente = NO
          l-fornec-fundap  = NO.
   
   FIND FIRST ordens-embarque
        WHERE ordens-embarque.cod-estabel = tt-parametros.cod-estabel
          AND ordens-embarque.embarque    = tt-parametros.embarque NO-LOCK NO-ERROR.

   IF AVAIL ordens-embarque THEN DO:
       
       FIND FIRST ordem-compra
            WHERE ordem-compra.numero-ordem = ordens-embarque.numero-ordem NO-LOCK NO-ERROR.
                  
       IF AVAIL ordem-compra THEN DO:

           FIND FIRST pedido-compr
                WHERE pedido-compr.num-pedido = ordem-compra.num-pedido NO-LOCK NO-ERROR.

           IF AVAIL pedido-compr THEN
              IF pedido-compr.cod-emitente <> tt-parametros.cod-emitente THEN
                  ASSIGN l-emit-diferente = YES.
       END.
   END.
 
   FIND FIRST estabelec
        WHERE estabelec.cod-estabel = tt-parametros.cod-estabel NO-LOCK NO-ERROR.
        
   FIND FIRST emitente
        WHERE emitente.cod-emitente = tt-parametros.cod-emitente NO-LOCK NO-ERROR.

   /* Verifica se Ç operaá∆o de FUNDAP */
   IF AVAIL estabelec AND AVAIL emitente  THEN
       IF emitente.pais = estabelec.pais THEN
           ASSIGN l-fornec-fundap = YES.

    RETURN "OK":U.
END PROCEDURE.


PROCEDURE gerarItensdesembarque:
/*------------------------------------------------------------------------------
  Purpose:     Cria temp-table com itens para o desembarque 
               Valida ordem de compra/cotaá∆o/pedido 
               Valida item/classificaá∆o fiscal
               Valida Natureza de operacao da nota, contra a dos itens
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT        PARAMETER TABLE FOR tt-parametros.
    DEFINE INPUT-OUTPUT PARAMETER TABLE FOR tt-itens-aux.
    DEFINE OUTPUT       PARAMETER TABLE FOR tt-bo-erro.

    DEFINE VARIABLE c-naturezas-itens AS CHARACTER NO-UNDO.
    
    IF CAN-FIND(FIRST tt-itens-aux) THEN 
        ASSIGN l-create-itens = YES.
    
    EMPTY TEMP-TABLE tt-bo-erro.
    ASSIGN i-seq-erro = 0.
    
    FOR EACH tt-parametros: 
    
        /* Usu†rio cadastrado no cadastro de usu†rios do recebimento */
        FIND FIRST param-re
             WHERE param-re.usuario = tt-parametros.usuario NO-LOCK NO-ERROR.

        IF NOT AVAIL param-re THEN DO:

            RUN criaTTBoErro(16482, tt-parametros.usuario).
            UNDO, LEAVE.
        END.
        
        FIND FIRST embarque-imp
             WHERE embarque-imp.cod-estabel = tt-parametros.cod-estabel
               AND embarque-imp.embarque    = tt-parametros.embarque NO-LOCK NO-ERROR.
        
        IF AVAIL embarque-imp THEN DO:
            
            ASSIGN de-val-maior = 0
                   l-dep-ext    = tt-parametros.envia-dep-ext.
            
            IF tt-parametros.l-gera-prim-nf-remes-mae THEN DO:
                
                FIND FIRST tt-embarque-pai NO-LOCK NO-ERROR.

                IF AVAIL tt-embarque-pai THEN /*gera os itens do embarque pai*/
                    RUN gerarItensDesembarqueAux (INPUT tt-embarque-pai.cod-estabel,
                                                  INPUT tt-embarque-pai.embarque,
                                                  INPUT YES).

               FOR EACH tt-embarque-filho: /*gera os itens dos embarques filhos*/
                   RUN gerarItensDesembarqueAux (INPUT tt-embarque-filho.cod-estabel,
                                                 INPUT tt-embarque-filho.embarque,
                                                 INPUT NO).
               END.

               RUN piResiduoItensNfMaeComRemessa IN THIS-PROCEDURE.
            END.
            ELSE DO:
                
                RUN gerarItensDesembarqueAux (INPUT tt-parametros.cod-estabel,
                                              INPUT tt-parametros.embarque,
                                              INPUT NO).
            END.

            IF NOT CAN-FIND(FIRST tt-itens-aux WHERE tt-itens-aux.quantidade > 0) THEN DO:
                
                RUN criaTTBoErro(55226, tt-parametros.embarque).
                UNDO, LEAVE.
            END.
        END.

        IF  l-mult-natur-receb
        AND NOT CAN-FIND(FIRST tt-itens-aux
                        WHERE tt-itens-aux.nat-fiscal = tt-parametros.nat-operacao) THEN DO:

            RUN getNaturezaItens(OUTPUT c-naturezas-itens).
            
            RUN criaTTBoErro(57165, tt-parametros.nat-operacao + "~~" + c-naturezas-itens).
        END.
    END.

    RETURN "OK":U.
END PROCEDURE.


PROCEDURE getNaturezaItens:
/*------------------------------------------------------------------------------
  Purpose:     Retornar todas as naturezas de operacao dos itens separadas por vigula
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER c-naturezas AS CHARACTER NO-UNDO.

    EMPTY TEMP-TABLE tt-naturezas.

    FOR EACH tt-itens-aux:

        IF NOT CAN-FIND(FIRST tt-naturezas
                        WHERE tt-naturezas.nat-fiscal = tt-itens-aux.nat-fiscal) THEN DO:
            
            CREATE tt-naturezas.
            ASSIGN tt-naturezas.nat-fiscal = tt-itens-aux.nat-fiscal
                   c-naturezas             = IF c-naturezas = "" THEN tt-itens-aux.nat-fiscal ELSE c-naturezas + ", ":U + tt-itens-aux.nat-fiscal.
        END.
    END.

    RETURN "OK".
END PROCEDURE.


PROCEDURE calculaValoresInternacional:
/*------------------------------------------------------------------------------
  Purpose:     Cria temp-table com itens para o desembarque
               Valida ordem de compra/cotaá∆o/pedido       
               Valida item/classificaá∆o fiscal            
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT        PARAMETER TABLE FOR tt-parametros.
    DEFINE INPUT-OUTPUT PARAMETER TABLE FOR tt-itens-aux.
    DEFINE OUTPUT       PARAMETER TABLE FOR tt-bo-erro.

    DEFINE VARIABLE c-return-value        AS   CHARACTER                          NO-UNDO.
    DEFINE VARIABLE i-cont                AS   INTEGER                            NO-UNDO.
    DEFINE VARIABLE c-class-fiscal        LIKE classif-fisc.class-fiscal          NO-UNDO.
    DEFINE VARIABLE de-preco-unit-mo      LIKE cotacao-item.preco-unit            NO-UNDO.
    DEFINE VARIABLE de-preco-total        LIKE item-doc-est.preco-total  EXTENT 0 NO-UNDO.
    DEFINE VARIABLE de-preco-total-mo     LIKE item-doc-est.preco-total  EXTENT 0 NO-UNDO.
    DEFINE VARIABLE de-preco-total-aux    LIKE item-doc-est.preco-unit   EXTENT 0 NO-UNDO.
    DEFINE VARIABLE de-preco-total-mo-aux LIKE item-doc-est.preco-unit   EXTENT 0 NO-UNDO.
    DEFINE VARIABLE l-create-itens        AS   LOGICAL                            NO-UNDO.
    DEFINE VARIABLE c-cod-depos           LIKE ordem-compra.dep-almoxar           NO-UNDO.
    DEFINE VARIABLE de-aliquota-ipi       LIKE item.aliquota-ipi                  NO-UNDO.
    DEFINE VARIABLE l-regime              AS   LOGICAL                            NO-UNDO.
    DEFINE VARIABLE l-gravado             AS   LOGICAL INITIAL NO                 NO-UNDO.
    DEFINE VARIABLE r-rowid-item          AS   ROWID                              NO-UNDO.
    DEFINE VARIABLE de-val-maior          LIKE item-doc-est.preco-total[1]        NO-UNDO.
    DEFINE VARIABLE de-desconto-cc        LIKE cotacao-item.valor-descto          NO-UNDO.
    DEFINE VARIABLE de-taxa               LIKE cotacao-item.valor-taxa            NO-UNDO.
    DEFINE VARIABLE d-aliquota-ipi        LIKE cotacao-item.aliquota-ipi          NO-UNDO.

    EMPTY TEMP-TABLE tt-bo-erro.
    ASSIGN i-seq-erro = 0.

    FIND FIRST tt-parametros NO-ERROR.

    FOR EACH tt-itens-aux:

         FIND FIRST ordem-compra WHERE ordem-compra.numero-ordem = tt-itens-aux.numero-ordem NO-LOCK NO-ERROR.

         IF AVAIL ordem-compra THEN DO:
             
             ASSIGN de-preco-unit-mo      = 0
                    de-preco-total        = 0
                    de-preco-total-mo     = 0
                    de-preco-total-aux    = 0.


             /* Cotaá∆o do item */
             FIND FIRST cotacao-item
                  WHERE cotacao-item.numero-ordem = ordem-compra.numero-ordem
                    AND cotacao-item.cod-emitente = ordem-compra.cod-emitente
                    AND cotacao-item.it-codigo    = ordem-compra.it-codigo
                    AND cotacao-item.cot-aprovada NO-LOCK NO-ERROR.

             IF NOT AVAIL cotacao-item THEN DO:

                 {utp/ut-liter.i Cotaá∆o_Item * L}
                 RUN criaTTBoErro(2, RETURN-VALUE + "~~":U + STRING(ordens-embarque.numero-ordem)).
             END.
             ELSE DO:
                 IF cotacao-item.mo-codigo <> 0 THEN
                     ASSIGN de-cotacao-dia = tt-parametros.d-cotacao.
                 ELSE
                     ASSIGN de-cotacao-dia = 1.

                 RUN rep/re1908int.p (ROWID(ordem-compra),
                                      embarque-imp.dec-1,
                                      OUTPUT de-preco-unit-mo,
                                      OUTPUT de-desconto-cc,
                                      OUTPUT de-taxa).

                 /* Calcula valor s/ IPI */
                 ASSIGN de-preco-unit-mo = cotacao-item.pre-unit-for
                        d-aliquota-ipi   = 0.

                 IF i-pais-impto-usuario = 9 /* Paraguai */ AND cotacao-item.codigo-ipi AND cotacao-item.aliquota-ipi = 0 THEN DO:

                      FIND FIRST item-mat NO-LOCK
                           WHERE item-mat.it-codigo = cotacao-item.it-codigo
                             AND item-mat.cod-tax   > 0 NO-ERROR.

                      IF AVAIL item-mat THEN DO:
                          FIND FIRST tipo-tax NO-LOCK WHERE tipo-tax.cod-tax = item-mat.cod-tax NO-ERROR. 
                          IF AVAIL tipo-tax THEN
                              ASSIGN d-aliquota-ipi = tipo-tax.tax-perc.                                
                      END.
                 END.
                 ELSE
                     ASSIGN d-aliquota-ipi = cotacao-item.aliquota-ipi.

                 ASSIGN de-preco-unit-mo  = (de-preco-unit-mo * 100) / (100 + d-aliquota-ipi)
                        de-preco-total-mo = de-preco-unit-mo  * tt-itens-aux.qtd-do-forn
                        de-preco-total    = de-preco-total-mo
                        de-desconto-cc    = de-desconto-cc    * tt-itens-aux.qtd-do-forn.

                 IF cotacao-item.mo-codigo <> 0 THEN
                     RUN cdp/cd0812a.p (INPUT  cotacao-item.mo-codigo,
                                        INPUT  0,
                                        INPUT  de-preco-total-mo,
                                        INPUT  tt-parametros.d-cotacao,
                                        OUTPUT de-preco-total).

                 ASSIGN tt-itens-aux.preco-total    = de-preco-total
                        tt-itens-aux.preco-total-mo = de-preco-total-mo
                        tt-itens-aux.desconto       = de-desconto-cc.

             END.
         END.
    END.

    RETURN "OK":U.
END PROCEDURE.


PROCEDURE recebevaloreswim0100:
/*------------------------------------------------------------------------------
  Purpose:     Procedure criada para receber valores para do programa web,   
               pois os valores est∆o se perdendo quando Ç chamado o programa 
               wim0100b.w.                                                   
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER p-cod-via-transp  AS INTEGER     NO-UNDO. 
    DEFINE INPUT PARAMETER p-cotacao-dia     AS DECIMAL     NO-UNDO.
    DEFINE INPUT PARAMETER p-pto-contr-base  AS INTEGER     NO-UNDO.
    DEFINE INPUT PARAMETER p-cod-itiner      AS INTEGER     NO-UNDO.
    DEFINE INPUT PARAMETER p-mo-codigo       AS INTEGER     NO-UNDO.
    DEFINE INPUT PARAMETER p-cod-cond-pag    AS INTEGER     NO-UNDO.
    
    ASSIGN i-cod-via-transp     = p-cod-via-transp
           de-cotacao-dia       = p-cotacao-dia
           i-pto-contr-base     = p-pto-contr-base
           i-cod-itiner         = p-cod-itiner
           i-mo-codigo          = p-mo-codigo
           i-cod-cond-pag       = p-cod-cond-pag.

    RETURN "OK":U.
END PROCEDURE.


PROCEDURE retornavaloreswim0100:
/*------------------------------------------------------------------------------
  Purpose:     Procedure criada para retornar valores para o programa web,  
               pois os valores est∆o se perdendo quando Ç chamado o programa
               wim0100b.w.                                                  
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER p-cod-via-transp    AS INTEGER     NO-UNDO. 
    DEFINE OUTPUT PARAMETER p-de-cotacao-dia    AS DECIMAL     NO-UNDO.
    DEFINE OUTPUT PARAMETER p-pto-contr-base    AS INTEGER     NO-UNDO.
    DEFINE OUTPUT PARAMETER p-cod-itiner        AS INTEGER     NO-UNDO.
    DEFINE OUTPUT PARAMETER p-mo-codigo         AS INTEGER     NO-UNDO.
    DEFINE OUTPUT PARAMETER p-cod-cond-pag      AS INTEGER     NO-UNDO.
    
    ASSIGN p-cod-via-transp     = i-cod-via-transp
           p-de-cotacao-dia     = de-cotacao-dia
           p-pto-contr-base     = i-pto-contr-base
           p-cod-itiner         = i-cod-itiner
           p-mo-codigo          = i-mo-codigo
           p-cod-cond-pag       = i-cod-cond-pag.

    RETURN "OK":U.
END PROCEDURE.


PROCEDURE executarDesembarque:
/*------------------------------------------------------------------------------
  Purpose:     Desembarque/geraá∆o de documentos 
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER TABLE FOR tt-parametros.
    DEFINE INPUT  PARAMETER TABLE FOR tt-itens-aux.
    DEFINE INPUT  PARAMETER TABLE FOR tt-quebra-aux.
    DEFINE OUTPUT PARAMETER TABLE FOR tt-bo-erro.
    DEFINE OUTPUT PARAMETER TABLE FOR tt-retorno.
    
    DEFINE VARIABLE c-titulo                AS CHARACTER                            NO-UNDO.
    DEFINE VARIABLE c-acomp                 AS CHARACTER                            NO-UNDO.
    DEFINE VARIABLE h-acomp                 AS HANDLE                               NO-UNDO.    
    DEFINE VARIABLE l-tem-quebra            AS LOGICAL                              NO-UNDO.
    DEFINE VARIABLE l-exec-im7777           AS LOGICAL                              NO-UNDO.
    DEFINE VARIABLE c-nro-docto             LIKE docum-est.nro-docto                NO-UNDO.
    DEFINE VARIABLE de-val-aux              LIKE item-doc-est.preco-unit EXTENT 0   NO-UNDO. 
    DEFINE VARIABLE l-cont-lote-nota-mae    AS LOGICAL                              NO-UNDO.
    
    FIND FIRST tt-parametros NO-ERROR.
    
    IF l-acomp THEN DO:
        RUN utp/ut-acomp.p PERSISTENT SET h-acomp.
        RUN pi-inicializar IN h-acomp (INPUT c-titulo).
        RUN pi-desabilita-cancela IN h-acomp.
    END.
    
    FIND FIRST tt-quebra-aux 
         WHERE tt-quebra-aux.situacao = NO NO-ERROR.

    IF NOT AVAIL tt-quebra-aux THEN DO:

        CREATE tt-nota.
        ASSIGN tt-nota.cod-emitente             = tt-parametros.cod-emitente
               tt-nota.cod-estabel              = tt-parametros.cod-estabel
               tt-nota.dt-emissao               = tt-parametros.da-emissao
               tt-nota.dt-trans                 = tt-parametros.da-transacao
               tt-nota.dt-venc-ipi              = tt-parametros.da-venc-ipi
               tt-nota.dt-venc-icm              = tt-parametros.da-venc-icms
               tt-nota.estab-fisc               = tt-parametros.estab-fisc
               tt-nota.nat-operacao             = tt-parametros.nat-operacao
               tt-nota.nro-docto                = tt-parametros.nro-docto
               tt-nota.serie-docto              = tt-parametros.serie
               tt-nota.observacao               = tt-parametros.observacao
               tt-nota.usuario                  = tt-parametros.usuario
                                                
               tt-nota.ct-transit               = tt-parametros.ct-transit /*int(substring(tt-parametros.ct-transit,1,param-global.tam-conta))*/
               tt-nota.sc-transit               = tt-parametros.sc-transit /*int(substring(tt-parametros.sc-transit,param-global.tam-conta + 1,5)) */   
                                                
               tt-nota.pais-impto-usuario       = tt-parametros.i-pais-impto-usuario
               tt-nota.ph-acomp                 = h-acomp
               tt-nota.pl-acomp                 = l-acomp
               tt-nota.tot-desconto             = tt-parametros.de-tot-desconto
               tt-nota.embarque                 = tt-parametros.embarque
               tt-nota.da-cotacao               = tt-parametros.da-cotacao
               tt-nota.via-transp               = i-cod-via-transp
               tt-nota.cotacao-dia              = de-cotacao-dia
               tt-nota.cod-pto-contr-base       = i-pto-contr-base
               tt-nota.cod-itiner               = i-cod-itiner
               tt-nota.mo-codigo                = i-mo-codigo
               tt-nota.cod-cond-pag             = i-cod-cond-pag
               tt-nota.l-icms-diferido          = tt-parametros.l-icms-diferido
               tt-nota.l-nf-simples-remessa     = tt-parametros.l-nf-simples-remessa 
               tt-nota.idi-nf-simples-remes     = tt-parametros.idi-nf-simples-remes 
               tt-nota.l-nf-ajuste              = tt-parametros.l-nf-ajuste
               tt-nota.l-gera-prim-nf-remes-mae = tt-parametros.l-gera-prim-nf-remes-mae
               tt-nota.ct-codigo                = tt-parametros.ct-codigo       /*conta de simples remessa*/
               tt-nota.sc-codigo                = tt-parametros.sc-codigo       /*centro de custo da simples remessa*/
               tt-nota.d-cotacao                = tt-parametros.d-cotacao
               .
               
        IF l-acomp THEN DO:
            {utp/ut-liter.i Validando_documento... * L}
            ASSIGN c-acomp = TRIM(RETURN-VALUE).
            RUN pi-acompanhar IN h-acomp (INPUT c-acomp).
        END.
        
        FOR EACH tt-itens-aux NO-LOCK
            BREAK BY tt-itens-aux.numero-ordem 
                  BY tt-itens-aux.parcela 
                  BY tt-itens-aux.sequencial:
            
            CREATE tt-itens.
            ASSIGN tt-itens.numero-ordem             = tt-itens-aux.numero-ordem
                   tt-itens.parcela                  = tt-itens-aux.parcela
                   tt-itens.seq                      = tt-itens-aux.sequencial
                   tt-itens.nr-proc-imp              = tt-itens-aux.nr-proc-imp
                   tt-itens.it-codigo                = tt-itens-aux.it-codigo                   
                   tt-itens.quantidade               = tt-itens-aux.quantidade
                   tt-itens.encerra-pa               = tt-itens-aux.encerra-pa                   
                   tt-itens.lote                     = tt-itens-aux.lote
                   tt-itens.dt-vali-lote             = tt-itens-aux.dt-vali-lote
                   tt-itens.cod-refer                = tt-itens-aux.cod-refer
                   tt-itens.class-fiscal             = tt-itens-aux.class-fiscal
                   tt-itens.nat-fiscal               = tt-itens-aux.nat-fiscal
                   tt-itens.nr-ato-concessorio       = tt-itens-aux.nr-ato-concessorio
                   tt-itens.preco-unit               = tt-itens-aux.preco-unit
                   tt-itens.preco-total              = tt-itens-aux.preco-total
                   tt-itens.preco-unit-mo            = tt-itens-aux.preco-unit-mo
                   tt-itens.preco-total-mo           = tt-itens-aux.preco-total-mo
                   tt-itens.desconto                 = tt-itens-aux.desconto
                   tt-itens.num-pedido               = tt-itens-aux.num-pedido
                   tt-itens.tp-despesa               = tt-itens-aux.tp-despesa
                   tt-itens.cod-depos                = tt-itens-aux.cod-depos
                   tt-itens.l-regime                 = tt-itens-aux.l-regime
                   tt-itens.l-ordens-embarque        = tt-itens-aux.l-ordens-embarque
                   tt-itens.peso-bruto               = tt-itens-aux.peso-bruto
                   tt-itens.peso-liquido             = tt-itens-aux.peso-liquido
                   tt-itens.val-cub-tot              = tt-itens-aux.val-cub-tot
                   tt-itens.cod-lote-fabrican        = tt-itens-aux.cod-lote-fabrican
                   tt-itens.dat-fabricc-lote         = tt-itens-aux.dat-fabricc-lote
                   tt-itens.dat-valid-lote-fabrican  = tt-itens-aux.dat-valid-lote-fabrican
                   tt-itens.nom-fabrican             = tt-itens-aux.nom-fabrican
                   tt-itens.cd-trib-ii               = tt-itens-aux.cd-trib-ii
                   tt-itens.cd-trib-ipi              = tt-itens-aux.cd-trib-ipi
                   tt-itens.cd-trib-icms             = tt-itens-aux.cd-trib-icms
                   tt-itens.aliquota-ii              = tt-itens-aux.aliquota-ii
                   tt-itens.aliquota-ipi             = tt-itens-aux.aliquota-ipi
                   tt-itens.aliquota-icms            = tt-itens-aux.aliquota-icms
                   tt-itens.suspensao-II             = tt-itens-aux.suspensao-II
                   tt-itens.suspensao-IPI            = tt-itens-aux.suspensao-IPI 
                   tt-itens.l-gera-prim-nf-remes-mae = tt-itens-aux.l-gera-prim-nf-remes-mae.
                   
            IF i-pais-impto-usuario <> 1 THEN DO:

                ASSIGN tt-itens.preco-unit         = tt-itens-aux.preco-total    / tt-itens-aux.qtd-do-forn
                       tt-itens.preco-unit-mo      = tt-itens-aux.preco-total-mo / tt-itens-aux.qtd-do-forn
                       tt-itens.desconto           = tt-itens-aux.desconto       / tt-itens-aux.qtd-do-forn
                       tt-itens.nro-comp           = tt-itens-aux.nro-comp
                       tt-itens.nat-comp           = tt-itens-aux.nat-comp
                       tt-itens.serie-comp         = tt-itens-aux.serie-comp
                       tt-itens.seq-comp           = tt-itens-aux.seq-comp.
            END.
        END.
        
        FIND FIRST tt-nota  NO-LOCK NO-ERROR.
        FIND FIRST tt-itens NO-LOCK NO-ERROR. 
        
        FIND FIRST ordem-compra
             WHERE ordem-compra.numero-ordem = tt-itens.numero-ordem NO-LOCK NO-ERROR.

        //Controla lote do item na nota m∆e
        FIND FIRST natur-operac-internac NO-LOCK 
             WHERE natur-operac-internac.cod-natur-operac = tt-nota.nat-operacao NO-ERROR.
        IF AVAIL natur-operac-internac THEN
            ASSIGN l-cont-lote-nota-mae = natur-operac-internac.log-livre-1.
        ELSE
            ASSIGN l-cont-lote-nota-mae = NO.         
             
        IF c-nom-prog-dpc-mg97  <> ""
        OR c-nom-prog-appc-mg97 <> ""
        OR c-nom-prog-upc-mg97  <> "" THEN DO:
            
            FOR EACH tt-epc
               WHERE tt-epc.cod-event = "CalculoPrecoUnitario":U:
                DELETE tt-epc.
            END.
                
            CREATE tt-epc.
            ASSIGN tt-epc.cod-event     = "CalculoPrecoUnitario":U
                   tt-epc.cod-parameter = "RowidOrdemCompra":U
                   tt-epc.val-parameter = STRING(ROWID(ordem-compra)).
                      
            {include/i-epc201.i "CalculoPrecoUnitario"} 
               
            FIND FIRST tt-epc 
                 WHERE tt-epc.cod-event      = "CalculoPrecoUnitario":U 
                   AND tt-epc.cod-parameter  = "AlteraCotacao":U NO-LOCK NO-ERROR.
                       
            IF AVAIL tt-epc THEN 
                ASSIGN tt-nota.cotacao-dia   = dec(tt-epc.val-parameter).
                
            EMPTY TEMP-TABLE tt-epc.
                
            CREATE tt-epc.
            ASSIGN tt-epc.cod-event     = "BeforeIM7777":U
                   tt-epc.cod-parameter = "handle-tt-itens":U
                   tt-epc.val-parameter =  STRING(TEMP-TABLE tt-itens:HANDLE).
                
            /* Chamada UPC */
            {include/i-epc201.i "beforeim7777"} 
        END.
                
        FIND FIRST tt-epc
             WHERE tt-epc.cod-event     = "BeforeIM7777":U
               AND tt-epc.cod-parameter = "tt-erro":U  NO-LOCK NO-ERROR.

        IF AVAIL tt-epc THEN DO:
             {utp/ut-liter.i "Pedido" *}
             ASSIGN c-return-value = TRIM(RETURN-VALUE).
             {utp/ut-liter.i "pendente_de_aprovaá∆o" *}

            RUN criaTTBoErro(17022, c-return-value + ' ' + STRING(pedido-compr.num-pedido) + ' ' + RETURN-VALUE + '.').
        END.
        
        IF NOT AVAIL tt-epc AND NOT CAN-FIND (FIRST tt-bo-erro) THEN DO:
            
            /* O objeto im3100a.p foi retirado do repositorio conforme DIS de unificaá∆o de conceitos.*/
            ASSIGN l-exec-im7777 = YES.
            
            IF l-ems2-imp-mexico THEN
                ASSIGN l-exec-im7777 = NO.
            
            
            IF l-exec-im7777 THEN DO:

                IF i-tp-nacionaliz = 0 THEN
                    ASSIGN i-tp-nacionaliz = 1. /* caso seja zero, assume 1 (embarque) */
                
                IF i-pais-impto-usuario <> 1 THEN
                    RUN imp/im3100a.p (INPUT  TABLE tt-nota,
                                       INPUT  TABLE tt-itens,
                                       INPUT  TABLE tt-docto-estoq-internac,
                                       OUTPUT TABLE tt-erro,
                                       OUTPUT TABLE tt-retorno).
                ELSE DO:
                    IF i-tp-nacionaliz = 1 THEN DO: /* Embarque */
                        
                        run imp/im7777.p (INPUT  TABLE tt-nota,
                                          INPUT  TABLE tt-itens,
                                          OUTPUT TABLE tt-erro,
                                          OUTPUT TABLE tt-retorno).
                    END.
                    ELSE DO:
                        IF VALID-HANDLE(h-bocx383a) THEN
                            DELETE PROCEDURE h-bocx383a.

                        RUN cxbo/bocx383a.p PERSISTENT SET h-bocx383a.

                        RUN pi-geraDocto IN h-bocx383a (INPUT  TABLE tt-nota,
                                                        INPUT  TABLE tt-itens,
                                                        OUTPUT TABLE tt-erro,
                                                        OUTPUT TABLE tt-retorno).
                        
                        RUN getRowErrors IN h-bocx383a (OUTPUT TABLE RowErrors APPEND).   

                        RUN getEmbarquesGerados IN h-bocx383a (OUTPUT TABLE tt-embarques-gerados APPEND).
                    END.
                END.

                /* Busca a numeraá∆o do documento que foi gerado no faturamento para criaá∆o da rat-lote. */
                    
                FIND FIRST tt-retorno NO-LOCK WHERE tt-retorno.cd-erro = 17006 NO-ERROR.

                IF AVAIL tt-retorno THEN DO:
                    ASSIGN c-nro-docto = tt-retorno.mensagem.
                    DELETE tt-retorno.
                END.

                IF c-nro-docto = "" THEN
                    ASSIGN c-nro-docto = tt-nota.nro-docto.
                
                ASSIGN l-tem-quebra = no.
                
                FIND FIRST docum-est
                     WHERE docum-est.nro-docto    = c-nro-docto           
                     AND   docum-est.nat-operacao = tt-nota.nat-operacao     
                     AND   docum-est.serie-docto  = tt-nota.serie-docto         
                     AND   docum-est.cod-emitente = tt-nota.cod-emitente NO-LOCK NO-ERROR. 

                IF AVAIL docum-est THEN DO:
                    
                    IF c-nom-prog-dpc-mg97  <> ""
                    OR c-nom-prog-appc-mg97 <> ""
                    OR c-nom-prog-upc-mg97  <> "" THEN DO:
                        
                        FOR EACH tt-epc
                           WHERE tt-epc.cod-event = "FimGeraDocto":U:
                            DELETE tt-epc.
                        END.
                        
                        CREATE tt-epc.
                        ASSIGN tt-epc.cod-event     = "FimGeraDocto":U
                               tt-epc.cod-parameter = "RowidDocumEst":U
                               tt-epc.val-parameter = STRING(ROWID(docum-est)).
                                  
                        {include/i-epc201.i "FimGeraDocto"} 

                        EMPTY TEMP-TABLE tt-epc.
                    END.
                END.

                FOR EACH item-doc-est NO-LOCK
                   WHERE item-doc-est.nro-docto    = c-nro-docto
                   AND   item-doc-est.nat-operacao = tt-nota.nat-operacao
                   AND   item-doc-est.serie-docto  = tt-nota.serie-docto
                   AND   item-doc-est.cod-emitente = tt-nota.cod-emitente:

                    IF CAN-FIND(FIRST item
                                WHERE item.it-codigo     = item-doc-est.it-codigo
                                  AND item.tipo-con-est >= 2) THEN DO:   /*N£mero de SÇrie*/
                        ASSIGN l-tem-quebra = YES.
                        LEAVE.
                    END.
                END.

                /*Transferencia de DRAWBACK Argentina*/
                IF i-pais-impto-usuario <> 1 AND
                   CAN-FIND (FIRST embarq-import-docto
                             WHERE embarq-import-docto.cod-estab        = tt-parametros.cod-estabel
                               AND embarq-import-docto.cod-embarq       = tt-parametros.embarque
                               AND embarq-import-docto.cod-ser-docto    = tt-nota.serie-docto
                               AND embarq-import-docto.cod-docto        = c-nro-docto
                               AND embarq-import-docto.cdn-emitente     = tt-nota.cod-emitente
                               AND embarq-import-docto.cod-natur-operac = tt-nota.nat-operacao
                               AND embarq-import-docto.log-transf-draw) THEN
                    ASSIGN l-tem-quebra = NO.
                                   
                IF l-tem-quebra THEN DO:
                    
                    FOR EACH tt-quebra-aux NO-LOCK:
                        FOR EACH rat-lote EXCLUSIVE-LOCK
                           WHERE rat-lote.nro-docto    = c-nro-docto
                           AND   rat-lote.nat-operacao = tt-nota.nat-operacao
                           AND   rat-lote.serie-docto  = tt-nota.serie-docto
                           AND   rat-lote.cod-emitente = tt-nota.cod-emitente
                           AND   rat-lote.it-codigo    = tt-quebra-aux.it-codigo:
                            
                            DELETE rat-lote.
                        END.
                    END.
                             
                    FOR EACH tt-quebra-aux NO-LOCK:

                        //Verificar se Ç nota simples remessa, nota m∆e e se controle lote do item na nota m∆e
                        IF tt-nota.l-nf-simples-remessa AND tt-nota.idi-nf-simples-remes = 1 AND l-cont-lote-nota-mae THEN DO:
                            FIND FIRST item-doc-est NO-LOCK
                                WHERE  item-doc-est.nro-docto       = c-nro-docto 
                                AND    item-doc-est.cod-emitente    = tt-nota.cod-emitente
                                AND    item-doc-est.nat-operacao    = tt-nota.nat-operacao
                                AND    item-doc-est.serie-docto     = tt-nota.serie-docto
                                AND    item-doc-est.it-codigo       = tt-quebra-aux.it-codigo 
                                AND    item-doc-est.num-parc-import = tt-quebra-aux.parcela 
                                AND    item-doc-est.num-ord-import  = tt-quebra-aux.numero-ordem NO-ERROR.
                        END.
                        ELSE DO:
                            FIND FIRST item-doc-est NO-LOCK
                                WHERE  item-doc-est.nro-docto    = c-nro-docto 
                                AND    item-doc-est.cod-emitente = tt-nota.cod-emitente
                                AND    item-doc-est.nat-operacao = tt-nota.nat-operacao
                                AND    item-doc-est.serie-docto  = tt-nota.serie-docto
                                AND    item-doc-est.it-codigo    = tt-quebra-aux.it-codigo 
                                AND    item-doc-est.parcela      = tt-quebra-aux.parcela 
                                AND    item-doc-est.numero-ordem = tt-quebra-aux.numero-ordem NO-ERROR.
                        END.
                        
                        IF AVAIL item-doc-est THEN DO:

                            CREATE rat-lote.
                            ASSIGN rat-lote.serie-docto      = item-doc-est.serie-docto
                                   rat-lote.cod-emitente     = item-doc-est.cod-emitente
                                   rat-lote.nro-docto        = item-doc-est.nro-docto
                                   rat-lote.nat-operacao     = item-doc-est.nat-operacao  
                                   rat-lote.it-codigo        = item-doc-est.it-codigo
                                   rat-lote.sequencia        = item-doc-est.sequencia
                                   rat-lote.cod-depos        = item-doc-est.cod-depos 
                                   rat-lote.cod-localiz      = item-doc-est.cod-localiz
                                   rat-lote.dt-vali-lote     = tt-quebra-aux.dt-vali-lote
                                   rat-lote.lote             = tt-quebra-aux.lote
                                   rat-lote.quantidade       = tt-quebra-aux.quantidade.
                        END.
                    END.
                END. /* if  l-tem-quebra then do: */

            END. /* IF  l-exec-im7777 THEN do: */
            ELSE
                RUN imp/im3100a.p (INPUT  TABLE tt-nota,                        
                                   INPUT  TABLE tt-itens,
                                   INPUT  TABLE tt-docto-estoq-internac,
                                   OUTPUT TABLE tt-erro,
                                   OUTPUT TABLE tt-retorno).
        END.
                          
        FOR EACH tt-erro NO-LOCK:
            ASSIGN i-seq-erro = i-seq-erro + 1.
            CREATE tt-bo-erro.
            ASSIGN tt-bo-erro.i-sequen   = i-seq-erro
                   tt-bo-erro.cd-erro    = tt-erro.cd-erro
                   tt-bo-erro.mensagem   = tt-erro.mensagem.
        END.
    END.
    
    IF VALID-HANDLE(h-acomp) AND l-acomp THEN
        RUN pi-finalizar IN h-acomp.
    
    RETURN "OK":U.
END PROCEDURE.


PROCEDURE setAcompanhamento:
/*------------------------------------------------------------------------------
  Purpose:     Define se o acompanhamento ser† mostrado.                  
               Deve ser yes somente quando executado via cliente/servidor.
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER p-acomp AS LOGICAL NO-UNDO.
    
    ASSIGN l-acomp = p-acomp.

    RETURN "OK":U.
END PROCEDURE.


PROCEDURE limpaTabela:
/*------------------------------------------------------------------------------
  Purpose:     Limpa temp-table tt-itens-aux quando for um novo embarque 
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    
    EMPTY TEMP-TABLE tt-itens-aux.
    
    RETURN "OK":U.
END PROCEDURE.


PROCEDURE ValidaNotaFiscalMaeSimplesRemessa:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER c-conta-contabil AS CHARACTER FORMAT 'x(20)':U NO-UNDO.
    DEFINE OUTPUT PARAMETER TABLE FOR tt-bo-erro.
    
    DEFINE VARIABLE ct-codigo AS INTEGER NO-UNDO.
    DEFINE VARIABLE sc-codigo AS INTEGER NO-UNDO.

    /*Verifica se Conta de Aplicacao NFS foi informada no programa IM0100*/
    IF c-conta-contabil <> "" THEN DO:
        
        IF NOT VALID-HANDLE(h_api_cta) THEN
            RUN prgint/utb/utb743za.py PERSISTENT SET h_api_cta.

        /*## busca i-empresa ##*/
        FIND FIRST estabelec
             WHERE estabelec.cod-estabel = c-cod-estabel-im0100 NO-LOCK NO-ERROR.
        
        ASSIGN i-empresa      = estabelec.ep-codigo WHEN AVAIL estabelec
               v_cod_cta_ctbl = c-conta-contabil.

	    RUN pi_busca_dados_cta_ctbl IN h_api_cta (INPUT        i-empresa,          /* EMPRESA EMS2 */
                                                  INPUT        "",                 /* PLANO DE CONTAS */
                                                  INPUT-OUTPUT v_cod_cta_ctbl,     /* CONTA */
                                                  INPUT        TODAY,              /* DATA TRANSACAO */   
                                                  OUTPUT       v_des_cta_ctbl,     /* DESCRICAO CONTA */
                                                  OUTPUT       v_num_tip_cta_ctbl, /* TIPO DA CONTA */
                                                  OUTPUT       v_num_sit_cta_ctbl, /* SITUAÄ«O DA CONTA */
                                                  OUTPUT       v_ind_finalid_cta,  /* FINALIDADES DA CONTA */
                                                  OUTPUT TABLE tt_log_erro).       /* ERROS */ 
		
        RUN pi_busca_dados_cta_ctbl_integr IN h_api_cta (INPUT        STRING(i-empresa),  /* EMPRESA EMS2 */
                                                         INPUT        "CEP":U,            /* MODULO */
                                                         INPUT        "",                 /* PLANO DE CONTAS */
                                                         INPUT        v_cod_cta_ctbl,     /* CONTA */
                                                         INPUT        TODAY,              /* DATA TRANSACAO */   
                                                         OUTPUT       v_ind_finalid_cta,  /* FINALIDADES DA CONTA */
                                                         OUTPUT TABLE tt_log_erro).       /* ERROS */ 

        IF RETURN-VALUE = "nok":U THEN DO:

            FIND FIRST tt_log_erro NO-LOCK NO-ERROR.

            IF AVAIL tt_log_erro THEN DO:

                RUN utp/ut-msgs.p (INPUT "show":U, 
                                   INPUT 17006, 
                                   STRING(tt_log_erro.ttv_des_msg_erro) + ' ('  + STRING(tt_log_erro.ttv_num_cod_erro) + ')' + "~~" + tt_log_erro.ttv_des_msg_ajuda).
                  
                 ASSIGN i-seq-erro = i-seq-erro + 1.                   
                 CREATE tt-bo-erro.
                 ASSIGN tt-bo-erro.i-sequen  = i-seq-erro + 1
                        tt-bo-erro.cd-erro   = INT(tt_log_erro.ttv_des_msg_erro) /*5407*/
                        tt-bo-erro.mensagem  = RETURN-VALUE.
                        
                 RETURN 'ADM-ERROR':U.  
            END.
        END.
        ELSE DO:
            
            /*Verifica se a conta informada Ç de sistema*/
            IF v_num_sit_cta_ctbl <> 3 THEN
                RUN criaTTBoErro(443, "").
            
            /*Verifica se a conta Ç de despesas, receita, ativo ou passivo*/                              
            IF NOT CAN-DO("1,2,4,5":U, STRING(v_num_tip_cta_ctbl)) THEN
                RUN criaTTBoErro(5543, "").
                        
            /*Verifica se a conta recebe lanáamentos no estoque*/
            IF LOOKUP({adinc/i05ad049.i 4 10}, v_ind_finalid_cta) <> 0 THEN
                RUN criaTTBoErro(15190, "").
            
            
			IF  LOOKUP({adinc/i05ad049.i 4 1}, v_ind_finalid_cta) = 0      /*Consumo*/
            AND LOOKUP({adinc/i05ad049.i 4 2}, v_ind_finalid_cta) = 0      /*Nao Consumo*/ 
			AND LOOKUP({adinc/i05ad049.i 4 3}, v_ind_finalid_cta) = 0      /*Ordem Servico*/
			AND LOOKUP({adinc/i05ad049.i 4 6}, v_ind_finalid_cta) = 0 THEN /*Custo mercadoria vendida*/
                RUN criaTTBoErro(107, "").
            
        END.
    END.
    ELSE DO: /*Conta de Aplicaá∆o NFS nao foi informada no programa IM0100*/

        {utp/ut-liter.i "Conta_Aplicaá∆o_Nota_Fiscal_Simples_Remessa" *}

        RUN criaTTBoErro(265, RETURN-VALUE).
    END.

    IF VALID-HANDLE(h_api_cta) THEN DO:
        DELETE PROCEDURE h_api_cta.
        ASSIGN h_api_cta = ?.
    END.
    
    RETURN "OK":U.
END PROCEDURE.


PROCEDURE ValidaNotaFiscalFilhaSimplesRemessa:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER c-natur-oper   AS CHARACTER FORMAT 'x(6)':U NO-UNDO.
    DEFINE OUTPUT PARAMETER l-emite-duplic AS LOGICAL                   NO-UNDO.

    FOR FIRST natur-oper FIELDS (emite-duplic)
        WHERE natur-oper.nat-operacao = c-natur-oper NO-LOCK: END.

    IF AVAIL natur-oper THEN
        ASSIGN l-emite-duplic = natur-oper.emite-duplic.

    RETURN "OK":U.
END PROCEDURE.


PROCEDURE pi-acerta-residuo:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pr-rowid AS ROWID NO-UNDO.

    DEFINE VARIABLE de-preco-total     as decimal                       INIT 0  NO-UNDO.
    DEFINE VARIABLE de-preco-total-aux LIKE item-doc-est.preco-total[1]         NO-UNDO.

    DEFINE BUFFER b-tt-itens-aux FOR tt-itens-aux.

    FOR EACH b-tt-itens-aux:
        ASSIGN de-preco-total  = de-preco-total + b-tt-itens-aux.preco-total-dec
               de-preco-total-aux = de-preco-total-aux + b-tt-itens-aux.preco-total.
    END.
    
    IF c-nom-prog-dpc-mg97  <> ""
    OR c-nom-prog-appc-mg97 <> ""
    OR c-nom-prog-upc-mg97  <> "" THEN DO:
        
        EMPTY TEMP-TABLE tt-epc.

        CREATE tt-epc.
        ASSIGN tt-epc.cod-event     = "CalculoPrecoUnitario2":U
               tt-epc.cod-parameter = "cod-estabel":U
               tt-epc.val-parameter = embarque-imp.cod-estabel.
             
        CREATE tt-epc.
        ASSIGN tt-epc.cod-event     = "CalculoPrecoUnitario2":U
               tt-epc.cod-parameter = "embarque":U
               tt-epc.val-parameter = embarque-imp.embarque.
               
        {include/i-epc201.i "CalculoPrecoUnitario2"} 
    END.

    IF  AVAIL cotacao
    AND AVAIL cotacao-item
    AND AVAIL tt-parametros THEN DO:
        
        FIND FIRST tt-epc
             WHERE tt-epc.cod-event     = "CalculoPrecoUnitario2":U
               AND tt-epc.cod-parameter = "AlteraCotacao":U NO-LOCK NO-ERROR.

        IF AVAIL tt-epc THEN
            ASSIGN de-preco-total = de-preco-total * DEC(tt-epc.val-parameter).
        ELSE
            IF i-pais-impto-usuario = 1 /* Brasil */ THEN
                RUN cdp/cd0812.p (INPUT  cotacao-item.mo-codigo,
                                  INPUT  0,
                                  INPUT  de-preco-total,
                                  INPUT  tt-parametros.da-cotacao,
                                  OUTPUT de-preco-total).
                                  
            ELSE
                RUN cdp/cd0812a.p (INPUT  cotacao-item.mo-codigo,
                                   INPUT  0,
                                   INPUT  de-preco-total,
                                   INPUT  tt-parametros.d-cotacao,
                                   OUTPUT de-preco-total).

        IF de-preco-total-aux <> de-preco-total THEN DO:
            
            FIND FIRST b-tt-itens-aux 
                 WHERE ROWID(b-tt-itens-aux) = pr-rowid EXCLUSIVE-LOCK NO-ERROR.
            
            IF AVAIL b-tt-itens-aux THEN
                ASSIGN b-tt-itens-aux.preco-total = b-tt-itens-aux.preco-total + (de-preco-total - de-preco-total-aux).
        END.
    END.

    RETURN "OK":U.
END PROCEDURE.


PROCEDURE piResiduoItensNfMaeComRemessa:
/*------------------------------------------------------------------------------
  Purpose:     PropÛsito: Acertar diferenÁa de valores do total da mercadoria dos itens da NF Mae COM Primeira Remessa.                 
               Quando gerado uma NF mae com primeira remessa, o embarque principal È quebrado antes da nacionalizacao                   
               dessa maneira os valores calculados para o total da mercadoria dos itens pode nao ser o mesmo do que                     
               quando calculado com as quantidades/valores totais do embarque principal (sem quebra anterior a nacionalizacao).         
               Sendo assim faz-se necessario um acerto de residuos, comparando o total calculado para a nota NF Mae com primeira Remessa
               contra o que seria calculado sem a quebra do embarque principal.                                                         
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE VARIABLE de-preco-total-item    AS DECIMAL NO-UNDO. /* Preco total do item no embarque pai + filhos */
    DEFINE VARIABLE de-preco-total-item-mo AS DECIMAL NO-UNDO.
    DEFINE VARIABLE de-preco-calculado     AS DECIMAL NO-UNDO. /* Preco calculado com a quantidade total do embarque pai + filhos */
    DEFINE VARIABLE de-preco-calculado-mo  AS DECIMAL NO-UNDO.
    DEFINE VARIABLE de-qnt-total-item      AS DECIMAL NO-UNDO. /* Quantidade do item no embarque pai + filhos */
    DEFINE VARIABLE de-val-maior-it        AS DECIMAL NO-UNDO.
    DEFINE VARIABLE r-maior-it             AS ROWID   NO-UNDO.

    DEFINE BUFFER b-tt-itens-aux FOR tt-itens-aux.


    FOR EACH tt-itens-aux NO-LOCK BREAK BY tt-itens-aux.numero-ordem:

        IF FIRST-OF(tt-itens-aux.numero-ordem) THEN DO:
            ASSIGN de-val-maior-it        = tt-itens-aux.preco-total
                   r-maior-it             = ROWID(tt-itens-aux)     
                   de-preco-total-item     = tt-itens-aux.preco-total
                   de-preco-total-item-mo  = tt-itens-aux.preco-total-mo
                   de-qnt-total-item       = tt-itens-aux.qtd-do-forn.
        END.
        ELSE DO:
            ASSIGN de-preco-total-item     = de-preco-total-item    + tt-itens-aux.preco-total
                   de-preco-total-item-mo  = de-preco-total-item-mo + tt-itens-aux.preco-total-mo
                   de-qnt-total-item       = de-qnt-total-item      + tt-itens-aux.qtd-do-forn.

            IF tt-itens-aux.preco-total > de-val-maior-it THEN
                ASSIGN r-maior-it      = ROWID(tt-itens-aux)
                       de-val-maior-it = tt-itens-aux.preco-total.
        END.

        IF LAST-OF(tt-itens-aux.numero-ordem) THEN DO:

            ASSIGN de-preco-calculado    = de-qnt-total-item * tt-itens-aux.preco-unit
                   de-preco-calculado-mo = de-qnt-total-item * tt-itens-aux.preco-unit-mo.
            
            /* Valor unitario vezes quantidade total for diferente do total dos itens, acerta residuo */
            IF  de-preco-calculado <> de-preco-total-item 
            AND de-preco-calculado -  de-preco-total-item <=  0.05
            AND de-preco-calculado -  de-preco-total-item >= -0.05 THEN
                FOR FIRST b-tt-itens-aux
                     WHERE rowid(b-tt-itens-aux) = r-maior-it EXCLUSIVE-LOCK:
                    
                    ASSIGN b-tt-itens-aux.preco-total = b-tt-itens-aux.preco-total 
                                                      + (de-preco-calculado - de-preco-total-item).
                END.

            
            IF  de-preco-calculado-mo <> de-preco-total-item-mo 
            AND de-preco-calculado-mo -  de-preco-total-item-mo <=  0.05
            AND de-preco-calculado-mo -  de-preco-total-item-mo >= -0.05 THEN
                FOR FIRST b-tt-itens-aux
                     WHERE rowid(b-tt-itens-aux) = r-maior-it EXCLUSIVE-LOCK:
                    
                    ASSIGN b-tt-itens-aux.preco-total-mo = b-tt-itens-aux.preco-total-mo 
                                                         + (de-preco-calculado-mo - de-preco-total-item-mo).
                END.

        END.
    END.
    
    RETURN "OK":U.
END PROCEDURE.


PROCEDURE piResiduoMoedaNfMaeComRemessa:
/*------------------------------------------------------------------------------
  Purpose:     PrpÛsito: Acerta diferenÁa de valores que venham a ocorrer no momento da conversao para a moeda 0 (Real).    
               Primeiro acertando os itens da NF Mae COM Simples Remessa em relacao a NF Mae SEM primeira remessa,          
               que È calculada com as quantidades totais, sem quebra antes da nacionalizacao.                               
               Posteriormente realizando acerto do total do documento com os itens, mesma logica realizada pi-acerta-residuo
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT-OUTPUT PARAMETER TABLE FOR tt-itens-aux.
    DEFINE INPUT        PARAMETER dt-data-cotacao AS DATE NO-UNDO.

    DEFINE BUFFER b-tt-itens-aux FOR tt-itens-aux.

    DEFINE VARIABLE d-val-tot-embarques     LIKE item-doc-est.preco-total[1] NO-UNDO. 
    DEFINE VARIABLE d-val-tot-embarques-mo  LIKE item-doc-est.preco-total[1] NO-UNDO.
    DEFINE VARIABLE d-val-tot-item-emb      LIKE item-doc-est.preco-total[1] NO-UNDO. 
    DEFINE VARIABLE d-val-tot-item-emb-mo   LIKE item-doc-est.preco-total[1] NO-UNDO.
    DEFINE VARIABLE de-val-maior-it         LIKE item-doc-est.preco-total[1] NO-UNDO.
    DEFINE VARIABLE r-maior-it              AS ROWID                         NO-UNDO.

    FOR EACH tt-itens-aux NO-LOCK BREAK BY tt-itens-aux.numero-ordem:
        
        /* Realiza a somatoria dos itens que foram quebrados nos demais embarques (pai + filhos) */
        IF FIRST-OF(tt-itens-aux.numero-ordem) THEN DO:
            ASSIGN de-val-maior-it        = tt-itens-aux.preco-total
                   r-maior-it             = ROWID(tt-itens-aux)     
                   d-val-tot-item-emb     = tt-itens-aux.preco-total      /* Valor convertido (reais) */
                   d-val-tot-item-emb-mo  = tt-itens-aux.preco-total-mo.  /* Valor na moeda estrangeira */
        END.
        ELSE DO:
            
            ASSIGN d-val-tot-item-emb    = d-val-tot-item-emb    + tt-itens-aux.preco-total
                   d-val-tot-item-emb-mo = d-val-tot-item-emb-mo + tt-itens-aux.preco-total-mo.
        
            IF tt-itens-aux.preco-total > de-val-maior-it THEN
                ASSIGN r-maior-it      = ROWID(tt-itens-aux)
                       de-val-maior-it = tt-itens-aux.preco-total.
        END.
        
        IF LAST-OF(tt-itens-aux.numero-ordem) THEN DO:
            
            FIND FIRST ordem-compra                                                               
                 WHERE ordem-compra.numero-ordem = tt-itens-aux.numero-ordem NO-LOCK NO-ERROR.

            IF AVAIL ordem-compra THEN DO:

                FIND FIRST cotacao-item                                                               
                     WHERE cotacao-item.numero-ordem = ordem-compra.numero-ordem                      
                       AND cotacao-item.cod-emitente = ordem-compra.cod-emitente                      
                       AND cotacao-item.it-codigo    = tt-itens-aux.it-codigo                      
                       AND cotacao-item.cot-aprovada NO-LOCK NO-ERROR.

                IF AVAIL cotacao-item THEN DO:

                    RUN cdp/cd0812.p (INPUT  cotacao-item.mo-codigo,                                       
                                      INPUT  0,                                                            
                                      INPUT  d-val-tot-item-emb-mo,
                                      INPUT  dt-data-cotacao,                                     
                                      OUTPUT d-val-tot-item-emb-mo). 
                            
                    /* Verifica se houve alguma diferenca de arredondamento e acerta para o item de maior valor */
                    IF  d-val-tot-item-emb-mo <> d-val-tot-item-emb 
                    AND (d-val-tot-item-emb-mo - d-val-tot-item-emb) <=  0.05
                    AND (d-val-tot-item-emb-mo - d-val-tot-item-emb) >= -0.05 THEN DO:
                        FOR FIRST b-tt-itens-aux
                             WHERE rowid(b-tt-itens-aux) = r-maior-it EXCLUSIVE-LOCK:
                            
                            ASSIGN b-tt-itens-aux.preco-total = b-tt-itens-aux.preco-total 
                                                              + (d-val-tot-item-emb-mo - d-val-tot-item-emb).
                        END.
                    END.
                END.
            END.
        END.
    END.
    
    FOR EACH tt-itens-aux NO-LOCK BREAK BY tt-itens-aux.numero-ordem:                                           
        /* Realizando mesma logica da procedure  pi-acerta-residuo da bocx220a.i1 com os valores totais do embarque*/ 
        IF FIRST (tt-itens-aux.numero-ordem) THEN
            ASSIGN de-val-maior           = tt-itens-aux.preco-total                                               
                   r-maior-it             = ROWID(tt-itens-aux)                                                    
                   d-val-tot-embarques    = tt-itens-aux.preco-total                                               
                   d-val-tot-embarques-mo = tt-itens-aux.preco-total-mo.                                           
                                                                                                                      
        ELSE DO:
            ASSIGN d-val-tot-embarques    = d-val-tot-embarques    + tt-itens-aux.preco-total                      
                   d-val-tot-embarques-mo = d-val-tot-embarques-mo + tt-itens-aux.preco-total-mo.                  
                                                                                                                      
            IF tt-itens-aux.preco-total > de-val-maior THEN
                ASSIGN r-maior-it   = ROWID(tt-itens-aux)                                                            
                       de-val-maior = tt-itens-aux.preco-total.                                                      
        END.                                                                                                          
                                                                                                                      
        IF LAST (tt-itens-aux.numero-ordem) THEN DO:

            FIND FIRST ordem-compra
                 WHERE ordem-compra.numero-ordem = tt-itens-aux.numero-ordem NO-LOCK NO-ERROR.
            
            IF AVAIL ordem-compra THEN DO:

                FIND FIRST cotacao-item
                     WHERE cotacao-item.numero-ordem = ordem-compra.numero-ordem
                       AND cotacao-item.cod-emitente = ordem-compra.cod-emitente
                       AND cotacao-item.it-codigo    = tt-itens-aux.it-codigo
                       AND cotacao-item.cot-aprovada NO-LOCK NO-ERROR.

                IF AVAIL cotacao-item THEN DO:

                    RUN cdp/cd0812.p (INPUT  cotacao-item.mo-codigo,
                                      INPUT  0,
                                      INPUT  d-val-tot-embarques-mo,
                                      INPUT  dt-data-cotacao,
                                      OUTPUT d-val-tot-embarques-mo).

                    IF  d-val-tot-embarques-mo <> d-val-tot-embarques
                    AND (d-val-tot-embarques-mo - d-val-tot-embarques ) <=  0.05
                    AND (d-val-tot-embarques-mo - d-val-tot-embarques ) >= -0.05 THEN DO:
                        FOR FIRST b-tt-itens-aux
                             WHERE rowid(b-tt-itens-aux) = r-maior-it EXCLUSIVE-LOCK:
                            
                            ASSIGN b-tt-itens-aux.preco-total = b-tt-itens-aux.preco-total                              
                                                              + (d-val-tot-embarques-mo - d-val-tot-embarques).
                        END.                                                                                                  
                    END.
                END.
            END.
        END. /* last ordem-compra */
    END.

    RETURN "OK":U.
END PROCEDURE.


PROCEDURE findDocumentoImp:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER p-cod-estabel         AS CHARACTER                NO-UNDO.
    DEFINE INPUT  PARAMETER p-embarque            AS CHARACTER                NO-UNDO.
    DEFINE INPUT  PARAMETER p-cod-emitente        LIKE docum-est.cod-emitente NO-UNDO.
    DEFINE INPUT  PARAMETER p-i-tipo-gerac        AS INTEGER                  NO-UNDO.
    
    DEFINE OUTPUT PARAMETER p-numero-docto        LIKE docum-est.nro-docto    NO-UNDO.
    DEFINE OUTPUT PARAMETER p-serie-docto         LIKE docum-est.serie-docto  NO-UNDO.
    DEFINE OUTPUT PARAMETER p-emitente-docto      LIKE docum-est.cod-emitente NO-UNDO.
    DEFINE OUTPUT PARAMETER p-nat-operacao        LIKE docum-est.nat-operacao NO-UNDO.

    IF p-i-tipo-gerac <> 0 THEN DO:
        IF CAN-FIND (FIRST docum-est
                     WHERE docum-est.cod-emitente                 = p-cod-emitente 
                       AND TRIM(SUBSTRING(docum-est.char-1,1,20)) = p-embarque
                       AND docum-est.idi-nf-simples-remes         = p-i-tipo-gerac) THEN DO:
            
            FIND FIRST docum-est
                 WHERE docum-est.cod-emitente                 = p-cod-emitente
                   AND TRIM(SUBSTRING(docum-est.char-1,1,20)) = p-embarque
                   AND docum-est.idi-nf-simples-remes         = p-i-tipo-gerac NO-LOCK NO-ERROR.

            IF AVAIL docum-est THEN DO:
                ASSIGN p-numero-docto   = docum-est.nro-docto
                       p-serie-docto    = docum-est.serie-docto
                       p-emitente-docto = docum-est.cod-emitente
                       p-nat-operacao   = docum-est.nat-operacao.
                RETURN "OK":U.       
            END.
        END.
    END.
    ELSE DO:
        IF CAN-FIND (FIRST docum-est
                     WHERE docum-est.cod-emitente                 = p-cod-emitente
                       AND TRIM(SUBSTRING(docum-est.char-1,1,20)) = p-embarque) THEN DO:
            
            FIND FIRST docum-est
                 WHERE docum-est.cod-emitente                 = p-cod-emitente
                   AND TRIM(SUBSTRING(docum-est.char-1,1,20)) = p-embarque NO-LOCK NO-ERROR.

            IF AVAIL docum-est THEN DO:
                ASSIGN p-numero-docto   = docum-est.nro-docto
                       p-serie-docto    = docum-est.serie-docto
                       p-emitente-docto = docum-est.cod-emitente
                       p-nat-operacao   = docum-est.nat-operacao.
                RETURN "OK":U.       
            END.
        END.
    END.

    RETURN "NOK":U.
END PROCEDURE.


PROCEDURE validaNumAdicaoSiscomex:
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER p-cod-estabel AS CHARACTER NO-UNDO.
    DEFINE INPUT  PARAMETER p-embarque    AS CHARACTER NO-UNDO.
    
    DEFINE BUFFER b-ordens-embarque FOR ordens-embarque.
    
    FIND FIRST param-imp NO-LOCK
         WHERE param-imp.cod-estabel = p-cod-estabel NO-ERROR.
    
   
    IF  param-imp.log-tax-siscomex
    AND CAN-FIND(FIRST ordens-embarque
                 WHERE ordens-embarque.cod-estabel = p-cod-estabel
                   AND ordens-embarque.embarque    = p-embarque
                   AND ordens-embarque.num-adic    = 0)
    AND CAN-FIND(FIRST b-ordens-embarque
                 WHERE b-ordens-embarque.cod-estabel = p-cod-estabel
                   AND b-ordens-embarque.embarque    = p-embarque
                   AND b-ordens-embarque.num-adic   <> 0) THEN
        RETURN "NOK":U.
    ELSE
        RETURN "OK":U.

END PROCEDURE.


