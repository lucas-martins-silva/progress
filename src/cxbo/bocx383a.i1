/*No momento do rateio dos valores da DI os valores s∆o todos calculados na moeda  
      negociada. Esta procedure foi criada para que seja gravado os campos conforme
      a regra abaixo.
      
      Os valores vmle , vmld , vmcv , vucv , despesa de frete e despesa de seguro 
      (DI, ADIÄÂES E ITENS DA ADIÄ«O)devem ser gravados em Real, D¢lar (moeda parametrizada nos parametros de importaá∆o) 
      e na moeda negociada (pedido de compra).
      
      val-xxxxx      = Real
      val-xxxx-me[1] = moeda da negociaá∆o
      val-xxxx-me[2] = moeda D¢lar do parametro
      
      val-acresc       = Real
      val-acresc-me[1] = moeda D¢lar do parametro
      val-acresc-me[2] = 0
      */

    FOR LAST decla-import EXCLUSIVE-LOCK
        WHERE decla-import.num-di-ems = p-num-di-ems
          and decla-import.cdd-siscomex-dts = p-cdd-siscomex-dts:

        FOR FIRST param-imp NO-LOCK
            WHERE param-imp.cod-estabel = decla-import.cod-estab : END.

        FOR FIRST decla-import-adic NO-LOCK
            WHERE decla-import-adic.num-di-ems = decla-import.num-di-ems 
              and decla-import-adic.cdd-siscomex-dts = decla-import.cdd-siscomex-dts:

            ASSIGN i-moeda-frete  = decla-import-adic.cdn-moed-frete
                   i-moeda-seguro = decla-import-adic.cdn-moed-seguro.

        END.
        

        /*****************************CONVERTENDO VALORES DA DECLARAÄ«O DE IMPORTAÄ«O *******************************************
        *************************************************************************************************************************
        *************************************************************************************************************************/

        /*gravando valor na moeda negociada no val-xxxx-me[1] e o valor em Real no val-xxxx*/
        IF i-mo-codigo <> 0 THEN DO:       
            ASSIGN decla-import.val-vmle-me[1] = decla-import.val-vmle
                   decla-import.val-vmld-me[1] = decla-import.val-vmld
                   decla-import.val-vmcv-me[1] = decla-import.val-vmcv.

            ASSIGN de-valor-despesa = 0.

            /*Convertendo da moeda negociada para Real*/
            RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                    INPUT decla-import.cdd-siscomex-dts,
                                    INPUT i-mo-codigo,
                                    INPUT 0,
                                    INPUT decla-import.val-vmle-me[1],
                                    INPUT decla-import.dat-di,
                                    OUTPUT de-valor-despesa).
            ASSIGN decla-import.val-vmle = de-valor-despesa.

            ASSIGN de-valor-despesa = 0.

            /*Convertendo da moeda negociada para Real*/
            RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                    INPUT decla-import.cdd-siscomex-dts,
                                    INPUT i-mo-codigo,
                                    INPUT 0,
                                    INPUT decla-import.val-vmld-me[1],
                                    INPUT decla-import.dat-di,
                                    OUTPUT de-valor-despesa).
            ASSIGN decla-import.val-vmld = de-valor-despesa.

            ASSIGN de-valor-despesa = 0.
            /*Convertendo da moeda negociada para Real*/
            RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                    INPUT decla-import.cdd-siscomex-dts,
                                    INPUT i-mo-codigo,
                                    INPUT 0,
                                    INPUT decla-import.val-vmcv-me[1],
                                    INPUT decla-import.dat-di,
                                    OUTPUT de-valor-despesa).
            ASSIGN decla-import.val-vmcv = de-valor-despesa.  
        END.
        ELSE DO:
            /*Foi negociado em Real ent∆o os campos val-xxxx-me[1] devem receber valor 0*/
            ASSIGN decla-import.val-vmle-me[1] = 0
                   decla-import.val-vmld-me[1] = 0
                   decla-import.val-vmcv-me[1] = 0.
        END.

        /*Se a moeda negociada for diferente de D¢lar converter e gravar em Dolar no valor-xxxx-me[2]*/
        IF i-mo-codigo <> param-imp.int-2 THEN DO:

            ASSIGN de-valor-despesa = 0.

            IF i-mo-codigo <> 0 THEN
                /*Convertendo da moeda negociada para D¢lar*/
                RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                        INPUT decla-import.cdd-siscomex-dts,
                                        INPUT i-mo-codigo,
                                        INPUT param-imp.int-2,
                                        INPUT decla-import.val-vmle-me[1],
                                        INPUT decla-import.dat-di,
                                        OUTPUT de-valor-despesa).
            ELSE
                /*Convertendo da moeda negociada para D¢lar*/
                RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                        INPUT decla-import.cdd-siscomex-dts,
                                        INPUT i-mo-codigo,
                                        INPUT param-imp.int-2,
                                        INPUT decla-import.val-vmle,
                                        INPUT decla-import.dat-di,
                                        OUTPUT de-valor-despesa).


            ASSIGN decla-import.val-vmle-me[2] = de-valor-despesa.

            ASSIGN de-valor-despesa = 0.

            IF i-mo-codigo <> 0 THEN
                /*Convertendo da moeda negociada para D¢lar*/
                RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                        INPUT decla-import.cdd-siscomex-dts,
                                        INPUT i-mo-codigo,
                                        INPUT param-imp.int-2,
                                        INPUT decla-import.val-vmld-me[1],
                                        INPUT decla-import.dat-di,
                                        OUTPUT de-valor-despesa).
            ELSE
                /*Convertendo da moeda negociada para D¢lar*/
                RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                        INPUT decla-import.cdd-siscomex-dts,
                                        INPUT i-mo-codigo,
                                        INPUT param-imp.int-2,
                                        INPUT decla-import.val-vmld,
                                        INPUT decla-import.dat-di,
                                        OUTPUT de-valor-despesa).

            ASSIGN decla-import.val-vmld-me[2] = de-valor-despesa.

            ASSIGN de-valor-despesa = 0.

            IF i-mo-codigo <> 0 THEN
            /*Convertendo da moeda negociada para D¢lar*/
                RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                        INPUT decla-import.cdd-siscomex-dts,
                                        INPUT i-mo-codigo,
                                        INPUT param-imp.int-2,
                                        INPUT decla-import.val-vmcv-me[1],
                                        INPUT decla-import.dat-di,
                                        OUTPUT de-valor-despesa).
            ELSE
                RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                        INPUT decla-import.cdd-siscomex-dts,
                                        INPUT i-mo-codigo,
                                        INPUT param-imp.int-2,
                                        INPUT decla-import.val-vmcv,
                                        INPUT decla-import.dat-di,
                                        OUTPUT de-valor-despesa).


            ASSIGN decla-import.val-vmcv-me[2] = de-valor-despesa.
            
        END.
        ELSE DO:
            ASSIGN decla-import.val-vmle-me[2] = decla-import.val-vmle-me[1] 
                   decla-import.val-vmld-me[2] = decla-import.val-vmld-me[1] 
                   decla-import.val-vmcv-me[2] = decla-import.val-vmcv-me[1] .
        END.

        /*Convertendo Frete e Seguro da DI pois esses valores devem ser gravados conforme abaixo:
        
        val-frete       = Valor do Frete em real
        val-frete-me[1] = Valor do Frete na moeda cadastrada para a despesa de frete
        val-frete-me[2] = Valor do Frete na moeda D¢lar cadastrada nos parametros de importaá∆o

        val-seguro       = Valor do Seguro em real
        val-seguro-me[1] = Valor do Seguro na moeda cadastrada para a despesa de Seguro
        val-seguro-me[2] = Valor do Seguro na moeda D¢lar cadastrada nos parametros de importaá∆o            
        
        */

        /*************************************************FRETE**********************************************************
        ******************************************************************************************************************/

        /*Frete negociado em moeda estrangeira deve converter para Real*/
        IF i-moeda-frete <> 0 THEN DO:

            ASSIGN decla-import.val-frete-me[1] = decla-import.val-frete.

            ASSIGN de-valor-despesa = 0.
            /*Convertendo da moeda negociada para Real*/
            RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                    INPUT decla-import.cdd-siscomex-dts,            
                                    INPUT i-moeda-frete,
                                    INPUT 0,
                                    INPUT decla-import.val-frete-me[1],
                                    INPUT decla-import.dat-di,
                                    OUTPUT de-valor-despesa).
            ASSIGN decla-import.val-frete = de-valor-despesa.
        END.
        ELSE DO:
            ASSIGN decla-import.val-frete-me[1] = 0.
        END.

        IF i-moeda-frete <> param-imp.int-2 THEN DO:

            ASSIGN de-valor-despesa = 0.
            
            /*Verifica se foi negociado em Real ou em Moeda estrangeira para buscar da val-frete ou da val-frete-me[1]*/
            IF i-moeda-frete <> 0 THEN
                /*Convertendo da moeda negociada para D¢lar*/
                RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                        INPUT decla-import.cdd-siscomex-dts,
                                        INPUT i-moeda-frete,
                                        INPUT param-imp.int-2,
                                        INPUT decla-import.val-frete-me[1],
                                        INPUT decla-import.dat-di,
                                        OUTPUT de-valor-despesa).
            ELSE
                /*Convertendo da moeda negociada para D¢lar*/
                RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                        INPUT decla-import.cdd-siscomex-dts,
                                        INPUT i-moeda-frete,
                                        INPUT param-imp.int-2,
                                        INPUT decla-import.val-frete,
                                        INPUT decla-import.dat-di,
                                        OUTPUT de-valor-despesa).

            ASSIGN decla-import.val-frete-me[2] = de-valor-despesa.
        END.
        ELSE DO:
            ASSIGN decla-import.val-frete-me[2] = decla-import.val-frete-me[1].
        END.

        /**********************************************FIM FRETE***********************************************************
        ******************************************************************************************************************/

        /*************************************************SEGURO***********************************************************
        ******************************************************************************************************************/

        IF i-moeda-seguro <> 0 THEN DO:

            ASSIGN decla-import.val-seguro-me[1] = decla-import.val-seguro.

            ASSIGN de-valor-despesa = 0.
            /*Convertendo da moeda negociada para Real*/
            RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                    INPUT decla-import.cdd-siscomex-dts,
                                    INPUT i-moeda-seguro,
                                    INPUT 0,
                                    INPUT decla-import.val-seguro-me[1],
                                    INPUT decla-import.dat-di,
                                    OUTPUT de-valor-despesa).
            ASSIGN decla-import.val-seguro = de-valor-despesa.
        END.
        ELSE DO:
            ASSIGN decla-import.val-seguro-me[1] = 0.
        END.

        IF i-moeda-seguro <> param-imp.int-2 THEN DO:

            ASSIGN de-valor-despesa = 0.
            
            /*Verifica se foi negociado em Real ou em Moeda estrangeira para buscar da val-seguro ou da val-seguro-me[1]*/
            IF i-moeda-seguro <> 0 THEN
                /*Convertendo da moeda negociada para D¢lar*/
                RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                        INPUT decla-import.cdd-siscomex-dts,
                                        INPUT i-moeda-seguro,
                                        INPUT param-imp.int-2,
                                        INPUT decla-import.val-seguro-me[1],
                                        INPUT decla-import.dat-di,
                                        OUTPUT de-valor-despesa).
            ELSE
                /*Convertendo da moeda negociada para D¢lar*/
                RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                        INPUT decla-import.cdd-siscomex-dts,
                                        INPUT i-moeda-seguro,
                                        INPUT param-imp.int-2,
                                        INPUT decla-import.val-seguro,
                                        INPUT decla-import.dat-di,
                                        OUTPUT de-valor-despesa).

            ASSIGN decla-import.val-seguro-me[2] = de-valor-despesa.
        END.
        ELSE DO:
            ASSIGN decla-import.val-seguro-me[2] = decla-import.val-seguro-me[1].
        END.

        /*********************************************FIM SEGURO***********************************************************
        ******************************************************************************************************************/

        /*Fim convers∆o Frete e Seguro*/

        /*****************************************CONVERTENDO VALORES DA ADIÄ«O**************************************************
        *************************************************************************************************************************
        *************************************************************************************************************************/

        FOR EACH decla-import-adic EXCLUSIVE-LOCK
            WHERE decla-import-adic.num-di-ems = decla-import.num-di-ems
              and decla-import-adic.cdd-siscomex-dts = decla-import.cdd-siscomex-dts:

            /*gravando valor na moeda negociada no val-xxxx-me[1] e o valor em Real no val-xxxx*/
            IF i-mo-codigo <> 0 THEN DO:       
                ASSIGN decla-import-adic.val-vmle-me[1] = decla-import-adic.val-vmle
                       decla-import-adic.val-vmld-me[1] = decla-import-adic.val-vmld
                       decla-import-adic.val-vmcv-me[1] = decla-import-adic.val-vmcv.
    
                ASSIGN de-valor-despesa = 0.
    
                /*Convertendo da moeda negociada para Real*/
                RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                        INPUT decla-import.cdd-siscomex-dts,
                                        INPUT i-mo-codigo,
                                        INPUT 0,
                                        INPUT decla-import-adic.val-vmle-me[1],
                                        INPUT decla-import.dat-di,
                                        OUTPUT de-valor-despesa).
                ASSIGN decla-import-adic.val-vmle = de-valor-despesa.
    
                ASSIGN de-valor-despesa = 0.
    
                /*Convertendo da moeda negociada para Real*/
                RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                        INPUT decla-import.cdd-siscomex-dts,
                                        INPUT i-mo-codigo,
                                        INPUT 0,
                                        INPUT decla-import-adic.val-vmld-me[1],
                                        INPUT decla-import.dat-di,
                                        OUTPUT de-valor-despesa).
                ASSIGN decla-import-adic.val-vmld = de-valor-despesa.
    
                ASSIGN de-valor-despesa = 0.
                /*Convertendo da moeda negociada para Real*/
                RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                        INPUT decla-import.cdd-siscomex-dts,
                                        INPUT i-mo-codigo,
                                        INPUT 0,
                                        INPUT decla-import-adic.val-vmcv-me[1],
                                        INPUT decla-import.dat-di,
                                        OUTPUT de-valor-despesa).
                ASSIGN decla-import-adic.val-vmcv = de-valor-despesa.            
            END.
            ELSE DO:
                /*Foi negociado em Real ent∆o os campos val-xxxx-me[1] devem receber valor 0*/
                ASSIGN decla-import-adic.val-vmle-me[1] = 0
                       decla-import-adic.val-vmld-me[1] = 0
                       decla-import-adic.val-vmcv-me[1] = 0.
            END.
    
            /*Se a moeda negociada for diferente de D¢lar converter e gravar em Dolar no valor-xxxx-me[2]*/
            IF i-mo-codigo <> param-imp.int-2 THEN DO:
    
                ASSIGN de-valor-despesa = 0.
                
                IF i-mo-codigo <> 0 THEN
                    /*Convertendo da moeda negociada para D¢lar*/
                    RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                            INPUT decla-import.cdd-siscomex-dts,
                                            INPUT i-mo-codigo,
                                            INPUT param-imp.int-2,
                                            INPUT decla-import-adic.val-vmle-me[1],
                                            INPUT decla-import.dat-di,
                                            OUTPUT de-valor-despesa).
                ELSE
                    RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                            INPUT decla-import.cdd-siscomex-dts,
                                            INPUT i-mo-codigo,
                                            INPUT param-imp.int-2,
                                            INPUT decla-import-adic.val-vmle,
                                            INPUT decla-import.dat-di,
                                            OUTPUT de-valor-despesa).

                ASSIGN decla-import-adic.val-vmle-me[2] = de-valor-despesa.
    
                ASSIGN de-valor-despesa = 0.
    
                IF i-mo-codigo <> 0 THEN
                    /*Convertendo da moeda negociada para D¢lar*/
                    RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                            INPUT decla-import.cdd-siscomex-dts,
                                            INPUT i-mo-codigo,
                                            INPUT param-imp.int-2,
                                            INPUT decla-import-adic.val-vmld-me[1],
                                            INPUT decla-import.dat-di,
                                            OUTPUT de-valor-despesa).
                ELSE
                    /*Convertendo da moeda negociada para D¢lar*/
                    RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                            INPUT decla-import.cdd-siscomex-dts,
                                            INPUT i-mo-codigo,
                                            INPUT param-imp.int-2,
                                            INPUT decla-import-adic.val-vmld,
                                            INPUT decla-import.dat-di,
                                            OUTPUT de-valor-despesa).

                ASSIGN decla-import-adic.val-vmld-me[2] = de-valor-despesa.
    
                ASSIGN de-valor-despesa = 0.

                IF i-mo-codigo <> 0 THEN
                    /*Convertendo da moeda negociada para D¢lar*/
                    RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                            INPUT decla-import.cdd-siscomex-dts,
                                            INPUT i-mo-codigo,
                                            INPUT param-imp.int-2,
                                            INPUT decla-import-adic.val-vmcv-me[1],
                                            INPUT decla-import.dat-di,
                                            OUTPUT de-valor-despesa).
                ELSE
                    /*Convertendo da moeda negociada para D¢lar*/
                    RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                            INPUT decla-import.cdd-siscomex-dts,
                                            INPUT i-mo-codigo,
                                            INPUT param-imp.int-2,
                                            INPUT decla-import-adic.val-vmcv,
                                            INPUT decla-import.dat-di,
                                            OUTPUT de-valor-despesa).

                ASSIGN decla-import-adic.val-vmcv-me[2] = de-valor-despesa.
                
            END.
            ELSE DO:
                ASSIGN decla-import-adic.val-vmle-me[2] = decla-import-adic.val-vmle-me[1] 
                       decla-import-adic.val-vmld-me[2] = decla-import-adic.val-vmld-me[1] 
                       decla-import-adic.val-vmcv-me[2] = decla-import-adic.val-vmcv-me[1] .
            END.

            /*Convertendo Frete e Seguro da ADIÄ«O pois esses valores devem ser gravados conforme abaixo:
            
            val-frete       = Valor do Frete em real
            val-frete-me[1] = Valor do Frete na moeda cadastrada para a despesa de frete
            val-frete-me[2] = Valor do Frete na moeda D¢lar cadastrada nos parametros de importaá∆o
    
            val-seguro       = Valor do Seguro em real
            val-seguro-me[1] = Valor do Seguro na moeda cadastrada para a despesa de Seguro
            val-seguro-me[2] = Valor do Seguro na moeda D¢lar cadastrada nos parametros de importaá∆o            
            
            */
    
            /*************************************************FRETE**********************************************************
            ******************************************************************************************************************/
    
            /*Frete negociado em moeda estrangeira deve converter para Real*/
            IF i-moeda-frete <> 0 THEN DO:
    
                ASSIGN decla-import-adic.val-frete-me[1] = decla-import-adic.val-frete.
    
                ASSIGN de-valor-despesa = 0.
                /*Convertendo da moeda negociada para Real*/
                RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                        INPUT decla-import.cdd-siscomex-dts,
                                        INPUT i-moeda-frete,
                                        INPUT 0,
                                        INPUT decla-import-adic.val-frete-me[1],
                                        INPUT decla-import.dat-di,
                                        OUTPUT de-valor-despesa).
                ASSIGN decla-import-adic.val-frete = de-valor-despesa.
            END.
            ELSE DO:
                ASSIGN decla-import-adic.val-frete-me[1] = 0.
            END.
    
            IF i-moeda-frete <> param-imp.int-2 THEN DO:
    
                ASSIGN de-valor-despesa = 0.
                
                /*Verifica se foi negociado em Real ou em Moeda estrangeira para buscar da val-frete ou da val-frete-me[1]*/
                IF i-moeda-frete <> 0 THEN
                    /*Convertendo da moeda negociada para D¢lar*/
                    RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                            INPUT decla-import.cdd-siscomex-dts,
                                            INPUT i-moeda-frete,
                                            INPUT param-imp.int-2,
                                            INPUT decla-import-adic.val-frete-me[1],
                                            INPUT decla-import.dat-di,
                                            OUTPUT de-valor-despesa).
                ELSE
                    /*Convertendo da moeda negociada para D¢lar*/
                    RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                            INPUT decla-import.cdd-siscomex-dts,
                                            INPUT i-moeda-frete,
                                            INPUT param-imp.int-2,
                                            INPUT decla-import-adic.val-frete,
                                            INPUT decla-import.dat-di,
                                            OUTPUT de-valor-despesa).
    
                ASSIGN decla-import-adic.val-frete-me[2] = de-valor-despesa.
            END.
            ELSE DO:
                ASSIGN decla-import-adic.val-frete-me[2] = decla-import-adic.val-frete-me[1].
            END.
    
            /**********************************************FIM FRETE***********************************************************
            ******************************************************************************************************************/
    
            /*************************************************SEGURO***********************************************************
            ******************************************************************************************************************/
    
            IF i-moeda-seguro <> 0 THEN DO:
    
                ASSIGN decla-import-adic.val-seguro-me[1] = decla-import-adic.val-seguro.
    
                ASSIGN de-valor-despesa = 0.
                /*Convertendo da moeda negociada para Real*/
                RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                        INPUT decla-import.cdd-siscomex-dts,
                                        INPUT i-moeda-seguro,
                                        INPUT 0,
                                        INPUT decla-import-adic.val-seguro-me[1],
                                        INPUT decla-import.dat-di,
                                        OUTPUT de-valor-despesa).
                ASSIGN decla-import-adic.val-seguro = de-valor-despesa.
            END.
            ELSE DO:
                ASSIGN decla-import-adic.val-seguro-me[1] = 0.
            END.
    
            IF i-moeda-seguro <> param-imp.int-2 THEN DO:
    
                ASSIGN de-valor-despesa = 0.
                
                /*Verifica se foi negociado em Real ou em Moeda estrangeira para buscar da val-seguro ou da val-seguro-me[1]*/
                IF i-moeda-seguro <> 0 THEN
                    /*Convertendo da moeda negociada para D¢lar*/
                    RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                            INPUT decla-import.cdd-siscomex-dts,
                                            INPUT i-moeda-seguro,
                                            INPUT param-imp.int-2,
                                            INPUT decla-import-adic.val-seguro-me[1],
                                            INPUT decla-import.dat-di,
                                            OUTPUT de-valor-despesa).
                ELSE
                    /*Convertendo da moeda negociada para D¢lar*/
                    RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                            INPUT decla-import.cdd-siscomex-dts,
                                            INPUT i-moeda-seguro,
                                            INPUT param-imp.int-2,
                                            INPUT decla-import-adic.val-seguro,
                                            INPUT decla-import.dat-di,
                                            OUTPUT de-valor-despesa).
    
                ASSIGN decla-import-adic.val-seguro-me[2] = de-valor-despesa.
            END.
            ELSE DO:
                ASSIGN decla-import-adic.val-seguro-me[2] = decla-import-adic.val-seguro-me[1].
            END.
    
            /*********************************************FIM SEGURO***********************************************************
            ******************************************************************************************************************/
    
            /*Fim convers∆o Frete e Seguro*/

            /*****************************CONVERTENDO VALORES DOS ITENS DA ADIÄ«O****************************************************
            *************************************************************************************************************************
            *************************************************************************************************************************/

            FOR EACH decla-import-adic-itens EXCLUSIVE-LOCK
                WHERE decla-import-adic-itens.num-di-ems = decla-import-adic.num-di-ems
                AND   decla-import-adic-itens.num-adic   = decla-import-adic.num-adic 
                and   decla-import-adic-itens.cdd-siscomex-dts = decla-import-adic.cdd-siscomex-dts:

                /*gravando valor na moeda negociada no val-xxxx-me[1] e o valor em Real no val-xxxx*/
                IF i-mo-codigo <> 0 THEN DO:       
                    ASSIGN decla-import-adic-itens.val-vmle-me[1] = decla-import-adic-itens.val-vmle
                           decla-import-adic-itens.val-vmld-me[1] = decla-import-adic-itens.val-vmld
                           decla-import-adic-itens.val-vmcv-me[1] = decla-import-adic-itens.val-vmcv
                           decla-import-adic-itens.val-vucv-me[1] = decla-import-adic-itens.val-vucv.
        
                    ASSIGN de-valor-despesa = 0.
        
                    /*Convertendo da moeda negociada para Real*/
                    RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                            INPUT decla-import.cdd-siscomex-dts,
                                            INPUT i-mo-codigo,
                                            INPUT 0,
                                            INPUT decla-import-adic-itens.val-vmle-me[1],
                                            INPUT decla-import.dat-di,
                                            OUTPUT de-valor-despesa).
                    ASSIGN decla-import-adic-itens.val-vmle = de-valor-despesa.
        
                    ASSIGN de-valor-despesa = 0.
        
                    /*Convertendo da moeda negociada para Real*/
                    RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                            INPUT decla-import.cdd-siscomex-dts,
                                            INPUT i-mo-codigo,
                                            INPUT 0,
                                            INPUT decla-import-adic-itens.val-vmld-me[1],
                                            INPUT decla-import.dat-di,
                                            OUTPUT de-valor-despesa).
                    ASSIGN decla-import-adic-itens.val-vmld = de-valor-despesa.

                    ASSIGN de-valor-despesa = 0.
        
                    /*Convertendo da moeda negociada para Real*/
                    RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                            INPUT decla-import.cdd-siscomex-dts,
                                            INPUT i-mo-codigo,
                                            INPUT 0,
                                            INPUT decla-import-adic-itens.val-vmcv-me[1],
                                            INPUT decla-import.dat-di,
                                            OUTPUT de-valor-despesa).
                    ASSIGN decla-import-adic-itens.val-vmcv = de-valor-despesa.      

                    ASSIGN de-valor-despesa = 0.
        
                    /*Convertendo da moeda negociada para Real*/
                    RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                            INPUT decla-import.cdd-siscomex-dts,
                                            INPUT i-mo-codigo,
                                            INPUT 0,
                                            INPUT decla-import-adic-itens.val-vucv-me[1],
                                            INPUT decla-import.dat-di,
                                            OUTPUT de-valor-despesa).
                    ASSIGN decla-import-adic-itens.val-vucv = de-valor-despesa. 

                END.
                ELSE DO:
                    /*Foi negociado em Real ent∆o os campos val-xxxx-me[1] devem receber valor 0*/
                    ASSIGN decla-import-adic-itens.val-vmle-me[1] = 0
                           decla-import-adic-itens.val-vmld-me[1] = 0
                           decla-import-adic-itens.val-vmcv-me[1] = 0
                           decla-import-adic-itens.val-vucv-me[1] = 0.
                END.
        
                /*Se a moeda negociada for diferente de D¢lar converter e gravar em Dolar no valor-xxxx-me[2]*/
                IF i-mo-codigo <> param-imp.int-2 THEN DO:
        
                    ASSIGN de-valor-despesa = 0.
        
                    IF i-mo-codigo <> 0 THEN
                        /*Convertendo da moeda negociada para D¢lar*/
                        RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                                INPUT decla-import.cdd-siscomex-dts,
                                                INPUT i-mo-codigo,
                                                INPUT param-imp.int-2,
                                                INPUT decla-import-adic-itens.val-vmle-me[1],
                                                INPUT decla-import.dat-di,
                                                OUTPUT de-valor-despesa).
                    ELSE
                        /*Convertendo da moeda negociada para D¢lar*/
                        RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                                INPUT decla-import.cdd-siscomex-dts,
                                                INPUT i-mo-codigo,
                                                INPUT param-imp.int-2,
                                                INPUT decla-import-adic-itens.val-vmle,
                                                INPUT decla-import.dat-di,
                                                OUTPUT de-valor-despesa).

                    ASSIGN decla-import-adic-itens.val-vmle-me[2] = de-valor-despesa.
        
                    ASSIGN de-valor-despesa = 0.
        
                    IF i-mo-codigo <> 0 THEN
                        /*Convertendo da moeda negociada para D¢lar*/
                        RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                                INPUT decla-import.cdd-siscomex-dts,
                                                INPUT i-mo-codigo,
                                                INPUT param-imp.int-2,
                                                INPUT decla-import-adic-itens.val-vmld-me[1],
                                                INPUT decla-import.dat-di,
                                                OUTPUT de-valor-despesa).
                    ELSE
                        /*Convertendo da moeda negociada para D¢lar*/
                        RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                                INPUT decla-import.cdd-siscomex-dts,
                                                INPUT i-mo-codigo,
                                                INPUT param-imp.int-2,
                                                INPUT decla-import-adic-itens.val-vmld,
                                                INPUT decla-import.dat-di,
                                                OUTPUT de-valor-despesa).

                    ASSIGN decla-import-adic-itens.val-vmld-me[2] = de-valor-despesa.
        
                    ASSIGN de-valor-despesa = 0.

                    IF i-mo-codigo <> 0 THEN
                        /*Convertendo da moeda negociada para D¢lar*/
                        RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                                INPUT decla-import.cdd-siscomex-dts,
                                                INPUT i-mo-codigo,
                                                INPUT param-imp.int-2,
                                                INPUT decla-import-adic-itens.val-vmcv-me[1],
                                                INPUT decla-import.dat-di,
                                                OUTPUT de-valor-despesa).
                    ELSE
                        /*Convertendo da moeda negociada para D¢lar*/
                        RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                                INPUT decla-import.cdd-siscomex-dts,
                                                INPUT i-mo-codigo,
                                                INPUT param-imp.int-2,
                                                INPUT decla-import-adic-itens.val-vmcv,
                                                INPUT decla-import.dat-di,
                                                OUTPUT de-valor-despesa).

                    ASSIGN decla-import-adic-itens.val-vmcv-me[2] = de-valor-despesa.

                    ASSIGN de-valor-despesa = 0.
                    IF i-mo-codigo <> 0 THEN
                        /*Convertendo da moeda negociada para D¢lar*/
                        RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                                INPUT decla-import.cdd-siscomex-dts,
                                                INPUT i-mo-codigo,
                                                INPUT param-imp.int-2,
                                                INPUT decla-import-adic-itens.val-vucv-me[1],
                                                INPUT decla-import.dat-di,
                                                OUTPUT de-valor-despesa).
                    ELSE
                        /*Convertendo da moeda negociada para D¢lar*/
                        RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                                INPUT decla-import.cdd-siscomex-dts,
                                                INPUT i-mo-codigo,
                                                INPUT param-imp.int-2,
                                                INPUT decla-import-adic-itens.val-vucv,
                                                INPUT decla-import.dat-di,
                                                OUTPUT de-valor-despesa).

                    ASSIGN decla-import-adic-itens.val-vucv-me[2] = de-valor-despesa.
                    
                END.
                ELSE DO:
                    ASSIGN decla-import-adic-itens.val-vmle-me[2] = decla-import-adic-itens.val-vmle-me[1] 
                           decla-import-adic-itens.val-vmld-me[2] = decla-import-adic-itens.val-vmld-me[1] 
                           decla-import-adic-itens.val-vmcv-me[2] = decla-import-adic-itens.val-vmcv-me[1]
                           decla-import-adic-itens.val-vucv-me[2] = decla-import-adic-itens.val-vucv-me[1].
                END.

                /*Convertendo Frete e Seguro dos ITENS DA ADIÄ«O pois esses valores devem ser gravados conforme abaixo:
                
                val-frete       = Valor do Frete em real
                val-frete-me[1] = Valor do Frete na moeda cadastrada para a despesa de frete
                val-frete-me[2] = Valor do Frete na moeda D¢lar cadastrada nos parametros de importaá∆o
        
                val-seguro       = Valor do Seguro em real
                val-seguro-me[1] = Valor do Seguro na moeda cadastrada para a despesa de Seguro
                val-seguro-me[2] = Valor do Seguro na moeda D¢lar cadastrada nos parametros de importaá∆o            
                
                */
        
                /*************************************************FRETE**********************************************************
                ******************************************************************************************************************/
        
                /*Frete negociado em moeda estrangeira deve converter para Real*/
                IF i-moeda-frete <> 0 THEN DO:
        
                    ASSIGN decla-import-adic-itens.val-frete-me[1] = decla-import-adic-itens.val-frete.
        
                    ASSIGN de-valor-despesa = 0.
                    /*Convertendo da moeda negociada para Real*/
                    RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                            INPUT decla-import.cdd-siscomex-dts,
                                            INPUT i-moeda-frete,
                                            INPUT 0,
                                            INPUT decla-import-adic-itens.val-frete-me[1],
                                            INPUT decla-import.dat-di,
                                            OUTPUT de-valor-despesa).
                    ASSIGN decla-import-adic-itens.val-frete = de-valor-despesa.
                END.
                ELSE DO:
                    ASSIGN decla-import-adic-itens.val-frete-me[1] = 0.
                END.
        
                IF i-moeda-frete <> param-imp.int-2 THEN DO:
        
                    ASSIGN de-valor-despesa = 0.
                    
                    /*Verifica se foi negociado em Real ou em Moeda estrangeira para buscar da val-frete ou da val-frete-me[1]*/
                    IF i-moeda-frete <> 0 THEN
                        /*Convertendo da moeda negociada para D¢lar*/
                        RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                                INPUT decla-import.cdd-siscomex-dts,
                                                INPUT i-moeda-frete,
                                                INPUT param-imp.int-2,
                                                INPUT decla-import-adic-itens.val-frete-me[1],
                                                INPUT decla-import.dat-di,
                                                OUTPUT de-valor-despesa).
                    ELSE
                        /*Convertendo da moeda negociada para D¢lar*/
                        RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                                INPUT decla-import.cdd-siscomex-dts,
                                                INPUT i-moeda-frete,
                                                INPUT param-imp.int-2,
                                                INPUT decla-import-adic-itens.val-frete,
                                                INPUT decla-import.dat-di,
                                                OUTPUT de-valor-despesa).
        
                    ASSIGN decla-import-adic-itens.val-frete-me[2] = de-valor-despesa.
                END.
                ELSE DO:
                    ASSIGN decla-import-adic-itens.val-frete-me[2] = decla-import-adic-itens.val-frete-me[1].
                END.
        
                /**********************************************FIM FRETE***********************************************************
                ******************************************************************************************************************/
        
                /*************************************************SEGURO***********************************************************
                ******************************************************************************************************************/
        
                IF i-moeda-seguro <> 0 THEN DO:
        
                    ASSIGN decla-import-adic-itens.val-seguro-me[1] = decla-import-adic-itens.val-seguro.
        
                    ASSIGN de-valor-despesa = 0.
                    /*Convertendo da moeda negociada para Real*/
                    RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                            INPUT decla-import.cdd-siscomex-dts,
                                            INPUT i-moeda-seguro,
                                            INPUT 0,
                                            INPUT decla-import-adic-itens.val-seguro-me[1],
                                            INPUT decla-import.dat-di,
                                            OUTPUT de-valor-despesa).
                    ASSIGN decla-import-adic-itens.val-seguro = de-valor-despesa.
                END.
                ELSE DO:
                    ASSIGN decla-import-adic-itens.val-seguro-me[1] = 0.
                END.
        
                IF i-moeda-seguro <> param-imp.int-2 THEN DO:
        
                    ASSIGN de-valor-despesa = 0.
                    
                    /*Verifica se foi negociado em Real ou em Moeda estrangeira para buscar da val-seguro ou da val-seguro-me[1]*/
                    IF i-moeda-seguro <> 0 THEN
                        /*Convertendo da moeda negociada para D¢lar*/
                        RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                                INPUT decla-import.cdd-siscomex-dts,
                                                INPUT i-moeda-seguro,
                                                INPUT param-imp.int-2,
                                                INPUT decla-import-adic-itens.val-seguro-me[1],
                                                INPUT decla-import.dat-di,
                                                OUTPUT de-valor-despesa).
                    ELSE
                        /*Convertendo da moeda negociada para D¢lar*/
                        RUN converteValorMoeda (INPUT decla-import.num-di-ems,
                                                INPUT decla-import.cdd-siscomex-dts,
                                                INPUT i-moeda-seguro,
                                                INPUT param-imp.int-2,
                                                INPUT decla-import-adic-itens.val-seguro,
                                                INPUT decla-import.dat-di,
                                                OUTPUT de-valor-despesa).
        
                    ASSIGN decla-import-adic-itens.val-seguro-me[2] = de-valor-despesa.
                END.
                ELSE DO:
                    ASSIGN decla-import-adic-itens.val-seguro-me[2] = decla-import-adic-itens.val-seguro-me[1].
                END.
        
                /*********************************************FIM SEGURO***********************************************************
                ******************************************************************************************************************/
                /*Fim convers∆o Frete e Seguro*/
            END.
        END.
    END.
