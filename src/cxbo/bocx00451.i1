{include/i_fncrowid.i}

/*TT com o saldo das antecipa‡äes*/
def temp-table tt_tit_ap_antecip_sdo no-undo
    field tta_cod_estab                    as Character format "x(5)" label "Estabelecimento" column-label "Estab"
    field tta_cod_espec_docto              as character format "x(3)" label "Esp‚cie Documento" column-label "Esp‚cie"
    field tta_cod_ser_docto                as character format "x(5)" label "S‚rie Documento" column-label "S‚rie"
    field tta_cod_tit_ap                   as character format "x(10)" label "T¡tulo" column-label "T¡tulo"
    field tta_cod_parcela                  as character format "x(02)" label "Parcela" column-label "Parcela"
    field tta_cod_refer                    as character format "x(10)" label "Referˆncia" column-label "Referˆncia"
    field tta_cdn_fornecedor               as Integer format ">>>,>>>,>>9" initial 0 label "Fornecedor" column-label "Fornecedor"
    field tta_nom_abrev_fornec             as character format "x(15)" label "Nome Abreviado" column-label "Nome Abreviado"
    field tta_cod_indic_econ               as character format "x(8)" label "Moeda" column-label "Moeda"
    field tta_val_sdo_tit_ap               as decimal format "->>>,>>>,>>9.99" decimals 2 initial 0 label "Valor Saldo" column-label "Valor Saldo"
    field tta_dat_transacao                as date format "99/99/9999" initial today label "Data Transa‡Æo" column-label "Dat Transac"
    field ttv_rec_tit_ap                   as &IF {&ROWID_READY} = YES &THEN 
                                                ROWID
                                              &ELSE
                                                RECID format ">>>>>>9" initial ?
                                              &ENDIF
    
    field tta_cod_empresa                  as character format "x(3)" label "Empresa" column-label "Empresa"
    field tta_val_origin_tit_ap            as decimal format "->>>,>>>,>>9.99" decimals 2 initial 0 label "Valor Original" column-label "Valor Original"
    field tta_val_entr_transf_estab        as decimal format "->>>,>>>,>>9.99" decimals 2 initial 0 label "Entr Transf Estab" column-label "Entr Transf Estab"
    field ttv_val_liber_pagto_orig_tot     as decimal format "->>>,>>>,>>9.99" decimals 2 initial 0 label "Total Liberado" column-label "Total Liberado"
    field ttv_val_tot_pagto_tit_ap         as decimal format "->>>,>>>,>>9.99" decimals 2 label "Total Pagamentos" column-label "Total Pagamentos"
    field tta_dat_emis_docto               as date format "99/99/9999" initial today label "Data  EmissÆo" column-label "Dt EmissÆo"
    field tta_dat_vencto_tit_ap            as date format "99/99/9999" initial today label "Data Vencimento" column-label "Dt Vencto"
    field tta_dat_prev_pagto               as date format "99/99/9999" initial today label "Data Prevista Pgto" column-label "Dt Prev Pagto"
    field tta_dat_ult_pagto                as date format "99/99/9999" initial ? label "Data éltimo Pagto" column-label "Data éltimo Pagto"
    field tta_dat_ult_apurac_variac_val    as date format "99/99/9999" initial ? label "Ult Apur Variac Val" column-label "Ult Apur Variac Val"
    field tta_dat_liquidac_tit_ap          as date format "99/99/9999" initial ? label "Data Liquida‡Æo" column-label "Data Liquida‡Æo"
    field ttv_val_origin_tit_ap_aux        as decimal format "->>>,>>>,>>9.99" decimals 2 label "Valor Original" column-label "Valor Original"
    field ttv_val_sdo_tit_ap_aux           as decimal format "->>,>>>,>>>,>>9.99" decimals 2 label "Valor Saldo" column-label "Valor Saldo"
    field ttv_val_cotac_indic_econ_aux     as decimal format ">>>>,>>9.9999999999" decimals 10 label "Cota‡Æo" column-label "Cota‡Æo"
    field ttv_val_cotac_indic_econ_inver   as decimal format "->>,>>>,>>>,>>9.9999999999" decimals 10 label "Cota‡Æo Inversa" column-label "Cota‡Æo Inversa"
    .

/*TT com os erros da atualiza‡Æo/consulta das antecipa‡äes*/
def temp-table tt_log_erros_atualiz no-undo
    field tta_cod_estab                    as character format "x(3)" label "Estabelecimento" column-label "Estab"
    field tta_cod_refer                    as character format "x(10)" label "Referˆncia" column-label "Referˆncia"
    field tta_num_seq_refer                as integer format ">>>9" initial 0 label "Sequˆncia" column-label "Seq"
    field ttv_num_mensagem                 as integer format ">>>>,>>9" label "N£mero" column-label "N£mero Mensagem"
    field ttv_des_msg_erro                 as character format "x(60)" label "Mensagem Erro" column-label "Inconsistˆncia"
    field ttv_des_msg_ajuda                as character format "x(40)" label "Mensagem Ajuda" column-label "Mensagem Ajuda"
    field ttv_ind_tip_relacto              as character format "X(15)" label "Tipo Relacionamento" column-label "Tipo Relac"
    field ttv_num_relacto                  as integer format ">>>>,>>9" label "Relacionamento" column-label "Relacionamento"
    .

/*TT com as antecipa‡äes a vincular*/
def temp-table tt_tit_ap_antecip_sdo_a_vincular no-undo like tt_tit_ap_antecip_sdo
    field tta_val_sdo_vincular             as decimal format "->>>,>>>,>>9.99" decimals 2 initial 0 label "Valor a Vincular" column-label "Valor a Vincular".
    
/*TT com os parƒmetros para a busca de antecipa‡äes*/
def temp-table tt-param-antecip no-undo
    field cod-estab-ini        like antecip-import.cod-estab-ap        /*estabelecimento inicial*/   
    field cod-estab-fim        like antecip-import.cod-estab-ap        /*estabelecimento final*/     
    field cdn-emitente-ini     like antecip-import.cdn-emitente-ap     /*fornecedor inicial*/        
    field cdn-emitente-fim     like antecip-import.cdn-emitente-ap     /*fornecedor final*/          
    field dat-transacao-ini    like antecip-import.dat-transacao       /*data de transa‡Æo inicial*/ 
    field dat-transacao-fim    like antecip-import.dat-transacao       /*data de transa‡Æo final*/   
    field cod-espec-docto-ini  like antecip-import.cod-espec-docto-ap  /*esp‚cie inicial*/           
    field cod-espec-docto-fim  like antecip-import.cod-espec-docto-ap  /*esp‚cie final*/             
    field cod-ser-docto-ini    like antecip-import.cod-ser-docto-ap    /*s‚rie inicial*/             
    field cod-ser-docto-fim    like antecip-import.cod-ser-docto-ap    /*s‚rie final*/               
    field cod-tit-ap-ini       like antecip-import.cod-tit-ap          /*t¡tulo inicial*/            
    field cod-tit-ap-fim       like antecip-import.cod-tit-ap.         /*t¡tulo final*/              
   
