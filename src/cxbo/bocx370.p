PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice ncmpstrd-id
  Parameters:  
               retorna valor do campo cod-cap
               retorna valor do campo cod-pos
               retorna valor do campo cod-idioma
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pcod-cap LIKE ncm-pos-traduz.cod-cap NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-pos LIKE ncm-pos-traduz.cod-pos NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-idioma LIKE ncm-pos-traduz.cod-idioma NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pcod-cap = RowObject.cod-cap
           pcod-pos = RowObject.cod-pos
           pcod-idioma = RowObject.cod-idioma.

    RETURN "OK":U.
END PROCEDURE.

