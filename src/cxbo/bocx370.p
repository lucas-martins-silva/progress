&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice ncmpstrd-id
  Parameters:  
               recebe valor do campo cod-cap
               recebe valor do campo cod-pos
               recebe valor do campo cod-idioma
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-cap LIKE ncm-pos-traduz.cod-cap NO-UNDO.
    DEFINE INPUT PARAMETER pcod-pos LIKE ncm-pos-traduz.cod-pos NO-UNDO.
    DEFINE INPUT PARAMETER pcod-idioma LIKE ncm-pos-traduz.cod-idioma NO-UNDO.

    FIND FIRST bfncm-pos-traduz WHERE 
        bfncm-pos-traduz.cod-cap = pcod-cap AND 
        bfncm-pos-traduz.cod-pos = pcod-pos AND 
        bfncm-pos-traduz.cod-idioma = pcod-idioma NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfncm-pos-traduz THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfncm-pos-traduz)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE linkToByPosicao DBOProgram 
PROCEDURE linkToByPosicao :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    
    DEF INPUT PARAM p-handle AS HANDLE NO-UNDO.

    IF VALID-HANDLE (p-handle) THEN
        RUN getKey IN p-handle (OUTPUT c-cod-cap, OUTPUT c-cod-pos).
                  
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryByPosicao DBOProgram 
PROCEDURE openQueryByPosicao :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    OPEN QUERY {&QueryName} FOR EACH {&TableName} NO-LOCK
                               WHERE {&TableName}.cod-cap = c-cod-cap 
                                 AND {&TableName}.cod-pos = c-cod-pos INDEXED-REPOSITION.              
                  
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

