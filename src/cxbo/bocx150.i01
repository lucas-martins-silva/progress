/* bocx150.i01 - Criada em 25/05/2004 - Eliza F.C.                    */
/* Include para tratar re-planejamento das parcelas no                */
/* MRP, conforme atividade 116178                                     */
                                                                     
/* Verifica se a ordem de compra est  vinculada                       */
/* a um processo de importa‡Æo que possua acompanhamento.             */

procedure buscaHistorico : 

        define input  parameter i-num-pedido like ordem-compra.num-pedido no-undo.
        define output parameter l-acomp      as logical                   no-undo.
        
        for each processo-imp no-lock where
                 processo-imp.num-pedido = i-num-pedido:
                 
                if can-find (first historico-proc-imp where 
                                   historico-proc-imp.cod-estabel = processo-imp.cod-estabel  and
                                   historico-proc-imp.nr-proc-imp = processo-imp.nr-proc-imp) then
                    assign l-acomp = yes.
               else assign l-acomp = no.
               
        end.

end procedure.

        



 

