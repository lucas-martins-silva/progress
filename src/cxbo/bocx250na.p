    IF NOT AVAILABLE RowObject THEN 
        RETURN "NOK":U.

    CASE pFieldName:
        WHEN "hist-processo":U THEN ASSIGN pFieldValue = RowObject.hist-processo.
        WHEN "inc-icms-tot-nf":U THEN ASSIGN pFieldValue = RowObject.inc-icms-tot-nf.
        WHEN "log-1":U THEN ASSIGN pFieldValue = RowObject.log-1.
        WHEN "log-2":U THEN ASSIGN pFieldValue = RowObject.log-2.
