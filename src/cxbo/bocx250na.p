&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getTrataDepExternos DBOProgram 
PROCEDURE getTrataDepExternos :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
DEF INPUT  PARAM pCodEstabel  LIKE param-imp.cod-estabel NO-UNDO.
DEF OUTPUT PARAM pTrataDepExt AS LOGICAL                 NO-UNDO.

ASSIGN pTrataDepExt = NO.

IF i-pais-impto-usuario <> 1 
    AND CAN-FIND(FIRST funcao
                 WHERE funcao.cd-funcao = "spp-trata-dep-ext-internac"
                 AND   funcao.ativo) THEN DO:

    FOR FIRST bf{&TableName} NO-LOCK
        WHERE bf{&TableName}.cod-estabel = pCodEstabel:
        ASSIGN pTrataDepExt = IF SUBSTRING(bf{&TableName}.char-1,226,1) = "S" THEN YES ELSE NO.
    END.  
END.

RETURN "OK":U.
END PROCEDURE.

