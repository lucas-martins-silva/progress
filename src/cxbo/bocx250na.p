&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE get-param-calc-desp-itiner DBOProgram 
PROCEDURE get-param-calc-desp-itiner :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
DEF INPUT  PARAM pCodEstabel          LIKE param-imp.cod-estabel NO-UNDO.
DEF OUTPUT PARAM p-calc-despes-itiner AS LOGICAL                 NO-UNDO.

FOR FIRST bfparam-imp NO-LOCK
    WHERE bfparam-imp.cod-estabel = pCodEstabel:
    IF SUBSTRING(bfparam-imp.char-1,168,1) = "S" THEN
        ASSIGN p-calc-despes-itiner = YES.
    ELSE
        ASSIGN p-calc-despes-itiner = NO.
END.

RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getCharField DBOProgram 
PROCEDURE getCharField :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valor de campos do tipo caracter
  Parameters:  
               recebe nome do campo
               retorna valor do campo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pFieldName AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldValue AS CHARACTER NO-UNDO.

    /*--- Verifica se temptable RowObject est  dispon¡vel, caso nÆo esteja ser 
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
        RETURN "NOK":U.

    CASE pFieldName:
        WHEN "char-1":U THEN ASSIGN pFieldValue = RowObject.char-1.
        WHEN "char-2":U THEN ASSIGN pFieldValue = RowObject.char-2.
        WHEN "check-sum":U THEN ASSIGN pFieldValue = RowObject.check-sum.
        WHEN "cod-estabel":U THEN ASSIGN pFieldValue = RowObject.cod-estabel.
        /*##WHEN "conta-transit-import":U THEN ASSIGN pFieldValue = RowObject.conta-transit-import.*/
        WHEN "ct-transit-import":U THEN ASSIGN pFieldValue = RowObject.ct-transit-import.
        WHEN "esp-tit-rec":U THEN ASSIGN pFieldValue = RowObject.esp-tit-rec.
        WHEN "esp-tit-transit":U THEN ASSIGN pFieldValue = RowObject.esp-tit-transit.
        WHEN "sc-transit-import":U THEN ASSIGN pFieldValue = RowObject.sc-transit-import.
        OTHERWISE RETURN "NOK":U.
    END CASE.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

