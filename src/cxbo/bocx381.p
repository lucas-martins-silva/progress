&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice prcsxprg-id
  Parameters:  
               recebe valor do campo cod-estabel
               recebe valor do campo nr-proc-exp
               recebe valor do campo cod-emitente
               recebe valor do campo cod-tit-ap
               recebe valor do campo cdn-impto
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-estabel LIKE proces-export-concil-impto.cod-estabel NO-UNDO.
    DEFINE INPUT PARAMETER pnr-proc-exp LIKE proces-export-concil-impto.nr-proc-exp NO-UNDO.
    DEFINE INPUT PARAMETER pcod-emitente LIKE proces-export-concil-impto.cod-emitente NO-UNDO.
    DEFINE INPUT PARAMETER pcod-tit-ap LIKE proces-export-concil-impto.cod-tit-ap NO-UNDO.
    DEFINE INPUT PARAMETER pcdn-impto LIKE proces-export-concil-impto.cdn-impto NO-UNDO.

    FIND FIRST bfproces-export-concil-impto WHERE 
        bfproces-export-concil-impto.cod-estabel = pcod-estabel AND 
        bfproces-export-concil-impto.nr-proc-exp = pnr-proc-exp AND 
        bfproces-export-concil-impto.cod-emitente = pcod-emitente AND 
        bfproces-export-concil-impto.cod-tit-ap = pcod-tit-ap AND 
        bfproces-export-concil-impto.cdn-impto = pcdn-impto NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfproces-export-concil-impto THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfproces-export-concil-impto)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE linkTottproces-export-concil DBOProgram 
PROCEDURE linkTottproces-export-concil :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEF INPUT PARAM ph-bocx379 AS HANDLE NO-UNDO.
    
    RUN getKey IN ph-bocx379 (OUTPUT cCod-estabel,
                              OUTPUT cNr-proc-exp,
                              OUTPUT iCod-emitente,
                              OUTPUT cCod-tit-ap).
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryImpto DBOProgram 
PROCEDURE openQueryImpto :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    
    OPEN QUERY qr{&TableName} FOR EACH {&TableName} NO-LOCK
                                 WHERE {&TableName}.cod-estabel  = cCod-estabel
                                   AND {&TableName}.nr-proc-exp  = cNr-proc-exp
                                   AND {&TableName}.cod-emitente = iCod-emitente
                                   AND {&TableName}.cod-tit-ap   = cCod-tit-ap
                                   INDEXED-REPOSITION.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/
    IF  pType = "Create":U THEN DO:
        IF  NOT CAN-FIND(FIRST tipo-tax
                         WHERE tipo-tax.cod-tax = RowObject.cdn-impto) THEN DO:
            RUN _insertError (INPUT 2,
                              INPUT "EMS":U,
                              INPUT ?,
                              INPUT 'Imposto').
        END.
        
        IF  CAN-FIND(FIRST bf{&TableName}
                     WHERE bf{&TableName}.cod-estabel  = RowObject.cod-estabel
                       AND bf{&TableName}.nr-proc-exp  = RowObject.nr-proc-exp
                       AND bf{&TableName}.cod-emitente = RowObject.cod-emitente 
                       AND bf{&TableName}.cod-tit-ap   = RowObject.cod-tit-ap
                       AND bf{&TableName}.cdn-impto  = RowObject.cdn-impto) THEN DO:
            RUN utp/ut-table.p (INPUT "mgcex":U,
                                INPUT "{&TableName}":U,
                                INPUT 1).
            RUN _insertError (INPUT 7,
                              INPUT "EMS":U,
                              INPUT ?,
                              INPUT RETURN-VALUE).
        END.
    END.
    
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

