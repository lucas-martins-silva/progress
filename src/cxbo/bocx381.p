&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getKey DBOProgram 
PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice prcsxprg-id
  Parameters:  
               retorna valor do campo cod-estabel
               retorna valor do campo nr-proc-exp
               retorna valor do campo cod-emitente
               retorna valor do campo cod-tit-ap
               retorna valor do campo cdn-impto
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pcod-estabel LIKE proces-export-concil-impto.cod-estabel NO-UNDO.
    DEFINE OUTPUT PARAMETER pnr-proc-exp LIKE proces-export-concil-impto.nr-proc-exp NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-emitente LIKE proces-export-concil-impto.cod-emitente NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-tit-ap LIKE proces-export-concil-impto.cod-tit-ap NO-UNDO.
    DEFINE OUTPUT PARAMETER pcdn-impto LIKE proces-export-concil-impto.cdn-impto NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pcod-estabel = RowObject.cod-estabel
           pnr-proc-exp = RowObject.nr-proc-exp
           pcod-emitente = RowObject.cod-emitente
           pcod-tit-ap = RowObject.cod-tit-ap
           pcdn-impto = RowObject.cdn-impto.

    RETURN "OK":U.
END PROCEDURE.

