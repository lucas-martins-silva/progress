procedure setConstraint1:
 
end procedure.

PROCEDURE setConstraint2:

    def input parameter p-cod-estabel like proc-siscomex.cod-estabel no-undo.
    def input parameter p-nr-proc-exp like proc-siscomex.nr-proc-exp no-undo.
    def input parameter p-nr-re like proc-siscomex.nr-re no-undo.
    assign c-cod-estabel  = p-cod-estabel
           c-nr-proc-exp  = p-nr-proc-exp
           c-nr-re        = p-nr-re.

END procEDURE.

PROCEDURE setConstraint3:

    def input parameter p-cod-estabel like proc-siscomex.cod-estabel no-undo.
    def input parameter p-nr-proc-exp like proc-siscomex.nr-proc-exp no-undo.
    assign c-cod-estabel  = p-cod-estabel
           c-nr-proc-exp  = p-nr-proc-exp.

END procEDURE.


PROCEDURE setConstraint4:
    def input parameter p-nr-proc-exp-ini like proc-siscomex.nr-proc-exp no-undo.
    def input parameter p-nr-proc-exp-fin like proc-siscomex.nr-proc-exp no-undo.

    assign c-nr-proc-exp-ini  = p-nr-proc-exp-ini
           c-nr-proc-exp-fin  = p-nr-proc-exp-fin.
END procEDURE.

PROCEDURE setConstraint5:

    def input parameter p-cod-estabel-ini like proc-siscomex.cod-estabel no-undo.
    def input parameter p-cod-estabel-fin like proc-siscomex.cod-estabel no-undo.

    assign c-cod-estabel-ini  = p-cod-estabel-ini
           c-cod-estabel-fin  = p-cod-estabel-fin.

END procEDURE.

PROCEDURE setConstraint6:

    def input parameter p-nr-re-ini like proc-siscomex.nr-re no-undo.
    def input parameter p-nr-re-fin like proc-siscomex.nr-re no-undo.

    assign c-nr-re-ini        = p-nr-re-ini
           c-nr-re-fin        = p-nr-re-fin.

END procEDURE.

PROCEDURE setConstraint7:

    def input parameter p-cod-estabel-ini like proc-siscomex.cod-estabel no-undo.
    def input parameter p-cod-estabel-fim like proc-siscomex.cod-estabel no-undo.
    def input parameter p-nr-proc-exp-ini like proc-siscomex.nr-proc-exp no-undo.
    def input parameter p-nr-proc-exp-fim like proc-siscomex.nr-proc-exp no-undo.
    def input parameter p-nr-re-ini       like proc-siscomex.nr-re no-undo.
    def input parameter p-nr-re-fim       like proc-siscomex.nr-re no-undo.

    assign c-cod-estabel-ini  = p-cod-estabel-ini
           c-cod-estabel-fin  = p-cod-estabel-fim
           c-nr-proc-exp-ini  = p-nr-proc-exp-ini
           c-nr-proc-exp-fin  = p-nr-proc-exp-fim
           c-nr-re-ini        = p-nr-re-ini
           c-nr-re-fin        = p-nr-re-fim.

END procEDURE.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
        when 2 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} where proc-siscomex.cod-estabel >= c-cod-estabel and ~
                                                                  proc-siscomex.nr-proc-exp >= c-nr-proc-exp and ~
                                                                  proc-siscomex.nr-re       >= c-nr-re  no-lock  by proc-siscomex.cod-estabel by proc-siscomex.nr-proc-exp.
        when 3 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} where proc-siscomex.cod-estabel = c-cod-estabel and ~
                                                                  proc-siscomex.nr-proc-exp = c-nr-proc-exp no-lock.

         when 4 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} where proc-siscomex.nr-proc-exp >= c-nr-proc-exp-ini and ~
                                                                  proc-siscomex.nr-proc-exp <= c-nr-proc-exp-fin  no-lock  by proc-siscomex.nr-proc-exp.
        when 5 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} where proc-siscomex.cod-estabel >= c-cod-estabel-ini and ~
                                                                  proc-siscomex.cod-estabel <= c-cod-estabel-fin no-lock  by proc-siscomex.cod-estabel.
        when 6 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} where proc-siscomex.nr-re       >= c-nr-re-ini and ~
                                                                  proc-siscomex.nr-re       <= c-nr-re-fin  no-lock by proc-siscomex.nr-re.  
        when 7 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} 
            where proc-siscomex.cod-estabel >= c-cod-estabel-ini and 
                  proc-siscomex.cod-estabel <= c-cod-estabel-fin and
                  proc-siscomex.nr-proc-exp >= c-nr-proc-exp-ini and
                  proc-siscomex.nr-proc-exp <= c-nr-proc-exp-fin and
                  proc-siscomex.nr-re       >= c-nr-re-ini       and
                  proc-siscomex.nr-re       <= c-nr-re-fin  no-lock
                  use-index pk-re
                  {&v9indrep}.

    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.
 
