procedure findPk_re:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter c-cod-estabel as char no-undo.
    def input parameter c-nr-proc-exp as char no-undo.
    def input parameter c-nr-re as char no-undo.
    def output parameter c-return as char no-undo.
 
    find proc-siscomex where
        proc-siscomex.cod-estabel = c-cod-estabel
        and proc-siscomex.nr-proc-exp = c-nr-proc-exp
        and proc-siscomex.nr-re = c-nr-re
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex proc-siscomex 1}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.
 
procedure validateFields:
    /*
    **  Valida Fields
    */
    
    run startMethod ("validateFields").
    
    find first rowObject no-lock no-error.
    
    if rowObject.cod-inst = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-siscomex cod-inst 2}
        run utp/ut-msgs.p (input "msg",
                           input 2,  /* NÆo encontrado(a) &1 para a chave informada*/
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = return-value.
    end.
    else 
       if not can-find(inst-negoc where inst-negoc.cod-inst = rowObject.cod-inst) then do:
           assign i-seq-erro = i-seq-erro + 1.
           /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
              pre-processador em chamada de includes */
           {utp/ut-field.i mgcex proc-siscomex cod-inst 2}
           run utp/ut-msgs.p (input "msg",
                              input 2,  /* NÆo encontrado(a) &1 para a chave informada*/
                              input return-value).
           create tt-bo-erro.
           assign tt-bo-erro.i-sequen = i-seq-erro
                  tt-bo-erro.cd-erro  = 2
                  tt-bo-erro.mensagem = return-value.
       end.
        
    if rowObject.cod-transac = 0 then do:
       assign i-seq-erro = i-seq-erro + 1.
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-field.i mgcex mod-transac cod-transac 2}
       run utp/ut-msgs.p (input "msg",                   
                          input 2,  /* NÆo encontrado(a) &1 para a chave informada*/
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen = i-seq-erro
              tt-bo-erro.cd-erro  = 2
              tt-bo-erro.mensagem = return-value.
    end.
    else
       if not can-find(mod-transac where mod-transac.cod-transac = rowObject.cod-transac) then do:
          assign i-seq-erro = i-seq-erro + 1.
          /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
             pre-processador em chamada de includes */
          {utp/ut-field.i mgcex mod-transac cod-transac 2}
          run utp/ut-msgs.p (input "msg",                   
                             input 2,  /* NÆo encontrado(a) &1 para a chave informada*/
                             input return-value).
          create tt-bo-erro.
          assign tt-bo-erro.i-sequen = i-seq-erro
                 tt-bo-erro.cd-erro  = 2
                 tt-bo-erro.mensagem = return-value.
    end.
       
    if rowObject.cod-enquad-1 = 0 then do:
       assign i-seq-erro = i-seq-erro + 1.
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-liter.i Enquadramento_1 * R}
       run utp/ut-msgs.p (input "msg",
                          input 2,  /* NÆo encontrado(a) &1 para a chave informada*/
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen = i-seq-erro
              tt-bo-erro.cd-erro  = 2
              tt-bo-erro.mensagem = return-value.
    end.
    else
       if not can-find(enquad-oper where enquad-oper.cod-enquad = rowObject.cod-enquad-1) then do:
          assign i-seq-erro = i-seq-erro + 1.
          /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
             pre-processador em chamada de includes */
          {utp/ut-liter.i Enquadramento_1 * R}
          run utp/ut-msgs.p (input "msg",
                             input 2,  /* NÆo encontrado(a) &1 para a chave informada*/
                             input return-value).
          create tt-bo-erro.
          assign tt-bo-erro.i-sequen = i-seq-erro
                 tt-bo-erro.cd-erro  = 2
                 tt-bo-erro.mensagem = return-value.
       end.
    if rowObject.cod-enquad-2 <> 0 and not 
       can-find(enquad-oper where enquad-oper.cod-enquad = rowObject.cod-enquad-2) then do:
       assign i-seq-erro = i-seq-erro + 1.
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-liter.i Enquadramento_2 * R}
       run utp/ut-msgs.p (input "msg",
                          input 2,  /* NÆo encontrado(a) &1 para a chave informada*/
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen = i-seq-erro
              tt-bo-erro.cd-erro  = 2
              tt-bo-erro.mensagem = return-value.
    end.
    if rowObject.cod-enquad-3 <> 0 and not 
       can-find(enquad-oper where enquad-oper.cod-enquad = rowObject.cod-enquad-3) then do:
       assign i-seq-erro = i-seq-erro + 1.
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-liter.i Enquadramento_3 * R}
       run utp/ut-msgs.p (input "msg",
                          input 2,  /* NÆo encontrado(a) &1 para a chave informada*/
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen = i-seq-erro
              tt-bo-erro.cd-erro  = 2
              tt-bo-erro.mensagem = return-value.
    end.
    if rowObject.cod-enquad-4 <> 0 and not 
       can-find(enquad-oper where enquad-oper.cod-enquad = rowObject.cod-enquad-4) then do:
       assign i-seq-erro = i-seq-erro + 1.
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-liter.i Enquadramento_4 * R}
       run utp/ut-msgs.p (input "msg",
                          input 2,  /* NÆo encontrado(a) &1 para a chave informada*/
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen = i-seq-erro
              tt-bo-erro.cd-erro  = 2
              tt-bo-erro.mensagem = return-value.
    end.
    if rowObject.cod-enquad-5 <> 0 and not 
       can-find(enquad-oper where enquad-oper.cod-enquad = rowObject.cod-enquad-5) then do:
       assign i-seq-erro = i-seq-erro + 1.
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-liter.i Enquadramento_5 * R}
       run utp/ut-msgs.p (input "msg",
                          input 2,  /* NÆo encontrado(a) &1 para a chave informada*/
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen = i-seq-erro
              tt-bo-erro.cd-erro  = 2
              tt-bo-erro.mensagem = return-value.
    end.
    if rowObject.cod-estabel = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 190,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 190
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.nr-ce = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 190,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 190
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.nr-proc-exp = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 190,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 190
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.nr-re = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 190,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 190
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.nr-res = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 190,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 190
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.nr-sd = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 190,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 190
               tt-bo-erro.mensagem     = return-value.
    end.
 
    run endMethod ("validateFields").
 
end procedure.

procedure setaCodSitProc:
    find first rowObject
        no-lock no-error.
 
    run startMethod ("validateFields").

    find first processo-exp where processo-exp.cod-estabel = rowObject.cod-estabel and
                                  processo-exp.nr-proc-exp = rowObject.nr-proc-exp no-lock no-error.
     if avail processo-exp then do:                                  
            if processo-exp.cod-sit-proc = 4 then do:
               assign i-seq-erro = i-seq-erro + 1.
               /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                  pre-processador em chamada de includes */
               {utp/ut-table.i mgcex processo-exp 1}
               run utp/ut-msgs.p (input "msg",
                                  input 18400,
                                  input return-value ).
               create tt-bo-erro.
               assign tt-bo-erro.i-sequen = i-seq-erro
                      tt-bo-erro.cd-erro  = 18400
                      tt-bo-erro.mensagem = return-value.
            end.
    end.
    run endMethod ("validateFields").    
END.
 
procedure validateCreate:
    /*
    **  Valida cria‡Æo da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.
 
    run initializeValidate.
    run startMethod ("validateCreate").
 
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
 
    find first rowObject
        no-lock no-error.
    if rowObject.cod-estabel = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-siscomex cod-estabel 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.nr-ce = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-siscomex nr-ce 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.nr-proc-exp = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-siscomex nr-proc-exp 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.nr-re = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-siscomex nr-re 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.nr-res = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-siscomex nr-res 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.nr-sd = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-siscomex nr-sd 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    find first tt-bo-erro
        no-lock no-error.
    if not available tt-bo-erro then do:
        find proc-siscomex where
            proc-siscomex.cod-estabel = rowObject.cod-estabel
        and proc-siscomex.nr-proc-exp = rowObject.nr-proc-exp
        and proc-siscomex.nr-re = rowObject.nr-re
            no-lock no-error.
        if avail proc-siscomex then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex proc-siscomex 1}
            run utp/ut-msgs.p (input "msg",
                               input 8,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 8
                   tt-bo-erro.mensagem     = return-value.
        end.
    end.
    
    if not can-find(processo-exp where processo-exp.cod-estabel = rowObject.cod-estabel 
                                   and processo-exp.nr-proc-exp = rowObject.nr-proc-exp) then do:
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
       {utp/ut-field.i mgcex processo-exp nr-proc-exp 1}
       assign i-seq-erro = i-seq-erro + 1.
       run utp/ut-msgs.p (input "msg",
                          input 2,
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen = i-seq-erro
              tt-bo-erro.cd-erro  = 2
              tt-bo-erro.mensagem = return-value.
    end. 


    run validateFields.
    
    find proc-siscomex 
         where proc-siscomex.cod-estabel = rowObject.cod-estabel
         and   proc-siscomex.nr-proc-exp = rowObject.nr-proc-exp
         and   proc-siscomex.nr-re       = rowObject.nr-re
         no-lock no-error.
    if avail proc-siscomex then do:
       assign i-seq-erro = i-seq-erro + 1.
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-liter.i Processo_Siscomex * R}
       run utp/ut-msgs.p (input "msg",
                          input 8,
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen     = i-seq-erro
              tt-bo-erro.cd-erro      = 8
              tt-bo-erro.mensagem     = return-value.
    end.
    
    /*run validateFields.*/
    find first tt-bo-erro
        no-lock no-error.
 
    if not avail tt-bo-erro then do:
       run executeCreate.
       assign r-chave = to-rowid(return-value).
    end.
 
    run endMethod ("validateCreate").
end procedure.
 
procedure deleteTable:

     def input parameter p-cod-estabel like historico-proc-exp.cod-estabel.
     def input parameter p-nr-proc-exp like historico-proc-exp.nr-proc-exp.
     
     def var r-rowid  as rowid no-undo.
     
     for each proc-siscomex exclusive-lock
         where proc-siscomex.cod-estabel = p-cod-estabel
         and   proc-siscomex.nr-proc-exp = p-nr-proc-exp:
         assign r-rowid = rowid(proc-siscomex).
         run validateDelete (input-output r-rowid, output table tt-bo-erro) .
     end.

end procedure. 
  
procedure getCharField:
    define input  parameter c-field as char.
    define output parameter c-value as char.
 
    case c-field:
        when "char-1" then c-value = RowObject.char-1.
        when "char-2" then c-value = RowObject.char-2.
        when "check-sum" then c-value = RowObject.check-sum.
        when "cod-estabel" then c-value = RowObject.cod-estabel.
        when "nr-ce" then c-value = RowObject.nr-ce.
        when "nr-proc-exp" then c-value = RowObject.nr-proc-exp.
        when "nr-rc" then c-value = RowObject.nr-rc.
        when "nr-re" then c-value = RowObject.nr-re.
        when "nr-res" then c-value = RowObject.nr-res.
        when "nr-rv" then c-value = RowObject.nr-rv.
        when "nr-sd" then c-value = RowObject.nr-sd.
        otherwise return error.
    end case.
end procedure.
 
procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.
 
    case c-field:
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        otherwise return error.
    end case.
end procedure.
 
procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.
 
    case c-field:
        when "cod-enquad-1" then c-value = RowObject.cod-enquad-1.
        when "cod-enquad-2" then c-value = RowObject.cod-enquad-2.
        when "cod-enquad-3" then c-value = RowObject.cod-enquad-3.
        when "cod-enquad-4" then c-value = RowObject.cod-enquad-4.
        when "cod-enquad-5" then c-value = RowObject.cod-enquad-5.
        when "cod-inst" then c-value = RowObject.cod-inst.
        when "cod-transac" then c-value = RowObject.cod-transac.
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.
        otherwise return error.
    end case.
end procedure.
 
procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.
 
    case c-field:
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.
        when "dt-ce" then c-value = RowObject.dt-ce.
        when "dt-rc" then c-value = RowObject.dt-rc.
        when "dt-re" then c-value = RowObject.dt-re.
        when "dt-res" then c-value = RowObject.dt-res.
        when "dt-rv" then c-value = RowObject.dt-rv.
        when "dt-sd" then c-value = RowObject.dt-sd.
        otherwise return error.
    end case.
end procedure.
 
procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.
 
    case c-field:
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.
        otherwise return error.
    end case.
end procedure.
 

Procedure retiraSimbolos.

  def input-output parameter c-inteiro-limpar as char.
  def var i-cont-dig as int.
  
  do i-cont-dig = 1 to length(c-inteiro-limpar):
    if i-cont-dig > 1 and
       (lookup(substr(c-inteiro-limpar,i-cont-dig,1),".,-,/") > 0 or 
               substr(c-inteiro-limpar,i-cont-dig,1) = ",")       then
       assign c-inteiro-limpar = substr(c-inteiro-limpar,1,i-cont-dig - 1) +
                                 substr(c-inteiro-limpar,i-cont-dig + 1)
              i-cont-dig = 1.
  end. /* do i-cont-dig ... */

end procedure.

procedure validaCampos:
  define input parameter  table for tt-proc-siscomex-aux.
  define output parameter table for tt-bo-erro.

  for each tt-bo-erro:
      delete tt-bo-erro.
  end.
  assign i-seq-erro = 0.

  find first tt-proc-siscomex-aux no-error.
  if avail tt-proc-siscomex-aux then do:
     find processo-exp
       where processo-exp.cod-estabel = tt-proc-siscomex-aux.cod-estabel
         and processo-exp.nr-proc-exp = tt-proc-siscomex-aux.nr-proc-exp no-lock no-error.
     if avail processo-exp then do:
        find itinerario where itinerario.cod-itiner = processo-exp.cod-itiner no-lock no-error.
        if avail itinerario then do:
           find pto-contr where
                pto-contr.cod-pto-contr = itinerario.pto-despacho no-lock no-error.
           if avail pto-contr then do:
               if pto-contr.unid-referencial = 0 then do: /*unidade referencial de despacho*/
                   assign i-seq-erro = i-seq-erro + 1.
                   /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                      pre-processador em chamada de includes */
                   {utp/ut-liter.i Unidade_Referencial_de_Despacho * L}
                   create tt-bo-erro.
                   assign tt-bo-erro.parametros = trim(return-value).
                   run utp/ut-msgs.p (input "msg",
                                      input 2,  /* NÆo encontrado(a) &1 para a chave informada*/
                                      input return-value).
                   assign tt-bo-erro.i-sequen = i-seq-erro
                          tt-bo-erro.cd-erro  = 2
                          tt-bo-erro.mensagem = trim(return-value).
                  {utp/ut-liter.i Verifique_se_existe_Unidade_Referencial_para_o_ponto_de_despacho_no_cadastro_de_pontos_de_controle_(cd2566) L}
                   assign tt-bo-erro.errorhelp = trim(return-value).
               end.
           end.     
           find pto-contr 
             where pto-contr.cod-pto-contr = itinerario.pto-embarque no-lock no-error.
           if avail pto-contr then do:
               if pto-contr.unid-referencial = 0 then do: /*unidade referencial de embarque*/
                   assign i-seq-erro = i-seq-erro + 1.
                   /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                      pre-processador em chamada de includes */
                   {utp/ut-liter.i Unidade_Referencial_de_Embarque * L}
                   create tt-bo-erro.
                   assign tt-bo-erro.parametros = trim(return-value).
                   run utp/ut-msgs.p (input "msg",
                                      input 2,  /* NÆo encontrado(a) &1 para a chave informada*/
                                      input trim(return-value)).
                   assign tt-bo-erro.i-sequen = i-seq-erro
                          tt-bo-erro.cd-erro  = 2
                          tt-bo-erro.mensagem = trim(return-value).
                   {utp/ut-liter.i Verifique_se_existe_Unidade_Referencial_para_o_ponto_de_embarque_no_cadastro_de_pontos_de_controle_(cd2566) L}
                   assign tt-bo-erro.errorhelp = trim(return-value).
               end.
           end.
              
        end. /*itinerario*/
      
        /*Pais Origem*/
        
        &if '{&BF_DIS_VERSAO_EMS}' >= '2.05' &then
            find first pais 
                 where int(pais.cod-pais-siscomex) = tt-proc-siscomex-aux.cod-pais-imptdor no-lock no-error.
        &ELSE
            find first pais 
                 where substring(pais.char-1,1,5) = trim(substring(tt-proc-siscomex-aux.char-1,3,5)) no-lock no-error.
        &endif
       
        if not avail pais or ( avail pais and 
            &if '{&bf_dis_versao_ems}' >= "2.05" &then
                 tt-proc-siscomex-aux.cod-pais-imptdor = 0)
            &else
                 trim(substring(tt-proc-siscomex-aux.char-1,3,5)) = "")
            &endif then do:
             assign i-seq-erro = i-seq-erro + 1.
             /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                pre-processador em chamada de includes */
             {utp/ut-liter.i Pa¡s_Origem * L}
             create tt-bo-erro.
             assign tt-bo-erro.parametros = trim(return-value).
             run utp/ut-msgs.p (input "msg",
                                input 2,  /* NÆo encontrado(a) &1 para a chave informada*/
                                input trim(return-value)).
             assign tt-bo-erro.i-sequen = i-seq-erro
                    tt-bo-erro.cd-erro  = 2
                    tt-bo-erro.mensagem = return-value.
        end.
      
        /*Pais Destino*/
        &if '{&BF_DIS_VERSAO_EMS}' >= '2.05' &then
            find first pais 
                  where int(pais.cod-pais-siscomex) = tt-proc-siscomex-aux.cod-pais-dest no-lock no-error.
        &ELSE
            find first pais 
                  where substring(pais.char-1,1,5) = trim(substring(tt-proc-siscomex-aux.char-1,8,5)) no-lock no-error.
        &endif

        if not avail pais or ( avail pais and 
            &if '{&bf_dis_versao_ems}' >= "2.05" &then
                 tt-proc-siscomex-aux.cod-pais-dest = 0)
            &else
                 trim(substring(tt-proc-siscomex-aux.char-1,8,5)) = "")
            &endif then do:
             assign i-seq-erro = i-seq-erro + 1.
             /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                pre-processador em chamada de includes */
             {utp/ut-liter.i Pa¡s_Destino_Final * L}
             create tt-bo-erro.
             assign tt-bo-erro.parametros = trim(return-value).
             run utp/ut-msgs.p (input "msg",
                                input 2,  /* NÆo encontrado(a) &1 para a chave informada*/
                                input trim(return-value)).
             assign tt-bo-erro.i-sequen = i-seq-erro
                    tt-bo-erro.cd-erro  = 2
                    tt-bo-erro.mensagem = return-value.
        end.
        find first proc-ped-venda 
             where proc-ped-venda.nr-proc-exp = processo-exp.nr-proc-exp
               and proc-ped-venda.cod-estabel = processo-exp.cod-estabel no-lock no-error.
        if avail proc-ped-venda then do:
            find ped-venda 
              where ped-venda.nome-abrev = proc-ped-venda.nome-abrev
                and ped-venda.nr-pedcli  = proc-ped-venda.nr-pedcli no-lock no-error.
            if avail ped-venda then do:
                find first moeda
                     where moeda.mo-codigo = ped-venda.mo-codigo no-lock no-error.
                if avail moeda then do:
                    if moeda.cod-decex = 0 then do:
                        assign i-seq-erro = i-seq-erro + 1.
                        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                           pre-processador em chamada de includes */
                        {utp/ut-liter.i Moeda_do_Siscomex * L}
                        create tt-bo-erro.
                        assign tt-bo-erro.parametros = trim(return-value).
                        run utp/ut-msgs.p (input "msg",
                                           input 2,  /* NÆo encontrado(a) &1 para a chave informada*/
                                           input trim(return-value)).
                        assign tt-bo-erro.i-sequen = i-seq-erro
                               tt-bo-erro.cd-erro  = 2
                               tt-bo-erro.mensagem = return-value.
                    end.
                end.
            end.
        end.
      end.
  end.

  return "OK":U.

end procedure.

procedure validaValores:

  define input  parameter pc-cod-estabel-ex0250 like estabelec.cod-estabel    no-undo.
  define input  parameter pc-nr-proc-exp-ex0250 like processo-exp.nr-proc-exp no-undo.
  define output parameter table for tt-bo-erro.
  
  &if defined(bf-dis-comex) &then
  &else
    &if "{&bf_dis_versao_ems}" >= "2.04" &then

      define variable i-cont as integer no-undo.
      define variable de-valor-fabricante like it-proc-siscomex.dec-2 no-undo.
      define variable de-valor-embarque   like it-proc-siscomex.dec-2 no-undo.
  
      define variable c-return1    as character no-undo.
      define variable c-return2    as character no-undo.
      define variable c-return3    as character no-undo.

      define buffer b-it-proc-siscomex for it-proc-siscomex.

      for each tt-bo-erro:
          delete tt-bo-erro.
      end.
      for each b-it-proc-siscomex 
         where b-it-proc-siscomex.cod-estabel      = pc-cod-estabel-ex0250
           and b-it-proc-siscomex.nr-proc-siscomex = pc-nr-proc-exp-ex0250
           and b-it-proc-siscomex.cod-fabrican[1] <> 0 no-lock:
           
              for each it-proc-siscomex
                 where it-proc-siscomex.cod-estabel      = b-it-proc-siscomex.cod-estabel
                   and it-proc-siscomex.nr-proc-siscomex = b-it-proc-siscomex.nr-proc-siscomex
                   and it-proc-siscomex.num-grp-item     = b-it-proc-siscomex.num-grp-item no-lock
                        break by it-proc-siscomex.num-grp-item :
                        
                    do i-cont = 1 to 10:
                       assign de-valor-fabricante = de-valor-fabricante + it-proc-siscomex.valor-fabrican[i-cont].
                    end.
                    assign de-valor-fabricante = round(de-valor-fabricante,2).
                    assign de-valor-embarque   = round(de-valor-embarque + it-proc-siscomex.dec-2,2).
                    
                    if last-of(it-proc-siscomex.num-grp-item) then do:
                       if de-valor-fabricante >= 0 and        /*Valor do fabricante*/
                          de-valor-embarque   >= 0 then do:   /*Valor no Embarque*/
                          if de-valor-fabricante <> de-valor-embarque then do:
                              assign i-seq-erro = i-seq-erro + 1.
                              assign c-return1 = string(it-proc-siscomex.num-grp-item).
                              {utp/ut-liter.i Valor_do_fabricante: L}
                              assign c-return2 = return-value + " " + string(de-valor-fabricante).
                              {utp/ut-liter.i Valor_no_local_de_embarque: L}
                              assign c-return3 = return-value + " " + string(de-valor-embarque).
                              create tt-bo-erro.
                              assign tt-bo-erro.parametros = c-return1 + "~~" + c-return2 + "~~" + c-return3.
                              run utp/ut-msgs.p(input "msg":U,
                                                input 31457,
                                                input tt-bo-erro.parametros).
                              assign tt-bo-erro.i-sequen = i-seq-erro
                                     tt-bo-erro.cd-erro  = 31457
                                     tt-bo-erro.mensagem = return-value.
                          end.
                       end.
                       assign de-valor-fabricante = 0           
                              de-valor-embarque   = 0.
                    end.
              end.
      end.
    &endif
  &endif
  
  return "OK":U.
end procedure.



