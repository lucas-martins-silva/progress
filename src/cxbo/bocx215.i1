procedure executeUpdate:

    /**  Executa Update*/
    if {&TABLE-NAME}.nr-re = "" then
       buffer-copy rowObject except cod-estabel nr-proc-exp r-rowid to {&TABLE-NAME}.
    else
       buffer-copy rowObject except cod-estabel nr-proc-exp nr-re r-rowid to {&TABLE-NAME}.

end procedure.
 

procedure executeDelete:

    /**  Executa Delete*/
    delete {&TABLE-NAME}.

end procedure.
 
procedure initializeValidate:
    /*
    **  Inicializa Validate
    */
 
    run startMethod ("initializeValidade").
    
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    assign i-seq-erro = 0.
 
    run endMethod   ("initializeValidade").

end procedure.

procedure findCh_ce:

    /**  procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.*/

    def input parameter c-nr-ce       like proc-siscomex.nr-ce no-undo.
    def input parameter c-cod-estabel like proc-siscomex.cod-estabel no-undo.
    def input parameter c-nr-proc-exp like proc-siscomex.nr-proc-exp no-undo.

    def output parameter table for RowObject.
 
    find first proc-siscomex 
         where proc-siscomex.nr-ce = c-nr-ce 
         and   proc-siscomex.cod-estabel = c-cod-estabel 
         and   proc-siscomex.nr-proc-exp = c-nr-proc-exp no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-liter.i Comprovante_Exporta‡Æo * R}
         run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
    end.
    else do:
       run setCurrent.
    end.

end procedure.

