DEFINE VAR c-cod-estabel like proc-siscomex.cod-estabel no-undo.
DEFINE VAR c-nr-proc-exp like proc-siscomex.nr-proc-exp no-undo.
DEFINE VAR c-nr-re       like proc-siscomex.nr-re       no-undo.

DEFINE VAR c-cod-estabel-ini like proc-siscomex.cod-estabel no-undo.
DEFINE VAR c-nr-proc-exp-ini like proc-siscomex.nr-proc-exp no-undo.
DEFINE VAR c-nr-re-ini       like proc-siscomex.nr-re       no-undo.
DEFINE VAR c-cod-estabel-fin like proc-siscomex.cod-estabel no-undo.
DEFINE VAR c-nr-proc-exp-fin like proc-siscomex.nr-proc-exp no-undo.
DEFINE VAR c-nr-re-fin       like proc-siscomex.nr-re       no-undo.

&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.001
&scoped-define FIRST-TABLE-IN-QUERY proc-siscomex
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME proc-siscomex

&IF INTEGER(ENTRY(1,PROVERSION,".")) >= 9 &THEN
   &GLOBAL-DEFINE v9indrep  INDEXED-REPOSITION
&endif
 
