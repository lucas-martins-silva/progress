DEFINE var c-cod-estabel    like proc-ped-venda.cod-estabel no-undo.
DEFINE var c-nr-proc-exp    like proc-ped-venda.nr-proc-exp no-undo. 
DEFINE var c-nr-pedido      like proc-ped-venda.nr-pedido   no-undo.
DEFINE VAR h-bocx195        as handle                       no-undo.
DEFINE VAR h-bocx195a       as handle                       no-undo.
DEFINE VAR h-bocx260        as handle                       no-undo.
DEFINE VAR h-bocx205        as handle                       no-undo.
define var l-recebe-bodi317efm04 as logical initial no no-undo.
define var l-not-achou-proc-ped-venda as logical initial no no-undo.

def var de-qtd-conver  as dec  no-undo.
def var c-unid-conver  as char no-undo.
def var c_mensagem_1   as char no-undo.
def var c_mensagem_2   as char no-undo.
def var c-return-msg   as char no-undo.
def var c-un-medida    as char no-undo.
define variable de-fator-conver as decimal no-undo.
&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.001
&scoped-define FIRST-TABLE-IN-QUERY proc-ped-venda
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME proc-ped-venda


