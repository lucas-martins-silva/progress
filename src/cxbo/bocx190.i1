&IF DEFINED(bf_comex206b-1) &THEN
def temp-table tt-proc-nota-fiscal no-undo like proc-nota-fiscal 
    field r-rowid as rowid .
def temp-table tt-proc-ped-venda no-undo like proc-ped-venda 
    field r-rowid as rowid .    
def temp-table tt-proc-ped-ent no-undo like proc-ped-ent 
    field r-rowid as rowid .   
def temp-table tt-proc-ped-ent-aux no-undo like proc-ped-ent 
    field r-rowid as rowid .      
def temp-table 
    tt-proc-desp-itiner no-undo like proc-desp-itiner .
def var c-notas as char no-undo. 
def temp-table tt-proc-ped-ent-filho no-undo like tt-proc-ped-ent.    
&ENDIF

def new global shared var p-relaciona-nota-embarque-ex0190 as log initial "no" no-undo.
def var pde-qt-proc-ext as decimal no-undo.
DEF TEMP-TABLE tt-embarque NO-UNDO
     FIELD cdd-embarq    LIKE embarque.cdd-embarq
     FIELD dt-embarque   AS DATE FORMAT "99/99/9999"
     FIELD identific     LIKE embarque.identific
     FIELD situacao      AS CHAR FORMAT "x(15)"
     FIELD tipo          AS char format "x(15)"
     field r-rowid       as rowid
     INDEX id IS PRIMARY cdd-embarq.

&if defined(bf_dis_proc_ent) &then
      /*&if '{&ems_dbtype}' = 'progress' &then */
          /* Include i-epc200.i: Definicao Temp-Table tt-epc */
          {include/i-epc200.i "bocx190"}
      /*&endif*/
&endif  

def buffer bf_nota_fiscal for nota-fiscal.
{include/boini.i}
 
DEFINE TEMP-TABLE tt-bo-erro-aux no-undo
                  field i-sequen as int
                  field cd-erro  as int
                  field mensagem as char format "x(255)"
                  field parametros as char format "x(255)" init ""
                  field errortype as char format "x(20)"
                  field errorhelp as char format "x(20)"
                  field errorsubtype as character.

def temp-table tt-bo-erro-aux1 no-undo like tt-bo-erro.

DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.
{cxbo/bocx190.i RowObject}
/*{cxbo/bocx190.i tt-proc-ped-venda}*/

{cxbo/bocx190.i tt-proc-ped-venda-aux}
    DEF VAR r-proc-ped-venda AS ROWID NO-UNDO.
    
&IF DEFINED (bf_comex206b-1) &THEN 
    DEF VAR h-bocx362 AS HANDLE NO-UNDO.
&ENDIF

DEF VAR h-exapi        AS HANDLE NO-UNDO.
DEF VAR h-bocx185      AS HANDLE NO-UNDO.
&IF "{&bf_dis_versao_ems}" >= "2.04" &THEN
    
    DEF VAR de-tot-peso    AS DEC    NO-UNDO.
    DEF VAR de-tot-val     AS DEC    NO-UNDO.
    DEF VAR de-tot-qt      AS DEC    NO-UNDO.
    DEF VAR de-tot-cub-ped AS DEC    NO-UNDO.
    DEF VAR de-tot-cub-ent AS DEC    NO-UNDO.

    DEF BUFFER b-ped-ent FOR ped-ent.

    DEFINE TEMP-TABLE tt-ped-ent no-undo like ped-ent
           USE-INDEX codigo
           field r-rowid    as rowid
           field log-select as logical init no.
&ENDIF


/*Convers∆o do valor do volume do item*/
FOR FIRST para-dis NO-LOCK:
   /*Unidade de Medida da Convers∆o 1 = Cent°metros 2 = Metros*/
   IF para-dis.int-1 = 1 THEN
      ASSIGN de-fator-conver = 0.000001.
   ELSE
      ASSIGN de-fator-conver = 1.
END.

procedure setConstraint1:

end.

PROCEDURE setConstraint2:
    
    def input parameter p-cod-estab like proc-ped-venda.cod-estabel no-undo. 
    def input parameter p-proc-exp  like proc-ped-venda.nr-proc-exp no-undo.
    def input parameter p-pedido    like proc-ped-venda.nr-pedido   no-undo.
    assign c-cod-estabel    = p-cod-estab 
           c-nr-proc-exp    = p-proc-exp
           c-nr-pedido      = p-pedido.

END PROCEDURE.


PROCEDURE setConstraint3:
    
    def input parameter r-chave as rowid no-undo.
    find processo-exp  no-lock
         where rowid(processo-exp) = r-chave no-error.
   
END PROCEDURE.

 
procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    assign i-bo-query = i-abertura.
    assign l-query = yes.    
    case i-abertura:
        
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock. 
     
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where proc-ped-venda.cod-estabel >= c-cod-estabel and ~     
                                                                  proc-ped-venda.nr-proc-exp >= c-nr-proc-exp and ~
                                                                  proc-ped-venda.nr-pedido   >= c-nr-pedido no-lock.
        when 3 then                                               
            open query {&QUERY-NAME} for each {&TABLE-NAME} of processo-exp no-lock
                                     by proc-ped-venda.cod-estabel
                                     by proc-ped-venda.nr-proc-exp
                                     by proc-ped-venda.nr-pedido.


    end case.
end procedure.
 
