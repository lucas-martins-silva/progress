{cdp/cdcfgmat.i} /* Definicao de pre-processadores */

&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.002
&scoped-define FIRST-TABLE-IN-QUERY item-doc-est-cex
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME item-doc-est-cex

{include/boini.i}
{cxbo/bocx100.i RowObject}

def var l-atualiza as logical no-undo.

DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

procedure setConstraint1:
end procedure. 

procedure setConstraint2:
    def input parameter r-chave as rowid no-undo.
 
    find item-doc-est where rowid(item-doc-est) = r-chave no-lock no-error.
end procedure. 

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.    
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock
                where {&TABLE-NAME}.serie-docto = item-doc-est.serie-docto and
                      &if defined(bf-mat-comex) &then                    
                          {&TABLE-NAME}.nro-docto = string(item-doc-est.nro-docto) and
                      &else                
                          {&TABLE-NAME}.nro-docto = item-doc-est.nro-docto and
                      &endif
                      {&TABLE-NAME}.cod-emitente = item-doc-est.cod-emitente and
                      {&TABLE-NAME}.nat-operacao = item-doc-est.nat-operacao and
                      {&TABLE-NAME}.sequencia = item-doc-est.sequencia.        
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.
 
{include/bostrmet.i}
{include/boendmet.i}
&if defined(bf-mat-comex) &then    
&else
    {include/bocomver.i}
    {include/bogetver.i}
&endif
{include/bonav.i}
{include/bofind.i}
{include/bosetcur.i}
{include/bogetcur.i}
{include/bosersen.i}
{include/boprebro.i}
{include/boexecre.i}
{include/boexedel.i}

procedure initializeValidate:
    /*
    **  Inicializa Validate
    */
     
    run startMethod ("initializeValidade").
 
    run endMethod   ("initializeValidade").
end procedure.

/* Utilizado para navegar nas despesas do item da nota - Magnus */
procedure findPrevItemNota:
    def input  parameter c-serie-docto       like item-doc-est-cex.serie-docto       no-undo.
    def input  parameter c-nro-docto         like item-doc-est-cex.nro-docto         no-undo.
    def input  parameter i-cod-emitente      like item-doc-est-cex.cod-emitente      no-undo.
    def input  parameter c-nat-operacao      like item-doc-est-cex.nat-operacao      no-undo.
    def input  parameter i-sequencia         like item-doc-est-cex.sequencia         no-undo.
    def output parameter c-return            as char                                 no-undo.   
    
    find prev {&TABLE-NAME} where
        {&TABLE-NAME}.serie-docto  = c-serie-docto and
        {&TABLE-NAME}.nro-docto    = c-nro-docto and
        {&TABLE-NAME}.cod-emitente = i-cod-emitente and
        {&TABLE-NAME}.nat-operacao = c-nat-operacao and
        {&TABLE-NAME}.sequencia    = i-sequencia no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        run utp/ut-msgs.p (input "msg",
                           input 7998,
                           input "").
        assign c-return = return-value.
    end.
    else run setCurrent.
end procedure.

/* Utilizado para navegar nas despesas do item da nota - Magnus */
procedure findNextItemNota:    
    def input  parameter c-serie-docto       like item-doc-est-cex.serie-docto       no-undo.
    def input  parameter c-nro-docto         like item-doc-est-cex.nro-docto         no-undo.
    def input  parameter i-cod-emitente      like item-doc-est-cex.cod-emitente      no-undo.
    def input  parameter c-nat-operacao      like item-doc-est-cex.nat-operacao      no-undo.
    def input  parameter i-sequencia         like item-doc-est-cex.sequencia         no-undo.
    def output parameter c-return            as char                                 no-undo.
    
    find next {&TABLE-NAME} where
        {&TABLE-NAME}.serie-docto  = c-serie-docto and
        {&TABLE-NAME}.nro-docto    = c-nro-docto and
        {&TABLE-NAME}.cod-emitente = i-cod-emitente and
        {&TABLE-NAME}.nat-operacao = c-nat-operacao and
        {&TABLE-NAME}.sequencia    = i-sequencia    
        no-lock no-error.        
    if not avail {&TABLE-NAME} then do:
        run utp/ut-msgs.p (input "msg",
                           input 7999,
                           input "").
        assign c-return = return-value.
    end.
    else run setCurrent.
end procedure.

procedure findCodigo:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    def input  parameter c-serie-docto       like item-doc-est-cex.serie-docto       no-undo.
    def input  parameter c-nro-docto         like item-doc-est-cex.nro-docto         no-undo.
    def input  parameter i-cod-emitente      like item-doc-est-cex.cod-emitente      no-undo.
    def input  parameter c-nat-operacao      like item-doc-est-cex.nat-operacao      no-undo.
    def input  parameter i-sequencia         like item-doc-est-cex.sequencia         no-undo.
    def input  parameter i-cod-emitente-desp like item-doc-est-cex.cod-emitente-desp no-undo.
    def input  parameter i-cod-desp          like item-doc-est-cex.cod-desp          no-undo.
    def output parameter c-return            as char                                 no-undo.
    
    run startMethod("find":U).
    
    {cdp/cd2503.i c-nat-operacao} /* Retira "." "-" do valor do campo */
 
    find {&TABLE-NAME} where
        {&TABLE-NAME}.serie-docto       = c-serie-docto and
        {&TABLE-NAME}.nro-docto         = c-nro-docto and
        {&TABLE-NAME}.cod-emitente      = i-cod-emitente and
        {&TABLE-NAME}.nat-operacao      = c-nat-operacao and
        {&TABLE-NAME}.sequencia         = i-sequencia and
        {&TABLE-NAME}.cod-emitente-desp = i-cod-emitente-desp and
        {&TABLE-NAME}.cod-desp          = i-cod-desp
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex item-doc-est-cex 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.                           
    end.
    else do:
       run setCurrent.
    end.
    run endMethod("find":U).
end procedure.

/* Utilizado para encontrar a primeira despesa do item da nota - Magnus */
procedure findFirstItemNota:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    
    def input  parameter c-serie-docto       like item-doc-est-cex.serie-docto       no-undo.
    def input  parameter c-nro-docto         like item-doc-est-cex.nro-docto         no-undo.
    def input  parameter i-cod-emitente      like item-doc-est-cex.cod-emitente      no-undo.
    def input  parameter c-nat-operacao      like item-doc-est-cex.nat-operacao      no-undo.
    def input  parameter i-sequencia         like item-doc-est-cex.sequencia         no-undo.
    def output parameter c-return            as char                                 no-undo.
    
    run startMethod("find":U).
    
    {cdp/cd2503.i c-nat-operacao} /* Retira "." "-" do valor do campo */ 
    
    find first {&TABLE-NAME} 
        where {&TABLE-NAME}.serie-docto  = c-serie-docto
          and {&TABLE-NAME}.nro-docto    = c-nro-docto
          and {&TABLE-NAME}.cod-emitente = i-cod-emitente
          and {&TABLE-NAME}.nat-operacao = c-nat-operacao
          and {&TABLE-NAME}.sequencia    = i-sequencia
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex item-doc-est-cex 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.                           
    end.
    else do:
       run setCurrent.
    end.
    run endMethod("find":U).
end procedure.

