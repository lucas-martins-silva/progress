          and {&TABLE-NAME}.nat-operacao = c-nat-operacao
          and {&TABLE-NAME}.sequencia    = i-sequencia
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex item-doc-est-cex 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.                           
    end.
    else do:
       run setCurrent.
    end.
    run endMethod("find":U).
end procedure.


procedure findDesp_imp:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    def input  parameter i-cod-desp like item-doc-est-cex.cod-desp no-undo.
    def output parameter c-return   as char                        no-undo.
 
    run startMethod("find":U).
    
    find {&TABLE-NAME} where
        {&TABLE-NAME}.cod-desp = i-cod-desp
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex item-doc-est-cex 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).                           
        assign c-return = return-value.                           
    end.
    else do:
       run setCurrent.
    end.
    run endMethod("find":U).    
end procedure.

procedure executeUpdate:
    /*
    **  Executa Update
    */
    buffer-copy RowObject except r-rowid serie-docto nro-docto cod-emitente nat-operacao sequencia cod-desp to {&TABLE-NAME}.
end procedure.
 
procedure validateUpdate:
    /*
    **  Valida Update
    */
    def input parameter table for RowObject.
    def input parameter r-chave as rowid no-undo.
    def output parameter table for tt-bo-erro.
    
    def var de-val-orig like item-doc-est-cex.val-desp no-undo.
 
    run startMethod ("validateUpdate").    
     
    run InitializeValidate.
 
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.    
 
    run validateFields.
    
    find first tt-bo-erro
        no-lock no-error.
    if not avail tt-bo-erro then do:
        if  r-chave <> ? then
            find {&TABLE-NAME} where
                rowid({&TABLE-NAME}) = r-chave
                exclusive-lock no-error no-wait.
        else
            find {&TABLE-NAME} where
                {&TABLE-NAME}.serie-docto       = RowObject.serie-docto and
                {&TABLE-NAME}.nro-docto         = RowObject.nro-docto and
                {&TABLE-NAME}.cod-emitente      = RowObject.cod-emitente and
                {&TABLE-NAME}.nat-operacao      = RowObject.nat-operacao and
                {&TABLE-NAME}.sequencia         = RowObject.sequencia and
                {&TABLE-NAME}.cod-emitente-desp = RowObject.cod-emitente-desp and
                {&TABLE-NAME}.cod-desp          = RowObject.cod-desp
                exclusive-lock no-error no-wait.
        if locked({&table-name}) then do:
            assign i-seq-erro = i-seq-erro + 1.    
            run utp/ut-msgs.p (input "msg",
	                        input 16096,
 			          input "").
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen = i-seq-erro
  	            tt-bo-erro.cd-erro  = 16096
 	            tt-bo-erro.mensagem = return-value.                
        end.
        else 
	     if avail {&table-name} then do:
	         assign de-val-orig = {&TABLE-NAME}.val-desp
	                r-chave     = rowid({&TABLE-NAME}).
                run executeUpdate.
                if not l-atualiza then
                    run imp/imapi005.p(input "mod":U,
                                       input r-chave,
                                       input de-val-orig).
            end.
    end.
    run startMethod ("validateUpdate").        
end procedure.

procedure validateUpdateDesp:
    /*
    **  Valida Update
    */
    def input parameter table for RowObject.
    def output parameter table for tt-bo-erro.    
 
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.    
 
    run validateFields.
    
end procedure.

procedure validateFields:
    /*
    **  Valida Fields
    */                             
    run startMethod ("validateFields").    
    
    find first RowObject no-error.
             
    if rowObject.val-desp = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex item-doc-est-cex val-desp 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.        
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end. 
    
    find moeda where moeda.mo-codigo = rowObject.mo-codigo no-lock no-error.
    if not avail moeda then do:
      assign i-seq-erro = i-seq-erro + 1.
      /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */      
      {utp/ut-field.i mgcex item-doc-est-cex mo-codigo 1}
      /******************************************/
      create tt-bo-erro.
      assign tt-bo-erro.parametros = return-value.
      run utp/ut-msgs.p (input "msg",
                         input 265,
                         input return-value).
      assign tt-bo-erro.i-sequen     = i-seq-erro
             tt-bo-erro.cd-erro      = 265
             tt-bo-erro.mensagem     = return-value.
    end.
    else do:
        if  rowObject.mo-codigo <> 0 then do:
            run findCotacao(input today,
                            input rowObject.mo-codigo).
            if not can-find(first tt-bo-erro) then
              run cdp/cd0812.p(input 0,
                               input rowObject.mo-codigo,
                               input rowObject.val-desp,
                               input today, 
                               output rowObject.cotacao).                        
      
        end.    
    end.
    run endMethod ("validateFields"). 
end procedure.

procedure validateDelete:
    /*
    **  Valida Delete
    */

    def input-output parameter r-chave as rowid.
    def output parameter table for tt-bo-erro.    
    
    run startMethod("validateDelete":U).
     
    run InitializeValidate.
    
    find {&TABLE-NAME} where
        rowid({&TABLE-NAME}) = r-chave
        exclusive-lock no-error.

    if avail {&TABLE-NAME} then do:
        run imp/imapi005.p ( input "del",
                             input r-chave,
                             input 0 ).        
        run executeDelete.
    end.                            
        
    /* Se for necessario a criacao de validacoes nesta procedure, criar uma include 
    conforme ja feito no validateUpdate para a mesma ser utilizada pelo browser 
    Manutencao de itens do documento */        
    
    if l-query then
        get next {&QUERY-NAME}
            no-lock no-wait.
    else
        find next {&TABLE-NAME}
            no-lock no-error.

    if not avail {&TABLE-NAME} then do:
       if l-query then
           get prev {&QUERY-NAME}
               no-lock no-wait.
       else
           find prev {&TABLE-NAME}
               no-lock no-error.
    end.
    assign r-chave = rowid({&TABLE-NAME}).
    return "".
    
    run endMethod("validateDelete":U).    
end procedure.

procedure validateCreate:
    /*
    **  Valida criacao da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.
    
    {cdp/cd4300.i3} /* include tratamento docum-est.char-1 */
    
    run startMethod("validateCreate":U).
 
    run initializeValidate.    
 
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    
    find first rowObject no-error.
    
    {rep/re1001a.i50}
    
    for first docum-est fields(cod-estabel char-1)
        where docum-est.serie-docto  = rowObject.serie-docto 
         &if defined(bf-mat-comex) &then
          and docum-est.nro-docto    = integer(rowObject.nro-docto)
         &else
          and docum-est.nro-docto    = rowObject.nro-docto
         &endif
          and docum-est.cod-emitente = rowObject.cod-emitente
          and docum-est.nat-operacao = rowObject.nat-operacao no-lock:
      &if defined(bf-mat-comex) &then 
        assign c-embarque = substring(docum-est.char-1,2,12).
      &else
        {cdp/cd4300.i4 "yes" docum-est.char-1}
        {rep/re1001a.i51 "yes"}
      &endif          
    end.
    
    if not avail docum-est then do:
        assign i-seq-erro = i-seq-erro + 1.
        {utp/ut-liter.i Documento * L}
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 2,
                           input tt-bo-erro.parametros).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 2
               tt-bo-erro.mensagem     = return-value.
        RETURN "NOK":U.                       
    end.    
    
    if c-embarque = "" then do:
        for first estabelec fields(pais)
            where estabelec.cod-estabel = docum-est.cod-estabel no-lock:
        end.
        
        for first emitente fields(natureza pais)
            where emitente.cod-emitente = rowObject.cod-emitente no-lock:
          &if defined(bf-mat-comex) &then
            if (emitente.natureza <> "E":U and emitente.natureza <> "T":U) then do:
          &else
            if (emitente.natureza <> 3 and emitente.natureza <> 4) then do:
          &endif
                assign i-seq-erro = i-seq-erro + 1.
                run utp/ut-msgs.p (input "msg":U,
                                   input 19156,
                                   input "").
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 19156
                       tt-bo-erro.mensagem     = return-value.
                RETURN "NOK":U.                   
            end.
            if emitente.pais = estabelec.pais then do:
                assign i-seq-erro = i-seq-erro + 1.
                run utp/ut-msgs.p (input "msg":U,
                                   input 27238,
                                   input "").
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 27238
                       tt-bo-erro.mensagem     = return-value.
                RETURN "NOK":U.
            end.
        end.
    end.
        
    {cxbo/bocx100.i1}        
    
    find first tt-bo-erro
        no-lock no-error. 
    if not avail tt-bo-erro then do:
        run executeCreate.
        assign r-chave = to-rowid(return-value).
        if not l-atualiza then
            run imp/imapi005.p (input "add":U,
                                input r-chave,
                                input 0).
    end.
    run endMethod("validateCreate":U). 
end procedure.

procedure validateCreateDesp:
    /*
    **  Valida criacao da tabela.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
 
    find first rowObject no-error.
        
    {cxbo/bocx100.i1}

end procedure.

procedure setValidate:
/*
** seta vari vel para indicar se o item esta sendo inclu¡do
*/
def input parameter p-atualiza as logical no-undo.

assign l-atualiza = p-atualiza.
end procedure.

procedure findCotacao:
/*
** Acha cotacao da moeda na data indicada.
*/
def input  parameter da-dt-atual as date format "99/99/9999"     no-undo.
def input  parameter i-mo-codigo like item-doc-est-cex.mo-codigo no-undo.

def var c-periodo like cotacao.ano-periodo no-undo.
         
assign c-periodo = string(year(da-dt-atual), "9999") + 
                   string(month(da-dt-atual), "99" ).

find cotacao where cotacao.mo-codigo = i-mo-codigo and
                   cotacao.ano-periodo = c-periodo no-lock no-error.
if not avail cotacao then do:
    assign i-seq-erro = i-seq-erro + 1.
    create tt-bo-erro.
    assign tt-bo-erro.parametros = string(i-mo-codigo) + "~~" + string(today).     
    run utp/ut-msgs.p (input "msg",
                       input 316,
                       input string(i-mo-codigo) + "~~" + string(today)).
    assign tt-bo-erro.i-sequen     = i-seq-erro
           tt-bo-erro.cd-erro      = 316
           tt-bo-erro.mensagem     = return-value.    
end.    
end procedure.

procedure deleteDespesasitem:
/*
** Elimina as despesas do item (item-doc-est) que esta sendo eliminado
*/
def input parameter p-rowid as rowid no-undo.
def output parameter table for tt-bo-erro.

find item-doc-est 
    where rowid(item-doc-est) = p-rowid 
    no-lock no-error.
    
for each item-doc-est-cex 
    where item-doc-est-cex.serie-docto  = item-doc-est.serie-docto
      &if defined(bf-mat-comex) &then
        and item-doc-est-cex.nro-docto    = string(item-doc-est.nro-docto)
      &else
        and item-doc-est-cex.nro-docto    = item-doc-est.nro-docto              
      &endif        
      and item-doc-est-cex.cod-emitente = item-doc-est.cod-emitente      
      and item-doc-est-cex.nat-operacao = item-doc-est.nat-operacao
      and item-doc-est-cex.sequencia    = item-doc-est.sequencia
      exclusive-lock:
    delete item-doc-est-cex.            
end.

end procedure.
 
procedure getCharField:
    define input  parameter c-field as char.
    define output parameter c-value as char.
 
    case c-field:
        when "serie-docto" then c-value = RowObject.serie-docto.
        when "nro-docto" then c-value = RowObject.nro-docto.
        when "nat-operacao" then c-value = RowObject.nat-operacao.
        when "char-1" then c-value = RowObject.char-1.
        when "char-2" then c-value = RowObject.char-2.
        when "check-sum" then c-value = RowObject.check-sum.
        otherwise return error.
    end case.
end procedure.

procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.
 
    case c-field:
        when "val-desp" then c-value = RowObject.val-desp.
        when "cotacao" then c-value = RowObject.cotacao.
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        otherwise return error.
    end case.
end procedure.

procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.
 
    case c-field:
        when "cod-emitente" then c-value = RowObject.cod-emitente.
        when "sequencia" then c-value = RowObject.sequencia.
        when "cod-emitente-desp" then c-value = RowObject.cod-emitente-desp.
        when "cod-desp" then c-value = RowObject.cod-desp.
        when "mo-codigo" then c-value = RowObject.mo-codigo.
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.        
        otherwise return error.
    end case.
end procedure.
 
procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.
 
    case c-field:
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.        
        otherwise return error.
    end case.
end procedure.

procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.
 
    case c-field:
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.        
        otherwise return error.
    end case.
end procedure.
