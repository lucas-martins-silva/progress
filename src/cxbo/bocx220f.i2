/* Criada em 25/05/2004 - Eliza F.C.                    */
/* Include para tratar re-planejamento das parcelas no 
   MRP, conforme atividade 116178                       */

def var h-bocx150 as handle  no-undo.
def var l-acomp   as logical no-undo.

find first prazo-compra 
     where prazo-compra.numero-ordem = ordens-embarque.numero-ordem 
       and prazo-compra.parcela      = ordens-embarque.parcela exclusive-lock no-error.
if avail prazo-compra then        
      assign prazo-compra.int-2 = 2. /* Parcela fixada (n∆o ser† re-planejada) */





