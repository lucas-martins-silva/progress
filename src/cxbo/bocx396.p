&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/
    
    IF pType = "Create" THEN DO:
        IF CAN-FIND (FIRST decla-import-proc
                     WHERE decla-import-proc.num-di-ems        = RowObject.num-di-ems
                     AND   decla-import-proc.cod-proces-vincul = RowObject.cod-proces-vincul
                     AND   decla-import-proc.cdd-siscomex-dts  = RowObject.cdd-siscomex-dts) THEN
            /* Inicio -- Projeto Internacional */
            DO:
            DEFINE VARIABLE c-lbl-liter-processo-vinculado AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Processo_Vinculado" *}
            ASSIGN c-lbl-liter-processo-vinculado = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                  &ErrorNumber="1"
                  &ErrorType="EMS"
                  &ErrorParameters="c-lbl-liter-processo-vinculado"}
            END. 
                  
        IF RowObject.idi-tip-proces-vincul > 4 OR  
            RowObject.idi-tip-proces-vincul < 1 THEN
            /* Inicio -- Projeto Internacional */
            DO:
            DEFINE VARIABLE c-lbl-liter-favor-informar-um-tipo-valido AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Favor_informar_um_tipo_v†lido_(1_a_4)" *}
            ASSIGN c-lbl-liter-favor-informar-um-tipo-valido = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                  &ErrorNumber="17006"
                  &ErrorType="EMS"
                  &ErrorParameters="c-lbl-liter-favor-informar-um-tipo-valido + '.'"}
            END. 
    END.


    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

