&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE setConstraintCodigo DBOProgram 
PROCEDURE setConstraintCodigo :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER p-idi-naladi     AS INT NO-UNDO.
    DEFINE INPUT PARAMETER p-cdn-naladi-ini LIKE naladi.cdn-naladi NO-UNDO.
    DEFINE INPUT PARAMETER p-cdn-naladi-fim LIKE naladi.cdn-naladi NO-UNDO.

    ASSIGN i-cdn-naladi-ini = p-cdn-naladi-ini
           i-cdn-naladi-fim = p-cdn-naladi-fim
           i-idi-naladi     = p-idi-naladi.

    RETURN "OK":U.
END PROCEDURE.

