&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice naladi-id
  Parameters:  
               recebe valor do campo idi-naladi
               recebe valor do campo cdn-naladi
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pidi-naladi LIKE naladi.idi-naladi NO-UNDO.
    DEFINE INPUT PARAMETER pcdn-naladi LIKE naladi.cdn-naladi NO-UNDO.

    FIND FIRST bfnaladi WHERE 
        bfnaladi.idi-naladi = pidi-naladi AND 
        bfnaladi.cdn-naladi = pcdn-naladi NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfnaladi THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfnaladi)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryCodigo DBOProgram 
PROCEDURE openQueryCodigo :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH naladi WHERE
                            naladi.idi-naladi = i-idi-naladi AND
                            naladi.cdn-naladi >= i-cdn-naladi-ini AND
                            naladi.cdn-naladi <= i-cdn-naladi-fim
                            NO-LOCK INDEXED-REPOSITION.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

