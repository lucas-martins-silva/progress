procedure setEmitente:
/* 
** Seta se o emitente ‚ cliente ou fornecedor para a visualiza‡Æo.
*/
def input parameter p-identific like emitente.identific no-undo.

&if defined(bf-mat-comex) &then                                    
    assign c-identific = p-identific.
&else
    assign i-identific = p-identific.
&endif    
end procedure.

procedure identEmitente:

    def input param p-fornecedor as log no-undo.
    assign l-fornecedor = p-fornecedor.
    
    return "OK":U.
        
end procedure.

procedure findFirst:
    def var i-nav as integer no-undo.
    find first {&TABLE-NAME} 
        no-lock no-error.
        
    do while i-nav <> 1:         
        &if defined(bf-mat-comex) &then                                    
            find emitente where 
                emitente.cod-emitente = {&TABLE-NAME}.cod-emitente and
                (emitente.identific = "A" or emitente.identific = c-identific) no-lock no-error.
        &else
            find emitente where 
                emitente.cod-emitente = {&TABLE-NAME}.cod-emitente and
                (emitente.identific = 3 or emitente.identific = i-identific) no-lock no-error.        
        &endif                
        if not avail emitente then do:
            find next {&TABLE-NAME}
                no-lock no-error.
            if not avail {&TABLE-NAME} then
                assign i-nav = 1.
        end.
        else
            assign i-nav = 1.
    end.
    run setCurrent.    
end procedure.

procedure findPrev:
    def output parameter c-return as char.
    def var i-nav as integer no-undo.
 
    find prev {&TABLE-NAME}
       no-lock no-error.
       
    do while i-nav <> 1:         
        &if defined(bf-mat-comex) &then                                    
            find emitente where 
                emitente.cod-emitente = {&TABLE-NAME}.cod-emitente and
                (emitente.identific = "A" or emitente.identific = c-identific) no-lock no-error.
        &else
            find emitente where 
                emitente.cod-emitente = {&TABLE-NAME}.cod-emitente and
                (emitente.identific = 3 or emitente.identific = i-identific) no-lock no-error.        
        &endif                       
        if not avail emitente then do:
            find prev {&TABLE-NAME}
                no-lock no-error.
            if not avail {&TABLE-NAME} then
                assign i-nav = 1.
        end.
        else
            assign i-nav = 1.
    end.
       
    if not avail {&TABLE-NAME} then do:
        run utp/ut-msgs.p (input "msg",
                           input 7998,
                           input "").
        assign c-return = return-value.
    end.
    else run setCurrent.
end procedure.
procedure findNext:
    def output parameter c-return as char.
    def var i-nav as integer no-undo.

    find next {&TABLE-NAME}
        no-lock no-error.

    do while i-nav <> 1:         
        &if defined(bf-mat-comex) &then                                        
            find emitente where 
                emitente.cod-emitente = {&TABLE-NAME}.cod-emitente and
                (emitente.identific = "A" or emitente.identific = c-identific) no-lock no-error.
        &else
            find emitente where 
            emitente.cod-emitente = {&TABLE-NAME}.cod-emitente and
            (emitente.identific = 3 or emitente.identific = i-identific) no-lock no-error.        
        &endif                               
        if not avail emitente then do:
            find next {&TABLE-NAME}
                no-lock no-error.
            if not avail {&TABLE-NAME} then
                assign i-nav = 1.
        end.
        else
            assign i-nav = 1.
    end.
            
    if not avail {&TABLE-NAME} then do:
        run utp/ut-msgs.p (input "msg",
                           input 7999,
                           input "").
        assign c-return = return-value.
    end.
    else run setCurrent.
end procedure.
procedure findLast:
    def var i-nav as integer no-undo.
    find last {&TABLE-NAME}
        no-lock no-error.
        
    do while i-nav <> 1:         
        &if defined(bf-mat-comex) &then                                        
            find emitente where 
                emitente.cod-emitente = {&TABLE-NAME}.cod-emitente and
                (emitente.identific = "A" or emitente.identific = c-identific) no-lock no-error.
        &else
            find emitente where 
                emitente.cod-emitente = {&TABLE-NAME}.cod-emitente and
                (emitente.identific = 3 or emitente.identific = i-identific) no-lock no-error.        
        &endif                        
        if not avail emitente then do:
            find prev {&TABLE-NAME}
                no-lock no-error.
            if not avail {&TABLE-NAME} then
                assign i-nav = 1.
        end.
        else
            assign i-nav = 1.
    end.        
    run setCurrent.
end procedure.

procedure getRowid:
    def output parameter r-chave as rowid no-undo.
    if avail {&TABLE-NAME} then do:
        assign r-chave = rowid({&TABLE-NAME}).
    end.
    else do:
       assign r-chave = ?.
    end.
end procedure.


procedure initializeValidate:
    /*
    **  Inicializa Validate
    */
    run startMethod ("initializeValidade").
 
    run endMethod   ("initializeValidade").
end procedure.

procedure findPk-emitente:
    
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    def input parameter i-cod-emitente as inte no-undo.
    def output parameter c-return as char no-undo.
               
    run startMethod("find":U).
 
    find {&TABLE-NAME} where {&TABLE-NAME}.cod-emitente = i-cod-emitente no-lock no-error.
    if not avail {&TABLE-NAME} then do:
       {utp/ut-table.i mgcex emitente-cex 1}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.                            
    end.
    else do:
        run setCurrent.
    end.
    run endMethod("find":U).
end procedure.

procedure findEmitentecexbyNomeAbrev:
    
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    def input parameter c-nome-abrev LIKE emitente.nome-abrev no-undo.
    def output parameter c-return as char no-undo.
               
    run startMethod("find":U).

    FOR FIRST emitente FIELDS (cod-emitente)
        WHERE emitente.nome-abrev = c-nome-abrev NO-LOCK:
    END.

    IF AVAIL emitente THEN
        find {&TABLE-NAME} where {&TABLE-NAME}.cod-emitente = emitente.cod-emitente no-lock no-error.
    if not avail {&TABLE-NAME} then do:
       {utp/ut-table.i mgcex emitente-cex 1}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.                            
    end.
    else do:
        run setCurrent.
    end.

    run endMethod("find":U).
end procedure.

procedure beforevalidateCreate:
    /* 
    ** Recebe parametro para a validacao da existencia do emitente ou nao. Quando      
    ** a criacao e atraves dos folder nos Cadastros de Clientes/Fornecedores, nao ha
    ** validacao no validateCreate.
    */
    def input parameter p-create-folder as logical init no no-undo.
    
    assign l-create-folder = p-create-folder.   
end procedure.

procedure validateCreate:
    
    /*
    **  Valida cria‡Æo da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.

    run startMethod("validateCreate":U).

    IF NOT VALID-HANDLE(h-eai-emit) AND v_log_eai_habilit then
        RUN adapters/xml/fi2/axsfi001.p PERSISTENT SET h-eai-emit (OUTPUT TABLE tt_log_erro).
    run initializeValidate.

    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
 
    find first rowObject no-lock no-error.
    
    if not l-create-folder then do:
        find emitente where emitente.cod-emitente = rowObject.cod-emitente no-lock no-error.
        if not avail emitente then do:
            create tt-bo-erro.
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-field.i mgcex emitente-cex cod-emitente 1}
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.        
    end.

    run validateFields.

    if not can-find(tt-bo-erro) then do:
        find emitente-cex where emitente-cex.cod-emitente = RowObject.cod-emitente no-lock no-error.
        if avail emitente-cex then do:
            create tt-bo-erro.
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-table.i mgcex emitente-cex 1}
            run utp/ut-msgs.p (input "msg",
                               input 8,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 8
                   tt-bo-erro.mensagem     = return-value.
        end.
    end.

    if l-create-folder = no then do:
        find first emitente where emitente.cod-emitente = RowObject.cod-emitente no-lock no-error.
        if avail emitente then do:
/*        &if defined(bf-mat-comex) &then                                    
 *            if emitente.natureza = "F" or emitente.natureza = "J" then do:
 *         &else
 *            if emitente.natureza = 1 or emitente.natureza = 2 then do:
 *          &endif    
 *                 assign i-seq-erro = i-seq-erro + 1.
 *                 {utp/ut-table.i mgcex emitente-cex 1}
 *                 run utp/ut-msgs.p (input "msg",
 *                                    input 19156,
 *                                    input return-value).
 *                 create tt-bo-erro.
 *                 assign tt-bo-erro.i-sequen     = i-seq-erro
 *                        tt-bo-erro.cd-erro      = 19156
 *                        tt-bo-erro.mensagem     = return-value.
 *            end.*/
           &if defined(bf-mat-comex) &then                                    
              if emitente.identific <> "A" and emitente.identific <> c-identific then do:
                 if c-identific = "C" then do: 
           &else
              if emitente.identific <> 3 and emitente.identific <> i-identific then do:
                 if i-identific = 1 then do:
           &endif    
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-table.i mgcex emitente-cex 1}
                    run utp/ut-msgs.p (input "msg",
                                       input 6249,
                                       input return-value).
                    create tt-bo-erro.
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 6249
                           tt-bo-erro.mensagem     = return-value.
                 end.
            &if defined(bf-mat-comex) &then                                    
                 if c-identific = "F" then do: 
            &else
                 if i-identific = 2 then do:
            &endif    
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-table.i mgcex emitente-cex 1}
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-emitente AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Emitente" *}
                    ASSIGN c-lbl-liter-emitente = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-fornecedor AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Fornecedor" *}
                    ASSIGN c-lbl-liter-fornecedor = TRIM(RETURN-VALUE).
                    run utp/ut-msgs.p (input "msg",
                                       input 17195,
                                       input c-lbl-liter-emitente + "~~" + c-lbl-liter-fornecedor).
                    create tt-bo-erro.
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 17195
                           tt-bo-erro.mensagem     = return-value.
                 end.
              end.
                          
        end.       
    end.  
    if not can-find (first tt-bo-erro) then 
     /*  Integracao EAI  */
     &IF '{&bf_dis_versao_ems}' >= "2.04":U &THEN 
       IF v_log_eai_habilit THEN
        if valid-handle (h-eai-emit) then do:
           find emitente where 
                emitente.cod-emitente = RowObject.cod-emitente no-lock no-error.
           run PITransUpsert IN h-eai-emit (input rowid(emitente),
                                            input "add":U,
                                            output table tt_log_erro).
           for each tt_log_erro where tt_log_erro.ttv_num_cod_erro <> 60:
               assign i-seq-erro = i-seq-erro + 1.
               create tt-bo-erro.
               run utp/ut-msgs.p (input "msg",
                                  input ttv_num_cod_erro,
                                  input ttv_des_msg_erro).
               assign tt-bo-erro.i-sequen  = i-seq-erro
                      tt-bo-erro.cd-erro   = ttv_num_cod_erro
                      tt-bo-erro.mensagem  = ttv_des_msg_erro
                      tt-bo-erro.errorhelp = ttv_des_msg_erro.
           end.
        end.
     &ENDIF
    
    find first tt-bo-erro no-lock no-error. 
    if not avail tt-bo-erro then do:
        run executeCreate.
        assign r-chave = to-rowid(return-value).
    end.
	
	if valid-handle(h-eai-emit) then do:
		delete procedure h-eai-emit.
                assign h-eai-emit = ?.
        end.                
		
    run endMethod("validateCreate").    
end procedure.

procedure validaEmitente:

    def input param p-identEmitente as log no-undo.
    
    assign l-identEmitente = p-identEmitente.
    
    return "OK":U.
        
end procedure.

procedure validateFields:
    
    find first rowObject no-lock no-error.

    &if "{&bf_comex206b-1}" >= "2.062" &then
        run validateFieldsProgram.
    &else
    if rowObject.cod-repres <> 0 then do:
        find repres where repres.cod-rep = rowObject.cod-repres no-lock no-error.
        if not avail repres then do:
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Representante * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).

            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
        /****
        else do:
            find emitente where emitente.cod-emitente = rowObject.cod-repres no-lock no-error.            
            if avail emitente then do:
                {cdp/cd2502.i}
            end.
        end.
        ***/
    end.        

    &if "{&bf_mat_versao_ems}":U >= "2.062":U &then
    /* Valida Corretor de Cambio */
    if  rowObject.cdn-corretor-cambio-import > 0 then do:

        if  not can-find (first  emitente
                           where emitente.cod-emitente = rowObject.cdn-corretor-cambio-import) then do:

            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Corretor_de_Cƒmbio * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).

            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
    end.

    /* Valida Despachante */
    if  rowObject.cdn-despa-import > 0 then do:         

        if  not can-find (first  emitente
                           where emitente.cod-emitente = rowObject.cdn-despa-import) then do:

            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Despachante * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).

            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
    end.

    /* Valida Despachante no Exterior */
    if  rowObject.cdn-despa-exter-import > 0 then do:

        if  not can-find (first  emitente
                           where emitente.cod-emitente = rowObject.cdn-despa-exter-import) then do:

            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Despachante_no_Exterior * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).

            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
    end.

    /* Valida Seguradora*/
    if  rowObject.cdn-segurad-import > 0 then do:

        if  not can-find (first  emitente
                           where emitente.cod-emitente = rowObject.cdn-segurad-import) then do:

            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Seguradora * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).

            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
    end.

    /* Valida Corretor*/
    if  rowObject.cdn-corretor-import > 0 then do:

        if  not can-find (first  emitente
                           where emitente.cod-emitente = rowObject.cdn-corretor-import) then do:

            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Corretor_Seguro * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).

            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
    end.
         &IF "{&BF_cex_VERSAO_EMS}" >= "2.062" &THEN
             /* Valida Moeda*/
             if  not can-find (first  moeda
                                   where moeda.mo-codigo = rowObject.mo-codigo) then do:
         
                     assign i-seq-erro = i-seq-erro + 1.
                     {utp/ut-liter.i Moeda * L}
                     create tt-bo-erro.
                     assign tt-bo-erro.parametros = return-value.
                     run utp/ut-msgs.p (input "msg",
                                        input 2,
                                        input return-value).
             
                     assign tt-bo-erro.i-sequen = i-seq-erro
                            tt-bo-erro.cd-erro  = 2
                            tt-bo-erro.mensagem = return-value.                               
             end.
         &ENDIF
      
    
         if  rowObject.des-layout-origin-ped-cambio <> "" then do:
        
             assign file-info:file-name = rowObject.des-layout-origin-ped-cambio.
        
             if  file-info:pathname = ? 
             or  search(rowObject.des-layout-origin-ped-cambio) <> ? then do:
        
                 assign i-seq-erro = i-seq-erro + 1.
                 run utp/ut-msgs.p (input "msg",
                                    input 4715,
                                    input rowObject.des-layout-origin-ped-cambio).                               
                 create tt-bo-erro.                                   
                 assign tt-bo-erro.i-sequen = i-seq-erro
                        tt-bo-erro.cd-erro  = 4715
                        tt-bo-erro.mensagem = return-value
                        tt-bo-erro.parametros = file-info:file-name.
             end. 
         end.
         
         if  rowObject.des-layout-origin-instruc-embarq <> "" then do:
        
                 assign file-info:file-name = rowObject.des-layout-origin-instruc-embarq.
        
                 if  file-info:pathname = ? 
                 or  search(rowObject.des-layout-origin-instruc-embarq) <> ? then do:
        
                     assign i-seq-erro = i-seq-erro + 1.
                     run utp/ut-msgs.p (input "msg",
                                        input 4715,
                                        input rowObject.des-layout-origin-instruc-embarq).                               
                     create tt-bo-erro.                                   
                     assign tt-bo-erro.i-sequen = i-seq-erro
                            tt-bo-erro.cd-erro  = 4715
                            tt-bo-erro.mensagem = return-value
                            tt-bo-erro.parametros = file-info:file-name.
                 end. 
         end.
        
         if  rowObject.des-layout-origin-pch-order <> "" then do:
        
             assign file-info:file-name = rowObject.des-layout-origin-pch-order.
        
             if  file-info:pathname = ? 
             or  search(rowObject.des-layout-origin-pch-order) <> ? then do:
        
                 assign i-seq-erro = i-seq-erro + 1.
                 run utp/ut-msgs.p (input "msg",
                                    input 4715,
                                    input rowObject.des-layout-origin-pch-order).                               
                 create tt-bo-erro.                                   
                 assign tt-bo-erro.i-sequen = i-seq-erro
                        tt-bo-erro.cd-erro  = 4715
                        tt-bo-erro.mensagem = return-value
                        tt-bo-erro.parametros = file-info:file-name.
             end. 
         end.
    &endif
        
    if  rowObject.cod-itiner-imp <> 0 then
        if not can-find(itinerario where itinerario.cod-itiner = rowObject.cod-itiner-imp) then do:        
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-field.i mgcex emitente-cex cod-itiner-imp 1}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).
                               
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
        
    if rowObject.cod-itiner-exp <> 0 then
        if not can-find(itinerario where itinerario.cod-itiner = rowObject.cod-itiner-exp) then do:        
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-field.i mgcex emitente-cex cod-itiner-exp 1}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
        
    if rowObject.cod-incoterm-imp <> "" then
        if not can-find(inco-cx where inco-cx.cod-incoterm = rowObject.cod-incoterm-imp) then do:        
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-field.i mgcex emitente-cex cod-incoterm-imp 1}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
        
    if rowObject.cod-incoterm-exp <> "" then
        if not can-find(inco-cx where inco-cx.cod-incoterm = rowObject.cod-incoterm-exp) then do:        
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-field.i mgcex emitente-cex cod-incoterm-exp 1}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
        
    if rowObject.cod-idioma <> "" then 
        &if defined(bf-mat-comex) &then                                        
            if not can-find(idioma where idioma.id-codigo = rowObject.cod-idioma) then do:
                assign i-seq-erro = i-seq-erro + 1.
                run utp/ut-msgs.p (input "msg",
                                   input 4774,
                                   input return-value).
                create tt-bo-erro.                                   
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 4774
                       tt-bo-erro.mensagem = return-value.                               
            end.        
    
        &else
            if not can-find(idioma where idioma.cod_idioma = rowObject.cod-idioma) then do:
                assign i-seq-erro = i-seq-erro + 1.
                run utp/ut-msgs.p (input "msg",
                                   input 4774,
                                   input return-value).
                create tt-bo-erro.                                   
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 4774
                       tt-bo-erro.mensagem = return-value.                               
            end.                
        &endif
    /*Valida‡Æo do Ponto de Controle Base*/
    &if "{&bf_dis_versao_ems}" >= "2.05" &then
        if rowObject.cod-itiner-imp <> 0 and 
           rowObject.cod-pto-contr <> 0 or
           rowObject.cod-itiner-imp = 0 and 
           rowObject.cod-pto-contr <> 0 then do:
           
           /*Valida‡Æo da existˆncia do ponto de controle */
           if not valid-handle (h-bocx110) then
               run cxbo/bocx110.p persistent set h-bocx110.
           run findCodigo in h-bocx110 (input rowObject.cod-pto-contr,
                                        output c-return). 
           if valid-handle (h-bocx110) then do:
               delete procedure h-bocx110.                             
               assign h-bocx110 = ?.
           end.
           if  c-return <> "" then do:
           
               {utp/ut-table.i mgcex pto-contr 1}

               create tt-bo-erro.
               assign tt-bo-erro.parametros = return-value.

               run utp/ut-msgs.p (input "msg",
                                  input 2,
                                  input return-value).                   
                              
               assign tt-bo-erro.i-sequen     = i-seq-erro
                      tt-bo-erro.cd-erro      = 2
                      tt-bo-erro.mensagem     = return-value.                                 
           end.                             
           if l-fornecedor then do:
              /*Valida se o ponto de controle est  vinculado ao itiner rio */
              if not can-find(pto-itiner where pto-itiner.cod-itiner = rowObject.cod-itiner-imp and
                                               pto-itiner.cod-pto-contr = rowObject.cod-pto-contr) then do:
                   assign i-seq-erro = i-seq-erro + 1.
                   /* Inicio -- Projeto Internacional */
                   DEFINE VARIABLE c-lbl-liter-ponto-de-controle-base AS CHARACTER NO-UNDO.
                   {utp/ut-liter.i "Ponto_de_controle_base" *}
                   ASSIGN c-lbl-liter-ponto-de-controle-base = TRIM(RETURN-VALUE).
                   DEFINE VARIABLE c-lbl-liter-itinerario AS CHARACTER NO-UNDO.
                   {utp/ut-liter.i "itiner rio" *}
                   ASSIGN c-lbl-liter-itinerario = TRIM(RETURN-VALUE).
                   run utp/ut-msgs.p (input "msg",
                                      input 19519,
                                      input c-lbl-liter-ponto-de-controle-base + "~~" + c-lbl-liter-itinerario).
                   create tt-bo-erro.                                   
                   /* Inicio -- Projeto Internacional */
                   DEFINE VARIABLE c-lbl-liter AS CHARACTER NO-UNDO.
                   ASSIGN c-lbl-liter = TRIM(RETURN-VALUE).
                   DEFINE VARIABLE c-lbl-liter-ponto-de-controle-base-2 AS CHARACTER NO-UNDO.
                   {utp/ut-liter.i "Ponto_de_controle_base" *}
                   ASSIGN c-lbl-liter-ponto-de-controle-base-2 = TRIM(RETURN-VALUE).
                   DEFINE VARIABLE c-lbl-liter-itinerario-2 AS CHARACTER NO-UNDO.
                   {utp/ut-liter.i "itiner rio" *}
                   ASSIGN c-lbl-liter-itinerario-2 = TRIM(RETURN-VALUE).
                   assign tt-bo-erro.i-sequen = i-seq-erro
                          tt-bo-erro.cd-erro  = 19519
                          tt-bo-erro.mensagem = c-lbl-liter
                          tt-bo-erro.parametros = c-lbl-liter-ponto-de-controle-base-2 + "~~" + c-lbl-liter-itinerario-2.
              end.    
           end.
        end.    
    &else
        if rowObject.cod-itiner-imp <> 0 and 
           int(substr(rowObject.char-1,11,6)) <> 0 or
           rowObject.cod-itiner-imp = 0 and 
           int(substr(rowObject.char-1,11,6)) <> 0 then do:
           
           /*Valida‡Æo da existˆncia do ponto de controle */
           if not valid-handle (h-bocx110) then
               run cxbo/bocx110.p persistent set h-bocx110.
           run findCodigo in h-bocx110 (input int(substr(rowObject.char-1,11,6)),
                                        output c-return). 
           if valid-handle (h-bocx110) then do:
               delete procedure h-bocx110.                              
               assign h-bocx110 = ?.
           end.
           if  c-return <> "" then do:
           
               {utp/ut-table.i mgcex pto-contr 1}

               create tt-bo-erro.
               assign tt-bo-erro.parametros = return-value.

               run utp/ut-msgs.p (input "msg",
                                  input 2,
                                  input return-value).                   
                              
               assign tt-bo-erro.i-sequen     = i-seq-erro
                      tt-bo-erro.cd-erro      = 2
                      tt-bo-erro.mensagem     = return-value.                                 
           end.       
           if l-fornecedor then do:
               /*Valida se o ponto de controle est  vinculado ao itiner rio */
               if not can-find(pto-itiner where pto-itiner.cod-itiner = rowObject.cod-itiner-imp and
                                                pto-itiner.cod-pto-contr = int(substr(rowObject.char-1,11,6))) then do:
                                                            
                   assign i-seq-erro = i-seq-erro + 1.
                   /* Inicio -- Projeto Internacional */
                   DEFINE VARIABLE c-lbl-liter-ponto-de-controle-base-3 AS CHARACTER NO-UNDO.
                   {utp/ut-liter.i "Ponto_de_controle_base" *}
                   ASSIGN c-lbl-liter-ponto-de-controle-base-3 = TRIM(RETURN-VALUE).
                   DEFINE VARIABLE c-lbl-liter-itinerario-3 AS CHARACTER NO-UNDO.
                   {utp/ut-liter.i "itiner rio" *}
                   ASSIGN c-lbl-liter-itinerario-3 = TRIM(RETURN-VALUE).
                   run utp/ut-msgs.p (input "msg",
                                      input 19519,
                                      input c-lbl-liter-ponto-de-controle-base-3 + "~~" + c-lbl-liter-itinerario-3).
                   create tt-bo-erro.                                   
                   /* Inicio -- Projeto Internacional */
                   DEFINE VARIABLE c-lbl-liter-2 AS CHARACTER NO-UNDO.
                   ASSIGN c-lbl-liter-2 = TRIM(RETURN-VALUE).
                   DEFINE VARIABLE c-lbl-liter-ponto-de-controle-base-4 AS CHARACTER NO-UNDO.
                   {utp/ut-liter.i "Ponto_de_controle_base" *}
                   ASSIGN c-lbl-liter-ponto-de-controle-base-4 = TRIM(RETURN-VALUE).
                   DEFINE VARIABLE c-lbl-liter-itinerario-4 AS CHARACTER NO-UNDO.
                   {utp/ut-liter.i "itiner rio" *}
                   ASSIGN c-lbl-liter-itinerario-4 = TRIM(RETURN-VALUE).
                   assign tt-bo-erro.i-sequen = i-seq-erro
                          tt-bo-erro.cd-erro  = 19519
                          tt-bo-erro.mensagem = c-lbl-liter-2
                          tt-bo-erro.parametros = c-lbl-liter-ponto-de-controle-base-4 + "~~" + c-lbl-liter-itinerario-4.
               end.    
           end.                                  
        end.    
    &endif.
    /* Validacao Tabela de Preco */ 

    if not l-verifica-programa then do: /* Parametro passado para evitar validacao da tabela de preco nos programas manutencao de clientes (cd0704) * 
                                         * manutencao  de fornecedores (cd0401) e Cadastro de Clientes Internacionais (cd2577)                      */
       &if "{&bf_dis_versao_ems}" = "2.05" &then
           {cxbo/bocx085.i2 rowObject.nr-tab
                            rowObject.cod-emitente 
                            rowObject.cod-itiner-imp
                            rowObject.cod-incoterm-imp
                            ?
                            ?
                            &VALIDA-DESPESA}
       &endif
       &if "{&bf_dis_versao_ems}" < "2.05" &then
           {cxbo/bocx085.i2 substring(rowObject.char-1,1,10)
                            rowObject.cod-emitente 
                            rowObject.cod-itiner-imp
                            rowObject.cod-incoterm-imp
                            ?
                            ?
                            &VALIDA-DESPESA}
       &endif
    end.
       
    
    /*Valida‡Æo do Layout Original para EmissÆo da Commercial Invoice*/
    
    &IF "{&bf_dis_versao_ems}" >= "2.04" &THEN
        if l-identEmitente then do:
            &IF "{&bf_dis_versao_ems}" >= "2.06" &THEN
                IF rowObject.des-layout-origin-comerc-invoi <> "" THEN do:
                   assign file-info:file-name = rowObject.des-layout-origin-comerc-invoi.
                   if  file-info:pathname = ? 
                   OR  SEARCH(rowObject.des-layout-origin-comerc-invoi) <> ? then do:
                       assign i-seq-erro = i-seq-erro + 1.
                       run utp/ut-msgs.p (input "msg",
                                     input 4715,
                                     input rowObject.des-layout-origin-comerc-invoi).                               
                       create tt-bo-erro.                                   
                       assign tt-bo-erro.i-sequen = i-seq-erro
                              tt-bo-erro.cd-erro  = 4715
                              tt-bo-erro.mensagem = return-value
                              tt-bo-erro.parametros = file-info:file-name.
                   end.
                end.
            &ELSE
                &IF "{&bf_cex_versao_ems}" >= "2.062" &THEN
                    IF rowObject.des-layout-origin-comerc-invoi <> "" THEN do:
                       assign file-info:file-name = rowObject.des-layout-origin-comerc-invoi.
                       if  file-info:pathname = ? 
                       OR  SEARCH(rowObject.des-layout-origin-comerc-invoi) <> ? then do:
                           assign i-seq-erro = i-seq-erro + 1.
                           run utp/ut-msgs.p (input "msg",
                                         input 4715,
                                         input rowObject.des-layout-origin-comerc-invoi).                               
                           create tt-bo-erro.                                   
                           assign tt-bo-erro.i-sequen = i-seq-erro
                                  tt-bo-erro.cd-erro  = 4715
                                  tt-bo-erro.mensagem = return-value
                                  tt-bo-erro.parametros = file-info:file-name.
                       end. 
                    end.
                &else
                     IF substring(rowObject.char-2,1,40) <> "" THEN do:
                        assign file-info:file-name = substring(rowObject.char-2,1,40).
                        if  file-info:pathname = ? 
                        OR  SEARCH(substring(rowObject.char-2,1,40)) <> ? then do:
                            assign i-seq-erro = i-seq-erro + 1.
                            run utp/ut-msgs.p (input "msg",
                                          input 4715,
                                          input substring(rowObject.char-2,1,40)).
                            create tt-bo-erro.                                   
                            assign tt-bo-erro.i-sequen = i-seq-erro
                                   tt-bo-erro.cd-erro  = 4715
                                   tt-bo-erro.mensagem = return-value
                                   tt-bo-erro.parametros = file-info:file-name.
                        end. 
                     end.
                &endif
            &ENDIF 
        end. 
    &ENDIF

    /*Valida‡Æo do Layout Original para EmissÆo de Fatura Proforma*/
    
    &IF "{&bf_dis_versao_ems}" >= "2.04" &THEN
        if l-identEmitente then do:
           &IF "{&bf_dis_versao_ems}" >= "2.06" &THEN
               IF rowObject.des-layout-origin-proform-invoi <> "" THEN do:
                  assign file-info:file-name = rowObject.des-layout-origin-proform-invoi.
                  if  file-info:pathname = ? 
                  OR  SEARCH(rowObject.des-layout-origin-proform-invoi) <> ? then do:
                      assign i-seq-erro = i-seq-erro + 1.
                      run utp/ut-msgs.p (input "msg",
                                    input 4715,
                                    input rowObject.des-layout-origin-proform-invoi).                               
                      create tt-bo-erro.                                   
                      assign tt-bo-erro.i-sequen = i-seq-erro
                             tt-bo-erro.cd-erro  = 4715
                             tt-bo-erro.mensagem = return-value
                             tt-bo-erro.parametros = file-info:file-name.
                  end. 
               end.
           &ELSE
               &IF "{&bf_cex_versao_ems}" >= "2.062" &THEN
                   IF rowObject.des-layout-origin-proform-invoi <> "" THEN do:
                      assign file-info:file-name = rowObject.des-layout-origin-proform-invoi.
                      if  file-info:pathname = ? 
                      OR  SEARCH(rowObject.des-layout-origin-proform-invoi) <> ? then do:
                          assign i-seq-erro = i-seq-erro + 1.
                          run utp/ut-msgs.p (input "msg",
                                        input 4715,
                                        input rowObject.des-layout-origin-proform-invoi).                               
                          create tt-bo-erro.                                   
                          assign tt-bo-erro.i-sequen = i-seq-erro
                                 tt-bo-erro.cd-erro  = 4715
                                 tt-bo-erro.mensagem = return-value
                                 tt-bo-erro.parametros = file-info:file-name.
                      end. 
                   end.
               &ELSE
                   IF substring(rowObject.char-1,17,40) <> "" THEN do:
                      assign file-info:file-name = substring(rowObject.char-1,17,40).
                      if  file-info:pathname = ? 
                      OR  SEARCH(substring(rowObject.char-1,17,40)) <> ? then do:
                          assign i-seq-erro = i-seq-erro + 1.
                          run utp/ut-msgs.p (input "msg",
                                        input 4715,
                                        input substring(rowObject.char-1,17,40)).
                          create tt-bo-erro.                                   
                          assign tt-bo-erro.i-sequen = i-seq-erro
                                 tt-bo-erro.cd-erro  = 4715
                                 tt-bo-erro.mensagem = return-value
                                 tt-bo-erro.parametros = file-info:file-name.
                      end. 
                   end.
               &endif
           &ENDIF  
        end.  
    &ENDIF  

   
    /*Valida‡Æo do Layout Original para EmissÆo da Packing List*/
    
    &IF "{&bf_dis_versao_ems}" >= "2.04" &THEN
        if l-identEmitente then do:
           &IF "{&bf_dis_versao_ems}" >= "2.06" &THEN
               IF rowObject.des-layout-origin-packing-list <> "" THEN do:
                  assign file-info:file-name = rowObject.des-layout-origin-packing-list.
                  if  file-info:pathname = ? 
                  OR  SEARCH(rowObject.des-layout-origin-packing-list) <> ? then do:
                      assign i-seq-erro = i-seq-erro + 1.
                      run utp/ut-msgs.p (input "msg",
                                    input 4715,
                                    input rowObject.des-layout-origin-packing-list).                               
                      create tt-bo-erro.                                   
                      assign tt-bo-erro.i-sequen = i-seq-erro
                             tt-bo-erro.cd-erro  = 4715
                             tt-bo-erro.mensagem = return-value
                             tt-bo-erro.parametros = file-info:file-name.
                  end. 
               end.
           &ELSE
               &IF "{&bf_cex_versao_ems}" >= "2.062" &THEN
                   IF rowObject.des-layout-origin-packing-list <> "" THEN do:
                       assign file-info:file-name = rowObject.des-layout-origin-packing-list.
                       if  file-info:pathname = ? 
                       OR  SEARCH(rowObject.des-layout-origin-packing-list) <> ? then do:
                           assign i-seq-erro = i-seq-erro + 1.
                           run utp/ut-msgs.p (input "msg",
                                         input 4715,
                                         input rowObject.des-layout-origin-packing-list).                               
                           create tt-bo-erro.                                   
                           assign tt-bo-erro.i-sequen = i-seq-erro
                                  tt-bo-erro.cd-erro  = 4715
                                  tt-bo-erro.mensagem = return-value
                                  tt-bo-erro.parametros = file-info:file-name.
                       end. 
                   end.
               &ELSE
                   IF substring(rowObject.char-2,41,40) <> "" THEN do:
                      assign file-info:file-name = substring(rowObject.char-2,41,40).
                      if  file-info:pathname = ? 
                      OR  SEARCH(substring(rowObject.char-2,41,40)) <> ? then do:
                          assign i-seq-erro = i-seq-erro + 1.
                          run utp/ut-msgs.p (input "msg",
                                        input 4715,
                                        input substring(rowObject.char-2,41,40)).
                          create tt-bo-erro.                                   
                          assign tt-bo-erro.i-sequen = i-seq-erro
                                 tt-bo-erro.cd-erro  = 4715
                                 tt-bo-erro.mensagem = return-value
                                 tt-bo-erro.parametros = file-info:file-name.
                      end. 
                   end.
               &endif
               
           &ENDIF  
           
           &if "{&bf_cex_versao_ems}" >= "2.062" &then           
               IF rowObject.des-layout-export-instruc-embarq <> "" THEN do:
                   assign file-info:file-name = rowObject.des-layout-export-instruc-embarq.
                   if  file-info:pathname = ? 
                   OR  SEARCH(rowObject.des-layout-export-instruc-embarq) <> ? then do:
                       assign i-seq-erro = i-seq-erro + 1.
                       run utp/ut-msgs.p (input "msg",
                                     input 4715,
                                     input rowObject.des-layout-export-instruc-embarq).                               
                       create tt-bo-erro.                                   
                       assign tt-bo-erro.i-sequen = i-seq-erro
                              tt-bo-erro.cd-erro  = 4715
                              tt-bo-erro.mensagem = return-value
                              tt-bo-erro.parametros = file-info:file-name.
                   end. 
               end.
           &else
               IF substring(rowObject.char-1,57,40) <> "" THEN do:
                  assign file-info:file-name = substring(rowObject.char-1,57,40).
                  if  file-info:pathname = ? 
                  OR  SEARCH(substring(rowObject.char-1,57,40)) <> ? then do:
                      assign i-seq-erro = i-seq-erro + 1.
                      run utp/ut-msgs.p (input "msg",
                                    input 4715,
                                    input substring(rowObject.char-1,57,40)).
                      create tt-bo-erro.                                   
                      assign tt-bo-erro.i-sequen = i-seq-erro
                             tt-bo-erro.cd-erro  = 4715
                             tt-bo-erro.mensagem = return-value
                             tt-bo-erro.parametros = file-info:file-name.
                  end. 
               end.
           &endif
        end.
    &ENDIF  
    /* if not can-find (first tt-bo-erro) then 
       if can-find (first emitente-cex where emitente-cex.cod-emitente = 
                                             RowObject.cod-emitente    no-lock) then 
      /*  Integracao EAI */
      &IF '{&bf_dis_versao_ems}' >= "2.04":U &THEN 
       IF v_log_eai_habilit THEN
        if valid-handle (h-eai-emit) then do:
           find emitente where 
                emitente.cod-emitente = RowObject.cod-emitente no-lock no-error.
           run PITransUpsert IN h-eai-emit (input rowid(emitente),
                                            input "upd":U,
                                            output table tt_log_erro).
           for each tt_log_erro where tt_log_erro.ttv_num_cod_erro <> 60:
               assign i-seq-erro = i-seq-erro + 1.
               create tt-bo-erro.
               run utp/ut-msgs.p (input "msg",
                                  input ttv_num_cod_erro,
                                  input ttv_des_msg_erro).
               assign tt-bo-erro.i-sequen  = i-seq-erro
                      tt-bo-erro.cd-erro   = ttv_num_cod_erro
                      tt-bo-erro.mensagem  = ttv_des_msg_erro
                      tt-bo-erro.errorhelp = ttv_des_msg_erro.
           end.
        end.
		
     &ENDIF */
&ENDIF     
end procedure. 

procedure returnNome-abrev:
    def input parameter p-chave as rowid no-undo.
    def output parameter p-nome-abrev like emitente.nome-abrev no-undo.
    def var h-boad098 as handle no-undo.
    
    run findRowid(input p-chave).
    if not valid-handle (h-boad098) then
        run adbo/boad098.p persistent set h-boad098.
    run findCodigo in h-boad098(input rowObject.cod-emitente,output c-return).
    if c-return = "" then
        run getCharfield in h-boad098(input "nome-abrev",output p-nome-abrev).
    if valid-handle (h-boad098) then do:
        delete procedure h-boad098.
        assign h-boad098 = ?.
    end.
end procedure.

procedure getCharField:
	define input parameter c-field as char.
	define output parameter c-value as char.
	
	case c-field:
	   when "cod-idioma"       then c-value = RowObject.cod-idioma.
	   when "cod-incoterm-imp" then c-value = RowObject.cod-incoterm-imp.
	   when "cod-incoterm-exp" then c-value = RowObject.cod-incoterm-exp.
	   when "char-1"           then c-value = RowObject.char-1.
	   when "char-2"           then c-value = RowObject.char-2.
	   when "check-sum"        then c-value = RowObject.check-sum.
          &if "{&bf_mat_versao_ems}" >= "2.05" &then
               when "cod-pto-contr" then c-value = string(RowObject.cod-pto-contr).
          &endif
          &if "{&bf_cex_versao_ems}" >= "2.062":U &then
               when "marca-1"       then c-value = RowObject.marca-1.
               when "marca-2"       then c-value = RowObject.marca-2.
               when "marca-3"       then c-value = RowObject.marca-3.
               when "marca-4"       then c-value = RowObject.marca-4.
               when "marca-5"       then c-value = RowObject.marca-5.
          &endif
	   otherwise return error.
       end case.		
end procedure.
 
procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.
 
    case c-field:
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        otherwise return error.
    end case.
end procedure.

procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.
 
    case c-field:
        when "cod-emitente" then c-value = RowObject.cod-emitente.
        when "cod-repres" then c-value = RowObject.cod-repres.
        when "cod-itiner-imp" then c-value = RowObject.cod-itiner-imp.    
        when "cod-itiner-exp" then c-value = RowObject.cod-itiner-exp.
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.
        &if "{&bf_mat_versao_ems}" >= "2.05" &then
            when "cod-pto-contr" then c-value = RowObject.cod-pto-contr.
        &endif
        &if "{&bf_cex_versao_ems}" >= "2.062":U &then
            when "cdn-despa-import":U           then c-value = RowObject.cdn-despa-import.
            when "cdn-corretor-import":U        then c-value = RowObject.cdn-corretor-import.
            when "cdn-despa-exter-import":U     then c-value = RowObject.cdn-despa-exter-import.
            when "cdn-segurad-import":U         then c-value = RowObject.cdn-segurad-import.
            when "cdn-corretor-cambio-import":U then c-value = RowObject.cdn-corretor-cambio-import.
        &endif
        otherwise return error.
    end case.
end procedure.
 
procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.
 
    case c-field:
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.        
        otherwise return error.
    end case.
end procedure.

procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.
 
    case c-field:
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.        
        otherwise return error.
    end case.
end procedure.

procedure verifica_validacao:
/*
** Carrega a variavel l-verifica-programa para verificar o programa que est  chamando 
** a procedure, fazendo ou nÆo a validacao da tabela de preco (mensagem 4432)
** Programas que chamam a procedure: cd0704-v07.w e cd0401-v08.w
*/

define input parameter p-verifica as logical no-undo.
&IF "{&bf_cex_versao_ems}" >= "2.062":U &THEN 
   define input parameter p-program2 as int     no-undo.
&endif   

assign l-verifica-programa = p-verifica
       &IF "{&bf_cex_versao_ems}" >= "2.062":U &THEN 
          i-program           = p-program2
       &endif
       .

return "OK":U.

end procedure.

procedure verifFornecEstrangeiro:
    def input parameter p-cod-emitente like emitente.cod-emitente no-undo.
    def output parameter l-estrangeiro as log no-undo.
        
    assign l-estrangeiro = no.
    &if defined(bf-mat-comex) &then 
    &else
        for first emitente 
            where emitente.cod-emitente = p-cod-emitente no-lock:
            &if defined(bf-mat-comex) &then                                    
                if emitente.natureza = "E" or emitente.natureza = "T" then 
            &else
                if emitente.natureza = 3 or emitente.natureza = 4 then
            &endif            
                    assign l-estrangeiro = yes.
        end.
    &endif    
    
    return "OK":U.
end procedure.

procedure returnMarcas:
    define input parameter c-field as char.
    define output parameter c-value as char.

   &IF "{&bf_cex_versao_ems}" >= "2.062" &THEN
        run exp/ex0270b.p (input c-field,
                           output c-value,
                           input table rowObject).
        if c-value = ? then return error.
   &ENDIF
   
   return "OK":U.      	
end procedure.

&if "{&bf_cex_versao_ems}" >= "2.062" &then
procedure flagProgram:

   def input param p-program as int no-undo.

   assign i-program = p-program.

   return "OK":U.

end procedure.

procedure validateFieldsProgram:

    if not avail rowObject then
        find first rowObject no-error.

   if rowObject.cod-repres <> 0 then do:
        find repres where repres.cod-rep = rowObject.cod-repres no-lock no-error.
        if not avail repres then do:
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Representante * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).

            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
        /****
        else do:
            find emitente where emitente.cod-emitente = rowObject.cod-repres no-lock no-error.            
            if avail emitente then do:
                {cdp/cd2502.i}
            end.
        end.
        ***/
    end.        

    &if "{&bf_mat_versao_ems}":U >= "2.062":U &then
    /* Valida Corretor de Cambio */
    if  rowObject.cdn-corretor-cambio-import > 0 then do:

        if  not can-find (first  emitente
                           where emitente.cod-emitente = rowObject.cdn-corretor-cambio-import) then do:

            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Corretor_de_Cƒmbio * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).

            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
    end.

    /* Valida Despachante */
    if  rowObject.cdn-despa-import > 0 then do:         

        if  not can-find (first  emitente
                           where emitente.cod-emitente = rowObject.cdn-despa-import) then do:

            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Despachante * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).

            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
    end.

    /* Valida Despachante no Exterior */
    if  rowObject.cdn-despa-exter-import > 0 then do:

        if  not can-find (first  emitente
                           where emitente.cod-emitente = rowObject.cdn-despa-exter-import) then do:

            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Despachante_no_Exterior * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).

            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
    end.

    /* Valida Seguradora*/
    if  rowObject.cdn-segurad-import > 0 then do:

        if  not can-find (first  emitente
                           where emitente.cod-emitente = rowObject.cdn-segurad-import) then do:

            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Seguradora * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).

            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
    end.

    /* Valida Corretor*/
    if  rowObject.cdn-corretor-import > 0 then do:

        if  not can-find (first  emitente
                           where emitente.cod-emitente = rowObject.cdn-corretor-import) then do:

            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Corretor_Seguro * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).

            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
    end.
    &IF "{&BF_cex_VERSAO_EMS}" >= "2.062" &THEN
        /* Valida Moeda*/
        if  not can-find (first  moeda
                              where moeda.mo-codigo = rowObject.mo-codigo) then do:
    
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-liter.i Moeda * L}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                run utp/ut-msgs.p (input "msg",
                                   input 2,
                                   input return-value).
        
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 2
                       tt-bo-erro.mensagem = return-value.                               
        end.
    &ENDIF

    if i-program = 1 then do:

       if  rowObject.des-layout-origin-ped-cambio <> "" then do:

           assign file-info:file-name = rowObject.des-layout-origin-ped-cambio.

           if  file-info:pathname = ? 
           or  search(rowObject.des-layout-origin-ped-cambio) <> ? then do:

               assign i-seq-erro = i-seq-erro + 1.
               run utp/ut-msgs.p (input "msg",
                                  input 4715,
                                  input rowObject.des-layout-origin-ped-cambio).                               
               create tt-bo-erro.                                   
               assign tt-bo-erro.i-sequen = i-seq-erro
                      tt-bo-erro.cd-erro  = 4715
                      tt-bo-erro.mensagem = return-value
                      tt-bo-erro.parametros = file-info:file-name.
           end. 
       end.

       if  rowObject.des-layout-origin-instruc-embarq <> "" then do:
    
               assign file-info:file-name = rowObject.des-layout-origin-instruc-embarq.

               if  file-info:pathname = ? 
               or  search(rowObject.des-layout-origin-instruc-embarq) <> ? then do:

                   assign i-seq-erro = i-seq-erro + 1.
                   run utp/ut-msgs.p (input "msg",
                                      input 4715,
                                      input rowObject.des-layout-origin-instruc-embarq).                               
                   create tt-bo-erro.                                   
                   assign tt-bo-erro.i-sequen = i-seq-erro
                          tt-bo-erro.cd-erro  = 4715
                          tt-bo-erro.mensagem = return-value
                          tt-bo-erro.parametros = file-info:file-name.
               end. 
       end.

       if  rowObject.des-layout-origin-pch-order <> "" then do:

           assign file-info:file-name = rowObject.des-layout-origin-pch-order.

           if  file-info:pathname = ? 
           or  search(rowObject.des-layout-origin-pch-order) <> ? then do:

               assign i-seq-erro = i-seq-erro + 1.
               run utp/ut-msgs.p (input "msg",
                                  input 4715,
                                  input rowObject.des-layout-origin-pch-order).                               
               create tt-bo-erro.                                   
               assign tt-bo-erro.i-sequen = i-seq-erro
                      tt-bo-erro.cd-erro  = 4715
                      tt-bo-erro.mensagem = return-value
                      tt-bo-erro.parametros = file-info:file-name.
           end. 
       end.
    end.
    
    &endif
        
    if  rowObject.cod-itiner-imp <> 0 then
        if not can-find(itinerario where itinerario.cod-itiner = rowObject.cod-itiner-imp) then do:        
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-field.i mgcex emitente-cex cod-itiner-imp 1}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).
                               
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
        
    if rowObject.cod-itiner-exp <> 0 then
        if not can-find(itinerario where itinerario.cod-itiner = rowObject.cod-itiner-exp) then do:        
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-field.i mgcex emitente-cex cod-itiner-exp 1}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
        
    if rowObject.cod-incoterm-imp <> "" then
        if not can-find(inco-cx where inco-cx.cod-incoterm = rowObject.cod-incoterm-imp) then do:        
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-field.i mgcex emitente-cex cod-incoterm-imp 1}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
        
    if rowObject.cod-incoterm-exp <> "" then
        if not can-find(inco-cx where inco-cx.cod-incoterm = rowObject.cod-incoterm-exp) then do:        
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-field.i mgcex emitente-cex cod-incoterm-exp 1}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.                               
        end.
        
    if rowObject.cod-idioma <> "" then 
        &if defined(bf-mat-comex) &then                                        
            if not can-find(idioma where idioma.id-codigo = rowObject.cod-idioma) then do:
                assign i-seq-erro = i-seq-erro + 1.
                run utp/ut-msgs.p (input "msg",
                                   input 4774,
                                   input return-value).
                create tt-bo-erro.                                   
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 4774
                       tt-bo-erro.mensagem = return-value.                               
            end.        
    
        &else
            if not can-find(idioma where idioma.cod_idioma = rowObject.cod-idioma) then do:
                assign i-seq-erro = i-seq-erro + 1.
                run utp/ut-msgs.p (input "msg",
                                   input 4774,
                                   input return-value).
                create tt-bo-erro.                                   
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 4774
                       tt-bo-erro.mensagem = return-value.                               
            end.                
        &endif
    /*Valida‡Æo do Ponto de Controle Base*/
    &if "{&bf_dis_versao_ems}" >= "2.05" &then
        if rowObject.cod-itiner-imp <> 0 and 
           rowObject.cod-pto-contr <> 0 or
           rowObject.cod-itiner-imp = 0 and 
           rowObject.cod-pto-contr <> 0 then do:
           
           /*Valida‡Æo da existˆncia do ponto de controle */
           if not valid-handle (h-bocx110) then
               run cxbo/bocx110.p persistent set h-bocx110.
           run findCodigo in h-bocx110 (input rowObject.cod-pto-contr,
                                        output c-return). 
           if valid-handle (h-bocx110) then do:
               delete procedure h-bocx110.                             
               assign h-bocx110 = ?.
           end.
           if  c-return <> "" then do:
           
               {utp/ut-table.i mgcex pto-contr 1}

               create tt-bo-erro.
               assign tt-bo-erro.parametros = return-value.

               run utp/ut-msgs.p (input "msg",
                                  input 2,
                                  input return-value).                   
                              
               assign tt-bo-erro.i-sequen     = i-seq-erro
                      tt-bo-erro.cd-erro      = 2
                      tt-bo-erro.mensagem     = return-value.                                 
           end.                             
           if l-fornecedor then do:
               /*Valida se o ponto de controle est  vinculado ao itiner rio */
               if not can-find(pto-itiner where pto-itiner.cod-itiner = rowObject.cod-itiner-imp and
                                                pto-itiner.cod-pto-contr = rowObject.cod-pto-contr) then do:
                    assign i-seq-erro = i-seq-erro + 1.
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-ponto-de-controle-base-5 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Ponto_de_controle_base" *}
                    ASSIGN c-lbl-liter-ponto-de-controle-base-5 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-itinerario-5 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "itiner rio" *}
                    ASSIGN c-lbl-liter-itinerario-5 = TRIM(RETURN-VALUE).
                    run utp/ut-msgs.p (input "msg",
                                       input 19519,
                                       input c-lbl-liter-ponto-de-controle-base-5 + "~~" + c-lbl-liter-itinerario-5).
                    create tt-bo-erro.                                   
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-3 AS CHARACTER NO-UNDO.
                    ASSIGN c-lbl-liter-3 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-ponto-de-controle-base-6 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Ponto_de_controle_base" *}
                    ASSIGN c-lbl-liter-ponto-de-controle-base-6 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-itinerario-6 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "itiner rio" *}
                    ASSIGN c-lbl-liter-itinerario-6 = TRIM(RETURN-VALUE).
                    assign tt-bo-erro.i-sequen = i-seq-erro
                           tt-bo-erro.cd-erro  = 19519
                           tt-bo-erro.mensagem = c-lbl-liter-3
                           tt-bo-erro.parametros = c-lbl-liter-ponto-de-controle-base-6 + "~~" + c-lbl-liter-itinerario-6.
               end.  
           end.  
        end.    
    &else
        if rowObject.cod-itiner-imp <> 0 and 
           int(substr(rowObject.char-1,11,6)) <> 0 or
           rowObject.cod-itiner-imp = 0 and 
           int(substr(rowObject.char-1,11,6)) <> 0 then do:
           
           /*Valida‡Æo da existˆncia do ponto de controle */
           if not valid-handle (h-bocx110) then
               run cxbo/bocx110.p persistent set h-bocx110.
           run findCodigo in h-bocx110 (input int(substr(rowObject.char-1,11,6)),
                                        output c-return). 
           if valid-handle (h-bocx110) then do:
               delete procedure h-bocx110.                              
               assign h-bocx110 = ?.
           end.
           if  c-return <> "" then do:
           
               {utp/ut-table.i mgcex pto-contr 1}

               create tt-bo-erro.
               assign tt-bo-erro.parametros = return-value.

               run utp/ut-msgs.p (input "msg",
                                  input 2,
                                  input return-value).                   
                              
               assign tt-bo-erro.i-sequen     = i-seq-erro
                      tt-bo-erro.cd-erro      = 2
                      tt-bo-erro.mensagem     = return-value.                                 
           end.       
           if l-fornecedor then do:
               /*Valida se o ponto de controle est  vinculado ao itiner rio */
               if not can-find(pto-itiner where pto-itiner.cod-itiner = rowObject.cod-itiner-imp and
                                                pto-itiner.cod-pto-contr = int(substr(rowObject.char-1,11,6))) then do:
                                                            
                   assign i-seq-erro = i-seq-erro + 1.
                   /* Inicio -- Projeto Internacional */
                   DEFINE VARIABLE c-lbl-liter-ponto-de-controle-base-7 AS CHARACTER NO-UNDO.
                   {utp/ut-liter.i "Ponto_de_controle_base" *}
                   ASSIGN c-lbl-liter-ponto-de-controle-base-7 = TRIM(RETURN-VALUE).
                   DEFINE VARIABLE c-lbl-liter-itinerario-7 AS CHARACTER NO-UNDO.
                   {utp/ut-liter.i "itiner rio" *}
                   ASSIGN c-lbl-liter-itinerario-7 = TRIM(RETURN-VALUE).
                   run utp/ut-msgs.p (input "msg",
                                      input 19519,
                                      input c-lbl-liter-ponto-de-controle-base-7 + "~~" + c-lbl-liter-itinerario-7).
                   create tt-bo-erro.                                   
                   /* Inicio -- Projeto Internacional */
                   DEFINE VARIABLE c-lbl-liter-4 AS CHARACTER NO-UNDO.
                   ASSIGN c-lbl-liter-4 = TRIM(RETURN-VALUE).
                   DEFINE VARIABLE c-lbl-liter-ponto-de-controle-base-8 AS CHARACTER NO-UNDO.
                   {utp/ut-liter.i "Ponto_de_controle_base" *}
                   ASSIGN c-lbl-liter-ponto-de-controle-base-8 = TRIM(RETURN-VALUE).
                   DEFINE VARIABLE c-lbl-liter-itinerario-8 AS CHARACTER NO-UNDO.
                   {utp/ut-liter.i "itiner rio" *}
                   ASSIGN c-lbl-liter-itinerario-8 = TRIM(RETURN-VALUE).
                   assign tt-bo-erro.i-sequen = i-seq-erro
                          tt-bo-erro.cd-erro  = 19519
                          tt-bo-erro.mensagem = c-lbl-liter-4
                          tt-bo-erro.parametros = c-lbl-liter-ponto-de-controle-base-8 + "~~" + c-lbl-liter-itinerario-8.
               end. 
           end.                                     
        end.    
    &endif.
    /* Validacao Tabela de Preco */ 
    if not l-verifica-programa then do: /* Parametro passado para evitar validacao da tabela de preco nos programas manutencao de clientes (cd0704) * 
                                         * manutencao  de fornecedores (cd0401) e Cadastro de Clientes Internacionais (cd2577)                      */
       &if "{&bf_dis_versao_ems}" >= "2.05" &then
           {cxbo/bocx085.i2 rowObject.nr-tab
                            rowObject.cod-emitente 
                            rowObject.cod-itiner-imp
                            rowObject.cod-incoterm-imp
                            ?
                            ?
                            &VALIDA-DESPESA}
       &else
           {cxbo/bocx085.i2 substring(rowObject.char-1,1,10)
                            rowObject.cod-emitente 
                            rowObject.cod-itiner-imp
                            rowObject.cod-incoterm-imp
                            ?
                            ?
                            &VALIDA-DESPESA}
       &endif
    end.

    if i-program = 2 then do:

         /*Valida‡Æo do Layout Original para EmissÆo da Commercial Invoice*/

         &IF "{&bf_dis_versao_ems}" >= "2.04" &THEN
             &IF "{&bf_dis_versao_ems}" >= "2.06" &THEN
               
                 IF rowObject.des-layout-origin-comerc-invoi <> "" THEN do:
                    assign file-info:file-name = rowObject.des-layout-origin-comerc-invoi.
                    if  file-info:pathname = ? 
                    OR  SEARCH(rowObject.des-layout-origin-comerc-invoi) <> ? then do:
                        assign i-seq-erro = i-seq-erro + 1.
                        run utp/ut-msgs.p (input "msg",
                                      input 4715,
                                      input rowObject.des-layout-origin-comerc-invoi).                               
                        create tt-bo-erro.                                   
                        assign tt-bo-erro.i-sequen = i-seq-erro
                               tt-bo-erro.cd-erro  = 4715
                               tt-bo-erro.mensagem = return-value
                               tt-bo-erro.parametros = file-info:file-name.
                    end. 
                 end.
             &ELSE
                 &IF "{&bf_cex_versao_ems}" >= "2.062" &THEN
                     IF rowObject.des-layout-origin-comerc-invoi <> "" THEN do:
                        assign file-info:file-name = rowObject.des-layout-origin-comerc-invoi.
                        if  file-info:pathname = ? 
                        OR  SEARCH(rowObject.des-layout-origin-comerc-invoi) <> ? then do:
                            assign i-seq-erro = i-seq-erro + 1.
                            run utp/ut-msgs.p (input "msg",
                                          input 4715,
                                          input rowObject.des-layout-origin-comerc-invoi).                               
                            create tt-bo-erro.                                   
                            assign tt-bo-erro.i-sequen = i-seq-erro
                                   tt-bo-erro.cd-erro  = 4715
                                   tt-bo-erro.mensagem = return-value
                                   tt-bo-erro.parametros = file-info:file-name.
                        end. 
                     end.
                 &else
                      IF substring(rowObject.char-2,1,40) <> "" THEN do:
                         assign file-info:file-name = substring(rowObject.char-2,1,40).
                         if  file-info:pathname = ? 
                         OR  SEARCH(substring(rowObject.char-2,1,40)) <> ? then do:
                             assign i-seq-erro = i-seq-erro + 1.
                             run utp/ut-msgs.p (input "msg",
                                           input 4715,
                                           input substring(rowObject.char-2,1,40)).
                             create tt-bo-erro.                                   
                             assign tt-bo-erro.i-sequen = i-seq-erro
                                    tt-bo-erro.cd-erro  = 4715
                                    tt-bo-erro.mensagem = return-value
                                    tt-bo-erro.parametros = file-info:file-name.
                         end. 
                      end.
                 &endif
             &ENDIF  
         &ENDIF
      
         /*Valida‡Æo do Layout Original para EmissÆo de Fatura Proforma*/
          
         &IF "{&bf_dis_versao_ems}" >= "2.04" &THEN
             &IF "{&bf_dis_versao_ems}" >= "2.06" &THEN
                 IF rowObject.des-layout-origin-proform-invoi <> "" THEN do:
                    assign file-info:file-name = rowObject.des-layout-origin-proform-invoi.
                    if  file-info:pathname = ? 
                    OR  SEARCH(rowObject.des-layout-origin-proform-invoi) <> ? then do:
                        assign i-seq-erro = i-seq-erro + 1.
                        run utp/ut-msgs.p (input "msg",
                                      input 4715,
                                      input rowObject.des-layout-origin-proform-invoi).                               
                        create tt-bo-erro.                                   
                        assign tt-bo-erro.i-sequen = i-seq-erro
                               tt-bo-erro.cd-erro  = 4715
                               tt-bo-erro.mensagem = return-value
                               tt-bo-erro.parametros = file-info:file-name.
                    end. 
                 end.
             &ELSE
                 &IF "{&bf_cex_versao_ems}" >= "2.062" &THEN
                     IF rowObject.des-layout-origin-proform-invoi <> "" THEN do:
                        assign file-info:file-name = rowObject.des-layout-origin-proform-invoi.
                        if  file-info:pathname = ? 
                        OR  SEARCH(rowObject.des-layout-origin-proform-invoi) <> ? then do:
                            assign i-seq-erro = i-seq-erro + 1.
                            run utp/ut-msgs.p (input "msg",
                                          input 4715,
                                          input rowObject.des-layout-origin-proform-invoi).                               
                            create tt-bo-erro.                                   
                            assign tt-bo-erro.i-sequen = i-seq-erro
                                   tt-bo-erro.cd-erro  = 4715
                                   tt-bo-erro.mensagem = return-value
                                   tt-bo-erro.parametros = file-info:file-name.
                        end. 
                     end.
                 &ELSE
                      IF substring(rowObject.char-1,17,40) <> "" THEN do:
                        assign file-info:file-name = substring(rowObject.char-1,17,40).
                        if  file-info:pathname = ? 
                        OR  SEARCH(substring(rowObject.char-1,17,40)) <> ? then do:
                            assign i-seq-erro = i-seq-erro + 1.
                            run utp/ut-msgs.p (input "msg",
                                          input 4715,
                                          input substring(rowObject.char-1,17,40)).
                            create tt-bo-erro.                                   
                            assign tt-bo-erro.i-sequen = i-seq-erro
                                    tt-bo-erro.cd-erro  = 4715
                                   tt-bo-erro.mensagem = return-value
                                   tt-bo-erro.parametros = file-info:file-name.
                        end. 
                     end.
                 &endif
             &ENDIF  
         &ENDIF  
        
         
         /*Valida‡Æo do Layout Original para EmissÆo da Packing List*/
          
         &IF "{&bf_dis_versao_ems}" >= "2.04" &THEN
             &IF "{&bf_dis_versao_ems}" >= "2.06" &THEN
                 IF rowObject.des-layout-origin-packing-list <> "" THEN do:
                    assign file-info:file-name = rowObject.des-layout-origin-packing-list.
                    if  file-info:pathname = ? 
                    OR  SEARCH(rowObject.des-layout-origin-packing-list) <> ? then do:
                        assign i-seq-erro = i-seq-erro + 1.
                        run utp/ut-msgs.p (input "msg",
                                      input 4715,
                                      input rowObject.des-layout-origin-packing-list).                               
                        create tt-bo-erro.                                   
                        assign tt-bo-erro.i-sequen = i-seq-erro
                               tt-bo-erro.cd-erro  = 4715
                               tt-bo-erro.mensagem = return-value
                               tt-bo-erro.parametros = file-info:file-name.
                    end. 
                 end.
             &ELSE
                &IF "{&bf_cex_versao_ems}" >= "2.062" &THEN
                     IF rowObject.des-layout-origin-packing-list <> "" THEN do:
                         assign file-info:file-name = rowObject.des-layout-origin-packing-list.
                         if  file-info:pathname = ? 
                         OR  SEARCH(rowObject.des-layout-origin-packing-list) <> ? then do:
                             assign i-seq-erro = i-seq-erro + 1.
                             run utp/ut-msgs.p (input "msg",
                                           input 4715,
                                           input rowObject.des-layout-origin-packing-list).                               
                             create tt-bo-erro.                                   
                             assign tt-bo-erro.i-sequen = i-seq-erro
                                    tt-bo-erro.cd-erro  = 4715
                                    tt-bo-erro.mensagem = return-value
                                    tt-bo-erro.parametros = file-info:file-name.
                         end. 
                     end.
                 &ELSE
                     IF substring(rowObject.char-2,41,40) <> "" THEN do:
                        assign file-info:file-name = substring(rowObject.char-2,41,40).
                        if  file-info:pathname = ? 
                        OR  SEARCH(substring(rowObject.char-2,41,40)) <> ? then do:
                            assign i-seq-erro = i-seq-erro + 1.
                            run utp/ut-msgs.p (input "msg",
                                           input 4715,
                                          input substring(rowObject.char-2,41,40)).
                            create tt-bo-erro.                                   
                            assign tt-bo-erro.i-sequen = i-seq-erro
                                   tt-bo-erro.cd-erro  = 4715
                                   tt-bo-erro.mensagem = return-value
                                    tt-bo-erro.parametros = file-info:file-name.
                        end. 
                     end.
                 &endif
                    
             &ENDIF  
                
             &if "{&bf_cex_versao_ems}" >= "2.062" &then           
                 IF rowObject.des-layout-export-instruc-embarq <> "" THEN do:
                     assign file-info:file-name = rowObject.des-layout-export-instruc-embarq.
                     if  file-info:pathname = ? 
                     OR  SEARCH(rowObject.des-layout-export-instruc-embarq) <> ? then do:
                         assign i-seq-erro = i-seq-erro + 1.
                         run utp/ut-msgs.p (input "msg",
                                       input 4715,
                                       input rowObject.des-layout-export-instruc-embarq).                               
                         create tt-bo-erro.                                   
                         assign tt-bo-erro.i-sequen = i-seq-erro
                                tt-bo-erro.cd-erro  = 4715
                                tt-bo-erro.mensagem = return-value
                                tt-bo-erro.parametros = file-info:file-name.
                     end. 
                 end.
             &else
                  IF substring(rowObject.char-1,57,40) <> "" THEN do:
                    assign file-info:file-name = substring(rowObject.char-1,57,40).
                    if  file-info:pathname = ? 
                    OR  SEARCH(substring(rowObject.char-1,57,40)) <> ? then do:
                        assign i-seq-erro = i-seq-erro + 1.
                        run utp/ut-msgs.p (input "msg",
                                      input 4715,
                                      input substring(rowObject.char-1,57,40)).
                        create tt-bo-erro.                                   
                        assign tt-bo-erro.i-sequen = i-seq-erro
                                tt-bo-erro.cd-erro  = 4715
                               tt-bo-erro.mensagem = return-value
                                tt-bo-erro.parametros = file-info:file-name.
                    end. 
                 end.
             &endif
        
         &ENDIF  
    end.
    /* if not can-find (first tt-bo-erro) then 
       if can-find (first emitente-cex where emitente-cex.cod-emitente = 
                                             RowObject.cod-emitente    no-lock) then 
      /*  Integracao EAI */
      &IF '{&bf_dis_versao_ems}' >= "2.04":U &THEN 
       IF v_log_eai_habilit THEN
        if valid-handle (h-eai-emit) then do:
           find emitente where 
                emitente.cod-emitente = RowObject.cod-emitente no-lock no-error.
           run PITransUpsert IN h-eai-emit (input rowid(emitente),
                                            input "upd":U,
                                            output table tt_log_erro).
           for each tt_log_erro where tt_log_erro.ttv_num_cod_erro <> 60:
               assign i-seq-erro = i-seq-erro + 1.
               create tt-bo-erro.
               run utp/ut-msgs.p (input "msg",
                                  input ttv_num_cod_erro,
                                  input ttv_des_msg_erro).
               assign tt-bo-erro.i-sequen  = i-seq-erro
                      tt-bo-erro.cd-erro   = ttv_num_cod_erro
                      tt-bo-erro.mensagem  = ttv_des_msg_erro
                      tt-bo-erro.errorhelp = ttv_des_msg_erro.
           end.
        end.
     &ENDIF */


end procedure.
&endif

procedure validaFornecedor:
    define input  parameter pr-rowid        as rowid        no-undo.
    define output paramete table for tt-bo-erro.
    
    define variable c-retorno1 as char no-undo.
    define variable c-retorno2 as char no-undo.

    find first cotacao-item
         where rowid(cotacao-item) = pr-rowid no-lock no-error.
    if avail cotacao-item then do:
       find first emitente
         where emitente.cod-emitente = cotacao-item.cod-emitente no-lock no-error.
         
       if  avail emitente 
       and emitente.natureza < 3 then do:
        
           {utp/ut-liter.i Fornecedor * R}
           assign c-retorno1  = return-value.
        
           {utp/ut-liter.i Estrangeiro_ou_Trading * R}
           assign c-retorno2 = return-value.

           assign i-seq-erro = i-seq-erro + 1.
           run utp/ut-msgs.p (input "msg",
                              input 17167,
                              input c-retorno1 + "~~" + c-retorno2).
           create tt-bo-erro.
           assign tt-bo-erro.i-sequen = i-seq-erro
                  tt-bo-erro.cd-erro  = 17167
                  tt-bo-erro.mensagem = return-value.
       end.
    end.
    
    return "ok":U.
end procedure.


procedure setaRowObject:
    define input parameter table for RowObject.

    return "OK":U.
end procedure.


procedure retornaErro:
    define output parameter table for tt-bo-erro.
    
    return "OK":U.
end procedure.    
