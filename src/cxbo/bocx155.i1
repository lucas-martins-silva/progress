def var i-cod-emitente-ini like emitente.cod-emitente no-undo.
def var i-cod-emitente-fim like emitente.cod-emitente no-undo.
def var l-create-folder as logical init no no-undo.
def var l-verifica-validacao as logical init no no-undo.
def var c-return1 as char no-undo.
def var h-bocx110 as handle no-undo.
def var l-verifica-programa as logical no-undo.
def var i-program as int no-undo.
def var l-identEmitente as log no-undo.
def var l-fornecedor    as log no-undo.
DEFINE VARIABLE c-lbl-liter-2 AS CHARACTER NO-UNDO.
DEFINE VARIABLE c-lbl-liter-nao-encontrada-tabela-de-preco AS CHARACTER NO-UNDO.

&if defined(bf-mat-comex) &then                                    
    def var c-identific    like emitente.identific    no-undo.
&else
    def var i-identific    like emitente.identific    no-undo.
&endif    

&IF '{&bf_dis_versao_ems}' >= "2.04":U &THEN 
  define temp-table tt_log_erro no-undo
     field ttv_num_cod_erro  as integer   initial ?
     field ttv_des_msg_ajuda as character initial ?
     field ttv_des_msg_erro  as character initial ?
      .

  def new global shared var v_log_eai_habilit as logical no-undo. 
  def var h-eai-emit               as handle  no-undo.
  if v_log_eai_habilit then
    run adapters/xml/fi2/axsfi001.p persistent set h-eai-emit (output table tt_log_erro).
&ENDIF


DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

procedure setConstraint1:
end procedure.

procedure setConstraint2:
def input parameter p-cod-emitente-ini as char no-undo.
def input parameter p-cod-emitente-fim as char no-undo.

assign i-cod-emitente-ini = integer(p-cod-emitente-ini)
       i-cod-emitente-fim = integer(p-cod-emitente-fim).
    
end procedure.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.    
        when 2 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock
                where {&TABLE-NAME}.cod-emitente >= i-cod-emitente-ini and
                      {&TABLE-NAME}.cod-emitente <= i-cod-emitente-fim
                      by {&TABLE-NAME}.cod-emitente.
                            
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.
 
{include/bostrmet.i}
{include/boendmet.i}
