def var c-desc-desp-ini as char no-undo.
def var c-desc-desp-fim as char no-undo.
def var c-desc-desp     as char no-undo.
def var c-cod-pto-contri as char no-undo.
def var c-cod-pto-contrf as char no-undo.
def var i-cod-pto-contri as integer no-undo.
def var i-cod-pto-contrf as integer no-undo.
def var i-cod-pto-contr as integer no-undo.
 
&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.001
&scoped-define FIRST-TABLE-IN-QUERY pto-contr
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME pto-contr
 
{include/boini.i}
 
{cxbo/bocx110.i RowObject}
 
DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

procedure setConstraint1:

end.
 
procedure setConstraint2:
  def input parameter p-pto-contr as char no-undo.
    
    assign i-cod-pto-contr = integer(p-pto-contr).
end procedure.

procedure setConstraint3:
    def input parameter r-chave as rowid no-undo.
    find pto-itiner no-lock where rowid(pto-itiner) = r-chave no-error.
end procedure.

procedure setConstraint4:
  def input parameter p-pto-contri as char no-undo.
  def input parameter p-pto-contrf as char no-undo.
    
    assign i-cod-pto-contri = integer(p-pto-contri).
    assign i-cod-pto-contrf = integer(p-pto-contrf).    
end procedure.


procedure setConstraint5:
    def input parameter p-desc-desp-ini as char no-undo.
    def input parameter p-desc-desp-fim as char no-undo.
 
    assign c-desc-desp-ini = p-desc-desp-ini
           c-desc-desp-fim = p-desc-desp-fim.
end procedure.
 
procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
           open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where 
                                              {&TABLE-NAME}.cod-pto-contr >= i-cod-pto-contr no-lock.
        when 3 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} where 
                                              {&TABLE-NAME}.cod-pto-contr >= i-cod-pto-contr no-lock by pto-contr.cod-pto-contr.
        when 4 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where 
                                              {&TABLE-NAME}.cod-pto-contr >= i-cod-pto-contri and
                                              {&TABLE-NAME}.cod-pto-contr <= i-cod-pto-contrf no-lock.
        when 5 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where 
                                              {&TABLE-NAME}.descricao >= c-desc-desp-ini and
                                              {&TABLE-NAME}.descricao <= c-desc-desp-fim no-lock by pto-contr.descricao by pto-contr.cod-pto-contr.   
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.
 
