procedure executeUpdate:
    /*
    **  Executa Update
    */
    buffer-copy RowObject except r-rowid cod-pto-contr to {&TABLE-NAME}.
end procedure.
 
procedure initializeValidate:
    /*
    **  Inicializa Validate
    */
 
    run startMethod ("initializeValidade").
 
    run endMethod   ("initializeValidade").
end procedure.
 
procedure findCodigo:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter i-cod-pto-contr as inte no-undo.
    def output parameter c-return as char no-undo.
 
    find pto-contr where
        pto-contr.cod-pto-contr = i-cod-pto-contr
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex pto-contr 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.

procedure findCodigoEX3001:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter i-cod-pto-contr as inte no-undo.
    def output parameter c-return as char no-undo.
 
    find pto-contr where
        pto-contr.cod-pto-contr = i-cod-pto-contr
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        assign c-return = "Registro nao encontrado".
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.
procedure findCodigo2:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    def input parameter i-cod-pto-contr as inte no-undo.
    def output parameter table for RowObject.
        
    find pto-contr where
        pto-contr.cod-pto-contr = i-cod-pto-contr
        no-lock no-error.
    
    if avail pto-contr then    
      run setCurrent.
    else do:
      find first rowObject exclusive-lock no-error.
      if avail rowObject then assign rowObject.descricao = "".                            
    end.  
         
end procedure.

procedure validateDelete:
    /*
    **  Valida Delete
    */
    def input-output parameter r-chave as rowid.
    def output parameter table for tt-bo-erro.
    def var c-tabela as char no-undo.
    
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    
    run InitializeValidate.
 
    find {&TABLE-NAME} where
        rowid({&TABLE-NAME}) = r-chave
        exclusive-lock no-error.
    if avail {&TABLE-NAME} then do:
        if can-find(first pto-itiner where pto-itiner.cod-pto-contr = {&table-name}.cod-pto-contr) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex pto-contr 1}
            /***************************************/
            assign c-tabela = return-value.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex pto-itiner 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = c-tabela + "~~ " + return-value.
            run utp/ut-msgs.p (input "msg",
                               input 5,
                               input c-tabela + "~~" + return-value).            
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 5
                   tt-bo-erro.mensagem = return-value.            
        end.
        else
            run executeDelete.
    end.
 
    if l-query then
        get next {&QUERY-NAME}
            no-lock no-wait.
    else
        find next {&TABLE-NAME}
            no-lock no-error.

    if not avail {&TABLE-NAME} then do:
       if l-query then
           get prev {&QUERY-NAME}
               no-lock no-wait.
       else
           find prev {&TABLE-NAME}
               no-lock no-error.
    end.
    assign r-chave = rowid({&TABLE-NAME}).
    return "".
end procedure.

procedure validateFields:
    /*
    **  Valida Fields
    */
    find first rowObject
        no-lock no-error.
 
    if rowObject.descricao = ? or rowObject.descricao = "" then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 190,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 190
               tt-bo-erro.mensagem     = return-value.
    end. 
end procedure.
 
procedure validateUpdate:
    /*
    **  Valida Update
    */
    def input parameter table for RowObject.
    def input parameter r-chave as rowid no-undo.
    def output parameter table for tt-bo-erro.
 
    run startmethod ("ValidateUpdate").

    run InitializeValidate.
 
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
   
    find first rowobject no-lock no-error.
    
    if RowObject.unid-referencial <> 0 and
        not can-find(first unid-rf
                     where unid-rf.cdn-unid-recta-feder = RowObject.unid-referencial) then do:
            /* Inicio -- Projeto Internacional */
            {utp/ut-liter.i "Unidade_Referencial" *}
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input RETURN-VALUE).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.                  
    end.
    
    run validateInternac.

    find first tt-bo-erro
        no-lock no-error.
    if not avail tt-bo-erro then do:
        find {&TABLE-NAME} where
            rowid({&TABLE-NAME}) = r-chave
            exclusive-lock no-error.
        run executeUpdate.
    end.
  
  run endmethod ("ValidateUpdate").
  
end procedure.

procedure validateCreate:
    /*
    **  Valida criacao da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.
 
    def var i-auto-num as integer no-undo.

    run initializeValidate.
    run startMethod ("validateCreate").
 
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
 
    find first rowObject no-lock no-error.
            
    if rowObject.cod-pto-contr = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex pto-contr cod-pto-contr 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    
    run validateFields.     
 
    find first tt-bo-erro
        no-lock no-error.
    if not available tt-bo-erro then do:
        find pto-contr where
            pto-contr.cod-pto-contr = rowObject.cod-pto-contr
            no-lock no-error.
        if avail pto-contr then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR! - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex pto-contr 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 8,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 8
                   tt-bo-erro.mensagem     = return-value.
        end.
    end.
     
    if RowObject.unid-referencial <> 0 and
        not can-find(first unid-rf
                     where unid-rf.cdn-unid-recta-feder = RowObject.unid-referencial) then do:
            /* Inicio -- Projeto Internacional */
            {utp/ut-liter.i "Unidade_Referencial" *}
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input RETURN-VALUE).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.                  
    end.
    /** Verifica duplicidade dos registros **/    
 
    find pto-contr where
        pto-contr.cod-pto-contr = rowObject.cod-pto-contr
        no-lock no-error.
    if avail pto-contr then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex pto-contr 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 8,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 8
               tt-bo-erro.mensagem     = return-value.
    end.
    
    run validateInternac.
    
    find first tt-bo-erro
        no-lock no-error.
 
    if not avail tt-bo-erro then do:
       run executeCreate.
       assign r-chave = to-rowid(return-value).
    end.
 
    run endMethod ("validateCreate").
end procedure.

{include/i-getEntryField.i}

procedure validateInternac:

    def var c-cidade as char no-undo.
    def var c-estado as char no-undo.
    def var c-pais   as char no-undo.

    ASSIGN c-cidade = GetEntryField(2,RowObject.char-2,";")
           c-estado = GetEntryField(3,RowObject.char-2,";")
           c-pais   = GetEntryField(4,RowObject.char-2,";").

    IF  c-cidade <> ""
    and NOT CAN-FIND(FIRST cidade 
                     WHERE cidade.cidade = c-cidade 
                       AND cidade.estado = c-estado 
                       AND cidade.pais   = c-pais) THEN DO:
        {utp/ut-liter.i "Cidade" *}
        run utp/ut-msgs.p (input "msg", input 2, input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 2
               tt-bo-erro.mensagem     = return-value.
    END.

    IF  c-estado <> ""
    and NOT CAN-FIND(FIRST UNID-FEDER 
                     WHERE UNID-FEDER.PAIS   = c-pais
                       AND UNID-FEDER.ESTADO = c-estado) THEN DO:
        {utp/ut-liter.i "Estado" *}
        run utp/ut-msgs.p (input "msg", input 2, input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 2
               tt-bo-erro.mensagem     = return-value.
    END.

    IF  c-pais <> ""
    and NOT CAN-FIND(FIRST PAIS 
                     WHERE PAIS.NOME-PAIS = c-pais) THEN DO:
        {utp/ut-liter.i "Pais" *}
        run utp/ut-msgs.p (input "msg", input 2, input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 2
               tt-bo-erro.mensagem     = return-value.
    END.


end procedure.

procedure autoNumber:
    def output parameter i-auto-num as integer no-undo.
    def var i-cont as integer init 1 no-undo. /** variavel de contador **/
    def output parameter table for tt-bo-erro.
        
    {include/boautonum.i "99999" "cod-pto-contr"}

end procedure.

procedure validateInteger:

    def input parameter c-unid-refer as char no-undo.
    def output parameter table for tt-bo-erro.
    def var i as integer no-undo.
    
    assign i = int(c-unid-refer) no-error.
    if  error-status:error then do:
       assign i-seq-erro = i-seq-erro + 1.
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-field.i mgcex pto-contr unid-referencial 1}
       /******************************************/
       run utp/ut-msgs.p (input "msg",
                          input 16963,
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen     = i-seq-erro
              tt-bo-erro.cd-erro      = 16963
              tt-bo-erro.mensagem     = return-value.
    end.           
              
end procedure.

procedure retornaDescricao:

   def input  parameter p-cod-pto-contr as integer /*like pto-contr.cod-pto-contr*/.
   def output parameter p-c-descricao   like pto-contr.descricao.
   
   find pto-contr where pto-contr.cod-pto-contr = p-cod-pto-contr no-lock no-error.

   assign p-c-descricao = if avail pto-contr then pto-contr.descricao else " ":U.

end procedure.
 
procedure getCharField:
    define input  parameter c-field as char.
    define output parameter c-value as char.
 
    case c-field:
        when "char-1" then c-value = RowObject.char-1.
        when "char-2" then c-value = RowObject.char-2.
        when "check-sum" then c-value = RowObject.check-sum.
        when "descricao" then c-value = RowObject.descricao.
        when "narrativa" then c-value = RowObject.narrativa.
        when "cod-uf" then c-value = RowObject.cod-uf.
        &IF '{&product_version}' >= "12.1.3" AND '{&product_version}' < "99.9.9" &THEN
                when "des-sig-pais" then c-value = RowObject.des-sig-pais.
        &ELSE
                when "des-sig-pais" then c-value = TRIM(SUBSTRING(RowObject.char-1,3,3)).
        &ENDIF
        
        otherwise return error.
    end case.
end procedure.
 
procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.
 
    case c-field:
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        otherwise return error.
    end case.
end procedure.
 
procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.
 
    case c-field:
        when "cod-pto-contr" then c-value = RowObject.cod-pto-contr.
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.
        when "unid-referencial" then c-value = RowObject.unid-referencial.
        otherwise return error.
    end case.
end procedure.
 
procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.
 
    case c-field:
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.
        otherwise return error.
    end case.
end procedure.
 
procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.
 
    case c-field:
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.
        otherwise return error.
    end case.
end procedure.
 
