&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/
    
    
    find first b-orgao-anuente
         where b-orgao-anuente.cod-orgao-anuente   = RowObject.cod-orgao-anuente no-lock no-error.
    
    if  pType = "Create":U then do:
        /***** Evento j† Cadastrado *****/          
        if  avail b-orgao-anuente then do:
            {method/svc/errors/inserr.i
                    &ErrorNumber="7"
                    &ErrorType="EMS"
                    &ErrorSubType="Error"
                    &ErrorParameters="'‡rg∆o Anuente'"}
            return "NOK":U.
        end.
    end.
    else do:
        if  not avail b-orgao-anuente then do:
            {method/svc/errors/inserr.i
                    &ErrorNumber="56"
                    &ErrorType="EMS"
                    &ErrorSubType="Error"
                    &ErrorParameters="'‡rg∆o Anuente'"}
            return "NOK":U.
        end.
    end.
    
    IF  RowObject.cod-orgao-anuente = "" THEN DO:
        {method/svc/errors/inserr.i
                &ErrorNumber="17006"
                &ErrorType="EMS"
                &ErrorSubType="Error"
                &ErrorDescription="C¢digo deve ser preenchido"}
        return "NOK":U.
    END.

    IF  RowObject.des-orgao-anuente = " " THEN DO:
        {method/svc/errors/inserr.i
                &ErrorNumber="17006"
                &ErrorType="EMS"
                &ErrorSubType="Error"
                &ErrorDescription="Descriá∆o deve ser preenchida"}
        return "NOK":U.
    END.

    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

