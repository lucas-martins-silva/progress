&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE setConstraintCodigo DBOProgram 
PROCEDURE setConstraintCodigo :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
  DEF INPUT PARAMETER pc-cod-orgao-anuente-ini LIKE orgao-anuente.cod-orgao-anuente NO-UNDO.
  DEF INPUT PARAMETER pc-cod-orgao-anuente-fim LIKE orgao-anuente.cod-orgao-anuente NO-UNDO.
    
  assign c-cod-orgao-anuente-ini = pc-cod-orgao-anuente-ini
         c-cod-orgao-anuente-fim = pc-cod-orgao-anuente-fim.
  return "OK":U.
END PROCEDURE.

