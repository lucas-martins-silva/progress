    def var de-quant-aux as decimal no-undo.
&endif

DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

procedure setConstraint1:

end procedure.

PROCEDURE setConstraint2:

    def input parameter p-cod-estabel  like proc-ped-ent.cod-estabel  no-undo.
    def input parameter p-nr-proc-exp  like proc-ped-ent.nr-proc-exp  no-undo.
    def input parameter p-nome-abrev   like proc-ped-ent.nome-abrev   no-undo.
    def input parameter p-nr-pedcli    like proc-ped-ent.nr-pedcli    no-undo.
    def input parameter p-nr-sequencia like proc-ped-ent.nr-sequencia no-undo.
    def input parameter p-it-codigo    as char no-undo.
    def input parameter p-cod-refer    as char no-undo.
    def input parameter p-nr-entrega   as char no-undo.

    assign c-cod-estabel    = p-cod-estabel
           c-nr-proc-exp    = p-nr-proc-exp
           c-nome-abrev     = p-nome-abrev
           c-nr-pedcli      = p-nr-pedcli
           i-nr-sequencia   = int(p-nr-sequencia)
           c-it-codigo      = p-it-codigo
           c-cod-refer      = p-cod-refer
           i-nr-entrega     = int(p-nr-entrega).

END PROCEDURE.

procedure setConstraint3:

end procedure.

procedure setConstraint4:

end procedure.

procedure setConstraint5:
    def input parameter r-chave as rowid no-undo.
    find processo-exp no-lock
         where rowid(processo-exp) = r-chave no-error.
end procedure.

procedure setConstraint6:


end procedure.


PROCEDURE setConstraint7:

def input parameter p-cod-estabel-ini  like proc-ped-ent.cod-estabel  no-undo.
def input parameter p-cod-estabel-fin  like proc-ped-ent.cod-estabel  no-undo.
def input parameter p-nr-proc-exp-ini  like proc-ped-ent.nr-proc-exp  no-undo.
def input parameter p-nr-proc-exp-fin  like proc-ped-ent.nr-proc-exp  no-undo.

    assign c-cod-estabel        = p-cod-estabel-ini
           c-nr-proc-exp        = p-nr-proc-exp-ini
           c-cod-estabel-fin    = p-cod-estabel-fin
           c-nr-proc-exp-fin    = p-nr-proc-exp-fin.

END PROCEDURE.

procedure setConstraint8:
   &if defined (bf_dis_versao_ems) &then
       &if '{&bf_dis_versao_ems}' >= '2.04' &then
           define input parameter pc-cod-estabel     like estabelec.cod-estabel    no-undo.
           define input parameter pc-nr-re-ini       like pedido-drb-re.nr-re      no-undo.
           define input parameter pc-nr-re-fim       like pedido-drb-re.nr-re      no-undo.
           define input parameter pc-nr-proc-exp-ini like processo-exp.nr-proc-exp no-undo.
           define input parameter pc-nr-proc-exp-fim like processo-exp.nr-proc-exp no-undo.
           
               assign c-cod-estabel     = pc-cod-estabel
                      c-nr-re-ini       = pc-nr-re-ini
                      c-nr-re-fim       = pc-nr-re-fim
                      c-nr-proc-exp-ini = pc-nr-proc-exp-ini
                      c-nr-proc-exp-fim = pc-nr-proc-exp-fim.
                      
       &endif
   &endif
end procedure.



procedure openQuery:
    define input parameter i-abertura as integer no-undo.

    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where proc-ped-ent.cod-estabel  >= c-cod-estabel  and ~
                                                                  proc-ped-ent.nr-proc-exp  >= c-nr-proc-exp  and ~
                                                                  proc-ped-ent.nome-abrev   >= c-nome-abrev   and ~
                                                                  proc-ped-ent.nr-pedcli    >= c-nr-pedcli    and ~
                                                                  proc-ped-ent.nr-sequencia >= i-nr-sequencia and ~
                                                                  proc-ped-ent.it-codigo    >= c-it-codigo    and ~
                                                                  proc-ped-ent.cod-refer    >= c-cod-refer    and ~
                                                                  proc-ped-ent.nr-entrega   >= i-nr-entrega no-lock.
        when 3 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
        when 4 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
        when 5 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} of processo-exp no-lock
                                                            by proc-ped-ent.cod-estabel
                                                            by proc-ped-ent.nr-proc-exp
                                                            by proc-ped-ent.nome-abrev
                                                            by proc-ped-ent.nr-pedcli
                                                            by proc-ped-ent.nr-sequencia
                                                            by proc-ped-ent.it-codigo.
        when 6 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
        when 7 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where proc-ped-ent.cod-estabel  >= c-cod-estabel  and ~
                                                       proc-ped-ent.cod-estabel  <= c-cod-estabel-fin and ~
                                                       proc-ped-ent.nr-proc-exp  >= c-nr-proc-exp and ~
                                                       proc-ped-ent.nr-proc-exp  <= c-nr-proc-exp-fin
                                                       no-lock.
        &if defined(bf_dis_versao_ems) &then
            &if '{&bf_dis_versao_ems}' >= '2.04' &then
                when 8 then
                    open query {&QUERY-NAME} for each {&TABLE-NAME}
                                                where proc-ped-ent.cod-estabel = c-cod-estabel 
                                                  and proc-ped-ent.nr-re       <> ""
                                                  and proc-ped-ent.nr-re       >= c-nr-re-ini
                                                  and proc-ped-ent.nr-re       <= c-nr-re-fim
                                                  and proc-ped-ent.nr-proc-exp >= c-nr-proc-exp-ini
                                                  and proc-ped-ent.nr-proc-exp <= c-nr-proc-exp-fim no-lock
                                             by proc-ped-ent.nr-re
                                             by proc-ped-ent.cod-estabel
                                             by proc-ped-ent.nr-proc-exp
                                             by proc-ped-ent.nome-abrev
                                             by proc-ped-ent.nr-pedcli
                                             by proc-ped-ent.nr-sequencia
                                             by proc-ped-ent.it-codigo.
            &endif
        &endif                                                       
            
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.

