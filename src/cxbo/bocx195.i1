{cxbo/bocx195.i tt-proc-ped-ent}
{cxbo/bocx195.i rowObject}
{cxbo/bocx190.i tt-proc-ped-venda}


&if defined(bf_comex206b-1) &then
    define temp-table tt-proc-ped-ent-simul no-undo like proc-ped-ent
        field qt-pedida      like ped-ent.qt-pedida
        field qt-simulada    like ped-ent.qt-pedida
        field qt-alocada     like ped-ent.qt-pedida
        field r-rowid        as rowid.
        
    define temp-table tt-browse no-undo
        field cod-estabel   like proc-ped-ent.cod-estabel
        field nr-proc-exp   like proc-ped-ent.nr-proc-exp
        field quantidade    as decimal
        field cod-sit-proc  like processo-exp.cod-sit-proc
        field desc-sit      as character.
    
    define temp-table tt-valores no-undo
        field nome-abrev    like ped-ent.nome-abrev
        field nr-pedcli     like ped-ent.nr-pedcli
        field nr-sequencia  like ped-ent.nr-sequencia
        field it-codigo     like ped-ent.it-codigo
        field cod-refer     like ped-ent.cod-refer
        field nr-entrega    like ped-ent.nr-entrega
        field qt-pedida     like ped-ent.qt-pedida
        field cod-emit      like emitente.cod-emitente
        field nome-emit     like emitente.nome-emit
        field nr-pedido     like ped-venda.nr-pedido
        field un            like item.un
        field descricao     like item.desc-item.    
&endif

