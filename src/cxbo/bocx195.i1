    &GLOBAL-DEFINE PROC-NOTA-FISCAL.LOG-NF-DEVOLVID proc-nota-fiscal.log-nf-devolvid
&ELSE
    &GLOBAL-DEFINE PROC-NOTA-FISCAL.LOG-NF-DEVOLVID proc-nota-fiscal.log-1
&ENDIF

define buffer b-proc-ped-ent    for proc-ped-ent.
define buffer b-ped-item        for ped-item.
define buffer b-natur-oper      for natur-oper.

DEFINE VAR h-bocx195        as handle  no-undo.
define var h-bocx345        as handle  no-undo.
DEFINE VAR c-cod-estabel    as char    no-undo.
DEFINE VAR c-nr-proc-exp    as char    no-undo.
DEFINE VAR c-nome-abrev     as char    no-undo.
DEFINE VAR c-nr-pedcli      as char    no-undo.
DEFINE VAR i-nr-sequencia   as integer no-undo.
DEFINE VAR c-it-codigo      as char    no-undo.
DEFINE VAR c-cod-refer      as char    no-undo.
DEFINE VAR i-nr-entrega     as integer no-undo.
DEFINE var i-cont           as integer no-undo.
DEFINE VAR rw-rowid         as rowid   no-undo.
DEFINE VAR i-tipo-atend     like it-nota-fisc.tipo-atend    no-undo.
DEFINE var c-nr-pedido      like proc-ped-venda.nr-pedido   no-undo.
DEFINE VAR l-val-nf-embarque as logical init yes no-undo.

&IF "{&bf_dis_versao_ems}" >= "2.04" &THEN
    DEF VAR h-bocx185 AS HANDLE NO-UNDO.
&ENDIF

define var c-cod-estabel-fin as char no-undo.
define var c-nr-proc-exp-fin as char no-undo.
define var c-nr-re-ini       as char no-undo.
define var c-nr-re-fim       as char no-undo.
define var c-nr-proc-exp-ini as char no-undo.
define var c-nr-proc-exp-fim as char no-undo.

&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.001
&scoped-define FIRST-TABLE-IN-QUERY proc-ped-ent
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME proc-ped-ent


