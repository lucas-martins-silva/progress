def var c-cod-inicial as char no-undo.
def var c-cod-ini     as char no-undo.
def var c-cod-fim     as char no-undo.

{cdp/cdcfgmat.i} /* defini‡Æo de pr‚-processador */

&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.001
&scoped-define FIRST-TABLE-IN-QUERY inco-cx
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME inco-cx
 
DEFINE TEMP-TABLE tt-desp-incoterm no-undo like desp-incoterm
    field r-rowid  as rowid.
 
 
{include/boini.i}
 
{cxbo/bocx025.i RowObject}
 
DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.
 
procedure setConstraint1:
  
  
end procedure.

procedure setConstraint2:
  def input parameter p-cod-inicial as char no-undo.
  assign c-cod-inicial = p-cod-inicial.

end procedure.

procedure setConstraint3:
  def input parameter p-cod-ini as char no-undo.
  def input parameter p-cod-fim as char no-undo.
  
  assign c-cod-ini = p-cod-ini
         c-cod-fim = p-cod-fim.

end procedure. 

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
           open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock. 
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where {&TABLE-NAME}.cod-incoterm >= c-cod-inicial no-lock by inco-cx.cod-incoterm.
        when 3 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where 
                                              {&TABLE-NAME}.cod-incoterm >= c-cod-ini and
                                              {&TABLE-NAME}.cod-incoterm <= c-cod-fim
                                               no-lock by inco-cx.cod-incoterm.            
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.
 
{include/bostrmet.i}
{include/boendmet.i}
&if defined(bf-mat-comex) &then    
&else
    {include/bocomver.i}
    {include/bogetver.i}
&endif
{include/bonav.i}
{include/bofind.i}
{include/bosetcur.i}
{include/bogetcur.i}
{include/bosersen.i}
{include/boprebro.i}
{include/boexecre.i}
