procedure executeUpdate:
    /*
    **  Executa Update
    */
    buffer-copy RowObject except r-rowid cod-incoterm to {&TABLE-NAME}.

end procedure.


procedure initializeValidate:
    /*
    **  Inicializa Validate
    */
 
    run startMethod ("initializeValidade").
 
    run endMethod   ("initializeValidade").
end procedure.
 
procedure findPk_incoterm:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter c-cod-incoterm as char no-undo.
    def output parameter c-return as char no-undo.
 
    find inco-cx where
        inco-cx.cod-incoterm = c-cod-incoterm
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
        pre-processador em chamada de includes */ 
        {utp/ut-table.i mgcex inco-cx 1}
        /***************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.

procedure validateUpdate:
    /*
    **  Valida Update
    */
    def input parameter table for RowObject.
    def input parameter r-chave as rowid no-undo.
    def output parameter table for tt-bo-erro.
 
    run InitializeValidate.
 
    for each tt-bo-erro exclusive-lock:
        delete tt-bo-erro.
    end.
 
    run validateFields.
    find {&TABLE-NAME} where rowid({&TABLE-NAME}) = r-chave no-lock no-error.
    if {&TABLE-NAME}.cod-incoterm <> rowObject.cod-incoterm then do:
       assign i-seq-erro = i-seq-erro + 1.
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-field.i mgcex inco-cx cod-incoterm 1}
       /************************************************/
       run utp/ut-msgs.p (input "msg",
                          input 16913,
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen     = i-seq-erro
              tt-bo-erro.cd-erro      = 16913
              tt-bo-erro.mensagem     = return-value.                    
    end.    
    find first tt-bo-erro
        no-lock no-error.
    if not avail tt-bo-erro then do:
        find {&TABLE-NAME} where
            rowid({&TABLE-NAME}) = r-chave
            exclusive-lock no-error.
        run executeUpdate.
    end.
end procedure.
 
procedure validateFields:
    /*
    **  Valida Fields
    */
    find first rowObject
        no-lock no-error.
 
    run startMethod ("validateFields").
 
    if rowObject.descricao = "" then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 190,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 190
               tt-bo-erro.mensagem     = return-value.
    end.
 
    run endMethod ("validateFields").
 
end procedure.

procedure validateDelete:
    /*
    **  Valida Delete
    */
    def input-output parameter r-chave as rowid.
    def output parameter table for tt-bo-erro.
    def var c-tabela as char no-undo.
 
    run InitializeValidate.
    
    find {&TABLE-NAME} where
        rowid({&TABLE-NAME}) = r-chave exclusive-lock no-error.
    if avail {&TABLE-NAME} then do:
        
        if can-find(first cotacao-item-cex where cotacao-item-cex.cod-incoterm = {&table-name}.cod-incoterm) then do:
           assign i-seq-erro = i-seq-erro + 1.
           /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
              pre-processador em chamada de includes */
           {utp/ut-table.i mgcex inco-cx 1}
           /******************************************/
           assign c-tabela = return-value.            
           {utp/ut-table.i mgcex cotacao-item-cex 1}
           run utp/ut-msgs.p (input "msg",
                              input 5,
                              input c-tabela + "~~" + return-value).
           create tt-bo-erro.
           assign tt-bo-erro.i-sequen  = i-seq-erro
                  tt-bo-erro.cd-erro   = 5
                  tt-bo-erro.mensagem  = return-value.
        end.
        if can-find(first processo-exp where processo-exp.cod-incoterm = {&table-name}.cod-incoterm) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex inco-cx 1}
            /******************************************/
            assign c-tabela = return-value.            
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex processo-exp 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 5,
                               input c-tabela + "~~" + return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen  = i-seq-erro
                   tt-bo-erro.cd-erro   = 5
                   tt-bo-erro.mensagem  = return-value.
        end.
        if can-find(first processo-imp where processo-imp.cod-incoterm = {&table-name}.cod-incoterm) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex inco-cx 1}
            /******************************************/ 
            assign c-tabela = return-value.            
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */     
            {utp/ut-table.i mgcex processo-imp 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 5,
                               input c-tabela + "~~" + return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen  = i-seq-erro
                   tt-bo-erro.cd-erro   = 5
                   tt-bo-erro.mensagem  = return-value.
        end.
        if can-find(first tb-pr-cex where tb-pr-cex.cod-incoterm = {&table-name}.cod-incoterm) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex inco-cx 1}
            /******************************************/  
            assign c-tabela = return-value.            
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex tb-pr-cex 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 5,
                               input c-tabela + "~~" + return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen  = i-seq-erro
                   tt-bo-erro.cd-erro   = 5
                   tt-bo-erro.mensagem  = return-value.
        end.
        if not can-find(first tt-bo-erro) then do:         
            /** Apaga as despesas relacionadas as incoterms. */
            for each desp-incoterm where 
                     desp-incoterm.cod-incoterm = {&table-name}.cod-incoterm exclusive-lock:
                delete desp-incoterm.
            end.
            run executeDelete.
         end.
    end.
    
    if not can-find(first tt-bo-erro) then do:         
        if l-query then
           get next {&QUERY-NAME} no-lock no-wait.
        else
           find next {&TABLE-NAME} no-lock no-error.
        
        if not avail {&TABLE-NAME} then do:
           if l-query then
              get prev {&QUERY-NAME} no-lock no-wait.
           else
              find prev {&TABLE-NAME} no-lock no-error.
        end.
    end.
    assign r-chave = rowid({&TABLE-NAME}).
    return "".
end procedure.

procedure validateCreate:
    /*
    **  Valida cria‡Æo da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.
 
    run initializeValidate.
    run startMethod ("validateCreate").
 
    for each tt-bo-erro exclusive-lock:
        delete tt-bo-erro.
    end.
 
    find first rowObject no-error.

    if rowObject.cod-incoterm = "" then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex inco-cx cod-incoterm 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end. 
    
    if can-find(first {&TABLE-NAME} where
                      {&TABLE-NAME}.cod-incoterm  = rowObject.cod-incoterm) then do:
       assign i-seq-erro = i-seq-erro + 1.
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-table.i mgcex inco-cx 1}
       /******************************************/
       run utp/ut-msgs.p (input "msg",
                          input 8,
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen     = i-seq-erro
              tt-bo-erro.cd-erro      = 8
              tt-bo-erro.mensagem     = return-value.
    end.    
 
    run validateFields.

    find first tt-bo-erro
        no-lock no-error.
 
    if not avail tt-bo-erro then do:
       run executeCreate.
       assign r-chave = to-rowid(return-value).
    end.
 
    run endMethod ("validateCreate").
end procedure.

procedure executeCopy:
def input parameter r-chave as rowid no-undo.
def input parameter c-cod-incoterm as char.
def output parameter c as char.

find {&table-name} where rowid({&table-name}) = r-chave no-lock no-error.
if avail {&table-name} then do:
   for each desp-incoterm where desp-incoterm.cod-incoterm = {&table-name}.cod-incoterm no-lock:
      assign c = string(desp-incoterm.cod-desp).
      create tt-desp-incoterm.
      assign tt-desp-incoterm.cod-incoterm = c-cod-incoterm
             tt-desp-incoterm.cod-desp     = desp-incoterm.cod-desp.
  end.  
  for each tt-desp-incoterm no-lock:
    create desp-incoterm.
    buffer-copy tt-desp-incoterm to desp-incoterm.
  end.
end.
end procedure.

procedure getCharField:
    define input  parameter c-field as char.
    define output parameter c-value as char.
 
    case c-field:
        when "char-1" then c-value = RowObject.char-1.
        when "char-2" then c-value = RowObject.char-2.
        when "check-sum" then c-value = RowObject.check-sum.
        when "cod-incoterm" then c-value = RowObject.cod-incoterm.
        when "descricao" then c-value = RowObject.descricao.
        otherwise return error.
    end case.
end procedure.
 
procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.
 
    case c-field:
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        otherwise return error.
    end case.
end procedure.
 
procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.
 
    case c-field:
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.
        otherwise return error.
    end case.
end procedure.
 
procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.
 
    case c-field:
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.
        otherwise return error.
    end case.
end procedure.
 
procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.
 
    case c-field:
        when "l-despesas-des" then c-value = RowObject.l-despesas-des.
        when "l-despesas-int" then c-value = RowObject.l-despesas-int.
        when "l-despesas-port" then c-value = RowObject.l-despesas-port.
        when "l-embalag-int" then c-value = RowObject.l-embalag-int.
        when "l-embalag-master" then c-value = RowObject.l-embalag-master.
        when "l-frete-ext" then c-value = RowObject.l-frete-ext.
        when "l-frete-inter" then c-value = RowObject.l-frete-inter.
        when "l-frete-nac" then c-value = RowObject.l-frete-nac.
        when "l-icms" then c-value = RowObject.l-icms.
        when "l-ii" then c-value = RowObject.l-ii.
        when "l-ipi" then c-value = RowObject.l-ipi.
        when "l-seguro-inter" then c-value = RowObject.l-seguro-inter.
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.
        otherwise return error.
    end case.
end procedure.
