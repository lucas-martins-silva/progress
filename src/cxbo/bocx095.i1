        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.  
    end.
 
    if rowObject.val-desp = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp val-desp 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.   
    end.
    
    if rowObject.int-1 <> 0 then do:
       find grupo-desp
           where grupo-desp.cod-grup-desp = rowObject.int-1
           no-lock no-error.
       if not avail grupo-desp then do:
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
              pre-processador em chamada de includes */
            {utp/ut-table.i mgcex grupo-desp 1}
            /******************************************/        
            create tt-bo-erro.
            assign tt-bo-erro.parametros = trim(return-value).           
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign c-return = return-value.            
            assign i-seq-erro = i-seq-erro + 1.          
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.
        end.
    end.
    
    if rowObject.inc-val-frete = yes and rowObject.inc-base-ipi = yes and i-pais-impto-usuario = 1 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp inc-val-frete 1}        
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 26813,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 26813
               tt-bo-erro.mensagem     = return-value. 
    end.
    
    assign i-cont = 0.        
    if rowObject.inc-val-seguro = yes then
        assign i-cont = i-cont + 1.
    if rowObject.inc-val-frete = yes then
        assign i-cont = i-cont + 1.
    if rowObject.inc-val-embal = yes then
        assign i-cont = i-cont + 1.
    if rowObject.inc-val-outras-desp = yes then
        assign i-cont = i-cont + 1.
        
    if (inc-val-duplic or
       inc-base-ipi or
       inc-base-icms) and       
       i-cont = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg":U,
                           input 19316,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 19316
               tt-bo-erro.mensagem     = return-value.
    end.    
        
    if i-cont > 1 then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg":U,
                           input 17488,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 17488
               tt-bo-erro.mensagem     = return-value.       
    end.
    
    /*Validaá∆o da fornecedor Padr∆o*/
    &if "{&bf_mat_versao_ems}" >= "2.05" &then
        if  rowObject.cod-emitente <> 0 then do:
            if  not can-find (first emitente where emitente.cod-emitente = rowObject.cod-emitente) then do:
                create tt-bo-erro.
                {utp/ut-liter.i Fornecedor_Padr∆o * L}
                assign tt-bo-erro.parametros = trim(return-value).
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input tt-bo-erro.parametros).
                
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 2
                       tt-bo-erro.mensagem = return-value.
            end.
            if  can-find (first emitente where emitente.cod-emitente = rowObject.cod-emitente
                                           and emitente.identific    = identificador) then do: /*Cliente*/
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "Emitente_informado_deve_ser_do_tipo_Fornecedor_ou_Ambos" *}
                run utp/ut-msgs.p (input "msg":U,
                                   input 25997,
                                   input RETURN-VALUE).
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 25997
                       tt-bo-erro.mensagem = return-value.
            end.
        end.

        /*Validaá∆o da despesa*/
        if rowObject.tp-despesa <> 0 then do:
            for first tipo-rec-desp fields(tp-codigo tipo) where 
                tipo-rec-desp.tp-codigo = rowObject.tp-despesa
                no-lock: end.

                if available tipo-rec-desp then do:
                    if tipo-rec-desp.tipo = 1 then do:
                        run utp/ut-msgs.p (input "msg":U,
                                           input 3300,
                                           input "").
                        create tt-bo-erro.
                        assign tt-bo-erro.i-sequen = i-seq-erro
                            tt-bo-erro.cd-erro  = 3300
                            tt-bo-erro.mensagem = return-value.
                    end.
                end.
                else do:
                    run utp/ut-msgs.p (input "msg":U,
                                       input 3299,
                                       input "").
                    create tt-bo-erro.
                    assign tt-bo-erro.i-sequen = i-seq-erro
                        tt-bo-erro.cd-erro  = 3299
                        tt-bo-erro.mensagem = return-value.
                end.
        end.
            
    &else
        if  trim(substring(rowObject.char-1,1,9)) <> "0" then do:
            if  not can-find (first emitente where emitente.cod-emitente = int(substring(rowObject.char-1,1,9))) then do:
                create tt-bo-erro.
                {utp/ut-liter.i Fornecedor_Padr∆o * L}
                assign tt-bo-erro.parametros = trim(return-value).
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input return-value).
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 2
                       tt-bo-erro.mensagem = return-value.
            end.
            if  can-find (first emitente where emitente.cod-emitente = int(substring(rowObject.char-1,1,9))
                                           and emitente.identific    = identificador) then do: /*Cliente*/
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "Emitente_informado_deve_ser_do_tipo_Fornecedor_ou_Ambos" *}
                run utp/ut-msgs.p (input "msg":U,
                                   input 25997,
                                   input RETURN-VALUE).
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 25997
                       tt-bo-erro.mensagem = return-value.
            end.           
        end.
    &endif.
    
    /********************************************
    * Engenharia Contabilizacao de Despesas     *
    ********************************************/
    &IF '{&bf_mat_versao_ems}' >= '2.04' &THEN
        
        &IF '{&bf_mat_versao_ems}' >= '2.06' &THEN
            ASSIGN c-cod-espec-padr = RowObject.cod-espec-padr.
        &ELSE
            ASSIGN c-cod-espec-padr = SUBSTRING(RowObject.char-1,14,02).
        &ENDIF
        
        IF  c-cod-espec-padr <> "" and c-cod-espec-padr <> ? AND
            NOT CAN-FIND(FIRST espec-ap
                         WHERE espec-ap.cod-esp = c-cod-espec-padr NO-LOCK) THEN DO:
                         
            CREATE tt-bo-erro.
            ASSIGN tt-bo-erro.parametros = c-cod-espec-padr.
            RUN utp/ut-msgs.p (INPUT "msg":U,
                               INPUT 624,
                               INPUT c-cod-espec-padr).
            
            ASSIGN i-seq-erro          = i-seq-erro + 1
                   tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 624
                   tt-bo-erro.mensagem = RETURN-VALUE.
        END.
    &ENDIF
    
    &IF "{&bf_mat_versao_ems}":U >= "2.062":U &THEN
    
    if  rowObject.dsl-formul-despes <> "" then do:

        run validaFormulaDespesa (input rowObject.dsl-formul-despes,
                                  input "IMP",
                                  output table rowErrors).
        if  can-find (first rowErrors) then do:

            for each rowErrors:

                assign i-seq-erro = i-seq-erro + 1.
                create tt-bo-erro.
                assign tt-bo-erro.parametros   = rowErrors.ErrorParameters 
                       tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = rowErrors.ErrorNumber     
                       tt-bo-erro.mensagem     = rowErrors.ErrorDescription.
            end.
        end.
        else do:

            run geraLegenda (input  rowObject.dsl-formul-despes,
                             output c-legenda).
            assign rowObject.dsl-legenda-formul = c-legenda.
        end.
    end.
    &ENDIF
    
    run endMethod ("validateFields").
 
end procedure.

procedure validateDelete:
    /*
    **  Valida Delete
    */
    def input-output parameter r-chave as rowid.
    def output parameter table for tt-bo-erro.
    
    
    def var c-return1       as char no-undo.
    def var c-returnErro    as char no-undo.
    def var h-bocx105       as handle no-undo.
    def var r-form-desp-imp as rowid no-undo.
 
    run InitializeValidate.
    run startMethod("validateDelete").
    
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    
    find {&TABLE-NAME} where
        rowid({&TABLE-NAME}) = r-chave
        exclusive-lock no-error.
    /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
       pre-processador em chamada de includes */
    {utp/ut-table.i mgcex desp-imp 1}
    /******************************************/
    assign c-return1 = return-value.        

    if can-find(first docum-est-cex where docum-est-cex.cod-desp = desp-imp.cod-desp) then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex docum-est-cex 1}
        /******************************************/
        assign c-returnErro = return-value.
    end.
    if can-find(first desp-item where desp-item.cod-desp = desp-imp.cod-desp) then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex desp-imp 1}
        /******************************************/
        assign c-returnErro = return-value.    
    end.
    if can-find(first cotacao-item-cex where cotacao-item-cex.cod-desp = desp-imp.cod-desp) then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex cotacao-item-cex 1}
        /******************************************/
        assign c-returnErro = return-value.
    end.
    if can-find(first desp-incoterm where desp-incoterm.cod-desp = desp-imp.cod-desp) then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex desp-incoterm 1}
        /******************************************/        
        assign c-returnErro = return-value.
    end.
    if can-find(first proc-desp-itiner where proc-desp-itiner.cod-desp = desp-imp.cod-desp) then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex proc-desp-itiner 1}
        /******************************************/
        assign c-returnErro = return-value.
    end.
    if can-find(first desp-itiner where desp-itiner.cod-desp = desp-imp.cod-desp) then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex desp-itiner 1}
        /******************************************/
        assign c-returnErro = return-value.    
    end.
    
    if c-returnErro <> "" then do:
        assign i-seq-erro = i-seq-erro + 1.        
        run utp/ut-msgs.p (input "msg":U,
                           input 5,
                           input c-return1 + "~~" + c-returnErro).
        create tt-bo-erro.        
        assign tt-bo-erro.i-sequen   = i-seq-erro
               tt-bo-erro.cd-erro    = 3
               tt-bo-erro.parametros = c-return1 + "~~" + c-returnErro.
               tt-bo-erro.mensagem   = return-value.
    end.
         
    for each form-desp-imp no-lock:
        do i-cont = 1 to 5:
            if form-desp-imp.cod-desp-form[i-cont] = desp-imp.cod-desp then do:
                assign i-seq-erro = i-seq-erro + 1.
                run utp/ut-msgs.p (input "msg":U,
                                   input 17103,
                                   input string(desp-imp.cod-desp) + "~~" + string(form-desp-imp.cod-desp)).
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 17103
                       tt-bo-erro.mensagem = return-value.
            end.         
        end.
    end.       
     
    if not can-find(first tt-bo-erro) then do:
        if avail {&TABLE-NAME} then do:
            run cxbo/bocx105.p persistent set h-bocx105.
            RUN openQueryStatic IN h-bocx105 (INPUT "Main":U) NO-ERROR.
            for each form-desp-imp where form-desp-imp.cod-desp = {&TABLE-NAME}.cod-desp no-lock:
                run goToKey in h-bocx105 (input form-desp-imp.cod-desp,
                                          input form-desp-imp.sequencia).                
                if return-value = "OK":U then do:
                        run deleteRecord in h-bocx105.
                        if return-value = "NOK":U then do:
                           delete procedure h-bocx105.
                           assign h-bocx105 = ?.
                           undo, leave.
                        end.
                end.                                                
            end.
            delete procedure h-bocx105.
            assign h-bocx105 = ?.
            run executeDelete.
        end.
    end.    
 
    if l-query then
        get next {&QUERY-NAME}
            no-lock no-wait.
    else
        find next {&TABLE-NAME}
            no-lock no-error.

    if not avail {&TABLE-NAME} then do:
       if l-query then
           get prev {&QUERY-NAME}
               no-lock no-wait.
       else
           find prev {&TABLE-NAME}
               no-lock no-error.
    end.
    assign r-chave = rowid({&TABLE-NAME}).
    
    run endMethod("validateDelete").
        
end procedure.
 
procedure validateCreate:
    /*
    **  Valida criacao da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.
    def var i-auto-num as integer no-undo.
    
    run initializeValidate.
    run startMethod ("validateCreate").
 
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
 
    find first rowObject
        no-lock no-error.
    
    if rowObject.cod-desp = ? or rowObject.cod-desp = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp cod-desp 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.descricao = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
