def var identificador as char no-undo.
assign identificador = "C":U.
&else
def var identificador as int no-undo.
assign identificador = 1.
&endif
   
&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.001
&scoped-define FIRST-TABLE-IN-QUERY desp-imp
&scoped-define QUERY-NAME qTable
