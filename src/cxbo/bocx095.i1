procedure executeUpdate:
    /*
    **  Executa Update
    */
    
    buffer-copy RowObject except r-rowid cod-desp to {&TABLE-NAME}.
    
end procedure.
 
procedure initializeValidate:
    /*
    **  Inicializa Validate
    */
 
    run startMethod ("initializeValidade").
 
    run endMethod   ("initializeValidade").
end procedure.
 
procedure findCodigo:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter i-cod-desp as inte no-undo.
    def output parameter c-return as char no-undo.
 
    find desp-imp where
        desp-imp.cod-desp = i-cod-desp
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex desp-imp 1}        
        /******************************************/        
        run utp/ut-msgs.p (input "msg":U,
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.

procedure findRowidDespImp:
    def input  param p-cod-desp like desp-imp.cod-desp no-undo.
    def output param p-rowid      as rowid             no-undo.
    
    find desp-imp no-lock
         where desp-imp.cod-desp = p-cod-desp no-error.
    if avail desp-imp then
        assign p-rowid = rowid(desp-imp).
    else                 
        assign p-rowid = ?.
        
end procedure.

procedure retornaDescDespesa:
    /*
    **  Retorna descricao do codigo da despesa da tabela Desp-imp
    */

    def input  parameter p-cod-desp  like desp-imp.cod-desp.
    def output parameter p-desc-desp like desp-imp.descricao.
        
    find desp-imp 
        where desp-imp.cod-desp = p-cod-desp no-lock no-error.
    if avail desp-imp then 
        assign p-desc-desp = desp-imp.descricao.
    else
        assign p-desc-desp = "".        
     
end procedure.

procedure validateFields:

    /*
    **  Valida Fields
    */
    
    /********************************************
    * Engenharia Contabilizacao de Despesas     *
    ********************************************/
    DEFINE VARIABLE c-cod-espec-padr AS CHARACTER NO-UNDO.
    DEFINE VARIABLE c-parametro      AS CHARACTER FORMAT "x(3)" NO-UNDO.
    
    find first rowObject
        no-lock no-error.
        
    run startMethod ("validateFields").    
    

    /* Engenharia Rateio Incoterm */
    &if '{&bf_mat_versao_ems}' >= '2.062' &then
        IF  rowObject.cod-incoterm-rat = ? then do:
            create tt-bo-erro.
            /* Inicio -- Projeto Internacional */
            {utp/ut-liter.i "C¢digo_Incoterm_de_Rateio_Inv†lido" *}
            assign tt-bo-erro.parametros = RETURN-VALUE.
            run utp/ut-msgs.p (input "msg":U,
                               input 17006,
                               input tt-bo-erro.parametros).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 17006
                   tt-bo-erro.mensagem     = return-value
                   tt-bo-erro.errorhelp    = return-value.
        end.
        IF  rowObject.cod-incoterm-rat <> ?
        AND rowObject.cod-incoterm-rat <> "" THEN DO:
    &else
        IF  SUBSTRING(rowObject.char-1,16,3) = ? or
            SUBSTRING(rowObject.char-1,16,3) = "?" then do:
            create tt-bo-erro.
            /* Inicio -- Projeto Internacional */
            {utp/ut-liter.i "C¢digo_Incoterm_de_Rateio_Inv†lido" *}
            assign tt-bo-erro.parametros = RETURN-VALUE.
            run utp/ut-msgs.p (input "msg":U,
                               input 17006,
                               input tt-bo-erro.parametros).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 17006
                   tt-bo-erro.mensagem     = return-value
                   tt-bo-erro.errorhelp    = return-value.
        end.
        IF  SUBSTRING(rowObject.char-1,16,3) <> ?
        AND SUBSTRING(rowObject.char-1,16,3) <> "" THEN DO:
    &endif
    
         IF NOT CAN-FIND(FIRST inco-cx
                         WHERE inco-cx.cod-incoterm = &if '{&bf_mat_versao_ems}' >= '2.062' &then
                                                          rowObject.cod-incoterm-rat
                                                      &else
                                                          SUBSTRING(rowObject.char-1,16,3)
                                                      &endif) THEN DO:
                                                      
               &if '{&bf_mat_versao_ems}' >= '2.062' &then
                   ASSIGN c-parametro = rowObject.cod-incoterm-rat.
               &else
                   ASSIGN c-parametro = SUBSTRING(rowObject.char-1,16,3).
               &endif
               
              if  c-parametro <> "?" then do:
                  create tt-bo-erro.
                  /* Inicio -- Projeto Internacional */
                  {utp/ut-liter.i "Incoterm" *}
                  assign tt-bo-erro.parametros = RETURN-VALUE.
                  /* Inicio -- Projeto Internacional */
                  DEFINE VARIABLE c-lbl-liter-incoterm AS CHARACTER NO-UNDO.
                  {utp/ut-liter.i "Incoterm" *}
                  ASSIGN c-lbl-liter-incoterm = TRIM(RETURN-VALUE).
                  DEFINE VARIABLE c-lbl-liter-c-parametro AS CHARACTER NO-UNDO.
                  {utp/ut-liter.i "c-parametro" *}
                  ASSIGN c-lbl-liter-c-parametro = TRIM(RETURN-VALUE).
                  run utp/ut-msgs.p (input "msg":U,
                                     input 2,
                                     input c-lbl-liter-incoterm + " " + "~~" + " " + c-lbl-liter-c-parametro).
                                     
            
                  assign tt-bo-erro.i-sequen     = i-seq-erro
                         tt-bo-erro.cd-erro      = 2
                         tt-bo-erro.mensagem     = return-value.
              end.
         END.
         ELSE DO:
         
             IF CAN-FIND(FIRST desp-incoterm
                         WHERE desp-incoterm.cod-desp     = RowObject.cod-desp
                         AND   desp-incoterm.cod-incoterm = &if '{&bf_mat_versao_ems}' >= '2.062' &then
                                                                 rowObject.cod-incoterm-rat
                                                            &else
                                                                  SUBSTRING(rowObject.char-1,16,3)
                                                            &endif) THEN DO: 
                                                            
                &if '{&bf_mat_versao_ems}' >= '2.062' &then
                   ASSIGN c-parametro = rowObject.cod-incoterm-rat.
                &else
                   ASSIGN c-parametro = SUBSTRING(rowObject.char-1,16,3).
                &endif
                                                            
                create tt-bo-erro.
                assign tt-bo-erro.parametros = string(RowObject.cod-desp).
                
                run utp/ut-msgs.p (input "msg":U,
                                   input 30164,
                                   input c-parametro + "~~" + tt-bo-erro.parametros).

                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 30164
                       tt-bo-erro.mensagem     = return-value.
                       
                run utp/ut-msgs.p (input "help":U,
                                   input 30164,
                                   input c-parametro + "~~" + tt-bo-erro.parametros).
                                   
                assign tt-bo-erro.errorhelp = return-value.

             END.                                                            

         END.                                                 

        END.
    
    if rowObject.descricao = ? or rowObject.descricao = "" then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp descricao 1}        
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).
        run utp/ut-msgs.p (input "msg":U,
                            input 265,
                            input return-value).
         
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
   
    end.
 
    if rowObject.fat-ponder = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp fat-ponder 1}
        /******************************************/        
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                            input 265,
                            input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.   
    end.
      
    if rowObject.identif = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp identific 1}        
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.   
    end.
 
    if rowObject.inc-base-icms = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp inc-base-icms 1}        
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.   
    end.
 
    if rowObject.inc-base-ipi = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */        
        {utp/ut-field.i mgcex desp-imp inc-base-ipi 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.   
    end. 
 
    if rowObject.inc-val-duplic = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp inc-val-deuplic 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.   
    end.
 
    if rowObject.inc-val-embal = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp inc-val-embal 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.   
    end.
 
    if rowObject.inc-val-frete = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp inc-val-frete 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.   
    end.
 
    if rowObject.inc-val-icms = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp inc-val-icms 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.   
    end.
 
    if rowObject.inc-val-ipi = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp inc-val-ipi 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.   
    end.
 
    if rowObject.inc-val-outras-desp = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        {utp/ut-field.i mgcex desp-imp inc-val-outras-desp 1}
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp inc-val-outras-desp 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
