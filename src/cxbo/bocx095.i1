{include/boini.i}
 
{cxbo/bocx095.i RowObject} 

define temp-table tt-form-desp-imp no-undo like form-desp-imp.
 
DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.
define buffer b-desp-imp for desp-imp.

assign l-exec-cd1070 = no.

procedure setConstraint1:
 
end procedure.

procedure setConstraint2:
    def input parameter p-cod-desp as char no-undo.
    def input parameter p-cod-tipo as char no-undo.    
 
    assign c-cod-desp = integer(p-cod-desp).
    assign c-cod-tipo = integer(p-cod-tipo).    

end procedure.

procedure setConstraint3:
    def input parameter p-cod-desp as char no-undo.
 
    assign c-cod-desp = integer(p-cod-desp).

end procedure.

procedure setConstraint4:
    def input parameter p-cod-desp-ini as integer no-undo.
    def input parameter p-cod-desp-fim as integer no-undo.
 
    assign i-cod-desp-ini = p-cod-desp-ini
           i-cod-desp-fim = p-cod-desp-fim.
end procedure.

procedure setConstraint5:

    def input parameter p-desc-desp as char no-undo.
 
    assign c-desc-desp = p-desc-desp.

end procedure.

procedure setConstraint6:
    def input parameter p-desc-desp-ini as char no-undo.
    def input parameter p-desc-desp-fim as char no-undo.
 
    assign c-desc-desp-ini = p-desc-desp-ini
           c-desc-desp-fim = p-desc-desp-fim.
end procedure.

procedure setaProgExec:
    def input parameter p-cd1070 as logical no-undo.
    
    assign l-exec-cd1070 = p-cd1070.
    
end procedure.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where {&TABLE-NAME}.cod-desp >= c-cod-desp and 
                                                                  {&TABLE-NAME}.tipo     >= c-cod-tipo no-lock by desp-imp.cod-desp.    
        when 3 THEN 
            open query {&QUERY-NAME} for each {&TABLE-NAME} where &if ("&emsDBtype") <> "PROGRESS" &THEN
                                                                      {&TABLE-NAME}.cod-desp > c-cod-desp OR
                                                                      {&TABLE-NAME}.cod-desp = c-cod-desp no-lock.
                                                                  &ELSE 
                                                                      {&TABLE-NAME}.cod-desp >= c-cod-desp NO-LOCK.
                                                                  &endif
        when 4 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where 
                                              {&TABLE-NAME}.cod-desp >= i-cod-desp-ini and
                                              {&TABLE-NAME}.cod-desp <= i-cod-desp-fim
                                               no-lock.      
                                               
        when 5 THEN 
            open query {&QUERY-NAME} for each {&TABLE-NAME} where &if ("&emsDBtype") <> "PROGRESS" &THEN
                                                                      {&TABLE-NAME}.descricao > c-desc-desp OR
                                                                      {&TABLE-NAME}.descricao = c-desc-desp no-lock.
                                                                  &ELSE 
                                                                      {&TABLE-NAME}.descricao >= c-desc-desp NO-LOCK.
                                                                  &endif
        when 6 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} where 
                                              {&TABLE-NAME}.descricao >= c-desc-desp-ini and
                                              {&TABLE-NAME}.descricao <= c-desc-desp-fim no-lock
                                                  by desp-imp.descricao
                                                      by desp-imp.cod-desp.        

  
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.
 
