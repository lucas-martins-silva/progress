def var c-desc-desp-ini as char no-undo.
def var c-desc-desp-fim as char no-undo.
def var c-desc-desp     as char no-undo.
def var c-cod-desp      as integer no-undo.
def var c-cod-tipo      as integer no-undo.
def var i-cont          as integer no-undo.
def var i-cod-desp-ini  as integer no-undo.
def var i-cod-desp-fim  as integer no-undo.
def var c-return2       as char    no-undo.
def var c-legenda       as character format "x(2000)":U no-undo.
def var c-texto-par     as character format "x(50)":U no-undo.
def var l-exec-cd1070   as logical no-undo.

