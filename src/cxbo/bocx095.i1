                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.inc-val-embal = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp inc-val-embal 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.inc-val-frete = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp inc-val-frete 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.inc-val-icms = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp inc-val-icms 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.inc-val-ipi = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp inc-val-ipi 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.inc-val-outras-desp = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp inc-val-outras-desp 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.inc-val-seguro = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp inc-val-seguro 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.inc-valor-mercad = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp inc-valor-mercad 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end. 

    if rowObject.val-desp = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp val-desp 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    find first tt-bo-erro
        no-lock no-error.
    if not available tt-bo-erro then do:
        find desp-imp where
            desp-imp.cod-desp = rowObject.cod-desp
            no-lock no-error.
        if avail desp-imp then do:
            assign i-seq-erro = i-seq-erro + 1.            
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex desp-imp 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = trim(return-value).            
            run utp/ut-msgs.p (input "msg":U,
                               input 8,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 8
                   tt-bo-erro.mensagem     = return-value.
        end.
    end.

    run validateFields.
    
    find first tt-bo-erro
        no-lock no-error.
    if can-find(first desp-imp where
                desp-imp.cod-desp = rowObject.cod-desp) then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex desp-imp 1}
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).
        /******************************************/
        run utp/ut-msgs.p (input "msg":U,
                          input 8,
                          input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 8
               tt-bo-erro.mensagem     = return-value.
    end.
    
    if not avail tt-bo-erro then do:
       run executeCreate.
       assign r-chave = to-rowid(return-value).
    end.
 
    run endMethod ("validateCreate").
end procedure.

procedure validateCodigo:
    
    def input-output parameter c-fat-ponder     as char no-undo.
    def input-output parameter c-val-desp       as char no-undo.
    def output parameter table for tt-bo-erro.
    def var i-teste as integer no-undo.
    
    run startMethod("validateCodigo").
    assign i-teste = int(c-fat-ponder) no-error.
    if  error-status:error then do:
       assign i-seq-erro = i-seq-erro + 1
              c-fat-ponder = "0".
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp fat-ponder 1}
       /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).       
        run utp/ut-msgs.p (input "msg":U,
                           input 16963,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 16963
               tt-bo-erro.mensagem     = return-value.
    end.
    
    assign i-teste = int(c-val-desp) no-error.
    if  error-status:error then do:
       assign i-seq-erro = i-seq-erro + 1
              c-val-desp = "0".
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex desp-imp val-desp 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 16963,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 16963
               tt-bo-erro.mensagem     = return-value.
    end. 
    run endMethod("validateCodigo").
 end procedure.

procedure executeCopy:
    def input parameter r-chave 	as rowid.
    def input parameter c-cod-desp 	like desp-imp.cod-desp.

    find {&table-name} where rowid({&table-name}) = r-chave no-lock no-error.
    if avail {&table-name} then do:
      for each form-desp-imp of {&table-name} no-lock:
         create tt-form-desp-imp.
         buffer-copy form-desp-imp to tt-form-desp-imp.
         assign tt-form-desp-imp.cod-desp = c-cod-desp.
      end.  
      for each tt-form-desp-imp:
         create form-desp-imp.
         buffer-copy tt-form-desp-imp to form-desp-imp.
      end.
    end.
end procedure.


procedure autoNumber:
    def output parameter i-auto-num as integer no-undo.
    def var i-cont as integer init 1 no-undo. /** variavel de contador **/
    def output parameter table for tt-bo-erro.
        
    {include/boautonum.i "99999" "cod-desp"}
 
end procedure.

procedure retornaDescricao:

 if i-bo-query = 2 then do:
   def input  parameter p-cod-desp as integer.
   def output parameter p-c-descricao   like desp-imp.descricao.
   
      find desp-imp where desp-imp.cod-desp = p-cod-desp no-lock no-error.

   assign p-c-descricao = if avail desp-imp then desp-imp.descricao else " ":U.
  
 end.
 else
    return error.  
end procedure.
 
procedure getCharField:
    define input  parameter c-field as char.
    define output parameter c-value as char.
 
    case c-field:
        when "char-1" then c-value = RowObject.char-1.
        when "char-2" then c-value = RowObject.char-2.
        when "check-sum" then c-value = RowObject.check-sum.
         when "cod-incoterm-rat":U then &if  defined(bf-mat-comex) &then
                                                    c-value = substr(RowObject.char-1,16,3).
                                                &else
                                                    &if '{&bf_mat_versao_ems}':U < '2.062':U &then
                                                        c-value = substr(RowObject.char-1,16,3).
                                                    &else
                                                        c-value = RowObject.cod-incoterm-rat. 
                                                    &endif
                                                &endif
        when "conta-contabil" then c-value = RowObject.conta-contabil.
        when "ct-codigo" then c-value = RowObject.ct-codigo.
        when "descricao" then c-value = RowObject.descricao.
        when "sc-codigo" then c-value = RowObject.sc-codigo.
        &if "{&bf_mat_versao_ems}":U >= "2.062":U &then
        when "dsl-formul-despes":U then c-value = RowObject.dsl-formul-despes.
        &endif
        otherwise return error.
    end case.
end procedure.
 
procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.
 
    case c-field:
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        when "fat-ponder" then c-value = RowObject.fat-ponder.
        when "val-desp" then c-value = RowObject.val-desp.
        otherwise return error.
    end case.
end procedure.
 
procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.
 
    case c-field:
        when "cod-desp" then c-value = RowObject.cod-desp.
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.
        &if '{&bf_mat_versao_ems}' >= '2.062' &then
            when "cod-emitente" then c-value = RowObject.cod-emitente.
        &ENDIF
        when "tipo" then c-value = RowObject.tipo.
            &if '{&bf_mat_versao_ems}' >= '2.05' &then
                when "tp-despesa" then c-value = rowobject.tp-despesa.
            &endif
        otherwise return error.
    end case.
end procedure.
 
procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.
 
    case c-field:
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.
        otherwise return error.
    end case.
end procedure.
 
procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.
 
    case c-field:
        when "gera-custo" then c-value = RowObject.gera-custo.
        when "identif" then c-value = RowObject.identif.
        when "inc-base-icms" then c-value = RowObject.inc-base-icms.
        when "inc-base-ipi" then c-value = RowObject.inc-base-ipi.
        when "inc-despesa-nota" then c-value = RowObject.inc-despesa-nota.
        when "inc-tot-valor" then c-value = RowObject.inc-tot-valor.
        when "inc-val-duplic" then c-value = RowObject.inc-val-duplic.
        when "inc-val-embal" then c-value = RowObject.inc-val-embal.
        when "inc-val-frete" then c-value = RowObject.inc-val-frete.
        when "inc-val-icms" then c-value = RowObject.inc-val-icms.
        when "inc-val-ipi" then c-value = RowObject.inc-val-ipi.
        when "log-incid-base-tax-estatis" then c-value = RowObject.log-incid-base-tax-estatis.
        when "inc-val-outras-desp" then c-value = RowObject.inc-val-outras-desp.
        when "inc-val-seguro" then c-value = RowObject.inc-val-seguro.
        when "inc-valor-mercad" then c-value = RowObject.inc-valor-mercad.
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.
        when "log-imposto" then c-value = RowObject.log-imposto.
        when "log-incid-base-isd" then c-value = RowObject.log-incid-base-isd.
        
        /** 2.1.10 Geraá∆o de Impostos Padr‰es na Inclus∆o das Cotaá‰es **/
        &if '{&bf_mat_versao_ems}' >= '2.062' &then
            when "log-permite-alter-cotac" then c-value = rowobject.log-permite-alter-cotac.
        &endif
        
        WHEN "log-incid-base-pis-val" THEN c-value = &if '{&bf_mat_versao_ems}' >= '2.06' &then
                                                     RowObject.log-incid-base-pis-val
                                                     &else
                                                     if substr(RowObject.char-1,10,1) = '1' then yes else no
                                                     &endif.
        WHEN "log-incid-base-pis-despes" THEN c-value = &if '{&bf_mat_versao_ems}' >= '2.06' &then
                                                        RowObject.log-incid-base-pis-despes
                                                        &else
                                                        if substr(RowObject.char-1,11,1) = '1' then yes else no
                                                        &endif.
        WHEN "log-incid-base-cofins-val" THEN c-value = &if '{&bf_mat_versao_ems}' >= '2.06' &then
                                                        RowObject.log-incid-base-cofins-val
                                                        &else
                                                        if substr(RowObject.char-1,12,1) = '1' then yes else no
                                                        &endif.
        WHEN "log-incid-base-cofins-despes" THEN c-value = &if '{&bf_mat_versao_ems}' >= '2.06' &then
                                                           RowObject.log-incid-base-cofins-despes
                                                           &else
                                                           if substr(RowObject.char-1,13,1) = '1' then yes else no
                                                           &endif.
        otherwise return error.
    end case.
end procedure.

PROCEDURE enableIncotermRat:

    DEFINE INPUT  PARAMETER icod-desp   AS INTEGER    NO-UNDO.
    DEFINE OUTPUT PARAMETER pl-habilita AS LOGICAL    NO-UNDO.

    {cdp/cd4300.i3}  /* include tratamento atributo livre */
    {cxbo/bocx250.i50} /* include tratamento atributo livre */

    ASSIGN pl-habilita = YES.

    blk_param_imp:
    FOR EACH param-imp NO-LOCK:

        {cdp/cd4300.i4 "yes" param-imp.char-1}

        /*--- busca despesa de importacao ---*/
        {cxbo/bocx250.i51 "yes"}

        IF  icod-desp = i-desp-ii-i50                     /* Despesa p/ o II */ 
        &if '{&bf_mat_versao_ems}' >= '2.062' &then
            OR  icod-desp = param-imp.cdn-despes-impto-pis    /* Despesa p/ o PIS */    
            OR  icod-desp = param-imp.cdn-despes-impto-cofins /* Despesa p/ o COFINS */ 
            OR  icod-desp = param-imp.cdn-despes-impto-ipi    /* Despesa p/ o IPI */ 
            OR  icod-desp = param-imp.cdn-despes-impto-icms   /* Despesa p/ o ICMS */ 
        &endif
        THEN DO:

            ASSIGN pl-habilita = NO.

            LEAVE blk_param_imp.

        END.                    

    END.

END PROCEDURE.

procedure retornaComexImplantado:
    define output param l-implantado as logical no-undo.
    
    if not avail param-global then
       find first param-global no-lock no-error.
       
    if  avail param-global
    and (  param-global.modulo-07
        or param-global.modulo-ex) then
        assign l-implantado = yes.
    else
        assign l-implantado = no.
        
    return "OK":U.
end.

procedure retornaListaVariaveis:
    define input  parameter cModulo as character no-undo.
    define output parameter table for tt-lista.

    FOR EACH tt-lista:
        DELETE tt-lista.
    END.

    find first param-global no-lock no-error.

    if  cModulo = "IMP" 
    and param-global.modulo-07 then do:

        create tt-lista.
        assign tt-lista.cod-lista = "INCOTERM"
               tt-lista.des-lista = "Incoterm"
               tt-lista.tipo-res  = 2.
    
        create tt-lista.
        assign tt-lista.cod-lista = "VIA-TRANSPORTE"
               tt-lista.des-lista = "Via de Transporte"
               tt-lista.tipo-res  = 2.

        create tt-lista.
        assign tt-lista.cod-lista = "VAL-MERC-LIQ"
               tt-lista.des-lista = "Valor da mercadoria l°quido"
               tt-lista.tipo-res  = 1.

        create tt-lista.
        assign tt-lista.cod-lista = "VAL-MERC-BRUTO"
               tt-lista.des-lista = "Valor da mercadoria bruto"  
               tt-lista.tipo-res  = 1.

        create tt-lista.
        assign tt-lista.cod-lista = "VAL-NEGOC-LIQ"
               tt-lista.des-lista = "Valor negociado (incoterm) l°quido"
               tt-lista.tipo-res  = 1.

        create tt-lista.
        assign tt-lista.cod-lista = "VAL-NEGOC-BRUTO"
               tt-lista.des-lista = "Valor negociado (incoterm) bruto"
               tt-lista.tipo-res  = 1.

        create tt-lista.
        assign tt-lista.cod-lista = "PESO-LIQ"
               tt-lista.des-lista = "Peso l°quido"
               tt-lista.tipo-res  = 1.

        create tt-lista.
        assign tt-lista.cod-lista = "PESO-BRUTO" 
               tt-lista.des-lista = "Peso bruto"
               tt-lista.tipo-res  = 1.

        create tt-lista.
        assign tt-lista.cod-lista = "DIST-ITINER"
               tt-lista.des-lista = "DistÉncia do itiner†rio"
               tt-lista.tipo-res  = 1.

        create tt-lista.
        assign tt-lista.cod-lista = "DIAS-ITINER"
               tt-lista.des-lista = "Dias do itiner†rio"
               tt-lista.tipo-res  = 1.

        create tt-lista.
        assign tt-lista.cod-lista = "DIAS-DESPACHO"
               tt-lista.des-lista = "Dias no ponto de despacho"
               tt-lista.tipo-res  = 1.

        create tt-lista.
        assign tt-lista.cod-lista = "DIAS-EMBARQUE"
               tt-lista.des-lista = "Dias no ponto de embarque"
               tt-lista.tipo-res  = 1.

        create tt-lista.
        assign tt-lista.cod-lista = "DIAS-EADI"
               tt-lista.des-lista = "Dias no ponto de EADI"
               tt-lista.tipo-res  = 1.

        create tt-lista.
        assign tt-lista.cod-lista = "DIAS-NACIONALIZ"
               tt-lista.des-lista = "Dias no ponto de nacionalizaá∆o"
               tt-lista.tipo-res  = 1.

        create tt-lista.
        assign tt-lista.cod-lista = "DIAS-CHEGADA"
               tt-lista.des-lista = "Dias no ponto de chegada"
               tt-lista.tipo-res  = 1.

        create tt-lista.
        assign tt-lista.cod-lista = "CUBAGEM"
               tt-lista.des-lista = "Cubagem"
               tt-lista.tipo-res  = 1.

        create tt-lista.
        assign tt-lista.cod-lista = "TAX-BAS-SEGURO"
               tt-lista.des-lista = "Taxa b†sica de seguro do item"
               tt-lista.tipo-res  = 1.

        create tt-lista.
        assign tt-lista.cod-lista = "TAX-IMP-SEGURO"
               tt-lista.des-lista = "Taxa de imposto no seguro"
               tt-lista.tipo-res  = 1.
    end.

    if  cModulo = "EXP" 
    and param-global.modulo-ex then do:

        create tt-lista.
        assign tt-lista.cod-lista = "DIST-ITINER"
               tt-lista.des-lista = "DistÉncia do itiner†rio"
               tt-lista.tipo-res  = 1.

        create tt-lista.
        assign tt-lista.cod-lista = "DIAS-ITINER"
               tt-lista.des-lista = "Dias do itiner†rio"
               tt-lista.tipo-res  = 1.
    end.

    return "OK":U.
end procedure.

procedure retornaListaDespesas:
    define input  parameter cModulo as character no-undo.
    define output parameter table for tt-lista.

    FOR EACH tt-lista:
        DELETE tt-lista.
    END.

    find first param-global no-lock no-error.

    for each desp-imp fields (cod-desp descricao) no-lock:

        if  cModulo = "IMP" 
        and param-global.modulo-07 then do:

            create tt-lista.
            assign tt-lista.cod-lista = "COD-DESP-" + trim(string(desp-imp.cod-desp))
                   tt-lista.des-lista = desp-imp.descricao
                   tt-lista.tipo-res  = 2.
        end.

        if  (    cModulo = "EXP" 
             and param-global.modulo-ex)
        or  (    cModulo = "IMP" 
             and param-global.modulo-07) then do:

            create tt-lista.
            assign tt-lista.cod-lista = "VAL-DESP-" + trim(string(desp-imp.cod-desp))
                   tt-lista.des-lista = desp-imp.descricao
                   tt-lista.tipo-res  = 1.
        end.
    end.

    return "OK":U.
end procedure.

procedure retornaListaIncoterms:
    define input  parameter cModulo as character no-undo.
    define output parameter table for tt-lista.

    FOR EACH tt-lista:
        DELETE tt-lista.
    END.

    find first param-global no-lock no-error.

    if  cModulo = "IMP" 
    and param-global.modulo-07 then do:

        for each inco-cx fields (cod-incoterm descricao) no-lock:

            create tt-lista.
            assign tt-lista.cod-lista = "VAL-INCO-" + inco-cx.cod-incoterm
                   tt-lista.des-lista = inco-cx.descricao
                   tt-lista.tipo-res  = 1.
        end.
    end.

    return "OK":U.
end procedure.

procedure validaFormulaDespesa:
    define input  parameter cFormula as character format "x(2000)":U no-undo.
    define input  parameter cModulo  as character                    no-undo.
    define output parameter table for RowErrors.

    FOR EACH tt-var:
        DELETE tt-var.
    END.
    FOR EACH tt-formula:
        DELETE tt-formula.
    END.
    FOR EACH RowErrors:
        DELETE RowErrors.
    END.
    
    run retornaListaVariaveis (input  cModulo,
                               output table tt-lista).

    find first inco-cx no-lock no-error.

    for each tt-lista:

        if  tt-lista.cod-lista = "INCOTERM" then do:

            create tt-var.
            assign tt-var.nome     = tt-lista.cod-lista
                   tt-var.valor    = 0
                   tt-var.texto    = inco-cx.cod-incoterm
                   tt-var.tipo-res = tt-lista.tipo-res.
        end.
        else 
            if  tt-lista.cod-lista = "VIA-TRANSPORTE" then do:

                create tt-var.
                assign tt-var.nome     = tt-lista.cod-lista
                       tt-var.valor    = 0
                       tt-var.texto    = "Rodovi†rio"
                       tt-var.tipo-res = tt-lista.tipo-res.
            end.
            else do:

                create tt-var.
                assign tt-var.nome     = tt-lista.cod-lista
                       tt-var.valor    = 1
                       tt-var.tipo-res = tt-lista.tipo-res.
            end.
    end.

    run retornaListaDespesas (input  cModulo,
                              output table tt-lista).

    find first b-desp-imp no-lock no-error.

    for each tt-lista:

        if  substr(tt-lista.cod-lista, 1, 8) = "COD-DESP" then do:

            create tt-var.
            assign tt-var.nome     = tt-lista.cod-lista
                   tt-var.texto    = string(b-desp-imp.cod-desp)
                   tt-var.tipo-res = 2.
        end.
        else 
            if  substr(tt-lista.cod-lista, 1, 8) = "VAL-DESP" then do:
                create tt-var.
                assign tt-var.nome     = tt-lista.cod-lista
                       tt-var.valor    = 1
                       tt-var.tipo-res = 1.
            end.
    end.

    run retornaListaIncoterms (input  cModulo,
                               output table tt-lista).
    for each tt-lista:

        create tt-var.
        assign tt-var.nome     = tt-lista.cod-lista
               tt-var.valor    = 1
               tt-var.tipo-res = 1.
    end.

    create tt-formula.
    assign tt-formula.formula               = cFormula
           tt-formula.cod-versao-integracao = 001.

    run cdp/cdapi020.p (input-output table tt-formula,
                        input table tt-var,
                        input-output table tt-erro,
                        input yes).
    for each tt-erro:
        create RowErrors.
        assign RowErrors.ErrorSequence    = tt-erro.i-sequen
               RowErrors.ErrorNumber      = tt-erro.cd-erro
               RowErrors.ErrorDescription = tt-erro.mensagem
               RowErrors.ErrorType        = "EMS"
               RowErrors.ErrorSubType     = "ERROR".
    end.

    return "OK":U.
end procedure.

procedure GeraLegenda:
    define input  parameter cFormula as character format "x(2000)":U no-undo.
    define output parameter cLegenda as character format "x(2000)":U no-undo.

    define variable i-cont as integer no-undo.

    FOR EACH tt-listas:
        DELETE tt-listas.
    END.
    
    run retornaListaVariaveis (input "IMP",
                               output table tt-listas append).
    run retornaListaDespesas  (input "IMP",
                               output table tt-listas append).
    run retornaListaIncoterms (input "IMP",
                               output table tt-listas append).
                                                    
    do  i-cont = 1 to num-entries(cFormula," "):

        for first tt-listas
            where tt-listas.cod-lista = entry(i-cont, cFormula, " ") no-lock: end.
        if  avail tt-listas then do:
          
            assign cLegenda = cLegenda + " " + replace(entry(i-cont, cFormula, " "), entry(i-cont, cFormula, " "), tt-listas.des-lista).
        end.
        else do:
    
            assign cLegenda = cLegenda + " " + entry(i-cont, cFormula, " ").
        end.
    end.

    return "OK":U.
end procedure.

procedure geraTTvar:
    define input  parameter cFormula as character format "x(2000)":U no-undo.
    define output parameter table for tt-var.

    FOR EACH tt-listas:
        DELETE tt-listas.
    END.
    FOR EACH tt-var:
        DELETE tt-var.
    END.
    
    run retornaListaVariaveis (input "IMP",
                               output table tt-listas append).
    run retornaListaDespesas  (input "IMP",
                               output table tt-listas append).
    run retornaListaIncoterms (input "IMP",
                               output table tt-listas append).

    do  i-cont = 1 to num-entries(cFormula," "):

        for first tt-listas
            where tt-listas.cod-lista = entry(i-cont, cFormula, " ") no-lock: end.
        if  avail tt-listas then do:

            create tt-var.
            assign tt-var.nome     = tt-listas.cod-lista
                   tt-var.tipo-res = tt-listas.tipo-res.
        end.
    end.

    return "OK":U.
end procedure.

procedure calculaFormula:
    define input  parameter cFormula as character format "x(2000)":U no-undo.
    define input  parameter table for tt-var.
    define output parameter d-resultado as decimal format ">>>,>>>,>>>,>>9,99999":U no-undo.
    define output parameter table for RowErrors.

    FOR EACH RowErrors:
        DELETE RowErrors.
    END.
    FOR EACH tt-formula:
        DELETE tt-formula.
    END.

    create tt-formula.
    assign tt-formula.formula               = cFormula
           tt-formula.cod-versao-integracao = 001.

    run cdp/cdapi020.p (input-output table tt-formula,
                        input table tt-var,
                        input-output table tt-erro,
                        input yes).
    if  not can-find(first tt-erro) then do:
        find first tt-formula no-error.
        if  avail tt-formula then
            assign d-resultado = tt-formula.result.
    end.
    else do:
        for each tt-erro:
            create RowErrors.
            assign RowErrors.ErrorSequence    = tt-erro.i-sequen
                   RowErrors.ErrorNumber      = tt-erro.cd-erro
                   RowErrors.ErrorDescription = tt-erro.mensagem
                   RowErrors.ErrorType        = "EMS"
                   RowErrors.ErrorSubType     = "ERROR".
        end.
        return "NOK":U.
    end.
    
    return "OK":U.
end procedure.

