&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice unidrf-id
  Parameters:  
               recebe valor do campo cdn-unid-recta-feder
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcdn-unid-recta-feder LIKE unid-rf.cdn-unid-recta-feder NO-UNDO.

    FIND FIRST bfunid-rf WHERE 
        bfunid-rf.cdn-unid-recta-feder = pcdn-unid-recta-feder NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfunid-rf THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfunid-rf)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryByCodDesc DBOProgram 
PROCEDURE openQueryByCodDesc :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
OPEN QUERY {&QUERYNAME} FOR EACH  {&TABLENAME}
                            WHERE {&TABLENAME}.cdn-unid-recta-feder >= c-cod-unid-rf-ini
                            AND   {&TABLENAME}.cdn-unid-recta-feder <= c-cod-unid-rf-fim
                            AND   {&TABLENAME}.des-descr >= c-des-descr-ini
                            AND   {&TABLENAME}.des-descr <= c-des-descr-fim NO-LOCK INDEXED-REPOSITION.

RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

