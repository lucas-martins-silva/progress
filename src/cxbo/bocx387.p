&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE setConstraintByCodDesc DBOProgram 
PROCEDURE setConstraintByCodDesc :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
DEF INPUT PARAM p-cod-unid-rf-ini LIKE {&TABLENAME}.cdn-unid-recta-feder NO-UNDO.
DEF INPUT PARAM p-cod-unid-rf-fim LIKE {&TABLENAME}.cdn-unid-recta-feder NO-UNDO.
DEF INPUT PARAM p-des-descr-ini LIKE {&TABLENAME}.des-descr NO-UNDO.
DEF INPUT PARAM p-des-descr-fim LIKE {&TABLENAME}.des-descr NO-UNDO.

ASSIGN c-cod-unid-rf-ini = p-cod-unid-rf-ini 
       c-cod-unid-rf-fim = p-cod-unid-rf-fim       
       c-des-descr-ini = p-des-descr-ini       
       c-des-descr-fim = p-des-descr-fim.

RETURN "OK":U.
END PROCEDURE.

