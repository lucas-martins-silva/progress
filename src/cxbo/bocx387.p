&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/
    
    IF pType = "Create" THEN DO:
        IF RowObject.cdn-unid-recta-feder = 0 THEN DO:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-codigo-invalido AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "C¢digo_Inv†lido" *}
            ASSIGN c-lbl-liter-codigo-invalido = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-liter-nao-e-permitido-inserir-uma-re AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "N∆o_Ç_permitido_inserir_uma_Receita_Federal_com_c¢digo_igual_a_0" *}
            ASSIGN c-lbl-liter-nao-e-permitido-inserir-uma-re = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                  &ErrorNumber="17006"
                  &ErrorType="EMS"
                  &ErrorParameters="c-lbl-liter-codigo-invalido + '!' + '~~~~' + c-lbl-liter-nao-e-permitido-inserir-uma-re + '.'"}
        END.                 
        FIND FIRST unid-rf
            WHERE unid-rf.cdn-unid-recta-feder = RowObject.cdn-unid-recta-feder NO-LOCK NO-ERROR.

        IF AVAIL unid-rf THEN DO:
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-unidade-receita-federal AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Unidade_Receita_Federal" *}
            ASSIGN c-lbl-liter-unidade-receita-federal = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                  &ErrorNumber="1"
                  &ErrorType="EMS"
                  &ErrorParameters="c-lbl-liter-unidade-receita-federal"}
        END.
    END.

    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

