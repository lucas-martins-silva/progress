def var c-1   as char no-undo. 
def var c-2   as char no-undo.
def var c-texto-fim as char no-undo.
def var c-idioma-ini as char no-undo.
def var c-idioma-fim as char no-undo.

&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.001
&scoped-define FIRST-TABLE-IN-QUERY docs-processo-exp
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME docs-processo-exp
 
{cdp/cdcfgdis.i} 
 
{include/boini.i}
 
{cxbo/bocx175.i RowObject}
 
DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.
 
procedure setConstraint1:


end procedure.

procedure setConstraint2:
def input parameter c-cod-estabel as char no-undo.
def input parameter c-nr-proc-exp as char no-undo.

assign c-1 = c-cod-estabel
       c-2 = c-nr-proc-exp.
end procedure.


procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock where {&TABLE-NAME}.cod-estabel = c-1
                                                                      and {&TABLE-NAME}.nr-proc-exp = c-2.            
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.
 
