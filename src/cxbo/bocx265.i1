{cdp/cdcfgdis.i} /* Definicao de pre-processadores */

DEFINE VAR c-cod-estabel    as char    no-undo.
DEFINE VAR c-nr-proc-exp    as char    no-undo.
DEFINE VAR c-serie          as char    no-undo.
DEFINE VAR c-nr-nota        as char    no-undo.

/*Definicao das variaveis da ut-glob.i que tambÇm sao utilizadas no magnus*/
&if defined(bf-dis-comex) &then
 def new Global shared var c-seg-usuario as char format "x(12)" no-undo.
 def new global shared var i-pais-impto-usuario as integer format ">>9" no-undo.
&endif

&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.001
&scoped-define FIRST-TABLE-IN-QUERY proc-it-nota-fisc
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME proc-it-nota-fisc

{include/boini.i}

{cxbo/bocx265.i tt-proc-it-nota-fisc}
{cxbo/bocx265.i rowObject}

DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

procedure setConstraint1:

end procedure.

PROCEDURE setConstraint2:
  
  def input  parameter p-cod-estabel like proc-nota-fiscal.cod-estabel. 
  def input  parameter p-nr-proc-exp like proc-nota-fiscal.nr-proc-exp.
  def input  parameter p-nr-nota-fis like proc-nota-fiscal.nr-nota-fis. 
  def input  parameter p-serie       like proc-nota-fiscal.serie.

  assign  c-cod-estabel = p-cod-estabel
          c-nr-proc-exp = p-nr-proc-exp
          c-nr-nota     = p-nr-nota-fis
          c-serie       = p-serie.

END PROCEDURE.

procedure setConstraint3:
    def input parameter r-chave as rowid no-undo.
    find processo-exp no-lock
         where rowid(processo-exp) = r-chave no-error.
end procedure.


procedure openQuery:
    define input parameter i-abertura as integer no-undo.

    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where {&TABLE-NAME}.cod-estabel = c-cod-estabel and
                                                                  {&TABLE-NAME}.nr-proc-exp = c-nr-proc-exp and
                                                                  {&TABLE-NAME}.nr-nota-fis = c-nr-nota and
                                                                  {&TABLE-NAME}.serie       = c-serie no-lock.
        when 3 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} of processo-exp no-lock.
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.

{include/bostrmet.i}
{include/boendmet.i}
&if defined(bf-dis-comex) &then    
&else
    {include/bocomver.i}
    {include/bogetver.i}
    {utp/ut-glob.i}
&endif
{include/bonav.i}
{include/bofind.i}
