procedure initializeValidate:
    /*
    **  Inicializa Validate
    */ 
    run startMethod ("initializeValidade").
 
    run endMethod   ("initializeValidade").
end procedure.

procedure findCh_container:
    /*  
    ** Procura pelo indice, caso nao ache,
    ** retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("validateFields").

    def input parameter p-id-container like {&table-name}.id-container no-undo.
    def output parameter c-return as char no-undo.
    
    find first {&TABLE-NAME}  no-lock
         where {&table-name}.id-container = p-id-container no-error.
    if not avail {&TABLE-NAME} then do:
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-table.i mgcex proc-container-emb 1}
       run utp/ut-msgs.p (input "msg",
                          input 2,
                          input return-value).
       assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("validateFields").

end procedure.

procedure findCh_item-embal:
    /*  
    ** Procura pelo indice, caso nao ache,
    ** retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("validateFields").

    def input parameter p-cod-estabel  like {&TABLE-NAME}.cod-estabel  no-undo.
    def input parameter p-serie        like {&TABLE-NAME}.serie        no-undo.
    def input parameter p-nr-nota-fis  like {&TABLE-NAME}.nr-nota-fis  no-undo.
    def input parameter p-nr-seq-fat   like {&TABLE-NAME}.nr-seq-fat   no-undo.
    def input parameter p-it-codigo    like {&table-name}.it-codigo    no-undo.
    def input parameter p-sigla-emb    like {&TABLE-NAME}.sigla-emb    no-undo.
    def output parameter c-return as char no-undo.
    
    for first {&TABLE-NAME} no-lock
         where {&TABLE-NAME}.cod-estabel  = p-cod-estabel and
               {&TABLE-NAME}.serie        = p-serie       and
               {&TABLE-NAME}.nr-nota-fis  = p-nr-nota-fis and
               {&TABLE-NAME}.nr-seq-fat   = p-nr-seq-fat  and
               {&table-name}.it-codigo    = p-it-codigo   and
               {&TABLE-NAME}.sigla-emb    = p-sigla-emb
               use-index ch-item-embal:
    end.
    if not avail {&TABLE-NAME} then do:
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-table.i mgcex proc-container-emb 1}
       run utp/ut-msgs.p (input "msg",
                          input 2,
                          input return-value).
       assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("validateFields").

end procedure.

procedure findCh_proc-exp:
    /*  
    ** Procura pelo indice, caso nao ache,
    ** retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("validateFields").

    def input parameter p-nr-proc-exp  like proc-container.nr-proc-exp  no-undo.
    def input parameter p-cod-estabel  like proc-container.cod-estabel  no-undo.
