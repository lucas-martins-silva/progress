end procedure.
 
procedure findPk_{&TABLE-NAME}:
    /*  
    ** Procura pelo indice, caso nao ache, 
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("validateFields").

    def input parameter p-cod-estabel  like {&TABLE-NAME}.cod-estabel  no-undo.
    def input parameter p-nr-proc-exp  like {&TABLE-NAME}.nr-proc-exp  no-undo.
    def input parameter p-id-container like {&table-name}.id-container no-undo.
    def input parameter p-serie        like {&TABLE-NAME}.serie        no-undo.
    def input parameter p-nr-nota-fis  like {&TABLE-NAME}.nr-nota-fis  no-undo.
    def input parameter p-nr-seq-fat   like {&TABLE-NAME}.nr-seq-fat   no-undo.
    def input parameter p-it-codigo    like {&table-name}.it-codigo    no-undo.
    def input parameter p-sigla-emb    like {&TABLE-NAME}.sigla-emb    no-undo.
    def input parameter p-volume       like {&TABLE-NAME}.volume       no-undo.
    def output parameter c-return as char no-undo.
    
    for first {&TABLE-NAME}  no-lock
         where {&TABLE-NAME}.cod-estabel  = p-cod-estabel  and
               {&TABLE-NAME}.nr-proc-exp  = p-nr-proc-exp  and
               {&table-name}.id-container = p-id-container and
               {&TABLE-NAME}.serie        = p-serie        and
               {&TABLE-NAME}.nr-nota-fis  = p-nr-nota-fis  and
               {&TABLE-NAME}.nr-seq-fat   = p-nr-seq-fat   and
               {&table-name}.it-codigo    = p-it-codigo    and
               {&TABLE-NAME}.sigla-emb    = p-sigla-emb    and
               {&TABLE-NAME}.volume       = p-volume
               use-index pk-container-emb:
    end.
    if not avail {&TABLE-NAME} then do:
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-table.i mgcex proc-container-emb 1}
       run utp/ut-msgs.p (input "msg",
                          input 2,
                          input return-value).
       assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("validateFields").

end procedure.

procedure findPk_container_emb:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter c-cod-estabel  as char no-undo.
    def input parameter c-nr-proc-exp  as char no-undo.
    def input parameter c-id-container as char no-undo.
    def input parameter c-serie        as char no-undo.
    def input parameter c-nr-nota-fis  as char no-undo.
    def input parameter i-nr-seq-fat   as inte no-undo.
    def input parameter c-it-codigo    as char no-undo.
    def input parameter c-sigla-emb    as char no-undo.
    def input parameter i-volume       as inte no-undo.
    def output parameter c-return      as char no-undo.
 
    for first {&TABLE-NAME} no-lock where 
              {&TABLE-NAME}.cod-estabel  = c-cod-estabel  and
              {&TABLE-NAME}.nr-proc-exp  = c-nr-proc-exp  and
              {&table-name}.id-container = c-id-container and
              {&TABLE-NAME}.serie        = c-serie        and
              {&TABLE-NAME}.nr-nota-fis  = c-nr-nota-fis  and
              {&TABLE-NAME}.nr-seq-fat   = i-nr-seq-fat   and
              {&table-name}.it-codigo    = c-it-codigo    and
              {&TABLE-NAME}.sigla-emb    = c-sigla-emb    and
              {&TABLE-NAME}.volume       = i-volume
              use-index pk-container-emb:
    end.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex proc-container-emb 1}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.
 
procedure validateFields:
    /*
    **  Valida Fields
    */
    find first rowObject
        no-lock no-error.
 
    run startMethod ("validateFields").
    if rowObject.cod-estabel = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-container-emb cod-estabel 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.id-container = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-container-emb id-container 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.it-codigo = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-container-emb it-codigo 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.nr-nota-fis = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-container-emb nr-nota-fis 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.nr-proc-exp = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-container-emb nr-proc-exp 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.nr-seq-fat = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-container-emb nr-seq-fat 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.serie = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-container-emb serie 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.sigla-emb = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-container-emb sigla-emb 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.volume = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-container-emb volume 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
        run endMethod ("validateFields").
 
end procedure.
 
procedure validateCreate:
    /*
    **  Valida cria‡Æo da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.
    
    def var c-return1 as char no-undo.
 
    run initializeValidate.
    run startMethod ("validateCreate").
 
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
 
    find first rowObject
        no-lock no-error.
        
    run validateFields.        
        
    if not can-find(item-embal where item-embal.cod-estabel = rowObject.cod-estabel
                                 and item-embal.serie       = rowObject.serie
                                 &if defined(bf-dis-comex) &then      
                                     and item-embal.nr-nota-fis = int(rowObject.nr-nota-fis)
                                 &else
                                     and item-embal.nr-nota-fis = rowObject.nr-nota-fis
                                 &endif    
                                 and item-embal.nr-seq-fat  = rowObject.nr-seq-fat
                                 and item-embal.it-codigo   = rowObject.it-codigo
                                 and item-embal.sigla-emb   = rowObject.sigla-emb
                                 and item-embal.int-1       = rowObject.volume) then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgdis item-embal 1}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 2
               tt-bo-erro.mensagem     = return-value.
    end.
    
    if not can-find(proc-nota-fiscal 
                    where proc-nota-fiscal.cod-estabel = rowObject.cod-estabel and
                          proc-nota-fiscal.nr-proc-exp = rowObject.nr-proc-exp and
                          proc-nota-fiscal.serie       = rowObject.serie and
                          proc-nota-fiscal.nr-nota-fis = rowObject.nr-nota-fis) then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgdis nota-fiscal 1}
        assign c-return1 = return-value.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex processo-exp 1}
        create tt-bo-erro.
        assign tt-bo-erro.parametros = c-return1 + "~~" + return-value.
        run utp/ut-msgs.p (input "msg",
                           input 8691,
                           input c-return1 + "~~" + return-value).        
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 8691
               tt-bo-erro.mensagem     = return-value.
    end.

    find first tt-bo-erro
        no-lock no-error.
    if not available tt-bo-erro then do:
        if can-find({&TABLE-NAME}
              where {&TABLE-NAME}.cod-estabel = rowObject.cod-estabel and
                    {&TABLE-NAME}.nr-proc-exp = rowObject.nr-proc-exp and
                    {&table-name}.id-container = rowObject.id-container and
                    {&TABLE-NAME}.serie = rowObject.serie and
                    {&TABLE-NAME}.nr-nota-fis = rowObject.nr-nota-fis and
                    {&TABLE-NAME}.nr-seq-fat = rowObject.nr-seq-fat and
                    {&table-name}.it-codigo = rowObject.it-codigo and
                    {&TABLE-NAME}.sigla-emb = rowObject.sigla-emb and
                    {&TABLE-NAME}.volume = rowObject.volume) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex proc-container-emb 1}
            run utp/ut-msgs.p (input "msg",
                               input 8,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 8
                   tt-bo-erro.mensagem     = return-value.
        end.
    end.
 
    find first tt-bo-erro
        no-lock no-error. 
    if not avail tt-bo-erro then do:
       run executeCreate.
       assign r-chave = to-rowid(return-value).
    end.
 
    run endMethod ("validateCreate").
end procedure.

procedure executeUpdate:
    /*  Executa Update  */
    buffer-copy RowObject except r-rowid cod-estabel nr-proc-exp id-container serie nr-nota-fis 
                                 nr-seq-fat it-codigo sigla-emb volume to {&TABLE-NAME}.
                                     
end procedure.

procedure deleteTable:
     def input parameter p-cod-estabel  like {&TABLE-NAME}.cod-estabel.
     def input parameter p-nr-proc-exp  like {&TABLE-NAME}.nr-proc-exp.
     def input parameter p-id-container like {&table-name}.id-container.
     
    /* def output parameter table for tt-bo-erro.*/
     def var r-rowid  as rowid no-undo.
     
     for each {&TABLE-NAME} exclusive-lock
         where {&TABLE-NAME}.cod-estabel  = p-cod-estabel
         and   {&TABLE-NAME}.nr-proc-exp  = p-nr-proc-exp
         and   {&table-name}.id-container = p-id-container
         use-index pk-container-emb:
         assign r-rowid = rowid({&TABLE-NAME}).
         run validateDelete (input-output r-rowid, output table tt-bo-erro) .
     end.   

end procedure.

procedure incluirEmbalagensnota:
/*
** Inclui todas as embalagens de uma nota fiscal
*/
def input parameter p-rw-proc-container as rowid                       no-undo.
def input parameter p-nr-nota-fis       like {&TABLE-NAME}.nr-nota-fis no-undo.
def input parameter p-serie             like {&TABLE-NAME}.serie no-undo.
def input parameter p-it-codigo-ini     like {&table-name}.it-codigo no-undo.
def input parameter p-it-codigo-fim     like {&table-name}.it-codigo no-undo.
def input parameter p-sigla-emb-ini     like {&table-name}.sigla-emb no-undo.
def input parameter p-sigla-emb-fim     like {&table-name}.sigla-emb no-undo.

def output parameter table for tt-bo-erro.

def var r-{&TABLE-NAME} as rowid   no-undo.
def var c-return1            as char    no-undo.
def var l-existe             as logical no-undo.

for each tt-{&TABLE-NAME}:
    delete tt-{&TABLE-NAME}.
end.

for each tt-bo-erro:
    delete tt-bo-erro.
end.

find proc-container where 
     rowid(proc-container) = p-rw-proc-container no-lock no-error.
if avail proc-container then do:
    
    if not can-find(first item-embal where item-embal.cod-estabel = proc-container.cod-estabel and
                                           item-embal.serie       = p-serie and
                                           &if defined(bf-dis-comex) &then      
                                               item-embal.nr-nota-fis = int(p-nr-nota-fis))
                                           &else
                                               item-embal.nr-nota-fis = p-nr-nota-fis) 
                                           &endif 
                                           then do:        
                                           
        assign i-seq-erro = i-seq-erro + 1.
        create tt-bo-erro.    
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgdis item-embal 1}
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = return-value.
    end.
    if not avail tt-bo-erro then do:
        
        if not can-find(first item-embal 
                            where item-embal.cod-estabel = proc-container.cod-estabel and
                                  &if defined(bf-dis-comex) &then      
                                      item-embal.nr-nota-fis = int(p-nr-nota-fis) and
                                  &else
                                      item-embal.nr-nota-fis = p-nr-nota-fis and
                                  &endif 
                                  item-embal.serie       = p-serie) then do:
            assign i-seq-erro = i-seq-erro + 1.
            create tt-bo-erro.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-field.i mgdis item-embal cod-estabel 1}
            assign c-return1 = return-value.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */ 
            {utp/ut-table.i mgdis item-embal 1}
            assign c-return1 = c-return1 + " " + return-value.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex proc-container 1}
            assign tt-bo-erro.parametros = c-return1 + "~~" + return-value.
            run utp/ut-msgs.p (input "msg",
                               input 17399,
                               input c-return1 + "~~" + return-value).
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 17399
                   tt-bo-erro.mensagem = return-value.
        end.
     end.
        
    for each item-embal fields(nr-seq-fat it-codigo sigla-emb int-1 serie nr-nota-fis)
       where item-embal.cod-estabel = proc-container.cod-estabel and
             item-embal.serie       = p-serie                    and
             &if defined(bf-dis-comex) &then      
                 item-embal.nr-nota-fis = int(p-nr-nota-fis) and
             &else
                 item-embal.nr-nota-fis = p-nr-nota-fis and
             &endif
             item-embal.it-codigo >= p-it-codigo-ini and
             item-embal.it-codigo <= p-it-codigo-fim and
             item-embal.sigla-emb >= p-sigla-emb-ini and
             item-embal.sigla-emb <= p-sigla-emb-fim no-lock:
        
        create tt-{&TABLE-NAME}.
        
        assign tt-{&TABLE-NAME}.nr-proc-exp  = proc-container.nr-proc-exp
               tt-{&TABLE-NAME}.cod-estabel  = proc-container.cod-estabel
               tt-{&table-name}.id-container = proc-container.id-container
               tt-{&TABLE-NAME}.serie        = item-embal.serie
               &if defined(bf-dis-comex) &then      
                   tt-{&TABLE-NAME}.nr-nota-fis = string(item-embal.nr-nota-fis)
               &else
                   tt-{&TABLE-NAME}.nr-nota-fis = item-embal.nr-nota-fis
               &endif    
               tt-{&TABLE-NAME}.nr-seq-fat   = item-embal.nr-seq-fat
               tt-{&table-name}.it-codigo    = item-embal.it-codigo
               tt-{&TABLE-NAME}.sigla-emb    = item-embal.sigla-emb
               tt-{&table-name}.volume       = item-embal.int-1.
               
        run validateCreate (input table tt-{&TABLE-NAME},
                            output table tt-bo-erro,
                            output r-{&TABLE-NAME}). 
        
        delete tt-{&TABLE-NAME}.
        find first tt-bo-erro no-error.
        if avail tt-bo-erro then do:
            assign i-seq-erro = i-seq-erro + 1.
            create tt-bo-erro.    
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgdis item-embal 1}
            assign c-return1 = return-value + " " + item-embal.it-codigo.
            assign tt-bo-erro.parametros = c-return1.
            run utp/ut-msgs.p (input "msg",
                               input 18880,
                               input c-return1).
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 18880
                   tt-bo-erro.mensagem = return-value.                                
            undo, leave.
        end.
    end.
end.

end procedure.

procedure getCharField:
    define input  parameter c-field as char.
    define output parameter c-value as char.
 
    case c-field:
        when "char-1" then c-value = RowObject.char-1.
        when "char-2" then c-value = RowObject.char-2.
        when "check-sum" then c-value = RowObject.check-sum.
        when "cod-estabel" then c-value = RowObject.cod-estabel.
        when "id-container" then c-value = RowObject.id-container.
        when "it-codigo" then c-value = RowObject.it-codigo.
        when "nr-nota-fis" then c-value = RowObject.nr-nota-fis.
        when "nr-proc-exp" then c-value = RowObject.nr-proc-exp.
        when "serie" then c-value = RowObject.serie.
        when "sigla-emb" then c-value = RowObject.sigla-emb.
        otherwise return error.
    end case.
end procedure.
 
procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.
 
    case c-field:
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        otherwise return error.
    end case.
end procedure.
 
procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.
 
    case c-field:
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.
        when "nr-seq-fat" then c-value = RowObject.nr-seq-fat.
        when "volume" then c-value = RowObject.volume.
        otherwise return error.
    end case.
end procedure.
 
procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.
 
    case c-field:
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.
        otherwise return error.
    end case.
end procedure.
 
procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.
 
    case c-field:
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.
        otherwise return error.
    end case.
end procedure.

