{cdp/cdcfgdis.i} /* Definicao de pre-processadores */

&IF INTEGER(ENTRY(1,PROVERSION,".")) >= 9 &THEN
   &GLOBAL-DEFINE v9indrep  INDEXED-REPOSITION
&endif

&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.001
&scoped-define FIRST-TABLE-IN-QUERY proc-container-emb
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME proc-container-emb
 
{include/boini.i} 
{cxbo/bocx245.i RowObject}
{cxbo/bocx245.i tt-proc-container-emb}
 
DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

DEFINE VAR c-cod-estabel  like {&TABLE-NAME}.cod-estabel  no-undo.
DEFINE VAR c-nr-proc-exp  like {&TABLE-NAME}.nr-proc-exp  no-undo.
DEFINE VAR c-id-container like {&table-name}.id-container no-undo.
DEFINE VAR c-serie        like {&TABLE-NAME}.serie        no-undo.
DEFINE VAR c-nr-nota-fis  like {&TABLE-NAME}.nr-nota-fis  no-undo.
DEFINE VAR i-nr-seq-fat   like {&TABLE-NAME}.nr-seq-fat   no-undo.
DEFINE VAR c-it-codigo    like {&table-name}.it-codigo    no-undo.
DEFINE VAR c-sigla-emb    like {&TABLE-NAME}.sigla-emb    no-undo.
DEFINE VAR c-volume       like {&TABLE-NAME}.volume       no-undo.
 
procedure setConstraint1: 
end procedure.

procedure setConstraint2:
    def input parameter p-cod-estabel  like {&TABLE-NAME}.cod-estabel  no-undo.
    def input parameter p-nr-proc-exp  like {&TABLE-NAME}.nr-proc-exp  no-undo.
    def input parameter p-id-container like {&table-name}.id-container no-undo.
    def input parameter p-serie        like {&TABLE-NAME}.serie        no-undo.
    def input parameter p-nr-nota-fis  like {&TABLE-NAME}.nr-nota-fis  no-undo.
    def input parameter p-nr-seq-fat   like {&TABLE-NAME}.nr-seq-fat   no-undo.
    def input parameter p-it-codigo    like {&table-name}.it-codigo    no-undo.
    def input parameter p-sigla-emb    like {&TABLE-NAME}.sigla-emb    no-undo.
    def input parameter p-volume       like {&TABLE-NAME}.volume       no-undo.
    assign c-cod-estabel  = p-cod-estabel
           c-nr-proc-exp  = p-nr-proc-exp
           c-id-container = p-id-container
           c-serie        = p-serie
           c-nr-nota-fis  = p-nr-nota-fis
           i-nr-seq-fat   = p-nr-seq-fat
           c-it-codigo    = p-it-codigo
           c-sigla-emb    = p-sigla-emb
           c-volume       = p-volume.

end procedure.

procedure setConstraint3:
    def input parameter p-cod-estabel  like {&TABLE-NAME}.cod-estabel  no-undo.
    def input parameter p-nr-proc-exp  like {&TABLE-NAME}.nr-proc-exp  no-undo.
    def input parameter p-id-container like {&table-name}.id-container no-undo.
    assign c-cod-estabel  = p-cod-estabel
           c-nr-proc-exp  = p-nr-proc-exp
           c-id-container = p-id-container.
end procedure.

procedure setConstraint4:
    def input parameter pr-proc-container as rowid  no-undo.
    
    find proc-container where rowid(proc-container) = pr-proc-container no-lock no-error.

end procedure.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
   
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock
                                              {&v9indrep}.
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where
                                        {&TABLE-NAME}.cod-estabel  >= c-cod-estabel  and 
                                        {&TABLE-NAME}.nr-proc-exp  >= c-nr-proc-exp  and 
                                        {&table-name}.id-container >= c-id-container and 
                                        {&TABLE-NAME}.serie        >= c-serie        and 
                                        {&TABLE-NAME}.nr-nota-fis  >= c-nr-nota-fis  and 
                                        {&TABLE-NAME}.nr-seq-fat   >= i-nr-seq-fat   and 
                                        {&table-name}.it-codigo    >= c-it-codigo    and 
                                        {&TABLE-NAME}.sigla-emb    >= c-sigla-emb    and
                                        {&TABLE-NAME}.volume       >= c-volume       no-lock
                                        use-index pk-container-emb
                                        {&v9indrep}.  
        when 3 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock where
                                        {&TABLE-NAME}.cod-estabel  = trim(c-cod-estabel)  and
                                        {&TABLE-NAME}.nr-proc-exp  = trim(c-nr-proc-exp)  and
                                        {&table-name}.id-container = trim(c-id-container)
                                        use-index pk-container-emb
                                        INDEXED-REPOSITION.
        when 4 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock where 
                                        {&TABLE-NAME}.cod-estabel  = proc-container.cod-estabel  and 
                                        {&TABLE-NAME}.nr-proc-exp  = proc-container.nr-proc-exp  and 
                                        {&table-name}.id-container = proc-container.id-container
                                        use-index pk-container-emb
                                        {&v9indrep}.
 
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.
 
