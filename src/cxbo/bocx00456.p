&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE pi-verificaControleAduanaInternac DBOProgram 
PROCEDURE pi-verificaControleAduanaInternac :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
DEFINE OUTPUT PARAMETER p-funcao-aduana AS LOG NO-UNDO.
    
    FIND FIRST funcao
         WHERE funcao.cd-funcao = "spp-controle-aduana-internac" OR 
               funcao.cd-funcao = "spp_controle-aduana-internac" NO-LOCK NO-ERROR.
    IF AVAIL funcao THEN
        ASSIGN p-funcao-aduana = YES.
    ELSE
        ASSIGN p-funcao-aduana = NO.
  
   RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

