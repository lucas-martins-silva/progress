&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getCharField DBOProgram 
PROCEDURE getCharField :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valor de campos do tipo caracter
  Parameters:  
               recebe nome do campo
               retorna valor do campo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pFieldName AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldValue AS CHARACTER NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
        RETURN "NOK":U.

    CASE pFieldName:
        WHEN "carta-credito":U THEN ASSIGN pFieldValue = RowObject.carta-credito.
        WHEN "char-1":U THEN ASSIGN pFieldValue = RowObject.char-1.
        WHEN "char-2":U THEN ASSIGN pFieldValue = RowObject.char-2.
        WHEN "check-sum":U THEN ASSIGN pFieldValue = RowObject.check-sum.
        WHEN "cod-estabel":U THEN ASSIGN pFieldValue = RowObject.cod-estabel.
        WHEN "cod-idioma":U THEN ASSIGN pFieldValue = RowObject.cod-idioma.
        WHEN "cod-incoterm":U THEN ASSIGN pFieldValue = RowObject.cod-incoterm.
        WHEN "contrato-cambio":U THEN ASSIGN pFieldValue = RowObject.contrato-cambio.
        WHEN "declaracao-import":U THEN ASSIGN pFieldValue = RowObject.declaracao-import.
        WHEN "destino-documentacao":U THEN ASSIGN pFieldValue = RowObject.destino-documentacao.
        WHEN "estab-fisc":U THEN ASSIGN pFieldValue = RowObject.estab-fisc.
        WHEN "licenca-import":U THEN ASSIGN pFieldValue = RowObject.licenca-import.
        WHEN "merc-orig":U THEN ASSIGN pFieldValue = RowObject.merc-orig.
        WHEN "narrativa":U THEN ASSIGN pFieldValue = RowObject.narrativa.
        WHEN "nr-conhecimento":U THEN ASSIGN pFieldValue = RowObject.nr-conhecimento.
        WHEN "nr-proc-imp":U THEN ASSIGN pFieldValue = RowObject.nr-proc-imp.
        WHEN "nr-rof":U THEN ASSIGN pFieldValue = RowObject.nr-rof.
        WHEN "texto-mensag":U THEN ASSIGN pFieldValue = RowObject.texto-mensag.
        OTHERWISE RETURN "NOK":U.
    END CASE.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


