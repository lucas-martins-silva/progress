procedure findItem.
def input parameter pr-item as rowid no-undo.

    find first bf-it-proc-siscomex no-lock
         where rowid(bf-it-proc-siscomex) = pr-item no-error.
         
    if avail bf-it-proc-siscomex then
    do:
        run getFabricante.
        return "ok".
    end.    
    else
        return "nok".
        
end procedure.


procedure getExtents.
def output parameter pi-extents as integer no-undo.

assign pi-extents = i-num-extents.

end procedure.

procedure initializeValidate.

    run startMethod ("initializevalidate").

    run endMethod ("initializeFields").

end procedure.
 

procedure validateFields:

        /*
        **  Valida cria‡Æo da tabela/duplicidade de registro.
        */                             
        def input  parameter table for ttRowObjectDetalhe.
        def input  parameter i-num-extent as integer no-undo.
        def output parameter table for tt-bo-erro.
        
        run initializeValidate.
        run startMethod ("validateFields").
        
        assign de-vl-fab = 0.
        
        for each tt-bo-erro:
            delete tt-bo-erro.
        end.
        assign i-seq-erro = 0
               de-qt-fab  = 0
               de-vl-fab  = 0
               de-qt-tot-grupo = 0
               de-vl-tot-grupo = 0.
        
        find first ttRowObjectDetalhe no-error.
        
        if i-num-extent > 10 then
        do:
            assign i-seq-erro = i-seq-erro + 1.
            run utp/ut-msgs.p (input "msg",
                               input 28107,
                               input "").
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 28107
                   tt-bo-erro.mensagem = return-value.
        
        end.
        
        IF (ttRowObjectDetalhe.qtd-fabrican) = 0 THEN DO:
            {utp/ut-liter.i Quantidade_Fabricante r}
            assign c-return = return-value.
            assign i-seq-erro = i-seq-erro + 1.
            
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
                            
            run utp/ut-msgs.p (input "msg",
                               input 18732,
                               input return-value).
            
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 18732
                   tt-bo-erro.mensagem = return-value.
        END.
        
        if length(ttRowObjectDetalhe.nr-ato-concessorio) > 13 then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* Inicio -- Projeto Internacional */
            {utp/ut-liter.i "Nr_Ato_Concess¢rio" *}
            run utp/ut-msgs.p (input "msg":U,
                               input 27743,
                               input RETURN-VALUE + "~~" + "13").
            create tt-bo-erro.
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter AS CHARACTER NO-UNDO.
            ASSIGN c-lbl-liter = TRIM(RETURN-VALUE).
            DEFINE VARIABLE c-lbl-liter-nr-ato-concessorio AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Nr_Ato_Concess¢rio" *}
            ASSIGN c-lbl-liter-nr-ato-concessorio = TRIM(RETURN-VALUE).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 27743
                   tt-bo-erro.mensagem     = c-lbl-liter
                   tt-bo-erro.parametros   = c-lbl-liter-nr-ato-concessorio + "~~" + "13".
                   
        end.
        else do:
                DO  i = 1 TO 13:
                    IF LENGTH(ttRowObjectDetalhe.nr-ato-concessorio) < 13 THEN DO:
                         ASSIGN ttRowObjectDetalhe.nr-ato-concessorio = "0" + ttRowObjectDetalhe.nr-ato-concessorio.
                    END.
                END.
        end.         
        
        IF (ttRowObjectDetalhe.valor-fabrican) = 0 THEN DO:
            {utp/ut-liter.i Valor_Fabricante r}
            assign c-return = return-value.
            assign i-seq-erro = i-seq-erro + 1.
            
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
                            
            run utp/ut-msgs.p (input "msg",
                               input 18732,
                               input return-value).
            
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 18732
                   tt-bo-erro.mensagem = return-value.
        END.

        
        /*
        if not can-find (emitente where 
                         emitente.cod-emitente = ttRowObjectDetalhe.cod-fabrican) then
        do:
           {utp/ut-field.i mgcex it-proc-siscomex cod-fabrican 1}
            assign i-seq-erro = i-seq-erro + 1.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.
        end.
                         
        if not can-find(classif-fisc where 
                        classif-fisc.class-fisc = ttRowObjectDetalhe.class-fiscal-fabrican ) then do:
           {utp/ut-field.i mgind classif-fisc class-fiscal 1}
            assign i-seq-erro = i-seq-erro + 1.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.
        end. 
        */
         
        find current bf-it-proc-siscomex no-lock no-error.
        if avail bf-it-proc-siscomex then do:
            FOR EACH it-proc-siscomex WHERE 
                     it-proc-siscomex.nr-proc-siscomex = bf-it-proc-siscomex.nr-proc-siscomex AND
                     it-proc-siscomex.cod-estabel = bf-it-proc-siscomex.cod-estabel AND
                     it-proc-siscomex.num-grp-item = bf-it-proc-siscomex.num-grp-item
                     NO-LOCK:
                ASSIGN de-qt-tot-grupo = de-qt-tot-grupo + it-proc-siscomex.dec-1
                       de-vl-tot-grupo = de-vl-tot-grupo + it-proc-siscomex.dec-2.
            END.
            
            
        /*    FIND it-proc-siscomex WHERE
                 it-proc-siscomex.nr-proc-siscomex = bf-it-proc-siscomex.nr-proc-siscomex AND
                 it-proc-siscomex.cod-estabel = bf-it-proc-siscomex.cod-estabel AND
                 it-proc-siscomex.num-grp-item = bf-it-proc-siscomex.num-grp-item AND
                 it-proc-siscomex.class-fiscal = bf-it-proc-siscomex.class-fiscal AND
                 it-proc-siscomex.it-codigo = bf-it-proc-siscomex.it-codigo AND
                 it-proc-siscomex.un = bf-it-proc-siscomex.un
                 NO-LOCK NO-ERROR.
            IF AVAIL it-proc-siscomex THEN DO:
                DO i = 1 TO 10:
                    ASSIGN de-qt-fab = de-qt-fab + it-proc-siscomex.qtd-fabrican[i]
                           de-vl-fab = de-vl-fab + it-proc-siscomex.valor-fabrican[i]
                           i = i + 1.
                END.
            END. */       
            
            /*IF (de-qt-fab + ttRowObjectDetalhe.qtd-fabrican) > de-qt-tot-grupo THEN DO:
                {utp/ut-liter.i Quantidade r}
                assign c-return = return-value.
                assign i-seq-erro = i-seq-erro + 1.
                
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                                
                run utp/ut-msgs.p (input "msg",
                                   input 28439,
                                   input return-value).
                
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 28439
                       tt-bo-erro.mensagem = return-value.
            END.*/
            
            /*IF (de-vl-fab + ttRowObjectDetalhe.valor-fabrican) > round(de-vl-tot-grupo,2) THEN DO:
                {utp/ut-liter.i Valor r}
                assign c-return = return-value.
                assign i-seq-erro = i-seq-erro + 1.
                
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.                
                run utp/ut-msgs.p (input "msg",
                                   input 28439,
                                   input return-value).
                                                   
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 28439
                       tt-bo-erro.mensagem = return-value.
            END.*/
        END.
        
        find first tt-bo-erro no-lock no-error.
        
        if not avail tt-bo-erro then do:
            find current bf-it-proc-siscomex exclusive-lock no-error.
            if avail bf-it-proc-siscomex then
            do:
                assign bf-it-proc-siscomex.cod-fabrican[i-num-extent]                = ttRowObjectDetalhe.cod-fabrican
                       bf-it-proc-siscomex.class-fiscal-fabrican[i-num-extent]       = ttRowObjectDetalhe.class-fiscal-fabrican
                       bf-it-proc-siscomex.nr-ato-concessorio-fabrican[i-num-extent] = ttRowObjectDetalhe.nr-ato-concessorio
                       bf-it-proc-siscomex.qtd-fabrican[i-num-extent]                = ttRowObjectDetalhe.qtd-fabrican
                       bf-it-proc-siscomex.valor-fabrican[i-num-extent]              = dec(string(ttRowObjectDetalhe.valor-fabrican,">>>,>>>,>>9.999")).
                       
            end.
            find current bf-it-proc-siscomex no-lock no-error.
            /*run atualizaFabricantes (input "add").*/
            run getFabricante.
        end.
        
        run endMethod ("validateFields").
        
end procedure.


procedure atualizaFabricantes:

        define input parameter p-type as char no-undo.
        
        def var i as integer no-undo.
        def var i2 as integer no-undo.
        def var i-cont as integer no-undo.
        def var i-cont2 as integer no-undo.
        
        if avail bf-it-proc-siscomex then do:
        
           for each bf-item exclusive-lock
               where bf-item.class-fiscal = bf-it-proc-siscomex.class-fiscal
                 and bf-item.un = bf-it-proc-siscomex.un
                 and bf-item.it-codigo <> bf-it-proc-siscomex.it-codigo
                 and bf-item.num-grp-item = bf-it-proc-siscomex.num-grp-item:
           
               do i = 1 to 10:
                  
                  if p-type = "add" then do:
                  
                     if bf-item.cod-fabrican[i] = 0 then do:
                          
                        assign bf-item.cod-fabrican[i] = bf-it-proc-siscomex.cod-fabrican[i]
                               bf-item.class-fiscal-fabrican[i] = bf-it-proc-siscomex.class-fiscal-fabrican[i]
                               bf-item.nr-ato-concessorio-fabrican[i] = bf-it-proc-siscomex.nr-ato-concessorio-fabrican[i]
                               bf-item.qtd-fabrican[i] = bf-it-proc-siscomex.qtd-fabrican[i]
                               bf-item.valor-fabrican[i] = bf-it-proc-siscomex.valor-fabrican[i]
                               bf-item.obs-export[i] = bf-it-proc-siscomex.obs-export[i].
                           
                        leave.                            
        
                     end.
                     
                  end.
                  else do:
                  
                     if bf-item.cod-fabrican[i] = bf-it-proc-siscomex.cod-fabrican[i] then do:
                          
                        assign bf-item.cod-fabrican[i] = 0
                               bf-item.class-fiscal-fabrican[i] = ""
                               bf-item.nr-ato-concessorio-fabrican[i] = ""
                               bf-item.qtd-fabrican[i] = 0
                               bf-item.valor-fabrican[i] = 0
                               bf-item.obs-export[i] = "".
                           
                        leave.                            
        
                     end.
                  end.
                   
               end.
                     
           end.
           
        end.
        

end procedure.

 
procedure executeDelete.
def input parameter pi-num-extent     as integer no-undo.
def input parameter pi-num-tot-extent as integer no-undo.

define variable i-cont-extent as integer no-undo.


    run startMethod ("executeDelete").
    
    find current bf-it-proc-siscomex exclusive-lock no-error.
    
    if avail bf-it-proc-siscomex then
    do:
        do i-cont-extent = pi-num-extent to pi-num-tot-extent:
            if i-cont-extent < 10 and i-cont-extent < pi-num-tot-extent then
            do:
                assign bf-it-proc-siscomex.cod-fabrican[i-cont-extent]                = bf-it-proc-siscomex.cod-fabrican[i-cont-extent + 1]
                       bf-it-proc-siscomex.class-fiscal-fabrican[i-cont-extent]       = bf-it-proc-siscomex.class-fiscal-fabrican[i-cont-extent + 1]
                       bf-it-proc-siscomex.nr-ato-concessorio-fabrican[i-cont-extent] = bf-it-proc-siscomex.nr-ato-concessorio-fabrican[i-cont-extent + 1]
                       bf-it-proc-siscomex.qtd-fabrican[i-cont-extent]                = bf-it-proc-siscomex.qtd-fabrican[i-cont-extent]
                       bf-it-proc-siscomex.valor-fabrican[i-cont-extent]              = bf-it-proc-siscomex.valor-fabrican[i-cont-extent].
            end.
            
            if i-cont-extent = pi-num-tot-extent or i-cont-extent = 10 then /* For‡a limpar £ltima extent */
            do:
                assign bf-it-proc-siscomex.cod-fabrican[i-cont-extent]                = 0
                       bf-it-proc-siscomex.class-fiscal-fabrican[i-cont-extent]       = "00000000"
                       bf-it-proc-siscomex.nr-ato-concessorio-fabrican[i-cont-extent] = ""
                       bf-it-proc-siscomex.qtd-fabrican[i-cont-extent]                = 0
                       bf-it-proc-siscomex.valor-fabrican[i-cont-extent]              = 0.
            end.
        end.
        /*run atualizaFabricantes (input "Del").*/
        
    end.
    
    find current bf-it-proc-siscomex no-lock no-error.
    
    run getFabricante.
    
    run endMethod ("ExecuteDelete").
    
end procedure.

procedure getFabricante.

        define variable i-cont as integer no-undo.
   
        run startMethod ("getFabricante").

        for each tt-fabricante:
            delete tt-fabricante.
        end.
   
        if avail bf-it-proc-siscomex then
        do:
           assign i-num-extents = 10.
           do i-cont = 1 to 10:
              if bf-it-proc-siscomex.cod-fabrican[i-cont] <> 0 then
              do:
           
                 find first emitente no-lock
                      where emitente.cod-emitente = bf-it-proc-siscomex.cod-fabrican[i-cont] no-error.
                    
                 create tt-fabricante.
                 assign tt-fabricante.r-Rowid               = rowid(tt-fabricante)
                        tt-fabricante.id                    = i-cont
                        tt-fabricante.cod-fabrican          = bf-it-proc-siscomex.cod-fabrican[i-cont]
                        tt-fabricante.class-fiscal-fabrican = bf-it-proc-siscomex.class-fiscal-fabrican[i-cont]
                        tt-fabricante.nr-ato-concessorio    = bf-it-proc-siscomex.nr-ato-concessorio-fabrican[i-cont]
                        tt-fabricante.qtd-fabrican          = bf-it-proc-siscomex.qtd-fabrican[i-cont]
                        tt-fabricante.valor-fabrican        = bf-it-proc-siscomex.valor-fabrican[i-cont].
                      
                 if avail emitente then
                 assign tt-fabricante.nome-abrev            = emitente.nome-abrev
                        tt-fabricante.cgc                   = emitente.cgc
                        tt-fabricante.estado                = emitente.estado.

              end.
              else
              do:
                 assign i-num-extents = i-cont - 1.
                 leave.
              end.
           end.
        end.
   
        run EndMethod ("getFabricante").
        
        run openQuery (input 1).
       
        return "ok".
        
end procedure.

procedure Carrega.

define variable rows as integer no-undo.

run serverSendRows(input ?,
                   input "",
                   input no,
                   input 0,
                   output Rows,
                   output table RowObjectAux).

end procedure.

procedure getDetalhe.
def output parameter pi-num-extent as integer no-undo.
def output parameter table for RowObjectAux.

run carrega.

for each RowObjectAux:
   delete RowObjectAux.
end.
for each RowObject:
    create rowObjectAux.
    buffer-copy RowObject to RowObjectAux.
end.

assign pi-num-extent = i-num-extents.

end procedure.

procedure getCurrentDet.

        def output parameter table for ttRowObjectDetalhe.
        
        run StartMethod ("getCurrent").
        
        for each ttRowObjectDetalhe:
            delete ttRowObjectDetalhe.
        end.
        
        if avail RowObject then
        do:
            create ttRowObjectDetalhe.
            buffer-copy RowObject to ttRowObjectDetalhe.
            /*
            assign ttRowObjectDetalhe.id                    = RowObject.id
                   ttRowObjectDetalhe.cod-fabrican          = RowObject.cod-fabrican
                   ttRowObjectDetalhe.class-fiscal-fabrican = RowObject.class-fiscal-fabrican
                   ttRowObjectDetalhe.nr-ato-concessorio    = RowObject.nr-ato-concessorio
                   ttRowObjectDetalhe.qtd-fabrican          = RowObject.qtd-fabrican
                   ttRowObjectDetalhe.valor-fabrican        = RowObject.valor-fabrican
                   ttRowObjectDetalhe.nome-abrev            = RowObject.nome-abrev
                   ttRowObjectDetalhe.cgc                   = RowObject.cgc
                   ttRowObjectDetalhe.estado                = RowObject.estado
                   ttRowObjectDetalhe.r-rowid               = rowid(RowObject). */
        end.

        run EndMethod ("getCurrent").

end procedure.


procedure getCharField.

        def input  parameter c-field  as char    no-undo.
        def output parameter c-value  as char    no-undo.
        
             
        if avail RowObject then
        do:
            case c-field:
                when "cgc" then c-value = RowObject.cgc.
                when "class-fiscal-fabrican" then c-value = RowObject.class-fiscal-fabrican.
                when "estado" then c-value = RowObject.estado.
                when "nome-abrev" then c-value = RowObject.nome-abrev.
                when "nr-ato-concessorio" then c-value = RowObject.nr-ato-concessorio.
                otherwise return error.
            end case.
        end.

end procedure.

procedure getDecField.

        def input  parameter c-field  as char    no-undo.
        def output parameter c-value  as dec    no-undo.
        
        if avail RowObject then
        do:
            case c-field:
                when "qtd-fabrican" then c-value = RowObject.qtd-fabrican.
                when "valor-fabrican" then c-value = RowObject.valor-fabrican.
                otherwise return error.
            end case.
        end.

end procedure.

procedure getIntField.

        def input  parameter c-field  as char    no-undo.
        def output parameter c-value  as integer no-undo.
        
        if avail RowObject then
        do:
            case c-field:
                when "cod-fabrican" then c-value = RowObject.cod-fabrican.
                otherwise return error.
            end case.
        end.

end procedure.

