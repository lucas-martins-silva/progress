/*
** Procure condi‡Æo de pagamento padrÆo para o fornecedor
*/

&IF '{&BF_MAT_VERSAO_EMS}' >= '2.062' &THEN
    def var i-cod-cond-pag as integer no-undo.
    
    find emitente
        where emitente.cod-emitente = {3} no-lock no-error.
    if avail emitente then
        assign i-cod-cond-pag = emitente.cod-cond-pag.
&ELSE
    find emitente
        where emitente.cod-emitente = rowObject.cod-emitente-desp no-lock no-error.
    if avail emitente then        
        assign rowObject.cod-cond-pag = emitente.cod-cond-pag.
&ENDIF        

/*
** Procure Tabela de Pre‡o
*/    
&IF '{&BF_MAT_VERSAO_EMS}' >= '2.062' &THEN
    find first tb-pr-cex 
         where tb-pr-cex.cod-emitente       = {3} 
           and tb-pr-cex.cod-itiner         = {1} 
           and tb-pr-cex.cod-incoterm       = {2} 
           and tb-pr-cex.dt-inicio          <= today
           and tb-pr-cex.dt-termino         >= today
           AND tb-pr-cex.situacao           = 1 /* ATIVA */
           and tb-pr-cex.log-tab-preco-padr = yes  no-lock no-error.

    if not avail tb-pr-cex then do:
        find first tb-pr-cex 
             where tb-pr-cex.cod-emitente       = {3} 
               and tb-pr-cex.cod-itiner         = {1} 
               and tb-pr-cex.cod-incoterm       = ""
               and tb-pr-cex.dt-inicio          <= today
               and tb-pr-cex.dt-termino         >= today
               AND tb-pr-cex.situacao           = 1 /* ATIVA */
               and tb-pr-cex.log-tab-preco-padr = yes no-lock no-error.

        if not avail tb-pr-cex then do:
            find first tb-pr-cex 
                 where tb-pr-cex.cod-emitente       = {3} 
                   and tb-pr-cex.cod-itiner         = 0 
                   and tb-pr-cex.cod-incoterm       = {2} 
                   and tb-pr-cex.dt-inicio          <= today
                   and tb-pr-cex.dt-termino         >= today
                   and tb-pr-cex.situacao           = 1 /* ATIVA */
                   and tb-pr-cex.log-tab-preco-padr = yes no-lock no-error.
            
            if not avail tb-pr-cex then
                find first tb-pr-cex 
                    where tb-pr-cex.cod-emitente       = {3} 
                      and tb-pr-cex.cod-itiner         = 0 
                      and tb-pr-cex.cod-incoterm       = "" 
                      and tb-pr-cex.dt-inicio          <= today
                      and tb-pr-cex.dt-termino         >= today
                      AND tb-pr-cex.situacao           = 1 /* ATIVA */
                      and tb-pr-cex.log-tab-preco-padr = yes no-lock no-error.
        end.
    end.
              
    if avail tb-pr-cex then do:
        find desp-tb-pr-cex 
            where desp-tb-pr-cex.cod-emitente = tb-pr-cex.cod-emitente
              and desp-tb-pr-cex.cod-itiner   = tb-pr-cex.cod-itiner
              and desp-tb-pr-cex.cod-incoterm = tb-pr-cex.cod-incoterm
              and desp-tb-pr-cex.nr-tab       = tb-pr-cex.nr-tab
              and desp-tb-pr-cex.cod-desp     = {4}
              and desp-tb-pr-cex.cod-cond-pag = i-cod-cond-pag
              and desp-tb-pr-cex.situacao     = 1 /* ATIVA */ 
              no-lock no-error.
    end.
&ELSE
    find tb-pr-cex no-lock
        where tb-pr-cex.cod-emitente = rowObject.cod-emitente-desp 
          and tb-pr-cex.cod-itiner   = {1} 
          and tb-pr-cex.cod-incoterm = {2} 
          and tb-pr-cex.nr-tab       = rowObject.nr-tab 
          no-error.
    if not avail tb-pr-cex then
        find tb-pr-cex no-lock
            where tb-pr-cex.cod-emitente = rowObject.cod-emitente-desp 
              and tb-pr-cex.cod-itiner   = {1} 
              and tb-pr-cex.cod-incoterm = ""
              and tb-pr-cex.nr-tab       = rowObject.nr-tab 
              no-error.
    if not avail tb-pr-cex then
        find tb-pr-cex no-lock
            where tb-pr-cex.cod-emitente = rowObject.cod-emitente-desp 
              and tb-pr-cex.cod-itiner   = 0
              and tb-pr-cex.cod-incoterm = {2}
              and tb-pr-cex.nr-tab       = rowObject.nr-tab 
              no-error.
    if not avail tb-pr-cex then
        find tb-pr-cex no-lock
            where tb-pr-cex.cod-emitente = rowObject.cod-emitente-desp
              and tb-pr-cex.cod-itiner   = 0
              and tb-pr-cex.cod-incoterm = ""
              and tb-pr-cex.nr-tab       = rowObject.nr-tab
              no-error.
    if avail tb-pr-cex then do:
        if tb-pr-cex.situacao = 1 then
            if tb-pr-cex.dt-inicio <= today and tb-pr-cex.dt-termino >= today then do:
                find desp-tb-pr-cex 
                    where desp-tb-pr-cex.cod-emitente = tb-pr-cex.cod-emitente
                      and desp-tb-pr-cex.cod-itiner   = tb-pr-cex.cod-itiner
                      and desp-tb-pr-cex.cod-incoterm = tb-pr-cex.cod-incoterm
                      and desp-tb-pr-cex.nr-tab       = tb-pr-cex.nr-tab
                      and desp-tb-pr-cex.cod-desp     = rowObject.cod-desp
                      no-lock no-error.
                if avail desp-tb-pr-cex and desp-tb-pr-cex.situacao = 1 then do:
                    assign rowObject.cod-cond-pag = desp-tb-pr-cex.cod-cond-pag
                           rowObject.perc-descto  = desp-tb-pr-cex.perc-descto
                           rowObject.taxa-financ  = tb-pr-cex.taxa-financ
                           rowObject.perc-taxa    = tb-pr-cex.perc-taxa
                           rowObject.nr-dias-taxa = tb-pr-cex.nr-dias-taxa.
                end.
            end.
    end.
&ENDIF        
