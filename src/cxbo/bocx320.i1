/*******************************************************************************
**  BOCX320.i1
**
**  Grupo Despesa 
**
*******************************************************************************/ 

{cdp/cdcfgmat.i} /* definicao de pre-processador */

&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.000
&scoped-define FIRST-TABLE-IN-QUERY grupo-desp
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME grupo-desp
 
{include/boini.i}
 
{cxbo/bocx320.i RowObject}

def var i-cod-grup-desp like grupo-desp.cod-grup-desp.
def var i-cod-grup-despi like grupo-desp.cod-grup-desp.  
def var i-cod-grup-despf like grupo-desp.cod-grup-desp.
 
DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

procedure setConstraint1:

end.

procedure setConstraint2: 
    def input parameter p-cod-grup-desp  as char no-undo.
   
    assign i-cod-grup-desp = integer(p-cod-grup-desp).
 
end procedure.

procedure setConstraint3:
    def input parameter p-cod-grup-desp-ini as char no-undo.
    def input parameter p-cod-grup-desp-fim as char no-undo.
   
    assign i-cod-grup-despi= integer(p-cod-grup-desp-ini).
    assign i-cod-grup-despf= integer(p-cod-grup-desp-fim).
 
end procedure.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.    
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where {&TABLE-NAME}.cod-grup-desp >= i-cod-grup-desp no-lock by grupo-desp.cod-grup-desp.
        when 3 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where {&TABLE-NAME}.cod-grup-desp >= i-cod-grup-despi and~
                                                                  {&TABLE-NAME}.cod-grup-desp <= i-cod-grup-despf no-lock by grupo-desp.cod-grup-desp.
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.
 
{include/bostrmet.i}
{include/boendmet.i}
&if defined(bf-mat-comex) &then    
&else
    {include/bocomver.i}
    {include/bogetver.i}
&endif
{include/bonav.i}
{include/bofind.i}
{include/bosetcur.i}
{include/bogetcur.i}
{include/bosersen.i}
{include/boprebro.i}
{include/boexecre.i}
{include/boexedel.i}
{include/bovalupt.i}

procedure executeUpdate:
    /*
    **  Executa Update
    */
    buffer-copy RowObject except r-rowid cod-grup-desp to {&TABLE-NAME}.
end procedure.
 
procedure initializeValidate:
    /*
    **  Inicializa Validate
    */
 
    run startMethod ("initializeValidade").
 
    run endMethod   ("initializeValidade").
end procedure.
 
procedure findCodigo:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input  parameter i-cod-grup-desp as integer no-undo.
    def output parameter c-return as char no-undo.
 
    find grupo-desp where
        grupo-desp.cod-grup-desp = i-cod-grup-desp
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex grupo-desp 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.


procedure validateDelete:
    /*
    **  Valida Delete
    */
    def input-output parameter r-chave as rowid.
    def output parameter table for tt-bo-erro.
    def var c-tabela as char no-undo.
    
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    
    run InitializeValidate.
 
    find {&TABLE-NAME} where
        rowid({&TABLE-NAME}) = r-chave
        exclusive-lock no-error.
    if avail {&TABLE-NAME} then do:
        if can-find(first desp-imp where desp-imp.int-1 = {&table-name}.cod-grup-desp)  then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex grupo-desp 1}
            /***************************************/
            assign c-tabela = return-value.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex desp-imp 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = c-tabela + "~~ " + return-value.
            run utp/ut-msgs.p (input "msg",
                               input 5,
                               input c-tabela + "~~" + return-value).            
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 5
                   tt-bo-erro.mensagem = return-value. 
            leave.           
        end.
        else
            run executeDelete.
    end.
 
    if l-query then
        get next {&QUERY-NAME}
            no-lock no-wait.
    else
        find next {&TABLE-NAME}
            no-lock no-error.

    if not avail {&TABLE-NAME} then do:
       if l-query then
           get prev {&QUERY-NAME}
               no-lock no-wait.
       else
           find prev {&TABLE-NAME}
               no-lock no-error.
    end.
    assign r-chave = rowid({&TABLE-NAME}).
    return "".
end procedure.

procedure validateFields:
    /*
    **  Valida Fields
    */
    find first rowObject
        no-lock no-error.
 
    if rowObject.desc-despesa = ? or rowObject.desc-despesa = "" then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 190,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 190
               tt-bo-erro.mensagem     = return-value.
    end. 
end procedure.
 
procedure validateCreate:
    /*
    **  Valida criacao da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.
 
    def var i-auto-num as integer no-undo.

    run initializeValidate.
    run startMethod ("validateCreate").
 
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
 
    find first rowObject no-lock no-error.
            
    if rowObject.cod-grup-desp = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex pto-contr cod-pto-contr 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    
    run validateFields.     
 
    find first tt-bo-erro
        no-lock no-error.
    if not available tt-bo-erro then do:
        find grupo-desp where
            grupo-desp.cod-grup-desp = rowObject.cod-grup-desp
            no-lock no-error.
        if avail grupo-desp then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR! - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex grupo-desp 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 8,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 8
                   tt-bo-erro.mensagem     = return-value.
        end.
    end.
     
    /** Verifica duplicidade dos registros **/    
 
    
    find first tt-bo-erro
        no-lock no-error.
 
    if not avail tt-bo-erro then do:
       run executeCreate.
       assign r-chave = to-rowid(return-value).
    end.
 
    run endMethod ("validateCreate").
end procedure.

procedure autoNumber:
    def output parameter i-auto-num as integer no-undo.
    def var i-cont as integer init 1 no-undo. /** variavel de contador **/
    def output parameter table for tt-bo-erro.
        
    {include/boautonum.i "99999" "cod-grup-desp"}

end procedure.


procedure retornaDescricao:

   def input  parameter p-cod-grup-desp as integer.
   def output parameter p-c-descricao   like grupo-desp.desc-despesa.
   
   find grupo-desp where grupo-desp.cod-grup-desp = p-cod-grup-desp no-lock no-error.

   assign p-c-descricao = if avail grupo-desp then grupo-desp.desc-despesa else " ":U.

end procedure.
 
procedure getCharField:
    define input  parameter c-field as char.
    define output parameter c-value as char.
 
    case c-field:
        when "desc-desp" then c-value = RowObject.desc-despesa.
        otherwise return error.
    end case.
end procedure.
 
procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.
 
    case c-field:
        otherwise return error.
    end case.
end procedure.
 
procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.
 
    case c-field:
        when "cod-grup-desp" then c-value = RowObject.cod-grup-desp.
        otherwise return error.
    end case.
end procedure.
 
procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.
 
    case c-field:
        otherwise return error.
    end case.
end procedure.
 
procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.
 
    case c-field:
        otherwise return error.
    end case.
end procedure.
 
