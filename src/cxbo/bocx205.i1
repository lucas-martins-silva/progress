procedure initializeValidate:
    /*
    **  Inicializa Validate
    */

    run startMethod ("initializeValidade").

    run endMethod   ("initializeValidade").
end procedure.

procedure findCh_proc_desp_itiner:

    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter i-cod-itiner as inte no-undo.
    def input parameter i-sequencia as inte no-undo.
    def input parameter i-cod-pto-contr as inte no-undo.
    def input parameter i-cod-desp as inte no-undo.
    def input parameter c-cod-estabel as char no-undo.
    def input parameter c-nr-proc-exp as char no-undo.
    def output parameter c-return as char no-undo.

    find proc-desp-itiner
         where proc-desp-itiner.cod-itiner    = i-cod-itiner
           and proc-desp-itiner.sequencia     = i-sequencia
           and proc-desp-itiner.cod-pto-contr = i-cod-pto-contr
           and proc-desp-itiner.cod-desp      = i-cod-desp
           and proc-desp-itiner.cod-estabel   = c-cod-estabel
           and proc-desp-itiner.nr-proc-exp   = c-nr-proc-exp no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        {utp/ut-table.i mgcex proc-desp-itiner 1}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").

end procedure.
              
