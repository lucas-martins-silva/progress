procedure setConstraint1:

end procedure.

PROCEDURE setConstraint2:

    DEFINE input parameter p-cod-estabel   like proc-desp-itiner.cod-estabel   no-undo.
    DEFINE input parameter p-nr-proc-exp   like proc-desp-itiner.nr-proc-exp   no-undo.
    DEFINE input parameter p-cod-itiner    like proc-desp-itiner.cod-itiner    no-undo.
    DEFINE input parameter p-nr-sequencia  like proc-desp-itiner.sequencia     no-undo.
    DEFINE input parameter p-cod-pto-contr like proc-desp-itiner.cod-pto-contr no-undo.
    DEFINE input parameter p-cod-desp      like proc-desp-itiner.cod-desp      no-undo.
    DEFINE input parameter p-cod-emit-desp like proc-desp-itiner.cod-emitente-desp no-undo.

    assign c-cod-estabel    = p-cod-estabel
           c-nr-proc-exp    = p-nr-proc-exp
           i-cod-itiner     = int(p-cod-itiner)
           i-nr-sequencia   = int(p-nr-sequencia)
           i-cod-pto-contr  = int(p-cod-pto-contr)
           i-cod-desp       = int(p-cod-desp)
           i-cod-emit-desp  = int(p-cod-emit-desp).

END PROCEDURE.

PROCEDURE setConstraint3:

  DEFINE input parameter p-chave as rowid no-undo.

  assign r-chave = p-chave.

END PROCEDURE.

PROCEDURE setConstraint4:

    DEFINE input parameter p-cod-estabel   like proc-desp-itiner.cod-estabel   no-undo.
    DEFINE input parameter p-nr-proc-exp   like proc-desp-itiner.nr-proc-exp   no-undo.
    DEFINE input parameter p-cod-itiner    like proc-desp-itiner.cod-itiner    no-undo.
    DEFINE input parameter p-cod-pto-contr like proc-desp-itiner.cod-pto-contr no-undo.

    assign c-cod-estabel    = p-cod-estabel
           c-nr-proc-exp    = p-nr-proc-exp
           i-cod-itiner     = int(p-cod-itiner)
           i-cod-pto-contr  = int(p-cod-pto-contr).


END PROCEDURE.

PROCEDURE setConstraint5:

    DEFINE input parameter p-cod-estabel   like proc-desp-itiner.cod-estabel   no-undo.
    DEFINE input parameter p-nr-proc-exp   like proc-desp-itiner.nr-proc-exp   no-undo.
    DEFINE input parameter p-cod-itiner    like proc-desp-itiner.cod-itiner    no-undo.
    
    assign c-cod-estabel   = p-cod-estabel
           c-nr-proc-exp   = p-nr-proc-exp
           i-cod-itiner    = int(p-cod-itiner).


END PROCEDURE.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where
                                         proc-desp-itiner.cod-estabel   >= c-cod-estabel  and
                                         proc-desp-itiner.nr-proc-exp   >= c-nr-proc-exp  and
                                         proc-desp-itiner.cod-itiner    >= i-cod-itiner   and
                                         proc-desp-itiner.sequencia     >= i-nr-sequencia and
                                         proc-desp-itiner.cod-pto-contr >= i-cod-pto-contr and
                                         proc-desp-itiner.cod-desp      >= i-cod-desp      and
                                         proc-desp-itiner.cod-emitente-desp >= i-cod-emit-desp no-lock.
        when 3 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock where
                                          rowid(proc-desp-itiner) = r-chave.
        when 4 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where
                 proc-desp-itiner.cod-estabel   = c-cod-estabel  and
                 proc-desp-itiner.nr-proc-exp   = c-nr-proc-exp  and
                 proc-desp-itiner.cod-itiner    = i-cod-itiner   and
                 proc-desp-itiner.cod-pto-contr = i-cod-pto-contr no-lock.
        when 5 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where
                 proc-desp-itiner.cod-estabel   = c-cod-estabel  and
                 proc-desp-itiner.nr-proc-exp   = c-nr-proc-exp  and
                 proc-desp-itiner.cod-itiner    = i-cod-itiner   no-lock.                
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.

