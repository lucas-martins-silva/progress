&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getUltimaMsg DBOProgram 
PROCEDURE getUltimaMsg :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
DEF OUTPUT PARAM pCodigo LIKE {&TABLENAME}.cdn-mensagem.                     
                     
FIND LAST bf{&TABLENAME} NO-LOCK NO-ERROR.
IF AVAIL bf{&TABLENAME} THEN
    ASSIGN pCodigo = bf{&TABLENAME}.cdn-mensagem + 1.
ELSE
    ASSIGN pCodigo = 1.

RETURN "OK":U.
END PROCEDURE.

