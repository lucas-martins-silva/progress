&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/
    
    IF pType = "CREATE" OR 
       pType = "COPY" THEN DO:
        IF CAN-FIND (FIRST msg-cex
                     WHERE msg-cex.cdn-mensagem = RowObject.cdn-mensagem) THEN
            /* Inicio -- Projeto Internacional */
            DO:
            DEFINE VARIABLE c-lbl-liter-mensagem-importacao AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Mensagem_Importaá∆o" *}
            ASSIGN c-lbl-liter-mensagem-importacao = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                  &ErrorNumber="1"
                  &ErrorType="EMS"
                  &ErrorParameters="c-lbl-liter-mensagem-importacao"}
            END. 

    END.

    IF pType = "DELETE" THEN DO:
        IF CAN-FIND (FIRST decla-import
                     WHERE decla-import.cdn-msg-di = RowObject.cdn-mensagem) THEN
            /* Inicio -- Projeto Internacional */
            DO:
            DEFINE VARIABLE c-lbl-liter-declaracao-de-importacao-vincu AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Declaraá∆o_de_Importaá∆o_vinculado_a_esta_mensagem" *}
            ASSIGN c-lbl-liter-declaracao-de-importacao-vincu = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                  &ErrorNumber="33077"
                  &ErrorType="EMS"
                  &ErrorParameters="c-lbl-liter-declaracao-de-importacao-vincu"}
            END. 

    END.


        


    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

