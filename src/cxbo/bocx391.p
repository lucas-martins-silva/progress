&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice msgcex-id
  Parameters:  
               recebe valor do campo cdn-mensagem
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcdn-mensagem LIKE msg-cex.cdn-mensagem NO-UNDO.

    FIND FIRST bfmsg-cex WHERE 
        bfmsg-cex.cdn-mensagem = pcdn-mensagem NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfmsg-cex THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfmsg-cex)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryByCodDesc DBOProgram 
PROCEDURE openQueryByCodDesc :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
OPEN QUERY {&QUERYNAME} FOR EACH  {&TABLENAME}
                            WHERE {&TABLENAME}.cdn-mensagem >= c-cdn-mensagem-ini
                            AND   {&TABLENAME}.cdn-mensagem <= c-cdn-mensagem-fim
                            AND   {&TABLENAME}.des-mensagem >= c-des-mensagem-ini
                            AND   {&TABLENAME}.des-mensagem <= c-des-mensagem-fim NO-LOCK INDEXED-REPOSITION.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

