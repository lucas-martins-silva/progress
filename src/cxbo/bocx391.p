&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE setConstraintByCodDesc DBOProgram 
PROCEDURE setConstraintByCodDesc :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
DEF INPUT PARAM p-cdn-mensagem-ini LIKE {&TABLENAME}.cdn-mensagem NO-UNDO.
DEF INPUT PARAM p-cdn-mensagem-fim LIKE {&TABLENAME}.cdn-mensagem NO-UNDO.
DEF INPUT PARAM p-des-mensagem-ini LIKE {&TABLENAME}.des-mensagem NO-UNDO.
DEF INPUT PARAM p-des-mensagem-fim LIKE {&TABLENAME}.des-mensagem NO-UNDO.

ASSIGN c-cdn-mensagem-ini = p-cdn-mensagem-ini 
       c-cdn-mensagem-fim = p-cdn-mensagem-fim       
       c-des-mensagem-ini = p-des-mensagem-ini       
       c-des-mensagem-fim = p-des-mensagem-fim.

RETURN "OK":U.
END PROCEDURE.

