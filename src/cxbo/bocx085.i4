procedure initializeValidate:
    /*
    **  Inicializa Validate
    */
    run startMethod ("initializeValidade":U).

    run endMethod   ("initializeValidade":U).
end procedure.

procedure findFirst:
    if l-query then
        get first {&QUERY-NAME}
            no-lock no-wait.
    else
        find first {&TABLE-NAME}
            no-lock no-error.
    run setCurrent.
end procedure.

procedure findLast:
    if l-query then
        get last {&QUERY-NAME}
            no-lock no-wait.
    else
        find last {&TABLE-NAME}
            no-lock no-error.
    run setCurrent.
end procedure.

procedure findNext:
    /*
    **  Localiza proximo registro na tabela.
    */
    def var i-numero-ordem as integer no-undo.
    def var i-cod-emitente as integer no-undo.
    def var c-it-codigo as char no-undo.
    def var i-seq-cotac as integer no-undo.
    def var d-data-cotacao as date no-undo.
    def var i-mapa-cotacao as integer no-undo.
    def output parameter c-return as char no-undo.

    if avail rowObject then
        assign i-numero-ordem = rowObject.numero-ordem
               i-cod-emitente = rowObject.cod-emitente
               c-it-codigo    = rowObject.it-codigo
               i-seq-cotac    = rowObject.seq-cotac
               d-data-cotacao = rowObject.data-cotacao
               i-mapa-cotacao = rowObject.mapa-cotacao.

    find first {&TABLE-NAME} where 
        {&TABLE-NAME}.numero-ordem = i-numero-ordem and
        {&TABLE-NAME}.cod-emitente = i-cod-emitente and
        {&table-name}.it-codigo    = c-it-codigo and
        {&TABLE-NAME}.seq-cotac    = i-seq-cotac and
        {&TABLE-NAME}.data-cotacao = d-data-cotacao and
        {&TABLE-NAME}.mapa-cotacao > i-mapa-cotacao
        no-lock no-error.
    
    if not avail {&TABLE-NAME} then
        find first {&TABLE-NAME} where 
            {&TABLE-NAME}.numero-ordem = i-numero-ordem and
            {&TABLE-NAME}.cod-emitente = i-cod-emitente and
            {&table-name}.it-codigo    = c-it-codigo and
            {&TABLE-NAME}.seq-cotac    = i-seq-cotac and
            {&TABLE-NAME}.data-cotacao > d-data-cotacao
            no-lock no-error.
            
        if not avail {&TABLE-NAME} then
            find first {&TABLE-NAME} where 
                {&TABLE-NAME}.numero-ordem = i-numero-ordem and
                {&TABLE-NAME}.cod-emitente = i-cod-emitente and
                {&table-name}.it-codigo    = c-it-codigo and
                {&TABLE-NAME}.seq-cotac    > i-seq-cotac
                no-lock no-error.
                
            if not avail {&TABLE-NAME} then
                find first  {&TABLE-NAME} where 
                    {&TABLE-NAME}.numero-ordem = i-numero-ordem and
                    {&TABLE-NAME}.cod-emitente = i-cod-emitente and
                    {&table-name}.it-codigo    > c-it-codigo
                    no-lock no-error.
                    
                if not avail {&TABLE-NAME} then
                    find first {&TABLE-NAME} where 
                        {&TABLE-NAME}.numero-ordem = i-numero-ordem and
                        {&TABLE-NAME}.cod-emitente > i-cod-emitente
                        no-lock no-error.
                        
                    if not avail {&TABLE-NAME} then                    
                        find first {&TABLE-NAME} where 
                            {&TABLE-NAME}.numero-ordem > i-numero-ordem
                            no-lock no-error.

    if not avail {&TABLE-NAME} then do:
        run utp/ut-msgs.p (input "msg":U,
                           input 7999,
                           input "").
        assign c-return = return-value.
    end.
    else run setCurrent.
end procedure.

procedure findPrev:
    /*
    **  Localiza registro anterior na tabela.
    */
    def var i-numero-ordem as integer no-undo.
    def var i-cod-emitente as integer no-undo.
    def var c-it-codigo as char no-undo.
    def var i-seq-cotac as integer no-undo.
    def var d-data-cotacao as date no-undo.
    def var i-mapa-cotacao as integer no-undo.
    def output parameter c-return as char no-undo.

    if avail rowObject then
        assign i-numero-ordem = rowObject.numero-ordem
               i-cod-emitente = rowObject.cod-emitente
               c-it-codigo    = rowObject.it-codigo
               i-seq-cotac    = rowObject.seq-cotac
               d-data-cotacao = rowObject.data-cotacao
               i-mapa-cotacao = rowObject.mapa-cotacao.

    find last {&TABLE-NAME} where 
        {&TABLE-NAME}.numero-ordem = i-numero-ordem and
        {&TABLE-NAME}.cod-emitente = i-cod-emitente and
        {&table-name}.it-codigo    = c-it-codigo and
        {&TABLE-NAME}.seq-cotac    = i-seq-cotac and
        {&TABLE-NAME}.data-cotacao = d-data-cotacao and
        {&TABLE-NAME}.mapa-cotacao < i-mapa-cotacao
        no-lock no-error.

    if not avail {&TABLE-NAME} then
        find last {&TABLE-NAME} where 
            {&TABLE-NAME}.numero-ordem = i-numero-ordem and
            {&TABLE-NAME}.cod-emitente = i-cod-emitente and
            {&table-name}.it-codigo    = c-it-codigo and
            {&TABLE-NAME}.seq-cotac    = i-seq-cotac and
            {&TABLE-NAME}.data-cotacao < d-data-cotacao
            no-lock no-error.
            
        if not avail {&TABLE-NAME} then
            find last {&TABLE-NAME} where 
                {&TABLE-NAME}.numero-ordem = i-numero-ordem and
                {&TABLE-NAME}.cod-emitente = i-cod-emitente and
                {&table-name}.it-codigo    = c-it-codigo and
                {&TABLE-NAME}.seq-cotac    < i-seq-cotac
                no-lock no-error.
                
            if not avail {&TABLE-NAME} then
                find last {&TABLE-NAME} where 
                    {&TABLE-NAME}.numero-ordem = i-numero-ordem and
                    {&TABLE-NAME}.cod-emitente = i-cod-emitente and
                    {&table-name}.it-codigo    < c-it-codigo
                    no-lock no-error.
                    
                if not avail {&TABLE-NAME} then
                    find last {&TABLE-NAME} where 
                        {&TABLE-NAME}.numero-ordem = i-numero-ordem and
                        {&TABLE-NAME}.cod-emitente < i-cod-emitente
                        no-lock no-error.
                        
                    if not avail {&TABLE-NAME} then
                        find last {&TABLE-NAME} where 
                            {&TABLE-NAME}.numero-ordem < i-numero-ordem
                            no-lock no-error.
                            
    if not avail {&TABLE-NAME} then do:
        run utp/ut-msgs.p (input "msg":U,
                           input 7998,
                           input "").
        assign c-return = return-value.
    end.
    else run setCurrent.
end procedure.

procedure getRowid:
    def output parameter r-chave as rowid no-undo.
    if avail {&TABLE-NAME} then do:
        assign r-chave = rowid({&TABLE-NAME}).
    end.
    else do:
       assign r-chave = ?.
    end.
end procedure.

procedure findCodigo:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    def input parameter i-numero-ordem as inte no-undo.
    def input parameter i-cod-emitente as inte no-undo.
    def input parameter c-it-codigo as char no-undo.
    &if defined(bf-mat-comex) &then    
        def input parameter da-cotacao as date no-undo.
    &else
        def input parameter i-seq-cotac as integer no-undo.    
    &endif
    def input parameter i-mapa-cotacao as inte no-undo.
    def input parameter c-cod-incoterm as char no-undo.
    def input parameter i-cod-itiner as inte no-undo.
    def input parameter i-sequencia as integer no-undo.
    def input parameter i-cod-emitente-desp as inte no-undo.
    def input parameter i-cod-desp as inte no-undo.
    def output parameter c-return as char no-undo.
    
    run startMethod ("find":U).

    find {&TABLE-NAME} where 
        {&TABLE-NAME}.numero-ordem      = i-numero-ordem and
        {&TABLE-NAME}.cod-emitente      = i-cod-emitente and
        {&table-name}.it-codigo         = c-it-codigo and
        &if defined(bf-mat-comex) &then
        &else
            {&TABLE-NAME}.seq-cotac     = i-seq-cotac and                             
        &endif
        {&TABLE-NAME}.data-cotacao      = da-cotacao and
        {&TABLE-NAME}.mapa-cotacao      = i-mapa-cotacao and
        {&TABLE-NAME}.cod-incoterm      = c-cod-incoterm and
        {&TABLE-NAME}.cod-itiner        = i-cod-itiner and
        {&TABLE-NAME}.sequencia         = i-sequencia and
        {&TABLE-NAME}.cod-emitente-desp = i-cod-emitente-desp and
        {&TABLE-NAME}.cod-desp = i-cod-desp
        no-lock no-error.
                
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex cotacao-item-cex 1}
        /******************************************/ 
        run utp/ut-msgs.p (input "msg":U,
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.

    run endMethod ("find":U).
end procedure.

procedure findCodigo2:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    def input parameter i-numero-ordem as inte no-undo.
    def input parameter i-cod-emitente as inte no-undo.
    def input parameter c-it-codigo as char no-undo.
    &if defined(bf-mat-comex) &then        
        def input parameter da-cotacao as date no-undo.        
    &else
        def input parameter i-seq-cotac as integer no-undo.    
    &endif
    def input parameter i-mapa-cotacao as inte no-undo.
    def input parameter c-cod-incoterm as char no-undo.
    def input parameter i-cod-itiner as inte no-undo.
    def input parameter i-cod-emitente-desp as inte no-undo.
    def input parameter i-cod-desp as inte no-undo.
    def output parameter c-return as char no-undo.

    run startMethod ("find":U).

    find {&TABLE-NAME} where 
        {&TABLE-NAME}.numero-ordem = i-numero-ordem and
        {&TABLE-NAME}.cod-emitente = i-cod-emitente and
        {&table-name}.it-codigo = c-it-codigo and
        &if defined(bf-mat-comex) &then
        &else                                   
            {&TABLE-NAME}.seq-cotac = i-seq-cotac and                                     
        &endif
        {&TABLE-NAME}.data-cotacao = da-cotacao and
        {&TABLE-NAME}.mapa-cotacao = i-mapa-cotacao and
        {&TABLE-NAME}.cod-incoterm = c-cod-incoterm and
        {&TABLE-NAME}.cod-itiner = i-cod-itiner and              
        {&TABLE-NAME}.cod-emitente-desp = i-cod-emitente-desp and
        {&TABLE-NAME}.cod-desp = i-cod-desp
