procedure ValidateRowid:
/*
Procedure criada para verificar se o rowid passado para o programa wim0510 Ç realmente do cotacao-item-cex.
*/

def input parameter r-rowid as rowid no-undo.
def output parameter c-erro as char no-undo.

find cotacao-item-cex where
     rowid(cotacao-item-cex) = r-rowid no-lock no-error.
if not avail cotacao-item-cex then
    assign c-erro = "Rowid N∆o Encontrado".

end procedure.

procedure findOrdemaprovadacc0308:
/* 
** Retorna rowid da cotacao-item-cex referente a ordem-compra, procura primeira pela cotacao aprovada
*/
def input  parameter i-numero-ordem like ordem-compra.numero-ordem no-undo. 
def output parameter r-chave        as rowid no-undo.
find ordem-compra
    where ordem-compra.numero-ordem = i-numero-ordem
    no-lock no-error.
    
for each cotacao-item
    where cotacao-item.numero-ordem = i-numero-ordem 
      and cotacao-item.cod-emitente = ordem-compra.cod-emitente
      and cotacao-item.it-codigo    = ordem-compra.it-codigo
      no-lock:
    if cotacao-item.cot-aprovada then do:
        {ccp/cc9019.i50}
        &if defined(bf-mat-comex) &then
            assign i-mapa-cotacao-i50  = int(substring(cotacao-item.char-1,6,2))
                   c-cod-incoterm-i50  = substring(cotacao-item.char-1,8,3)
                   i-cod-pto-contr-i50 = int(substring(cotacao-item.char-1,11,5)).
        &else
            {cdp/cd4300.i4 "yes" cotacao-item.char-1}
            {ccp/cc9019.i51 "yes"}
        &endif
        
        find first cotacao-item-cex
            where cotacao-item-cex.numero-ordem = cotacao-item.numero-ordem
              and cotacao-item-cex.cod-emitente = cotacao-item.cod-emitente
              and cotacao-item-cex.it-codigo    = cotacao-item.it-codigo
              &if defined(bf-mat-comex) &then              
              &else
                  and cotacao-item-cex.seq-cotac    = cotacao-item.seq-cotac
              &endif
              and cotacao-item-cex.data-cotacao = cotacao-item.data-cotacao
              and cotacao-item-cex.mapa-cotacao = i-mapa-cotacao-i50
              no-lock no-error.
        if avail cotacao-item-cex then
            assign r-chave = rowid(cotacao-item-cex).
        leave.
    end.
end.

end procedure.


