    def input parameter c-cod-incoterm as char no-undo.
    def input parameter i-cod-itiner as inte no-undo.
    def input parameter i-cod-emitente-desp as inte no-undo.
    def input parameter i-cod-desp as inte no-undo.
    def output parameter c-return as char no-undo.

    run startMethod ("find":U).

    find first {&TABLE-NAME} where 
        {&table-name}.it-codigo = c-it-codigo and
        {&TABLE-NAME}.cod-emitente = i-cod-emitente and
        {&TABLE-NAME}.data-cotacao = da-data-cotacao and
        {&TABLE-NAME}.numero-ordem = i-numero-ordem and
        {&TABLE-NAME}.cod-incoterm = c-cod-incoterm and
        {&TABLE-NAME}.cod-itiner = i-cod-itiner and
        {&TABLE-NAME}.cod-emitente-desp = i-cod-emitente-desp and
        {&TABLE-NAME}.cod-desp = i-cod-desp
        no-lock no-error.
        
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex cotacao-item-cex 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg":U,
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.

    run endMethod ("find":U).
end procedure.

