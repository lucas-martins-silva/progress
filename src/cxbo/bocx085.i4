    end.

    run endMethod ("find":U).
end procedure.

procedure findCotacao:
    /*
    **  Procura o primeiro registro da cotacao do material informada.
    */
    def input parameter pr-chave as rowid no-undo. /* rowid cotacao-item */
    def output parameter table for RowObject.
    def output parameter c-return as char no-undo.
    
    find cotacao-item 
        where rowid(cotacao-item) = pr-chave 
        no-lock no-error.
    if avail cotacao-item then do:
        find first {&TABLE-NAME} 
            where {&TABLE-NAME}.numero-ordem = cotacao-item.numero-ordem 
              and {&TABLE-NAME}.cod-emitente = cotacao-item.cod-emitente 
              and {&table-name}.it-codigo    = cotacao-item.it-codigo 
              &if defined(bf-mat-comex) &then              
              &else
                and {&TABLE-NAME}.seq-cotac    = cotacao-item.seq-cotac              
              &endif
              and {&TABLE-NAME}.data-cotacao = cotacao-item.data-cotacao
              no-lock no-error.
        if avail {&TABLE-NAME} then              
            run setCurrent.              
    end.
            
end procedure.

procedure findCotacaoitem:
    /*
    **  Procura o primeiro registro da cotacao do material informada.
    */
    def input parameter p-numero-ordem like ordem-compra.numero-ordem no-undo.
    def input parameter p-cod-emitente like emitente.cod-emitente no-undo.
    def input parameter p-it-codigo    like item.it-codigo no-undo.
  &if defined(bf-mat-comex) &then
  &else
    def input parameter p-seq-cotac    like cotacao-item.seq-cotac no-undo.
  &endif
    def input parameter p-data-cotacao like cotacao-item.data-cotacao no-undo.
    def output parameter c-return as char no-undo.
    
    find first cotacao-item-cex
        where cotacao-item-cex.numero-ordem = p-numero-ordem
          and cotacao-item-cex.cod-emitente = p-cod-emitente
          and cotacao-item-cex.it-codigo    = p-it-codigo
        &if defined(bf-mat-comex) &then
        &else
          and cotacao-item-cex.seq-cotac    = p-seq-cotac
        &endif
          and cotacao-item-cex.data-cotacao = p-data-cotacao
          no-lock no-error.
    if avail {&TABLE-NAME} then do:
        if avail {&TABLE-NAME} then              
            run setCurrent.              
    end.
    else do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex cotacao-item-cex 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg":U,
                           input 2,
                           input return-value).
        assign c-return = return-value.    
    end.            
end procedure.

procedure findSub:
    /*
    **  Localiza bloco de registro subsequente na tabela.
    **  O bloco e formado pelos registros com mesma chave.
    */
    def output parameter c-return as char no-undo.

    run startMethod ("find":U).

    assign i-numero-ordem      = {&TABLE-NAME}.numero-ordem
           i-cod-emitente      = {&TABLE-NAME}.cod-emitente
           c-it-codigo         = {&table-name}.it-codigo
           i-seq-cotac         = {&TABLE-NAME}.seq-cotac
           da-cotacao          = {&TABLE-NAME}.data-cotacao
           i-mapa-cotacao      = {&TABLE-NAME}.mapa-cotacao
           c-cod-incoterm      = {&TABLE-NAME}.cod-incoterm
           i-cod-itiner        = {&TABLE-NAME}.cod-itiner
           i-sequencia         = {&TABLE-NAME}.sequencia.

    find first {&TABLE-NAME} where 
        {&TABLE-NAME}.numero-ordem  = i-numero-ordem and
        {&TABLE-NAME}.cod-emitente  = i-cod-emitente and
        {&table-name}.it-codigo     = c-it-codigo and
        {&TABLE-NAME}.seq-cotac     = i-seq-cotac and
        {&TABLE-NAME}.data-cotacao  = da-cotacao  and  
        {&TABLE-NAME}.mapa-cotacao  = i-mapa-cotacao and
        {&TABLE-NAME}.cod-incoterm  = c-cod-incoterm and
        {&TABLE-NAME}.cod-itiner    = i-cod-itiner and
        {&TABLE-NAME}.sequencia     <> i-sequencia
        no-lock no-error.

    if avail {&TABLE-NAME} then
        run setCurrent.
    else do:
        find first {&TABLE-NAME} where {&TABLE-NAME}.numero-ordem <> i-numero-ordem no-lock no-error.
        if avail {&TABLE-NAME} then
            run setCurrent.
    end.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex cotacao-item-cex 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg":U,
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    run endMethod ("find":U).
end procedure.

procedure executeUpdate:
    /*
    **  Executa Update
    */
    buffer-copy RowObject except r-rowid
        numero-ordem cod-emitente it-codigo seq-cotac data-cotacao mapa-cotacao
        data-cotacao cod-incoterm cod-itiner sequencia cod-emitente-desp cod-desp to {&TABLE-NAME}.
end procedure.

procedure validateFields:
    /*
    **  Valida Fields
    */
    
    def var c-return1 as char no-undo.
    def var c-return-value as char no-undo.

    run startMethod ("validateFields":U).    

    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

    find first RowObject no-error.
    
    /* Validacao Tabela de Preco */
    if rowObject.cod-cond-pag = ? or rowObject.cod-cond-pag = 0 then DO:
        {cxbo/bocx085.i2 rowObject.nr-tab 
                         rowObject.cod-emitente-desp 
                         rowObject.cod-itiner 
                         rowObject.cod-incoterm 
                         rowObject.cod-desp
                         ?
                         &VALIDA-DESPESA}
    END.                     
    else DO:
        {cxbo/bocx085.i2 rowObject.nr-tab 
                         rowObject.cod-emitente-desp 
                         rowObject.cod-itiner 
                         rowObject.cod-incoterm 
                         rowObject.cod-desp
                         rowObject.cod-cond-pag}
    END.                     

    if rowObject.cod-pto-contr = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex cotacao-item-cex cod-pto-contr 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.    
    end.
    else do:
        if not can-find(pto-contr where pto-contr.cod-pto-contr = rowObject.cod-pto-contr) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex pto-contr 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.            
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.            
        end.
        if not can-find(pto-itiner where pto-itiner.cod-itiner    = rowObject.cod-itiner and
                                         pto-itiner.cod-pto-contr = rowObject.cod-pto-contr) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex pto-itiner 1}
            /******************************************/        
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.            
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.            
        end.        
    end.

    if rowObject.cod-comprado = "" then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex cotacao-item-cex cod-comprado 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                          input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    else
        if not can-find(comprador where comprador.cod-comprado = rowObject.cod-comprado) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-liter.i Comprador * L}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = trim(return-value).            
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input tt-bo-erro.parametros).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.
        end.
        
    if rowObject.cod-cond-pag <> 0 then
        if not can-find(cond-pagto where cond-pagto.cod-cond-pag = rowObject.cod-cond-pag) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgadm cond-pagto 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.            
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.
        end.

    if rowObject.data-cotacao-desp = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex cotacao-item-cex data-cotacao-desp 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.

    end.

    if rowObject.dias-validade = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex cotacao-item-cex dias-validade 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.

    end.
    
    /* Validacao Moeda */
    /*frank - 09/05/05*/
    &IF DEFINED(BF_DIS_VERSAO_EMS) &THEN         
        &IF '{&BF_DIS_VERSAO_EMS}' < '2.04' &THEN
           {cxbo/bocx085.i3}
        &ENDIF                                    
    &ELSE                                         
       {cxbo/bocx085.i3}
    &ENDIF                                        
    /*fim frank - 09/05/05*/        

    if rowObject.perc-descto > 100 then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg":U,
                           input 507,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 507
               tt-bo-erro.mensagem     = return-value.
    end.
/*
    if rowObject.usuario = "" then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex cotacao-item-cex usuario 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.

    end.
*/

    if  rowObject.val-desp = 0
    or  rowObject.val-desp = ? then do:
        assign i-seq-erro     = i-seq-erro + 1.
               
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex cotacao-item-cex val-desp 1}
        /******************************************/
        assign c-return-value = return-value + string(rowObject.cod-desp).
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value + string(rowObject.cod-desp).        
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input c-return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.

    assign rowObject.data-atualiz = today
           rowObject.hora-atualiz = string(time,'HH:MM:SS'). /* Grava a hora da atualizacao */
           
    RUN procuraEmbarqueCompras (INPUT "Material em TrÉnsito").

    run endMethod ("validateFields":U).
end procedure.


procedure validateDelete:
    /*
    **  Valida Delete
    */
    def input-output parameter r-chave as rowid.
    def output parameter table for tt-bo-erro.    
    run InitializeValidate.
    
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    for each tt-cotacao-temp:
        delete tt-cotacao-temp.
    end.
    find {&TABLE-NAME} where
        rowid({&TABLE-NAME}) = r-chave
        exclusive-lock no-error.
    create tt-cotacao-temp.
    buffer-copy {&TABLE-NAME} to tt-cotacao-temp.
    assign tt-cotacao-temp.r-rowid = rowid({&TABLE-NAME}).

    &IF '{&BF_MAT_VERSAO_EMS}' >= '2.062' &THEN
        run findRowid(input r-chave).
        run getCurrent(output table rowObject).
        RUN validateImport.
        
    &ENDIF

    if  avail {&TABLE-NAME} 
    AND NOT CAN-FIND(FIRST tt-bo-erro
                     WHERE tt-bo-erro.errorSubType <> "INFORMATION":U
                       AND tt-bo-erro.errorSubType <> "WARNING":U) then do:

        run executeDelete.

        &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
        run imp/imapi006.p(input "tt-cotacao-item-cex":U,  
                           input ?,
                           input rowObject.cod-desp,
                           input 0,
                           input table rowObject,
                           input-output table tt-desp-ja-recalc).

        &endif


    end.

    run findVapara (input tt-cotacao-temp.it-codigo,
                    input tt-cotacao-temp.cod-emitente,
                    &if defined(bf-mat-comex) &then                    
                        input tt-cotacao-temp.data-cotacao,
                    &else
                        input tt-cotacao-temp.seq-cotac,                    
                    &endif
                    input tt-cotacao-temp.numero-ordem,
                    input tt-cotacao-temp.mapa-cotacao,
                    output c-return).
    if c-return <> "" then do:
        &IF '{&BF_MAT_VERSAO_EMS}' >= '2.062' &THEN
        &else
            create rowObject. 
            buffer-copy tt-cotacao-temp to rowObject.
        &endif    
        delete tt-cotacao-temp.
        run findNext (output c-return).
        if c-return <> "" then
            run findPrev (output c-return).
    end.
    if c-return <> "" then
        run findFirst.
    
    if avail {&TABLE-NAME} then
        assign r-chave = rowid({&TABLE-NAME}).
    return "".
end procedure.

procedure validateDeletepaicc0308:
def input-output parameter r-chave as rowid.
def output parameter table for tt-bo-erro.

assign l-cc0308 = yes.

run validateDeletepai(input-output r-chave,
                      output table tt-bo-erro).

assign l-cc0308 = no.                          
end procedure.

procedure validateDeletepai:
    /*
    **  Valida Delete
    */
    def input-output parameter r-chave as rowid.
    def output parameter table for tt-bo-erro.
    
    run startMethod ("validateDeletepai":U).
    
    for each rowObject:
        delete rowObject.
    end.
   
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    
    run InitializeValidate.
    
    find {&TABLE-NAME} where rowid({&TABLE-NAME}) = r-chave no-lock no-error.
    
    if avail {&TABLE-NAME} then do:
    
        find cotacao-item exclusive-lock
            where cotacao-item.it-codigo    = {&table-name}.it-codigo 
              and cotacao-item.cod-emitente = {&TABLE-NAME}.cod-emitente
              and cotacao-item.data-cotacao = {&TABLE-NAME}.data-cotacao                  
              and cotacao-item.numero-ordem = {&TABLE-NAME}.numero-ordem               
              &if defined(bf-mat-comex) &then                                                  
              &else
                and cotacao-item.seq-cotac  = {&TABLE-NAME}.seq-cotac
              &endif
              no-error.                  
        if avail cotacao-item then do:  
            
            {ccp/cc9019.i50}
            &if defined(bf-mat-comex) &then
                assign i-mapa-cotacao-i50  = int(substring(cotacao-item.char-1,6,2))
                       c-cod-incoterm-i50  = substring(cotacao-item.char-1,8,3)
                       i-cod-pto-contr-i50 = int(substring(cotacao-item.char-1,11,5)).
            &else                        
                {cdp/cd4300.i4 "yes" cotacao-item.char-1}
                {ccp/cc9019.i51 "yes"}            
            &endif
            if i-mapa-cotacao-i50 = {&TABLE-NAME}.mapa-cotacao and
               c-cod-incoterm-i50 = {&TABLE-NAME}.cod-incoterm then do:                                
               
                if cotacao-item.cot-aprovada and not l-cc0308 then do:
                    assign i-seq-erro = i-seq-erro + 1.
                    run utp/ut-msgs.p (input "msg":U,
                                       input 17266,
                                       input "").
                    create tt-bo-erro.
                    assign tt-bo-erro.i-sequen = i-seq-erro
                           tt-bo-erro.cd-erro  = 17266
                           tt-bo-erro.mensagem = return-value.
                end.
                else do:
                    assign i-mapa-cotacao-i50     = 0.
                    &if defined(bf-mat-comex) &then
                        assign substring(cotacao-item.char-1,6,2) = string(i-mapa-cotacao-i50,"99").
                    &else
                        {ccp/cc9019.i51 "no"}
                        {cdp/cd4300.i4 "no" cotacao-item.char-1}.
                    &endif
                end.
            end.
        end.

        if not can-find(first tt-bo-erro
                        WHERE tt-bo-erro.errorSubType <> "INFORMATION":U
                          AND tt-bo-erro.errorSubType <> "WARNING":U) then do:
            create rowObject.
            buffer-copy {&TABLE-NAME} to rowObject.
            for each {&TABLE-NAME} where 
                {&TABLE-NAME}.numero-ordem = rowObject.numero-ordem and
                {&TABLE-NAME}.cod-emitente = rowObject.cod-emitente and
                {&table-name}.it-codigo    = rowObject.it-codigo    and
                {&TABLE-NAME}.seq-cotac    = rowObject.seq-cotac    and
                {&TABLE-NAME}.data-cotacao = rowObject.data-cotacao and
                {&TABLE-NAME}.mapa-cotacao = rowObject.mapa-cotacao exclusive-lock :
                run executeDelete.
            end.
        end.
    end.
    run findNext (output c-return).
    
    if c-return <> "" then 
        run findPrev (output c-return).
    
    assign r-chave = rowid({&TABLE-NAME}).
    run endMethod("validateDeletepai":U).
    

end procedure.

procedure validateCreatepai:
    /*
    **  Valida criacao da tabela/duplicidade de registro criado pelo programa pai.
    **  Cria os filhos automaticamente de acordo com as despesas registradas.
    */
    def input-output  parameter table for RowObject.
    def output        parameter table for tt-bo-erro.
    def output        parameter r-chave as rowid no-undo.
    def output        parameter l-criou as logical init no no-undo.
    
    
    def var i-auto-num          as integer no-undo.
    def var i-seq-desp          as integer no-undo.
    def var d-valor-despesa     as decimal no-undo.
    def var d-valor-aux         as decimal no-undo.
    def var l-desp-imposto      as logical no-undo.
    DEF VAR r-first-rowid       AS ROWID   NO-UNDO.
    def var i-numero-ordem      like cotacao-item-cex.numero-ordem no-undo.     
    def var c-cod-emitente      like cotacao-item-cex.cod-emitente no-undo.     
    def var c-it-codigo         like cotacao-item-cex.it-codigo    no-undo.
    def var i-seq-cotac         like cotacao-item-cex.seq-cotac    no-undo.     
    def var dt-cotac            like cotacao-item-cex.data-cotacao no-undo.     
    def var i-mapa-cotacao      like cotacao-item-cex.mapa-cotacao no-undo.     
    def var c-cod-emitente-desp like cotacao-item-cex.cod-emitente-desp no-undo.

    run startMethod("validateCreatepai":U).
    run initializeValidate.
    
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    
    find first rowObject no-error.    
    
    run validateFieldscreate.
    if not can-find(first tt-bo-erro
                    WHERE tt-bo-erro.errorSubType <> "INFORMATION":U
                      AND tt-bo-erro.errorSubType <> "WARNING":U) then
        if rowObject.mapa-cotacao = 0 then do:
            run autoNumber(output i-auto-num).
            if i-auto-num > 99 then do:
                assign i-seq-erro = i-seq-erro + 1.
                /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                   pre-processador em chamada de includes */
                {utp/ut-table.i mgcex cotacao-item-cex 1}
                /******************************************/
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                run utp/ut-msgs.p (input "msg":U,
                                   input 17052,
                                   input return-value).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 17052
                       tt-bo-erro.mensagem     = return-value.
            end.
            else assign rowObject.mapa-cotacao = i-auto-num.
        end.
        
    if not can-find(first tt-bo-erro
                    WHERE tt-bo-erro.errorSubType <> "INFORMATION":U
                      AND tt-bo-erro.errorSubType <> "WARNING":U) then
       if  can-find(first {&TABLE-NAME} where 
           {&TABLE-NAME}.numero-ordem = rowObject.numero-ordem and
           {&TABLE-NAME}.cod-emitente = rowObject.cod-emitente and
           {&table-name}.it-codigo    = rowObject.it-codigo and
           /*
           {&TABLE-NAME}.seq-cotac    = rowObject.seq-cotac and
           {&TABLE-NAME}.data-cotacao = rowObject.data-cotacao and
           */
           {&TABLE-NAME}.mapa-cotacao = rowObject.mapa-cotacao ) then do:
           
           assign i-seq-erro = i-seq-erro + 1.
           /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
              pre-processador em chamada de includes */
           {utp/ut-table.i mgcex cotacao-item-cex 1}
           /******************************************/
           create tt-bo-erro.
           assign tt-bo-erro.parametros = return-value.
           run utp/ut-msgs.p (input "msg":U,
                              input 8,
                              input return-value).
           assign tt-bo-erro.i-sequen     = i-seq-erro
                  tt-bo-erro.cd-erro      = 8
                  tt-bo-erro.mensagem     = return-value.
       end.
    
    find first tt-bo-erro 
         WHERE tt-bo-erro.errorSubType <> "INFORMATION":U
           AND tt-bo-erro.errorSubType <> "WARNING":U no-error.
    if not avail tt-bo-erro then do:

        find ordem-compra 
            where ordem-compra.numero-ordem = rowObject.numero-ordem no-lock no-error.
        if  avail ordem-compra then do:
            find param-imp 
                where param-imp.cod-estabel = ordem-compra.cod-estabel no-lock no-error.
            
            if l-nt2024002 then
                find first param-imp-trib
                    where param-imp-trib.cod-estabel = ordem-compra.cod-estabel no-lock no-error.
        end.
        
        create tt-cotacao-im001.
        assign tt-cotacao-im001.cod-versao-integracao = 2
               tt-cotacao-im001.it-codigo    = rowObject.it-codigo
               tt-cotacao-im001.cod-itiner   = rowObject.cod-itiner
               tt-cotacao-im001.cod-incoterm = rowObject.cod-incoterm
               tt-cotacao-im001.cod-emitente = rowObject.cod-emitente
               &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
               tt-cotacao-im001.numero-ordem = rowObject.numero-ordem
               &endif
               .
        
        run imp/imapi001.p (input table tt-cotacao-im001,
                            output table tt-despesas-im001,
                            output table tt-erro-im001).    /* Despesas Pre-Cadastradas (Itiner, Item) */
        
        find first tt-erro-im001 no-error.
        if avail tt-erro-im001 then do:
            
            assign i-seq-erro = i-seq-erro + 1.
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen   = i-seq-erro
                   tt-bo-erro.cd-erro    = tt-erro-im001.cd-erro
                   tt-bo-erro.mensagem   = tt-erro-im001.mensagem
                   tt-bo-erro.parametros = tt-erro-im001.parametros.
        end.
        else do:
            
            for each tt-cotacao-temp:
                delete tt-cotacao-temp.
            end.
            assign i-seq-desp = 0.
            /*find first rowobject no-error.*/

            for each tt-despesas-im001:
            
                assign i-seq-desp              = tt-despesas-im001.seq /*i-seq-desp + 1*/
                       l-criou                 =  yes
                       rowObject.sequencia     = i-seq-desp
                       rowObject.cod-desp      = tt-despesas-im001.cod-desp
                       rowObject.cod-pto-contr = tt-despesas-im001.cod-pto-contr
                       rowObject.val-desp      = 0
                       rowObject.nr-tab        = tt-despesas-im001.nr-tab.

                /*--- Eng. Cotaá∆o Autom†tica ---*/
                /* (Fornecedor padr∆o do cd2756) */
                for first desp-imp fields(cod-desp cod-emitente tp-despesa 
                                         &if defined(bf-mat-comex) &then char-1 &else &endif)
                    where desp-imp.cod-desp = rowObject.cod-desp no-lock:
                end.
                
                if avail desp-imp then do:
                     assign rowObject.cod-emitente-desp = tt-despesas-im001.cod-emitente.
                      
                      if rowObject.cod-emitente-desp = ? then
                         assign rowObject.cod-emitente-desp = 0.
                         
                     /* Gravaá∆o do tipo de despesa */
                     
                     if desp-imp.tp-despesa <> 0 then
                            assign rowObject.tp-despesa = desp-imp.tp-despesa.
                     else 
                         for first emitente fields(tp-desp-padrao) 
                             where emitente.cod-emitente = RowObject.cod-emitente no-lock:
                             assign rowObject.tp-despesa = emitente.tp-desp-padrao.
                         end.
                end.
                else
                    assign rowObject.cod-emitente-desp = 0.
                    
                
                find first emitente
                     where emitente.cod-emitente =  rowobject.cod-emitente-desp no-lock no-error.
                if avail emitente then
                    assign rowobject.cod-cond-pag = emitente.cod-cond-pag.
                
                RELEASE tb-pr-cex.
                RELEASE desp-tb-pr-cex.
                
                
                if tt-despesas-im001.nr-tab <> "":U then do:
                    
                    /* Mesma logica utilizada na bocx085.i6
                       Procura por tabelas na ordem ate encontrar alguma 
                       itinerario e incoterm -> itinerario e sem incoterm -> sem itinerario com incoterm -> sem itinerario e sem incoterm
                     */
                    find first tb-pr-cex 
                         where tb-pr-cex.cod-emitente = tt-despesas-im001.cod-emitente
                           and tb-pr-cex.cod-itiner   = rowObject.cod-itiner
                           and tb-pr-cex.cod-incoterm = rowObject.cod-incoterm
                           and tb-pr-cex.nr-tab       = tt-despesas-im001.nr-tab no-lock no-error.

                    if not avail tb-pr-cex then do:
                        find first tb-pr-cex 
                             where tb-pr-cex.cod-emitente = tt-despesas-im001.cod-emitente
                               and tb-pr-cex.cod-itiner   = rowObject.cod-itiner
                               and tb-pr-cex.cod-incoterm = ""
                               and tb-pr-cex.nr-tab       = tt-despesas-im001.nr-tab no-lock no-error.
                
                        if not avail tb-pr-cex then do:
                            find first tb-pr-cex 
                                 where tb-pr-cex.cod-emitente = tt-despesas-im001.cod-emitente
                                   and tb-pr-cex.cod-itiner   = 0 
                                   and tb-pr-cex.cod-incoterm = rowObject.cod-incoterm
                                   and tb-pr-cex.nr-tab       = tt-despesas-im001.nr-tab no-lock no-error.
                            
                            if not avail tb-pr-cex then
                                find first tb-pr-cex 
                                    where tb-pr-cex.cod-emitente = tt-despesas-im001.cod-emitente
                                      and tb-pr-cex.cod-itiner   = 0 
                                      and tb-pr-cex.cod-incoterm = "" 
                                      and tb-pr-cex.nr-tab       = tt-despesas-im001.nr-tab no-lock no-error.
                        end.
                    end.
                    if avail tb-pr-cex then do:
                        find first desp-tb-pr-cex 
                             where desp-tb-pr-cex.cod-emitente = tb-pr-cex.cod-emitente
                               and desp-tb-pr-cex.cod-itiner   = tb-pr-cex.cod-itiner
                               and desp-tb-pr-cex.cod-incoterm = tb-pr-cex.cod-incoterm
                               and desp-tb-pr-cex.nr-tab       = tb-pr-cex.nr-tab
                               and desp-tb-pr-cex.cod-desp     = tt-despesas-im001.cod-desp 
                               and desp-tb-pr-cex.cod-cond-pag = rowobject.cod-cond-pag no-lock no-error.
                    end.
                end.
                
                if avail tb-pr-cex then do:
                    assign rowObject.mo-codigo = tb-pr-cex.mo-codigo.
                    if not can-find(first desp-tb-pr-cex 
                                    where desp-tb-pr-cex.cod-emitente = tb-pr-cex.cod-emitente 
                                      and desp-tb-pr-cex.cod-itiner   = tb-pr-cex.cod-itiner   
                                      and desp-tb-pr-cex.cod-incoterm = tb-pr-cex.cod-incoterm 
                                      and desp-tb-pr-cex.nr-tab       = tb-pr-cex.nr-tab       
                                      and desp-tb-pr-cex.cod-desp     = Rowobject.cod-desp) then
                       assign rowobject.nr-tab = "".
                end.
                else
                    assign rowobject.nr-tab = "".
                
                /* Atualiza dados das despesas correspondentes aos impostos */
                assign l-desp-imposto = no.

                if  param-imp.log-cotac-autom-impto-import 
                and int(substr(param-imp.char-1,21,20)) = desp-imp.cod-desp then
                    assign rowObject.cod-emitente-desp = int(substr(param-imp.char-1,1,20)) /* emitente despesa correspondente ao II */
                           l-desp-imposto              = yes.
                else 
                     if  param-imp.log-cotac-autom-ipi
                     and param-imp.cdn-despes-impto-ipi = desp-imp.cod-desp then
                         assign rowObject.cod-emitente-desp = param-imp.cdn-fornec-ipi
                                l-desp-imposto              = yes.
                     else
                          if  param-imp.log-cotac-autom-pis
                          and param-imp.cdn-despes-impto-pis = desp-imp.cod-desp then
                              assign rowObject.cod-emitente-desp = param-imp.cdn-fornec-pis
                                     l-desp-imposto              = yes.
                          else 
                               if  param-imp.log-cotac-autom-cofins
                               and param-imp.cdn-despes-impto-cofins = desp-imp.cod-desp then
                                   assign rowObject.cod-emitente-desp = param-imp.cdn-fornec-cofins
                                          l-desp-imposto              = yes.
                               else 
                                    if  param-imp.log-cotac-autom-icms
                                    and param-imp.cdn-despes-impto-icms = desp-imp.cod-desp then
                                        assign rowObject.cod-emitente-desp = param-imp.cdn-fornec-icms
                                               l-desp-imposto              = yes.
                
                if l-nt2024002 and avail param-imp-trib then do: 
                    if  param-imp-trib.log-cotac-autom-IBSUF
                    and param-imp-trib.cdn-despes-impto-IBSUF = desp-imp.cod-desp then
                        assign rowObject.cod-emitente-desp = param-imp-trib.cdn-fornec-IBSUF
                               l-desp-imposto              = yes.
                    else
                    if  param-imp-trib.log-cotac-autom-CBS
                    and param-imp-trib.cdn-despes-impto-CBS = desp-imp.cod-desp then
                        assign rowObject.cod-emitente-desp = param-imp-trib.cdn-fornec-CBS
                               l-desp-imposto              = yes.
                    else
                    if  param-imp-trib.log-cotac-autom-IBSMun
                    and param-imp-trib.cdn-despes-impto-IBSMun = desp-imp.cod-desp then
                        assign rowObject.cod-emitente-desp = param-imp-trib.cdn-fornec-IBSMun
                               l-desp-imposto              = yes.
                    else
                    if  param-imp-trib.log-cotac-autom-IS
                    and param-imp-trib.cdn-despes-impto-IS = desp-imp.cod-desp then
                        assign rowObject.cod-emitente-desp = param-imp-trib.cdn-fornec-IS
                               l-desp-imposto              = yes.
                end.
                
                if  l-desp-imposto then do:        
                    find emitente
                        where emitente.cod-emitente = rowObject.cod-emitente-desp no-lock no-error.
                    if  avail emitente then
                        assign rowObject.cod-cond-pag = emitente.cod-cond-pag.
            
                    assign rowObject.perc-descto  = 0
                           rowObject.taxa-financ  = yes
                           rowObject.perc-taxa    = 0
                           rowObject.nr-dias-taxa = 30
                           rowObject.nr-tab       = "".
            
                    find cotacao-item 
                        where cotacao-item.numero-ordem = rowObject.numero-ordem
                        and   cotacao-item.cod-emitente = rowObject.cod-emitente
                        and   cotacao-item.it-codigo    = rowObject.it-codigo
                        and   cotacao-item.seq-cotac    = rowObject.seq-cotac no-lock no-error.
                    if  avail cotacao-item then
                        assign rowObject.mo-codigo = cotacao-item.mo-codigo.
                end.
                else do:
                    if available tb-pr-cex and
                       available desp-tb-pr-cex then do:
                        assign rowObject.perc-descto  = desp-tb-pr-cex.perc-descto
                               rowObject.taxa-financ  = tb-pr-cex.taxa-financ
                               rowObject.perc-taxa    = tb-pr-cex.perc-taxa
                               rowObject.nr-dias-taxa = tb-pr-cex.nr-dias-taxa.
                    end.
                    else if tt-despesas-im001.nr-tab = "":U and
                            rowObject.cod-emitente-desp <> 0 then do:
                            
                        find emitente-cex no-lock where
                            emitente-cex.cod-emitente = rowObject.cod-emitente-desp no-error.
                        if avail emitente-cex then
                            assign rowObject.mo-codigo = emitente-cex.mo-codigo.
                        
                    end.
                end.
                

                
                if  rowObject.cod-emitente-desp <> 0
                and rowObject.cod-cond-pag      <> 0
                and rowObject.cod-pto-contr     <> 0 then do:
                    if l-desp-imposto then  
                        assign rowObject.log-gerac-autom = yes.
                    else if rowObject.nr-tab            <> "" then
                            assign rowObject.log-gerac-autom = yes.
                end.            
                
                
                if  rowObject.cod-emitente-desp <> 0 and rowObject.nr-tab <> "":U then
                    run validateInitialize(input  table rowObject,
                                           output table tt-bo-erro).
                find first tt-bo-erro 
                     WHERE tt-bo-erro.errorSubType <> "INFORMATION":U
                       AND tt-bo-erro.errorSubType <> "WARNING":U no-error.
                if avail tt-bo-erro then
                    assign l-criou = no.

                /* Valor Despesa */
                if  l-criou then do:
                    run cxbo/bocx095c.p persistent set h-bocx095c.
                    run setCotacaoDespesaImportacao in h-bocx095c(input rowObject.numero-ordem,
                                                                  input rowObject.cod-emitente,
                                                                  input rowObject.it-codigo,
                                                                  input rowObject.seq-cotac,
                                                                  input rowObject.mapa-cotacao,
                                                                  input rowObject.cod-itiner,
                                                                  input rowObject.cod-incoterm,
                                                                  input rowObject.cod-emitente-desp,
                                                                  input rowObject.cod-desp,
                                                                  input rowObject.nr-tab,
                                                                  input rowObject.mo-codigo,
                                                                  input rowObject.data-cotacao,
                                                                  input 1,
                                                                  input ?,
                                                                  input rowObject.cod-cond-pag).
                    run calculaDespesa in h-bocx095c(output d-valor-despesa,
                                                     output table tt-bo-erro).
                    if not can-find(first tt-bo-erro) then do:
                        assign rowObject.val-desp = d-valor-despesa.
                    end.
                    delete procedure h-bocx095c.
                    assign h-bocx095c = ?.
                end.
                /*------*/

                if  l-criou then
                    run executeCreate.
                assign r-chave       = to-rowid(return-value)
                       r-first-rowid = IF  r-first-rowid = ? THEN 
                                           r-chave 
                                       ELSE 
                                           r-first-rowid.
                &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
                if  l-desp-imposto then do:
                    run pi-calcula-despesa(input r-chave,
                                           output d-valor-despesa). 

                    find bCotacao-item-cex
                        where rowid(bCotacao-item-cex) = r-chave exclusive-lock no-error.
                    if  avail bCotacao-item-cex then do:
                    
                        
                        if  d-valor-despesa = 0
                        or  d-valor-despesa = ? then do:
                        
                            assign i-numero-ordem      = bCotacao-item-cex.numero-ordem
                                   c-cod-emitente      = bCotacao-item-cex.cod-emitente
                                   c-it-codigo         = bCotacao-item-cex.it-codigo   
                                   i-seq-cotac         = bCotacao-item-cex.seq-cotac
                                   dt-cotac            = bCotacao-item-cex.data-cotacao     
                                   i-mapa-cotacao      = bCotacao-item-cex.mapa-cotacao     
                                   c-cod-emitente-desp = bCotacao-item-cex.cod-emitente-desp.
                                   
                            delete bCotacao-item-cex.
                            
                            find first cotacao-item-cex
                                 where cotacao-item-cex.numero-ordem      = i-numero-ordem
                                   and cotacao-item-cex.cod-emitente      = c-cod-emitente
                                   and cotacao-item-cex.it-codigo         = c-it-codigo   
                                   and cotacao-item-cex.data-cotacao      = dt-cotac           
                                   and cotacao-item-cex.mapa-cotacao      = i-mapa-cotacao  no-lock no-error.
                                   
                            if avail cotacao-item-cex then 
                                assign r-chave       = rowid(cotacao-item-cex)
                                       r-first-rowid = r-chave.
                        end.
                        else
                            assign bCotacao-item-cex.val-desp = d-valor-despesa.
                    end.
                end.
                
                &endif
            end.
        end.
    end.

    IF  NOT PROGRAM-NAME(2) MATCHES "*piSaveAndOk*" 
    AND NOT PROGRAM-NAME(2) MATCHES "*pi-importacao-assign*" THEN
        ASSIGN r-chave = r-first-rowid.

    run endMethod("validateCreatepai":U).

end procedure.

procedure validateCreate:
    /*
    **  Valida criacao da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.
 
    def var i-auto-num as integer no-undo.

    run startMethod("validateCreate":U).

    run initializeValidate.

    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

    find first rowObject no-error.    

    run validateFieldscreate.
    if rowObject.cod-desp = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex cotacao-item-cex cod-desp 1}
        /******************************************/    
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    else
        if not can-find(desp-imp where desp-imp.cod-desp = rowObject.cod-desp) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex desp-imp 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.
        end.
    if rowObject.cod-emitente-desp = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex cotacao-item-cex cod-emitente-desp 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    else do:
        find emitente where emitente.cod-emitente = rowObject.cod-emitente-desp no-lock no-error.
        if not avail emitente then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-field.i mgcex cotacao-item-cex cod-emitente 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.
        end.
        else do:
            {cdp/cd2502.i}
        end.
    end.

    run validateFields.

    if not can-find(first tt-bo-erro
                    WHERE tt-bo-erro.errorSubType <> "INFORMATION":U
                      AND tt-bo-erro.errorSubType <> "WARNING":U) then do:
        find first rowObject no-error.
        if rowObject.mapa-cotacao = 0 then do:
        run autoNumber(output i-auto-num).
            if i-auto-num > 99 then do:
                assign i-seq-erro = i-seq-erro + 1.
                /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                   pre-processador em chamada de includes */
                {utp/ut-table.i mgcex cotacao-item-cex 1}
                /******************************************/
                run utp/ut-msgs.p (input "msg":U,
                                   input 17052,
                                   input return-value).
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 17052
                       tt-bo-erro.mensagem     = return-value.
            end.
            else assign rowObject.mapa-cotacao = i-auto-num.
        end.
        run autoNumber2(output i-auto-num).
        if i-auto-num > 999 then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex cotacao-item-cex 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg":U,
                               input 17052,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 17052
                   tt-bo-erro.mensagem     = return-value.
        end.
        else assign rowObject.sequencia = i-auto-num.
    end.

    if not can-find(first tt-bo-erro
                    WHERE tt-bo-erro.errorSubType <> "INFORMATION":U
                      AND tt-bo-erro.errorSubType <> "WARNING":U) then
        if  can-find(first {&TABLE-NAME} where 
            {&TABLE-NAME}.numero-ordem = rowObject.numero-ordem and
            {&TABLE-NAME}.cod-emitente = rowObject.cod-emitente and
            {&table-name}.it-codigo = rowObject.it-codigo and
            /*
            {&TABLE-NAME}.seq-cotac    = rowObject.seq-cotac and
            {&TABLE-NAME}.data-cotacao = rowObject.data-cotacao and                                              
            */
            {&TABLE-NAME}.mapa-cotacao = rowObject.mapa-cotacao and
            {&TABLE-NAME}.cod-incoterm = rowObject.cod-incoterm and
            {&TABLE-NAME}.cod-itiner = rowObject.cod-itiner and        
            {&TABLE-NAME}.cod-desp = rowObject.cod-desp ) then do:
            
            assign i-seq-erro = i-seq-erro + 1.            
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex cotacao-item-cex 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.            
            run utp/ut-msgs.p (input "msg":U,
                               input 8,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 8
                   tt-bo-erro.mensagem     = return-value.
        end.

    &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
    BLOCK_update:
    DO TRANS:
    &endif

    if  not can-find(first tt-bo-erro
                     WHERE tt-bo-erro.errorSubType <> "INFORMATION":U
                       AND tt-bo-erro.errorSubType <> "WARNING":U) then do:
        run executeCreate.
        
        assign r-chave = to-rowid(return-value).

        &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
            run imp/imapi006.p(input "cotacao-item-cex":U,  
                               input rowid(cotacao-item-cex),
                               input cotacao-item-cex.cod-desp,
                               input 0,
                               input table rowObject,
                               input-output table tt-desp-ja-recalc).

            RUN findPedidoOrdem (INPUT ROWID(cotacao-item-cex),
                                 OUTPUT i-pedido-vinculado).

            RUN cxbo/bocx341.p PERSISTENT SET h-bocx341.

            IF  i-pedido-vinculado <> 0 
            AND VALID-HANDLE(h-bocx341) THEN DO:

                RUN retornaValorTotalDespCotada (INPUT  ROWID(cotacao-item-cex),
                                                 OUTPUT de-valor-tot-desp).

                RUN retornaIncotermRateio IN h-bocx341(INPUT ROWID(cotacao-item-cex),
                                                       INPUT i-pedido-vinculado,
                                                       OUTPUT c-cod-incoterm).

                RUN retornaValorDespesa IN h-bocx341(INPUT i-pedido-vinculado, 
                                                     INPUT cotacao-item-cex.cod-desp,
                                                     INPUT cotacao-item-cex.mo-codigo,
                                                     INPUT cotacao-item-cex.cod-emitente-desp,
                                                     INPUT cotacao-item-cex.cod-cond-pag,
                                                     INPUT cotacao-item-cex.cod-pto-contr,
                                                     INPUT cotacao-item-cex.tp-despesa,
                                                     OUTPUT rw-despes-ped-compra,
                                                     OUTPUT de-vl-tot-desp-pedido).

                IF  de-vl-tot-desp-pedido <> 0 THEN DO:

                    FIND desp-imp WHERE
                         desp-imp.cod-desp = rowObject.cod-desp NO-LOCK NO-ERROR.
                    IF  AVAIL desp-imp
                    AND desp-imp.tipo = 1 /* valor fixo */ THEN DO:
                        /*--- alerta: despesas do tipo valor fixo nao sao 
                              atualizadas automaticamente no pedido de compra ---*/
                        assign i-seq-erro = i-seq-erro + 1.            
                        create tt-bo-erro.
                        assign tt-bo-erro.parametros = string(rowObject.cod-desp).            
                        run utp/ut-msgs.p (input "msg":U,
                                           input 31410,
                                           input tt-bo-erro.parametros).
                        assign tt-bo-erro.i-sequen     = i-seq-erro
                               tt-bo-erro.cd-erro      = 31410
                               tt-bo-erro.mensagem     = return-value.
                        run utp/ut-msgs.p (input "help":U,
                                           input 31410,
                                           input tt-bo-erro.parametros).
                        ASSIGN tt-bo-erro.errorhelp = RETURN-VALUE.
                    END.
                    ELSE DO:
                        /*--- atualiza despes-ped-compra na base ---*/    
                        RUN emptyRowObject IN h-bocx341.
                        RUN emptyRowErrors IN h-bocx341.
                        RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                        RUN repositionRecord IN h-bocx341 (INPUT rw-despes-ped-compra).
    
                        IF  RETURN-VALUE <> "NOK":U THEN DO:
                            RUN getRecord IN h-bocx341 (OUTPUT TABLE tt-despes-ped-compra).
                            FIND FIRST tt-despes-ped-compra NO-ERROR.
    
                            IF  AVAIL tt-despes-ped-compra THEN DO:
                                ASSIGN tt-despes-ped-compra.val-desp = de-valor-tot-desp + de-vl-tot-desp-pedido.
                                RUN setRecord IN h-bocx341(INPUT TABLE tt-despes-ped-compra).
                                RUN updateRecord IN h-bocx341.
                                RUN verificaErros(INPUT h-bocx341).
                                IF  RETURN-VALUE = "NOK":U THEN
                                    UNDO BLOCK_update, RETURN "NOK":U.
                            END.
                        END.
                        /*--- fim atualizacao despes-ped-compra ---*/
                    END.
                END.
                ELSE DO:
                    /*--- cria despes-ped-compra na base ---*/    
                    RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                    RUN emptyRowObject IN h-bocx341.
                    RUN emptyRowErrors IN h-bocx341.
                    empty temp-table tt-despes-ped-compra.
                    CREATE tt-despes-ped-compra.
                    ASSIGN tt-despes-ped-compra.num-pedido        = i-pedido-vinculado
                           tt-despes-ped-compra.cod-desp          = cotacao-item-cex.cod-desp
                           tt-despes-ped-compra.cod-emitente-desp = cotacao-item-cex.cod-emitente-desp
                           tt-despes-ped-compra.cod-incoterm-rat  = c-cod-incoterm
                           tt-despes-ped-compra.cod-pto-contr     = cotacao-item-cex.cod-pto-contr
                           tt-despes-ped-compra.cod-cond-pag      = cotacao-item-cex.cod-cond-pag
                           tt-despes-ped-compra.mo-codigo         = cotacao-item-cex.mo-codigo
                           tt-despes-ped-compra.tp-despesa        = cotacao-item-cex.tp-despesa
                           tt-despes-ped-compra.val-desp          = de-valor-tot-desp.
                    RUN sugereSeqDespesa IN h-bocx341 (INPUT i-pedido-vinculado,
                                                       OUTPUT tt-despes-ped-compra.sequencia).
                    RUN setRecord IN h-bocx341 (INPUT TABLE tt-despes-ped-compra).
                    RUN createRecord IN h-bocx341.
                    
                    RUN verificaErros(INPUT h-bocx341).
                    IF  RETURN-VALUE = "NOK":U THEN
                        UNDO BLOCK_update, RETURN "NOK":U.
                    /*--- fim criacao despes-ped-compra ---*/
                END.

            END.

            IF  VALID-HANDLE(h-bocx341) THEN DO:
                DELETE PROCEDURE h-bocx341 NO-ERROR.
                ASSIGN h-bocx341 = ?.
            END.
        &endif
    end.
    run endMethod("validateCreate":U).

    &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
    END. /* DO TRANS: */
    &endif


end procedure.

procedure validateFieldscreate:
    run startMethod("validateFieldscreate":U).

    find first rowObject no-error.
    
    if not can-find(item where item.it-codigo = rowObject.it-codigo) then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgind item it-codigo 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg":U,
                           input 2,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 2
               tt-bo-erro.mensagem     = return-value.
    end.

    if rowObject.cod-emitente = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex cotacao-item-cex cod-emitente 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    else do:
        find emitente where emitente.cod-emitente = rowObject.cod-emitente no-lock no-error.
        if not avail emitente then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-field.i mgcex cotacao-item-cex cod-emitente 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                  tt-bo-erro.mensagem     = return-value.
        end.
        else do:
            {cdp/cd2500.i}
            {cdp/cd2502.i}
        end.
    end.

    if rowObject.data-cotacao = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex cotacao-item-cex data-cotacao 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.



    if rowObject.numero-ordem = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex cotacao-item-cex numero-ordem 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    
    if not can-find(ordem-compra where
                    ordem-compra.numero-ordem = rowObject.numero-ordem) then do:
       assign i-seq-erro = i-seq-erro + 1.
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-field.i mgind ordem-compra numero-ordem 1}
       /******************************************/ 
       create tt-bo-erro.
       assign tt-bo-erro.parametros = return-value.
       run utp/ut-msgs.p (input "msg":U,
                          input 2,
                          input return-value).
                          
       assign tt-bo-erro.i-sequen     = i-seq-erro
              tt-bo-erro.cd-erro      = 2
              tt-bo-erro.mensagem     = return-value.
    end.
    
    if not can-find(first tt-bo-erro
                    WHERE tt-bo-erro.errorSubType <> "INFORMATION":U
                      AND tt-bo-erro.errorSubType <> "WARNING":U) then do:
        find cotacao-item where 
             cotacao-item.it-codigo         = rowObject.it-codigo 
              and cotacao-item.cod-emitente = rowObject.cod-emitente
              and cotacao-item.data-cotacao = rowObject.data-cotacao              
              and cotacao-item.numero-ordem = rowObject.numero-ordem 
              &if defined(bf-mat-comex) &then              
              &else    
                and cotacao-item.seq-cotac    = rowObject.seq-cotac                                 
              &endif
            no-lock no-error.
        
        if not avail cotacao-item then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-liter.i Cotaá‰es_do_Item *L}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = trim(return-value).
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.
        end.
        else do:
            
            {ccp/cc9019.i50}
            &if defined(bf-mat-comex) &then
                assign i-mapa-cotacao-i50  = int(substring(cotacao-item.char-1,6,2))
                       c-cod-incoterm-i50  = substring(cotacao-item.char-1,8,3)
                       i-cod-pto-contr-i50 = int(substring(cotacao-item.char-1,11,5)).
            &else   
                {cdp/cd4300.i4 "yes" cotacao-item.char-1}
                {ccp/cc9019.i51 "yes"}
            &endif    
            {cxbo/bocx085.i1 c-cod-incoterm-i50} /* Validacao Incoterm */
            
        end.
        IF NOT CAN-FIND(FIRST tt-bo-erro 
                        WHERE tt-bo-erro.errorSubType <> "INFORMATION":U
                          AND tt-bo-erro.errorSubType <> "WARNING":U) then do:
            assign rowObject.cod-incoterm = string(c-cod-incoterm-i50,"x(03)").
        end.
    end.


    if rowObject.cod-itiner = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex cotacao-item-cex cod-itiner 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    else
        if not can-find(itinerario where itinerario.cod-itiner = rowObject.cod-itiner) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex itinerario 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.
        end.
    
    run endMethod("validateFieldscreate":U).
end procedure.

procedure validateUpdate:

    define input  parameter table for RowObject.
    define input  parameter r-chave as rowid no-undo.
    define output parameter table for tt-bo-erro.

    define variable l-alter-val-desp as logical no-undo.

    &IF '{&BF_MAT_VERSAO_EMS}' >= '2.062' &THEN
        DEF VAR i-cod-cond-pag-ant  LIKE cotacao-item-cex.cod-cond-pag  NO-UNDO.
        DEF VAR i-cod-pto-contr-ant LIKE cotacao-item-cex.cod-pto-contr NO-UNDO.
        DEF VAR i-tp-despesa-ant    LIKE cotacao-item-cex.tp-despesa    NO-UNDO.
        DEF VAR de-val-desp-ant     LIKE cotacao-item-cex.val-desp      NO-UNDO.
    &ENDIF
 
    run InitializeValidate.
 
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
 
    run validateFields.

    &IF '{&BF_MAT_VERSAO_EMS}' >= '2.062' &THEN
        RUN validateImport.
    &ENDIF
    
    find first tt-bo-erro 
         WHERE tt-bo-erro.errorSubType <> "INFORMATION":U
           AND tt-bo-erro.errorSubType <> "WARNING":U no-lock no-error.
    
    &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
    BLOCK_update:
    DO TRANS:
    &endif
    
    if  not avail tt-bo-erro then do:
    
        &if defined(LOCKCONTROL) > 0 &then
            find {&TABLE-NAME} 
                where rowid({&TABLE-NAME}) = r-chave no-lock no-error.
        &else
            find {&TABLE-NAME}
                where rowid({&TABLE-NAME}) = r-chave exclusive-lock no-error.
        &endif    
            
        if  rowObject.val-desp <> {&table-name}.val-desp then
            assign l-alter-val-desp = yes.
            
        &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
            ASSIGN i-cod-cond-pag-ant  = {&TABLE-NAME}.cod-cond-pag 
                   i-cod-pto-contr-ant = {&TABLE-NAME}.cod-pto-contr
                   i-tp-despesa-ant    = {&TABLE-NAME}.tp-despesa   
                   de-val-desp-ant     = {&TABLE-NAME}.val-desp.     
        &endif

        run executeUpdate.

        &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
        
            if  l-alter-val-desp then
                run imp/imapi006.p(input "cotacao-item-cex":U,  
                                   input rowid(cotacao-item-cex),
                                   input cotacao-item-cex.cod-desp,
                                   input 0,
                                   input table rowObject,
                                   input-output table tt-desp-ja-recalc).

            IF  i-cod-cond-pag-ant  <> {&TABLE-NAME}.cod-cond-pag 
            OR  i-cod-pto-contr-ant <> {&TABLE-NAME}.cod-pto-contr
            OR  i-tp-despesa-ant    <> {&TABLE-NAME}.tp-despesa   
            OR  de-val-desp-ant     <> {&TABLE-NAME}.val-desp THEN DO:

                /*--- verifica se a despesa que esta sendo alterada 
                      pertence a um mapa aprovado por uma ordem vinculada 
                      a um pedido de compra ----*/
                RUN findPedidoOrdem (INPUT ROWID(cotacao-item-cex),
                                     OUTPUT i-pedido-vinculado).

                IF  i-pedido-vinculado <> 0 THEN DO:
                    IF  NOT VALID-HANDLE(h-bocx341) THEN
                        RUN cxbo/bocx341.p PERSISTENT SET h-bocx341.

                    FIND cotacao-item
                         WHERE cotacao-item.numero-ordem = cotacao-item-cex.numero-ordem
                           AND cotacao-item.it-codigo    = cotacao-item-cex.it-codigo
                           AND cotacao-item.data-cotacao = cotacao-item-cex.data-cotacao
                           AND cotacao-item.seq-cotac    = cotacao-item-cex.seq-cotac NO-LOCK NO-ERROR.

                    IF  AVAIL cotacao-item 
                    AND VALID-HANDLE(h-bocx341) THEN DO:
                        RUN retornaQuantidadeTotal (INPUT ROWID(cotacao-item),
                                                    OUTPUT de-qtd-total).

                        ASSIGN de-vl-total-ant = de-val-desp-ant * de-qtd-total
                               de-vl-total-atu = {&table-name}.val-desp * de-qtd-total.

                        RUN retornaIncotermRateio IN h-bocx341(INPUT ROWID(cotacao-item-cex),
                                                               INPUT i-pedido-vinculado,
                                                               OUTPUT c-cod-incoterm).

                        /*--- diminui o valor antigo da cotacao-item-cex,
                              na despes-ped-compra ---*/
                        RUN retornaValorDespesa IN h-bocx341(INPUT i-pedido-vinculado, 
                                                             INPUT cotacao-item-cex.cod-desp,
                                                             INPUT cotacao-item-cex.mo-codigo,
                                                             INPUT cotacao-item-cex.cod-emitente-desp,
                                                             INPUT  i-cod-cond-pag-ant, 
                                                             INPUT  i-cod-pto-contr-ant,
                                                             INPUT  i-tp-despesa-ant,   
                                                             OUTPUT rw-despes-ped-compra,
                                                             OUTPUT de-vl-tot-desp-pedido).

                        IF  de-vl-tot-desp-pedido <> 0 THEN DO:

                            ASSIGN de-vl-diferenca = de-vl-tot-desp-pedido - de-vl-total-ant.

                            FIND desp-imp WHERE
                                 desp-imp.cod-desp = rowObject.cod-desp NO-LOCK NO-ERROR.
                            IF  AVAIL desp-imp
                            AND desp-imp.tipo = 1 /* valor fixo */ THEN
                                /*--- atualiza o pedido com o valor informado no im0010 ---*/
                                ASSIGN de-vl-diferenca = rowObject.val-desp.

                            IF  de-vl-diferenca > 0 THEN DO:
                                /*--- atualiza despes-ped-compra na base ---*/    
                                RUN emptyRowObject IN h-bocx341.
                                RUN emptyRowErrors IN h-bocx341.
                                RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                                RUN repositionRecord IN h-bocx341 (INPUT rw-despes-ped-compra).
                                IF  RETURN-VALUE <> "NOK":U THEN DO:
                                    RUN getRecord IN h-bocx341 (OUTPUT TABLE tt-despes-ped-compra).
                                    FIND FIRST tt-despes-ped-compra NO-ERROR.
                                    IF  AVAIL tt-despes-ped-compra THEN DO:
                                        ASSIGN tt-despes-ped-compra.val-desp = de-vl-diferenca.
                                        RUN setRecord IN h-bocx341(INPUT TABLE tt-despes-ped-compra).
                                        RUN updateRecord IN h-bocx341.
                                        RUN verificaErros(INPUT h-bocx341).
                                        IF  RETURN-VALUE = "NOK":U THEN
                                            UNDO BLOCK_update, RETURN "NOK":U.
                                    END.
                                END.
                                /*--- fim atualizacao despes-ped-compra ---*/
                            END.
                            ELSE DO:
                                /*--- elimina despes-ped-compra na base ---*/    
                                RUN emptyRowErrors IN h-bocx341.
                                RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                                RUN repositionRecord IN h-bocx341 (INPUT rw-despes-ped-compra).
                                IF RETURN-VALUE = "NOK":U THEN NEXT.
                                RUN deleteRecord IN h-bocx341.
                                RUN verificaErros(INPUT h-bocx341).
                                IF  RETURN-VALUE = "NOK":U THEN
                                    UNDO BLOCK_update, RETURN "NOK":U.
                                /*--- fim eliminacao despes-ped-compra ---*/
                            END.
                        END.

                        FIND desp-imp WHERE
                             desp-imp.cod-desp = rowObject.cod-desp NO-LOCK NO-ERROR.
                        IF  AVAIL desp-imp
                        AND desp-imp.tipo <> 1 /* nao faz os procedimentos para valor fixo */ 
                        THEN  DO:

                            /*--- soma o novo valor da cotacao-item-cex,
                                  na despes-ped-compra ---*/
                            RUN retornaValorDespesa IN h-bocx341(INPUT  i-pedido-vinculado, 
                                                                 INPUT  cotacao-item-cex.cod-desp,
                                                                 INPUT  cotacao-item-cex.mo-codigo,
                                                                 INPUT  cotacao-item-cex.cod-emitente-desp,
                                                                 INPUT  cotacao-item-cex.cod-cond-pag, 
                                                                 INPUT  cotacao-item-cex.cod-pto-contr,
                                                                 INPUT  cotacao-item-cex.tp-despesa,   
                                                                 OUTPUT rw-despes-ped-compra,
                                                                 OUTPUT de-vl-tot-desp-pedido).
    
                            IF  de-vl-tot-desp-pedido > 0 THEN DO:
    
                                ASSIGN de-vl-total = de-vl-total-atu + de-vl-tot-desp-pedido.
    
                                /*--- atualiza despes-ped-compra na base ---*/    
                                RUN emptyRowObject IN h-bocx341.
                                RUN emptyRowErrors IN h-bocx341.
                                RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                                RUN repositionRecord IN h-bocx341 (INPUT rw-despes-ped-compra).
                                IF  RETURN-VALUE <> "NOK":U THEN DO:
                                    RUN getRecord IN h-bocx341 (OUTPUT TABLE tt-despes-ped-compra).
                                    FIND FIRST tt-despes-ped-compra NO-ERROR.
                                    IF  AVAIL tt-despes-ped-compra THEN DO:
                                        ASSIGN tt-despes-ped-compra.val-desp = de-vl-total.
                                        RUN setRecord IN h-bocx341(INPUT TABLE tt-despes-ped-compra).
                                        RUN updateRecord IN h-bocx341.
                                        RUN verificaErros(INPUT h-bocx341).
                                        IF  RETURN-VALUE = "NOK":U THEN
                                            UNDO BLOCK_update, RETURN "NOK":U.
                                    END.
                                END.
                                /*--- fim atualizacao despes-ped-compra ---*/
                            END.
                            ELSE DO:
                                /*--- cria despes-ped-compra na base ---*/    
                                RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                                RUN emptyRowObject IN h-bocx341.
                                RUN emptyRowErrors IN h-bocx341.
                                empty temp-table tt-despes-ped-compra.
                                CREATE tt-despes-ped-compra.
                                ASSIGN tt-despes-ped-compra.num-pedido        = i-pedido-vinculado
                                       tt-despes-ped-compra.cod-desp          = cotacao-item-cex.cod-desp
                                       tt-despes-ped-compra.cod-emitente-desp = cotacao-item-cex.cod-emitente-desp
                                       tt-despes-ped-compra.cod-incoterm-rat  = c-cod-incoterm
                                       tt-despes-ped-compra.cod-pto-contr     = cotacao-item-cex.cod-pto-contr
                                       tt-despes-ped-compra.cod-cond-pag      = cotacao-item-cex.cod-cond-pag
                                       tt-despes-ped-compra.mo-codigo         = cotacao-item-cex.mo-codigo
                                       tt-despes-ped-compra.tp-despesa        = cotacao-item-cex.tp-despesa
                                       tt-despes-ped-compra.val-desp          = de-vl-total-atu.
                                RUN sugereSeqDespesa IN h-bocx341 (INPUT i-pedido-vinculado,
                                                                   OUTPUT tt-despes-ped-compra.sequencia).
                                RUN setRecord IN h-bocx341 (INPUT TABLE tt-despes-ped-compra).
                                RUN createRecord IN h-bocx341.
                                RUN verificaErros(INPUT h-bocx341).
                                IF  RETURN-VALUE = "NOK":U THEN
                                    UNDO BLOCK_update, RETURN "NOK":U.
                                /*--- fim criacao despes-ped-compra ---*/
                            END.
                        END.
                    END.

                    IF  VALID-HANDLE(h-bocx341) THEN DO:
                        DELETE PROCEDURE h-bocx341 NO-ERROR.
                        ASSIGN h-bocx341 = ?.
                    END.

                END. /* if i-pedido-vinculado...*/
            END.
        &endif
    end.

    &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
    END.
    &endif

    
end procedure.


PROCEDURE validateImport:
&IF '{&BF_MAT_VERSAO_EMS}' >= '2.062' &THEN
    DEFINE VARIABLE l-permite-alter-cotac        AS LOGICAL    NO-UNDO.
    DEFINE VARIABLE l-permite-alter-cotac-despes AS LOGICAL    NO-UNDO.

    FIND FIRST RowObject NO-ERROR.
    /* Somente faz essa validaá∆o para despesas cotadas automaticamente pelo sistema */
    IF RowObject.log-gerac-autom THEN DO:

        /* Verifica se despesa permite alteraá∆o */
        FOR FIRST desp-imp FIELDS(log-permite-alter-cotac)
            WHERE desp-imp.cod-desp = RowObject.cod-desp NO-LOCK:
            ASSIGN l-permite-alter-cotac = desp-imp.log-permite-alter-cotac.
        END.
        
        /* Verifica se usu†rio possui permiss∆o de alteraá∆o */
        FOR FIRST usuar-import FIELDS(log-permite-alter-cotac-despes)
            WHERE usuar-import.cod-usuar = c-seg-usuario NO-LOCK:
            ASSIGN l-permite-alter-cotac-despes = usuar-import.log-permite-alter-cotac-despes.
        END.
        
        IF  NOT l-permite-alter-cotac 
        AND NOT l-permite-alter-cotac-despes THEN DO:
            assign i-seq-erro = i-seq-erro + 1.
            create tt-bo-erro.
            assign tt-bo-erro.parametros   = c-seg-usuario + "~~" + STRING(rowObject.cod-desp).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 30099.
            RETURN "NOK".
        END.             
    END.
    RETURN "OK".
&ENDIF
END PROCEDURE.


/* Procedures de negocio ***************************************************************************/

procedure calculoPrecocotacao:
    /*
    **  Calcula o preco total do mapa de cotacao.
    */
    def input  parameter r-chave      as rowid   no-undo.
    def output parameter p-precototal as decimal no-undo.
    
    def var i-mo-codigo      as   integer                no-undo.
    def var de-valor-despesa like {&TABLE-NAME}.val-desp no-undo.
    def var de-val-desp      like {&TABLE-NAME}.val-desp no-undo.
    DEF VAR de-qtd-total         AS DEC FORMAT ">>>,>>>,>>9.9999" NO-UNDO.
    
    for each tt-cotacao-temp:
        delete tt-cotacao-temp.
    end.
    
    find {&TABLE-NAME} where rowid({&TABLE-NAME}) =  r-chave no-lock no-error.
    if avail {&TABLE-NAME} then do:
        create tt-cotacao-temp.
        buffer-copy {&TABLE-NAME} to tt-cotacao-temp.
    end.
    
    for first cotacao-item fields(mo-codigo numero-ordem)
        where cotacao-item.numero-ordem     = tt-cotacao-temp.numero-ordem and
              cotacao-item.cod-emitente     = tt-cotacao-temp.cod-emitente and
              cotacao-item.it-codigo        = tt-cotacao-temp.it-codigo    and
              &if defined(bf-mat-comex) &then              
                  cotacao-item.data-cotacao = tt-cotacao-temp.data-cotacao no-lock:
              &else
                  cotacao-item.seq-cotac    = tt-cotacao-temp.seq-cotac no-lock:              
              &endif          
        assign i-mo-codigo = cotacao-item.mo-codigo.              
    end.      
    
    for each {&TABLE-NAME} fields(val-desp mo-codigo cod-desp numero-ordem)
        where {&table-name}.it-codigo    = tt-cotacao-temp.it-codigo
          and {&TABLE-NAME}.cod-emitente = tt-cotacao-temp.cod-emitente
          and {&TABLE-NAME}.data-cotacao = tt-cotacao-temp.data-cotacao
          and {&TABLE-NAME}.numero-ordem = tt-cotacao-temp.numero-ordem
          and {&TABLE-NAME}.mapa-cotacao = tt-cotacao-temp.mapa-cotacao
          and {&TABLE-NAME}.cod-incoterm = tt-cotacao-temp.cod-incoterm
          and {&TABLE-NAME}.cod-itiner   = tt-cotacao-temp.cod-itiner no-lock:
          
        for first ordem-compra no-lock
            where ordem-compra.numero-ordem = {&TABLE-NAME}.numero-ordem:
            find first param-imp-trib where param-imp-trib.cod-estabel = ordem-compra.cod-estabel no-lock no-error.
        end.
             
        if avail param-imp-trib 
        and (   {&TABLE-NAME}.cod-desp = param-imp-trib.cdn-despes-impto-CBS 
             or {&TABLE-NAME}.cod-desp = param-imp-trib.cdn-despes-impto-IBSUF
             or {&TABLE-NAME}.cod-desp = param-imp-trib.cdn-despes-impto-IBSMun
             or {&TABLE-NAME}.cod-desp = param-imp-trib.cdn-despes-impto-IS) then next.
        
        find first desp-imp where desp-imp.cod-desp = {&TABLE-NAME}.cod-desp no-lock no-error.
        if avail desp-imp and (desp-imp.inc-val-embal       = yes 
                           or  desp-imp.inc-val-seguro      = yes
                           or  desp-imp.inc-val-frete       = yes 
                           or  desp-imp.inc-val-outras-desp = yes) then do:
          
          assign de-val-desp = {&TABLE-NAME}.val-desp.

          /* Para despesas do tipo "fixo", o preco da cotacao sera calculado valor da despesa/quantidade,
             sendo que no browser com o detalhamento das despesas da cotacao do item de importacao, 
             sera mostrado sempre o valor fixo "total" e nao unitario. Unitario somente para efeito de calculo */
          if  desp-imp.tipo = 1 then do: /*fixo*/
              assign de-qtd-total = 0.
              for each  prazo-compra FIELDS(quantidade)
                 where prazo-compra.numero-ordem = cotacao-item.numero-ordem
                   and prazo-compra.situacao <> 4 /* eliminada */ no-lock:
        
                   assign de-qtd-total = de-qtd-total + prazo-compra.quantidade.
               end.
                                                    
             assign de-val-desp = de-val-desp / de-qtd-total.
          end.
          
          run cdp/cd0812.p (input {&TABLE-NAME}.mo-codigo,
                            input i-mo-codigo,
                            input de-val-desp,
                            input today,
                            output de-valor-despesa).
          if de-valor-despesa = ? then
              assign de-valor-despesa = {&TABLE-NAME}.val-desp.                      

          assign p-precototal = p-precototal + de-valor-despesa.
        end.
    end.
end procedure.

procedure calculoPrecoCotTrib:
    /*
    **  Calcula o preco total do mapa de cotacao com os novos tributos da RT.
    */
    def input  parameter r-chave      as rowid   no-undo.
    def output parameter p-precototal as decimal no-undo.
    
    def var i-mo-codigo      as   integer                no-undo.
    def var de-valor-despesa like {&TABLE-NAME}.val-desp no-undo.
    def var de-val-desp      like {&TABLE-NAME}.val-desp no-undo.
    DEF VAR de-qtd-total         AS DEC FORMAT ">>>,>>>,>>9.9999" NO-UNDO.
    
    for each tt-cotacao-temp:
        delete tt-cotacao-temp.
    end.
    
    find {&TABLE-NAME} where rowid({&TABLE-NAME}) =  r-chave no-lock no-error.
    if avail {&TABLE-NAME} then do:
        create tt-cotacao-temp.
        buffer-copy {&TABLE-NAME} to tt-cotacao-temp.
    end.
    
    for first cotacao-item fields(mo-codigo numero-ordem)
        where cotacao-item.numero-ordem     = tt-cotacao-temp.numero-ordem and
              cotacao-item.cod-emitente     = tt-cotacao-temp.cod-emitente and
              cotacao-item.it-codigo        = tt-cotacao-temp.it-codigo    and
              &if defined(bf-mat-comex) &then              
                  cotacao-item.data-cotacao = tt-cotacao-temp.data-cotacao no-lock:
              &else
                  cotacao-item.seq-cotac    = tt-cotacao-temp.seq-cotac no-lock:              
              &endif          
        assign i-mo-codigo = cotacao-item.mo-codigo.              
    end.      
    
    for each {&TABLE-NAME} fields(val-desp mo-codigo cod-desp numero-ordem)
        where {&table-name}.it-codigo    = tt-cotacao-temp.it-codigo
          and {&TABLE-NAME}.cod-emitente = tt-cotacao-temp.cod-emitente
          and {&TABLE-NAME}.data-cotacao = tt-cotacao-temp.data-cotacao
          and {&TABLE-NAME}.numero-ordem = tt-cotacao-temp.numero-ordem
          and {&TABLE-NAME}.mapa-cotacao = tt-cotacao-temp.mapa-cotacao
          and {&TABLE-NAME}.cod-incoterm = tt-cotacao-temp.cod-incoterm
          and {&TABLE-NAME}.cod-itiner   = tt-cotacao-temp.cod-itiner no-lock:
          
        for first ordem-compra no-lock
            where ordem-compra.numero-ordem = {&TABLE-NAME}.numero-ordem:
            find first param-imp-trib where param-imp-trib.cod-estabel = ordem-compra.cod-estabel no-lock no-error.
        end.
             
        find first desp-imp where desp-imp.cod-desp = {&TABLE-NAME}.cod-desp no-lock no-error.
        
        if avail param-imp-trib 
        and (   {&TABLE-NAME}.cod-desp = param-imp-trib.cdn-despes-impto-CBS 
             or {&TABLE-NAME}.cod-desp = param-imp-trib.cdn-despes-impto-IBSUF
             or {&TABLE-NAME}.cod-desp = param-imp-trib.cdn-despes-impto-IBSMun
             or {&TABLE-NAME}.cod-desp = param-imp-trib.cdn-despes-impto-IS)
        and avail desp-imp and (desp-imp.inc-val-embal       = yes 
                            or  desp-imp.inc-val-seguro      = yes
                            or  desp-imp.inc-val-frete       = yes 
                            or  desp-imp.inc-val-outras-desp = yes) then do:
          
          assign de-val-desp = {&TABLE-NAME}.val-desp.

          /* Para despesas do tipo "fixo", o preco da cotacao sera calculado valor da despesa/quantidade,
             sendo que no browser com o detalhamento das despesas da cotacao do item de importacao, 
             sera mostrado sempre o valor fixo "total" e nao unitario. Unitario somente para efeito de calculo */
          if  desp-imp.tipo = 1 then do: /*fixo*/
              assign de-qtd-total = 0.
              for each  prazo-compra FIELDS(quantidade)
                 where prazo-compra.numero-ordem = cotacao-item.numero-ordem
                   and prazo-compra.situacao <> 4 /* eliminada */ no-lock:
        
                   assign de-qtd-total = de-qtd-total + prazo-compra.quantidade.
               end.
                                                    
             assign de-val-desp = de-val-desp / de-qtd-total.
          end.
          
          run cdp/cd0812.p (input {&TABLE-NAME}.mo-codigo,
                            input i-mo-codigo,
                            input de-val-desp,
                            input today,
                            output de-valor-despesa).
          if de-valor-despesa = ? then
              assign de-valor-despesa = {&TABLE-NAME}.val-desp.                      

          assign p-precototal = p-precototal + de-valor-despesa.
        end.
    end.
end procedure.

procedure autoNumber:
    /*
    ** Autonumeracao para o mapa de cotacao.
    */
    def output parameter i-auto-num as integer init 1 no-undo.
    
    def var i-cont as integer init 1 no-undo.
    
    find last {&TABLE-NAME} where 
        {&TABLE-NAME}.numero-ordem      = rowObject.numero-ordem and
        {&TABLE-NAME}.cod-emitente      = rowObject.cod-emitente and
        {&table-name}.it-codigo         = rowObject.it-codigo 
        /*
        and
        &if defined(bf-mat-comex) &then                                  
            {&TABLE-NAME}.data-cotacao = rowObject.data-cotacao 
        &else
            {&TABLE-NAME}.seq-cotac    = rowObject.seq-cotac                               
        &endif
        */
        no-lock no-error.
        
    if avail {&TABLE-NAME} then
        assign i-auto-num = {&TABLE-NAME}.mapa-cotacao + 1.
    else assign i-auto-num = 1.
    
    if i-auto-num > 99 then do:
        do while i-cont <= 99:
            if not can-find({&TABLE-NAME} where {&TABLE-NAME}.mapa-cotacao = i-cont) then do:
                assign i-auto-num = i-cont
                       i-cont = 99.
            end.
            i-cont = i-cont + 1.
        end.
    end.
end procedure.

procedure autoNumber2:
    /*
    ** Autonumeracao para a sequencia das despesas do mapa de cotacao.
    */
    def output parameter i-auto-num as integer init 1 no-undo.
    def var i-cont as integer init 1 no-undo.
    
    find last {&TABLE-NAME} where 
        {&TABLE-NAME}.numero-ordem      = rowObject.numero-ordem and
        {&TABLE-NAME}.cod-emitente      = rowObject.cod-emitente and
        {&table-name}.it-codigo         = rowObject.it-codigo and
        /*
        &if defined(bf-mat-comex) &then                                 
            {&TABLE-NAME}.data-cotacao  = rowObject.data-cotacao and
        &else
            {&TABLE-NAME}.seq-cotac     = rowObject.seq-cotac and                              
        &endif
        */
        {&TABLE-NAME}.mapa-cotacao      = rowObject.mapa-cotacao and
        {&TABLE-NAME}.cod-incoterm      = rowObject.cod-incoterm and
        {&TABLE-NAME}.cod-itiner        = rowObject.cod-itiner no-lock no-error.
        
    if avail {&TABLE-NAME} then
        assign i-auto-num = {&TABLE-NAME}.sequencia + 1.
    else assign i-auto-num = 1.
    
    if i-auto-num > 999 then do:
        do while i-cont <= 999:
            if not can-find({&TABLE-NAME} where {&TABLE-NAME}.sequencia = i-cont) then do:
                assign i-auto-num = i-cont
                       i-cont = 999.
            end.
            i-cont = i-cont + 1.
        end.
    end.
end procedure.

procedure verificaFornecedor:
    /*
    ** Retorna se o fornecedor da despesa pode ser modificado ou nao.
    */
    def input parameter r-chave as rowid no-undo.
    def output parameter l-modifica as logical no-undo.
    
    find {&TABLE-NAME} where rowid({&TABLE-NAME}) = r-chave no-lock no-error.
    if avail {&TABLE-NAME} and {&TABLE-NAME}.cod-emitente-desp = 0 then
        assign l-modifica = yes.
    else
        assign l-modifica = no.
end procedure.

procedure validateInitialize:
    /*
    ** Validacao dos campos iniciais da inclusao de despesas.
    */
    def input parameter table for rowObject. 
    def output parameter table for tt-bo-erro.
    def var c-return1 as char no-undo.
    
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    
    find first rowObject no-error.
    
    if rowObject.cod-emitente-desp = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex cotacao-item-cex cod-emitente-desp 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    else do:
        find emitente where emitente.cod-emitente = rowObject.cod-emitente-desp no-lock no-error.
        if not avail emitente then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-field.i mgcex cotacao-item-cex cod-emitente 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.
        end.
        else do:
            {cdp/cd2502.i}
        end.
    end.
    
    if rowObject.cod-desp = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex cotacao-item-cex cod-desp 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.    
    else if not can-find(desp-imp where desp-imp.cod-desp = rowObject.cod-desp ) then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex desp-imp 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg":U,
                           input 2,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 2
               tt-bo-erro.mensagem     = return-value.
    end.
    
    /* Validacao Tabela de Preco */
    if rowObject.cod-cond-pag = ? then

    {cxbo/bocx085.i2 rowObject.nr-tab 
                     rowObject.cod-emitente-desp 
                     rowObject.cod-itiner 
                     rowObject.cod-incoterm 
                     rowObject.cod-desp
                     ?
                     &VALIDA-DESPESA}
 
    else
    {cxbo/bocx085.i2 rowObject.nr-tab 
                     rowObject.cod-emitente-desp 
                     rowObject.cod-itiner 
                     rowObject.cod-incoterm 
                     rowObject.cod-desp
                     rowObject.cod-cond-pag}
                    
    /* Validacao Moeda */
    /*frank - 09/05/05*/
    &IF DEFINED(BF_DIS_VERSAO_EMS) &THEN         
        &IF '{&BF_DIS_VERSAO_EMS}' < '2.04' &THEN
           {cxbo/bocx085.i3}
        &ENDIF                                    
    &ELSE                                         
       {cxbo/bocx085.i3}
    &ENDIF                                        
    /*fim frank - 09/05/05*/                
    
    /*  Validaá∆o do Tipo de Despesa da Despesa de Importaá∆o */
    &if "{&bf_mat_versao_ems}" >= "2.05" &then
        if not can-find(first tipo-rec-desp no-lock 
                        where tipo-rec-desp.tp-codigo = RowObject.tp-despesa) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-field.i mgcex cotacao-item-cex tp-despesa 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg":U,
                               input 3866,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 3866
                   tt-bo-erro.mensagem     = return-value.            
        end.
        else
            if can-find(first tipo-rec-desp no-lock 
                        where tipo-rec-desp.tp-codigo = RowObject.tp-despesa and
                              tipo-rec-desp.tipo = 1) then do:
                assign i-seq-erro = i-seq-erro + 1.
                /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                   pre-processador em chamada de includes */
                {utp/ut-field.i mgcex cotacao-item-cex tp-despesa 1}
                /******************************************/
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                run utp/ut-msgs.p (input "msg":U,
                                   input 4995,
                                   input return-value).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 4995
                       tt-bo-erro.mensagem     = return-value.  
            end.
    &endif 
    /* Fim da validaá∆o por tipo de despesa */
    
end procedure.

procedure createFornecedor:
 
    /*
    ** Cria despesa quando acessada pelo programa filho. Criacao temporaria.
    ** Valores default.
    */
    def input-output parameter table for rowObject.
    def output parameter table for tt-bo-erro.    
    
    
    find first rowObject no-error.
    run atualizaDespesafornecedor(input "add":U).
    
    
end procedure.

procedure updateFornecedor:
    /*
    ** Atualiza despesa na primeira modificaá∆o quando o fornecedor = 0.
    ** Valores default.
    */
    def input parameter r-chave        as rowid   no-undo.
    def input parameter i-cod-emitente as integer no-undo.
    def input parameter i-cod-desp     as integer no-undo.
    def input parameter c-nr-tab       as char    no-undo.
    def input parameter i-mo-codigo    as integer no-undo.
    &IF "{&bf_mat_versao_ems}" >= "2.05" &THEN
      def input parameter i-tp-despesa as integer no-undo.
    &ENDIF    
    def output parameter table for tt-bo-erro.
    
    for each rowObject:
        delete rowObject.
    end.
    
    run findRowid(input r-chave).
    run getCurrent(output table rowObject).
    find first rowObject no-error.
        assign rowObject.cod-emitente-desp = i-cod-emitente
               rowObject.cod-desp          = i-cod-desp
               rowObject.nr-tab            = c-nr-tab
               rowObject.val-desp          = 0
               rowObject.mo-codigo         = i-mo-codigo
               &IF "{&bf_mat_versao_ems}" >= "2.05" &THEN
                  rowObject.tp-despesa = i-tp-despesa
               &ENDIF               
               .
    run validateInitialize(input table rowObject,
                           output table tt-bo-erro).

    &IF '{&BF_MAT_VERSAO_EMS}' >= '2.062' &THEN
        RUN validateImport.
    &ENDIF

    find first tt-bo-erro 
         WHERE tt-bo-erro.errorSubType <> "INFORMATION":U
           AND tt-bo-erro.errorSubType <> "WARNING":U no-error.
    if not avail tt-bo-erro then           
        run atualizaDespesafornecedor(input "mod":U).
        
end procedure.

procedure atualizaDespesafornecedor:
/*
** Atualiza valores da despesa da cotacao.
*/
    def input parameter c-param as char no-undo.
    
    def var d-valor-despesa as decimal no-undo.
    def var d-valor-aux     as decimal no-undo.
    def var i-seq-erro      as integer no-undo.
    def var i-auto-num      as integer no-undo.
    
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    for each tt-parametros:
        delete tt-parametros.
    end.
    for each tt-parametros-imp:
        delete tt-parametros-imp.
    end.    
    

    /* 
    ** Atualiza com informacoes da cotacao
    */
    find cotacao-item 
        where cotacao-item.it-codigo    = rowObject.it-codigo 
          and cotacao-item.cod-emitente = rowObject.cod-emitente
          and cotacao-item.data-cotacao = rowObject.data-cotacao
          and cotacao-item.numero-ordem = rowObject.numero-ordem
        &if defined(bf-mat-comex) &then
        &else
          and cotacao-item.seq-cotac    = rowObject.seq-cotac
        &endif
          no-lock no-error.
    if avail cotacao-item then
        assign rowObject.contato      = cotacao-item.contato
               rowObject.cod-comprado = cotacao-item.cod-comprado.
    
    {cxbo/bocx085.i6 rowObject.cod-itiner rowObject.cod-incoterm rowObject.cod-emitente-desp rowObject.cod-desp}
    /*
    ** Verifica se existe outra despesa cotada para o mesmo fornecedor
    */
    find first cotacao-item-cex
        where cotacao-item-cex.numero-ordem      = rowObject.numero-ordem
          and cotacao-item-cex.cod-emitente      = rowObject.cod-emitente
          and cotacao-item-cex.it-codigo         = rowObject.it-codigo
        &if defined(bf-mat-comex) &then
        &else
          and cotacao-item-cex.seq-cotac         = rowObject.seq-cotac
        &endif
          and cotacao-item-cex.data-cotacao      = rowObject.data-cotacao
          and cotacao-item-cex.mapa-cotacao      = rowObject.mapa-cotacao
          and cotacao-item-cex.cod-emitente-desp = rowObject.cod-emitente-desp
          no-lock no-error.
    if avail cotacao-item-cex then
        assign rowObject.cod-cond-pag  = cotacao-item-cex.cod-cond-pag
               rowObject.cod-comprado  = cotacao-item-cex.cod-comprado
               rowObject.cod-cond-pag  = cotacao-item-cex.cod-cond-pag
               rowObject.contato       = cotacao-item-cex.contato
               rowObject.dias-validade = cotacao-item-cex.dias-validade
               rowObject.motivo-apr    = cotacao-item-cex.motivo-apr
               rowObject.nr-dias-taxa  = cotacao-item-cex.nr-dias-taxa
               rowObject.perc-descto   = cotacao-item-cex.perc-descto
               rowObject.perc-taxa     = cotacao-item-cex.perc-taxa
               rowObject.taxa-financ   = cotacao-item-cex.taxa-financ.
               
    &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
    
        if avail tb-pr-cex and avail desp-tb-pr-cex then
            assign rowObject.nr-tab       = tb-pr-cex.nr-tab
                   rowObject.cod-cond-pag = desp-tb-pr-cex.cod-cond-pag
                   rowObject.perc-descto  = desp-tb-pr-cex.perc-descto
                   rowObject.taxa-financ  = tb-pr-cex.taxa-financ
                   rowObject.perc-taxa    = tb-pr-cex.perc-taxa
                   rowObject.nr-dias-taxa = tb-pr-cex.nr-dias-taxa.

        run cxbo/bocx095c.p persistent set h-bocx095c.
        run setCotacaoDespesaImportacao in h-bocx095c(input rowObject.numero-ordem,
                                                      input rowObject.cod-emitente,
                                                      input rowObject.it-codigo,
                                                      input rowObject.seq-cotac,
                                                      input rowObject.mapa-cotacao,
                                                      input rowObject.cod-itiner,
                                                      input rowObject.cod-incoterm,
                                                      input rowObject.cod-emitente-desp,
                                                      input rowObject.cod-desp,
                                                      input rowObject.nr-tab,
                                                      input rowObject.mo-codigo,
                                                      input rowObject.data-cotacao,
                                                      input 1,
                                                      input ?,
                                                      input rowObject.cod-cond-pag).
        run calculaDespesa in h-bocx095c(output d-valor-despesa,
                                         output table tt-bo-erro).
        if not can-find(first tt-bo-erro) then do:
            assign rowObject.val-desp = d-valor-despesa.
        end.
        delete procedure h-bocx095c.
        assign h-bocx095c = ?.
    &else
        create tt-parametros.
        assign tt-parametros.cod-versao-integracao = 2
               tt-parametros.cod-desp              = rowObject.cod-desp
               tt-parametros.cod-emitente          = rowObject.cod-emitente
               tt-parametros.cod-itiner            = rowObject.cod-itiner
               tt-parametros.cod-incoterm          = rowObject.cod-incoterm
               tt-parametros.nr-tab                = rowObject.nr-tab
               tt-parametros.cod-emitente-desp     = rowObject.cod-emitente-desp
               tt-parametros.modulo                = "imp":U.
        
        create tt-parametros-imp.
        assign tt-parametros-imp.numero-ordem = rowObject.numero-ordem
               tt-parametros-imp.it-codigo    = rowObject.it-codigo
             &if defined(bf-mat-comex) &then
               tt-parametros-imp.data         = rowObject.data-cotacao
             &else  
               tt-parametros-imp.seq-cotac    = rowObject.seq-cotac
             &endif    
               tt-parametros-imp.mapa-cotacao = rowObject.mapa-cotacao.       
        
        /*
        ** Calculo das despesas de importacao 
        */
        run cxbo/bocx095a.p (input table tt-parametros,
                             input table tt-parametros-imp,
                             input table tt-parametros-exp,
                             output d-valor-despesa,
                             output table tt-erro).    
        
        for each tt-erro:
            assign i-seq-erro = i-seq-erro + 1.
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = tt-erro.cd-erro
                   tt-bo-erro.mensagem = tt-erro.mensagem.
        end.    
        if not can-find(first tt-bo-erro) then do:
            if d-valor-despesa = ? then
                assign rowObject.val-desp = 0.
            else do:
                assign d-valor-aux = d-valor-despesa.
                if rowObject.mo-codigo <> 0 then do:
                    run cdp/cd0812.p (input 0,
                                      input rowObject.mo-codigo,
                                      input d-valor-despesa,
                                      input today,
                                      output d-valor-aux).
                    if d-valor-aux = ? or
                       d-valor-aux = 0 then
                        assign d-valor-aux = d-valor-despesa.
                end.
                assign rowObject.val-desp = d-valor-aux.
            end.            
        end.
    &endif
        
    if c-param = "add":U then do:
        run autoNumber2(output i-auto-num).
        if i-auto-num > 999 then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
            {utp/ut-table.i mgcex cotacao-item-cex 1}
            run utp/ut-msgs.p (input "msg":U,
                               input 17052,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 17052
                   tt-bo-erro.mensagem     = return-value.
        end.
        else do:
            assign rowObject.sequencia         = i-auto-num
                   rowObject.data-cotacao-desp = today.
                   rowObject.hora-atualiz      = string(time,'HH:MM:SS'). /* Grava a hora da atualizaá∆o */
        end.
    end.
    else do:
        find {&TABLE-NAME}
            where rowid({&TABLE-NAME}) = rowObject.r-rowid exclusive-lock no-error no-wait.
        if locked({&TABLE-NAME}) then do:
            assign i-seq-erro = i-seq-erro + 1.
            run utp/ut-msgs.p (input "msg":U,
    	                        input 16096,
                               input "").
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 16096
     	            tt-bo-erro.mensagem = return-value.
        end.
        else
            if avail {&TABLE-NAME} then do:
                run executeUpdate.
                assign {&TABLE-NAME}.cod-emitente-desp = rowObject.cod-emitente-desp.
            end.
    end.
    
end procedure.

procedure verificaNomeabrev:
    /*
    ** Permite ao usuario informar o nome abreviado do emitente em vez do codigo
    */
    def input-output parameter c-emitente as char no-undo. /** Variavel retorna codigo do emitente **/
    def output parameter table for tt-bo-erro.
    
    find emitente where emitente.nome-abrev = c-emitente no-lock no-error.
    if avail emitente then
        assign c-emitente = string(emitente.cod-emitente).
    else do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgadm emitente 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg":U,
                           input 2,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 2
               tt-bo-erro.mensagem     = return-value.
       end.
       
end procedure.

procedure verificaCGC:
    /*
    ** Permite ao usuario informar o CGC do emitente em vez do codigo
    */
    def input-output parameter c-emitente as char no-undo. /** Variavel retorna codigo do emitente **/
    def output parameter table for tt-bo-erro.
    
    /*{cdp/cd2503.i c-emitente}*/  /* Retira os caracteres "." "-" "/" */
    
    find first emitente where emitente.cgc = c-emitente no-lock no-error.
    if avail emitente then
        assign c-emitente = string(emitente.cod-emitente).
    else do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgadm emitente 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg":U,
                           input 2,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 2
               tt-bo-erro.mensagem     = return-value.
    end.
end procedure.

procedure verificaAprovacao:
    /*
    ** Verifica se a cotacao do item (cotacao-item) esta aprovada
    */
    def input parameter r-chave     as rowid no-undo.   /* rowid do registro corrente      */
    def output parameter l-aprovado as logical init no no-undo. /* variavel indica aprovado ou nao */
    {ccp/cc9019.i50}
  
    find {&TABLE-NAME} where rowid({&TABLE-NAME}) = r-chave no-lock no-error.
  
    for first cotacao-item fields(cotacao-item.cot-aprovada cotacao-item.char-1) NO-LOCK
        where cotacao-item.numero-ordem = {&TABLE-NAME}.numero-ordem and
              cotacao-item.cod-emitente = {&TABLE-NAME}.cod-emitente and
              cotacao-item.it-codigo    = {&table-name}.it-codigo and
              &if defined(bf-mat-comex) &then
                  cotacao-item.data-cotacao = {&TABLE-NAME}.data-cotacao:
   
                  assign i-mapa-cotacao-i50  = int(substring(cotacao-item.char-1,6,2))
                         c-cod-incoterm-i50  = substring(cotacao-item.char-1,8,3)
                         i-cod-pto-contr-i50 = int(substring(cotacao-item.char-1,11,5)).
   
              &else    
                  cotacao-item.seq-cotac    = {&TABLE-NAME}.seq-cotac:
                  {cdp/cd4300.i4 "yes" cotacao-item.char-1}
                  {ccp/cc9019.i51 "yes"}              
              &endif    
        
        if i-mapa-cotacao-i50 = {&TABLE-NAME}.mapa-cotacao then
            assign l-aprovado = cotacao-item.cot-aprovada.
        
    end.
    
    &IF "{&bf_mat_versao_ems}":U >= "2.062":U &THEN
        /* Se a variavel gl-pedido-emergencial estiver setada como YES,
         * o programa IM0010 foi executado pelo CC0300B, como antes da
         * chamada para o IM0010, a cotacao-item.cot-aprovada = NO, 
         * somente dever† ser considerada esta variavel para retornar
         * o status da cotacao-item */
        IF  gl-pedido-emergencial THEN
            ASSIGN l-aprovado = YES.
    &ENDIF
    
end procedure.


procedure verificaMapaaprovado:
    /*
    ** Verifica se o mapa de cotacao de despesas adicionais esta aprovado.
    */
    def input parameter r-chave as rowid no-undo.
    def output parameter l-mapa-aprovado as logical no-undo.
    
    {ccp/cc9019.i50}
    find {&TABLE-NAME} where rowid({&TABLE-NAME}) = r-chave no-lock no-error.
    
    if avail {&TABLE-NAME} then do:
        for first cotacao-item fields(cotacao-item.char-1 cotacao-item.cot-aprovada)
            where cotacao-item.it-codigo    = {&table-name}.it-codigo
              and cotacao-item.cod-emitente = {&TABLE-NAME}.cod-emitente 
              and cotacao-item.data-cotacao = {&TABLE-NAME}.data-cotacao               
              and cotacao-item.numero-ordem = {&TABLE-NAME}.numero-ordem 
              &if defined(bf-mat-comex) &then
              &else
                and cotacao-item.seq-cotac  = {&TABLE-NAME}.seq-cotac
              &endif
              no-lock:
              
            &if '{&bf_mat_versao_ems}' >= '2.062' &then
                assign l-cotacao-aprovada = cotacao-item.cot-aprovada.
            &endif         
              
            &if defined(bf-mat-comex) &then              
                assign i-mapa-cotacao-i50  = int(substring(cotacao-item.char-1,6,2))
                       c-cod-incoterm-i50  = substring(cotacao-item.char-1,8,3)
                       i-cod-pto-contr-i50 = int(substring(cotacao-item.char-1,11,5)).
            &else
                      {cdp/cd4300.i4 "yes" cotacao-item.char-1}
                      {ccp/cc9019.i51 "yes"}
            &endif    
            
            if i-mapa-cotacao-i50 = {&TABLE-NAME}.mapa-cotacao then do:
                assign l-mapa-aprovado = yes.
            end.
            
        end.
    end.
    
end procedure.

procedure aprovaMapa:
    /*
    ** Grava o mapa indicado na tabela cotacao do item - substring(char-1,1,2)
    ** Altera o mapa que esta gravado na cotacao do item
    ** Nao inclui nem altera o mapa quando a cotacao do item ja estiver aprovada
    */
    def input parameter r-chave as rowid no-undo.
    def output parameter table for tt-bo-erro.
    
    run imp/im9026.p (input r-chave,
                      output table tt-bo-erro).
                      
                      
end procedure.

procedure aprovaMapacc0308:
    /*
    ** Grava o mapa indicado na tabela cotacao do item - substring(char-1,1,2)
    ** Inclui/Altera mapa para cotacao ja aprovada
    */
    def input parameter r-chave as rowid no-undo.
    def output parameter table for tt-bo-erro.
    
    run imp/im9033.p (input r-chave,
                      output table tt-bo-erro).
                      
end procedure.

procedure executeCopy:
    /*
    ** Procedure para a copia de registros do pai
    ** Copia as despesas relacionadas ao mapa e grava o emitente como 0
    */
    def input parameter r-chave-cop as rowid no-undo.   /* registro originario da copia */
    def input parameter table for tt-cotacao-item-cex2. /* novo registro que foi criado */
    
    for each rowObject:
        delete rowObject.
    end.
    
    find first tt-cotacao-item-cex2 no-error.
    
    find {&TABLE-NAME} where rowid({&TABLE-NAME}) = r-chave-cop no-lock no-error.
    if avail {&TABLE-NAME} then do:
        create tt-cotacao-item-cex.
        buffer-copy {&TABLE-NAME} to tt-cotacao-item-cex.
        for each {&TABLE-NAME} where 
            {&TABLE-NAME}.numero-ordem = tt-cotacao-item-cex.numero-ordem and
            {&TABLE-NAME}.cod-emitente = tt-cotacao-item-cex.cod-emitente and
            {&table-name}.it-codigo    = tt-cotacao-item-cex.it-codigo and
            /*
            {&TABLE-NAME}.seq-cotac    = tt-cotacao-item-cex.seq-cotac and
            */
            {&TABLE-NAME}.mapa-cotacao = tt-cotacao-item-cex.mapa-cotacao and
            {&TABLE-NAME}.cod-incoterm = tt-cotacao-item-cex.cod-incoterm and
            {&TABLE-NAME}.cod-itiner   = tt-cotacao-item-cex.cod-itiner no-lock:
            create rowObject.
            assign rowObject.numero-ordem      = tt-cotacao-item-cex2.numero-ordem
                   rowObject.cod-emitente      = tt-cotacao-item-cex2.cod-emitente
                   rowObject.it-codigo         = tt-cotacao-item-cex2.it-codigo
                   /*
                   rowObject.seq-cotac         = tt-cotacao-item-cex2.seq-cotac
                   */
                   rowObject.cod-incoterm      = tt-cotacao-item-cex2.cod-incoterm
                   rowObject.cod-itiner        = tt-cotacao-item-cex2.cod-itiner
                   rowObject.mapa-cotacao      = tt-cotacao-item-cex2.mapa-cotacao
                   rowObject.cod-emitente-desp = 0
                   rowObject.cod-desp          = {&TABLE-NAME}.cod-desp.
        end.
        for each rowObject:
            if  not can-find(first {&TABLE-NAME} where
                {&TABLE-NAME}.numero-ordem = rowObject.numero-ordem and
                {&TABLE-NAME}.cod-emitente = rowObject.cod-emitente and
                {&table-name}.it-codigo    = rowObject.it-codigo and
                /*
                {&TABLE-NAME}.seq-cotac    = rowObject.seq-cotac and
                */
                {&TABLE-NAME}.mapa-cotacao = rowObject.mapa-cotacao and
                {&TABLE-NAME}.cod-incoterm = rowObject.cod-incoterm and
                {&TABLE-NAME}.cod-itiner   = rowObject.cod-itiner and
                {&TABLE-NAME}.cod-desp     = rowObject.cod-desp) then do:
                run executeCreate.
            end.
        end.
    end.
end procedure.

procedure getCharField:
    define input  parameter c-field as char.
    define output parameter c-value as char.
    
    case c-field:
        when "it-codigo" then c-value = RowObject.it-codigo.
        when "cod-incoterm" then c-value = RowObject.cod-incoterm.
        when "contato" then c-value = RowObject.contato.
        when "cod-comprado" then c-value = RowObject.cod-comprado.
        when "aprovador" then c-value = RowObject.aprovador.
        when "usuario" then c-value = RowObject.usuario.
        when "hora-atualiz" then c-value = RowObject.hora-atualiz.
        when "motivo-apr" then c-value = RowObject.motivo-apr.
        when "nr-tab" then c-value = RowObject.nr-tab.
        when "char-1" then c-value = RowObject.char-1.
        when "char-2" then c-value = RowObject.char-2.
        when "check-sum" then c-value = RowObject.check-sum.
        otherwise return error.
    end case.
end procedure.

procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.
    
    case c-field:
        when "val-desp" then c-value = RowObject.val-desp.
        when "perc-taxa" then c-value = RowObject.perc-taxa.
        when "perc-descto" then c-value = RowObject.perc-descto.
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        otherwise return error.
    end case.
end procedure.

procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.
    
    case c-field:
        when "cod-emitente" then c-value = RowObject.cod-emitente.
        when "numero-ordem" then c-value = RowObject.numero-ordem.
        when "seq-cotac" then c-value = RowObject.seq-cotac.
        when "mapa-cotacao" then c-value = RowObject.mapa-cotacao.
        when "cod-itiner" then c-value = RowObject.cod-itiner.
        when "sequencia" then c-value = RowObject.sequencia.
        when "cod-emitente-desp" then c-value = RowObject.cod-emitente-desp.
        when "cod-desp" then c-value = RowObject.cod-desp.
        when "cod-cond-pag" then c-value = RowObject.cod-cond-pag.
        when "mo-codigo" then c-value = RowObject.mo-codigo.
        when "dias-validade" then c-value = RowObject.dias-validade.
        when "nr-dias-taxa" then c-value = RowObject.nr-dias-taxa.
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.
        otherwise return error.
    end case.
end procedure.

procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.
    
    case c-field:
        when "data-cotacao" then c-value = RowObject.data-cotacao.
        when "data-cotacao-desp" then c-value = RowObject.data-cotacao-desp.
        when "data-atualiz" then c-value = RowObject.data-atualiz.
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.
        otherwise return error.
    end case.
end procedure.

procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.
    
    case c-field:
        when "taxa-financ" then c-value = RowObject.taxa-financ.
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.
        otherwise return error.
    end case.
end procedure.

procedure validateCreatecc0303:
    /*
    ** Utilizado na inclusao/modificacao de uma cotacao para o item de importacao (CC0303.W)
    */
    def input parameter table for rowObject.
    def input parameter i-pto-controle like pto-contr.cod-pto-contr no-undo.
    def output parameter table for tt-bo-erro.
    
    find first rowObject no-error.
    
    run validateIncotermPtocontrole (input rowObject.cod-incoterm,
                                     input i-pto-controle,
                                     output table tt-bo-erro).
                                     
    find first tt-bo-erro no-error.
    
    if rowObject.mapa-cotacao <> 0 then
        if  not can-find(first {&TABLE-NAME} where 
            {&TABLE-NAME}.numero-ordem    = rowObject.numero-ordem and
            {&TABLE-NAME}.cod-emitente    = rowObject.cod-emitente and
            {&table-name}.it-codigo       = rowObject.it-codigo and
          &if defined(bf-mat-comex) &then
            {&TABLE-NAME}.data-cotacao = rowObject.data-cotacao and 
          &else    
            {&TABLE-NAME}.seq-cotac    = rowObject.seq-cotac and
          &endif   
            {&TABLE-NAME}.mapa-cotacao    = rowObject.mapa-cotacao) then do:
           
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-field.i mgcex cotacao-item-cex mapa-cotacao 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p(input "msg":U,
                              input 2,
                              input return-value).
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.
        end.

end procedure.

procedure validateFieldscc0310:
    def input parameter table for rowObject.
    def input parameter table for tt-cotacao-item-cex2.
    def input parameter p-param as char no-undo.
    def output parameter table for tt-bo-erro.   

    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

    find first rowObject no-error.

    {cxbo/bocx085.i1 rowObject.cod-incoterm}    

    run validateFields.

    /* Teste de duplicidade - Verifica com os registros ja criados temporariamente */
    if p-param = "add" then do:
        find first tt-bo-erro 
             WHERE tt-bo-erro.errorSubType <> "INFORMATION":U
               AND tt-bo-erro.errorSubType <> "WARNING":U no-error.
        if not avail tt-bo-erro then do:
            find tt-cotacao-item-cex2
                where tt-cotacao-item-cex2.cod-emitente-desp = rowObject.cod-emitente-desp and
                      tt-cotacao-item-cex2.cod-desp          = rowObject.cod-desp
                      no-lock no-error.
            if avail tt-cotacao-item-cex2 then do:
                assign i-seq-erro = i-seq-erro + 1.
                /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                   pre-processador em chamada de includes */
                {utp/ut-table.i mgcex cotacao-item-cex 1}
                /******************************************/
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 8
                       tt-bo-erro.mensagem     = return-value.
            end.
        end.
    end.
end procedure.

procedure validateIncotermPtocontrole:
    /*
    ** Utilizada para validar o codigo da incoterm e o ponto de controle base informados na cotacao do item.
    */
    def input parameter c-cod-incoterm       like inco-cx.cod-incoterm no-undo.
    def input parameter i-cod-pto-contr-base like pto-contr.cod-pto-contr no-undo.
    def output parameter table for tt-bo-erro.
    
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    
    {cxbo/bocx085.i1 c-cod-incoterm} /* Validacao Incoterm */
    if i-cod-pto-contr-base = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        {utp/ut-liter.i Ponto_controle_base mim L}
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).
        run utp/ut-msgs.p(input "msg":U,
                          input 265,
                          input return-value).
        assign tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 265
               tt-bo-erro.mensagem = return-value.
    end.
    else do:
        if not can-find(pto-contr where pto-contr.cod-pto-contr = i-cod-pto-contr-base ) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex pto-contr 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p(input "msg":U,
                              input 2,
                              input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.
        end.
    end.    
end procedure.

procedure alterarCotacaoimp:
/*
** Altera os campos da cotacao referente a importacao (Incoterm, ponto de controle base)
*/
def input parameter p-numero-ordem       like ordem-compra.numero-ordem no-undo.
def input parameter p-incoterm           like inco-cx.cod-incoterm      no-undo.
def input parameter p-cod-pto-contr-base like pto-contr.cod-pto-contr   no-undo.
def input parameter p-de-aliq-ii         like item.aliquota-ipi init 0  no-undo.
def input parameter p-class-fiscal       like classif-fisc.class-fiscal no-undo.
def input parameter p-cod-fabricante     like emitente.cod-emitente     no-undo.
def input parameter p-regime-import      as   integer format ">9"       no-undo.
def input parameter p-de-aliq-ipi        like item.aliquota-ipi init 0  no-undo.
def output parameter table for tt-bo-erro.

def buffer b-{&TABLE-NAME} for {&TABLE-NAME}.

def var l-primeiro    as   logical initial no      no-undo.
def var c-return      as   char                    no-undo.
def var de-preco-unit like cotacao-item.preco-unit no-undo.
def var l-preco-bruto as   logical initial no      no-undo.

for each tt-bo-erro:
    delete tt-bo-erro.
end.

find ordem-compra
    where ordem-compra.numero-ordem = p-numero-ordem
    no-lock no-error.
    
find cotacao-item
    where cotacao-item.numero-ordem = p-numero-ordem
      and cotacao-item.cod-emitente = ordem-compra.cod-emitente
      and cotacao-item.it-codigo    = ordem-compra.it-codigo
      and cotacao-item.cot-aprovada
      exclusive-lock no-error.
if avail cotacao-item then do:
   if avail ordem-compra then
      assign i-num-pedido    = ordem-compra.num-pedido
             i-num-ordem     = ordem-compra.numero-ordem.
       
    assign c-cod-incoterm1 = p-incoterm.
    
    run validateIncoterm.
    
    {ccp/cc9019.i50}
    &if defined(bf-mat-comex) &then
        assign i-mapa-cotacao-i50  = int(substring(cotacao-item.char-1,6,2))
               c-cod-incoterm-i50  = substring(cotacao-item.char-1,8,3)
               i-cod-pto-contr-i50 = int(substring(cotacao-item.char-1,11,5))
               de-aliq-ii-i50      = dec(substring(cotacao-item.char-1,17,6))
               c-class-fiscal-i50  = substring(cotacao-item.char-1,23,10).
    &else                        
        {cdp/cd4300.i4 "yes" cotacao-item.char-1}
        {ccp/cc9019.i51 "yes"}
    &endif
    
    for each b-{&TABLE-NAME}
        where b-{&TABLE-NAME}.numero-ordem = cotacao-item.numero-ordem
          and b-{&TABLE-NAME}.cod-emitente = cotacao-item.cod-emitente
          and b-{&table-name}.it-codigo    = cotacao-item.it-codigo
        &if defined(bf-mat-comex) &then
          and b-{&TABLE-NAME}.data-cotacao = cotacao-item.data-cotacao        
        &else
          and b-{&TABLE-NAME}.seq-cotac    = cotacao-item.seq-cotac
        &endif              
          and b-{&TABLE-NAME}.mapa-cotacao = i-mapa-cotacao-i50
          no-lock:
        if not l-primeiro then do:
            assign l-primeiro = yes.
            find pto-itiner
                where pto-itiner.cod-itiner    = b-{&TABLE-NAME}.cod-itiner
                  and pto-itiner.cod-pto-contr = p-cod-pto-contr-base
                  no-lock no-error.
            if not avail pto-itiner then do:
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-liter.i Ponto_Controle_Base mim L}
                assign c-return = return-value + " " + string(p-cod-pto-contr-base).
                {utp/ut-table.i mgcex itinerario 1}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = c-return + "~~" + return-value + " " + string(b-{&TABLE-NAME}.cod-itiner).
                run utp/ut-msgs.p(input "msg":U,
                                  input 8691,
                                  input c-return + "~~" + return-value + " " + string(b-{&TABLE-NAME}.cod-itiner)).
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 8691
                       tt-bo-erro.mensagem = return-value.
                leave.
            end.
        end.
        
        find {&TABLE-NAME}
            where rowid({&TABLE-NAME}) = rowid(b-{&TABLE-NAME})
            exclusive-lock no-error.
        if avail {&TABLE-NAME} then
            assign {&TABLE-NAME}.cod-incoterm = p-incoterm.
        else leave.
    end.
    if can-find(first tt-bo-erro
                WHERE tt-bo-erro.errorSubType <> "INFORMATION":U
                  AND tt-bo-erro.errorSubType <> "WARNING":U) then 
        leave.
        
    assign c-cod-incoterm-i50     = p-incoterm
           i-cod-pto-contr-i50    = p-cod-pto-contr-base
           de-aliq-ii-i50         = p-de-aliq-ii
           c-class-fiscal-i50     = p-class-fiscal.
           
    &if defined(bf-mat-comex) &then
        assign substring(cotacao-item.char-1,8,3)  = p-incoterm
               substring(cotacao-item.char-1,11,5) = string(p-cod-pto-contr-base)
               substring(cotacao-item.char-1,17,6) = string(p-de-aliq-ii)
               substring(cotacao-item.char-1,23,10) = p-class-fiscal.
    &else  
        {ccp/cc9019.i51 "no"}
        {cdp/cd4300.i4 "no" cotacao-item.char-1}.
    &endif
    
    &if '{&bf_mat_versao_ems}' >= '2.062' &then
        {ocp/oc0201.i50}
    &else
        {ccp/cc0303.i50}
    &endif
    &if defined(bf-mat-comex) &then
    &else
        {cdp/cd4300.i4 "yes" cotacao-item.char-2}.
        &if '{&bf_mat_versao_ems}' >= '2.062' &then
            {ocp/oc0201.i51 "yes"}
        &else
            {ccp/cc0303.i51 "yes"}
        &endif
    &endif
    assign i-cod-fabricante-i50 = p-cod-fabricante
           i-regime-import-i50  = p-regime-import.
    &if defined(bf-mat-comex) &then
        assign substring(cotacao-item.char-1,33,9) = string(i-cod-fabricante-i50)
               substring(cotacao-item.char-1,42,2) = string(i-regime-import-i50).
    &else
        &if '{&bf_mat_versao_ems}' >= '2.062' &then
            {ocp/oc0201.i51 "no"}
        &else
            {ccp/cc0303.i51 "no"}
        &endif
        {cdp/cd4300.i4 "no" cotacao-item.char-2}.
    &endif
    
    /* 
    ** Atualiza Al°quota do IPI e Preáo Unit†rio conforme Pa°s x Al°quota    
    */            
    if p-regime-import <> 0 and 
       p-de-aliq-ipi <> cotacao-item.aliquota-ipi then do:
        find first param-compra no-lock no-error.
        &if defined(bf-mat-comex) &then        
            assign l-preco-bruto =  param-compra.ipi-sobre-preco.
        &else
            assign l-preco-bruto = (param-compra.ipi-sobre-preco = 1).
        &endif            
        
        /* 
        ** Atualizaá∆o Preáo 
        */
        assign cotacao-item.aliquota-ipi = p-de-aliq-ipi.
        {cdp/cd9300.i cotacao-item}
        assign cotacao-item.preco-unit = cotacao-item.pre-unit-for.
        
        find ordem-compra
            where ordem-compra.numero-ordem = p-numero-ordem exclusive-lock no-error.        
        assign ordem-compra.aliquota-ipi = p-de-aliq-ipi.            
        {cdp/cd9300.i ordem-compra}
        assign ordem-compra.preco-unit   = ordem-compra.pre-unit-for.
        /*
        ** C†lculo do preáo de reposiá∆o do item
        */        
        run ccp/ccapi001.p (input rowid(ordem-compra)).
    end.
end.

end procedure.


procedure calcularValorfatura:
/*
** Procedimento para calcular qual o valor das despesas que vao incidir no total da fatura
*/

def input  parameter pr-cotacao-item as   rowid                    no-undo.
def output parameter pde-valor-desp like cotacao-item-cex.val-desp no-undo.

def var de-valor-desp like cotacao-item-cex.val-desp no-undo.

{ccp/cc9019.i50}

find cotacao-item 
    where rowid(cotacao-item) = pr-cotacao-item no-lock no-error.
if avail cotacao-item then do:
  &if defined(bf-mat-comex) &then
    assign i-mapa-cotacao-i50  = int(substring(cotacao-item.char-1,6,2))
           c-cod-incoterm-i50  = substring(cotacao-item.char-1,8,3)
           i-cod-pto-contr-i50 = int(substring(cotacao-item.char-1,11,5)).
  &else
    {cdp/cd4300.i4 "yes" cotacao-item.char-1}
    {ccp/cc9019.i51 "yes"}
  &endif
    {cxbo/bocx085.i5} /* condicoes para despesa incidir */
                if avail cotacao-item-cex then do:
                    assign de-valor-desp = cotacao-item-cex.val-desp.
                    if cotacao-item-cex.mo-codigo <> cotacao-item.mo-codigo then do:
                        run cdp/cd0812.p (input cotacao-item-cex.mo-codigo,
                                          input cotacao-item.mo-codigo,
                                          input de-valor-desp,
                                          input today,
                                          output de-valor-desp).
                        if de-valor-desp = 0 or
                           de-valor-desp = ? then
                        assign de-valor-desp = cotacao-item-cex.val-desp.
                                          
                    end.
                    assign pde-valor-desp = pde-valor-desp + de-valor-desp.
                end.
            end.
        end.
end.    
    
end procedure.


procedure validaCotacaoitem:
    /*
    ** Valida as informaá‰es a serem gravadas na cotac∆o do item
    */
    def input parameter i-cod-emitente   like emitente.cod-emitente       no-undo.
    def input parameter c-cod-incoterm   like inco-cx.cod-incoterm        no-undo.
    def input parameter i-pto-contr-base like pto-contr.cod-pto-contr     no-undo.
    def input parameter i-cod-fabricante like emitente.cod-emitente       no-undo.
    def input parameter i-regime-import  like pais-aliquota.regime-import no-undo.
    def input parameter c-it-codigo      like item.it-codigo              no-undo.
    def input parameter c-class-fiscal   like classif-fisc.class-fiscal   no-undo.
    def input parameter c-nbs            as char                          no-undo.
    &if "{&bf_mat_versao_ems}":U >= "2.062":U &then
    def input parameter i-cdn-pais-orig  as integer format ">>,>>9":U     no-undo.
    &endif
    def output parameter table for tt-bo-erro.
    
    def var c-return   as   char          no-undo.
    def var i-cod-pais like pais.cod-pais no-undo.
    
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    
    /* 
    ** Verifica se emitente Ç estrangeiro ou trading e fornecedor
    */
    find emitente
        where emitente.cod-emitente = i-cod-emitente no-lock no-error.
    if not avail emitente then
        leave.
    else
      &if defined(bf-mat-comex) &then
        if emitente.natureza  = "F":U or 
           emitente.natureza  = "J":U or 
           emitente.identific = "C":U then
      &else
        if emitente.natureza  = 1 or 
           emitente.natureza  = 2 or
           emitente.identific = 1 then 
      &endif           
            leave.
    
    /*
    ** Valida incoterm
    */
    
    if c-cod-incoterm = "":U then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
        {utp/ut-field.i mgcex inco-cx cod-incoterm 1}
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    else 
        if not can-find(inco-cx 
                            where inco-cx.cod-incoterm = c-cod-incoterm) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
            {utp/ut-table.i mgcex inco-cx 1}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value + "~~" + c-cod-incoterm.
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input tt-bo-erro.parametros).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.                            
        end.
    
    /*
    ** Valida ponto de controle base
    */            
    if i-pto-contr-base = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
        {utp/ut-liter.i Ponto_Controle_Base * L}
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input tt-bo-erro.parametros).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    else 
        if not can-find(pto-contr 
                           where pto-contr.cod-pto-contr = i-pto-contr-base) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
            {utp/ut-liter.i Ponto_Controle_Base * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = trim(return-value) + "~~" + string(i-pto-contr-base).
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input tt-bo-erro.parametros).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.                            
        end.

    /*
    ** Valida fabricante e pais do fabricante
    */        
    if i-cod-fabricante <> 0 then do:
        find emitente
            where emitente.cod-emitente = i-cod-fabricante no-lock no-error.
        if not avail emitente then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
            {utp/ut-liter.i Fabricante * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = trim(return-value) + "~~" + string(i-cod-fabricante).
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input tt-bo-erro.parametros).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.
        end.
        else do:
          &if defined(bf-mat-comex) &then
            if emitente.identific = "C":U then do:
          &else
            if emitente.identific = 1     then do:
          &endif
                assign i-seq-erro = i-seq-erro + 1.
                /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
                {utp/ut-liter.i Fabricante * L}
                assign c-return = trim(return-value).
                {utp/ut-liter.i Cliente * L}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = c-return + "~~" + trim(return-value).
                run utp/ut-msgs.p (input "msg":U,
                                   input 7972,
                                   input tt-bo-erro.parametros).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 7972
                       tt-bo-erro.mensagem     = return-value.
            end.        
            find pais
                where pais.nome-pais = emitente.pais no-lock no-error.
            if not avail pais then do:
                assign i-seq-erro = i-seq-erro + 1.
                /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
                {utp/ut-liter.i Pa°s_do_fabricante * L}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = trim(return-value) + "~~" + emitente.pais.
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input tt-bo-erro.parametros).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = return-value.
            end.
            else 
                assign i-cod-pais = pais.cod-pais.        
        end.
    end.    
    
    /*
    ** Valida relacionamento pais origem x aliquota
    */
    if i-regime-import <> 0 then do:
        if i-cod-fabricante = 0 then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
            {utp/ut-liter.i C¢digo_Fabricante * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = trim(return-value).
            run utp/ut-msgs.p (input "msg":U,
                               input 265,
                               input tt-bo-erro.parametros).
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 265
                   tt-bo-erro.mensagem = return-value.        
        end.       

        if not can-find(pais-aliquota
                            where pais-aliquota.cod-pais      = &if '{&bf_mat_versao_ems}':U >= '2.062':U &then i-cdn-pais-orig &else i-cod-pais &endif
                              and pais-aliquota.regime-import = i-regime-import
                              and pais-aliquota.class-fiscal  = c-class-fiscal) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
            {utp/ut-table.i mgcex pais-aliquota 1}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.
        end.
    end.
    
    /*
    ** Verifica item e valida classificaá∆o fiscal e NBS informados
    */
        find item
            where item.it-codigo = c-it-codigo no-lock no-error.
    if avail item and
          &if defined (bf-mat-comex) &then
            item.tipo-contr = "D":U then do:
          &else
            item.tipo-contr = 4     then do:
          &endif
            if not can-find(classif-fisc
                                where classif-fisc.class-fiscal = c-class-fiscal) then do:
                assign i-seq-erro = i-seq-erro + 1.
                /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
                {utp/ut-liter.i Classificaá∆o_fiscal * L}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = trim(return-value) + "~~" + c-class-fiscal.
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input tt-bo-erro.parametros).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = return-value.
            end.
            
            if  c-nbs <> ""
            and not can-find(first cad-nbs no-lock
                             where cad-nbs.cod-nbs = c-nbs) then do:
                assign i-seq-erro = i-seq-erro + 1.
                /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
                {utp/ut-liter.i NBS * L}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = trim(return-value) + "~~" + c-nbs.
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input tt-bo-erro.parametros).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = return-value.
            end.
        end.

end procedure.


procedure validaMapacotacao:
/*
** Valida quando o mapa de despesas de importaá∆o for informado
*/
    def input parameter i-numero-ordem like cotacao-item-cex.numero-ordem no-undo.
    def input parameter i-cod-emitente like cotacao-item-cex.cod-emitente no-undo.
    def input parameter c-it-codigo    like cotacao-item-cex.it-codigo    no-undo.
  &if defined(bf-mat-comex) &then
    def input parameter da-data-cotacao like cotacao-item-cex.data-cotacao no-undo.
  &else
    def input parameter i-seq-cotac    like cotacao-item-cex.seq-cotac     no-undo.
  &endif
    def input parameter i-mapa-cotacao like cotacao-item-cex.mapa-cotacao  no-undo.
    def output parameter table for tt-bo-erro.
        
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    
    if i-mapa-cotacao = 0 then 
        leave.
        
    if not can-find(first {&TABLE-NAME} 
                        where {&TABLE-NAME}.numero-ordem = i-numero-ordem 
                          and {&TABLE-NAME}.cod-emitente = i-cod-emitente 
                          and {&table-name}.it-codigo    = c-it-codigo 
                        &if defined(bf-mat-comex) &then
                          and {&TABLE-NAME}.data-cotacao = da-data-cotacao 
                        &else    
                          and {&TABLE-NAME}.seq-cotac    = i-seq-cotac
                        &endif   
                          and {&TABLE-NAME}.mapa-cotacao = i-mapa-cotacao) then do:           
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece pre-processador em chamada de includes */
        {utp/ut-field.i mgcex cotacao-item-cex mapa-cotacao 1}
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p(input "msg":U,
                          input 2,
                          input return-value).
        assign tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = return-value.
    end.
    ELSE DO: 
        &IF '{&BF_MAT_VERSAO_EMS}' >= '2.062' &THEN
        
            for each cotacao-item-cex fields(log-recalc-val cod-desp) no-lock
               where cotacao-item-cex.numero-ordem = i-numero-ordem 
               AND   cotacao-item-cex.cod-emitente = i-cod-emitente 
               AND   cotacao-item-cex.it-codigo    = c-it-codigo
               &if defined(bf-mat-comex) &then
                   AND   cotacao-item-cex.data-cotacao = da-cotacao 
               &else    
                   AND   cotacao-item-cex.seq-cotac    = i-seq-cotac
               &endif    
               AND   cotacao-item-cex.mapa-cotacao = i-mapa-cotacao:

                IF cotacao-item-cex.log-recalc-val THEN DO:
                    assign i-seq-erro = i-seq-erro + 1.
                    create tt-bo-erro.
                    /* Inicio -- Projeto Internacional */
                    {utp/ut-liter.i "Mapa" *}
                    assign tt-bo-erro.parametros = RETURN-VALUE + "~~" + STRING(cotacao-item-cex.cod-desp).
                    run utp/ut-msgs.p (input "msg":U,
                                       input 30076,
                                       input RETURN-VALUE + "~~" + STRING(cotacao-item-cex.cod-desp)).
                    assign tt-bo-erro.i-sequen = i-seq-erro
                           tt-bo-erro.cd-erro  = 30076
                           tt-bo-erro.mensagem = return-value.    

                END.

            END.
        
        &ENDIF
    END.


end procedure.


procedure executeCreate:
    /*
    **  Cria registro na tabela.
    */
 
    create {&TABLE-NAME}.
    buffer-copy RowObject except r-rowid {1} to {&TABLE-NAME} no-error.

    return string(rowid({&TABLE-NAME})).
end procedure.
PROCEDURE executeDelete:

&IF DEFINED(LOCKCONTROL) > 0 &THEN     
    DEFINE VARIABLE iLockAgain AS INTEGER NO-UNDO.

    TRANS_BLOCK:
    DO TRANSACTION:

        /*--- Marca registro com exclusive-lock ---*/
        FIND CURRENT {&Table-Name} EXCLUSIVE-LOCK NO-WAIT NO-ERROR.

        /*--- Execucao de N (inicialmente 5) tentativas a fim de esperar o 
              registro corrente ser desbloqueado ---*/
        DO WHILE LOCKED {&Table-Name}:

            IF LOCKED {&Table-Name} THEN
                FIND CURRENT {&Table-Name} EXCLUSIVE-LOCK NO-WAIT NO-ERROR.
            
            IF (NOT LOCKED {&Table-Name} AND NOT AVAILABLE {&Table-Name}) OR
               (AVAILABLE {&Table-Name} AND NOT LOCKED {&Table-Name}) OR
               (iLockAgain >= 5) THEN LEAVE.
               
            ASSIGN iLockAgain = iLockAgain + 1.
            
        END.
        
        IF NOT AVAILABLE {&Table-Name} THEN
            IF NOT LOCKED {&Table-Name} THEN DO:
        
                /*--- Erro 3: Tabela {&TableLabel} nao disponivel ---*/

                ASSIGN i-seq-erro = i-seq-erro + 1.
                
                CREATE tt-bo-erro.
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "Tabela_" + {&TableLabel} + "_n∆o_dispon°vel" *}
                ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 3
                       tt-bo-erro.mensagem = RETURN-VALUE.
                
                UNDO TRANS_BLOCK, RETURN "NOK":U.
            END.
        ELSE IF LOCKED {&Table-Name} THEN DO:
            /*--- Erro 4: Registro da tabela {&TableLabel} estaˇ bloqueado 
                          por outro usuario ---*/

            ASSIGN i-seq-erro = i-seq-erro + 1.
            /* Inicio -- Projeto Internacional */
            {utp/ut-liter.i "Registro_da_tabela_" + {&TableLabel} + "_est†_bloqueado_por_outro_usu†rio" *}
            CREATE tt-bo-erro.
            ASSIGN tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 4
                   tt-bo-erro.mensagem = RETURN-VALUE.
            
            UNDO TRANS_BLOCK, RETURN "NOK":U.
        END.

        RUN procuraEmbarqueCompras (INPUT "Despesas do Embarque").
    
        /*--- tratamento tabela despes-ped-compra ---*/
        &IF  "{&bf_mat_versao_ems}" >= "2.062" &THEN
            
            RUN findPedidoOrdem (INPUT ROWID(cotacao-item-cex),
                                 OUTPUT i-pedido-vinculado).

            IF  i-pedido-vinculado <> 0 THEN DO:

                IF  NOT VALID-HANDLE(h-bocx341) THEN
                    RUN cxbo/bocx341.p PERSISTENT SET h-bocx341.
    
                FIND desp-imp WHERE
                     desp-imp.cod-desp = cotacao-item-cex.cod-desp NO-LOCK NO-ERROR.
                IF  AVAIL desp-imp
                AND desp-imp.tipo = 1 /* valor fixo */ THEN DO:

                    ASSIGN l-ultima-desp-pedido = YES.

                    /*--- verifica se a despesa que esta sendo eliminada eh a ultima
                          do pedido compra em questao ---*/
                    FOR EACH b-ordem-compra 
                        WHERE b-ordem-compra.num-pedido = i-pedido-vinculado NO-LOCK,
                        FIRST b-cotacao-item
                        WHERE b-cotacao-item.numero-ordem = b-ordem-compra.numero-ordem
                          AND b-cotacao-item.it-codigo    = b-ordem-compra.it-codigo
                          AND b-cotacao-item.cot-aprovada = YES  /* cotacao aprovada */
                          AND SUBSTRING(b-cotacao-item.char-1,1,20) <> "" /* mapa aprovado */ NO-LOCK:
                        FOR FIRST b-cotacao-item-cex
                            WHERE b-cotacao-item-cex.numero-ordem = b-ordem-compra.numero-ordem
                              AND b-cotacao-item-cex.cod-desp     = cotacao-item-cex.cod-desp
                              AND ROWID(b-cotacao-item-cex) <> ROWID(cotacao-item-cex)
                              AND b-cotacao-item-cex.mapa-cotacao = INT(SUBSTR(b-cotacao-item.char-1,1,20)) NO-LOCK: END.
                        IF  AVAIL b-cotacao-item-cex THEN DO:
                            ASSIGN l-ultima-desp-pedido = NO.
                            LEAVE.
                        END.
                    END.

                    IF  l-ultima-desp-pedido THEN DO:
                        RUN retornaValorDespesa IN h-bocx341(INPUT  i-pedido-vinculado, 
                                                             INPUT  cotacao-item-cex.cod-desp,
                                                             INPUT  cotacao-item-cex.mo-codigo,
                                                             INPUT  cotacao-item-cex.cod-emitente-desp,
                                                             INPUT  cotacao-item-cex.cod-cond-pag, 
                                                             INPUT  cotacao-item-cex.cod-pto-contr,
                                                             INPUT  cotacao-item-cex.tp-despesa,   
                                                             OUTPUT rw-despes-ped-compra,
                                                             OUTPUT de-vl-tot-desp-pedido).

                        /*--- elimina despes-ped-compra na base ---*/    
                        RUN emptyRowErrors IN h-bocx341.
                        RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                        RUN repositionRecord IN h-bocx341 (INPUT rw-despes-ped-compra).
    
                        IF RETURN-VALUE = "NOK":U THEN NEXT.
                        RUN deleteRecord IN h-bocx341.
                        RUN verificaErros(INPUT h-bocx341).
                        IF  RETURN-VALUE = "NOK":U THEN
                            UNDO TRANS_BLOCK, RETURN "NOK":U.
                        /*--- fim eliminacao despes-ped-compra ---*/
                    END.

                END.
                ELSE DO:
                    RUN retornaValorTotalDespCotada (INPUT  ROWID(cotacao-item-cex),
                                                     OUTPUT de-valor-tot-desp).
    
                    RUN retornaValorDespesa IN h-bocx341(INPUT  i-pedido-vinculado, 
                                                         INPUT  cotacao-item-cex.cod-desp,
                                                         INPUT  cotacao-item-cex.mo-codigo,
                                                         INPUT  cotacao-item-cex.cod-emitente-desp,
                                                         INPUT  cotacao-item-cex.cod-cond-pag, 
                                                         INPUT  cotacao-item-cex.cod-pto-contr,
                                                         INPUT  cotacao-item-cex.tp-despesa,   
                                                         OUTPUT rw-despes-ped-compra,
                                                         OUTPUT de-vl-tot-desp-pedido).
    
                    ASSIGN de-vl-diferenca = de-vl-tot-desp-pedido - de-valor-tot-desp.
    
                    IF  de-vl-diferenca > 0 THEN DO:
                        /*--- atualiza despes-ped-compra na base ---*/    
                        RUN emptyRowObject IN h-bocx341.
                        RUN emptyRowErrors IN h-bocx341.
                        RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                        RUN repositionRecord IN h-bocx341 (INPUT rw-despes-ped-compra).
                        IF  RETURN-VALUE <> "NOK":U THEN DO:
                            RUN getRecord IN h-bocx341 (OUTPUT TABLE tt-despes-ped-compra).
                            FIND FIRST tt-despes-ped-compra NO-ERROR.
                            IF  AVAIL tt-despes-ped-compra THEN DO:
                                ASSIGN tt-despes-ped-compra.val-desp = de-vl-diferenca.
                                RUN setRecord IN h-bocx341(INPUT TABLE tt-despes-ped-compra).
                                RUN updateRecord IN h-bocx341.
                                RUN verificaErros(INPUT h-bocx341).
                                IF  RETURN-VALUE = "NOK":U THEN
                                    UNDO TRANS_BLOCK, RETURN "NOK":U.
                            END.
                        END.
                        /*--- fim atualizacao despes-ped-compra ---*/
                    END.
                    ELSE DO:
                        /*--- elimina despes-ped-compra na base ---*/    
                        RUN emptyRowErrors IN h-bocx341.
                        RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                        RUN repositionRecord IN h-bocx341 (INPUT rw-despes-ped-compra).
    
                        IF RETURN-VALUE = "NOK":U THEN NEXT.
                        RUN deleteRecord IN h-bocx341.
                        RUN verificaErros(INPUT h-bocx341).
                        IF  RETURN-VALUE = "NOK":U THEN
                            UNDO TRANS_BLOCK, RETURN "NOK":U.
                        /*--- fim eliminacao despes-ped-compra ---*/
                    END.
                END.
    
                IF  VALID-HANDLE(h-bocx341) THEN DO:
                    DELETE PROCEDURE h-bocx341 NO-ERROR.
                    ASSIGN h-bocx341 = ?.
                END.

            END.
        &ENDIF
        /*--- fim tratamento tabela despes-ped-compra ---*/

        DELETE {&TABLE-NAME}.
        
    END.    

&ELSE
    &IF  "{&bf_mat_versao_ems}" >= "2.062" &THEN
    BLOCK_update:
    DO TRANS:
    &ENDIF
    RUN procuraEmbarqueCompras (INPUT "Despesas do Embarque").

    /*--- tratamento tabela despes-ped-compra ---*/
    &IF  "{&bf_mat_versao_ems}" >= "2.062" &THEN
        
        RUN findPedidoOrdem (INPUT ROWID(cotacao-item-cex),
                             OUTPUT i-pedido-vinculado).

        IF  i-pedido-vinculado <> 0 THEN DO:

            IF  NOT VALID-HANDLE(h-bocx341) THEN
                RUN cxbo/bocx341.p PERSISTENT SET h-bocx341.

            RUN retornaValorTotalDespCotada (INPUT  ROWID(cotacao-item-cex),
                                             OUTPUT de-valor-tot-desp).

            RUN retornaValorDespesa IN h-bocx341(INPUT  i-pedido-vinculado, 
                                                 INPUT  cotacao-item-cex.cod-desp,
                                                 INPUT  cotacao-item-cex.mo-codigo,
                                                 INPUT  cotacao-item-cex.cod-emitente-desp,
                                                 INPUT  cotacao-item-cex.cod-cond-pag, 
                                                 INPUT  cotacao-item-cex.cod-pto-contr,
                                                 INPUT  cotacao-item-cex.tp-despesa,   
                                                 OUTPUT rw-despes-ped-compra,
                                                 OUTPUT de-vl-tot-desp-pedido).

            ASSIGN de-vl-diferenca = de-vl-tot-desp-pedido - de-valor-tot-desp.

            IF  de-vl-diferenca > 0 THEN DO:
                /*--- atualiza despes-ped-compra na base ---*/    
                RUN emptyRowObject IN h-bocx341.
                RUN emptyRowErrors IN h-bocx341.
                RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                RUN repositionRecord IN h-bocx341 (INPUT rw-despes-ped-compra).
                IF  RETURN-VALUE <> "NOK":U THEN DO:
                    RUN getRecord IN h-bocx341 (OUTPUT TABLE tt-despes-ped-compra).
                    FIND FIRST tt-despes-ped-compra NO-ERROR.
                    IF  AVAIL tt-despes-ped-compra THEN DO:
                        ASSIGN tt-despes-ped-compra.val-desp = de-vl-diferenca.
                        RUN setRecord IN h-bocx341(INPUT TABLE tt-despes-ped-compra).
                        RUN updateRecord IN h-bocx341.
                        RUN verificaErros(INPUT h-bocx341).
                        IF  RETURN-VALUE = "NOK":U THEN
                            UNDO BLOCK_update, RETURN "NOK":U.
                    END.
                END.
                /*--- fim atualizacao despes-ped-compra ---*/
            END.
            ELSE DO:
                /*--- elimina despes-ped-compra na base ---*/    
                RUN emptyRowErrors IN h-bocx341.
                RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                RUN repositionRecord IN h-bocx341 (INPUT rw-despes-ped-compra).
                IF  RETURN-VALUE = "OK":U THEN 
                    RUN deleteRecord IN h-bocx341.
                RUN verificaErros(INPUT h-bocx341).
                IF  RETURN-VALUE = "NOK":U THEN
                    UNDO BLOCK_update, RETURN "NOK":U.
                /*--- fim eliminacao despes-ped-compra ---*/
            END.

            IF  VALID-HANDLE(h-bocx341) THEN DO:
                DELETE PROCEDURE h-bocx341 NO-ERROR.
                ASSIGN h-bocx341 = ?.
            END.
        END.
    &ENDIF
    /*--- fim tratamento tabela despes-ped-compra ---*/

    find current {&table-name} exclusive-lock no-error.
    DELETE {&TABLE-NAME}.

    &IF  "{&bf_mat_versao_ems}" >= "2.062" &THEN
    END. /* DO TRANS */
    &ENDIF

&ENDIF
    
END PROCEDURE.


PROCEDURE procuraEmbarqueCompras:
DEF INPUT PARAM p-mensagem AS CHAR.
    &if "{&bf_mat_versao_ems}" >= "2.04" &then
        if connected("mgcex") then do:
        
            run cxbo/bocx225.p persistent set h-bocx225.
            /* -- Verifica se o mapa est† aprovado -- */        
            
            run verificaMapaAprovado (input rowid({&table-name}), 
                                      output l-mapa-aprovado).
                                      
            /* -- Verifica a tabela de emitentes -- */
            find first emitente where 
                       emitente.cod-emitente = {&Table-Name}.cod-emitente 
                       no-lock no-error.
            
            find first ordem-compra where 
                       ordem-compra.numero-ordem = {&Table-Name}.numero-ordem 
                       no-lock no-error.
            
            find first param-global no-lock no-error.
        
            /* -- Verifica alteraá‰es na ordem de compra -- */
                if (l-mapa-aprovado)        and 
                   (param-global.modulo-07) and 
                   (emitente.natureza = 3   or emitente.natureza = 4)  then
                    run procuraEmbarqueCompras in h-bocx225 
                        (input ordem-compra.num-pedido, 
                         input ordem-compra.numero-ordem, 
                         input ?, 
                         output table tt-embarque). 
                                 
                    /* -- Se existir algum registro na tt-Embarque --*/
                    assign c-msg = "".
                    for each tt-embarque:
                        if c-msg = "" then
                            assign c-msg = tt-embarque.embarque.
                        else
                            assign c-msg = c-msg + ", " + tt-embarque.embarque.
                    end.
                    
                    if c-msg <> "" then do:
                        
                        run utp/ut-msgs.p (input "msg":U,
                                           input 28558, 
                                           input c-msg + "~~" + p-mensagem).

                        assign i-seq-erro = i-seq-erro + 1.
                        create tt-bo-erro.
                        assign tt-bo-erro.i-sequen = i-seq-erro
                               tt-bo-erro.cd-erro  = 28558
                               tt-bo-erro.parametros = c-msg + "~~" + p-mensagem
                               tt-bo-erro.errorsubtype = "INFORMATION"
                               tt-bo-erro.mensagem     = RETURN-VALUE.
                    end.
            delete procedure h-bocx225.
        end.
    &endif               
END PROCEDURE.

procedure validateIncoterm:
/* 
** Procedure respons†vel pela verificaá∆o da Incoterm na Ordem de Compra,
** Todas as ordens de compra precisam ter a mesma incoterm.
*/

def buffer bf-ordem-compra for ordem-compra.
def buffer bf-cotacao-item for cotacao-item.

def var c-cod-incoterm2 as char no-undo.

for first bf-ordem-compra fields(num-pedido)
    where bf-ordem-compra.numero-ordem = i-numero-ordem no-lock:
end.
if avail bf-ordem-compra then
   assign i-num-pedido = bf-ordem-compra.num-pedido.        

for first bf-ordem-compra fields(numero-ordem)
    where bf-ordem-compra.num-pedido   = i-num-pedido
      and bf-ordem-compra.numero-ordem <> i-num-ordem no-lock:
end.

if avail bf-ordem-compra then do:
   find bf-cotacao-item where
        bf-cotacao-item.numero-ordem = bf-ordem-compra.numero-ordem and
        bf-cotacao-item.cot-aprovada no-lock no-error.
        
end.
if avail bf-cotacao-item then do:
    {ccp/cc9019.i50}
    {cdp/cd4300.i4 "yes" bf-cotacao-item.char-1}

    {ccp/cc9019.i51 "yes"}
    assign c-cod-incoterm2 = c-cod-incoterm-i50.

    if c-cod-incoterm1  <> c-cod-incoterm2 AND
       c-cod-incoterm2  <> "" then do:
        create tt-bo-erro.
        run utp/ut-msgs.p (input "msg":U,
                           input 17478,
                           input "").
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 17478
               tt-bo-erro.mensagem     = return-value.
    end.
end.

return "":U.

end procedure.

PROCEDURE pi-calcula-despesa:
/*
Objetivo - Calcular o valor da despesa com base na 
           tabela cotacao-item-cex. Executada a partir
           da imapi006.p.
*/
&IF '{&BF_MAT_VERSAO_EMS}' >= '2.062' &THEN
    DEF INPUT  PARAM p-rowid     AS ROWID               NO-UNDO.
    DEF OUTPUT PARAM p-val-desp  LIKE desp-imp.val-desp NO-UNDO.
    
    DEF VAR    de-val-desp-ant    LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEF VAR    de-val-diferenca   LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEF VAR    de-diferenca-tot   LIKE cotacao-item-cex.val-desp NO-UNDO.
    DEF VAR    de-qtd-total       AS   DEC                       NO-UNDO.
    def buffer b-cotacao-item-cex for cotacao-item-cex.

    BLOCK_update:
    DO TRANS:
    
        FIND b-cotacao-item-cex WHERE
             ROWID(b-cotacao-item-cex) = p-rowid EXCLUSIVE-LOCK NO-ERROR.
    
        IF  NOT AVAIL b-cotacao-item-cex THEN
            RETURN "NOK":U.
    
        ASSIGN de-val-desp-ant = b-cotacao-item-cex.val-desp.
        
        run cxbo/bocx095c.p persistent set h-bocx095c.
        run setCotacaoDespesaImportacao in h-bocx095c(input b-cotacao-item-cex.numero-ordem,
                                                      input b-cotacao-item-cex.cod-emitente,
                                                      input b-cotacao-item-cex.it-codigo,
                                                      input b-cotacao-item-cex.seq-cotac,
                                                      input b-cotacao-item-cex.mapa-cotacao,
                                                      input b-cotacao-item-cex.cod-itiner,
                                                      input b-cotacao-item-cex.cod-incoterm,
                                                      input b-cotacao-item-cex.cod-emitente-desp,
                                                      input b-cotacao-item-cex.cod-desp,
                                                      input b-cotacao-item-cex.nr-tab,
                                                      input b-cotacao-item-cex.mo-codigo,
                                                      input b-cotacao-item-cex.data-cotacao,
                                                      input 1,
                                                      input rowid(b-cotacao-item-cex),
                                                      input b-cotacao-item-cex.cod-cond-pag).
        run calculaDespesa in h-bocx095c(output p-val-desp,
                                         output table tt-bo-erro).
        delete procedure h-bocx095c.
        assign h-bocx095c = ?
               b-cotacao-item-cex.log-recalc-val = no.
    
        /*--- verifica se o valor da despesa realmente
              sera alterado ---*/
        IF  p-val-desp <> de-val-desp-ant THEN DO:
    
            /*--- marca as despesas/impostos influenciados pela alteracao
                  para serem recalculados ---*/
            run imp/imapi006.p(input "cotacao-item-cex":U,  
                               input rowid(b-cotacao-item-cex),
                               input b-cotacao-item-cex.cod-desp,
                               input 0,
                               input table rowObject,
                               input-output table tt-desp-ja-recalc).

            /*--- verifica se a despesa que esta sendo alterada 
                  pertence a um mapa aprovado por uma ordem vinculada 
                  a um pedido de compra ----*/
            RUN findPedidoOrdem (INPUT ROWID(b-cotacao-item-cex),
                                 OUTPUT i-pedido-vinculado).
    
            IF  i-pedido-vinculado <> 0 THEN DO:
    
                ASSIGN de-val-diferenca = p-val-desp - de-val-desp-ant.
    
                IF  NOT VALID-HANDLE(h-bocx341) THEN
                    RUN cxbo/bocx341.p PERSISTENT SET h-bocx341.
    
                FIND cotacao-item
                     WHERE cotacao-item.numero-ordem = b-cotacao-item-cex.numero-ordem
                       AND cotacao-item.it-codigo    = b-cotacao-item-cex.it-codigo
                       AND cotacao-item.data-cotacao = b-cotacao-item-cex.data-cotacao
                       AND cotacao-item.seq-cotac    = b-cotacao-item-cex.seq-cotac NO-LOCK NO-ERROR.
    
                IF  AVAIL cotacao-item 
                AND VALID-HANDLE(h-bocx341) THEN DO:
                    RUN retornaQuantidadeTotal (INPUT ROWID(cotacao-item),
                                                OUTPUT de-qtd-total).
    
                    ASSIGN de-diferenca-tot = de-qtd-total * de-vl-diferenca.
    
                    RUN retornaIncotermRateio IN h-bocx341(INPUT ROWID(b-cotacao-item-cex),
                                                           INPUT i-pedido-vinculado,
                                                           OUTPUT c-cod-incoterm).
    
                    RUN retornaValorDespesa IN h-bocx341(INPUT i-pedido-vinculado, 
                                                         INPUT b-cotacao-item-cex.cod-desp,
                                                         INPUT b-cotacao-item-cex.mo-codigo,
                                                         INPUT b-cotacao-item-cex.cod-emitente-desp,
                                                         INPUT b-cotacao-item-cex.cod-cond-pag,
                                                         INPUT b-cotacao-item-cex.cod-pto-contr,
                                                         INPUT b-cotacao-item-cex.tp-despesa,
                                                         OUTPUT rw-despes-ped-compra,
                                                         OUTPUT de-vl-tot-desp-pedido).
    
                    IF  de-vl-tot-desp-pedido <> 0 THEN DO:
                        /*--- atualiza despes-ped-compra na base ---*/    
                        RUN emptyRowObject IN h-bocx341.
                        RUN emptyRowErrors IN h-bocx341.
                        RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                        RUN repositionRecord IN h-bocx341 (INPUT rw-despes-ped-compra).
                        IF  RETURN-VALUE <> "NOK":U THEN DO:
                            RUN getRecord IN h-bocx341 (OUTPUT TABLE tt-despes-ped-compra).
                            FIND FIRST tt-despes-ped-compra NO-ERROR.
                            IF  AVAIL tt-despes-ped-compra THEN DO:
                                FIND desp-imp WHERE
                                     desp-imp.cod-desp = rowObject.cod-desp NO-LOCK NO-ERROR.
                                IF  AVAIL desp-imp
                                AND desp-imp.tipo = 1 /* valor fixo */ THEN
                                    /*--- atualiza o pedido com o valor recalculado pela
                                          bocx095c ---*/
                                    ASSIGN tt-despes-ped-compra.val-desp = p-val-desp.
                                ELSE
                                    ASSIGN tt-despes-ped-compra.val-desp = de-diferenca-tot + de-vl-tot-desp-pedido.
                                RUN setRecord IN h-bocx341(INPUT TABLE tt-despes-ped-compra).
                                RUN updateRecord IN h-bocx341.
                                RUN verificaErros(INPUT h-bocx341).
                                IF  RETURN-VALUE = "NOK":U THEN
                                    UNDO BLOCK_update, RETURN "NOK":U.
                            END.
                        END.
                        /*--- fim atualizacao despes-ped-compra ---*/
                    END.
                    ELSE DO:
    
                        RUN retornaValorTotalDespCotada (INPUT  ROWID(b-cotacao-item-cex),
                                                         OUTPUT de-valor-tot-desp).
    
                        /*--- cria despes-ped-compra na base ---*/    
                        RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                        RUN emptyRowObject IN h-bocx341.
                        RUN emptyRowErrors IN h-bocx341.
                        empty temp-table tt-despes-ped-compra.
                        CREATE tt-despes-ped-compra.
                        ASSIGN tt-despes-ped-compra.num-pedido        = i-pedido-vinculado
                               tt-despes-ped-compra.cod-desp          = b-cotacao-item-cex.cod-desp
                               tt-despes-ped-compra.cod-emitente-desp = b-cotacao-item-cex.cod-emitente-desp
                               tt-despes-ped-compra.cod-incoterm-rat  = c-cod-incoterm
                               tt-despes-ped-compra.cod-pto-contr     = b-cotacao-item-cex.cod-pto-contr
                               tt-despes-ped-compra.cod-cond-pag      = b-cotacao-item-cex.cod-cond-pag
                               tt-despes-ped-compra.mo-codigo         = b-cotacao-item-cex.mo-codigo
                               tt-despes-ped-compra.tp-despesa        = b-cotacao-item-cex.tp-despesa.
                        FIND desp-imp WHERE
                             desp-imp.cod-desp = rowObject.cod-desp NO-LOCK NO-ERROR.
                        IF  AVAIL desp-imp
                        AND desp-imp.tipo = 1 /* valor fixo */ THEN
                            /*--- atualiza o pedido com o valor recalculado pela
                                  bocx095c ---*/
                            ASSIGN tt-despes-ped-compra.val-desp = p-val-desp.
                        ELSE
                            ASSIGN tt-despes-ped-compra.val-desp = de-valor-tot-desp.
                        RUN sugereSeqDespesa IN h-bocx341 (INPUT i-pedido-vinculado,
                                                           OUTPUT tt-despes-ped-compra.sequencia).
                        RUN setRecord IN h-bocx341 (INPUT TABLE tt-despes-ped-compra).
                        RUN createRecord IN h-bocx341.
                        RUN verificaErros(INPUT h-bocx341).
                        IF  RETURN-VALUE = "NOK":U THEN
                            UNDO BLOCK_update, RETURN "NOK":U.
                        /*--- fim criacao despes-ped-compra ---*/
                    END.
                END.
    
                IF  VALID-HANDLE(h-bocx341) THEN DO:
                    DELETE PROCEDURE h-bocx341 NO-ERROR.
                    ASSIGN h-bocx341 = ?.
                END.                     
            END.
        END.
    END.

    RETURN "OK":U.
&endif
END PROCEDURE.
/***************************************************************/
PROCEDURE pi-calcula-preco-unit:
&IF "{&BF_MAT_VERSAO_EMS}" >= "2.062" &THEN
    DEFINE INPUT        PARAMETER p-cod-estabel   LIKE ordem-compra.cod-estabel  NO-UNDO.
    DEFINE INPUT        PARAMETER p-numero-ordem  LIKE ordem-compra.numero-ordem NO-UNDO.
    DEFINE INPUT-OUTPUT PARAMETER p-de-preco-unit LIKE ordem-compra.preco-unit   NO-UNDO.

    for first param-imp fields (cdn-despes-impto-ipi)
        where param-imp.cod-estabel = p-cod-estabel no-lock: 
    end.
    IF AVAIL param-imp THEN DO:

        for first ordem-compra fields (preco-unit)
            where ordem-compra.numero-ordem = p-numero-ordem no-lock: 
        end.
        if  avail ordem-compra then do:

            for first cotacao-item fields (numero-ordem cod-emitente it-codigo
                                           seq-cotac data-cotacao char-1 aliquota-ipi)
                WHERE cotacao-item.numero-ordem = p-numero-ordem
                and   cotacao-item.cot-aprovada no-lock: 
            end.
            IF AVAIL cotacao-item THEN DO:
    
                for first cotacao-item-cex
                    where cotacao-item-cex.numero-ordem = cotacao-item.numero-ordem
                    and   cotacao-item-cex.cod-emitente = cotacao-item.cod-emitente
                    and   cotacao-item-cex.it-codigo    = cotacao-item.it-codigo
                    and   cotacao-item-cex.seq-cotac    = cotacao-item.seq-cotac
                    and   cotacao-item-cex.data-cotacao = cotacao-item.data-cotacao
                    and   cotacao-item-cex.mapa-cotacao = int(substr(cotacao-item.char-1,1,20))
                    and   cotacao-item-cex.cod-desp     = param-imp.cdn-despes-impto-ipi no-lock: 
                end.
                if  avail cotacao-item-cex then
                    ASSIGN p-de-preco-unit = (ordem-compra.preco-unit * 100)/(100 + cotacao-item.aliquota-ipi). 
            END.
        END.
    end.
    RETURN "OK":U.
&ENDIF
END PROCEDURE.

PROCEDURE atualizaMapaDespesasPedido:

&IF  "{&bf_mat_versao_ems}" >= "2.062"  &THEN

DEF INPUT PARAM pr-cotacao-item    AS ROWID                           NO-UNDO.
DEF INPUT PARAM pi-mapa-cotac-novo LIKE cotacao-item-cex.mapa-cotacao NO-UNDO.
DEF INPUT PARAM pi-mapa-cotac-ant  LIKE cotacao-item-cex.mapa-cotacao NO-UNDO.

DEF VAR de-val-diferenca AS DEC NO-UNDO.
def buffer b-cotacao-item-cex for cotacao-item-cex.

    FIND cotacao-item WHERE
         ROWID(cotacao-item) = pr-cotacao-item NO-LOCK NO-ERROR.
    
    IF  NOT AVAIL cotacao-item THEN
        RETURN "NOK":U.
    
    FIND FIRST ordem-compra 
         WHERE ordem-compra.numero-ordem = cotacao-item.numero-ordem NO-LOCK NO-ERROR.    
         
    IF  NOT AVAIL ordem-compra THEN
        RETURN "NOK":U.
         
    find first pedido-compr
         where pedido-compr.num-pedido = ordem-compra.num-pedido no-lock no-error.
         
    IF NOT AVAIL pedido-compr or (avail pedido-compr and pedido-compr.emergencial = no) then 
        RETURN "OK":U.

    IF  NOT VALID-HANDLE(h-bocx341) THEN
        RUN cxbo/bocx341.p PERSISTENT SET h-bocx341.

    BLOCK_update:
    DO TRANS:

        IF  ordem-compra.num-pedido > 0 THEN DO:
    
            FOR EACH cotacao-item-cex OF cotacao-item
                WHERE cotacao-item-cex.mapa-cotacao = pi-mapa-cotac-ant NO-LOCK:
    
                RUN retornaValorTotalDespCotada (INPUT  ROWID(cotacao-item-cex),
                                                 OUTPUT de-valor-tot-desp).
    
                RUN retornaValorDespesa IN h-bocx341(INPUT ordem-compra.num-pedido, 
                                                     INPUT cotacao-item-cex.cod-desp,
                                                     INPUT cotacao-item-cex.mo-codigo,
                                                     INPUT cotacao-item-cex.cod-emitente-desp,
                                                     INPUT cotacao-item-cex.cod-cond-pag,
                                                     INPUT cotacao-item-cex.cod-pto-contr,
                                                     INPUT cotacao-item-cex.tp-despesa,
                                                     OUTPUT rw-despes-ped-compra,
                                                     OUTPUT de-vl-tot-desp-pedido).
    
                IF  de-vl-tot-desp-pedido > 0 THEN DO:
    

                    FIND desp-imp WHERE
                         desp-imp.cod-desp = cotacao-item-cex.cod-desp NO-LOCK NO-ERROR.
                    IF  AVAIL desp-imp
                    AND desp-imp.tipo = 1 /* valor fixo */ THEN DO:

                        ASSIGN l-ultima-desp-pedido = YES.

                        /*--- verifica se a despesa que esta sendo eliminada eh a ultima
                              do pedido compra em questao ---*/
                        FOR EACH b-ordem-compra 
                            WHERE b-ordem-compra.num-pedido = i-pedido-vinculado NO-LOCK,
                            FIRST b-cotacao-item
                            WHERE b-cotacao-item.numero-ordem = b-ordem-compra.numero-ordem
                              AND b-cotacao-item.it-codigo    = b-ordem-compra.it-codigo
                              AND b-cotacao-item.cot-aprovada = YES  /* cotacao aprovada */
                              AND SUBSTRING(b-cotacao-item.char-1,1,20) <> "" /* mapa aprovado */ NO-LOCK:
                            FOR FIRST b-cotacao-item-cex
                                WHERE b-cotacao-item-cex.numero-ordem = b-ordem-compra.numero-ordem
                                  AND b-cotacao-item-cex.cod-desp     = cotacao-item-cex.cod-desp
                                  AND ROWID(b-cotacao-item-cex) <> ROWID(cotacao-item-cex)
                                  AND b-cotacao-item-cex.mapa-cotacao = INT(SUBSTR(b-cotacao-item.char-1,1,20)) NO-LOCK: END.
                            IF  AVAIL b-cotacao-item-cex THEN DO:
                                ASSIGN l-ultima-desp-pedido = NO.
                                LEAVE.
                            END.
                        END.

                        IF  l-ultima-desp-pedido THEN DO:
                            /*--- elimina despes-ped-compra na base ---*/    
                            RUN emptyRowErrors IN h-bocx341.
                            RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                            RUN repositionRecord IN h-bocx341 (INPUT rw-despes-ped-compra).

                            IF RETURN-VALUE = "NOK":U THEN NEXT.
                            RUN deleteRecord IN h-bocx341.
                            RUN verificaErros(INPUT h-bocx341).
                            IF  RETURN-VALUE = "NOK":U THEN
                                UNDO, RETURN "NOK":U.
                            /*--- fim eliminacao despes-ped-compra ---*/
                        END.

                    END.
                    ELSE DO:
                        ASSIGN de-val-diferenca = de-vl-tot-desp-pedido - de-valor-tot-desp.
        
                        IF  de-val-diferenca > 0 THEN DO:
                            /*--- atualiza despes-ped-compra na base ---*/    
                            RUN emptyRowObject IN h-bocx341.
                            RUN emptyRowErrors IN h-bocx341.
                            RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                            RUN repositionRecord IN h-bocx341 (INPUT rw-despes-ped-compra).
                            IF  RETURN-VALUE <> "NOK":U THEN DO:
                                RUN getRecord IN h-bocx341 (OUTPUT TABLE tt-despes-ped-compra).
                                FIND FIRST tt-despes-ped-compra NO-ERROR.
                                IF  AVAIL tt-despes-ped-compra THEN DO:
                                    ASSIGN tt-despes-ped-compra.val-desp = de-val-diferenca.
                                    RUN setRecord IN h-bocx341(INPUT TABLE tt-despes-ped-compra).
                                    RUN updateRecord IN h-bocx341.
                                    RUN verificaErros(INPUT h-bocx341).
                                    IF  RETURN-VALUE = "NOK":U THEN
                                        UNDO BLOCK_update, RETURN "NOK":U.
                                END.
                            END.
                            /*--- fim atualizacao despes-ped-compra ---*/
                        END.
                        ELSE DO:
                            /*--- elimina despes-ped-compra na base ---*/    
                            RUN emptyRowErrors IN h-bocx341.
                            RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                            RUN repositionRecord IN h-bocx341 (INPUT rw-despes-ped-compra).
                            IF RETURN-VALUE = "NOK":U THEN NEXT.
                            RUN deleteRecord IN h-bocx341.
                            RUN verificaErros(INPUT h-bocx341).
                            IF  RETURN-VALUE = "NOK":U THEN
                                UNDO BLOCK_update, RETURN "NOK":U.
                            /*--- fim eliminacao despes-ped-compra ---*/
                        END.       
                    END.
                END.
            END. /* for each cotacao-item-cex... */
    
    
            FOR EACH cotacao-item-cex OF cotacao-item
                WHERE cotacao-item-cex.mapa-cotacao = pi-mapa-cotac-novo NO-LOCK:
    
                RUN retornaValorTotalDespCotada (INPUT  ROWID(cotacao-item-cex),
                                                 OUTPUT de-valor-tot-desp).
    
                RUN retornaIncotermRateio IN h-bocx341(INPUT ROWID(cotacao-item-cex),
                                                       INPUT i-pedido-vinculado,
                                                       OUTPUT c-cod-incoterm).
    
    
                /*--- soma o novo valor da cotacao-item-cex,
                      na despes-ped-compra ---*/
                RUN retornaValorDespesa IN h-bocx341(INPUT  ordem-compra.num-pedido, 
                                                     INPUT  cotacao-item-cex.cod-desp,
                                                     INPUT  cotacao-item-cex.mo-codigo,
                                                     INPUT  cotacao-item-cex.cod-emitente-desp,
                                                     INPUT  cotacao-item-cex.cod-cond-pag, 
                                                     INPUT  cotacao-item-cex.cod-pto-contr,
                                                     INPUT  cotacao-item-cex.tp-despesa,   
                                                     OUTPUT rw-despes-ped-compra,
                                                     OUTPUT de-vl-tot-desp-pedido).
    
                IF  de-vl-tot-desp-pedido > 0 THEN DO:

                    FIND desp-imp WHERE
                         desp-imp.cod-desp = rowObject.cod-desp NO-LOCK NO-ERROR.
                    IF  AVAIL desp-imp
                    AND desp-imp.tipo = 1 /* valor fixo */ THEN DO:
                        /*--- alerta: despesas do tipo valor fixo nao sao 
                              atualizadas automaticamente no pedido de compra ---*/
                        assign i-seq-erro = i-seq-erro + 1.            
                        create tt-bo-erro.
                        assign tt-bo-erro.parametros = string(rowObject.cod-desp).            
                        run utp/ut-msgs.p (input "msg":U,
                                           input 31410,
                                           input tt-bo-erro.parametros).
                        assign tt-bo-erro.i-sequen     = i-seq-erro
                               tt-bo-erro.cd-erro      = 31410
                               tt-bo-erro.mensagem     = return-value.
                        run utp/ut-msgs.p (input "help":U,
                                           input 31410,
                                           input tt-bo-erro.parametros).
                        ASSIGN tt-bo-erro.errorhelp = RETURN-VALUE.
                    END.
                    ELSE DO:


                        /*--- atualiza despes-ped-compra na base ---*/    
                        RUN emptyRowObject IN h-bocx341.
                        RUN emptyRowErrors IN h-bocx341.
                        RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                        RUN repositionRecord IN h-bocx341 (INPUT rw-despes-ped-compra).
                        IF  RETURN-VALUE <> "NOK":U THEN DO:
                            RUN getRecord IN h-bocx341 (OUTPUT TABLE tt-despes-ped-compra).
                            FIND FIRST tt-despes-ped-compra NO-ERROR.
                            IF  AVAIL tt-despes-ped-compra THEN DO:
                                FIND desp-imp WHERE
                                     desp-imp.cod-desp = rowObject.cod-desp NO-LOCK NO-ERROR.
                                IF  AVAIL desp-imp
                                AND desp-imp.tipo = 1 /* valor fixo */ THEN 
                                    ASSIGN tt-despes-ped-compra.val-desp = de-valor-tot-desp.
                                ELSE
                                    ASSIGN tt-despes-ped-compra.val-desp = de-valor-tot-desp + de-vl-tot-desp-pedido.
                                RUN setRecord IN h-bocx341(INPUT TABLE tt-despes-ped-compra).
                                RUN updateRecord IN h-bocx341.
                                RUN verificaErros(INPUT h-bocx341).
                                IF  RETURN-VALUE = "NOK":U THEN
                                    UNDO BLOCK_update, RETURN "NOK":U.
                            END.
                        END.
                        /*--- fim atualizacao despes-ped-compra ---*/
                    END.
                END.
                ELSE DO:
                    /*--- cria despes-ped-compra na base ---*/    
                    RUN openQueryStatic IN h-bocx341 (INPUT "main":U).
                    RUN emptyRowObject IN h-bocx341.
                    RUN emptyRowErrors IN h-bocx341.
                    empty temp-table tt-despes-ped-compra.
                    CREATE tt-despes-ped-compra.
                    ASSIGN tt-despes-ped-compra.num-pedido        = ordem-compra.num-pedido
                           tt-despes-ped-compra.cod-desp          = cotacao-item-cex.cod-desp
                           tt-despes-ped-compra.cod-emitente-desp = cotacao-item-cex.cod-emitente-desp
                           tt-despes-ped-compra.cod-incoterm-rat  = c-cod-incoterm
                           tt-despes-ped-compra.cod-pto-contr     = cotacao-item-cex.cod-pto-contr
                           tt-despes-ped-compra.cod-cond-pag      = cotacao-item-cex.cod-cond-pag
                           tt-despes-ped-compra.mo-codigo         = cotacao-item-cex.mo-codigo
                           tt-despes-ped-compra.tp-despesa        = cotacao-item-cex.tp-despesa
                           tt-despes-ped-compra.val-desp          = de-valor-tot-desp.
                    RUN sugereSeqDespesa IN h-bocx341 (INPUT ordem-compra.num-pedido,
                                                       OUTPUT tt-despes-ped-compra.sequencia).
                    RUN setRecord IN h-bocx341 (INPUT TABLE tt-despes-ped-compra).
                    RUN createRecord IN h-bocx341.
                    RUN verificaErros(INPUT h-bocx341).
                    IF  RETURN-VALUE = "NOK":U THEN
                        UNDO BLOCK_update, RETURN "NOK":U.
                    /*--- fim criacao despes-ped-compra ---*/
                END.                           
            END.
        END.
    END. /* DO TRANS: */

    IF  VALID-HANDLE(h-bocx341) THEN DO:
        DELETE PROCEDURE h-bocx341 NO-ERROR.
        ASSIGN h-bocx341 = ?.
    END.



    RETURN "OK":U.
&ENDIF
END PROCEDURE.


PROCEDURE findPedidoOrdem:
/*****
Este procedure eh responsavel por verificar se a despesa cotada pertence a um mapa 
aprovado por uma ordem de compra aprovada e vinculada a um pedido
*****/
&IF  "{&bf_mat_versao_ems}" >= "2.062"  &THEN

DEF INPUT  PARAM pr-cotacao-item-cex AS ROWID                     NO-UNDO.
DEF OUTPUT PARAM pi-num-pedido       LIKE pedido-compr.num-pedido NO-UNDO.

    FOR FIRST cotacao-item-cex FIELDS(numero-ordem)
        WHERE ROWID(cotacao-item-cex) = pr-cotacao-item-cex NO-LOCK: END.

    IF  NOT AVAIL cotacao-item-cex THEN
        RETURN "NOK":U.

    RUN verificaMapaAprovado (INPUT pr-cotacao-item-cex, 
                              OUTPUT l-mapa-aprovado).

    IF  NOT l-mapa-aprovado THEN
        RETURN "OK":U.

    RUN verificaAprovacao (INPUT pr-cotacao-item-cex,
                           OUTPUT l-aprovado).

    IF  NOT l-aprovado THEN
        RETURN "OK":U.

    FOR FIRST ordem-compra FIELDS(num-pedido)
        WHERE ordem-compra.numero-ordem = cotacao-item-cex.numero-ordem NO-LOCK: END.

    IF  AVAIL ordem-compra THEN
        ASSIGN pi-num-pedido = ordem-compra.num-pedido.

    RETURN "OK":U.
&ENDIF
END PROCEDURE.

PROCEDURE retornaValorTotalDespCotada:
/****
Este procedure serah responsavel por retornar para cada despesa 
cotada o seu valor total
****/
&IF  "{&bf_mat_versao_ems}" >= "2.062"  &THEN

    DEF INPUT  PARAM pr-cotacao-item-cex AS ROWID                        NO-UNDO.
    DEF OUTPUT PARAM pde-val-desp        LIKE despes-ped-compra.val-desp NO-UNDO.

    DEF VAR de-qtd-total AS DEC FORMAT ">>>,>>>,>>9.9999"                NO-UNDO.

    FIND cotacao-item-cex WHERE
         ROWID(cotacao-item-cex) = pr-cotacao-item-cex NO-LOCK NO-ERROR.

    IF  NOT AVAIL cotacao-item-cex THEN
        RETURN "NOK":U.

    FIND FIRST cotacao-item 
         WHERE cotacao-item.numero-ordem             = cotacao-item-cex.numero-ordem
           AND cotacao-item.it-codigo                = cotacao-item-cex.it-codigo
           AND cotacao-item.seq-cotac                = cotacao-item-cex.seq-cotac
           AND cotacao-item.data-cotacao             = cotacao-item-cex.data-cotacao
           AND INT(SUBSTR(cotacao-item.char-1,1,20)) = cotacao-item-cex.mapa-cotacao
        NO-LOCK NO-ERROR.

    IF  NOT AVAIL cotacao-item THEN
        RETURN "NOK":U.

    RUN retornaQuantidadeTotal (INPUT ROWID(cotacao-item),
                                OUTPUT de-qtd-total).
    
    FIND desp-imp WHERE
         desp-imp.cod-desp = cotacao-item-cex.cod-desp NO-LOCK NO-ERROR.
    IF  AVAIL desp-imp
    AND desp-imp.tipo = 1 /* valor fixo */ THEN
        ASSIGN pde-val-desp = cotacao-item-cex.val-desp.
    ELSE
        ASSIGN pde-val-desp = de-qtd-total * cotacao-item-cex.val-desp.

    RETURN "OK":U.
&ENDIF
END PROCEDURE.

PROCEDURE retornaQuantidadeTotal:
/****
Este procedure serah responsavel por retornar para a 
cotacao a quantidade total da cotacao
****/

&IF  "{&bf_mat_versao_ems}" >= "2.062"  &THEN

    DEF INPUT PARAM pr-cotacao-item AS ROWID                         NO-UNDO.
    DEF OUTPUT PARAM pde-qtd-total  AS DEC FORMAT ">>>,>>>,>>9.9999" NO-UNDO.

    FIND cotacao-item WHERE
         ROWID(cotacao-item) = pr-cotacao-item NO-LOCK NO-ERROR.

    IF  NOT AVAIL cotacao-item THEN
        RETURN "NOK":U.

    FOR EACH  prazo-compra FIELDS(quantidade)
        WHERE prazo-compra.numero-ordem = cotacao-item.numero-ordem
          AND prazo-compra.situacao <> 4 /* eliminada */ NO-LOCK:

        ASSIGN pde-qtd-total = pde-qtd-total + prazo-compra.quantidade.

    END.

    RETURN "OK":U.
&ENDIF

END PROCEDURE.

PROCEDURE verificaErros:
    DEF INPUT PARAM h-bo AS HANDLE NO-UNDO.

    RUN getRowErrors IN h-bo(OUTPUT TABLE rowErrors).

    for each rowErrors
        where rowErrors.ErrorType = "INTERNAL":
        delete rowErrors.
    end.

    FOR EACH tt-bo-erro:
        DELETE tt-bo-erro.
    END.

    FOR EACH rowErrors:
        ASSIGN i-seq-erro = i-seq-erro + 1.            
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = rowErrors.ErrorNumber
               tt-bo-erro.mensagem     = rowErrors.ErrorDescription
               tt-bo-erro.parametros   = rowErrors.ErrorParameters
               tt-bo-erro.errorSubType = rowErrors.errorSubType
               tt-bo-erro.errorType    = rowErrors.errorType.
    END.


    /*--- Verifica ocorrància de erros ---*/
    IF  CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
    
END PROCEDURE.

PROCEDURE getTtBoErro:
    DEF OUTPUT PARAM TABLE FOR tt-bo-erro.
END PROCEDURE.

PROCEDURE emptyTtBoErro:
    FOR EACH tt-bo-erro:
        DELETE tt-bo-erro.
    END.
END PROCEDURE.

procedure NovocalculoPrecocotacao:
    DEF input  parameter i-moeda-g      AS INTEGER FORMAT ">9"         NO-UNDO.
    DEF input  parameter l-conv-g       AS LOGICAL                     NO-UNDO.
    DEF input  parameter da-conv-g      AS DATE    FORMAT "99/99/9999" NO-UNDO.
    def input  parameter r-cot-item-cex as rowid                       no-undo.
    def output parameter de-preco       like cotacao-item-cex.val-desp no-undo.
    def buffer b-cotacao-item-cex for cotacao-item-cex.
       
    def var de-vl-preco                 like cotacao-item-cex.val-desp no-undo.
     
    assign de-vl-preco = 0
           de-preco    = 0.

    find first b-cotacao-item-cex where rowid(b-cotacao-item-cex) = r-cot-item-cex no-lock no-error.
        
    for each cotacao-item-cex where cotacao-item-cex.it-codigo    = b-cotacao-item-cex.it-codigo
                                and cotacao-item-cex.cod-emitente = b-cotacao-item-cex.cod-emitente
                                and cotacao-item-cex.data-cotacao = b-cotacao-item-cex.data-cotacao
                                and cotacao-item-cex.numero-ordem = b-cotacao-item-cex.numero-ordem
                                and cotacao-item-cex.mapa-cotacao = b-cotacao-item-cex.mapa-cotacao
                                and cotacao-item-cex.cod-incoterm = b-cotacao-item-cex.cod-incoterm
                                and cotacao-item-cex.cod-itiner   = b-cotacao-item-cex.cod-itiner no-lock:
        find first desp-imp where desp-imp.cod-desp = cotacao-item-cex.cod-desp no-lock no-error.
        if avail desp-imp and (desp-imp.inc-val-embal       = yes 
                           or  desp-imp.inc-val-seguro      = yes
                           or  desp-imp.inc-val-frete       = yes 
                           or  desp-imp.inc-val-outras-desp = yes) then do:
           if l-conv-g = yes then
              run cdp/cd0812.p (input  cotacao-item-cex.mo-codigo,
                                input  i-moeda-g,
                                input  cotacao-item-cex.val-desp,
                                input  cotacao-item-cex.data-cotacao,
                                output de-vl-preco).
           else
              run cdp/cd0812.p (input  cotacao-item-cex.mo-codigo,
                                input  i-moeda-g,
                                input  cotacao-item-cex.val-desp,
                                input  da-conv-g,
                                output de-vl-preco).
                                
           assign de-preco = de-preco + de-vl-preco.                      
        end.
    end.                                                     

END PROCEDURE.

procedure verificaMapaCotAprovado:

    /*
    ** Verifica se o mapa de cotacao de despesas adicionais esta aprovado.
    */
    def input parameter  r-chave as rowid no-undo.
    def output parameter l-mapa-aprovado    as logical no-undo.
    def output parameter p-cotacao-aprovada as logical no-undo.
    
    assign l-cotacao-aprovada = no.
    
    run verificaMapaAprovado (input  r-chave, 
                              output l-mapa-aprovado).
                              
    assign p-cotacao-aprovada = l-cotacao-aprovada.
                                      
                              
end procedure.

PROCEDURE repositionOpenQuery:
    DEFINE INPUT PARAM p-row-table AS ROWID NO-UNDO.    
    DEFINE OUTPUT PARAM rowid-array AS ROWID EXTENT 18 NO-UNDO.
    DEF VAR oldRowid AS ROWID NO-UNDO.
    IF AVAIL(cotacao-item-cex) THEN 
        ASSIGN oldRowid = ROWID(cotacao-item-cex).
    ELSE 
        ASSIGN oldRowid = ?.

     FIND FIRST cotacao-item-cex NO-LOCK 
             WHERE ROWID(cotacao-item-cex) = p-row-table NO-ERROR.
     IF AVAIL cotacao-item-cex THEN
        FIND FIRST ordem-compra WHERE ordem-compra.numero-ordem = cotacao-item-cex.numero-ordem NO-LOCK NO-ERROR.
    

    IF l-estab-security-active AND AVAIL(ordem-compra) THEN DO:
        FIND FIRST {&ESTAB-SEC-TT} NO-LOCK 
             WHERE {&ESTAB-SEC-TT-FIELD} = ordem-compra.cod-estabel NO-ERROR.
    END.
    ELSE DO:
        FIND FIRST {&ESTAB-SEC-TT} NO-LOCK NO-ERROR.             
    END.
    IF AVAIL {&ESTAB-SEC-TT} AND AVAIL(ordem-compra)  THEN DO:
        ASSIGN 
            rowid-array[1] = p-row-table
            rowid-array[2] = ROWID(ordem-compra)
            rowid-array[3] = ROWID({&ESTAB-SEC-TT}).
        RETURN "OK".
    END.
    ELSE DO:
        
        /*inicio logica para retornar ao registro anterior*/
        IF oldRowid <> ? THEN DO:

            FIND FIRST cotacao-item-cex NO-LOCK 
                 WHERE ROWID(cotacao-item-cex) = oldRowid NO-ERROR.
            IF AVAIL cotacao-item-cex THEN
                FIND FIRST ordem-compra WHERE ordem-compra.numero-ordem = cotacao-item-cex.numero-ordem NO-LOCK NO-ERROR.
            
            IF l-estab-security-active AND AVAIL(ordem-compra) THEN DO:
                FIND FIRST {&ESTAB-SEC-TT} NO-LOCK 
                     WHERE {&ESTAB-SEC-TT-FIELD} = ordem-compra.cod-estabel NO-ERROR.
            END.
            ELSE DO:
                FIND FIRST {&ESTAB-SEC-TT} NO-LOCK NO-ERROR.             
            END.
        END.
        /*fim logica para retornar ao registro anterior*/
        IF AVAIL {&ESTAB-SEC-TT} AND AVAIL(ordem-compra) THEN DO:   
                
            ASSIGN 
                rowid-array[1] = oldRowid
                rowid-array[2] = ROWID(ordem-compra)
                rowid-array[3] = ROWID({&ESTAB-SEC-TT}).                 
                    
                
            RETURN "OK".
        END.
        ELSE DO:        
            ASSIGN ERROR-STATUS:ERROR = NO. /*CORRIGE O ERRO DE STATUS PARA NAO APRESENTAR A MSG 16690*/
            ASSIGN 
                rowid-array[1] = ?    
                rowid-array[2] = ?
                rowid-array[3] = ?
                rowid-array[4] = ?    
                rowid-array[5] = ?
                rowid-array[6] = ?.
            /*RETURN "ADM-ERROR".*/
            RETURN "NOK".
        END.
    END.
END PROCEDURE.

procedure findRowid2:
    /*
    **  Localiza registro pelo rowid e nao retorna o registro.
    */
    def input parameter r-chave as rowid no-undo.
    find cotacao-item-cex where
        rowid(cotacao-item-cex) = r-chave
        no-lock no-error.
    if avail cotacao-item-cex then RUN setCurrent.
end procedure.
