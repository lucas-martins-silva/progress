def temp-table tt-embarque no-undo
    field embarque as char format "x(16)".
procedure setConstraint1:
end procedure.

procedure setConstraint2:
    def input parameter p-inicial as char no-undo.

    assign c-inicial = p-inicial.
end procedure.

procedure setConstraint3:
/*
** Setconstraint para o browser do programa filho.
*/
    def input parameter r-chave as rowid no-undo.

    find {&TABLE-NAME} where rowid({&TABLE-NAME}) = r-chave no-lock no-error.
    if avail {&TABLE-NAME} then
        assign c-it-codigo    = {&table-name}.it-codigo
               i-cod-emitente = {&TABLE-NAME}.cod-emitente
               d-data-cotacao = {&TABLE-NAME}.data-cotacao
               i-numero-ordem = {&TABLE-NAME}.numero-ordem
               i-mapa-cotacao = {&TABLE-NAME}.mapa-cotacao
               c-cod-incoterm = {&TABLE-NAME}.cod-incoterm.
    else
        assign c-it-codigo    = ""
               i-cod-emitente = 0
               d-data-cotacao = ?
               i-numero-ordem = 0
               i-mapa-cotacao = 0
               c-cod-incoterm = "".   
            
end procedure.

procedure setConstraint4:
/*
** Setconstraint para o browser do programa filho.
*/
    def input parameter r-chave as rowid no-undo.

    find {&TABLE-NAME} where rowid({&TABLE-NAME}) = r-chave no-lock no-error.
    if avail {&TABLE-NAME} then
        assign c-it-codigo    = {&table-name}.it-codigo
               i-cod-emitente = {&TABLE-NAME}.cod-emitente
               d-data-cotacao = {&TABLE-NAME}.data-cotacao
               i-numero-ordem = {&TABLE-NAME}.numero-ordem
               i-mapa-cotacao = {&TABLE-NAME}.mapa-cotacao
               c-cod-incoterm = {&TABLE-NAME}.cod-incoterm.
    else
        assign c-it-codigo    = ""
               i-cod-emitente = 0
               d-data-cotacao = ?
               i-numero-ordem = 0
               i-mapa-cotacao = 0
               c-cod-incoterm = "".   
end procedure.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then do:
            &Scoped-define OPEN-QUERY-{&MY-QUERY}-AT OPEN QUERY {&Query-Name} FOR~
                                       EACH {&Table-Name} NO-LOCK,~
                                       EACH ordem-compra WHERE ordem-compra.numero-ordem = {&Table-Name}.numero-ordem NO-LOCK,~
                                       EACH {&ESTAB-SEC-TT} WHERE {&ESTAB-SEC-TT-FIELD} = ordem-compra.cod-estabel.
                                                
            &Scoped-define OPEN-QUERY-{&MY-QUERY}-IN OPEN QUERY {&Query-Name} FOR~
                                      EACH {&Table-Name} NO-LOCK,~
                                      EACH ordem-compra WHERE ordem-compra.numero-ordem = {&Table-Name}.numero-ordem NO-LOCK,~
                                      EACH  {&ESTAB-SEC-TT} no-lock.
                {include/i-estab-openquery.i}
        end.
        when 2 then do:
            &Scoped-define OPEN-QUERY-{&MY-QUERY}-AT OPEN QUERY {&Query-Name} FOR~
                                      EACH {&Table-Name} NO-LOCK~
                                      WHERE {&table-name}.it-codigo >= c-inicial,~
                                      EACH ordem-compra WHERE ordem-compra.numero-ordem = {&Table-Name}.numero-ordem NO-LOCK,~
                                      EACH {&ESTAB-SEC-TT} WHERE {&ESTAB-SEC-TT-FIELD} = ordem-compra.cod-estabel.
                                                
            &Scoped-define OPEN-QUERY-{&MY-QUERY}-IN OPEN QUERY {&Query-Name} FOR~
                                      EACH {&Table-Name} NO-LOCK~
                                      WHERE {&table-name}.it-codigo >= c-inicial,~
                                      EACH ordem-compra WHERE ordem-compra.numero-ordem = {&Table-Name}.numero-ordem NO-LOCK,~
                                      EACH  {&ESTAB-SEC-TT} no-lock.
            {include/i-estab-openquery.i}
        end.
        when 3 then do:
            &Scoped-define OPEN-QUERY-{&MY-QUERY}-AT OPEN QUERY {&Query-Name} FOR~
                                      EACH {&Table-Name} NO-LOCK~
                                      WHERE {&table-name}.it-codigo    = c-it-codigo~
                                      AND   {&TABLE-NAME}.cod-emitente = i-cod-emitente~
                                      AND   {&TABLE-NAME}.data-cotacao = d-data-cotacao~
                                      AND   {&TABLE-NAME}.numero-ordem = i-numero-ordem~
                                      AND   {&TABLE-NAME}.mapa-cotacao = i-mapa-cotacao~
                                      AND   {&TABLE-NAME}.cod-incoterm = c-cod-incoterm,~
                                      EACH ordem-compra WHERE ordem-compra.numero-ordem = {&Table-Name}.numero-ordem NO-LOCK,~
                                      EACH {&ESTAB-SEC-TT} WHERE {&ESTAB-SEC-TT-FIELD} = ordem-compra.cod-estabel~
                                      BY {&TABLE-NAME}.cod-emitente-desp.
                                                
            &Scoped-define OPEN-QUERY-{&MY-QUERY}-IN OPEN QUERY {&Query-Name} FOR~
                                      EACH {&Table-Name} NO-LOCK~
                                      WHERE {&table-name}.it-codigo    = c-it-codigo~
                                      AND   {&TABLE-NAME}.cod-emitente = i-cod-emitente~
                                      AND   {&TABLE-NAME}.data-cotacao = d-data-cotacao~
                                      AND   {&TABLE-NAME}.numero-ordem = i-numero-ordem~
                                      AND   {&TABLE-NAME}.mapa-cotacao = i-mapa-cotacao~
                                      AND   {&TABLE-NAME}.cod-incoterm = c-cod-incoterm,~
                                      EACH ordem-compra WHERE ordem-compra.numero-ordem = {&Table-Name}.numero-ordem NO-LOCK,~
                                      EACH  {&ESTAB-SEC-TT} no-lock~
                                      BY {&TABLE-NAME}.cod-emitente-desp.
            {include/i-estab-openquery.i}        
        end.
        when 4 then do:
            &Scoped-define OPEN-QUERY-{&MY-QUERY}-AT OPEN QUERY {&Query-Name} FOR~
                                      EACH {&Table-Name} NO-LOCK~
                                      WHERE {&table-name}.it-codigo    = c-it-codigo~
                                      AND   {&TABLE-NAME}.cod-emitente = i-cod-emitente~
                                      AND   {&TABLE-NAME}.data-cotacao = d-data-cotacao~
                                      AND   {&TABLE-NAME}.numero-ordem = i-numero-ordem~
                                      AND   {&TABLE-NAME}.mapa-cotacao = i-mapa-cotacao~
                                      AND   {&TABLE-NAME}.cod-incoterm = c-cod-incoterm,~
                                      EACH ordem-compra WHERE ordem-compra.numero-ordem = {&Table-Name}.numero-ordem NO-LOCK,~
                                      EACH {&ESTAB-SEC-TT} WHERE {&ESTAB-SEC-TT-FIELD} = ordem-compra.cod-estabel.
                                                
            &Scoped-define OPEN-QUERY-{&MY-QUERY}-IN OPEN QUERY {&Query-Name} FOR~
                                      EACH {&Table-Name} NO-LOCK~
                                      WHERE {&table-name}.it-codigo    = c-it-codigo~
                                      AND   {&TABLE-NAME}.cod-emitente = i-cod-emitente~
                                      AND   {&TABLE-NAME}.data-cotacao = d-data-cotacao~
                                      AND   {&TABLE-NAME}.numero-ordem = i-numero-ordem~
                                      AND   {&TABLE-NAME}.mapa-cotacao = i-mapa-cotacao~
                                      AND   {&TABLE-NAME}.cod-incoterm = c-cod-incoterm,~
                                      EACH ordem-compra WHERE ordem-compra.numero-ordem = {&Table-Name}.numero-ordem NO-LOCK,~
                                      EACH  {&ESTAB-SEC-TT} no-lock.
            {include/i-estab-openquery.i}
        end.
    end case.
    
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.

