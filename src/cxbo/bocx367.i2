FOR EACH proc-it-nota-fisc NO-LOCK
   &if '{&BF_MAT_VERSAO_EMS}' >= "2.071" &then
     WHERE proc-it-nota-fisc.cod-estabel  = wt-docto.cod-estab-proces-export
   &else
     WHERE proc-it-nota-fisc.cod-estabel  = substring(wt-docto.char-1,118,3)
   &endif
     AND proc-it-nota-fisc.nr-proc-exp  = wt-docto.nr-proc-exp
     AND proc-it-nota-fisc.nome-abrev   = {1}.nome-abrev 
     AND proc-it-nota-fisc.nr-pedcli    = {1}.nr-pedcli
     AND proc-it-nota-fisc.nr-sequencia = {1}.nr-sequencia
     AND proc-it-nota-fisc.it-codigo    = {1}.it-codigo
     AND proc-it-nota-fisc.cod-refer    = {1}.cod-refer
     AND proc-it-nota-fisc.nr-entrega   = {1}.nr-entrega:
    
    /*Nota Cancelada*/
    IF  CAN-FIND(FIRST nota-fiscal
                   WHERE nota-fiscal.cod-estabel = proc-it-nota-fisc.cod-estab-faturam
                   AND nota-fiscal.serie       = proc-it-nota-fisc.serie
                   AND nota-fiscal.nr-nota-fis = proc-it-nota-fisc.nr-nota-fis
                   AND nota-fiscal.dt-cancela <> ?) THEN
        NEXT.

    /*Nota Devolvida*/
    IF  CAN-FIND(FIRST proc-nota-fiscal
                 WHERE proc-nota-fiscal.cod-estabel = proc-it-nota-fisc.cod-estab-faturam
                   AND proc-nota-fiscal.nr-proc-exp = proc-it-nota-fisc.nr-proc-exp
                   AND proc-nota-fiscal.serie       = proc-it-nota-fisc.serie
                   AND proc-nota-fiscal.nr-nota-fis = proc-it-nota-fisc.nr-nota-fis
                   AND proc-nota-fiscal.log-nf-devolvid) THEN
        NEXT.

    /*Quantidade Faturada*/
    for first it-nota-fisc fields(qt-faturada[1]) NO-LOCK
         WHERE it-nota-fisc.cod-estabel  = proc-it-nota-fisc.cod-estab-faturam
         AND it-nota-fisc.serie        = proc-it-nota-fisc.serie
         AND it-nota-fisc.nr-nota-fis  = proc-it-nota-fisc.nr-nota-fis
         AND it-nota-fisc.nr-seq-fat   = proc-it-nota-fisc.nr-seq-fat
         AND it-nota-fisc.it-codigo    = proc-it-nota-fisc.it-codigo:
        
        ASSIGN de-tot-qt-faturada = de-tot-qt-faturada
                                  + it-nota-fisc.qt-faturada[1].
    END.

    /*Despesa Faturada*/
    for first proc-it-nota-desp fields(val-despes) no-lock where
              proc-it-nota-desp.cod-estabel = proc-it-nota-fisc.cod-estabel and
              proc-it-nota-desp.nr-proc-exp = proc-it-nota-fisc.nr-proc-exp and
              proc-it-nota-desp.serie       = proc-it-nota-fisc.serie       and
              proc-it-nota-desp.cod-estab-faturam = proc-it-nota-fisc.cod-estab-faturam and
              proc-it-nota-desp.nr-nota-fis = proc-it-nota-fisc.nr-nota-fis and
              proc-it-nota-desp.nr-seq-fat  = proc-it-nota-fisc.nr-seq-fat  and
              proc-it-nota-desp.it-codigo   = proc-it-nota-fisc.it-codigo   and
              proc-it-nota-desp.cdn-despes  = {1}.cdn-despes:
        ASSIGN de-tot-vl-faturada = de-tot-vl-faturada
                                  + proc-it-nota-desp.val-despes.
    end.
END.
