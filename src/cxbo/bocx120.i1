procedure findCodigo:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter i-cod-itiner as inte no-undo.
    def input parameter i-sequencia as inte no-undo.
    def output parameter c-return as char no-undo.

    find pto-itiner where
        pto-itiner.cod-itiner = i-cod-itiner
        and pto-itiner.sequencia = i-sequencia
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex pto-itiner 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.

procedure findCodpto:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    def input parameter i-cod-pto-contr as inte no-undo.
    def output parameter table for RowObject.

    find pto-contr where pto-contr.cod-pto-contr = i-cod-pto-contr no-lock no-error.
    if not avail pto-contr then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex pto-itiner 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
    end.
    else do:
       run setCurrent.
    end.
end procedure.

procedure findCoditiner:
        /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    def input parameter i-cod-itiner as inte no-undo.
    def output parameter c-return as char.

    find itinerario where itinerario.cod-itiner = i-cod-itiner no-lock no-error.
    if not avail itinerario then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex pto-itiner 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
end procedure.

procedure findItiner_pto:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter i-cod-itiner as inte no-undo.
    def input parameter i-cod-pto-contr as inte no-undo.
    def output parameter c-return as char no-undo.

    find pto-itiner where
        pto-itiner.cod-itiner = i-cod-itiner
        and pto-itiner.cod-pto-contr = i-cod-pto-contr
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex pto-itiner 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.

procedure executeCreate:
    /*
    **  Cria registro na tabela.
    */
    
    def var c-rowid-pto-itiner as char format "x(20)" no-undo.
    
    def input parameter l-embarque    as logical.
    def input parameter l-desembarque as logical.
    def input parameter l-despacho    as logical.
    def input parameter l-chegada     as logical.
    def input parameter l-eadi        as logical.    
    def input parameter l-recebimento as logical.    
    
    create {&TABLE-NAME}.
    buffer-copy RowObject except r-rowid to {&TABLE-NAME}.
    
    find itinerario where itinerario.cod-itiner = {&table-name}.cod-itiner exclusive-lock no-error.
    if avail itinerario then do:
        if  l-embarque then
            assign itinerario.pto-embarque = {&table-name}.cod-pto-contr.
        if  l-desembarque then
            assign itinerario.pto-desembarque = {&table-name}.cod-pto-contr.
        if  l-despacho then
            assign itinerario.pto-despacho = {&table-name}.cod-pto-contr.
        if  l-chegada then
            assign itinerario.pto-chegada = {&table-name}.cod-pto-contr.
        if  l-eadi then
            assign itinerario.int-1 = {&table-name}.cod-pto-contr.            
        if  l-recebimento then
            assign overlay(itinerario.char-1,1,5) = string({&table-name}.cod-pto-contr).
        /* Licenciamento Importacao */
        &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
        if  l-solicita-li then
            assign itinerario.cdn-pto-solic-licenciam-import = {&table-name}.cod-pto-contr.
        &endif
    end.
    
    assign c-rowid-pto-itiner = string(rowid({&TABLE-NAME})).
    release {&table-name}.
    run cxbo/bocx115.p persistent set h-bocx115.
    run atualizarDiasDistanciaitinerario in h-bocx115 (input rowObject.cod-itiner,
                                                       input rowObject.cod-pto-contr,
                                                       input "add",
                                                       input 0,
                                                       input 0).
    delete procedure h-bocx115.

    return (c-rowid-pto-itiner).
end procedure.

procedure executeUpdate:
    /*
    **  Executa Update
    */
    def var i-old-nr-dias   like pto-itiner.nr-dias no-undo.
    def var i-old-distancia like pto-itiner.distancia no-undo.
    
    assign i-old-nr-dias   = {&TABLE-NAME}.nr-dias
           i-old-distancia = {&TABLE-NAME}.distancia.
           
    buffer-copy RowObject except r-rowid cod-itiner sequencia cod-pto-contr to {&TABLE-NAME}.
    
    run cxbo/bocx115.p persistent set h-bocx115.
    
    run atualizarDiasDistanciaitinerario in h-bocx115 (input rowObject.cod-itiner,
                                                       input rowObject.cod-pto-contr,
                                                       input "mod",
                                                       input i-old-nr-dias,
                                                       input i-old-distancia).
    delete procedure h-bocx115.

end procedure.

procedure initializeValidate:
    /*
    **  Inicializa Validate
    */

    run startMethod ("initializeValidade").

    run endMethod   ("initializeValidade").
end procedure.

procedure validateUpdate:
    /*
    **  Valida Update
    */
    run startmethod ("ValidateUpdate").

    def input         parameter table          for RowObject.
    def input-output  parameter r-chave        as rowid no-undo.        
    def input         parameter l-embarque     as logical no-undo.
    def input         parameter l-desembarque  as logical no-undo.
    def input         parameter l-despacho     as logical no-undo.
    def input         parameter l-chegada      as logical no-undo.
    def input         parameter l-eadi         as logical no-undo.
    def input         parameter l-recebimento  as logical no-undo.
    def output        parameter r-chave-iti    as rowid no-undo.
    def output        parameter table          for tt-bo-erro.
    
    def var c-return          as char no-undo.
    def var i-seq-despacho    as integer no-undo.
    def var i-seq-embarque    as integer no-undo.
    def var i-seq-desembarque as integer no-undo.
    def var i-seq-chegada     as integer no-undo.        
    def var i-seq-recebimento as integer no-undo.

    run InitializeValidate.

    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    
    find first rowObject no-lock no-error.
    
    run validateFields.
    
    if not can-find(first tt-bo-erro) then do:    
        find itinerario where itinerario.cod-itiner = rowObject.cod-itiner no-lock no-error.         
        if avail itinerario then do:
                
            find pto-itiner where pto-itiner.cod-itiner = itinerario.cod-itiner and
                                  pto-itiner.cod-pto-contr = itinerario.pto-despacho no-lock no-error.
            if avail pto-itiner then
                assign i-seq-despacho = pto-itiner.sequencia.
            find pto-itiner where pto-itiner.cod-itiner = itinerario.cod-itiner and
                                  pto-itiner.cod-pto-contr = itinerario.pto-embarque no-lock no-error.
            if avail pto-itiner then
                assign i-seq-embarque = pto-itiner.sequencia.
            find pto-itiner where pto-itiner.cod-itiner = itinerario.cod-itiner and
                                  pto-itiner.cod-pto-contr = itinerario.pto-desembarque no-lock no-error.
            if avail pto-itiner then
                assign i-seq-desembarque = pto-itiner.sequencia.     
            find pto-itiner where pto-itiner.cod-itiner = itinerario.cod-itiner and
                                  pto-itiner.cod-pto-contr = int(substring(itinerario.char-1,1,5)) no-lock no-error.
            if avail pto-itiner then
               assign i-seq-recebimento = pto-itiner.sequencia.
            find pto-itiner where pto-itiner.cod-itiner = itinerario.cod-itiner and
                                  pto-itiner.cod-pto-contr = itinerario.pto-chegada no-lock no-error.
            if avail pto-itiner then
                assign i-seq-chegada = pto-itiner.sequencia.                
        
            if l-despacho then do:                
                if itinerario.pto-despacho <> 0 and
                   itinerario.pto-despacho <> rowObject.cod-pto-contr then do:
                    assign i-seq-erro = i-seq-erro + 1.
                    /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                       pre-processador em chamada de includes */
                    {utp/ut-field.i mgcex itinerario pto-despacho 1}
                    /******************************************/
                    run utp/ut-msgs.p (input "msg",
                                       input  18255,
                                       input return-value).
                    create tt-bo-erro.
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 18255
                           tt-bo-erro.mensagem     = return-value.
                end.
                if l-desembarque then do:
                    assign i-seq-erro = i-seq-erro + 1.
                    run utp/ut-msgs.p (input "msg",
                                       input 17792,
                                       input "").
                    create tt-bo-erro.
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 17792
                           tt-bo-erro.mensagem     = return-value.                
                end.                            
                if l-chegada then do:
                    assign i-seq-erro = i-seq-erro + 1.
                    run utp/ut-msgs.p (input "msg",
                                       input 17794,
                                       input "").
                    create tt-bo-erro.
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 17794
                           tt-bo-erro.mensagem     = return-value.                
                end.                
                if (rowObject.sequencia > i-seq-embarque and i-seq-embarque <> 0) or
                   (rowObject.sequencia > i-seq-desembarque and i-seq-desembarque <> 0) or 
                   (rowObject.sequencia > i-seq-recebimento and i-seq-recebimento <> 0) or
                   (rowObject.sequencia > i-seq-chegada and i-seq-chegada <> 0) then do:
                    assign i-seq-erro = i-seq-erro + 1.
                    run utp/ut-msgs.p (input "msg",
                                       input 2108,
                                       input "").
                    create tt-bo-erro.
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 2108
                           tt-bo-erro.mensagem     = return-value.
                end.
            end.
            if not can-find(first tt-bo-erro) then do:
                if l-embarque then do:
                    if itinerario.pto-embarque <> 0 and
                       itinerario.pto-embarque <> rowObject.cod-pto-contr then do:            
                        assign i-seq-erro = i-seq-erro + 1.
                        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                           pre-processador em chamada de includes */
                        {utp/ut-field.i mgcex itinerario pto-embarque 1}
                        /******************************************/
                        run utp/ut-msgs.p (input "msg",
                                           input 18255,
                                           input return-value).
                        create tt-bo-erro.
                        assign tt-bo-erro.i-sequen     = i-seq-erro
                               tt-bo-erro.cd-erro      = 18255
                               tt-bo-erro.mensagem     = return-value.
                    end.
                    if l-desembarque then do:
                        assign i-seq-erro = i-seq-erro + 1.
                        run utp/ut-msgs.p (input "msg",
                                           input 17795,
                                           input "").
                        create tt-bo-erro.
                        assign tt-bo-erro.i-sequen     = i-seq-erro
                               tt-bo-erro.cd-erro      = 17795
                               tt-bo-erro.mensagem     = return-value.
                    end.                                      
                    if l-chegada then do:
                        assign i-seq-erro = i-seq-erro + 1.
                        run utp/ut-msgs.p (input "msg",
                                           input 17793,
                                           input "").
                        create tt-bo-erro.
                        assign tt-bo-erro.i-sequen     = i-seq-erro
                               tt-bo-erro.cd-erro      = 17793
                               tt-bo-erro.mensagem     = return-value.
                    end.            
                    if (rowObject.sequencia < i-seq-despacho and i-seq-despacho <> 0) or
                       (rowObject.sequencia > i-seq-desembarque and i-seq-desembarque <> 0) or 
                       (rowObject.sequencia > i-seq-recebimento and i-seq-recebimento <> 0) or 
                       (rowObject.sequencia > i-seq-chegada and i-seq-chegada <> 0) then do:
                        assign i-seq-erro = i-seq-erro + 1.
                        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                           pre-processador em chamada de includes */ 
                        {utp/ut-field.i mgcex itinerario pto-embarque 1}
                        /******************************************/
                        run utp/ut-msgs.p (input "msg",
                                           input 2108,
                                           input return-value).
                        create tt-bo-erro.
                        assign tt-bo-erro.i-sequen     = i-seq-erro
                               tt-bo-erro.cd-erro      = 2108
                               tt-bo-erro.mensagem     = return-value.
                    end.                
                end.
            end.
            if not can-find(first tt-bo-erro) then do:                
                if l-desembarque then do:
                    if itinerario.pto-desembarque <> 0 and 
                       itinerario.pto-desembarque <> rowobject.cod-pto-contr then do:
                        assign i-seq-erro = i-seq-erro + 1.
                        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                           pre-processador em chamada de includes */
                        {utp/ut-field.i mgcex itinerario pto-desembarque 1}
                        /******************************************/
                        run utp/ut-msgs.p (input "msg",
                                           input 18255,
                                           input return-value).
                        create tt-bo-erro.
                        assign tt-bo-erro.i-sequen     = i-seq-erro
                               tt-bo-erro.cd-erro      = 18255
                               tt-bo-erro.mensagem     = return-value.
                    end.    
                    if l-embarque then do:
                        assign i-seq-erro = i-seq-erro + 1.
                        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                           pre-processador em chamada de includes */
                        {utp/ut-field.i mgcex itinerario pto-embarque 1}
                        /******************************************/
                        run utp/ut-msgs.p (input "msg",
                                           input  17795,
                                           input return-value).
                        create tt-bo-erro.
                        assign tt-bo-erro.i-sequen     = i-seq-erro
                               tt-bo-erro.cd-erro      = 17795
                               tt-bo-erro.mensagem     = return-value.                
                    end.
                    if l-despacho then do:
                        assign i-seq-erro = i-seq-erro + 1.
                        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                           pre-processador em chamada de includes */
                        {utp/ut-field.i mgcex itinerario pto-despacho 1}
                        /******************************************/
                        run utp/ut-msgs.p (input "msg",
                                           input  17792,
                                           input return-value).
                        create tt-bo-erro.
                        assign tt-bo-erro.i-sequen     = i-seq-erro
                               tt-bo-erro.cd-erro      = 17792
                               tt-bo-erro.mensagem     = return-value.
                    end.
                    if (rowObject.sequencia < i-seq-despacho and i-seq-despacho <> 0) or
                       (rowObject.sequencia < i-seq-embarque and i-seq-embarque <> 0) or 
                       (rowObject.sequencia > i-seq-recebimento and i-seq-recebimento <> 0) or 
                       (rowObject.sequencia > i-seq-chegada and i-seq-chegada <> 0) then do:
                        assign i-seq-erro = i-seq-erro + 1.
                        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                           pre-processador em chamada de includes */
                        {utp/ut-field.i mgcex itinerario pto-embarque 1}
                        /******************************************/
                        run utp/ut-msgs.p (input "msg",
                                           input 2108,
                                           input return-value).
                        create tt-bo-erro.
                        assign tt-bo-erro.i-sequen     = i-seq-erro
                               tt-bo-erro.cd-erro      = 2108
                               tt-bo-erro.mensagem     = return-value.
                    end.                
                end.
            end.
            if not can-find(first tt-bo-erro) then do:
               if l-recebimento then do:
                  if  trim(substring(itinerario.char-1,1,5)) <> ""
                  and trim(substring(itinerario.char-1,1,5)) <> string(rowobject.cod-pto-contr) 
                  and l-recebimento then do:
        
                      assign i-seq-erro = i-seq-erro + 1.
                      {utp/ut-liter.i Ponto_Recebimento * r}
                      assign c-return = return-value.
                      create tt-bo-erro.
                      assign tt-bo-erro.parametros = c-return.
                      run utp/ut-msgs.p (input "msg",
                                         input  18255,
                                         input return-value).
                      assign tt-bo-erro.i-sequen     = i-seq-erro
                             tt-bo-erro.cd-erro      = 18255
                             tt-bo-erro.mensagem     = return-value.
                  end.
                  if l-despacho then do:
                      assign i-seq-erro = i-seq-erro + 1.
                      /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                         pre-processador em chamada de includes */
                      {utp/ut-liter.i Recebimento * r}
                      assign c-literal = trim(return-value).
                      {utp/ut-field.i mgcex itinerario pto-despacho 1}
                      /******************************************/
                      run utp/ut-msgs.p (input "msg",
                                         input  55333,
                                         input c-literal + "~~" + return-value).
                      create tt-bo-erro.
                      assign tt-bo-erro.i-sequen     = i-seq-erro
                             tt-bo-erro.cd-erro      = 55333
                             tt-bo-erro.mensagem     = return-value.
                  end.
                  if l-embarque then do:
                      assign i-seq-erro = i-seq-erro + 1.
                      /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                         pre-processador em chamada de includes */
                      {utp/ut-liter.i Recebimento * r}
                      assign c-literal = trim(return-value).
                      {utp/ut-field.i mgcex itinerario pto-embarque 1}
                      /******************************************/
                      run utp/ut-msgs.p (input "msg",
                                         input  55333,
                                         input c-literal + "~~" + return-value).
                      create tt-bo-erro.
                      assign tt-bo-erro.i-sequen     = i-seq-erro
                             tt-bo-erro.cd-erro      = 55333
                             tt-bo-erro.mensagem     = return-value.                
                  end.
                  if l-desembarque then do:
                      assign i-seq-erro = i-seq-erro + 1.
                      /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                         pre-processador em chamada de includes */
                      {utp/ut-liter.i Recebimento * r}
                      assign c-literal = trim(return-value).
                      {utp/ut-field.i mgcex itinerario pto-desembarque 1}
                      /******************************************/
                      run utp/ut-msgs.p (input "msg",
                                         input  55333,
                                         input c-literal + "~~" + return-value).
                      create tt-bo-erro.
                      assign tt-bo-erro.i-sequen     = i-seq-erro
                             tt-bo-erro.cd-erro      = 55333
                             tt-bo-erro.mensagem     = return-value.
                  end.
                  
                  if (rowObject.sequencia < i-seq-despacho and i-seq-despacho <> 0) or
                     (rowObject.sequencia < i-seq-embarque and i-seq-embarque <> 0) or 
                     (rowObject.sequencia < i-seq-desembarque and i-seq-desembarque <> 0) or 
                     (rowObject.sequencia > i-seq-chegada and i-seq-chegada <> 0) then do:
                      assign i-seq-erro = i-seq-erro + 1.
                      /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                         pre-processador em chamada de includes */
                      {utp/ut-liter.i Ponto_Recebimento * r}
                      /******************************************/
                      run utp/ut-msgs.p (input "msg",
                                         input 2108,
                                         input return-value).
                      create tt-bo-erro.
                      assign tt-bo-erro.i-sequen     = i-seq-erro
                             tt-bo-erro.cd-erro      = 2108
                             tt-bo-erro.mensagem     = return-value.
                  end.
               end.
            end.
            if not can-find(first tt-bo-erro) then do:                
                if l-chegada then do:
                    if itinerario.pto-chegada <> 0 and 
                       itinerario.pto-chegada <> rowobject.cod-pto-contr then do:
                        assign i-seq-erro = i-seq-erro + 1.
                        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                           pre-processador em chamada de includes */
                        {utp/ut-field.i mgcex itinerario pto-chegada 1}
                        /******************************************/
                        run utp/ut-msgs.p (input "msg",
                                           input 18255,
                                           input return-value).
                        create tt-bo-erro.
                        assign tt-bo-erro.i-sequen     = i-seq-erro
                               tt-bo-erro.cd-erro      = 18255
                               tt-bo-erro.mensagem     = return-value.
                    end.
                    if l-embarque then do:
                        assign i-seq-erro = i-seq-erro + 1.
                        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                           pre-processador em chamada de includes */
                        {utp/ut-field.i mgcex itinerario pto-embarque 1}
                        /******************************************/
                        run utp/ut-msgs.p (input "msg",
                                           input 17793,
                                           input "").
                        create tt-bo-erro.
                        assign tt-bo-erro.i-sequen     = i-seq-erro
                               tt-bo-erro.cd-erro      = 17793
                               tt-bo-erro.mensagem     = return-value.                
                    end.
                    if l-despacho then do:
                        assign i-seq-erro = i-seq-erro + 1.
                        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                           pre-processador em chamada de includes */
                        {utp/ut-field.i mgcex itinerario pto-despacho 1}
                        /******************************************/
                        run utp/ut-msgs.p (input "msg",
                                           input 17794,
                                           input "").
                        create tt-bo-erro.
                        assign tt-bo-erro.i-sequen     = i-seq-erro
                               tt-bo-erro.cd-erro      = 17794
                               tt-bo-erro.mensagem     = return-value.
                    end.
                    if (rowObject.sequencia < i-seq-embarque and i-seq-embarque <> 0) or
                       (rowObject.sequencia < i-seq-desembarque and i-seq-desembarque <> 0) or 
                       (rowObject.sequencia < i-seq-recebimento and i-seq-recebimento <> 0) or 
                       (rowObject.sequencia < i-seq-despacho and i-seq-despacho <> 0) then do:
                        assign i-seq-erro = i-seq-erro + 1.
                        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                           pre-processador em chamada de includes */
                        {utp/ut-field.i mgcex itinerario pto-embarque 1}
                        /******************************************/
                        run utp/ut-msgs.p (input "msg",
                                           input 2108,
                                           input return-value).
                        create tt-bo-erro.
                        assign tt-bo-erro.i-sequen     = i-seq-erro
                               tt-bo-erro.cd-erro      = 2108
                               tt-bo-erro.mensagem     = return-value.
                    end.                
                end.
            end.                
            if  not can-find(first tt-bo-erro) then do:
                if  itinerario.int-1 <> 0
                and itinerario.int-1 <> rowobject.cod-pto-contr 
                and l-eadi then do:

                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-liter.i Ponto_EADI * r}
                    assign c-return = return-value.
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = c-return.
                    run utp/ut-msgs.p (input "msg",
                                       input  18255,
                                       input return-value).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 18255
                           tt-bo-erro.mensagem     = return-value.
                end.
                
                if  trim(substring(itinerario.char-1,1,5)) <> ""
                and trim(substring(itinerario.char-1,1,5)) <> string(rowobject.cod-pto-contr) 
                and l-recebimento then do:

                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-liter.i Ponto_Recebimento * r}
                    assign c-return = return-value.
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = c-return.
                    run utp/ut-msgs.p (input "msg",
                                       input  18255,
                                       input return-value).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 18255
                           tt-bo-erro.mensagem     = return-value.
                end.
                
                /* Licencimento Importacao */
                &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
                if  itinerario.cdn-pto-solic-licenciam-import <> 0
                and itinerario.cdn-pto-solic-licenciam-import <> rowobject.cod-pto-contr 
                and l-solicita-li then do:

                    {utp/ut-liter.i Ponto_Solicita_LI_ * r}
                    
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value.

                    run utp/ut-msgs.p (input "msg",
                                       input  18255,
                                       input tt-bo-erro.parametros).

                    assign i-seq-erro           = i-seq-erro + 1
                           tt-bo-erro.i-sequen  = i-seq-erro
                           tt-bo-erro.cd-erro   = 18255
                           tt-bo-erro.mensagem  = return-value.
                end.                
                &endif
            end.
        end.    

        if not can-find(first tt-bo-erro) then do:
            find itinerario exclusive-lock 
                where itinerario.cod-itiner = rowObject.cod-itiner no-error no-wait.
            if avail itinerario and not locked(itinerario) then do:    
                if l-despacho then
                    assign itinerario.pto-despacho = rowObject.cod-pto-contr.
                else
                    if not l-despacho and itinerario.pto-despacho = rowobject.cod-pto-contr then 
                        assign itinerario.pto-despacho = 0.
                    
                if l-embarque then
                    assign itinerario.pto-embarque = rowObject.cod-pto-contr.
                else
                    if not l-embarque and itinerario.pto-embarque = rowobject.cod-pto-contr then 
                        assign itinerario.pto-embarque = 0.
                    
                if l-desembarque then
                    assign itinerario.pto-desembarque = rowObject.cod-pto-contr.
                else
                    if not l-desembarque and itinerario.pto-desembarque = rowobject.cod-pto-contr then 
                        assign itinerario.pto-desembarque = 0. 
              
                if l-chegada then
                    assign itinerario.pto-chegada = rowObject.cod-pto-contr.
                else
                   if not l-chegada and itinerario.pto-chegada = rowobject.cod-pto-contr then 
                      assign itinerario.pto-chegada = 0.
                if l-eadi then 
                    assign itinerario.int-1 = rowObject.cod-pto-contr.
                else if not l-eadi and itinerario.int-1 = rowobject.cod-pto-contr then 
                          assign itinerario.int-1 = 0.
                          
                if l-recebimento then
                    assign overlay(itinerario.char-1,1,5) = string(rowobject.cod-pto-contr).
                else if not l-recebimento and substring(itinerario.char-1,1,5) = string(rowobject.cod-pto-contr) then
                    assign overlay(itinerario.char-1,1,5) = "".

                /* Licenciamento Importacao*/
                &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
                
                if  l-solicita-li then 
                    assign itinerario.cdn-pto-solic-licenciam-import = rowObject.cod-pto-contr.
                else 
                    if  not l-solicita-li
                    and itinerario.cdn-pto-solic-licenciam-import = rowobject.cod-pto-contr then 
                        assign itinerario.cdn-pto-solic-licenciam-import = 0.
                &endif
            end.
                        
            find {&TABLE-NAME} exclusive-lock
                where rowid({&TABLE-NAME}) = r-chave  no-error.
            if avail {&TABLE-NAME} then
                run executeUpdate.
        end.
    end.    

    run endmethod ("ValidateUpdate").  

end procedure.

procedure validateFields:
    /*
    **  Valida Fields
    */
    run startMethod ("validateFields").

    if rowObject.cod-itiner = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex pto-itiner cod-itiner 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.

    if rowObject.cod-pto-contr = ? or rowObject.cod-pto-contr = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex pto-itiner cod-pto-contr 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.

    if rowObject.distancia = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex pto-itiner distancia 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.

    if rowObject.nr-dias = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex pto-itiner nr-dias 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.

    if rowObject.sequencia = ? or rowObject.sequencia = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex pto-itiner sequencia 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    
    run endmethod("ValidateFields").

end procedure.

procedure validateDelete:
    /*
    **  Valida Delete
    */
    run startmethod ("ValidateDelete").

    def input-output parameter r-chave as rowid.
    def output parameter table for tt-bo-erro.

    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

    run InitializeValidate.

    find {&TABLE-NAME} exclusive-lock
         where rowid({&TABLE-NAME}) = r-chave no-error no-wait.
    if locked({&table-name}) then do:
        run utp/ut-msgs.p (input "msg",
                           input 16096,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 16096
               tt-bo-erro.mensagem     = return-value.
    end.
    find first tt-bo-erro no-error.
    if not avail tt-bo-erro then do:
        if avail {&table-name} then do:
            for each incoterm-itiner exclusive-lock of {&TABLE-NAME}:
                delete incoterm-itiner.
            end.
            for each desp-itiner exclusive-lock of {&TABLE-NAME}:
                delete desp-itiner.
            end.
            for each decl-itiner exclusive-lock of {&TABLE-NAME}:
                delete decl-itiner.
            end.
            find itinerario exclusive-lock
                where itinerario.cod-itiner = {&table-name}.cod-itiner no-error.
            if avail itinerario then do:
                if itinerario.pto-embarque = {&table-name}.cod-pto-contr then
                    assign itinerario.pto-embarque = 0.
                if itinerario.pto-desembarque = {&table-name}.cod-pto-contr then
                    assign itinerario.pto-desembarque = 0.
                if itinerario.pto-chegada = {&table-name}.cod-pto-contr then
                    assign itinerario.pto-chegada = 0.
                if itinerario.pto-despacho = {&table-name}.cod-pto-contr then
                    assign itinerario.pto-despacho = 0.
                if itinerario.int-1 = {&table-name}.cod-pto-contr then
                    assign itinerario.int-1 = 0.
                if trim(substring(itinerario.char-1,1,5)) = string({&table-name}.cod-pto-contr) then
                    assign overlay(itinerario.char-1,1,5) = "".
                 /* Licenciamento Importacao*/
                &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
                
                if  itinerario.cdn-pto-solic-licenciam-import = {&table-name}.cod-pto-contr then
                    assign itinerario.cdn-pto-solic-licenciam-import = 0.

                &endif
            end.
            
            run cxbo/bocx115.p persistent set h-bocx115.
            run atualizarDiasDistanciaitinerario in h-bocx115 (input {&TABLE-NAME}.cod-itiner,
                                                               input {&TABLE-NAME}.cod-pto-contr,
                                                               input "del",
                                                               input 0,
                                                               input 0).
            delete procedure h-bocx115.            
            run executeDelete.
        end.

        find next {&TABLE-NAME}
            no-lock no-error.
        if not avail {&TABLE-NAME} then
            find prev {&TABLE-NAME} no-lock no-error.

        assign r-chave = rowid({&TABLE-NAME}).
        return "".
    end.
    run endmethod ("ValidateDelete").

end procedure.

procedure validateCreate:
    /*
    **  Valida cria‡Æo da tabela/duplicidade de registro.
    */
    run startMethod ("validateCreate").

    def input  parameter table         for RowObject.
    def output parameter table         for tt-bo-erro.
    def input  parameter l-embarque    as logical.
    def input  parameter l-desembarque as logical.
    def input  parameter l-despacho    as logical.
    def input  parameter l-chegada     as logical.
    def input  parameter l-eadi        as logical.
    def input  parameter l-recebimento as logical.
    def output parameter r-chave       as rowid.
    def input  parameter r-chave-pai   as rowid no-undo.
    def input  parameter l-copia       as logical.
    def var    c-return                as char no-undo.

    define buffer bf-pto-itiner for pto-itiner.
    
    run initializeValidate.

    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

    find first rowObject no-lock no-error.
    run validateFields .

    find itinerario no-lock
         where itinerario.cod-itiner = rowObject.cod-itiner no-error.
    if not avail itinerario then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex itinerario 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 2
               tt-bo-erro.mensagem     = return-value.
    end.

    find pto-contr no-lock
        where pto-contr.cod-pto-contr = rowObject.cod-pto-contr no-error.
    if not avail pto-contr then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex pto-contr 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 2
               tt-bo-erro.mensagem     = return-value.
    end.

    find itinerario no-lock where
        itinerario.cod-itiner = rowObject.cod-itiner no-error.
    if avail itinerario then do:
        if (itinerario.pto-despacho  = rowObject.cod-pto-contr and
            rowObject.cod-pto-contr <> 0                       and
            l-chegada) or
            (l-despacho and l-chegada) then do:
                assign i-seq-erro = i-seq-erro + 1.
                run utp/ut-msgs.p (input "msg",
                                   input 17794,
                                   input "").
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 17794
                       tt-bo-erro.mensagem     = return-value.
        end. /* if (itinerario ... */
           
        if itinerario.pto-despacho <> 0 and 
            itinerario.pto-despacho <> rowobject.cod-pto-contr and
            l-despacho then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-field.i mgcex itinerario pto-despacho 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input  18255,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 18255
                   tt-bo-erro.mensagem     = return-value.
        end.
       
        if (itinerario.pto-despacho  = rowObject.cod-pto-contr and
            rowObject.cod-pto-contr <> 0                       and
            l-desembarque) or
            (l-despacho and l-desembarque) then do:
            assign i-seq-erro = i-seq-erro + 1.
            run utp/ut-msgs.p (input "msg",
                               input 17792,
                               input "").
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 17792
                   tt-bo-erro.mensagem     = return-value.
        end. /* if (itinerario ... */

        if (itinerario.pto-embarque  = rowObject.cod-pto-contr and
            rowObject.cod-pto-contr <> 0                       and
            l-chegada) or
           (l-embarque and l-chegada) then do:
            assign i-seq-erro = i-seq-erro + 1.
            run utp/ut-msgs.p (input "msg",
                               input 17793,
                               input "").
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 17793
                   tt-bo-erro.mensagem     = return-value.
        end. /* if (itinerario ... */

        if itinerario.pto-embarque <> 0 and 
           itinerario.pto-embarque <> rowobject.cod-pto-contr and
           l-embarque then do:
           assign i-seq-erro = i-seq-erro + 1.
           /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
              pre-processador em chamada de includes */
           {utp/ut-field.i mgcex itinerario pto-embarque 1}
           /******************************************/
           run utp/ut-msgs.p (input "msg",
                              input 18255,
                              input return-value).
           create tt-bo-erro.
           assign tt-bo-erro.i-sequen     = i-seq-erro
                  tt-bo-erro.cd-erro      = 18255
                  tt-bo-erro.mensagem     = return-value.
        end.

        if (itinerario.pto-embarque  = rowObject.cod-pto-contr and
            rowObject.cod-pto-contr <> 0                       and
            l-desembarque) or
            (l-embarque and l-desembarque) then do:
            assign i-seq-erro = i-seq-erro + 1.
            run utp/ut-msgs.p (input "msg",
                               input 17795,
                               input "").
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 17795
                   tt-bo-erro.mensagem     = return-value.
        end. /* if (itinerario ... */

        if itinerario.pto-desembarque <> 0 and 
            itinerario.pto-desembarque <> rowobject.cod-pto-contr and 
            l-desembarque then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-field.i mgcex itinerario pto-desembarque 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 18255,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 18255
                   tt-bo-erro.mensagem     = return-value.
        end.

        if itinerario.pto-chegada <> 0 and 
            itinerario.pto-chegada <> rowobject.cod-pto-contr and
            l-chegada then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-field.i mgcex itinerario pto-chegada 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input  18255,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 18255
                   tt-bo-erro.mensagem     = return-value.
        end.

        if itinerario.int-1 <> 0 and 
            itinerario.int-1 <> rowobject.cod-pto-contr 
            and l-eadi then do:
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Ponto_EADI * r}
            assign c-return = return-value.
            run utp/ut-msgs.p (input "msg",
                               input  18255,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 18255
                   tt-bo-erro.mensagem     = return-value.
        end.
        
        if  trim(substring(itinerario.char-1,1,5)) <> "" and 
            trim(substring(itinerario.char-1,1,5)) <> string(rowobject.cod-pto-contr)
            and l-recebimento then do:
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Ponto_Recebimento * r}
            assign c-return = return-value.
            run utp/ut-msgs.p (input "msg",
                               input  18255,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 18255
                   tt-bo-erro.mensagem     = return-value.
        end.
        if l-recebimento then do:
            find first bf-pto-itiner 
                 where bf-pto-itiner.cod-itiner    = itinerario.cod-itiner
                   and bf-pto-itiner.cod-pto-contr = itinerario.pto-chegada no-lock no-error.
            
            if avail bf-pto-itiner then do:
                if rowobject.sequencia > bf-pto-itiner.sequencia then do:
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-liter.i Ponto_Recebimento * r}
                    assign c-return = return-value.
                    {utp/ut-liter.i Ponto_Chegada * r}                       /*andre*/

					create tt-bo-erro.
					tt-bo-erro.parametros   = c-return + "~~" + return-value.          
                    run utp/ut-msgs.p (input "msg",
                                       input  55793,
                                       input c-return + "~~" + return-value).					
                    
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 55793
                           tt-bo-erro.mensagem     = return-value.
						   
                end.
            end.
        end.

         if (trim(substring(itinerario.char-1,1,5))  = string(rowObject.cod-pto-contr) and
            rowObject.cod-pto-contr <> 0                       and
            l-recebimento) or
            (l-recebimento and l-despacho) or
            (l-recebimento and l-embarque) or
            (l-recebimento and l-desembarque) or
            (l-recebimento and l-chegada) then do:
            
            {utp/ut-liter.i Recebimento}
            assign c-literal = trim(return-value).
            if l-despacho then do:
               {utp/ut-liter.i Despacho * }
            end.
            if l-embarque then do:
               {utp/ut-liter.i Embarque * }
            end.
            if l-desembarque then do:
               {utp/ut-liter.i Nacionaliza‡Æo * }
            end.
            if l-chegada then do:
               {utp/ut-liter.i Chegada * }
            end.
            
            assign i-seq-erro = i-seq-erro + 1.
            run utp/ut-msgs.p (input "msg",
                               input 55333,
                               input c-literal + "~~" + return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 55333
                   tt-bo-erro.mensagem     = return-value.
        end. /* if (itinerario ... */

        /* Licenciamento Importacao */
        &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
        if  itinerario.cdn-pto-solic-licenciam-import <> 0
        and itinerario.cdn-pto-solic-licenciam-import <> rowObject.cod-pto-contr
        and l-solicita-li then do:

            {utp/ut-liter.i Ponto_Solicita_LI_ * r}

            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.

            run utp/ut-msgs.p (input "msg",
                               input  18255,
                               input tt-bo-erro.parametros).
            
            assign i-seq-erro          = i-seq-erro + 1
                   tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 18255
                   tt-bo-erro.mensagem = return-value.
        end.
        &endif
    end. /* if avail itinerario ... */

    find first {&TABLE-NAME} no-lock
         where {&TABLE-NAME}.cod-itiner = rowObject.cod-itiner
           and {&TABLE-NAME}.sequencia  = rowObject.sequencia
           and {&TABLE-NAME}.cod-pto-contr = rowObject.cod-pto-contr no-error.
    if not avail pto-itiner then do:
        find first {&TABLE-NAME} no-lock
            where {&TABLE-NAME}.cod-itiner = rowObject.cod-itiner
              and {&TABLE-NAME}.cod-pto-contr = rowObject.cod-pto-contr no-error.
        if avail {&TABLE-NAME} then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex pto-itiner 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 8,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 8
                   tt-bo-erro.mensagem     = return-value.
        end.         
    end.
    find first tt-bo-erro no-error.
    if not avail tt-bo-erro then do:
        RUN alterasequencia .
        run executeCreate (input l-embarque,
                           input l-desembarque,
                           input l-despacho,
                           input l-chegada,
                           input l-eadi,
                           input l-recebimento).
        assign r-chave = to-rowid(return-value).
    end.
    
/* 
 *    if l-embarque or l-desembarque then do:
 *        find itinerario where rowid(itinerario) = r-chave-pai no-lock no-error.
 *        if l-embarque and itinerario.pto-desembarque <> 0 then do:
 *             find pto-itiner where pto-itiner.cod-itiner = itinerario.cod-itiner and
 *                  pto-itiner.cod-pto-contr               = itinerario.pto-desembarque no-lock no-error.
 *             if avail pto-itiner and pto-itiner.sequencia < int(c-seq) then do:
 *                assign i-seq-erro = i-seq-erro + 1.
                  {utp/ut-liter.i Sequencia_embarque * r}
 *                assign c-return = return-value.
 *                {utp/ut-liter.i Sequencia_desembarque * r}
 *                 run utp/ut-msgs.p (input "msg",
 *                                   input 5820,
 *                                   input c-return + "~~" + return-value).
 *                create tt-bo-erro.
 *                assign tt-bo-erro.i-sequen = i-seq-erro
 *                       tt-bo-erro.cd-erro  = 5820
 *                       tt-bo-erro.mensagem = return-value.
 *             end.
 *        end.
 *     end.       */

  run endMethod ("validateCreate").

end procedure.

procedure SugereAutoNumber:

    def input  parameter p-cod-itiner like itinerario.cod-itiner no-undo.
    def output parameter i-auto-num as integer no-undo.

    find last {&TABLE-NAME} no-lock 
         where {&TABLE-NAME}.cod-itiner = p-cod-itiner no-error.
    if avail {&TABLE-NAME} then 
       assign i-auto-num = {&TABLE-NAME}.sequencia + 1.
       
end procedure.

procedure executeCopy:
/*
** Cria‡Æo das tabela Incoterm-itiner
*/
    if i-bo-query = 2 then do:
        def input parameter i-cod-itinerario as int   no-undo.
        def input parameter i-pto-contr      as int   no-undo.
        def input parameter r-chave-pai      as rowid no-undo.

        find {&table-name} where rowid({&table-name}) = r-chave-pai no-lock no-error.
        
        if avail {&table-name} then do:
            for each incoterm-itiner no-lock of {&table-name}:
                create tt-incoterm-itiner.
                assign tt-incoterm-itiner.cod-itiner    = i-cod-itinerario
                       tt-incoterm-itiner.cod-pto-contr = i-pto-contr.
                buffer-copy incoterm-itiner except incoterm-itiner.cod-itiner incoterm-itiner.cod-pto-contr  to tt-incoterm-itiner.
            end.
            for each desp-itiner no-lock of {&table-name}:
                create tt-desp-itiner.
                assign tt-desp-itiner.cod-itiner = i-cod-itinerario
                       tt-desp-itiner.cod-pto-contr = i-pto-contr.
                buffer-copy desp-itiner except desp-itiner.cod-itiner desp-itiner.cod-pto-contr to tt-desp-itiner.
            end.
        end.
        for each tt-incoterm-itiner:
            create incoterm-itiner.
            buffer-copy tt-incoterm-itiner to incoterm-itiner.
        end.
        for each tt-desp-itiner:
            create desp-itiner.
            buffer-copy tt-desp-itiner to desp-itiner.
        end.
    end.
    else
        return error.
        
end procedure.

procedure setalocais:
     def input  parameter r-chave       as rowid   no-undo.
     def output parameter l-eadi        as logical no-undo.
     def output parameter l-recebimento as logical no-undo.
     def output parameter c-local       as char    no-undo.

     assign l-eadi        = no
            &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
            l-solicita-li = no
            &endif
            l-recebimento = no.
     find pto-itiner where rowid(pto-itiner) = r-chave no-lock no-error.
     if  avail pto-itiner then do:

         find itinerario where itinerario.cod-itiner = pto-itiner.cod-itiner no-lock no-error.
         if  avail itinerario then do:

             if itinerario.pto-despacho = pto-itiner.cod-pto-contr and
                itinerario.pto-embarque = pto-itiner.cod-pto-contr then
                assign c-local = "Embarque/Despacho".
             else
             if itinerario.pto-despacho  = pto-itiner.cod-pto-contr and
                itinerario.pto-embarque <> pto-itiner.cod-pto-contr then
                assign c-local = "Despacho".
             else
             if itinerario.pto-embarque  = pto-itiner.cod-pto-contr and
                itinerario.pto-despacho <> pto-itiner.cod-pto-contr then
                assign c-local = "Embarque".
             else
             if itinerario.pto-desembarque = pto-itiner.cod-pto-contr and
                itinerario.pto-chegada     = pto-itiner.cod-pto-contr then
                assign c-local = "Desembarque/Chegada".
             else
             if itinerario.pto-desembarque  = pto-itiner.cod-pto-contr and
                itinerario.pto-chegada     <> pto-itiner.cod-pto-contr then
                assign c-local = "Desembarque".
             else
             if itinerario.pto-chegada      = pto-itiner.cod-pto-contr and
                itinerario.pto-desembarque <> pto-itiner.cod-pto-contr then
                assign c-local = "Chegada".

             if itinerario.int-1 = pto-itiner.cod-pto-contr then
                assign l-eadi = yes.
                
             if trim(substring(itinerario.char-1,1,5)) = string(pto-itiner.cod-pto-contr) then
                 assign l-recebimento = yes.

             /* Licenciamento Importacao */
             &if '{&bf_mat_versao_ems}':U >= '2.062':U &then
             if  itinerario.cdn-pto-solic-licenciam-import = pto-itiner.cod-pto-contr then
                 assign l-solicita-li = yes.
             &endif
         end.
     end.

end procedure.

procedure perguntaembarque:
    if i-bo-query = 2 then do:
        def input parameter l-embarque as logical.
        def input parameter r-chave-pai as rowid.
        def output parameter table for tt-bo-erro.

        for each tt-bo-erro:
            delete tt-bo-erro.
        end.

        find itinerario where rowid(itinerario) = r-chave-pai no-lock no-error.
        if avail itinerario then do:
           if itinerario.pto-embarque <> 0 and l-embarque = yes then do:
              /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                 pre-processador em chamada de includes */
              {utp/ut-field.i mgcex itinerario pto-embarque}
              /******************************************/
              run utp/ut-msgs.p (input "msg",
                                 input 17072,
                                 input return-value).
              create tt-bo-erro.
              assign tt-bo-erro.i-sequen     = i-seq-erro
                     tt-bo-erro.cd-erro      = 17072
                     tt-bo-erro.mensagem     = return-value.
           end.
        end.
    end.
    else
      return error.
end procedure.

procedure perguntadesembarque:
    if i-bo-query = 2 then do:
       def input parameter l-desembarque as logical.
       def input parameter r-chave-pai as rowid.
       def output parameter table for tt-bo-erro.

       for each tt-bo-erro:
           delete tt-bo-erro.
       end.

       find itinerario where rowid(itinerario) = r-chave-pai no-lock no-error.
       if avail itinerario then do:
          if itinerario.pto-desembarque <> 0 and l-desembarque = yes then do:
             /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                pre-processador em chamada de includes */
             {utp/ut-field.i mgcex itinerario pto-desembarque}
             /******************************************/
             run utp/ut-msgs.p (input "msg",
                                input 17072,
                                input return-value).
             create tt-bo-erro.
             assign tt-bo-erro.i-sequen     = i-seq-erro
                    tt-bo-erro.cd-erro      = 17072
                    tt-bo-erro.mensagem     = return-value.
          end.
       end.
    end.
    else return error.
end procedure.

procedure validatelocais:
    def input parameter l-embarque as logical.
    def input parameter l-desembarque as logical.
    def input parameter r-chave-pai as rowid.
    def output parameter table for tt-bo-erro.

    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

    find itinerario where rowid(itinerario) = r-chave-pai no-lock no-error.
    if avail itinerario and itinerario.pto-embarque = 0 and
             itinerario.pto-desembarque = 0 and l-embarque = no and
             l-desembarque = no then do:
       assign i-seq-erro = i-seq-erro + 1.
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-field.i mgcex itinerario pto-desembarque 1}
       /******************************************/
       run utp/ut-msgs.p (input "msg",
                          input 17081,
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen     = i-seq-erro
              tt-bo-erro.cd-erro      = 17081
              tt-bo-erro.mensagem     = return-value.
    end.
    
end procedure.

procedure alteraSequencia:
    def var l-seq as logical init yes no-undo.
    def var i-seq as integer no-undo.
    
    assign i-seq = rowObject.sequencia.
    for each tt-pto-itiner:
        delete tt-pto-itiner.
    end.   
    do while l-seq:
      if avail rowObject then do:
          find {&TABLE-NAME} where 
               {&TABLE-NAME}.cod-itiner  = rowObject.cod-itiner  and
               {&TABLE-NAME}.sequencia   = i-seq exclusive-lock no-error.
          if avail {&TABLE-NAME} then do:
             create tt-pto-itiner.         
             assign tt-pto-itiner.cod-itiner = {&TABLE-NAME}.cod-itiner
                    tt-pto-itiner.sequencia  = {&TABLE-NAME}.sequencia
                    tt-pto-itiner.cod-pto-contr = {&TABLE-NAME}.cod-pto-contr
                    tt-pto-itiner.r-rowid    = rowid({&TABLE-NAME})
                    i-seq = i-seq + 1.                 
          end.
          else assign l-seq = no.      
      end.      
    end. 
    for each tt-pto-itiner by tt-pto-itiner.sequencia desc:
       find {&TABLE-NAME} exclusive-lock
            where rowid({&TABLE-NAME}) = tt-pto-itiner.r-rowid  no-error.
       if avail {&TABLE-NAME} then do:
         assign {&TABLE-NAME}.sequencia = tt-pto-itiner.sequencia + 1.
       end.
    end.

end procedure.

procedure getCharField:
    define input  parameter c-field as char.
    define output parameter c-value as char.

    case c-field:
        when "char-1" then c-value = RowObject.char-1.
        when "char-2" then c-value = RowObject.char-2.
        when "check-sum" then c-value = RowObject.check-sum.
        otherwise return error.
    end case.
    return error.
end procedure.

procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.

    case c-field:
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        when "nr-dias" then c-value = RowObject.nr-dias.
        otherwise return error.
    end case.
end procedure.

procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.

    case c-field:
        when "cod-itiner" then c-value = RowObject.cod-itiner.
        when "cod-pto-contr" then c-value = RowObject.cod-pto-contr.
        when "distancia" then c-value = RowObject.distancia.
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.
        when "sequencia" then c-value = RowObject.sequencia.
        otherwise return error.
    end case.
end procedure.

procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.

    case c-field:
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.
        otherwise return error.
    end case.
end procedure.

procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.

    case c-field:
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.
        otherwise return error.
    end case.
end procedure.

procedure returnItinerario:
def input parameter p-rowid as rowid no-undo.
def output parameter p-itinerario as char no-undo.
def var h-bocx115 as handle no-undo.

run findRowid(input p-rowid).
run cxbo/bocx115.p persistent set h-bocx115.
run findCodigo in h-bocx115(input rowObject.cod-itiner,output c-return).
if c-return = "" then
    run getCharfield in h-bocx115(input "descricao",output p-itinerario).
delete procedure h-bocx115.        

end procedure.


procedure returnPto-contr:
def input parameter p-rowid as rowid no-undo.
def output parameter p-pto-contr as char no-undo.
def var h-bocx110 as handle no-undo.

run findRowid(input p-rowid).
run cxbo/bocx110.p persistent set h-bocx110.
run findCodigo in h-bocx110(input rowObject.cod-pto-contr,output c-return).
if c-return = "" then
    run getCharfield in h-bocx110(input "descricao",output p-pto-contr).
delete procedure h-bocx110.

end procedure.
procedure pi-calcula-entrega:
    /** Programa para calcular data de entrega atrav‚ do entervalo de embarque e 
        chegada do itinerario **/
    def input  parameter p-cod-itiner    like itinerario.cod-itiner no-undo.
    def input  parameter p-data-embarque as   date                  no-undo. 
    def output parameter p-data-entrega  as   date                  no-undo.
    
    def var              v-intervalo     like pto-itiner.nr-dias    no-undo.    
    
    assign v-intervalo = 0.
    
    find itinerario 
         where itinerario.cod-itiner = p-cod-itiner no-lock no-error.
    if not avail itinerario then do:
      return 'NOK'.                                       
    end.                 
    
    find first pto-itiner no-lock 
         where pto-itiner.cod-itiner    = itinerario.cod-itiner 
         and   pto-itiner.cod-pto-contr = itinerario.pto-embarque no-error.
         
    if avail pto-itiner then do:
       repeat:
            FIND NEXT  pto-itiner NO-LOCK 
                 WHERE pto-itiner.cod-itiner = itinerario.cod-itiner NO-ERROR.
            if avail pto-itiner then do:
                assign v-intervalo = v-intervalo + pto-itiner.nr-dias.
                if pto-itiner.cod-pto-contr = itinerario.pto-chegada then leave.
            end.
            else leave. 
       end. /*repeat*/
       assign p-data-entrega = (v-intervalo +  p-data-embarque).
    end.
    else 
        assign p-data-entrega = today.
    
    return 'OK'.
end.

procedure emptyRowObject:
/* retirar assim que o suporte corrigir a include main-block.i */
end.


procedure ValidateItinerPedVendaDesp:
&if defined(bf_mat_versao_ems) &then
    &if '{&bf_mat_versao_ems}' >= '2.04' &then
        define input  parameter pc-nr-pedcli  as character no-undo.
        define input  parameter pc-nome-abrev as character no-undo. 
        define input  parameter pi-cod-itiner as integer   no-undo.
        define input  parameter table         for tt-ped-venda-desp.
        define output parameter table         for tt-bo-erro.
        
        for each tt-ped-venda-desp
           where tt-ped-venda-desp.nr-pedcli  = pc-nr-pedcli
             and tt-ped-venda-desp.nome-abrev = pc-nome-abrev no-lock:
                 
            find pto-itiner 
                 where pto-itiner.cod-itiner    = pi-cod-itiner
                   and pto-itiner.cod-pto-contr = tt-ped-venda-desp.cod-pto-contr no-lock no-error.
                       
            if not avail pto-itiner then do:
               assign i-seq-erro = i-seq-erro + 1.
               create tt-bo-erro.
               assign tt-bo-erro.parametros = string(pi-cod-itiner).
               run utp/ut-msgs.p (input "msg":U,
                                  input 30262,
                                  input tt-bo-erro.parametros).
               assign tt-bo-erro.i-sequen     = i-seq-erro
                      tt-bo-erro.cd-erro      = 30262
                      tt-bo-erro.mensagem     = return-value.
                           
               return "NOK":U.
            end.
        end.
    &endif                                     
&else                                          
&endif                                         
    

end procedure.

procedure setParameterLI:
    define input parameter pl-solicita-li as logical no-undo.

    assign l-solicita-li = pl-solicita-li.
    
end procedure .

procedure getParameterLI:

    define output parameter pl-solicita-li as logical no-undo.

    assign pl-solicita-li = l-solicita-li.

end procedure.
