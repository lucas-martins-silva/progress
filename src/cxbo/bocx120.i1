{cdp/cdcfgmat.i} /* defini‡Æo de pr‚-processador */

&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.003
&scoped-define FIRST-TABLE-IN-QUERY pto-itiner
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME pto-itiner

{include/boini.i}
{cxbo/bocx120.i RowObject}

define temp-table tt-incoterm-itiner no-undo like incoterm-itiner.
define temp-table tt-desp-itiner     no-undo like desp-itiner.
define temp-table tt-altera          no-undo like pto-itiner.
define temp-table tt-pto-itiner      no-undo like pto-itiner
       field r-rowid                 as   rowid.

&if defined(bf_mat_versao_ems) &then
    &if '{&bf_mat_versao_ems}' >= '2.04' &then       
        define temp-table tt-ped-venda-desp  no-undo like ped-venda-desp
               field r-rowid                 as rowid.
    &endif
&else
&endif

DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

def var l-solicita-li       as logical   no-undo.
def var l-igual             as logical   no-undo.
def var i-cod-itiner        as integer   no-undo.
def var i-cod-pto           as integer   no-undo.
def var i-seq               as integer   no-undo.
def var i-cod-itiner-ini    as integer   no-undo.
def var i-cod-itiner-fim    as integer   no-undo.
def var i-cod-pto-contr-ini as integer   no-undo.
def var i-cod-pto-contr-fim as integer   no-undo.
def var h-bocx115           as handle    no-undo.
def var c-literal           as character no-undo.

procedure setConstraint1:
end procedure.

procedure setConstraint2:
    def input parameter p-cod-itiner as char no-undo.
    def input parameter p-cod-pto    as char no-undo.
    def input parameter p-seq        as char no-undo.

    assign i-cod-itiner = int(p-cod-itiner)
           i-cod-pto    = int(p-cod-pto)
           i-seq        = int(p-seq).

end procedure.

procedure setConstraint3:
    def input parameter r-chave as rowid no-undo.
    find itinerario no-lock
         where rowid(itinerario) = r-chave no-error.         

end procedure.

procedure setConstraint4:
/*
** Recebe parametros do zoom wz01cx120
*/ 
    def input parameter p-cod-itiner-ini as char no-undo.
    def input parameter p-cod-itiner-fim as char no-undo.
    def input parameter p-cod-pto-contr-ini as char no-undo.
    def input parameter p-cod-pto-contr-fim as char no-undo.
    
    assign i-cod-itiner-ini = integer(p-cod-itiner-ini)
           i-cod-itiner-fim = integer(p-cod-itiner-fim)
           i-cod-pto-contr-ini = integer(p-cod-pto-contr-ini)
           i-cod-pto-contr-fim = integer(p-cod-pto-contr-fim).
    
end procedure.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where pto-itiner.cod-itiner >= i-cod-itiner and ~
                                                                  pto-itiner.sequencia  >= i-seq        and ~
                                                                  pto-itiner.cod-pto-contr >= i-cod-pto no-lock  by pto-itiner.cod-itiner.
        when 3 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} of itinerario where pto-itiner.cod-itiner    >= i-cod-itiner and ~
                                                                                pto-itiner.sequencia     >= i-seq        and ~
                                                                                pto-itiner.cod-pto-contr >= i-cod-pto no-lock.
        when 4 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME}
                where {&TABLE-NAME}.cod-itiner >= i-cod-itiner-ini and ~
                      {&TABLE-NAME}.cod-itiner <= i-cod-itiner-fim and ~
                      {&TABLE-NAME}.cod-pto-contr >= i-cod-pto-contr-ini and ~
                      {&TABLE-NAME}.cod-pto-contr <= i-cod-pto-contr-fim ~
                      no-lock by {&TABLE-NAME}.cod-itiner.
        when 5 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME}
                where {&TABLE-NAME}.cod-itiner >= i-cod-itiner-ini and ~
                      {&TABLE-NAME}.cod-itiner <= i-cod-itiner-fim and ~
                      {&TABLE-NAME}.cod-pto-contr >= i-cod-pto-contr-ini and ~
                      {&TABLE-NAME}.cod-pto-contr <= i-cod-pto-contr-fim ~
                      no-lock by {&TABLE-NAME}.cod-pto-contr.
    end case.
    assign l-query    = true 
           i-bo-query = i-abertura.

end procedure.

