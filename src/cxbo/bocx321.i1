procedure executeUpdate:
        

        buffer-copy rowObject except cod-estabel 
                                     nr-proc-siscomex 
                                     num-grp-item
                                     class-fiscal 
                                     it-codigo 
                                     un 
                                     r-rowid to {&TABLE-NAME}.
                           
end procedure.
 

procedure executeDelete:

        /**  Executa Delete*/
        delete {&TABLE-NAME}.

end procedure.
 
procedure initializeValidate:
        /*
        **  Inicializa Validate
        */
 
        run startMethod ("initializeValidade").
 
        run endMethod   ("initializeValidade").
    
end procedure.

procedure findPk_Ncm:
        /*
        **  Procura pelo indice, caso nao ache,
        **  retorna mensagem de erro padrao do EMS.
        */
        run startMethod ("findPk_Ncm").
        def input parameter c-cod-estabel like it-proc-siscomex.cod-estabel no-undo.
        def input parameter c-nr-proc-siscomex like it-proc-siscomex.nr-proc-siscomex no-undo.
        def input parameter i-num-grupo like it-proc-siscomex.num-grp-item no-undo.
        def input parameter c-class-fiscal like it-proc-siscomex.class-fiscal no-undo.
        def input parameter c-it-codigo like it-proc-siscomex.it-codigo no-undo.
        def input parameter c-un like it-proc-siscomex.un no-undo.
        def output parameter c-return as char no-undo.
        
        find it-proc-siscomex where
             it-proc-siscomex.cod-estabel  = c-cod-estabel and 
             it-proc-siscomex.nr-proc-siscomex  = c-nr-proc-siscomex and 
             it-proc-siscomex.num-grp-item = i-num-grupo  and 
             it-proc-siscomex.class-fiscal = c-class-fiscal and 
             it-proc-siscomex.it-codigo    = c-it-codigo  and 
             it-proc-siscomex.un           = c-un
             no-lock no-error.
        if not avail {&TABLE-NAME} then do:
           {utp/ut-table.i mgcex it-proc-siscomex 1}
           run utp/ut-msgs.p (input "msg",
                              input 2,
                              input return-value).
           assign c-return = return-value.
        end.
        else do:
           run setCurrent.
        end.
        run endMethod ("findPk_Ncm").
    
end procedure.

procedure findCh_item:

        /*
        **  Procura pelo indice, caso nao ache,
        **  retorna mensagem de erro padrao do EMS.
        */
        run startMethod ("findCh_Item").
        def input parameter c-cod-estabel like it-proc-siscomex.cod-estabel no-undo.
        def input parameter c-nr-proc-siscomex like it-proc-siscomex.nr-proc-siscomex no-undo.
        def output parameter c-return as char no-undo.
        
        find first it-proc-siscomex where
             it-proc-siscomex.cod-estabel  = c-cod-estabel and 
             it-proc-siscomex.nr-proc-siscomex  = c-nr-proc-siscomex  
             no-lock no-error.
        if not avail {&TABLE-NAME} then do:
           {utp/ut-table.i mgcex it-proc-siscomex 1}
           run utp/ut-msgs.p (input "msg",
                              input 2,
                              input return-value).
           assign c-return = return-value.
        end.
        else do:
           run setCurrent.
        end.
        run endMethod ("findCh_Item").

end procedure.
 
procedure findProcSiscomex:

        /*
        **  Procura pelo indice, caso nao ache,
        **  retorna mensagem de erro padrao do EMS.
        */
        run startMethod ("findProcSiscomex").
        def input parameter c-cod-estabel like it-proc-siscomex.cod-estabel  no-undo.
        def input parameter c-nr-proc-exp like processo-exp.nr-proc-exp no-undo.
        def output parameter r-rowid as rowid no-undo.
        
        find first proc-siscomex where
                   proc-siscomex.cod-estabel  = c-cod-estabel and 
                   proc-siscomex.nr-proc-exp  = c-nr-proc-exp no-lock no-error.
        if avail proc-siscomex then do:
            assign r-rowid = rowid(proc-siscomex). 
        end.
        run endMethod ("findProcSiscomex").

end procedure.

procedure validateFields:
        /*
        **  Valida Fields
        */
        find first rowObject
              no-lock no-error.
        
        run startMethod ("validateFields").
        
        
        
        run endMethod ("validateFields").
 
end procedure.

 
procedure validateCreate:

        /*
        **  Valida criaá∆o da tabela/duplicidade de registro.
        */
        def input  parameter table for RowObject.
        def output parameter table for tt-bo-erro.
        def output parameter r-chave as rowid.
        
        run initializeValidate.
        run startMethod ("validateCreate").
        
        for each tt-bo-erro:
            delete tt-bo-erro.
        end.
        
        find first rowObject
             no-lock no-error.
        
        if rowObject.cod-estabel = "" then do:
           assign i-seq-erro = i-seq-erro + 1.
           {utp/ut-field.i mgcex it-proc-siscomex cod-estabel 1}
           run utp/ut-msgs.p (input "msg",
                              input 265,
                              input return-value).
           create tt-bo-erro.
           assign tt-bo-erro.i-sequen     = i-seq-erro
                  tt-bo-erro.cd-erro      = 265
                  tt-bo-erro.mensagem     = return-value.
        end.
        
        if rowObject.nr-proc-siscomex = "" then do:
           assign i-seq-erro = i-seq-erro + 1.
           {utp/ut-field.i mgcex it-proc-siscomex nr-proc-siscomex 1}
           run utp/ut-msgs.p (input "msg",
                              input 265,
                              input return-value).
           create tt-bo-erro.
           assign tt-bo-erro.i-sequen     = i-seq-erro
                  tt-bo-erro.cd-erro      = 265
                  tt-bo-erro.mensagem     = return-value.
        end.
        
        if rowObject.class-fiscal = "" then do:
           assign i-seq-erro = i-seq-erro + 1.
           {utp/ut-field.i mgcex it-proc-siscomex class-fiscal 1}
           run utp/ut-msgs.p (input "msg",
                              input 265,
                              input return-value).
           create tt-bo-erro.
           assign tt-bo-erro.i-sequen     = i-seq-erro
                  tt-bo-erro.cd-erro      = 265
                  tt-bo-erro.mensagem     = return-value.
        end.
        
        if rowObject.it-codigo = "" then do:
           assign i-seq-erro = i-seq-erro + 1.
           {utp/ut-field.i mgcex it-proc-siscomex it-codigo 1}
           run utp/ut-msgs.p (input "msg",
                              input 265,
                              input return-value).
           create tt-bo-erro.
           assign tt-bo-erro.i-sequen     = i-seq-erro
                  tt-bo-erro.cd-erro      = 265
                  tt-bo-erro.mensagem     = return-value.
        end.
        
        if rowObject.un = "" then do:
           assign i-seq-erro = i-seq-erro + 1.
           {utp/ut-field.i mgcex it-proc-siscomex un 1}
           run utp/ut-msgs.p (input "msg",
                              input 265,
                              input return-value).
           create tt-bo-erro.
           assign tt-bo-erro.i-sequen     = i-seq-erro
                  tt-bo-erro.cd-erro      = 265
                  tt-bo-erro.mensagem     = return-value.
        end.
        
        if not can-find(estabelec where 
                        estabelec.cod-estabel = rowObject.cod-estabel) then do:
           {utp/ut-field.i mgadm estabelec cod-estabel 1}
           assign i-seq-erro = i-seq-erro + 1.
           run utp/ut-msgs.p (input "msg",
                              input 2,
                              input return-value).
           create tt-bo-erro.
           assign tt-bo-erro.i-sequen = i-seq-erro
                  tt-bo-erro.cd-erro  = 2
                  tt-bo-erro.mensagem = return-value.
        end. 
        
        if not can-find(processo-exp where 
                        processo-exp.cod-estabel = rowObject.cod-estabel and 
                        processo-exp.nr-proc-exp = rowObject.nr-proc-siscomex) then do:
          {utp/ut-field.i mgcex processo-exp nr-proc-exp 1}
           assign i-seq-erro = i-seq-erro + 1.
           run utp/ut-msgs.p (input "msg",
                              input 2,
                              input return-value).
           create tt-bo-erro.
           assign tt-bo-erro.i-sequen = i-seq-erro
                  tt-bo-erro.cd-erro  = 2
                  tt-bo-erro.mensagem = return-value.
        end. 
        
        if not can-find(classif-fisc where 
                        classif-fisc.class-fiscal = rowObject.class-fiscal ) then do:
           {utp/ut-field.i mgind classif-fisc class-fisc 1}
            assign i-seq-erro = i-seq-erro + 1.
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.
        end. 
        
        if not can-find(item where 
                        item.it-codigo = rowObject.it-codigo ) then do:
           {utp/ut-field.i mgind item it-codigo 1}
           assign i-seq-erro = i-seq-erro + 1.
           run utp/ut-msgs.p (input "msg",
                              input 2,
                              input return-value).
           create tt-bo-erro.
           assign tt-bo-erro.i-sequen = i-seq-erro
                  tt-bo-erro.cd-erro  = 2
                  tt-bo-erro.mensagem = return-value.
        end. 
        
        find first tt-bo-erro
             no-lock no-error.
        if not avail tt-bo-erro then do:
        
           find it-proc-siscomex where
                it-proc-siscomex.cod-estabel  = rowObject.cod-estabel  and 
                it-proc-siscomex.nr-proc-siscomex  = rowObject.nr-proc-siscomex  and 
                it-proc-siscomex.num-grp-item = rowobject.num-grp-item and 
                it-proc-siscomex.class-fiscal = rowObject.class-fiscal and 
                it-proc-siscomex.it-codigo    = rowObject.it-codigo    and 
                it-proc-siscomex.un           = rowObject.un           no-lock no-error.
           if avail it-proc-siscomex then do:
              assign i-seq-erro = i-seq-erro + 1.
              {utp/ut-table.i mgcex it-proc-siscomex 1}
              run utp/ut-msgs.p (input "msg",
                                 input 8,
                                 input return-value).
              create tt-bo-erro.
              assign tt-bo-erro.i-sequen     = i-seq-erro
                     tt-bo-erro.cd-erro      = 8
                     tt-bo-erro.mensagem     = return-value.
           end.
           
        end.
        
        run validateFields.
        
        find first tt-bo-erro
             no-lock no-error.
        if not avail tt-bo-erro then do:
           run executeCreate.
           assign r-chave = to-rowid(return-value).
        end.
        
        /** EPC - Inicio **/
        for each tt-epc where tt-epc.cod-event = "ModificaValorItem": 
            delete tt-epc. 
        end.
        
        IF c-nom-prog-upc-mg97 <> "" THEN DO:
              /* Criando registro da EPC */
              {include/i-epc200.i2 &CodEvent='"ModificaValorItem"'
                                   &CodParameter='"cod-estabel"'
                                   &ValueParameter="string(rowObject.cod-estabel)" }
    
              {include/i-epc200.i2 &CodEvent='"ModificaValorItem"'
                                   &CodParameter='"nr-proc-siscomex"'
                                   &ValueParameter="string(rowObject.nr-proc-siscomex)" }
    
              {include/i-epc200.i2 &CodEvent='"ModificaValorItem"'
                                   &CodParameter='"num-grp-item"'
                                   &ValueParameter="string(rowObject.num-grp-item)" }
              
              {include/i-epc200.i2 &CodEvent='"ModificaValorItem"'
                                   &CodParameter='"class-fiscal"'
                                   &ValueParameter="string(rowObject.class-fiscal)" }

              {include/i-epc200.i2 &CodEvent='"ModificaValorItem"'
                                   &CodParameter='"it-codigo"'
                                   &ValueParameter="string(rowObject.it-codigo)" }
                                   
              {include/i-epc200.i2 &CodEvent='"ModificaValorItem"'
                                   &CodParameter='"un"'
                                   &ValueParameter="string(rowObject.un)" }
                                   
              {include/i-epc200.i2 &CodEvent='"ModificaValorItem"'
                                   &CodParameter='"qt-item"'
                                   &ValueParameter="string(rowObject.dec-1)" }

              {include/i-epc200.i2 &CodEvent='"ModificaValorItem"'
                                   &CodParameter='"vl-item"'
                                   &ValueParameter="string(rowObject.dec-2)" }                                   

              {include/i-epc200.i2 &CodEvent='"ModificaValorItem"'
                                   &CodParameter='"table-rowid"'
                                   &ValueParameter="string(r-chave)" }                                   
        END.
        
        run endMethod ("validateCreate").
    
end procedure.

 
procedure deleteTable:
     
        def input parameter p-cod-estabel like historico-proc-exp.cod-estabel.
        def input parameter p-nr-proc-siscomex like historico-proc-exp.nr-proc-exp.
        
        def var r-rowid  as rowid no-undo.
        
        run startMethod ("deleteTable").
        
        for each it-proc-siscomex exclusive-lock
            where it-proc-siscomex.cod-estabel = p-cod-estabel
              and it-proc-siscomex.nr-proc-siscomex = p-nr-proc-siscomex:
            assign r-rowid = rowid(it-proc-siscomex).
            run validateDelete (input-output r-rowid, output table tt-bo-erro) .
        end.
         
        run endMethod ("DeleteTable").
 

end procedure. 


procedure getValuesItem:

  
        def  input parameter p-estabel       like it-proc-siscomex.cod-estabel      no-undo.
        def  input parameter p-processo      like it-proc-siscomex.nr-proc-siscomex no-undo.
        def  input parameter p-class-fisc    like it-proc-siscomex.class-fiscal     no-undo.
        def  input parameter p-item          like it-proc-siscomex.it-codigo        no-undo.
        def  input parameter p-un            like it-proc-siscomex.un               no-undo.
        def  input parameter p-num-grupo     like it-proc-siscomex.num-grp-item      no-undo.
        
        def output parameter de-faturada     like it-nota-fisc.qt-faturada[1]       no-undo.
        def output parameter de-vl-fob       like it-nota-fisc.vl-tot-item          no-undo.
        def output parameter de-vl-venda     like it-nota-fisc.vl-tot-item          no-undo.
        def output parameter de-peso-liq     like it-nota-fisc.peso-liq-fat         no-undo.
        def output parameter de-faturada-aux like it-nota-fisc.qt-faturada[1]       no-undo.
        def output parameter de-vl-fob-aux   like it-nota-fisc.vl-tot-item          no-undo.
        def output parameter de-vl-venda-aux like it-nota-fisc.vl-tot-item          no-undo.
        def output parameter de-peso-liq-aux like it-nota-fisc.peso-liq-fat         no-undo.
       
        run startMethod ("getValuesItem").
        
        assign de-faturada = 0
               de-vl-fob   = 0
               de-vl-venda = 0
               de-peso-liq = 0
               de-faturada-aux = 0 
               de-vl-fob-aux   = 0
               de-vl-venda-aux = 0
               de-peso-liq-aux = 0.
        
        for each proc-it-nota-fisc no-lock 
           where proc-it-nota-fisc.cod-estabel = p-estabel
             and proc-it-nota-fisc.nr-proc-exp = p-processo use-index pk-it-notafisc:
             
           if proc-it-nota-fisc.it-codigo <> p-item then next.

           /**************************************************
           *     Engenharia Devolucao Nota de Exportacao     *
           **************************************************/
           &IF  DEFINED(bf_dis_versao_ems) &THEN
               &IF  "{&bf_dis_versao_ems}":U >= "2.04":U &THEN
                   FIND FIRST proc-nota-fiscal
                        WHERE proc-nota-fiscal.cod-estabel = proc-it-nota-fisc.cod-estabel AND
                              proc-nota-fiscal.nr-proc-exp = proc-it-nota-fisc.nr-proc-exp AND
                              proc-nota-fiscal.serie       = proc-it-nota-fisc.serie       AND
                              proc-nota-fiscal.nr-nota-fis = proc-it-nota-fisc.nr-nota-fis NO-LOCK NO-ERROR.

                   IF  AVAIL proc-nota-fiscal THEN DO:
                       &IF  "{&bf_dis_versao_ems}":U >= "2.06":U &THEN
                           IF  proc-nota-fiscal.log-nf-devolvid THEN NEXT.
                       &ELSE
                           IF  proc-nota-fiscal.log-1 THEN NEXT.
                       &ENDIF
                   END.
               &ENDIF
           &ENDIF
           
           for first it-nota-fisc fields
               (it-codigo class-fiscal nr-pedido un-fatur[1] qt-faturada[1] nr-seq-fat 
                cod-estabel serie nr-nota-fis vl-tot-item vl-frete-it vl-merc-liq peso-liq-fat vl-preuni-e[1] vl-despesit-e[1])
               where it-nota-fisc.cod-estabel = proc-it-nota-fisc.cod-estabel 
                 and it-nota-fisc.serie       = proc-it-nota-fisc.serie       
                 and it-nota-fisc.nr-nota-fis = proc-it-nota-fisc.nr-nota-fis 
                 and it-nota-fisc.nr-seq-fat  = proc-it-nota-fisc.nr-seq-fat  
                 and it-nota-fisc.it-codigo   = proc-it-nota-fisc.it-codigo
                 use-index ch-nota-item: 
           end.
            
           if not avail it-nota-fisc then next.
           
           if it-nota-fisc.class-fiscal <> p-class-fisc then next.           

           if it-nota-fisc.un-fatur[1] <> p-un then next. 
           
           for first nota-fiscal fields 
               (cod-estabel serie nr-nota-fis dt-emis-nota dt-cancela vl-taxa-exp vl-seguro vl-mercad ) no-lock where 
                nota-fiscal.cod-estabel = it-nota-fisc.cod-estabel and 
                nota-fiscal.serie       = it-nota-fisc.serie       and 
                nota-fiscal.nr-nota-fis = it-nota-fisc.nr-nota-fis : end.
                
           if not avail nota-fiscal then NEXT.

           if nota-fiscal.dt-cancela <> ? then NEXT.
           
           assign de-qt-devol = 0
                  de-vl-devol = 0
                  d-data-emissao = nota-fiscal.dt-emis-nota.

           run pi-devolucao.
           
           if i-mo-codigo-ped = 0 then 
             find ped-venda where
                  ped-venda.nr-pedido = it-nota-fisc.nr-pedido
                  no-lock no-error.
             if avail ped-venda then
                assign i-mo-codigo-ped = ped-venda.mo-codigo.          


           run retornaValorDolar (input it-nota-fisc.vl-preuni-e[1],
                                  input i-mo-codigo-ped,
                                  input d-data-emissao,
                                  output de-preco-dolar-item).
           
            
           ASSIGN de-faturada  = de-faturada + it-nota-fisc.qt-faturada[1]
                  de-faturada  = de-faturada - de-qt-devol
                  /*Dranka*/
                  /*de-vl-venda  = de-vl-venda + ( (it-nota-fisc.vl-tot-item - de-vl-devol) / nota-fiscal.vl-taxa-exp )
                  de-vl-fob    = de-vl-fob   + ( (it-nota-fisc.vl-tot-item - de-vl-devol  - it-nota-fisc.vl-frete-it - ( (nota-fiscal.vl-seguro / nota-fiscal.vl-mercad) * it-nota-fisc.vl-merc-liq ) ) / nota-fiscal.vl-taxa-exp )*/
                  de-vl-venda  = de-vl-venda + ( ( it-nota-fisc.vl-preuni-e[1]  * it-nota-fisc.qt-faturada[1]) - de-vl-devol + it-nota-fisc.vl-despesit-e[1])   
                  de-vl-fob    = de-vl-fob   + ( ( it-nota-fisc.vl-preuni-e[1]  * it-nota-fisc.qt-faturada[1]) - de-vl-devol /*- it-nota-fisc.vl-despesit-e[1]*/)
                  de-peso-liq  = de-peso-liq + it-nota-fisc.peso-liq-fat.
        
           /* A quantidade faturada e o valor do item s∆o gravados nos campos dec-1 e dec-2, caso os mesmos tiverem valor n∆o poder∆o ser atualizados pois neste caso os grupos j† foram confirmados*/
           if p-num-grupo <> 0 then
               find it-proc-siscomex where
                    it-proc-siscomex.cod-estabel       = p-estabel and 
                    it-proc-siscomex.nr-proc-siscomex  = p-processo and 
                    it-proc-siscomex.num-grp-item      = p-num-grupo  and 
                    it-proc-siscomex.class-fiscal      = p-class-fisc and 
                    it-proc-siscomex.it-codigo         = p-item  and 
                    it-proc-siscomex.un                = p-un
                    no-lock no-error.
               if avail it-proc-siscomex then do:
                   assign de-peso-liq = it-proc-siscomex.dec-1 
                          de-vl-venda = it-proc-siscomex.dec-2.
               end.
        END.
        
        run startMethod ("getValuesItem").

end procedure.

procedure getValueFormaPagto:

def  input parameter p-idi-forma-pagto    like it-proc-siscomex.idi-forma-pagto  no-undo.
def output parameter c-forma-pagto  as char no-undo.

run startMethod ("getValuesProc").

case p-idi-forma-pagto:
   when 1 then 
      assign c-forma-pagto = "N∆o Usa".
   when 2 then
      assign c-forma-pagto = "Conta Gr†fica".
   when 3 then
      assign c-forma-pagto = "Fatura".
   when 4 then
      assign c-forma-pagto = "Receber".
 end.      
run endMethod ("getValuesProc").
      
end.

procedure pi-devolucao:

        run startMethod ("pi-devolucao").
        
        for each devol-cli fields ( qt-devolvida vl-devol ) no-lock
            where devol-cli.cod-estabel  = nota-fiscal.cod-estabel 
              and devol-cli.serie        = nota-fiscal.serie
              and devol-cli.nr-nota-fis  = nota-fiscal.nr-nota-fis
              and devol-cli.nr-sequencia = it-nota-fisc.nr-seq-fat
              and devol-cli.it-codigo    = it-nota-fisc.it-codigo use-index ch-nfs:
                
            assign de-qt-devol = de-qt-devol + devol-cli.qt-devolvida
                   de-vl-devol = de-vl-devol + devol-cli.vl-devol.
                 
        end.

        run endMethod ("pi-devolucao").

end procedure.

procedure getValuesProc:

        define input  parameter pc-cod-estabel       as char                           no-undo.
        define input  parameter pc-nr-proc-siscomex  as char                           no-undo.
        define output parameter pde-valor-antecipado as dec format "->>,>>>,>>>,>>9.99" no-undo.
        define output parameter pde-valor-avista     as dec format "->>,>>>,>>>,>>9.99" no-undo.
        define output parameter pde-valor-parcela    like it-nota-fisc.peso-liq-fat    no-undo.

        run startMethod ("getValuesProc").

        def var de-vl-parcela-ant as dec format "->>,>>>,>>>,>>9.99" no-undo.
        def var de-vl-descont-ant as dec format "->>,>>>,>>>,>>9.99" no-undo.
        def var de-vl-taxa-exp    like nota-fiscal.vl-taxa-exp no-undo.
        DEF VAR de-tot-nf-mo-est  AS DEC FORMAT "->>,>>>,>>>,>>9.99" no-undo.
        DEF VAR de-desc-nf-mo-est AS DEC FORMAT "->>,>>>,>>>,>>9.99" no-undo.
        def var de-vl-total-nota  as dec FORMAT "->>,>>>,>>>,>>9.99" no-undo.
        def var l-fechaDuplic     as log                             no-undo.
        
        find para-fat no-lock no-error.

        assign de-vl-parcela-ant    = 0
               de-vl-descont-ant    = 0
               pde-valor-antecipado = 0
               pde-valor-avista     = 0
               pde-valor-parcela    = 0
               de-tot-nf-mo-est     = 0
               de-desc-nf-mo-est    = 0.
               
        /* Busca todas as notas fiscais do processo */
        if can-find(funcao where /* Fechamento de Duplicatas por Pedido */
                    funcao.cd-funcao = "spp-FechaDuplic" and
                    funcao.ativo = yes) and 
                    para-fat.ind-fec-dup = 2 then
                assign l-fechaDuplic = yes.

        for each nota-fiscal where
                 nota-fiscal.cod-estabel = pc-cod-estabel  and
                 nota-fiscal.nr-proc-exp = pc-nr-proc-siscomex no-lock 
                 use-index ch-invoice break by nota-fiscal.nr-fatura:
                
                 if first-of (nota-fiscal.nr-fatura) then
                    ASSIGN de-tot-nf-mo-est  = 0
                           de-desc-nf-mo-est = 0
                           de-vl-total-nota  = 0.
                
                 if nota-fiscal.dt-cancela <> ? then next.                   
                
                 find first proc-nota-fiscal where
                            proc-nota-fiscal.cod-estabel = pc-cod-estabel and
                            proc-nota-fiscal.nr-proc-exp = pc-nr-proc-siscomex and
                            proc-nota-fiscal.serie       = nota-fiscal.serie   and
                            proc-nota-fiscal.nr-nota-fis = nota-fiscal.nr-nota-fis no-lock no-error.

                 IF NOT AVAIL proc-nota-fiscal THEN
                     NEXT.
                 /**************************************************
                 *     Engenharia Devolucao Nota de Exportacao     *
                 **************************************************/
                 &IF  DEFINED(bf_dis_versao_ems) &THEN
                      &IF  "{&bf_dis_versao_ems}":U >= "2.06":U &THEN
                          IF  proc-nota-fiscal.log-nf-devolvid THEN NEXT.
                      &ELSEIF "{&bf_dis_versao_ems}":U >= "2.04":U &THEN
                          IF  proc-nota-fiscal.log-1 THEN NEXT.
                      &ENDIF
                 &ENDIF
                
                 for each it-nota-fisc fields (it-nota-fisc.vl-mercliq-e it-nota-fisc.vl-despesit-e vl-merc-ori-me vl-merc-liq-me)
                    where it-nota-fisc.cod-estabel = nota-fiscal.cod-estabel and
                          it-nota-fisc.serie       = nota-fiscal.serie       and
                          it-nota-fisc.nr-nota-fis = nota-fiscal.nr-nota-fis no-lock:
                         
                          assign de-tot-nf-mo-est  = de-tot-nf-mo-est + 
                                                     it-nota-fisc.vl-mercliq-e[1] +
                                                     it-nota-fisc.vl-despesit-e[1]
                                 de-desc-nf-mo-est = de-desc-nf-mo-est + 
                                                     it-nota-fisc.vl-merc-ori-me - 
                                                     it-nota-fisc.vl-merc-liq-me.
                 end.      
               
                 assign de-vl-total-nota = de-vl-total-nota + nota-fiscal.vl-tot-nota.
                
                 if last-of (nota-fiscal.nr-fatura) then do:
                         assign de-vl-tot-item = de-vl-tot-item + de-tot-nf-mo-est.
                
                         for each fat-duplic no-lock where 
                                  fat-duplic.cod-estabel = proc-nota-fiscal.cod-estabel and 
                                  fat-duplic.serie       = proc-nota-fiscal.serie       and 
                                  fat-duplic.nr-fatura   = nota-fiscal.nr-fatura :
                                 
                                  if fat-duplic.cod-vencto = 3 then do: /* Antecipado */
                                          assign de-vl-parcela-ant = de-vl-parcela-ant + ( de-tot-nf-mo-est * (fat-duplic.vl-parcela / de-vl-total-nota)).
                                          if not l-fechaDuplic then 
                                                assign de-vl-descont-ant = de-vl-descont-ant + ( de-desc-nf-mo-est * (fat-duplic.vl-desconto / nota-fiscal.vl-desconto)).
                                  end.
                                  else do: 
                                       if (fat-duplic.cod-vencto = 2 or 
                                           fat-duplic.cod-vencto = 4) then /* ∑ vista */
                                              assign pde-valor-avista = pde-valor-avista + ( de-tot-nf-mo-est * (fat-duplic.vl-parcela / de-vl-total-nota)).
                                                     
                                  end.
                                  if l-fechaDuplic then
                                     assign pde-valor-parcela = pde-valor-parcela + ( de-tot-nf-mo-est * (fat-duplic.vl-parcela / de-vl-total-nota)). /*frank-Dranka - 1 */  
                                  else
                                     assign pde-valor-parcela = pde-valor-parcela + ( fat-duplic.vl-parcela / nota-fiscal.vl-taxa-exp ).
                         end.
                 end.
        end.
         
                    
       
        
        assign pde-valor-antecipado = de-vl-parcela-ant - de-vl-descont-ant
               pde-valor-parcela = pde-valor-parcela - (pde-valor-avista + de-vl-parcela-ant).               
       
        run acertadiferencatotal (input de-vl-tot-item,
                                  input pde-valor-parcela).         


   run EndMethod ("getValuesProc").


end procedure.
  

procedure CriaTTItProcSiscomex:

        define  input parameter pc-cod-estabel as char   no-undo.
        define  input parameter pc-nr-proc-siscomex as char   no-undo.
        define output parameter table for tt-item.
        define output parameter table for tt-bo-erro.
        
        define variable r-chave-item as rowid no-undo.
        
        for each tt-it-proc-siscomex:
            delete tt-it-proc-siscomex.
        end.

        for each tt-item:
            delete tt-item.
        end.

        /* Busca todas as notas fiscais do processo */
        for each proc-it-nota-fisc fields 
           (cod-estabel nr-proc-exp serie nr-nota-fis nr-seq-fat it-codigo) no-lock
            where proc-it-nota-fisc.cod-estabel = pc-cod-estabel
              and proc-it-nota-fisc.nr-proc-exp = pc-nr-proc-siscomex use-index pk-it-notafisc:

            /**************************************************
            *     Engenharia Devolucao Nota de Exportacao     *
            **************************************************/
            &IF  DEFINED(bf_dis_versao_ems) &THEN
                &IF  "{&bf_dis_versao_ems}":U >= "2.04":U &THEN
                    FIND FIRST proc-nota-fiscal
                         WHERE proc-nota-fiscal.cod-estabel = proc-it-nota-fisc.cod-estabel AND
                               proc-nota-fiscal.nr-proc-exp = proc-it-nota-fisc.nr-proc-exp AND
                               proc-nota-fiscal.serie       = proc-it-nota-fisc.serie       AND
                               proc-nota-fiscal.nr-nota-fis = proc-it-nota-fisc.nr-nota-fis NO-LOCK NO-ERROR.
            
                    IF  AVAIL proc-nota-fiscal THEN DO:
                        &IF  "{&bf_dis_versao_ems}":U >= "2.06":U &THEN
                            IF  proc-nota-fiscal.log-nf-devolvid THEN NEXT.
                        &ELSE
                            IF  proc-nota-fiscal.log-1 THEN NEXT.
                        &ENDIF
                    END.
                &ENDIF
            &ENDIF
              
            for first nota-fiscal fields 
               (dt-cancela cod-estabel serie nr-nota-fis vl-taxa-exp) no-lock where 
                nota-fiscal.cod-estabel = proc-it-nota-fisc.cod-estabel and 
                nota-fiscal.serie       = proc-it-nota-fisc.serie       and
                nota-fiscal.nr-nota-fis = proc-it-nota-fisc.nr-nota-fis use-index ch-nota : 
            end.
                
            if not avail nota-fiscal then next.

            if nota-fiscal.dt-cancela <> ? then next.
           
            for first it-nota-fisc fields
                (it-codigo class-fiscal un-fatur[1] qt-faturada[1] nr-seq-fat )
                where it-nota-fisc.cod-estabel = proc-it-nota-fisc.cod-estabel 
                  and it-nota-fisc.serie       = proc-it-nota-fisc.serie       
                  and it-nota-fisc.nr-nota-fis = proc-it-nota-fisc.nr-nota-fis 
                  and it-nota-fisc.nr-seq-fat  = proc-it-nota-fisc.nr-seq-fat  
                  and it-nota-fisc.it-codigo   = proc-it-nota-fisc.it-codigo
                  use-index ch-nota-item: 
            end.
            
            if not avail it-nota-fisc then next.
           
            assign de-qt-devol = 0
                   de-vl-devol = 0.

            run pi-devolucao.
             
            if it-nota-fisc.qt-faturada[1] = de-qt-devol then next.
            
            find first tt-item
                 where tt-item.it-codigo    = it-nota-fisc.it-codigo
                   and tt-item.class-fiscal = it-nota-fisc.class-fiscal
                   and tt-item.un           = it-nota-fisc.un-fatur[1] no-error.
                   
            if not avail tt-item then do: 

                create tt-item.
                assign tt-item.class-fiscal = it-nota-fisc.class-fiscal
                       tt-item.it-codigo    = it-nota-fisc.it-codigo
                       tt-item.un           = it-nota-fisc.un-fatur[1].
        
            end.
            
            assign tt-item.cod-estabel  = proc-it-nota-fisc.cod-estabel 
                   tt-item.nr-proc-siscomex  = proc-it-nota-fisc.nr-proc-exp
                   tt-item.num-grp-item = 0.
                       
            find first item-cex no-lock 
                 where item-cex.it-codigo  = it-nota-fisc.it-codigo no-error.
                        
            if avail item-cex then do:
                
               &IF {&BF_DIS_VERSAO_EMS} >= 2.05 &THEN
                   assign tt-item.cod-categ-textil = item-cex.cod-categ-textil.  
               &else                                               
                   assign tt-item.cod-categ-textil = substring(item-cex.char-1,1,4).  
               &endif
                  
            end.
                   
            assign tt-item.dt-valid-embarq = today + 90. 
        end.
   

end procedure.
  

procedure getReturnPeriod_Indi:

        define input parameter pc-cod-estabel as char    no-undo.
        define input parameter pc-nr-proc-siscomex as char    no-undo.
        define output parameter p-num-dias    as integer no-undo.
        define output parameter p-d-dias      as char    no-undo.
        define output parameter p-nr-parcelas as integer no-undo.

        run startMethod ("getReturnPeriod_Indi").

        assign p-num-dias    = 0
               p-d-dias      = ""
               p-nr-parcelas = 0.       
                    

        find first proc-nota-fiscal no-lock 
             where proc-nota-fiscal.cod-estabel = pc-cod-estabel 
               and proc-nota-fiscal.nr-proc-exp = pc-nr-proc-siscomex no-error.
           
        if avail proc-nota-fiscal then do:
    
           find first nota-fiscal no-lock where 
                nota-fiscal.cod-estabel = proc-nota-fiscal.cod-estabel and 
                nota-fiscal.serie       = proc-nota-fiscal.serie  and 
                nota-fiscal.nr-nota-fis = proc-nota-fiscal.nr-nota-fis no-error.
       
           if avail nota-fiscal then do:

              find cond-pagto no-lock where 
                   cond-pagto.cod-cond-pag = nota-fiscal.cod-cond-pag no-error.
               
              if avail cond-pagto then do:
          
                 if (cond-pagto.cod-vencto <> 2
                 or  cond-pagto.cod-vencto <> 3 
                 or  cond-pagto.cod-vencto <> 4) 
                 and cond-pagto.prazos[cond-pagto.num-parcelas] <> 0 then do:
                 
                     assign p-num-dias    = cond-pagto.prazos[cond-pagto.num-parcelas]
                            p-d-dias      = "D"
                            p-nr-parcelas = 001.             

                 end.

              end.
                 
           end.
       
        end.
        
        run EndMethod ("getReturnPeriod_Indi").
     
end procedure.


procedure getRegDet.

        def input  parameter i-extent as integer no-undo.
        def output parameter table for ttRowObjectDetRet.
        
        run StartMethod ("getRegDet").
        
        for each ttRowObjectDetRet:
            delete ttRowObjectDetRet.
        end.
        
        find first ttRowObjectDet no-lock
             where ttRowObjectDet.id = i-extent no-error.
        
        if avail ttRowObjectDet then
        do:
            create ttRowObjectDetRet.
            assign ttRowObjectDetRet.id = ttRowObjectDet.id
                   ttRowObjectDetRet.cod-fabrican = ttRowObjectDet.cod-fabrican
                   ttRowObjectDetRet.class-fiscal-fabrican = ttRowObjectDet.class-fiscal-fabrican
                   ttRowObjectDetRet.nr-ato-concessorio = ttRowObjectDet.nr-ato-concessorio
                   ttRowObjectDetRet.qtd-fabrican = ttRowObjectDet.qtd-fabrican
                   ttRowObjectDetRet.valor-fabrican = ttRowObjectDet.valor-fabrican
                   ttRowObjectDetRet.nome-abrev = ttRowObjectDet.nome-abrev
                   ttRowObjectDetRet.cgc = ttRowObjectDet.cgc
                   ttRowObjectDetRet.estado = ttRowObjectDet.estado
                   ttRowObjectDetRet.r-rowid = ttRowObjectDet.r-rowid.
        end.

        run EndMethod ("getRegDet").

end procedure.

procedure gravaitemCex:

        def input parameter pcod-item  like it-proc-siscomex.it-codigo no-undo.
        def input parameter pcod-categ like it-proc-siscomex.cod-categ-textil no-undo.
   
        run StartMethod ("gravaItemCex").
        
        find first item-cex exclusive-lock 
             where item-cex.it-codigo = pcod-item no-error.
        if not avail item-cex then do:
           create item-cex.
           assign item-cex.it-codigo = pcod-item
                  item-cex.ind-imp-desc = 1.
        end.
   
        &IF {&BF_DIS_VERSAO_EMS} >= 2.05 &THEN
            assign item-cex.cod-categ-textil = pcod-categ.  
        &else                                               
            assign substring(item-cex.char-1,1,4) = pcod-categ.  
        &endif

        run EndMethod ("GravaItemCex").

end procedure.

procedure getObsFab:

        def input parameter c-cod-estabel like it-proc-siscomex.cod-estabel no-undo.
        def input parameter c-nr-proc-siscomex like it-proc-siscomex.nr-proc-siscomex no-undo.
        def input parameter i-num-grupo like it-proc-siscomex.num-grp-item no-undo.
        def input parameter c-class-fiscal like it-proc-siscomex.class-fiscal no-undo.
        def input parameter c-it-codigo like it-proc-siscomex.it-codigo no-undo.
        def input parameter c-un like it-proc-siscomex.un no-undo.
        def output parameter p-obs  as char format "x(01)"  no-undo.
        def output parameter p-fab  as char format "x(01)"  no-undo.

        def var i-cont as integer no-undo.
        
        find it-proc-siscomex where
             it-proc-siscomex.cod-estabel  = c-cod-estabel and 
             it-proc-siscomex.nr-proc-siscomex  = c-nr-proc-siscomex and 
             it-proc-siscomex.num-grp-item = i-num-grupo  and 
             it-proc-siscomex.class-fiscal = c-class-fiscal and 
             it-proc-siscomex.it-codigo    = c-it-codigo  and 
             it-proc-siscomex.un           = c-un
             no-lock no-error.
             
        if avail {&TABLE-NAME} then do:
        
           do i-cont = 1 to 10:
              if {&TABLE-NAME}.obs-export[i-cont] <> " " then
                 assign p-obs = "S".
           end.
           if p-obs = " " then
              assign p-obs = "N".

           do i-cont = 1 to 10:
              if {&TABLE-NAME}.cod-fabrican[i-cont] <> 0 then
                 assign p-fab = "S".
           end.
           if p-fab = " " then
              assign p-fab = "N".
        
        end.   

end procedure.

procedure GeraAgrupamento:

        define input parameter i-num-col-descr    as integer                             NO-UNDO.
        define input parameter i-idi-forma-descr  as integer                             NO-UNDO.
        define input parameter p-cod-estabel      like it-proc-siscomex.cod-estabel      no-undo.
        define input parameter p-nr-proc-siscomex like it-proc-siscomex.nr-proc-siscomex no-undo.
        define input parameter l-automatico       as logical                             no-undo.
        
        DEFINE INPUT-OUTPUT PARAMETER table for tt-it-proc-siscomex.
        
        define variable h-bocx180     as   handle             no-undo.
        define variable c-return      as   character          no-undo.
        define variable d-vl-it-anexo like ped-item.vl-preori no-undo.
        
        if not valid-handle(h-bocx180) or 
            h-bocx180:type      <> "procedure":U or
            h-bocx180:file-name <> "cxbo/bocx180.p":U then
            run cxbo/bocx180.p persistent set h-bocx180.             
        
        ASSIGN i-cont2 = 10
               i-cont  = 0
               de-tot-fatur = 0.
        
        for each tt-it-proc-siscomex-aux:
           delete tt-it-proc-siscomex-aux.
        end.
        
        for each tt-descricao:
            delete tt-descricao.
        end. 
        
        for each tt-descricao-aux:
            delete tt-descricao-aux.
        end.
        
        FOR EACH tt-it-proc-siscomex
            where tt-it-proc-siscomex.cod-estabel = p-cod-estabel
            and tt-it-proc-siscomex.nr-proc-siscomex = p-nr-proc-siscomex
            BREAK BY tt-it-proc-siscomex.class-fiscal
                  BY tt-it-proc-siscomex.un:
                  
            RUN getValuesItem ( INPUT tt-it-proc-siscomex.cod-estabel,
                                INPUT tt-it-proc-siscomex.nr-proc-siscomex,
                                input tt-it-proc-siscomex.class-fiscal,
                                INPUT tt-it-proc-siscomex.it-codigo,
                                INPUT tt-it-proc-siscomex.un,
                                input tt-it-proc-siscomex.num-grp-item,
                                OUTPUT de-faturada,
                                OUTPUT de-vl-fob,
                                OUTPUT de-vl-venda,
                                OUTPUT de-peso-liq,
                                output de-faturada-aux,
                                output de-vl-fob-aux,
                                output de-vl-venda-aux,
                                output de-peso-liq-aux).
                               
            run findPk_estabel in h-bocx180 (input tt-it-proc-siscomex.cod-estabel,
                                             output c-return).

            if c-return = "" then do:
               run getdecfield in h-bocx180 (input "dec-1":U,
                                             output d-vl-it-anexo).
                                             
               IF  d-vl-it-anexo      <> 0 
               and de-preco-dolar-item > d-vl-it-anexo then 
                   assign l-menor = no.
               else 
                   assign l-menor = yes.
            
               if l-menor then do: /* Item possue valor unit†rio menor ou igual a $50,00 */
                   IF  (i-num-col-descr   = 1  OR       /* uma coluna */
                        i-num-col-descr   = 2) AND      /* duas colunas */
                       (i-idi-forma-descr = 1  OR       /* item */
                        i-idi-forma-descr = 3) THEN DO: /* ambos */
            
                       FIND ITEM NO-LOCK WHERE 
                            ITEM.it-codigo = tt-it-proc-siscomex.it-codigo NO-ERROR.
            
                       IF AVAIL ITEM THEN  
                          ASSIGN c-descricao = ITEM.descricao-1 + item.descricao-2.
                    
                       CASE i-idi-forma-descr:
                           WHEN 1 THEN DO:
                               if l-automatico then do:
                                    RUN pi-cria-descricao-aut ( INPUT c-descricao, INPUT de-faturada,
                                                                INPUT (IF i-num-col-descr = 1 THEN 9 ELSE 18)).  /* n£mero de linhas */
                               end.                                      
                               else do:
                                  run pi-cria-descricao-man (input de-faturada).                                  
                               end.   
                           END.
                           WHEN 3 THEN DO:
                               if l-automatico then do:
                                  RUN pi-cria-descricao-aut ( INPUT c-descricao, INPUT de-faturada,
                                                              INPUT (IF i-num-col-descr  = 1 THEN 
                                                                     9 ELSE 16)).  /* Dranka n£mero de linhas */
                               end.
                               else do: 
                                  run pi-cria-descricao-man (input de-faturada).                                  
                               end.
                           END.
                       END CASE.
                       


                   END.
            
                   IF (i-num-col-descr   = 1  OR 
                       i-num-col-descr   = 2) AND 
                       i-idi-forma-descr = 2 THEN DO:
            
                       if first-of(tt-it-proc-siscomex.class-fiscal) or
                          first-of(tt-it-proc-siscomex.un) then do:
                          assign i-cont = i-cont + 1.
                       end.
                       if i-cont = 0 then i-cont = 1. /*dranka*/

                       ASSIGN de-tot-fatur = de-tot-fatur + de-faturada.
                    
                       if  l-automatico then do:
                            assign tt-it-proc-siscomex.num-grp-item = i-cont.
    
                       end.
                    
                       IF  LAST-OF (tt-it-proc-siscomex.class-fiscal) or 
                           LAST-OF (tt-it-proc-siscomex.un) THEN DO:
                                                
                           FIND classif-fisc NO-LOCK 
                                WHERE classif-fisc.class-fiscal = tt-it-proc-siscomex.class-fiscal NO-ERROR.
            
                           IF AVAIL classif-fisc THEN
                              ASSIGN c-descricao = classif-fisc.descricao.
            
                           if l-automatico then do:
    
                              CREATE tt-descricao.
                              ASSIGN tt-descricao.cod-estabel        = tt-it-proc-siscomex.cod-estabel
                                     tt-descricao.nr-proc-siscomex   = tt-it-proc-siscomex.nr-proc-siscomex
                                     tt-descricao.class-fiscal       = tt-it-proc-siscomex.class-fiscal
                                     tt-descricao.un                 = tt-it-proc-siscomex.un
                                     tt-descricao.it-codigo          = tt-it-proc-siscomex.it-codigo
                                     tt-descricao.quantidade         = de-tot-fatur
                                     tt-descricao.descricao          = c-descricao
                                     tt-descricao.num-grp-item       = tt-it-proc-siscomex.num-grp-item.
                                
                           end.
                           else do:
                              run pi-cria-descricao-man (input de-tot-fatur).                                  
                           end.
                        
                           if not l-automatico then
                              assign tt-descricao.num-grp-item = tt-it-proc-siscomex.num-grp-item.
      
                           assign de-tot-fatur = 0.
                           
                       END.
                       
                   END.
                   assign l-prim-item = no.
               end.
               else do:
                   create tt-it-proc-siscomex-aux.
                   buffer-copy tt-it-proc-siscomex to tt-it-proc-siscomex-aux.
                   assign tt-it-proc-siscomex-aux.dec-1 = de-faturada.
               end.
               IF  LAST-OF (tt-it-proc-siscomex.class-fiscal) or 
                   LAST-OF (tt-it-proc-siscomex.un) THEN DO:
                       ASSIGN i-cont  = 0
                              i-cont2 = i-cont2 + 10.
               END.
            end.
        END.
        
        run pi-grava-extent (input i-num-col-descr, 
                             input i-idi-forma-descr,
                             input l-automatico,
                             input p-cod-estabel,
                             input p-nr-proc-siscomex,
                             input-output table tt-it-proc-siscomex,
                             input-output table tt-descricao).


        find last tt-it-proc-siscomex no-error.
        assign i-cont = tt-it-proc-siscomex.num-grp-item + 1.
        
                            
        for each tt-it-proc-siscomex-aux:
            find tt-it-proc-siscomex where
                 tt-it-proc-siscomex.cod-estabel  = tt-it-proc-siscomex-aux.cod-estabel and 
                 tt-it-proc-siscomex.nr-proc-siscomex  = tt-it-proc-siscomex-aux.nr-proc-siscomex and 
                 tt-it-proc-siscomex.num-grp-item = tt-it-proc-siscomex-aux.num-grp-item  and 
                 tt-it-proc-siscomex.class-fiscal = tt-it-proc-siscomex-aux.class-fiscal and 
                 tt-it-proc-siscomex.it-codigo    = tt-it-proc-siscomex-aux.it-codigo  and 
                 tt-it-proc-siscomex.un           = tt-it-proc-siscomex-aux.un
                 no-error.
            if avail tt-it-proc-siscomex-aux then do:
               assign tt-it-proc-siscomex.num-grp-item = i-cont
                      i-cont = i-cont + 1.
               
               find item where item.it-codigo =  tt-it-proc-siscomex-aux.it-codigo no-lock no-error.
               if not avail item then next.
               
               find classif-fisc where classif-fisc.class-fiscal = tt-it-proc-siscomex-aux.class-fiscal no-lock no-error.
               if not avail classif-fisc then next.
               
               if i-idi-forma-descr = 1 then
                   assign tt-it-proc-siscomex.dsl-mercad[1] =  string(tt-it-proc-siscomex-aux.dec-1)  + " "  + 
                                                               tt-it-proc-siscomex-aux.un    + " "  +
                                                               string(item.descricao-1 + item.descricao-2).
               else
                  assign tt-it-proc-siscomex.dsl-mercad[1] = string(tt-it-proc-siscomex-aux.dec-1)  + " "  + classif-fisc.descricao
                         tt-it-proc-siscomex.dsl-mercad[2] =  string(tt-it-proc-siscomex-aux.dec-1)  + " "  + 
                                               tt-it-proc-siscomex-aux.un    + " "  +
                                               string(item.descricao-1 + item.descricao-2).

            end.
        end.
        
        assign i-cont2 = 0 
               l-prim-item = yes.
        
        if valid-handle(h-bocx180) then do:
           delete procedure h-bocx180.
           assign h-bocx180 = ?.
        end.
       
        /* Fim ************************************  */ 
        
end procedure.

PROCEDURE pi-grava-extent:

        define input parameter i-num-col-descr   as integer NO-UNDO.
        define input parameter i-idi-forma-descr as integer NO-UNDO.
        define input parameter l-automatico      as logical NO-UNDO.
        define input parameter p-cod-estabel like it-proc-siscomex.cod-estabel           no-undo.
        define input parameter p-nr-proc-siscomex like it-proc-siscomex.nr-proc-siscomex no-undo.
        
        DEFINE INPUT-OUTPUT PARAMETER table for tt-it-proc-siscomex.
        DEFINE INPUT-OUTPUT PARAMETER table for tt-descricao.
        
        def var c-desc-aux as char format "x(75)" no-undo.
        def var c-espaco as char format "x(01)" no-undo.
        def var c-dif-espaco as int no-undo.
        
        /* gravar nos campo extent */
        
        IF (i-num-col-descr   = 1  or         /* uma coluna */
            i-num-col-descr   = 2) AND        /* duas colunas */
           (i-idi-forma-descr = 1  OR         /* forma descricao item */
            i-idi-forma-descr = 2) THEN DO:   /* forma descriá∆o ncm */
        
            IF  i-num-col-descr   = 2  AND       /* duas colunas */
                i-idi-forma-descr = 1  THEN DO:  /* item */
          
                FOR EACH tt-it-proc-siscomex
                   where tt-it-proc-siscomex.cod-estabel = p-cod-estabel
                     and tt-it-proc-siscomex.nr-proc-siscomex = p-nr-proc-siscomex
                      by tt-it-proc-siscomex.num-grp-item:
                      
                   assign i-cont  = 0 i-cont2 = 0.        
                    
                   if tt-it-proc-siscomex.num-grp-item <> 0 then do:       
                      for each tt-descricao 
                         where tt-descricao.cod-estabel = tt-it-proc-siscomex.cod-estabel
                           and tt-descricao.nr-proc-siscomex = tt-it-proc-siscomex.nr-proc-siscomex
                           and tt-descricao.class-fiscal = tt-it-proc-siscomex.class-fiscal
                           and tt-descricao.num-grp-item = tt-it-proc-siscomex.num-grp-item
                          /* and tt-descricao.it-codigo = tt-it-proc-siscomex.it-codigo */
                           and tt-descricao.un = tt-it-proc-siscomex.un :
                         assign i-cont = i-cont + 1.
                         if i-cont mod 2  = 1 then 
                            assign i-cont2 = i-cont2 + 1.                                                               

                         if i-cont2 = 0 then assign i-cont2 = 1. /*Condor*/
                         assign c-desc-aux = substring(string(tt-descricao.quantidade)  + " "  + 
                                             tt-descricao.un                  + " "  +
                                             tt-descricao.descricao,1,36).

                         if tt-it-proc-siscomex.dsl-mercad[i-cont2] = "" then do:
                            assign c-espaco = " "
                                   c-dif-espaco = 35 - length(c-desc-aux). 
                                   tt-it-proc-siscomex.dsl-mercad[i-cont2] = substring(c-desc-aux,1,35) + string(FILL(c-espaco,c-dif-espaco)) + " - ".
                         end.
                         else do:
                            assign tt-it-proc-siscomex.dsl-mercad[i-cont2] = tt-it-proc-siscomex.dsl-mercad[i-cont2] + substring(c-desc-aux,1,35).
                         end.
                      end.
                   end.
                   else do:
                      find first tt-descricao 
                         where tt-descricao.cod-estabel = tt-it-proc-siscomex.cod-estabel
                           and tt-descricao.nr-proc-siscomex = tt-it-proc-siscomex.nr-proc-siscomex
                           and tt-descricao.class-fiscal = tt-it-proc-siscomex.class-fiscal
                           and tt-descricao.num-grp-item = tt-it-proc-siscomex.num-grp-item
                          /* and tt-descricao.it-codigo = tt-it-proc-siscomex.it-codigo */
                           and tt-descricao.un = tt-it-proc-siscomex.un no-error.
                      if avail tt-descricao then     
                         assign c-desc-aux = substring(string(tt-descricao.quantidade)  + " "  + 
                                             tt-descricao.un                  + " "  +
                                             tt-descricao.descricao,1,36).

                         if i-cont2 = 0 then assign i-cont2 = 1. /*Condor*/
                         if tt-it-proc-siscomex.dsl-mercad[i-cont2] = "" then do:
                            assign c-espaco = " "
                                   c-dif-espaco = 35 - length(c-desc-aux). 
                                   tt-it-proc-siscomex.dsl-mercad[i-cont2] = substring(c-desc-aux,1,35) + string(FILL(c-espaco,c-dif-espaco)) + " - ".
                         end.
                         else do:
                            assign tt-it-proc-siscomex.dsl-mercad[i-cont2] = tt-it-proc-siscomex.dsl-mercad[i-cont2] + substring(c-desc-aux,1,35).
                         end.
                   end.  
                end.   
            end.
            else do: /* uma coluna e forma descriá∆o item ou ncm / duas colunas e forma descricao ncm*/
                FOR EACH tt-it-proc-siscomex
                   where tt-it-proc-siscomex.cod-estabel = p-cod-estabel
                     and tt-it-proc-siscomex.nr-proc-siscomex = p-nr-proc-siscomex
                      by tt-it-proc-siscomex.num-grp-item:
                   
                   assign i-cont = 0.        

                   if tt-it-proc-siscomex.num-grp-item <> 0 then do: 
                      for each tt-descricao 
                         where tt-descricao.cod-estabel      = tt-it-proc-siscomex.cod-estabel
                           and tt-descricao.nr-proc-siscomex = tt-it-proc-siscomex.nr-proc-siscomex
                           and tt-descricao.class-fiscal     = tt-it-proc-siscomex.class-fiscal
                           and tt-descricao.num-grp-item     = tt-it-proc-siscomex.num-grp-item
                           /*and tt-descricao.it-codigo        = tt-it-proc-siscomex.it-codigo */
                           and tt-descricao.un               = tt-it-proc-siscomex.un :
                                  
                           assign i-cont = i-cont + 1.

                         if i-idi-forma-descr = 2 then do:
                            FIND classif-fisc NO-LOCK WHERE 
                                 classif-fisc.class-fiscal = tt-it-proc-siscomex.class-fiscal NO-ERROR.
                            IF AVAIL classif-fisc THEN
                               ASSIGN c-descricao = classif-fisc.descricao.
                         end. 
                         else assign c-descricao = tt-descricao.descricao.     
                         
                           assign c-desc-aux = string(tt-descricao.quantidade) + " " + 
                                             tt-descricao.un         + " " + 
                                             c-descricao
                                  tt-it-proc-siscomex.dsl-mercad[i-cont] = c-desc-aux.
                      end.  
                   end.
                   else do:
                      find first tt-descricao 
                         where tt-descricao.cod-estabel = tt-it-proc-siscomex.cod-estabel
                           and tt-descricao.nr-proc-siscomex = tt-it-proc-siscomex.nr-proc-siscomex
                           and tt-descricao.class-fiscal = tt-it-proc-siscomex.class-fiscal
                           and tt-descricao.num-grp-item = tt-it-proc-siscomex.num-grp-item
                          /* and tt-descricao.it-codigo = tt-it-proc-siscomex.it-codigo */
                           and tt-descricao.un = tt-it-proc-siscomex.un no-error.
                      if avail tt-descricao then do:
                           assign i-cont = i-cont + 1.


                           assign c-desc-aux = string(tt-descricao.quantidade) + " " + 
                                             tt-descricao.un         + " " + 
                                             c-descricao
                                  tt-it-proc-siscomex.dsl-mercad[i-cont] = c-desc-aux.
                      end.                                                     
                   end.  
                   
                end.
                
            end.
            
        end.
           
        IF (i-num-col-descr   = 1  or      /* uma coluna */
            i-num-col-descr   = 2) AND     /* duas colunas */
            i-idi-forma-descr = 3 THEN DO: /* ambos */
            
            FOR EACH tt-it-proc-siscomex
               where tt-it-proc-siscomex.cod-estabel = p-cod-estabel
                 and tt-it-proc-siscomex.nr-proc-siscomex = p-nr-proc-siscomex
                  by tt-it-proc-siscomex.num-grp-item:

               assign i-cont = 1 de-tot-fatur = 0.        
               
               if tt-it-proc-siscomex.num-grp-item <> 0 then do:
               
                  for each tt-descricao 
                     where tt-descricao.cod-estabel = tt-it-proc-siscomex.cod-estabel
                       and tt-descricao.nr-proc-siscomex = tt-it-proc-siscomex.nr-proc-siscomex
                       and tt-descricao.num-grp-item = tt-it-proc-siscomex.num-grp-item:
                     assign de-tot-fatur = de-tot-fatur + tt-descricao.quantidade.  
                  end.  
                  FIND classif-fisc NO-LOCK WHERE 
                       classif-fisc.class-fiscal = tt-it-proc-siscomex.class-fiscal NO-ERROR.
                  IF AVAIL classif-fisc THEN
                     ASSIGN c-descricao = classif-fisc.descricao.
                     assign tt-it-proc-siscomex.dsl-mercad[i-cont] = string(de-tot-fatur)   + " " +
                                                                     tt-it-proc-siscomex.un + " " + c-descricao.
               end.
               
               if i-num-col-descr = 1 and i-idi-forma-descr = 3 then do:
               
                  if tt-it-proc-siscomex.num-grp-item <> 0  then do:
                     for each tt-descricao 
                        where tt-descricao.cod-estabel = tt-it-proc-siscomex.cod-estabel
                          and tt-descricao.nr-proc-siscomex = tt-it-proc-siscomex.nr-proc-siscomex
                          and tt-descricao.class-fiscal = tt-it-proc-siscomex.class-fiscal
                          and tt-descricao.num-grp-item = tt-it-proc-siscomex.num-grp-item
                          and tt-descricao.un = tt-it-proc-siscomex.un: 
                        assign i-cont = i-cont + 1.
                        assign tt-it-proc-siscomex.dsl-mercad[i-cont] = string(tt-descricao.quantidade) + " " + 
                                                                        tt-descricao.un         + " " + 
                                                                        tt-descricao.descricao.
                     end.  
                  end.
                  else do:
                      find first tt-descricao 
                         where tt-descricao.cod-estabel = tt-it-proc-siscomex.cod-estabel
                           and tt-descricao.nr-proc-siscomex = tt-it-proc-siscomex.nr-proc-siscomex
                           and tt-descricao.class-fiscal = tt-it-proc-siscomex.class-fiscal
                           and tt-descricao.num-grp-item = tt-it-proc-siscomex.num-grp-item
                           /*and tt-descricao.it-codigo = tt-it-proc-siscomex.it-codigo */
                           and tt-descricao.un = tt-it-proc-siscomex.un no-error.
                      if avail tt-descricao then
                         assign tt-it-proc-siscomex.dsl-mercad[1] = string(tt-descricao.quantidade)  + " "  + 
                                                                           tt-descricao.un           + " "  + 
                                                                           tt-descricao.descricao    /*+ " - "*/.
                  end.   
                  
               end.
               else do:
               
                  assign i-cont2 = 1.        

                  if tt-it-proc-siscomex.num-grp-item <> 0 then do:
                         
                     for each tt-descricao 
                        where tt-descricao.cod-estabel = tt-it-proc-siscomex.cod-estabel
                          and tt-descricao.nr-proc-siscomex = tt-it-proc-siscomex.nr-proc-siscomex
                          and tt-descricao.class-fiscal = tt-it-proc-siscomex.class-fiscal
                          and tt-descricao.num-grp-item = tt-it-proc-siscomex.num-grp-item
                          and tt-descricao.un = tt-it-proc-siscomex.un: 
                                
                        assign i-cont = i-cont + 1.
                        if i-cont mod 2  = 0 then 
                           assign i-cont2 = i-cont2 + 1.
                                
                           assign c-desc-aux = substring(string(tt-descricao.quantidade)  + " "  + 
                                               tt-descricao.un                  + " "  +
                                               tt-descricao.descricao,1,36).

                           if tt-it-proc-siscomex.dsl-mercad[i-cont2] = "" then do:
                              assign c-espaco = " "
                                     c-dif-espaco = 35 - length(c-desc-aux). 
                                     tt-it-proc-siscomex.dsl-mercad[i-cont2] = substring(c-desc-aux,1,35) + string(FILL(c-espaco,c-dif-espaco)) + " - ".
                           end.
                           else do:
                              assign tt-it-proc-siscomex.dsl-mercad[i-cont2] = tt-it-proc-siscomex.dsl-mercad[i-cont2] + substring(c-desc-aux,1,35).
                           end.
                     end.                                                    
                  end.  
                  else do:
                  
                     find first tt-descricao 
                        where tt-descricao.cod-estabel = tt-it-proc-siscomex.cod-estabel
                          and tt-descricao.nr-proc-siscomex = tt-it-proc-siscomex.nr-proc-siscomex
                          and tt-descricao.class-fiscal = tt-it-proc-siscomex.class-fiscal
                          and tt-descricao.num-grp-item = tt-it-proc-siscomex.num-grp-item
                         /* and tt-descricao.it-codigo = tt-it-proc-siscomex.it-codigo */
                          and tt-descricao.un = tt-it-proc-siscomex.un no-error.
                     if avail tt-descricao then
                         assign c-desc-aux = substring(string(tt-descricao.quantidade)  + " "  + 
                                             tt-descricao.un                  + " "  +
                                             tt-descricao.descricao,1,36).

                         if i-cont2 = 0 then assign i-cont2 = 1. /*Condor*/
                         if tt-it-proc-siscomex.dsl-mercad[i-cont2] = "" then do:
                            assign c-espaco = " "
                                   c-dif-espaco = 35 - length(c-desc-aux). 
                                   tt-it-proc-siscomex.dsl-mercad[i-cont2] = substring(c-desc-aux,1,35) + string(FILL(c-espaco,c-dif-espaco)) + " - ".
                         end.
                         else do:
                            assign tt-it-proc-siscomex.dsl-mercad[i-cont2] = tt-it-proc-siscomex.dsl-mercad[i-cont2] + substring(c-desc-aux,1,35).
                         end.
                  end.
                  
               end.  /* else do */
               
            end.
           
        end.


end procedure.

PROCEDURE pi-cria-descricao-aut:

        DEF INPUT PARAMETER p-descricao  LIKE ITEM.desc-item NO-UNDO.
        DEF INPUT PARAMETER p-quantidade LIKE it-nota-fisc.qt-faturada[1] NO-UNDO.
        DEF INPUT PARAMETER p-linha      AS   INTEGER        NO-UNDO.

        
        assign i-cont = i-cont + 1.

        IF i-cont > p-linha THEN 
           ASSIGN i-cont2 = i-cont2 + 10
                  i-cont  = 1.

        ASSIGN c-num-grupo = STRING(i-cont2).
                    
        CREATE tt-descricao.
        ASSIGN tt-descricao.cod-estabel   = tt-it-proc-siscomex.cod-estabel
               tt-descricao.nr-proc-siscomex   = tt-it-proc-siscomex.nr-proc-siscomex
               tt-descricao.class-fiscal  = tt-it-proc-siscomex.class-fiscal
               tt-descricao.un            = tt-it-proc-siscomex.un
               tt-descricao.it-codigo     = tt-it-proc-siscomex.it-codigo
               tt-descricao.quantidade    = p-quantidade
               tt-descricao.descricao     = p-descricao.

          IF i-cont2 <=  90 THEN
             ASSIGN tt-descricao.num-grp-item  = INT(SUBSTRING(c-num-grupo,1,1)).
          ELSE IF i-cont2  >  90 AND i-cont2 <=  900 THEN
             ASSIGN tt-descricao.num-grp-item  = INT(SUBSTRING(c-num-grupo,1,2)).
          ELSE IF i-cont2  > 900 AND i-cont2 <= 9000 THEN
             ASSIGN tt-descricao.num-grp-item  = INT(SUBSTRING(c-num-grupo,1,3)).
        
        assign tt-it-proc-siscomex.num-grp-item = tt-descricao.num-grp-item.

        
END PROCEDURE.


PROCEDURE retornaValorDolar:

define input  parameter de-vl-fob           as decimal                no-undo.
define input  parameter i-mo-codigo-ped     like ped-venda.mo-codigo  no-undo.
define input  parameter d-data-emissao      like nota-fiscal.dt-emis no-undo.
define output parameter de-preco-item-dolar as decimal                no-undo.

        find first moeda where 
                   moeda.cod-decex = 220 no-lock no-error.
        if avail moeda then
            assign i-mo-codigo-dolar = moeda.mo-codigo.
                   
     
        run cdp/cd0812.p (input  i-mo-codigo-ped,
                          input  i-mo-codigo-dolar,
                          input  de-vl-fob,
                          input  d-data-emissao,
                          output de-preco-item-dolar).
                          
                        
END.


PROCEDURE pi-cria-descricao-man:

        DEF INPUT PARAMETER p-quantidade LIKE it-nota-fisc.qt-faturada[1] NO-UNDO.

        find first b-tt-it-proc-siscomex 
             where b-tt-it-proc-siscomex.num-grp-item = 0 no-error.
             
        if avail b-tt-it-proc-siscomex then do: 

           find first tt-descricao 
                where tt-descricao.cod-estabel   = tt-it-proc-siscomex.cod-estabel 
                  and tt-descricao.nr-proc-siscomex   = tt-it-proc-siscomex.nr-proc-siscomex
                  and tt-descricao.class-fiscal  = tt-it-proc-siscomex.class-fiscal
                  and tt-descricao.num-grp-item  = tt-it-proc-siscomex.num-grp-item
                  and tt-descricao.it-codigo     = tt-it-proc-siscomex.it-codigo
                  and tt-descricao.un            = tt-it-proc-siscomex.un           no-error.
           if not avail tt-descricao then do:

              CREATE tt-descricao.
              ASSIGN tt-descricao.cod-estabel   = tt-it-proc-siscomex.cod-estabel
                     tt-descricao.nr-proc-siscomex   = tt-it-proc-siscomex.nr-proc-siscomex
                     tt-descricao.class-fiscal  = tt-it-proc-siscomex.class-fiscal
                     tt-descricao.un            = tt-it-proc-siscomex.un
                     tt-descricao.quantidade    = p-quantidade
                     tt-descricao.descricao     = c-descricao
                     tt-descricao.it-codigo     = tt-it-proc-siscomex.it-codigo
                     tt-descricao.num-grp-item  = tt-it-proc-siscomex.num-grp-item.
               
           end.

        end.          

END PROCEDURE.

procedure AtualizaItens:

        define input parameter table for tt-it-proc-siscomex.
        
        find first tt-it-proc-siscomex no-error.
        
        def var i as integer no-undo.

        if avail tt-it-proc-siscomex then do:
        
           for each it-proc-siscomex exclusive-lock
              where it-proc-siscomex.cod-estabel  = tt-it-proc-siscomex.cod-estabel
                and it-proc-siscomex.nr-proc-siscomex  = tt-it-proc-siscomex.nr-proc-siscomex
                and it-proc-siscomex.num-grp-item = tt-it-proc-siscomex.num-grp-item
                and it-proc-siscomex.class-fiscal = tt-it-proc-siscomex.class-fiscal
                and it-proc-siscomex.un           = tt-it-proc-siscomex.un:
                
              do i = 1 to 10:
                 assign it-proc-siscomex.dsl-mercad[i] = tt-it-proc-siscomex.dsl-mercad[i].                 
              end.   
              do i = 1 to 10:
                 assign it-proc-siscomex.obs-export[i] = tt-it-proc-siscomex.obs-export[i].                 
              end.   

           end.
           
        end.

end procedure. 

procedure preencheItensGrupo:
    define input-output parameter table for tt-it-proc-siscomex.
    
    def var d-dec-perc-comis-agent like tt-it-proc-siscomex.dec-perc-comis-agent.
    def var i-idi-forma-pagto      like tt-it-proc-siscomex.idi-forma-pagto.
    def var c-cod-categ-textil     like tt-it-proc-siscomex.cod-categ-textil.
    
    def var d-dec-perc-comis-agent-aux like tt-it-proc-siscomex.dec-perc-comis-agent.
    def var i-idi-forma-pagto-aux      like tt-it-proc-siscomex.idi-forma-pagto.
    def var c-cod-categ-textil-aux     like tt-it-proc-siscomex.cod-categ-textil.
    for each tt-it-proc-siscomex break by 
             tt-it-proc-siscomex.num-grp-item:
       if first-of (tt-it-proc-siscomex.num-grp-item) then do:
          find first b-tt-it-proc-siscomex where 
                     b-tt-it-proc-siscomex.num-grp-item = tt-it-proc-siscomex.num-grp-item no-error.
          if avail b-tt-it-proc-siscomex then do:
               if   (b-tt-it-proc-siscomex.dec-perc-comis-agent <> 0 or
                     b-tt-it-proc-siscomex.idi-forma-pagto <> 1       or
                     b-tt-it-proc-siscomex.cod-categ-textil <> " ") then do:
                     assign d-dec-perc-comis-agent     = b-tt-it-proc-siscomex.dec-perc-comis-agent
                            i-idi-forma-pagto          = b-tt-it-proc-siscomex.idi-forma-pagto
                            c-cod-categ-textil         = b-tt-it-proc-siscomex.cod-categ-textil 
                            d-dec-perc-comis-agent-aux = b-tt-it-proc-siscomex.dec-perc-comis-agent
                            i-idi-forma-pagto-aux      = b-tt-it-proc-siscomex.idi-forma-pagto
                            c-cod-categ-textil-aux     = b-tt-it-proc-siscomex.cod-categ-textil.
               end.
               else do:
                     assign d-dec-perc-comis-agent     = d-dec-perc-comis-agent-aux
                            i-idi-forma-pagto          = i-idi-forma-pagto-aux
                            c-cod-categ-textil         = c-cod-categ-textil-aux.
               end.
           end.
           
       end.
       assign tt-it-proc-siscomex.dec-perc-comis-agent = d-dec-perc-comis-agent
              tt-it-proc-siscomex.idi-forma-pagto = i-idi-forma-pagto
              tt-it-proc-siscomex.cod-categ-textil = c-cod-categ-textil.
              
    end.
end.

procedure retornaDadosPedido:
        
def input  parameter c-nome-abrev like ped-venda.nome-abrev no-undo.
def input  parameter c-nr-pedcli  like ped-venda.nr-pedcli no-undo.
def output parameter i-mo-codigo like ped-venda.mo-codigo  no-undo.
def output  parameter c-local-entrega  as char no-undo.

find ped-venda where 
     ped-venda.nome-abrev = c-nome-abrev and
     ped-venda.nr-pedcli = c-nr-pedcli no-error.
if avail ped-venda then 
    assign i-mo-codigo = ped-venda.mo-codigo
           c-local-entrega = ped-venda.cod-entrega.

end.


procedure retornaDadosEmitente:

def input  parameter i-cod-emitente like emitente.cod-emitente no-undo.
def output parameter c-nome-emit  like emitente.nome-emit no-undo.
def output parameter c-endereco like emitente.endereco  no-undo.
def output  parameter c-cidade  like emitente.cidade no-undo.

find emitente where emitente.cod-emitente = i-cod-emitente no-error.
if avail emitente then
   assign c-nome-emit = emitente.nome-emit
          c-endereco = emitente.endereco
          c-cidade = emitente.cidade.


end.

procedure chama-epc:

run startMethod ("chama-epc").
                
find first rowObject no-error.

  /** EPC - Inicio **/
  for each tt-epc where tt-epc.cod-event = "ModificaItem": 
      delete tt-epc. 
  end.
  
  IF c-nom-prog-upc-mg97 <> "" THEN DO:
        /* Criando registro da EPC */
        {include/i-epc200.i2 &CodEvent='"ModificaItem"'
                             &CodParameter='"cod-estabel"'
                             &ValueParameter="string(rowObject.cod-estabel)" }

        {include/i-epc200.i2 &CodEvent='"ModificaItem"'
                             &CodParameter='"nr-proc-siscomex"'
                             &ValueParameter="string(rowObject.nr-proc-siscomex)" }

        {include/i-epc200.i2 &CodEvent='"ModificaItem"'
                             &CodParameter='"num-grp-item"'
                             &ValueParameter="string(rowObject.num-grp-item)" }
        
        {include/i-epc200.i2 &CodEvent='"ModificaItem"'
                             &CodParameter='"class-fiscal"'
                             &ValueParameter="string(rowObject.class-fiscal)" }

        {include/i-epc200.i2 &CodEvent='"ModificaItem"'
                             &CodParameter='"it-codigo"'
                             &ValueParameter="string(rowObject.it-codigo)" }
                             
        {include/i-epc200.i2 &CodEvent='"ModificaItem"'
                             &CodParameter='"un"'
                             &ValueParameter="string(rowObject.un)" }
                             
        {include/i-epc200.i2 &CodEvent='"ModificaItem"'
                             &CodParameter='"qt-item"'
                             &ValueParameter="string(rowObject.dec-1)" }

        {include/i-epc200.i2 &CodEvent='"ModificaItem"'
                             &CodParameter='"vl-item"'
                             &ValueParameter="string(rowObject.dec-2)" }                                   

        {include/i-epc200.i2 &CodEvent='"ModificaItem"'
                             &CodParameter='"table-rowid"'
                             &ValueParameter="string(rowObject.r-rowid)" }                                   
  END.

  run endMethod ("chama-epc").

end.
procedure getCharFieldDet.

        def input  parameter i-extent as integer no-undo.
        def input  parameter c-field  as char    no-undo.
        def output parameter c-value  as char    no-undo.
        
        find first ttRowObjectDet no-lock
             where ttRowObjectDet.id = i-extent no-error.
             
        if avail ttRowObjectDet then
        do:
            case c-field:
                when "cgc" then c-value = ttRowObjectDet.cgc.
                when "class-fiscal-fabrican" then c-value = ttRowObjectDet.class-fiscal-fabrican.
                when "estado" then c-value = ttRowObjectDet.estado.
                when "nome-abrev" then c-value = ttRowObjectDet.nome-abrev.
                when "nr-ato-concessorio" then c-value = ttRowObjectDet.nr-ato-concessorio.
                otherwise return error.
            end case.
        end.

end procedure.

procedure getDecFieldDet.

        def input  parameter i-extent as integer no-undo.
        def input  parameter c-field  as char    no-undo.
        def output parameter c-value  as dec    no-undo.
        
        find first ttRowObjectDet no-lock
             where ttRowObjectDet.id = i-extent no-error.
             
        if avail ttRowObjectDet then
        do:
            case c-field:
                when "qtd-fabrican" then c-value = ttRowObjectDet.qtd-fabrican.
                when "valor-fabrican" then c-value = ttRowObjectDet.valor-fabrican.
                otherwise return error.
            end case.
        end.

end procedure.

procedure getIntFieldDet.

        def input  parameter i-extent as integer no-undo.
        def input  parameter c-field  as char    no-undo.
        def output parameter c-value  as integer no-undo.
        
        find first ttRowObjectDet no-lock
             where ttRowObjectDet.id = i-extent no-error.
             
        if avail ttRowObjectDet then
        do:
            case c-field:
                when "cod-fabrican" then c-value = ttRowObjectDet.cod-fabrican.
                otherwise return error.
            end case.
        end.

end procedure.

procedure getCharField:

        define input  parameter c-field as char.
        define output parameter c-value as char.
 
        case c-field:
            when "char-1" then c-value = RowObject.char-1.
            when "char-2" then c-value = RowObject.char-2.
            when "cod-estabel" then c-value = RowObject.cod-estabel.
            when "nr-proc-siscomex" then c-value = RowObject.nr-proc-siscomex.
            when "class-fiscal" then c-value = RowObject.class-fiscal.
            when "it-codigo" then c-value = RowObject.it-codigo.
            when "un" then c-value = RowObject.un.
            when "cod-categ-textil" then c-value = rowobject.cod-categ-textil.
            otherwise return error.
        end case.
        
end procedure.
 
procedure getDecField:
        define input  parameter c-field as char.
        define output parameter c-value as decimal.
 
        case c-field:
             when "dec-1" then c-value = RowObject.dec-1.
             when "dec-2" then c-value = RowObject.dec-2.
             otherwise return error.
        end case.
        
end procedure.
 
procedure getIntField:

        define input  parameter c-field as char.
        define output parameter c-value as integer.
 
        case c-field:
            when "num-grp-item" then c-value = RowObject.num-grp-item.
            when "idi-forma-pagto" then c-value = RowObject.idi-forma-pagto.
            otherwise return error.
        end case.
        
end procedure.
 
procedure getDateField:
        define input  parameter c-field as char.
        define output parameter c-value as date.
 
        case c-field:
            when "data-1" then c-value = RowObject.data-1.
            when "data-2" then c-value = RowObject.data-2.
            when "dt-valid-embarq" then c-value = RowObject.dt-valid-embarq.
            otherwise return error.
        end case.
end procedure.
 
procedure getLogField:
        define input  parameter c-field as char.
        define output parameter c-value as logical.
 
        case c-field:
            when "log-1" then c-value = RowObject.log-1.
            when "log-2" then c-value = RowObject.log-2.
            otherwise return error.
        end case.
end procedure.


procedure acertadiferencatotal:
    define input  parameter pde-vl-tot-item as dec format "->>,>>>,>>>,>>9.99" no-undo.
    define input  parameter pde-vl-tot-nota as dec format "->>,>>>,>>>,>>9.99" no-undo.

    if pde-vl-tot-nota > pde-vl-tot-item then
        assign de-diferenca =  pde-vl-tot-nota - pde-vl-tot-item.
        
end procedure.

procedure retornaDiferencaValor:
    define output parameter pde-diferenca as dec format "->>,>>>,>>>,>>9.99" no-undo.

    assign pde-diferenca = de-diferenca.

end procedure.
