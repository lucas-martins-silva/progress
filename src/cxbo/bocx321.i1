define temp-table tt-it-proc-siscomex like rowobject.
define temp-table tt-it-proc-siscomex-aux like rowobject.
define temp-table tt-item like rowobject.
 
DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

define buffer bf{&TABLE-NAME} for it-proc-siscomex.
define buffer b-tt-it-proc-siscomex for tt-it-proc-siscomex.

define temp-table tt-descricao 
    field cod-estabel  like it-proc-siscomex.cod-estabel
    field nr-proc-siscomex  like it-proc-siscomex.nr-proc-siscomex
    FIELD num-grp-item LIKE it-proc-siscomex.num-grp-item
    FIELD class-fiscal LIKE it-proc-siscomex.class-fiscal
    FIELD un           LIKE it-proc-siscomex.un
    field it-codigo    like it-proc-siscomex.it-codigo
    FIELD quantidade   LIKE it-nota-fisc.qt-faturada[1]
    FIELD descricao    LIKE ITEM.desc-item.

define temp-table tt-descricao-aux
    field cod-estabel  like it-proc-siscomex.cod-estabel
    field nr-proc-siscomex  like it-proc-siscomex.nr-proc-siscomex
    FIELD num-grp-item LIKE it-proc-siscomex.num-grp-item
    FIELD class-fiscal LIKE it-proc-siscomex.class-fiscal
    FIELD un           LIKE it-proc-siscomex.un
    field it-codigo    like it-proc-siscomex.it-codigo
    FIELD quantidade   LIKE it-nota-fisc.qt-faturada[1]
    FIELD descricao    LIKE ITEM.desc-item.

define temp-table ttRowObjectDet
    field r-Rowid               as rowid
    field id                    as integer
    field cod-fabrican          like it-proc-siscomex.cod-fabrican[1]
    field nome-abrev            like emitente.nome-abrev
    field cgc                   like emitente.cgc
    field estado                like emitente.estado
    field class-fiscal-fabrican like it-proc-siscomex.class-fiscal-fabrican[1]
    field nr-ato-concessorio    like it-proc-siscomex.nr-ato-concessorio[1]
    field qtd-fabrican          like it-proc-siscomex.qtd-fabrican[1]
    field valor-fabrican        like it-proc-siscomex.valor-fabrican[1].
    
define temp-table ttRowObjectDetRet like ttRowObjectDet. 

procedure setConstraint1:
 
end procedure.

procedure setConstraint2:

    def input parameter p-cod-estabel  like it-proc-siscomex.cod-estabel  no-undo.
    def input parameter p-nr-proc-siscomex  like it-proc-siscomex.nr-proc-siscomex  no-undo.

    assign c-cod-estabel  = p-cod-estabel
           c-nr-proc-siscomex  = p-nr-proc-siscomex.
 
end procedure.


PROCEDURE setConstraint3:

    def input parameter p-cod-estabel  like it-proc-siscomex.cod-estabel  no-undo.
    def input parameter p-nr-proc-siscomex  like it-proc-siscomex.nr-proc-siscomex  no-undo.
    def input parameter p-num-grupo    like it-proc-siscomex.num-grp-item no-undo.
    def input parameter p-class-fiscal like it-proc-siscomex.class-fiscal no-undo.
    def input parameter p-it-codigo    like it-proc-siscomex.it-codigo    no-undo.
    def input parameter p-un           like it-proc-siscomex.un           no-undo.
    
    assign c-cod-estabel  = p-cod-estabel
           c-nr-proc-siscomex  = p-nr-proc-siscomex
           i-num-grupo    = p-num-grupo
           c-class-fisc   = p-class-fiscal
           c-it-codigo    = p-it-codigo 
           c-un           = p-un.

END procEDURE.


PROCEDURE setConstraint4:

    def input parameter p-cod-estabel-ini like it-proc-siscomex.cod-estabel  no-undo.
    def input parameter p-cod-estabel-fim like it-proc-siscomex.cod-estabel  no-undo.
    def input parameter p-nr-proc-siscomex-ini like it-proc-siscomex.nr-proc-siscomex  no-undo.
    def input parameter p-nr-proc-siscomex-fim like it-proc-siscomex.nr-proc-siscomex  no-undo.
    def input parameter p-num-grupo-ini   like it-proc-siscomex.num-grp-item no-undo.
    def input parameter p-num-grupo-fim   like it-proc-siscomex.num-grp-item no-undo.
    def input parameter p-class-fisc-ini  like it-proc-siscomex.class-fiscal no-undo.
    def input parameter p-class-fisc-fim  like it-proc-siscomex.class-fiscal no-undo.
    def input parameter p-it-codigo-ini   like it-proc-siscomex.it-codigo    no-undo.
    def input parameter p-it-codigo-fim   like it-proc-siscomex.it-codigo    no-undo.
    def input parameter p-un-ini          like it-proc-siscomex.un           no-undo.
    def input parameter p-un-fim          like it-proc-siscomex.un           no-undo.

    assign c-cod-estabel-ini  = p-cod-estabel-ini
           c-cod-estabel-fin  = p-cod-estabel-fim
           c-nr-proc-siscomex-ini  = p-nr-proc-siscomex-ini
           c-nr-proc-siscomex-fin  = p-nr-proc-siscomex-fim
           i-num-grupo-ini    = p-num-grupo-ini
           i-num-grupo-fim    = p-num-grupo-fim
           c-class-fisc-ini   = p-class-fisc-ini
           c-class-fisc-fim   = p-class-fisc-fim
           c-it-codigo-ini    = p-it-codigo-fim
           c-un-ini           = p-un-ini
           c-un-fim           = p-un-fim.

END PROCEDURE.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
        when 2 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} where it-proc-siscomex.cod-estabel   = c-cod-estabel and ~
                                                                  it-proc-siscomex.nr-proc-siscomex   = c-nr-proc-siscomex NO-LOCK.
        when 3 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} where it-proc-siscomex.cod-estabel  >= c-cod-estabel and ~
                                                                  it-proc-siscomex.nr-proc-siscomex  >= c-nr-proc-siscomex and ~
                                                                  it-proc-siscomex.num-grp-item >= i-num-grupo   and ~
                                                                  it-proc-siscomex.class-fiscal >= c-class-fisc  and ~
                                                                  it-proc-siscomex.it-codigo    >= c-it-codigo   and ~
                                                                  it-proc-siscomex.un           >= c-un no-lock.
        when 4 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} 
                                            where it-proc-siscomex.cod-estabel  >= c-cod-estabel-ini and 
                                                  it-proc-siscomex.cod-estabel  <= c-cod-estabel-fin and
                                                  it-proc-siscomex.nr-proc-siscomex  >= c-nr-proc-siscomex-ini and
                                                  it-proc-siscomex.nr-proc-siscomex  <= c-nr-proc-siscomex-fin and
                                                  it-proc-siscomex.num-grp-item >= i-num-grupo-ini   and 
                                                  it-proc-siscomex.num-grp-item <= i-num-grupo-fim   and 
                                                  it-proc-siscomex.class-fiscal >= c-class-fisc-ini  and 
                                                  it-proc-siscomex.class-fiscal <= c-class-fisc-fim  and 
                                                  it-proc-siscomex.it-codigo    >= c-it-codigo-ini   and 
                                                  it-proc-siscomex.it-codigo    <= c-it-codigo-fim   and 
                                                  it-proc-siscomex.un           >= c-un-ini          and
                                                  it-proc-siscomex.un           <= c-un-fim  no-lock.
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.
 
