define var c-cod-estabel          like proc-siscomex.cod-estabel     no-undo.
define var c-nr-proc-siscomex     like proc-siscomex.nr-proc-exp     no-undo.
define var i-num-grupo            like it-proc-siscomex.num-grp-item no-undo.
define var c-class-fisc           like it-proc-siscomex.class-fiscal no-undo.
define var c-un                   like it-proc-siscomex.un           no-undo.
define var c-it-codigo            like it-proc-siscomex.it-codigo    no-undo.
define var l-leave                as logical                         no-undo.
define var i-mo-codigo-ped        like ped-venda.mo-codigo           no-undo.
define var d-data-emissao         like nota-fiscal.dt-emis.
define var l-prim-item            as log initial yes                 no-undo.
define var i-mo-codigo-dolar      like moeda.mo-codigo               no-undo.
define var de-preco-item-dolar    as decimal                         no-undo.
define var i-cont3                as integer                         no-undo.
define var de-preco-dolar-item    as decimal                         no-undo.
define var l-menor                as logical initial yes             no-undo.

define var c-cod-estabel-ini      like proc-siscomex.cod-estabel      no-undo.
define var c-cod-estabel-fin      like proc-siscomex.cod-estabel      no-undo.
define var c-nr-proc-siscomex-ini like proc-siscomex.nr-proc-exp      no-undo.
define var c-nr-proc-siscomex-fin like proc-siscomex.nr-proc-exp      no-undo.
define var i-num-grupo-ini        like it-proc-siscomex.num-grp-item  no-undo.
define var i-num-grupo-fim        like it-proc-siscomex.num-grp-item  no-undo.
define var c-class-fisc-ini       like it-proc-siscomex.class-fiscal  no-undo.
define var c-class-fisc-fim       like it-proc-siscomex.class-fiscal  no-undo.
define var c-it-codigo-ini        like it-proc-siscomex.it-codigo     no-undo.
define var c-it-codigo-fim        like it-proc-siscomex.it-codigo     no-undo.
define var c-un-ini               like it-proc-siscomex.un            no-undo.
define var c-un-fim               like it-proc-siscomex.un            no-undo.
define var de-qt-devol            like devol-cli.qt-devolvida         no-undo.
define var de-vl-devol            like devol-cli.vl-devol             no-undo.
define var i-cont                 as integer                          no-undo.
define var i-cont2                as integer                          no-undo.
define var c-num-grupo            as character                        no-undo.
                                                                
define var c-descricao            like classif-fisc.descricao         no-undo.
define var de-faturada            like it-nota-fisc.qt-faturada[1]    no-undo.
define var de-vl-fob              like it-nota-fisc.vl-tot-item       no-undo.
define var de-vl-venda            like it-nota-fisc.vl-tot-item       no-undo.
define var de-peso-liq            like it-nota-fisc.peso-liq-fat      no-undo.
define var de-tot-fatur           like it-nota-fisc.qt-faturada[1]    no-undo.
define var de-faturada-aux        like it-nota-fisc.qt-faturada[1]    no-undo.
define var de-vl-fob-aux          like it-nota-fisc.vl-tot-item       no-undo.
define var de-vl-venda-aux        like it-nota-fisc.vl-tot-item       no-undo.
define var de-peso-liq-aux        like it-nota-fisc.peso-liq-fat      no-undo.
define var de-vl-tot-item         like it-nota-fisc.vl-tot-item       no-undo.
define var de-diferenca           as   decimal format "->,>>>,>>>,>>9.99" no-undo.
        
&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.04.00.000
