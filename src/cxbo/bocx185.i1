define var c-cod-estabel-fim like processo-exp.cod-estabel no-undo.
define var c-nr-proc-exp-ini like processo-exp.nr-proc-exp no-undo.
define var c-nr-proc-exp-fim like processo-exp.nr-proc-exp no-undo.
