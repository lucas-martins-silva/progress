&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/
    IF pType = "CREATE" OR 
        pType = "COPY"  THEN DO:
        IF CAN-FIND (FIRST nve-atrib
                     WHERE nve-atrib.idi-niv      = RowObject.idi-niv      
                     AND   nve-atrib.cod-ident    = RowObject.cod-ident    
                     AND   nve-atrib.cod-atributo = RowObject.cod-atributo) THEN
            /* Inicio -- Projeto Internacional */
            DO:
            DEFINE VARIABLE c-lbl-liter-nve-atributo AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "NVE_Atributo" *}
            ASSIGN c-lbl-liter-nve-atributo = TRIM(RETURN-VALUE).
            {method/svc/errors/inserr.i
                  &ErrorNumber="1"
                  &ErrorType="EMS"
                  &ErrorParameters="c-lbl-liter-nve-atributo"}
            END. 

    END.   

    IF RowObject.cod-atributo = "" THEN
        /* Inicio -- Projeto Internacional */
        DO:
        DEFINE VARIABLE c-lbl-liter-codigo-atributo-deve-ser-infor AS CHARACTER NO-UNDO.
        {utp/ut-liter.i "C¢digo_Atributo_deve_ser_informado" *}
        ASSIGN c-lbl-liter-codigo-atributo-deve-ser-infor = TRIM(RETURN-VALUE).
        {method/svc/errors/inserr.i
              &ErrorNumber="17006"
              &ErrorType="EMS"
              &ErrorParameters="c-lbl-liter-codigo-atributo-deve-ser-infor + '!'"}
        END. 
              
    IF RowObject.des-atributo = "" THEN
        /* Inicio -- Projeto Internacional */
        DO:
        DEFINE VARIABLE c-lbl-liter-descricao-atributo-deve-ser-in AS CHARACTER NO-UNDO.
        {utp/ut-liter.i "Descriá∆o_Atributo_deve_ser_informado" *}
        ASSIGN c-lbl-liter-descricao-atributo-deve-ser-in = TRIM(RETURN-VALUE).
        {method/svc/errors/inserr.i
              &ErrorNumber="17006"
              &ErrorType="EMS"
              &ErrorParameters="c-lbl-liter-descricao-atributo-deve-ser-in + '!'"}
        END. 
              
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

