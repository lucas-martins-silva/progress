&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice nveatrib-id
  Parameters:  
               recebe valor do campo idi-niv
               recebe valor do campo cod-ident
               recebe valor do campo cod-atributo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pidi-niv LIKE nve-atrib.idi-niv NO-UNDO.
    DEFINE INPUT PARAMETER pcod-ident LIKE nve-atrib.cod-ident NO-UNDO.
    DEFINE INPUT PARAMETER pcod-atributo LIKE nve-atrib.cod-atributo NO-UNDO.

    FIND FIRST bfnve-atrib WHERE 
        bfnve-atrib.idi-niv = pidi-niv AND 
        bfnve-atrib.cod-ident = pcod-ident AND 
        bfnve-atrib.cod-atributo = pcod-atributo NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfnve-atrib THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfnve-atrib)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryByIdentif DBOProgram 
PROCEDURE openQueryByIdentif :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
OPEN QUERY {&QUERYNAME} FOR EACH {&TABLENAME} NO-LOCK 
                            WHERE {&TABLENAME}.idi-niv   = i-idi-niv   
                            AND   {&TABLENAME}.cod-ident = c-cod-ident INDEXED-REPOSITION.


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

