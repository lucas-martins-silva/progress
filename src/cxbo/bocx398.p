&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE pi-verifica-especif DBOProgram 
PROCEDURE pi-verifica-especif :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
DEFINE INPUT  PARAMETER pidi-niv   LIKE nve-atrib.idi-niv      NO-UNDO.
DEFINE INPUT  PARAMETER pcod-ident LIKE nve-atrib.cod-ident    NO-UNDO.
DEFINE INPUT  PARAMETER pcod-atrib LIKE nve-atrib.cod-atributo NO-UNDO.
DEFINE OUTPUT PARAMETER l-retorno  AS LOGICAL                  NO-UNDO.

IF CAN-FIND(FIRST nve-especif
            WHERE nve-especif.idi-niv      = pidi-niv       
            AND   nve-especif.cod-ident    = pcod-ident     
            AND   nve-especif.cod-atributo = pcod-atrib ) THEN
    ASSIGN l-retorno = YES.
ELSE
    ASSIGN l-retorno = NO.


RETURN "OK":U.
END PROCEDURE.

