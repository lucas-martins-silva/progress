DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

DEF VAR l-not-createupdate     AS LOGICAL INITIAL NO NO-UNDO.
DEF VAR l-not-validatepedvenda AS LOGICAL INITIAL NO NO-UNDO.
def var c-data-prof            as char               no-undo.

DEF VAR c-aux                  AS CHAR               NO-UNDO.

procedure setConstraint1:

end procedure.


procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
    end case.
    assign l-query = true
           i-bo-query = i-abertura.
    
end procedure.

