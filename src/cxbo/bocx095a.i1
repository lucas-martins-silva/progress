/********************************************************************************
**
**  BOCX095A.i1 - API de Calculo das despesas de importacao (desp-imp)
**
*/
/****************** Definicao Tabelas Temporarias ******************************/
{cxbo/bocx095a.i}
{cxbo/bocx095b.i}

/****************** Definicao Parametros ***************************************/
def input  parameter table for tt-parametros.
def input  parameter table for tt-parametros-imp.
def input  parameter table for tt-parametros-exp.
def output parameter d-valor-despesa like desp-imp.val-desp no-undo.
def output parameter table for tt-erro.

&if "{&bf_mat_versao_ems}":U < "2.062":U &then

def var de-tot-pa       like prazo-compra.quantidade no-undo.
def var de-preco-unit   like cotacao-item.preco-unit no-undo.
def var de-pre-unit-for like cotacao-item.pre-unit-for no-undo.

/****************** Execucao **************************************************/
find first tt-parametros no-error.
find first tt-parametros-imp no-error.
find first tt-parametros-exp no-error.

if tt-parametros.cod-versao-integracao <> 2 then do:
    run utp/ut-msgs.p (input "msg":U,
                       input 3941,
                       input "").
    create tt-erro.
    assign tt-erro.i-sequen = 1
           tt-erro.cd-erro  = 3941
           tt-erro.mensagem = return-value.    
    return.           
end.

for each tt-pendentes-095:
    delete tt-pendentes-095.
end.

if substring(tt-parametros.modulo,1,3) = "imp":U then do:
    find ordem-compra no-lock
        where ordem-compra.numero-ordem = tt-parametros-imp.numero-ordem  no-error.
    if avail ordem-compra then do:
        for each prazo-compra no-lock 
            where prazo-compra.numero-ordem = ordem-compra.numero-ordem:
            assign de-tot-pa = de-tot-pa + prazo-compra.quantidade.
        end.
        &if defined(bf-mat-comex) &then           
            assign tt-parametros.qt-solic = de-tot-pa.   
        &else
            assign tt-parametros.qt-solic = ordem-compra.qt-solic.     
        &endif
        assign tt-parametros.quantidade = de-tot-pa.
    end.
    find cotacao-item no-lock
        where cotacao-item.numero-ordem = tt-parametros-imp.numero-ordem
          and cotacao-item.cod-emitente = tt-parametros.cod-emitente
          and cotacao-item.it-codigo    = tt-parametros-imp.it-codigo
          &if defined(bf-mat-comex) &then
              and cotacao-item.data-cotacao = tt-parametros-imp.data
          &else
              and cotacao-item.seq-cotac    = tt-parametros-imp.seq-cotac
          &endif
          no-error.
    if avail cotacao-item then do:
        assign de-preco-unit   = cotacao-item.preco-unit
               de-pre-unit-for = cotacao-item.pre-unit-for.
        if cotacao-item.mo-codigo <> 0 then do:            
            run cdp/cd0812.p (input cotacao-item.mo-codigo,
                              input 0,
                              input cotacao-item.preco-unit,
                              input today,
                              output de-preco-unit).
            if de-preco-unit = 0 or
               de-preco-unit = ? then
                assign de-preco-unit = cotacao-item.preco-unit.               
            run cdp/cd0812.p (input cotacao-item.mo-codigo,
                              input 0,
                              input cotacao-item.pre-unit-for,
                              input today,
                              output de-pre-unit-for).
            if de-pre-unit-for = 0 or
               de-pre-unit-for = ? then
                assign de-pre-unit-for = cotacao-item.pre-unit-for.
        end.
        assign de-preco-unit   = (de-preco-unit * 100) / (100 + cotacao-item.aliquota-ipi)
               de-pre-unit-for = (de-pre-unit-for * 100) / (100 + cotacao-item.aliquota-ipi).        
        assign tt-parametros.valor        = de-preco-unit
               tt-parametros.pre-unit-for = de-pre-unit-for
               tt-parametros.valor-taxa   = cotacao-item.valor-taxa
               tt-parametros.nr-dias-taxa = cotacao-item.nr-dias-taxa
               tt-parametros-imp.cod-emitente = cotacao-item.cod-emitente.
    end.                       
    find item 
        where item.it-codigo = tt-parametros-imp.it-codigo 
        no-lock no-error.
    if avail item then
        assign tt-parametros.peso   = item.peso-bruto
               tt-parametros.volume = item.altura *
                                      item.comprim * 
                                      item.largura.
end.

if avail tt-parametros then do:           
    find desp-imp no-lock
        where desp-imp.cod-desp = tt-parametros.cod-desp no-error.
    if avail desp-imp then
        run cxbo/bocx095b.p (input table tt-parametros,
                             input table tt-parametros-imp,
                             input table tt-parametros-exp,
                             output d-valor-despesa,
                             output table tt-erro).
end.

for each tt-pendentes-095:
    delete tt-pendentes-095.
end.

&endif  /* "{&bf_mat_versao_ems}":U < "2.062":U */

/* BOCX095A.I1 */
