/* bocx140.i02                                          */
/* Criada em 25/05/2004 - Eliza F.C.                    */
/* Include para tratar re-planejamento das parcelas no 
   MRP, conforme atividade 116178                       */

if can-find (first historico-proc-imp where 
                   historico-proc-imp.cod-estabel = {&table-name}.cod-estabel  and
                   historico-proc-imp.nr-proc-imp = {&table-name}.nr-proc-imp) then do:

      &if "{&bf_mat_versao_ems}":U >= "2.062":U &then
      run cxbo/bocx351.p persistent set h-bocx351.
      &endif

      for each  ordem-compra 
          where ordem-compra.num-pedido = {&table-name}.num-pedido no-lock,
          each  prazo-compra 
          where prazo-compra.numero-ordem = ordem-compra.numero-ordem exclusive-lock:
                    
          /* Licenciamento Importacao */
          &if "{&bf_mat_versao_ems}":U >= "2.062":U &then
          
          run piRetornaLi in h-bocx351 (input 3,
                                        input no,
                                        input ?,
                                        input ?,
                                        input ?,
                                        input prazo-compra.parcela,
                                        input yes,
                                        input yes,
                                        input prazo-compra.numero-ordem,
                                        input prazo-compra.numero-ordem,
                                        input "":U,
                                        input "":U,
                                        input "":U,
                                        input "":U,
                                        input "":U,
                                        input "":U,
                                        output table tt-licenciam-import-oc).
          if  can-find(first tt-licenciam-import-oc) then 
              next.

          &endif
          
          assign prazo-compra.int-2 = 0. /* Parcela nÆo fixada (ser  re-planejada) */
      end.

      &if "{&bf_mat_versao_ems}":U >= "2.062":U &then
      if  valid-handle (h-bocx351) then do:
          delete procedure h-bocx351.
          assign h-bocx351 = ?.
      end.
      &endif
end.
