def temp-table tt-dupli   no-undo
    field dt-vencim    as date
    field tp-despesa   as integer
    field vl-apagar    as decimal
    field vl-apagar-mo as decimal
    /*frank - 09/05/05*/
    &if '{&bf_dis_versao_ems}' >= '2.04' &then
    FIELD mo-codigo    AS INT
    &endif
    /*fim frank 09/05/05*/
    index data
        /*frank - 09/05/05*/
        &if '{&bf_dis_versao_ems}' >= '2.04' &then
           mo-codigo
        &endif
        /*fim frank 09/05/05*/
        dt-vencim.

