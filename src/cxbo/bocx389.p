&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getKey DBOProgram 
PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice ddspsdct-id
  Parameters:  
               retorna valor do campo num-di-ems
               retorna valor do campo num-adic
               retorna valor do campo num-seq
               retorna valor do campo cdn-despes
               retorna valor do campo cdn-emit-despes
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pnum-di-ems LIKE despes-adic-itens.num-di-ems NO-UNDO.
    DEFINE OUTPUT PARAMETER pnum-adic LIKE despes-adic-itens.num-adic NO-UNDO.
    DEFINE OUTPUT PARAMETER pnum-seq LIKE despes-adic-itens.num-seq NO-UNDO.
    DEFINE OUTPUT PARAMETER pcdn-despes LIKE despes-adic-itens.cdn-despes NO-UNDO.
    DEFINE OUTPUT PARAMETER pcdn-emit-despes LIKE despes-adic-itens.cdn-emit-despes NO-UNDO.
    DEFINE OUTPUT PARAMETER pcdd-siscomex-dts LIKE despes-adic-itens.cdd-siscomex-dts NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pnum-di-ems = RowObject.num-di-ems
           pnum-adic = RowObject.num-adic
           pnum-seq = RowObject.num-seq
           pcdn-despes = RowObject.cdn-despes
           pcdn-emit-despes = RowObject.cdn-emit-despes
           pcdd-siscomex-dts = RowObject.cdd-siscomex-dts.

    RETURN "OK":U.
END PROCEDURE.

