&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice ddspsdct-id
  Parameters:  
               recebe valor do campo num-di-ems
               recebe valor do campo num-adic
               recebe valor do campo num-seq
               recebe valor do campo cdn-despes
               recebe valor do campo cdn-emit-despes
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pnum-di-ems LIKE despes-adic-itens.num-di-ems NO-UNDO.
    DEFINE INPUT PARAMETER pnum-adic LIKE despes-adic-itens.num-adic NO-UNDO.
    DEFINE INPUT PARAMETER pnum-seq LIKE despes-adic-itens.num-seq NO-UNDO.
    DEFINE INPUT PARAMETER pcdn-despes LIKE despes-adic-itens.cdn-despes NO-UNDO.
    DEFINE INPUT PARAMETER pcdn-emit-despes LIKE despes-adic-itens.cdn-emit-despes NO-UNDO.
    DEFINE INPUT PARAMETER pcdd-siscomex-dts LIKE despes-adic-itens.cdd-siscomex-dts NO-UNDO.

    FIND FIRST bfdespes-adic-itens WHERE 
        bfdespes-adic-itens.num-di-ems = pnum-di-ems AND 
        bfdespes-adic-itens.num-adic = pnum-adic AND 
        bfdespes-adic-itens.num-seq = pnum-seq AND 
        bfdespes-adic-itens.cdn-despes = pcdn-despes AND 
        bfdespes-adic-itens.cdn-emit-despes = pcdn-emit-despes  AND
        bfdespes-adic-itens.cdd-siscomex-dts = pcdd-siscomex-dts NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfdespes-adic-itens THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfdespes-adic-itens)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

