/*
** Validacao Parƒmetros
*/

def var c-return-value as char no-undo.
def var c-return1      as char no-undo.
def var l-arg-comex    as log  no-undo.

assign l-arg-comex = no.

&if "{&bf_mat_versao_ems}":U >= "2.062":U &then
    if i-pais-impto-usuario = 1 then
        assign l-arg-comex = no.
    else    
        assign l-arg-comex = yes.
&endif

&if defined(bf-mat-comex) &then
    def var i-ct-codigo like conta-contab.ct-codigo no-undo.
    def var i-sc-codigo like conta-contab.sc-codigo no-undo.
&else
&endif

for each tt-bo-erro:
    delete tt-bo-erro.
end.

if  not l-im0101 then
    find first tt-parametros no-error.

if not avail tt-parametros then do:
    assign i-seq-erro = i-seq-erro + 1.
    {utp/ut-liter.i Parƒmetros * L}
    create tt-bo-erro.
    assign tt-bo-erro.parametros = trim(return-value).
    run utp/ut-msgs.p (input "msg":U,
                       input 265,
                       input tt-bo-erro.parametros).
    assign tt-bo-erro.i-sequen = i-seq-erro
           tt-bo-erro.cd-erro  = 265
           tt-bo-erro.mensagem = return-value.
    return "NOK":U.
end.


/* Estabelecimento */
if not can-find (estabelec 
                 where estabelec.cod-estabel = tt-parametros.cod-estabel) then do:
    assign i-seq-erro = i-seq-erro + 1.
    create tt-bo-erro.
    {utp/ut-liter.i Estabelecimento * L}
    assign tt-bo-erro.parametros = trim(return-value).
    run utp/ut-msgs.p (input "msg":U,
                       input 2,
                       input tt-bo-erro.parametros).
    assign tt-bo-erro.i-sequen = i-seq-erro
           tt-bo-erro.cd-erro  = 2
           tt-bo-erro.mensagem = return-value.
end.

/* Embarque */
find embarque-imp 
    where embarque-imp.cod-estabel = tt-parametros.cod-estabel
      and embarque-imp.embarque    = tt-parametros.embarque no-lock no-error.
if not avail embarque-imp then do:
    assign i-seq-erro = i-seq-erro + 1.
    create tt-bo-erro.
    {utp/ut-liter.i Embarque * L}
    assign tt-bo-erro.parametros = trim(return-value).
    run utp/ut-msgs.p (input "msg":U,
                       input 2,
                       input tt-bo-erro.parametros).
    assign tt-bo-erro.i-sequen = i-seq-erro
           tt-bo-erro.cd-erro  = 2
           tt-bo-erro.mensagem = return-value.
end.
 
/* Emitente */
if not can-find (emitente
                 where emitente.cod-emitente = tt-parametros.cod-emitente{1}) then do:
    assign i-seq-erro = i-seq-erro + 1.
    create tt-bo-erro.
    {utp/ut-liter.i Emitente * L}
    assign tt-bo-erro.parametros = trim(return-value).
    run utp/ut-msgs.p (input "msg":U,
                       input 2,
                       input tt-bo-erro.parametros).
    assign tt-bo-erro.i-sequen = i-seq-erro
           tt-bo-erro.cd-erro  = 2
           tt-bo-erro.mensagem = return-value.
end.

/* Data da transa‡Æo */
if tt-parametros.da-transacao = ? then do:
    assign i-seq-erro = i-seq-erro + 1.
    {utp/ut-liter.i Data_transa‡Æo * L}
    create tt-bo-erro.
    assign tt-bo-erro.parametros = trim(return-value).
    run utp/ut-msgs.p (input "msg":U,
                       input 265,
                       input tt-bo-erro.parametros).
    assign tt-bo-erro.i-sequen     = i-seq-erro
           tt-bo-erro.cd-erro      = 265
           tt-bo-erro.mensagem     = return-value.
end.

/* Data da emissÆo */
if tt-parametros.da-emissao = ? then do:
    assign i-seq-erro = i-seq-erro + 1.
    {utp/ut-liter.i Data_emissao * L}
    create tt-bo-erro.
    assign tt-bo-erro.parametros = trim(return-value).
    run utp/ut-msgs.p (input "msg":U,
                       input 265,
                       input tt-bo-erro.parametros).
    assign tt-bo-erro.i-sequen     = i-seq-erro
           tt-bo-erro.cd-erro      = 265
           tt-bo-erro.mensagem     = return-value.    
end.

/* Data de vencimento IPI/ICMS */ 

if  avail param-global 
and not l-arg-comex then
    find param-fasb 
        where param-fasb.ep-codigo = param-global.empresa-prin no-lock no-error.
    if avail param-fasb then do:
        if tt-parametros.da-venc-icms = ? then do:
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Dt_Vencimento_ICMS * r}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = trim(return-value).
            run utp/ut-msgs.p (input "msg":U,
                               input 265,
                               input tt-bo-erro.parametros).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 265
                   tt-bo-erro.mensagem     = return-value.
        end.                       
        if tt-parametros.da-venc-ipi = ? then do:
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Dt_Vencimento_IPI * r}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = trim(return-value).
            run utp/ut-msgs.p (input "msg":U,
                               input 265,
                               input tt-bo-erro.parametros).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 265
                   tt-bo-erro.mensagem     = return-value.
        end.          
    end.    

/* S‚rie */
if not can-find (serie
                 where serie.serie = tt-parametros.serie) then do:
    assign i-seq-erro = i-seq-erro + 1.
    create tt-bo-erro.
    {utp/ut-liter.i S‚rie * L}
    assign tt-bo-erro.parametros = trim(return-value).
    run utp/ut-msgs.p (input "msg":U,
                       input 2,
                       input tt-bo-erro.parametros).
    assign tt-bo-erro.i-sequen = i-seq-erro
           tt-bo-erro.cd-erro  = 2
           tt-bo-erro.mensagem = return-value.
end.

/* Natureza opera‡Æo */
find natur-oper
    where natur-oper.nat-operacao = tt-parametros.nat-operacao no-lock no-error.
if not avail natur-oper then do:
    assign i-seq-erro = i-seq-erro + 1.
    create tt-bo-erro.
    {utp/ut-liter.i Natureza_de_Opera‡Æo * L}
    assign tt-bo-erro.parametros = trim(return-value).
    run utp/ut-msgs.p (input "msg":U,
                       input 2,
                       input tt-bo-erro.parametros).
    assign tt-bo-erro.i-sequen = i-seq-erro
           tt-bo-erro.cd-erro  = 2
           tt-bo-erro.mensagem = return-value.
end.
else do:
    /* Se natureza de opera‡Æo nÆo gera nota no faturamento obriga n£mero do documento */
    if not natur-oper.imp-nota then do:
      &if defined(bf-mat-comex) &then 
        if tt-parametros.nro-docto = 0 then do:
      &else
        if tt-parametros.nro-docto = "" then do:
      &endif    
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i N£mero_do_Documento * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = trim(return-value).
            run utp/ut-msgs.p (input "msg":U,
                               input 265,
                               input tt-bo-erro.parametros).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 265
                   tt-bo-erro.mensagem     = return-value.
        end.
    end. 
end.    

/* Estabelecimento fiscal */
if not can-find (estabelec
                 where estabelec.cod-estabel = tt-parametros.estab-fisc) then do:
    assign i-seq-erro = i-seq-erro + 1.
    create tt-bo-erro.
    {utp/ut-liter.i Estabelecimento_fiscal * L}        
    assign tt-bo-erro.parametros = trim(return-value).
    run utp/ut-msgs.p (input "msg":U,
                       input 2,
                       input tt-bo-erro.parametros).
    assign tt-bo-erro.i-sequen = i-seq-erro
           tt-bo-erro.cd-erro  = 2
           tt-bo-erro.mensagem = return-value.
end.

/* Conta trasit¢ria */
if tt-parametros.ct-transit = "" then do:
    assign i-seq-erro = i-seq-erro + 1.
    {utp/ut-liter.i Conta_Trƒnsitoria * L}
    create tt-bo-erro.
    assign tt-bo-erro.parametros = trim(return-value).        
    run utp/ut-msgs.p (input "msg",
                       input 265,
                       input tt-bo-erro.parametros).
    assign tt-bo-erro.i-sequen     = i-seq-erro
           tt-bo-erro.cd-erro      = 265
           tt-bo-erro.mensagem     = return-value.
end.
else do:
    assign v_cod_cta_ctbl = tt-parametros.ct-transit.
    
    find estabelec where
         estabelec.cod-estabel = tt-parametros.cod-estabel no-lock no-error.
    assign i-empresa = estabelec.ep-codigo when avail estabelec.
    
    IF NOT VALID-HANDLE(h_api_cta) THEN
        run prgint/utb/utb743za.py persistent set h_api_cta.

    run pi_busca_dados_cta_ctbl in h_api_cta (input        i-empresa,          /* EMPRESA EMS2 */
                                              input        "",                 /* PLANO DE CONTAS */
                                              input-output v_cod_cta_ctbl,     /* CONTA */
                                              input        today,              /* DATA TRANSACAO */   
                                              output       v_des_cta_ctbl,     /* DESCRICAO CONTA */
                                              output       v_num_tip_cta_ctbl, /* TIPO DA CONTA */
                                              output       v_num_sit_cta_ctbl, /* SITUA€ÇO DA CONTA */
                                              output       v_ind_finalid_cta,  /* FINALIDADES DA CONTA */
                                              output table tt_log_erro).       /* ERROS */ 

    run pi_busca_dados_cta_ctbl_integr in h_api_cta (input        i-empresa,          /* EMPRESA EMS2 */
                                                     input        "CEP",              /* MODULO */
                                                     input        "",                 /* PLANO DE CONTAS */
                                                     input        v_cod_cta_ctbl,     /* CONTA */
                                                     input        today,              /* DATA TRANSACAO */   
                                                     output       v_ind_finalid_cta,  /* FINALIDADES DA CONTA */
                                                     output table tt_log_erro).       /* ERROS */ 
                                        
    if  return-value = "nok" then do:                          
        find first tt_log_erro no-lock no-error.
        if avail tt_log_erro then do:
            run utp/ut-msgs.p (input "show":U, 
                               input 17006, 
                               STRING(tt_log_erro.ttv_des_msg_erro) + ' ('  + string(tt_log_erro.ttv_num_cod_erro) + ')' + "~~" + tt_log_erro.ttv_des_msg_ajuda).
            assign i-seq-erro = i-seq-erro + 1.                   
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = int(tt_log_erro.ttv_des_msg_erro) /*5407*/
                   tt-bo-erro.mensagem     = return-value.             
            return 'ADM-ERROR':U.       
        end.
    end.
    else do:
        /*Verifica se a conta recebe lan‡amentos no estoque*/
        if  lookup({adinc/i05ad049.i 4 10}, v_ind_finalid_cta) <> 0 then do:
            run utp/ut-msgs.p (input "msg":u, input 15190, input "").
            assign i-seq-erro = i-seq-erro + 1.
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 15190
                   tt-bo-erro.mensagem     = return-value. 
        end.    
        
        /*Verifica se a conta permite lan‡amentos de notas fiscais de entrada*/
        if  lookup({adinc/i05ad049.i 4 2}, v_ind_finalid_cta) = 0 and      /* Nao Consumo */
            lookup({adinc/i05ad049.i 4 4}, v_ind_finalid_cta) = 0 and      /* Transferencia */
            lookup({adinc/i05ad049.i 4 7}, v_ind_finalid_cta) = 0 then do: /* Transitoria Compras */
            run utp/ut-msgs.p (input 'msg':U, input 438, input '').
            assign i-seq-erro = i-seq-erro + 1.
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 438 
                   tt-bo-erro.mensagem     = return-value. 
        end.
    end. 
            
    IF VALID-HANDLE(h_api_cta) THEN DO:
        DELETE PROCEDURE h_api_cta.
        ASSIGN h_api_cta = ?.
    END.
end.

/* Data cota‡Æo da moeda */
if tt-parametros.da-cotacao = ? then do:
    assign i-seq-erro = i-seq-erro + 1.
    {utp/ut-liter.i Data_cota‡Æo_moeda * L}
    create tt-bo-erro.
    assign tt-bo-erro.parametros = trim(return-value).
    run utp/ut-msgs.p (input "msg":U,
                       input 265,
                       input tt-bo-erro.parametros).
    assign tt-bo-erro.i-sequen     = i-seq-erro
           tt-bo-erro.cd-erro      = 265
           tt-bo-erro.mensagem     = return-value.    
end.

/* BOCX220A.I2 */
