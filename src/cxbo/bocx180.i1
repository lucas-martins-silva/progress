{utp/ut-glob.i}
{cdp/cdcfgdis.i} /* Definicao de pre-processadores */ 
{cdp/cdcfgcex.i} /* Definicao de pre-processadores */ 
{cdp/cdcfgmat.i} /* Definicao de pre-processadores */ 
&if '{&bf_dis_versao_ems}' >= '2.062' &then     
    {cdp~/cd2508.i} /*Funá∆o ems2-exp-mexico*/
&endif
 
&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.001
&scoped-define FIRST-TABLE-IN-QUERY param-exp
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME param-exp

{include/boini.i}
{method/dbotterr.i} /*Definiá∆o temp-table RowErrors*/

{cxbo/bocx180.i RowObject}
{cxbo/bocx00457.i tt-param-exp-siscomex}

DEFINE VAR c-estabel-ini      as char    no-undo.
DEFINE VAR c-estabel-fin      as char    no-undo.

DEFINE VAR c-nr-ult-proc-exp  as char                  no-undo.
DEFINE VAR c-nr-prox-proc-exp as char                  no-undo.
DEFINE VAR c-zero             as char                  no-undo.
DEFINE VAR c-inc-num          as char                  no-undo.
DEFINE VAR c-cod-estabel      as char                  no-undo.
define var r-param-exp        as rowid                 no-undo.
define var i-empresa          like param-global.empresa-prin   no-undo.
define var c-literal          as char format "x(25)":U no-undo.
DEFINE VAR l-comex-nacional   AS LOG                   NO-UNDO.
define var l-moeda            as char                  no-undo.
define var h-bocx00457        as handle                no-undo.

DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

&if defined(bf_comex206b-1) &then
    &if '{&bf_dis_versao_ems}' >= '2.07' &then                 
        &GLOBAL-DEFINE ROWOBJECT.CDN-MOTIVO RowObject.cdn-motivo
    &else               
        &GLOBAL-DEFINE ROWOBJECT.CDN-MOTIVO substring(RowObject.char-1,25,3)
    &endif
&endif

def var h_api_cta_ctbl as handle no-undo. /* utb743za.py */

def var v_des_cta_ctbl      as character format 'x(40)'             no-undo.
def var v_num_tip_cta_ctbl  as integer                              no-undo.
def var v_num_sit_cta_ctbl  as integer                              no-undo.
def var v_ind_finalid_cta   as char                                 no-undo.
                                                                            
DEFINE TEMP-TABLE tt_log_erro NO-UNDO                                       
     FIELD ttv_num_cod_erro AS integer INITIAL ?                            
     FIELD ttv_des_msg_ajuda AS character INITIAL ?                         
     FIELD ttv_des_msg_erro AS character INITIAL ?.                         

EMPTY TEMP-TABLE tt_log_erro.

ASSIGN l-comex-nacional = YES.
&IF '{&bf_dis_versao_ems}' >= '2.062' &THEN
   IF  i-pais-impto-usuario <> 1 THEN
       ASSIGN l-comex-nacional = NO.
&ENDIF

procedure setConstraint1:
 
end procedure.

PROCEDURE setConstraint2:

    def input parameter p-cod-estabel  as char no-undo.
    assign c-cod-estabel  = p-cod-estabel.
 
END PROCEDURE.

PROCEDURE setConstraint3:

    def input parameter p-estabel-ini  as char no-undo.
    def input parameter p-estabel-fin  as char no-undo.

    assign c-estabel-ini  = p-estabel-ini
           c-estabel-fin  = p-estabel-fin.
 
END PROCEDURE.
 
PROCEDURE openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where 
                                     param-exp.cod-estabel >= c-cod-estabel  no-lock.    
        when 3 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where 
                                     param-exp.cod-estabel >= c-estabel-ini and ~
                                     param-exp.cod-estabel <= c-estabel-fin  no-lock.    

    end case.
    assign l-query = true.
    assign i-bo-query = i-abertura.
END PROCEDURE.
 
{include/bostrmet.i}
{include/boendmet.i}
&if defined(bf-dis-comex) &then    
&else
    {include/bocomver.i}
    {include/bogetver.i}
&endif    

{include/bonav.i}
{include/bofind.i}
{include/bosetcur.i}
{include/bogetcur.i}
{include/bosersen.i}
{include/boprebro.i}
{include/boexecre.i}
{include/boexeupt.i}
{include/boexedel.i}
/*{include/bovalupt.i}*/
{include/bovaldel.i}

&IF DEFINED(bf-dis-comex) &THEN
&ELSE
    {include/i-epc200.i "bocx180"}
&ENDIF

procedure initializeValidate:
    /*
    **  Inicializa Validate
    */
 
    run startMethod ("initializeValidade").
 
    run endMethod   ("initializeValidade").
end procedure.
 
procedure findPk_estabel:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter c-cod-estabel as char no-undo.
    def output parameter c-return as char no-undo.
 
    release {&TABLE-NAME}.
    find {&TABLE-NAME} where
         {&TABLE-NAME}.cod-estabel = c-cod-estabel no-LOCK  no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex param-exp 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.
 
procedure validateFields:
    /*
    **  Valida Fields
    */
    if not valid-handle(h-bocx00457) then do:
       run cxbo/bocx00457.p persistent set h-bocx00457.
       run openQueryStatic in h-bocx00457 (input "Main":U).
    end.
       
    find first rowObject no-lock no-error.
        
    find first tt-param-exp-siscomex no-lock no-error.
        
    run startMethod ("validateFields").
    
    if rowObject.i-contr-num = 2 then do:
       if rowObject.inc-num = 0 then do:
          /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
          {utp/ut-field.i mgcex param-exp inc-num 1}
          /****************************************/
          assign c-inc-num = return-value
                 i-seq-erro = i-seq-erro + 1.
          /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */       
          {utp/ut-liter.i zero * R}
          /****************************************/
          assign c-zero = return-value.
          run utp/ut-msgs.p (input "msg",
                             input 1207,
                             input c-inc-num + "~~" + c-zero).
          create tt-bo-erro.
          assign tt-bo-erro.i-sequen     = i-seq-erro
                 tt-bo-erro.cd-erro      = 1207
                 tt-bo-erro.mensagem     = return-value.
       end.
    
       if rowObject.nr-prox-proc-exp <= rowObject.nr-ult-proc-exp then do:
          assign i-seq-erro = i-seq-erro + 1.
          /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
          {utp/ut-field.i mgcex param-exp nr-prox-proc-exp 2}
          /****************************************/
          assign c-nr-prox-proc-exp = return-value.
          /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
          {utp/ut-field.i mgcex param-exp nr-ult-proc-exp 2}
          /****************************************/
          assign c-nr-ult-proc-exp = return-value.
          run utp/ut-msgs.p (input "msg",
                             input 1207,
                             input c-nr-prox-proc-exp + "~~" + c-nr-ult-proc-exp).
          create tt-bo-erro.
          assign tt-bo-erro.i-sequen     = i-seq-erro
                 tt-bo-erro.cd-erro      = 1207
                 tt-bo-erro.mensagem     = return-value.
       end.
    end.
 
    if rowObject.cod-estabel = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 190,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 190
               tt-bo-erro.mensagem     = return-value.
    end.
 
    if rowObject.inc-num = ? or rowObject.inc-num = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex param-exp inc-num 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.

    &if defined(bf-dis-comex) &then    
    &else
        &IF "{&bf_dis_versao_ems}" >= "2.062" &THEN
          if not L-EMS2-EXP-MEXICO AND l-comex-nacional then do:
            IF  RowObject.num-increm-num-memorando <> 0 OR
                RowObject.num-ult-memorando        <> 0 THEN DO:
                IF  RowObject.num-increm-num-memorando = 0 THEN DO:
                    {utp/ut-field.i mgcex param-exp num-increm-num-memorando 1}
                    run utp/ut-msgs.p (input "msg",
                                       input 265,
                                       input return-value).
                    create tt-bo-erro.
                    assign i-seq-erro              = i-seq-erro + 1
                           tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 265
                           tt-bo-erro.mensagem     = return-value.
                END.
                IF  RowObject.num-ult-memorando = 0 
                    AND CAN-FIND(FIRST memorando-nf-item
                                 WHERE memorando-nf-item.nfs-cod-estabel = RowObject.cod-estabel
								   AND memorando-nf-item.num-form > 0) THEN DO:
                    {utp/ut-field.i mgcex param-exp num-ult-memorando 1}
                    run utp/ut-msgs.p (input "msg",
                                       input 265,
                                       input return-value).
                    create tt-bo-erro.
                    assign i-seq-erro              = i-seq-erro + 1
                           tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 265
                           tt-bo-erro.mensagem     = return-value.
                END.
            END.
            IF RowObject.num-item-saida-memorando = 0 THEN DO:
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "Nr_Itens_Sa°da_por_Memorando" *}
                run utp/ut-msgs.p (input "msg",
                                   input 265,
                                   input RETURN-VALUE).
                create tt-bo-erro.
                assign i-seq-erro              = i-seq-erro + 1
                       tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 265
                       tt-bo-erro.mensagem     = return-value.
            END.
        
            IF RowObject.num-docto-entr-memorando = 0 THEN DO:
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "Nr_Documentos_de_Entrada_por_Memorando" *}
                run utp/ut-msgs.p (input "msg",
                                   input 265,
                                   input RETURN-VALUE).
                create tt-bo-erro.
                assign i-seq-erro              = i-seq-erro + 1
                       tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 265
                       tt-bo-erro.mensagem     = return-value.
          end.            
        END.
            if not can-find(first moeda no-lock
                            where moeda.mo-codigo = RowObject.cdn-moed-reg-export) then do:
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "Moeda" *}
                run utp/ut-msgs.p (input "msg",
                                   input 2,
                                   input RETURN-VALUE).
                create tt-bo-erro.
                assign i-seq-erro              = i-seq-erro + 1
                       tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = return-value
                       tt-bo-erro.parametros   = "Moeda".
            end.
        &ENDIF
    &ENDIF
    
    &IF DEFINED(bf_comex206b-1) &THEN
        if RowObject.log-ctblz-recta-embarq then do:
           
           &IF '{&bf_mat_versao_ems}' < '2.062' &THEN
            if not can-find(first esp-doc
                            where esp-doc.cod-esp = RowObject.cod-espec-export-nao-embarc) then do:
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "EspÇcie_Documento" *}
                run utp/ut-msgs.p (input "msg",
                                   input 2,
                                   input RETURN-VALUE).
                create tt-bo-erro.
                ASSIGN i-seq-erro              = i-seq-erro + 1
                       tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = return-value
                       tt-bo-erro.parametros   = "EspÇcie Documento".
            end.
            
            if not can-find(first esp-doc
                            where esp-doc.cod-esp = RowObject.cod-espec-export-embarc) then do:
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "EspÇcie_Documento" *}
                run utp/ut-msgs.p (input "msg",
                                   input 2,
                                   input RETURN-VALUE).
                create tt-bo-erro.
                assign i-seq-erro              = i-seq-erro + 1
                       tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = return-value
                       tt-bo-erro.parametros   = "EspÇcie Documento".
            end.
           &ENDIF
            
            if not can-find(first deposito
                            where deposito.cod-depos = RowObject.cod-depos-export-nao-embarc) then do:
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "Dep¢sito" *}
                run utp/ut-msgs.p (input "msg",
                                   input 2,
                                   input RETURN-VALUE).
                create tt-bo-erro.
                assign i-seq-erro              = i-seq-erro + 1
                       tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = return-value
                       tt-bo-erro.parametros   = "Dep¢sito".
            end.
            else do: 
                 find first deposito
                            where deposito.cod-depos = RowObject.cod-depos-export-nao-embarc no-lock no-error.
                            
                 if avail deposito and (deposito.ind-acabado or deposito.cons-saldo) then do: 
                         run utp/ut-msgs.p (input "msg",
                                            input 33496,
                                            input "").
                        create tt-bo-erro.
                        assign i-seq-erro              = i-seq-erro + 1
                               tt-bo-erro.i-sequen     = i-seq-erro
                               tt-bo-erro.cd-erro      = 33496
                               tt-bo-erro.mensagem     = return-value.
                               
                 end. 
   
            end.
        end.
        
        &IF '{&bf_mat_versao_ems}' >= '2.062' &THEN
         &IF '{&bf_mat_versao_ems}' < '2.08' &THEN
          IF  SUBSTR(RowObject.char-1,28,1) = '1' OR /* YES */
             ( SUBSTR(RowObject.char-1,28,1) = ''  AND RowObject.log-ctblz-recta-embarq ) THEN DO:
         &ELSE
          IF  RowObject.log-controla-dupl-export THEN DO:
         &ENDIF
              
              IF  NOT CAN-FIND(FIRST esp-doc
                               WHERE esp-doc.cod-esp = RowObject.cod-espec-export-nao-embarc) THEN DO:
                  /* Inicio -- Projeto Internacional */
                  {utp/ut-liter.i "EspÇcie_Documento" *}
                  RUN utp/ut-msgs.p (INPUT "msg",
                                     INPUT 2,
                                     INPUT RETURN-VALUE).
                  CREATE tt-bo-erro.
                  ASSIGN i-seq-erro              = i-seq-erro + 1
                         tt-bo-erro.i-sequen     = i-seq-erro
                         tt-bo-erro.cd-erro      = 2
                         tt-bo-erro.mensagem     = RETURN-VALUE
                         tt-bo-erro.parametros   = "EspÇcie Documento".
              END.
              
              IF  NOT CAN-FIND(FIRST esp-doc
                               WHERE esp-doc.cod-esp = RowObject.cod-espec-export-embarc) THEN DO:
                  /* Inicio -- Projeto Internacional */
                  {utp/ut-liter.i "EspÇcie_Documento" *}
                  RUN utp/ut-msgs.p (INPUT "msg",
                                     INPUT 2,
                                     INPUT RETURN-VALUE).
                  CREATE tt-bo-erro.
                  ASSIGN i-seq-erro              = i-seq-erro + 1
                         tt-bo-erro.i-sequen     = i-seq-erro
                         tt-bo-erro.cd-erro      = 2
                         tt-bo-erro.mensagem     = RETURN-VALUE
                         tt-bo-erro.parametros   = "EspÇcie Documento".
              END.
          END.
        &ENDIF
        
        if not can-find (first motivo no-lock  
                         where motivo.cod-motivo   = integer({&ROWOBJECT.CDN-MOTIVO})
                           and motivo.ind-tp-trans = 1) then do:
            run utp/ut-msgs.p (input "msg",
                               input 27534,
                               input "").
            create tt-bo-erro.
            ASSIGN i-seq-erro              = i-seq-erro + 1
                   tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 27534
                   tt-bo-erro.mensagem     = return-value
                   tt-bo-erro.parametros   = "".
        end.            
        

        /* COMEX - COPAMEX   ************************************/
        &if '{&bf_dis_versao_ems}' >= '2.062' &then
            if NOT l-ems2-exp-mexico then do:
                run pi-valida-conta (input "cod-ct-transit-despes-export", input RowObject.cod-ct-transit-despes-export).
                if not RowObject.log-ctblz-recta-embarq then run pi-valida-conta (input "cod-ct-provis-despes-export", input RowObject.cod-ct-provis-despes-export).
            end.
        &else
            run pi-valida-conta (input "cod-ct-transit-despes-export", input RowObject.cod-ct-transit-despes-export).
            if not RowObject.log-ctblz-recta-embarq then run pi-valida-conta (input "cod-ct-provis-despes-export", input RowObject.cod-ct-provis-despes-export).
                                     
        &endif
        
        &if '{&bf_dis_versao_ems}' >= '2.07' &then
           if  RowObject.cdn-priorid-simul-padr <> 0 
           and not can-find(first prioridade 
                            where prioridade.cod-priori = RowObject.cdn-priorid-simul-padr) then do:
        &else
           &if '{&bf_cex_versao_ems}' >= '2.062' &then
               &if defined(bf_comex206b-1) &then
                   if  RowObject.int-1 <> 0 
                   and not can-find(first prioridade 
                                    where prioridade.cod-priori = RowObject.int-1) then do:
               &endif
           &endif
        &endif
            /* Inicio -- Projeto Internacional */
            {utp/ut-liter.i "Prioridade" *}
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input RETURN-VALUE).
            create tt-bo-erro.
            ASSIGN i-seq-erro              = i-seq-erro + 1
                   tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = trim(return-value)
                   tt-bo-erro.parametros   = "Prioridade".
        end.
    &ENDIF
 
    if i-pais-impto-usuario = 4 then do:
    
        if substring(RowObject.char-1,34,2) <> "0" and
           substring(RowObject.char-1,34,2) <> "" then do:
           
            if not can-find(first moeda
                            where moeda.mo-codigo = int(substring(RowObject.char-1,34,2))) then do:
                {utp/ut-liter.i Moeda *}
                assign l-moeda = return-value.
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input l-moeda).
                create tt-bo-erro.
                ASSIGN i-seq-erro              = i-seq-erro + 1
                       tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = trim(return-value)
                       tt-bo-erro.parametros   = l-moeda.

            end.

        end.
           

    end.
    
    if avail tt-param-exp-siscomex then do:
       RUN piSetaErroParamExp IN h-bocx00457 (input can-find(first tt-bo-erro)).
       RUN emptyRowObject     IN h-bocx00457.
       RUN emptyRowErrors     IN h-bocx00457.
       RUN goToKey            IN h-bocx00457(INPUT tt-param-exp-siscomex.cod-estabel).
       
       IF RETURN-VALUE = "OK":U THEN DO:
           RUN setRecord    IN h-bocx00457 (INPUT TABLE tt-param-exp-siscomex).
           RUN updateRecord IN h-bocx00457.
       END.
       ELSE DO:
           RUN setRecord    IN h-bocx00457 (INPUT TABLE tt-param-exp-siscomex).
           RUN createRecord IN h-bocx00457.
       END.
       
       run getRowErrors in h-bocx00457 (output table RowErrors).
       for each rowErrors:
           create tt-bo-erro.
           ASSIGN i-seq-erro              = i-seq-erro + 1
                  tt-bo-erro.i-sequen     = i-seq-erro
                  tt-bo-erro.cd-erro      = rowErrors.ErrorNumber
                  tt-bo-erro.mensagem     = ErrorDescription
                  tt-bo-erro.parametros   = ErrorParameters .
       end.
       if valid-handle(h-bocx00457) then do:
          delete procedure h-bocx00457.
          assign h-bocx00457 = ?.
       end.
    end.
    
    run endMethod ("validateFields").
 
end procedure.
 
PROCEDURE validateUpdate:

    DEFINE INPUT  PARAMETER TABLE FOR RowObject.
    DEFINE INPUT  PARAMETER r-chave AS ROWID NO-UNDO.
    DEFINE OUTPUT PARAMETER TABLE FOR tt-bo-erro.
 
    RUN InitializeValidate.
 
    FOR EACH tt-bo-erro:
        DELETE tt-bo-erro.
    END.
 
    RUN validateFields.
    
    FIND FIRST tt-bo-erro NO-LOCK NO-ERROR.
    
    IF NOT AVAIL tt-bo-erro THEN DO:
    
        &IF DEFINED(LOCKCONTROL) > 0 &THEN
            FIND {&TABLE-NAME} WHERE ROWID({&TABLE-NAME}) = r-chave NO-LOCK NO-ERROR.
        &ELSE    
            FIND {&TABLE-NAME} WHERE ROWID({&TABLE-NAME}) = r-chave EXCLUSIVE-LOCK NO-ERROR.
        &ENDIF    
            
        RUN executeUpdate.
        
    END.
    return "OK":U.
END PROCEDURE.


procedure pi-valida-conta:

if not valid-handle(h_api_cta_ctbl) then run prgint/utb/utb743za.py persistent set h_api_cta_ctbl.

&IF DEFINED(bf_comex206b-1) &THEN
    def input param p-tipo  as char no-undo. 
    def input param p-conta as char no-undo.

    def var c-label as char no-undo.

    if  not avail RowObject then
        find first RowObject no-error.

    run utp/ut-field.p (input "mgcex":U, 
                        input "param-exp", 
                        input p-tipo, 
                        input 1).

    assign c-label = return-value.

    if  p-conta = "":U then do:
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input c-label).
        create tt-bo-erro.
        ASSIGN i-seq-erro              = i-seq-erro + 1
               tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value
               tt-bo-erro.parametros   = c-label.
    end.
    else do:
        find first param-global no-lock no-error.
        assign i-empresa = param-global.empresa-prin.

        if  not avail estabelec or estabelec.cod-estabel <> RowObject.cod-estabel then
            find first estabelec no-lock 
                where estabelec.cod-estabel = rowObject.cod-estabel no-error.

        run cdp/cd9970.p (input rowid(estabelec), output i-empresa).
        
        RUN pi_busca_dados_cta_ctbl IN h_api_cta_ctbl (INPUT        i-empresa,          /* EMPRESA EMS2 */
                                                       INPUT        "",                 /* PLANO DE CONTAS */
                                                       INPUT-OUTPUT p-conta,            /* CONTA */
                                                       INPUT        TODAY,              /* DATA TRANSACAO */   
                                                       OUTPUT       v_des_cta_ctbl,     /* DESCRICAO CONTA */
                                                       OUTPUT       v_num_tip_cta_ctbl, /* TIPO DA CONTA */
                                                       OUTPUT       v_num_sit_cta_ctbl, /* SITUAÄ«O DA CONTA */
                                                       OUTPUT       v_ind_finalid_cta,  /* FINALIDADES DA CONTA */
                                                       OUTPUT TABLE tt_log_erro).       /* ERROS */
        
        if can-find(first tt_log_erro) then 
        for each tt_log_erro:
                create tt-bo-erro.
                assign i-seq-erro          = i-seq-erro + 1
                       tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = ttv_num_cod_erro 
                       tt-bo-erro.mensagem = ttv_des_msg_erro.
        end. /* for each tt_log_erro: */
        
        if  v_num_tip_cta_ctbl = 6 then do:
            run utp/ut-msgs.p (input "msg", input 17544, input c-label).
            create tt-bo-erro.
            ASSIGN i-seq-erro              = i-seq-erro + 1
                   tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 17544
                   tt-bo-erro.mensagem     = return-value
                   tt-bo-erro.parametros   = c-label.
        end. /* if  v_num_tip_cta_ctbl = 6 */
        
        if  v_num_sit_cta_ctbl = 1 then do:
            run utp/ut-msgs.p (input "msg", input 638, input p-conta).
            create tt-bo-erro.
            ASSIGN i-seq-erro              = i-seq-erro + 1
                   tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 638
                   tt-bo-erro.mensagem     = return-value
                   tt-bo-erro.parametros   = p-conta.
        end. /* if  v_num_sit_cta_ctbl = 1 */
        
        if  v_num_sit_cta_ctbl = 2 then do:
            run utp/ut-msgs.p (input "msg", input 913, input p-conta).
            create tt-bo-erro.
            ASSIGN i-seq-erro              = i-seq-erro + 1
                   tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 913
                   tt-bo-erro.mensagem     = return-value
                   tt-bo-erro.parametros   = p-conta.
        end. /* if  v_num_sit_cta_ctbl = 2 */
        
        /* finalidade */
        run pi_valida_cta_ctbl_integr in h_api_cta_ctbl (input i-empresa,           /* EMPRESA       */
                                                         input 'FTP',               /* M‡DULO        */
                                                         input '',                  /* PLANOS CONTAS */
                                                         input p-conta,             /* CONTA         */
                                                         input v_ind_finalid_cta,   /* FINALIDADE    */
                                                         input today,               /* DT. TRANSAÄ«O */
                                                         output table tt_log_erro). /* ERROS         */
        if can-find(first tt_log_erro) then 
        for each tt_log_erro:
                create tt-bo-erro.
                assign i-seq-erro          = i-seq-erro + 1
                       tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = ttv_num_cod_erro 
                       tt-bo-erro.mensagem = ttv_des_msg_erro.
        end. /* for each tt_log_erro: */        
    end.

&endif

	if valid-handle(h_api_cta_ctbl) then do:
			delete procedure h_api_cta_ctbl.
			assign h_api_cta_ctbl = ?.
	end.
	
end procedure.

procedure validateCreate:
    /*
    **  Valida criaá∆o da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.
 
    run initializeValidate.
    run startMethod ("validateCreate").
 
    for each tt-bo-erro no-lock:
        delete tt-bo-erro.
    end.
 
    find first rowObject
        no-lock no-error.
    if rowObject.cod-estabel = ? or rowObject.cod-estabel = "" then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex param-exp cod-estabel 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    else do:
      find first estabelec no-lock 
          where estabelec.cod-estabel = rowObject.cod-estabel no-error.
      if not avail estabelec then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 13,
                           input rowObject.cod-estabel).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 13
               tt-bo-erro.mensagem     = return-value.
      end.
    end.
    
    /*
    ** No EMS5, quando a fatura esta para ser criada com o numero do processo 
    ** de exportacao (ft0301) devera ser permitido informar apenas 
    ** ate 10 caracteres devido ao tiulo no CR permitir ter apenas 10 caracteres
    ** No EMS2, o titulo no CR permite ter ate 16 caracteres
    */
    if can-find(first funcao 
                where funcao.cd-funcao = "adm-acr-ems-5.00":U
                   and funcao.ativo     = yes
                   and funcao.log-1     = yes) then do:
        find first para-fat no-lock no-error.
        if  avail para-fat 
        and para-fat.ind-docum-fatura = 2 then do:
        
            if length(string(RowObject.nr-ult-proc-exp))  > 10 
            or length(string(RowObject.nr-prox-proc-exp)) > 10 then do:
               {utp/ut-liter.i ParÉmetros_de_Exportaá∆o * L}
               assign c-literal  = trim(return-value)
                      i-seq-erro = i-seq-erro + 1.
               run utp/ut-msgs.p (input "msg":U,
                                  input 33294,
                                  input c-literal).
               create tt-bo-erro.
               assign tt-bo-erro.i-sequen     = i-seq-erro
                      tt-bo-erro.cd-erro      = 33294
                      tt-bo-erro.mensagem     = trim(return-value).
            end.
        end.
    end.
     
    if rowObject.inc-num = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex param-exp inc-num 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
 
    find first tt-bo-erro
        no-lock no-error.
    if not available tt-bo-erro then do:
        find param-exp where
             param-exp.cod-estabel = rowObject.cod-estabel
             no-lock no-error.
        if avail param-exp then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex param-exp 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 8,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 8
                   tt-bo-erro.mensagem     = return-value.
        end.
    end.
 
    run validateFields.
    find first tt-bo-erro
        no-lock no-error.
 
    if not avail tt-bo-erro then do:
       run executeCreate.
       assign r-chave = to-rowid(return-value).
    end.
 
    run endMethod ("validateCreate").
end procedure.
    
 
procedure getNextSeq:
   def input        parameter p-cod-estabel like estabelec.cod-estabel    no-undo.
   def input-output parameter p-nr-proc-exp like processo-exp.nr-proc-exp no-undo.
   def output       parameter table for tt-bo-erro.
   
   define variable i-nr-proc-exp as integer no-undo.

   for each tt-bo-erro:
       delete tt-bo-erro.
   end.
   
   find first param-exp where
        param-exp.cod-estabel = p-cod-estabel no-lock no-error.
  
   if avail param-exp then do:

        &IF DEFINED(bf-dis-comex) &THEN
        &ELSE
            RUN pi-cria-tt-epc (INPUT p-nr-proc-exp).
       
            FIND FIRST tt-epc NO-LOCK 
                WHERE tt-epc.cod-event     = "BEFORE-GET-NEXT" 
                  AND tt-epc.cod-parameter = "NUMBER-NEXT" NO-ERROR.
    
            IF NOT AVAIL tt-epc THEN DO:
        &ENDIF
     
        /* Se numeraá∆o for "AUTOMµTICA" */
        if param-exp.i-contr-num = 2 then do:
            find param-exp where
                 param-exp.cod-estabel = p-cod-estabel exclusive-lock no-error .
            if p-nr-proc-exp = "" then 
                assign p-nr-proc-exp = string(param-exp.nr-prox-proc-exp)
                       param-exp.nr-ult-proc-exp = param-exp.nr-prox-proc-exp
                       param-exp.nr-prox-proc-exp = param-exp.nr-prox-proc-exp + param-exp.inc-num.
            else do:
                 if can-find(first processo-exp where processo-exp.cod-estabel = param-exp.cod-estabel 
                                                  and processo-exp.nr-proc-exp = p-nr-proc-exp) then do:
                    ASSIGN i-nr-proc-exp = int(p-nr-proc-exp)
                           i-nr-proc-exp = i-nr-proc-exp + param-exp.inc-num
                           p-nr-proc-exp = string(i-nr-proc-exp).
                 end.
                 /* Se for diferente de branco,  ent∆o verifica se a pr¢xima sequància Ç 
                    igual ao que foi digitado, se sim, ent∆o aceita  e grava o processo,
                    mas n∆o atualiza a pr¢xima sequància.*/
                 if string(param-exp.nr-prox-proc-exp) = p-nr-proc-exp then
                    assign param-exp.nr-ult-proc-exp  = param-exp.nr-prox-proc-exp
                           param-exp.nr-prox-proc-exp = param-exp.nr-prox-proc-exp + param-exp.inc-num.
            end.
        end.  /* if param-exp.i-contr-num = 2  */
        release param-exp.

        &IF DEFINED(bf-dis-comex) &THEN
        &ELSE
            END.
            else do:
                if tt-epc.val-parameter <> "" then do:
                    assign p-nr-proc-exp = tt-epc.val-parameter.
                end.
            end.
        &ENDIF
   
   end. /* if avail param-exp ... */
   else do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex param-exp 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 2
               tt-bo-erro.mensagem     = return-value.
   end. /* else do ... */

   find first param-exp where
        param-exp.cod-estabel = p-cod-estabel no-lock no-error.
       
   return "OK":U.
end procedure.


procedure getNextSeq2:

/* Procedure que acha o pr¢ximo processo de exportaá∆o mas n∆o atualiza a base */
   
   def input        parameter p-cod-estabel like estabelec.cod-estabel    no-undo.
   def input-output parameter p-nr-proc-exp like processo-exp.nr-proc-exp no-undo.
   def output       parameter table for tt-bo-erro.

   find param-exp where
        param-exp.cod-estabel = p-cod-estabel exclusive-lock no-error.
   
   if avail param-exp then do:

        &IF DEFINED(bf-dis-comex) &THEN
        &ELSE
       
            RUN pi-cria-tt-epc (input p-nr-proc-exp).
       
            FIND FIRST tt-epc NO-LOCK 
                WHERE tt-epc.cod-event     = "BEFORE-GET-NEXT" 
                  AND tt-epc.cod-parameter = "NUMBER-NEXT" NO-ERROR.
    
            IF NOT AVAIL tt-epc THEN DO:

        &ENDIF
      
            /* Se numeraá∆o for "AUTOMµTICA" */
            &IF DEFINED(bf_comex206b-1) &THEN
                if p-nr-proc-exp = "" then 
                   assign p-nr-proc-exp = string(param-exp.nr-prox-proc-exp).
            &else 
                if param-exp.i-contr-num = 2 then do:
                    if p-nr-proc-exp = "" then 
                        assign p-nr-proc-exp = string(param-exp.nr-prox-proc-exp).
                end.  /* if param-exp.i-contr-num = 2  */
            &endif

        &IF DEFINED(bf-dis-comex) &THEN
        &ELSE
         
            END.
            else do:
                if tt-epc.val-parameter <> "" then do:
                    assign p-nr-proc-exp = tt-epc.val-parameter.
                end.      
            end.

        &ENDIF
        

   end. /* if avail param-exp ... */
   else do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex param-exp 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 2
               tt-bo-erro.mensagem     = return-value.
   end. /* else do ... */
   
    find param-exp where
         param-exp.cod-estabel = p-cod-estabel no-lock no-error.

end procedure.

procedure pi-cria-tt-epc:

    def input parameter p-nr-proc-exp like processo-exp.nr-proc-exp no-undo.

    &IF DEFINED(bf-dis-comex) &THEN
    &ELSE

        /******************************
        ** EPC - Inicio
        ******************************/
        for each tt-epc 
           where tt-epc.cod-event = "BEFORE-GET-NEXT" no-lock: 
           delete tt-epc. 
        end.
        assign r-param-exp = rowid(param-exp).
        /*** Criacao do registro para temp-table tt-epc ***/
        {include/i-epc200.i2 &CodEvent='"BEFORE-GET-NEXT"'
                             &CodParameter=p-nr-proc-exp
                             &ValueParameter=string(r-param-exp)}
            
        /*** Chamada do programa EPC ***/
        {include/i-epc201.i "BEFORE-GET-NEXT"}

    &ENDIF
end procedure.

procedure getCharField:
    define input  parameter c-field as char.
    define output parameter c-value as char.
 
    case c-field:
        when "char-1" then c-value = RowObject.char-1.
        when "char-2" then c-value = RowObject.char-2.
        when "check-sum" then c-value = RowObject.check-sum.
        when "cod-estabel" then c-value = RowObject.cod-estabel.
        &if defined(bf_comex206b-1) &then
            when "cod-espec-export-nao-embarc" then c-value  = RowObject.cod-espec-export-nao-embarc.
            when "cod-espec-export-embarc" then c-value      = RowObject.cod-espec-export-embarc.
            when "cod-depos-export-nao-embarc" then c-value  = RowObject.cod-depos-export-nao-embarc.
            when "cod-ct-transit-despes-export" then c-value = RowObject.cod-ct-transit-despes-export.
            when "cod-ct-provis-despes-export" then c-value  = RowObject.cod-ct-provis-despes-export.
        &endif
        otherwise return error.
    end case.
end procedure.
 
procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.
 
    case c-field:
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        otherwise return error.
    end case.
end procedure.
 
procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.
 
    case c-field:
        when "i-contr-num"      then c-value = RowObject.i-contr-num.
        when "inc-num"          then c-value = RowObject.inc-num.
        when "int-1"            then c-value = RowObject.int-1.
        when "int-2"            then c-value = RowObject.int-2.
        when "nr-prox-proc-exp" then c-value = RowObject.nr-prox-proc-exp.
        when "nr-ult-proc-exp"  then c-value = RowObject.nr-ult-proc-exp.
        &IF "{&bf_cex_versao_ems}" >= "2.062" &THEN
            &IF '{&bf_dis_versao_ems}' >= '2.07' &THEN
                when "cdn-priorid-simul-padr" THEN c-value = RowObject.cdn-priorid-simul-padr.
            &endif
            WHEN "num-increm-num-memorando" THEN c-value = RowObject.num-increm-num-memorando.
            WHEN "num-ult-memorando"        THEN c-value = RowObject.num-ult-memorando.
            WHEN "num-docto-entr-memorando" THEN c-value = RowObject.num-docto-entr-memorando.
            WHEN "num-item-saida-memorando" THEN c-value = RowObject.num-item-saida-memorando.
            when "idi-descr-anexo"          then c-value = RowObject.idi-descr-anexo.
            when "idi-quant-col"            then c-value = RowObject.idi-quant-col.
            when "cdn-moed-reg-export"      then c-value = RowObject.cdn-moed-reg-export.
        &ENDIF
        
         
        &if "{&bf_dis_versao_ems}":U >= "2.08":U &then
        WHEN "idi-bxa-devol" THEN DO:
             assign c-value = RowObject.idi-bxa-devol.
        END.
        &endif
     
        otherwise return error.
    end case.
end procedure.
 
procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.
 
    case c-field:
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.
        otherwise return error.
    end case.
end procedure.
 
procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.
    
    case c-field:
         when "gera-procexp" then c-value = RowObject.gera-procexp.
         when "gera-procpedent" then c-value = RowObject.gera-procpedent.
         when "log-permite-alter-itiner" then c-value = RowObject.log-permite-alter-itiner.
         when "log-1" then c-value = RowObject.log-1.
         when "log-2" then c-value = RowObject.log-2.
         when "log-histor-proces-export":U then assign c-value = RowObject.log-histor-proces-export.
         &if defined(bf_comex206b-1) &then
             when "log-ctblz-recta-embarq" then c-value = RowObject.log-ctblz-recta-embarq.
         &endif
         
         WHEN "log-controla-dupl-export" THEN DO:
            &if defined(bf_comex206b-1) &then
             IF  RowObject.log-ctblz-recta-embarq THEN DO:
                &IF '{&bf_mat_versao_ems}' < '2.08' &THEN
                 IF  SUBSTR(RowObject.char-1,28,1) = '0' /* NO */ THEN
                &ELSE
                 IF  RowObject.log-controla-dupl-export = NO THEN
                &ENDIF
                     c-value = NO.
                 ELSE
                     c-value = YES.
             END.
             ELSE DO:
                &IF '{&bf_mat_versao_ems}' < '2.08' &THEN
                 IF  SUBSTR(RowObject.char-1,28,1) = '1' /* YES */ THEN
                     c-value = YES.
                &ELSE
                 IF  RowObject.log-controla-dupl-export THEN
                     c-value = YES.
                &ENDIF
                 ELSE
                     c-value = NO.
             END.
            &endif
         END.
         
         &if "{&bf_dis_versao_ems}":U >= "2.08":U &then
         WHEN "log-atualiz-proces-export" THEN DO:
             assign c-value = if RowObject.log-atualiz-proces-export then YES else NO.
         END.
         &endif
         
        &if "{&bf_dis_versao_ems}":U >= "2.09":U &then
            when "log-consid-cfop" then do: 
                assign c-value = if RowObject.log-consid-cfop then YES else NO.
            end.
        &else
            when "log-consid-cfop" then do:
                assign c-value = IF SUBSTR(RowObject.char-1,32,1) = "S" then yes else no.
            end.
        &endif
         
         otherwise return error.
    end case.
end procedure.

procedure piEnviaParamExpSiscomex:
/*
** Recebe temp-table tt-param-exp-siscomex para que os dados sejam validados 
** na criaá∆o/modificaá∆o/eliminaá∆o do registro da tabela param-exp
*/
    define input parameter table for tt-param-exp-siscomex.

    return "OK":U.
end procedure.
