procedure setEmitente:
/* 
|** Seta se o emitente Ç cliente ou fornecedor para a visualizaá∆o.
*/
def input parameter p-identific as integer no-undo.

assign i-identific = p-identific.

end procedure.

procedure initializeValidate:
    /*
    **  Inicializa Validate
    */
     
    run startMethod ("initializeValidade":U).
 
    run endMethod   ("initializeValidade":U).
end procedure.

procedure returnNome-abrev:
    def input parameter p-chave as rowid no-undo.
    def output parameter p-nome-abrev like emitente.nome-abrev no-undo.    
    def var h-boad098 as handle no-undo.
    
    run findRowid(input p-chave).
    run adbo/boad098.p persistent set h-boad098.    
    run findCodigo in h-boad098(input rowObject.cod-emitente,output c-return).
    if c-return = "" then
        run getCharfield in h-boad098(input "nome-abrev":U,output p-nome-abrev).
    delete procedure h-boad098.    
end procedure.

procedure getCharField:
	define input parameter c-field as char.
	define output parameter c-value as char.
	
	case c-field:
	   when "cod-idioma" then c-value = RowObject.cod-idioma.
	   when "cod-incoterm-imp" then c-value = RowObject.cod-incoterm-imp.
	   when "cod-incoterm-exp" then c-value = RowObject.cod-incoterm-exp.
	   when "char-1" then c-value     = RowObject.char-1.
	   when "char-2" then c-value     = RowObject.char-2.
	   when "check-sum" then c-value  = RowObject.check-sum.
	   otherwise return error.
       end case.		
end procedure.
 
procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.
 
    case c-field:
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        otherwise return error.
    end case.
end procedure.

procedure getDetalheEmitente-cex:
        DEF INPUT  PARAM r-rowid                       AS ROWID   NO-UNDO.
        DEF OUTPUT PARAM p-cdn-corretor-cambio-import  AS INTEGER NO-UNDO.
        DEF OUTPUT PARAM p-cdn-despa-import            AS INTEGER NO-UNDO.
        DEF OUTPUT PARAM p-cdn-despa-exter-import      AS INTEGER NO-UNDO.
        DEF OUTPUT PARAM p-cdn-segurad-import          AS INTEGER NO-UNDO.
        DEF OUTPUT PARAM p-cdn-corretor-import         AS INTEGER NO-UNDO.

        FIND FIRST bf{&Table-Name}
            WHERE ROWID(bf{&Table-Name}) = r-rowid NO-LOCK NO-ERROR.
        
        IF AVAIL bf{&Table-Name} THEN DO:
           assign p-cdn-corretor-cambio-import = bf{&Table-Name}.cdn-corretor-cambio-import
                  p-cdn-despa-import           = bf{&Table-Name}.cdn-despa-import          
                  p-cdn-despa-exter-import     = bf{&Table-Name}.cdn-despa-exter-import    
                  p-cdn-segurad-import         = bf{&Table-Name}.cdn-segurad-import        
                  p-cdn-corretor-import        = bf{&Table-Name}.cdn-corretor-import.       
        
        END.
        
        RETURN "OK":U.

end procedure.

procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.
 
    case c-field:
        when "cod-emitente" then c-value = RowObject.cod-emitente.
        when "cod-repres" then c-value = RowObject.cod-repres.
	 when "cod-itiner-imp" then c-value = RowObject.cod-itiner-imp.    
	 when "cod-itiner-exp" then c-value = RowObject.cod-itiner-exp.
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.        
        otherwise return error.
    end case.
end procedure.
 
procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.
 
    case c-field:
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.        
        otherwise return error.
    end case.
end procedure.

procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.
 
    case c-field:
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.        
        otherwise return error.
    end case.
end procedure.


procedure findPk-emitente:
    
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    def input parameter i-cod-emitente as inte no-undo.
    def output parameter c-return as char no-undo.
               
    run startMethod("find":U).
 
    find {&TABLE-NAME} where {&TABLE-NAME}.cod-emitente = i-cod-emitente no-lock no-error.
    if not avail {&TABLE-NAME} then do:
       {utp/ut-table.i mgcex emitente-cex 1}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.                            
    end.
    else do:
        run setCurrent.
    end.
    run endMethod("find":U).
end procedure.

procedure validateCreate:
       /*
    ** Chama Procedimento que Valida criaá∆o da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.
    def var h-bocx155 as handle no-undo. 
    
    if not valid-handle(h-bocx00479) then do:
       run cxbo/bocx00479.p persistent set h-bocx00479.
       run openQueryStatic in h-bocx00479 (input "Main":U).
    end.
   
    run cxbo/bocx155.p persistent set h-bocx155.
    run setEmitente in h-bocx155 (input 2). /* Fornecedor */
    
    if  l-verifica-programa then
        run verifica_validacao in h-bocx155 (input yes, 
                                             input i-program-cd).

    run validateCreate in h-bocx155(input table rowObject,output table tt-bo-erro,output r-chave).
    delete procedure h-bocx155.
    
    find first tt-emitente-siscomex no-lock no-error.
    
    if avail tt-emitente-siscomex then do:
       RUN piSetaErroEmitenteCex IN h-bocx00479 (input can-find(first tt-bo-erro)).
       RUN emptyRowObject     IN h-bocx00479.
       RUN emptyRowErrors     IN h-bocx00479.
       RUN goToKey            IN h-bocx00479(INPUT tt-emitente-siscomex.cdn-emitente).
       
       IF RETURN-VALUE = "OK":U THEN DO:
           RUN setRecord    IN h-bocx00479 (INPUT TABLE tt-emitente-siscomex).
           RUN updateRecord IN h-bocx00479.
       END.
       ELSE DO:
           RUN setRecord    IN h-bocx00479 (INPUT TABLE tt-emitente-siscomex).
           RUN createRecord IN h-bocx00479.
       END.
       
       run getRowErrors in h-bocx00479 (output table RowErrors).
       find last tt-bo-erro no-error.
       if avail tt-bo-erro then
           assign i-seq-erro = tt-bo-erro.i-sequen.
           
       for each rowErrors:
           create tt-bo-erro.
           assign i-seq-erro              = i-seq-erro + 1
                  tt-bo-erro.i-sequen     = i-seq-erro
                  tt-bo-erro.cd-erro      = rowErrors.ErrorNumber
                  tt-bo-erro.mensagem     = ErrorDescription
                  tt-bo-erro.parametros   = ErrorParameters.
       end.
    end.  
    
    if valid-handle(h-bocx00479) then do:
       delete procedure h-bocx00479.
       assign h-bocx00479 = ?.
    end.  
end.

procedure validateUpdate:
/*Chama o procedimento que valida a alteraá∆o de registros na bocx155*/

    def input parameter table for RowObject.
    def input parameter r-chave as rowid no-undo.
    def output parameter table for tt-bo-erro.    
    def var h-bocx155 as handle no-undo. 
    
    if not valid-handle(h-bocx00479) then do:
       run cxbo/bocx00479.p persistent set h-bocx00479.
       run openQueryStatic in h-bocx00479 (input "Main":U).
    end.
    
    run cxbo/bocx155.p persistent set h-bocx155.
    run identEmitente in h-bocx155 (input yes).

    if  l-verifica-programa then
        run verifica_validacao in h-bocx155 (input yes, input i-program-cd).

    run validateUpdate in h-bocx155(input table rowObject,input r-chave,output table tt-bo-erro).
    delete procedure h-bocx155.
    
    find first tt-emitente-siscomex no-lock no-error.
    
    if avail tt-emitente-siscomex then do:
       RUN piSetaErroEmitenteCex IN h-bocx00479 (input can-find(first tt-bo-erro)).
       RUN emptyRowObject     IN h-bocx00479.
       RUN emptyRowErrors     IN h-bocx00479.
       RUN goToKey            IN h-bocx00479(INPUT tt-emitente-siscomex.cdn-emitente).
       
       IF RETURN-VALUE = "OK":U THEN DO:
           RUN setRecord    IN h-bocx00479 (INPUT TABLE tt-emitente-siscomex).
           RUN updateRecord IN h-bocx00479.
       END.
       ELSE DO:
           RUN setRecord    IN h-bocx00479 (INPUT TABLE tt-emitente-siscomex).
           RUN createRecord IN h-bocx00479.
       END.
       
       run getRowErrors in h-bocx00479 (output table RowErrors).
       find last tt-bo-erro no-error.
       if avail tt-bo-erro then
           assign i-seq-erro = tt-bo-erro.i-sequen.
           
       for each rowErrors:
           create tt-bo-erro.
           assign i-seq-erro              = i-seq-erro + 1
                  tt-bo-erro.i-sequen     = i-seq-erro
                  tt-bo-erro.cd-erro      = rowErrors.ErrorNumber
                  tt-bo-erro.mensagem     = ErrorDescription
                  tt-bo-erro.parametros   = ErrorParameters.
       end.
    end.  
    
    if valid-handle(h-bocx00479) then do:
       delete procedure h-bocx00479.
       assign h-bocx00479 = ?.
    end.  
end.

procedure validateDelete:

    def input-output parameter r-chave as rowid.
    def output parameter table for tt-bo-erro.

    run startMethod("validateDelete":U).
    
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
     
    run InitializeValidate.
    
    find {&TABLE-NAME} where
        rowid({&TABLE-NAME}) = r-chave
        exclusive-lock no-error.
        
    if avail {&TABLE-NAME} then do:
        /* elimina aqui*/
        if not valid-handle(h-bocx00479) then do:
           run cxbo/bocx00479.p persistent set h-bocx00479.
           run openQueryStatic in h-bocx00479 (input "Main":U).
        end.
         
        RUN piSetaErroEmitenteCex IN h-bocx00479 (input can-find(first tt-bo-erro)).
        RUN emptyRowObject     IN h-bocx00479.
        RUN emptyRowErrors     IN h-bocx00479.
        RUN goToKey            IN h-bocx00479(INPUT {&TABLE-NAME}.cod-emitente).
        
        IF RETURN-VALUE = "OK":U THEN
            RUN deleteRecord    IN h-bocx00479.
        
        run getRowErrors in h-bocx00479 (output table RowErrors).
        find last tt-bo-erro no-error.
        if avail tt-bo-erro then
            assign i-seq-erro = tt-bo-erro.i-sequen.
            
        for each rowErrors where RowErrors.ErrorType <> "INTERNAL":U:
           create tt-bo-erro.
           assign i-seq-erro              = i-seq-erro + 1
                  tt-bo-erro.i-sequen     = i-seq-erro
                  tt-bo-erro.cd-erro      = rowErrors.ErrorNumber
                  tt-bo-erro.mensagem     = ErrorDescription
                  tt-bo-erro.parametros   = ErrorParameters.
        end.  
        
        if valid-handle(h-bocx00479) then do:
           delete procedure h-bocx00479.
           assign h-bocx00479 = ?.
        end.  
        
        if not can-find(first tt-bo-erro) then
            run executeDelete.
    end.
    
    /* Se for necessario a criacao de validacoes nesta procedure, criar uma include 
    conforme ja feito no validateUpdate para a mesma ser utilizada pelo browser 
    Manutencao de itens do documento */        
    
    if l-query then
        get next {&QUERY-NAME}
            no-lock no-wait.
    else
        find next {&TABLE-NAME}
            no-lock no-error.

    if not avail {&TABLE-NAME} then do:
       if l-query then
           get prev {&QUERY-NAME}
               no-lock no-wait.
       else
           find prev {&TABLE-NAME}
               no-lock no-error.
    end.
    
    run endMethod("validateDelete":U). 
    
    assign r-chave = rowid({&TABLE-NAME}).
    return "".
end procedure. 

procedure verifica_validacao:
    /** Carrega a variavel l-verifica-programa para verificar o programa que est† chamando 
    ** a procedure, fazendo ou n∆o a validacao da tabela de preco (mensagem 4432) */
    define input parameter p-verifica as logical no-undo.
    define input parameter p-program-cd as int   no-undo.
    
    assign l-verifica-programa = p-verifica
           i-program-cd        = p-program-cd.
    
    return "OK":U.
end procedure.


procedure findEmitenteCex:
    /*
    ** Verifica se o emitente Ç Fornecedor ou Ambos
    ** Procedure utilizada no V† Para do programa cd2576
    */
    def input parameter  i-cod-emitente as inte no-undo.
    def output parameter c-return       as char no-undo.

    run startMethod("find":U).
 
    find {&table-name} where 
         {&table-name}.cod-emitente = i-cod-emitente no-lock no-error.
    if not avail {&table-name} or
       not can-find (first emitente 
                     where emitente.cod-emitente = {&table-name}.cod-emitente 
                       and (emitente.identific = 2 or emitente.identific = 3)) then do:
          {utp/ut-table.i mgcex emitente-cex 1}
          run utp/ut-msgs.p (input "msg":U,
                             input 2,
                             input return-value).
          assign c-return = return-value.                            
    end.
    else do:
         run setCurrent.
    end.
    
    run endMethod("find":U).
    
end procedure.
