/*
** Recebe temp-table tt-param-imp-siscomex para que os dados sejam validados 
** na criaá∆o/modificaá∆o/eliminaá∆o do registro da tabela emitente-cex
*/
    define input parameter table for tt-emitente-siscomex.

    return "OK":U.
end procedure.
