/******************************************************************************
**
**  bocx250.i50 - Definicao das variaveis que serao utilizadas pela include
**               bocx250.i51.
**
**  Significado das variaveis:
**
**  i-emitente-ii-i50.: Codigo do fornecedor do imposto de importacao
**  i-desp-ii-i50.....: Codigo da despesa utilizada como imposto de importacao
**  
******************************************************************************/

/* variaveis char-1 */
def {1} var i-emitente-ii-i50 as integer format "999999999" no-undo.
def {1} var i-desp-ii-i50     as integer format "99999"     no-undo.

/*Sao 2 variaveis para o char-1*/
assign aux-i-num-var[1] = 2  /* Sempre que for criada uma nova variavel nesse */
                             /* programa, devera  ser  acrescentado  um  para */
                             /* essa variavel.                                */
       aux-i-tamanho[1] = 20.  /* espaco padrao utilizado na variavel char-1 */       

/*  bocx250.i50  */
