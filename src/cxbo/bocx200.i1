procedure findCh_itiner:
    /*******************************************
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    ********************************************/
    run startMethod ("find").
    def input  parameter p-cod-itiner  like historico-proc-exp.cod-itiner  no-undo.
    def input  parameter p-cod-estabel like historico-proc-exp.cod-estabel no-undo.
    def input  parameter p-nr-proc-exp like historico-proc-exp.nr-proc-exp no-undo.
    def output parameter c-return as char no-undo.    
    
    find first {&table-name} 
        where {&table-name}.cod-itiner  = p-cod-itiner 
          and {&table-name}.cod-estabel = p-cod-estabel 
          and {&table-name}.nr-proc-exp = p-nr-proc-exp no-lock no-error.
    if not avail {&table-name} then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex historico-proc-exp 1} 
        /*******************************************/
        run utp/ut-msgs.p (input "msg":u,
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else run setCurrent.
    
    run endMethod ("find").
end procedure.


procedure findPk_proc_pto_itiner:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter c-cod-estabel as char no-undo.
    def input parameter c-nr-proc-exp as char no-undo.
    def input parameter i-cod-itiner as inte no-undo.
    def input parameter i-sequencia as inte no-undo.
    def input parameter i-cod-pto-contr as inte no-undo.
    def output parameter c-return as char no-undo.
 
    find historico-proc-exp 
        where historico-proc-exp.cod-estabel   = c-cod-estabel
          and historico-proc-exp.nr-proc-exp   = c-nr-proc-exp
          and historico-proc-exp.cod-itiner    = i-cod-itiner
          and historico-proc-exp.sequencia     = i-sequencia
          and historico-proc-exp.cod-pto-contr = i-cod-pto-contr
          no-lock no-error.
    if not avail {&table-name} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex historico-proc-exp 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg":u,        
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else
       run setCurrent.
       
    run endMethod ("find").
end procedure.

