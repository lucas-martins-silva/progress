procedure setConstraint1:
end procedure.

procedure setConstraint2:
 
    def input parameter p-cod-estabel   like historico-proc-exp.cod-estabel   no-undo.
    def input parameter p-nr-proc-exp   like historico-proc-exp.nr-proc-exp   no-undo.
    def input parameter p-cod-itiner    like historico-proc-exp.cod-itiner    no-undo.
    def input parameter p-nr-sequencia  like historico-proc-exp.sequencia     no-undo.
    def input parameter p-cod-pto-contr like historico-proc-exp.cod-pto-contr no-undo.    
    
    assign c-cod-estabel   = p-cod-estabel
           c-nr-proc-exp   = p-nr-proc-exp
           i-cod-itiner    = int(p-cod-itiner)
           i-nr-sequencia  = int(p-nr-sequencia)
           i-cod-pto-contr = int(p-cod-pto-contr).

end procedure.

procedure setConstraint3: 
    def input parameter p-processo-exp as rowid.

    assign r-processo-exp = p-processo-exp.
end procedure.

procedure setConstraint4:
    def input parameter p-processo-exp      as rowid                              no-undo.
    def input parameter p-nr-sequencia-ini  like historico-proc-exp.sequencia     no-undo.
    def input parameter p-nr-sequencia-fim  like historico-proc-exp.sequencia     no-undo.
    def input parameter p-cod-pto-contr-ini like historico-proc-exp.cod-pto-contr no-undo.    
    def input parameter p-cod-pto-contr-fim like historico-proc-exp.cod-pto-contr no-undo.    
    
    assign r-processo-exp      = p-processo-exp
           i-nr-sequencia-ini  = int(p-nr-sequencia-ini)
           i-nr-sequencia-fim  = int(p-nr-sequencia-fim)
           i-cod-pto-contr-ini = int(p-cod-pto-contr-ini)
           i-cod-pto-contr-fim = int(p-cod-pto-contr-fim).
           
end procedure.

procedure openQuery:
    def input parameter i-abertura as integer no-undo.
    
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&table-name} no-lock
                                         {&v9indrep}.
        when 2 then 
            open query {&QUERY-NAME} for each {&table-name} where
                                  historico-proc-exp.cod-estabel   >= c-cod-estabel  and 
                                  historico-proc-exp.nr-proc-exp   >= c-nr-proc-exp  and 
                                  historico-proc-exp.cod-itiner    >= i-cod-itiner   and 
                                  historico-proc-exp.sequencia     >= i-nr-sequencia and 
                                  historico-proc-exp.cod-pto-contr >= i-cod-pto-contr no-lock.
        when 3 then do:
            RUN cxbo/bocx185.p persistent set h-bocx185.
            RUN findRowid IN h-bocx185 (input r-processo-exp).
            RUN getCurrent IN h-bocx185 (output table {&PARENT-TABLE}).
            DELETE PROCEDURE h-bocx185.
            find first {&PARENT-TABLE} no-error.
            open query {&QUERY-NAME} for each {&table-name} OF {&PARENT-TABLE} NO-LOCK.
        end.
        when 4 then do:
            RUN cxbo/bocx185.p persistent set h-bocx185.
            RUN findRowid IN h-bocx185 (input r-processo-exp).
            RUN getCurrent IN h-bocx185 (output table {&PARENT-TABLE}).
            DELETE PROCEDURE h-bocx185.
            find first {&PARENT-TABLE} no-error.
            open query {&QUERY-NAME} for each {&table-name} OF {&PARENT-TABLE} no-lock where
                                              {&table-name}.sequencia     >= i-nr-sequencia-ini  and 
                                              {&table-name}.sequencia     <= i-nr-sequencia-fim  and 
                                              {&table-name}.cod-pto-contr >= i-cod-pto-contr-ini and
                                              {&table-name}.cod-pto-contr <= i-cod-pto-contr-fim.
        end.        
    end case.
    
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.
 
