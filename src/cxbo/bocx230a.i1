/**
 ** Include para tratamento e traducao de mensagens apresentadas 
 **
 ** Parametros: {1} Tabela que sera traduiza
 **             {2} Campo que sera traduzido
 **
 ** Variaveis necessarias: c-desc-pto-atual
 **                        c-desc-pto-anterior 
 **                        c-desc-campo-validado
 **                        c-lista-ptos 
 **                        i-pto-contr
 **                         
 ** Definicoes: def var c-desc-pto-atual       as char    no-undo.
 **             def var c-desc-pto-anterior    as char    no-undo.
 **             def var c-desc-campo-validado  as char    no-undo.
 **             def var c-lista-ptos           as char    no-undo.
 **             def var i-pto-contr            as integer no-undo.
 **
**/   


{utp/ut-field.i mgcex {1} {2} 1}
assign c-desc-campo-validado = return-value.

assign c-lista-ptos = string(embarque-imp.cdn-pto-despch)   + "," 
                    + string(embarque-imp.cdn-pto-embarq)   + "," 
                    + string(embarque-imp.cdn-pto-desembar) + "," 
                    + string(embarque-imp.cdn-pto-chegad)   + ","
       i-pto-contr  = LOOKUP(string(rowObject.cod-pto-contr), c-lista-ptos, ",").

CASE i-pto-contr:
    WHEN 1 THEN DO:
        {utp/ut-field.i mgcex embarque-imp cdn-pto-despch 1}
        assign c-desc-pto-atual = return-value.
    END.
    WHEN 2 THEN DO:
        {utp/ut-field.i mgcex embarque-imp cdn-pto-embarq 1}
        assign c-desc-pto-atual = return-value.
    END.
    WHEN 3 THEN DO:
        {utp/ut-field.i mgcex embarque-imp cdn-pto-desembar 1}
        assign c-desc-pto-atual = return-value.
    END.
    WHEN 4 THEN DO:
        {utp/ut-field.i mgcex embarque-imp cdn-pto-chegad 1}
        assign c-desc-pto-atual = return-value.
    END.
END CASE.

assign i-pto-contr  = LOOKUP(string(historico-embarque.cod-pto-contr), c-lista-ptos, ",").
        
CASE i-pto-contr:
    WHEN 1 THEN DO:
        {utp/ut-field.i mgcex embarque-imp cdn-pto-despch 1}
        assign c-desc-pto-anterior = return-value.
    END.
    WHEN 2 THEN DO:
        {utp/ut-field.i mgcex embarque-imp cdn-pto-embarq 1}
        assign c-desc-pto-anterior = return-value.
    END.
    WHEN 3 THEN DO:
        {utp/ut-field.i mgcex embarque-imp cdn-pto-desembar 1}
        assign c-desc-pto-anterior = return-value.
    END.
    WHEN 4 THEN DO:
        {utp/ut-field.i mgcex embarque-imp cdn-pto-chegad 1}
        assign c-desc-pto-anterior = return-value.
    END.
END CASE.


