{cdp/cdcfgdis.i}

&IF INTEGER(ENTRY(1,PROVERSION,".")) >= 9 &THEN
   &GLOBAL-DEFINE v9indrep  INDEXED-REPOSITION
&endif

DEFINE VAR c-cod-estabel   like decl-hist-proc-exp.cod-estabel   no-undo.
DEFINE VAR c-nr-proc-exp   like decl-hist-proc-exp.nr-proc-exp   no-undo.
DEFINE VAR i-cod-itiner    like decl-hist-proc-exp.cod-itiner    no-undo.
DEFINE VAR i-nr-sequencia  like decl-hist-proc-exp.sequencia     no-undo.
DEFINE VAR de-codigo       like decl-hist-proc-exp.de-codigo     no-undo.
DEFINE VAR r-chave         as   rowid                            no-undo.
def var h-bocx185          as handle                             no-undo.
def var h-bocx155          as handle                             no-undo.
def var i-pos              as integer                            no-undo.
def var i-cod-emit         as integer                            no-undo.
DEFINE VARIABLE lAlteracaoItinerario AS LOGICAL   NO-UNDO.
DEFINE VARIABLE c-msg-params         AS CHARACTER NO-UNDO.

def var c-cod-idiom-usuar  &if defined(bf-dis-comex) &then 
                               like idioma.id-codigo
                           &else
                               like idioma.cod_idioma
                           &endif no-undo.

def var c-proc  like processo-exp.nr-proc-exp    no-undo.
def var c-est   like processo-exp.cod-estabel    no-undo.
def var i-emit  like processo-exp.cod-emitente   no-undo.
def var c-idiom &if defined(bf-dis-comex) &then
                    like idioma.id-codigo
                &else
                    like idioma.cod_idioma
                &endif no-undo.
def var i-decl  like decl-cliente.de-codigo      no-undo.
def var c-idiom-usuar &if defined(bf-dis-comex) &then
                          like idioma.id-codigo
                      &else
                          like idioma.cod_idioma
                      &endif no-undo.
def var i-iti   like decl-hist-proc-exp.cod-itiner no-undo.
def var i-seq   like decl-hist-proc-exp.sequencia  no-undo.


&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.001
&scoped-define FIRST-TABLE-IN-QUERY decl-hist-proc-exp
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME decl-hist-proc-exp

{include/boini.i}

{cxbo/bocx285.i RowObject}
{cxbo/bocx285.i tt-decl-hist-proc-exp}
