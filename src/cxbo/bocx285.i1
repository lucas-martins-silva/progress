procedure initializeValidate:
    /*
    **  Inicializa Validate
    */

    run startMethod ("initializeValidade").

    run endMethod   ("initializeValidade").
end procedure.

procedure findCh_emitida:

    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter l-decl-emitida as logi no-undo.
    def input parameter c-cod-estabel  as char no-undo.
    def input parameter c-nr-proc-exp  as char no-undo.
    def input parameter i-cod-itiner   as inte no-undo.
    def input parameter i-sequencia    as inte no-undo.
    def input parameter de-codigo      as inte no-undo.
    def output parameter c-return      as char no-undo.

    find first decl-hist-proc-exp
         where decl-hist-proc-exp.decl-emitida  = l-decl-emitida
           and decl-hist-proc-exp.cod-estabel   = c-cod-estabel
           and decl-hist-proc-exp.nr-proc-exp   = c-nr-proc-exp
           and decl-hist-proc-exp.cod-itiner    = i-cod-itiner
           and decl-hist-proc-exp.sequencia     = i-sequencia
           and decl-hist-proc-exp.de-codigo     = de-codigo no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex decl-hist-proc-exp 1}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").

end procedure.

procedure findPk_decl_hist_proc_exp:

    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter c-cod-estabel  as char no-undo.
    def input parameter c-nr-proc-exp  as char no-undo.
    def input parameter i-cod-itiner   as inte no-undo.
    def input parameter i-sequencia    as inte no-undo.
    def input parameter de-codigo      as inte no-undo.
    def output parameter c-return as char no-undo.

    find decl-hist-proc-exp
         where decl-hist-proc-exp.cod-estabel   = c-cod-estabel
           and decl-hist-proc-exp.nr-proc-exp   = c-nr-proc-exp
           and decl-hist-proc-exp.cod-itiner    = i-cod-itiner
           and decl-hist-proc-exp.sequencia     = i-sequencia
           and decl-hist-proc-exp.de-codigo     = de-codigo no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */ 
        {utp/ut-table.i mgcex decl-hist-proc-exp 1}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").

end procedure.

procedure validateFields:
    /*
    **  Valida Fields
    */

    run startMethod ("validateFields").

    find first rowObject  no-lock no-error.
    empty temp-table tt-campo-erro.

    if rowObject.cod-estabel = ? or rowObject.cod-estabel = "" then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex decl-hist-proc-exp cod-estabel 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
        create tt-campo-erro.
        assign tt-campo-erro.campo = "cod-estabel":U.
    end.

    if rowObject.nr-proc-exp = ? or rowObject.nr-proc-exp = "" then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex decl-hist-proc-exp nr-proc-exp 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
        create tt-campo-erro.
        assign tt-campo-erro.campo = "nr-proc-exp":U.
    end.

    if rowObject.cod-itiner = ? or rowObject.cod-itiner = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex decl-hist-proc-exp cod-itiner 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
        create tt-campo-erro.
        assign tt-campo-erro.campo = "cod-itiner":U.
    end.
    
    /* Valida se o ponto de controle informado pertence ao itiner†rio do processo de exportaá∆o */
    IF NOT CAN-FIND(FIRST historico-proc-exp
                    WHERE historico-proc-exp.cod-estabel = rowObject.cod-estabel
                      AND historico-proc-exp.nr-proc-exp = rowObject.nr-proc-exp
                      AND historico-proc-exp.cod-itiner  = rowObject.cod-itiner
                      AND historico-proc-exp.sequencia   = rowObject.sequencia) THEN DO:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex historico-proc-exp cod-pto-contr 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.        
        run utp/ut-msgs.p (input "msg":u,
                           input 54667,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 54667
               tt-bo-erro.mensagem     = return-value.   
        create tt-campo-erro.
        assign tt-campo-erro.campo = "sequencia":U.
    END.
    
    if rowObject.sequencia = ? or rowObject.sequencia = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex decl-hist-proc-exp sequencia 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
        create tt-campo-erro.
        assign tt-campo-erro.campo = "sequencia":U.
    end.
    
    if not can-find(first decl-padrao 
                    where decl-padrao.de-codigo = rowobject.de-codigo) then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-liter.i "Declaraá∆o" *}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 2
               tt-bo-erro.mensagem     = return-value.
        create tt-campo-erro.
        assign tt-campo-erro.campo = "de-codigo":U.
    end.
    
    if rowobject.de-codigo <> 0 and rowobject.de-codigo <> ? and
       (rowobject.descricao = ? or rowobject.descricao = "":U) then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex decl-hist-proc-exp descricao 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.        
        run utp/ut-msgs.p (input "msg":u,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
        create tt-campo-erro.
        assign tt-campo-erro.campo = "descricao":U.
    end.
    
    run endMethod ("validateFields").

end procedure.

procedure validateCreate:
    /*
    **  Valida criaá∆o da tabela/duplicidade de registro.
    */

    run startMethod ("validateCreate").
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.

    run initializeValidate.

    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

    run validateFields.
    find decl-hist-proc-exp
         where decl-hist-proc-exp.cod-estabel = rowObject.cod-estabel
           and decl-hist-proc-exp.nr-proc-exp = rowObject.nr-proc-exp
           and decl-hist-proc-exp.cod-itiner  = rowObject.cod-itiner
           and decl-hist-proc-exp.sequencia   = rowObject.sequencia
           and decl-hist-proc-exp.de-codigo   = rowObject.de-codigo no-lock no-error.
    if avail decl-hist-proc-exp then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex decl-hist-proc-exp 1}
        run utp/ut-msgs.p (input "msg",
                           input 8,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 8
               tt-bo-erro.mensagem     = return-value.
    end.

    find first tt-bo-erro no-lock no-error.
    if not avail tt-bo-erro then do:
       run executeCreate.
       assign r-chave = to-rowid(return-value).
    end.
    run endMethod ("validateCreate").

end procedure.


procedure validateUpdate:
    def input parameter table for RowObject.
    def input parameter r-chave as rowid no-undo.
    def output parameter table for tt-bo-erro.
    
    run startMethod("validateUpdate":U).
 
    run InitializeValidate.
 
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    assign i-seq-erro = 0.
    
    run validateFields.
    
    for first rowObject: end.
    for first decl-hist-proc-exp fields()
        where decl-hist-proc-exp.cod-estabel = rowObject.cod-estabel
          and decl-hist-proc-exp.nr-proc-exp = rowObject.nr-proc-exp
          and decl-hist-proc-exp.cod-itiner  = rowObject.cod-itiner
          and decl-hist-proc-exp.sequencia   = rowObject.sequencia
          and decl-hist-proc-exp.de-codigo   = rowObject.de-codigo
          and rowid(decl-hist-proc-exp)      <> rowObject.r-rowid no-lock:
    end.

    if avail decl-hist-proc-exp then do:
        assign i-seq-erro = i-seq-erro + 1.
        {utp/ut-table.i mgcex decl-hist-proc-exp 1}
        run utp/ut-msgs.p (input "msg",
                           input 8,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 8
               tt-bo-erro.mensagem     = return-value.
    end.
    
    find first tt-bo-erro no-lock no-error.
    if not avail tt-bo-erro then do:
        find {&TABLE-NAME} where rowid({&TABLE-NAME}) = r-chave            
            exclusive-lock no-error no-wait.
	if avail {&TABLE-NAME} then do:
           run executeUpdate.   
        end.
    end.
    
    run endMethod("validateUpdate":U).
end procedure.

procedure executeUpdate:

    /*  Executa Update*/
    buffer-copy RowObject except r-rowid
                                 cod-estabel
                                 nr-proc-exp
                                 cod-itiner to {&TABLE-NAME}.

end procedure.


PROCEDURE generateTable:
     def input  parameter table for tt-hist-proc-exp.
     def output parameter table for tt-bo-erro.
     def var r-chave as rowid no-undo.

     find first tt-hist-proc-exp no-lock no-error.
     if avail tt-hist-proc-exp then do:
        for each tt-idioma:
            delete tt-idioma.
        end.    
        for each  decl-itiner no-lock
            where decl-itiner.cod-itiner = tt-hist-proc-exp.cod-itiner
              and decl-itiner.cod-pto-contr = tt-hist-proc-exp.cod-pto-contr:

            /* Se alterou itiner†rio */
            if lAlteracaoItinerario then do:
                if can-find(first decl-hist-proc-exp
                            where decl-hist-proc-exp.cod-estabel = tt-hist-proc-exp.cod-estabel
                              and decl-hist-proc-exp.nr-proc-exp = tt-hist-proc-exp.nr-proc-exp
                              and decl-hist-proc-exp.cod-itiner  = decl-itiner.cod-itiner      
                              and decl-hist-proc-exp.sequencia   = tt-hist-proc-exp.sequencia  
                              and decl-hist-proc-exp.de-codigo   = decl-itiner.de-codigo) then next.
            end.
            
            create tt-decl-hist-proc-exp.
            assign tt-decl-hist-proc-exp.cod-estabel  = tt-hist-proc-exp.cod-estabel
                   tt-decl-hist-proc-exp.nr-proc-exp  = tt-hist-proc-exp.nr-proc-exp
                   tt-decl-hist-proc-exp.cod-itiner   = decl-itiner.cod-itiner
                   tt-decl-hist-proc-exp.sequencia    = tt-hist-proc-exp.sequencia
                   tt-decl-hist-proc-exp.de-codigo    = decl-itiner.de-codigo
                   tt-decl-hist-proc-exp.decl-emitida = no
                   tt-decl-hist-proc-exp.int-1        = decl-itiner.emite-decl-docum
                   tt-decl-hist-proc-exp.int-2        = decl-itiner.dias-tolerancia.
                   
            for first decl-padrao fields(descricao)
                where decl-padrao.de-codigo = decl-itiner.de-codigo no-lock:
                assign tt-decl-hist-proc-exp.descricao = decl-padrao.descricao.
            end.
            
            if  decl-itiner.emite-emitente = yes then do:
                run cxbo/bocx185.p persistent set h-bocx185.
                run findPk_proc_exp in h-bocx185 (input tt-hist-proc-exp.cod-estabel,
                                                  input tt-hist-proc-exp.nr-proc-exp,
                                                  output c-return).
                if c-return = "" then do:
                   run getCurrent in h-bocx185 (output table tt-processo-exp).
                   find first tt-processo-exp no-lock no-error.
                   if avail tt-processo-exp then do:
                      find emitente where 
                           emitente.cod-emitente = tt-processo-exp.cod-emitente 
                           no-lock no-error.
                      if avail emitente then do:         
                         &if defined(bf-dis-comex) &then 
                         &else                         
                             assign tt-decl-hist-proc-exp.e-mail-emitente = emitente.e-mail.
                         &endif
                         run cxbo/bocx155.p persistent set h-bocx155.
                         run findPk-emitente in h-bocx155 (input emitente.cod-emitente, output c-return).
                         if  c-return = "" then do: 
                             run getCurrent in h-bocx155 (output table tt-emitente-cex).
                             find first tt-emitente-cex no-lock no-error.
                             if  avail tt-emitente-cex then do:
                                 create tt-idioma.
                                 assign tt-idioma.cod-idioma = tt-emitente-cex.cod-idioma.
                             end.
                             else do:       
                                  if  c-cod-idiom-usuar <> "" then do:
                                      create tt-idioma.
                                      assign tt-idioma.cod-idioma = c-cod-idiom-usuar.
                                  end.    
                             end.     
                         end.
                         delete procedure h-bocx155.
                      end.   
                   end.   
                end.   
                delete procedure h-bocx185.
            end.                   
  
            if decl-itiner.emite-outros = yes then do:
               assign tt-decl-hist-proc-exp.e-mail-outros = decl-itiner.destinatario-outros.
               run cxbo/bocx185.p persistent set h-bocx185.
               run findPk_proc_exp in h-bocx185 (input tt-hist-proc-exp.cod-estabel,
                                                 input tt-hist-proc-exp.nr-proc-exp,
                                                 output c-return).
               if c-return = "" then do:                                  
                   run getCurrent in h-bocx185 (output table tt-processo-exp).
                   find first tt-processo-exp no-lock no-error.
                   if avail tt-processo-exp then do:
                        find emitente-cex where
                             emitente-cex.cod-emitente =  tt-processo-exp.cod-emitente 
                             no-lock no-error.
                        if   avail emitente-cex then do:
                             find tt-idioma where
                                  tt-idioma.cod-idioma = emitente-cex.cod-idioma
                                  no-error.
                             if   not avail tt-idioma then do:
                                  create tt-idioma.
                                  assign tt-idioma.cod-idioma = emitente-cex.cod-idioma.
                             end.
                        end.
                   end.      
                   delete procedure h-bocx185.
               end.
            end.   
   
            if decl-itiner.emite-despachante = yes then do:            
               run cxbo/bocx185.p persistent set h-bocx185.
               run findPk_proc_exp in h-bocx185 (input tt-hist-proc-exp.cod-estabel,
                                                 input tt-hist-proc-exp.nr-proc-exp,
                                                 output c-return).
                if c-return = "" then do:
                   run getCurrent in h-bocx185 (output table tt-processo-exp).
                   find first tt-processo-exp no-lock no-error.
                   if avail tt-processo-exp then do:
                      find emitente where 
                           emitente.cod-emitente = tt-processo-exp.cod-despachante no-lock no-error.
                      if   avail emitente then do:         
                           &if defined(bf-dis-comex) &then 
                           &else
                               assign tt-decl-hist-proc-exp.e-mail-despachante = emitente.e-mail.
                           &endif
                           run cxbo/bocx155.p persistent set h-bocx155.
                           run findPk-emitente in h-bocx155 (input emitente.cod-emitente, output c-return).
                           if  c-return = "" then do:
                               run getCurrent in h-bocx155 (output table tt-emitente-cex).
                               find first tt-emitente-cex no-lock no-error.
                               if   avail tt-emitente-cex then do:
                                    create tt-idioma.
                                    assign tt-idioma.cod-idioma = tt-emitente-cex.cod-idioma.
                               end.
                               else do:       
                                    if  c-cod-idiom-usuar <> "" then do:
                                        create tt-idioma.
                                        assign tt-idioma.cod-idioma = c-cod-idiom-usuar.
                                    end.    
                               end.
                           end.
                           delete procedure h-bocx155.
                      end.    
                   end.
                end.            
                delete procedure h-bocx185.
            end.
            if decl-itiner.emite-fabricante = yes then do:            
               run cxbo/bocx185.p persistent set h-bocx185.
               run findPk_proc_exp in h-bocx185 (input tt-hist-proc-exp.cod-estabel,
                                                 input tt-hist-proc-exp.nr-proc-exp,
                                                 output c-return).
                if c-return = "" then do:
                   run getCurrent in h-bocx185 (output table tt-processo-exp).
                   find first tt-processo-exp no-lock no-error.
                   if avail tt-processo-exp then do:
                      find emitente where 
                           emitente.cod-emitente = tt-processo-exp.cod-fabric 
                           no-lock no-error.
                      if avail emitente then do:          
                         &if defined(bf-dis-comex) &then 
                         &else
                             assign tt-decl-hist-proc-exp.e-mail-fabricante = emitente.e-mail.
                         &endif
                         run cxbo/bocx155.p persistent set h-bocx155.
                         run findPk-emitente in h-bocx155 (input emitente.cod-emitente, output c-return).
                         if  c-return = "" then do:
                             run getCurrent in h-bocx155 (output table tt-emitente-cex).
                             find first tt-emitente-cex no-lock no-error.
                             if   avail tt-emitente-cex then do:
                                  create tt-idioma.
                                  assign tt-idioma.cod-idioma = tt-emitente-cex.cod-idioma.
                             end.
                             else do:       
                                  if  c-cod-idiom-usuar <> "" then do:
                                      create tt-idioma.
                                      assign tt-idioma.cod-idioma = c-cod-idiom-usuar.
                                  end.    
                             end.
                         end.
                         delete procedure h-bocx155.
                      end.   
                   end.
                end.            
                delete procedure h-bocx185.
            end.
            if decl-itiner.emite-agentecarga = yes then do:            
               run cxbo/bocx185.p persistent set h-bocx185.
               run findPk_proc_exp in h-bocx185 (input tt-hist-proc-exp.cod-estabel,
                                                 input tt-hist-proc-exp.nr-proc-exp,
                                                 output c-return).
                if c-return = "" then do:
                   run getCurrent in h-bocx185 (output table tt-processo-exp).
                   find first tt-processo-exp no-lock no-error.
                   if avail tt-processo-exp then do:
                      find  emitente where 
                            emitente.cod-emitente = tt-processo-exp.cod-agente-cia 
                            no-lock no-error.
                      if avail emitente then do:         
                         &if defined(bf-dis-comex) &then 
                         &else
                             assign tt-decl-hist-proc-exp.e-mail-agente = emitente.e-mail.
                         &endif
                         run cxbo/bocx155.p persistent set h-bocx155.
                         run findPk-emitente in h-bocx155 (input emitente.cod-emitente, output c-return).
                         if  c-return = "" then do:
                             run getCurrent in h-bocx155 (output table tt-emitente-cex).
                             find first tt-emitente-cex no-lock no-error.
                             if   avail tt-emitente-cex then do:
                                  create tt-idioma.
                                  assign tt-idioma.cod-idioma = tt-emitente-cex.cod-idioma.
                             end.
                             else do:       
                                  if  c-cod-idiom-usuar <> "" then do:
                                      create tt-idioma.
                                      assign tt-idioma.cod-idioma = c-cod-idiom-usuar.
                                  end.    
                             end.
                         end.
                         delete procedure h-bocx155.
                      end.   
                   end.
                end.            
                delete procedure h-bocx185.
            end.  
            if decl-itiner.emite-representante then do:
               run cxbo/bocx185.p persistent set h-bocx185.
               run findPk_proc_exp in h-bocx185 (input tt-hist-proc-exp.cod-estabel,
                                                 input tt-hist-proc-exp.nr-proc-exp,
                                                 output c-return).
               if c-return = "" then do:
                  run getCurrent in h-bocx185 (output table tt-processo-exp).
                  find first tt-processo-exp no-lock no-error.
                  if avail tt-processo-exp then do: 
                     find first proc-ped-venda where
                                proc-ped-venda.cod-estabel = tt-processo-exp.cod-estabel and
                                proc-ped-venda.nr-proc-exp = tt-processo-exp.nr-proc-exp
                                no-lock no-error.
                     if   avail proc-ped-venda then do:
                          find ped-venda where
                               ped-venda.nr-pedido = proc-ped-venda.nr-pedido
                               no-lock no-error.
                          if   avail ped-venda then do:
                               find repres where
                                    repres.nome-abrev = ped-venda.no-ab-reppri
                                    no-lock no-error.
                               &if defined(bf-dis-comex) &then 
                               &else     
                                   if avail repres then 
                                      /* guarda o e-mail do representando no campo livre char-1 */
                                      assign substr(tt-decl-hist-proc-exp.char-1,1,40) = repres.e-mail.
                               &endif       
                          end.     
                     end.          
                  end.
               end.   
               delete procedure h-bocx185.
            end.
            
            run cxbo/bocx185.p persistent set h-bocx185.
            run findPk_proc_exp in h-bocx185 (input tt-hist-proc-exp.cod-estabel,
                                              input tt-hist-proc-exp.nr-proc-exp,
                                              output c-return).
            if c-return = "" then do:
                run getCurrent in h-bocx185 (output table tt-processo-exp).
                find first tt-processo-exp no-lock no-error.
                if   avail tt-processo-exp then 
                     assign i-cod-emit = tt-processo-exp.cod-emitente.                     
            end.
            delete procedure h-bocx185.         
            for  each tt-idioma:
                 find decl-cliente where 
                      decl-cliente.cod-emitente = i-cod-emit            and
                      decl-cliente.de-codigo    = decl-itiner.de-codigo and
                      decl-cliente.cod-idioma   = tt-idioma.cod-idioma         
                      no-lock no-error.
                 if  avail decl-cliente then do:
                     assign i-pos = length(decl-cliente.texto).
                     if   tt-decl-hist-proc-exp.texto <> "" then 
                          assign tt-decl-hist-proc-exp.texto = tt-decl-hist-proc-exp.texto + 
                                                               chr(10) + chr(10) +
                                                               trim(decl-cliente.texto).                
                     else 
                       assign tt-decl-hist-proc-exp.texto = trim(decl-cliente.texto).                                        
                 end.
                 else do:
                      find decl-cliente where
                           decl-cliente.cod-emitente = 0                     and
                           decl-cliente.de-codigo    = decl-itiner.de-codigo and
                           decl-cliente.cod-idioma   = tt-idioma.cod-idioma
                           no-lock no-error.
                      if   avail decl-cliente then do:
                           assign i-pos                    = length(decl-cliente.texto).
                           if   tt-decl-hist-proc-exp.texto <> "" then
                                assign tt-decl-hist-proc-exp.texto = tt-decl-hist-proc-exp.texto + 
                                                                     chr(10) + chr(10) +
                                                                     trim(decl-cliente.texto).                                   
                           else assign tt-decl-hist-proc-exp.texto = trim(decl-cliente.texto).                                          
                      end.         
                 end.
            end. 

            run validatecreate (input table tt-decl-hist-proc-exp,
                                output table tt-bo-erro,
                                output r-chave).

            delete tt-decl-hist-proc-exp.

        end. /* for each  decl-itiner */

     end. /*if avail processo-exp*/
END.


PROCEDURE deleteTable:

     def input parameter p-cod-estabel like decl-hist-proc-exp.cod-estabel.
     def input parameter p-nr-proc-exp like decl-hist-proc-exp.nr-proc-exp.
     def input parameter p-cod-itiner  like decl-hist-proc-exp.cod-itiner.
     def input parameter p-sequencia   like decl-hist-proc-exp.sequencia.
     def var r-rowid  as rowid no-undo.
     for each decl-hist-proc-exp exclusive-lock
         where decl-hist-proc-exp.cod-estabel = p-cod-estabel
         and   decl-hist-proc-exp.nr-proc-exp = p-nr-proc-exp
         and   decl-hist-proc-exp.cod-itiner  = p-cod-itiner
         and   decl-hist-proc-exp.sequencia   = p-sequencia:
         assign r-rowid = rowid(decl-hist-proc-exp).
         run validateDelete (input-output r-rowid, output table tt-bo-erro).
     end.

END PROCEDURE.


procedure validateDelete:
    /*
    **  Valida Delete
    */
    def input-output parameter r-chave as rowid.
    def output parameter table for tt-bo-erro.
    
    for each tt-bo-erro.
        delete tt-bo-erro.
    end.

    run InitializeValidate.

    find {&TABLE-NAME} where
        rowid({&TABLE-NAME}) = r-chave
        exclusive-lock no-error.
    if avail {&TABLE-NAME} then do:
        run executeDelete.
    end.

    if l-query then
        get next {&QUERY-NAME}
            no-lock no-wait.
    else
        find next {&TABLE-NAME}
            no-lock no-error.

    if not avail {&TABLE-NAME} then do:
       if l-query then
           get prev {&QUERY-NAME}
               no-lock no-wait.
       else
           find prev {&TABLE-NAME}
               no-lock no-error.
    end.
    assign r-chave = rowid({&TABLE-NAME}).
    return "".
end procedure.


procedure getCharField:
    define input  parameter c-field as char.
    define output parameter c-value as char.

    case c-field:
        when "char-1":U then c-value = RowObject.char-1.
        when "char-2":U then c-value = RowObject.char-2.
        when "check-sum":U then c-value = RowObject.check-sum.
        when "cod-estabel":U then c-value = RowObject.cod-estabel.
        when "nr-proc-exp":U then c-value = RowObject.nr-proc-exp.
        when "descricao":U then c-value = RowObject.descricao.
        otherwise return error.
    end case.
end procedure.

procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.

    case c-field:
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        otherwise return error.
    end case.
end procedure.

procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.

    case c-field:
        when "de-codigo" then c-value = RowObject.de-codigo.
        when "cod-itiner" then c-value = RowObject.cod-itiner.
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.
        when "sequencia" then c-value = RowObject.sequencia.
        otherwise return error.
    end case.
end procedure.

procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.

    case c-field:
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.
        otherwise return error.
    end case.
end procedure.

procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.

    case c-field:
        when "decl-emitida" then c-value = RowObject.decl-emitida.
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.
        otherwise return error.
    end case.
end procedure.

procedure pi-recebe-idioma2:
/*
** Procedure que recebe o idioma do usu†rio.
*/ 

def input parameter c_cod_idiom_usuar &if defined(bf-dis-comex) &then 
                                          like idioma.id-codigo.
                                      &else
                                          like idioma.cod_idioma.
                                      &endif 

assign c-cod-idiom-usuar = c_cod_idiom_usuar.

end procedure.

 
procedure retornaTexto:
/*
** Procedure criada para retornar o texto da declaraá∆o.
*/

def input  parameter c-nr-proc-exp     like processo-exp.nr-proc-exp.
def input  parameter c-cod-estabel     like processo-exp.cod-estabel.
def input  parameter i-cod-emitente    like emitente.cod-emitente.
def input  parameter i-de-codigo       like decl-cliente.de-codigo. 
def input  parameter c-cod-idiom-usuar &if defined(bf-dis-comex) &then 
                                           like idioma.id-codigo.
                                       &else
                                           like idioma.cod_idioma.
                                       &endif
def output parameter c-e-mail-ag         as char format "x(40)".
def output parameter c-e-mail-desp       as char format "x(40)".
def output parameter c-e-mail-emit       as char format "x(40)".
def output parameter c-e-mail-fab        as char format "x(40)".
def output parameter c-e-mail-rep        as char format "x(40)".  
def output parameter c-texto           as char format "x(2000)".

assign c-proc            = c-nr-proc-exp 
       c-est             = c-cod-estabel
       i-emit            = i-cod-emitente
       i-decl            = i-de-codigo
       c-idiom-usuar     = c-cod-idiom-usuar.
       
     for each tt-idioma:
         delete tt-idioma.
     end.    

     run cxbo/bocx185.p persistent set h-bocx185.
     run findPk_proc_exp in h-bocx185 (input c-est,
                                       input c-proc,
                                       output c-return).
     if  c-return = "" then do:
         run getCurrent in h-bocx185 (output table tt-processo-exp).
         find first tt-processo-exp no-lock no-error.
         if avail tt-processo-exp then do:
            find  emitente where 
                  emitente.cod-emitente = tt-processo-exp.cod-emitente 
                  no-lock no-error.
            if    avail emitente then do:
                  find  emitente-cex where
                        emitente-cex.cod-emitente = emitente.cod-emitente
                        no-lock no-error.                 
                  if    avail emitente-cex then do:
                        create tt-idioma.
                        assign tt-idioma.cod-idioma = emitente-cex.cod-idioma.
                  end.      
                  else do:
                       create tt-idioma.
                       assign tt-idioma.cod-idioma = c-idiom-usuar.
                  end. 
                  &if defined(bf-dis-comex) &then 
                  &else
                      assign c-e-mail-emit = emitente.e-mail.
                  &endif    
            end.
                  
            find  emitente where 
                  emitente.cod-emitente = tt-processo-exp.cod-despachante
                  no-lock no-error.
            &if defined(bf-dis-comex) &then 
            &else      
                if avail emitente then            
                   assign c-e-mail-desp =  emitente.e-mail.
            &endif       
            find  emitente where
                  emitente.cod-emitente = tt-processo-exp.cod-fabric
                  no-lock no-error.
            &if defined(bf-dis-comex) &then 
            &else      
                if avail emitente then
                   assign c-e-mail-fab = emitente.e-mail.
            &endif       
            find  emitente where
                  emitente.cod-emitente = tt-processo-exp.cod-agente-cia
                  no-lock no-error.
            &if defined(bf-dis-comex) &then 
            &else
                if avail emitente then 
                   assign c-e-mail-ag = emitente.e-mail.
            &endif       
            find first proc-ped-venda where
                       proc-ped-venda.cod-estabel = tt-processo-exp.cod-estabel and
                       proc-ped-venda.nr-proc-exp = tt-processo-exp.nr-proc-exp
                       no-lock no-error.
            if   avail proc-ped-venda then do:
                 find ped-venda where
                      ped-venda.nr-pedido = proc-ped-venda.nr-pedido
                      no-lock no-error.
                 if   avail ped-venda then do:
                      find repres where
                           repres.nome-abrev = ped-venda.no-ab-reppri
                           no-lock no-error.
                     &if defined(bf-dis-comex) &then 
                     &else      
                         if   avail repres then 
                              assign c-e-mail-rep = repres.e-mail.
                     &endif         
                 end.    
            end.
                 
            find  tt-idioma where
                  tt-idioma.cod-idioma = tt-processo-exp.cod-idioma
                  no-error.
            if    not avail tt-idioma then do:          
                  create tt-idioma.
                  assign tt-idioma.cod-idioma = tt-processo-exp.cod-idioma.
            end.
            find emitente-cex where
                 emitente-cex.cod-emitente = tt-processo-exp.cod-despachante
                 no-lock no-error.                 
            if   avail emitente-cex then do:
                 find tt-idioma where
                      tt-idioma.cod-idioma = emitente-cex.cod-idioma
                      no-error.
                 if   not avail tt-idioma then do:     
                      create tt-idioma.
                      assign tt-idioma.cod-idioma = emitente-cex.cod-idioma.
                 end.     
            end.     
            find emitente-cex where
                 emitente-cex.cod-emitente = tt-processo-exp.cod-agente-cia
                 no-lock no-error.                 
            if   avail emitente-cex then do:
                 find tt-idioma where
                      tt-idioma.cod-idioma = emitente-cex.cod-idioma
                      no-error.
                 if   not avail tt-idioma then do:     
                      create tt-idioma.
                      assign tt-idioma.cod-idioma = emitente-cex.cod-idioma.
                 end.     
            end.
            find emitente-cex where
                 emitente-cex.cod-emitente = tt-processo-exp.cod-fabric
                 no-lock no-error.                 
            if   avail emitente-cex then do:
                 find tt-idioma where
                      tt-idioma.cod-idioma = emitente-cex.cod-idioma
                      no-error.
                 if   not avail tt-idioma then do:     
                      create tt-idioma.
                      assign tt-idioma.cod-idioma = emitente-cex.cod-idioma.
                 end.     
            end.
            
            for each tt-idioma:
                find decl-cliente where 
                     decl-cliente.cod-emitente   = tt-processo-exp.cod-emitente and
                     decl-cliente.de-codigo      = i-decl                       and
                     decl-cliente.cod-idioma     = tt-idioma.cod-idioma         
                     no-lock no-error.
                if  avail decl-cliente then do:
                    assign i-pos = length(decl-cliente.texto).
                    if   c-texto <> " " then 
                         assign c-texto = c-texto + chr(10) + chr(10) + subst(decl-cliente.texto,1,i-pos).                
                    else assign c-texto = subst(decl-cliente.texto,1,i-pos).                                                                            
                end.
                else do:
                     find decl-cliente where
                          decl-cliente.cod-emitente = 0      and
                          decl-cliente.de-codigo    = i-decl and
                          decl-cliente.cod-idioma   = tt-idioma.cod-idioma
                          no-lock no-error.
                     if   avail decl-cliente then do:
                          assign i-pos = length(decl-cliente.texto).
                          if   c-texto <> " " then 
                               assign c-texto = c-texto + chr(10) + chr(10) + subst(decl-cliente.texto,1,i-pos).                
                         else  assign c-texto = subst(decl-cliente.texto,1,i-pos).
                     end.         
                end. 
            end.
         end.   
    end.     
    delete procedure h-bocx185. 
end procedure. 

procedure validaDeclaracao:
/*
** Procedure para tela de declaraá∆o.
*/

def input  parameter c_est         like decl-hist-proc-exp.cod-estabel.
def input  parameter c_proc        like decl-hist-proc-exp.nr-proc-exp.
def input  parameter i_iti         like decl-hist-proc-exp.cod-itiner.
def input  parameter i_decl        like decl-hist-proc-exp.de-codigo.
def input  parameter i_emit        like emitente.cod-emitente.
def input  parameter c_idiom_usuar &if defined(bf-dis-comex) &then 
                                       like idioma.id-codigo.
                                   &else
                                       like idioma.cod_idioma.
                                   &endif 
def output parameter table for tt-bo-erro.

assign c-est         = c_est
       c-proc        = c_proc
       i-iti         = i_iti
       i-decl        = i_decl
       i-emit        = i_emit
       c-idiom-usuar = c_idiom_usuar.
       
for first decl-hist-proc-exp fields(de-codigo) 
    where decl-hist-proc-exp.cod-estabel = c-est  and
          decl-hist-proc-exp.nr-proc-exp = c-proc and
          decl-hist-proc-exp.cod-itiner  = i-iti  and
          decl-hist-proc-exp.de-codigo   = i-decl
          no-lock:
end.
if   avail decl-hist-proc-exp then do:
     assign i-seq-erro = i-seq-erro + 1.
     /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
        pre-processador em chamada de includes */
     {utp/ut-table.i mgcex decl-hist-proc-exp 1}
     run utp/ut-msgs.p (input "msg",
                        input 8,
                        input return-value).
     create tt-bo-erro.
     assign tt-bo-erro.i-sequen     = i-seq-erro
            tt-bo-erro.cd-erro      = 8
            tt-bo-erro.mensagem     = return-value.
end.


for first emitente-cex fields(cod-idioma) 
    where emitente-cex.cod-emitente = i-emit
    no-lock:
end.
if avail emitente-cex then do:     
     for first decl-cliente fields(de-codigo)
         where decl-cliente.cod-emitente = i-emit and
               decl-cliente.de-codigo    = i-decl and
               decl-cliente.cod-idioma   = emitente-cex.cod-idioma
               no-lock:
     end.
     if   not avail decl-cliente then do:
          for first decl-cliente fields(de-codigo)
              where decl-cliente.cod-emitente = 0      and
                    decl-cliente.de-codigo    = i-decl and
                    decl-cliente.cod-idioma   = emitente-cex.cod-idioma
                    no-lock:
          end.
          if   not avail decl-cliente then do:
               assign i-seq-erro = i-seq-erro + 1.
               /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                  pre-processador em chamada de includes */
               {utp/ut-table.i mgcex decl-cliente 1}
               run utp/ut-msgs.p (input "msg",
                                  input 2,
                                  input return-value).
               create tt-bo-erro.
               assign tt-bo-erro.i-sequen     = i-seq-erro
                      tt-bo-erro.cd-erro      = 2
                      tt-bo-erro.mensagem     = return-value.
          end.
     end.
end.
else do:
     for first decl-cliente fields(de-codigo) 
         where decl-cliente.cod-emitente = i-emit and
               decl-cliente.de-codigo    = i-decl and
               decl-cliente.cod-idioma   = c-idiom-usuar
               no-lock:
     end.
     if not avail decl-cliente then do:
          for first decl-cliente fields(de-codigo) 
              where decl-cliente.cod-emitente = 0      and
                    decl-cliente.de-codigo    = i-decl and
                    decl-cliente.cod-idioma   = c-idiom-usuar
                    no-lock:
          end.
          if not avail decl-cliente then do: 
               assign i-seq-erro = i-seq-erro + 1.
               /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
                  pre-processador em chamada de includes */
               {utp/ut-table.i mgcex decl-cliente 1}
               run utp/ut-msgs.p (input "msg",
                                  input 2,
                                  input return-value).
               create tt-bo-erro.
               assign tt-bo-erro.i-sequen     = i-seq-erro
                      tt-bo-erro.cd-erro      = 2
                      tt-bo-erro.mensagem     = return-value.
          end.
     end.     
end.         

end procedure.

procedure pi-seta-alteracao-itiner:
/*-----------------------------------------------------------------------------------
    Purpose: Recebe um parÉmetro l¢gico indicando se o itiner†rio foi alterado ou n∆o.
    Parameters: pAltItiner: YES = Itiner†rio alterado; 
                             NO = Itiner†rio n∆o sofreu alteraá∆o.
    Notes:   
-----------------------------------------------------------------------------------*/
     define input param pAltItiner as logical no-undo.
     
     assign lAlteracaoItinerario = pAltItiner.

    return "OK":U.
end procedure.

procedure findDeclHistProcExp:
/*-----------------------------------------------------------------------------------
    Purpose: Procura declaraá∆o do processo de exportaá∆o.
    Parameters: pcod-estabel - C¢digo do estabelecimento
                pnr-proc-exp - N£mero do processo de exportaá∆o
                pcod-itiner  - C¢digo do itiner†rio
                pc-return    - Retorna branco se encontrar registro, 
                               caso contr†rio retorna a mensagem do erro 2.
    Notes:   
-----------------------------------------------------------------------------------*/
    define input param pcod-estabel Like decl-hist-proc-exp.cod-estabel no-undo.
    define input param pnr-proc-exp Like decl-hist-proc-exp.nr-proc-exp no-undo.
    define input param pcod-itiner  Like decl-hist-proc-exp.cod-itiner  no-undo.
    define output param pc-return   as character                        no-undo.

    find first decl-hist-proc-exp
         where decl-hist-proc-exp.cod-estabel   = pcod-estabel
           and decl-hist-proc-exp.nr-proc-exp   = pnr-proc-exp
           and decl-hist-proc-exp.cod-itiner    = pcod-itiner no-lock no-error.
    if not avail decl-hist-proc-exp then do:
        {utp/ut-table.i mgcex decl-hist-proc-exp 1}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign pc-return = return-value.
    end.
    return "OK":U.
end procedure.

procedure pi-valida-decl-acomp:
/*-----------------------------------------------------------------------------------
    Purpose: Validaá∆o da declaraá∆o do ponto do itinerario. /*ex0200*/
    Parameters: input - RowObject (temp-table) : Informaá‰es da declaraá∆o 
                output - tt-bo-erro (temp-table) : Erros ocorridos durante o processo.
    Notes:   
-----------------------------------------------------------------------------------*/
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    
    find first RowObject no-error.
    
    /* Verifica se o ponto informado para a declaraá∆o j† est† efetivado. */
    FOR FIRST historico-proc-exp fields(dt-efetiva cod-pto-contr) no-lock
        WHERE historico-proc-exp.cod-estabel = rowObject.cod-estabel
          AND historico-proc-exp.nr-proc-exp = rowObject.nr-proc-exp
          AND historico-proc-exp.cod-itiner  = rowObject.cod-itiner
          AND historico-proc-exp.sequencia   = rowObject.sequencia:
        IF historico-proc-exp.dt-efetiva <> ? THEN DO: /* Ponto de controle j† efetivado */
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i "O ponto de controle "}
            assign c-msg-params = RETURN-VALUE + STRING(historico-proc-exp.cod-pto-contr).
            run utp/ut-msgs.p (input "msg",
                               input 26202,
                               input c-msg-params).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 26202
                   tt-bo-erro.mensagem     = return-value
                   tt-bo-erro.errorhelp    = return-value
                   tt-bo-erro.parametros   = c-msg-params.
            create tt-campo-erro.
            assign tt-campo-erro.campo = "cod-pto-contr":U.
        END.
    END.
 
    return "OK":U.
end procedure.

PROCEDURE getFieldErrors:
/*------------------------------------------------------------------------------------------
Purpose: Retornar uma temp-table com informaá‰es dos erros ocorridos durante alteraá∆o/criaá∆o.
Parameters:  (output) (temp-table) tt-campo-erro: Nome do campo em que ocorreu o erro.
Notes: 
------------------------------------------------------------------------------------------*/
   DEFINE OUTPUT PARAMETER TABLE FOR tt-campo-erro.

   RETURN "OK":U.
END PROCEDURE.
