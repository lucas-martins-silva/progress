{cxbo/bocx155.i tt-emitente-cex}
{cxbo/bocx200.i tt-hist-proc-exp}

define temp-table tt-idioma no-undo
   field cod-idioma &if defined(bf-dis-comex) &then 
                        like idioma.id-codigo
                    &else
                        like idioma.cod_idioma
                    &endif 
   index idioma cod-idioma.

DEFINE TEMP-TABLE tt-campo-erro NO-UNDO
    FIELD campo       AS CHARACTER.
    
define buffer b-decl-cliente for decl-cliente.        

DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

procedure setConstraint1:

end procedure.

PROCEDURE setConstraint2:

    DEFINE input parameter p-cod-estabel   like decl-hist-proc-exp.cod-estabel   no-undo.
    DEFINE input parameter p-nr-proc-exp   like decl-hist-proc-exp.nr-proc-exp   no-undo.
    DEFINE input parameter p-cod-itiner    like decl-hist-proc-exp.cod-itiner    no-undo.
    DEFINE input parameter p-nr-sequencia  like decl-hist-proc-exp.sequencia     no-undo.
    DEFINE input parameter p-codigo        like decl-hist-proc-exp.de-codigo     no-undo.

    assign c-cod-estabel    = p-cod-estabel
           c-nr-proc-exp    = p-nr-proc-exp
           i-cod-itiner     = int(p-cod-itiner)
           i-nr-sequencia   = int(p-nr-sequencia)
           de-codigo        = int(p-codigo).

END PROCEDURE.

PROCEDURE setConstraint3:

  DEFINE input parameter p-chave as rowid no-undo.

  assign r-chave = p-chave.

END PROCEDURE.

PROCEDURE setConstraint4:
    DEFINE input parameter p-cod-estabel   like decl-hist-proc-exp.cod-estabel   no-undo.
    DEFINE input parameter p-nr-proc-exp   like decl-hist-proc-exp.nr-proc-exp   no-undo.
    DEFINE input parameter p-cod-itiner    like decl-hist-proc-exp.cod-itiner    no-undo.
    DEFINE input parameter p-nr-sequencia  like decl-hist-proc-exp.sequencia     no-undo.

    assign c-cod-estabel    = p-cod-estabel
           c-nr-proc-exp    = p-nr-proc-exp
           i-cod-itiner     = int(p-cod-itiner)
           i-nr-sequencia   = int(p-nr-sequencia).
END PROCEDURE.

PROCEDURE setConstraint5:
    DEFINE input parameter p-cod-estabel   like decl-hist-proc-exp.cod-estabel   no-undo.
    DEFINE input parameter p-nr-proc-exp   like decl-hist-proc-exp.nr-proc-exp   no-undo.
    DEFINE input parameter p-cod-itiner    like decl-hist-proc-exp.cod-itiner    no-undo.

    assign c-cod-estabel    = p-cod-estabel
           c-nr-proc-exp    = p-nr-proc-exp
           i-cod-itiner     = int(p-cod-itiner).
           
END PROCEDURE.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock
                                              {&v9indrep}.
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where
                                         decl-hist-proc-exp.cod-estabel   >= c-cod-estabel  and
                                         decl-hist-proc-exp.nr-proc-exp   >= c-nr-proc-exp  and
                                         decl-hist-proc-exp.cod-itiner    >= i-cod-itiner   and
                                         decl-hist-proc-exp.sequencia     >= i-nr-sequencia and
                                         decl-hist-proc-exp.de-codigo     >= de-codigo no-lock
                                         {&v9indrep}.
        when 3 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock
                                         where rowid(decl-hist-proc-exp) = r-chave
                                         {&v9indrep}.
        when 4 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where
                                         decl-hist-proc-exp.cod-estabel   = c-cod-estabel  and
                                         decl-hist-proc-exp.nr-proc-exp   = c-nr-proc-exp  and
                                         decl-hist-proc-exp.cod-itiner    = i-cod-itiner   and
                                         decl-hist-proc-exp.sequencia     = i-nr-sequencia no-lock
                                         {&v9indrep}.
       when 5 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where
                                         decl-hist-proc-exp.cod-estabel   = c-cod-estabel  and
                                         decl-hist-proc-exp.nr-proc-exp   = c-nr-proc-exp  and
                                         decl-hist-proc-exp.cod-itiner    = i-cod-itiner   no-lock
                                         {&v9indrep}.                                        
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.

end procedure.

