/* *********************************************************************** 
**   Include Chamadas upc(s) 
**
**   
**     
************************************************************************* */     
     
     /************** EPC - Inicio ***** ***********/
     for each tt-epc 
       where tt-epc.cod-event = "BEFORE-VALID-ESTABEL": 
       delete tt-epc. 
     end. 
     /*** Criacao do registro para temp-table tt-epc ***/
     {include/i-epc200.i2 &CodEvent='"BEFORE-VALID-ESTABEL"'
                          &CodParameter='"TABLE-FIELDS"'
                          &ValueParameter=c-cod-estabel }
         
     /*** Chamada do programa EPC ***/
     {include/i-epc201.i "BEFORE-VALID-ESTABEL"}
   
   
     /************** EPC - Inicio ***** ***********/
     for each tt-epc 
       where tt-epc.cod-event = "BEFORE-VALID-PROCESS": 
       delete tt-epc. 
     end. 
     /*** Criacao do registro para temp-table tt-epc ***/
     {include/i-epc200.i2 &CodEvent='"BEFORE-VALID-PROCESS"'
                          &CodParameter='"TABLE-FIELDS"'
                          &ValueParameter=c-nr-proc-exp }
     /*** Chamada do programa EPC ***/
     {include/i-epc201.i "BEFORE-VALID-PROCESS"}
     

     /************** EPC - Inicio ***** ***********/
     for each tt-epc 
       where tt-epc.cod-event = "BEFORE-VALID-PEDIDO": 
       delete tt-epc. 
     end. 
     /*** Criacao do registro para temp-table tt-epc ***/
     {include/i-epc200.i2 &CodEvent='"BEFORE-VALID-PEDIDO"'
                          &CodParameter='"TABLE-FIELDS"'
                          &ValueParameter=string(c-nr-pedido) }
     /*** Chamada do programa EPC ***/
     {include/i-epc201.i "BEFORE-VALID-PEDIDO"}

/* End Include */
