{cdp/cdcfgdis.i} /* Definicao de pre-processadores */

DEFINE var c-cod-estabel    like proc-nota-fiscal.cod-estabel no-undo.
DEFINE var c-nr-proc-exp    like proc-nota-fiscal.nr-proc-exp no-undo. 
DEFINE VAR h-bocx195        as handle no-undo.
define var c-rowid          as char   no-undo.

&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.001
&scoped-define FIRST-TABLE-IN-QUERY proc-nota-fiscal
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME proc-nota-fiscal
 
{include/boini.i}
 
DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.
{cxbo/bocx260.i RowObject}
{cxbo/bocx260.i tt-proc-nota-fiscal}

&IF DEFINED(bf-dis-comex) &THEN
&ELSE
    {include/i-epc200.i "bocx260"}
&ENDIF

procedure setConstraint1:

end.

PROCEDURE setConstraint2:
    def input parameter p-cod-estab like proc-nota-fiscal.cod-estabel no-undo. 
    def input parameter p-proc-exp  like proc-nota-fiscal.nr-proc-exp no-undo.
        assign c-cod-estabel    = p-cod-estab 
               c-nr-proc-exp    = p-proc-exp.
               
END PROCEDURE.

PROCEDURE setConstraint3:
    def input parameter r-chave as rowid no-undo.
    find processo-exp  no-lock
         where rowid(processo-exp) = r-chave no-error.
END PROCEDURE.

PROCEDURE setConstraint4:
    def input parameter p-proc-exp  like proc-nota-fiscal.nr-proc-exp no-undo.
    assign c-nr-proc-exp = p-proc-exp.

END PROCEDURE.

procedure openQuery:
    
    define input parameter i-abertura as integer no-undo.
    assign i-bo-query = i-abertura.
    assign l-query = yes.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock. 
        when 2 then do:
            open query {&QUERY-NAME} for each {&TABLE-NAME} where proc-nota-fiscal.cod-estabel = c-cod-estabel and ~     
                                                                  proc-nota-fiscal.nr-proc-exp = c-nr-proc-exp no-lock.
        end.                                                          
        when 3 then 
            if c-nr-proc-exp = "" then do:
               open query {&QUERY-NAME} for each {&TABLE-NAME} of processo-exp no-lock 
                     by proc-nota-fiscal.nr-nota-fis 
                     by proc-nota-fiscal.serie
                     by proc-nota-fiscal.cod-estabel.
            end.
            else do:
               open query {&QUERY-NAME} for each {&TABLE-NAME} where proc-nota-fiscal.nr-proc-exp = c-nr-proc-exp no-lock
                     by proc-nota-fiscal.nr-nota-fis 
                     by proc-nota-fiscal.serie
                     by proc-nota-fiscal.cod-estabel.
            end.   
        when 4 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where proc-nota-fiscal.nr-proc-exp = c-nr-proc-exp no-lock.
    end case.
   
end procedure.

 
