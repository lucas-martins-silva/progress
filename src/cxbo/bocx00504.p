PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice id--chave
  Parameters:  
               retorna valor do campo cod-item
               retorna valor do campo cod-class-fisc
               retorna valor do campo cod-atrib
               retorna valor do campo cod-domin
               retorna valor do campo ind-modal
               retorna valor do campo num-seq
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pcod-item LIKE item-atrib-det.cod-item NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-class-fisc LIKE item-atrib-det.cod-class-fisc NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-atrib LIKE item-atrib-det.cod-atrib NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-domin LIKE item-atrib-det.cod-domin NO-UNDO.
    DEFINE OUTPUT PARAMETER pind-modal LIKE item-atrib-det.ind-modal NO-UNDO.
    DEFINE OUTPUT PARAMETER pnum-seq LIKE item-atrib-det.num-seq NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pcod-item = RowObject.cod-item
           pcod-class-fisc = RowObject.cod-class-fisc
           pcod-atrib = RowObject.cod-atrib
           pcod-domin = RowObject.cod-domin
           pind-modal = RowObject.ind-modal
           pnum-seq = RowObject.num-seq.

    RETURN "OK":U.
END PROCEDURE.

