&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram  
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice id--chave
  Parameters:  
               recebe valor do campo cod-item
               recebe valor do campo cod-class-fisc
               recebe valor do campo cod-atrib
               recebe valor do campo cod-domin
               recebe valor do campo ind-modal
               recebe valor do campo num-seq
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-item LIKE item-atrib-det.cod-item NO-UNDO.
    DEFINE INPUT PARAMETER pcod-class-fisc LIKE item-atrib-det.cod-class-fisc NO-UNDO.
    DEFINE INPUT PARAMETER pcod-atrib LIKE item-atrib-det.cod-atrib NO-UNDO.
    DEFINE INPUT PARAMETER pcod-domin LIKE item-atrib-det.cod-domin NO-UNDO.
    DEFINE INPUT PARAMETER pind-modal LIKE item-atrib-det.ind-modal NO-UNDO.
    DEFINE INPUT PARAMETER pnum-seq LIKE item-atrib-det.num-seq NO-UNDO.

    FIND FIRST bfitem-atrib-det WHERE 
        bfitem-atrib-det.cod-item = pcod-item AND 
        bfitem-atrib-det.cod-class-fisc = pcod-class-fisc AND 
        bfitem-atrib-det.cod-atrib = pcod-atrib AND 
        bfitem-atrib-det.cod-domin = pcod-domin AND 
        bfitem-atrib-det.ind-modal = pind-modal AND 
        bfitem-atrib-det.num-seq = pnum-seq NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfitem-atrib-det THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfitem-atrib-det)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

