&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getNextNumSeq DBOProgram 
PROCEDURE getNextNumSeq :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER p-num-seq LIKE item-atrib-det.num-seq NO-UNDO.
    
    FOR EACH item-atrib-det WHERE item-atrib-det.cod-item = c-item
                            NO-LOCK:
        ASSIGN p-num-seq = p-num-seq + 1.
    END.
    ASSIGN p-num-seq = p-num-seq + 1.
    
    FOR FIRST item-atrib-det FIELD(num-seq)
                             WHERE item-atrib-det.cod-item = c-item
                             AND   item-atrib-det.num-seq  = p-num-seq:
    END.
    IF AVAIL item-atrib-det THEN DO:
        DO WHILE AVAIL item-atrib-det:            
            ASSIGN p-num-seq = p-num-seq + 1.
            FOR FIRST item-atrib-det FIELD(num-seq)
                                     WHERE item-atrib-det.cod-item = c-item
                                     AND   item-atrib-det.num-seq  = p-num-seq:
            END.            
        END.        
    END.    

    RETURN "OK":U.
    
END PROCEDURE.

