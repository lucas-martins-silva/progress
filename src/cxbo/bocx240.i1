DEFINE VAR c-cod-estabel  like proc-container.cod-estabel  no-undo.
DEFINE VAR c-nr-proc-exp  like proc-container.nr-proc-exp  no-undo.
DEFINE VAR c-id-container like proc-container.id-container no-undo.
DEFINE VAR c-id-container-ini like proc-container.id-container no-undo.
DEFINE VAR c-id-container-fin like proc-container.id-container no-undo.
DEFINE VAR c-nr-proc-exp-ini like proc-container.nr-proc-exp no-undo.
DEFINE VAR c-nr-proc-exp-fin like proc-container.nr-proc-exp no-undo.


define var h-bocx245      as handle.

&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.001
&scoped-define FIRST-TABLE-IN-QUERY proc-container
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME proc-container

{cdp/cdcfgdis.i}

&IF INTEGER(ENTRY(1,PROVERSION,".")) >= 9 &THEN
   &GLOBAL-DEFINE v9indrep  INDEXED-REPOSITION
&endif

{include/boini.i}

{cxbo/bocx240.i RowObject}

DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

procedure setConstraint1:

end procedure.

procedure setConstraint2:
    def input parameter p-nr-proc-exp  as char no-undo.
    def input parameter p-cod-estabel  as char no-undo.
    def input parameter p-id-container as char no-undo.

    assign c-nr-proc-exp  = p-nr-proc-exp
           c-cod-estabel  = p-cod-estabel
           c-id-container = p-id-container .
end procedure.

procedure setConstraint3:
    def input parameter p-id-container-ini as char no-undo.
    def input parameter p-id-container-fin as char no-undo.

    assign c-id-container-ini = p-id-container-ini
           c-id-container-fin = p-id-container-fin.
end procedure.

procedure setConstraint4:
    def input parameter p-id-container-ini as char no-undo.
    def input parameter p-id-container-fin as char no-undo.
    def input parameter p-nr-proc-exp-ini as char no-undo.
    def input parameter p-nr-proc-exp-fin as char no-undo.

    assign c-id-container-ini = p-id-container-ini
           c-id-container-fin = p-id-container-fin
           c-nr-proc-exp-ini = p-nr-proc-exp-ini
           c-nr-proc-exp-fin = p-nr-proc-exp-fin.
end procedure.


procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock
                                     {&v9indrep}.
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where
                                     proc-container.cod-estabel  = c-cod-estabel and
                                     proc-container.nr-proc-exp  = c-nr-proc-exp and
                                     proc-container.id-container = c-id-container no-lock
                                     use-index pk-proc-container
                                     {&v9indrep}.
        when 3 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where
                                     proc-container.id-container >= c-id-container-ini and ~
                                     proc-container.id-container <= c-id-container-fin no-lock
                                     {&v9indrep}.
        when 4 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where
                                     proc-container.cod-estabel  >= c-cod-estabel and
                                     proc-container.nr-proc-exp  >= c-nr-proc-exp and
                                     proc-container.id-container >= c-id-container no-lock
                                     use-index pk-proc-container
                                     {&v9indrep}.
        when 5 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} where
                                     proc-container.id-container >= c-id-container-ini and ~
                                     proc-container.id-container <= c-id-container-fin and ~
                                     proc-container.nr-proc-exp >= c-nr-proc-exp-ini and ~
                                     proc-container.nr-proc-exp <= c-nr-proc-exp-fin no-lock
                                     {&v9indrep}.

    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.

