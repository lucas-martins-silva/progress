procedure initializeValidate:
    /*
    **  Inicializa Validate
    */

    run startMethod ("initializeValidade").

    run endMethod   ("initializeValidade").
end procedure.

procedure findCh_container:

    /*  Procura pelo indice, caso nao ache, ****
    **  retorna mensagem de erro padrao do EMS.*/
    run startMethod ("find").

    def input parameter p-id-container like proc-container.id-container no-undo.
    def output parameter c-return as char no-undo.

    find first {&TABLE-NAME}  no-lock
         where {&TABLE-NAME}.id-container = p-id-container no-error.
    if not avail {&TABLE-NAME} then do:
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-table.i mgcex proc-container 1}
       run utp/ut-msgs.p (input "msg",
                          input 2,
                          input return-value).
       assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").

end procedure.

procedure findCh_proc-exp:

    /*  Procura pelo indice, caso nao ache, ****
    **  retorna mensagem de erro padrao do EMS.*/
    run startMethod ("find").

    def input parameter p-nr-proc-exp  like proc-container.nr-proc-exp  no-undo.
    def input parameter p-cod-estabel  like proc-container.cod-estabel  no-undo.
    def output parameter c-return as char no-undo.

    find first {&TABLE-NAME}  no-lock
         where {&TABLE-NAME}.nr-proc-exp  = p-nr-proc-exp
           and {&TABLE-NAME}.cod-estabel  = p-cod-estabel no-error.
    if not avail {&TABLE-NAME} then do:
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-table.i mgcex proc-container 1}
       run utp/ut-msgs.p (input "msg",
                          input 2,
                          input return-value).
       assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").

end procedure.

procedure findPk_proc_container:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    run startMethod ("find").
    def input parameter c-cod-estabel as char no-undo.
    def input parameter c-nr-proc-exp as char no-undo.
    def input parameter c-id-container as char no-undo.
    def output parameter c-return as char no-undo.

    find proc-container where
        proc-container.cod-estabel = c-cod-estabel
        and proc-container.nr-proc-exp = c-nr-proc-exp
        and proc-container.id-container = c-id-container
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex proc-container 1}
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod ("find").
end procedure.

procedure validateFields:
    /*
    **  Valida Fields
    */
    find first rowObject
        no-lock no-error.

    run startMethod ("validateFields").

    if rowObject.cod-estabel = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 190,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 190
               tt-bo-erro.mensagem     = return-value.
    end.

    if rowObject.id-container = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 190,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 190
               tt-bo-erro.mensagem     = return-value.
    end.

    if rowObject.nr-proc-exp = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 190,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 190
               tt-bo-erro.mensagem     = return-value.
    end.

    run endMethod ("validateFields").

end procedure.

procedure validateCreate:
    /*
    **  Valida cria‡Æo da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.

    run initializeValidate.
    run startMethod ("validateCreate").

    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

    find first rowObject
        no-lock no-error.

    if rowObject.cod-estabel = "" then do:
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-field.i mgcex proc-container cod-estabel 1}
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 190,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 190
               tt-bo-erro.mensagem     = return-value.
    end.

    if rowObject.nr-proc-exp = "" then do:
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-field.i mgcex proc-container nr-proc-exp 1}
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 190,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 190
               tt-bo-erro.mensagem     = return-value.
    end.

    if not can-find(processo-exp where processo-exp.cod-estabel = rowObject.cod-estabel
                                   and processo-exp.nr-proc-exp = rowObject.nr-proc-exp) then do:
       assign i-seq-erro = i-seq-erro + 1.
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-table.i mgcex processo-exp 1}
       run utp/ut-msgs.p (input "msg",
                          input 2,
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen     = i-seq-erro
              tt-bo-erro.cd-erro      = 2
              tt-bo-erro.mensagem     = return-value.
    end.

    if rowObject.id-container = "" then do:
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-field.i mgcex proc-container id-container 1}
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 190,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 190
               tt-bo-erro.mensagem     = return-value.
    end.
    if rowObject.cod-estabel = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-container cod-estabel 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.

    if rowObject.id-container = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-container id-container 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.

    if rowObject.nr-proc-exp = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex proc-container nr-proc-exp 1}
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.

    find first tt-bo-erro
        no-lock no-error.
    if not available tt-bo-erro then do:
        find proc-container where
            proc-container.cod-estabel = rowObject.cod-estabel
        and proc-container.nr-proc-exp = rowObject.nr-proc-exp
        and proc-container.id-container = rowObject.id-container
            no-lock no-error.
        if avail proc-container then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex proc-container 1}
            run utp/ut-msgs.p (input "msg",
                               input 8,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 8
                   tt-bo-erro.mensagem     = return-value.
        end.
    end.

    run validateFields.
    find first tt-bo-erro
        no-lock no-error.

    if not avail tt-bo-erro then do:
       run executeCreate.
       assign r-chave = to-rowid(return-value).
    end.

    run endMethod ("validateCreate").
end procedure.

procedure executeUpdate:

    /*  Executa Update  */
    buffer-copy RowObject except r-rowid
                                 cod-estabel
                                 nr-proc-exp
                                 id-container to {&TABLE-NAME}.

end procedure.


procedure getCharField:
    define input  parameter c-field as char.
    define output parameter c-value as char.

    case c-field:
        when "char-1" then c-value = RowObject.char-1.
        when "char-2" then c-value = RowObject.char-2.
        when "check-sum" then c-value = RowObject.check-sum.
        when "cod-estabel" then c-value = RowObject.cod-estabel.
        when "id-container" then c-value = RowObject.id-container.
        when "nr-proc-exp" then c-value = RowObject.nr-proc-exp.
        otherwise return error.
    end case.
end procedure.

procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.

    case c-field:
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        otherwise return error.
    end case.
end procedure.

procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.

    case c-field:
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.
        otherwise return error.
    end case.
end procedure.

procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.

    case c-field:
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.
        otherwise return error.
    end case.
end procedure.

procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.

    case c-field:
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.
        otherwise return error.
    end case.
end procedure.


PROCEDURE deleteTable:

     def input parameter p-cod-estabel like {&TABLE-NAME}.cod-estabel.
     def input parameter p-nr-proc-exp like {&TABLE-NAME}.nr-proc-exp.

    /* def output parameter table for tt-bo-erro.*/
     def var r-rowid  as rowid no-undo.

     for each {&TABLE-NAME} exclusive-lock
         where {&TABLE-NAME}.cod-estabel = p-cod-estabel
         and   {&TABLE-NAME}.nr-proc-exp = p-nr-proc-exp:
         assign r-rowid = rowid({&TABLE-NAME}).
         run validateDelete (input-output r-rowid, output table tt-bo-erro) .
     end.

END PROCEDURE.

PROCEDURE validateDelete:

    /*  Valida Delete */
    def input-output parameter r-chave as rowid.
    def output parameter table for tt-bo-erro.

    run InitializeValidate.
    run startMethod ("validateDelete").
    RUN cxbo/bocx245.p persistent set h-bocx245.
    find {&TABLE-NAME}
         where rowid({&TABLE-NAME}) = r-chave exclusive-lock no-error.
    if avail {&TABLE-NAME} then do:
       run deleteTable in h-bocx245 (input {&TABLE-NAME}.cod-estabel,
                                     input {&TABLE-NAME}.nr-proc-exp,
                                     input {&TABLE-NAME}.id-container).
       run executeDelete.
    end.

    delete procedure h-bocx245.
    find next {&TABLE-NAME} no-lock no-error.
    if not avail {&TABLE-NAME} then
        find prev {&TABLE-NAME}
            no-lock no-error.
    assign r-chave = rowid({&TABLE-NAME}).
    return "".
    run endMethod ("validateDelete").

END PROCEDURE.


