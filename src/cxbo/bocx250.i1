DEFINE QUERY {&QUERY-NAME} for param-imp scrolling.

def var c-cod-estabel         like estabelec.cod-estabel     no-undo.
def var c-cod-estabel-ini     like estabelec.cod-estabel     no-undo.
def var c-cod-estabel-fim     like estabelec.cod-estabel     no-undo.
def var c-confirma-senha      as character format "x(15)":U  no-undo.
def var c-confirma-senha-pch  as character format "x(15)":U  no-undo.
def var l-fn-antecip          as logical                     no-undo.

def var i-empresa like param-global.empresa-prin no-undo.

ASSIGN l-fn-antecip = CAN-FIND(FIRST funcao
                               WHERE funcao.cd-funcao = "spp-imp-antecip":U
                                 AND funcao.ativo     = YES).
                                 
def var h-bocx00454 as handle no-undo.
{cxbo/bocx00454.i tt-internac-impto-faixa}
{method/dbotterr.i} 
def buffer bf-param-imp for param-imp.

/***********API FINANCAS****************/
def var h_api_cta          as handle no-undo.
def var h_api_ccust        as handle no-undo.
def var p_cod_format_cta_ctbl   as char   no-undo.
DEF VAR p_cod_format_ccusto     AS CHAR NO-UNDO.
DEF VAR p_des_titulo        AS CHAR NO-UNDO.
DEF VAR v_des_ccusto        AS CHAR NO-UNDO.
DEF VAR v_cod_cta_ctbl AS CHAR NO-UNDO.
DEF VAR v_des_cta_ctbl AS CHAR NO-UNDO.
DEF VAR v_num_tip_cta_ctbl AS CHAR NO-UNDO.
DEF VAR v_num_sit_cta_ctbl AS INT NO-UNDO.
DEF VAR v_ind_finalid_cta AS CHAR NO-UNDO.

def temp-table tt_log_erro no-undo
    field ttv_num_cod_erro  as integer format ">>>>,>>9" label "N£mero" column-label "Número"
    field ttv_des_msg_ajuda as character format "x(40)" label "Mensagem Ajuda" column-label "Mensagem Ajuda"
    field ttv_des_msg_erro  as character format "x(60)" label "Mensagem Erro" column-label "Inconsistºncia".

def temp-table tt_cta_integr no-undo
    field ttv_cod_cta_ctbl         as char format "x(20)" label "Conta Cont†bil"
    field ttv_des_titulo           as char format "x(40)"
    field ttv_num_tip_cta_ctbl     as int  format ">9" label "Tipo Conta" column-label "Tipo Conta"
    field ttv_num_sit_cta_ctbl     as int  format ">9" label "Situaá∆o Conta" column-label "Situaá∆o Cta"
    field ttv_ind_finalid_ctbl_cta as char format "X(40)" label "Finalidade Cont†bil".

def temp-table tt_ccusto_integr no-undo
    field ttv_cod_ccusto as char format "x(11)" label "Centro Custo" column-label "Centro Custo"
    field ttv_des_titulo as char format "x(40)".

/***************************************/

procedure setConstraint1:
end procedure.

procedure setConstraint2:

    def input parameter p-cod-estabel as char no-undo.

    assign c-cod-estabel = p-cod-estabel.
end procedure.

procedure setConstraint3:
    def input parameter p-cod-estabel-ini like estabelec.cod-estabel no-undo.
    def input parameter p-cod-estabel-fim like estabelec.cod-estabel no-undo.
    
    assign c-cod-estabel-ini = p-cod-estabel-ini
           c-cod-estabel-fim = p-cod-estabel-fim.    
    
end procedure.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then
            open query {&QUERY-NAME} for each param-imp no-lock.
        when 2 then
            open query {&QUERY-NAME} for each param-imp no-lock
                where param-imp.cod-estabel >= c-cod-estabel.
        when 3 then 
            open query {&QUERY-NAME} for each param-imp no-lock
                where param-imp.cod-estabel >= c-cod-estabel-ini and
                      param-imp.cod-estabel <= c-cod-estabel-fim.                                      
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.

