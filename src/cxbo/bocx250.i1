                       tt-bo-erro.parametros   = c-lbl-liter-despesa-do-pis.
            end.
            else do:
                find desp-imp 
                    where desp-imp.cod-desp = rowObject.cdn-despes-impto-pis no-lock no-error.
    
                if  desp-imp.cod-incoterm-rat <> "" then do:
    
                    /* As despesas para impostos nao devem possuir incoterm de rateio */
                    run utp/ut-msgs.p (input "msg":U,
                                       input 30180,
                                       input rowObject.cdn-despes-impto-pis).
                    assign i-seq-erro = i-seq-erro + 1.
                    create tt-bo-erro.
                    assign tt-bo-erro.i-sequen   = i-seq-erro
                           tt-bo-erro.cd-erro    = 30180
                           tt-bo-erro.parametros = string(rowObject.cdn-despes-impto-pis)
