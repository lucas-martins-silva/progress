{include/boexedel.i}

procedure validateUpdate:
    /*
    **  Valida Update
    */
    def input parameter table for RowObject.
    def input parameter r-chave as rowid no-undo.
    def input parameter l-ems50-erro as logical.
    def output parameter table for tt-bo-erro.

    run InitializeValidate.

    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    
    find first rowObject
        no-lock no-error.
     
    run validateFields( input l-ems50-erro ).
    
    find first tt-bo-erro
        no-lock no-error.
    if not avail tt-bo-erro then do:
        find param-imp where
            rowid(param-imp) = r-chave
            exclusive-lock no-error.
        run executeUpdate.
    end.
end procedure.

procedure findCodigo:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    def input parameter c-cod-estabel as char no-undo.
    def output parameter c-return as char no-undo.

    run startMethod("find":U).

    find param-imp where
         param-imp.cod-estabel = c-cod-estabel
         no-lock no-error.
    if not avail param-imp then do:
        {utp/ut-table.i mgcex param-imp 1}
        run utp/ut-msgs.p (input "msg":U,
                           input 2,
                           input return-value).
        assign c-return = return-value.
    end.
    else do:
       run setCurrent.
    end.
    run endMethod("find":U).
end procedure.

procedure initializeValidate:
    /*
    **  Inicializa Validate
    */

    run startMethod ("initializeValidade":U).

    run endMethod   ("initializeValidade":U).
end procedure.

procedure validateCreate:
    /*
    **  Valida criaá∆o da tabela/duplicidade de registro.
    */

    def input  parameter table for RowObject.
    def input  parameter l-ems50-erro as logical.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.

    run initializeValidate.

    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

    find first rowObject
        no-lock no-error.
        
    if rowObject.cod-estabel = "" then do:
        assign i-seq-erro = i-seq-erro + 1.
        {utp/ut-field.i mgcex param-imp cod-estabel 1}
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    else do:
        if not can-find(estabelec where estabelec.cod-estabel = rowObject.cod-estabel) then do:
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-table.i mgadm estabelec 1}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.
        end.
    end.

    run validateFields( input l-ems50-erro ).

    if can-find(first param-imp where
                      param-imp.cod-estabel = rowObject.cod-estabel) then do:
       assign i-seq-erro = i-seq-erro + 1.
       {utp/ut-table.i mgcex param-imp 1}
       run utp/ut-msgs.p (input "msg":U,
                          input 8,
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen     = i-seq-erro
              tt-bo-erro.cd-erro      = 8
              tt-bo-erro.mensagem     = return-value.
    end.

    find first tt-bo-erro
        no-lock no-error.

    if not avail tt-bo-erro then do:
         run executeCreate.
         assign r-chave = to-rowid(return-value).
    end.

end procedure.

procedure validateDelete:

    def input-output parameter r-chave as rowid.
    def output parameter table for tt-bo-erro.

    run startMethod("validateDelete":U).
     
    run InitializeValidate.
    
    find {&TABLE-NAME} where
        rowid({&TABLE-NAME}) = r-chave
        exclusive-lock no-error.
        
    if avail {&TABLE-NAME} then do:
        if i-pais-impto-usuario = 2 
            and can-find(first internac-impto-faixa
                         where internac-impto-faixa.cod-estabel = {&TABLE-NAME}.cod-estabel) then do:                
            for each internac-impto-faixa exclusive-lock
                where internac-impto-faixa.cod-estabel = {&TABLE-NAME}.cod-estabel:
                delete internac-impto-faixa.
            end.    
        end.
        
        if i-pais-impto-usuario <> 1 then do:
            for each param-imp-internac exclusive-lock
                where param-imp-internac.cod-estabel = {&TABLE-NAME}.cod-estabel:
                delete param-imp-internac.
            end.
        end.
        
        run executeDelete.
    end.
    
    /* Se for necessario a criacao de validacoes nesta procedure, criar uma include 
    conforme ja feito no validateUpdate para a mesma ser utilizada pelo browser 
    Manutencao de itens do documento */        
    
    if l-query then
        get next {&QUERY-NAME}
            no-lock no-wait.
    else
        find next {&TABLE-NAME}
            no-lock no-error.

    if not avail {&TABLE-NAME} then do:
       if l-query then
           get prev {&QUERY-NAME}
               no-lock no-wait.
       else
           find prev {&TABLE-NAME}
               no-lock no-error.
    end.
    
    run endMethod("validateDelete":U). 
    
    assign r-chave = rowid({&TABLE-NAME}).
    return "".
end procedure.    

procedure validateFields:
/*
** Validaá‰es Campos 
*/

    run prgint/utb/utb743za.py persistent set h_api_cta.
    run prgint/utb/utb742za.py persistent set h_api_ccust.
    def input parameter l-ems50-erro as logical.
    def var c-tipo         as char format "x(17)" no-undo.
    def var c-return-value as char format "x(30)" no-undo.
    
    find first param-global no-lock no-error.
    assign i-empresa = param-global.empresa-prin.
    for first estabelec fields(cod-estabel ep-codigo)
        where estabelec.cod-estabel = rowObject.cod-estabel no-lock:
    end.
    if avail estabelec then do:
        assign i-empresa = estabelec.ep-codigo when avail estabelec.
    end.
    
    if can-find(funcao where funcao.cd-funcao = "adm-apb-ems-5.00" and
                funcao.ativo = yes and
                funcao.log-1 = yes) and not l-ems50-erro then do:

        run prgfin/apb/apb909za.py (input 1,
                                    input rowObject.esp-tit-transit,
                                    output c-tipo). 

        if c-tipo = "1" or c-tipo = "" then do:
            assign i-seq-erro = i-seq-erro + 1.
            run utp/ut-msgs.p (input "msg":U,
                               input 624,
                               input rowObject.esp-tit-transit).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 624
                   tt-bo-erro.mensagem = return-value.
        end.

        if c-tipo <> "5" and c-tipo <> "Provisao":U then do:
            assign i-seq-erro = i-seq-erro + 1.
            run utp/ut-msgs.p (input "msg":U,
                               input 18151,
                               input rowObject.esp-tit-transit).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 18151
                   tt-bo-erro.mensagem = return-value.
        end.

    end.

    {cdp/cd4300.i4 "yes" rowObject.char-1}
    {cxbo/bocx250.i51 "yes"}

    &if defined(bf-mat-comex) &then
    &else
            if RowObject.esp-tit-transit = "" then do:
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-liter.i EspÇcie_T°tulo_TrÉnsito * L}    
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                run utp/ut-msgs.p (input "msg":U,
                                   input 265,
                                   input return-value).
                assign tt-bo-erro.i-sequen  = i-seq-erro
                       tt-bo-erro.cd-erro   = 265
                       tt-bo-erro.mensagem  = return-value.
            end.  
            else do:
                if not can-find(espec-ap where
                                espec-ap.cod-esp = RowObject.esp-tit-transit) then do:
                   assign i-seq-erro = i-seq-erro + 1.
                   {utp/ut-liter.i EspÇcie_T°tulo_TrÉnsito * L}
                   create tt-bo-erro.
                   assign tt-bo-erro.parametros = return-value.
                   run utp/ut-msgs.p (input "msg":U,
                                      input 2,
                                      input return-value).
                   assign tt-bo-erro.i-sequen   = i-seq-erro
                          tt-bo-erro.cd-erro    = 2
                          tt-bo-erro.mensagem   = return-value.
                end.
            end.
            
            if  i-pais-impto-usuario = 1 
            and l-fn-antecip        then do:
                if RowObject.cod-espec-antecip = "":U then do:
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-liter.i EspÇcie_Antecipaá∆o * L}    
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value.
                    run utp/ut-msgs.p (input "msg":U,
                                       input 265,
                                       input return-value).
                    assign tt-bo-erro.i-sequen  = i-seq-erro
                           tt-bo-erro.cd-erro   = 265
                           tt-bo-erro.mensagem  = return-value.
                end.
                else if can-find(first espec-ap 
                                 where espec-ap.cod-esp = rowObject.cod-espec-antecip
                                   and espec-ap.tipo <> 2) then do:
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-liter.i EspÇcie_T°tulo_Antecipaá∆o * L}
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value.
                    RUN utp/ut-msgs.p (input "msg":U,
                                       input 144,
                                       input return-value).
                    assign tt-bo-erro.i-sequen   = i-seq-erro
                           tt-bo-erro.cd-erro    = 144
                           tt-bo-erro.mensagem   = return-value.
                end.
                else do:
                    if not can-find(espec-ap where
                                    espec-ap.cod-esp = RowObject.cod-espec-antecip) then do:
                       assign i-seq-erro = i-seq-erro + 1.
                       {utp/ut-liter.i EspÇcie_Antecipaá∆o * L}
                       create tt-bo-erro.
                       assign tt-bo-erro.parametros = return-value.
                       run utp/ut-msgs.p (input "msg":U,
                                          input 2,
                                          input return-value).
                       assign tt-bo-erro.i-sequen   = i-seq-erro
                              tt-bo-erro.cd-erro    = 2
                              tt-bo-erro.mensagem   = return-value.
                    end.
                end.
                if RowObject.perc-max-antecip > 100 then do:
                   assign i-seq-erro = i-seq-erro + 1.
                   create tt-bo-erro.
                   assign tt-bo-erro.parametros = "".
                   run utp/ut-msgs.p (input "msg":U,
                                      input 8451,
                                      input "").
                   assign tt-bo-erro.i-sequen   = i-seq-erro
                          tt-bo-erro.cd-erro    = 8451
                          tt-bo-erro.mensagem   = return-value.
                end.
            end.
    &endif
    
    if  i-pais-impto-usuario = 1 
    and l-fn-antecip then do:
        if  not can-find (first serie where serie.serie = RowObject.cod-ser-antecip) then do:
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i SÇrie * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen   = i-seq-erro
                   tt-bo-erro.cd-erro    = 2
                   tt-bo-erro.mensagem   = return-value.
        end.
        else do:
             for first ser-estab fields()
                 where ser-estab.serie = RowObject.cod-ser-antecip
                   and ser-estab.cod-estabel = RowObject.cod-estabel no-lock:
             end. 
             if  not avail ser-estab then do:
                 assign i-seq-erro = i-seq-erro + 1.
                 run utp/ut-msgs.p (input "msg":U,
                                    input 6514,
                                    input RowObject.cod-ser-antecip).
                 create tt-bo-erro.
                 assign tt-bo-erro.i-sequen = i-seq-erro
                        tt-bo-erro.cd-erro  = 6514
                        tt-bo-erro.mensagem = return-value.
             end.
        end.
    end.
            
    if RowObject.esp-tit-rec = "" then do:
        assign i-seq-erro = i-seq-erro + 1.
        {utp/ut-liter.i EspÇcie_Titulo_Recebimento * L}
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    else do:
        if not can-find(espec-ap where
                        espec-ap.cod-esp = RowObject.esp-tit-rec) then do:
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i EspÇcie_Titulo_Recebimento * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.
        end.
    end.
    
    &if defined(bf-mat-comex) &then
    &else
            if RowObject.hp-codigo = ? or
               RowObject.hp-codigo = 0 then do:
               assign i-seq-erro = i-seq-erro + 1.
               {utp/ut-liter.i Hist¢rico_Padr∆o * L}
               create tt-bo-erro.
               assign tt-bo-erro.parametros = return-value.
               run utp/ut-msgs.p (input "msg":U,
                                  input 265,
                                  input return-value).
               assign tt-bo-erro.i-sequen = i-seq-erro
                      tt-bo-erro.cd-erro  = 265
                      tt-bo-erro.mensagem = return-value.
            end.
            else do:
                if not can-find(hist-padrao where
                                hist-padrao.hp-codigo = RowObject.hp-codigo) then do:
                   assign i-seq-erro = i-seq-erro + 1.
                   {utp/ut-liter.i Hist¢rico_Padr∆o * L}
                   create tt-bo-erro.
                   assign tt-bo-erro.parametros = return-value.
                   run utp/ut-msgs.p (input "msg":U,
                                      input 2,
                                      input return-value).
                   assign tt-bo-erro.i-sequen = i-seq-erro
                          tt-bo-erro.cd-erro  = 2
                          tt-bo-erro.mensagem = return-value.
                end.
            end.
    &endif

    if rowObject.ct-transit-import = "" then do:
        assign i-seq-erro = i-seq-erro + 1.
        {utp/ut-liter.i Conta_Material_em_TrÉnsito * L}
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    else do:
	assign v_cod_cta_ctbl = rowObject.ct-transit-import.
	run pi_busca_dados_cta_ctbl in h_api_cta (input        i-empresa,          /* EMPRESA EMS2 */
                                                  input        "",                 /* PLANO DE CONTAS */
                                                  input-output v_cod_cta_ctbl,     /* CONTA */
                                                  input        today,              /* DATA TRANSACAO */   
                                                  output       v_des_cta_ctbl,     /* DESCRICAO CONTA */
                                                  output       v_num_tip_cta_ctbl, /* TIPO DA CONTA */
                                                  output       v_num_sit_cta_ctbl, /* SITUAÄ«O DA CONTA */
                                                  output       v_ind_finalid_cta,  /* FINALIDADES DA CONTA */
                                                  output table tt_log_erro).       /* ERROS */ 
        IF not return-value = "ok" THEN DO:
            assign i-seq-erro = i-seq-erro + 1.
            /*run utp/ut-msgs.p (input "msg":U,
                           input 5407,
                           input rowObject.ct-transit-import).*/
            find first tt_log_erro no-lock no-error.
            if avail tt_log_erro then do:
                run utp/ut-msgs.p (input "show":U, 
                                   input 17006, 
                                   STRING(tt_log_erro.ttv_des_msg_erro) + ' ('  + string(tt_log_erro.ttv_num_cod_erro) + ')' + "~~" + tt_log_erro.ttv_des_msg_ajuda).
                return 'ADM-ERROR':U.              
            end.
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = int(tt_log_erro.ttv_des_msg_erro) /*5407*/
                   tt-bo-erro.mensagem     = return-value.
        end.
        else do:
            run pi_busca_dados_cta_ctbl_integr in h_api_cta (input        i-empresa,          /* EMPRESA EMS2 */
                                                             input        "CEP",              /* MODULO */
                                                             input        "",                 /* PLANO DE CONTAS */
                                                             input        v_cod_cta_ctbl,     /* CONTA */
                                                             input        today,              /* DATA TRANSACAO */   
                                                             output       v_ind_finalid_cta,  /* FINALIDADES DA CONTA */
                                                             output table tt_log_erro).       /* ERROS */ 
                                                             
            
            if  v_num_sit_cta_ctbl <> 3 then do: 
                assign i-seq-erro = i-seq-erro + 1.
                run utp/ut-msgs.p (input 'msg':U,
                                   input 443, /*Conta n∆o Ç de sistema*/
                                   input '').
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 443
                       tt-bo-erro.mensagem = return-value.
            end.
                         
            if  lookup({adinc/i05ad049.i 4 10}, v_ind_finalid_cta) <> 0 then do: 
                assign i-seq-erro = i-seq-erro + 1.
                run utp/ut-msgs.p (input 'msg':U,
                                   input 15190, /*Conta n∆o aceita lancamentos do estoque*/
                                   input '').
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 15190
                       tt-bo-erro.mensagem = return-value.
            end.
               
            if  lookup({adinc/i05ad049.i 4 2}, v_ind_finalid_cta) = 0 and      /* Nao Consumo */
                lookup({adinc/i05ad049.i 4 4}, v_ind_finalid_cta) = 0 and      /* Transferencia */
                lookup({adinc/i05ad049.i 4 7}, v_ind_finalid_cta) = 0 then do: /* Transitoria Compras */
               assign i-seq-erro = i-seq-erro + 1.
               run utp/ut-msgs.p (input 'msg':U,
                                   input 438, /*Conta n∆o permite lanáamentos de notas fiscais de entrada.*/ 
                                   input '').
               create tt-bo-erro.
               assign tt-bo-erro.i-sequen = i-seq-erro
                      tt-bo-erro.cd-erro  = 438
                      tt-bo-erro.mensagem = return-value.
            end.
        end.
    end.

    if i-pais-impto-usuario = 1 then do:
        
        if  string(rowObject.cod-cta-aplic-nf-simples-remes) <> '' then do:
            
            find first param-global no-lock no-error.
                
            assign v_cod_cta_ctbl = rowObject.cod-cta-aplic-nf-simples-remes.
            run pi_busca_dados_cta_ctbl in h_api_cta (input        i-empresa,          /* EMPRESA EMS2 */
                                                      input        "",                 /* PLANO DE CONTAS */
                                                      input-output v_cod_cta_ctbl,     /* CONTA */
                                                      input        today,              /* DATA TRANSACAO */   
                                                      output       v_des_cta_ctbl,     /* DESCRICAO CONTA */
                                                      output       v_num_tip_cta_ctbl, /* TIPO DA CONTA */
                                                      output       v_num_sit_cta_ctbl, /* SITUAÄ«O DA CONTA */
                                                      output       v_ind_finalid_cta,  /* FINALIDADES DA CONTA */
                                                      output table tt_log_erro).       /* ERROS */ 
            if not return-value = "ok" THEN DO:
                
                assign i-seq-erro = i-seq-erro + 1.
                /*run utp/ut-msgs.p (input "msg":U,
                                   input 5407,
                                   input rowObject.cod-cta-aplic-nf-simples-remes).*/
                find first tt_log_erro no-lock no-error.
                if avail tt_log_erro then do:
                        run utp/ut-msgs.p (input "show":U, 
                                           input 17006, 
                                           STRING(tt_log_erro.ttv_des_msg_erro) + ' ('  + string(tt_log_erro.ttv_num_cod_erro) + ')' + "~~" + tt_log_erro.ttv_des_msg_ajuda).
                        return 'ADM-ERROR':U.              
                end.                   
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = int(tt_log_erro.ttv_des_msg_erro) /*5407*/
                       tt-bo-erro.mensagem = return-value.
            end.
            else do:

                run pi_busca_dados_cta_ctbl_integr in h_api_cta (input        i-empresa,          /* EMPRESA EMS2 */
                                                                 input        "CEP",              /* MODULO */
                                                                 input        "",                 /* PLANO DE CONTAS */
                                                                 input        v_cod_cta_ctbl,     /* CONTA */
                                                                 input        today,              /* DATA TRANSACAO */   
                                                                 output       v_ind_finalid_cta,  /* FINALIDADES DA CONTA */
                                                                 output table tt_log_erro).       /* ERROS */ 
            
                if  v_num_sit_cta_ctbl <> 3 then do: 
                    assign i-seq-erro = i-seq-erro + 1.
                    run utp/ut-msgs.p (input 'msg':U,
                                       input 443, /*Conta nío Ç de sistema*/
                                       input '').
                    create tt-bo-erro.
                    assign tt-bo-erro.i-sequen = i-seq-erro
                           tt-bo-erro.cd-erro  = 443
                           tt-bo-erro.mensagem = return-value.
                end.
    
                
                if not can-do("1,2,4,5",v_num_tip_cta_ctbl) then do:
                    assign i-seq-erro = i-seq-erro + 1.
                    run utp/ut-msgs.p (input 'msg':U,
                                       input 5543, /*Conta deve ser de despesa, receita, ativo ou passivo*/
                                       input '').
                    create tt-bo-erro.
                    assign tt-bo-erro.i-sequen = i-seq-erro
                           tt-bo-erro.cd-erro  = 5543
                           tt-bo-erro.mensagem = return-value.
                end.

                if  lookup({adinc/i05ad049.i 4 10}, v_ind_finalid_cta) <> 0  then do: 
                    assign i-seq-erro = i-seq-erro + 1.
                    run utp/ut-msgs.p (input 'msg':U,
                                       input 15190, /*Conta n∆o aceita lancamentos do estoque*/
                                       input '').
                    create tt-bo-erro.
                    assign tt-bo-erro.i-sequen = i-seq-erro
                           tt-bo-erro.cd-erro  = 15190
                           tt-bo-erro.mensagem = return-value.
                end.
        
                   
    		   IF lookup({adinc/i05ad049.i 4 1}, v_ind_finalid_cta) = 0 AND       /*Consumo*/
    		      lookup({adinc/i05ad049.i 4 2}, v_ind_finalid_cta) = 0 AND       /*N∆o Consumo*/
    		      lookup({adinc/i05ad049.i 4 3}, v_ind_finalid_cta) = 0 AND       /*Ordem de Serviáo*/
    		      lookup({adinc/i05ad049.i 4 6}, v_ind_finalid_cta) = 0 THEN DO:  /*Custo da Mercadoria Vendida*/
                   

                   assign i-seq-erro = i-seq-erro + 1.
                   run utp/ut-msgs.p (input 'msg':U,
                                       input 107, /*Conta n∆o aceita lancamentos de requisiá‰es*/
                                       input '').
                   create tt-bo-erro.
                   assign tt-bo-erro.i-sequen = i-seq-erro
                          tt-bo-erro.cd-erro  = 107
                          tt-bo-erro.mensagem = return-value.
                END.
            end.
        end.
    end.
    /*Internacional - Geraá∆o t°tulo IVA para todos os pa°ses e C†lculo Taxa de Estat°stica para o pa°s Argentina*/
    else do:
        if RowObject.log-descons-iva-tit-mercad then do:
            if  not can-find(desp-imp where desp-imp.cod-desp = rowObject.cdn-despes-iva) then do:        
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-table.i mgcex desp-imp 1}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "despesa_do_IPI" *}
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input RETURN-VALUE).
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-desp-iva AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-desp-iva = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-despesa-do-iva AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "despesa_do_IPI" *}
                ASSIGN c-lbl-liter-despesa-do-iva = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = c-lbl-liter-desp-iva
                       tt-bo-erro.parametros   = c-lbl-liter-despesa-do-iva. 
            end.
            find first emitente 
            where emitente.cod-emitente = RowObject.cdn-emit-iva no-lock no-error.
            if  not avail emitente
            or  rowObject.cdn-emit-iva = 0 then do:
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-table.i mgadm emitente 1}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "fornecedor_do_IPI" *}
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input RETURN-VALUE).
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-fornec-iva AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-fornec-iva = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-fornecedor-do-iva AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "fornecedor_do_IPI" *}
                ASSIGN c-lbl-liter-fornecedor-do-iva = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = c-lbl-liter-fornec-iva
                       tt-bo-erro.parametros   = c-lbl-liter-fornecedor-do-iva.
            end.
            else do:
                /** Emitente deve ser fornecedor **/
                if  emitente.identific = 1 then do: 
            
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-table.i mgadm emitente 1}
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value.
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-emitente-do-iva AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Emitente_do_IPI" *}
                    ASSIGN c-lbl-liter-emitente-do-iva = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-fornecedor-iva AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "fornecedor" *}
                    ASSIGN c-lbl-liter-fornecedor-iva = TRIM(RETURN-VALUE).
                    run utp/ut-msgs.p (input "msg":U,
                                       input 17195,
                                       input c-lbl-liter-emitente-do-iva + " " + "~~" + c-lbl-liter-fornecedor-iva).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 17195
                           tt-bo-erro.mensagem     = return-value.
                end.
            end.        
        end.
        
        if i-pais-impto-usuario = 2 then do:
            if  not can-find(desp-imp where desp-imp.cod-desp = RowObject.cdn-despes-tax-estatis) then do:        
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-table.i mgcex desp-imp 1}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "Despesa_Taxa_Estat°stica" *}
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input RETURN-VALUE).
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-desp-est AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-desp-est = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-despesa-est AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Despesa_Taxa_Estat°stica" *}
                ASSIGN c-lbl-liter-despesa-est = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = c-lbl-liter-desp-est
                       tt-bo-erro.parametros  = c-lbl-liter-despesa-est. 
            end.        
            
            find emitente 
            where emitente.cod-emitente = RowObject.cdn-emit-tax-estatis no-lock no-error.
            if  not avail emitente 
            or  RowObject.cdn-emit-tax-estatis = 0 then do:
        
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-table.i mgadm emitente 1}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "fornecedor_da_Taxa_Estat°stica" *}
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input RETURN-VALUE).
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-fornec-est AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-fornec-est = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-fornecedor-est AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "fornecedor_da_Taxa_Estat°stica" *}
                ASSIGN c-lbl-liter-fornecedor-est = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = c-lbl-liter-fornec-est
                       tt-bo-erro.parametros   = c-lbl-liter-fornecedor-est.
            end.
            else do:
                /** Emitente deve ser fornecedor **/
                if  emitente.identific = 1 then do: 
        
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-table.i mgadm emitente 1}
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value.
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-emitente-est AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Emitente_da_Taxa_Estat°stica" *}
                    ASSIGN c-lbl-liter-emitente-est = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-fornec-est-2 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "fornecedor" *}
                    ASSIGN c-lbl-liter-fornec-est-2 = TRIM(RETURN-VALUE).
                    run utp/ut-msgs.p (input "msg":U,
                                       input 17195,
                                       input c-lbl-liter-emitente-est + " " + "~~" + c-lbl-liter-fornec-est-2).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 17195
                           tt-bo-erro.mensagem     = return-value.
                end.
            end.
        end.

    end.
    
        if  i-emitente-ii-i50 = 0 
        or  i-emitente-ii-i50 = ? then do:
        
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Fornecedor_II * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.        
            run utp/ut-msgs.p (input "msg":U,
                               input 265,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 265
                   tt-bo-erro.mensagem     = return-value.        
        end.
        else 
            if not can-find(emitente 
                                where emitente.cod-emitente = i-emitente-ii-i50) then do:
                                                              
        
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-liter.i Fornecedor_II * L}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input return-value).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = return-value.
            end.

    
        if i-desp-ii-i50 = 0
        or i-desp-ii-i50 = ? then do:
        
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-liter.i Despesa_II * L}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg":U,
                               input 265,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 265
                   tt-bo-erro.mensagem     = return-value.        
        end.
        else do:
            find desp-imp where desp-imp.cod-desp = i-desp-ii-i50 no-lock no-error.
                                                    
            if not avail desp-imp then do:
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-liter.i Despesa_II * L}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input return-value).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = return-value.
            end.
            else do:        
                if  desp-imp.cod-incoterm-rat <> "" then do:
            
                    /* As despesas para impostos nao devem possuir incoterm de rateio */
                    run utp/ut-msgs.p (input "msg":U,
                                       input 30180,
                                       input i-desp-ii-i50).
                    assign i-seq-erro = i-seq-erro + 1.
                    create tt-bo-erro.
                    assign tt-bo-erro.i-sequen   = i-seq-erro
                           tt-bo-erro.cd-erro    = 30180
                           tt-bo-erro.parametros = string(i-desp-ii-i50)
                           tt-bo-erro.mensagem   = return-value.
                end.
        
                if desp-imp.log-2 then do: /* Despesa II n∆o pode incidir na base II */
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-liter.i Incide_Base_II * L}
                    assign c-return-value = trim(return-value).
                    {utp/ut-liter.i Despesa_II * L}
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value + "~~" + trim(c-return-value).
                    run utp/ut-msgs.p (input "msg":U,
                                       input 7972,
                                       input tt-bo-erro.parametros).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 7972
                           tt-bo-erro.mensagem     = return-value.
                end.
                if desp-imp.tipo <> 2 then do: /* S¢ pode ser Valor Informado */
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-liter.i do_tipo_diferente_de_Valor_Informado * L}
                    assign c-return-value = trim(return-value).
                    {utp/ut-liter.i Despesa_II * L}
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value + "~~" + trim(c-return-value).
                    run utp/ut-msgs.p (input "msg":U,
                                       input  7972,
                                       input tt-bo-erro.parametros).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 7972
                           tt-bo-erro.mensagem     = return-value.
                end.
            end.            
        end.
    
    /** 2.1.10 Geraá∆o de Impostos Padr‰es na Inclus∆o das Cotaá‰es **/
    if rowObject.cod-natur-operac-padr <> "" then do:
        if not can-find(natur-oper where natur-oper.nat-operacao = rowObject.cod-natur-operac-padr) then do:
            assign i-seq-erro = i-seq-erro + 1.
            {utp/ut-table.i mgind natur-oper 1}
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.
            /* Inicio -- Projeto Internacional */
            {utp/ut-liter.i "Natureza_de_Operaá∆o" *}
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input RETURN-VALUE).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.
        end.           
    end.
    
    if i-pais-impto-usuario = 1 then do:
        /* Verifica se Ç cotaá∆o autom†tica de impostos de importaá∆o ****/
        if rowObject.log-cotac-autom-impto-import or 
           rowObject.log-cotac-autom-ipi          or
           rowObject.log-cotac-autom-pis          or 
           rowObject.log-cotac-autom-cofins       or
           rowObject.log-cotac-autom-icms       then do:
           
            if rowObject.cod-natur-operac-padr = "" then do:
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-table.i mgind natur-oper 1}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-natureza-de-operacao AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Natureza_de_operaá∆o" *}
                ASSIGN c-lbl-liter-natureza-de-operacao = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-cotacao-automatica-para-impost AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "cotaá∆o_autom†tica_para_impostos" *}
                ASSIGN c-lbl-liter-cotacao-automatica-para-impost = TRIM(RETURN-VALUE).
                run utp/ut-msgs.p (input "msg":U,
                                   input 30055,
                                   input c-lbl-liter-natureza-de-operacao + "~~" + c-lbl-liter-cotacao-automatica-para-impost).
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-natureza-de-operacao-2 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Natureza_de_operaá∆o" *}
                ASSIGN c-lbl-liter-natureza-de-operacao-2 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-cotacao-automatica-para-impost-2 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "cotaá∆o_autom†tica_para_impostos" *}
                ASSIGN c-lbl-liter-cotacao-automatica-para-impost-2 = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 30055
                       tt-bo-erro.mensagem     = c-lbl-liter
                       tt-bo-erro.parametros   = c-lbl-liter-natureza-de-operacao-2 + "~~" + c-lbl-liter-cotacao-automatica-para-impost-2.             
            end.
        end.
        
        /****** Verifica se Ç cotaá∆o autom†tica - IPI ******/
        if  rowObject.log-cotac-autom-ipi  then do: 
        
            if  not can-find(desp-imp where desp-imp.cod-desp = rowObject.cdn-despes-impto-ipi) then do:
    
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-table.i mgcex desp-imp 1}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "despesa_do_IPI" *}
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input RETURN-VALUE).
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-2 AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-2 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-despesa-do-ipi AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "despesa_do_IPI" *}
                ASSIGN c-lbl-liter-despesa-do-ipi = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = c-lbl-liter-2
                       tt-bo-erro.parametros  = c-lbl-liter-despesa-do-ipi. 
            end.
            else do:
                find desp-imp 
                    where desp-imp.cod-desp = rowObject.cdn-despes-impto-ipi no-lock no-error.
    
                if  desp-imp.cod-incoterm-rat <> "" then do:
        
                    /* As despesas para impostos nao devem possuir incoterm de rateio */
                    run utp/ut-msgs.p (input "msg":U,
                                       input 30180,
                                       input rowObject.cdn-despes-impto-ipi).
                    assign i-seq-erro = i-seq-erro + 1.
                    create tt-bo-erro.
                    assign tt-bo-erro.i-sequen   = i-seq-erro
                           tt-bo-erro.cd-erro    = 30180
                           tt-bo-erro.parametros = string(rowObject.cdn-despes-impto-ipi)
                           tt-bo-erro.mensagem   = return-value.
                end.
    
                if  desp-imp.tipo <> 2 then do:
    
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-table.i mgcex desp-imp 1}
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value.
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-despesa-ipi AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Despesa_IPI" *}
                    ASSIGN c-lbl-liter-despesa-ipi = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-do-tipo-diferente-de-valor-inf AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "do_tipo_diferente_de_Valor_Informado" *}
                    ASSIGN c-lbl-liter-do-tipo-diferente-de-valor-inf = TRIM(RETURN-VALUE).
                    run utp/ut-msgs.p (input "msg":U,
                                       input 7972,
                                       input c-lbl-liter-despesa-ipi + "~~" + c-lbl-liter-do-tipo-diferente-de-valor-inf).
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-3 AS CHARACTER NO-UNDO.
                    ASSIGN c-lbl-liter-3 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-despesa-ipi-2 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Despesa_IPI" *}
                    ASSIGN c-lbl-liter-despesa-ipi-2 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-do-tipo-diferente-de-valor-inf-2 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "do_tipo_diferente_de_Valor_Informado" *}
                    ASSIGN c-lbl-liter-do-tipo-diferente-de-valor-inf-2 = TRIM(RETURN-VALUE).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 7972
                           tt-bo-erro.mensagem     = c-lbl-liter-3
                           tt-bo-erro.parametros   = c-lbl-liter-despesa-ipi-2 + "~~" + c-lbl-liter-do-tipo-diferente-de-valor-inf-2.
                end.
                
                /*** Despesa do IPI incide sobre sua pr¢pria base ***/
                if  desp-imp.inc-base-ipi then do:
    
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-table.i mgcex desp-imp 1}
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value.
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-despesa-ipi-3 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Despesa_IPI" *}
                    ASSIGN c-lbl-liter-despesa-ipi-3 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-incide-base-ipi AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "incide_base_IPI" *}
                    ASSIGN c-lbl-liter-incide-base-ipi = TRIM(RETURN-VALUE).
                    run utp/ut-msgs.p (input "msg":U,
                                       input 7972,
                                       input c-lbl-liter-despesa-ipi-3 + "~~" + c-lbl-liter-incide-base-ipi).
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-4 AS CHARACTER NO-UNDO.
                    ASSIGN c-lbl-liter-4 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-despesa-ipi-4 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Despesa_IPI" *}
                    ASSIGN c-lbl-liter-despesa-ipi-4 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-incide-base-ipi-2 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "incide_base_IPI" *}
                    ASSIGN c-lbl-liter-incide-base-ipi-2 = TRIM(RETURN-VALUE).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 7972
                           tt-bo-erro.mensagem     = c-lbl-liter-4
                           tt-bo-erro.parametros   = c-lbl-liter-despesa-ipi-4 + "~~" + c-lbl-liter-incide-base-ipi-2.
                           
                end.
            end. /* else do */
            
            find first emitente 
                where emitente.cod-emitente = rowObject.cdn-fornec-ipi no-lock no-error.
            if  not avail emitente
            or  rowObject.cdn-fornec-ipi = 0 then do:
    
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-table.i mgadm emitente 1}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "fornecedor_do_IPI" *}
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input RETURN-VALUE).
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-5 AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-5 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-fornecedor-do-ipi AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "fornecedor_do_IPI" *}
                ASSIGN c-lbl-liter-fornecedor-do-ipi = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = c-lbl-liter-5
                       tt-bo-erro.parametros   = c-lbl-liter-fornecedor-do-ipi.
            end.
            else do:
                /** Emitente deve ser fornecedor **/
                if  emitente.identific = 1 then do: 
    
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-table.i mgadm emitente 1}
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value.
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-emitente-do-ipi AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Emitente_do_IPI" *}
                    ASSIGN c-lbl-liter-emitente-do-ipi = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-fornecedor AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "fornecedor" *}
                    ASSIGN c-lbl-liter-fornecedor = TRIM(RETURN-VALUE).
                    run utp/ut-msgs.p (input "msg":U,
                                       input 17195,
                                       input c-lbl-liter-emitente-do-ipi + " " + "~~" + c-lbl-liter-fornecedor).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 17195
                           tt-bo-erro.mensagem     = return-value.
                end.
            end.
        end. /* IPI */
        
        /****** Verifica se Ç cotaá∆o autom†tica - PIS ******/
        if  rowObject.log-cotac-autom-pis  then do: 
        
            
    
            if  not can-find(desp-imp where desp-imp.cod-desp = rowObject.cdn-despes-impto-pis) then do:
    
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-table.i mgcex desp-imp 1}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "despesa_do_PIS" *}
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input RETURN-VALUE).
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-6 AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-6 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-despesa-do-pis AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "despesa_do_PIS" *}
