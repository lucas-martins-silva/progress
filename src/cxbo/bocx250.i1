                    assign tt-bo-erro.parametros = return-value.
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-despesa-pis AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Despesa_PIS" *}
                    ASSIGN c-lbl-liter-despesa-pis = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-do-tipo-diferente-de-valor-inf-3 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "do_tipo_diferente_de_Valor_Informado" *}
                    ASSIGN c-lbl-liter-do-tipo-diferente-de-valor-inf-3 = TRIM(RETURN-VALUE).
                    run utp/ut-msgs.p (input "msg":U,
                                       input 7972,
                                       input c-lbl-liter-despesa-pis + "~~" + c-lbl-liter-do-tipo-diferente-de-valor-inf-3).
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-7 AS CHARACTER NO-UNDO.
                    ASSIGN c-lbl-liter-7 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-despesa-pis-2 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Despesa_PIS" *}
                    ASSIGN c-lbl-liter-despesa-pis-2 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-do-tipo-diferente-de-valor-inf-4 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "do_tipo_diferente_de_Valor_Informado" *}
                    ASSIGN c-lbl-liter-do-tipo-diferente-de-valor-inf-4 = TRIM(RETURN-VALUE).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 7972
                           tt-bo-erro.mensagem     = c-lbl-liter-7
                           tt-bo-erro.parametros   = c-lbl-liter-despesa-pis-2 + "~~" + c-lbl-liter-do-tipo-diferente-de-valor-inf-4.
                end.
                
                /*** Despesa do PIS incide sobre sua pr¢pria base ***/
                if  desp-imp.log-incid-base-pis-val
                or  desp-imp.log-incid-base-pis-despes then do:
    
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-table.i mgcex desp-imp 1}
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value.
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-despesa-pis-3 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Despesa_PIS" *}
                    ASSIGN c-lbl-liter-despesa-pis-3 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-incide-base-pis AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "incide_base_PIS" *}
                    ASSIGN c-lbl-liter-incide-base-pis = TRIM(RETURN-VALUE).
                    run utp/ut-msgs.p (input "msg":U,
                                       input 7972,
                                       input c-lbl-liter-despesa-pis-3 + "~~" + c-lbl-liter-incide-base-pis).
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-8 AS CHARACTER NO-UNDO.
                    ASSIGN c-lbl-liter-8 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-despesa-pis-4 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Despesa_PIS" *}
                    ASSIGN c-lbl-liter-despesa-pis-4 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-incide-base-pis-2 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "incide_base_PIS" *}
                    ASSIGN c-lbl-liter-incide-base-pis-2 = TRIM(RETURN-VALUE).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 7972
                           tt-bo-erro.mensagem     = c-lbl-liter-8
                           tt-bo-erro.parametros   = c-lbl-liter-despesa-pis-4 + "~~" + c-lbl-liter-incide-base-pis-2.
                end.
            end. /* else do */
    
            find emitente 
                where emitente.cod-emitente = rowObject.cdn-fornec-pis no-lock no-error.
            if  not avail emitente 
            or  rowObject.cdn-fornec-pis = 0 then do:
    
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-table.i mgadm emitente 1}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "fornecedor_do_PIS" *}
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input RETURN-VALUE).
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-9 AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-9 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-fornecedor-do-pis AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "fornecedor_do_PIS" *}
                ASSIGN c-lbl-liter-fornecedor-do-pis = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = c-lbl-liter-9
                       tt-bo-erro.parametros   = c-lbl-liter-fornecedor-do-pis.
            end.
            else do:
                /** Emitente deve ser fornecedor **/
                if  emitente.identific = 1 then do: 
    
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-table.i mgadm emitente 1}
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value.
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-emitente-do-pis AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Emitente_do_PIS" *}
                    ASSIGN c-lbl-liter-emitente-do-pis = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-fornecedor-2 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "fornecedor" *}
                    ASSIGN c-lbl-liter-fornecedor-2 = TRIM(RETURN-VALUE).
                    run utp/ut-msgs.p (input "msg":U,
                                       input 17195,
                                       input c-lbl-liter-emitente-do-pis + " " + "~~" + c-lbl-liter-fornecedor-2).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 17195
                           tt-bo-erro.mensagem     = return-value.
                end.
            end.
        end. /* PIS */
    
        /****** Verifica se Ç cotaá∆o autom†tica - COFINS ******/
        if  rowObject.log-cotac-autom-cofins then do: 
        
            if  not can-find(desp-imp where desp-imp.cod-desp = rowObject.cdn-despes-impto-cofins) then do:
    
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-table.i mgcex desp-imp 1}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "despesa_do_COFINS" *}
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input RETURN-VALUE).
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-10 AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-10 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-despesa-do-cofins AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "despesa_do_COFINS" *}
                ASSIGN c-lbl-liter-despesa-do-cofins = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = c-lbl-liter-10
                       tt-bo-erro.parametros   = c-lbl-liter-despesa-do-cofins .
            end.
            else do:
                find desp-imp 
                    where desp-imp.cod-desp = rowObject.cdn-despes-impto-cofins no-lock no-error.
    
                if  desp-imp.cod-incoterm-rat <> "" then do:
        
                    /* As despesas para impostos nao devem possuir incoterm de rateio */
                    run utp/ut-msgs.p (input "msg":U,
                                       input 30180,
                                       input rowObject.cdn-despes-impto-cofins).
                    assign i-seq-erro = i-seq-erro + 1.
                    create tt-bo-erro.
                    assign tt-bo-erro.i-sequen   = i-seq-erro
                           tt-bo-erro.cd-erro    = 30180
                           tt-bo-erro.parametros = string(rowObject.cdn-despes-impto-cofins)
                           tt-bo-erro.mensagem   = return-value.
                end.
    
                if  desp-imp.tipo <> 2 then do:
    
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-table.i mgcex desp-imp 1}
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value.
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-despesa-cofins AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Despesa_COFINS" *}
                    ASSIGN c-lbl-liter-despesa-cofins = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-do-tipo-diferente-de-valor-inf-5 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "do_tipo_diferente_de_Valor_Informado" *}
                    ASSIGN c-lbl-liter-do-tipo-diferente-de-valor-inf-5 = TRIM(RETURN-VALUE).
                    run utp/ut-msgs.p (input "msg":U,
                                       input 7972,
                                       input c-lbl-liter-despesa-cofins + "~~" + c-lbl-liter-do-tipo-diferente-de-valor-inf-5).
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-11 AS CHARACTER NO-UNDO.
                    ASSIGN c-lbl-liter-11 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-despesa-cofins-2 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Despesa_COFINS" *}
                    ASSIGN c-lbl-liter-despesa-cofins-2 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-do-tipo-diferente-de-valor-inf-6 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "do_tipo_diferente_de_Valor_Informado" *}
                    ASSIGN c-lbl-liter-do-tipo-diferente-de-valor-inf-6 = TRIM(RETURN-VALUE).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 7972
                           tt-bo-erro.mensagem     = c-lbl-liter-11
                           tt-bo-erro.parametros   = c-lbl-liter-despesa-cofins-2 + "~~" + c-lbl-liter-do-tipo-diferente-de-valor-inf-6.
                end.
                
                /*** Despesa do COFINS incide sobre sua pr¢pria base ***/
                if  desp-imp.log-incid-base-cofins-val
                or  desp-imp.log-incid-base-cofins-despes then do:
    
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-table.i mgcex desp-imp 1}
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value.
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-despesa-cofins-3 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Despesa_COFINS" *}
                    ASSIGN c-lbl-liter-despesa-cofins-3 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-incide-base-cofins AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "incide_base_COFINS" *}
                    ASSIGN c-lbl-liter-incide-base-cofins = TRIM(RETURN-VALUE).
                    run utp/ut-msgs.p (input "msg":U,
                                       input 7972,
                                       input c-lbl-liter-despesa-cofins-3 + "~~" + c-lbl-liter-incide-base-cofins).
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-12 AS CHARACTER NO-UNDO.
                    ASSIGN c-lbl-liter-12 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-despesa-cofins-4 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Despesa_COFINS" *}
                    ASSIGN c-lbl-liter-despesa-cofins-4 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-incide-base-cofins-2 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "incide_base_COFINS" *}
                    ASSIGN c-lbl-liter-incide-base-cofins-2 = TRIM(RETURN-VALUE).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 7972
                           tt-bo-erro.mensagem     = c-lbl-liter-12
                           tt-bo-erro.parametros   = c-lbl-liter-despesa-cofins-4 + "~~" + c-lbl-liter-incide-base-cofins-2.
                end.
            end. /* else do */
    
            find emitente 
                where emitente.cod-emitente = rowObject.cdn-fornec-cofins no-lock no-error.
            if  not avail emitente
            or  rowObject.cdn-fornec-cofins = 0 then do:
    
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-table.i mgadm emitente 1}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "fornecedor_do_COFINS" *}
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input RETURN-VALUE).
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-13 AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-13 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-fornecedor-do-cofins AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "fornecedor_do_COFINS" *}
                ASSIGN c-lbl-liter-fornecedor-do-cofins = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = c-lbl-liter-13
                       tt-bo-erro.parametros   = c-lbl-liter-fornecedor-do-cofins.
            end.
            else do:
                /** Emitente deve ser fornecedor **/
                if  emitente.identific = 1 then do: 
    
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-table.i mgadm emitente 1}
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value.
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-emitente-do-cofins AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Emitente_do_COFINS" *}
                    ASSIGN c-lbl-liter-emitente-do-cofins = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-fornecedor-3 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "fornecedor" *}
                    ASSIGN c-lbl-liter-fornecedor-3 = TRIM(RETURN-VALUE).
                    run utp/ut-msgs.p (input "msg":U,
                                       input 17195,
                                       input c-lbl-liter-emitente-do-cofins + " " + "~~" + c-lbl-liter-fornecedor-3).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 17195
                           tt-bo-erro.mensagem     = return-value.
                end.
            end.
        end. /* COFINS */
        
        /****** Verifica se Ç cotaá∆o autom†tica - ICMS ******/
        if  rowObject.log-cotac-autom-icms  then do: 
        
            if  not can-find(desp-imp where desp-imp.cod-desp = rowObject.cdn-despes-impto-icms) then do:
    
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-table.i mgcex desp-imp 1}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "despesa_do_ICMS" *}
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input RETURN-VALUE).
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-14 AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-14 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-despesa-do-icms AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "despesa_do_ICMS" *}
                ASSIGN c-lbl-liter-despesa-do-icms = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = c-lbl-liter-14
                       tt-bo-erro.parametros   = c-lbl-liter-despesa-do-icms.
            end.
            else do:
                find desp-imp 
                    where desp-imp.cod-desp = rowObject.cdn-despes-impto-icms no-lock no-error.
    
                if  desp-imp.cod-incoterm-rat <> "" then do:
    
                    /* As despesas para impostos nao devem possuir incoterm de rateio */
                    run utp/ut-msgs.p (input "msg":U,
                                       input 30180,
                                       input rowObject.cdn-despes-impto-icms).
                    assign i-seq-erro = i-seq-erro + 1.
                    create tt-bo-erro.
                    assign tt-bo-erro.i-sequen   = i-seq-erro
                           tt-bo-erro.cd-erro    = 30180
                           tt-bo-erro.parametros = string(rowObject.cdn-despes-impto-icms)
                           tt-bo-erro.mensagem   = return-value.
                end.
    
                if  desp-imp.tipo <> 2 then do:
    
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-table.i mgcex desp-imp 1}
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value.
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-despesa-icms AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Despesa_ICMS" *}
                    ASSIGN c-lbl-liter-despesa-icms = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-do-tipo-diferente-de-valor-inf-7 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "do_tipo_diferente_de_Valor_Informado" *}
                    ASSIGN c-lbl-liter-do-tipo-diferente-de-valor-inf-7 = TRIM(RETURN-VALUE).
                    run utp/ut-msgs.p (input "msg":U,
                                       input 7972,
                                       input c-lbl-liter-despesa-icms + "~~" + c-lbl-liter-do-tipo-diferente-de-valor-inf-7).
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-15 AS CHARACTER NO-UNDO.
                    ASSIGN c-lbl-liter-15 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-despesa-icms-2 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Despesa_ICMS" *}
                    ASSIGN c-lbl-liter-despesa-icms-2 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-do-tipo-diferente-de-valor-inf-8 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "do_tipo_diferente_de_Valor_Informado" *}
                    ASSIGN c-lbl-liter-do-tipo-diferente-de-valor-inf-8 = TRIM(RETURN-VALUE).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 7972
                           tt-bo-erro.mensagem     = c-lbl-liter-15
                           tt-bo-erro.parametros   = c-lbl-liter-despesa-icms-2 + "~~" + c-lbl-liter-do-tipo-diferente-de-valor-inf-8.
                end.
                
                /*** Despesa do ICMS incide sobre sua pr¢pria base ***/
                if  desp-imp.inc-base-icms then do:
    
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-table.i mgcex desp-imp 1}
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value.
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-despesa-icms-3 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Despesa_ICMS" *}
                    ASSIGN c-lbl-liter-despesa-icms-3 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-incide-base-icms AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "incide_base_ICMS" *}
                    ASSIGN c-lbl-liter-incide-base-icms = TRIM(RETURN-VALUE).
                    run utp/ut-msgs.p (input "msg":U,
                                       input 7972,
                                       input c-lbl-liter-despesa-icms-3 + "~~" + c-lbl-liter-incide-base-icms).
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-16 AS CHARACTER NO-UNDO.
                    ASSIGN c-lbl-liter-16 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-despesa-icms-4 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Despesa_ICMS" *}
                    ASSIGN c-lbl-liter-despesa-icms-4 = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-incide-base-icms-2 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "incide_base_ICMS" *}
                    ASSIGN c-lbl-liter-incide-base-icms-2 = TRIM(RETURN-VALUE).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 7972
                           tt-bo-erro.mensagem     = c-lbl-liter-16
                           tt-bo-erro.parametros   = c-lbl-liter-despesa-icms-4 + "~~" + c-lbl-liter-incide-base-icms-2.
                end.
            end. /* else do */
            
            find emitente 
                where emitente.cod-emitente = rowObject.cdn-fornec-icms no-lock no-error.
            if  not avail emitente 
            or  rowObject.cdn-fornec-icms = 0 then do:
    
                assign i-seq-erro = i-seq-erro + 1.
                {utp/ut-table.i mgadm emitente 1}
                create tt-bo-erro.
                assign tt-bo-erro.parametros = return-value.
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "fornecedor_do_ICMS" *}
                run utp/ut-msgs.p (input "msg":U,
                                   input 2,
                                   input RETURN-VALUE).
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-17 AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-17 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-fornecedor-do-icms AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "fornecedor_do_ICMS" *}
                ASSIGN c-lbl-liter-fornecedor-do-icms = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 2
                       tt-bo-erro.mensagem     = c-lbl-liter-17
                       tt-bo-erro.parametros   = c-lbl-liter-fornecedor-do-icms.
            end.
            else do:
                /** Emitente deve ser fornecedor **/
                if  emitente.identific = 1 then do: 
    
                    assign i-seq-erro = i-seq-erro + 1.
                    {utp/ut-table.i mgadm emitente 1}
                    create tt-bo-erro.
                    assign tt-bo-erro.parametros = return-value.
                    /* Inicio -- Projeto Internacional */
                    DEFINE VARIABLE c-lbl-liter-emitente-do-icms AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "Emitente_do_ICMS" *}
                    ASSIGN c-lbl-liter-emitente-do-icms = TRIM(RETURN-VALUE).
                    DEFINE VARIABLE c-lbl-liter-fornecedor-4 AS CHARACTER NO-UNDO.
                    {utp/ut-liter.i "fornecedor" *}
                    ASSIGN c-lbl-liter-fornecedor-4 = TRIM(RETURN-VALUE).
                    run utp/ut-msgs.p (input "msg":U,
                                       input 17195,
                                       input c-lbl-liter-emitente-do-icms + " " + "~~" + c-lbl-liter-fornecedor-4).
                    assign tt-bo-erro.i-sequen     = i-seq-erro
                           tt-bo-erro.cd-erro      = 17195
                           tt-bo-erro.mensagem     = return-value.
                end.
            end.
        end. /* ICMS */
    end.
    
    if  rowObject.des-senha-docto <> ""
    and rowObject.des-senha-docto <> c-confirma-senha then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg":U,
                           input 4757,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 4757
               tt-bo-erro.mensagem = return-value.
    end.

    if  rowObject.des-senha-pch-order <> ""
    and rowObject.des-senha-pch-order <> c-confirma-senha-pch then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg":U,
                           input 31026,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 31026
               tt-bo-erro.mensagem = return-value.
    end.
            
    if  rowObject.des-layout-origin-licenc-import <> "" then do:
          
        assign file-info:file-name = rowObject.des-layout-origin-licenc-import.
    
        if  file-info:pathname = ? then do: 
    
            assign i-seq-erro = i-seq-erro + 1.
            run utp/ut-msgs.p (input "msg",
                               input 4715,
                               input rowObject.des-layout-origin-licenc-import).                               
            create tt-bo-erro.                                   
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 4715
                   tt-bo-erro.mensagem = return-value
                   tt-bo-erro.parametros = file-info:file-name.
        end. 
    end.
    
    if  rowObject.des-layout-autoriz-import <> "" then do:

        assign file-info:file-name = rowObject.des-layout-autoriz-import.
    
        if  file-info:pathname = ? then do:
    
            assign i-seq-erro = i-seq-erro + 1.
            run utp/ut-msgs.p (input "msg",
                               input 4715,
                               input rowObject.des-layout-autoriz-import).                               
            create tt-bo-erro.                                   
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 4715
                   tt-bo-erro.mensagem = return-value
                   tt-bo-erro.parametros = file-info:file-name.
        end. 
    end.
    
    if TRIM(SUBSTRING(RowObject.char-1,233,12 )) <> "" then do:
        IF NOT CAN-FIND(FIRST usuar_mestre
                        WHERE usuar_mestre.cod_usuario = TRIM(SUBSTRING(RowObject.char-1,233,12 ))) THEN DO:
            assign i-seq-erro = i-seq-erro + 1.
            /* Inicio -- Projeto Internacional */
            DEFINE VARIABLE c-lbl-liter-usuario-drawback AS CHARACTER NO-UNDO.
            {utp/ut-liter.i "Usu†rio_Drawback" *}
            ASSIGN c-lbl-liter-usuario-drawback = TRIM(RETURN-VALUE).
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input RETURN-VALUE).
            
            create tt-bo-erro.                                   
            assign tt-bo-erro.i-sequen   = i-seq-erro
                   tt-bo-erro.cd-erro    = 2
                   tt-bo-erro.mensagem   = return-value
                   tt-bo-erro.parametros = c-lbl-liter-usuario-drawback.
        END.
    end.
    
    if i-pais-impto-usuario = 1 then do:
           &if "{&bf_mat_versao_ems}" < "2.07" &then
            if   substr(rowObject.char-1,105,1) = '1'
            and (int(substr(rowObject.char-1, 91,5)) = 0 or int(substr(rowObject.char-1, 96,9)) = 0) then do:
                assign i-seq-erro = i-seq-erro + 1.
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "Despesa_e_Fornecedor" *}
                run utp/ut-msgs.p (input "msg",
                                   input 33556,
                                   input RETURN-VALUE).
                create tt-bo-erro.
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-18 AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-18 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-despesa-e-fornecedor AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Despesa_e_Fornecedor" *}
                ASSIGN c-lbl-liter-despesa-e-fornecedor = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 33556
                       tt-bo-erro.mensagem = c-lbl-liter-18
                       tt-bo-erro.parametros = c-lbl-liter-despesa-e-fornecedor.
            end.
            
            if  int(substr(rowObject.char-1, 91,5)) <> 0
            and not can-find(first desp-imp where desp-imp.cod-desp = int(substr(rowObject.char-1, 91,5))) then do:
                assign i-seq-erro = i-seq-erro + 1.
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-despesa-siscomex AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Despesa_Siscomex" *}
                ASSIGN c-lbl-liter-despesa-siscomex = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-codigo-de-despesa AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "C¢digo_de_Despesa" *}
                ASSIGN c-lbl-liter-codigo-de-despesa = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-manutencao-de-despesas-e-impos AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Manutená∆o_de_Despesas_e_Impostos" *}
                ASSIGN c-lbl-liter-manutencao-de-despesas-e-impos = TRIM(RETURN-VALUE).
                run utp/ut-msgs.p (input "msg",
                                   input 33563,
                                   input c-lbl-liter-despesa-siscomex + "~~" + 
                                         c-lbl-liter-codigo-de-despesa + "~~" +
                                         c-lbl-liter-manutencao-de-despesas-e-impos).
                create tt-bo-erro.
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-19 AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-19 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-despesa-siscomex-2 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Despesa_Siscomex" *}
                ASSIGN c-lbl-liter-despesa-siscomex-2 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-codigo-de-despesa-2 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "C¢digo_de_Despesa" *}
                ASSIGN c-lbl-liter-codigo-de-despesa-2 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-manutencao-de-despesas-e-impos-2 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Manutená∆o_de_Despesas_e_Impostos" *}
                ASSIGN c-lbl-liter-manutencao-de-despesas-e-impos-2 = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 33563
                       tt-bo-erro.mensagem = c-lbl-liter-19
                       tt-bo-erro.parametros = c-lbl-liter-despesa-siscomex-2 + "~~" + 
                                               c-lbl-liter-codigo-de-despesa-2 + "~~" +
                                               c-lbl-liter-manutencao-de-despesas-e-impos-2.
            end.
            
            if  int(substr(rowObject.char-1, 96,9)) <> 0
            and not can-find(first emitente
                             where emitente.cod-emitente = int(substr(rowObject.char-1, 96,9))
                               and (emitente.identific    = 2
                                or  emitente.identific    = 3)) then do:
                assign i-seq-erro = i-seq-erro + 1.
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-fornecedor-siscomex AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Fornecedor_Siscomex" *}
                ASSIGN c-lbl-liter-fornecedor-siscomex = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-codigo-de-fornecedor AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "C¢digo_de_Fornecedor" *}
                ASSIGN c-lbl-liter-codigo-de-fornecedor = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-manutencao-de-fornecedores AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Manutená∆o_de_Fornecedores" *}
                ASSIGN c-lbl-liter-manutencao-de-fornecedores = TRIM(RETURN-VALUE).
                run utp/ut-msgs.p (input "msg",
                                   input 33563,
                                   input c-lbl-liter-fornecedor-siscomex + "~~" + 
                                         c-lbl-liter-codigo-de-fornecedor + "~~" +
                                         c-lbl-liter-manutencao-de-fornecedores).
                create tt-bo-erro.
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-20 AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-20 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-fornecedor-siscomex-2 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Fornecedor_Siscomex" *}
                ASSIGN c-lbl-liter-fornecedor-siscomex-2 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-codigo-de-fornecedor-2 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "C¢digo_de_Fornecedor" *}
                ASSIGN c-lbl-liter-codigo-de-fornecedor-2 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-manutencao-de-fornecedores-2 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Manutená∆o_de_Fornecedores" *}
                ASSIGN c-lbl-liter-manutencao-de-fornecedores-2 = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 33563
                       tt-bo-erro.mensagem = c-lbl-liter-20
                       tt-bo-erro.parametros = c-lbl-liter-fornecedor-siscomex-2 + "~~" + 
                                               c-lbl-liter-codigo-de-fornecedor-2 + "~~" +
                                               c-lbl-liter-manutencao-de-fornecedores-2.
            end.
            
            IF  INT(SUBSTR(rowObject.char-1, 91,5)) <> 0
            AND INT(SUBSTR(rowObject.char-1, 91,5)) = INT(SUBSTR(rowObject.char-1,21,5)) THEN DO:
                RUN utp/ut-msgs.p (INPUT "msg",
                                   INPUT 33834,
                                   INPUT RETURN-VALUE).
                CREATE tt-bo-erro.
                ASSIGN tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 33834
                       tt-bo-erro.mensagem     = RETURN-VALUE.
            END.
           &else
            if   rowObject.log-tax-siscomex
            and (rowObject.cdn-despes-siscomex = 0 or rowObject.cdn-emit-siscomex = 0) then do:
                assign i-seq-erro = i-seq-erro + 1.
                /* Inicio -- Projeto Internacional */
                {utp/ut-liter.i "Despesa_e_Fornecedor" *}
                run utp/ut-msgs.p (input "msg",
                                   input 33556,
                                   input RETURN-VALUE).
                create tt-bo-erro.
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-21 AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-21 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-despesa-e-fornecedor-2 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Despesa_e_Fornecedor" *}
                ASSIGN c-lbl-liter-despesa-e-fornecedor-2 = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 33556
                       tt-bo-erro.mensagem = c-lbl-liter-21
                       tt-bo-erro.parametros = c-lbl-liter-despesa-e-fornecedor-2.
            end.
            
            if  rowObject.cdn-despes-siscomex <> 0
            and not can-find(first desp-imp where desp-imp.cod-desp = rowObject.cdn-despes-siscomex) then do:
                assign i-seq-erro = i-seq-erro + 1.
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-despesa-siscomex-3 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Despesa_Siscomex" *}
                ASSIGN c-lbl-liter-despesa-siscomex-3 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-codigo-de-despesa-3 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "C¢digo_de_Despesa" *}
                ASSIGN c-lbl-liter-codigo-de-despesa-3 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-manutencao-de-despesas-e-impos-3 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Manutená∆o_de_Despesas_e_Impostos" *}
                ASSIGN c-lbl-liter-manutencao-de-despesas-e-impos-3 = TRIM(RETURN-VALUE).
                run utp/ut-msgs.p (input "msg",
                                   input 33563,
                                   input c-lbl-liter-despesa-siscomex-3 + "~~" + 
                                         c-lbl-liter-codigo-de-despesa-3 + "~~" +
                                         c-lbl-liter-manutencao-de-despesas-e-impos-3).
                create tt-bo-erro.
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-22 AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-22 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-despesa-siscomex-4 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Despesa_Siscomex" *}
                ASSIGN c-lbl-liter-despesa-siscomex-4 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-codigo-de-despesa-4 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "C¢digo_de_Despesa" *}
                ASSIGN c-lbl-liter-codigo-de-despesa-4 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-manutencao-de-despesas-e-impos-4 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Manutená∆o_de_Despesas_e_Impostos" *}
                ASSIGN c-lbl-liter-manutencao-de-despesas-e-impos-4 = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 33563
                       tt-bo-erro.mensagem = c-lbl-liter-22
                       tt-bo-erro.parametros = c-lbl-liter-despesa-siscomex-4 + "~~" + 
                                               c-lbl-liter-codigo-de-despesa-4 + "~~" +
                                               c-lbl-liter-manutencao-de-despesas-e-impos-4.
            end.
            
            if  rowObject.cdn-emit-siscomex <> 0
            and not can-find(first emitente
                             where emitente.cod-emitente = rowObject.cdn-emit-siscomex
                               and (emitente.identific    = 2
                                or  emitente.identific    = 3)) then do:
                assign i-seq-erro = i-seq-erro + 1.
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-fornecedor-siscomex-3 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Fornecedor_Siscomex" *}
                ASSIGN c-lbl-liter-fornecedor-siscomex-3 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-codigo-de-fornecedor-3 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "C¢digo_de_Fornecedor" *}
                ASSIGN c-lbl-liter-codigo-de-fornecedor-3 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-manutencao-de-fornecedores-3 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Manutená∆o_de_Fornecedores" *}
                ASSIGN c-lbl-liter-manutencao-de-fornecedores-3 = TRIM(RETURN-VALUE).
                run utp/ut-msgs.p (input "msg",
                                   input 33563,
                                   input c-lbl-liter-fornecedor-siscomex-3 + "~~" + 
                                         c-lbl-liter-codigo-de-fornecedor-3 + "~~" +
                                         c-lbl-liter-manutencao-de-fornecedores-3).
                create tt-bo-erro.
                /* Inicio -- Projeto Internacional */
                DEFINE VARIABLE c-lbl-liter-23 AS CHARACTER NO-UNDO.
                ASSIGN c-lbl-liter-23 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-fornecedor-siscomex-4 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Fornecedor_Siscomex" *}
                ASSIGN c-lbl-liter-fornecedor-siscomex-4 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-codigo-de-fornecedor-4 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "C¢digo_de_Fornecedor" *}
                ASSIGN c-lbl-liter-codigo-de-fornecedor-4 = TRIM(RETURN-VALUE).
                DEFINE VARIABLE c-lbl-liter-manutencao-de-fornecedores-4 AS CHARACTER NO-UNDO.
                {utp/ut-liter.i "Manutená∆o_de_Fornecedores" *}
                ASSIGN c-lbl-liter-manutencao-de-fornecedores-4 = TRIM(RETURN-VALUE).
                assign tt-bo-erro.i-sequen = i-seq-erro
                       tt-bo-erro.cd-erro  = 33563
                       tt-bo-erro.mensagem = c-lbl-liter-23
                       tt-bo-erro.parametros = c-lbl-liter-fornecedor-siscomex-4 + "~~" + 
                                               c-lbl-liter-codigo-de-fornecedor-4 + "~~" +
                                               c-lbl-liter-manutencao-de-fornecedores-4.
            end.
            
            IF  rowObject.cdn-despes-siscomex <> 0
            AND rowObject.cdn-despes-siscomex  = INT(SUBSTR(rowObject.char-1,21,5)) THEN DO:
                RUN utp/ut-msgs.p (INPUT "msg",
                                   INPUT 33834,
                                   INPUT RETURN-VALUE).
                CREATE tt-bo-erro.
                ASSIGN tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 33834
                       tt-bo-erro.mensagem     = RETURN-VALUE.
            END.
           &endif
    end.

    if valid-handle(h_api_cta) then do:
        delete procedure h_api_cta.
        assign h_api_cta = ?.
    end.
    if valid-handle(h_api_ccust) then do:
        delete procedure h_api_ccust.
        assign h_api_ccust = ?.
    end.    
end procedure.

procedure getCharField:
    define input parameter c-field as char.
    define output parameter c-value as char.

    case c-field:
        when "cod-estabel":U then c-value = RowObject.cod-estabel.
       
        when "ct-transit-import":U then c-value = RowObject.ct-transit-import.
        when "sc-transit-import":U then c-value = RowObject.sc-transit-import.
        when "esp-tit-transit":U then c-value = RowObject.esp-tit-transit.
        when "cod-espec-antecip":U then c-value = RowObject.cod-espec-antecip.
        when "cod-ser-antecip":U then c-value = RowObject.cod-ser-antecip.
        when "esp-tit-rec":U then c-value = RowObject.esp-tit-rec.
        when "char-1":U then c-value = RowObject.char-1.
        when "char-2":U then c-value = RowObject.char-2.
        when "check-sum":U then c-value = RowObject.check-sum.
        when "cod-natur-operac-padr":U then c-value = RowObject.cod-natur-operac-padr.
        when "des-layout-origin-licenc-import":U then c-value = RowObject.des-layout-origin-licenc-import.
        when "des-layout-autoriz-import":U then c-value = RowObject.des-layout-autoriz-import.
        
        otherwise return error.
    end case.
end procedure.

procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.

    case c-field:
        when "dec-1":U then c-value = RowObject.dec-1.
        when "dec-2":U then c-value = RowObject.dec-2.
        when "perc-max-antecip":U then c-value = RowObject.perc-max-antecip.
        otherwise return error.
    end case.
end procedure.

procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.

    case c-field:
        when "hp-codigo":U then c-value = RowObject.hp-codigo.
        when "int-1":U then c-value = RowObject.int-1.
        when "int-2":U then c-value = RowObject.int-2.
        when "cdn-emit-iva" then c-value = RowObject.cdn-emit-iva.
        when "cdn-despes-iva" then c-value = RowObject.cdn-despes-iva.
        when "cdn-despes-tax-estatis" then c-value = RowObject.cdn-despes-tax-estatis.
        when "cdn-emit-tax-estatis" then c-value = RowObject.cdn-emit-tax-estatis.        
        
       /** 2.1.10 Geraá∆o de Impostos Padr‰es na Inclus∆o das Cotaá‰es **/
       when "cdn-despes-impto-ip°":U then c-value = RowObject.cdn-despes-impto-ipi.
       when "cdn-despes-impto-pis":U then c-value = RowObject.cdn-despes-impto-pis.
       when "cdn-despes-impto-cofins":U then c-value = RowObject.cdn-despes-impto-cofins.
       when "cdn-despes-impto-icms":U then c-value = RowObject.cdn-despes-impto-icms.
       when "cdn-fornec-ipi":U then c-value = RowObject.cdn-fornec-ipi.
       when "cdn-fornec-pis":U then c-value = RowObject.cdn-fornec-pis.
       when "cdn-fornec-cofins":U then c-value = RowObject.cdn-fornec-cofins.
       when "cdn-fornec-icms":U then c-value = RowObject.cdn-fornec-icms.
        &if '{&BF_MAT_VERSAO_EMS}'  >= "2.07" &then 
            when "cdn-despes-siscomex" then c-value = RowObject.cdn-despes-siscomex.
        &endif
        
        otherwise return error.
    end case.
end procedure.

procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.

    case c-field:
        when "data-1":U then c-value = RowObject.data-1.
        when "data-2":U then c-value = RowObject.data-2.
        otherwise return error.
    end case.
end procedure.

procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.

    case c-field:
        when "inc-icms-tot-nf":U then c-value = RowObject.inc-icms-tot-nf.
        when "hist-processo":U then c-value = RowObject.hist-processo.
        when "log-1":U then c-value = RowObject.log-1.
        when "log-2":U then c-value = RowObject.log-2.
        when "log-descons-iva-tit-mercad" then c-value = RowObject.log-descons-iva-tit-mercad.
        
       /** 2.1.10 Geraá∆o de Impostos Padr‰es na Inclus∆o das Cotaá‰es **/
        when "log-gerac-cotac-despes-impto":U then c-value = RowObject.log-gerac-cotac-despes-impto.
        when "log-cotac-autom-impto-import":U then c-value = RowObject.log-cotac-autom-impto-import.
        when "log-cotac-autom-ipi":U then c-value = RowObject.log-cotac-autom-ipi.
        when "log-cotac-autom-pis":U then c-value = RowObject.log-cotac-autom-pis.
        when "log-cotac-autom-cofins":U then c-value = RowObject.log-cotac-autom-cofins.
        when "log-cotac-autom-icms":U then c-value = RowObject.log-cotac-autom-icms.
        when "log-incid-icms-ipi-outros-of" then c-value = RowObject.log-incid-icms-ipi-outros-of.
        &if '{&BF_MAT_VERSAO_EMS}'  >= "2.07" &then
            when "log-tax-siscomex" then c-value = RowObject.log-tax-siscomex.
        &endif
        
        otherwise return error.
    end case.
end procedure.

procedure pi-conecta-bases-EMS5:
    define output parameter l-emsbas     as logical init no.
    define output parameter l-emsfin     as logical init no.
    define output parameter l-emsuni     as logical init no.
    define output parameter l-ems50-erro as logical init no.

    find first param-global no-lock no-error.
    
    &if defined(bf-mat-comex) &then    
    &else
    DEF VAR h-btb009za AS HANDLE.
    
    if not avail param-global then
        find first param-global no-lock no-error.
    
    RUN btb/btb009za.p PERSISTENT SET h-btb009za.    
    run pi-conecta-bco IN h-btb009za (Input 1,
                                      Input 1,
                                      Input param-global.empresa-prin,
                                      Input "all":U,
                                      Output Table tt_erros_conexao).    
    if return-value <> "OK":U then do:
        find first tt_erros_conexao no-error.
        if avail tt_erros_conexao 
           and tt_erros_conexao.cd-erro <> 25821 
           and tt_erros_conexao.cd-erro <> 25822 then 
            assign l-ems50-erro = yes.
        else
            assign l-emsbas = yes
                   l-emsfin = yes
                   l-emsuni = yes.            
    end.
    else
        assign l-emsbas = yes
               l-emsfin = yes
               l-emsuni = yes.
    DELETE PROCEDURE h-btb009za.
    
    &endif
end procedure.


procedure pi-desconecta-bases-EMS5:
    define input parameter l-emsbas as logical no-undo.
    define input parameter l-emsfin as logical no-undo.
    define input parameter l-emsuni as logical no-undo.
    
    &if defined(bf-mat-comex) &then
    &else

    DEF VAR h-btb009za AS HANDLE.
    
    if not avail param-global then
        find first param-global no-lock no-error.
    
    RUN btb/btb009za.p PERSISTENT SET h-btb009za.    
    run pi-conecta-bco IN h-btb009za (Input 1,
                                      Input 2,
                                      Input param-global.empresa-prin,
                                      Input "all":U,
                                      Output Table tt_erros_conexao).    
    DELETE PROCEDURE h-btb009za.
        
    &endif    
end procedure.

procedure retornarelaciona:
    /****************************
    * "Ordens de Compra ", no,  *
    * "Parcelas de Compra", yes *
    ****************************/
    define output parameter p-relaciona as logical no-undo.
    assign p-relaciona = param-imp.log-1.
    if p-relaciona = ? 
    then assign p-relaciona = no.
end.

procedure retornainforma:
    define output parameter p-informa as integer no-undo.
    if avail param-imp then 
        assign p-informa = param-imp.int-1.
end.

procedure setConfirmaSenha :
    define input parameter pc-confirma-senha as character format "x(15)":U no-undo.

    assign c-confirma-senha = pc-confirma-senha.

    return "OK":U.
end procedure.

procedure setConfirmaSenhaPch :
    define input parameter pc-confirma-senha as character format "x(15)":U no-undo.

    assign c-confirma-senha-pch = pc-confirma-senha.

    return "OK":U.
end procedure.

procedure piCopiaIternacImptoFaixa:

    def input  param pEstabOld like param-imp.cod-estabel no-undo.
    def input  param pEstabNew like param-imp.cod-estabel no-undo.
    def output param table for RowErrors.
    
    if not valid-handle(h-bocx00454) then
        run cxbo/bocx00454.p persistent set h-bocx00454.
        
    run openQueryStatic in h-bocx00454 ("Main":U).

    run emptyRowErrors  in h-bocx00454.
    
    for each  internac-impto-faixa no-lock
        where internac-impto-faixa.cod-estabel = pEstabOld:
    
        empty temp-table tt-internac-impto-faixa.
    
        create tt-internac-impto-faixa.
        assign tt-internac-impto-faixa.cod-estabel = pEstabNew.
        buffer-copy internac-impto-faixa except cod-estabel to tt-internac-impto-faixa.
        
        run goToKey in h-bocx00454 (input tt-internac-impto-faixa.cod-estabel,
                                    input tt-internac-impto-faixa.num-sequencia).
                                    
        if return-value = "NOK":U then do:
            run emptyRowObject in h-bocx00454.
            run setRecord      in h-bocx00454 (input table tt-internac-impto-faixa).
            run createRecord   in h-bocx00454.
            run getRowErrors   in h-bocx00454 (output table RowErrors).
        end.
    end.


end procedure.
