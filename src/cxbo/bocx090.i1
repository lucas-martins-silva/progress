{cdp/cdcfgmat.i} /* Definicao de pre-processadores */

&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.000
&scoped-define FIRST-TABLE-IN-QUERY docum-est-cex
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME docum-est-cex

{include/boini.i}
{cxbo/bocx090.i RowObject}

DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

def var l-inclusao as logical no-undo.

procedure setConstraint1:
end procedure. 

procedure setConstraint2:
    def input parameter r-chave as rowid no-undo.
  
    find docum-est where rowid(docum-est) = r-chave no-lock no-error.    
end procedure.

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.    
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock where 
                                         &if defined(bf-mat-comex) &then                                
                                             {&TABLE-NAME}.nro-docto = string(docum-est.nro-docto) and
                                         &else
                                             {&TABLE-NAME}.nro-docto = docum-est.nro-docto and                                         
                                         &endif
                                         {&TABLE-NAME}.nat-operacao  = docum-est.nat-operacao and
                                         {&TABLE-NAME}.serie-docto   = docum-est.serie-docto and
                                         {&TABLE-NAME}.cod-emitente  = docum-est.cod-emitente.  
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.
 
{include/bostrmet.i}
{include/boendmet.i}
&if defined(bf-mat-comex) &then    
&else
    {include/bocomver.i}
    {include/bogetver.i}
&endif
{include/bonav.i}
{include/bofind.i}
{include/bosetcur.i}
{include/bogetcur.i}
{include/bosersen.i}
{include/boprebro.i}
{include/boexecre.i}
{include/boexedel.i}
{include/bovaldel.i}

procedure initializeValidate:
    /*
    **  Inicializa Validate
    */
     
    run startMethod ("initializeValidade").
 
    run endMethod   ("initializeValidade").
end procedure.

/* Utilizado para encontrar a primeira despesa da nota - Magnus */
procedure findFirstDespNota:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    
    def input  parameter c-serie-docto       like {&TABLE-NAME}.serie-docto       no-undo.
    def input  parameter c-nro-docto         like {&TABLE-NAME}.nro-docto         no-undo.
    def input  parameter i-cod-emitente      like {&TABLE-NAME}.cod-emitente      no-undo.
    def input  parameter c-nat-operacao      like {&TABLE-NAME}.nat-operacao      no-undo.
    def output parameter c-return            as char                              no-undo.
    
    run startMethod("find":U).
    
    {cdp/cd2503.i c-nat-operacao} /* Retira "." "-" do valor do campo */ 
    
    find first {&TABLE-NAME} 
        where {&TABLE-NAME}.serie-docto  = c-serie-docto
          and {&TABLE-NAME}.nro-docto    = c-nro-docto
          and {&TABLE-NAME}.cod-emitente = i-cod-emitente
          and {&TABLE-NAME}.nat-operacao = c-nat-operacao
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex docum-est-cex 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.                           
    end.
    else do:
       run setCurrent.
    end.
    run endMethod("find":U).
end procedure.

/* Utilizado para encontrar a ultima despesa da nota - Magnus */
procedure findLastDespNota:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    
    def input  parameter c-serie-docto       like {&TABLE-NAME}.serie-docto       no-undo.
    def input  parameter c-nro-docto         like {&TABLE-NAME}.nro-docto         no-undo.
    def input  parameter i-cod-emitente      like {&TABLE-NAME}.cod-emitente      no-undo.
    def input  parameter c-nat-operacao      like {&TABLE-NAME}.nat-operacao      no-undo.
    def output parameter c-return            as char                                 no-undo.
    
    run startMethod("find":U).
    
    {cdp/cd2503.i c-nat-operacao} /* Retira "." "-" do valor do campo */ 
    
    find last {&TABLE-NAME} 
        where {&TABLE-NAME}.serie-docto  = c-serie-docto
          and {&TABLE-NAME}.nro-docto    = c-nro-docto
          and {&TABLE-NAME}.cod-emitente = i-cod-emitente
          and {&TABLE-NAME}.nat-operacao = c-nat-operacao
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex docum-est-cex 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.                           
    end.
    else do:
       run setCurrent.
    end.
    run endMethod("find":U).
end procedure.

/* Utilizado para navegar nas despesas da nota - Magnus */
procedure findPrevDespNota:
    def input  parameter c-serie-docto       like {&TABLE-NAME}.serie-docto       no-undo.
    def input  parameter c-nro-docto         like {&TABLE-NAME}.nro-docto         no-undo.
    def input  parameter i-cod-emitente      like {&TABLE-NAME}.cod-emitente      no-undo.
    def input  parameter c-nat-operacao      like {&TABLE-NAME}.nat-operacao      no-undo.
    def output parameter c-return            as char                                 no-undo.   
    
    find prev {&TABLE-NAME} where
        {&TABLE-NAME}.serie-docto  = c-serie-docto and
        {&TABLE-NAME}.nro-docto    = c-nro-docto and
        {&TABLE-NAME}.cod-emitente = i-cod-emitente and
        {&TABLE-NAME}.nat-operacao = c-nat-operacao 
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        run utp/ut-msgs.p (input "msg",
                           input 7998,
                           input "").
        assign c-return = return-value.
    end.
    else run setCurrent.
end procedure.

/* Utilizado para navegar nas despesas da nota - Magnus */
procedure findNextDespNota:    
    def input  parameter c-serie-docto       like {&TABLE-NAME}.serie-docto       no-undo.
    def input  parameter c-nro-docto         like {&TABLE-NAME}.nro-docto         no-undo.
    def input  parameter i-cod-emitente      like {&TABLE-NAME}.cod-emitente      no-undo.
    def input  parameter c-nat-operacao      like {&TABLE-NAME}.nat-operacao      no-undo.
    def output parameter c-return            as char                                 no-undo.
    
    find next {&TABLE-NAME} where
        {&TABLE-NAME}.serie-docto  = c-serie-docto and
        {&TABLE-NAME}.nro-docto    = c-nro-docto and
        {&TABLE-NAME}.cod-emitente = i-cod-emitente and
        {&TABLE-NAME}.nat-operacao = c-nat-operacao 
        no-lock no-error.        
    if not avail {&TABLE-NAME} then do:
        run utp/ut-msgs.p (input "msg",
                           input 7999,
                           input "").
        assign c-return = return-value.
    end.
    else run setCurrent.
end procedure.

procedure findCodigo:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    def input parameter c-serie-docto as char no-undo.
    def input parameter c-nro-docto as char no-undo.
    def input parameter i-cod-emitente as inte no-undo.
    def input parameter c-nat-operacao as char no-undo.
    def input parameter i-cod-emitente-desp as inte no-undo.
    def input parameter i-cod-desp as inte no-undo.
    def output parameter c-return as char no-undo.    
    
    run startMethod("find":U).
 
    find docum-est-cex where docum-est-cex.serie-docto = c-serie-docto and
                             docum-est-cex.nro-docto = c-nro-docto and 
                             docum-est-cex.cod-emitente = i-cod-emitente and
                             docum-est-cex.nat-operacao = c-nat-operacao and 
                             docum-est-cex.cod-emitente-desp = i-cod-emitente-desp and
                             docum-est-cex.cod-desp = i-cod-desp
                             no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex docum-est-cex 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.                           
    end.
    else do:
       run setCurrent.
    end.
    run endMethod("find":U).
end procedure.

procedure findDesp_imp:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    def input parameter i-cod-desp as inte no-undo.
    def output parameter c-return as char no-undo.        
    
    run startMethod("find":U).
 
    find docum-est-cex where docum-est-cex.cod-desp = i-cod-desp no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex docum-est-cex 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.                            
    end.
    else do:
        run setCurrent.
    end.
    run endMethod("find":U).
end procedure.

procedure executeUpdate:
    /*
    **  Executa Update
    */
    buffer-copy RowObject except r-rowid serie-docto nro-docto cod-emitente nat-operacao cod-emitente-desp cod-desp to {&TABLE-NAME}.
end procedure.

procedure validateUpdate:
    /*
    **  Valida Update
    */
    def input parameter table for RowObject.
    def input parameter r-chave as rowid no-undo.
    def output parameter table for tt-bo-erro.
    
    def var de-valor-despesa as decimal no-undo.
    
    run startMethod("validateUpdate":U).
 
    run InitializeValidate.
 
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.    
 
    run validateFields.    
    
    assign de-valor-despesa = rowObject.val-desp.    
    
    find first tt-bo-erro
        no-lock no-error.
    if not avail tt-bo-erro then do:
        find {&TABLE-NAME} where
            rowid({&TABLE-NAME}) = r-chave
            exclusive-lock no-error no-wait.
        if locked({&table-name}) then do:
            assign i-seq-erro = i-seq-erro + 1.    
            run utp/ut-msgs.p (input "msg",
	                       input 16096,
 			       input "").
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen = i-seq-erro
  	            tt-bo-erro.cd-erro  = 16096
 	            tt-bo-erro.mensagem = return-value.                
        end.
        else
            if avail {&table-name} then do:
                if de-valor-despesa <> {&table-name}.val-desp then             
                    run atualizaItens(input r-chave, input de-valor-despesa). 
                run executeUpdate.
            end.
    end.
    run endMethod("validateUpdate":U).    
end procedure.

procedure validateFields:
    /*
    **  Valida Fields
    */
    run startMethod("validateFields":U).
    
    find first rowObject no-lock no-error.        

    if not can-find(moeda where moeda.mo-codigo = rowObject.mo-codigo) then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex docum-est-cex mo-codigo 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 2
               tt-bo-erro.mensagem = return-value.
    end.     
 
    if rowObject.val-desp = 0 then do:
       assign i-seq-erro = i-seq-erro + 1.
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex docum-est-cex val-desp 1}
        /******************************************/
       run utp/ut-msgs.p (input "msg",
                          input 265,
                          input return-value).
       create tt-bo-erro.
       assign tt-bo-erro.i-sequen     = i-seq-erro
              tt-bo-erro.cd-erro      = 265
              tt-bo-erro.mensagem     = return-value.
    end.
 
    run endMethod("validateFields":U).
end procedure.

procedure setValidate:
/* 
** Verifica se esta sendo incluido uma despesa para um documento novo
*/     
def input parameter p-inclusao as logical no-undo.

assign l-inclusao = p-inclusao.

end procedure.

procedure validateCreate:
    /*
    **  Valida criacao da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.
    
    {cdp/cd4300.i3}
    
    run startMethod("validateCreate":U).
 
    run initializeValidate.
 
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
 
    find first rowObject no-error.
    
    {rep/re1001a.i50}
    
    for first docum-est fields(cod-estabel char-1)
        where docum-est.serie-docto  = rowObject.serie-docto 
         &if defined(bf-mat-comex) &then
          and docum-est.nro-docto    = integer(rowObject.nro-docto)
         &else
          and docum-est.nro-docto    = rowObject.nro-docto
         &endif
          and docum-est.cod-emitente = rowObject.cod-emitente
          and docum-est.nat-operacao = rowObject.nat-operacao no-lock:
      &if defined(bf-mat-comex) &then
        assign c-embarque = substring(docum-est.char-1,2,12).
      &else
        {cdp/cd4300.i4 "yes" docum-est.char-1}
        {rep/re1001a.i51 "yes"}
      &endif
    end.
    
    if not avail docum-est then do:
        assign i-seq-erro = i-seq-erro + 1.
        {utp/ut-liter.i Documento * L}
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 2,
                           input tt-bo-erro.parametros).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 2
               tt-bo-erro.mensagem     = return-value.
        RETURN "NOK":U.                       
    end.    
    
    if c-embarque = "" then do:
        for first estabelec fields(pais)
            where estabelec.cod-estabel = docum-est.cod-estabel no-lock:
        end.    
        
        for first emitente fields(natureza pais)
            where emitente.cod-emitente = rowObject.cod-emitente no-lock:
          &if defined(bf-mat-comex) &then
            if (emitente.natureza <> "E":U and emitente.natureza <> "T":U) then do:
          &else
            if (emitente.natureza <> 3 and emitente.natureza <> 4) then do:
          &endif
                assign i-seq-erro = i-seq-erro + 1.
                run utp/ut-msgs.p (input "msg":U,
                                   input 19156,
                                   input "").
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 19156
                       tt-bo-erro.mensagem     = return-value.
                RETURN "NOK":U.                   
            end.
            if emitente.pais = estabelec.pais then do:
                assign i-seq-erro = i-seq-erro + 1.
                run utp/ut-msgs.p (input "msg":U,
                                   input 27238,
                                   input "").
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 27238
                       tt-bo-erro.mensagem     = return-value.
                RETURN "NOK":U.
            end.
        end.        
    end.        
    
    run validateCreatedesp (input rowObject.cod-emitente-desp,
                            input rowObject.cod-desp,
                            input rowObject.val-desp,
                            output table tt-bo-erro).
                                
    if rowObject.serie-docto <> "" then do:
        find serie 
            where serie.serie = rowObject.serie-docto 
            no-lock no-error.
        if not avail serie then do:            
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgind serie 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.            
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.   
        end.
    end.
    
    if rowObject.nat-operacao = "" then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex docum-est-cex nat-operacao 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg":U,
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    else do:
        find natur-oper 
            where natur-oper.nat-operacao = rowObject.nat-operacao 
            no-lock no-error.
        if not avail natur-oper then do:            
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgind natur-oper 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.            
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.   
        end.
    end.    
    
    if rowObject.cod-emitente = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex docum-est-cex cod-emitente 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.   
    end.
    else do:
        find emitente 
            where emitente.cod-emitente = rowObject.cod-emitente 
            no-lock no-error.
        if not avail emitente then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgadm emitente 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.            
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.   
        end.            
    end.
        
    if not l-inclusao then do:                
        find docum-est
            where docum-est.serie-docto = rowObject.serie-docto 
              &if defined(bf-mat-comex) &then
                and docum-est.nro-docto   = integer(rowObject.nro-docto)
              &else
                and docum-est.nro-docto   = rowObject.nro-docto
              &endif
              and docum-est.cod-emitente = rowObject.cod-emitente
              and docum-est.nat-operacao = rowObject.nat-operacao
              no-lock no-error.
        if not avail docum-est then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgind docum-est 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.            
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.
        end.        
    end.         
  
    find first tt-bo-erro
        no-lock no-error.
    if not avail tt-bo-erro then do:
        find docum-est-cex 
            where docum-est-cex.serie-docto       = rowObject.serie-docto
              and docum-est-cex.nro-docto         = rowObject.nro-docto
              and docum-est-cex.cod-emitente      = rowObject.cod-emitente
              and docum-est-cex.nat-operacao      = rowObject.nat-operacao
              and docum-est-cex.cod-emitente-desp = rowObject.cod-emitente-desp
              and docum-est-cex.cod-desp          = rowObject.cod-desp
              no-lock no-error.
        if avail docum-est-cex then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgcex docum-est-cex 1}
            /******************************************/
            create tt-bo-erro.
            assign tt-bo-erro.parametros = return-value.            
            run utp/ut-msgs.p (input "msg":U,
                               input 8,
                               input return-value).
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 8
                   tt-bo-erro.mensagem = return-value.
        end.
    end.
 
    run validateFields.
    
    find first tt-bo-erro
        no-lock no-error.
 
    if not avail tt-bo-erro then do:
       run executeCreate.
       assign r-chave = to-rowid(return-value).
    end.
    
    run endMethod("validateCreate").
end procedure.

procedure validateCreatedesp:
/*
** valida apenas os valores do emitente da despesa e da despesa
*/
def input parameter p-cod-emitente-desp like emitente.cod-emitente  no-undo.
def input parameter p-cod-desp          like desp-imp.cod-desp      no-undo.
def input parameter p-val-desp          like docum-est-cex.val-desp no-undo.
def output parameter table for tt-bo-erro.

    for each tt-bo-erro:
        delete tt-bo-erro.
    end.

    if p-cod-desp = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex docum-est-cex cod-desp 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.        
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
    end.
    else do:
         if not can-find(desp-imp where desp-imp.cod-desp = p-cod-desp) then do:
          assign i-seq-erro = i-seq-erro + 1.
         /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
            pre-processador em chamada de includes */
        {utp/ut-field.i mgcex docum-est-cex cod-desp 1}
        /******************************************/
          create tt-bo-erro.        
          assign tt-bo-erro.parametros = return-value.
          run utp/ut-msgs.p (input "msg":U,
                             input 2,
                             input return-value).
          assign tt-bo-erro.i-sequen = i-seq-erro
                 tt-bo-erro.cd-erro  = 2
                 tt-bo-erro.mensagem = return-value.
       end.           
    end. 
    
    if p-cod-emitente-desp = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex docum-est-cex cod-emitente-desp 1}
        /******************************************/
        create tt-bo-erro.
        assign tt-bo-erro.parametros = return-value.        
        run utp/ut-msgs.p (input "msg":U,
                           input 7965,
                           input return-value).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 7965
               tt-bo-erro.mensagem     = return-value.
    end.
    else do:
         if not can-find(emitente where emitente.cod-emitente = p-cod-emitente-desp) then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-field.i mgcex docum-est-cex cod-emitente-desp 1}
            /******************************************/
            create tt-bo-erro.            
            assign tt-bo-erro.parametros = return-value.
            run utp/ut-msgs.p (input "msg":U,
                               input 2,
                               input return-value).
            assign tt-bo-erro.i-sequen = i-seq-erro
                   tt-bo-erro.cd-erro  = 2
                   tt-bo-erro.mensagem = return-value.
         end. 
         find emitente where emitente.cod-emitente = p-cod-emitente-desp
              no-lock no-error.
         if   avail emitente then do:
             {cdp/cd2502.i} /* Se e fornecedor ou ambos */
         end.
    end.

    if p-val-desp = 0 then do:
       assign i-seq-erro = i-seq-erro + 1.
       /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
          pre-processador em chamada de includes */
       {utp/ut-field.i mgcex docum-est-cex val-desp 1}
       /******************************************/
       create tt-bo-erro.        
       assign tt-bo-erro.parametros = return-value.
       run utp/ut-msgs.p (input "msg",
                          input 265,
                          input return-value).
       assign tt-bo-erro.i-sequen     = i-seq-erro
              tt-bo-erro.cd-erro      = 265
              tt-bo-erro.mensagem     = return-value.
    end.    

end procedure.

procedure validateCodigo:
/*
** Valida o formato e o tipo de valor que esta sendo preenchido.
*/
    def input-output parameter c-cod-emitente-desp as char no-undo.
    def input-output parameter c-cod-desp          as char no-undo.
    def input-output parameter c-val-desp          as char no-undo.
    def input-output parameter c-mo-codigo         as char no-undo.            
    def output parameter table for tt-bo-erro.
    
    def var i-teste1 as integer no-undo.
    def var i-teste2 as integer no-undo.
    def var i-teste3 as integer no-undo.
    def var i-teste4 as integer no-undo.
    
    assign i-teste1 = int(c-cod-emitente-desp) no-error.
    if  error-status:error then do:
        assign i-seq-erro = i-seq-erro + 1
               c-cod-emitente-desp = "0".
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex docum-est-cex cod-emitente-desp 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 16963,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 16963
               tt-bo-erro.mensagem     = return-value.
    end.    
    assign i-teste2 = int(c-cod-desp) no-error.
    if  error-status:error then do:
        assign i-seq-erro = i-seq-erro + 1
               c-cod-desp = "0".
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex docum-est-cex cod-desp 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 16963,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 16963
               tt-bo-erro.mensagem     = return-value.
    end.          
    assign i-teste3 = int(c-val-desp) no-error.
    if  error-status:error then do:
        assign i-seq-erro = i-seq-erro + 1
               c-val-desp = "0".
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex docum-est-cex val-desp 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 16963,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 16963
               tt-bo-erro.mensagem     = return-value.
    end.    
    assign i-teste4 = int(c-mo-codigo) no-error.
    if  error-status:error then do:
        assign i-seq-erro = i-seq-erro + 1
               c-mo-codigo = "0".
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex docum-est-cex mo-codigo 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 16963,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 16963
               tt-bo-erro.mensagem     = return-value.
    end.
              
end procedure.

procedure findCotacao:
/*
** Acha a cotacao da moeda para a data atual.
*/
    def input  parameter da-dt-trans like docum-est.dt-trans no-undo.
    def input  parameter c-moeda like docum-est-cex.mo-codigo no-undo.
    def output parameter de-cotacao as decimal init 0.
    
    def var c-periodo like cotacao.ano-periodo no-undo.    
             
    assign c-periodo = string(year(da-dt-trans), "9999") + 
                       string(month(da-dt-trans), "99" ).    
    find cotacao
         where cotacao.mo-codigo = c-moeda
         and   cotacao.ano-periodo = c-periodo no-lock no-error.
    if  avail cotacao then do:
        assign de-cotacao = cotacao.cotacao[day(da-dt-trans)].
    end.
    else 
        assign de-cotacao = 1.
end procedure.

procedure atualizaItens:
/*
** Atualiza as despesas do item-doc-est-cex, item-doc-est e docum-est
*/
    def input  parameter r-row  as rowid   no-undo.
    def input  parameter de-val as decimal no-undo.
    
    def var h-im9028 as handle no-undo.
    
    RUN imp/im9028.p persistent set h-im9028.
    run pi-atualizaItens in h-im9028 (input r-row, input de-val).    
    delete procedure h-im9028.    
end procedure.
 
procedure getCharField:
    define input  parameter c-field as char.
    define output parameter c-value as char.
 
    case c-field:
        when "serie-docto" then c-value = RowObject.serie-docto.
        when "nro-docto" then c-value = RowObject.nro-docto.
        when "nat-operacao" then c-value = RowObject.nat-operacao.
        when "char-1" then c-value = RowObject.char-1.
        when "char-2" then c-value = RowObject.char-2.
        when "check-sum" then c-value = RowObject.check-sum.
        otherwise return error.
    end case.
end procedure.
 
procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.
 
    case c-field:
        when "val-desp" then c-value = RowObject.val-desp.
        when "cotacao" then c-value = RowObject.cotacao.
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        otherwise return error.
    end case.
end procedure.
 
procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.
 
    case c-field:
        when "cod-emitente" then c-value = RowObject.cod-emitente.
        when "cod-emitente-desp" then c-value = RowObject.cod-emitente-desp.
        when "cod-desp" then c-value = RowObject.cod-desp.
        when "cod-cond-pag" then c-value = RowObject.cod-cond-pag.
        when "mo-codigo" then c-value = RowObject.mo-codigo.
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.        
        otherwise return error.
    end case.
end procedure.
 
procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.
 
    case c-field:
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.        
        otherwise return error.
    end case.
end procedure.
 
procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.
 
    case c-field:
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.        
        otherwise return error.
    end case.
end procedure.
