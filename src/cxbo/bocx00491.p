&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE setaTipo DBOProgram 
PROCEDURE setaTipo :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAM pTipo    AS INTEGER   NO-UNDO.
    
    IF pTipo = 0 THEN
        ASSIGN iTipoIni    = 1
               iTipoFim    = 99.
    ELSE 
        ASSIGN iTipoIni    = pTipo
               iTipoFim    = pTipo.

    RETURN "OK":U.
END PROCEDURE.

