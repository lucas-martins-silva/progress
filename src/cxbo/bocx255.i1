{cdp/cdcfgmat.i} /* Definicao de pre-processadores */

&scoped-define BOVERSION 1.1
&scoped-define PRVERSION 2.00.00.000
&scoped-define FIRST-TABLE-IN-QUERY dupli-apagar-cex
&scoped-define QUERY-NAME qTable
&scoped-define TABLE-NAME dupli-apagar-cex

{include/boini.i}
{cxbo/bocx255.i RowObject}

DEFINE QUERY {&QUERY-NAME} for {&TABLE-NAME} scrolling.

DEF VAR c-usuario LIKE param-re.usuario NO-UNDO.

procedure setConstraint1:
end procedure.

procedure setConstraint2:

    def input parameter p-r-chave   as rowid no-undo.
 
    find docum-est where rowid(docum-est) = p-r-chave no-lock no-error.
end procedure. 

procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then 
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock.    
        when 2 then
            open query {&QUERY-NAME} for each {&TABLE-NAME} no-lock
                where dupli-apagar-cex.serie-docto   = docum-est.serie-docto and
                      &if defined(bf-mat-comex) &then                    
                          dupli-apagar-cex.nro-docto = string(docum-est.nro-docto) and
                      &else
                          dupli-apagar-cex.nro-docto = docum-est.nro-docto and                      
                      &endif    
                      dupli-apagar-cex.cod-emitente  = docum-est.cod-emitente and
                      dupli-apagar.nat-operacao      = docum-est.nat-operacao.
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.
 
{include/bostrmet.i}
{include/boendmet.i}
&if defined(bf-mat-comex) &then    
&else
    {include/bocomver.i}
    {include/bogetver.i}
&endif
{include/bonav.i}
{include/bofind.i}
{include/bosetcur.i}
{include/bogetcur.i}
{include/bosersen.i}
{include/boprebro.i}
{include/boexecre.i}
{include/boexedel.i}
{include/bovaldel.i}

/* Utilizado para navegar nas duplicatas de despesas da nota - Magnus */
procedure findPrevDupliNota:
    def input  parameter c-serie-docto       like dupli-apagar-cex.serie-docto       no-undo.
    def input  parameter c-nro-docto         like dupli-apagar-cex.nro-docto         no-undo.
    def input  parameter i-cod-emitente      like dupli-apagar-cex.cod-emitente      no-undo.
    def input  parameter c-nat-operacao      like dupli-apagar-cex.nat-operacao      no-undo.
    def output parameter c-return            as char                                 no-undo.
    
    find prev {&TABLE-NAME} where
        {&TABLE-NAME}.serie-docto  = c-serie-docto and
        {&TABLE-NAME}.nro-docto   = c-nro-docto and
        {&TABLE-NAME}.cod-emitente = i-cod-emitente and
        {&TABLE-NAME}.nat-operacao = c-nat-operacao no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        run utp/ut-msgs.p (input "msg",
                           input 7998,
                           input "").
        assign c-return = return-value.
    end.
    else run setCurrent.
end procedure.

/* Utilizado para navegar nas duplicatas de despesas da nota - Magnus */
procedure findNextDupliNota:
    
    def input  parameter c-serie-docto       like dupli-apagar-cex.serie-docto       no-undo.
    def input  parameter c-nro-docto         like dupli-apagar-cex.nro-docto         no-undo.
    def input  parameter i-cod-emitente      like dupli-apagar-cex.cod-emitente      no-undo.
    def input  parameter c-nat-operacao      like dupli-apagar-cex.nat-operacao      no-undo.
    def output parameter c-return            as char                                 no-undo.
    
    find next {&TABLE-NAME} where
        {&TABLE-NAME}.serie-docto  = c-serie-docto and
        {&TABLE-NAME}.nro-docto   = c-nro-docto and
        {&TABLE-NAME}.cod-emitente = i-cod-emitente and
        {&TABLE-NAME}.nat-operacao = c-nat-operacao        
        no-lock no-error.        
    if not avail {&TABLE-NAME} then do:
        run utp/ut-msgs.p (input "msg",
                           input 7999,
                           input "").
        assign c-return = return-value.
    end.
    else run setCurrent.
end procedure.

procedure findCodigo:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    def input  parameter c-serie-docto       like dupli-apagar-cex.serie-docto       no-undo.
    def input  parameter c-nro-docto         like dupli-apagar-cex.nro-docto         no-undo.
    def input  parameter i-cod-emitente      like dupli-apagar-cex.cod-emitente      no-undo.
    def input  parameter c-nat-operacao      like dupli-apagar-cex.nat-operacao      no-undo.
    def input  parameter i-cod-emitente-desp like dupli-apagar-cex.cod-emitente-desp no-undo.    
    def input  parameter i-parcela           like dupli-apagar-cex.parcela           no-undo.    
    def output parameter c-return            as char                                 no-undo.
    
    run startMethod("find":U).
    
    {cdp/cd2503.i c-nat-operacao} /* Retira "." "-" do valor do campo */ 
    find first dupli-apagar-cex 
        where dupli-apagar-cex.serie-docto       = c-serie-docto
          and dupli-apagar-cex.nro-docto         = c-nro-docto
          and dupli-apagar-cex.cod-emitente      = i-cod-emitente
          and dupli-apagar-cex.nat-operacao      = c-nat-operacao
          and dupli-apagar-cex.cod-emitente-desp = i-cod-emitente-desp
          and dupli-apagar-cex.parcela           = i-parcela
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        {utp/ut-liter.i Duplicata * l}    
        run utp/ut-msgs.p (input "msg",
                           input 5366,
                           input return-value).
        assign c-return = trim(return-value).
    end.
    else do:
       run setCurrent.
    end.
    run endMethod("find":U).
end procedure.

/* Utilizado para encontrar a primeira duplicata pertencente a nota - Magnus */
procedure findFirstDupli:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    
    def input  parameter c-serie-docto       like dupli-apagar-cex.serie-docto       no-undo.
    def input  parameter c-nro-docto         like dupli-apagar-cex.nro-docto         no-undo.
    def input  parameter i-cod-emitente      like dupli-apagar-cex.cod-emitente      no-undo.
    def input  parameter c-nat-operacao      like dupli-apagar-cex.nat-operacao      no-undo.
    def output parameter c-return            as char                                 no-undo.
    
    run startMethod("find":U).
    
    {cdp/cd2503.i c-nat-operacao} /* Retira "." "-" do valor do campo */ 
    
    find first dupli-apagar-cex 
        where dupli-apagar-cex.serie-docto  = c-serie-docto
          and dupli-apagar-cex.nro-docto    = c-nro-docto
          and dupli-apagar-cex.cod-emitente = i-cod-emitente
          and dupli-apagar-cex.nat-operacao = c-nat-operacao
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex dupli-apagar-cex 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.                           
    end.
    else do:
       run setCurrent.
    end.
    run endMethod("find":U).
end procedure.

/* Utilizado para encontrar a ultima duplicata pertencente a nota - Magnus */
procedure findLastDupli:
    /*
    **  Procura pelo indice, caso nao ache,
    **  retorna mensagem de erro padrao do EMS.
    */
    
    def input  parameter c-serie-docto       like dupli-apagar-cex.serie-docto       no-undo.
    def input  parameter c-nro-docto         like dupli-apagar-cex.nro-docto         no-undo.
    def input  parameter i-cod-emitente      like dupli-apagar-cex.cod-emitente      no-undo.
    def input  parameter c-nat-operacao      like dupli-apagar-cex.nat-operacao      no-undo.
    def output parameter c-return            as char                                 no-undo.
    
    run startMethod("find":U).
    
    {cdp/cd2503.i c-nat-operacao} /* Retira "." "-" do valor do campo */ 
    
    find last dupli-apagar-cex 
        where dupli-apagar-cex.serie-docto  = c-serie-docto
          and dupli-apagar-cex.nro-docto    = c-nro-docto
          and dupli-apagar-cex.cod-emitente = i-cod-emitente
          and dupli-apagar-cex.nat-operacao = c-nat-operacao
        no-lock no-error.
    if not avail {&TABLE-NAME} then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex dupli-apagar-cex 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 2,
                           input return-value).
        assign c-return = return-value.                           
    end.
    else do:
       run setCurrent.
    end.
    run endMethod("find":U).
end procedure.

procedure executeUpdate:
    /*
    **  Executa Update
    */
    buffer-copy RowObject except r-rowid serie-docto nro-docto cod-emitente nat-operacao cod-emitente-desp parcela to {&TABLE-NAME}.
end procedure.

procedure initializeValidate:
    /*
    **  Inicializa Validate
    */
     
    run startMethod ("initializeValidade").
 
    run endMethod   ("initializeValidade").
end procedure.

procedure validateUpdate:
    /*
    **  Valida Update
    */
    def input  parameter table for RowObject.
    def input  parameter r-chave as rowid no-undo.
    def output parameter table for tt-bo-erro.
    
    run startMethod("validateUpdate":U).
 
    run InitializeValidate.
 
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
    
    find first rowObject no-error.
 
    run validateFields.
    
    find first tt-bo-erro
        no-lock no-error.
    if not avail tt-bo-erro then do:
        find {&TABLE-NAME} where
            rowid({&TABLE-NAME}) = r-chave
            exclusive-lock no-error no-wait.

        if locked({&table-name}) then do:
            assign i-seq-erro = i-seq-erro + 1.    
            run utp/ut-msgs.p (input "msg",
	                       input 16096,
 			       input "").
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen = i-seq-erro
  	           tt-bo-erro.cd-erro  = 16096
 	           tt-bo-erro.mensagem = return-value.                
        end.
        else 
	    if avail {&table-name} then
                run executeUpdate.
    end.    
    run endMethod("find":U).
end procedure.

procedure validateCreate:
    /*
    **  Valida criacao da tabela/duplicidade de registro.
    */
    def input  parameter table for RowObject.
    def output parameter table for tt-bo-erro.
    def output parameter r-chave as rowid.
    
    {cdp/cd4300.i3} /* tratamento atributo livre */
    
    run startMethod("validateCreate":U).

    run initializeValidate.
 
    for each tt-bo-erro:
        delete tt-bo-erro.
    end.
 
    find first rowObject no-error.
    
    {rep/re1001a.i50} /* tratamento docum-est.char-1 */
    
    for first docum-est fields(cod-estabel char-1)
        where docum-est.serie-docto  = rowObject.serie-docto 
         &if defined(bf-mat-comex) &then
          and docum-est.nro-docto    = integer(rowObject.nro-docto)
         &else
          and docum-est.nro-docto    = rowObject.nro-docto
         &endif
          and docum-est.cod-emitente = rowObject.cod-emitente
          and docum-est.nat-operacao = rowObject.nat-operacao no-lock:
      &if defined(bf-mat-comex) &then 
        assign c-embarque = substring(docum-est.char-1,2,12).
      &else          
        {cdp/cd4300.i4 "yes" docum-est.char-1}
        {rep/re1001a.i51 "yes"}
      &endif
    end.
    
    if not avail docum-est then do:
        assign i-seq-erro = i-seq-erro + 1.
        {utp/ut-liter.i Documento * L}
        create tt-bo-erro.
        assign tt-bo-erro.parametros = trim(return-value).        
        run utp/ut-msgs.p (input "msg":U,
                           input 2,
                           input tt-bo-erro.parametros).
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 2
               tt-bo-erro.mensagem     = return-value.
        RETURN "NOK":U.                       
    end.    
    
    if c-embarque = "" then do:
        for first estabelec fields(pais)
            where estabelec.cod-estabel = docum-est.cod-estabel no-lock:
        end.
        
        for first emitente fields(natureza pais)
            where emitente.cod-emitente = rowObject.cod-emitente no-lock:
          &if defined(bf-mat-comex) &then
            if (emitente.natureza <> "E":U and emitente.natureza <> "T":U) then do:
          &else
            if (emitente.natureza <> 3 and emitente.natureza <> 4) then do:
          &endif
                assign i-seq-erro = i-seq-erro + 1.
                run utp/ut-msgs.p (input "msg":U,
                                   input 19156,
                                   input "").
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 19156
                       tt-bo-erro.mensagem     = return-value.
                RETURN "NOK":U.                   
            end.
            if emitente.pais = estabelec.pais then do:
                assign i-seq-erro = i-seq-erro + 1.
                run utp/ut-msgs.p (input "msg":U,
                                   input 27238,
                                   input "").
                create tt-bo-erro.
                assign tt-bo-erro.i-sequen     = i-seq-erro
                       tt-bo-erro.cd-erro      = 27238
                       tt-bo-erro.mensagem     = return-value.
                RETURN "NOK":U.
            end.
        end.
    end.        
    
    for first natur-oper fields(&if defined(bf-mat-comex) &then log-1 &else nota-rateio &endif)
        where natur-oper.nat-operacao = rowObject.nat-operacao no-lock:
        if &if defined(bf-mat-comex) &then natur-oper.log-1 &else natur-oper.nota-rateio &endif then do:
            assign i-seq-erro = i-seq-erro + 1.
            run utp/ut-msgs.p (input "msg":U,
                               input 15331,
                               input "").
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 15331
                   tt-bo-erro.mensagem     = return-value.
            RETURN "NOK":U.                   
        end.
    end.
    
    if rowObject.cod-emitente-desp = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex dupli-apagar-cex cod-emitente-desp 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 265
               tt-bo-erro.mensagem     = return-value.
        RETURN "NOK":U.               
    end.
    else do:
        find emitente 
            where emitente.cod-emitente = rowObject.cod-emitente-desp no-lock no-error.
        if not avail emitente then do:
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-table.i mgadm emitente 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 2,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 2
                   tt-bo-erro.mensagem     = return-value.
            RETURN "NOK":U.                                                
        end.         
        else do:
          {cdp/cd2502.i}
        end.  
    end.    
    
    if rowObject.parcela = "" or rowObject.parcela = "0" then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-table.i mgcex dupli-apagar-cex parcela 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 3520,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen     = i-seq-erro
               tt-bo-erro.cd-erro      = 3520
               tt-bo-erro.mensagem     = return-value.
        RETURN "NOK":U.               
    end.    

    find first tt-bo-erro
        no-lock no-error.
        
    if  not avail tt-bo-erro then do:
        find first dupli-apagar-cex 
            where dupli-apagar-cex.serie-docto       = rowObject.serie-docto
              and dupli-apagar-cex.nro-docto         = rowObject.nro-docto    
              and dupli-apagar-cex.cod-emitente      = rowObject.cod-emitente 
              and dupli-apagar-cex.nat-operacao      = rowObject.nat-operacao         
              and dupli-apagar-cex.cod-emitente-desp = rowObject.cod-emitente-desp
              and dupli-apagar-cex.parcela           = rowObject.parcela no-lock no-error.
        
        if  avail dupli-apagar-cex then do:        
            assign i-seq-erro = i-seq-erro + 1.
            /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
               pre-processador em chamada de includes */
            {utp/ut-field.i mgcex dupli-apagar-cex nro-docto 1}
            /******************************************/
            run utp/ut-msgs.p (input "msg",
                               input 8,
                               input return-value).
            create tt-bo-erro.
            assign tt-bo-erro.i-sequen     = i-seq-erro
                   tt-bo-erro.cd-erro      = 8
                   tt-bo-erro.mensagem     = return-value.
            RETURN "NOK":U.                   
        end.
    end.
         
    run validateFields. 
 
    find first tt-bo-erro
        no-lock no-error.
 
    if not avail tt-bo-erro then do:
       run executeCreate.
       assign r-chave = to-rowid(return-value).
    end.
    run endMethod("validateCreate":U).
end procedure.
 
procedure validateFields:
    
    find first rowObject no-lock no-error.
 
    run startMethod ("validateFields").    
    
    if rowObject.vl-a-pagar = 0 then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex dupli-apagar-cex vl-a-pagar 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 265
               tt-bo-erro.mensagem = return-value.
        RETURN "NOK":U.               
    end.     
    
    if  not can-find(moeda where moeda.mo-codigo = rowObject.mo-codigo) then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 4929,
                           input rowObject.mo-codigo).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 4929
               tt-bo-erro.mensagem = return-value.
        RETURN "NOK":U.               
    end.    
    
    if  rowObject.vl-a-pagar-mo = 0 or 
        string(rowObject.vl-a-pagar-mo) = " " then do:
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex dupli-apagar-cex vl-a-pagar-mo 1}    
        /******************************************/
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 17527,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 17527
               tt-bo-erro.mensagem = return-value.
        RETURN "NOK":U.               
    end.
    
    if rowObject.desconto <> 0 and rowObject.dt-venc-desc = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex dupli-apagar-cex dt-venc-desc 1}
        /******************************************/
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 265
               tt-bo-erro.mensagem = return-value.
        RETURN "NOK":U.               
    end.
    
    if rowObject.desconto > 100 then do:
        assign i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg",
                           input 6076,
                           input "").
        create tt-bo-erro.
        assign tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 6076.
               tt-bo-erro.mensagem = return-value.
        RETURN "NOK":U.               
    end.

    if  rowObject.dt-emissao = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex dupli-apagar-cex dt-emissao 1}
        /******************************************/
        create tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = TRIM(RETURN-VALUE).
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 265
               tt-bo-erro.mensagem = return-value.
        RETURN "NOK":U.
    end.

    if rowObject.dt-vencim = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex dupli-apagar-cex dt-vencim 1}
        /******************************************/
        create tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = TRIM(RETURN-VALUE).
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 265
               tt-bo-erro.mensagem = return-value.
        RETURN "NOK":U.
    end.

    if rowObject.dt-trans = ? then do:
        assign i-seq-erro = i-seq-erro + 1.
        /* NAO ALTERAR - Distribuicao Magnus nao reconhece 
           pre-processador em chamada de includes */
        {utp/ut-field.i mgcex dupli-apagar-cex dt-trans 1}
        /******************************************/
        create tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = TRIM(RETURN-VALUE).
        run utp/ut-msgs.p (input "msg",
                           input 265,
                           input return-value).
        assign tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 265
               tt-bo-erro.mensagem = return-value.
        RETURN "NOK":U.
    end.

    FIND param-re
        WHERE param-re.usuario = c-usuario NO-LOCK NO-ERROR.

    if  AVAIL param-re
    AND rowObject.dt-emissao < today - param-re.var-emis
    or  rowObject.dt-emissao > today then do:
        ASSIGN i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg":U, 
                           input 614, 
                           INPUT "").
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 614
               tt-bo-erro.mensagem = RETURN-VALUE.
        RETURN "NOK":U.
    end.

    if rowObject.dt-emissao > rowObject.dt-vencim then do:
        ASSIGN i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg":U, 
                           input 1031, 
                           INPUT "").
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 1031
               tt-bo-erro.mensagem = RETURN-VALUE.
        RETURN "NOK":U.
    end.

    if  rowObject.dt-trans > today
    or  rowObject.dt-trans < rowObject.dt-emissao then do:
        ASSIGN i-seq-erro = i-seq-erro + 1.
        run utp/ut-msgs.p (input "msg":U,
                           input 1788,
                           INPUT "").
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 1788
               tt-bo-erro.mensagem = RETURN-VALUE.
        RETURN "NOK":U.
    end.

    FIND FIRST param-ap NO-LOCK NO-ERROR.
    if  avail param-ap
    and rowObject.dt-vencim < param-ap.dt-ult-fec
    then do:
        ASSIGN i-seq-erro = i-seq-erro + 1.
        CREATE tt-bo-erro.
        ASSIGN tt-bo-erro.parametros = string(rowObject.dt-vencim) + "~~" + STRING(param-ap.dt-ult-fec).
        run utp/ut-msgs.p (input "show":U,
                           input 633,
                           INPUT tt-bo-erro.parametros).
        ASSIGN tt-bo-erro.i-sequen = i-seq-erro
               tt-bo-erro.cd-erro  = 633
               tt-bo-erro.mensagem = RETURN-VALUE.
        RETURN "NOK":U.
    end.
     
    run endMethod ("validateFields").
end procedure.


PROCEDURE setUsuario:
    DEF INPUT PARAMETER p-usuario LIKE param-re.usuario NO-UNDO.

    ASSIGN c-usuario = p-usuario.
END PROCEDURE.


procedure getCharField:
    define input parameter c-field as char.
    define output parameter c-value as char.
	
    case c-field:
        when "serie-docto" then c-value = RowObject.serie-docto.                
        when "parcela" then c-value = RowObject.parcela.
        when "nat-operacao" then c-value = RowObject.nat-operacao.
        when "nr-duplic" then c-value = RowObject.nr-duplic.
        when "observacao" then c-value = RowObject.observacao.
        when "historico" then c-value = RowObject.historico.
        when "esp-irf" then c-value = RowObject.esp-irf.
        when "cod-imp-irf" then c-value = RowObject.cod-imp-irf.
        when "char-1" then c-value = RowObject.char-1.
        when "char-2" then c-value = RowObject.char-2.
        when "check-sum" then c-value = RowObject.check-sum.
        otherwise return error.
    end case.
end procedure.
 
procedure getDecField:
    define input  parameter c-field as char.
    define output parameter c-value as decimal.
 
    case c-field:
        when "vl-a-pagar" then c-value = RowObject.vl-a-pagar.
        when "desconto" then c-value = RowObject.desconto.
        when "vl-desconto" then c-value = RowObject.vl-desconto.
        when "vl-ap-fasb[1]" then c-value = RowObject.vl-ap-fasb[1].
        when "vl-ap-fasb[2]" then c-value = RowObject.vl-ap-fasb[2].
        when "perc-juros" then c-value = RowObject.perc-juros.
        when "perc-mora" then c-value = RowObject.perc-mora.
        when "aliq-irf" then c-value = RowObject.aliq-irf.
        when "imposto-ir" then c-value = RowObject.imposto-ir.
        when "imposto-iss" then c-value = RowObject.imposto-iss.
        when "imposto-inss" then c-value = RowObject.imposto-inss.
        when "vl-taxa" then c-value = RowObject.vl-taxa.
        when "vl-frete" then c-value = RowObject.vl-frete.
        when "vl-outros" then c-value = RowObject.vl-outros.
        when "valor-a-pagar-me" then c-value = RowObject.valor-a-pagar-me.
        when "vl-a-pagar-mo" then c-value = RowObject.vl-a-pagar-mo.        
        when "dec-1" then c-value = RowObject.dec-1.
        when "dec-2" then c-value = RowObject.dec-2.
        otherwise return error.
    end case.
end procedure.

procedure getIntField:
    define input  parameter c-field as char.
    define output parameter c-value as integer.
 
    case c-field:
        when "cod-emitente" then c-value = RowObject.cod-emitente.
        when "cod-emitente-desp" then c-value = RowObject.cod-emitente-desp.
        when "esp-movto" then c-value = RowObject.esp-movto.
        when "estado-cq" then c-value = RowObject.estado-cq.
        when "dias-atraso" then c-value = RowObject.dias-atraso.
        when "ep-codigo" then c-value = RowObject.ep-codigo.
        when "tp-despesa" then c-value = RowObject.tp-despesa.
        when "cod-ret-irf" then c-value = RowObject.cod-ret-irf.
        when "dia-util-irf" then c-value = RowObject.dia-util-irf.
        when "mo-codigo" then c-value = RowObject.mo-codigo.        
        when "int-1" then c-value = RowObject.int-1.
        when "int-2" then c-value = RowObject.int-2.                
        otherwise return error.
    end case.
end procedure.
 
procedure getDateField:
    define input  parameter c-field as char.
    define output parameter c-value as date.
 
    case c-field:
        when "dt-emissao" then c-value = RowObject.dt-emissao.
        when "dt-trans" then c-value = RowObject.dt-trans.
        when "dt-vencim" then c-value = RowObject.dt-vencim.
        when "dt-venc-desc" then c-value = RowObject.dt-venc-desc.
        when "data-1" then c-value = RowObject.data-1.
        when "data-2" then c-value = RowObject.data-2.        
        otherwise return error.
    end case.
end procedure.

procedure getLogField:
    define input  parameter c-field as char.
    define output parameter c-value as logical.
 
    case c-field:
        when "log-1" then c-value = RowObject.log-1.
        when "log-2" then c-value = RowObject.log-2.        
        otherwise return error.
    end case.
end procedure.
