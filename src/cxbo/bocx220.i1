def var c-idioma       like processo-imp.cod-idioma  no-undo.
def var de-unit        like cotacao-item.preco-unit  no-undo.
def var i-cod-emitente like emitente.cod-emitente    no-undo.
def var c-est-ini      like estabelec.cod-estabel    no-undo.
def var c-est-fim      like estabelec.cod-estabel    no-undo.
def var c-embarque-ini like embarque-imp.embarque    no-undo.
def var c-embarque-fim like embarque-imp.embarque    no-undo.
def var c-ordem        as char                       no-undo.
def var r-chave        as rowid                      no-undo.
def var c-meio-transp  as char format "x(20)"        no-undo.
def var h-boad355      as handle no-undo.
def var h-boin682      as handle no-undo.
def var v-pagar        as char no-undo.
