DEFINE BUFFER b-embarque-imp  FOR embarque-imp.
define buffer bf-embarque-imp for embarque-imp.

procedure setConstraint1:
end procedure. 

procedure setConstraint2:
    def input parameter p-cod      like estabelec.cod-estabel no-undo.
    def input parameter p-embarque like embarque-imp.embarque no-undo.

    assign c-cod-estabel = p-cod
           c-embarque    = p-embarque.
end procedure.

procedure setConstraint3:
    def input parameter p-est-ini      like estabelec.cod-estabel no-undo.
    def input parameter p-est-fim      like estabelec.cod-estabel no-undo.
    def input parameter p-embarque-ini like embarque-imp.embarque no-undo.
    def input parameter p-embarque-fim like embarque-imp.embarque no-undo.

    assign c-est-ini      = p-est-ini
           c-est-fim      = p-est-fim
           c-embarque-ini = p-embarque-ini
           c-embarque-fim = p-embarque-fim.

end procedure.

procedure setConstraint7:
    def input parameter p-meio-transp  as char format "x(20)" no-undo.

    assign c-meio-transp = p-meio-transp.

end procedure.

procedure setConstraint8:
     define input parameter p-c-cod-estabel      like estabelec.cod-estabel          no-undo.
     define input parameter p-c-decl-import-ini  like embarque-imp.declaracao-import no-undo.
     define input parameter p-c-decl-import-fim  like embarque-imp.declaracao-import no-undo.
     define input parameter p-c-embarque-ini     like embarque-imp.embarque          no-undo.
     define input parameter p-c-embarque-fim     like embarque-imp.embarque          no-undo.
     

     assign c-cod-estabel     = p-c-cod-estabel
            c-decl-import-ini = p-c-decl-import-ini
            c-decl-import-fim = p-c-decl-import-fim
            c-embarque-ini    = p-c-embarque-ini   
            c-embarque-fim    = p-c-embarque-fim.
     
end procedure.

procedure setConstraint9:
     define input parameter p-c-declaracao-import like embarque-imp.declaracao-import no-undo.

     assign c-declaracao-import = p-c-declaracao-import.
     
end procedure.
procedure openQuery:
    define input parameter i-abertura as integer no-undo.
    case i-abertura:
        when 1 then 
            open query {&QUERY-NAME} for each embarque-imp no-lock.
        when 2 then 
            open query {&QUERY-NAME} for each embarque-imp no-lock 
                where embarque-imp.cod-estabel >= c-cod-estabel 
                  and embarque-imp.embarque    >= c-embarque.
        when 3 then 
            open query {&QUERY-NAME} for each embarque-imp no-lock 
                where embarque-imp.cod-estabel >= c-est-ini      
                  and embarque-imp.cod-estabel <= c-est-fim      
                  and embarque-imp.embarque    >= c-embarque-ini 
                  and embarque-imp.embarque    <= c-embarque-fim by embarque-imp.embarque.
        when 4 then 
            open query {&QUERY-NAME} for each embarque-imp no-lock 
                where embarque-imp.cod-estabel >= c-est-ini      
                  and embarque-imp.cod-estabel <= c-est-fim      
                  and embarque-imp.embarque    >= c-embarque-ini 
                  and embarque-imp.embarque    <= c-embarque-fim by embarque-imp.cod-estabel.
        when 5 then 
            open query {&QUERY-NAME} for each embarque-imp no-lock 
                where embarque-imp.cod-estabel >= c-est-ini      
                  and embarque-imp.cod-estabel <= c-est-fim      
                  and embarque-imp.embarque    >= c-embarque-ini 
                  and embarque-imp.embarque    <= c-embarque-fim by embarque-imp.embarque.
        when 6 then 
            open query {&QUERY-NAME} for each embarque-imp no-lock 
                where embarque-imp.cod-estabel >= c-est-ini      
                  and embarque-imp.cod-estabel <= c-est-fim      
                  and embarque-imp.embarque    >= c-embarque-ini 
                  and embarque-imp.embarque    <= c-embarque-fim by embarque-imp.cod-estabel.
        when 7 then 
            open query {&QUERY-NAME} for each embarque-imp no-lock 
                where embarque-imp.situacao = 1
                  and substr(embarque-imp.char-1,1,20) = c-meio-transp.
        when 8 then
            open query {&QUERY-NAME} for each embarque-imp no-lock 
                where embarque-imp.cod-estabel       = c-cod-estabel
                  and embarque-imp.declaracao-import <> ""
                  and embarque-imp.declaracao-import >= c-decl-import-ini
                  and embarque-imp.declaracao-import <= c-decl-import-fim
                  and embarque-imp.embarque          >= c-embarque-ini   
                  and embarque-imp.embarque          <= c-embarque-fim   
                by embarque-imp.declaracao-import
                by embarque-imp.cod-estabel
                by embarque-imp.embarque.
        when 9 then
            open query {&QUERY-NAME} for each embarque-imp no-lock 
                where embarque-imp.declaracao-import <> ""
                  and embarque-imp.declaracao-import  = c-declaracao-import
                by embarque-imp.declaracao-import
                by embarque-imp.cod-estabel
                by embarque-imp.embarque.                
    end case.
    assign l-query    = true
           i-bo-query = i-abertura.
end procedure.

