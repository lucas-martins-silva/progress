/************************************************************** 
* AF0502.i1 ImpressÆo das notas
*
**************************************************************/

VIEW FRAME f-cabec.
VIEW FRAME f-rodape.

FOR EACH tt-notas where
         tt-notas.tipo = "TF"
   break by tt-notas.cod-estabel
         by tt-notas.dt-indice-fim
         {1}
         {2}:
         
    if first-of(tt-notas.dt-indice-fim) or
       first-of(tt-notas.cod-estabel) then do:
       for first estabelec fields(nome)
           where estabelec.cod-estabel = tt-notas.cod-estabel no-lock: end.
       if tt-param.l-salta-pagina-per-est and line-counter > 5  then
          page.
       if line-counter > 6 then
         put skip(1).
       assign c-dt-indice-ini = string(month(tt-notas.dt-indice-ini),"99") + string(year(tt-notas.dt-indice-ini),"9999")
              c-dt-indice-fim = string(month(tt-notas.dt-indice-fim),"99") + string(year(tt-notas.dt-indice-fim),"9999").
       disp tt-notas.cod-estabel
            estabelec.nome when avail estabelec
            c-dt-indice-ini
            c-dt-indice-fim
            tt-notas.ano-avaliacao
            tt-notas.des-periodo-aval
            with frame f-est-per.
            down with frame f-est-per.
       put skip(1).
    end.

    disp tt-notas.cod-emitente
         tt-notas.nome-emit
         tt-notas.nota with frame f-forn.
    down with frame f-forn.

    if tt-param.l-detalha-controle-fornecedor or
       tt-param.l-detalha-itens or
       tt-param.l-detalha-controle-item then
       put skip(1).
       
    
    /* Detalhamento dos pontos de controle do fornecedor*/
    if tt-param.l-detalha-controle-fornecedor then do:
        for each b-tt-notas
           where b-tt-notas.dt-indice-fim = tt-notas.dt-indice-fim
             and b-tt-notas.cod-estabel = tt-notas.cod-estabel
             and b-tt-notas.cod-emitente = tt-notas.cod-emitente
             and b-tt-notas.tipo = "DF":
            disp b-tt-notas.nr-controle @ tt-notas.nr-controle
                 b-tt-notas.descricao   @ tt-notas.descricao
                 b-tt-notas.cod-grp-resp @ tt-notas.cod-grp-resp 
                 b-tt-notas.usuar-alter @ tt-notas.usuar-alter 
                 b-tt-notas.indice @ tt-notas.indice
                 b-tt-notas.percentual @ tt-notas.percentual
                 b-tt-notas.nota @ tt-notas.nota
                 with frame f-forn-contr.
            down with frame f-forn-contr.
        end.
        put skip(1).
    end.
    /* Itens dos pontos de controle do fornecedor */
    if tt-param.l-detalha-itens then do:
        for each b-tt-notas
           where b-tt-notas.dt-indice-fim = tt-notas.dt-indice-fim
             and b-tt-notas.cod-estabel = tt-notas.cod-estabel
             and b-tt-notas.cod-emitente = tt-notas.cod-emitente
             and b-tt-notas.tipo = "TI":
            disp b-tt-notas.it-codigo @ tt-notas.it-codigo
                 b-tt-notas.desc-item @ tt-notas.desc-item
                 b-tt-notas.nota @ tt-notas.nota
                 with frame f-forn-item.
            down with frame f-forn-item.
            
        
            /* Öndices detalhados */
            if tt-param.l-detalha-controle-item then do:
                put skip(1).
                for each b1-tt-notas
                   where b1-tt-notas.dt-indice-fim = b-tt-notas.dt-indice-fim
                     and b1-tt-notas.cod-estabel = b-tt-notas.cod-estabel
                     and b1-tt-notas.cod-emitente = b-tt-notas.cod-emitente
                     and b1-tt-notas.it-codigo = b-tt-notas.it-codigo
                     and b1-tt-notas.tipo = "DE":
                    disp b1-tt-notas.nr-controle @ tt-notas.nr-controle
                         b1-tt-notas.descricao   @ tt-notas.descricao
                         b1-tt-notas.cod-grp-resp @ tt-notas.cod-grp-resp 
                         b1-tt-notas.usuar-alter @ tt-notas.usuar-alter 
                         b1-tt-notas.indice @ tt-notas.indice
                         b1-tt-notas.percentual @ tt-notas.percentual
                         b1-tt-notas.nota @ tt-notas.nota
                         with frame f-detalhe.
                    down with frame f-detalhe.
                    
                    if l-detalha-documentos then do:
                       run pi-detalha-documentos.
                    end.
                    
                end.
                put skip(1).
            end.
         end.
        put skip(1).
    end.
    
    if tt-param.l-salta-pagina-forn then
       page.
end.
