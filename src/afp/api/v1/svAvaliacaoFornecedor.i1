DEFINE TEMP-TABLE tt-notas
    FIELD cod-estabel      like af-contr-indice.cod-estabel                                    COLUMN-LABEL "Codigo estabelecimento"
    FIELD cod-emitente     like af-contr-indice.cod-emitente                                   COLUMN-LABEL "Codigo emitente"
    FIELD it-codigo        like af-contr-indice.it-codigo                                      COLUMN-LABEL "Codigo item"
    FIELD nr-controle      like af-contr-indice.nr-controle                                    COLUMN-LABEL "N£mero cotrole"
    FIELD dt-indice        like af-contr-indice.dt-indice                                      COLUMN-LABEL "Data indice"
    FIELD dt-indice-ini    like af-periodo-aval.dt-periodo-ini[1]                              COLUMN-LABEL "Data inicio"      
    FIELD dt-indice-fim    like af-periodo-aval.dt-periodo-fim[1]                              COLUMN-LABEL "Data final"        
    FIELD ano-avaliacao    like af-periodo-aval.ano-avaliacao                                  COLUMN-LABEL "Ano"               
    FIELD des-periodo-aval LIKE af-periodo-aval.des-periodo-aval[1]                            COLUMN-LABEL "Per¡odo"  
    FIELD cod-grp-resp     like af-item-contr-estab-form.cod-grp-resp                          COLUMN-LABEL "Grupo Respons vel"
    FIELD fm-codigo        like item.fm-codigo                                                 COLUMN-LABEL "C¢digo familia"
    FIELD ge-codigo        like item.ge-codigo                                                 COLUMN-LABEL "Grupo Estoque"
    FIELD cod-gr-forn      like emitente.cod-gr-forn                                           COLUMN-LABEL "Grupo"
    FIELD indice           as   dec                                                            COLUMN-LABEL "Öndice"
    FIELD percentual       as   dec                                                            COLUMN-LABEL "Percentual"
    FIELD nota             as   dec                                                            COLUMN-LABEL "Nota"
    FIELD tipo             as   char                                                           COLUMN-LABEL "Tipo"
    FIELD nome-abrev       like emitente.nome-abrev                                            COLUMN-LABEL "Nome emitente abreviado"
    FIELD nome-emit        like emitente.nome-emit                                             COLUMN-LABEL "Nome emitente"
    FIELD desc-item        like item.desc-item                                                 COLUMN-LABEL "Descri‡Æo do item"
    FIELD usuar-alter      like af-contr-indice.usuar-alter                                    COLUMN-LABEL "Usu rio Altera‡Æo"
    FIELD descricao        like af-controle.descricao                                          COLUMN-LABEL "Descri‡Æo do ponto de controle"
    FIELD narrativa        like af-contr-indice.narrativa                                      COLUMN-LABEL "Narrativa"
    FIELD movimento        LIKE af-contr-indice.movimento                                      COLUMN-LABEL "Movimentos".
