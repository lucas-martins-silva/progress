define temp-table tt-param no-undo
    field destino             as integer
    field arquivo             as char format "x(35)":U
    field usuario             as char format "x(12)":U
    field data-exec           as date
    field hora-exec           as integer
    FIELD lParam              AS LOGICAL
    FIELD lGeraExcel          AS LOGICAL
    FIELD arquivoExcel        as char format "x(35)":U
    FIELD ep-codigo           LIKE mab-eqpto.ep-codigo
    FIELD cod-eqpto           LIKE mab-eqpto.cod-eqpto
    FIELD data-ini            as date    format "99/99/9999"
    FIELD data-fim            as date    format "99/99/9999"
    FIELD hora-ini            as char    format "99:99:99"
    FIELD hora-fim            as char    format "99:99:99"
    FIELD docto-ini           LIKE mmv-ord-manut.nr-ord-produ
    FIELD docto-fim           LIKE mmv-ord-manut.nr-ord-produ.

DEFINE TEMP-TABLE tt-digita NO-UNDO 
    LIKE mab-movto-km-eqpto.

def temp-table tt-raw-digita
   field raw-digita      as raw.
