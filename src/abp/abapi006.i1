/** Parƒmetros **/
define temp-table tt-param no-undo
    field destino      as integer
    field arquivo      as char format "x(35)":U
    field usuario      as char format "x(12)":U
    field data-exec    as date
    field hora-exec    as integer
    field iAcao        as integer   /** 1 = Cria‡Æo / 2 = Elimina‡Æo **/
    field dataIni      as date format "99/99/9999"
    field dataFim      as date format "99/99/9999"
    field docIni       like mab-movto-event.num-docto
    field docFim       like mab-movto-event.num-docto
    field empIni       like mab-movto-event.ep-codigo
    field empFim       like mab-movto-event.ep-codigo
    field eqptoIni     like mab-movto-event.cod-eqpto
    field eqptoFim     like mab-movto-event.cod-eqpto
    field eventIni     like mab-movto-event.cod-evento
    field eventFim     like mab-movto-event.cod-evento
    field subIni       like mab-movto-event.cod-sub-sist
    field subFim       like mab-movto-event.cod-sub-sist
    field lresumo      as logical
    field lInferior    as logical
    field lVencido     as logical
    field lVencer      as logical
    &IF DEFINED(bf_mnt_ems206b) &THEN
    FIELD unidNegocIni AS CHAR FORMAT "x(3)"
    FIELD unidNegocFim AS CHAR FORMAT "x(3)"
    &ENDIF
    .
    
/*****************************************************************************/
                                                         /** Fim da Include **/


