                                                /** Defini‡Æo de Vari veis **/
DEFINE VARIABLE c-liter-imp     AS CHARACTER FORMAT "x(14)" NO-UNDO.
DEFINE VARIABLE c-destino       AS CHARACTER FORMAT "x(09)" NO-UNDO.
DEFINE VARIABLE c-fora          AS CHARACTER FORMAT "x(01)" NO-UNDO.
DEFINE VARIABLE c-fora-sec      AS CHARACTER FORMAT "x(01)" NO-UNDO.
DEFINE VARIABLE c-desc-cont-sec AS CHARACTER FORMAT "x(25)" NO-UNDO.
DEFINE VARIABLE l-nivelItem     AS LOGICAL                  NO-UNDO.

/*****************************************************************************/
                                                     /** Form de Parƒmetros **/

form   /*IMPRESSÇO*/
       skip
       c-liter-imp              AT 09    no-label
       skip
       c-destino                COLON 30 " - " tt-param.arquivo NO-LABEL
       tt-param.usuario         COLON 30
       skip
       with width 132 side-labels frame f-param-definidos stream-io.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-param-definidos:HANDLE).

/*****************************************************************************/
                                                              /** ImpressÆo **/
form tt-param.dtIni   AT 26 " |<   >| " 
     tt-param.dtFim   no-label
     with NO-BOX width 132 side-labels frame f-periodo stream-io.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-periodo:HANDLE).

                                                                   
form tt-digita.cod-oficial   AT 20 " - " 
     tt-digita.desc-dimensao no-label
     with NO-BOX width 132 side-labels frame f-visoes stream-io.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-visoes:HANDLE).

     
form bfDigita.cod-oficial
     bfDigita.desc-dimensao    format "x(26)"
     bfDigita.qtd-combustivel
     bfDigita.val-percurso
     bfDigita.val-real
     c-fora                    no-label
     bfDigita.val-padrao
     bfDigita.relacao          no-label
     bfDigita.de-desvio
     with width 132 no-attr-space no-box down frame f-dados stream-io.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-dados:HANDLE).

form bfDigita.cod-oficial
     bfDigita.desc-dimensao    format "x(26)"
     bfDigita.qtd-combustivel
     with width 132 no-attr-space no-box down frame f-dadosVisaoItem stream-io.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-dados:HANDLE).
     
form bfDigita.cod-oficial
     bfDigita.desc-dimensao    format "x(26)"
     with width 132 no-attr-space no-box down frame f-dados-2 stream-io.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-dados-2:HANDLE).

     
form c-desc-cont-sec           no-label format "x(25)" at 40
     bfDigita.val-percurso-sec no-label
     bfDigita.val-real-sec     no-label
     c-fora-sec                no-label
     bfDigita.val-padrao-sec   no-label
     bfDigita.relacao-sec      no-label
     bfDigita.de-desvio-sec    no-label
     with width 132 no-attr-space no-box no-label down frame f-dados-sec stream-io.
run utp/ut-trfrrp.p (input frame f-dados-sec:handle).      

/*****************************************************************************/
                                               /** Literais Form Parƒmetros **/
{utp/ut-liter.i Usu rio * l}
assign tt-param.usuario:label in frame f-param-definidos = trim(return-value).

{utp/ut-liter.i Destino * l}
assign c-destino:label in frame f-param-definidos = trim(return-value).

{utp/ut-liter.i IMPRESSÇO * R}
assign c-liter-imp = trim(return-value).

/*****************************************************************************/
                                                    /** Literais Form Dados **/
{utp/ut-liter.i Descri‡Æo}
assign bfDigita.desc-dimensao:label in frame f-dados = return-value.
{utp/ut-liter.i Descri‡Æo}
assign bfDigita.desc-dimensao:label in frame f-dados-2 = return-value.
{utp/ut-liter.i "    Combust¡vel"}
assign bfDigita.qtd-combustivel:label in frame f-dados = return-value.
{utp/ut-liter.i "    Percurso" MAB}
assign bfDigita.val-percurso:label in frame f-dados = return-value.
{utp/ut-liter.i "    Real"}
assign bfDigita.val-real:label in frame f-dados = return-value.
{utp/ut-liter.i "    PadrÆo"}
assign bfDigita.val-padrao:label in frame f-dados = return-value.
{utp/ut-liter.i "% Desvio"}
assign bfDigita.de-desvio:label in frame f-dados = trim(return-value).
{utp/ut-liter.i Contador_Secund rio * }
assign c-desc-cont-sec = trim(return-value) + fill(".",(24 - length(trim(return-value)))) + ":".

{utp/ut-liter.i Per¡odo}
assign tt-param.dtIni:label in frame f-periodo = trim(return-value).
       

/*****************************************************************************/
                                                         /** Fim da Include **/
