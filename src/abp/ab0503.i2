/********************************************************************************
**
**  Include: abp/ab0503.i2
**
**  Imprime Relat¢rio por Documento
**
********************************************************************************/
procedure pi-documento:

 disp cDocto     
   cTpApont        
   cData           
   cHora           
   cPstOrig        
   cBomba          
   cMaterial       
   cValIni-1      
   cValFim-1     
   cQtde-1         
   cPstDest        
    with frame f-cabecalho-1 page-top top-only.


for each mab-control-bomba
   WHERE mab-control-bomba.num-docto             >=  tt-param.i-docto-ini
    and  mab-control-bomba.num-docto             <=  tt-param.i-docto-fim
    and  mab-control-bomba.dat-apont             >=  tt-param.d-data-ini
    and  mab-control-bomba.dat-apont             <=  tt-param.d-data-fim
    and  mab-control-bomba.hra-apont             >=  tt-param.c-hora-ini
    and  mab-control-bomba.hra-apont             <=  tt-param.c-hora-fim
    and  mab-control-bomba.cod-posto-orig        >=   tt-param.c-posto-ini
    and  mab-control-bomba.cod-posto-orig        <=   tt-param.c-posto-fim
    and  (( mab-control-bomba.idi-tip-movto       = 1 and l-afericoes) 
     or  ( mab-control-bomba.idi-tip-movto        = 2 and l-transf   )
     or  ( mab-control-bomba.idi-tip-movto        = 3 and l-leitura  ))no-lock
                             break by mab-control-bomba.num-docto
                                   by mab-control-bomba.idi-tip-movto:
                             
    for first mab-bomba
       where mab-bomba.cod-bomba = mab-control-bomba.cod-bomba
       and   mab-bomba.cod-posto = mab-control-bomba.cod-posto-orig,
       first mab-tip-mater
             where mab-tip-mater.cod-tip-mater = mab-bomba.cod-tip-mater no-lock:
    end.
    
    if not avail mab-tip-mater then next.
    assign   cApont      = {frinc/i00fr056.i 4  mab-control-bomba.idi-tip-movto}.
                             

           disp  mab-control-bomba.num-docto              NO-LABEL  FORMAT ">>>>>>>9" 
                 cApont                                   NO-LABEL  format "x(16)"     
                 mab-control-bomba.dat-apont              NO-LABEL                     
                 mab-control-bomba.hra-apont              NO-LABEL  FORMAT "99:99"     
                 mab-control-bomba.cod-posto-orig         NO-LABEL                     
                 mab-control-bomba.cod-bomba              NO-LABEL  FORMAT "X(08)"     
                 mab-tip-mater.des-tip-mater              NO-LABEL  format "x(16)"     
                 mab-control-bomba.val-leitura-inicial    NO-LABEL                     
                 mab-control-bomba.val-leitura-final      NO-LABEL                    
                 mab-control-bomba.val-quant              NO-LABEL  
                 mab-control-bomba.cod-posto-dest         NO-LABEL  format "x(07)"                   
                 with frame f-dados-1.
                        down with frame f-dados-1.   
                              

           
                   
end.     

return 'OK'.

end procedure.
/* FIM */
