define temp-table tt-param no-undo
  field destino                    as integer
  field arquivo                    as character format "x(35)"
  field usuario                    as character format "x(12)"
  field data-exec                  as date
  field hora-exec                  as integer
  field todos                      as integer  /** 1 = Todos / 2 = Rejeitados **/
  field execucao                   as integer
  field arq-destino                as character format "x(80)"
  /** Exporta‡Æo **/
  field dest-exportacao            as integer
  field dir-entrada                as character format "x(80)"
  field gera-cabecalho             as logical
  /** NOP - Estabelecimento **/
  field l-de-para                  as logical
  field arq-estabel                as character format "x(80)"
  /*pag 1*/
  field l-tab-unidade              AS logical
  field l-tag                      AS logical
&IF "{&mguni_version}" >= "2.071" &THEN
    field c-estab-tag            AS CHAR FORMAT "X(05)":U
&ELSE
    field c-estab-tag            AS CHAR FORMAT "X(3)":U
&ENDIF
  field c-cc-tag                   AS character FORMAT "X(20)":U
  FIELD c-depos                    AS CHARACTER FORMAT "x(10)":U
  FIELD c-empresa                  AS CHARACTER FORMAT "x(10)":U
  FIELD c-grp-event                AS CHARACTER FORMAT "x(10)":U
  FIELD c-sub-sist                 AS CHARACTER FORMAT "x(10)":U
  FIELD c-tip-mater                AS CHARACTER FORMAT "x(10)":U
  field l-mab-marca                AS logical
  field l-mab-model                AS logical
  field l-mab-consu-model          AS logical
  field l-mmv-tempo-padr           AS logical
  field l-mab-ativid               AS logical
  field l-mab-trajeto              AS logical
  FIELD l-mab-caract               AS logical
  FIELD l-mab-comptmento           AS logical
  FIELD l-mab-estrut-mec           AS logical
  field l-mab-sist                 AS logical 
  field l-mab-sub-sist             AS logical 
  field l-mab-sit-eqpto            AS logical 
  field l-mab-grp-eqpto            AS logical 
  field l-mab-eqpto-sub-sist       AS logical 
  field l-mab-posto                AS logical 
  field l-mab-bomba                AS logical 
  field l-mab-tip-mater            AS logical 
  field l-mab-tip-mater-item       AS logical 
  field l-mab-grp-event            AS logical 
  field l-mab-event                AS logical 
  FIELD l-mab-motoris              AS logical
  FIELD l-mab-motoris-model        AS logical
  FIELD l-mab-integr-cargo         AS logical
  /*pag 2*/
  field l-mmv-ofici                AS logical 
  field l-mmv-setor-ofici          AS logical 
  field l-mmv-func-ofici           AS logical 
  field l-mmv-plano-prevent        AS logical 
  field l-mmv-tar-plano            AS logical 
  field l-mmv-tar-plano-item       AS logical 
  FIELD c-cod-ofic                 AS CHARACTER FORMAT "x(10)":U
  FIELD c-cod-cc                   AS CHARACTER FORMAT "x(20)":U
  FIELD c-cod-event                AS CHARACTER FORMAT "x(10)":U
  FIELD c-sub-sist2                AS CHARACTER FORMAT "x(10)":U
  FIELD c-cod-posto                AS CHARACTER FORMAT "x(10)":U
  FIELD c-cod-calend               AS CHARACTER FORMAT "x(9)":U
  field i-cd-tipo                  as integer 
  /*pag 3*/      
  field l-mpn-param                AS logical 
  field l-mpn-tip-borracha         AS logical 
  field l-mpn-medid                AS logical 
  field l-mpn-pos-pneu             AS logical 
  field l-mpn-layout               AS logical 
  field l-mpn-layout-eixo-pos      AS logical 
  field l-mpn-ambien-trab          AS logical 
  field l-mpn-serv                 AS logical  
  field l-mpn-tip-serv             AS logical  
  field l-mpn-desen                AS logical  
  FIELD l-mpn-km-esperad           AS logical  
  field l-mpn-model                AS logical 
  field l-mpn-pneu                 AS logical 
  field l-mpn-histor-vida          AS logical 
  FIELD c-evento                   AS CHARACTER FORMAT "x(10)":U
  FIELD c-sit-eqpto                AS CHARACTER FORMAT "x(10)":U
  FIELD c-causa                    AS CHARACTER FORMAT "x(10)":U
  FIELD c-it-codigo                AS CHARACTER FORMAT "x(10)":U
  FIELD c-sub-sist3                AS CHARACTER FORMAT "x(10)":U
  FIELD c-cod-serv                 AS CHARACTER FORMAT "x(10)":U 
  FIELD c-cod-medida2              AS CHARACTER FORMAT "x(10)":U
  field c-cod-empr2                like mab-eqpto.ep-codigo
  field i-km-vida-pneu             as integer  /** 1 = Atualiza‡Æo Normal, 2 = Atualiza Somente Quilometragem **/
  /*pag 4*/                    
  field l-mco-compon               AS logical 
  field l-mco-histor-vida          AS logical 
  FIELD c-cod-emitente             AS CHARACTER FORMAT "x(10)":U
  FIELD c-cc-codigo-compon         AS CHARACTER FORMAT "x(20)":U
  field i-km-vida-comp             as integer  /** 1 = Atualiza‡Æo Normal, 2 = Atualiza Somente Quilometragem **/
  /*pag 5*/                  
  field l-mab-eqpto                AS logical
  field l-mab-histor-ativid        AS logical 
  field l-mab-histor-combust       AS logical 
  field l-mab-comptmento-eqpto     AS logical 
  field l-mab-period-manut         AS logical 
  field l-mab-configur-eixo        AS logical 
  field l-mmv-eqpto-plano          AS logical 
  FIELD l-mpn-histor-layout-eixo   AS logical 
  FIELD c-sub-sist-oleo            AS CHARACTER FORMAT "x(10)":U
  FIELD c-sub-sist-filtro          AS CHARACTER FORMAT "x(10)":U  
  FIELD c-cod-cidade               AS CHARACTER FORMAT "x(50)":U
  FIELD c-cod-estado               AS CHARACTER FORMAT "x(10)":U
  FIELD c-cod-pais                 AS CHARACTER FORMAT "x(20)":U
  field l-mab-grp-eqpto-sub-sist   as logical
  field i-km-eqpto                 as integer  /** 1 = Atualiza‡Æo Normal, 2 = Atualiza Somente Quilometragem **/
  .


define new global shared temp-table tt-estabelec no-undo
  field cod-nop     as char 
  field cod-estabel like estabelec.cod-estabel.
