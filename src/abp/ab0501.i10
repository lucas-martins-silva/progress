/********************************************************************************
**
**  Include: abp/ab0501.i10
**
**  Imprime Relat¢rio por Equipamentos
**
**  Autor: Carlos Valentini
**
********************************************************************************/
procedure pi-unid-negoc:
&IF "{&mguni_version}" >= "2.071" &THEN
def variable iEmp   like empresa.ep-codigo no-undo.
&ELSE
def variable iEmp   as integer no-undo.
&ENDIF
def var cEqpto           as char                 no-undo.
def var l-mostrou-cab    as logical initial no   no-undo.
def var l-primeiro-resu  as logical initial yes  no-undo.
def var l-primeiro-detal as logical initial yes  no-undo.
def var cUnidNegoc       as char    initial ""   no-undo.

assign iEmp   = ?
       cEqpto = "":U.

for each mab-eqpto  fields (cod-eqpto ep-codigo cod-grp-eqpto cod-model cod-estabel cd-tag cod-emitente cod-estrut-mec cc-codigo cod-unid-negoc
                           cod-sit-eqpto vli-ano-fabric idi-tip-eqpto idi-tip-propriet cod-chassi cod-placa val-hodom-horim-inicial mab-eqpto.val-hodom-horim-sec
                           mab-eqpto.log-cont-sec mab-eqpto.vli-ano-model cod-emitente dat-situacao dat-compra dat-inicial val-compra cod-renavam bm-codigo bm-indice mab-eqpto.val-km-sec mab-eqpto.val-km-inicial) 
   WHERE  mab-eqpto.ep-codigo             >= tt-param.i-cod-emp-ini   
    and   mab-eqpto.ep-codigo             <= tt-param.i-cod-emp-fim   
    and   mab-eqpto.cod-eqpto             >= tt-param.c-cod-eqpto-ini 
    and   mab-eqpto.cod-eqpto             <= tt-param.c-cod-eqpto-fim 
    and   mab-eqpto.cod-grp-eqpto         >= tt-param.c-grupo-ini     
    and   mab-eqpto.cod-grp-eqpto         <= tt-param.c-grupo-fim     
    and   mab-eqpto.cod-model             >= tt-param.c-modelo-ini    
    and   mab-eqpto.cod-model             <= tt-param.c-modelo-fim    
    and   mab-eqpto.cod-estabel           >= tt-param.c-estab-ini     
    and   mab-eqpto.cod-estabel           <= tt-param.c-estab-fim     
    and   mab-eqpto.cd-tag                >= tt-param.c-tag-ini       
    and   mab-eqpto.cd-tag                <= tt-param.c-tag-fim      
    and   mab-eqpto.cod-emitente          >= tt-param.i-prop-ini
    and   mab-eqpto.cod-emitente          <= tt-param.i-prop-fim
    and   mab-eqpto.cod-estrut-mec        >= tt-param.c-estr-mec-ini  
    and   mab-eqpto.cod-estrut-mec        <= tt-param.c-estr-mec-fim  
    and   mab-eqpto.cc-codigo             >= tt-param.c-ccusto-ini    
    and   mab-eqpto.cc-codigo             <= tt-param.c-ccusto-fim    
    and   mab-eqpto.cod-sit-eqpto         >= tt-param.c-sit-ini       
    and   mab-eqpto.cod-sit-eqpto         <= tt-param.c-sit-fim       
    and   mab-eqpto.vli-ano-fabric        >= tt-param.i-ano-fab-ini   
    and   mab-eqpto.vli-ano-fabric        <= tt-param.i-ano-fab-fim
    and (( mab-eqpto.idi-tip-eqpto         = 1 and tt-param.l-motorizados ) 
     or  ( mab-eqpto.idi-tip-eqpto         = 2 and tt-param.l-n-motorizados ))
    and (( mab-eqpto.idi-tip-propriet      = 1 and tt-param.l-proprios )
     or  ( mab-eqpto.idi-tip-propriet      = 2 and tt-param.l-terceiros )) no-lock,
     each mab-sit-eqpto fields (cod-sit-eqpto idi-tip des-sit-eqpto) where  mab-sit-eqpto.cod-sit-eqpto = mab-eqpto.cod-sit-eqpto
         and (( mab-sit-eqpto.idi-tip      = 1 and tt-param.l-ativos  )
         or  ( mab-sit-eqpto.idi-tip       = 2 and tt-param.l-Inativos )) no-lock
                     break by mab-eqpto.cod-unid-negoc
                           by mab-eqpto.ep-codigo
                           by mab-eqpto.cod-eqpto:

           IF l-usa-unid-negoc THEN DO:
              /*--- Considera Matriz Unidade de Neg¢cio na Sele‡Æo dos Equipamentos ---*/
              IF tt-param.l-matriz-un AND CAN-FIND(FIRST mab-unid-negoc-eqpto
                                                   WHERE mab-unid-negoc-eqpto.ep-codigo = mab-eqpto.ep-codigo
                                                   AND   mab-unid-negoc-eqpto.cod-eqpto = mab-eqpto.cod-eqpto NO-LOCK) THEN DO:

                  IF NOT CAN-FIND(FIRST mab-unid-negoc-eqpto WHERE
                                        mab-unid-negoc-eqpto.ep-codigo       = mab-eqpto.ep-codigo           AND   
                                        mab-unid-negoc-eqpto.cod-eqpto       = mab-eqpto.cod-eqpto           AND   
                                        mab-unid-negoc-eqpto.cod-unid-negoc >= tt-param.c-cod-unid-negoc-ini AND         
                                        mab-unid-negoc-eqpto.cod-unid-negoc <= tt-param.c-cod-unid-negoc-fim NO-LOCK) THEN NEXT.        
              END.
              ELSE DO:
                  IF NOT(mab-eqpto.cod-unid-negoc >= tt-param.c-cod-unid-negoc-ini  AND
                         mab-eqpto.cod-unid-negoc <= tt-param.c-cod-unid-negoc-fim) THEN NEXT.
              END.
           END.

           for first mab-movto-km-eqpto fields (val-hodom-horim cod-eqpto ep-codigo )
               where  mab-movto-km-eqpto.ep-codigo = mab-eqpto.ep-codigo
               and    mab-movto-km-eqpto.cod-eqpto = mab-eqpto.cod-eqpto no-lock: 
           end.
           for first mab-model fields (cod-model des-model un cod-livre-1)
                  where mab-model.cod-model = mab-eqpto.cod-model  no-lock:
           end.               
           for first empresa fields (ep-codigo nome) 
                where   empresa.ep-codigo  = mab-eqpto.ep-codigo no-lock:
           end. 
           for first tag fields (cd-tag descricao) 
                where   tag.cd-tag  = mab-eqpto.cd-tag no-lock:
           end.     
           for first mab-estrut-mec fields (cod-estrut-mec des-estrut-mec) 
                where  mab-estrut-mec.cod-estrut-mec   = mab-eqpto.cod-estrut-mec no-lock:
           end.     
           for first emitente fields (cod-emitente nome-emit) 
                where   emitente.cod-emitente  = mab-eqpto.cod-emitente no-lock:
           end.  
           for first mab-grp-eqpto fields (cod-grp-eqpto des-grp-eqpto) 
                where   mab-grp-eqpto.cod-grp-eqpto  = mab-eqpto.cod-grp-eqpto no-lock:
           end.       
           FOR FIRST unid-negoc
                WHERE unid-negoc.cod-unid-negoc = mab-eqpto.cod-unid-negoc NO-LOCK:
           END.

           find estabelec where   estabelec.cod-estabel  = mab-eqpto.cod-estabel no-lock no-error.
                if not avail estabelec then next.

           assign cSituacao  = {frinc/i00fr024.i 4  mab-sit-eqpto.idi-tip}
                  cAnoModel  = trim(string(mab-eqpto.vli-ano-fabric,"9999") + "/" + string(mab-eqpto.vli-ano-model,"9999"))
                  cTipoEqpto = {frinc/i00fr007.i 4  mab-eqpto.idi-tip-eqpto}
                  cTipoProp  = {frinc/i01fr007.i 4  mab-eqpto.idi-tip-propriet}
                  cProp      = string(mab-eqpto.cod-emitente).
             
                               /*display para impressÆo do relat¢rio */   

                 assign c-un-sec  = substring(mab-model.cod-livre-1, 1, 2)
                        c-un-sec2 = c-un-sec
                        c-un      = mab-model.un
                        c-un2 = c-un.

                 if  not mab-eqpto.log-cont-sec then
                     assign c-un-sec  = ""
                            c-un-sec2 = "".

                 if tt-param.rs-considera = 1 then do:
                        if first-of(mab-eqpto.cod-unid-negoc) AND
                           first-of(mab-eqpto.ep-codigo)      AND 
                           first-of(mab-eqpto.cod-eqpto)      OR
                           mab-eqpto.cod-unid-negoc <> cUnidNegoc then do:

                           assign cUnidNegoc = mab-eqpto.cod-unid-negoc.

                           if l-Insere then do:
                                if NOT l-primeiro-detal then
                                   PAGE.
                                else 
                                   assign l-primeiro-detal = NO.
                           end.
                           disp cTitUN
                                mab-eqpto.cod-unid-negoc
                                unid-negoc.des-unid-negoc when avail unid-negoc
                                with frame f-tit-un.
                        end.
                        
                        if l-usa-unid-negoc then do:                        
                           for first unid-negoc
                               where unid-negoc.cod-unid-negoc = mab-eqpto.cod-unid-negoc no-lock:
                           end.

                           display  mab-eqpto.ep-codigo          
                                    empresa.nome                 
                                    mab-eqpto.cod-eqpto          
                                    cTipoEqpto                   
                                    mab-eqpto.cod-model          
                                    mab-model.des-model          
                                    cAnoModel                
                                    mab-eqpto.cd-tag             
                                    tag.descricao                
                                    mab-eqpto.cc-codigo
                                    mab-eqpto.cod-grp-eqpto      
                                    mab-grp-eqpto.des-grp-eqpto  
                                    mab-eqpto.dat-compra         
                                    mab-eqpto.cod-estrut-mec     
                                    mab-estrut-mec.des-estrut-mec
                                    mab-eqpto.val-compra         
                                    mab-eqpto.cod-sit-eqpto      
                                    mab-sit-eqpto.des-sit-eqpto  
                                    mab-eqpto.dat-situacao       
                                    mab-eqpto.cod-estabel        
                                    estabelec.nome      
                                    mab-eqpto.cod-unid-negoc
                                    unid-negoc.des-unid-negoc when avail unid-negoc
                                    mab-eqpto.dat-inicial        
                                    cTipoProp 
                                    mab-eqpto.val-hodom-horim-inicial 
                                    cProp
                                    emitente.nome-emit when  avail emitente
                                    mab-eqpto.cod-renavam
                                    mab-eqpto.cod-placa         
                                    mab-eqpto.cod-chassi        
                                    mab-eqpto.bm-codigo
                                    mab-eqpto.bm-indice
                                    mab-eqpto.log-cont-sec
                                    mab-eqpto.dat-inicial        
                                    mab-eqpto.val-hodom-horim-sec
                                    c-un-sec
                                    mab-eqpto.val-hodom-horim-inicial
                                    c-un
                                    mab-eqpto.val-km-sec
                                    c-un-sec2
                                    mab-eqpto.val-km-inicial
                                    c-un2
                                    with frame f-eqpto-un.
                                       down with frame f-eqpto-un.
                                       put skip(1).                        
                        end.
                        else do:
                           display  mab-eqpto.ep-codigo          
                                    empresa.nome                 
                                    mab-eqpto.cod-eqpto          
                                    cTipoEqpto                   
                                    mab-eqpto.cod-model          
                                    mab-model.des-model          
                                    cAnoModel                
                                    mab-eqpto.cd-tag             
                                    tag.descricao                
                                    mab-eqpto.cc-codigo
                                    mab-eqpto.cod-grp-eqpto      
                                    mab-grp-eqpto.des-grp-eqpto  
                                    mab-eqpto.dat-compra         
                                    mab-eqpto.cod-estrut-mec     
                                    mab-estrut-mec.des-estrut-mec
                                    mab-eqpto.val-compra         
                                    mab-eqpto.cod-sit-eqpto      
                                    mab-sit-eqpto.des-sit-eqpto  
                                    mab-eqpto.dat-situacao       
                                    mab-eqpto.cod-estabel        
                                    estabelec.nome      
                                    mab-eqpto.dat-inicial        
                                    cTipoProp 
                                    mab-eqpto.val-hodom-horim-inicial 
                                    cProp
                                    emitente.nome-emit when  avail emitente
                                    mab-eqpto.cod-renavam
                                    mab-eqpto.cod-placa         
                                    mab-eqpto.cod-chassi        
                                    mab-eqpto.bm-codigo
                                    mab-eqpto.bm-indice
                                    mab-eqpto.log-cont-sec
                                    mab-eqpto.dat-inicial        
                                    mab-eqpto.val-hodom-horim-sec
                                    c-un-sec
                                    mab-eqpto.val-hodom-horim-inicial
                                    c-un
                                    mab-eqpto.val-km-sec
                                    c-un-sec2
                                    mab-eqpto.val-km-inicial
                                    c-un2
                                    with frame f-eqpto.
                                       down with frame f-eqpto.
                                       put skip(1).
                        end.                                        
                  
                      IF l-usa-unid-negoc AND tt-param.l-detalha-un THEN DO:
                         IF CAN-FIND(FIRST mab-unid-negoc-eqpto WHERE
                                           mab-unid-negoc-eqpto.ep-codigo = mab-eqpto.ep-codigo AND   
                                           mab-unid-negoc-eqpto.cod-eqpto = mab-eqpto.cod-eqpto NO-LOCK) THEN DO:

                             DISP c-liter-matriz
                                  c-liter-unid-negoc
                                  c-liter-desc
                                  c-liter-perc
                                  WITH FRAME f-cab-matriz STREAM-IO.

                             FOR EACH mab-unid-negoc-eqpto 
                                WHERE mab-unid-negoc-eqpto.ep-codigo = mab-eqpto.ep-codigo 
                                AND   mab-unid-negoc-eqpto.cod-eqpto = mab-eqpto.cod-eqpto NO-LOCK:

                                ASSIGN c-unid-negoc     = mab-unid-negoc-eqpto.cod-unid-negoc 
                                       d-rateio         = mab-unid-negoc-eqpto.val-perc-unid-negoc.

                                FOR FIRST unid-negoc
                                    WHERE unid-negoc.cod-unid-negoc = mab-unid-negoc-eqpto.cod-unid-negoc NO-LOCK:
                                    ASSIGN c-des-unid-negoc = unid-negoc.des-unid-negoc.
                                END.

                                DISP c-unid-negoc
                                     c-des-unid-negoc
                                     d-rateio
                                WITH FRAME f-matriz.
                                DOWN WITH FRAME f-matriz.
                             END.
                             PUT SKIP(1).
                         END.
                      END.
                      if tt-param.l-combust  = yes then do:
                         for each mab-histor-combust fields (ep-codigo cod-eqpto cod-tip-mater ep-codigo idi-tip-consu 
                                                     dat-inicial val-capac-tanque val-consu-padr dat-desativ num-livre-1 val-livre-1) 
                               where mab-histor-combust.ep-codigo = mab-eqpto.ep-codigo
                               and   mab-histor-combust.cod-eqpto = mab-eqpto.cod-eqpto no-lock,
                               first mab-tip-mater fields (des-tip-mater cod-tip-mater) where
                                     mab-tip-mater.cod-tip-mater = mab-histor-combust.cod-tip-mater no-lock
                                           break by mab-histor-combust.ep-codigo
                                                 by mab-histor-combust.cod-eqpto
                                                 by mab-histor-combust.dat-inicial:

                                   assign cTipoComb = {frinc/i01fr014.i 4  mab-histor-combust.idi-tip-consu}
                                          cCodMater =  mab-tip-mater.cod-tip-mater.
                                          
                                   if  mab-histor-combust.num-livre-1 <> 0 then
                                       assign cTipoCombSec = {frinc/i01fr014.i 4  mab-histor-combust.idi-tip-consu}.
                                   else
                                       assign cTipoCombSec = {frinc/i01fr014.i 4  1}.
                                          
                                   if  first-of( mab-histor-combust.ep-codigo) then do:
                                        display cDataIni    when first-of(mab-histor-combust.dat-inicial)
                                                cCombust    when first-of(mab-histor-combust.dat-inicial)  
                                                cDescricao  when first-of(mab-histor-combust.dat-inicial)
                                                cCapTaq     when first-of(mab-histor-combust.dat-inicial)
                                                cTpCons     when first-of(mab-histor-combust.dat-inicial) 
                                                cValCons    when first-of(mab-histor-combust.dat-inicial)
                                                cTpConsSec  when first-of(mab-histor-combust.dat-inicial)
                                                cValConsSec when first-of(mab-histor-combust.dat-inicial) 
                                                cDtDesativ  when first-of(mab-histor-combust.dat-inicial)
                                                with  frame f-cab-combustivel.
                                   end.
                                   Display mab-histor-combust.dat-inicial                              at 01
                                              cCodMater                                                at 14     
                                              mab-tip-mater.des-tip-mater                              at 29                
                                              mab-histor-combust.val-capac-tanque FORMAT "zzzz9.9"     at 63 
                                              cTipoComb                                                at 71           
                                              mab-histor-combust.val-consu-padr   FORMAT "zzzzz9.99"   at 90   
                                              cTipoCombSec                                             at 90   
                                              mab-histor-combust.val-livre-1      format "zzzzzz9.99"  at 111  
                                              mab-histor-combust.dat-desativ                           at 115           
                                              with frame f-relatorio-combustivel.            
                                                  down with frame f-relatorio-combustivel.
                           end. 
                           put skip (1).
                       end.  
                      if tt-param.l-caract  = yes then do:
                        for each mab-eqpto-caract
                             where mab-eqpto-caract.ep-codigo = mab-eqpto.ep-codigo
                               and mab-eqpto-caract.cod-eqpto = mab-eqpto.cod-eqpto no-lock,
                               first mab-caract fields (cod-caract des-abrev des-caract) where
                                     mab-caract.cod-caract = mab-eqpto-caract.cod-caract no-lock
                                           break by mab-eqpto-caract.cod-caract:
                                     if iEmp <> mab-eqpto.ep-codigo 
                                        or cEqpto <> mab-eqpto.cod-eqpto then do:
                                        put cLinha at 01 skip.
                                        put cLinha2 at 01. 
                                     end.
                                   Display mab-caract.cod-caract
                                           mab-caract.des-abrev        
                                           mab-eqpto-caract.des-caract 
                                           mab-eqpto-caract.des-arquivo
                                           with frame f-relatorio-caracteristica.            
                                           down with frame f-relatorio-caracteristica.
                                                  
                                   assign iEmp   = mab-eqpto.ep-codigo 
                                          cEqpto = mab-eqpto.cod-eqpto.
                           end. 
                           put skip(1).
                       end.  

                       if tt-param.l-comptes  = yes then do: 
                               if can-find (first mab-comptmento-eqpto where  mab-comptmento-eqpto.ep-codigo = mab-eqpto.ep-codigo
                                                                       and    mab-comptmento-eqpto.cod-eqpto = mab-eqpto.cod-eqpto no-lock) then do:
                                       display cCompto    
                                               cTpMatrl   
                                               cCapcid    
                                               cRemont    
                                               cEvent     
                                               cPeriodo   
                                               with  frame f-cab-compto.
                               end.                 
                               for each mab-comptmento-eqpto fields (cod-eqpto cod-comptmento ep-codigo cod-tip-mater qtd-capac val-perc-remon) 
                                       where  mab-comptmento-eqpto.ep-codigo = mab-eqpto.ep-codigo
                                       and    mab-comptmento-eqpto.cod-eqpto = mab-eqpto.cod-eqpto no-lock
                                       break by mab-comptmento-eqpto.cod-comptmento:
                                                       
                                                         for first mab-comptmento fields (cod-comptmento des-comptmento)
                                                               where mab-comptmento.cod-comptmento = mab-comptmento-eqpto.cod-comptmento no-lock: 
                                                         end. 
                                                         for first mab-tip-mater fields (cod-tip-mater des-tip-mater )
                                                             where mab-tip-mater.cod-tip-mater = mab-comptmento-eqpto.cod-tip-mater no-lock: 
                                                         end. 
                                                        display   mab-comptmento-eqpto.cod-comptmento 
                                                                      mab-comptmento.des-comptmento           
                                                                      mab-tip-mater.des-tip-mater              
                                                                      mab-comptmento-eqpto.qtd-capac FORMAT "zzzz9.99"         
                                                                      mab-comptmento-eqpto.val-perc-remon FORMAT "zz9.99"
                                                                      with frame f-compartimento.  
                                                          for each mab-period-manut fields (cod-comptmento cod-eqpto cod-evento val-km-padr ep-codigo)
                                                              where mab-period-manut.ep-codigo      = mab-comptmento-eqpto.ep-codigo
                                                              and   mab-period-manut.cod-eqpto      = mab-comptmento-eqpto.cod-eqpto 
                                                              and   mab-period-manut.cod-comptmento = mab-comptmento-eqpto.cod-comptmento no-lock,
                                                              each mab-event fields (cod-evento des-evento)
                                                                   where mab-event.cod-evento = mab-period-manut.cod-evento no-lock:
                                                                        
                                                             
                                                                     display   mab-event.des-evento                
                                                                               mab-period-manut.val-km-padr FORMAT "ZZ,ZZZ,ZZ9.9"       
                                                                               with frame f-compartimento.
                                                                               down with frame f-compartimento.          
                                                          end.
                               end. 
                            put skip(1).
                               
                       end.    
                        if tt-param.l-hist  = yes then do:
                                  if can-find (first mab-histor-ativid where  mab-histor-ativid.ep-codigo = mab-eqpto.ep-codigo
                                                                       and    mab-histor-ativid.cod-eqpto = mab-eqpto.cod-eqpto
                                                                       and    mab-histor-ativid.dat-cadastro >= tt-param.dat-cadastr-ini 
                                                                       and    mab-histor-ativid.dat-cadastro <= tt-param.dat-cadastr-fim no-lock) then do:
                                           display  cData                      
                                                    cDescEstab 
                                                    cDescGrp   
                                                    cCusto     
                                                    cCtaCont   
                                                    cUdeNeg    
                                                    cTag
                                                    cAtivid  
                                                    cAgr     
                                                    with frame f-cab-histco.
                                  end.                 
                          
                            &IF DEFINED(bf_mnt_ems206b) &THEN
                               for each mab-histor-ativid fields (cod-eqpto cod-estabel cod-grp-eqpto cod-unid-negoc cd-tag cc-codigo ep-codigo cod-ativid dat-cadastro ct-codigo) no-lock
                            &ELSE
                               for each mab-histor-ativid fields (cod-eqpto cod-estabel cod-grp-eqpto cod_unid_negoc cd-tag cc-codigo ep-codigo cod-ativid dat-cadastro ct-codigo) no-lock
                            &ENDIF                                                                   
                                       where mab-histor-ativid.ep-codigo     = mab-eqpto.ep-codigo
                                       and   mab-histor-ativid.cod-eqpto     = mab-eqpto.cod-eqpto 
                                       and   mab-histor-ativid.dat-cadastro >= tt-param.dat-cadastr-ini     
                                       and   mab-histor-ativid.dat-cadastro <= tt-param.dat-cadastr-fim 
                                                   break by mab-histor-ativid.cod-ativid
                                                         by mab-histor-ativid.cod-eqpto:
                                                        
                                                         
                                                      for first estabelec fields (cod-estabel nome)
                                                               where estabelec.cod-estabel = mab-histor-ativid.cod-estabel no-lock: 
                                                               assign cEstabel = string(estabelec.cod-estabel) + " - " + string(estabelec.nome).
                                                      end. 
                                                      for first mab-grp-eqpto fields (cod-grp-eqpto des-grp-eqpto )
                                                             where mab-grp-eqpto.cod-grp-eqpto  = mab-histor-ativid.cod-grp-eqpto no-lock: 
                                                      assign  cGrupo   = string(mab-grp-eqpto.cod-grp-eqpto) + " - " + string(mab-grp-eqpto.des-grp-eqpto).       

                                                      end. 
                                                      for first mab-ativid 
                                                          where mab-ativid.cod-ativid = mab-histor-ativid.cod-ativid no-lock:
                                                      end.

                                                             display   mab-histor-ativid.dat-cadastro   
                                                                       cEstabel                         
                                                                       cGrupo                           
                                                                       mab-histor-ativid.cc-codigo      
                                                                       mab-histor-ativid.ct-codigo      
                                                                    &IF DEFINED(bf_mnt_ems206b) &THEN
                                                                       mab-histor-ativid.cod-unid-negoc 
                                                                    &ELSE
                                                                       mab-histor-ativid.cod_unid_negoc 
                                                                    &ENDIF
                                                                       mab-histor-ativid.cd-tag
                                                                       mab-histor-ativid.cod-ativid         
                                                                       mab-ativid.log-area-agro
                                                                       with frame f-historico.
                                                                       down with frame f-historico.
                               end.
                               put skip(1). 
                           
                       end.    
                        if tt-param.l-eventos   = yes then do:  
                            if can-find (first mab-programac-event where  mab-programac-event.ep-codigo = mab-eqpto.ep-codigo
                                                                  and    mab-programac-event.cod-eqpto = mab-eqpto.cod-eqpto no-lock) then do:
                                           display cDescEvent                       
                                                   cVencto     
                                                   cAntecip    
                                                   cNumParc    
                                                   cValidade   
                                                   with frame f-cab-evento. 
                            end.                                        
                               for each mab-programac-event fields (cod-eqpto cod-evento ep-codigo dat-inicial dat-final
                                                                     num-dia num-parcela cod-dia-mes-vencto) 
                                       where mab-programac-event.ep-codigo     = mab-eqpto.ep-codigo
                                       and   mab-programac-event.cod-eqpto     = mab-eqpto.cod-eqpto no-lock
                                                   break by mab-programac-event.cod-evento
                                                         by mab-programac-event.cod-eqpto:
                                                         for first mab-event fields (cod-evento des-evento )
                                                             where mab-event.cod-evento  = mab-programac-event.cod-evento no-lock: 
                                                                assign  cEvento   = string(mab-event.cod-evento) + " - " + string(mab-event.des-evento) 
                                                                        cPerValid = string(mab-programac-event.dat-inicial,"99/99/9999") + " -  " + string(mab-programac-event.dat-final,"99/99/9999").
                                                             end.
                                                         
                                                                         display cEvento                                
                                                                            mab-programac-event.cod-dia-mes-vencto 
                                                                            mab-programac-event.num-dia   FORMAT "zzzzz"       
                                                                            mab-programac-event.num-parcela  FORMAT "z9"      
                                                                            cPerValid                              
                                                                            with frame f-evento.
                                                                            down with frame f-evento.
                                                            
                          end.
                          put skip(1). 
                        
                      end.       
                        if tt-param.l-planos  = yes then do: 
                            if can-find (first mmv-eqpto-plano where  mmv-eqpto-plano.ep-codigo = mab-eqpto.ep-codigo
                                                               and    mmv-eqpto-plano.cod-eqpto = mab-eqpto.cod-eqpto no-lock) then do:
                                           display cDescPlano                         
                                                   c-dat-inicial   
                                                   c-dat-final
                                                   c-val-km-inicial
                                                   c-val-km-real   
                                                   with frame f-cab-plano. 
                            end.   

                          for each  mmv-eqpto-plano
                            where mmv-eqpto-plano.ep-codigo       = mab-eqpto.ep-codigo
                            and   mmv-eqpto-plano.cod-eqpto       = mab-eqpto.cod-eqpto no-lock:
                
                               for first mmv-plano-prevent fields(cod-model cod-plano des-plano-manut)
                                    where mmv-plano-prevent.cod-model  = mab-eqpto.cod-model
                                      and mmv-plano-prevent.cod-plano  = mmv-eqpto-plano.cod-plano no-lock:
                               end.
                               if avail mmv-plano-prevent then
                                     assign c-des-plano = mmv-plano-prevent.des-plano-manut.

                                    display  mmv-eqpto-plano.cod-plano
                                             c-des-plano
                                             mmv-eqpto-plano.dat-inicial
                                             mmv-eqpto-plano.dat-final
                                             mmv-eqpto-plano.val-km-inicial
                                             mmv-eqpto-plano.val-km-real  
                                                    with frame f-plano.
                                                    down with frame f-plano.
                          end.  

                       end.    
                       if tt-param.l-config  = yes then do: 
                                  if can-find (first mab-configur-eix where  mab-configur-eix.ep-codigo = mab-eqpto.ep-codigo
                                                                       and    mab-configur-eix.cod-eqpto = mab-eqpto.cod-eqpto no-lock) then do:
                                                                 display cEixo    
                                                                         cTempo   
                                                                         cTracao  
                                                                         cDuplo   
                                                                         with frame f-cab-eixo.
                                                            
                                  end.      

                               for each mab-configur-eix fields (cod-eqpto num-eixo ep-codigo log-eixo-tracao log-eixo-dpl val-percent-suspen) 
                                       where mab-configur-eix.ep-codigo = mab-eqpto.ep-codigo
                                       and mab-configur-eix.cod-eqpto = mab-eqpto.cod-eqpto   no-lock
                                                   break by mab-configur-eixo.num-eixo
                                                         by mab-configur-eix.ep-codigo
                                                         by mab-configur-eix.cod-eqpto:
                                                         assign l-tracao = mab-configur-eixo.log-eixo-tracao
                                                                l-duplo  = mab-configur-eixo.log-eixo-dpl.

                                                            display  mab-configur-eixo.num-eixo           
                                                                     mab-configur-eixo.val-percent-suspen FORMAT "zz9.99"
                                                                     l-tracao                             
                                                                     l-duplo                              
                                                                     with frame f-eixo.
                                                                     down with frame f-eixo.
                               end. 
                       end. 
                       if l-insere then
                           page.
                       else
                           put skip(1). 
                 end.
                 if tt-param.rs-considera = 2 then do:
                        if first-of(mab-eqpto.cod-unid-negoc) AND
                           first-of(mab-eqpto.ep-codigo) AND 
                           first-of(mab-eqpto.cod-eqpto) then do:
                           if l-Insere then do:
                                PAGE.
                                ASSIGN l-primeiro-resu = YES.
                           end.
                           if l-primeiro-resu then
                                assign l-primeiro-resu = no.
                           else
                                put skip(1).

                           disp cTitUN
                                mab-eqpto.cod-unid-negoc
                                unid-negoc.des-unid-negoc when avail unid-negoc
                                with frame f-tit-un.

                           if l-mostrou-cab then  
                                assign l-mostrou-cab = no.
                          end.

                     if not l-mostrou-cab then do:
                          display cUdeNeg
                                  c-e        
                                  c-eqpto 
                                  c-desc-model 
                                  cEs     
                                  c-chassi     
                                  cAnoMod-1    
                                  cSitEqpto  
                                  c-placa
                                  c-renavan      
                               with  frame f-cab-resumido-un.                      
                          assign l-mostrou-cab = yes.
                      end.
                      display  mab-eqpto.cod-unid-negoc                                              
                               mab-eqpto.ep-codigo                           
                               mab-eqpto.cod-eqpto                           
                               mab-model.des-model                           
                               mab-eqpto.cod-estabel                         
                               mab-eqpto.cod-chassi                          
                               cAnoModel   when first-of(mab-eqpto.cod-eqpto)
                               cSituacao                                     
                               mab-eqpto.cod-placa
                               mab-eqpto.cod-renavam                           
                               with frame f-resumido-un.                  
                              down with frame f-resumido-un.
                 end.
end.

return 'OK'.
end procedure.
/* FIM */    
