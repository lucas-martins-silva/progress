                                                /** Defini‡Æo de Vari veis **/
DEFINE VARIABLE c-liter-par   AS CHARACTER FORMAT "x(15)"               NO-UNDO.                                                
DEFINE VARIABLE c-liter-imp   AS CHARACTER FORMAT "x(14)"               NO-UNDO.
DEFINE VARIABLE c-destino     AS CHARACTER FORMAT "x(09)"               NO-UNDO.
DEFINE VARIABLE c-fora        AS CHARACTER FORMAT "x(01)"               NO-UNDO.
/** Variaveis para a Impressao da visao Documento **/
define variable cCodigo       as character format "x(16)"               no-undo.
define variable cDesc         as character format "x(22)"               no-undo.
define variable cQuant        as character format "x(13)"               no-undo.
define variable cUn           as character format "x(02)"               no-undo.
define variable cVal-mater    as character format "x(14)"               no-undo.
define variable cIntegracao   as character format "x(13)"               no-undo.
define variable dtData        as date format "99/99/9999"               no-undo.
define variable cHora         as character format "99:99:99"            no-undo.
define variable dContador     LIKE mab-abastec-lubrific.val-hodom-horim no-undo.
define variable cNr-trans     as character format "x(11)"               no-undo.         
define variable dt-trans      as date format "99/99/9999"               no-undo.         

/*****************************************************************************/
                                                     /** Form de Parƒmetros **/

form   /*PAR¶METROS*/
       skip(1)
       c-liter-par              at 09    no-label
       skip(1)
       tt-param.i-tipo          COLON 30 " - " c-tipo  format "x(30)" no-label
       tt-param.l-quebra        colon 30
       /*IMPRESSÇO*/
       skip(1)
       c-liter-imp              AT 09    no-label
       skip(1)
       c-destino                COLON 30 " - " tt-param.arquivo NO-LABEL
       tt-param.usuario         COLON 30
       skip(1)
       with width 132 side-labels frame f-param-definidos stream-io.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-param-definidos:HANDLE).




/*****************************************************************************/
                                                              /** ImpressÆo **/
                                                                   
form tt-digita.cod-nivel   AT 12 " - " 
     tt-digita.desc-dimensao no-label
     with width 132 side-labels no-attr-space no-box frame f-visoes stream-io.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-visoes:HANDLE).

     
form bfDigita.cod-nivel   AT 01  format "x(16)"
     bfDigita.desc-dimensao format "x(30)"
     bfDigita.quantidade
     bfDigita.un    
     bfDigita.val-mater
     with width 132 no-attr-space no-box down frame f-dados stream-io.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-dados:HANDLE).

     
form cCodigo     at 1  label "Codigo"
     cDesc       at 18  
     cQuant      at 41 
     cUn         at 55 label "Un"
     cVal-mater  at 58 
     cIntegracao at 73 
     dtData      at 87 
     cHora       at 98 
     dContador   at 107 
     cNr-trans   at 119
     dt-trans    at 131
     with width 140 no-attr-space no-box down frame f-dados1 stream-io.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-dados1:HANDLE).


/*****************************************************************************/
                                               /** Literais Form Parƒmetros **/
{utp/ut-liter.i Usu rio * l}
assign tt-param.usuario:label in frame f-param-definidos = trim(return-value).

{utp/ut-liter.i Destino * l}
assign c-destino:label in frame f-param-definidos = trim(return-value).

{utp/ut-liter.i IMPRESSÇO * R}
assign c-liter-imp = trim(return-value).

{utp/ut-liter.i PAR¶METROS * R}
assign c-liter-par = trim(return-value).

{utp/ut-liter.i Tipo_de_Relat¢rio * }
assign tt-param.i-tipo:label in frame f-param-definidos = trim(return-value).

{utp/ut-liter.i Quebra_P g._por_Abast/Lubrif * }
assign tt-param.l-quebra:label in frame f-param-definidos = trim(return-value).

{utp/ut-liter.i Sim/NÆo * }
assign tt-param.l-quebra:format in frame f-param-definidos = trim(return-value).


/*****************************************************************************/
                                                    /** Literais Form Dados **/
{utp/ut-liter.i Quantidade}
assign bfDigita.quantidade:label in frame f-dados = trim(return-value).
{utp/ut-liter.i Un * R}
assign bfDigita.un:label in frame f-dados = trim(return-value).
{utp/ut-liter.i Valor * L}
assign bfDigita.val-mater:label in frame f-dados = trim(return-value).
{utp/ut-liter.i "Codigo" * L}
assign bfDigita.cod-nivel:label in frame f-dados = trim(return-value).
{utp/ut-liter.i "Descri‡Æo" * L}
assign bfDigita.desc-dimensao:label in frame f-dados = trim(return-value).

/** f-dados1 **/
{utp/ut-liter.i Codigo * L}
assign cCodigo:label in frame f-dados1 = trim(return-value).
{utp/ut-liter.i Descri‡Æo * L}
assign cDesc:label in frame f-dados1 = trim(return-value).
{utp/ut-liter.i Quantidade * L}
assign cQuant:label in frame f-dados1 = trim(return-value).
{utp/ut-liter.i Un * L}
assign cUn:label in frame f-dados1 = trim(return-value).
{utp/ut-liter.i Valor * L}
assign cVal-mater:label in frame f-dados1 = trim(return-value).
{utp/ut-liter.i Integra‡Æo * L}
assign cIntegracao:label in frame f-dados1 = trim(return-value).
{utp/ut-liter.i Data * L}
assign dtData:label in frame f-dados1 = trim(return-value).
{utp/ut-liter.i Hora * L}
assign cHora:label in frame f-dados1 = trim(return-value).
{utp/ut-liter.i Contador * L}
assign dContador:label in frame f-dados1 = trim(return-value).
{utp/ut-liter.i Nr_Trans * L}
assign cNr-trans:label in frame f-dados1 = trim(return-value).
{utp/ut-liter.i Dt_Trans * L}
assign dt-trans:label in frame f-dados1 = trim(return-value).

/*****************************************************************************/
                                                         /** Fim da Include **/
