                                                /** Defini‡Æo de Vari veis **/
DEFINE VARIABLE c-liter-imp  AS CHARACTER FORMAT "x(14)" NO-UNDO.
DEFINE VARIABLE c-destino    AS CHARACTER FORMAT "x(09)" NO-UNDO.
DEFINE VARIABLE c-fora       AS CHARACTER FORMAT "x(01)" NO-UNDO.

/*****************************************************************************/
                                                     /** Form de Parƒmetros **/

form   /*IMPRESSÇO*/
       skip(1)
       c-liter-imp              AT 09    no-label
       skip(1)
       c-destino                COLON 30 " - " tt-param.arquivo NO-LABEL
       tt-param.usuario         COLON 30
       skip(1)
       with width 132 side-labels frame f-param-definidos stream-io.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-param-definidos:HANDLE).

/*****************************************************************************/
                                                              /** ImpressÆo **/
     
FORM HEADER 
     FILL ("-",22) FORMAT "X(22)" AT 01
     FILL ("-",22) FORMAT "X(22)" AT 24
     FILL ("-",22) FORMAT "X(22)" AT 47
     FILL ("-",14) FORMAT "X(14)" AT 70
     FILL ("-",14) FORMAT "X(14)" AT 85
     FILL ("-",14) FORMAT "X(14)" AT 100
     FILL ("-",02) FORMAT "X(02)" AT 111
     FILL ("-",09) FORMAT "X(09)" AT 114
     FILL ("-",09) FORMAT "X(09)" AT 124 SKIP
     WITH WIDTH 132 NO-LABELS NO-BOX FRAME f-visoes STREAM-IO.
     
form cDesc1               format "x(22)"          AT 01 
     cDesc2               format "x(22)"          AT 24 
     cDesc3               format "x(22)"          AT 47 
     bfDigita.uso-real    format "->>,>>>,>>9.99" AT 70 
     bfDigita.uso-padrao  format "->>,>>>,>>9.99" AT 85 
     bfDigita.diferenca   format "->>,>>>,>>9.99" AT 100
     bfDigita.un          format "x(02)"          AT 111
     bfDigita.perc-desvio format "->>,>>9.99"     AT 114
     cPrazo               format "x(09)"          AT 124 SKIP
     with width 132 no-attr-space no-box down frame f-dados stream-io.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-dados:HANDLE).


form cDesc1              format "x(22)" AT 01
     cDesc2              format "x(22)" AT 24
     cDesc3              format "x(22)" AT 47
     bfDigita.quantida
     bfDigita.valor
     with width 132 no-attr-space no-box down frame f-dados2 stream-io.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-dados2:HANDLE).



/*****************************************************************************/
                                               /** Literais Form Parƒmetros **/
{utp/ut-liter.i Usu rio * l}
assign tt-param.usuario:label in frame f-param-definidos = trim(return-value).

{utp/ut-liter.i Destino * l}
assign c-destino:label in frame f-param-definidos = trim(return-value).

{utp/ut-liter.i IMPRESSÇO * R}
assign c-liter-imp = trim(return-value).

/*****************************************************************************/
                                                    /** Literais Form Dados **/
{utp/ut-liter.i "Uso Real"}
assign bfDigita.uso-real:label in frame f-dados = trim(return-value).
{utp/ut-liter.i "Uso PadrÆo"}
assign bfDigita.uso-padrao:label in frame f-dados = trim(return-value).
{utp/ut-liter.i "Diferen‡a"}
assign bfDigita.diferenca:label in frame f-dados = trim(return-value).
{utp/ut-liter.i "UN"}
assign bfDigita.un:label in frame f-dados = trim(return-value).
{utp/ut-liter.i "% Desvio"}
assign bfDigita.perc-desvio:label in frame f-dados = trim(return-value).
{utp/ut-liter.i "Prazo"}
assign cPrazo:label in frame f-dados = trim(return-value).

{utp/ut-liter.i "Quantidade"}
assign bfDigita.quantidade:label in frame f-dados2 = trim(return-value).
{utp/ut-liter.i "Valor"}
assign bfDigita.valor:label in frame f-dados2 = trim(return-value).


/*****************************************************************************/
                                                         /** Fim da Include **/
