/********************************************************************************
Program: ab0138.i2
Include def de temp-tables para integra‡Æo com o ems5

caso precise da tt_log_erro usar a include ab0138.i, esta include foi criada para
evitar os conflitos com a cdunif001.i


*******************************************************************************/

/* Filtro RECID x ROWID Aplicado */
{include/i_fncrowid.i}
{include/i_def_vars_epc.i}

def temp-table tt_bem_pat_consulta_api no-undo
    field tta_cod_empresa                  as character format "x(3)"               
    field tta_cod_cta_pat                  as character format "x(18)"              
    field tta_num_bem_pat                  as integer format ">>>>>>>>9" initial 0  
    field tta_num_seq_bem_pat              as integer format ">>>>9" initial 0      
    field tta_num_id_bem_pat               as integer format ">>,>>>,>>9" initial 0 
    field tta_des_bem_pat                  as character format "x(40)" 
    field tta_cod_ident_cop                as character format "x(8)"  
    field tta_qtd_cop_gerad                as decimal format ">>>>>>>>9" initial 0 
    field tta_ind_orig_bem                 as character format "X(15)" initial "Aquisi‡Æo" 
    field tta_qtd_bem_pat_represen         as decimal format ">>>>>>>>9" initial 1 
    field tta_dat_lim_utiliz               as date format "99/99/9999" initial 12/31/9999 
    field tta_dat_ult_invent               as date format "99/99/9999" initial today 
    field tta_ind_period_invent            as character format "x(07)" initial "Mes(es)" 
    field tta_qtd_interv_invent            as decimal format "999" initial 0 
    field tta_dat_aquis_bem_pat            as date format "99/99/9999" initial today 
    field tta_cod_estab                    as character format "x(3)" 
    field tta_cod_grp_calc                 as character format "x(6)" 
    field tta_ind_periodic_invent          as character format "x(14)" initial "Anual" 
    field tta_cb3_ident_visual             as Character format "x(20)" initial ? 
    field tta_val_perc_bxa                 as decimal format ">>9.99" decimals 10 initial 0 
    field tta_cod_espec_bem                as character format "x(6)" 
    field tta_cod_marca                    as character format "x(6)" 
    field tta_cod_modelo                   as character format "x(8)" 
    field tta_cod_licenc_uso               as character format "x(12)"
    field tta_cod_especif_tec              as character format "x(8)" 
    field tta_cod_arrendador               as character format "x(6)" 
    field tta_cod_contrat_leas             as character format "x(12)" 
    field tta_cod_estado_fisic_bem_pat     as character format "x(8)" 
    field tta_cdn_fornecedor               as Integer format ">>>,>>>,>>9" initial 0 
    field tta_cod_localiz                  as character format "x(12)" 
    field tta_cod_usuario                  as character format "x(12)" 
    field tta_cod_plano_ccusto             as character format "x(8)" 
    field tta_cod_ccusto_respons           as Character format "x(11)" 
    field tta_des_anot_tab                 as character format "x(2000)" 
    field tta_cod_unid_negoc               as character format "x(3)" 
    field tta_cod_imagem                   as character format "x(30)" 
    field tta_dat_calc_pat                 as date format "99/99/9999" initial today 
    field tta_cod_indic_econ               as character format "x(8)" 
    field tta_val_original                 as decimal format "->>>>>,>>>,>>9.99" decimals 4 initial 0 
    field tta_val_despes_financ            as decimal format "->>>>>,>>>,>>9.99" decimals 2 initial 0 
    field tta_dat_refer                    as date format "99/99/9999" initial ? 
    field tta_log_informa_quant_produz     as logical 
    field tta_cod_indic_econ_avaliac       as character format "x(8)" 
    field tta_val_avaliac_apol_seguro      as decimal format "->>,>>>,>>>,>>9.99" decimals 2 initial 0 
    field tta_dat_avaliac_apol_seguro      as date format "99/99/9999" initial today 
    field tta_des_narrat_bem_pat           as character format "x(2000)" 
    field tta_log_utiliz_alug_inter        as logical initial no 
    field tta_cod_plano_ccusto_cr          as character format "x(8)" 
    field tta_cod_ccusto_cr                as Character format "x(11)" 
    field tta_cod_unid_negoc_cr            as character format "x(8)" 
    field tta_num_pessoa_jurid_gartia      as integer format ">>>,>>>,>>9" initial 0 
    field tta_dat_inic_valid_gartia_bem    as date format "99/99/9999" initial &IF "{&ems_dbtype}":U = "MSS":U &THEN 01/01/1800 &ELSE 01/01/0001 &ENDIF 
    field tta_dat_fim_valid_gartia_bem     as date format "99/99/9999" initial 12/31/9999 
    field tta_des_termo_gartia_bem_pat     as character format "x(2000)" 
    field tta_cod_docto_entr               as character format "x(8)" 
    field tta_cod_ser_nota                 as character format "x(3)" 
    field tta_num_item_docto_entr          as integer format ">>>,>>9" initial 0 
    field tta_cod_img_gartia_bem_pat       as character format "x(30)" 
    field tta_cod_usuar_ult_atualiz        as character format "x(12)" 
    field tta_dat_ult_atualiz              as date format "99/99/9999" initial today 
    field tta_hra_ult_atualiz              as Character format "99:99:99" 
    field tta_ind_sit_bem_pat              as character format "x(12)" initial "Normal" 
    field tta_dat_fim_calc_pat             as date format "99/99/9999" initial today 
    field tta_cod_livre_1                  as character format "x(100)" 
    field tta_log_bem_imptdo               as logical  initial no 
    field tta_log_cr_pis                   as logical  initial no 
    field tta_log_cr_cofins                as logical  initial no 
    field tta_num_parc_pis_cofins          as integer format "999" initial 0 
    field tta_val_origin_corrig            as decimal format "->>>>>,>>>,>>9.99" decimals 4 initial 0 label "Val Origin Corrigido" column-label "Val Origin Corrigido"
    field ttv_rec_bem_pat                  as &IF "{&ROWID_READY}" = "YES" &THEN ROWID &ELSE RECID FORMAT ">>>>>>9" INITIAL ? &ENDIF
    index tt_bempat_bem                   
          tta_num_bem_pat                  ascending
          tta_num_seq_bem_pat              ascending
    index tt_bempat_ccusto                
          tta_cod_empresa                  ascending
          tta_cod_plano_ccusto             ascending
          tta_cod_ccusto_respons           ascending
    index tt_bempat_emp                   
          tta_cod_empresa                  ascending
          tta_num_bem_pat                  ascending
          tta_num_seq_bem_pat              ascending
    index tt_bempat_estab                 
          tta_cod_estab                    ascending
          tta_num_bem_pat                  ascending
          tta_num_seq_bem_pat              ascending
    index tt_bempat_fornecedor            
          tta_cod_empresa                  ascending
          tta_cdn_fornecedor               ascending
    index tt_bempat_grp_calc              
          tta_cod_grp_calc                 ascending
    index tt_bempat_id                     is primary unique
          tta_cod_empresa                  ascending
          tta_cod_cta_pat                  ascending
          tta_num_bem_pat                  ascending
          tta_num_seq_bem_pat              ascending
    index tt_bempat_ident_visu            
          tta_cod_empresa                  ascending
          tta_cb3_ident_visual             ascending
    index tt_bempat_leasing               
          tta_cod_arrendador               ascending
          tta_cod_contrat_leas             ascending
    index tt_bempat_localiz               
          tta_cod_estab                    ascending
          tta_cod_localiz                  ascending
    index tt_bempat_marca                 
          tta_cod_marca                    ascending
    index tt_bempat_modelo                
          tta_cod_espec_bem                ascending
          tta_cod_marca                    ascending
          tta_cod_modelo                   ascending
    index tt_bempat_orig_bem              
          tta_cod_empresa                  ascending
          tta_ind_orig_bem                 ascending
          tta_cod_cta_pat                  ascending
          tta_num_bem_pat                  ascending
          tta_num_seq_bem_pat              ascending
    index tt_bempat_seq                    is unique
          tta_num_id_bem_pat               ascending
    index tt_bempat_tmdctntr              
          tta_cod_estab                    ascending
          tta_cod_empresa                  ascending
          tta_cdn_fornecedor               ascending
          tta_cod_docto_entr               ascending
          tta_cod_ser_nota                 ascending
          tta_num_item_docto_entr          ascending
    index tt_bempat_usuario               
          tta_cod_usuario                  ascending
    index tt_bempat_word                  
          tta_des_bem_pat                  ascending.
