                                                /** Defini‡Æo de Vari veis **/
DEFINE VARIABLE c-liter-imp  AS CHARACTER FORMAT "x(14)" NO-UNDO.
DEFINE VARIABLE c-liter-par  AS CHARACTER FORMAT "x(14)" NO-UNDO.
DEFINE VARIABLE c-destino    AS CHARACTER FORMAT "x(09)" NO-UNDO.
DEFINE VARIABLE c-fora       AS CHARACTER FORMAT "x(01)" NO-UNDO.

/*****************************************************************************/
                                                     /** Form de Parƒmetros **/

form   /*PAR¶METROS*/
       skip(1)
       c-liter-par              at 09    no-label
       skip(1)
       tt-param.iTipo           COLON 30 " - " tt-param.cTipo  format "x(25)" no-label
       tt-param.lHistorico      colon 30
       tt-param.lObs            colon 30
       tt-param.lQuebra         colon 30
       /*IMPRESSÇO*/
       skip(1)
       c-liter-imp              AT 09    no-label
       skip(1)
       c-destino                COLON 30 " - " tt-param.arquivo NO-LABEL
       tt-param.usuario         COLON 30
       skip(1)
       with width 132 side-labels frame f-param-definidos stream-io.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-param-definidos:HANDLE).

/*****************************************************************************/
                                                              /** ImpressÆo **/
form tt-digita.cod-oficial  at 20 " - " 
     tt-digita.desc-dimensao no-label format "x(75)"
     with width 132 no-attr-space no-box side-labels frame f-visoes stream-io.
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-visoes:HANDLE).

     
form bfDigita.cod-oficial     format "x(20)"       at 01
     bfDigita.cod-ensaio      format "x(08)"       at 21
     bfDigita.desc-dimensao   format "x(30)"       at 31
     cDescStatus              format "x(25)"       at 63
     cDescLog                 format "x(05)"       at 89 
     bfDigita.des-val-restdo  format "x(25)"       at 98 
     with width 132 no-attr-space no-box down frame f-dados stream-io. 
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-dados:HANDLE).
      


form cVal-min                 format "x(25)"        at 03      
     cVal-max                 format "x(25)"        at 30   
     bfDigita.num-tabela                            at 56                
     cDatResult               format "X(25)"        at 63   
     cDatResultAnt            format "X(25)"        at 89   
     cDescResult                                    at 115  
     with width 132 no-attr-space no-box down frame f-historico stream-io. 
/* Inicio -- Projeto Internacional -- ut-trfrrp.p adicionado */
RUN utp/ut-trfrrp.p (INPUT FRAME f-historico:HANDLE).
 
     
form cObs           at 37 
     "------------" at 37
     with width 132 no-labels no-attr-space no-box down frame f-obs stream-io.  
     
   

/*****************************************************************************/
                                               /** Literais Form Parƒmetros **/
{utp/ut-liter.i Usu rio * l}
assign tt-param.usuario:label in frame f-param-definidos = trim(return-value).

{utp/ut-liter.i Destino * l}
assign c-destino:label in frame f-param-definidos = trim(return-value).

{utp/ut-liter.i Tipo_de_Relat¢rio * l}
assign tt-param.iTipo:label in frame f-param-definidos = trim(return-value).

{utp/ut-liter.i Quebra_p gina_por_documento * l}
assign tt-param.lQuebra:label in frame f-param-definidos = trim(return-value).

{utp/ut-liter.i Imprime_Hist¢rico * l}
assign tt-param.lHistorico:label in frame f-param-definidos = trim(return-value).

{utp/ut-liter.i Imprime_Observa‡Æo * l}
assign tt-param.lObs:label in frame f-param-definidos = trim(return-value).

{utp/ut-liter.i Tipo_de_Relat¢rio * l}
assign tt-param.iTipo:label in frame f-param-definidos = trim(return-value).

{utp/ut-liter.i PAR¶METROS * R}
assign c-liter-par = trim(return-value).

{utp/ut-liter.i IMPRESSÇO * R}
assign c-liter-imp = trim(return-value).
   {utp/ut-liter.i Sim/NÆo}
assign  tt-param.lObs:FORMAT in frame f-param-definidos       = return-value
        tt-param.lQuebra:FORMAT in frame f-param-definidos    = return-value
        tt-param.lHistorico:format in frame f-param-definidos = return-value.
        
{utp/ut-liter.i Observa‡Æo * } 
assign cObs = trim(return-value). 

/*****************************************************************************/
                                                    /** Literais Form Dados **/
{utp/ut-liter.i "Estado"}
assign cDescStatus:label in frame f-dados = trim(return-value).
{utp/ut-liter.i "PadrÆo"}
assign cDescLog:label in frame f-dados = trim(return-value).
{utp/ut-liter.i "Resultado"}
assign bfDigita.des-val-restdo:label in frame f-dados = trim(return-value).
{utp/ut-liter.i "M ximo"}
assign cVal-max:label in frame f-historico = trim(return-value).
{utp/ut-liter.i "M¡nimo"}
assign cVal-min:label in frame f-historico = trim(return-value).
{utp/ut-liter.i "Tabela"}
assign bfDigita.num-tabela:label in frame f-historico  = trim(return-value).
{utp/ut-liter.i Tipo_de_Resultado * }
assign cDescResult:label in frame f-historico  = trim(return-value).
{utp/ut-liter.i "Ensaio"}
assign bfDigita.cod-ensaio:label in frame f-dados  = trim(return-value).
{utp/ut-liter.i "Descri‡Æo"}
assign bfDigita.desc-dimensao:label in frame f-dados  = trim(return-value).
/*****************************************************************************/
                                                         /** Fim da Include **/
