  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .


  assign  c-lista = rs-modulo:radio-buttons in frame f-pg-par.

 {utp/ut-liter.i Contas_a_Pagar * L}
  assign entry(1,c-lista)= return-value.

  {utp/ut-liter.i Contas_a_Receber * L}
  assign entry(3,c-lista)= return-value.

  {utp/ut-liter.i Caixa_e_Bancos * L}
  assign entry(5,c-lista)= return-value.

  {utp/ut-liter.i Conta_Corrente_Representante * L}
  assign entry(7,c-lista)= return-value.

  {utp/ut-liter.i RETORNAR_: * L}
  assign c-modulo:screen-value in frame f-pg-par = return-value. 

  assign rs-modulo:radio-buttons in frame f-pg-par = c-lista.

  &IF DEFINED(BF_FIN_RAC)  &THEN  
      find first param-global no-lock no-error.
      if  param-global.modulo-rac = no then
          IF rs-modulo:DISABLE(entry(7,c-lista)) IN FRAME f-pg-par THEN.
  &ELSE
      IF  rs-modulo:DELETE(entry(7,c-lista)) IN FRAME f-pg-par THEN.
  &ENDIF 

  {cdp/cd1202.i}
  if  l-tesou-ems5 then do:
      IF rs-modulo:DISABLE(entry(5,c-lista)) IN FRAME f-pg-par THEN.
  end.


  /* Code placed here will execute AFTER standard behavior.    */

END PROCEDURE.

