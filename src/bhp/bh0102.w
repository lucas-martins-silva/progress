&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE pi-executar C-Win 
PROCEDURE pi-executar :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

do  on error undo, return error
    on stop  undo, return error:     

    {include/i-rpexa.i}

    if  input frame f-pg-imp rs-destino = 2 then do:
        run utp/ut-vlarq.p (input input frame f-pg-imp c-arquivo).
        if  return-value = "nok" then do:
            run utp/ut-msgs.p (input "show",
                               input 73,
                               input "").
            apply 'mouse-select-click' to im-pg-imp in frame f-relat.
            apply 'entry' to c-arquivo in frame f-pg-imp.                   
            return error.
        end.
    end.

    find empresa NO-LOCK where empresa.ep-codigo = input frame f-pg-par i-emp no-error.
    if not avail empresa then do:     
       run utp/ut-msgs.p (input "SHOW",
                          input 327, 
                          input trim(i-emp:label in frame f-pg-par)).                        
       apply 'mouse-select-click' to im-pg-par in frame f-relat.
       apply 'entry' to i-emp in frame f-pg-par.
       return error.       
    end.

    /****** BANCOS HIST‡RICOS *****/
    {cdp/cd1000.i}
    /******************************/
    if  l-funcao-banc-hist-adm = no then do:
        {utp/ut-liter.i "Estrutura_nao_permite_historico" * R}
        run utp/ut-msgs.p(input "show",
                          input 29869,
                          input return-value).

        RETURN "OK":U.
    end.



     if  integer(substring(input frame f-pg-par c-per,5,2)) < 01
        or  integer(substring(input c-per,5,2)) > 12 
        or  integer(substring(input c-per,1,4)) = 0 then do:
        run utp/ut-msgs.p (input "SHOW",
                            input 333, 
                            input trim(c-per:label in frame f-pg-par)).                        
        apply 'mouse-select-click' to im-pg-par in frame f-relat.
        apply 'entry' to c-per in frame f-pg-par.
        return error.       
    end.

    assign da-corte = date(integer(substring(input frame f-pg-par c-per,5,2)),
                      01,
                      integer(substring(input c-per,1,4))).

    /* Coloque aqui as validaá‰es das outras p†ginas, lembrando que elas
       devem apresentar uma mensagem de erro cadastrada, posicionar na p†gina 
       com problemas e colocar o focus no campo com problemas             */    

    create tt-param.
    assign tt-param.usuario         = c-seg-usuario
           tt-param.destino         = input frame f-pg-imp rs-destino
           tt-param.data-exec       = today
           tt-param.hora-exec       = time
           tt-param.i-emp           = input frame f-pg-par i-emp
           tt-param.c-per           = input frame f-pg-par c-per
           tt-param.L-ap            = NO
           tt-param.L-cr            = NO
           tt-param.L-cb            = NO
           tt-param.l-rac           = NO 
           tt-param.da-corte        = da-corte.

    CASE input frame f-pg-par rs-modulo :
         WHEN 1 THEN assign tt-param.l-ap   = yes.
         WHEN 2 THEN assign tt-param.l-cr = yes.
         WHEN 3 THEN assign tt-param.l-cb   = yes.
         WHEN 4 THEN assign tt-param.l-rac            = yes.
    END CASE. 


    if  tt-param.destino = 1 then           
        assign tt-param.arquivo = "".
    else
    if  tt-param.destino = 2 then 
        assign tt-param.arquivo = input frame f-pg-imp c-arquivo.
    else
        assign tt-param.arquivo = session:temp-directory + c-programa-mg97 + ".tmp".

    /* Coloque aqui a l¢gica de gravaá∆o dos parÉmtros e seleá∆o na temp-table
       tt-param */ 

    {include/i-rpexb.i}

    if  session:set-wait-state("general") then.
   /*Pergunta de confirmaá∆o */

     run utp/ut-msgs.p (input "show",
                       input 6849,
                       input "").

    if return-value = "no"  then
       return "adm-error".
    else do:
           {include/i-rprun.i bhp\bh0102rp.p}

           {include/i-rpexc.i}

           if  session:set-wait-state("") then.

           {include/i-rptrm.i}

    end.
end.
END PROCEDURE.

