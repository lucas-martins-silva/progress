/* Set CURRENT-WINDOW: this will parent dialog-boxes and frames.        */
ASSIGN CURRENT-WINDOW                = {&WINDOW-NAME} 
       THIS-PROCEDURE:CURRENT-WINDOW = {&WINDOW-NAME}.

{utp/ut9000.i "BH0301" "2.00.00.006"}

/* inicializaá‰es do template de relat¢rio */
{include/i-rpini.i}

/* The CLOSE event can be used from inside or outside the procedure to  */
/* terminate it.                                                        */
ON CLOSE OF THIS-PROCEDURE 
   RUN disable_UI.

{include/i-rplbl.i}

/* Best default for GUI applications is...                              */
PAUSE 0 BEFORE-HIDE.

/* Now enable the interface and wait for the exit condition.            */
/* (NOTE: handle ERROR and END-KEY so cleanup code will always fire.    */
MAIN-BLOCK:
DO  ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
    ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:

    /*{include/i-rpvar.i}*/
    RUN enable_UI.

    {utp/ut-liter.i Per°odo_de_Corte * L}
    assign da-per-corte:label in frame f-pg-par = return-value.

    find first param-global
        no-lock no-error.

    if  not avail param-global then do:
        run utp/ut-msgs.p (input "show",
                           input 7006,
                           input "").
        return error.
    end.

    assign i-empresa = param-global.empresa-prin.

    if param-global.modulo-ce = yes then do:
        find first param-estoq no-lock no-error.

       if not avail param-estoq then do:
          {utp/ut-table.i mgind param-estoq 1}
          run utp/ut-msgs.p (input "show",
                             input 47,
                             input return-value).
          return error.
       end.

       {cep/ce9998.i}
       assign da-per-corte:screen-value in frame f-pg-par = string(param-estoq.ult-fech-dia,"99/99/9999").
    end.

    /* Verifica estrutura do banco */
    find first param-global
        no-lock no-error.
    if  not avail param-global or not param-global.modulo-bh then do:
        {utp/ut-liter.i "Estrutura_nao_permite_historico" * R}
        run utp/ut-msgs.p(input "show",
                          input 8035,
                          input return-value).
        return error.
    end.

    {include/i-rpmbl.i im-pg-par}

    IF  NOT THIS-PROCEDURE:PERSISTENT THEN
        WAIT-FOR CLOSE OF THIS-PROCEDURE.
END.

