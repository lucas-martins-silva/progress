&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE pi-cria-tt-divisao-mg V-table-Win 
PROCEDURE pi-cria-tt-divisao-mg :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  p-ind-tipo-movto (1-Inclus∆o 2-Alteraá∆o 3-Exclus∆o)
  Notes:       Integraá∆o EMS 2.04 x Magnus I.01
------------------------------------------------------------------------------*/
    def input param p-ind-tipo-movto as int no-undo.
    def input param p-atualiza       as log no-undo.
    
    for each tt-divisao-mg:
        delete tt-divisao-mg.
    end.

    create tt-divisao-mg.
    assign tt-divisao-mg.ind-tipo-movto = p-ind-tipo-movto
           tt-divisao-mg.ep-codigo = divisao.ep-codigo
           tt-divisao-mg.di-codigo = divisao.di-codigo
           tt-divisao-mg.descricao = fn-free-accent(divisao.descricao)
           tt-divisao-mg.l-atualiza = p-atualiza.
    assign tt-divisao-mg.dec-1     = divisao.dec-1
           tt-divisao-mg.int-1     = divisao.int-1
           tt-divisao-mg.log-1     = divisao.log-1
           tt-divisao-mg.char-1    = fn-free-accent(divisao.char-1).
    assign tt-divisao-mg.char-2    = fn-free-accent(divisao.char-2)
           tt-divisao-mg.dec-2     = divisao.dec-2
           tt-divisao-mg.int-2     = divisao.int-2.

END PROCEDURE.

