&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-assign-record V-table-Win 
PROCEDURE local-assign-record :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */
   
   if  not frame {&frame-name}:validate() then
      return 'ADM-ERROR':U. 
   if  divisao.di-codigo:sensitive in frame {&frame-name} then do:
       if input frame {&frame-name} divisao.di-codigo = 0 then do:
          run utp/ut-msgs.p (input "show":U,
                              input 3384, 
                              input return-value).
          apply "entry" to divisao.di-codigo in frame {&frame-name}.                   
          return 'ADM-ERROR':U.
       end. 
  
       if input frame {&frame-name} divisao.di-codigo <> 0
          and can-find (divisao where divisao.di-codigo = input frame {&frame-name} divisao.di-codigo and divisao.ep-codigo = i-ep-codigo-usuario) then do:
          {utp/ut-field.i mguni divisao di-codigo 1}
          run utp/ut-msgs.p (input "show":U,
                             input 5243, 
                             input return-value).
          apply "entry" to divisao.di-codigo in frame {&frame-name}.                   
          return 'ADM-ERROR':U.
       end.
  end.
  if return-value = 'ADM-ERROR':U then
     return 'ADM-ERROR':U.
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'assign-record':U ) .
  if  avail divisao then do:
      assign divisao.ep-codigo = i-ep-codigo-usuario.
  end.

  /*Integraá∆o EMS 2.04 x Magnus I.01*/
  {cdp/cd0002i1.i divisao}

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
