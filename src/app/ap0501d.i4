/******************************************************************************
***
***  app/ap0501d.i4 - Valida‡Æo Casas Decimais Moeda - lin-conta-ap.
***
***  ***** NÆo foram validados os atributos 
***  ***** vl-movto-fasb
***  ***** vl-movto-presente
***  ***** vl-movto-cmi
******************************************************************************/

/* Verifica Decimais para vl-movto */
assign l-rejeita-dec  = no.
assign de-tt-valor-valida = fn_vld_ajust_dec(lin-conta-ap.vl-movto,0).
if  l-rejeita-dec then do:
    {utp/ut-field.i mgadm lin-conta-ap vl-movto 1}
    run utp/ut-msgs.p(input "help", 
                      input 18130, 
                      input trim(return-value)).
    assign l-situacao = no
           i-num-erro = 18130
           c-cod-msg  = string(lin-i-ap.ep-codigo)  + " , " +
                        string(lin-i-ap.referencia) + " , " +
                        string(lin-i-ap.sequencia)  + " , " +
                        string(lin-i-ap.seq-import).       
    {app/ap0501d.i "18130"}
end.

/* Verifica Decimais para vl-movto-me */
assign l-rejeita-dec  = no.
assign de-tt-valor-valida = fn_vld_ajust_dec(lin-conta-ap.vl-movto-me,lin-i-ap.mo-codigo).
if  l-rejeita-dec then do:
    {utp/ut-field.i mgadm lin-conta-ap vl-movto-me 1}
    run utp/ut-msgs.p(input "help", 
                      input 18130, 
                      input trim(return-value)).
    assign l-situacao = no
           i-num-erro = 18130
           c-cod-msg  = string(lin-i-ap.ep-codigo)  + " , " +
                        string(lin-i-ap.referencia) + " , " +
                        string(lin-i-ap.sequencia)  + " , " +
                        string(lin-i-ap.seq-import).       
    {app/ap0501d.i "18130"}
end.
