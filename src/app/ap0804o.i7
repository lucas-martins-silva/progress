if l-modulo-fc = yes then
   run pi-criar-tt-mov-ap.

if can-find(first tt-mov-ap) then do:
    disp c-div-cmcac 
         with frame f-div-cmcac.
end.

for each tt-mov-ap
    where tt-mov-ap.transacao <> 8
    and   l-modulo-fc = yes exclusive-lock:

    run pi-calcula-valores-cmcac.
    
    if tt-mov-ap.transacao = 2 then
       assign i-lancamento = 2.
    else
       assign i-lancamento = tt-mov-ap.lancamento.

    disp entry(tt-mov-ap.transacao, c-lista-trans) @ c-transac
         tt-mov-ap.dt-transacao
         tt-mov-ap.dt-vencimen
         entry(i-lancamento, c-lista-lanc) @ c-lancto
         tt-mov-ap.referencia
         tt-mov-ap.vl-desc-cmi   
         tt-mov-ap.vl-juros-cmi  
         tt-mov-ap.vl-ant-cmi    
         tt-mov-ap.valor-presente
         tt-mov-ap.acerto-cmi    
         tt-mov-ap.ganho-perda
         de-saldo-cmi
         de-saldo-vl-pres
         with frame f-cmcac.
    down with frame f-cmcac.
end.
