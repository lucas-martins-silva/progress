/* Forma de pagto */

if  i-op-banco = 1
or  i-op-banco = 041
or  i-op-banco = 275
or  i-op-banco = 356
or  i-op-banco = 237
or  i-op-banco = 341 
or  i-op-banco = 409
or  i-op-banco = 422
or  i-op-banco = 230
or  i-op-banco = 479
or  i-op-banco = 399
or  i-op-banco = 291
or  i-op-banco = 745 then do:
    assign i-nr-banco = tt-digita.banco
           c-agencia  = trim(tt-digita.agencia)
           c-cc-forn  = trim(tt-digita.cta-corrente).
end.

