/********************************************************************************
**
** app/ap0505d.i12 - Include chama programas de c lculo do IR
**
********************************************************************************/
   assign de-base-ir = 0. 
   assign de-base-ir = lin-b-ap.vl-baixa + lin-b-ap.vl-juros - lin-b-ap.vl-desconto.
 
   run app/ap0501ba.p (input tit-ap.tp-codigo, 
                       input de-base-ir,
                       input lin-b-ap.cod-fornec,
                       input lin-b-ap.dt-baixa,
                       input 1,                     /*origem AP*/
                       input 2,                     /*Baixa*/
                       input 1,                     /*modifica*/                       
                       output de-valor-ir,
                       output de-perc-faixa,
                       output r-tab-acum-emi).                       
                       
    
    if  de-valor-ir > 0 then do:
        run app/ap0503b.w (input rowid(lin-b-ap),
                           input rowid(doc-b-ap), 
                           input 1,                   /*origem AP*/ 
                           input 5,                   /*executor*/ 
                           input 1,                   /*incluir*/
                           input 2,                   /*Baixa*/
                           input de-valor-ir,
                           input de-perc-faixa,
                           input r-tab-acum-emi).
                                          
    end.   

/* fim da include */
