/********************************************************************************
***
*** app/ap0518b.i4 - Gera Movimento IMP para a nova AN.
***
********************************************************************************/
                
create mov-ap.
assign mov-ap.ep-codigo      = tit-ap.ep-codigo
       mov-ap.cod-estabel    = tit-ap.cod-estabel
       mov-ap.cod-fornec     = tit-ap.cod-fornec
       mov-ap.cod-esp        = tit-ap.cod-esp
       mov-ap.serie          = tit-ap.serie
       mov-ap.nr-docto       = tit-ap.nr-docto
       mov-ap.parcela        = tit-ap.parcela
       mov-ap.nome-abrev     = tit-ap.nome-abrev
       mov-ap.origem         = tit-ap.origem
       mov-ap.dt-emissao     = tit-ap.dt-emissao
       mov-ap.dt-vencimen    = tit-ap.dt-vencimen
       mov-ap.dt-transacao   = tit-ap.dt-transacao
       mov-ap.moeda          = tit-ap.moeda
       mov-ap.cotacao-dia    = tit-ap.cotacao-dia
       mov-ap.valor-mov-me   = tit-ap.vl-orig-me
       mov-ap.valor-mov      = tit-ap.vl-original
       mov-ap.referencia     = tit-ap.referencia
       mov-ap.esp-ant        = tit-ap.esp-ant
       mov-ap.serie-ant      = tit-ap.serie-ant
       mov-ap.docto-ant      = tit-ap.docto-ant
       mov-ap.parc-ant       = tit-ap.parc-ant
       mov-ap.fornec-ant     = tit-ap.cod-fornec
       mov-ap.tp-codigo      = tit-ap.tp-codigo
       mov-ap.transacao      = 1
       mov-ap.tipo           = 2
       mov-ap.vl-mov-fasb    = 0
       mov-ap.portador       = 0
       mov-ap.modalidade     = 1
       mov-ap.ct-conta       = conta-contab.ct-codigo
       mov-ap.sc-conta       = conta-contab.sc-codigo
       mov-ap.conta-contabil = conta-contab.conta-contabil
       mov-ap.dt-today       = today
       mov-ap.c-time         = string(time, "HH:MM")
       mov-ap.usuario        = c-seg-usuario
       mov-ap.historico      = trim(c-historico)
       mov-ap.hp-codigo      = i-hp-codigo.
            
/********* Multiplanta ***********/  
run pi-cria-tt-dados-mov-ap (input 1).     
/******* Fim-Multiplanta *********/ 
        
/*--- INTEGRA€åES ---*/
{app/ap9100.i2}
assign tt-integ-ap.tt-row-mov-ap  = rowid(mov-ap)
       tt-integ-ap.tt-fc1014a     = yes
       tt-integ-ap.tt-fc1114a     = yes.
raw-transfer tt-integ-ap to raw-integracao.
run app/ap9100.p (Input raw-integracao, input-output table tt-erro).
        
/* Fim de Include */
