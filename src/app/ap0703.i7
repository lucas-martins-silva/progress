/******************************************************************************
**
**  AP0703.i7 - Acumula valores p/ grupo de fornecedores
**
******************************************************************************/

    if  tit-ap.dt-vencimen <= tt-param.resumo then do:
        assign nr-dias = tt-param.resumo - tit-ap.dt-vencimen.
        if  nr-dias <= i-venc-30
        and avail w-grupo-for then
            assign w-grupo-for.ven-30 = w-grupo-for.ven-30 + de-saldo
                   w-grupo-for.tot    = w-grupo-for.tot    + de-saldo.
        else
            if  nr-dias >= tt-param.venc-31 and nr-dias <= tt-param.venc-60
            and avail  w-grupo-for then
                assign w-grupo-for.ven-60 = w-grupo-for.ven-60 + de-saldo
                       w-grupo-for.tot    = w-grupo-for.tot    + de-saldo.
            else
                if  nr-dias >= tt-param.venc-61 and nr-dias <= tt-param.venc-90
                and avail  w-grupo-for then
                    assign w-grupo-for.ven-90 = w-grupo-for.ven-90 + de-saldo
                           w-grupo-for.tot    = w-grupo-for.tot    + de-saldo.
                else
                    if  nr-dias >= i-venc-91
                    and avail  w-grupo-for then
                        assign w-grupo-for.ven-999 = w-grupo-for.ven-999 + de-saldo
                               w-grupo-for.tot     = w-grupo-for.tot     + de-saldo.
    end.
    else do:
        assign nr-dias = tit-ap.dt-vencimen - tt-param.resumo.
        if  nr-dias <= i-a-venc-30
        and avail  w-grupo-for then
            assign w-grupo-for.ven1-30 = w-grupo-for.ven1-30 + de-saldo
                   w-grupo-for.tot1    = w-grupo-for.tot1    + de-saldo.
        else
            if  nr-dias >= tt-param.a-venc-31 and nr-dias <= tt-param.a-venc-60
            and avail  w-grupo-for then
                assign w-grupo-for.ven1-60 = w-grupo-for.ven1-60 + de-saldo
                       w-grupo-for.tot1    = w-grupo-for.tot1    + de-saldo.
            else
                if  nr-dias >= tt-param.a-venc-61 and nr-dias <= tt-param.a-venc-90
                and avail  w-grupo-for then
                    assign w-grupo-for.ven1-90 = w-grupo-for.ven1-90 + de-saldo
                           w-grupo-for.tot1    = w-grupo-for.tot1    + de-saldo.
                else
                    if  nr-dias >= tt-param.a-venc-91 and nr-dias <= tt-param.a-venc-120
                    and avail w-grupo-for then
                       assign w-grupo-for.ven1-120 = w-grupo-for.ven1-120 + de-saldo
                              w-grupo-for.tot1     = w-grupo-for.tot1 + de-saldo.
                    else
                        if  nr-dias >= i-a-venc-121
                        and avail  w-grupo-for then
                            assign w-grupo-for.ven1-999 = w-grupo-for.ven1-999 + de-saldo
                                   w-grupo-for.tot1     = w-grupo-for.tot1 + de-saldo.
    end.

/* fim-de-programa */
