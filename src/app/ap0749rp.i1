/******************************************************************************
***
*** app/ap0749rp.i1 - Temp-Tables.
***
******************************************************************************/

define temp-table tt-param no-undo
    field destino               as integer
    field arquivo               as char format "x(35)"
    field usuario               as char format "x(12)"
    field data-exec             as date
    field hora-exec             as integer
    field classifica            as integer
    field desc-classifica       as char format "x(40)"
    field cod-estabel-ini       as CHARACTER FORMAT "X(3)":U
    field cod-estabel-fin       as CHARACTER FORMAT "X(3)":U
    field cod-esp-ini           as CHARACTER FORMAT "!!":U 
    field cod-esp-fin           as CHARACTER FORMAT "!!":U 
    field cod-emitente-ini      as INTEGER   FORMAT ">>>>>>>>9":U
    field cod-emitente-fin      as INTEGER   FORMAT ">>>>>>>>9":U
    field dt-trans-ini          as DATE      FORMAT "99/99/9999":U
    field dt-trans-fin          as DATE      FORMAT "99/99/9999":U
    field dt-venci-ini          as DATE      FORMAT "99/99/9999":U
    field dt-venci-fin          as DATE      FORMAT "99/99/9999":U
    field l-tit-subs            as log     
    field l-nota-db-cr          as log
    field c-origem              as char      
    field ep-codigo             as INTEGER
    field imp-par               as logical
    FIELD referencia-ini        LIKE mov-ap.referencia
    FIELD referencia-fim        LIKE mov-ap.referencia.

def temp-table tt-raw-digita no-undo
   field raw-digita      as raw.

def temp-table tt-mov-ap no-undo like mov-ap.    
