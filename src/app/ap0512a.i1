***
*** app/ap0512a.i1 - Defini‡Æo de Form's e variaveis.
*** Parameters :  {1} Preprocessador &BASE 
*******************************************************************************/
/*--- tt-log-erro-ap ---*/
{app/ap0512a.i5 {1}}

def temp-table tt-mov no-undo  /*--- BUFFER TEMPORARIO PARA OS DOCTOS  ---*/
    field r-rowid as rowid     /*--- QUE SAO ELIMINADOS RECURSIVAMENTE ---*/
    field l-erro  as logical
    index codigo is unique primary
      r-rowid
    index erro
      l-erro.

def buffer b3-tit-ap  for {1}tit-ap.
def buffer b2-mov-ap  for {1}mov-ap.
def buffer b-tt-mov   for tt-mov.

def var c-erro          as char format "x(60)" no-undo.
def var c-reg-lidos     as char format "x(80)" no-undo.
def var c-reg-elim      as char format "x(80)" no-undo.
def var c-acompanha     as char                no-undo.
def var r-tit-ap        as rowid               no-undo.
def var h-acomp         as handle              no-undo.

/*--- Fim de AP0512A.I1 ---*/
