/*******************************************************************************
***
*** app/apapi17b.i4 - Atualizaá∆o Impostos.
***
*******************************************************************************/

for each tt-imposto:

    assign i-sequencia = 1.

    repeat:
        find first impto-tit-ap no-lock
             where impto-tit-ap.ep-codigo     = tit-ap.ep-codigo
             and   impto-tit-ap.cod-estabel   = tit-ap.cod-estabel
             and   impto-tit-ap.cod-fornec    = tit-ap.cod-fornec
             and   impto-tit-ap.cod-esp       = tit-ap.cod-esp
             and   impto-tit-ap.serie         = tit-ap.serie
             and   impto-tit-ap.nr-docto      = tit-ap.nr-docto
             and   impto-tit-ap.parcela       = tit-ap.parcela 
             and   impto-tit-ap.num-seq-impto = i-sequencia no-error.

        if  avail impto-tit-ap then
            assign i-sequencia = i-sequencia + 1.
        else
            leave.
    end.    

    create impto-tit-ap.
    assign impto-tit-ap.ep-codigo           = tit-ap.ep-codigo
           impto-tit-ap.cod-estabel         = tit-ap.cod-estabel
           impto-tit-ap.cod-fornec          = tit-ap.cod-fornec
           impto-tit-ap.cod-esp             = tit-ap.cod-esp
           impto-tit-ap.serie               = tit-ap.serie
           impto-tit-ap.nr-docto            = tit-ap.nr-docto
           impto-tit-ap.parcela             = tit-ap.parcela
           impto-tit-ap.dt-emissao          = tit-ap.dt-emissao
           impto-tit-ap.dt-transacao        = tit-ap.dt-transacao
           impto-tit-ap.dt-vencimen         = tit-ap.dt-vencimen
           impto-tit-ap.cod-imposto         = tt-imposto.cod-imposto
           impto-tit-ap.perc-imposto        = tt-imposto.perc-imposto
           impto-tit-ap.perc-percepcao      = tt-imposto.perc-percepcao
           impto-tit-ap.perc-retencao       = tt-imposto.perc-retencao
           impto-tit-ap.conta-imposto       = tt-imposto.conta-imposto
           impto-tit-ap.conta-percepcao     = tt-imposto.conta-percepcao
           impto-tit-ap.conta-retencao      = tt-imposto.conta-retencao
           impto-tit-ap.mo-codigo           = tt-nota-debito-credito.moeda
           impto-tit-ap.cotacao-dia         = tt-nota-debito-credito.cotacao-dia
           impto-tit-ap.trans-impto-ap      = 16
           impto-tit-ap.origem-impto        = 13
           impto-tit-ap.contabilizou        = if i-pais-impto-usuario <> 4 then yes else no
           impto-tit-ap.num-seq-impto       = i-sequencia
           impto-tit-ap.num-id-mov-ap       = i-num-id-mov-ap.

    /*--- Atualizaá∆o Valores ---*/
    assign impto-tit-ap.vl-base-me          = fn_ajust_dec(tt-imposto.vl-base-me, tt-nota-debito-credito.moeda)
           impto-tit-ap.vl-imposto-me       = fn_ajust_dec(tt-imposto.vl-imposto-me, tt-nota-debito-credito.moeda)
           impto-tit-ap.vl-saldo-imposto-me = fn_ajust_dec(tt-imposto.vl-imposto-me, tt-nota-debito-credito.moeda)
           impto-tit-ap.vl-percepcao-me     = fn_ajust_dec(tt-imposto.vl-percepcao-me, tt-nota-debito-credito.moeda)
           impto-tit-ap.vl-retencao-me      = fn_ajust_dec(tt-imposto.vl-retencao-me, tt-nota-debito-credito.moeda).

    if  impto-tit-ap.mo-codigo = 0 then do:
        assign impto-tit-ap.vl-base             = fn_ajust_dec(tt-imposto.vl-base-me, impto-tit-ap.mo-codigo)
               impto-tit-ap.vl-imposto          = fn_ajust_dec(tt-imposto.vl-imposto-me, impto-tit-ap.mo-codigo)
               impto-tit-ap.vl-saldo-imposto    = fn_ajust_dec(tt-imposto.vl-imposto-me, impto-tit-ap.mo-codigo)
               impto-tit-ap.vl-percepcao        = fn_ajust_dec(tt-imposto.vl-percepcao-me, impto-tit-ap.mo-codigo)
               impto-tit-ap.vl-retencao         = fn_ajust_dec(tt-imposto.vl-retencao-me, impto-tit-ap.mo-codigo).
    end.
    else do:
        /*** Divis∆o do assign  para evitar erros no Progress 9 ***/
        assign impto-tit-ap.vl-base             = fn_ajust_dec(fn_conv_moedas (
                                                                  tt-imposto.vl-base-me,
                                                                  impto-tit-ap.cotacao-dia,
                                                                  impto-tit-ap.mo-codigo,
                                                                  0),0).
        assign impto-tit-ap.vl-imposto          = fn_ajust_dec(fn_conv_moedas (
                                                                  tt-imposto.vl-imposto-me,
                                                                  impto-tit-ap.cotacao-dia,
                                                                  impto-tit-ap.mo-codigo,
                                                                  0),0).
        assign impto-tit-ap.vl-saldo-imposto    = fn_ajust_dec(fn_conv_moedas (
                                                                  tt-imposto.vl-imposto-me,
                                                                  impto-tit-ap.cotacao-dia,
                                                                  impto-tit-ap.mo-codigo,
                                                                  0),0).
        assign impto-tit-ap.vl-percepcao        = fn_ajust_dec(fn_conv_moedas (
                                                                  tt-imposto.vl-percepcao-me,
                                                                  impto-tit-ap.cotacao-dia,
                                                                  impto-tit-ap.mo-codigo,
                                                                  0),0).
        assign impto-tit-ap.vl-retencao         = fn_ajust_dec(fn_conv_moedas (
                                                                  tt-imposto.vl-retencao-me,
                                                                  impto-tit-ap.cotacao-dia,
                                                                  impto-tit-ap.mo-codigo,
                                                                  0),0).
    end.

    /*--- Atualizaá∆o Conta Imposto ---*/
    find first conta-contab no-lock
         where conta-contab.ep-codigo      = impto-tit-ap.ep-codigo
         and   conta-contab.conta-contabil = impto-tit-ap.conta-imposto no-error.

    if  avail conta-contab then do:
        assign impto-tit-ap.ct-imposto     = conta-contab.ct-codigo
               impto-tit-ap.sc-imposto     = conta-contab.sc-codigo.
    end.

    /*--- Atualizaá∆o Conta Percepá∆o ---*/
    find first conta-contab no-lock
         where conta-contab.ep-codigo      = impto-tit-ap.ep-codigo
         and   conta-contab.conta-contabil = impto-tit-ap.conta-percepcao no-error.

    if  avail conta-contab then do:
        assign impto-tit-ap.ct-percepcao   = conta-contab.ct-codigo
               impto-tit-ap.sc-percepcao   = conta-contab.sc-codigo.
    end.

    /*--- Atualizaá∆o Conta Retená∆o ---*/
    find first conta-contab no-lock
         where conta-contab.ep-codigo      = impto-tit-ap.ep-codigo
         and   conta-contab.conta-contabil = impto-tit-ap.conta-retencao no-error.

    if  avail conta-contab then do:
        assign impto-tit-ap.ct-retencao    = conta-contab.ct-codigo
               impto-tit-ap.sc-retencao    = conta-contab.sc-codigo.
    end.

    find first tipo-tax no-lock
         where tipo-tax.cod-tax = impto-tit-ap.cod-imposto no-error.
    if  avail tipo-tax then do:
        if  tit-ap.tipo = 4 then do:
            if tipo-tax.tipo = 2 then
               assign impto-tit-ap.lancamento = 1.
            else
               assign impto-tit-ap.lancamento = 2.
        end.
        else do:
            if  tit-ap.tipo = 5 then do:
                if tipo-tax.tipo = 2 then
                   assign impto-tit-ap.lancamento = 2.
                else
                   assign impto-tit-ap.lancamento = 1.
            end.
        end. 

        assign impto-tit-ap.tipo              = tipo-tax.tipo
               impto-tit-ap.ind-data-base     = tipo-tax.ind-data-base
               impto-tit-ap.cod-classificacao = tipo-tax.cod-classificacao
               impto-tit-ap.ind-tipo-imposto  = tipo-tax.ind-tipo-imposto.
    end.
end. 

/* Fim de Include */
