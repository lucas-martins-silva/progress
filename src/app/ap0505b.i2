/****************************************************************************
***
*** app/ap0505b.i2 - Verifica existˆncia de antecipa‡Æo.
***
*****************************************************************************/

assign l-antecipacao = no.

if  avail lin-b-ap then do:

    find first espec-ap no-lock where espec-ap.cod-esp = lin-b-ap.cod-esp no-error.
    if  avail espec-ap then do:
                        
        if  espec-ap.usa-antec = yes then do:

            find first tit-ap no-lock
                 where tit-ap.ep-codigo    = lin-b-ap.ep-codigo
                 and   tit-ap.cod-estabel  = lin-b-ap.cod-estabel
                 and   tit-ap.cod-fornec   = lin-b-ap.cod-fornec
                 and   tit-ap.tipo         = 2
                 and   tit-ap.vl-saldo     > 0 no-error.   
                    
            if  not avail tit-ap then do:
                        
                /*----- Verifica se a matriz possui antecipa‡Æo -----*/
                find first emitente
                     where emitente.cod-emitente = lin-b-ap.cod-fornec
                     and   emitente.identific   <> 1 
                     no-lock no-error.
                          
                if  avail emitente then do: 
                    find first b-emitente
                         where b-emitente.nome-abrev   = emitente.nome-matriz
                         and   b-emitente.identific   <> 1 no-lock no-error.
                                  
                    if  avail b-emitente then do: 

                        {utp/ut-liter.i Matriz map C}
                        assign c-fornecedor = trim(return-value).                    

                        find first tit-ap use-index matriz
                             where tit-ap.ep-codigo       = lin-b-ap.ep-codigo
                             and   tit-ap.cod-estabel     = lin-b-ap.cod-estabel
                             and   tit-ap.matriz          = b-emitente.cod-emitente
                             and   tit-ap.tipo            = 2 
                             and   tit-ap.valor-saldo     > 0 
                             no-lock no-error.
                              
                        if  avail tit-ap then do:
                            {utp/ut-liter.i Matriz map C}
                            assign c-fornecedor  = trim(return-value)
                                   l-antecipacao = yes.
                        end.

                    end.
                end.
            end.
            else do:
                {utp/ut-liter.i Fornecedor map C}
                assign c-fornecedor  = trim(return-value)
                       l-antecipacao = yes.
            end.
             
            
            if  l-antecipacao = yes then do:
                    
                run utp/ut-msgs.p (input "show",
                                   input 17241,
                                   input trim(c-fornecedor)).
                                   
                if  return-value = 'yes' then do:
                    if can-find(first impto-tit-pend-ap no-lock
                                where impto-tit-pend-ap.ep-codigo   = lin-b-ap.ep-codigo
                                  and impto-tit-pend-ap.cod-estabel = lin-b-ap.cod-estabel
                                  and impto-tit-pend-ap.cod-esp     = lin-b-ap.cod-esp
                                  and impto-tit-pend-ap.serie       = lin-b-ap.serie
                                  and impto-tit-pend-ap.nr-docto    = lin-b-ap.nr-docto
                                  and impto-tit-pend-ap.parcela     = lin-b-ap.parcela
                                  and impto-tit-pend-ap.cod-fornec  = lin-b-ap.cod-fornec
                                &if "{&mgadm_version}" >= "2.07" &then
                                  and impto-tit-pend-ap.cdn-empres-pagto  = lin-b-ap.ep-codigo
                                  and impto-tit-pend-ap.cod-refer-pagto   = lin-b-ap.referencia
                                  and impto-tit-pend-ap.num-seq-pagto     = lin-b-ap.sequencia
                                &else
                                  and trim(substr(impto-tit-pend-ap.char-2,01,03)) = string(lin-b-ap.ep-codigo)
                                  and trim(substr(impto-tit-pend-ap.char-2,04,10)) = lin-b-ap.referencia
                                  and trim(substr(impto-tit-pend-ap.char-2,14,06)) = string(lin-b-ap.sequencia)
                                &endif
                                  and impto-tit-pend-ap.trans-impto-ap = 2 /* baixa */ ) then do:
                        run utp/ut-msgs.p (input "show", input 31802, input "").
                    end.
                    else
                       if  l-provisao then
                           run app/ap0555.w (input no,
                                             input rowid(lin-b-ap),
                                             2). /* Antecipa‡Æo */
                       else
                                   run app/ap0555.w (input no,
                                                     input rowid(lin-b-ap)).

                end.
            end.
        end.
    end.
end.
