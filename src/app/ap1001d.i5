/* Trailler do Arquivo */

put stream relat
    "9"                                                               at 001
    (i-hea-qua + 2)                                   format "999999" at 002
    de-hea-val                             format "99999999999999999" at 008
    (i-hea-qua + 2)                                   format "999999" at 495
    skip.



