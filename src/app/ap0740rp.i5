/*******************************************************************************
***
*** app/ap0740rp.i5 - last-of(tt-tit-ap.mes-vencto).
***
*******************************************************************************/

if  last-of(tt-tit-ap.mes-vencto) then do:
        
    if (de-tot-mes-orig  <> 0 or
        de-tot-mes-saldo <> 0) then do:
        
        disp "-----------------" @ tt-tit-ap.vl-original     
             "-----------------" @ tt-tit-ap.valor-saldo with frame f-detalhe.
                
        down with frame f-detalhe.
        
        if  de-tot-mes-orig > 0 then
            assign c-lancto-1 = c-credito.
        else
            assign c-lancto-1 = c-debito.
        
        if  de-tot-mes-saldo > 0 then
            assign c-lancto-2 = c-credito.
        else
            assign c-lancto-2 = c-debito.
        
        if  de-tot-mes-orig < 0 then
            assign de-tot-mes-orig = de-tot-mes-orig * (-1).
        
        if  de-tot-mes-saldo < 0 then
            assign de-tot-mes-saldo = de-tot-mes-saldo * (-1).
                
        put c-total-mes      at 46
            de-tot-mes-orig  to 103
            c-lancto-1       to 106
            de-tot-mes-saldo to 129
            c-lancto-2       to 132
            skip.
            
        assign de-tot-mes-orig  = 0
               de-tot-mes-saldo = 0.
           
    end.       
end.

/* Fim de Include */
