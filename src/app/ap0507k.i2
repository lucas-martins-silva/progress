/******************************************************
 ***
 *** AP0507k.i2 - Testa libera‡Æo da Fun‡Æo LOC-MAN-CHQ
 ***
 ******************************************************/

 def var v-log-func-utiliz-man-chq as logical initial no no-undo.

 &if defined(BF_FIN_LOC_MAN_CHEQUE) &then
     assign v-log-func-utiliz-man-chq = yes.
 &else
     if can-find(first funcao
                 where funcao.cd-funcao = "spp-loc-man-chq"
                   and funcao.ativo     = yes) then
         assign v-log-func-utiliz-man-chq = yes.
 &endif

 /* Fim ap0507k.i2 */
