/*******************************************************************************
***
*** app/ap0741rp.i19 - Classifica‡äes 1 e 5.
***
*******************************************************************************/
    
if  tt-param.log-cons-mo-orig = no then do:
    for each tt-mov-ap use-index {1} no-lock
        break by tt-mov-ap.ep-codigo
              by tt-mov-ap.cod-fornec
              {2}
              by tt-mov-ap.serie
              by tt-mov-ap.nr-docto
              by tt-mov-ap.parcela:
                
        /*------ Relat¢rio Detalhado ------*/
        if  tt-param.tp-relatorio = 1 then do:
            if  first-of(tt-mov-ap.cod-fornec) then
                run pi-primeira-quebra (input 1).
        end.
                
        run pi-display-detalhe (input 1).
            
        if  last-of(tt-mov-ap.cod-fornec) then
            run pi-ultima-quebra (input 1, 
                                  input tt-mov-ap.cod-fornec, 
                                  input tt-mov-ap.moeda,
                                  input yes).
            
    end.
            
    if  tt-param.log-saldo-movto = yes then
        run pi-listar-saldo-sem-movtos (input 1).
                
    run pi-total-geral.
        
    run pi-ferfil-compras.
            
end.
else do:
    for each tt-mov-ap use-index {1}a no-lock
        break by tt-mov-ap.ep-codigo
              by tt-mov-ap.moeda
              by tt-mov-ap.cod-fornec
              {2}
              by tt-mov-ap.serie
              by tt-mov-ap.nr-docto
              by tt-mov-ap.parcela:
            
        if  first-of(tt-mov-ap.moeda) then do:
                
            find first moeda where moeda.mo-codigo = tt-mov-ap.moeda no-lock no-error.
            if  avail moeda then do:
                put trim(c-moeda) format "x(08)"
                    " "
                    tt-mov-ap.moeda
                    " - "
                    moeda.descricao format "x(20)"
                    skip(1).
            end.
        end.
                
        /*------ Relat¢rio Detalhado ------*/
        if  tt-param.tp-relatorio = 1 then do:
            if  first-of(tt-mov-ap.cod-fornec) then
                run pi-primeira-quebra (input 1).
        end.
                
        run pi-display-detalhe (input 1).
                
        if  last-of(tt-mov-ap.cod-fornec) then
            run pi-ultima-quebra (input 1, 
                                  input tt-mov-ap.cod-fornec, 
                                  input tt-mov-ap.moeda,
                                  input yes).
        
        if  last-of(tt-mov-ap.moeda) then do:
                
            if  tt-param.log-saldo-movto = yes then
                run pi-listar-saldo-sem-movtos-moeda (input 1).

            run pi-total-geral.
                        
            run pi-ferfil-compras.
            
            page.
        end.
            
    end.
end.
        
/* Fim de Include */
