/*********************************************************************************
***
*** app/apapi022.i12 - Consistencias da Tabela prograssiva de IR
***
*********************************************************************************/


/* Atualiza‡Æo Imposto Renda */

find first tab-ir-prog
     where tab-ir-prog.data-inicio <= tt-ant-ir.da-emis-antec
     and   tab-ir-prog.data-fim    >= tt-ant-ir.da-emis-antec
     no-lock no-error.

if  not avail tab-ir-prog then do:
    run utp/ut-msgs.p (input "show",
                       input 25641,
                       input "").

    assign c-mensagem = return-value.

    run pi-cria-log-tit-ap (input 1, input c-mensagem, input 1).
    assign l-erro = yes.
end.
else do:

    if param-ap.acum-ir = 1 then
       assign tt-ant-ir.c-cod-estab-acum = param-ap.estab-ir.
    else
       assign tt-ant-ir.c-cod-estab-acum = tt-ant-ir.c-cod-estab.

    /*--- Geracao do Valor do Imposto ---*/
    {app/ap0503ir.i1 param-ap.ep-codigo}

    if  de-base <= 0 or  tt-ant-ir.de-original <= 0  then
         assign tt-ant-ir.de-original = 0.

    if not Verifica_Program_Name("AP0503A",30) then do:
        /*--- Valor do imposto menor que zero ---*/ 
        if tt-ant-ir.de-original <= 0 then do:
            run utp/ut-msgs.p (input "HELP",
                               input 19475,
                               input "").
        
            assign c-mensagem = return-value.
        
            run pi-cria-log-tit-ap (input 19475, input c-mensagem, input 2).
        end.
    end.
    
    /*--- Valor do imposto maior que valor da AN ---*/
    if tt-ant-ir.de-original  > tt-ant-ir.de-vl-antecip then do:
       run utp/ut-msgs.p(input "help",
                         input 19496,
                         input  string(tt-ant-ir.de-original)
                                + "~~" +
                                string(tt-ant-ir.de-vl-antecip)).

       assign c-mensagem            = return-value
              tt-ant-ir.de-original = tt-ant-ir.de-original.

       run pi-cria-log-tit-ap (input 19496, input c-mensagem, input 2).
    end.

end.
/*--- FIM da include apapi022.i12 ---*/
