/**************************************************************************
***
*** app/ap0501e.i8
 - Cria AVA.
***
**************************************************************************/
  
if  {1} <> " " then do:
    create mov-ap.
    assign mov-ap.ep-codigo      = tit-ap.ep-codigo
           mov-ap.cod-estabel    = tit-ap.cod-estabel
           mov-ap.cod-esp        = tit-ap.cod-esp
           mov-ap.serie          = tit-ap.serie
           mov-ap.nr-docto       = tit-ap.nr-docto
           mov-ap.parcela        = tit-ap.parcela
           mov-ap.cod-fornec     = tit-ap.cod-fornec
           mov-ap.transacao      = 5
           mov-ap.dt-today       = today
           mov-ap.dt-transacao   = doc-i-ap.data-movto
           mov-ap.dt-emissao     = tit-ap.dt-emissao
           mov-ap.dt-vencimen    = tit-ap.dt-vencimen
           mov-ap.nome-abrev     = tit-ap.nome-abrev
           mov-ap.portador       = tit-ap.portador
           mov-ap.modalidade     = tit-ap.modalidade
           mov-ap.referencia     = doc-i-ap.referencia
           mov-ap.contabilizou   = no
           mov-ap.tipo           = tit-ap.tipo
           mov-ap.ind-tp-alter   = 1
           mov-ap.usuario        = c-seg-usuario
           mov-ap.c-time         = string(time, "HH:MM")
           mov-ap.lancamento     = 2
           mov-ap.conta-contabil = {1}
           mov-ap.ct-conta       = {2}
           mov-ap.sc-conta       = {3}
           mov-ap.vl-original    = tit-ap.vl-original
           mov-ap.valor-mov      = {4}
           mov-ap.impostos       = yes
           mov-ap.tp-codigo      = tit-ap.tp-codigo
           mov-ap.moeda          = lin-i-ap.mo-codigo
           mov-ap.cotacao-dia    = lin-i-ap.cotacao-dia
           mov-ap.vl-orig-me     = tit-ap.vl-orig-me
           mov-ap.origem         = lin-i-ap.origem.
           
    if  lin-i-ap.mo-codigo = 0 then
        assign mov-ap.valor-mov-me = {4}.
    else
        assign mov-ap.valor-mov-me   = fn_ajust_dec(fn_conv_moedas (
                                                    {4},
                                                    lin-i-ap.cotacao-dia,
                                                    0,
                                                    lin-i-ap.mo-codigo),lin-i-ap.mo-codigo).
        
    assign de-soma-ava    = de-soma-ava    + mov-ap.valor-mov
           de-soma-ava-me = de-soma-ava-me + mov-ap.valor-mov-me.       

    assign mov-ap.historico = impto-tit-pend-ap.historico.
    
    find first portador 
         where portador.ep-codigo    = mov-ap.ep-codigo
         and   portador.cod-portador = mov-ap.portador
         and   portador.modalidade   = mov-ap.modalidade
         no-lock no-error.
    if avail portador then do:

        if  portador.log-1 = yes then /* Identifica se o mesmo ‚ centralizador */
            assign mov-ap.conta-var-monetaria = "CENTRALIZADOR".
        else
            assign mov-ap.conta-var-monetaria = "NAO CENTRALIZADOR".
    end. 
end.
else do:
    assign vl-total-docto = 0.
    for each tit-conta-ap
        where tit-conta-ap.ep-codigo   = tit-ap.ep-codigo
        and   tit-conta-ap.cod-estabel = tit-ap.cod-estabel
        and   tit-conta-ap.cod-esp     = tit-ap.cod-esp
        and   tit-conta-ap.serie       = tit-ap.serie
        and   tit-conta-ap.nr-docto    = tit-ap.nr-docto
        and   tit-conta-ap.parcela     = tit-ap.parcela
        and   tit-conta-ap.cod-fornec  = tit-ap.cod-fornec 
        no-lock:
          
        create mov-ap.
        assign mov-ap.ep-codigo      = tit-ap.ep-codigo
               mov-ap.cod-estabel    = tit-ap.cod-estabel
               mov-ap.cod-esp        = tit-ap.cod-esp
               mov-ap.serie          = tit-ap.serie
               mov-ap.nr-docto       = tit-ap.nr-docto
               mov-ap.parcela        = tit-ap.parcela
               mov-ap.cod-fornec     = tit-ap.cod-fornec
               mov-ap.transacao      = 5
               mov-ap.dt-today       = today
               mov-ap.dt-transacao   = doc-i-ap.data-movto
               mov-ap.dt-emissao     = tit-ap.dt-emissao
               mov-ap.dt-vencimen    = tit-ap.dt-vencimen
               mov-ap.nome-abrev     = tit-ap.nome-abrev
               mov-ap.portador       = tit-ap.portador
               mov-ap.modalidade     = tit-ap.modalidade
               mov-ap.referencia     = doc-i-ap.referencia
               mov-ap.contabilizou   = no
               mov-ap.tipo           = tit-ap.tipo
               mov-ap.ind-tp-alter   = 1
               mov-ap.usuario        = c-seg-usuario
               mov-ap.c-time         = string(time, "HH:MM")
               mov-ap.lancamento     = 2
               mov-ap.conta-contabil = tit-conta-ap.conta-debito
               mov-ap.ct-conta       = tit-conta-ap.ct-codigo
               mov-ap.sc-conta       = tit-conta-ap.sc-codigo
               mov-ap.vl-original    = tit-ap.vl-original
               mov-ap.impostos       = yes
               mov-ap.tp-codigo      = tit-ap.tp-codigo
               mov-ap.moeda          = lin-i-ap.mo-codigo
               mov-ap.cotacao-dia    = lin-i-ap.cotacao-dia
               mov-ap.vl-orig-me     = tit-ap.vl-orig-me
               mov-ap.origem         = lin-i-ap.origem.
          
        assign mov-ap.valor-mov-me   = fn_ajust_dec(fn_conv_moedas (
                                                        (tit-conta-ap.vl-movto / tit-ap.vl-original * {4}),
                                                        lin-i-ap.cotacao-dia,
                                                        0,
                                                        lin-i-ap.mo-codigo),lin-i-ap.mo-codigo).

        assign mov-ap.valor-mov = fn_ajust_dec((tit-conta-ap.vl-movto / tit-ap.vl-original * {4}),tit-ap.moeda).

        assign vl-total-docto = vl-total-docto + mov-ap.valor-mov
               de-soma-ava    = de-soma-ava    + mov-ap.valor-mov
               de-soma-ava-me = de-soma-ava-me + mov-ap.valor-mov-me.       
               
        assign mov-ap.historico = impto-tit-pend-ap.historico.
        
        find first portador 
             where portador.ep-codigo    = mov-ap.ep-codigo
             and   portador.cod-portador = mov-ap.portador
             and   portador.modalidade   = mov-ap.modalidade
             no-lock no-error.
        if avail portador then do:
           if  portador.log-1 = yes then /* Identifica se o mesmo ‚ centralizador */
               assign mov-ap.conta-var-monetaria = "CENTRALIZADOR".
           else
               assign mov-ap.conta-var-monetaria = "NAO CENTRALIZADOR".
        end.      
    end.
    
    /* Verifica se h  diferenca do valor calculado para o valor total do imposto.
       Se houver, faz acerto da diferenca no £ltimo valor do mov-ap para a chave. */
    if  vl-total-docto <> {4} then do:
        find last mov-ap
            where mov-ap.ep-codigo   = tit-ap.ep-codigo
            and   mov-ap.cod-estabel = tit-ap.cod-estabel
            and   mov-ap.cod-esp     = tit-ap.cod-esp
            and   mov-ap.serie       = tit-ap.serie
            and   mov-ap.nr-docto    = tit-ap.nr-docto
            and   mov-ap.parcela     = tit-ap.parcela
            and   mov-ap.cod-fornec  = tit-ap.cod-fornec 
            exclusive-lock no-error.
        
        assign mov-ap.valor-mov = mov-ap.valor-mov + ({4} - vl-total-docto)
               de-soma-ava      = de-soma-ava      + ({4} - vl-total-docto).

        if  tit-ap.moeda = 0 then
            assign mov-ap.valor-mov-me = mov-ap.valor-mov
                   de-soma-ava-me      = de-soma-ava.
    end.
end.
                    
/*--- Lote Gerado Pelo MultiPlanta ---*/
if  doc-i-ap.log-2 = yes then do:
    assign mov-ap.flag-contab  = no 
           mov-ap.contabiliza  = no
           mov-ap.contabilizou = no
           mov-ap.origem       = 3.
end.                        
    
/*-------- INTEGRA€åES ---------*/
{app/ap9100.i2}
assign tt-integ-ap.tt-row-tit-ap  = rowid(tit-ap)
       tt-integ-ap.tt-row-mov-ap  = rowid(mov-ap)
       tt-integ-ap.tt-cb0201a     = yes
       tt-integ-ap.tt-ge0102b     = yes
       tt-integ-ap.tt-ge0102g     = yes
       tt-integ-ap.tt-cb1202a     = yes                   
       tt-integ-ap.tt-op-cb0201a  = 16
       tt-integ-ap.tt-op-ge0102b  = 16
       tt-integ-ap.tt-op-ge0102g  = 16
       tt-integ-ap.tt-op-cb1202a  = 21.
       
raw-transfer tt-integ-ap to raw-integracao.
run app/ap9100.p (Input raw-integracao, input-output table tt-erro).                    

create tt-mov-ap.
assign tt-mov-ap.r-mov-ap-ava = rowid(mov-ap)
       tt-mov-ap.r-tit-ap-ava = rowid(tit-ap).
           
/* Fim de Include */
