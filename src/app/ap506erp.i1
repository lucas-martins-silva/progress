/********************************************************************************
***
*** app/ap506erp.i1 - Foms's
***
********************************************************************************/

form
    skip(1)
    c-liter  to 96
    de-saldo at 98
    with stream-io down no-box no-attr-space no-labels width 132 frame f-total.

form 
    skip(1)
    c-selecao no-label skip (1)
    tt-param.portador colon 45
    tt-param.nr-bordero colon 45
    tt-param.dt-transacao colon 45 skip(1)
    c-impressao no-label skip (1)
    c-destino colon 45
    " - "
    tt-param.arquivo no-label format "x(60)":U
    tt-param.usuario colon 45
    with stream-io side-labels no-box width 132 frame f-parametros.
run utp/ut-trfrrp.p (input frame f-total:handle).
run utp/ut-trfrrp.p (input frame f-parametros:handle).

/* Fim de Include */



