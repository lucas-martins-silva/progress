/****************************************************************
*** AP0531rp.i4 - Teste se a empresa utiliza a tabela progressiva
***   {1} - Codigo da Empresa 
***   {2} - Se emite a advertencia sobre a tabela progressiva
*****************************************************************/

assign l-tabela-progressiva = no. 
&IF  DEFINED (BF_FIN_TAB_PROG_IR) &THEN
    
    find first param-ap 
          where param-ap.ep-codigo = {1}
          no-lock no-error.
    if not avail param-ap then      
       return.
    if  param-ap.acum-ir = 1 
    or  param-ap.acum-ir = 2 then do:
        assign l-tabela-progressiva = yes.
        if  {2} = yes then do:
            run utp/ut-msgs.p (input "show":U,
                               input 19660,
                               input {adinc/i06ad198.i 04 param-ap.acum-ir}).
        end.
    end.
&ENDIF

/*--- Fim include ap0531rp.i3 ---*/
