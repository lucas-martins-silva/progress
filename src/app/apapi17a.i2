/*******************************************************************************
***
*** app/apapi17a.i2 - Validaá‰es tt-conta-debito.
***
*******************************************************************************/

{utp/ut-liter.i Contas_Cont†beis}
assign c-identificacao = trim(return-value).

assign de-informado = 0
       i-contador   = 0.
/*--- Validaá∆o V†rias Conta DÇbito ---*/
for each  tt-conta-debito
    where tt-conta-debito.ep-codigo   = tt-nota-debito-credito.ep-codigo
    and   tt-conta-debito.cod-estabel = tt-nota-debito-credito.cod-estabel
    and   tt-conta-debito.cod-fornec  = tt-nota-debito-credito.cod-fornec
    and   tt-conta-debito.cod-esp     = tt-nota-debito-credito.cod-esp
    and   tt-conta-debito.serie       = tt-nota-debito-credito.serie
    and   tt-conta-debito.nr-docto    = tt-nota-debito-credito.nr-docto
    and   tt-conta-debito.parcela     = tt-nota-debito-credito.parcela:
                
    assign de-informado = de-informado + tt-conta-debito.vl-movto
           i-contador   = i-contador   + 1.
                    
    /*--- Valida Conta Cont†bil ---*/
    find first conta-contab no-lock
         where conta-contab.ep-codigo      = tt-conta-debito.ep-codigo 
         and   conta-contab.conta-contabil = tt-conta-debito.conta-debito no-error.
            
    if  not avail conta-contab then do:
        run utp/ut-msgs.p (input "msg", 
                           input 19, 
                           input string(tt-nota-debito-credito.conta-debito, param-global.formato-conta-contabil)).
        run pi-gerar-erro-retorno (input 19, input return-value).
    end.                         
    else do:
       
        /*--- Conta Ç de T°tulo ---*/
        if  conta-contab.tipo = 6 then do:
            run utp/ut-msgs.p (input "help", 
                               input 1061, 
                               input string(tt-nota-debito-credito.conta-debito, param-global.formato-conta-contabil)).
            run pi-gerar-erro-retorno (input 1061, input return-value).
        end.                         
                
        /*--- Conta deve ser de Sistema ---*/
        if  conta-contab.estado <> 3 then do:
            run utp/ut-msgs.p (input "msg", 
                               input 638, 
                               input string(tt-nota-debito-credito.conta-debito, param-global.formato-conta-contabil)).
            run pi-gerar-erro-retorno (input 638, input return-value).
        end.                         
                
        /*--- Conta n∆o pode receber lanátos no AP ---*/
        if  conta-contab.contas-pagar = 1 then do:
            run utp/ut-msgs.p (input "msg", 
                               input 460, 
                               input "").
            run pi-gerar-erro-retorno (input 460, input return-value).
        end.                         
                
        /*--- Conta n∆o pode ser de saldo ---*/
        if  conta-contab.contas-pagar = 3 then do:
            run utp/ut-msgs.p (input "msg", 
                               input 6276, 
                               input string(tt-nota-debito-credito.conta-debito, param-global.formato-conta-contabil)).
            run pi-gerar-erro-retorno (input 6276, input return-value).
        end.
    end.    
end.        
        
find first tt-conta-debito
     where tt-conta-debito.ep-codigo   = tt-nota-debito-credito.ep-codigo
     and   tt-conta-debito.cod-estabel = tt-nota-debito-credito.cod-estabel
     and   tt-conta-debito.cod-fornec  = tt-nota-debito-credito.cod-fornec
     and   tt-conta-debito.cod-esp     = tt-nota-debito-credito.cod-esp
     and   tt-conta-debito.serie       = tt-nota-debito-credito.serie
     and   tt-conta-debito.nr-docto    = tt-nota-debito-credito.nr-docto
     and   tt-conta-debito.parcela     = tt-nota-debito-credito.parcela
     no-error.
        
if  avail tt-conta-debito then do:
    if i-pais-impto-usuario <> 2 then do:
    
       if  de-informado <> tt-nota-debito-credito.vl-orig-me then do:
           run utp/ut-msgs.p (input "help",
                              input 8890,
                              input string(tt-nota-debito-credito.vl-orig-me, "zzz,zzz,zz9.99")).
           run pi-gerar-erro-retorno (input 8890, input return-value).    
       end.
       
    end.
    else do:
    
       /* Localizacao argentina */
       /*--- Total dos Impostos + Rateio deve ser igual ao valor Original ---*/
       if  (de-vl-imposto + de-informado) <> tt-nota-debito-credito.vl-orig-me and
           de-informado <> 0 then do:
 
           assign de-vl-liquido = tt-nota-debito-credito.vl-orig-me - de-vl-imposto.
 
           /* Valor informado n∆o pode ser maior que o valor original */
           run utp/ut-msgs.p (input "help",
                              input 8890,
                              input string(de-vl-liquido, "zzz,zzz,zz9.99")).
           run pi-gerar-erro-retorno (input 8890, input return-value).    
           
       end.            
       
    end.   
end.
    
/* Fim de Include */

