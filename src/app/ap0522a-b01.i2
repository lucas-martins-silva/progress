/*****************************************************************************
**
**  APP/AP0522a-b01.i2 - Cria temp-table tt_xml_estorno para Estorno.
**
*****************************************************************************/

create tt_xml_estorno.
assign tt_xml_estorno.tt_cod_label       = "Funcao"
       tt_xml_estorno.tt_des_conteudo    = "{1}" /* "Estorna" */
       tt_xml_estorno.tt_num_seq_1_xml   = v_sequencia
       tt_xml_estorno.tt_num_seq_2_xml   = 1.

create tt_xml_estorno.
assign tt_xml_estorno.tt_cod_label       = "Empresa"
       tt_xml_estorno.tt_des_conteudo    = string(i-ep-codigo-usuario)
       tt_xml_estorno.tt_num_seq_1_xml   = v_sequencia
       tt_xml_estorno.tt_num_seq_2_xml   = 1.

find conta-contab
    where conta-contab.ep-codigo      = i-ep-codigo-usuario and
          conta-contab.conta-contabil = INPUT BROWSE br-table bordero-ap.conta-debito
          no-lock no-error.

create tt_xml_estorno.
assign tt_xml_estorno.tt_cod_label       = "Conta Contabil"
       tt_xml_estorno.tt_des_conteudo    = string(conta-contab.ct-codigo) + ',' +
                                           string(conta-contab.sc-codigo)
       tt_xml_estorno.tt_num_seq_1_xml   = v_sequencia
       tt_xml_estorno.tt_num_seq_2_xml   = 1.

create tt_xml_estorno.
assign tt_xml_estorno.tt_cod_label       = "Estabelecimento"
       tt_xml_estorno.tt_des_conteudo    = INPUT BROWSE br-table bordero-ap.cod-estabel
       tt_xml_estorno.tt_num_seq_1_xml   = v_sequencia
       tt_xml_estorno.tt_num_seq_2_xml   = 1.

create tt_xml_estorno.
assign tt_xml_estorno.tt_cod_label       = "Data Movimentacao"
       tt_xml_estorno.tt_des_conteudo    = string(INPUT BROWSE br-table bordero-ap.dt-transacao)
       tt_xml_estorno.tt_num_seq_1_xml   = v_sequencia
       tt_xml_estorno.tt_num_seq_2_xml   = 1.

create tt_xml_estorno.
assign tt_xml_estorno.tt_cod_label       = "Finalidade Economica"
       tt_xml_estorno.tt_des_conteudo    = string(bordero-ap.moeda)
       tt_xml_estorno.tt_num_seq_1_xml   = v_sequencia
       tt_xml_estorno.tt_num_seq_2_xml   = 1.

create tt_xml_estorno.
assign tt_xml_estorno.tt_cod_label       = "Valor Movimento"
       tt_xml_estorno.tt_des_conteudo    = string(INPUT BROWSE br-table bordero-ap.vl-docto)
       tt_xml_estorno.tt_num_seq_1_xml   = v_sequencia
       tt_xml_estorno.tt_num_seq_2_xml   = 1.

create tt_xml_estorno.
assign tt_xml_estorno.tt_cod_label       = "Origem Movimento"
       tt_xml_estorno.tt_des_conteudo    = "04" /* AP EMS2 Pendente */
       tt_xml_estorno.tt_num_seq_1_xml   = v_sequencia
       tt_xml_estorno.tt_num_seq_2_xml   = 1.

create tt_xml_estorno.
assign tt_xml_estorno.tt_cod_label       = "ID Movimento"
       tt_xml_estorno.tt_des_conteudo    = string(i-ep-codigo-usuario) + chr(10) +
                                           bordero-ap.char-1               
       tt_xml_estorno.tt_num_seq_1_xml   = v_sequencia
       tt_xml_estorno.tt_num_seq_2_xml   = 1.

/*--- Fim AP0522a-b01.i2 ---*/



