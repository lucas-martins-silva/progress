/***************************************************************************
**
** AP1001A.i5
** Objetivo: Trailler Banco do Brasil
**
***************************************************************************/
assign i-num-reg = i-num-reg + 1.

if  tt-param.i-tipo-pag = 30
or  tt-param.i-tipo-pag = 31 then do:
    put stream relat
    "001"                                                             at 001
    "9"                                                               at 004
    i-hea-qua                                         format "999999" at 005
    de-hea-val                             format "99999999999999999" at 011
    "                                                                                                                                                                                                                     "
    at 028
    skip.
end.
else do:
    put stream relat 
    "9"                                                               at 001
    i-num-reg                                        format "999999"  at 195
    skip.
end.

/* ap1001a.i5 */
