/**************************************************************************
***
*** app/ap0586.i12 - Atualiza‡Æo dos Impostos.
***
**************************************************************************/
assign de-soma-ava    = 0
       de-soma-ava-me = 0
       l-ir = no.            
      
find first e-tit-ap use-index codigo
   where e-tit-ap.ep-codigo   = {1}.ep-codigo
     and e-tit-ap.cod-estabel = {1}.cod-estabel
     and e-tit-ap.cod-esp     = {1}.cod-esp
     and e-tit-ap.serie       = {1}.serie
     and e-tit-ap.nr-docto    = {1}.nr-docto
     and e-tit-ap.parcela     = {1}.parcela
     and e-tit-ap.cod-fornec  = {1}.cod-fornec
   exclusive-lock no-error.
            
if  avail e-tit-ap then do:        
    for each impto-tit-pend-ap use-index codigo
       where impto-tit-pend-ap.ep-codigo   = e-tit-ap.ep-codigo
         and impto-tit-pend-ap.cod-est     = e-tit-ap.cod-estabel
         and impto-tit-pend-ap.cod-esp     = e-tit-ap.cod-esp
         and impto-tit-pend-ap.serie       = e-tit-ap.serie
         and impto-tit-pend-ap.nr-docto    = e-tit-ap.nr-docto
         and impto-tit-pend-ap.parcela     = e-tit-ap.parcela
         and impto-tit-pend-ap.cod-fornec  = e-tit-ap.cod-fornec
         and impto-tit-pend-ap.tipo        = 1:     
    
       find first tipo-tax no-lock
          where tipo-tax.cod-tax = impto-tit-pend-ap.cod-imposto no-error.
       if  avail tipo-tax and tipo-tax.ind-data-base-ret = 1 then do:                    
    
           for each tt-epc
              where tt-epc.cod-event = "ap0505d".
              delete tt-epc.
           end.
 
           create tt-epc.
           assign tt-epc.cod-event     = "ap0505d" 
                  tt-epc.cod-parameter = "cod-fornec"
                  tt-epc.val-parameter = string(impto-tit-pend-ap.cod-fornec).

           create tt-epc.
           assign tt-epc.cod-event     = "ap0505d"
                  tt-epc.cod-parameter = "tp-codigo"
                  tt-epc.val-parameter = string(impto-tit-pend-ap.tp-codigo).
           
           {include/i-epc201.i {2}}
 
           find first tt-epc 
              where tt-epc.cod-event = "ap0505d-return" no-lock no-error.
           if  avail tt-epc then do:               
               if  impto-tit-pend-ap.cod-imposto = 
                   int(tt-epc.val-parameter) then do:                   
                   assign l-ir = yes.                         
               end.
           end.
           
           /****** Cria AVA **************/
            create mov-ap.
            assign mov-ap.ep-codigo      = e-tit-ap.ep-codigo
                   mov-ap.cod-estabel    = e-tit-ap.cod-estabel
                   mov-ap.cod-esp        = e-tit-ap.cod-esp
                   mov-ap.serie          = e-tit-ap.serie
                   mov-ap.nr-docto       = e-tit-ap.nr-docto
                   mov-ap.parcela        = e-tit-ap.parcela
                   mov-ap.cod-fornec     = e-tit-ap.cod-fornec
                   mov-ap.transacao      = 5
                   mov-ap.dt-today       = today
                   mov-ap.dt-transacao   = doc-b-ap.data-movto
                   mov-ap.dt-emissao     = e-tit-ap.dt-emissao
                   mov-ap.dt-vencimen    = e-tit-ap.dt-vencimen
                   mov-ap.dt-pagamento   = {1}.dt-emissao
                   mov-ap.nome-abrev     = e-tit-ap.nome-abrev
                   mov-ap.portador       = e-tit-ap.portador
                   mov-ap.referencia     = e-tit-ap.referencia
                   mov-ap.contabilizou   = no
                   mov-ap.tipo           = e-tit-ap.tipo
                   mov-ap.usuario        = c-seg-usuario
                   mov-ap.c-time         = string(time, "HH:MM")
                   mov-ap.lancamento     = 2
                   mov-ap.conta-contabil = impto-tit-pend-ap.conta-imposto
                   mov-ap.ct-conta       = impto-tit-pend-ap.ct-imposto
                   mov-ap.sc-conta       = impto-tit-pend-ap.sc-imposto
                   mov-ap.vl-original    = e-tit-ap.vl-original
                   mov-ap.valor-mov      = impto-tit-pend-ap.vl-imposto
                   mov-ap.impostos       = yes
                   mov-ap.tp-codigo      = e-tit-ap.tp-codigo.

            if  l-ir = yes then do:
                assign mov-ap.ind-ir = yes.
            end.       
            
            /*{utp/ut-liter.i Reten‡äes * R}
             * assign mov-ap.historico = trim(return-value).*/
                                
            /*-------------- Multi-Moeda ---------------*/
            assign mov-ap.moeda          = e-tit-ap.moeda
                   mov-ap.cotacao-dia    = e-tit-ap.cotacao-dia
                   mov-ap.vl-orig-me     = e-tit-ap.vl-orig-me
                   mov-ap.valor-mov-me   = impto-tit-pend-ap.vl-imposto / 
                                           e-tit-ap.cotacao-dia.
                                                           
            assign de-soma-ava    = de-soma-ava    + mov-ap.valor-mov
                   de-soma-ava-me = de-soma-ava-me + mov-ap.valor-mov-me.    
            
            /*-------- INTEGRA€åES ---------*/
            {app/ap9100.i2}
            assign tt-integ-ap.tt-row-tit-ap  = rowid(e-tit-ap)
                   tt-integ-ap.tt-row-mov-ap  = rowid(mov-ap)
                   tt-integ-ap.tt-fc1014a     = yes
                   tt-integ-ap.tt-fc1114a     = yes
                   tt-integ-ap.tt-cb0201a     = yes
                   tt-integ-ap.tt-ge0102b     = yes
                   tt-integ-ap.tt-ge0102g     = yes
                   tt-integ-ap.tt-cb1202a     = yes       
                   tt-integ-ap.tt-op-cb0201a  = 16
                   tt-integ-ap.tt-op-ge0102b  = 16
                   tt-integ-ap.tt-op-ge0102g  = 16
                   tt-integ-ap.tt-op-cb1202a  = 21.
            raw-transfer tt-integ-ap to raw-integracao.
            run app/ap9100.p (Input raw-integracao,
                              input-output table tt-erro).                    
           /****** Fim AVA **************/
           
           /****** Criacao titulo Voucher *****/
           if  tipo-tax.serie <> " " then do:
                find first emitente use-index codigo
                     where emitente.cod-emitente = {1}.cod-fornec
                     and emitente.identific   <> 1 no-lock no-error.
    
                find first serie exclusive-lock
                   where serie.serie = tipo-tax.serie no-error.
                
                find first espec-ap no-lock
                   where espec-ap.cod-esp = tipo-tax.cod-esp no-error.
                            
                assign i-nr-docto-ret = serie.nr-ult-fat + 1.            
                
                repeat:
                    find first b-tit-ap use-index codigo
                       where b-tit-ap.ep-codigo   = tit-ap.ep-codigo
                         and b-tit-ap.cod-estabel = tit-ap.cod-estabel
                         and b-tit-ap.serie       = tipo-tax.serie
                         and b-tit-ap.cod-esp     = tipo-tax.cod-esp
                         and b-tit-ap.nr-docto    = string(i-nr-docto-ret)
                         and b-tit-ap.parcela     = "1"
                         and b-tit-ap.cod-fornec  = tit-ap.cod-fornec 
                       no-error.
                    if  not avail b-tit-ap then do:
                        assign serie.nr-ult-fat = i-nr-docto-ret
                               serie.dt-ult-fat = today.
                        leave.
                    end.
                    assign i-nr-docto-ret = i-nr-docto-ret + 1.
                end.
    
                create b-tit-ap.
                assign b-tit-ap.ep-codigo       = e-tit-ap.ep-codigo
                       b-tit-ap.cod-estabel     = e-tit-ap.cod-estabel
                       b-tit-ap.cod-esp         = tipo-tax.cod-esp
                       b-tit-ap.serie           = tipo-tax.serie
                       b-tit-ap.nr-docto        = string(i-nr-docto-ret)
                       b-tit-ap.parcela         = "1"
                       b-tit-ap.serie-ant       = e-tit-ap.serie
                       b-tit-ap.esp-ant         = e-tit-ap.cod-esp
                       b-tit-ap.docto-ant       = e-tit-ap.nr-docto
                       b-tit-ap.parc-ant        = e-tit-ap.parcela
                       b-tit-ap.cod-fornec      = e-tit-ap.cod-fornec
                       b-tit-ap.transacao       = 1 /*IMD*/
                       b-tit-ap.portador        = e-tit-ap.portador
                       b-tit-ap.dt-transacao    = e-tit-ap.dt-transacao
                       b-tit-ap.cod-impto-ret   = impto-tit-pend-ap.cod-impost
                       b-tit-ap.dt-emissao      = e-tit-ap.dt-emissao      
                       b-tit-ap.dt-prev-pag     = impto-tit-pend-ap.dt-vencimen
                       b-tit-ap.referencia      = e-tit-ap.referencia 
                       b-tit-ap.conta-debito    = impto-tit-pend-ap.conta-imposto
                       b-tit-ap.ct-conta-db     = impto-tit-pend-ap.ct-imposto
                       b-tit-ap.sc-conta-db     = impto-tit-pend-ap.sc-imposto      
                       b-tit-ap.tipo            = espec-ap.tipo
                       b-tit-ap.nome-abrev      = emitente.nome-abrev
                       b-tit-ap.cgc             = emitente.cgc
                       b-tit-ap.calcula-cmi     = espec-ap.calc-var-cmi
                       b-tit-ap.moeda           = 0
                       b-tit-ap.cotacao-dia     = 1
                       b-tit-ap.observacao      = impto-tit-pend-ap.obs
                       b-tit-ap.vl-original     = impto-tit-pend-ap.vl-imposto
                       b-tit-ap.vl-liquido      = impto-tit-pend-ap.vl-imposto
                       b-tit-ap.valor-saldo     = impto-tit-pend-ap.vl-imposto
                       b-tit-ap.vl-orig-me      = impto-tit-pend-ap.vl-imposto
                       b-tit-ap.vl-liquido-me   = impto-tit-pend-ap.vl-imposto
                       b-tit-ap.vl-saldo-me     = impto-tit-pend-ap.vl-imposto.
    
                /*** Campos referente IR ***/       
                assign b-tit-ap.dt-vencimen     = impto-tit-pend-ap.dt-vencimen
                       b-tit-ap.cod-retencao    = impto-tit-pend-ap.cod-retencao
                       b-tit-ap.tp-codigo       = impto-tit-pend-ap.tp-codigo.
    
                assign c-matriz = emitente.nome-matriz.
                find first emitente use-index codigo
                   where emitente.nome-abrev = c-matriz
                     and emitente.identific <> 1 no-lock no-error.
                
                if  avail emitente then do:
                    assign b-tit-ap.matriz = emitente.cod-emitente.
                end.
    
                create mov-ap.
                assign mov-ap.ep-codigo      = b-tit-ap.ep-codigo
                       mov-ap.cod-estabel    = b-tit-ap.cod-estabel
                       mov-ap.nr-docto       = b-tit-ap.nr-docto
                       mov-ap.parcela        = b-tit-ap.parcela
                       mov-ap.serie          = b-tit-ap.serie
                       mov-ap.cod-esp        = b-tit-ap.cod-esp
                       mov-ap.tp-codigo      = b-tit-ap.tp-codigo
                       mov-ap.transacao      = 1  /*IMD*/
                       mov-ap.tipo           = b-tit-ap.tipo
                       mov-ap.esp-ant        = e-tit-ap.cod-esp
                       mov-ap.serie-ant      = e-tit-ap.serie
                       mov-ap.docto-ant      = e-tit-ap.nr-docto
                       mov-ap.parc-ant       = e-tit-ap.parcela
                       mov-ap.fornec-ant     = e-tit-ap.cod-fornec 
                       mov-ap.conta-contabil = b-tit-ap.conta-debito
                       mov-ap.ct-conta       = b-tit-ap.ct-conta-db
                       mov-ap.sc-conta       = b-tit-ap.sc-conta-db
                       mov-ap.cod-fornec     = b-tit-ap.cod-fornec
                       mov-ap.portador       = b-tit-ap.portador
                       mov-ap.dt-emissao     = b-tit-ap.dt-emissao
                       mov-ap.dt-vencimen    = b-tit-ap.dt-vencimen
                       mov-ap.dt-transacao   = b-tit-ap.dt-emissao
                       mov-ap.dt-today       = today
                       mov-ap.referencia     = b-tit-ap.referencia
                       mov-ap.contabilizou   = no
                       mov-ap.usuario        = c-seg-usuario
                       mov-ap.c-time         = string(time, "HH:MM")
                       mov-ap.emit-fita      = no
                       mov-ap.lancamento     = 2
                       mov-ap.historico      = b-tit-ap.observacao
                       mov-ap.vl-original    = b-tit-ap.vl-original
                       mov-ap.valor-mov      = b-tit-ap.vl-original
                       mov-ap.moeda          = b-tit-ap.moeda
                       mov-ap.cotacao-dia    = b-tit-ap.cotacao-dia
                       mov-ap.vl-orig-me     = b-tit-ap.vl-orig-me.
    
                if  l-ir = yes then do:
                    assign mov-ap.ind-ir   = yes
                           b-tit-ap.ind-ir   = yes
                           b-tit-ap.valor-ir = impto-tit-pend-ap.vl-imposto.
                            
                end.
            end.    
           /******* Fim Voucher ************/

       end.
       delete impto-tit-pend-ap.
    end.

    /*------------------- IVA ------------------*/
    for each impto-tit-pend-ap use-index codigo
       where impto-tit-pend-ap.ep-codigo  = e-tit-ap.ep-codigo
         and impto-tit-pend-ap.cod-est    = e-tit-ap.cod-est
         and impto-tit-pend-ap.cod-esp    = e-tit-ap.cod-esp
         and impto-tit-pend-ap.serie      = e-tit-ap.serie
         and impto-tit-pend-ap.nr-docto   = e-tit-ap.nr-docto
         and impto-tit-pend-ap.parcela    = e-tit-ap.parcela
         and impto-tit-pend-ap.cod-fornec = e-tit-ap.cod-fornec
         and impto-tit-pend-ap.tipo       = 2:

        create impto-tit-ap.
        assign impto-tit-ap.ep-codigo           = impto-tit-pend-ap.ep-codigo
               impto-tit-ap.cod-est             = impto-tit-pend-ap.cod-est
               impto-tit-ap.cod-esp             = impto-tit-pend-ap.cod-esp
               impto-tit-ap.serie               = impto-tit-pend-ap.serie
               impto-tit-ap.cod-fornec          = impto-tit-pend-ap.cod-fornec
               impto-tit-ap.nr-docto            = impto-tit-pend-ap.nr-docto
               impto-tit-ap.parcela             = impto-tit-pend-ap.parcela
               impto-tit-ap.dt-emissao          = impto-tit-pend-ap.dt-emissao
               impto-tit-ap.dt-transacao        = impto-tit-pend-ap.dt-transacao
               impto-tit-ap.lancamento          = impto-tit-pend-ap.lancamento
               impto-tit-ap.tipo                = impto-tit-pend-ap.tipo
               impto-tit-ap.trans-impto-ap      = impto-tit-pend-ap.trans-impto-ap
               impto-tit-ap.origem-impto        = impto-tit-pend-ap.origem-impto
               impto-tit-ap.contabilizou        = no
               impto-tit-ap.ind-data-base       = impto-tit-pend-ap.ind-data-base
               impto-tit-ap.obs                 = impto-tit-pend-ap.obs
               impto-tit-ap.vl-base             = impto-tit-pend-ap.vl-base
               impto-tit-ap.vl-base-me          = impto-tit-pend-ap.vl-base-me
               impto-tit-ap.cod-imposto         = impto-tit-pend-ap.cod-imposto
               impto-tit-ap.mo-codigo           = impto-tit-pend-ap.mo-codigo
               impto-tit-ap.cotacao-dia         = impto-tit-pend-ap.cotacao-dia.
                  
        assign i-sequencia = 0.
        repeat:
            assign i-sequencia = i-sequencia + 10.
            find first b-impto-tit-ap use-index codigo
               where b-impto-tit-ap.ep-codigo     = e-tit-ap.ep-codigo
                 and b-impto-tit-ap.cod-estabel   = e-tit-ap.cod-estabel
                 and b-impto-tit-ap.cod-esp       = e-tit-ap.cod-esp
                 and b-impto-tit-ap.serie         = e-tit-ap.serie
                 and b-impto-tit-ap.nr-docto      = e-tit-ap.nr-docto
                 and b-impto-tit-ap.parcela       = e-tit-ap.parcela
                 and b-impto-tit-ap.cod-fornec    = e-tit-ap.cod-fornec
                 and b-impto-tit-ap.cod-imposto   = impto-tit-pend-ap.cod-imposto
                 and b-impto-tit-ap.num-seq-impto = i-sequencia
                no-error.
            
            if  not avail b-impto-tit-ap then do:
                assign impto-tit-ap.num-seq-impto = i-sequencia.
                leave.
            end.
        end.
        create tt-iva.
        assign tt-iva.tt-row-impto-tit-ap = rowid(impto-tit-ap).
        
        assign impto-tit-ap.conta-imposto       = impto-tit-pend-ap.conta-imposto
               impto-tit-ap.ct-imposto          = impto-tit-pend-ap.ct-imposto
               impto-tit-ap.sc-imposto          = impto-tit-pend-ap.sc-imposto
               impto-tit-ap.perc-imposto        = impto-tit-pend-ap.perc-imposto.
        assign impto-tit-ap.conta-percepcao     = impto-tit-pend-ap.conta-percepcao
               impto-tit-ap.ct-percepcao        = impto-tit-pend-ap.ct-percepcao
               impto-tit-ap.sc-percepcao        = impto-tit-pend-ap.sc-percepcao
               impto-tit-ap.perc-percepcao      = impto-tit-pend-ap.perc-percepcao.
        assign impto-tit-ap.conta-retencao      = ""
               impto-tit-ap.ct-retencao         = ""
               impto-tit-ap.sc-retencao         = ""
               impto-tit-ap.perc-retencao       = 0.
        assign impto-tit-ap.conta-iva-liberado  = impto-tit-pend-ap.conta-iva-liberado
               impto-tit-ap.ct-iva-liberado     = impto-tit-pend-ap.ct-iva-liberado
               impto-tit-ap.sc-iva-liberado     = impto-tit-pend-ap.sc-iva-liberado
               impto-tit-ap.perc-iva-liberado   = impto-tit-pend-ap.perc-iva-liberado.
        assign impto-tit-ap.vl-imposto          = impto-tit-pend-ap.vl-imposto
               impto-tit-ap.vl-saldo-imposto    = impto-tit-pend-ap.vl-saldo-imposto
               impto-tit-ap.vl-retencao         = 0
               impto-tit-ap.vl-percepcao        = impto-tit-pend-ap.vl-percepcao
               impto-tit-ap.vl-iva-liberado     = impto-tit-pend-ap.vl-iva-liberado.
        assign impto-tit-ap.vl-imposto-me       = impto-tit-pend-ap.vl-imposto-me
               impto-tit-ap.vl-saldo-imposto-me = impto-tit-pend-ap.vl-saldo-imposto-me
               impto-tit-ap.vl-retencao-me      = 0
               impto-tit-ap.vl-percepcao-me     = impto-tit-pend-ap.vl-percepcao-me
               impto-tit-ap.vl-iva-liberado-me  = impto-tit-pend-ap.vl-iva-liberado-me
               impto-tit-ap.cod-classificacao   = impto-tit-pend-ap.cod-classificacao.

        delete impto-tit-pend-ap.            
        
    end.
end.
/* Fim de Include */
