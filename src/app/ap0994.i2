/*****************************************************************************
*** include: app/ap0994.i2
******************************************************************************/
if  avail tipo-tax
and tipo-tax.tributado = yes then do:
    create impto-tit-pend-ap.
    assign impto-tit-pend-ap.cod-forn          =  tt-dados.cod-emit
           impto-tit-pend-ap.cod-esp           = tt-dados.cod-esp
           impto-tit-pend-ap.cod-estabel       = tt-dados.cod-est
           impto-tit-pend-ap.cod-imposto       = tipo-tax.cod-tax
           impto-tit-pend-ap.contabilizou      = no
           impto-tit-pend-ap.origem-impto      = 1
           impto-tit-pend-ap.trans-impto-ap    = 1
           impto-tit-pend-ap.ct-imposto        = if available tipo-tax then tipo-tax.ct-tax
                                                 else ""
           impto-tit-pend-ap.sc-imposto        = if available tipo-tax then tipo-tax.sc-tax
                                                 else ""
           impto-tit-pend-ap.dt-emissao        = tt-dados.dt-emissao
           impto-tit-pend-ap.dt-transacao      = tt-dados.dt-transacao
           impto-tit-pend-ap.ep-codigo         = tt-dados.ep-codigo
           impto-tit-pend-ap.serie             = tt-dados.serie 
           impto-tit-pend-ap.nr-docto          = tt-dados.nr-docto
           impto-tit-pend-ap.parcela           = string({1})
           impto-tit-pend-ap.perc-imposto      = tipo-tax.tax-perc
           impto-tit-pend-ap.tipo              = {2}
           impto-tit-pend-ap.cod-classificacao = tipo-tax.cod-classificacao
           impto-tit-pend-ap.vl-base           = {3} 
           impto-tit-pend-ap.vl-imposto        = {4} / {5} * {6}
           r-tax-2                             = rowid(impto-tit-pend-ap). 
end.
