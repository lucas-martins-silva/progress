/**************************************************************************
**   SPAP2001A.I1
**   Objetivo : Registros header e trailler de lote do banco ITAU
**************************************************************************/


if "{1}" = "HEADER" then do:

    /*-----------------------------------------------------------------------
                           HEADER de Lote - Segmento N  
      -----------------------------------------------------------------------*/    
    
    put stream relat
        "341"                                                                at 001
        i-tot-lotes                                   format "9999"          at 004
        "1"                                                                  at 008
        "C"                                                                  at 009
        "20"                                                                 at 010
        "17"                                                                 at 012
        "030"                                                                at 014
        "2"                                                                  at 018
        c-cgc-emp                                    format "99999999999999" at 019.
        
    put stream relat
        substr(cta-corrente.agencia-extrato, 2,5)    format "99999"          at 053      
        "00"                                                                 at 059
        substr(cta-corrente.conta-corren-ext, 01,10) format "9999999999"     at 061
        substr(cta-corrente.conta-corren-ext, 11,01) format "9"              at 072
        empresa.razao-social                         format "x(30)"          at 073
        " "                                                                  at 103 
        " "                                                                  at 133
        ""
        empresa.endereco                             format "x(30)"          at 143
        empresa.cidade                               format "x(20)"          at 193
        empresa.cep                                  format "x(08)"          at 213
        empresa.uf                                   format "x(02)"          at 221
       "          "                                                          at 231 skip. 


end.
else do:

/* ------------------------------------------------------------
                       Trailer do lote 
   ------------------------------------------------------------*/
put stream relat

    "341"                                                             at 001
    i-tot-lotes                              format "9999"            at 004
    "5"                                                               at 008
    i-tot-reg-lote + 2                       format "999999"          at 018
    de-tot-val * 100                         format "99999999999999"  at 024
    "00000000000000"                                                  at 038
    "00000000000000"                                                  at 052
    de-tot-val * 100                         format "99999999999999"  at 066
    "0000000000"                                                      at 231 skip.

end.
