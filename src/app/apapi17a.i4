/*******************************************************************************
***
*** app/apapi17a.i4 - Validaá‰es tt-imposto.
***
*******************************************************************************/

{utp/ut-liter.i Impostos}
assign c-identificacao = trim(return-value).

/*--- Validaá∆o Impostos ---*/
for each  tt-imposto
    where tt-imposto.ep-codigo   = tt-nota-debito-credito.ep-codigo
    and   tt-imposto.cod-estabel = tt-nota-debito-credito.cod-estabel
    and   tt-imposto.cod-fornec  = tt-nota-debito-credito.cod-fornec
    and   tt-imposto.cod-esp     = tt-nota-debito-credito.cod-esp
    and   tt-imposto.serie       = tt-nota-debito-credito.serie
    and   tt-imposto.nr-docto    = tt-nota-debito-credito.nr-docto
    and   tt-imposto.parcela     = tt-nota-debito-credito.parcela:

    /*--- Valida Tipo de Imposto ---*/
    find first tipo-tax no-lock
         where tipo-tax.cod-tax = tt-imposto.cod-imposto no-error.                    

    if  not avail tipo-tax then do:
        run utp/ut-msgs.p (input "help",
                           input 3459,
                           input " ").
        run pi-gerar-erro-retorno (input 3459, input return-value).
    end.    
    else do:
    
        /*** Verifica se pais Ç diferente de MÇxico ***/
        if  i-pais-impto-usuario <> 4 then
             /*--- Somente IVA  ---*/
            if  tipo-tax.tipo <> 2 then do:
                run utp/ut-msgs.p (input "help",
                                   input 5013,
                                   input " ").
                run pi-gerar-erro-retorno (input 5013, input return-value).
            end.
        else do:
            /*** Sen∆o verifica tipo de imposto de Retená∆o ***/
            if tipo-tax.tipo <> 1 and tipo-tax.tipo <> 2 then do:
                 run utp/ut-msgs.p (input "help",
                                    input 29892,
                                    input " ").
                 run pi-gerar-erro-retorno (input 29892, input return-value).
            end.
        end.
    end.

    if  tt-imposto.perc-imposto > 100 then do:
        run utp/ut-msgs.p (input "help",
                           input 374,
                           input " ").
        run pi-gerar-erro-retorno (input 374, input return-value).
    end.                

    /* Percentual deve ser informado */
    if  tt-imposto.conta-imposto <> "" and
        tt-imposto.perc-imposto = 0 then do:
        run utp/ut-msgs.p (input "msg",
                           input 2336,
                           input "").
        run pi-gerar-erro-retorno (input 2336, input return-value).
    end.      

    if  tt-imposto.perc-percepcao > 100 then do:
        run utp/ut-msgs.p (input "help",
                           input 374,
                           input " ").
        run pi-gerar-erro-retorno (input 374, input return-value).
    end.                

    /* Percentual deve ser informado */
    if  tt-imposto.conta-percepcao <> "" and
        tt-imposto.perc-percepcao = 0 then do:
        run utp/ut-msgs.p (input "msg",
                           input 2336,
                           input "").
        run pi-gerar-erro-retorno (input 2336, input return-value).
    end.      

    if  tt-imposto.perc-retencao > 100 then do:
        run utp/ut-msgs.p (input "help",
                           input 374,
                           input " ").
        run pi-gerar-erro-retorno (input 374, input return-value).
    end.

    /* Percentual deve ser informado */
    if  tt-imposto.conta-retencao <> "" and
        tt-imposto.perc-retencao = 0 then do:
        run utp/ut-msgs.p (input "msg",
                           input 2336,
                           input "").
        run pi-gerar-erro-retorno (input 2336, input return-value).
    end.      

    if  tt-imposto.conta-imposto <> "" or
        tt-imposto.perc-imposto <> 0 then do:  

        find first conta-contab no-lock
             where conta-contab.ep-codigo      = i-ep-codigo-usuario
             and   conta-contab.conta-contabil = tt-imposto.conta-imposto
             no-error.               

        if  not avail conta-contab then do:
            /*--- Conta nao cadastrada ---*/
            run utp/ut-msgs.p (input "help",
                               input 1060,
                               input tt-imposto.conta-imposto).
            run pi-gerar-erro-retorno (input 1060, input return-value).
        end.
        else do:
            if  conta-contab.tipo  = 6 then do:
                /*--- Conta de Titulo nao pode receber lancamento ---*/
                run utp/ut-msgs.p (input "help",
                                   input 1061,
                                   input string(conta-contab.conta-contabil, param-global.formato-conta-contabil)).
                run pi-gerar-erro-retorno (input 1061, input return-value).
            end.

            if  conta-contab.estado <> 3 then do:
                /*--- Conta Contabil nao e de Sistema ---*/
                run utp/ut-msgs.p (input "help",
                                   input 1062,
                                   input string(conta-contab.conta-contabil, param-global.formato-conta-contabil)).
                run pi-gerar-erro-retorno (input 1062, input return-value).
            end.

            /*--- Conta n∆o pode receber lanátos no AP ---*/
            if  conta-contab.contas-pagar = 1 then do:
                run utp/ut-msgs.p (input "msg", 
                                   input 460, 
                                   input "").
                run pi-gerar-erro-retorno (input 460, input return-value).
            end.                         

            /*--- Conta n∆o pode ser de saldo ---*/
            if  conta-contab.contas-pagar = 3 then do:
                run utp/ut-msgs.p (input "msg", 
                                   input 6276, 
                                   input string(conta-contab.conta-contabil, param-global.formato-conta-contabil)).
                run pi-gerar-erro-retorno (input 6276, input return-value).
            end.                         

        end.
    end.

    if  tt-imposto.conta-percepcao <> "" or
        tt-imposto.perc-percepcao <> 0 then do:  

        find first conta-contab no-lock
             where conta-contab.ep-codigo      = i-ep-codigo-usuario
             and   conta-contab.conta-contabil = tt-imposto.conta-percepcao
             no-error.

        if  not avail conta-contab then do:
            /* Conta nao cadastrada */
            run utp/ut-msgs.p (input "help",
                               input 1060,
                               input string(tt-imposto.conta-percepcao, param-global.formato-conta-contabil)).
            run pi-gerar-erro-retorno (input 1060, input return-value).
        end.
        else do:    
            if  conta-contab.tipo  = 6 then do:
                /* Conta de Titulo nao pode receber lancamento */
                run utp/ut-msgs.p (input "msg",
                                   input 1061,
                                   input string(conta-contab.conta-contabil, param-global.formato-conta-contabil)).
                run pi-gerar-erro-retorno (input 1061, input return-value).
            end.

            if  conta-contab.estado <> 3 then do:
                /* Conta Contabil nao e de Sistema */
                run utp/ut-msgs.p (input "help",
                                   input 1062,
                                   input string(conta-contab.conta-contabil, param-global.formato-conta-contabil)).
                run pi-gerar-erro-retorno (input 1062, input return-value).
            end.

            /*--- Conta n∆o pode receber lanátos no AP ---*/
            if  conta-contab.contas-pagar = 1 then do:
                run utp/ut-msgs.p (input "msg", 
                                   input 460, 
                                   input "").
                run pi-gerar-erro-retorno (input 460, input return-value).
            end.                         

            /*--- Conta n∆o pode ser de saldo ---*/
            if  conta-contab.contas-pagar = 3 then do:
                run utp/ut-msgs.p (input "help", 
                                   input 6276, 
                                   input string(conta-contab.conta-contabil, param-global.formato-conta-contabil)).
                run pi-gerar-erro-retorno (input 6276, input return-value).
            end.

        end.
    end.

    if  tt-imposto.conta-retencao <> "" or
        tt-imposto.perc-retencao <> 0 then do:  

        find first conta-contab no-lock
             where conta-contab.ep-codigo      = i-ep-codigo-usuario
             and   conta-contab.conta-contabil = tt-imposto.conta-retencao
             no-error.                    

        if  not avail conta-contab then do:
            /* Conta nao cadastrada */
            run utp/ut-msgs.p (input "help",
                               input 1060,
                               input string(tt-imposto.conta-retencao, param-global.formato-conta-contabil)).
            run pi-gerar-erro-retorno (input 1060, input return-value).
        end.
        else do:    
            if  conta-contab.tipo  = 6 then do:
                /* Conta de Titulo nao pode receber lancamento */
                run utp/ut-msgs.p (input "help",
                                   input 1061,
                                   input string(conta-contab.conta-contabil, param-global.formato-conta-contabil)).
                run pi-gerar-erro-retorno (input 1061, input return-value).
            end.

            if  conta-contab.estado <> 3 then do:
                /* Conta Contabil nao e de Sistema */
                run utp/ut-msgs.p (input "help",
                                   input 1062,
                                   input string(conta-contab.conta-contabil, param-global.formato-conta-contabil)).
                run pi-gerar-erro-retorno (input 1062, input return-value).
            end.
            /*--- Conta n∆o pode receber lanátos no AP ---*/
            if  conta-contab.contas-pagar = 1 then do:
                run utp/ut-msgs.p (input "msg", 
                                   input 460, 
                                   input "").
                run pi-gerar-erro-retorno (input 460, input return-value).
            end.                         

            /*--- Conta n∆o pode ser de saldo ---*/
            if  conta-contab.contas-pagar = 3 then do:
                run utp/ut-msgs.p (input "msg", 
                                   input 6276, 
                                   input string(conta-contab.conta-contabil, param-global.formato-conta-contabil)).
                run pi-gerar-erro-retorno (input 6276, input return-value).
            end.

        end.
    end.
end.

/* Fim de Include */

