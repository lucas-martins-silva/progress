    with down width 132 no-box  no-label stream-io frame f-detalhe.

form
    tt-tit-ap.cod-estabel            at  01
    tt-tit-ap.cod-esp                at  05
    tt-tit-ap.serie                  at  09
    tt-tit-ap.nr-docto               at  16
    tt-tit-ap.parcela                at  33
    tt-tit-ap.cod-fornec             to  44
    tt-tit-ap.transacao              at  46
    tt-tit-ap.referencia             at  51
    tt-tit-ap.dt-emissao             to  71
    tt-tit-ap.dt-vencimen            to  82
    tt-tit-ap.moeda                  to  85
    tt-tit-ap.vl-original            to 103
    tt-tit-ap.lancamento  no-label   to 106
    tt-tit-ap.valor-saldo            to 129
    tt-tit-ap.lancamento1 no-label   to 132
    with down width 132 no-box page-top stream-io frame f-det-detalhe.


form
    skip(4)
    c-grupo
    grupo-fornec.cod-gr-forn
    " - " 
    grupo-fornec.descricao  
    skip(3)
    with no-box no-labels column 45 no-attr-space stream-io width 132 frame f-grupo.

form
    skip(3)
    space(15) 
    c-resumo1    skip(2)
    c-30-ven     
    tt-resumo.ven-30 
    space(3)    
    de-per-30    
    "%"          skip(1)
    c-60-ven     
    tt-resumo.ven-60 
    space(3)   
    de-per-60    
    "%"          skip(1)
    c-90-ven     
    tt-resumo.ven-90 
    space(3)   
    de-per-90    
    "%"          skip(1)
    c-91-ven    
    tt-resumo.ven-999 
    space(3) 
    de-per-999  
    "%"          skip(1)
    space(20)
    c-total 
    space(3)
    tt-resumo.tot 
    space(3)   
    de-per-tot  
    "%"  
    with no-box no-labels column 35 no-attr stream-io width 132 frame f-vencidos.

form
    skip(1)
    space(15) 
    c-resumo2    skip(2)
    c-30-aven    
    tt-resumo.ven1-30 
    space(3)  
    de-per1-30   
    "%"          skip(1)
    c-60-aven    
    tt-resumo.ven1-60 
    space(3)  
    de-per1-60   
    "%"          skip(1)
    c-90-aven    
    tt-resumo.ven1-90 
    space(3)  
    de-per1-90   
    "%"          skip(1)
    c-120-aven   
    tt-resumo.ven1-120 
    space(3) 
    de-per1-120  
    "%"          skip(1)
    c-121-aven   
    tt-resumo.ven1-999 
    space(3) 
    de-per1-999  
    "%"          skip(1)
    space(20) 
    c-total          
    space(3)  
    tt-resumo.tot1 
    space(3)  
    de-per-tot1  
    "%"          skip(1)
    with no-box no-labels column 35 no-attr stream-io width 132 frame f-vencer.

form c-text-1                    no-label at 01 skip(2)
     tt-param.cod-est-ini        colon 40 
     "|< >|"                     at 60
     tt-param.cod-est-fim        no-label colon 65 skip
     tt-param.cod-esp-ini        colon 40 
     "|< >|"                     at 60
     tt-param.cod-esp-fim        no-label colon 65 skip
     tt-param.cod-fornec-ini     colon 40 
     "|< >|"                     at 60
     tt-param.cod-fornec-fim     no-label colon 65 skip
     tt-param.cod-grupo-ini      colon 40 
     "|< >|"                     at 60
     tt-param.cod-grupo-fim      no-label colon 65 skip
     tt-param.cod-port-ini       colon 40 
     "|< >|"                     at 60
     tt-param.cod-port-fim       no-label colon 65 skip
     tt-param.cod-matriz-ini     colon 40 
     "|< >|"                     at 60
     tt-param.cod-matriz-fim     no-label colon 65
     tt-param.cod-moeda-ini      colon 40 
     "|< >|"                     at 60
     tt-param.cod-moeda-fim      no-label colon 65 skip
     tt-param.c-conta-ini        colon 40 
     "|< >|"                     at 60
     tt-param.c-conta-fim        no-label colon 65 skip(2)
     c-text-4                    no-label at 01 skip(2)
     tt-param.desc-classifica    colon 40 no-label skip(2)
     c-text-2                    no-label at 01 skip(2)  
     tt-param.des-tipo-rel       colon 40
     tt-param.i-margem-dias      colon 40 skip
     tt-param.da-data-base       format "99/99/9999" colon 40 skip
     tt-param.des-tipo-resumo    colon 40 skip
     tt-param.da-calc-resumo     format "99/99/9999" colon 40 skip
     tt-param.log-param-prazo    colon 40 skip
     tt-param.i-venc-31          format ">>9" colon 40 space(05) "|< >|"
     tt-param.i-venc-60          format ">>9" no-label colon 55 
     c-dia                       no-label colon 60 skip
     tt-param.i-venc-61          format ">>9" colon 40 space(05) "|< >|"
     tt-param.i-venc-90          format ">>9" no-label colon 55 
     c-dia-um                    no-label colon 60 skip
     tt-param.i-a-venc-31        format ">>9" colon 40 space(05) "|< >|"
     tt-param.i-a-venc-60        format ">>9" no-label colon 55 
     c-dia-dois                  no-label colon 60 skip
     tt-param.i-a-venc-61        format ">>9" colon 40 space(05) "|< >|"
     tt-param.i-a-venc-90        format ">>9" no-label colon 55 
     c-dia-treis                 no-label colon 60 skip
     tt-param.i-a-venc-91        format ">>9" colon 40 space(05) "|< >|"
     tt-param.i-a-venc-120       format ">>9" no-label colon 55      
     c-dia-quat                  no-label colon 60 skip      
     tt-param.log-lis-antec      colon 40 skip
     tt-param.log-lis-prev       colon 40 skip
     tt-param.log-lis-hist-prev  colon 40 skip
     tt-param.log-lis-hist-docto colon 40 skip
     tt-param.log-cons-mo-orig   colon 40 skip
     tt-param.da-corte           format "99/99/9999" colon 40 skip
     tt-param.i-cod-moeda        colon 40 skip
     tt-param.da-conversao       format "99/99/9999" colon 40 skip
     tt-param.de-cotacao-dia     colon 40 skip
     with down no-box side-labels stream-io width 132 frame f-parametros.

form tt-param.log-lis-prov       colon 40 skip
     with down no-box side-labels stream-io width 132 frame f-param-prov.

form c-text-3                    no-label at 01 skip(2)
     c-destino                   format "x(80)" colon 40 skip
     tt-param.usuario            colon 40 skip(2)
     with down no-box side-labels stream-io width 132 frame f-parametros2.

form
    tt-resumo-conta.conta-saldo
    tt-resumo-conta.titulo
    tt-resumo-conta.de-contas-pagar
    c-lancto-1 no-label                      
    tt-resumo-conta.de-contabilidade
    c-lancto-3 no-label
    tt-resumo-conta.de-diferenca
    with no-attr no-box width 132 down stream-io frame f-conta.
run utp/ut-trfrrp.p (input frame f-detalhe:handle).
run utp/ut-trfrrp.p (input frame f-det-detalhe:handle).
run utp/ut-trfrrp.p (input frame f-grupo:handle).
run utp/ut-trfrrp.p (input frame f-vencidos:handle).
run utp/ut-trfrrp.p (input frame f-vencer:handle).
run utp/ut-trfrrp.p (input frame f-parametros:handle).
run utp/ut-trfrrp.p (input frame f-param-prov:handle).
run utp/ut-trfrrp.p (input frame f-parametros2:handle).
run utp/ut-trfrrp.p (input frame f-conta:handle).

{utp/ut-liter.i Conta_Cont bil}
assign tt-resumo-conta.conta-saldo:label in frame f-conta = trim(return-value).

{utp/ut-liter.i Contas_a_Pagar}
assign tt-resumo-conta.de-contas-pagar:label in frame f-conta = trim(return-value).

{utp/ut-liter.i Contabilidade}
assign tt-resumo-conta.de-contabilidade:label in frame f-conta = trim(return-value).

{utp/ut-liter.i Diferen‡a}
assign tt-resumo-conta.de-diferenca:label in frame f-conta = trim(return-value).

assign tt-resumo-conta.conta-saldo:format in frame f-conta = param-global.formato-conta-contabil.

