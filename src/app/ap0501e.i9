/**************************************************************************
***
*** app/ap0501e.i9 - Cria T¡tulo Reten‡Æo.
***
**************************************************************************/

find first emitente use-index codigo
     where emitente.cod-emitente = lin-i-ap.cod-fornec
     and   emitente.identific   <> 1 no-lock no-error.

find first espec-ap
     where espec-ap.cod-esp = trim(substring(impto-tit-pend-ap.char-1, 01,02))
     no-lock no-error.

create b-tit-ap.
assign b-tit-ap.ep-codigo       = tit-ap.ep-codigo
       b-tit-ap.cod-estabel     = tit-ap.cod-estabel
       b-tit-ap.cod-esp         = trim(substring(impto-tit-pend-ap.char-1, 01,02))
       b-tit-ap.serie           = trim(substring(impto-tit-pend-ap.char-1, 03,05))
       b-tit-ap.nr-docto        = trim(substring(impto-tit-pend-ap.char-1, 08,16))
       b-tit-ap.parcela         = trim(substring(impto-tit-pend-ap.char-1, 24,02))
       b-tit-ap.serie-ant       = tit-ap.serie
       b-tit-ap.esp-ant         = tit-ap.cod-esp
       b-tit-ap.docto-ant       = tit-ap.nr-docto
       b-tit-ap.parc-ant        = tit-ap.parcela
       b-tit-ap.cod-fornec      = tit-ap.cod-fornec
       b-tit-ap.transacao       = 1
       b-tit-ap.dt-transacao    = tit-ap.dt-transacao
       b-tit-ap.portador        = tit-ap.portador
       b-tit-ap.modalidade      = tit-ap.modalidade
       b-tit-ap.referencia      = lin-i-ap.referencia 
       b-tit-ap.tipo            = espec-ap.tipo
       b-tit-ap.nome-abrev      = emitente.nome-abrev
       b-tit-ap.cgc             = emitente.cgc
       b-tit-ap.calcula-cmi     = espec-ap.calc-var-cmi
       b-tit-ap.moeda           = 0
       b-tit-ap.cotacao-dia     = 1
       b-tit-ap.vl-original     = {1}
       b-tit-ap.vl-liquido      = {1}
       b-tit-ap.valor-saldo     = {1}
       b-tit-ap.vl-orig-me      = {1}
       b-tit-ap.vl-liquido-me   = {1}
       b-tit-ap.vl-saldo-me     = {1}
       b-tit-ap.observacao      = {2}
       b-tit-ap.conta-debito    = {3}
       b-tit-ap.ct-conta-db     = {4}
       b-tit-ap.sc-conta-db     = {5}      
       b-tit-ap.valor-ir        = impto-tit-pend-ap.vl-base
       b-tit-ap.cod-impto-ret   = {7}
       b-tit-ap.dt-emissao      = {6}  
       b-tit-ap.dt-prev-pag     = {8}
       b-tit-ap.dt-vencimen     = {8}
       b-tit-ap.cod-retencao    = {9}
       b-tit-ap.tp-codigo       = {10}
       b-tit-ap.ind-ir          = yes
       b-tit-ap.origem          = lin-i-ap.origem
       b-tit-ap.tp-pagto        = tit-ap.tp-pagto.      
       
find first espec-ap
     where espec-ap.cod-esp = substring(impto-tit-pend-ap.char-1, 01,02) no-lock no-error.
        
if avail espec-ap and espec-ap.tipo = 8 then        
     assign tit-ap.valor-ir = impto-tit-pend-ap.vl-base.


run pi-epc-pagto.

/*--- Quando for documento de IR  e for
      gerado pelo acumulado l-acum-ir = yes ---*/
&IF DEFINED (BF_FIN_TAB_PROG_IR) &THEN
    assign b-tit-ap.l-acum-ir = impto-tit-pend-ap.l-acum-ir.
&ENDIF


/*--- Lote Gerado Pelo MultiPlanta ---*/
if  doc-i-ap.log-2 = yes then do:
    assign b-tit-ap.origem = 3.
end.                        

assign c-matriz = emitente.nome-matriz.

find first emitente
     where emitente.nome-abrev = c-matriz
     and   emitente.identific <> 1 no-lock no-error.

if  avail emitente then
    assign b-tit-ap.matriz = emitente.cod-emitente.

run app/ap0501ea.p (input rowid(b-tit-ap)).

create mov-ap.
assign mov-ap.ep-codigo      = b-tit-ap.ep-codigo
       mov-ap.cod-estabel    = b-tit-ap.cod-estabel
       mov-ap.nr-docto       = b-tit-ap.nr-docto
       mov-ap.parcela        = b-tit-ap.parcela
       mov-ap.serie          = b-tit-ap.serie
       mov-ap.cod-esp        = b-tit-ap.cod-esp
       mov-ap.transacao      = 1
       mov-ap.tipo           = b-tit-ap.tipo
       mov-ap.nome-abrev     = b-tit-ap.nome-abrev
       mov-ap.esp-ant        = tit-ap.cod-esp
       mov-ap.serie-ant      = tit-ap.serie
       mov-ap.docto-ant      = tit-ap.nr-docto
       mov-ap.parc-ant       = tit-ap.parcela
       mov-ap.fornec-ant     = tit-ap.cod-fornec
       mov-ap.conta-contabil = b-tit-ap.conta-debito
       mov-ap.ct-conta       = b-tit-ap.ct-conta-db
       mov-ap.sc-conta       = b-tit-ap.sc-conta-db
       mov-ap.cod-fornec     = b-tit-ap.cod-fornec
       mov-ap.portador       = b-tit-ap.portador
       mov-ap.modalidade     = b-tit-ap.modalidade
       mov-ap.dt-emissao     = b-tit-ap.dt-emissao
       mov-ap.dt-transacao   = b-tit-ap.dt-transacao
       mov-ap.dt-vencimen    = b-tit-ap.dt-vencimen
       mov-ap.dt-today       = today
       mov-ap.referencia     = b-tit-ap.referencia
       mov-ap.contabilizou   = no
       mov-ap.emit-fita      = no
       mov-ap.lancamento     = 2
       mov-ap.hp-codigo      = impto-tit-pend-ap.hp-codigo
       mov-ap.historico      = impto-tit-pend-ap.historico
       mov-ap.vl-original    = b-tit-ap.vl-original
       mov-ap.valor-mov      = b-tit-ap.vl-original
       mov-ap.moeda          = b-tit-ap.moeda
       mov-ap.cotacao-dia    = b-tit-ap.cotacao-dia
       mov-ap.vl-orig-me     = b-tit-ap.vl-orig-me
       mov-ap.valor-mov-me   = b-tit-ap.vl-orig-me
       mov-ap.tp-codigo      = b-tit-ap.tp-codigo
       mov-ap.ind-ir         = b-tit-ap.ind-ir
       mov-ap.valor-ir       = b-tit-ap.valor-ir
       mov-ap.cod-retencao   = b-tit-ap.cod-retencao
       mov-ap.usuario        = c-seg-usuario
       mov-ap.c-time         = string(time, "HH:MM")
       mov-ap.origem         = b-tit-ap.origem.

find first portador 
     where portador.ep-codigo    = mov-ap.ep-codigo
     and   portador.cod-portador = mov-ap.portador
     and   portador.modalidade   = mov-ap.modalidade
     no-lock no-error.
if avail portador then do:
   if  portador.log-1 = yes then /* Identifica se o mesmo ‚ centralizador */
       assign mov-ap.conta-var-monetaria = "CENTRALIZADOR".
   else
       assign mov-ap.conta-var-monetaria = "NAO CENTRALIZADOR".
end.

if  mov-ap.conta-contabil = "" then do:
    find first tit-conta-ap no-lock
         where tit-conta-ap.ep-codigo   = b-tit-ap.ep-codigo
         and   tit-conta-ap.cod-estabel = b-tit-ap.cod-estabel
         and   tit-conta-ap.cod-esp     = b-tit-ap.cod-esp
         and   tit-conta-ap.serie       = b-tit-ap.serie
         and   tit-conta-ap.nr-docto    = b-tit-ap.nr-docto
         and   tit-conta-ap.parcela     = b-tit-ap.parcela
         and   tit-conta-ap.cod-fornec  = b-tit-ap.cod-fornec no-error.

    if  avail tit-conta-ap then do:
        assign mov-ap.conta-contabil = tit-conta-ap.conta-debito
               mov-ap.ct-conta       = tit-conta-ap.ct-codigo
               mov-ap.sc-conta       = tit-conta-ap.sc-codigo.
    end.
end.

/*-------- EMITE-AP ----------*/
find espec-ap where espec-ap.cod-esp = b-tit-ap.cod-esp no-lock no-error.

if  avail espec-ap then do:                
    if  espec-ap.emite-ap = yes then do:    
        find first emite-ap
             where emite-ap.ep-codigo   = b-tit-ap.ep-codigo
             and   emite-ap.cod-estabel = b-tit-ap.cod-estabel
             and   emite-ap.cod-esp     = b-tit-ap.cod-esp
             and   emite-ap.serie       = b-tit-ap.serie
             and   emite-ap.nr-docto    = b-tit-ap.nr-docto
             and   emite-ap.parcela     = b-tit-ap.parcela
             and   emite-ap.cod-fornec  = b-tit-ap.cod-fornec
             and   emite-ap.transacao   = 1
             no-lock no-error.

        if  not avail emite-ap then do:
            create emite-ap.
            assign emite-ap.ep-codigo   = b-tit-ap.ep-codigo
                   emite-ap.cod-estabel = b-tit-ap.cod-estabel
                   emite-ap.cod-esp     = b-tit-ap.cod-esp
                   emite-ap.serie       = b-tit-ap.serie
                   emite-ap.nr-docto    = b-tit-ap.nr-docto
                   emite-ap.parcela     = b-tit-ap.parcela
                   emite-ap.cod-fornec  = b-tit-ap.cod-fornec
                   emite-ap.dt-emissao  = b-tit-ap.dt-emissao
                   emite-ap.dt-vencimen = b-tit-ap.dt-vencimen
                   emite-ap.valor-ap    = b-tit-ap.vl-saldo
                   emite-ap.referencia  = doc-i-ap.referencia
                   emite-ap.transacao   = 1.
        end.
    end.
end.    

if  c-nom-prog-upc-mg97  <> "" or
    c-nom-prog-dpc-mg97  <> "" or
    c-nom-prog-appc-mg97 <> "" then do:

    for each tt-epc 
        where tt-epc.cod-event = "TIPO_PAGTO"
        exclusive-lock:

        delete tt-epc.

    end.    

    create tt-epc.
    assign tt-epc.cod-event     = "TIPO_PAGTO"
           tt-epc.cod-parameter = "documento-retencao"
           tt-epc.val-parameter = string(rowid(b-tit-ap)).

{include/i-epc201.i "TIPO_PAGTO"}
end.

/*-------- INTEGRA€åES ---------*/
{app/ap9100.i2}
assign tt-integ-ap.tt-row-tit-ap  = rowid(b-tit-ap)
       tt-integ-ap.tt-row-mov-ap  = rowid(mov-ap)
       tt-integ-ap.tt-cb1202a     = yes
       tt-integ-ap.tt-cb0110a     = yes
       tt-integ-ap.tt-fc1014a     = yes
       tt-integ-ap.tt-fc1114a     = yes
       tt-integ-ap.tt-op-cb1202a  = 16
       tt-integ-ap.tt-op-cb0110a  = 16.
raw-transfer tt-integ-ap to raw-integracao.
run app/ap9100.p (Input raw-integracao, input-output table tt-erro).

create tt-mov-ap.
assign tt-mov-ap.r-mov-ap-ava = rowid(mov-ap)
       tt-mov-ap.r-tit-ap-ava = rowid(tit-ap).

/*--- Lote Gerado Pelo MultiPlanta ---*/
if  doc-i-ap.log-2 = yes then do:
    assign mov-ap.flag-contab  = no 
           mov-ap.contabiliza  = no
           mov-ap.contabilizou = no
           mov-ap.origem       = 3.
end.                        

/* Fim de Include */
