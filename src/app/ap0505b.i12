/****************************************************************************
***
*** app/ap0505b.i12 - Impostos Referente Juros Pagos.
***
****************************************************************************/

{utp/ut-liter.i juros_Pagos * C}    
run utp/ut-msgs.p (input "show",
                   input 6097,
                   input trim(return-value)).
                
if  return-value = 'yes':U then do:
    
    {utp/ut-liter.i Juros_Pagos * C}
    assign c-observacao = trim(return-value).
    
    find first b-impto-tit-ap use-index codigo
       where b-impto-tit-ap.ep-codigo    = tit-ap.ep-codigo
         and b-impto-tit-ap.cod-estabel  = tit-ap.cod-estabel
         and b-impto-tit-ap.cod-esp      = tit-ap.cod-esp
         and b-impto-tit-ap.serie        = tit-ap.serie
         and b-impto-tit-ap.nr-docto     = tit-ap.nr-docto
         and b-impto-tit-ap.parcela      = tit-ap.parcela
         and b-impto-tit-ap.cod-fornec   = tit-ap.cod-fornec
         and b-impto-tit-ap.mo-codigo    <> 0
         and b-impto-tit-ap.cotacao-dia  <> lin-b-ap.cotacao-dia
       no-error.
    
    if  avail b-impto-tit-ap then do:
        run utp/ut-msgs.p (input "show",
                           input 6859,
                           input trim(c-observacao)).
        if  return-value = 'yes':U then do:
            assign l-juros = yes.
        end.
        else do:
            assign l-juros = no.
        end.
    end.

    assign l-soma = yes.

    {app/ap0505b.i9 "1" 
                    "lin-b-ap.vl-juros" 
                    "lin-b-ap.vl-juros-me"
                    "l-juros"
                    "4"}

end.

/* Fim de Include */
