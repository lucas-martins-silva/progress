/****************************************************************************
***
*** app/ap0706rp.i4 - Inicializaá∆o do Relat¢rio (Usado Detalhado/Resumido).
***
****************************************************************************/
    
create tt-param.
raw-transfer raw-param to tt-param.
    
run utp/ut-acomp.p persistent set h-acomp.
run pi-inicializar in h-acomp (input "Raz∆o dos Movimentos").
    
{include/i-rpout.i}
    
find empresa where empresa.ep-codigo = i-ep-codigo-usuario no-lock no-error.
    
{utp/ut-liter.i Raz∆o_dos_Movimentos * C}
assign c-titulo-relat = trim(return-value).
    
{utp/ut-liter.i CONTAS_A_PAGAR}
assign c-sistema = trim(return-value).
    
{utp/ut-liter.i ANTECIPAÄ«O * C}
assign c-texto = trim(return-value) + " - ":U.
    
{utp/ut-liter.i Fornecedor * L}
assign c-text-acomp = trim(return-value) + ": ":U.
    
assign c-empresa  = empresa.razao-social
       c-programa = "AP/0706".

/* Fim de Include */
