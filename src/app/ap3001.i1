/*--- DEFINI€ÇO DAS TEMP-TABLES TT-INVEST-MG E TT-ERROS-INVEST-MG ---*/

DEFINE TEMP-TABLE tt-invest-mg no-undo
       field ep-codigo     like empresa.ep-codigo
       field num-ord-inv   as integer
       field r-rowid       as rowid.
      
      
DEFINE TEMP-TABLE tt-erros-invest-mg no-undo
       field i-cod-erro    as integer
       field c-mensagem    as character
       field desfaz-trans   as logical
       field r-rowid       as rowid.

