find param-fasb
    where param-fasb.ep-codigo = i-ep-codigo-usuario no-lock no-error.
if avail param-fasb then do:
    if avail tit-ap then do:
        if tit-ap.tipo = 2 then do:
            assign de-dolar = tit-ap.vl-sal-fasb / 100.
        end.
        else do:
            if param-fasb.tipo-calculo = 0 then do:
                {cdp/cd9600.i "param-fasb.moeda-fasb"
                              "tit-ap.dt-emissao" 
                              "de-dolar"
                              " "
                              "msg"}
                assign de-dolar = de-dolar *
                                  (tit-ap.vl-sal-fasb / tit-ap.vl-orig-fasb).
            end.
            else
                assign de-dolar = tit-ap.vl-sal-fasb / 100.
        end.
        &if "{&mgadm_version}" <= "2.02" &then  
            if tit-ap.tipo = 2 then do:
                {cdp/cd9600.i "param-fasb.moeda-fasb"
                              "tit-ap.dt-emissao"
                              "de-dolar"
                              " "
                              "msg"}
            end. 
        &endif
    end.
end.

if avail tit-ap then do:
    assign de-vl-sal-fasb  = tit-ap.valor-saldo / de-dolar
           de-vl-orig-fasb = tit-ap.vl-original / de-dolar.
    find first b-mov-ap
         where b-mov-ap.ep-codigo  = tit-ap.ep-codigo
         and   b-mov-ap.cod-est    = tit-ap.cod-est
         and   b-mov-ap.cod-esp    = tit-ap.cod-esp
         and   b-mov-ap.serie      = tit-ap.serie
         and   b-mov-ap.nr-docto   = tit-ap.nr-docto
         and   b-mov-ap.parcela    = tit-ap.parcela
         and   b-mov-ap.cod-fornec = tit-ap.cod-fornec
         and   b-mov-ap.transacao  = 1
         no-lock no-error.
    if avail b-mov-ap then
        assign de-vl-orig-fasb = b-mov-ap.vl-mov-fasb.

    if de-vl-sal-fasb  = ? then assign de-vl-sal-fasb  = 0.
    if de-vl-orig-fasb = ? then assign de-vl-orig-fasb = 0.   
end.

if not avail param-global then
    find first param-global no-lock no-error.

if avail param-global and  param-global.modulo-fc = no then do:
    assign de-vl-orig-fasb = 0.
end.

disp c-div-fasb 
 with frame f-div-fasb.

disp de-vl-orig-fasb
     de-vl-sal-fasb
     with frame f-fasb-1.

if l-modulo-fc then do:
    run pi-criar-tt-mov-ap.
end.

for each tt-mov-ap
    where tt-mov-ap.transacao <> 9
    and   l-modulo-fc          = yes exclusive-lock
    by tt-mov-ap.dt-today
    by tt-mov-ap.c-time.

    run pi-calcula-valores.

    if tt-mov-ap.transacao = 8 then
        assign de-vl-mov-fasb = de-ganho-perda.
    else
        assign de-vl-mov-fasb = tt-mov-ap.vl-mov-fasb.

    disp entry(tt-mov-ap.transacao, c-lista-trans) @ c-transac
         tt-mov-ap.dt-trans
         tt-mov-ap.dt-vencimen
         de-vl-mov-fasb
         de-efeito-maxi       
         de-ganho-perda       
         with frame f-fasb-2.
    down with frame f-fasb-2.
end.
