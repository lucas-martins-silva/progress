/**************************************************************************
**
**  AP1001P.I1 - Registros header do banco UNIBANCO
**
**************************************************************************/

find first empresa where empresa.ep-codigo = i-empresa no-lock no-error.
find first portador where portador.ep-codigo = i-empresa and
           portador.cod-portador = i-portador no-lock no-error.
find first cta-corrente
     where cta-corrente.cod-banco    = portador.cod-banco
     and   cta-corrente.agencia      = portador.agencia
     and   cta-corrente.conta-corren = portador.conta-corren
     no-lock no-error.
find banco where banco.cod-banco = portador.cod-banco no-lock no-error.

put stream relat
    "0"                                                     at 001
    "1"                                                     at 002
    "REMESSA"                                               at 003
    "08"                                                    at 010
    "CONTAS A PAGAR"                                        at 012
    substr(cta-corren.agencia-extrato,3,4)  format "9999"   at 026
    substr(cta-corren.conta-corren-ext,5,6) format "999999" at 030
    substr(cta-corren.conta-corren-ext,11,1) format "9"     at 036
    fn-free-accent(caps(empresa.razao-social)) format "x(30)" at 037
    "409"                                                   at 067
    "UNIBANCO"                                              at 070
    day(today)              format "99"                     at 085
    month(today)            format "99"                     at 087
    substr(string(year(today),"9999"),3,2) format "99"      at 089
    i-num-reg format "999999"                               at 315.

put stream relat skip.

/* AP1001P.I1 */
