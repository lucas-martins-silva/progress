/***************************************************************************
** ap1001c.i5
** Objetivo: Gerar registro Trailer do Lote para o HSBC-Bamerindus.
***************************************************************************/

/* Trailer do lote */
assign i-num-reg     = i-num-reg     + 1
       i-num-reg-arq = i-num-reg-arq + 1.

/* trailer de lote */
if  tt-param.i-tipo-pag < 30 then
    put stream relat
        "399"                                                         at 001
        i-num-reg                                                     at 004
        "5"                                                           at 008
        "         "                                                   at 009
        i-num-reg                            format "999999"          at 018
        "   "                                                         at 024
        de-tot-geral-l * 100                 format "999999999999999" at 027
        " "                                                           at 240 
        skip.
else
    put stream relat
        "399"                                                         at 001
        i-num-reg                                                     at 004
        "5"                                                           at 008
        "         "                                                   at 009
        i-num-reg                            format "999999"          at 018
        "   "                                                         at 024
        de-tot-geral-l * 100                 format "999999999999999" at 027
        " "                                                           at 240
        skip. 
    
    
/* trailer do arquivo */
assign i-num-reg-arq = i-num-reg-arq + 1.
put stream relat
    "399"                                                             at 001
    "9999"                                                            at 004
    "9"                                                               at 008
    "         "                                                       at 009
    "000001"                                   format "999999"        at 018
    i-num-reg-arq                              format "999999"        at 024
    " "                                                               at 240 
    skip.

/* Fim da Include */


