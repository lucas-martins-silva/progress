/*******************************************************************************
**
**  Include.: AP0711.I2
**  Objetivo: ImpressÆo da parametriza‡Æo utilizada no relat¢rio
**
*******************************************************************************/

{utp/ut-liter.i SELE€ÇO * C}
assign c-text-6 = trim(return-value).
{utp/ut-liter.i CLASSIFICA€ÇO * C}
assign c-text-7 = trim(return-value).
{utp/ut-liter.i PAR¶METROS * C}
assign c-text-8 = trim(return-value).
{utp/ut-liter.i IMPRESSÇO * C}
assign c-text-9 = trim(return-value).

{utp/ut-field.i mgadm tit-ap cod-estabel 1}
assign tt-param.estab-ini:label in frame f-parametros = return-value.
{utp/ut-field.i mgadm emite-ap cod-fornec 1}
assign tt-param.for-ini:label in frame f-parametros = return-value.
{utp/ut-field.i mgadm tit-ap cod-esp 1}
assign tt-param.esp-ini:label in frame f-parametros = return-value.
{utp/ut-liter.i Vencimento * C}
assign tt-param.venc-ini:label in frame f-parametros = return-value.
{utp/ut-liter.i EmissÆo * C}
assign tt-param.emis-ini:label in frame f-parametros = return-value.
{utp/ut-liter.i Transa‡Æo * C}
assign tt-param.trans-ini:label in frame f-parametros = return-value. 
{utp/ut-field.i mgadm tit-ap serie 1}
assign tt-param.serie-ini:label in frame f-parametros = return-value. 
{utp/ut-liter.i Documento * C}
assign tt-param.num-ini:label in frame f-parametros = return-value. 
{utp/ut-field.i mgadm tit-ap parcela 1}
assign tt-param.parc-ini:label in frame f-parametros = return-value. 

       
{utp/ut-liter.i Por_Folha * C}
assign tt-param.folha:label in frame f-parametros = trim(return-value).
{utp/ut-liter.i Considera_data_de_desconto * C}
assign tt-param.considera:label in frame f-parametros = trim(return-value).
{utp/ut-liter.i ReemissÆo * C}
assign tt-param.reemissao:label in frame f-parametros = trim(return-value).
{utp/ut-liter.i Usu rio * C}
assign tt-param.usuario:label in frame f-parametros = trim(return-value).
{utp/ut-liter.i Destino * C}
assign c-destino:label in frame f-parametros = trim(return-value)
       c-destino = {varinc/var00002.i 04 tt-param.destino}.

if  page-number > 0 then page.

display c-text-6
        tt-param.estab-ini
        tt-param.estab-fim 
        tt-param.for-ini
        tt-param.for-fim 
        tt-param.esp-ini
        tt-param.esp-fim
        tt-param.venc-ini
        tt-param.venc-fim
        tt-param.emis-ini
        tt-param.emis-fim
        tt-param.trans-ini
        tt-param.trans-fim
        tt-param.serie-ini
        tt-param.serie-fim 
        tt-param.num-ini
        tt-param.num-fim
        tt-param.parc-ini
        tt-param.parc-fim
        c-text-7
        tt-param.desc-classifica
        c-text-8
        tt-param.folha
        c-text-9
        c-destino
        " - ":U
        tt-param.arquivo
        tt-param.usuario
        with frame f-parametros.

do  with frame f-parametros:
    if  tt-param.reemissao = yes then {utp/ut-liter.i Sim * C} else {utp/ut-liter.i NÆo * C}.
    disp trim(return-value) @ tt-param.reemissao.
    if  tt-param.considera = yes then {utp/ut-liter.i Sim * C} else {utp/ut-liter.i NÆo * C}.
    disp trim(return-value) @ tt-param.considera.
end.

down with frame f-parametros.

