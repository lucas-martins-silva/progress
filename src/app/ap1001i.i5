/* Trailler do Arquivo */

put stream relat
    "9"                                                               at 001
    "000000000000000000"                                              at 002
    de-hea-val                            format "999999999999999999" at 020
    "000000000000000000"                                              at 038
    i-num-reg + 1                                     format "999999" at 395
    skip.
