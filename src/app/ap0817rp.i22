/*************************************************************************
**
**   Include: ap0817rp.i22 
**
**   Impressao do relatorio, para opcao "Sintetico Dia".
*************************************************************************/

block-disp:
for each tt-concil-ap no-lock
    break by tt-concil-ap.ct-conta
          by tt-concil-ap.sc-conta
          by tt-concil-ap.dt-contab:

    assign c-conta = string(trim(tt-concil-ap.ct-conta) + trim(tt-concil-ap.sc-conta),param-global.formato-conta-contabil).
    {utp/ut-liter.i Imprimindo_Conta: * L}
    run pi-acompanhar in h-acomp (input return-value + " " + c-conta).

    if first-of(tt-concil-ap.ct-conta)
    or first-of(tt-concil-ap.sc-conta) then    
        assign l-first-of = yes.

    if  (l-imp-dif = yes
    and (tt-concil-ap.debito-contab  <> tt-concil-ap.debito-modulo
    or   tt-concil-ap.credito-contab <> tt-concil-ap.credito-modulo)
    or   l-imp-dif = no) then do:
        if  l-first-of = yes then do:

            if line-counter >= 56 then
                page.
                
            disp c-label-1
                 c-label-2
                 c-conta
                 tt-concil-ap.titulo
                 c-label-15      
                 c-label-16    
                 c-label-7     
                 c-label-8       
                 c-label-9       
                 c-label-10      
                 c-label-17      
                 /*c-label-11*/      
                 c-label-12      
                 c-label-20      
                 c-label-19      
                 c-label-21      
                 with frame f-cab-conta-dia.
            assign l-first-of = no.
        end.
        if line-counter >= 64 then do:
            if  tt-concil-ap.ct-conta = c-ct-cont-ant
            and tt-concil-ap.sc-conta = c-sc-cont-ant then
                disp c-label-15 
                     c-label-16 
                     c-label-7  
                     c-label-8  
                     c-label-9  
                     c-label-10 
                     c-label-17 
                     /*c-label-11*/ 
                     c-label-12 
                     c-label-2  
                     c-label-19 
                     c-label-21 
                   with frame f-cab-pag-conta-dia.
        end.
        
        if tt-concil-ap.docto <> "" then
            assign c-docto = trim(tt-concil-ap.docto) + c-barra + tt-concil-ap.parcela.
        else
            assign c-docto = "".

        disp tt-concil-ap.dt-contab      when tt-concil-ap.debito-contab  <> 0
                                         or   tt-concil-ap.credito-contab <> 0
             tt-concil-ap.refer
             tt-concil-ap.debito-contab  when tt-concil-ap.debito-contab  <> 0
             tt-concil-ap.credito-contab when tt-concil-ap.credito-contab <> 0
             tt-concil-ap.dt-modulo
             tt-concil-ap.espec 
             c-docto                     when c-docto <> ""
             tt-concil-ap.debito-modulo  when tt-concil-ap.debito-modulo  <> 0
             tt-concil-ap.credito-modulo when tt-concil-ap.credito-modulo <> 0
             with frame f-det-sin-dia.
        down with frame f-det-sin-dia.
    end.
    
    if  l-imp-dif = yes then do:
        if tt-concil-ap.debito-contab  <> tt-concil-ap.debito-modulo
        or tt-concil-ap.credito-contab <> tt-concil-ap.credito-modulo then
        
            assign de-vl-debito-contab  = de-vl-debito-contab  + tt-concil-ap.debito-contab
                   de-vl-credito-contab = de-vl-credito-contab + tt-concil-ap.credito-contab
                   de-vl-debito-modulo  = de-vl-debito-modulo  + tt-concil-ap.debito-modulo
                   de-vl-credito-modulo = de-vl-credito-modulo + tt-concil-ap.credito-modulo.
    end.
    else 
        assign de-vl-debito-contab  = de-vl-debito-contab  + tt-concil-ap.debito-contab
               de-vl-credito-contab = de-vl-credito-contab + tt-concil-ap.credito-contab
               de-vl-debito-modulo  = de-vl-debito-modulo  + tt-concil-ap.debito-modulo
               de-vl-credito-modulo = de-vl-credito-modulo + tt-concil-ap.credito-modulo.

    assign c-ct-cont-ant = tt-concil-ap.ct-conta
           c-sc-cont-ant = tt-concil-ap.sc-conta.

    if last-of(tt-concil-ap.ct-conta)
    or last-of(tt-concil-ap.sc-conta) then do:
      
        assign de-vl-debito-difer   = absolute(de-vl-debito-contab  - de-vl-debito-modulo)
               de-vl-credito-difer  = absolute(de-vl-credito-contab - de-vl-credito-modulo).
               
        if  (l-imp-dif = yes 
        and (de-vl-debito-difer  <> 0
        or  de-vl-credito-difer  <> 0)
        or  l-imp-dif = no) then do:
            disp c-label-13 
                 c-label-4  
                 c-label-5  
                 c-label-6  
                 c-debito
                 de-vl-debito-contab
                 de-vl-debito-modulo
                 de-vl-debito-difer
                 c-credito
                 de-vl-credito-contab
                 de-vl-credito-modulo
                 de-vl-credito-difer
                 with frame f-tot-dia.
        end.

        assign de-vl-debito-contab  = 0
               de-vl-credito-contab = 0
               de-vl-debito-modulo  = 0
               de-vl-credito-modulo = 0.
    end.
end /*block-disp*/.
/* Fim de Include */
