if can-find(first tt-documento) then do:
    disp c-div-movto
         with frame f-div-movto.
end.

for each tt-documento exclusive-lock:
    assign c-transac = entry(tt-documento.transacao , c-lista-trans).
    disp c-transac
         tt-documento.portador         
         tt-documento.c-modalidade     
         tt-documento.dt-transacao     
         tt-documento.c-lanca
         tt-documento.valor-mov
         tt-documento.valor-mov-me
         tt-documento.moeda            
         tt-documento.cotacao-dia
         tt-documento.i-nr-bordero
         tt-documento.nr-cheque 
         tt-documento.emit-fita    
         tt-documento.contabiliza  
         tt-documento.contabilizou
         tt-documento.valor-presente
         tt-documento.valor-juros
         tt-documento.vl-desconto
         tt-documento.de-vl-juros-neg
         &if defined(BF_FIN_MULTA_ABATIMENTO) &then
         tt-documento.vl-multa
         tt-documento.vl-abatimento
         &endif
         tt-documento.dt-vencimen
         tt-documento.referencia       format 'x(11)'
         tt-documento.esp-ant
         tt-documento.serie-ant
         tt-documento.docto-ant
         tt-documento.parc-ant
         tt-documento.fornec-ant       format '>>>>>>>>>>9'
         tt-documento.vl-antecip
         with frame f-movto.
    down with frame f-movto.
    
    find first mov-ap
        where rowid(mov-ap) = tt-documento.gr-tt-doc no-lock no-error.
    if avail mov-ap then do:       
        find first tit-ap 
            where tit-ap.ep-codigo   = mov-ap.ep-codigo
            and   tit-ap.cod-estabel = mov-ap.cod-estabel
            and   tit-ap.cod-fornec  = mov-ap.cod-fornec
            and   tit-ap.cod-esp     = mov-ap.cod-esp
            and   tit-ap.serie       = mov-ap.serie
            and   tit-ap.nr-docto    = mov-ap.nr-docto
            and   tit-ap.parcela     = mov-ap.parcela no-lock no-error.
        if avail tit-ap then do:
            for each tt-mov-ap-2 exclusive-lock:
                delete tt-mov-ap-2.
            end.
            for each tt-movto exclusive-lock:
                delete tt-movto.
            end.
            
            create tt-movto.
            assign tt-movto.r-tit-ap         = rowid(tit-ap)
                   tt-movto.r-mov-ap         = rowid(mov-ap)
                   tt-movto.cod-versao-integ = 001
                   tt-movto.l-vid-rel        = yes.
                   
            run app/apapi011.p (input  table tt-movto,
                                output table tt-mov-ap-2,
                                output table tt-erro-mov-ap).

            if can-find(first tt-mov-ap-2) then do:
                disp c-div-movto-contab
                     with frame f-div-movto-contab.
            end.

            for each tt-mov-ap-2 exclusive-lock:
                disp string(tt-mov-ap-2.cod-conta, c-formato) @ tt-mov-ap-2.cod-conta
                     tt-mov-ap-2.titulo
                     tt-mov-ap-2.valor
                     tt-mov-ap-2.lancto
                     with frame f-movto-contab.
                down with frame f-movto-contab.
            end.
            disp '' with frame f-espaco.
        end.
    end.

end.
