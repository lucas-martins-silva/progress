/******************************************************************************
***
*** app/ap0734.i1 - Impress∆o Totais.
***
******************************************************************************/

IF  tt-param.l-resumo = NO THEN DO:

    DISP " --------------" @ tt-dirf-ap.de-rendto
         " --------------" @ tt-dirf-ap.valor-ir
         WITH FRAME {1}.
        
    DOWN WITH FRAME {1}.
        
    DISP " Total:"    @ tt-dirf-ap.nr-docto
         de-tot-rend  @ tt-dirf-ap.de-rendto
         de-tot-impto @ tt-dirf-ap.valor-ir
         WITH FRAME {1}.
                
    DOWN (2) WITH FRAME {1}.
end.

