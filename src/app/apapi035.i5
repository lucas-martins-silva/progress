    if  param-global.modulo-cb = yes and che-emit.portador <> tit-ap.portador then do:
        
        /*--- Estorna valor do cheque do portador antigo ---*/
        find first portador
             where portador.ep-codigo    = tit-ap.ep-codigo
             and   portador.cod-portador = che-emit.portador
             and   portador.modalidade   = tit-ap.modalidade
             no-lock no-error.
    
        if  avail portador then do:
                
            find first cheque exclusive-lock
                 where cheque.cod-banco    = portador.cod-banco
                 and   cheque.agencia      = portador.agencia
                 and   cheque.conta-corren = portador.conta-corren
                 and   cheque.nr-cheque    = che-emit.nr-cheque no-error.

            if  avail cheque then do:
                ASSIGN cheque.vl-cheque = cheque.vl-cheque - che-emit.valor-docto.
                IF  cheque.vl-cheque <= 0 THEN do:
                    DELETE cheque.
                end.
            END.
        END.

        /*--- Atualiza valor do cheque do portador novo ---*/
        find first portador
             where portador.ep-codigo    = tit-ap.ep-codigo
             and   portador.cod-portador = tit-ap.portador
             and   portador.modalidade   = tit-ap.modalidade
             no-lock no-error.
    
        if  avail portador then do:
            find first cheque exclusive-lock
                 where cheque.cod-banco    = portador.cod-banco
                 and   cheque.agencia      = portador.agencia
                 and   cheque.conta-corren = portador.conta-corren
                 and   cheque.nr-cheque    = che-emit.nr-cheque no-error.

            if  not avail cheque then do:
                create cheque.
                assign cheque.cod-banco       = portador.cod-banco
                       cheque.agencia         = portador.agencia
                       cheque.conta-corren    = portador.conta-corren
                       cheque.nr-cheque       = che-emit.nr-cheque
                       cheque.vl-cheque       = 0.
            end.

            assign cheque.ep-codigo-mvto  = che-emit.ep-codigo
                   cheque.cod-portador    = tit-ap.portador
                   cheque.dt-vencimento   = che-emit.dt-vencto
                   cheque.dt-emissao      = che-emit.dt-emissao
                   cheque.tp-codigo       = tit-ap.tp-codigo
                   cheque.vl-cheque       = cheque.vl-cheque + che-emit.valor-docto
                   cheque.tipo-cheque     = 1  /* Pr½prio */
                   cheque.situacao-cheque = 1  /* Pendente */
                   cheque.origem-cheque   = 5. /* AP */              
            if  mov-ap.data-1 = mov-ap.dt-transacao 
            or  mov-ap.data-1 = ? then do:
                if  AVAIL param-ap AND param-ap.log-2 = yes then do:
                    assign cheque.dt-liberacao = ?.
                end.
                else do:
                    assign cheque.dt-liberacao = tit-ap.dt-transacao.
                end.
            end.                            
        END.
    END.

