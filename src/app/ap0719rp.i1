/********************************************************************
***
***  app/ap0719rp.i1 - Antiga include "ap0719.i8" do Magnus I.
***                    Imprime Resgistros tipo 3
***
********************************************************************/


        assign i-nr-registro = i-nr-registro + 1
               i-tot-reg-3   = i-tot-reg-3 + 1.
        
        do  i-cont = 1 to 12:
            assign de-rend-geral = de-rend-geral + de-tot-rend[i-cont]
                   de-ded-geral  = de-ded-geral  + de-tot-ded[i-cont]
                   de-ir-geral   = de-ir-geral + de-tot-ir[i-cont]
                   c-rend-trib2[i-cont] = string(de-tot-rend[i-cont]
                                        * 100,"999999999999999")
                   c-ir-ret2[i-cont]    = string(de-tot-ir[i-cont]
                                        * 100,"999999999999999")
                   c-deducoes[i-cont]   = string(de-tot-ded[i-cont]
                                        * 100,"999999999999999")
                   de-tot-rend[i-cont] = 0
                   de-tot-ded[i-cont]  = 0
                   de-tot-ir [i-cont]  = 0.                     
        end.
        
        if (i-ano-base = 2007 and i-sit-declar = 1) 
        or (i-ano-base = 2008 and i-sit-declar = 1)
        or (i-ano-base = 2009 and i-sit-declar = 2) then do:

           do i-cont = 1 to 12:
               assign c-deducoes[i-cont]   = "000000000000000".
           end.
           for each t-dirf-deduc no-lock
              where t-dirf-deduc.cgc-decl    = c-cgc-emp    
                and t-dirf-deduc.cod-ret     = i-cod-ret:
               assign de-total-deduc = 0.
               do i-cont = 1 to 12:
                   assign c-rend-trib2[i-cont] = string(int(c-rend-trib2[i-cont]) + (int(string(t-dirf-deduc.ded-prev[i-cont]   * 100, "999999999999999"))),"999999999999999")
                          c-deducoes[i-cont]   = string(int(c-deducoes[i-cont])   + (int(string(t-dirf-deduc.ded-depend[i-cont] * 100, "999999999999999"))),"999999999999999")
                          c-ir-ret2[i-cont]    = string(int(c-ir-ret2[i-cont])    + (int(string(t-dirf-deduc.ded-pensao[i-cont] * 100, "999999999999999"))),"999999999999999").
                          de-total-deduc       = de-total-deduc + t-dirf-deduc.ded-prev[i-cont] + t-dirf-deduc.ded-depend[i-cont] + t-dirf-deduc.ded-pensao[i-cont].
               end.
               if de-total-deduc > 0 then
                   i-tot-reg = i-tot-reg + 1.
           end.
        end.
        
        assign c-registro = "3".
        put stream s-dirf
            i-nr-registro format "99999999" at  1
            c-registro    format "9"        at  9
            c-cgc-emp                       at 10
            i-cod-ret     format "9999"     at 24
            i-tot-reg     format "99999999" at 28.
        
        {app/ap0719rp.i2}
        
        assign i-tot-reg = 0.

/*--- Fim da Include AP0719RP.I1 ---*/
