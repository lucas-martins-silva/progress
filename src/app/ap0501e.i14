/*******************************************************************************
**
** app/ap0501e.i14 - Gera Movimente Implantaá∆o.
**
*******************************************************************************/ 
    
create mov-ap.             
assign mov-ap.ep-codigo      = lin-i-ap.ep-codigo
       mov-ap.cod-estabel    = lin-i-ap.cod-estabel
       mov-ap.cod-esp        = lin-i-ap.cod-esp
       mov-ap.serie          = lin-i-ap.serie
       mov-ap.nr-docto       = lin-i-ap.nr-docto
       mov-ap.parcela        = lin-i-ap.parcela
       mov-ap.cod-fornec     = lin-i-ap.cod-fornec
       mov-ap.transacao      = 1
       mov-ap.referencia     = doc-i-ap.referencia
       mov-ap.dt-emissao     = lin-i-ap.dt-emissao
       mov-ap.dt-vencimen    = lin-i-ap.dt-vencimen
       mov-ap.dt-transacao   = doc-i-ap.data-movto
       mov-ap.ct-conta       = lin-i-ap.ct-debito
       mov-ap.sc-conta       = lin-i-ap.sc-debito
       mov-ap.conta-contabil = lin-i-ap.conta-debito            
       mov-ap.portador       = lin-i-ap.cod-portador
       mov-ap.modalidade     = if lin-i-ap.int-1 <> 0 then
                                  lin-i-ap.int-1
                               else 1
       mov-ap.origem         = i-origem
       mov-ap.historico      = lin-i-ap.historico
       mov-ap.usuario        = c-seg-usuario
       mov-ap.dt-today       = today
       mov-ap.c-time         = string(time, "HH:MM")
       mov-ap.contabiliza    = if  i-pais-impto-usuario  = 3 /*EUA*/ 
                               and lin-i-ap.sit-receb    = 2 then 
                                    no 
                               else 
                                    espec-ap.contabiliza
       mov-ap.cod-retencao   = lin-i-ap.cod-retencao
       mov-ap.tp-codigo      = lin-i-ap.tp-codigo
      &if "{&mgdis_version}" >= "2.02" &then
	mov-ap.titulo-banco   = lin-i-ap.pedido
      &else
	mov-ap.pedido         = lin-i-ap.pedido
      &endif
       mov-ap.num-ord-inv    = lin-i-ap.num-ord-inv
       r-movapfa             = rowid(mov-ap)
       row-mov-ap            = rowid(mov-ap)
       de-cotacao            = lin-i-ap.cotacao-dia
       mov-ap.tipo           = espec-ap.tipo.

if  i-origem      = 5 and /* Origens do tipo 5 s∆o comiss‰es - RAC - verifica se o movimento Ç cont†bil */
    espec-ap.tipo = 1 /* NO */ then do: 

    assign c-cta-saldo-fornec = ""
           l-contabiliza      = no
           l-entrou           = no.

    if  not avail emitente then 
        find first emitente
             where emitente.cod-emitente = lin-i-ap.cod-fornec
             and   emitente.identific   <> 1 no-lock no-error.       
    if  not avail emitente then 
        return.
        
    find first conta-ap 
         where conta-ap.ep-codigo   = lin-i-ap.ep-codigo
           and conta-ap.cod-estabel = lin-i-ap.cod-estabel
           and conta-ap.cod-esp     = lin-i-ap.cod-esp
           and conta-ap.cod-grupo   = emitente.cod-gr-forn no-lock no-error.

    if  not avail conta-ap then 
        return.
        
    assign c-cta-saldo-fornec = conta-ap.conta-saldo.

    for  each l-ant-ap 
        where l-ant-ap.ep-codigo      = lin-i-ap.ep-codigo
          and l-ant-ap.cod-estabel    = lin-i-ap.cod-estabel
          and l-ant-ap.cod-esp        = lin-i-ap.cod-esp
          and l-ant-ap.serie          = lin-i-ap.serie
          and l-ant-ap.nr-docto       = lin-i-ap.nr-docto
          and l-ant-ap.parcela        = lin-i-ap.parcela 
          and l-ant-ap.cod-fornec     = lin-i-ap.cod-fornec
          exclusive-lock:

        &IF DEFINED(BF_FIN_PROVISAO) &THEN
            if  l-ant-ap.tipo <> 10 then next.
        &ELSE
            &if defined(bf_fin_provisao203) &then
                if  can-find(first funcao where
                                   funcao.cd-funcao = "spp-provisao" and
                                   funcao.ativo     = yes ) then
                    if  l-ant-ap.tipo <> 10 then next.
            &ENDIF.
        &ENDIF.
        
        assign l-entrou = yes.
        
        find first emitente
             where emitente.cod-emitente = l-ant-ap.fornec-ant
             and   emitente.identific   <> 1 no-lock no-error. 
        if  not avail emitente then 
            next.

        find first conta-ap 
             where conta-ap.ep-codigo   = l-ant-ap.ep-cod-ant
               and conta-ap.cod-estabel = l-ant-ap.cod-est-ant
               and conta-ap.cod-esp     = l-ant-ap.cod-esp-ant
               and conta-ap.cod-grupo   = emitente.cod-gr-forn no-lock no-error.
        if  not avail conta-ap then
            next.
          
        if  c-cta-saldo-fornec <> conta-ap.conta-saldo then do:
            assign l-contabiliza = yes.
            leave.
        end.
    end.
    
    if  l-entrou = no then 
        assign l-contabiliza = yes.

    assign mov-ap.contabiliza = l-contabiliza.
end.

       
find first portador 
     where portador.ep-codigo    = mov-ap.ep-codigo
     and   portador.cod-portador = mov-ap.portador
     and   portador.modalidade   = mov-ap.modalidade
     no-lock no-error.
if avail portador then do:
   if  portador.log-1 = yes then /* Identifica se o mesmo Ç centralizador */
       assign mov-ap.conta-var-monetaria = "CENTRALIZADOR".
   else
       assign mov-ap.conta-var-monetaria = "NAO CENTRALIZADOR".
end. 
      

assign mov-ap.moeda          = lin-i-ap.mo-codigo
       mov-ap.cotacao-dia    = lin-i-ap.cotacao-dia
       mov-ap.valor-mov      = lin-i-ap.vl-original
       mov-ap.vl-original    = lin-i-ap.vl-original
       mov-ap.vl-orig-me     = lin-i-ap.vl-orig-me
       mov-ap.frete          = if lin-i-ap.origem <> 1 then 0 else lin-i-ap.frete
       mov-ap.diversos       = if lin-i-ap.origem <> 1 then 0 else lin-i-ap.diversos
       mov-ap.vl-desconto    = lin-i-ap.vl-desconto
       mov-ap.vl-desc-fasb   = 0
       mov-ap.vl-juro-fasb   = 0
       mov-ap.vl-ant-fasb    = 0
       mov-ap.vl-mov-fasb    = lin-i-ap.vl-original / de-taxa-prev
       mov-ap.valor-mov-me   = lin-i-ap.vl-orig-me
       mov-ap.frete-me       = if lin-i-ap.origem <> 1 then 0 else lin-i-ap.frete-me
       mov-ap.diversos-me    = if lin-i-ap.origem <> 1 then 0 else lin-i-ap.diversos-me
       mov-ap.vl-desconto-me = lin-i-ap.vl-desconto-me.
    
/**************************************************************
- doc-i-ap.log-1 identifica se o movimento Ç referente a uma
  importaá∆o de movimentos j† contabilizados (ap1101). 
**************************************************************/
assign mov-ap.contabilizou = doc-i-ap.log-1.

/*--- Lote Gerado Pelo MultiPlanta ---*/
if  avail param-global and param-global.modulo-mp = yes then do:
    if  doc-i-ap.log-2 = yes then do:
        assign mov-ap.flag-contab  = no 
               mov-ap.contabiliza  = no
               mov-ap.contabilizou = no
               mov-ap.origem       = 3.
    end.  
    else 
        if  doc-i-ap.cod-esp = "CT" then
            assign mov-ap.origem = 3.                      
end.
      
/* o lin-conta-ap.char-1 = " "(branco) identifica o registro como rateio em
   v†rias contas de documento normal. */
       
if  mov-ap.conta-contabil = "" then do:
    find first lin-conta-ap no-lock
         where lin-conta-ap.ep-codigo   = lin-i-ap.ep-codigo
         and   lin-conta-ap.cod-estabel = lin-i-ap.cod-estabel
         and   lin-conta-ap.cod-esp     = lin-i-ap.cod-esp
         and   lin-conta-ap.serie       = lin-i-ap.serie
         and   lin-conta-ap.nr-docto    = lin-i-ap.nr-docto
         and   lin-conta-ap.parcela     = lin-i-ap.parcela
         and   lin-conta-ap.cod-fornec  = lin-i-ap.cod-fornec
         and   lin-conta-ap.char-1      = " " no-error.
          
    if  avail lin-conta-ap then do:
        assign mov-ap.conta-contabil = lin-conta-ap.conta-debito
               mov-ap.ct-conta       = lin-conta-ap.ct-codigo
               mov-ap.sc-conta       = lin-conta-ap.sc-codigo.
    end.
end.
    
/* Fim Include */
