/*******************************************************************************
***
*** app/ap0741rp.i15 - Quebra por Grupo / Matriz / Esp‚cie.
***
*******************************************************************************/
        
assign de-ger-atual = de-ger-atual
                    + de-tot-cr 
                    - de-tot-db
       de-tot-atual = de-tot-cr
                    - de-tot-db.

if  tt-param.log-cons-mo-orig = no then do:
    for each  tt2-mov-ap no-lock use-index ch-pagto-escrit
        where tt2-mov-ap.ep-codigo    = tt-param.ep-codigo
        and   tt2-mov-ap.dt-transacao = tt-param.dt-trans-fim
        and   tt2-mov-ap.portador     = 0
        and   tt2-mov-ap.transacao    = 7
        and ((tt2-mov-ap.int-1        = int(p-cod-chave) and p-class = 2)
        or   (tt2-mov-ap.int-2        = int(p-cod-chave) and p-class = 3)
        or   (tt2-mov-ap.cod-esp      = p-cod-chave      and p-class = 4)):
                        
        {app/ap0741rp.i22}
                               
    end.    
end.
else do:
    for each  tt2-mov-ap no-lock use-index ch-pagto-escrit
        where tt2-mov-ap.ep-codigo    = tt-param.ep-codigo
        and   tt2-mov-ap.dt-transacao = tt-param.dt-trans-fim
        and   tt2-mov-ap.moeda        = p-moeda
        and   tt2-mov-ap.portador     = 0
        and   tt2-mov-ap.transacao    = 7
        and ((tt2-mov-ap.int-1        = int(p-cod-chave) and p-class = 2)
        or   (tt2-mov-ap.int-2        = int(p-cod-chave) and p-class = 3)
        or   (tt2-mov-ap.cod-esp      = p-cod-chave      and p-class = 4)):
            
        {app/ap0741rp.i22}
            
    end.    
end.
    
if  de-tot-saldo >= 0 then
    assign c-lancto1    = {adinc/i01ad059.i 04 2}
           de-ger-saldo = de-ger-saldo + de-tot-saldo.
else
    assign c-lancto1    = {adinc/i01ad059.i 04 1}
           de-tot-saldo = de-tot-saldo * (- 1)
           de-ger-saldo = de-ger-saldo - de-tot-saldo.
            
if  de-tot-atual >= 0 then
    assign c-lancto2 = {adinc/i01ad059.i 04 2}.
else
    assign c-lancto2 = {adinc/i01ad059.i 04 1}.
           
/* Fim de Include */

