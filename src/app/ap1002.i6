/************************************************************************
***
***  ap1002.i6
***  Objetivo : Rotina de impressao relatorio de retorno.
***
************************************************************************/

if  l-antecipacao = no then do:
    disp tit-ap.cod-fornec
         tit-ap.cod-estabel
         tit-ap.cod-esp
         tit-ap.serie
         tit-ap.nr-docto
         tit-ap.parcela
         tit-ap.dt-emissao
         tit-ap.dt-vencimen
         tit-ap.nr-bordero
         da-data
         de-valor-liq @ de-valor
         c-transacao
         with frame f-detalhe1.
    down with frame f-detalhe1.
end.
else do:
    disp bordero-ap.cod-fornec    @ tit-ap.cod-fornec
         bordero-ap.cod-estabel   @ tit-ap.cod-estabel
         bordero-ap.cod-esp       @ tit-ap.cod-esp
         bordero-ap.serie         @ tit-ap.serie
         bordero-ap.nr-docto      @ tit-ap.nr-docto
         bordero-ap.parcela       @ tit-ap.parcela
         bordero-ap.dt-transacao  @ tit-ap.dt-emissao
         bordero-ap.dt-vencto     @ tit-ap.dt-vencimen
         bordero-ap.nr-bordero    @ tit-ap.nr-bordero
         da-data
         de-valor-liq @ de-valor
         c-transacao
         with frame f-detalhe1.
    down with frame f-detalhe1.
end.

if  c-observacao <> "" then do:
    put "OBSERVA€ÇO: " c-observacao.
end. 

/* Fim de Include */


