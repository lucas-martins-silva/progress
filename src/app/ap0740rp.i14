/*******************************************************************************
***
*** app/ap0740rp.i14 - last-of(tt-tit-ap.tp-pagto).
***
*******************************************************************************/

if  last-of(tt-tit-ap.tp-pagto) then do:
        
    if  de-tot-tp-pag-orig > 0 then
        assign c-lancto-1 = c-credito.
    else
        assign c-lancto-1 = c-debito.
        
    if  de-tot-tp-pag-saldo > 0 then
        assign c-lancto-2 = c-credito.
    else
        assign c-lancto-2 = c-debito.
        
    if  de-tot-tp-pag-orig < 0 then
        assign de-tot-tp-pag-orig = de-tot-tp-pag-orig * (-1).
    
    if  de-tot-tp-pag-saldo < 0 then
        assign de-tot-tp-pag-saldo = de-tot-tp-pag-saldo * (-1).
        
    put c-total-tp-pagto    at 46
        de-tot-tp-pag-orig  to 103
        c-lancto-1          to 106
        de-tot-tp-pag-saldo to 129 
        c-lancto-2          to 132
        skip(1).
            
    assign de-tot-tp-pag-orig  = 0
           de-tot-tp-pag-saldo = 0.
end.

/* Fim de Include */
