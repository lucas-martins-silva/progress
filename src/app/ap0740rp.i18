/*******************************************************************************
***
*** app/ap0740rp.i18 - pi-tratar-resumo-grupo.
***
*******************************************************************************/

for each tt-resumo no-lock 
    break by tt-resumo.cod-chave:
                
    page.

    find first grupo-fornec
         where grupo-fornec.cod-gr-forn = tt-resumo.cod-chave no-lock no-error.
                
    if  avail grupo-fornec then do:
        disp c-grupo
             grupo-fornec.cod-gr-forn
             grupo-fornec.descricao
             with frame f-grupo.
    end.
    else do:
                
        disp c-grupo
             tt-resumo.cod-chave @ grupo-fornec.cod-gr-forn with frame f-grupo.
                
        {utp/ut-liter.i Grupo_n∆o_Cadastrado}
        disp trim(return-value) @ grupo-fornec.descricao with frame f-grupo.
            
    end.
        
    run pi-imprimir-resumo.
                    
end.

/* Fim de Include */
