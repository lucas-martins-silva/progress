        for each  tit-ap 
            where tit-ap.ep-codigo    = tt-param.i-empresa
            and   tit-ap.portador     = tt-param.i-portador
            and   tit-ap.dt-liq       = 12/31/9999
            and   tit-ap.dt-vencimen  = tt-param.da-vencimen-ini
            and   tit-ap.tipo         = 1
            {1}
            and   tit-ap.cod-estabel >= tt-param.c-est-ini
            and   tit-ap.cod-estabel <= tt-param.c-est-fim
            and   tit-ap.cod-esp     >= tt-param.c-esp-ini
            and   tit-ap.cod-esp     <= tt-param.c-esp-fim
            and   tit-ap.nr-docto    >= tt-param.i-docto-ini
            and   tit-ap.nr-docto    <= tt-param.i-docto-fim
            and   tit-ap.cod-fornec  >= tt-param.i-fornec-ini
            and   tit-ap.cod-fornec  <= tt-param.i-fornec-fim
            no-lock
            break by tit-ap.ep-codigo
                  by tit-ap.nr-bordero:

            if  tit-ap.moeda <> 0 then
                next.
            
            &if "{&mgadm_version}" >= "2.02" &then                               
                if l-valid-tp-pagto = yes then do:
                    if  (tit-ap.tp-pagto  = 5 or 
                         tit-ap.tp-pagto  = 6 or 
                         tit-ap.tp-pagto  = 7 ) then 
                         next. 
                end.
            &endif.       

            if  tit-ap.estado <> 1 
            and tt-param.l-estado = no then
               next.
            run pi-autorizacoes.     /* Antigo chamada do ap0001a.p */                   
            if  l-erro = yes then
                next.

            find first tt-emitente 
                 where tt-emitente.cod-emit   = tit-ap.cod-fornec 
                 and   tt-emitente.identific <> 1 no-lock no-error.
            if  not avail tt-emitente then do:
                find first emitente 
                     where emitente.cod-emitente = tit-ap.cod-fornec 
                     and   emitente.identific   <> 1 no-lock no-error.
                if  not avail emitente then
                    next.
                create tt-emitente.
                buffer-copy emitente to tt-emitente.    
            end.

            find first tt-portador no-lock 
                 where tt-portador.ep-codigo    = tit-ap.ep-codigo
                 and   tt-portador.cod-portador = tit-ap.portador
                 and   tt-portador.modalidade   = 1 no-error.
            if  not avail tt-portador then do: 
                find first portador no-lock
                     where portador.ep-codigo    = tit-ap.ep-codigo
                     and   portador.cod-portador = tit-ap.portador
                     and   portador.modalidade   = 1 no-error.
                            
                if  not avail portador then
                    next.
                
                create tt-portador.
                buffer-copy portador to tt-portador.    
            end.
                    
            if  tt-portador.log-2 = no then do: /* N’o envia documentos atrasados */
                /*--- Prazo de envio ---*/
                if (tit-ap.dt-vencimen - today) < 0 then
                    next.
            end.        
                               
            /*--------- INICIO UPC GRENDENE - ESPEC™FICO ---------*/
            for each tt-epc where tt-epc.cod-event = "esgrend1" exclusive-lock:
                delete tt-epc.
            end.
                                            
            create tt-epc.
            assign tt-epc.cod-event     = "esgrend1" 
                   tt-epc.cod-parameter = "selec-bordero"
                   tt-epc.val-parameter = string(rowid(tit-ap))      + "," +
                                          string(tt-param.da-pagto)  + ",".
                                        
            {include/i-epc201.i "esgrend1"}                
            
            find first tt-epc where tt-epc.cod-event = "esgrend1" no-lock no-error.
            if avail tt-epc then do:
                if index(tt-epc.val-parameter,"desfaz") > 0 then
                    next.
            end.
            
            /*--------- FINAL UPC GRENDENE - ESPEC™FICO ---------*/  
            
            for  each mov-ap of tit-ap where mov-ap.emit-fita = no no-lock:
                 if  tt-param.i-ocorrencia = 1 then do:
                     if  mov-ap.transacao <> 1 and 
                         mov-ap.transacao <> 6 then
                         next.
                     
                     if  mov-ap.transacao  = 6 and 
                         mov-ap.lancamento = 1 then
                         next.
                 end.
                 else do:
                    if  tit-ap.titulo-banco = ""   or
                       (mov-ap.transacao   <> 13   and
                        mov-ap.transacao   <> 14   and
                        mov-ap.transacao   <> 15   and
                        mov-ap.transacao   <> 11   and
                        mov-ap.transacao   <> 12   and
                        mov-ap.transacao   <> 10   and
                        mov-ap.transacao   <> 15)  then
                        next.
                 end.
                 
                 if    mov-ap.transacao <> 10 and
                       tit-ap.valor-saldo = 0 then
                       next.

                 run pi-criar-tt-tit-ap.
            end.
        end.

