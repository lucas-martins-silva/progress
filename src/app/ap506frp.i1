/*********************************************************************************
***
*** app/ap506frp.i1 - Variaveis e Form's.
***
*********************************************************************************/

def var c-param        as char format "x(10)" no-undo.
def var c-impressao    as char format "x(12)" no-undo.
def var c-destino      as char format "x(16)" no-undo.
def var c-obj-proces   as char format "x(18)" no-undo.
def var c-mensagem     as char format "x(80)" no-undo.
def var c-estabelec    as char                no-undo.
def var h-acomp        as handle              no-undo.
def var de-valor-ir    as dec                 no-undo.
def var de-perc-faixa  as dec                 no-undo.
def var r-tab-acum-emi as rowid               no-undo.

form
    nota-dup.referencia at 10
    nota-dup.dt-transacao
    nota-dup.cod-estabel-n
    nota-dup.cod-esp-n
    nota-dup.serie-n
    nota-dup.nr-docto-n
    nota-dup.parcela-n
    nota-dup.cod-fornec
    nota-dup.cod-estabel-d
    nota-dup.cod-esp-d
    nota-dup.serie-d
    nota-dup.nr-docto-d
    nota-dup.parcela-d
    nota-dup.fornec-dup skip
    c-mensagem at 10
    with stream-io down no-box no-attr-space width 132 frame f-nota-dup.

form 
   skip(1)
   c-param   no-label skip (1)
   tt-param.referencia colon 45
   tt-param.dt-transacao colon 45 skip(1)
   c-impressao no-label skip (1)
   c-destino colon 45
   " - "
   tt-param.arquivo no-label format "x(60)":U
   tt-param.usuario colon 45
   with stream-io side-labels no-box width 132 frame f-parametros.
run utp/ut-trfrrp.p (input frame f-nota-dup:handle).
run utp/ut-trfrrp.p (input frame f-parametros:handle).

{utp/ut-liter.i Mensagem * L}
assign c-mensagem:label in frame f-nota-dup = trim(return-value).

{utp/ut-liter.i PAR¶METROS * R}
assign c-param = trim(return-value).

{utp/ut-liter.i IMPRESSÇO * R}
assign c-impressao = trim(return-value).

{utp/ut-field.i mgadm nota-dup referencia 1}
assign tt-param.referencia:label in frame f-parametros = return-value.

{utp/ut-field.i mgadm nota-dup dt-transacao 1}
assign tt-param.dt-transacao:label in frame f-parametros = return-value.

{utp/ut-liter.i Usu rio * L}
assign tt-param.usuario:label in frame f-parametros = trim(return-value).

{utp/ut-liter.i Destino * L}
assign c-destino:label in frame f-parametros = trim(return-value)
       c-destino = {varinc/var00002.i 04 tt-param.destino}.

/* Fim de Include */
