/*********************************************************************************
***
*** app/apapi022.i9 - Validaá∆o Cheques
***
*********************************************************************************/
    find first talonario
       where talonario.ep-codigo   = tt-antecip.ep-codigo
         and talonario.cod-port    = tt-antecip.portador 
         and talonario.situacao    = 1 no-lock no-error.
    if  not avail talonario then do:
        run utp/ut-msgs.p (input "msg", 
                           input 8445, 
                           input " ").

        assign c-mensagem = return-value.

        run pi-cria-log-tit-ap (input 8445, input c-mensagem, input 1).
       assign l-houve-erro = yes.
    end.
 
    if  (tt-antecip.portador <> 0) 
    and (avail talonario) 
    and (talonario.automatico = no ) then do:
    
        if  tt-antecip.nr-cheque = 0
        or  tt-antecip.nr-cheque = ? then do:
            run utp/ut-msgs.p (input "msg":U, 
                               input 1259, 
                               input "").

            assign c-mensagem = return-value.
    
            run pi-cria-log-tit-ap (input 1259, input c-mensagem, input 1).
            assign l-houve-erro = yes.
        end.

        find first che-emit
            where che-emit.ep-codigo   = portador.ep-codigo
              and che-emit.portador    = portador.cod-portador
              and che-emit.nr-cheque   = tt-antecip.nr-cheque
              and che-emit.dt-emissao <> tt-antecip.dt-emissao
              no-lock no-error.
        if  avail che-emit then do:
            run utp/ut-msgs.p (input "msg":U,
                               input 830,
                               input string(che-emit.dt-emissao, "99/99/9999")).

            assign c-mensagem = return-value.
    
            run pi-cria-log-tit-ap (input 830, input c-mensagem, input 1).
            assign l-houve-erro = yes.
        end.
 
        find first che-emit
            where che-emit.ep-codigo = portador.ep-codigo
              and che-emit.portador  = portador.cod-portador
              and che-emit.nr-cheque = tt-antecip.nr-cheque
              and (che-emit.emitiu   = yes or che-emit.cancelado = yes)
              no-lock no-error.
        if  avail che-emit then do:
            run utp/ut-msgs.p (input "msg":U,
                               input 832,
                               input string(tt-antecip.nr-cheque)).

            assign c-mensagem = return-value.
    
            run pi-cria-log-tit-ap (input 832, input c-mensagem, input 1).
            assign l-houve-erro = yes.
        end.
 
        find first che-emit
            where che-emit.ep-codigo  = portador.ep-codigo
              and che-emit.portador   = portador.cod-portador
              and che-emit.nr-cheque  = tt-antecip.nr-cheque
              and che-emit.dt-vencto <> tt-antecip.dt-emissao
              no-lock no-error.
        if  avail che-emit then do:
            run utp/ut-msgs.p (input "msg":U,
                               input 7398,
                               input string(che-emit.dt-vencto, "99/99/9999") + "~~" +
                                     string(tt-antecip.nr-cheque)).

            assign c-mensagem = return-value.
    
            run pi-cria-log-tit-ap (input 7398, input c-mensagem, input 1).
            assign l-houve-erro = yes.
        end.
 
        if  tt-antecip.nr-cheque <> 0 then do:
            find first talonario
                where talonario.ep-codigo      = portador.ep-codigo
                and   talonario.cod-port       = portador.cod-portador
                and   talonario.automatico     = no
                and   talonario.nr-cheque-ini <= tt-antecip.nr-cheque
                and   talonario.nr-cheque-fin >= tt-antecip.nr-cheque
                and   talonario.situacao       = 1   
                no-lock no-error.
            if  not avail talonario then do:
                {utp/ut-liter.i Ativo}
                run utp/ut-msgs.p (input "help":U,
                                   input 8650,
                                   input trim(return-value)            + "~~" + 
                                         string(portador.ep-codigo)    + "~~" +
                                         string(portador.cod-portador) + "~~" +
                                         string(tt-antecip.nr-cheque)).

                assign c-mensagem = return-value.
        
                run pi-cria-log-tit-ap (input 8650, input c-mensagem, input 1).
                assign l-houve-erro = yes.
            end.
        end.                
        /****************************************************
        if  param-global.modulo-cb = yes then do: /* Caixa e Bancos implantado */
            find first cheque no-lock
                where cheque.cod-banco    = portador.cod-banco
                and   cheque.agencia      = portador.agencia
                and   cheque.conta-corren = portador.conta-corren
                and   cheque.nr-cheque    = tt-antecip.nr-cheque no-error.
            if  avail cheque then do:
                run utp/ut-msgs.p (input "msg":U,
                                   input 7393,
                                   input string(tt-antecip.nr-cheque)).
                if  return-value = 'no' then do:
                    apply 'entry':U to tit-ap.nr-cheque in frame {&frame-name}.
                    assign l-houve-erro = yes.
                end.
            end.
        end.***************************************************/
    end.
    else
        assign tt-antecip.nr-cheque = 0.

    /*--- BANCOS HIST‡RICOS ---*/
    if  l-funcao-banc-hist-adm then do:
        if  tt-antecip.nr-cheque <> 0 then do:
            run crp/cr0512vc.p (INPUT portador.cod-banco,
                                input portador.agencia,
                                input portador.conta-corren,
                                input tt-antecip.nr-cheque,
                                input "HELP":U).
            if  RETURN-VALUE <> "" then do:
                assign c-mensagem = return-value.
                run pi-cria-log-tit-ap (input 25471, input c-mensagem, input 1).
                assign l-houve-erro = yes.    
            end.
        end. /*--- tt-antecip.nr-cheque ---*/
    end. /*--- param-global ---*/

/* fim app/apapi022.i9 */
