/********************************************************************************
***
*** app/ap0535c.i8 - Procedures MultiPlanta.
***
*********************************************************************************/
        
PROCEDURE pi-cria-tt-dados-b-tit-ap-dup:
                
    def input parameter i-tipo-movto as integer no-undo.
                            
    if  param-global.modulo-mp = yes and tt-replica-msg.log-replica-msg = yes and l-centraliz = no then do: 
                
        create tt-tit-ap-aux.
        buffer-copy b-tit-ap-dup to tt-tit-ap-aux.
                
        create tt-dados-env.                  
        assign tt-dados-env.num-sequencia  = i-seq 
               tt-dados-env.cod-tipo-reg   = 58
               tt-dados-env.ind-tipo-movto = i-tipo-movto
               tt-dados-env.identif-msg    = string(b-tit-ap-dup.ep-codigo)   + " , " +
                                             string(b-tit-ap-dup.cod-fornec)  + " , " +
                                             string(b-tit-ap-dup.cod-estabel) + " , " +
                                             string(b-tit-ap-dup.cod-esp)     + " , " +
                                             string(b-tit-ap-dup.serie)       + " , " +
                                             string(b-tit-ap-dup.nr-docto)    + " , " +
                                             string(b-tit-ap-dup.parcela).
        raw-transfer tt-tit-ap-aux to tt-dados-env.conteudo-msg.                                    
        assign i-seq = i-seq + 1.                                     
    end.
        
END PROCEDURE.

