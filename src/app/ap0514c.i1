/******************************************************************************
**
** AP0514C.I1 - Defini‡Æo temp_tables multi-planta.
**
******************************************************************************/
                
Procedure pi-cria-tt-dados-tit:
        
    def input parameter i-tipo-movto as integer. 
                
    if  param-global.modulo-mp = yes then do:
    {cdp/cd0006c.i "AP"
                   "tit-ap.ep-codigo"
                   "tit-ap.cod-estabel" 
                   "return"}
    
        if  tt-replica-msg.log-replica-msg = yes and l-centraliz = no then do: 
                
            create tt-tit-ap-aux.
            buffer-copy tit-ap to tt-tit-ap-aux.
                
            create tt-dados-env.                  
            assign tt-dados-env.num-sequencia  = i-seq 
                   tt-dados-env.cod-tipo-reg   = 58
                   tt-dados-env.ind-tipo-movto = i-tipo-movto
                   tt-dados-env.identif-msg    = string(tit-ap.ep-codigo)   + " , " +
                                                 string(tit-ap.cod-fornec)  + " , " +
                                                 string(tit-ap.cod-estabel) + " , " +
                                                 string(tit-ap.cod-esp)     + " , " +
                                                 string(tit-ap.serie)       + " , " +
                                                 string(tit-ap.nr-docto)    + " , " +
                                                 string(tit-ap.parcela).
            raw-transfer tt-tit-ap-aux to tt-dados-env.conteudo-msg.                                     
            assign i-seq = i-seq + 1.
        end.    
    end.
end procedure.
        
Procedure pi-cria-tt-dados-cheque:
        
    def input parameter i-tipo-movto as integer. 
    if  param-global.modulo-mp = yes then do:
        
    if  avail che-emit then do:
        {cdp/cd0006c.i "AP"
                       "che-emit.ep-codigo"
                       "che-emit.cod-estabel" 
                       "return"}
    end.
    else 
        return.
    
        if  tt-replica-msg.log-replica-msg = yes and l-centraliz = no then do: 
        
            create tt-cheque-aux.
            buffer-copy cheque to tt-cheque-aux.
            
            create tt-dados-env.                  
            assign tt-dados-env.num-sequencia  = i-seq 
                   tt-dados-env.cod-tipo-reg   = 163
                   tt-dados-env.ind-tipo-movto = i-tipo-movto
                   tt-dados-env.identif-msg    = string(cheque.cod-banco)    + " , " +
                                                 string(cheque.agencia)      + " , " +
                                                 string(cheque.conta-corren) + " , " +
                                                 string(cheque.nr-cheque).
            raw-transfer tt-cheque-aux to tt-dados-env.conteudo-msg.                                     
            assign i-seq = i-seq + 1.
        end.    
    end.
end procedure.

