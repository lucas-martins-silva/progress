/*******************************************************************************
***
***  app/ap0533rp.i4 - PI-EMISSAO-MANUAL
***
*******************************************************************************/

        /*--- BANCOS HIST‡RICOS ---*/
        if  l-funcao-banc-hist-adm then do:
            run crp/cr0512vc.p (INPUT portador.cod-banco,
                                input portador.agencia,
                                input portador.conta-corren,
                                input tt-param.novo-cheque,
                                input "SHOW":U).
            if  RETURN-VALUE <> "" then do:
                {cdp/cd1000.i4}
                return "ADM-ERROR":U.
            end.
        end. /*--- param-global ---*/



        if  tt-param.reemissao = yes then
            assign i-cheq-old         = che-emit.nr-cheque
                   che-emit.nr-cheque = if  not tt-param.mantem-nr-cheque then 
                                            tt-param.novo-cheque
                                        else che-emit.nr-cheque.

        if  first-of(che-emit.nr-cheque) then do:
            assign i-dia    = day(che-emit.dt-emissao)
                   i-mes    = month(che-emit.dt-emissao)
                   c-ano1   = substring(string(che-emit.dt-emissao,"99/99/9999"),7,4).
        end.

        if  tt-param.list-tipo = 2 then do:
            find estabelec where estabelec.cod-estabel = che-emit.cod-estabel no-lock no-error.
            assign c-cidade = fill(" ",(25 - length(estabelec.cidade))) + estabelec.cidade.
        end.
        else
            assign c-cidade = fill(" ",(25 - length(empresa.cidade))) + empresa.cidade.

        if  first-of(che-emit.nr-cheque) or last-of(che-emit.nr-cheque) then do:
            assign i-num9100  = 2
                   i-tam9100  = (if  tt-param.imp = 2 then 55
                                 else if  int(substr(tt-param.layout,1,3)) = 1
                                      or  int(substr(tt-param.layout,1,3)) = 237 then 59
                                      else if  int(substr(tt-param.layout,1,3)) = 33 then 55
                                          else  if  int(substr(tt-param.layout,1,3)) = 341
                                                or  int(substr(tt-param.layout,1,3)) = 347
                                                or  int(substr(tt-param.layout,1,3)) = 399 then 57
                                                else 53)
                   i-aux1 = i-tam9100
                   i-aux2 = (if  tt-param.imp = 2 then 64
                                 else if  int(substr(tt-param.layout,1,3)) = 1
                                      or  int(substr(tt-param.layout,1,3)) = 33
                                      or  int(substr(tt-param.layout,1,3)) = 237
                                      or  int(substr(tt-param.layout,1,3)) = 409
                                      or  int(substr(tt-param.layout,1,3)) = 745 then 66
                                      else if int(substr(tt-param.layout,1,3)) = 347 then 67
                                           else 68).
        end.

        assign de-valor = if  che-emit.transacao = 4 then
                              de-valor - che-emit.valor-docto
                          else
                              de-valor + che-emit.valor-docto.

        if  first-of(che-emit.nr-cheque) and last-of(che-emit.nr-cheque) then do:
            assign de-valor   = if l-tot-pgt-pef and che-emit.transacao = 4 then 
                                (che-emit.valor-docto * -1) else che-emit.valor-docto
                   de-val9100 = de-valor.
            run cdp/cd9100.p.
        end.
        else
            if  last-of(che-emit.nr-cheque) then do:
                assign de-val9100 = de-valor.
                run cdp/cd9100.p.
            end.

        if  last-of(che-emit.nr-cheque) then do:
            assign i-ind-e1 = i-ind-e1 + 1.

            find first tit-ap
                 where tit-ap.ep-codigo   = che-emit.ep-codigo
                 and   tit-ap.cod-estabel = che-emit.cod-estabel
                 and   tit-ap.cod-esp     = che-emit.cod-esp
                 and   tit-ap.serie       = che-emit.serie
                 and   tit-ap.nr-docto    = che-emit.nr-docto
                 and   tit-ap.parcela     = che-emit.parcela
                 and   tit-ap.cod-fornec  = che-emit.cod-fornec no-lock no-error.

            if  avail tit-ap then
                assign c-hist1 = substring(tit-ap.observacao,1,40)
                       c-hist2 = substring(tit-ap.observacao,41,80).
            else
                assign c-hist1 = substring(che-emit.historico,1,40)
                       c-hist2 = substring(che-emit.historico,41,80).

            if  i-ind-e1 = 1 then
                create w-cheque.
            else
                find last w-cheque exclusive-lock no-error.

            if  avail w-cheque then do:
                assign w-valor[i-ind-e1]             = de-valor
                       w-ext9100[(i-ind-e1 * 2) - 1] = c-ext9100[1]
                       w-ext9100[i-ind-e1 * 2]       = c-ext9100[2]
                       w-nominal[i-ind-e1]           = che-emit.literal
                       w-dia[i-ind-e1]               = i-dia
                       w-mes[i-ind-e1]               = i-mes
                       w-ano1[i-ind-e1]              = c-ano1
                       w-cidade[i-ind-e1]            = c-cidade
                       w-hist1[i-ind-e1]             = c-hist1
                       w-hist2[i-ind-e1]             = c-hist2
                       w-data[i-ind-e1]              = che-emit.dt-emissao.
            end.        

            if  tt-param.imp = 1 then
                assign i-ind-e1 = 2.

            if  i-ind-e1 = 2 then do:
                assign i-ind-e1 = 0.
            end.


            if  tt-param.gerar = yes then do:
                find first talonario exclusive-lock
                     where talonario.ep-codigo      = che-emit.ep-codigo
                     and   talonario.cod-port       = che-emit.portador
                     and   talonario.automatico     = no
                     and   talonario.nr-cheque-ini <= che-emit.nr-cheque
                     and   talonario.nr-cheque-fin >= che-emit.nr-cheque no-error.
                     {app/ap0533.i}
            end.

            assign de-valor = 0.

        end.

        /************ MULTIPLANTA ************/
        {cdp/cd0006.i3 "che-emit.cod-estabel"}
        /*************************************/

        assign che-emit.emitiu = yes
               i-cont          = i-cont + 1.


        if  (tt-param.reemissao = yes
        and not tt-param.mantem-nr-cheque)  
        or  not  tt-param.reemissao then do:

            /************ MULTIPLANTA ************/
            run pi-cria-tt-dados-che-emit (input 2).
            /*************************************/
        end.

        if  tt-param.reemissao = yes 
        and not tt-param.mantem-nr-cheque then do:
            create b-che-emit.
            assign b-che-emit.ep-codigo     = che-emit.ep-codigo
                   b-che-emit.portador      = che-emit.portador
                   b-che-emit.nr-cheque     = i-cheq-old
                   b-che-emit.cod-estabel   = che-emit.cod-estabel
                   b-che-emit.cod-fornec    = che-emit.cod-fornec
                   b-che-emit.cod-esp       = che-emit.cod-esp
                   b-che-emit.serie         = che-emit.serie
                   b-che-emit.nr-docto      = che-emit.nr-docto
                   b-che-emit.parcela       = che-emit.parcela
                   b-che-emit.dt-emissao    = che-emit.dt-emissao
                   b-che-emit.dt-vencto     = che-emit.dt-vencto
                   b-che-emit.transacao     = che-emit.transacao
                   b-che-emit.referencia    = che-emit.referencia
                   b-che-emit.nominal       = che-emit.nominal
                   b-che-emit.literal       = che-emit.literal
                   b-che-emit.valor-docto   = che-emit.valor-docto
                   b-che-emit.ct-conta      = che-emit.ct-conta
                   b-che-emit.sc-conta      = che-emit.sc-conta
                   b-che-emit.conta-debito  = che-emit.conta-debito
                   b-che-emit.historico     = che-emit.historico
                   b-che-emit.nr-talonario  = che-emit.nr-talonario
                   b-che-emit.char-1        = che-emit.char-1
                   b-che-emit.emitiu        = yes
                   b-che-emit.cancelado     = yes.

            /*********** MULTIPLANTA*****************/
            run pi-cria-tt-dados-b-che-emit (input 1).        
            /****************************************/

            if  che-emit.transacao = 2 or 
                che-emit.transacao = 1 then do:

                find first b-mov-ap exclusive-lock 
                     where b-mov-ap.num-id-mov-ap = int(che-emit.char-1) no-wait no-error.

                if  not avail b-mov-ap then do:
                    find first b-mov-ap exclusive-lock
                         where b-mov-ap.ep-codigo    = che-emit.ep-codigo
                         and   b-mov-ap.cod-fornec   = che-emit.cod-fornec
                         and   b-mov-ap.cod-estabel  = che-emit.cod-estabel
                         and   b-mov-ap.cod-esp      = che-emit.cod-esp
                         and   b-mov-ap.serie        = che-emit.serie
                         and   b-mov-ap.nr-docto     = che-emit.nr-docto
                         and   b-mov-ap.parcela      = che-emit.parcela
                         and   b-mov-ap.transacao    = che-emit.transacao
                         and   b-mov-ap.portador     = che-emit.portador
                         and   b-mov-ap.dt-transacao = che-emit.dt-emissao
                         and   b-mov-ap.referencia   = che-emit.referencia
                         and   b-mov-ap.nr-cheque    = i-cheq-old no-error.
                end.

                if  avail b-mov-ap then do:

                    if   b-mov-ap.transacao = 1 then do:
                         find tit-ap exclusive-lock
                              where tit-ap.ep-codigo   = b-mov-ap.ep-codigo
                              and   tit-ap.cod-estabel = b-mov-ap.cod-estabel
                              and   tit-ap.cod-esp     = b-mov-ap.cod-esp
                              and   tit-ap.serie       = b-mov-ap.serie
                              and   tit-ap.nr-docto    = b-mov-ap.nr-docto
                              and   tit-ap.parcela     = b-mov-ap.parcela
                              and   tit-ap.cod-fornec  = b-mov-ap.cod-fornec
                              and   tit-ap.tipo        = 2 no-error.
                              if  avail tit-ap then do:
                                  run  pi-exclui-integracao-tit-ap.

                                  assign tit-ap.nr-cheque = tt-param.novo-cheque.
                                  /************ MultiPlanta *************/
                                  run pi-cria-tt-dados-tit-ap (input 2).
                                  /**************************************/
                              end.
                    end.
                end.

                run pi-exclui-integracao.

                assign b-mov-ap.nr-cheque    = tt-param.novo-cheque
                       b-mov-ap.nr-docto-emp = string(tt-param.novo-cheque).

                /************ MultiPlanta *************/
                run pi-cria-tt-dados-b-mov-ap (input 2).
                /**************************************/

                create tt-integra-cb.
                assign tt-integra-cb.raw-b-mov-ap = rowid(b-mov-ap)
                       tt-integra-cb.transacao    = che-emit.transacao.        
                run pi-gera-integracao.

            end.

            if  che-emit.transacao = 3 or 
                che-emit.transacao = 4 then do:

                find first b-mov-ap exclusive-lock
                     where b-mov-ap.num-id-mov-ap = int(che-emit.char-1) no-error.

                if  not avail b-mov-ap then do:
                    find first b-mov-ap exclusive-lock
                         where b-mov-ap.ep-codigo    = che-emit.ep-codigo
                         and   b-mov-ap.portador     = che-emit.portador
                         and   b-mov-ap.cod-fornec   = che-emit.cod-fornec
                         and   b-mov-ap.cod-estabel  = che-emit.cod-estabel
                         and   b-mov-ap.cod-esp      = che-emit.cod-esp
                         and   b-mov-ap.serie        = che-emit.serie
                         and   b-mov-ap.nr-docto     = che-emit.nr-docto
                         and   b-mov-ap.parcela      = che-emit.parcela
                         and   b-mov-ap.dt-transacao = che-emit.dt-emissao
                         and   b-mov-ap.nr-cheque    = i-cheq-old
                         and   b-mov-ap.ct-conta     = che-emit.ct-conta
                         and   b-mov-ap.sc-conta     = che-emit.sc-conta
                         and   b-mov-ap.valor-mov    = che-emit.valor-docto
                         and   b-mov-ap.transacao    = che-emit.transacao no-error.
                end.

                create tt-integra-cb.
                assign tt-integra-cb.raw-b-mov-ap = rowid(b-mov-ap)
                       tt-integra-cb.transacao    = che-emit.transacao.        

                if  avail b-mov-ap then
                    run pi-exclui-integracao.

                    assign b-mov-ap.nr-cheque    = tt-param.novo-cheque
                           b-mov-ap.nr-docto-emp = string(tt-param.novo-cheque).

                /************ MultiPlanta *************/
                run pi-cria-tt-dados-b-mov-ap (input 2).
                /**************************************/

                run  pi-gera-integracao.    
            end.
        end.            

        /************ MULTIPLANTA ************/
        run pi-encerramento.
        /*************************************/
{utp/ut-liter.i Emiss∆o:_ *}

        IF l-conf-favorec = NO OR tt-param.conf-favorec = NO THEN 
            run pi-acompanhar in h-acomp(input  Return-value  + string(i-cont)).


/* Fim de Include */
