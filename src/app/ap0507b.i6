/*****************************************************************************
**
**  APP/AP0507.I6 - Cria temp-table tt_xml_estorno para Estorno. Varias Contas.
**
*****************************************************************************/
for each tit-conta-ap no-lock where
         tit-conta-ap.ep-codigo         = tit-ap.ep-codigo      and
         tit-conta-ap.cod-estabel       = tit-ap.cod-estabel    and
         tit-conta-ap.cod-esp           = tit-ap.cod-esp        and
         tit-conta-ap.serie             = tit-ap.serie          and
         tit-conta-ap.nr-docto          = tit-ap.nr-docto       and
         tit-conta-ap.parcela           = tit-ap.parcela        and
         tit-conta-ap.cod-fornec        = tit-ap.cod-fornec:

            CREATE tt_xml_estorno.
            ASSIGN tt_xml_estorno.tt_cod_label     = "Funcao"
                   tt_xml_estorno.tt_des_conteudo  = "Estorna"
                   tt_xml_estorno.tt_num_seq_1_xml = v_sequencia
                   tt_xml_estorno.tt_num_seq_2_xml = 1.

            CREATE tt_xml_estorno.
            ASSIGN tt_xml_estorno.tt_cod_label     = "Empresa"
                   tt_xml_estorno.tt_des_conteudo  = STRING(tit-ap.ep-codigo)
                   tt_xml_estorno.tt_num_seq_1_xml = v_sequencia
                   tt_xml_estorno.tt_num_seq_2_xml = 1.

            find conta-contab
           where conta-contab.ep-codigo      = i-ep-codigo-usuario and
                 conta-contab.conta-contabil = tit-conta-ap.conta-debito
                 no-lock no-error.

            CREATE tt_xml_estorno.
            ASSIGN tt_xml_estorno.tt_cod_label     = "Conta Contabil"
                   tt_xml_estorno.tt_des_conteudo  = string(conta-contab.ct-codigo) + ',' +
                                                     string(conta-contab.sc-codigo)
                   tt_xml_estorno.tt_num_seq_1_xml = v_sequencia
                   tt_xml_estorno.tt_num_seq_2_xml = 1.

            CREATE tt_xml_estorno.
            ASSIGN tt_xml_estorno.tt_cod_label     = "Estabelecimento"
                   tt_xml_estorno.tt_des_conteudo  = tit-ap.cod-estabel
                   tt_xml_estorno.tt_num_seq_1_xml = v_sequencia
                   tt_xml_estorno.tt_num_seq_2_xml = 1.

            CREATE tt_xml_estorno.
            ASSIGN tt_xml_estorno.tt_cod_label     = "Data Movimentacao"
                   tt_xml_estorno.tt_des_conteudo  = if   string(input frame {&frame-name} tit-ap.dt-transacao) = ? then 
                                                          string(tit-ap.dt-transacao)
                                                     else string(input frame {&frame-name} tit-ap.dt-transacao)
                   tt_xml_estorno.tt_num_seq_1_xml = v_sequencia
                   tt_xml_estorno.tt_num_seq_2_xml = 1.

            CREATE tt_xml_estorno.
            ASSIGN tt_xml_estorno.tt_cod_label     = "Finalidade Economica"
                   tt_xml_estorno.tt_des_conteudo  = STRING(tit-ap.moeda)
                   tt_xml_estorno.tt_num_seq_1_xml = v_sequencia
                   tt_xml_estorno.tt_num_seq_2_xml = 1.

            /* Calcula o Valor do Movimento */
            /* Calculo Antigo
            ASSIGN de-vl-movimento = (tit-conta-ap.vl-movto-me / tit-ap.vl-orig-me) * tit-ap.vl-saldo-me.
            */    
            ASSIGN de-vl-movimento = tit-conta-ap.vl-movto-me.            

            CREATE tt_xml_estorno.
            ASSIGN tt_xml_estorno.tt_cod_label     = "Valor Movimento"
                   tt_xml_estorno.tt_des_conteudo  = STRING(de-vl-movimento)
                   tt_xml_estorno.tt_num_seq_1_xml = v_sequencia
                   tt_xml_estorno.tt_num_seq_2_xml = 1.

            CREATE tt_xml_estorno.
            ASSIGN tt_xml_estorno.tt_cod_label     = "Origem Movimento"
                   tt_xml_estorno.tt_des_conteudo  = "05" /* AP EMS2 Titulo */
                   tt_xml_estorno.tt_num_seq_1_xml = v_sequencia
                   tt_xml_estorno.tt_num_seq_2_xml = 1.

            find first mov-ap
                where mov-ap.ep-codigo   = tit-ap.ep-codigo
                and   mov-ap.cod-estabel = tit-ap.cod-estabel
                and   mov-ap.cod-esp     = tit-ap.cod-esp
                and   mov-ap.serie       = tit-ap.serie
                and   mov-ap.nr-docto    = tit-ap.nr-docto
                and   mov-ap.parcela     = tit-ap.parcela
                and   mov-ap.cod-fornec  = tit-ap.cod-fornec NO-LOCK no-error.
            
            CREATE tt_xml_estorno.
            ASSIGN tt_xml_estorno.tt_cod_label     = "ID Movimento"
                   tt_xml_estorno.tt_des_conteudo  = STRING(tit-conta-ap.ep-codigo) + chr(10) +
                                                     STRING(tit-conta-ap.num-id-tit-conta-ap) + chr(10) +
                                                     string(mov-ap.num-id-mov-ap)
                   tt_xml_estorno.tt_num_seq_1_xml = v_sequencia
                   tt_xml_estorno.tt_num_seq_2_xml = 1.

            ASSIGN v_sequencia = v_sequencia + 1.       

end.

/*--- Fim ap0507b.i6 ---*/
