/*******************************************************************************
***
*** app/ap8100.i5 - pi-criar-movimento.
***
*******************************************************************************/
            
PROCEDURE pi-criar-movimento.
            
    def input param p-campo-1  like conta-contab.ct-codigo no-undo.
    def input param p-campo-2  like conta-contab.sc-codigo no-undo.
    def input param p-campo-3  as integer format ">9"      no-undo.
    def input param p-campo-4  like mov-ap.valor-mov       no-undo.
    def input param p-campo-5  like mov-ap.vl-mov-fasb     no-undo.
    def input param p-campo-6  like conta-contab.titulo    no-undo.
    def input param p-campo-7  like mov-ap.vl-mov-cmi      no-undo.
    def input param p-campo-8  like mov-ap.valor-presente  no-undo.
        
    def buffer b-conta-diario for conta-contab.

    if  c-programa-ap8100 <> "AP/0707" then do:
        {app/ap8100.i1  "p-campo-1" 
                        "p-campo-2" 
                        "p-campo-3"
                        "p-campo-4" 
                        "p-campo-5"
                        "p-campo-6"
                        "p-campo-7" 
                        "p-campo-8"}
    end.
    else do:
            
        /*--- Esta L¢gica somente para o DIµRIO ---*/
                
        assign c-campo-1   = p-campo-1
               c-campo-2   = p-campo-2
               i-campo-3   = p-campo-3
               de-campo-4  = p-campo-4
               de-campo-5  = p-campo-5
               c-campo-6   = p-campo-6
               de-campo-7  = p-campo-7
               de-campo-8  = p-campo-8
               c-campo-9   = c-include-ap8100
               da-campo-10 = da-fim-per-ap8100.
                
        find first b-conta-diario use-index codigo
             where b-conta-diario.ep-codigo = i-ep-codigo-usuario
             and   b-conta-diario.ct-codigo = c-campo-1
             and   b-conta-diario.sc-codigo = c-campo-2 
             no-lock no-error.
                                            
        if  avail b-conta-diario then do:
                    
            assign de-campo-5 = (if  l-ignora-gpf-ap8100 then 0 else de-campo-5)
                   de-campo-7 = (if  l-ignora-cmi-ap8100 then 0 else de-campo-7)
                   de-campo-8 = (if  l-ignora-cmi-ap8100 then 0 else de-campo-8).
                        
            if  de-campo-4 <> 0 or 
                de-campo-5 <> 0 or  
                de-campo-7 <> 0 or 
                de-campo-8 <> 0 then do:
                                
                find mov-ap where rowid(mov-ap) = rw-mov-ap no-lock no-error.
                if  avail mov-ap then do:
                            
                    /*--- Gera Hist¢rico Para o Di rio ---*/
                    if  c-prog-hist-ap8100 <> "" then do:
                       
                           
                        if  mov-ap.nome-abrev = "" then 
                            assign c-nome-abrev = c-text-1.
                        else
                           assign c-nome-abrev = mov-ap.nome-abrev.
                            
                        if (mov-ap.transacao = 2 or mov-ap.transacao = 8 or mov-ap.transacao = 9)
                        and mov-ap.nr-cheque = 0 then do:
                                assign c-historico = {adinc/i01ad165.i 04 mov-ap.transacao} + "/"
                                                   + c-nome-abrev + "/" + c-text-1 + ": "
                                                   + mov-ap.cod-esp + "/" + mov-ap.serie + "/"
                                                   + mov-ap.nr-docto + "/" + mov-ap.parcela + "/"
                                                   + c-text-2 + ": " + string(mov-ap.nr-bordero,"99999999").
                        
                        end.
                        else do:
                            assign c-historico = {adinc/i01ad165.i 04 mov-ap.transacao} + "/"
                                               + c-nome-abrev + "/" + c-text-1 + ": "
                                               + mov-ap.cod-esp + "/" + mov-ap.serie + "/"
                                               + mov-ap.nr-docto + "/" + mov-ap.parcela + "/"
                                               + c-text-2 + ": " + string(mov-ap.nr-cheque).
                        end.
                    end.
                        
                    /*--- Cria temp-table t-diario-ap ---*/        
                    if  rw-impto-tit-ap = ? then do:
                        {app/ap8100a.i1 "mov-ap" "b-conta-diario.conta-contabil"}
                    end.
                    else do:
                        find impto-tit-ap where rowid(impto-tit-ap) = rw-impto-tit-ap no-lock no-error.
                        if  avail impto-tit-ap then do:
                            {app/ap8100a.i1 "impto-tit-ap" "b-conta-diario.conta-contabil"}
                        end.
                    end.
                end.
            end.
        end.            
    end.
                            
END PROCEDURE.
    
/* Fim de Include */

