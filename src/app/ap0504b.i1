end procedure.

procedure pi-cria-tt-dados-b-tit-ap:
        
    def input parameter i-tipo-movto as integer. 
        
    if  param-global.modulo-mp = yes then do:
        if  tt-replica-msg.log-replica-msg = yes and l-centraliz = no then do: 
                
            create tt-tit-ap-aux.
            buffer-copy b-tit-ap to tt-tit-ap-aux no-error.
                
            create tt-dados-env.                  
            assign tt-dados-env.num-sequencia  = i-seq 
                   tt-dados-env.cod-tipo-reg   = 58
                   tt-dados-env.ind-tipo-movto = i-tipo-movto
                   tt-dados-env.identif-msg    = string(b-tit-ap.ep-codigo)   + " , " +
                                                 string(b-tit-ap.cod-fornec)  + " , " +
                                                 string(b-tit-ap.cod-estabel) + " , " +
                                                 string(b-tit-ap.cod-esp)     + " , " +
                                                 string(b-tit-ap.serie)       + " , " +
                                                 string(b-tit-ap.nr-docto).
            raw-transfer tt-tit-ap-aux to tt-dados-env.conteudo-msg.                                     
            assign i-seq = i-seq + 1.
        end.    
     end.
end procedure.

