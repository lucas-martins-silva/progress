/******************************************************************************
***
*** app/ap0504b.i1 - Defini‡Æo TempTable's MultiPlanta.
***
******************************************************************************/

Procedure pi-cria-tt-dados-mov:

    def input parameter i-tipo-movto as integer. 
  
    if  param-global.modulo-mp = yes then do:
        if  tt-replica-msg.log-replica-msg = yes and l-centraliz = no then do: 
    
            create tt-mov-ap-aux.
            buffer-copy mov-ap to tt-mov-ap-aux.
            
            create tt-dados-env.                  
            assign tt-dados-env.num-sequencia  = i-seq 
                   tt-dados-env.cod-tipo-reg   = 59
                   tt-dados-env.ind-tipo-movto = i-tipo-movto
                   tt-dados-env.identif-msg    = string(mov-ap.ep-codigo)   + " , " +
                                                 string(mov-ap.cod-fornec)  + " , " +
                                                 string(mov-ap.cod-estabel) + " , " +
                                                 string(mov-ap.cod-esp)     + " , " +
                                                 string(mov-ap.serie)       + " , " +
                                                 string(mov-ap.nr-docto)    + " , " +
                                                 string(mov-ap.parcela)     + " , " +
                                                 string(mov-ap.transacao).
            raw-transfer tt-mov-ap-aux to tt-dados-env.conteudo-msg.                                     
            assign i-seq = i-seq + 1.
        end.    
    end.

end procedure.

Procedure pi-cria-tt-dados-impto-ap:

    def input parameter i-tipo-movto as integer. 

    if  param-global.modulo-mp = yes then do:
        if  tt-replica-msg.log-replica-msg = yes and l-centraliz = no then do: 
    
            create tt-impto-tit-ap-aux.
            buffer-copy impto-tit-ap to tt-impto-tit-ap-aux.
            
            create tt-dados-env.                  
            assign tt-dados-env.num-sequencia  = i-seq 
                   tt-dados-env.cod-tipo-reg   = 170
                   tt-dados-env.ind-tipo-movto = i-tipo-movto
                   tt-dados-env.identif-msg    = string(impto-tit-ap.ep-codigo)   + " , " +
                                                 string(impto-tit-ap.cod-estabel) + " , " +
                                                 string(impto-tit-ap.cod-esp)     + " , " +
                                                 string(impto-tit-ap.serie)       + " , " +
                                                 string(impto-tit-ap.nr-docto)    + " , " +
                                                 string(impto-tit-ap.parcela).
            raw-transfer tt-impto-tit-ap-aux to tt-dados-env.conteudo-msg.                                     
            assign i-seq = i-seq + 1.
        end.    
    end.

end procedure.

