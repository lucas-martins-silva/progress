/********************************************************************************
***
*** app/ap0518b.i1 - Gera Movimento de Baixa Documento Original.
***
********************************************************************************/
    
{cdp/cd9600.i "tit-ap.moeda" 
              "p-dat-transf" 
              "de-cotacao"}
                          
create mov-ap.
assign mov-ap.ep-codigo      = tit-ap.ep-codigo
       mov-ap.cod-estabel    = tit-ap.cod-estabel
       mov-ap.cod-fornec     = tit-ap.cod-fornec
       mov-ap.cod-esp        = tit-ap.cod-esp
       mov-ap.serie          = tit-ap.serie
       mov-ap.nr-docto       = tit-ap.nr-docto
       mov-ap.parcela        = tit-ap.parcela
       mov-ap.origem         = tit-ap.origem
       mov-ap.lancamento     = 1
       mov-ap.transacao      = 5
       mov-ap.tipo           = 2
       mov-ap.ct-conta       = conta-contab.ct-codigo
       mov-ap.sc-conta       = conta-contab.sc-codigo
       mov-ap.conta-contabil = conta-contab.conta-contabil
       mov-ap.dt-emissao     = tit-ap.dt-emissao
       mov-ap.dt-vencimen    = tit-ap.dt-vencimen
       mov-ap.dt-transacao   = p-dat-transf
       mov-ap.moeda          = tit-ap.moeda
       mov-ap.cotacao-dia    = de-cotacao
       mov-ap.valor-mov-me   = p-val-transf
       mov-ap.vl-antecip-me  = p-val-transf
       mov-ap.vl-mov-fasb    = 0
       mov-ap.portador       = 0
       mov-ap.modalidade     = tit-ap.modalidade
       mov-ap.nome-abrev     = tit-ap.nome-abrev
       mov-ap.referencia     = p-referencia
       mov-ap.ind-tp-alter   = 1
       mov-ap.dt-today       = today
       mov-ap.c-time         = string(time, "HH:MM")
       mov-ap.usuario        = c-seg-usuario
       mov-ap.tp-codigo      = tit-ap.tp-codigo.

/*** Divis∆o do assign  para evitar erros no Progress 9 ***/
assign mov-ap.valor-mov      = fn_ajust_dec(fn_conv_moedas (
                                                mov-ap.valor-mov-me,
                                                mov-ap.cotacao-dia,
                                                mov-ap.moeda,
                                                0),0).
assign mov-ap.vl-antecip     = fn_ajust_dec(fn_conv_moedas (
                                                mov-ap.vl-antecip-me,
                                                mov-ap.cotacao-dia,
                                                mov-ap.moeda,
                                                0),0).

assign tit-ap.valor-saldo = tit-ap.valor-saldo - mov-ap.valor-mov
       tit-ap.vl-saldo-me = tit-ap.vl-saldo-me - mov-ap.valor-mov-me.
                
/* recalcula e retorna saldo da antecipacao com base nos movimentos */
if  tit-ap.vl-saldo-me = 0 and tit-ap.valor-saldo <> 0 then do:
    {cdp/cd3201a.i "tit-ap" "b-mov-ap-cambial"}
    
    /* faz acerto se ocorre diferenca na antecipacao */
    if de-saldo <> 0 then do:
        find last b-mov-ap-cambial exclusive-lock
            where b-mov-ap-cambial.ep-codigo   = tit-ap.ep-codigo  
              and b-mov-ap-cambial.cod-estabel = tit-ap.cod-estabel
              and b-mov-ap-cambial.serie       = tit-ap.serie      
              and b-mov-ap-cambial.cod-esp     = tit-ap.cod-esp    
              and b-mov-ap-cambial.nr-docto    = tit-ap.nr-docto   
              and b-mov-ap-cambial.parcela     = tit-ap.parcela 
              and b-mov-ap-cambial.cod-fornec  = tit-ap.cod-fornec
              and b-mov-ap-cambial.transacao   = 5
              and b-mov-ap-cambial.log-1       = yes no-error.
        if avail b-mov-ap-cambial then do:
            run pi-lancamento(input b-mov-ap-cambial.cod-esp,
                              input b-mov-ap-cambial.transacao,  
                              input b-mov-ap-cambial.lancamento,
                              output c-lanc).
            if c-lanc = "-" then
                assign b-mov-ap-cambial.valor-mov = b-mov-ap-cambial.valor-mov + de-saldo.
            else
                assign b-mov-ap-cambial.valor-mov = b-mov-ap-cambial.valor-mov - de-saldo.
            assign tit-ap.valor-saldo = tit-ap.valor-saldo - de-saldo. /* acerta saldo da duplicata*/
        end.
        else do:
            /* se a antecipacao nao possuir movimento de ava variacao cambial deve acertar o ava que zera o saldo*/
            assign mov-ap.valor-mov    = mov-ap.valor-mov    + de-saldo
                   tit-ap.valor-saldo  = tit-ap.valor-saldo  - de-saldo
                   de-saldo            = 0.
        end.
    end.
end.
       
/************* Multiplanta *************/  
run pi-cria-tt-dados-tit-ap (input 2).     
/********** Fim-Multiplanta ************/ 
            
{utp/ut-liter.i Transferància_para_o_estabelecimento}
assign mov-ap.historico = trim(return-value) + ": " + caps(p-est-transf).
            
/************* Multiplanta **************/  
run pi-cria-tt-dados-mov-ap (input 1).     
/********** Fim-Multiplanta *************/   
        
run app/ap6000a.p (input rowid(tit-ap)).

/*--- Integraá‰es ---*/
{app/ap9100.i2}
assign tt-integ-ap.tt-row-mov-ap  = rowid(mov-ap)
       tt-integ-ap.tt-fc1014a     = yes
       tt-integ-ap.tt-fc1114a     = yes.
raw-transfer tt-integ-ap to raw-integracao.
run app/ap9100.p (Input raw-integracao, input-output table tt-erro).

find first emite-ap exclusive-lock
     where emite-ap.ep-codigo   = tit-ap.ep-codigo
     and   emite-ap.cod-estabel = tit-ap.cod-estabel
     and   emite-ap.cod-esp     = tit-ap.cod-esp
     and   emite-ap.serie       = tit-ap.serie
     and   emite-ap.nr-docto    = tit-ap.nr-docto
     and   emite-ap.parcela     = tit-ap.parcela
     and   emite-ap.cod-fornec  = tit-ap.cod-fornec no-error.
        
if  avail emite-ap then do:
        
    assign emite-ap.emitiu = yes.
            
    /************* Multiplanta *************/  
    run pi-cria-tt-dados-emite-ap (input 2).     
    /********** Fim-Multiplanta ************/ 
        
end.
        
/* Fim de Include */

