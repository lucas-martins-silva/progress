/*******************************************************************************
***
*** app/ap0741rp.i10 - pi-listar-saldo-sem-movtos.
***
*******************************************************************************/
        
assign l-existe = no.
                
for each  mov-ap no-lock use-index ch-pagto-escrit
    where mov-ap.ep-codigo    = tt-param.ep-codigo
    and   mov-ap.dt-transacao = tt-param.dt-trans-fim
    and   mov-ap.transacao    = 7
    and   mov-ap.portador     = 0:
            
    find first tt-fornec no-lock
         where {1} = {2} no-error.
        	
    if  not avail tt-fornec then do:
        assign l-existe = yes.
        leave.
    end.    
end.        

if  l-existe = yes then do:
        
    for each  mov-ap no-lock use-index ch-pagto-escrit
        where mov-ap.ep-codigo    = tt-param.ep-codigo
        and   mov-ap.dt-transacao = tt-param.dt-trans-fim
        and   mov-ap.transacao    = 7
        and   mov-ap.portador     = 0
        break by {2}:
                
        find first tt-fornec no-lock
             where {1} = {2} no-error.
                
        if  avail tt-fornec then
            next.
                            
        if  first-of({2}) then do:
                
            if  p-class = 1 then do:
                if  tt-param.tp-relatorio = 1 then do:
                    {app/ap0741rp.i16 "mov-ap.cod-fornec"}
                end.
            end.
                
            if  p-class = 2 then do:
                {app/ap0741rp.i17 "mov-ap.int-1"}
            end.
                
            if  p-class = 3 then do:
                {app/ap0741rp.i18 "mov-ap.int-2"}
            end.
            
            if  p-class = 4 then do:
                {app/ap0741rp.i21 "mov-ap.cod-esp"}
            end.
                            
        end.
                        
        if  last-of({2}) then
            run pi-ultima-quebra (input p-class, 
                                  input {2}, 
                                  input mov-ap.moeda,
                                  input no).
            
    end.
end.
    
/* Fim de Include */

