                                             string(impto-tit-ap.nr-docto)     + " , " +
                                             string(impto-tit-ap.parcela)      + " , " +
                                             string(impto-tit-ap.cod-imposto)  + " , " +
                                             string(impto-tit-ap.num-seq-impto).
        raw-transfer tt-imposto-tit-ap-aux to tt-dados-env.conteudo-msg.
        assign i-seq = i-seq + 1.
