/********************************************************************************
***
*** app/ap0591c.i10 - Procedure's MultiPlanta.
***
********************************************************************************/

PROCEDURE pi-cria-tt-dados-tit-conta-ap:

    def input parameter i-tipo-movto as integer no-undo.

    {cdp/cd0006c.i "AP"
                   "tit-conta-ap.ep-codigo"
                   "tit-conta-ap.cod-estabel" 
                   "return"}

    if  param-global.modulo-mp = yes and tt-replica-msg.log-replica-msg = yes and l-centraliz = no then do: 

        create tt-tit-conta-ap-aux.
        buffer-copy tit-conta-ap to tt-tit-conta-ap-aux no-error.

        create tt-dados-env.                  
        assign tt-dados-env.num-sequencia  = i-seq 
               tt-dados-env.cod-tipo-reg   = 36
               tt-dados-env.ind-tipo-movto = i-tipo-movto
               tt-dados-env.identif-msg    = string(tit-conta-ap.ep-codigo)   + " , " +
                                             string(tit-conta-ap.cod-fornec)  + " , " +
                                             string(tit-conta-ap.cod-estabel) + " , " +
                                             string(tit-conta-ap.cod-esp)     + " , " +
                                             string(tit-conta-ap.serie)       + " , " +
                                             string(tit-conta-ap.nr-docto)    + " , " +
                                             string(tit-conta-ap.parcela).
        raw-transfer tt-tit-conta-ap-aux to tt-dados-env.conteudo-msg.
        assign i-seq = i-seq + 1.
    end.

END PROCEDURE.

