** ap1001q.i5
** Objetivo: Trailler do banco Citibank.
**
***************************************************************************/

/* Trailler do Arquivo */

put stream relat
    "TRL"                                                        at 001
    (i-hea-qua )                        format "999999999999999" at 004
    de-hea-val                          format "999999999999999" at 019    
    "000000000000000"                                            at 034
    (i-hea-qua )                        format "999999999999999" at 049
    " "                                           format "x(37)" at 064
    skip.


