/*******************************************
**     Programa: apapi024.i1
**     Objetivo: Cria Temp-table de erros
**         Data: Dezembro de 1999
**
**          {1} -> Codigo da mensagem
*******************************************/

run utp/ut-msgs.p (input c-video, 
                   input {1},
                   input c-param).
                   
if not tt-param.l-video then do:
   create tt-retorno-erro.
   assign tt-retorno-erro.cod-erro  = {1}
          tt-retorno-erro.desc-erro = trim(return-value).
end.          

return "NOK".

/* fim include */
