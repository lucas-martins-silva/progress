def var l-vlmin-deduc as logical no-undo.

assign l-vlmin-deduc = no.

&if defined(BF_FIN_VL_MIN_DEDUC_IMP) &then
    assign l-vlmin-deduc = yes.
&else
    if can-find(first funcao
                where funcao.cd-funcao = 'spp-vlmin-ded-im') then
       assign l-vlmin-deduc = yes.
&endif                     
