/*******************************************************************************
***
***  app/ap0511rp.i2 - Defini‡Æo Form's.
***
*******************************************************************************/

form
    tt-param.copia label "Arquivo gerado da c¢pia do cheque"
    with overlay row 18 side-labels stream-io frame f-copia1.

form
    "--------------------------------------------------"
    "------------------------------"  at 51
    empresa.razao-social
    "-"
    empresa.cidade
    da-data                at 71 skip(1)
    "COPIA DE CHEQUE NR:"
    c-nr-copia
    "VALOR :"              at 55
    che-emit.valor-docto   at 63 skip(1)
    "P A G O   A   :  "
    che-emit.literal             skip(1)
    "CHEQUE NUMERO :  "
    che-emit.nr-cheque
    "CONTA :"              at 55
    c-conta                at 66 skip(1)
    "DO  B A N C O :  "
    portador.nome                skip(1)
    "ASSINADO POR  :  "          skip(2)
    with down no-box width 80 no-labels stream-io frame f-copia.

form
    "--------------------------------------------------"
    "------------------------------"  at 51
    empresa.razao-social
    "-"
    empresa.cidade
    da-data                at 71 skip(1)
    "COPIA DE CHEQUE NR:"
    c-nr-copia
    "VALOR :"              at 55 skip(1)
    "P A G O   A   :  "    skip(1)
    "CHEQUE NUMERO :  "
    che-emit.nr-cheque
    "CONTA :"              at 55 skip(1)
    "DO  B A N C O :  "
    portador.nome                skip(1)
    "ASSINADO POR  :  "          skip(2)
    "REFERENTE  A  :  "
    c-historico                  skip(1)
    "VALOR :"              at 55 skip
    "--------------------------------------------------"
    "------------------------------"  at 51
    with down no-box width 80 no-labels stream-io frame f-teste.

form 
   skip(2) 
   c-text-6 no-label     at   01 skip(2)
   tt-param.for-ini            colon 30 space(12) "|<  >|"
   tt-param.for-fim      no-label  colon 63 skip
   tt-param.num-ini            colon 30 space(02) "|<  >|" 
   tt-param.num-fim      no-label  colon 63 skip
   tt-param.dat-ini            colon 30 space(08) "|<  >|"
   tt-param.dat-fim      no-label  colon 63 skip
   tt-param.reemissao          colon 30 skip
   tt-param.cheque-ini         colon 30 space(02) "|<  >|"
   tt-param.cheque-fim   no-label  colon 63 skip(01)  
   c-text-8 no-label     at   01 skip(2) 
   tt-param.portador          colon 30
   tt-param.formulario        colon 30
   tt-param.gerar             colon 30
   tt-param.copia             colon 30
   tt-param.banco             colon 30
   tt-param.imp-hist          colon 30
   tt-param.text-quant        colon 30 
   tt-param.list-text         colon 30
   tt-param.text-imp          colon 30
   tt-param.text-colum        colon 30 skip(01)   
   c-text-9 no-label     at   01 skip(2)
   c-destino                  colon 30
   " - ":U
   tt-param.arquivo      no-label format "x(60)":U skip
   tt-param.usuario           colon 30  skip(02)
   with down no-box  side-labels stream-io width 132 frame f-parametros .
run utp/ut-trfrrp.p (input frame f-copia1:handle).
run utp/ut-trfrrp.p (input frame f-teste:handle).
run utp/ut-trfrrp.p (input frame f-parametros:handle).

