/******************************************************************************
**
**  Programa: AP1001P.I4 - Fun‡Æo para montar a agencia e cta corrente 
**                         corretamente
**
******************************************************************************/

function fn-preenche-campo RETURNS char (input p-campo as char, input p-tamanho as integer).
    def var c-aux as char.
    if length(trim(p-campo)) >= p-tamanho then 
        assign c-aux = substr(trim(p-campo),
                       length(trim(p-campo)) - (p-tamanho - 1),
                       p-tamanho).
    else
       assign c-aux = fill("0",p-tamanho - length(trim(p-campo)))  + trim(p-campo).

    return trim(c-aux).     
     
end function.
