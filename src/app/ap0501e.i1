{utp/ut-glob.i}       
{app/ap9100.i}
{app/ap9100.i1}
                                
def input param p-row-doc-i-ap as rowid no-undo.

def buffer b-doc-i-ap        for doc-i-ap.
def buffer b-l-ant-ap        for l-ant-ap.
def buffer b-lin-i-ap        for lin-i-ap.            
def buffer b-mov-ap-var-camb for mov-ap.
def buffer b-tit-ap-impl     for tit-ap.
def buffer b-tit-ap-ant      for tit-ap.
def buffer b-tit-ap-dup      for tit-ap.
def buffer b-tit-ap          for tit-ap.
def buffer b-emitente        for emitente.
def buffer b-espec-ap        for espec-ap.
def buffer b-impto-tit-ap    for impto-tit-ap.
def buffer b-tit-conta-ap    for tit-conta-ap.
def buffer b-mov-ap-ava      for mov-ap.
def buffer b-tit-ap-ava      for tit-ap.
def buffer b-mov-ap-cambial  for mov-ap.

def new global shared var i-emp      as integer format ">>9".
def new shared var c-fluxo           as character.  
def new shared var i-empresa         like empresa.ep-codigo.
def new shared var l-elimina         as logical init yes no-undo. 
/* usado nos m¢dulos integrados */
def new shared var l-undo            as logical no-undo.
def new shared var r-mov-ap          as rowid no-undo.
def new shared var r-movapfa         as rowid no-undo.

def new shared var r-gerencial       as rowid no-undo.
def new shared var r-fluxo           as rowid no-undo.

def shared var c-opcao               as character.

/****************************************************************************
**
**      ATENCAO: Sempre que criar uma nova variavel SHARED nao esqueca de
