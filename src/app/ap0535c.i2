/**********************************************************************************
***
*** app/ap0535c.i2 - Acerta Saldo da Duplicata.
***
**********************************************************************************/
    
assign b-tit-ap-dup.valor-saldo = b-tit-ap-dup.valor-saldo - mov-ap.valor-mov.

if  b-tit-ap-dup.moeda <> 0 then
    assign b-tit-ap-dup.vl-saldo-me = b-tit-ap-dup.vl-saldo-me - mov-ap.valor-mov-me.
else 
    assign b-tit-ap-dup.vl-saldo-me = b-tit-ap-dup.vl-saldo-me - mov-ap.valor-mov.

/*if  b-tit-ap-dup.valor-saldo < 0 then
    assign b-tit-ap-dup.valor-saldo = 0. este acerto ‚ feito posteriormente */
        
if  b-tit-ap-dup.vl-saldo-me < 0 then
    assign b-tit-ap-dup.vl-saldo-me = 0.
    
if  b-tit-ap-dup.moeda = 0 and b-tit-ap-dup.valor-saldo = 0 then
    assign b-tit-ap-dup.vl-saldo-me = 0.    

/*if  b-tit-ap-dup.moeda <> 0 and b-tit-ap-dup.vl-saldo-me = 0 then
    assign b-tit-ap-dup.valor-saldo = 0. este acerto ‚ feito posteriormente */   
    
/* Fim de Include */

