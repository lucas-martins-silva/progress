PROCEDURE pi-cria-tt-dados-rel:

    def input parameter i-tipo-movto as integer. 
  
    if  avail mov-ap then do:
        {cdp/cd0006c.i "AP"
                       "mov-ap.ep-codigo" 
                       "mov-ap.cod-estabel" 
                       "return"}  
    end.
    else
        return.

    if  param-global.modulo-mp and tt-replica-msg.log-replica-msg = yes and l-centraliz = no then do: 
    
        create tt-relacto-titulo-cheque-aux.
        buffer-copy relacto-titulo-cheque to tt-relacto-titulo-cheque-aux.
        
        create tt-dados-env.                  
        assign tt-dados-env.num-sequencia  = i-seq 
               tt-dados-env.cod-tipo-reg   = 162
