/************************************************************************
**
**   Programa: AP0531rp.I1
**
**   Autor...: Datasul S/A.
**
**   Objetivo: Criar o arquivo Dirf-apf para gerar os valores acumulados para
**             emissao da Dirf pessoa fisica.
**
******************************************************************************/

for each b2-mov-ap
    where b2-mov-ap.ep-codigo   = b-tit-ap.ep-codigo
    and   b2-mov-ap.cod-estabel = b-tit-ap.cod-estabel
    and   b2-mov-ap.cod-esp     = b-tit-ap.cod-esp
    and   b2-mov-ap.serie       = b-tit-ap.serie
    and   b2-mov-ap.nr-docto    = b-tit-ap.nr-docto
    and   b2-mov-ap.parcela     = b-tit-ap.parcela
    and   b2-mov-ap.cod-fornec  = b-tit-ap.cod-fornec
    and   b2-mov-ap.transacao   = 5  no-lock:
    
    find espec-ap where espec-ap.cod-esp = b2-mov-ap.esp-ant no-lock no-error.
        
    if  avail espec-ap and espec-ap.tipo = 8 then do:
    
        find first b-mov-ap
            where b-mov-ap.ep-codigo   = b2-mov-ap.ep-codigo
            and   b-mov-ap.cod-estabel = b2-mov-ap.cod-estabel
            and   b-mov-ap.cod-esp     = b2-mov-ap.esp-ant
            and   b-mov-ap.serie       = b2-mov-ap.serie-ant
            and   b-mov-ap.nr-docto    = b2-mov-ap.docto-ant
            and   b-mov-ap.parcela     = b2-mov-ap.parc-ant
            and   b-mov-ap.cod-fornec  = b2-mov-ap.fornec-ant
            and   b-mov-ap.transacao   = 1
            no-lock no-error.                       

        /* procura implantacao do IR  gerado na implantacao da  antecipacao */
        if  avail b-mov-ap then do:
            find first b1-mov-ap
                where b1-mov-ap.ep-codigo   = b-mov-ap.ep-codigo
                and   b1-mov-ap.cod-estabel = b-mov-ap.cod-estab
                and   b1-mov-ap.esp-ant     = b-mov-ap.esp-ant
                and   b1-mov-ap.serie-ant   = b-mov-ap.serie-ant
                and   b1-mov-ap.docto-ant   = b-mov-ap.docto-ant
                and   b1-mov-ap.parc-ant    = b-mov-ap.parc-ant
                and   b1-mov-ap.fornec-ant  = b-mov-ap.fornec-ant
                and   b1-mov-ap.transacao   = 2
                no-lock no-error. /* docto DP da AN */
                /* procura as baixa da antecipacao que gerou o IR para
                deduzir do rendimento tributavel e do valor do IR */
            if  avail b1-mov-ap then do:
                assign dirf-apf.base-bruta[i-mes] =
                       dirf-apf.base-bruta[i-mes] - b1-mov-ap.valor-mov 
                                                  - b2-mov-ap.valor-mov
                       dirf-apf.valor-irrf[i-mes] =
                       dirf-apf.valor-irrf[i-mes] - b2-mov-ap.valor-mov
                       de-forn-ir = de-forn-ir  - b2-mov-ap.valor-mov
                       de-valor-subtrair = b2-mov-ap.valor-mov  
                       de-sub-bruta = b1-mov-ap.valor-mov.
            end.
        end.                                      
    end.
end.

/* Fim de Include */
