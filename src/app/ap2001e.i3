/***************************************************************************
** ap1001e.i5
** Objetivo: Gerar registro Trailer do Lote para o banco Itau.
***************************************************************************/



/* ------------------------------------------------------------
                       Trailer do Arquivo
   ------------------------------------------------------------*/
put stream relat
    "341"                                                             at 001
    "9999"                                   format "9999"            at 004
    "9"                                                               at 008
    i-tot-lotes                              format "999999"          at 018 
    i-tot-reg + 2                            format "999999"          at 024
    " "                                                               at 240 skip.
