/*******************************************************************************
***
*** app/ap0741rp.i4 - pi-display-detalhe.
***
*******************************************************************************/

def input param p-class as integer no-undo.

def var i-tipo-esp      as integer no-undo.

assign i-cont = i-cont + 1.

if  i-cont mod 10 = 0 then     
    run pi-acompanhar in h-acomp (input trim(c-acomp) 
                                      + " " 
                                      + string(i-cont)
                                      + " => "
                                      + string(i-reg)).

find tt-espec-ap 
    where tt-espec-ap.cod-esp = tt-mov-ap.cod-esp
    no-lock no-error.
if  not avail tt-espec-ap then do:    
    find first espec-ap no-lock
        where espec-ap.cod-esp = tt-mov-ap.cod-esp no-error.
    if  avail espec-ap then do:
        create tt-espec-ap.
        buffer-copy espec-ap to tt-espec-ap.
    end.
end.        


if  avail tt-espec-ap then
    assign i-tipo-esp = tt-espec-ap.tipo.
else
    assign i-tipo-esp = 0.

find mov-ap where rowid(mov-ap) = tt-mov-ap.row-mov-ap no-lock no-error.
if  avail mov-ap then do:

    if  (mov-ap.transacao = 1 and i-tipo-esp <> 2)
    or  (mov-ap.transacao = 5 and mov-ap.lancamento = 1)
    or  (mov-ap.transacao = 6 and mov-ap.lancamento = 2)
    or  (mov-ap.transacao = 3 and i-tipo-esp = 2)
    or   mov-ap.transacao = 4 then do:

        if  i-tipo-esp = 3 then do:
            assign de-tot-cr       = de-tot-cr       + tt-mov-ap.valor-mov
                   de-total-geral-cr = de-total-geral-cr + tt-mov-ap.valor-mov.
        end.
        else do:
            if  i-tipo-esp = 2 and mov-ap.transacao = 3 then do:
                assign de-tot-cr       = de-tot-cr       + tt-mov-ap.vl-antecip
                       de-total-geral-cr = de-total-geral-cr + tt-mov-ap.vl-antecip.
            end.
            else do:
                if  mov-ap.transacao <> 4 then do: 
                    assign de-tot-cr       = de-tot-cr       + tt-mov-ap.valor-mov
                           de-total-geral-cr = de-total-geral-cr + tt-mov-ap.valor-mov.
                end.
            end.
        end.
    end.

    if  (mov-ap.transacao = 1 and i-tipo-esp = 2)
    or  (mov-ap.transacao = 5 and mov-ap.lancamento = 2)
    or  (mov-ap.transacao = 6 and mov-ap.lancamento = 1)
    or  (mov-ap.transacao = 3 and i-tipo-esp <> 2 and tt-param.log-prev-saldo = yes)
    or   mov-ap.transacao = 2 then do:
        if l-log-lista-baixa-an = no then do:
            assign de-tot-db         = de-tot-db + tt-mov-ap.valor-mov
                   de-total-geral-db = de-total-geral-db + tt-mov-ap.valor-mov
                   de-tot-cr         = de-tot-cr + if mov-ap.transacao <> 5
                                       and mov-ap.transacao <> 1
                                       and mov-ap.esp-ant   <> " "
                                       and mov-ap.esp-ant   >= tt-param.cod-esp-ini
                                       and mov-ap.esp-ant   <= tt-param.cod-esp-fim then
                                       tt-mov-ap.valor-mov
                                       else 0
                   de-total-geral-cr = de-total-geral-cr + if mov-ap.transacao <> 5
                                       and mov-ap.transacao <> 1
                                       and mov-ap.esp-ant   <> " "
                                       and mov-ap.esp-ant   >= tt-param.cod-esp-ini
                                       and mov-ap.esp-ant   <= tt-param.cod-esp-fim then
                                       tt-mov-ap.valor-mov
                                       else 0. 
        end.
        else do:
            if  mov-ap.transacao = 2 /* BND */
            and i-tipo-esp       = 2 /* AN  */ then do:
                assign de-tot-cr         = de-tot-cr + tt-mov-ap.valor-mov
                       de-total-geral-cr = de-total-geral-cr + tt-mov-ap.valor-mov.
            end.
            else do:
                assign de-tot-db         = de-tot-db + tt-mov-ap.valor-mov
                       de-total-geral-db = de-total-geral-db + tt-mov-ap.valor-mov.
            end.
        end.
    end.
end.

if  (mov-ap.transacao = 3 or mov-ap.transacao = 4) then do:
     assign de-tot-pef = de-tot-pef + if mov-ap.transacao = 4 then
                         tt-mov-ap.valor-mov else (- tt-mov-ap.valor-mov).
end.

if  tt-mov-ap.transacao <> 0 then
    assign c-trans = {adinc/i01ad165.i 04 tt-mov-ap.transacao}.
else
    assign c-trans = "".

run pi-calculo-atraso-medio-pagto.
run pi-calculo-prazo-medio-compra.

/*------ Relat¢rio Detalhado ------*/
if  tt-param.tp-relatorio = 1 then do:

    disp tt-mov-ap.cod-estabel
         tt-mov-ap.cod-esp
         tt-mov-ap.serie
         tt-mov-ap.nr-docto
         tt-mov-ap.parcela
         c-trans
         tt-mov-ap.portador
         tt-mov-ap.modalidade
         tt-mov-ap.referencia
         tt-mov-ap.dt-transacao
         tt-mov-ap.dt-vencimen
         tt-mov-ap.valor-mov
         tt-mov-ap.cod-lancto
         with frame f-detalhe.

    down with frame f-detalhe.

    if  tt-param.log-salt-linha = yes then
        put skip(1).

    if  tt-param.log-vinculado = yes and 
        tt-mov-ap.esp-ant <> "" then do:

        disp tt-mov-ap.esp-ant    @ tt-mov-ap.cod-esp
             tt-mov-ap.serie-ant  @ tt-mov-ap.serie
             tt-mov-ap.docto-ant  @ tt-mov-ap.nr-docto
             tt-mov-ap.parc-ant   @ tt-mov-ap.parcela
             tt-mov-ap.vl-antecip @ tt-mov-ap.valor-mov
             with frame f-detalhe.

        down with frame f-detalhe.

    end.
end.

CASE p-class:
    WHEN 1 THEN 
        find first tt-fornec no-lock
             where tt-fornec.cod-fornec  = tt-mov-ap.cod-fornec
             and   tt-fornec.moeda       = tt-mov-ap.moeda
             no-error.
    WHEN 2 THEN 
        find first tt-fornec no-lock
             where tt-fornec.cod-gr-forn = tt-mov-ap.cod-gr-forn
             and   tt-fornec.moeda       = tt-mov-ap.moeda
             no-error.
    WHEN 3 THEN 
        find first tt-fornec no-lock
             where tt-fornec.matriz = tt-mov-ap.matriz
             and   tt-fornec.moeda  = tt-mov-ap.moeda
             no-error.
    WHEN 4 THEN 
        find first tt-fornec no-lock
             where tt-fornec.cod-esp  = tt-mov-ap.cod-esp
             and   tt-fornec.moeda    = tt-mov-ap.moeda
             no-error.
END CASE.

if  not avail tt-fornec then do:
    create tt-fornec.
    assign tt-fornec.cod-fornec  = tt-mov-ap.cod-fornec
           tt-fornec.cod-gr-forn = tt-mov-ap.cod-gr-forn
           tt-fornec.matriz      = tt-mov-ap.matriz
           tt-fornec.cod-esp     = tt-mov-ap.cod-esp
           tt-fornec.moeda       = tt-mov-ap.moeda.
end.

/* Fim de Include */
