/********************************************************************************
***
***  app/ap8100c.i1 - Contabiliza‡Æo Doctos Normais (Pagamento Centralizado).
***
********************************************************************************/

assign l-ok = yes.

/*--- Valida Estabelecimento ---*/
find first estabelec where estabelec.cod-estabel = {1} no-lock no-error.
if  not avail estabelec then do:

    run utp/ut-msgs.p (input "msg",
                       input 13,
                       input caps({1})).

    assign c-mensagem = return-value
           c-trans    = {adinc/i01ad165.i 04 mov-ap.transacao}
           c-docto    = fill(" ", 16 - length(mov-ap.nr-docto)) + mov-ap.nr-docto
           l-ok       = no.

    disp mov-ap.cod-estabel
         mov-ap.cod-esp
         mov-ap.serie
         mov-ap.cod-fornec
         c-docto
         mov-ap.parcela
         c-trans
         c-mensagem
         with frame f-mensagem.
    down with frame f-mensagem.
end.
else do:
    /*--- Valida Conta Transit¢ria do Estabelecimento ---*/
    find first conta-contab no-lock use-index ch-conta-contabil
         where conta-contab.ep-codigo      = mov-ap.ep-codigo
         and   conta-contab.conta-contabil = estabelec.conta-desp-iof no-error.

    if  not avail conta-contab then do:
        run utp/ut-msgs.p (input "msg",
                           input 16756,
                           input estabelec.cod-estabel).

        assign c-mensagem = return-value
               c-trans    = {adinc/i01ad165.i 04 mov-ap.transacao}
               c-docto    = fill(" ", 16 - length(mov-ap.nr-docto)) + mov-ap.nr-docto
               l-ok       = no.

        disp mov-ap.cod-estabel
             mov-ap.cod-esp
             mov-ap.serie
             mov-ap.cod-fornec
             c-docto
             mov-ap.parcela
             c-trans
             c-mensagem
             with frame f-mensagem.
        down with frame f-mensagem.
    end.
end.

if  l-central = yes then do:

    /*--- Valida Fornecedor do Movimento ---*/
    find first emitente
         where emitente.cod-emitente = mov-ap.cod-fornec
         and   emitente.identific   <> 1 no-lock no-error.

    if  not avail emitente then do:
        run utp/ut-msgs.p (input "msg",
                           input 91,
                           input string(mov-ap.cod-fornec)).

        assign c-mensagem = return-value
               c-trans    = {adinc/i01ad165.i 04 mov-ap.transacao}
               c-docto    = fill(" ", 16 - length(mov-ap.nr-docto)) + mov-ap.nr-docto
               l-ok       = no.

        disp mov-ap.cod-estabel
             mov-ap.cod-esp
             mov-ap.serie
             mov-ap.cod-fornec
             c-docto
             mov-ap.parcela
             c-trans
             c-mensagem
             with frame f-mensagem.
        down with frame f-mensagem.

    end.
    else do:

        /*--- Valida Conta de Saldo do Fornecedor ---*/
        find first conta-ap use-index codigo
             where conta-ap.ep-codigo   = mov-ap.ep-codigo
             and   conta-ap.cod-estabel = {2}
             and   conta-ap.cod-esp     = mov-ap.cod-esp
             and   conta-ap.cod-grupo   = emitente.cod-gr-forn
             no-lock no-error.

        if  not avail conta-ap then do:
            run utp/ut-msgs.p (input "help",
                               input 1823,
                               input string({2}) + "~~" +
                                     string(mov-ap.cod-esp) + "~~" +
                                     string(emitente.cod-gr-forn)).

            assign c-mensagem = return-value
                   c-trans    = {adinc/i01ad165.i 04 mov-ap.transacao}
                   c-docto    = fill(" ", 16 - length(mov-ap.nr-docto)) + mov-ap.nr-docto
                   l-ok       = no.

            disp mov-ap.cod-estabel
                 mov-ap.cod-esp
                 mov-ap.serie
                 mov-ap.cod-fornec
                 c-docto
                 mov-ap.parcela
                 c-trans
                 c-mensagem
                 with frame f-mensagem.
            down with frame f-mensagem.
        end.
        else do:
            /*--- Valida Conta Cont bil da Conta de Saldo ---*/
            find first b-conta-contab use-index codigo
                 where b-conta-contab.ep-codigo = mov-ap.ep-codigo
                 and   b-conta-contab.ct-codigo = conta-ap.ct-saldo
                 and   b-conta-contab.sc-codigo = conta-ap.sc-saldo
                 no-lock no-error.

            if  not avail b-conta-contab then do:
                run utp/ut-msgs.p (input "msg",
                                   input 19,
                                   input conta-ap.conta-saldo).

                assign c-mensagem = return-value
                       c-trans    = {adinc/i01ad165.i 04 mov-ap.transacao}
                       c-docto    = fill(" ", 16 - length(mov-ap.nr-docto)) + mov-ap.nr-docto
                       l-ok       = no.

                disp mov-ap.cod-estabel
                     mov-ap.cod-esp
                     mov-ap.serie
                     mov-ap.cod-fornec
                     c-docto
                     mov-ap.parcela
                     c-trans
                     c-mensagem
                     with frame f-mensagem.
                down with frame f-mensagem.
            end.        
        end.
    end.
end.
else do:

    /*--- Valida Conta Cont bil (despesa) do Movimento ---*/
    find first b-conta-contab use-index codigo
         where b-conta-contab.ep-codigo = mov-ap.ep-codigo
         and   b-conta-contab.ct-codigo = mov-ap.ct-conta
         and   b-conta-contab.sc-codigo = mov-ap.sc-conta
         no-lock no-error.
    if  not avail b-conta-contab then do:
        {utp/ut-liter.i Conta_Despesa_Movimento_nÆo_Cadastrada}

        assign c-mensagem = trim(return-value) + " - " + mov-ap.conta-contabil
               c-trans    = {adinc/i01ad165.i 04 mov-ap.transacao}
               c-docto    = fill(" ", 16 - length(mov-ap.nr-docto)) + mov-ap.nr-docto
               l-ok       = no.

        disp mov-ap.cod-estabel
             mov-ap.cod-esp
             mov-ap.serie
             mov-ap.cod-fornec
             c-docto
             mov-ap.parcela
             c-trans
             c-mensagem
             with frame f-mensagem.
        down with frame f-mensagem.
    end.        
end.

if  l-ok = yes then do:

    if  c-programa-ap8100 <> "AP/0817" and
        c-programa-ap8100 <> "AP/0707" then               
        run value(c-prog-hist-ap8100).
        
    assign vl-fasb = mov-ap.vl-mov-fasb.

    /************ GE - Rodrigo ************/
    IF  c-nom-prog-upc-mg97  <> "" OR  
        c-nom-prog-dpc-mg97  <> "" OR
        c-nom-prog-appc-mg97 <> "" THEN DO:
        for each tt-epc
            where tt-epc.cod-event = "MOEDA_ORIGEM":U exclusive-lock:
            delete tt-epc.
        end.

        create tt-epc.
        assign tt-epc.cod-event = "MOEDA_ORIGEM":U.

        {include/i-epc201.i MOEDA_ORIGEM}

        find tt-epc
            where tt-epc.cod-event   = "MOEDA_ORIGEM":U
            and tt-epc.cod-parameter = "RETURN":U no-error.

        if avail tt-epc and tt-epc.val-parameter = "yes":U then
            assign vl-fasb = mov-ap.valor-mov-me.
    END.
    /************ GE - Rodrigo ************/

    /*--- Parƒmetro {1} ---*/
    run pi-criar-movimento (input conta-contab.ct-codigo,
                            input conta-contab.sc-codigo, 
                            input {3},
                            input mov-ap.valor-mov,
                            input vl-fasb,
                            input conta-contab.titulo,
                            input mov-ap.vl-mov-cmi,
                            input mov-ap.valor-presente).

    /*--- Parƒmetro {2} ---*/
    if  l-central = yes then 
        run pi-criar-movimento (input b-conta-contab.ct-codigo,
                                input b-conta-contab.sc-codigo, 
                                input {4},
                                input mov-ap.valor-mov,
                                input vl-fasb,
                                input b-conta-contab.titulo,
                                input mov-ap.vl-mov-cmi,
                                input mov-ap.valor-presente).
    else 
        run pi-criar-movimento (input b-conta-contab.ct-codigo,
                                input b-conta-contab.sc-codigo, 
                                input {4},
                                input mov-ap.valor-mov,
                                input vl-fasb,
                                input b-conta-contab.titulo,
                                input mov-ap.vl-mov-cmi,
                                input mov-ap.valor-presente).
end.

/* Fim de Include */
