/*********************************************************************************
***
*** app/ap0503aa.i1 - Informa Dados Imposto de Renda Antecipa‡Æo.
***
*********************************************************************************/

if  l-informa-ir = yes then do:

    if  i-tp-codigo = 0 then
        assign i-tp-codigo = {1}.

    assign de-tributavel = {2}.

    if  c-nr-docto = "" then
        assign c-nr-docto = {3}.

    if  c-parcela = "" then
        assign c-parcela = {4}.
    &IF DEFINED (BF_FIN_TAB_PROG_IR) &THEN
        RUN PI-TAB-PROG-IR IN THIS-PROCEDURE.
    &ENDIF    
    run app/ap0503aa.w (input-output i-cod-imposto,
                        input        {5},
                        input        {6},
                        input-output c-cod-esp,
                        input-output c-serie,
                        input-output c-nr-docto,
                        input-output c-parcela,
                        input-output da-vencimento,
                        input-output i-cod-retencao,
                        input-output i-tp-codigo,
                        input-output c-conta-debito,
                        input-output de-tributavel,
                        input-output de-aliquota,
                        input-output de-original,
                        input-output i-hp-codigo-ir,
                        input-output c-historico-ir,
                        input        {7},
                        input        {8},
                        input        {9},
                        output       l-cancela).

    if  l-cancela = yes then
        {10}.

end.

/* Fim de Include */
