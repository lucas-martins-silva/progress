/*******************************************************************************
**
**  Include.: AP0706.I2
**  Objetivo: Somat¢ria Totais para Perfil de Distribuicao de Compras e
**            C lculo do Prazo M‚dio de Compras e Atraso M‚dio de Pagamento
**
*******************************************************************************/

assign i-data = mov-ap.dt-vencimen - mov-ap.dt-emissao.
    
if  avail espec-ap
and ((espec-ap.contabiliza = yes and tt-param.l-espec-ctbl = yes)
or   tt-param.l-espec-ctbl = no) then do:
        
    if  i-tipo-esp = 1 or i-tipo-esp = 8 then do:
        if  tt-param.tp-moeda = 1 then do:
            assign de-prazo    = fn_ajust_dec((de-prazo + (i-data * de-calc-valor-mov)),tt-param.moeda)
                   de-pr-total = de-pr-total + de-calc-valor-mov.
        end.
        else do:
            assign de-prazo    = de-prazo + (i-data * mov-ap.vl-mov-fasb)
                   de-pr-total = de-pr-total + mov-ap.vl-mov-fasb.
        end.
    end.
            
    do  i-cont = 1 to 13:
        if  i-data < ((i-cont * 15) + 1) or i-cont = 13 then do:
            if  i-tipo-esp = 3 or i-tipo-esp = 10 then do:
                assign de-vencimen[i-cont] = de-vencimen[i-cont] + de-calc-valor-mov
                       de-vencimen[14]     = de-vencimen[14]     + de-calc-valor-mov.
                leave.
            end.
            else do:
                if  tt-param.tp-moeda = 1 then do:
                    assign de-vencimen[i-cont] = de-vencimen[i-cont] + de-calc-valor-mov
                           de-vencimen[14]     = de-vencimen[14]     + de-calc-valor-mov.
                end.
                else do:
                    assign de-vencimen[i-cont] = de-vencimen[i-cont] + mov-ap.vl-mov-fasb
                           de-vencimen[14]     = de-vencimen[14]     + mov-ap.vl-mov-fasb.
                end.
                leave.
            end.
        end.
    end.
end.
    
/* AP0706.I2 */
