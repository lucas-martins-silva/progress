/***************************************************************************
**
** ap1001p.i5 - Gerar registro Trailer para o Unibanco             
**
***************************************************************************/

/* Trailer do arquivo */

put stream relat
    "9"                                                               at 001
    i-num-reg - 1 /* nao conta o header */  format "999999"           at 002
    de-tot-geral-l * 100 format "9999999999999"                       at 008
    i-num-reg + 1  /* considera o trailler */ format "999999"         at 021
    i-num-reg + 1  format "999999"                                    at 315
    skip.

/* AP1001P.I5 */
