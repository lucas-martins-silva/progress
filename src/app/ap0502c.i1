**  Objetivo: Valida versao da base. 
*****************************************************/

def var l-ava-prev          as log   no-undo.
def var c-mov-relac-prev    as char  no-undo.

assign l-ava-prev = no.

&if defined(BF_FIN_RET_SALDO_PREV) &then  
    assign l-ava-prev = yes.
&else
    if can-find(first funcao where 
                      funcao.cd-funcao = "spp-bf_fin_ret_saldo_prev" and
                      funcao.ativo     = yes) then
       assign l-ava-prev = yes.                       
&endif.

/* Fim Programa */
