/*******************************************************************************
***
*** app/ap0740rp.i16 - pi-totais.
***
*******************************************************************************/

/*--- TOTAL NORMAL ---*/
if  de-tot-norm-orig > 0 then
    assign c-lancto-1 = c-credito.
else
    assign c-lancto-1 = c-debito.

if  de-tot-norm-saldo > 0 then
    assign c-lancto-2 = c-credito.
else
    assign c-lancto-2 = c-debito.

if  de-tot-norm-orig < 0 then
    assign de-tot-norm-orig = de-tot-norm-orig * (-1).

if  de-tot-norm-saldo < 0 then
    assign de-tot-norm-saldo = de-tot-norm-saldo * (-1).

put c-total-normal    at 46
    de-tot-norm-orig  to 103
    c-lancto-1        to 106
    de-tot-norm-saldo to 129
    c-lancto-2        to 132
    skip(1).

/*--- TOTAL PREVISAO ---*/
if  de-tot-prev-orig > 0 then
    assign c-lancto-1 = c-credito.
else
    assign c-lancto-1 = c-debito.

if  de-tot-prev-saldo > 0 then
    assign c-lancto-2 = c-credito.
else
    assign c-lancto-2 = c-debito.

if  de-tot-prev-orig < 0 then
    assign de-tot-prev-orig = de-tot-prev-orig * (-1).

if  de-tot-prev-saldo < 0 then
    assign de-tot-prev-saldo = de-tot-prev-saldo * (-1).

put c-total-prev      at 46
    de-tot-prev-orig  to 103
    c-lancto-1        to 106
    de-tot-prev-saldo to 129
    c-lancto-2        to 132
    skip(1).

/*--- TOTAL PROVISAO ---*/
if l-provisao then do:
    if  de-tot-prov-orig > 0 then
        assign c-lancto-1 = c-credito.
    else
        assign c-lancto-1 = c-debito.

    if  de-tot-prov-saldo > 0 then
        assign c-lancto-2 = c-credito.
    else
        assign c-lancto-2 = c-debito.

    if  de-tot-prov-orig < 0 then
        assign de-tot-prov-orig = de-tot-prov-orig * (-1).

    if  de-tot-prov-saldo < 0 then
        assign de-tot-prov-saldo = de-tot-prov-saldo * (-1).

    put c-total-prov      at 46
        de-tot-prov-orig  to 103
        c-lancto-1        to 106
        de-tot-prov-saldo to 129
        c-lancto-2        to 132
        skip(1).
end.

/*--- TOTAL ANTECIPACAO ---*/
if  de-tot-ante-orig < 0 then
    assign c-lancto-1 = c-credito.
else
    assign c-lancto-1 = c-debito.

if  de-tot-ante-saldo < 0 then
    assign c-lancto-2 = c-credito.
else
    assign c-lancto-2 = c-debito.
    
if  de-tot-ante-orig < 0 then
    assign de-tot-ante-orig = de-tot-ante-orig * (-1).

if  de-tot-ante-saldo < 0 then
    assign de-tot-ante-saldo = de-tot-ante-saldo * (-1).

put c-total-antec     at 46
    de-tot-ante-orig  to 103
    c-lancto-1        to 106
    de-tot-ante-saldo to 129
    c-lancto-2        to 132
    skip(1).

/*--- TOTAL GERAL ---*/
if  de-tot-geral-orig > 0 then
    assign c-lancto-1 = c-credito.
else
    assign c-lancto-1 = c-debito.

if  de-tot-geral-saldo > 0 then
    assign c-lancto-2 = c-credito.
else
    assign c-lancto-2 = c-debito.

if  de-tot-geral-orig < 0 then
    assign de-tot-geral-orig = de-tot-geral-orig * (-1).

if  de-tot-geral-saldo < 0 then
    assign de-tot-geral-saldo = de-tot-geral-saldo * (-1).

put c-total-geral      at 46
    de-tot-geral-orig  to 103
    c-lancto-1         to 106
    de-tot-geral-saldo to 129
    c-lancto-2         to 132
    skip(1).

/* Fim de Include */
