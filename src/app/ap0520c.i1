/******************************************************************************
***       
*** app/ap0520c.i1 - Consistàncias para criar a DIRF (PIS/COFINS/CSLL).
***
******************************************************************************/

FIND FIRST emitente NO-LOCK
     WHERE emitente.cod-emitente = tit-ap.cod-fornec NO-ERROR.

IF  AVAIL emitente THEN DO:
    IF  emitente.cod-gr-forn < tt-param.i-grupo-ini or
        emitente.cod-gr-forn > tt-param.i-grupo-fim THEN
        NEXT dirf_block.
END.
ELSE 
    NEXT dirf_block.

IF  emitente.natureza = 1 or
    emitente.natureza = 3 or
    emitente.natureza = 4 THEN 
    NEXT dirf_block.

/* Somente se for a seleá∆o Normal */
if  l-normal = yes then do:

    find FIRST espec-ap where espec-ap.cod-esp = tit-ap.cod-esp no-lock no-error.
    if  not avail espec-ap THEN
        NEXT dirf_block.

    if  avail espec-ap and espec-ap.log-1 = yes THEN
        NEXT dirf_block.

    /* Verifica se a espÇcie do t°tulo n∆o Ç uma espÇcie de PIS/COFINS/CSLL */
    FIND FIRST tt-espec-pis-cofins-csll NO-LOCK
         WHERE tt-espec-pis-cofins-csll.cod-esp = tit-ap.cod-esp NO-ERROR.

    if  avail tt-espec-pis-cofins-csll then
        NEXT dirf_block.
        
    if  tt-param.l-for-ret-pagto = yes
    and &if '{&mgadm_version}' >= '2.06' &then
            emitente.retem-pagto = no
        &else
            (upper(substr(emitente.char-1,30,1)) <> "S") 
        &endif 
        then
        NEXT dirf_block.    
end.

/* Somente ser for a seleá∆o para PIS/COFINS/CSLL (Retená‰es) */
if  l-retencao = yes then do:

     IF  tit-ap.cod-ret = 0 THEN 
         NEXT dirf_block.

    find first mov-ap no-lock
         where mov-ap.ep-codigo     = tit-ap.ep-codigo
         and   mov-ap.cod-fornec    = tit-ap.cod-fornec
         and   mov-ap.cod-estabel   = tit-ap.cod-estabel
         and   mov-ap.serie         = tit-ap.serie
         and   mov-ap.cod-esp       = tit-ap.cod-esp
         and   mov-ap.nr-docto      = tit-ap.nr-docto
         and   mov-ap.parcela       = tit-ap.parcela
         and   mov-ap.transacao     = 1 
         no-error.

    if  avail mov-ap then do:

        /* Se o t°tulo foi baixado por Substituiá∆o o imposto n∆o Ç considerado */
        if  tt-param.l-substituicao = no then do:
            FIND FIRST b-mov-ap no-lock
                 where b-mov-ap.ep-codigo    = mov-ap.ep-codigo
                 and   b-mov-ap.cod-estabel  = mov-ap.cod-estabel
                 and   b-mov-ap.cod-esp      = mov-ap.esp-ant
                 and   b-mov-ap.serie        = mov-ap.serie-ant
                 and   b-mov-ap.nr-docto     = mov-ap.docto-ant
                 and   b-mov-ap.parcela      = mov-ap.parc-ant
                 and   b-mov-ap.cod-fornec   = mov-ap.fornec-ant
                 and   b-mov-ap.tipo         = 1 
                 and   b-mov-ap.transacao    = 6
                 NO-ERROR.

            IF  AVAIL b-mov-ap THEN
                NEXT dirf_block.        
        end.

        if c-nom-prog-upc-mg97  <> "" or  
           c-nom-prog-dpc-mg97  <> "" or
           c-nom-prog-appc-mg97 <> "" then do: 

            for each  tt-epc
                where tt-epc.cod-event = "Movimento-baixa-dirf":
                delete tt-epc.
            end.

            create tt-epc.
            assign tt-epc.cod-event     = "Movimento-baixa-dirf"
                   tt-epc.cod-parameter = "Movimento-baixa-dirf"
                   tt-epc.val-parameter = STRING(rowid(tit-ap)).

           {include/i-epc201.i "Movimento-baixa-dirf"}           
        END.

        FIND FIRST tt-epc
             WHERE tt-epc.cod-event     = "Movimento-baixa-dirf"
             AND   tt-epc.cod-parameter = "nao_utiliza_baixa" NO-LOCK NO-ERROR.
             
        IF  NOT AVAIL tt-epc THEN do:

            /* Se n∆o existir pagamentos impostos de PIS/COFINS/CSLL 
               n∆o devem ir para a DIRF */
               
            FIND FIRST b-mov-ap no-lock
                 where b-mov-ap.ep-codigo    = mov-ap.ep-codigo
                 and   b-mov-ap.cod-estabel  = mov-ap.cod-estabel
                 and   b-mov-ap.cod-esp      = mov-ap.esp-ant
                 and   b-mov-ap.serie        = mov-ap.serie-ant
                 and   b-mov-ap.nr-docto     = mov-ap.docto-ant
                 and   b-mov-ap.parcela      = mov-ap.parc-ant
                 and   b-mov-ap.cod-fornec   = mov-ap.fornec-ant
                 and ((b-mov-ap.tipo = 1 and  b-mov-ap.transacao = 2)
                 or   (b-mov-ap.tipo = 1 and  b-mov-ap.transacao = 6)
                 or   (b-mov-ap.tipo = 2 and  b-mov-ap.transacao = 1)) 
                 NO-ERROR.       
                 
            IF  NOT AVAIL b-mov-ap THEN DO:
                NEXT dirf_block.
            END.
            ELSE DO:
            
                /* O PIS/COFINS/CSLL pode ter sido vinculado na IMPL e n∆o na BXA,
                   neste caso, gera o fato gerador com a data do primeiro movimento
                   de baixa da DP que gerou o Imposto */
                if  tt-param.i-fato-gerador = 2 then do:
                    assign da-fato-gerador = b-mov-ap.dt-transacao.
                end.
            END.
        end.
    end.

    find first dirf-ap
         where dirf-ap.ep-codigo  = tit-ap.ep-codigo
         and   dirf-ap.cod-fornec = tit-ap.cod-fornec
         and   dirf-ap.cod-estab  = tit-ap.cod-estab
         and   dirf-ap.cod-esp    = tit-ap.cod-esp
         and   dirf-ap.serie      = tit-ap.serie
         and   dirf-ap.nr-docto   = tit-ap.nr-docto
         and   dirf-ap.parcela    = tit-ap.parcela
         no-lock no-error.

    if  avail dirf-ap then
        next. 
end.

if (l-normal = yes or l-antecipacao = yes) then do:

    /* Se n∆o existir pagamentos impostos de PIS/COFINS/CSLL 
       n∆o devem ir para a DIRF */
    if  l-normal = yes then do:

        if  tt-param.l-subst-normal = no and tit-ap.tipo = 1 then do:
            FIND FIRST b-mov-ap no-lock
                 where b-mov-ap.ep-codigo    = tit-ap.ep-codigo
                 and   b-mov-ap.cod-estabel  = tit-ap.cod-estabel
                 and   b-mov-ap.cod-esp      = tit-ap.cod-esp
                 and   b-mov-ap.serie        = tit-ap.serie
                 and   b-mov-ap.nr-docto     = tit-ap.nr-docto
                 and   b-mov-ap.parcela      = tit-ap.parcela
                 and   b-mov-ap.cod-fornec   = tit-ap.cod-fornec
                 and   b-mov-ap.tipo         = 1 
                 and   b-mov-ap.transacao    = 6
                 NO-ERROR.

            IF  AVAIL b-mov-ap THEN
                NEXT dirf_block.
        end.

        if  tt-param.l-baixa = yes and tit-ap.tipo = 1 then do:
            FIND FIRST b-mov-ap no-lock
                 where b-mov-ap.ep-codigo    = tit-ap.ep-codigo
                 and   b-mov-ap.cod-estabel  = tit-ap.cod-estabel
                 and   b-mov-ap.cod-esp      = tit-ap.cod-esp
                 and   b-mov-ap.serie        = tit-ap.serie
                 and   b-mov-ap.nr-docto     = tit-ap.nr-docto
                 and   b-mov-ap.parcela      = tit-ap.parcela
                 and   b-mov-ap.cod-fornec   = tit-ap.cod-fornec
                 and ((b-mov-ap.tipo         = 1 and b-mov-ap.transacao = 2)
                 or   (b-mov-ap.tipo         = 1 and b-mov-ap.transacao = 6 and tt-param.l-subst-normal = yes))
                 NO-ERROR.
                        
            IF  NOT AVAIL b-mov-ap THEN
                NEXT dirf_block.
        end.
    end.

    /******************************************************************
    -> Se a seleá∆o for de ANÔs ou Normais e existir impostos
       n∆o deve prosseguir pois o dirf-ap ser† criado para os impostos.

    -> Logo abaixo tambÇm Ç verificado se j† n∆o foi gerado algum dirf-ap
       para a antecipaá∆o ou documento normal, Ç checado todas as espÇcies
       de PIS/COFINS/CSLL. 
    ******************************************************************/

    assign l-existe-pis = no.

    find first imposto-pagto no-lock
         where imposto-pagto.ep-codigo   = tit-ap.ep-codigo
           and imposto-pagto.cod-fornec  = tit-ap.cod-fornec
           and imposto-pagto.cod-estabel = tit-ap.cod-estabel
           and imposto-pagto.cod-esp     = tit-ap.cod-esp
           and imposto-pagto.serie       = tit-ap.serie
           and imposto-pagto.nr-docto    = tit-ap.nr-docto
           and imposto-pagto.parcela     = tit-ap.parcela
           and imposto-pagto.vl-imposto  = 0 no-error.
    if not avail imposto-pagto then do:
    
    Existe_block:
        for each imposto-pagto no-lock
           where imposto-pagto.ep-codigo   = tit-ap.ep-codigo
             and imposto-pagto.cod-fornec  = tit-ap.cod-fornec
             and imposto-pagto.cod-estabel = tit-ap.cod-estabel
             and imposto-pagto.cod-esp     = tit-ap.cod-esp
             and imposto-pagto.serie       = tit-ap.serie
             and imposto-pagto.nr-docto    = tit-ap.nr-docto
             and imposto-pagto.parcela     = tit-ap.parcela
             and imposto-pagto.vl-imposto  > 0:
            
            find first tt-espec-pis-cofins-csll no-lock
                 where tt-espec-pis-cofins-csll.cod-esp = imposto-pagto.cod-esp-impto no-error.
    
            if avail tt-espec-pis-cofins-csll then do:        
                assign l-existe-pis = yes.
                leave Existe_block.
            end.
        end.
        
        /* verifica imposto retido na implantacao */
        Existe_block2:
    for each  mov-ap NO-LOCK
        where mov-ap.ep-codigo  = tit-ap.ep-codigo
        and   mov-ap.cod-estab  = tit-ap.cod-estab
        and   mov-ap.docto-ant  = tit-ap.nr-docto
        and   mov-ap.parc-ant   = tit-ap.parcela
        and   mov-ap.esp-ant    = tit-ap.cod-esp
        and   mov-ap.fornec-ant = tit-ap.cod-fornec
        and   mov-ap.serie-ant  = tit-ap.serie
            and   mov-ap.referencia = tit-ap.referencia
        and   mov-ap.transacao  = 1
        AND   mov-ap.tipo       = 1:

        /* Na tt-espec-pis-cofins-csll somente existem as espÇcies de PIS/COFINS/CSLL */
        FIND FIRST tt-espec-pis-cofins-csll NO-LOCK
             WHERE tt-espec-pis-cofins-csll.cod-esp = mov-ap.cod-esp NO-ERROR.

        if  avail tt-espec-pis-cofins-csll then do:        
            assign l-existe-pis = yes.
                leave Existe_block2.
        end.
    end.                
    end.
    else do:
         assign v-cod-forn-matriz = imposto-pagto.cod-fornec.
         if VALID-HANDLE(h-cd0421) THEN
            RUN pi-ret-matriz-cod-forn IN h-cd0421 (INPUT imposto-pagto.cod-fornec ,
                                                    OUTPUT v-cod-forn-matriz,
                                                    output l-retem-matriz-impto).
                                                    
         /* se j† existe alguma retená∆o do fornecedor no mes n∆o s∆o gerados os t°tulos sem retená∆o */
         if can-find(first acum-imposto-pagto
              where acum-imposto-pagto.ep-codigo   = imposto-pagto.ep-codigo
              and   acum-imposto-pagto.cod-estabel = ""
              and   acum-imposto-pagto.cod-fornec  = v-cod-forn-matriz
              and   acum-imposto-pagto.dat-refer   = date(month(imposto-pagto.dat-refer),01,year(imposto-pagto.dat-refer)) 
              and   acum-imposto-pagto.cod-imposto = imposto-pagto.cod-imposto
              and   acum-imposto-pagto.val-acum-impto-retid-period > 0 ) then assign l-existe-pis = yes.
          
    end.

    if  l-existe-pis = yes then
        NEXT dirf_block.

    if l-antecipacao = yes then do:

        /* procura movimento de baixa na antecipacao */
        if can-find(first mov-ap no-lock
                    where mov-ap.ep-codigo   = tit-ap.ep-codigo  
                      and mov-ap.cod-estabel = tit-ap.cod-estabel
                      and mov-ap.fornec-ant  = tit-ap.cod-fornec 
                      and mov-ap.esp-ant     = tit-ap.cod-esp    
                      and mov-ap.serie-ant   = tit-ap.serie      
                      and mov-ap.docto-ant   = tit-ap.nr-docto   
                      and mov-ap.parc-ant    = tit-ap.parcela    
                      and mov-ap.transacao   = 2) then do:

            /* se nao houver imposto pagto nao foi informado imposto na an */
            if not can-find(first imposto-pagto
                            where imposto-pagto.ep-codigo   = tit-ap.ep-codigo
                              and imposto-pagto.cod-fornec  = tit-ap.cod-fornec
                              and imposto-pagto.cod-estabel = tit-ap.cod-estabel
                              and imposto-pagto.cod-esp     = tit-ap.cod-esp
                              and imposto-pagto.serie       = tit-ap.serie
                              and imposto-pagto.nr-docto    = tit-ap.nr-docto
                              and imposto-pagto.parcela     = tit-ap.parcela) then next dirf_block.
            
        end.
    end.

    if  tt-param.l-for-ret-pagto = yes
    and &if '{&mgadm_version}' >= '2.06' &then
            emitente.retem-pagto = no
        &else
            (upper(substr(emitente.char-1,30,1)) <> "S") 
        &endif then
        NEXT dirf_block.    


    /* Se j† existir dirf-ap n∆o gerar novamente. Na tt-espec-pis-cofins-csll 
       somente existem as espÇcies de PIS/COFINS/CSLL, n∆o Ç 
       checado o tt-param c-esp-pis pois o usu†rio poder† informar
       uma espÇcie de PIS/COFINS/CSLL a cada geraá∆o. */

    Existe_block:
    for each tt-espec-pis-cofins-csll no-lock:
        find first dirf-ap no-lock
             where dirf-ap.ep-codigo  = tit-ap.ep-codigo
             and   dirf-ap.cod-fornec = tit-ap.cod-fornec
             and   dirf-ap.cod-estab  = tit-ap.cod-estab
             and   dirf-ap.cod-esp    = tt-espec-pis-cofins-csll.cod-esp
             and   dirf-ap.serie      = tit-ap.serie
             and   dirf-ap.nr-docto   = tit-ap.nr-docto
             and   dirf-ap.parcela    = tit-ap.parcela
             no-error.

        if  avail dirf-ap then do:    
            assign l-existe-pis = yes.
            leave Existe_block.
        end.

        /* ê checado na tt porque se tiver uma DP e uma AN sem PIS/COFINS/CSLL
           com dados exatamente iguais e for informado para gerar dados dos 
           t°tulos sem retená∆o ser† gerado 2 registros com dados iguais 
           da tt e depois quando for criar o dirf-apser† apresentado 
           erro progress */

        find first tt-dirf-ap no-lock
             where tt-dirf-ap.ep-codigo  = tit-ap.ep-codigo
             and   tt-dirf-ap.cod-fornec = tit-ap.cod-fornec
             and   tt-dirf-ap.cod-estab  = tit-ap.cod-estab
             and   tt-dirf-ap.cod-esp    = tt-espec-pis-cofins-csll.cod-esp
             and   tt-dirf-ap.serie      = tit-ap.serie
             and   tt-dirf-ap.nr-docto   = tit-ap.nr-docto
             and   tt-dirf-ap.parcela    = tit-ap.parcela
             no-error.

        if  avail tt-dirf-ap then do:    
            assign l-existe-pis = yes.
            leave Existe_block.
        end.

    end.

    if  l-existe-pis = yes then
        NEXT dirf_block.

end.

/* fim de Include */

