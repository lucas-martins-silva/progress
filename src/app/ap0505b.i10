                       b-impto-tit-pend-ap-vm.vl-imposto   = ((impto-tit-pend-ap.vl-imposto-me * impto-tit-ap.cotacao-dia)
                                                           -  (impto-tit-pend-ap.vl-imposto-me * lin-b-ap.cotacao-dia)).
            end.
        end.
        else do:
            if  lin-b-ap.cotacao-dia > impto-tit-ap.cotacao-dia then do:
                assign b-impto-tit-pend-ap-vm.origem-impto = 5
                       b-impto-tit-pend-ap-vm.lancamento   = 1
                       b-impto-tit-pend-ap-vm.vl-imposto   = ((impto-tit-pend-ap.vl-imposto-me * lin-b-ap.cotacao-dia)
