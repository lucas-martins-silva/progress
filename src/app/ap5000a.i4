{app/ap5000a.i3 {1}}
FIND FIRST grupo-fornec NO-LOCK
     WHERE grupo-fornec.cod-gr-for = {1}.cod-gr-forn NO-ERROR.
IF  AVAIL grupo-fornec THEN DO:
    {app/ap5000a.i3 grupo-fornec}
END.
FIND FIRST conta-ap NO-LOCK
     WHERE conta-ap.ep-codigo   = {2}.ep-codigo
     AND   conta-ap.cod-estabel = {2}.cod-estabel
     AND   conta-ap.cod-esp     = {3}
     AND   conta-ap.cod-grupo   = {1}.cod-gr-forn NO-ERROR.
IF  AVAIL conta-ap THEN DO:
    {app/ap5000a.i3 conta-ap}
    RUN pi-criar-temp-table-conta (INPUT conta-ap.conta-saldo).
    RUN pi-criar-temp-table-conta (INPUT conta-ap.conta-var-monetaria).
    RUN pi-criar-temp-table-conta (INPUT conta-ap.conta-antecipacao).
    RUN pi-criar-temp-table-conta (INPUT conta-ap.conta-diversos).
    RUN pi-criar-temp-table-conta (INPUT conta-ap.conta-frete).
    RUN pi-criar-temp-table-conta (INPUT conta-ap.conta-correcao).
    RUN pi-criar-temp-table-conta (INPUT conta-ap.char-1).
    RUN pi-criar-temp-table-conta (INPUT conta-ap.conta-descontos).
    RUN pi-criar-temp-table-conta (INPUT conta-ap.conta-juros-pagos).
    &IF DEFINED(BF_FIN_MULTA_ABATIMENTO) &THEN
    RUN pi-criar-temp-table-conta (INPUT conta-ap.conta-abatimento).
    RUN pi-criar-temp-table-conta (INPUT conta-ap.conta-multa).
    &ENDIF
    &IF DEFINED(BF_FIN_ENCCONTAS) &THEN
    RUN pi-criar-temp-table-conta (INPUT conta-ap.conta-enc-contas).
    &ENDIF
END.
&if  "{&mgadm_version}" >= "2.02" &then 
     FIND FIRST cta-emitente NO-LOCK
          WHERE cta-emitente.cod-emitente = {1}.cod-emitente NO-ERROR.
     IF  AVAIL cta-emitente THEN DO:
         {app/ap5000a.i3 cta-emitente}
     END.
&endif
{app/ap5000a.i5 emitente.portador emitente.modalidade}
