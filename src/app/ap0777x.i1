/*******************************************************************************
***
*** app/ap0777x.i1 - 
***
*******************************************************************************/

Block_Impto:
FOR EACH tipo-tax NO-LOCK:
            
    FIND FIRST espec-ap NO-LOCK
         WHERE espec-ap.cod-esp = tipo-tax.cod-esp NO-ERROR.

    IF  AVAIL espec-ap THEN DO:
            
        ASSIGN c-des-esp = espec-ap.descricao
               c-des-esp = REPLACE(c-des-esp, ".", "").
                
        IF  c-des-esp MATCHES ("*INSS*")               OR
            c-des-esp MATCHES ("*ISS*")                OR
            c-des-esp MATCHES ("*INSTITUTO NACIONAL*") OR
            c-des-esp MATCHES ("*Imposto Renda*")      THEN
            NEXT Block_Impto.

        FIND FIRST tt-espec-impto WHERE tt-espec-impto.cod-esp = espec-ap.cod-esp NO-ERROR.
        IF  NOT AVAIL tt-espec-impto THEN DO:
                
            CREATE tt-espec-impto.
            BUFFER-COPY espec-ap TO tt-espec-impto.

        END.
    END.
END.

/* Fim Include */

