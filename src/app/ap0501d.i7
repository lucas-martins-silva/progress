/******************************************************************************
***
***  app/ap0501d.i7 - Valida‡Æo Casas Decimais Moeda - impto-tit-pend-ap.
***
******************************************************************************/

/* Verifica Decimais para vl-imposto */
assign l-rejeita-dec  = no.
assign de-tt-valor-valida = fn_vld_ajust_dec(impto-tit-pend-ap.vl-imposto,0).
if  l-rejeita-dec then do:
    {utp/ut-field.i mgadm impto-tit-pend-ap Vl-imposto 1}
    run utp/ut-msgs.p(input "help", 
                      input 18130, 
                      input trim(return-value)).
    assign l-situacao = no
           c-cod-msg  = string(lin-i-ap.ep-codigo)  + " , " +
                        string(lin-i-ap.referencia) + " , " +
                        string(lin-i-ap.sequencia)  + " , " +
                        string(lin-i-ap.seq-import).       
    {app/ap0501d.i "18130"}
    run pi-alt-descricao (input-output tt-retorno-lin-i-ap.desc-erro).
end.

