/*******************************************************************************
***
***  app/ap0523rp.i10 - Integraá‰es Caixa e Bancos - Emiss∆o Autom†tica.
***
*******************************************************************************/
        
if  param-global.modulo-cb = yes then do:
            
    find first cheque
         where cheque.cod-banco    = portador.cod-banco
         and   cheque.agencia      = portador.agencia
         and   cheque.conta-corren = portador.conta-corren
         and   cheque.nr-cheque    = b-che-emit.nr-cheque 
         no-error.
                
    if  not avail cheque then do:
        create cheque.
        assign cheque.cod-banco       = portador.cod-banco
               cheque.agencia         = portador.agencia
               cheque.conta-corren    = portador.conta-corren
               cheque.nr-cheque       = b-che-emit.nr-cheque
               cheque.ep-codigo-mvto  = b-che-emit.ep-codigo
               cheque.cod-emitente    = b-che-emit.cod-fornec
               cheque.cod-portador    = b-che-emit.portador
               cheque.dt-vencimento   = b-che-emit.dt-vencto
               cheque.dt-compensacao  = b-che-emit.dt-vencto
               cheque.dt-liberacao    = ?
               cheque.dt-emissao      = b-che-emit.dt-emissao
               cheque.tp-codigo       = mov-ap.tp-codigo
               cheque.vl-cheque       = tt-cheque.de-valor
               cheque.tipo-cheque     = 1  /* Pr¢prio */
               cheque.situacao-cheque = 1  /* Pendente */
               cheque.origem-cheque   = 5. /* AP */
                
        if  avail mov-ap then do:
            if  mov-ap.data-1 = mov-ap.dt-transacao 
            or  mov-ap.data-1 = ? then do:
                if  param-ap.log-2 = yes then do:
                    assign cheque.dt-liberacao = ?.
                end.
                else do:
                    assign cheque.dt-liberacao = mov-ap.dt-transacao.
                end.
            end.
        end.

        validate cheque.
                        
        /************ MultiPlanta *************/
        run pi-cria-tt-dados-cheque (input 1).
        /**************************************/
            
    end.
end.
        
find mov-ap where rowid(mov-ap) = v-row-mov-ap-1 no-error.
if  avail mov-ap then do:
            
    /*--- Integraá‰es Caixa e Bancos ---*/
    {app/ap9100.i2}
    assign tt-integ-ap.tt-row-mov-ap  = rowid(mov-ap)
           tt-integ-ap.tt-cb0201a     = yes
           tt-integ-ap.tt-cb1202a     = yes
           tt-integ-ap.tt-op-cb0201a  = 16.
            
    if  mov-ap.transacao = 2 then do:
        assign tt-integ-ap.tt-op-cb1202a  = 21.
    end.
    else do:
        assign tt-integ-ap.tt-op-cb1202a  = 16.
    end.    
                    
    raw-transfer tt-integ-ap to raw-integracao.
    run app/ap9100.p (Input raw-integracao, input-output table tt-erro).
end.
        
find mov-ap where rowid(mov-ap) = v-row-mov-ap-2 no-error.
if  avail mov-ap then do:   
                
    /*--- Integraá‰es Caixa e Bancos ---*/
    {app/ap9100.i2}
    assign tt-integ-ap.tt-row-mov-ap  = rowid(mov-ap)
           tt-integ-ap.tt-cb0201a     = yes
           tt-integ-ap.tt-cb1202a     = yes
           tt-integ-ap.tt-op-cb0201a  = 16
           tt-integ-ap.tt-op-cb1202a  = 21.
            
    raw-transfer tt-integ-ap to raw-integracao.
    run app/ap9100.p (Input raw-integracao, input-output table tt-erro).
end.
        
/* Fim de Include */
