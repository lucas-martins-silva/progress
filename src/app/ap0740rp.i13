/*******************************************************************************
***
*** app/ap0740rp.i13 - first-of(tt-tit-ap.tp-pagto).
***
*******************************************************************************/

if  first-of(tt-tit-ap.tp-pagto) then do:
    
    put trim(c-tipo-pagto)
        " "
        tt-tit-ap.tp-pagto
        " - "
        if tt-tit-ap.tp-pagto <> 0 then {adinc/i22ad098.i 04 tt-tit-ap.tp-pagto} else ""
        skip.
end.


