Bordero_Block:
for each  bord-rec exclusive-lock
    {1}
    on stop undo, leave:

    run pi-acompanhar in h-acomp (input c-liter1 + ": " + string(bord-rec.nr-bordero)).
            
    assign r-bordero = rowid(bord-rec).
    if  bord-rec.estado = 1 or bord-rec.estado > 4 then do:
        create tt-erros.
        assign tt-erros.nr-bordero = bord-rec.nr-bordero
               tt-erros.cod-erro   = 15747.
        next Bordero_Block.
    end.             
    if  bord-rec.estado = 2 and tt-param.sit = yes then do:
        create tt-erros.
        assign tt-erros.nr-bordero = bord-rec.nr-bordero
               tt-erros.cod-erro   = 15745.
        next Bordero_Block.
    end.
    else do:  
        if  bord-rec.estado = 3 and tt-param.sit = yes then do:
            assign bord-rec.estado = 4.
        end.
        else do:
            if  bord-rec.estado = 3 and tt-param.sit = no then do:
                create tt-erros.
                assign tt-erros.nr-bordero = bord-rec.nr-bordero
                       tt-erros.cod-erro   = 15746.
                next Bordero_Block.
            end. 
        end.      
    end.       

    if c-verif-sem-desembolso = "n"
    or bord-rec.vl-liquido > 0 then do:
        CASE bord-rec.classif:
            WHEN 1 then do:
                run app/ap5520a.p.
            END.
            WHEN 2 then do:
                run app/ap5520b.p.
            END.
            WHEN 3 then do:
                run app/ap5520c.p.
            END.
            OTHERWISE
                run app/ap5520d.p.
        END CASE. 
    end.

    if  bord-rec.estado = 2 and tt-param.sit = no then 
        assign bord-rec.estado = 3.
end.
