/*******************************************************************************
***
***  app/ap0511rp.i8 - PI-VERSAO
***
*******************************************************************************/
    
    &if "{&mgadm_version}" >= "2.02" &then 
        
    /*  MINIFLEXIBILIZA€¶O 
        OBJETIVO: VERÇO >= 2.02 - Criar registro na tabela TIT-AP Atrav‚s do 
                  BORDERO-AP Sendo, o BORDERO-AP criado na Implanta‡Æo de 
                  Antecipa‡Æo Normal, somente quando o tipo de pagamento for 
                  cheque-nominal.Dessa maneira, a Antecipa‡Æo s¢ ficar  
                  dispon¡vel para o usu rioap¢s a emissÆo do cheque referente a 
                  mesma.
    */
        
        find bordero-ap use-index codigo where
             bordero-ap.ep-codigo   = che-emit.ep-codigo and
             bordero-ap.cod-estabel = che-emit.cod-estabel and
             bordero-ap.cod-esp     = che-emit.cod-esp and
             bordero-ap.serie       = che-emit.serie and
             bordero-ap.cod-fornec  = che-emit.cod-fornec and
             bordero-ap.nr-docto    = che-emit.nr-docto and
             bordero-ap.parcela     = che-emit.parcela and
             bordero-ap.int-1       = 5
             exclusive-lock no-error.
        if  avail bordero-ap then do: /* Bordero de Cheque Nominal */
            
            assign bordero-ap.emitiu = yes.
            /*----------- Doctos AN/PEF'S ------------*/
            /* CRIA TIT-AP Atrav‚s do BORDERO-AP -----*/
            run app/ap0521c.p (input bordero-ap.ep-codigo,
                               input bordero-ap.nr-bordero,
                               input bordero-ap.portador,
                               input bordero-ap.dt-transacao,
                               input tt-param.usuario).
        end.    
        
        find mov-ap use-index codigo
            where mov-ap.ep-codigo   = che-emit.ep-codigo
            and   mov-ap.cod-estabel = che-emit.cod-estabel
            and   mov-ap.cod-esp     = che-emit.cod-esp
            and   mov-ap.serie       = che-emit.serie
            and   mov-ap.cod-fornec  = che-emit.cod-fornec
            and   mov-ap.nr-docto    = che-emit.nr-docto
            and   mov-ap.parcela     = che-emit.parcela
            and   mov-ap.transacao   = 1
            and   mov-ap.tipo        = 2 /* AN */ exclusive-lock  no-error.
        if  avail mov-ap then do:
            assign che-emit.sequencia = mov-ap.sequencia
                   che-emit.char-1    = string(mov-ap.num-id-mov-ap)
                   mov-ap.data-1      = mov-ap.dt-transacao.
                   
            if  che-emit.automatico = no then do:
                if  param-global.modulo-cb = yes then do: /* Caixa e Bancos implantado */
                    find first cheque exclusive-lock
                        where cheque.cod-banco    = portador.cod-banco
                        and   cheque.agencia      = portador.agencia
                        and   cheque.conta-corren = portador.conta-corren
                        and   cheque.nr-cheque    = che-emit.nr-cheque no-error.
                    if  avail cheque then do:
                        if  mov-ap.data-1 = mov-ap.dt-transacao 
                        or  mov-ap.data-1 = ? then do:
                            if  param-ap.log-2 = yes then do:
                                assign cheque.dt-liberacao = ?.
                            end.
                            else do:
                                assign cheque.dt-liberacao = mov-ap.dt-transacao.
                            end.
                        end.
                    end.    
                end.        
            end.
        end.    
    &endif

/* Fim da Include ap0511rp.i8 */
