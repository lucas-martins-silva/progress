PROCEDURE pi-criar-temp-table-conta:

    DEF INPUT PARAM p-conta AS CHAR NO-UNDO.

    find first conta-contab no-lock
         where conta-contab.ep-codigo      = tt-param.ep-codigo
         and   conta-contab.conta-contabil = p-conta
         no-error.

    if  avail conta-contab then do:
        {app/ap5000a.i3 conta-contab}

        find first conta no-lock
             where conta.ct-codigo = conta-contab.ct-codigo no-error.

        if  avail conta then do:
            {app/ap5000a.i3 conta}
        end. 

        find first sub-conta no-lock
             where sub-conta.sc-codigo = conta-contab.sc-codigo no-error.

        if  avail sub-conta then do:
            {app/ap5000a.i3 sub-conta}
        end.  
    end.   

END PROCEDURE.
