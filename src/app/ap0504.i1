{include/i-lgcode.i}

&IF "{&LANGUAGE-CODE}" = "POR" &THEN
&glob val1 Cb Simples
&glob val2 Carteira
&glob val3 Cheque
&ENDIF
&IF "{&LANGUAGE-CODE}" = "ESP" &THEN
&glob val1 Cb Simple
&glob val2 Cartera
&glob val3 Cheque
&ENDIF
&IF "{&LANGUAGE-CODE}" = "ING" &THEN
&glob val1 Simple
&glob val2 Portfolio
&glob val3 Check
&ENDIF

