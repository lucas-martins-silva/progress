/*******************************************************************************
***
*** app/ap0740b.i1 - Sele‡Æo Documentos.
***
*******************************************************************************/

for each  tit-ap {1}
    where tit-ap.ep-codigo     = tt-param.ep-codigo
    {2}
    and   tit-ap.cod-esp      >= tt-param.cod-esp-ini
    and   tit-ap.cod-esp      <= tt-param.cod-esp-fim
    and   tit-ap.portador     >= tt-param.cod-port-ini
    and   tit-ap.portador     <= tt-param.cod-port-fim 
    and ((tit-ap.tipo          =  1)
    or   (tit-ap.tipo          =  8)
    or   (tit-ap.tipo          =  2 and tt-param.log-lis-antec = yes)
    or   (tit-ap.tipo          =  3 and tt-param.log-lis-prev  = yes)
    or   (tit-ap.tipo          = 10 and tt-param.log-lis-prov  = yes))
    and   tit-ap.dt-vencimen  >= da-a-vencer
    and   tit-ap.dt-vencimen  <= da-venc-xxx
    and   tit-ap.moeda        >= tt-param.cod-moeda-ini
    and   tit-ap.moeda        <= tt-param.cod-moeda-fim
    and   tit-ap.dt-transacao <= tt-param.da-corte
    no-lock:

    find first tt-espec-ap where tt-espec-ap.cod-esp = tit-ap.cod-esp no-lock no-error.
    if  not avail tt-espec-ap then do:
        find first espec-ap where espec-ap.cod-esp = tit-ap.cod-esp no-lock no-error.
        if  not avail espec-ap then 
            next.
        create tt-espec-ap.
        buffer-copy espec-ap to tt-espec-ap.
    end.

    find first tt-emitente where tt-emitente.cod-emit = tit-ap.cod-fornec no-lock no-error.
    if  not avail tt-emitente then do:
        find first tt-emitente
             where tt-emitente.nome-abrev = tit-ap.nome-abrev no-lock no-error.
        if  not avail tt-emitente THEN do:
            find first emitente no-lock where emitente.cod-emit = tit-ap.cod-fornec no-error.   
            if  not avail emitente then
            next.
        
           create tt-emitente.
           buffer-copy emitente to tt-emitente.
        end.
    end.
    
    if  tt-emitente.identific = 1 then
        next.

    if (tt-emitente.cod-gr-forn < tt-param.cod-grupo-ini  or
        tt-emitente.cod-gr-forn > tt-param.cod-grupo-fim) then
        next.

    if  tt-param.classifica = 7 then do:        
        find first tt-conta-ap 
             where tt-conta-ap.ep-codigo   = tit-ap.ep-codigo
             and   tt-conta-ap.cod-grupo   = tt-emitente.cod-gr-forn
             and   tt-conta-ap.cod-esp     = tit-ap.cod-esp
             and   tt-conta-ap.cod-estabel = tit-ap.cod-estabel no-lock no-error.

        if  not avail tt-conta-ap then do:
            find first conta-ap
                 where conta-ap.ep-codigo   = tit-ap.ep-codigo
                 and   conta-ap.cod-grupo   = tt-emitente.cod-gr-forn
                 and   conta-ap.cod-esp     = tit-ap.cod-esp
                 and   conta-ap.cod-estabel = tit-ap.cod-estabel
                 no-lock no-error.
            if  not avail conta-ap then
                next.

            create tt-conta-ap.
            buffer-copy conta-ap to tt-conta-ap.
        end.     
        if  tt-conta-ap.conta-saldo < tt-param.c-conta-ini or
            tt-conta-ap.conta-saldo > tt-param.c-conta-fim then
            next.
    end.

    assign i-reg = i-reg + 1.    

    if  i-reg mod 10 = 0 then
        run pi-acompanhar in h-acomp(input c-acomp + " " + string(i-reg, "999999999")).

    run pi-selecionar-documentos.

end.            

/* Fim de Include */
