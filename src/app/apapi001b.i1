/***************************************************************************
***
*** app/apapi001b.i1 - Faz atualiza‡Æo, utilizada em v rias rotinas.
***
***************************************************************************/
    
    FOR EACH lin-i-ap FIELDS(ep-codigo  
                             cod-estabel
                             cod-fornec 
                             cod-esp    
                             serie      
                             nr-docto   
                             parcela    
                             referencia) NO-LOCK
        WHERE lin-i-ap.ep-codigo  = doc-i-ap.ep-codigo
        AND   lin-i-ap.referencia = doc-i-ap.referencia:
        {app/ap6001.i1 lin-i-ap
                       lin-i-ap.referencia
                       doc-i-ap.data-movto
                       0}
    END.

    run app/ap0501db.p (input rowid(doc-i-ap)).
    run app/ap0501e.p  (input rowid(doc-i-ap)).

    /* Tratamento Bloqueio */
    RUN app/ap6001.p (INPUT  TABLE tt-consiste-bloqueio-ap,
                      OUTPUT TABLE tt-retorno-bloqueio-ap).

    FIND FIRST tt-retorno-bloqueio-ap NO-ERROR.
    IF  AVAIL tt-retorno-bloqueio-ap THEN DO:

        FOR EACH tt-retorno-bloqueio-ap:
            create tt-retorno-lin-i-ap.
            assign tt-retorno-lin-i-ap.desc-erro  = tt-retorno-bloqueio-ap.desc-erro
                   tt-retorno-lin-i-ap.cod-erro   = STRING(tt-retorno-bloqueio-ap.num-erro)
                   tt-retorno-lin-i-ap.situacao   = NO
                   tt-retorno-lin-i-ap.cod-chave  = tt-retorno-bloqueio-ap.referencia  + "," +
                                             string(10)                                + "," +
                                             string(tt-retorno-bloqueio-ap.ep-codigo)  + "," + 
                                                    tt-retorno-bloqueio-ap.cod-estabel + "," +                       
                                                    tt-retorno-bloqueio-ap.cod-esp     + "," +
                                                    tt-retorno-bloqueio-ap.serie       + "," +
                                                    tt-retorno-bloqueio-ap.nr-docto    + "," +
                                                    tt-retorno-bloqueio-ap.parcela     + "," +
                                             string(tt-retorno-bloqueio-ap.cod-fornec).     

            FIND FIRST tt-lin-i-ap NO-LOCK
                 WHERE tt-lin-i-ap.ep-codigo   = tt-retorno-bloqueio-ap.ep-codigo
                 AND   tt-lin-i-ap.cod-estabel = tt-retorno-bloqueio-ap.cod-estabel
                 AND   tt-lin-i-ap.cod-fornec  = tt-retorno-bloqueio-ap.cod-fornec
                 AND   tt-lin-i-ap.cod-esp     = tt-retorno-bloqueio-ap.cod-esp    
                 AND   tt-lin-i-ap.serie       = tt-retorno-bloqueio-ap.serie      
                 AND   tt-lin-i-ap.nr-docto    = tt-retorno-bloqueio-ap.nr-docto   
                 AND   tt-lin-i-ap.parcela     = tt-retorno-bloqueio-ap.parcela
                 NO-ERROR.

            IF  AVAIL tt-lin-i-ap THEN
                ASSIGN entry(2, tt-retorno-lin-i-ap.cod-chave, ",") = string(tt-lin-i-ap.sequencia).
        END.
        
        /* Utilizada pela API apapi002.p */
        {1}        

        UNDO Main_Block, LEAVE Main_Block.

    END.
