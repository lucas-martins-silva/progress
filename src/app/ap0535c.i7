/**********************************************************************************
***
*** app/ap0535c.i7 - Gera Hist¢rico para a Duplicata.
***
**********************************************************************************/

assign i-sequencia = 1.
        
repeat:
    find last  his-d-ap
         where his-d-ap.ep-codigo    = b-tit-ap-dup.ep-codigo
         and   his-d-ap.cod-estabel  = b-tit-ap-dup.cod-estabel
         and   his-d-ap.cod-esp      = b-tit-ap-dup.cod-esp
         and   his-d-ap.serie        = b-tit-ap-dup.serie
         and   his-d-ap.nr-docto     = b-tit-ap-dup.nr-docto
         and   his-d-ap.parcela      = b-tit-ap-dup.parcela
         and   his-d-ap.cod-fornec   = b-tit-ap-dup.cod-fornec
         and   his-d-ap.dt-his-doc   = today 
         and   his-d-ap.sequencia    = i-sequencia
         no-error.
    
    if  not avail his-d-ap then do:
        create his-d-ap.
        assign his-d-ap.ep-codigo    = b-tit-ap-dup.ep-codigo
               his-d-ap.cod-estabel  = b-tit-ap-dup.cod-estabel
               his-d-ap.serie        = b-tit-ap-dup.serie
               his-d-ap.cod-esp      = b-tit-ap-dup.cod-esp
               his-d-ap.nr-docto     = b-tit-ap-dup.nr-docto
               his-d-ap.parcela      = b-tit-ap-dup.parcela
               his-d-ap.cod-fornec   = b-tit-ap-dup.cod-fornec
               his-d-ap.dt-his-doc   = today
               his-d-ap.sequencia    = i-sequencia.       
        leave.
    end.
    else 
        assign i-sequencia = i-sequencia + 1.
end.

run utp/ut-msgs.p (input "msg":U, 
                   input 4933, 
                   input string(today,"99/99/9999")).
                   
assign his-d-ap.historico = trim(return-value).
        
run utp/ut-msgs.p (input "msg":U, 
                   input 4298, 
                   input c-seg-usuario + "~~" +
                         string(b-tit-ap-dup.vl-saldo-me + p-vl-baixa-me, "zzz,zzz,zz9.99") + "~~" +
                         string(b-tit-ap-dup.vl-saldo-me, "zzz,zzz,zzz,zz9.99")).
                
assign his-d-ap.historico = his-d-ap.historico 
                          + " "
                          + trim(return-value)
                          + chr(13).
    
{utp/ut-liter.i -_Altera‡Æo_feita_pelo_vinculo_de_antecipa‡äes_(ap0535)}
assign his-d-ap.historico = his-d-ap.historico 
                          + trim(return-value).
    
/* Fim de Include */

