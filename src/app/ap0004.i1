if  tt-impto-tit-ap.de-valor-new > tt-impto-tit-ap.de-valor-old then
    assign de-vl-base = tt-impto-tit-ap.de-valor-new 
                      - tt-impto-tit-ap.de-valor-old.
else
    assign de-vl-base = tt-impto-tit-ap.de-valor-old 
                      - tt-impto-tit-ap.de-valor-new.
    
if  de-vl-base > 0 then do:
    {app/ap0004.i2}
end.

