/*******************************************************************************
***
*** app/ap0777x.i4 - 
***
*******************************************************************************/

FIND FIRST tit-ap NO-LOCK
     WHERE ROWID(tit-ap) = tt-log-erros.rw-tit NO-ERROR.

IF  AVAIL tit-ap THEN DO:

    FIND FIRST tt-dirf
         WHERE tt-dirf.ep-codigo = tit-ap.ep-codigo
         AND   tt-dirf.situacao  = tt-log-erros.ind-tipo-erro
         NO-ERROR.

    IF  NOT AVAIL tt-dirf THEN DO:
    
        CREATE tt-dirf.
        ASSIGN tt-dirf.situacao  = tt-log-erros.ind-tipo-erro
               tt-dirf.ep-codigo = tit-ap.ep-codigo.

        IF  tt-dirf.situacao = "ADV" THEN
            ASSIGN tt-dirf.ind-situacao = "Advertˆncia".

        IF  tt-dirf.situacao = "NOK" THEN
            ASSIGN tt-dirf.ind-situacao = "Com Erro".

    END.

    ASSIGN tt-dirf.qtde-registros = tt-dirf.qtde-registros + 1.
        
    if  tt-dirf.razao-social = "" or tt-dirf.cgc = "" then do:
        find first empresa no-lock
             where empresa.ep-codigo = tit-ap.ep-codigo no-error.
        if  avail empresa then
            assign tt-dirf.razao-social = empresa.razao-social
                   tt-dirf.cgc          = empresa.cgc.
    end.
        
END.

/* Fim Include */
