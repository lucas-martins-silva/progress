/**************************************************************************
**
**  Include.: AP0704.I8
**  Objetivo: Display dos titulos
**
************************************************************************/

     if  tt-tit-ap.tipo <> 2 then do:   /*AN*/
        if  tt-param.data-faixa = 1 then do:

            mov-block:
            for each mov-ap use-index codigo
                where mov-ap.ep-codigo   = tt-tit-ap.ep-codigo
                and   mov-ap.cod-estabel = tt-tit-ap.cod-estabel
                and   mov-ap.cod-esp     = tt-tit-ap.cod-esp
                and   mov-ap.serie       = tt-tit-ap.serie
                and   mov-ap.nr-docto    = tt-tit-ap.nr-docto
                and   mov-ap.parcela     = tt-tit-ap.parcela
                and   mov-ap.cod-fornec  = tt-tit-ap.cod-fornec no-lock:

                {app/ap9999.i2 "mov-ap"
                               "tt-param.moeda"
                               "tt-tit-ap"}

                if  mov-ap.transacao   <> 2 /*BND*/
                and mov-ap.transacao   <> 3 /*PEF*/
                and mov-ap.transacao   <> 5 /*AVA*/
                and mov-ap.transacao   <> 6 /*SND*/
                and mov-ap.transacao   <> 8 /*GPF*/ then
                    next.

                if  mov-ap.transacao   = 6 
                and mov-ap.lancamento <> 1 /*D*/ then
                    next.

                assign de-vl-mov-fasb = mov-ap.vl-mov-fasb.

                if  mov-ap.dt-transacao > tt-param.da-data then
                    if  mov-ap.transacao = 5 and mov-ap.lancamento = 1 then
                        if  tt-param.normal-fasb = 1 then
                            assign de-saldo = de-saldo - de-calc-valor-mov.
                        else 
                            assign de-saldo = de-saldo - mov-ap.vl-mov-fasb.

                    else
                        if  mov-ap.transacao = 5 and mov-ap.lancamento = 2 then     /*C*/
                            if  tt-param.normal-fasb = 1 then
                                assign de-saldo = de-saldo + de-calc-valor-mov.
                            else 
                                assign de-saldo = de-saldo + mov-ap.vl-mov-fasb. 
                        else
                            if  mov-ap.transacao = 8 then  
                                if  tt-param.normal-fasb = 2 then
                                    assign de-saldo = de-saldo + de-calc-valor-mov + de-calc-valor-juros.
                                else 
                                    assign de-saldo = de-saldo.
                            else
                                if  tt-param.normal-fasb = 1 then
                                    assign de-saldo = de-saldo + de-calc-valor-mov.
                                else 
                                    assign de-saldo = de-saldo + de-vl-mov-fasb.
            end.
        end.

        if  de-saldo > 0 then do:
            if  tt-tit-ap.tipo = 1  /*NO*/
            or  tt-tit-ap.tipo = 8 then    /*IR*/
                assign de-tot-nor  = de-tot-nor  + de-original
                       de-tot-nor1 = de-tot-nor1 + de-saldo
                       c-tip       = c-credito    /*C*/
                       c-tip1      = c-credito    /*C*/.

            if  tt-tit-ap.tipo = 3 then  /*PR*/
                assign de-tot-pre  = de-tot-pre  + de-original
                       de-tot-pre1 = de-tot-pre1 + de-saldo
                       c-tpo       = c-credito /*C*/
                       c-tpo1      = c-credito /*C*/.

            /* Carlos - src12112 - Tratamento de Provisäes */
            if tt-tit-ap.tipo = 10 then   /*PRO*/
                assign de-tot-pro  = de-tot-pro  + de-original
                       de-tot-pro1 = de-tot-pro1 + de-saldo
                       c-tpro      = c-credito
                       c-tpro1     = c-credito.
            /* ------------------------------------------- */

            assign c-dbcr         = c-credito /*C*/
                   c-dbcr1        = c-credito /*C*/
                   de-normal      = de-normal      + de-original
                   de-normal1     = de-normal1     + de-saldo
                   de-orig-grupo  = de-orig-grupo  + de-original
                   de-saldo-grupo = de-saldo-grupo + de-saldo
                   de-orig-forn   = de-orig-forn   + de-original
                   de-saldo-forn  = de-saldo-forn  + de-saldo.

            if  tt-tit-ap.dt-vencimen <= tt-param.da-calc-venc then do:
                assign nr-dias = tt-param.da-calc-venc - tt-tit-ap.dt-vencimen.

                if  nr-dias <= 30 then
                    assign de-ven-30 = de-ven-30 + de-saldo
                           de-total  = de-total  + de-saldo.
                else
                    if  nr-dias > 30 and nr-dias <= 60 then
                        assign de-ven-60 = de-ven-60 + de-saldo
                               de-total  = de-total  + de-saldo.
                    else
                        if  nr-dias > 60 and nr-dias <= 90 then
                            assign de-ven-90 = de-ven-90 + de-saldo
                                   de-total  = de-total  + de-saldo.
                        else
                            if  nr-dias > 90 and nr-dias <= 120 then
                                assign de-ven-120 = de-ven-120 + de-saldo
                                       de-total   = de-total   + de-saldo.
                            else
                                if  nr-dias > 120 then
                                    assign de-ven-999 = de-ven-999 + de-saldo
                                           de-total   = de-total   + de-saldo.
            end.
            else do:
                assign nr-dias = tt-tit-ap.dt-vencimen - tt-param.da-calc-venc.

                if  nr-dias <= 30 then
                    assign de-ven1-30 = de-ven1-30 + de-saldo
                           de-total1  = de-total1  + de-saldo.
                else
                    if  nr-dias > 30 and nr-dias <= 60 then
                        assign de-ven1-60 = de-ven1-60 + de-saldo
                               de-total1  = de-total1  + de-saldo.
                    else
                        if  nr-dias > 60 and nr-dias <= 90 then
                            assign de-ven1-90 = de-ven1-90 + de-saldo
                                   de-total1  = de-total1  + de-saldo.
                        else
                            if  nr-dias > 90 and nr-dias <= 120 then
                                assign de-ven1-120 = de-ven1-120 + de-saldo
                                       de-total1   = de-total1   + de-saldo.
                            else
                                if  nr-dias > 120 then
                                    assign de-ven1-999 = de-ven1-999 + de-saldo
                                           de-total1   = de-total1   + de-saldo.
            end.
        end.
    end.
    else do:                   

        if  tt-param.data-faixa = 1 then do:

            mov-block:
            for each mov-ap use-index ch-antecip
                where mov-ap.ep-codigo   = tt-tit-ap.ep-codigo
                and   mov-ap.cod-estabel = tt-tit-ap.cod-estabel
                and   mov-ap.esp-ant     = tt-tit-ap.cod-esp
                and   mov-ap.serie-ant   = tt-tit-ap.serie
                and   mov-ap.docto-ant   = tt-tit-ap.nr-docto
                and   mov-ap.parc-ant    = tt-tit-ap.parcela
                and   mov-ap.fornec-ant  = tt-tit-ap.cod-fornec
                and ((mov-ap.vl-antecip  <> 0 and tt-param.normal-fasb = 1)
                or   (mov-ap.vl-ant-fasb <> 0 and tt-param.normal-fasb = 2)) no-lock:

                {app/ap9999.i2 "mov-ap"
                               "tt-param.moeda"
                               "tt-tit-ap"}

                if   mov-ap.transacao <> 2            /*BND*/
                and  mov-ap.transacao <> 3            /*PEF*/
                and  mov-ap.transacao <> 8 then next. /*GPF*/

                if  (mov-ap.transacao = 2       /*BND*/ 
                or   mov-ap.transacao = 3)      /*PEF*/
                and  mov-ap.dt-trans  > tt-param.da-data then do:
                    assign de-vl-ant-fasb = mov-ap.vl-mov-fasb.
                    if tt-param.normal-fasb = 1 then
                       assign de-saldo = de-saldo + de-calc-vl-antecip.
                    else 
                       assign de-saldo = de-saldo + de-vl-ant-fasb.
                end.

                if   mov-ap.transacao     = 8  /*GPF*/
                and  mov-ap.dt-trans      > tt-param.da-data 
                and  tt-param.normal-fasb = 2 then
                     assign de-saldo = de-saldo + de-calc-valor-mov + de-calc-valor-juros.
            end. 

            mov-block:
            for each mov-ap use-index codigo
                where mov-ap.ep-codigo  = tt-tit-ap.ep-codigo
                and   mov-ap.cod-est    = tt-tit-ap.cod-est
                and   mov-ap.cod-esp    = tt-tit-ap.cod-esp
                and   mov-ap.serie      = tt-tit-ap.serie
                and   mov-ap.nr-docto   = tt-tit-ap.nr-docto
                and   mov-ap.parcela    = tt-tit-ap.parcela
                and   mov-ap.cod-fornec = tt-tit-ap.cod-fornec
                and  (mov-ap.transacao  = 5           /*AVA*/
                or    mov-ap.transacao  = 3           /*PEF*/
                or    mov-ap.transacao  = 8) no-lock: /*GPF*/


                {app/ap9999.i2 "mov-ap"
                               "tt-param.moeda"
                               "tt-tit-ap"}

                assign de-vl-ant-fasb = mov-ap.vl-mov-fasb.
                if  mov-ap.transacao = 5 /*AVA*/
                and mov-ap.dt-trans  > tt-param.da-data then
                    if  mov-ap.lancamento = 1 then  /*D*/
                        if  tt-param.normal-fasb = 1 then
                            assign de-saldo = de-saldo + de-calc-valor-mov.
                        else 
                            assign de-saldo = de-saldo + de-vl-ant-fasb.
                    else 
                        if  tt-param.normal-fasb = 1 then
                            assign de-saldo = de-saldo - de-calc-valor-mov.
                        else 
                            assign de-saldo = de-saldo - de-vl-ant-fasb. 

                if  mov-ap.transacao     = 3  /*PEF*/
                and mov-ap.dt-trans      > tt-param.da-data 
                and tt-param.normal-fasb = 2 then do:
                    assign de-vl-ant-fasb = mov-ap.vl-mov-fasb.
                    assign de-saldo = de-saldo + de-vl-ant-fasb.
                end.

                if   mov-ap.transacao     = 8 /*GPF*/
                and  mov-ap.dt-trans      > tt-param.da-data 
                and  tt-param.normal-fasb = 2 then
                     assign de-saldo = de-saldo - (mov-ap.valor-mov + mov-ap.valor-juros).
            end.
        end.

        if  de-saldo > 0 then
            if  tt-tit-ap.tipo = 2 then    /*AN*/
                assign c-dbcr         = c-debito   /*D*/
                       c-dbcr1        = c-debito   
                       c-tp1          = c-debito   
                       c-tp           = c-debito   
                       de-antec       = de-antec       + de-original
                       de-antec1      = de-antec1      + de-saldo
                       de-tot-ant     = de-tot-ant     + de-original
                       de-tot-ant1    = de-tot-ant1    + de-saldo
                       de-gerant      = de-gerant      + de-original
                       de-gerant1     = de-gerant1     + de-saldo
                       de-ante-grupo  = de-ante-grupo  + de-original
                       de-ante1-grupo = de-ante1-grupo + de-saldo
                       de-ante-forn   = de-ante-forn   + de-original
                       de-ante1-forn  = de-ante1-forn  + de-saldo.

       /* *********** 187465 **************** 
        * /*-- Calcula RESUMO --*/
        * if  de-saldo <> 0 then
        *    if tit-ap.tipo <> 2 then do:    /*AN*/
        *        {app/ap0704.i6 "+"}  /* Acumula totais - documentos normais */
        *    end.
        *    else do:
        *       {app/ap0704.i6 "-"} /* Desconta as Antecipacoes */
        *    end.
        * ***********************************/
    end.

    if  de-saldo > 0 then do:
        assign l-emitiu = yes.
        if  tt-param.detal-resum = 1 then do:
            disp tt-tit-ap.cod-fornec
                 tt-tit-ap.nome-abrev
                 tt-tit-ap.referencia
                 tt-tit-ap.cod-estabel
                 tt-tit-ap.cod-esp
                 tt-tit-ap.serie
                 tt-tit-ap.nr-docto
                 tt-tit-ap.parcela
                 tt-tit-ap.portador
                 tt-tit-ap.dt-emissao
                 tt-tit-ap.dt-vencimen
                 de-original
                 c-dbcr
                 de-saldo
                 c-dbcr1
                 tt-tit-ap.estado when tt-tit-ap.estado > 0
                 with frame f-item2.
            down with frame f-item2.
        end.
        if  (tt-param.lista-hist-prev   and tt-tit-ap.tipo  = 3)
        or  (tt-param.lista-hist-doctos and tt-tit-ap.tipo <> 3) /*PR*/
        or  (tt-param.lista-hist-prev   and tt-param.lista-hist-doctos) then do:
            find first mov-ap  use-index codigo
                 where mov-ap.ep-codigo    = tt-tit-ap.ep-codigo
                 and   mov-ap.cod-estabel  = tt-tit-ap.cod-estabel
                 and   mov-ap.cod-esp      = tt-tit-ap.cod-esp
                 and   mov-ap.serie        = tt-tit-ap.serie
                 and   mov-ap.nr-docto     = tt-tit-ap.nr-docto
                 and   mov-ap.parcela      = tt-tit-ap.parcela
                 and   mov-ap.cod-fornec   = tt-tit-ap.cod-fornec
                 and   (mov-ap.transacao   = 1 or mov-ap.transacao = 6)
                 no-lock no-error.
            if  avail mov-ap then
                if  mov-ap.historico <> "" then do:
                    if  tt-param.detal-resum = 1 then 
                        disp mov-ap.historico
                             with frame f-historico.
                end.
        end.
    end.
    if  last-of(day(tt-tit-ap.dt-vencimen))
    and l-emitiu = yes then do:
        assign l-emitiu = no.
        if  de-normal > de-antec then do:
            assign de-tot-mes  = de-normal - de-antec.

            assign c-tipo  = c-credito   /*C*/
                   c-tipo1 = c-credito.  /*C*/
        end.
        else
            if  de-normal < de-antec then do:
                assign de-tot-mes  = de-antec - de-normal.
                assign c-tipo  = c-debito  /*D*/
                       c-tipo1 = c-debito. /*D*/
            end.
            else
                if  de-normal = de-antec then
                    assign de-tot-mes = 0
                           c-tipo  = ""
                           c-tipo1 = "".

        if  de-tot-mes < 0 then
            assign de-tot-mes = de-tot-mes * -1.

        if  de-normal1 > de-antec1 then do:
            assign de-tot-mes1 = de-normal1 - de-antec1.

            if c-tipo1 = c-credito then
               de-tot-mes3 = de-tot-mes3 + de-tot-mes1.
            if c-tipo1 = c-debito then
               de-tot-mes3 = de-tot-mes3 - de-tot-mes1.
            assign c-tipo  = c-credito
                   c-tipo1 = c-credito.
        end.
        else
            if  de-normal1 < de-antec1 then do:
                assign de-tot-mes1 = de-antec1 - de-normal1.
                if c-tipo1 = c-debito then
                   de-tot-mes3 = de-tot-mes3 + de-tot-mes1.
                if c-tipo1 = c-credito then
                   de-tot-mes3 = de-tot-mes3 - de-tot-mes1.
                assign c-tipo  = c-debito
                       c-tipo1 = c-debito.
            end.
            else
                if  de-normal1 = de-antec1 then
                    assign de-tot-mes1 = 0
                           c-tipo      = ""
                           c-tipo1     = "".

         if de-tot-mes1 < 0 then
            assign de-tot-mes1 = de-tot-mes1 * -1.
         if de-tot-mes3 < 0 then
            assign de-tot-mes3 = de-tot-mes3 * -1.

        if  tt-param.detal-resum = 1 then
            disp c-mes-01    
                 de-tot-mes  
                 c-tipo      
                 de-tot-mes1 
                 c-tipo1
                 with frame f-mes.

        assign de-tot-mes  = 0
               de-tot-mes1 = 0
               de-normal   = 0
               de-normal1  = 0
               de-antec    = 0
               de-antec1   = 0.
    end.

    if  avail espec-ap
    and espec-ap.tipo = 2 then       /*AN*/
        if  de-saldo > 0 then 
            assign de-tot-mes2 = de-tot-mes2 - de-original.

    if   avail espec-ap
    and (espec-ap.tipo = 1   /*NO*/ /*PR*/
    or   espec-ap.tipo = 3 or espec-ap.tipo = 8 or espec-ap.tipo = 10) then    /*IR*/ /*PRO*/
         if  de-saldo > 0 then 
             assign de-tot-mes2 = de-tot-mes2 + de-original.

    if  last-of (month(tt-tit-ap.dt-vencimen)) then do:
        if  de-tot-mes2 < 0 then
            assign de-tot-mes2 = de-tot-mes2 * -1.

        if  de-tot-mes2 > 0
        or  de-tot-mes3 > 0 then do:
            if  tt-param.detal-resum = 1 then do:
                disp c-mes1-01
                     de-tot-mes2 
                     c-tipo      
                     de-tot-mes3 
                     c-tipo1
                     with frame f-mes1.
                assign de-tot-mes2 = 0
                       de-tot-mes3 = 0.
            end.
        end.
    end.

/* AP0704.I8 */
