**
**  AP2001E.I2 - DETALHE do Banco Itaœ
**
*******************************************************************************/

    assign i-tot-reg-lote  = i-tot-reg-lote + 1
           de-tot-val      = de-tot-val + tt-gps.valor-gps.

    put stream relat
        "341"                                                         at 001 
        i-tot-lotes                                 format "9999"     at 004
        "3"                                                           at 008
        i-tot-reg-lote                              format "99999"    at 009
        "N"                                                           at 014
        "000"                                                         at 015
        "01"                                                          at 018        
        tt-gps.cod-retencao                  format "9999"            at 020
        month(tt-gps.dt-competencia)         format "99"              at 024
        year(tt-gps.dt-competencia)          format "9999"            at 026
        tt-gps.cgc                           format "99999999999999"  at 030         
        tt-gps.valor-gps * 100               format "99999999999999"  at 044 
        "00000000000000"                                              at 058 
        "00000000000000"                                              at 072        
        tt-gps.valor-gps * 100               format "99999999999999"  at 086                     
        day(tt-gps.dt-pagto)                 format "99"              at 100
        month(tt-gps.dt-pagto)               format "99"              at 102
        year(tt-gps.dt-pagto)                format "9999"            at 104
        tt-gps.nome-emit                     format "x(29)"           at 166
        string(tt-gps.nr-docto-gps)          format "x(20)"           at 196
        " "                                                           at 240 skip. 

