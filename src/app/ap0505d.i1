/**************************************************************************
**
**  crp/cr0503d.i3 - PREVISÇO.
**
**************************************************************************/
                                                            
for each  l-pre-ap use-index codigo
    where l-pre-ap.ep-codigo   = lin-b-ap.ep-codigo
    and   l-pre-ap.cod-estabel = lin-b-ap.cod-estabel
    and   l-pre-ap.serie       = lin-b-ap.serie
    and   l-pre-ap.cod-esp     = lin-b-ap.cod-esp
    and   l-pre-ap.nr-docto    = lin-b-ap.nr-docto
    and   l-pre-ap.parcela     = lin-b-ap.parcela 
    no-lock:

    find first b-tit-ap use-index codigo
         where b-tit-ap.ep-codigo   = l-pre-ap.ep-cod-pre
         and   b-tit-ap.cod-estabel = l-pre-ap.cod-est-pre
         and   b-tit-ap.serie       = l-pre-ap.serie-pre
         and   b-tit-ap.cod-esp     = l-pre-ap.cod-esp-pre
         and   b-tit-ap.nr-docto    = l-pre-ap.nr-docto-pre
         and   b-tit-ap.parcela     = l-pre-ap.parcela-pre
         and   b-tit-ap.cod-fornec  = l-pre-ap.cod-fornec
         exclusive-lock no-error.
            
    if  avail b-tit-ap then do:
       
        /*--- Acerta Saldo da Antecipa‡Æo ----*/
        assign b-tit-ap.valor-saldo  = b-tit-ap.valor-saldo - l-pre-ap.vl-previsao
               b-tit-ap.vl-saldo-me  = b-tit-ap.vl-saldo-me - l-pre-ap.vl-previsao-me.       
                    
        /*---- Acerta data de liquidacao ----*/
        run app/ap6000a.p (input rowid(b-tit-ap)).
        
    end.
end.

/* fim de include */
