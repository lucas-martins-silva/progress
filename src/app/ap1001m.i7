/*****************************************************************************
**
**  ap1001m.i7 - agrupa codigo de barras pela leitora
**
*****************************************************************************/

            assign w-real-banco = int(substr(string(c-cod-barras,"999"),1,3))
                   w-real-c1    = substr(string(c-cod-barras),1,4)
                               + substr(string(c-cod-barras),20,5).
            run app/ap1001e5.p (input string(w-real-c1), output i-digito).

            assign w-real-c1 = string(w-real-c1) + string(i-digito)
                   w-real-c2 = substr(string(c-cod-barras),25,10).
            run app/ap1001e5.p (input string(w-real-c2), output i-digito).
            
            assign w-real-c2 = string(w-real-c2) + string(i-digito)
                   w-real-c3 = substr(string(c-cod-barras),35,10).
            run app/ap1001e5.p (input string(w-real-c3), output i-digito).

            assign w-real-c3 = string(w-real-c3) + string(i-digito)
                   c-dac    = substring(string(c-cod-barras),1,4)
                            + substring(string(c-cod-barras),6,39).
            run app/ap1001e6.p (input string(c-dac), output i-digito).

            assign w-real-dvg = int(substr(c-cod-barras,5,1))
                   w-real-c5 = substr(c-cod-barras,6,14).
                   
/*-- ap1001m.i7 --*/
