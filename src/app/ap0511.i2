/**************************************************************************
**
**  AP0511.I2 - Lay-outs dos cheques
**
***************************************************************************/

def {1} shared frame f-brasil.
form
   w-valor[1]                  at 64 skip(1)
   w-ext9100[1] format "x(59)" at 24
   w-ext9100[2] format "x(66)" at 16 skip(1)
   w-nominal[1]                at 17 skip(1)
   w-cidade[1]                 at 31
   w-dia[1]                    at 58
   w-mes[1]                    at 62
   w-ano1[1]                   at 78
   skip(10)
   with down no-labels no-box width 180 stream-io frame f-brasil.

def {1} shared frame f-brasil80.
form
   w-valor[1]                  at 62 skip(1)
   w-ext9100[1] format "x(59)" at 22
   w-ext9100[2] format "x(66)" at 14 skip(1)
   w-nominal[1]                at 15 skip(1)
   w-cidade[1]                 at 29
   w-dia[1]                    at 56
   w-mes[1]                    at 60
   w-ano1[1]                   at 76
   skip(10)
   with down no-labels no-box width 90 stream-io frame f-brasil80.

