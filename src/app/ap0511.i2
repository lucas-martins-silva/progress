   w-ext9100[2] format "x(66)" at 2  skip(1)
   w-nominal[1]                at 3  skip
   w-cidade[1]                 at 22
   w-dia[1]                    at 48
   w-mes[1]                    at 53
   w-ano1[1]                   at 65 skip(1)
   skip(10)
