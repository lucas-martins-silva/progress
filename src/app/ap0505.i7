/*******************************************************************************
**
**  AP0505.I7 - Include para achar o valor da Variacao Monetaria
**
*******************************************************************************/

find l-ant-ap
    where l-ant-ap.ep-codigo    =  doc-b-ap.ep-codigo
      and l-ant-ap.cod-est-ant  =  lin-b-ap.cod-estabel
      and l-ant-ap.cod-esp-ant  =  lin-b-ap.cod-esp
      and l-ant-ap.serie-ant    =  lin-b-ap.serie
      and l-ant-ap.nr-docto-ant =  lin-b-ap.nr-docto
      and l-ant-ap.parcela-ant  =  lin-b-ap.parcela
      and l-ant-ap.fornec-ant   =  lin-b-ap.cod-fornec
     {1}   no-error.
if  avail l-ant-ap then
    assign de-variacao = l-ant-ap.vl-ant-fasb.
else
    assign de-variacao = 0.
