PROCEDURE pi-criar-temp-tables-movimentos:

    /* Se o movimento j† foi exportado n∆o precisa prosseguir...*/
    find first tt-mov-ap no-lock
         where tt-mov-ap.r-rowid = rowid(mov-ap) no-error.
                
    if  avail tt-mov-ap then
        return.   
        
    IF  mov-ap.esp-ant <> "" THEN DO:
        FIND FIRST b-tit-ap NO-LOCK
             where b-tit-ap.ep-codigo  = mov-ap.ep-codigo  
             and   b-tit-ap.cod-estab  = mov-ap.cod-estab  
             and   b-tit-ap.cod-fornec = mov-ap.fornec-ant 
             and   b-tit-ap.cod-esp    = mov-ap.esp-ant    
             and   b-tit-ap.serie      = mov-ap.serie-ant  
             and   b-tit-ap.nr-docto   = mov-ap.docto-ant  
             and   b-tit-ap.parcela    = mov-ap.parc-ant
             NO-ERROR.

        IF  AVAIL b-tit-ap THEN DO:
            FIND FIRST tt-relacto NO-LOCK
                 WHERE tt-relacto.row-relacto = ROWID(b-tit-ap) NO-ERROR.
            IF  NOT AVAIL tt-relacto THEN DO:
                CREATE tt-relacto.
                ASSIGN tt-relacto.row-relacto = ROWID(b-tit-ap).
            END.
        END.
    END.

    {app/ap5000a.i3 mov-ap}

    RUN pi-criar-temp-table-conta (INPUT mov-ap.conta-contabil).
    RUN pi-criar-temp-table-conta (INPUT mov-ap.conta-diversos).
    RUN pi-criar-temp-table-conta (INPUT mov-ap.conta-frete).
    RUN pi-criar-temp-table-conta (INPUT mov-ap.conta-cre-antec).
    RUN pi-criar-temp-table-conta (INPUT mov-ap.conta-var-cambial). 
    RUN pi-criar-temp-table-conta (INPUT mov-ap.conta-var-monetaria).
        
    find first bord-rec 
         where bord-rec.ep-codigo  = mov-ap.ep-codigo 
         and   bord-rec.nr-bordero = mov-ap.nr-bordero
         NO-LOCK no-error.

    if  avail bord-rec then do:   
        {app/ap5000a.i3 bord-rec}
    end.

    /* Exporta Cadastros B†sicos */
    {app/ap5000a.i10 "mov-ap" 
                     "mov-ap.portador" 
                     "mov-ap.modalidade"}

    /* Dados Banc†rios */
    {app/ap5000a.i5 "mov-ap.portador"     
                    "mov-ap.modalidade"} 

    for each  che-emit no-lock
        where che-emit.ep-codigo   = mov-ap.ep-codigo
        and   che-emit.portador    = mov-ap.portador
        and   che-emit.nr-cheque   = mov-ap.nr-cheque
        and   che-emit.cod-fornec  = mov-ap.cod-fornec
        and   che-emit.cod-estabel = mov-ap.cod-estabel
        and   che-emit.cod-esp     = mov-ap.cod-esp
        and   che-emit.serie       = mov-ap.serie
        and   che-emit.nr-docto    = mov-ap.nr-docto
        and   che-emit.parcela     = mov-ap.parcela
        and   int(che-emit.char-1) = mov-ap.num-id-mov-ap:

        {app/ap5000a.i3 che-emit}

        /* O portador Ç lido na include ap5000a.i10 */
        if  avail portador then do:
            for each  cheque no-lock
                where cheque.cod-banco    = portador.cod-banco
                and   cheque.agencia      = portador.agencia
                and   cheque.conta-corren = portador.conta-corren
                and   cheque.nr-cheque    = che-emit.nr-cheque:
                {app/ap5000a.i3 cheque}
            end.    
        end.
    end.

END PROCEDURE.
