/********************************************************************************
***
*** app/ap0591c.i4 - Gera Antecipaá∆o em consequància do documento de origem
***                  n∆o possuir saldo ou a NC n∆o for vinculada.
***
********************************************************************************/

/*--- Cria Documento ---*/
run pi-valida-criacao-an-i4.
if return-value <> "NOK" then do:
    {app/ap0591c.i6 "tit-ap"
                    "tit-ap"}

    /*--- Cria Movimento ---*/
    {app/ap0591c.i5 "b-tit-ap"
                    "b-tit-ap"
                    "1"
                    "b-tit-ap.conta-debito"
                    "b-tit-ap.ct-conta-db"
                    "b-tit-ap.sc-conta-db"
                    "b-tit-ap.vl-original"
                    "b-tit-ap.vl-orig-me"
                    "1"}

    find first portador
         where portador.ep-codigo    = tit-ap.ep-codigo
           and portador.cod-portador = tit-ap.portador
           and portador.modalidade   = 1 no-lock no-error.

    if avail portador then do:

        assign mov-ap.banco        = portador.cod-banco
               mov-ap.agencia      = portador.agencia
               mov-ap.cta-corrente = portador.conta-corren
               mov-ap.cod-docto    = "1".       

        find first cta-corrente no-lock 
             where cta-corrente.cod-banco    = portador.cod-banco
               and cta-corrente.agencia      = portador.agencia
               and cta-corrente.conta-corren = portador.conta-corren
             no-error.

        if  avail cta-corrente then do:
            find first conta-contab no-lock
                where conta-contab.ep-codigo      = i-ep-codigo-usuario
                  and conta-contab.conta-contabil = cta-corrente.conta-saldo no-error.

            if avail conta-contab then do:
                assign mov-ap.conta-contabil = conta-contab.conta-contabil
                       mov-ap.ct-conta       = conta-contab.ct-codigo
                       mov-ap.sc-conta       = conta-contab.sc-codigo
                       mov-ap.nr-docto-banco = string(mov-ap.num-id-mov-ap)
                       b-tit-ap.conta-debito = conta-contab.conta-contabil
                       b-tit-ap.ct-conta-db  = conta-contab.ct-codigo
                       b-tit-ap.sc-conta-db  = conta-contab.sc-codigo.
            end.
        end.
    end.
    else if i-pais-impto-usuario = 4 /*MEX*/ then do:
        find first emitente where emitente.cod-emitente = b-tit-ap.cod-fornec no-lock no-error.
        if avail emitente then do:

            find first conta-ap
                where conta-ap.ep-codigo   = i-ep-codigo-usuario
                  and conta-ap.cod-estabel = b-tit-ap.cod-estabel
                  and conta-ap.cod-esp     = b-tit-ap.cod-esp  
                  and conta-ap.cod-grupo   = emitente.cod-gr-forn no-lock no-error.
            if avail conta-ap then do:
                find first conta-contab
                    where conta-contab.ep-codigo      = i-ep-codigo-usuario
                      and conta-contab.conta-contabil = conta-ap.conta-saldo no-lock no-error.
                if avail conta-contab then do:
                    /*foi feito isto pois dava erro na AN da nota CR sem portador e com t°tulo vinculado */
                    /*Leitura na b-impto-tit-ap, Ç para evitar erro de contabilizaá∆o na mesma conta ! - Heber*/
                    if  tit-ap.tipo = 4 /* Nota DB */ 
                    or (tit-ap.tipo = 5 and not l-vinculado and CAN-FIND(FIRST b-impto-tit-ap NO-LOCK
                                                                   WHERE b-impto-tit-ap.ep-codigo     = b-tit-ap.ep-codigo
                                                                     AND b-impto-tit-ap.cod-estabel   = b-tit-ap.cod-estabel
                                                                     AND b-impto-tit-ap.cod-fornec    = b-tit-ap.cod-fornec
                                                                     AND b-impto-tit-ap.cod-esp       = b-tit-ap.cod-esp
                                                                     AND b-impto-tit-ap.serie         = b-tit-ap.serie
                                                                     AND b-impto-tit-ap.nr-docto      = b-tit-ap.nr-docto
                                                                     AND b-impto-tit-ap.parcela       = b-tit-ap.parcela)) then
                        assign mov-ap.conta-contabil = conta-contab.conta-contabil
                               mov-ap.ct-conta       = conta-contab.ct-codigo
                               mov-ap.sc-conta       = conta-contab.sc-codigo.

                end.
            end.     
        end.
    end.        

    /************ MULTIPLANTA ************/
    run pi-cria-tt-dados-b-tit-ap (input 1).
    /*************************************/

    /*********** MULTIPLANTA ************/
    run pi-cria-tt-dados-mov-ap (input 1).
    /************************************/       
end.    

/* Fim de Include */

