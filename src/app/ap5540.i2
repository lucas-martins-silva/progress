/******************************************************************************
***
*** app/ap5540.i2 - Atualizaá‰es Permiss‰es Usu†rio.
***
***                 ATENÄ«O: N∆o Ç atualizado o c¢digo do portador e o
***                          n£mero do borderì porque estes campos n∆o
***                          deveriam pertencer ao °ndice.
***
******************************************************************************/
                            
/*-- Confirma Autorizaá∆o ? --*/
run utp/ut-msgs.p(input "show",
                  input 8381,
                  input "").
                
if  return-value = 'yes' then do:
                
    find first usuar-autoriza-tit use-index codigo
         where usuar-autoriza-tit.ep-codigo    = tit-ap.ep-codigo
         and   usuar-autoriza-tit.nr-bordero   = 0
         and   usuar-autoriza-tit.cod-portador = 0
         and   usuar-autoriza-tit.cod-estabel  = tit-ap.cod-estabel
         and   usuar-autoriza-tit.cod-fornec   = tit-ap.cod-fornec
         and   usuar-autoriza-tit.cod-esp      = tit-ap.cod-esp
         and   usuar-autoriza-tit.serie        = tit-ap.serie
         and   usuar-autoriza-tit.nr-docto     = tit-ap.nr-docto
         and   usuar-autoriza-tit.parcela      = tit-ap.parcela
         and   usuar-autoriza-tit.int-1        = tit-ap.tp-pagto
         and   usuar-autoriza-tit.autorizou    = no
         and   usuar-autoriza-tit.usuario      = c-seg-usuario exclusive-lock no-error.
                            
    if  avail usuar-autoriza-tit then do:
                
        assign usuar-autoriza-tit.dt-today     = today
               usuar-autoriza-tit.c-time       = string(time, "HH:MM")
               usuar-autoriza-tit.autorizou    = yes.
               
        /************* Multiplanta ************/
        run pi-cria-tt-dados-autoriza (input 2).
        /********** Fim-Multiplanta ***********/        
            
    end.
    else do:
            
        create usuar-autoriza-tit.
        assign usuar-autoriza-tit.ep-codigo    = tit-ap.ep-codigo
               usuar-autoriza-tit.nr-bordero   = 0
               usuar-autoriza-tit.cod-portador = 0
               usuar-autoriza-tit.cod-estabel  = tit-ap.cod-estabel
               usuar-autoriza-tit.cod-esp      = tit-ap.cod-esp
               usuar-autoriza-tit.serie        = tit-ap.serie
               usuar-autoriza-tit.nr-docto     = tit-ap.nr-docto
               usuar-autoriza-tit.parcela      = tit-ap.parcela
               usuar-autoriza-tit.cod-fornec   = tit-ap.cod-fornec
               usuar-autoriza-tit.int-1        = tit-ap.tp-pagto
               usuar-autoriza-tit.usuario      = c-seg-usuario
               usuar-autoriza-tit.dt-today     = today
               usuar-autoriza-tit.c-time       = string(time, "HH:MM")
               usuar-autoriza-tit.autorizou    = yes.
                
        /*--- Atualiza Sequància ---*/
        {app/ap0001.i2}
                
        /************* Multiplanta ************/
        run pi-cria-tt-dados-autoriza (input 1).
        /*********** Fim-Multiplanta **********/
                            
        find b-tit-ap of tit-ap exclusive-lock no-error.
                            
        assign b-tit-ap.autorizacao = b-tit-ap.autorizacao + 1.

        /************* Multiplanta ************/
        run pi-cria-tt-dados-b-tit-ap (input 2).
        /*********** Fim-Multiplanta **********/
        
    end.
                
    run utp/ut-msgs.p(input "show",
                      input 8385,
                      input "").
                      
end.
else do:
    find first usuar-autoriza-tit use-index codigo
         where usuar-autoriza-tit.ep-codigo    = tit-ap.ep-codigo
         and   usuar-autoriza-tit.nr-bordero   = 0
         and   usuar-autoriza-tit.cod-portador = 0
         and   usuar-autoriza-tit.cod-estabel  = tit-ap.cod-estabel
         and   usuar-autoriza-tit.cod-fornec   = tit-ap.cod-fornec
         and   usuar-autoriza-tit.cod-esp      = tit-ap.cod-esp
         and   usuar-autoriza-tit.serie        = tit-ap.serie
         and   usuar-autoriza-tit.nr-docto     = tit-ap.nr-docto
         and   usuar-autoriza-tit.parcela      = tit-ap.parcela
         and   usuar-autoriza-tit.int-1        = tit-ap.tp-pagto
         and   usuar-autoriza-tit.autorizou    = no
         and   usuar-autoriza-tit.usuario      = c-seg-usuario exclusive-lock no-error.

    if  not avail usuar-autoriza-tit then do:
        create usuar-autoriza-tit.
        assign usuar-autoriza-tit.ep-codigo    = tit-ap.ep-codigo
               usuar-autoriza-tit.nr-bordero   = 0
               usuar-autoriza-tit.cod-portador = 0
               usuar-autoriza-tit.cod-estabel  = tit-ap.cod-estabel
               usuar-autoriza-tit.cod-esp      = tit-ap.cod-esp
               usuar-autoriza-tit.serie        = tit-ap.serie
               usuar-autoriza-tit.nr-docto     = tit-ap.nr-docto
               usuar-autoriza-tit.parcela      = tit-ap.parcela
               usuar-autoriza-tit.cod-fornec   = tit-ap.cod-fornec
               usuar-autoriza-tit.int-1        = tit-ap.tp-pagto
               usuar-autoriza-tit.usuario      = c-seg-usuario
               usuar-autoriza-tit.dt-today     = today
               usuar-autoriza-tit.c-time       = string(time, "HH:MM")
               usuar-autoriza-tit.autorizou    = no.
                                
        /*--- Atualiza Sequància ---*/
        {app/ap0001.i2}
                
        /************ Multiplanta *************/
        run pi-cria-tt-dados-autoriza (input 1).
        /*********** Fim-Multiplanta **********/
                
        run utp/ut-msgs.p(input "show",
                          input 15472,
                          input "").
                
    end.
end.
            
/* Fim de Include */
