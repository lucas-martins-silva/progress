    find first estabelec no-lock
         where estabelec.cod-estabel = {1}.cod-estabel no-error.
    if  avail estabelec then do:
        {app/ap5000a.i3 estabelec}
    END.

    find first empresa no-lock
         where empresa.ep-codigo = tt-param.ep-codigo no-error.
    if  avail empresa then do:
        {app/ap5000a.i3 empresa}
    END.

    find first param-ap no-lock
         where param-ap.ep-codigo = tt-param.ep-codigo no-error.
    if  avail param-ap then do:
        {app/ap5000a.i3 param-ap}
        RUN pi-criar-temp-table-conta (INPUT param-ap.conta-trans-pag).
        RUN pi-criar-temp-table-conta (INPUT param-ap.conta-despesas).
    END.

    FIND FIRST emitente NO-LOCK
         WHERE emitente.cod-emitente = {1}.cod-fornec NO-ERROR.

    IF  AVAIL emitente THEN DO:
        {app/ap5000a.i4 emitente {1} {1}.cod-esp}
        ASSIGN c-matriz = emitente.nome-matriz.
    END.
    ELSE 
        ASSIGN c-matriz = "".

    FIND FIRST emitente NO-LOCK
         WHERE emitente.nome-abrev = c-matriz NO-ERROR.
    IF  AVAIL emitente THEN DO:
        {app/ap5000a.i4 emitente {1} {1}.cod-esp}
    END.

    FIND FIRST espec-ap NO-LOCK
         WHERE espec-ap.cod-esp = {1}.cod-esp NO-ERROR.

    IF  AVAIL espec-ap THEN DO:
        {app/ap5000a.i3 espec-ap}
    END.
