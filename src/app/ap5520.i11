/***************************************************************************
**
**  AP5520.i11 - Display do cabecalho
**
***************************************************************************/

if  bord-rec.estado >= 3 then do:
    {utp/ut-liter.i ReemissÆo}
    assign c-reemissao = trim(return-value).
end.   
else do:
    {utp/ut-liter.i Teste_Prepara‡Æo}
    if  bord-rec.estado = 1 then assign c-reemissao = trim(return-value).
    else
        c-reemissao = "".
end.
find empresa use-index codigo
     where empresa.ep-codigo = bord-rec.ep-codigo no-lock no-error.

if  available empresa then do:    
    disp c-estab
         c-esp
         c-serie
         c-empresa 
         empresa.razao-social
         c-endereco
         empresa.endereco
         c-cidade
         empresa.cidade
         empresa.uf
         empresa.cep
         empresa.endereco
         c-cgc
         empresa.cgc
         c-data 
         da-today   
         c-bordero
         bord-rec.nr-bordero
         c-reemissao  
         c-documento
         c-parc
         c-fornec
         c-emissao
         c-vencimento
         c-valor-doc
         c-juros
         c-desconto
         c-variacao
         &if defined(BF_FIN_MULTA_ABATIMENTO) &then
         c-multa
         c-abat
         c-vl-liq
         &endif
         c-razao
         c-praca
         c-nome-banc
         c-corrente
         c-cont-corrent     format "9999999999-xx"         
         &if defined(BF_FIN_MULTA_ABATIMENTO) &then
         &else
         c-vl-liq
         &endif
         with frame f-empresa{1}.
end.

find first portador use-index codigo
     where portador.ep-codigo  = bord-rec.ep-codigo
     and   portador.cod-port   = bord-rec.portador
     and   portador.modalidade = 1 no-lock no-error.

if  avail portador then do:

    find first cta-corrente 
         where cta-corrente.cod-banco      = portador.cod-banco 
         and   cta-corrente.agencia        = portador.agencia
         and   cta-corrente.conta-corren   = portador.conta-corren no-lock no-error.

    if  not avail cta-corrente then 
        assign c-conta          = portador.conta-corren
               c-codigo-agencia = portador.agencia.
    else 
        assign c-conta          = cta-corrente.conta-corren-extr
               c-codigo-agencia = cta-corrente.agencia-extrato.

    assign i-cont = portador.modalidade.

    disp c-banco
         portador.nome
         c-agencia                 
         with frame f-empresa{1}.

    if  avail cta-corrente then
        disp c-codigo-agencia @ portador.agencia  format "999999-x"
             c-conta                              format "9999999999-xx"
             with frame f-empresa{1}.
    else
        disp c-codigo-agencia @ portador.agencia
             c-conta
             with frame f-empresa{1}.

end.

if  bord-rec.mens-ini > 0 then do:
    find mensagem where mensagem.cod-mensagem = bord-rec.mens-ini no-lock no-error.
    if  available mensagem then do:
        assign c-mensagem        = mensagem.texto-mensag
               c-mensagem        =    replace(c-mensagem, chr(10), " ")
               c-mensagem        =    replace(c-mensagem, chr(13), " ")
               c-texto-mensag[1] =  substring(c-mensagem, 001, 70)
               c-texto-mensag[2] =  substring(c-mensagem, 071, 70)
               c-texto-mensag[3] =  substring(c-mensagem, 141, 70)
               c-texto-mensag[4] =  substring(c-mensagem, 211, 70)
               c-texto-mensag[5] =  substring(c-mensagem, 281, 70).

        disp c-texto-mensag[1]
             c-texto-mensag[2]
             c-texto-mensag[3]
             c-texto-mensag[4]
             c-texto-mensag[5]   
             with frame f-empresa{1}.

    end.
end.

/* fim */
