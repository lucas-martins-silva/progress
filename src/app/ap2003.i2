assign i-cont = 0.
if  tt-param.i-listagem = 1 then do:
    for each tit-ap NO-LOCK {1} 
        where tit-ap.ep-codigo     = tt-param.i-empresa
        and   tit-ap.tipo          = 1
        and   tit-ap.dt-liq        = 12/31/9999
        and   tit-ap.portador     >= tt-param.i-port-ini
        and   tit-ap.portador     <= tt-param.i-port-fim
        and   tit-ap.cod-fornec   >= tt-param.i-forn-ini
        and   tit-ap.cod-fornec   <= tt-param.i-forn-fim
        and   tit-ap.dt-vencimen  >= tt-param.dt-ini-vecto
        and   tit-ap.dt-vencimen  <= tt-param.dt-fim-vecto
        and   tit-ap.titulo-banco >= tt-param.c-nr-gps-ini
        and   tit-ap.titulo-banco <= tt-param.c-nr-gps-fim:
        
        assign i-cont = i-cont + 1.
        if i-cont mod 50 = 0 then
           run pi-acompanhar in h-acomp (input string(i-cont)).
        
        if  substr(tit-ap.titulo-banco,1,3) <> "GPS" then 
            next.
            
        if  tt-param.i-listagem = 1 and tit-ap.vl-saldo = 0 then
            next.
    
        if  tt-param.i-listagem = 2 and tit-ap.vl-saldo <> 0 then
            next.
    
        run pi-cria-tt.
    end.
end.
else do:
    for each tit-ap NO-LOCK {1} 
        where tit-ap.ep-codigo     = tt-param.i-empresa
        and   tit-ap.tipo          = 1
        and   tit-ap.portador     >= tt-param.i-port-ini
        and   tit-ap.portador     <= tt-param.i-port-fim
        and   tit-ap.cod-fornec   >= tt-param.i-forn-ini
        and   tit-ap.cod-fornec   <= tt-param.i-forn-fim
        and   tit-ap.dt-vencimen  >= tt-param.dt-ini-vecto
        and   tit-ap.dt-vencimen  <= tt-param.dt-fim-vecto
        and   tit-ap.titulo-banco >= tt-param.c-nr-gps-ini
        and   tit-ap.titulo-banco <= tt-param.c-nr-gps-fim:

        assign i-cont = i-cont + 1.
        if i-cont mod 50 = 0 then
           run pi-acompanhar in h-acomp (input string(i-cont)).
        
        if  substr(tit-ap.titulo-banco,1,3) <> "GPS" then 
            next.
            
        if  tt-param.i-listagem = 1 and tit-ap.vl-saldo = 0 then
            next.

        if  tt-param.i-listagem = 2 and tit-ap.vl-saldo <> 0 then
            next.
    
        run pi-cria-tt.
    end.

end.
