
def temp-table tt-cheque-pend
    field num-id-mov-tit    like cheque-pend.num-id-mov-tit 
    field ep-codigo-mvto    like cheque-pend.ep-codigo-mvto
    field cod-estabel-mvto  like cheque-pend.cod-estabel-mvto
    field cod-esp-mvto      like cheque-pend.cod-esp-mvto
    field serie-mvto        like cheque-pend.serie-mvto
    field nr-docto-mvto     like cheque-pend.nr-docto-mvto  
    field parcela-mvto      like cheque-pend.parcela-mvto
    field cod-banco         like cheque-pend.cod-banco
    field agencia           like cheque-pend.agencia 
    field conta-corren      like cheque-pend.conta-corren
    field nr-cheque         like cheque-pend.nr-cheque  
    field cod-postal        like cheque-pend.cod-postal
    field tipo-cheque       like cheque-pend.tipo-cheque
    field vl-cheque         like cheque-pend.vl-cheque
    field situacao-cheque   like cheque-pend.situacao-cheque 
    field dt-vencimento     like cheque-pend.dt-vencimento
    field dt-compensacao    like cheque-pend.dt-compensacao
    field dt-emissao        like cheque-pend.dt-emissao
    field dt-deposito       like cheque-pend.dt-deposito
    field dt-liberacao      like cheque-pend.dt-liberacao
    field dt-devolucao      like cheque-pend.dt-devolucao
    field refer-devolucao   like cheque-pend.refer-devolucao
    field cod-portador      like cheque-pend.cod-portador
    field cod-emitente      like cheque-pend.cod-emitente
    field vl-desp-banc      like cheque-pend.vl-desp-banc
    field sequencia-mvto    like cheque-pend.sequencia-mvto
    field horas-compensacao like cheque-pend.horas-compensacao
    field cod-banco-ant     like cheque-pend.cod-banco-ant
    field agencia-ant       like cheque-pend.agencia-ant
    field conta-corren-ant  like cheque-pend.conta-corren-ant 
    field nr-cheque-ant     like cheque-pend.nr-cheque-ant  
    field nr-docto-bco      like cheque-pend.nr-docto-bco 
    field nom-emit-cheque   like cheque-pend.nom-emit-cheque
    field origem-cheque     like cheque-pend.origem-cheque
    field cod-controle      like cheque-pend.cod-controle
    field tp-codigo         like cheque-pend.tp-codigo  
    field cod-image         like cheque-pend.cod-image
    field char-2            like cheque-pend.char-2.
