/*******************************************************************************
***
*** app/ap0533.i6 - Defini‡Æo temp-table.
***
*******************************************************************************/

/* Obs: quando for alterado a tt-param deve ser dado manuten‡Æo dos programas ap0533b, ap0533c e ap0533d.
        Pois os mesmos possuem a defini‡Æo da tt-param, pois os fontes sÆo liberados aos clientes. */

define {1} temp-table tt-param
    field destino          as integer                   /* Sa¡da: impressora, terminal ou arquivo */
    field arquivo          as char                      /* Nome do arquivo de saida */ 
    field usuario          as char format "x(12)"       /* Usu rio logado no sistema */
    field data-exec        as date                      /* Data de Execu‡Æo */
    field hora-exec        as integer                   /* Hora de Execu‡Æo */
    field for-ini          like che-emit.cod-fornec     /* C¢digo do fornecedor inicial informado na sele‡Æo*/
    field for-fim          like che-emit.cod-fornec     /* C¢digo do fornecedor final   informado na sele‡Æo*/
    field dat-ini          like che-emit.dt-emissao     /* Data de vencimento inicial informado na sele‡Æo*/
    field dat-fim          like emite-ap.dt-vencimen    /* Data de vencimento final informado na sele‡Æo*/
    field num-ini          like che-emit.nr-docto       /* N£mero do documento inicial informado na sele‡Æo*/
    field num-fim          like che-emit.nr-docto       /* N£mero do documento final informado na sele‡Æo*/
    field reemissao        as logical                   /* Igual a yes, Identifica que foi escolhido a op‡Æo reemissao*/
    field cheque-ini       like che-emit.nr-cheque      /* N£mero do cheque inicial informado na sele‡Æo. Tamb‚m utilizado p/ informar o nr. do cheque a ser reemitido */
    field cheque-fim       like che-emit.nr-cheque      /* N£mero do cheque final informado na sele‡Æo*/
    field portador         like che-emit.portador       /* Portador informado no folder parƒmetros*/
    field i-ep-codigo      like empresa.ep-codigo       /* Codigo da empresa a qual o usuario esta logado*/
    field layout           as char format "x(40)"       /* Cont‚m o codigo e descri‡Æo do banco do portador, determinando o layout que o cheque vai ser impresso */
                                                        /* Pode conter tamb‚m "999 - Espec¡fico + Nome abreviado do portador" que deve ser utilizado p/ o desenvolvimento de layout espec¡fico */
    field l-teste          as logical                   /* Igual a yes, significa que o usu rio deseja fazer um teste de formul rio*/
    field gerar            as logical                   /* Igual a yes, significa que ser  gerado arquivo de c¢pia do cheque */
    field imp-hist         as logical                   /* Igual a yes, significa que ser  impresso o hist¢rico no arquivo de c¢pia do cheque */
    field copia            as char format "x(40)"       /* Nome do arquivo de c¢pia do cheque */
    field quant            as integer                   /* Quantidade de cheques emitidos por p gina (1, 2 ou 3) */
    field text-quant       as char format "x(40)"       /* Texto existente no folder parƒmetros, para a quantidade de c¢pias por p gina escolhida*/
    field list-tipo        as integer                   /* Quando 1, lista a cidade da empresa. Quando 2, lista a empresa do estabelecimento, de acordo com a escolha feita no folder de parametros */
    field list-text        as char format "x(40)"       /* Cont‚m o texto correspondente a cidade que quem ir  imprimir (Emmpresa ou Estabelecimento)*/
    field imp              as integer                   /* N£mero de colunas em que os cheques serÆo impressos. Obs: somente o Bamerindus (399) possui a op‡Æo de 2 colunas */
    field text-imp         as char format "x(40)"       /* Texto referente ao n£mero de colunas escolhida para impressÆo do cheque */
    field colum            as integer                   /* Tipo da impressora escolhida (1 - 80 colunas e 2 - 132 colunas) */
    field text-colum       as char format "x(40)"       /* Texto referente a escolha da impressora */
    field novo-cheque      like che-emit.nr-cheque      /* N£mero do cheque que ir  substituir o que est  sendo reemitido. Utilizado quando talon rio do portador for manual */
    field mantem-nr-cheque as logical init no           /* Mant‚m n£mero de cheque na reemissÆo */
    field conf-favorec     as logical                   /* fun‡Æo conf-favorec*/
    .

define {1} temp-table tt-digita
    field ordem            as integer   format ">>>>9"  
    field exemplo          as character format "x(30)"
    index id is primary unique
        ordem.

/* Fim de Include */
