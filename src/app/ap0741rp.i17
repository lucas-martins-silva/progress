/*******************************************************************************
***
*** app/ap0741rp.i17 - Primeiro Grupo.
***
*******************************************************************************/

find first grupo-fornec no-lock 
     where grupo-fornec.cod-gr-forn = {1} no-error.
        
if  avail grupo-fornec then do:
    put trim(c-grupo) format "x(18)"
        " "
        grupo-fornec.cod-gr-forn
        " - "
        grupo-fornec.descricao skip(1).
end.

/* Fim de Include */

