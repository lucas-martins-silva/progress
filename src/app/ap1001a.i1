/**************************************************************************
**
**  AP1001AG.I1
**  Objetivo : Registro Header do Banco do Brasil
**
**************************************************************************/

find first empresa 
     where empresa.ep-codigo = i-ep-codigo-usuario 
     no-lock no-error.

find first portador 
     where portador.ep-codigo    = i-ep-codigo-usuario 
     and   portador.cod-portador = i-portador 
     and   portador.modalidade   = 1
     no-lock no-error.

find first cta-corrente
     where cta-corrente.cod-banco    = portador.cod-banco
     and   cta-corrente.agencia      = portador.agencia
     and   cta-corrente.conta-corren = portador.conta-corren
     no-lock no-error.

find first banco 
     where banco.cod-banco = portador.cod-banco 
     no-lock no-error.

assign c-cgc-emp = ""
       i-num-reg = 1.

do i-cont = 1 to 19:
   if  substr(empresa.cgc,i-cont,1) >= "0" 
   and substr(empresa.cgc,i-cont,1) <= "9" then
       assign c-cgc-emp = c-cgc-emp + substr(empresa.cgc,i-cont,1).
end.

if  tt-param.i-tipo-pag = 30
or  tt-param.i-tipo-pag = 31 then do:
    put stream relat
    "001"                                                              at 001
    "1"                                                                at 004
    day(today)                                 format "99"             at 005
    month(today)                               format "99"             at 007
    substr(string(year(today),"9999"),3,2)     format "99"             at 009
    tt-param.i-sequencia                       format "99999"          at 011
    substr(cta-corrente.agencia-extrato,3,4)   format "9999"           at 016
    substr(cta-corrente.agencia-extrato,7,1)   format "9"              at 020
    substr(cta-corrente.conta-corren-extr,2,9) format "999999999"      at 021
    substr(cta-corrente.conta-corren-extr,11,1)format "9"              at 030
    dec(c-cgc-emp)                             format "99999999999999" at 031
    "CBR388"                                                           at 045
    "                                                                                                                                                                                              "
                                                                       at 051 skip.
end.
else do: /* DOC, CC */
    put stream relat
    "01"                                                           at 001
    "03"                                                           at 010
    "00000"                                                        at 013
    substr(cta-corrente.agencia-extrato,3,4)    format "9999"      at 027
    substr(cta-corrente.agencia-extrato,7,1)    format "9"         at 031
    substr(cta-corrente.conta-corren-extr,2,9)  format "999999999" at 032
    substr(cta-corrente.conta-corren-extr,11,1) format "9"         at 041
    empresa.razao-social                        format "x(30)"     at 047
    "001"                                                          at 077
    tt-param.i-convenio                         format "999999"    at 080
    "RET"                                                          at 086
    "00"                                                           at 099
    "NOVO"                                                         at 167
    i-num-reg                                   format "999999"    at 195
    skip.
end.
                                                                       

/* ap1001a.i1 */
