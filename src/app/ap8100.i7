define {1} shared temp-table t-diario-ap no-undo 
    field ep-codigo        like diario-ap.ep-codigo
    field ct-conta         like diario-ap.ct-conta
    field sc-conta         like diario-ap.sc-conta
    field conta-contabil   like diario-ap.conta-contabil
    field dt-transacao     like diario-ap.dt-transacao
    field transacao        like diario-ap.transacao
    field referencia       like mov-ap.referencia
    field cod-fornec       like mov-ap.cod-fornec
    field cod-estabel      like mov-ap.cod-estabel
    field cod-esp          like mov-ap.cod-esp
    field serie            like mov-ap.serie
    field nr-docto         like mov-ap.nr-docto
    field parcela          like mov-ap.parcela
    field nr-cheque        like mov-ap.nr-cheque     
    field portador         like diario-ap.portador      
    field historico        like diario-ap.historico     
    field titulo           as rowid        
    field lancamento       like diario-ap.lancamento     
    field vl-debito        like diario-ap.vl-debito  
    field vl-deb-fasb      like diario-ap.vl-deb-fasb
    field vl-deb-cmi       like diario-ap.vl-deb-cmi     
    field vl-deb-presente  like diario-ap.vl-deb-presente
    field vl-credito       like diario-ap.vl-credito      
    field vl-cred-fasb     like diario-ap.vl-cred-fasb    
    field vl-cred-cmi      like diario-ap.vl-cred-cmi     
    field vl-cred-presente like diario-ap.vl-cred-presente
    field char-1           as rowid
    field contra-partida   as char format "x(17)"
    field rowid-mov-ap     as char
    INDEX data1 ep-codigo 
                dt-transacao 
                conta-contabil
                ct-conta
                sc-conta
                nr-cheque
                ASCENDING
    INDEX data2 ep-codigo 
                dt-transacao 
                nr-cheque
                portador
                ct-conta
                sc-conta
                ASCENDING
    INDEX forne ep-codigo 
                cod-fornec 
                cod-estabel
                cod-esp
                serie
                nr-docto
                parcela
                dt-transacao
                transacao
                rowid-mov-ap
                ASCENDING.


