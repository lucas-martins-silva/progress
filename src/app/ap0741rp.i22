/*******************************************************************************
***
*** app/ap0741rp.i22 - 
***
*******************************************************************************/

assign de-tot-saldo = de-tot-saldo + tt2-mov-ap.valor-mov
       de-ger-atual = de-ger-atual + tt2-mov-ap.valor-mov.
                
assign de-tot-atual = de-tot-atual
                    + tt2-mov-ap.valor-mov.
                    
if  tt2-mov-ap.valor-mov >= 0 then
    assign de-ger-saldo-cr = de-ger-saldo-cr + tt2-mov-ap.valor-mov.
else
    assign de-ger-saldo-db = de-ger-saldo-db + (tt2-mov-ap.valor-mov * (- 1)).
            
if  de-tot-atual >= 0 then
    assign de-ger-atual-cr = de-ger-atual-cr + de-tot-atual.
else
    assign de-tot-atual    = de-tot-atual.
           de-ger-atual-db = de-ger-atual-db + de-tot-atual.

/* Fim de Include */
