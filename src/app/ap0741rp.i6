/*******************************************************************************
***
*** app/ap0741rp.i6 - pi-quebra-classificacao.
***
*******************************************************************************/

def input param p-log-tt as logical no-undo.

assign i-prazo      = if  de-pr-total <> 0 then
                          de-prazo / de-pr-total
                      else 0
       i-atraso     = if  de-at-total <> 0 then
                          de-atraso / de-at-total
                      else 0.

if  de-tot-saldo < 0 then
    assign de-tot-saldo = de-tot-saldo * (-1).

if  de-tot-atual < 0 then
    assign de-tot-atual = de-tot-atual * (-1).
                        
/*------ Relat¢rio Detalhado ------*/
if  tt-param.tp-relatorio = 1 then do:
        
    disp i-prazo
         de-tot-saldo
         c-lancto1
         i-atraso
         de-tot-atual
         c-lancto2
         with frame f-medio.
            
    down with frame f-medio.
        
    if  tt-param.log-razao-ficha = yes then
        page.
        
end.
else do:

    if (tt-param.classifica = 1  or
        tt-param.classifica = 5) then do:
                
        if  p-log-tt = yes then do:
            disp tt-mov-ap.cod-fornec
                 tt-mov-ap.nome-emit
                 with frame f-resumo.
                 
        end.
        else do:
            
            if  avail mov-ap then do:
                find tt-emitente 
                    where tt-emitente.cod-emitente = mov-ap.cod-fornec no-lock no-error.
                if  not avail tt-emitente then do:
                    find first emitente no-lock
                        where emitente.cod-emitente = mov-ap.cod-fornec no-error.
                    if  avail emitente then do:
                        create tt-emitente.
                        buffer-copy emitente to tt-emitente.
                    end.    
                end.    
                    
                if  avail tt-emitente then
                    disp tt-emitente.cod-emitente @ tt-mov-ap.cod-fornec
                         tt-emitente.nome-emit    @ tt-mov-ap.nome-emit 
                         with frame f-resumo.
                         
            end.    
        end.
                
        disp de-tot-saldo
             c-lancto1
             de-tot-atual
             c-lancto2
             i-prazo
             i-atraso
             with frame f-resumo.
                
        down with frame f-resumo.
                
    end.
    else do:
            
        disp de-tot-saldo
             c-lancto1
             de-tot-atual
             c-lancto2
             i-prazo
             i-atraso
             with frame f-resumo1.
                
        down with frame f-resumo1.
            
    end.
    
    if  tt-param.classifica = 2 or
        tt-param.classifica = 3 or
        tt-param.classifica = 4 then
        put skip(1).
            
end.
        
assign de-at-geral    = de-at-geral  + de-at-total
       de-pr-geral    = de-pr-geral  + de-pr-total
       de-pr-data     = de-pr-data   + de-prazo
       de-at-data     = de-at-data   + de-atraso
       de-tot-db      = 0
       de-tot-cr      = 0
       de-tot-atual   = 0
       de-tot-saldo   = 0
       de-pr-total    = 0
       de-at-total    = 0
       de-prazo       = 0
       de-atraso      = 0
       i-prazo        = 0
       i-atraso       = 0.
        
/* Fim de Include */
