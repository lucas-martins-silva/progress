/*******************************************************************************
**  
**  PROGRAMA: APAPI020.I2
**
**  Include de cancelamento das previsäes.
**
*******************************************************************************/

assign i-cant = i-cant + 1.

run pi-validar-previsao (output l-erro).

if  l-erro = yes then do:
    next {1}.
end.
        
run pi-cria-tt-dados-tit-ap.        
        
assign c-des-mensagem = "".

find emite-ap exclusive-lock
    where emite-ap.ep-codigo   = tit-ap.ep-codigo
    and   emite-ap.cod-estabel = tit-ap.cod-estabel
    and   emite-ap.cod-esp     = tit-ap.cod-esp
    and   emite-ap.serie       = tit-ap.serie
    and   emite-ap.cod-fornec  = tit-ap.cod-fornec 
    and   emite-ap.nr-docto    = tit-ap.nr-docto
    and   emite-ap.parcela     = tit-ap.parcela
    and   emite-ap.transacao   = 1 no-error.
  
if  avail emite-ap then do:
    run pi-cria-tt-dados-emite-ap.
    delete emite-ap.   
end.

{app/ap9100.i2}
assign tt-integ-ap.tt-row-tit-ap  = rowid(tit-ap)
       tt-integ-ap.tt-ge0102g     = yes
       tt-integ-ap.tt-cb0110a     = yes  
       tt-integ-ap.tt-cb1202a     = yes
       tt-integ-ap.tt-op-ge0102g  = 6   /*Elimina*/
       tt-integ-ap.tt-op-cb0110a  = 6   /*Elimina*/ 
       tt-integ-ap.tt-op-cb1202a  = 6.  /*Elimina*/
raw-transfer tt-integ-ap to raw-integracao.
run app/ap9100.p (input raw-integracao, input-output table tt-erro).

for each mov-ap exclusive-lock
    where mov-ap.ep-codigo   = tit-ap.ep-codigo
    and   mov-ap.cod-estabel = tit-ap.cod-estabel
    and   mov-ap.cod-esp     = tit-ap.cod-esp
    and   mov-ap.serie       = tit-ap.serie
    and   mov-ap.cod-fornec  = tit-ap.cod-fornec
    and   mov-ap.nr-docto    = tit-ap.nr-docto
    and   mov-ap.parcela     = tit-ap.parcela:

    if  avail param-global then do:
        if  param-global.modulo-in = yes
        and mov-ap.num-ord-inv > 0  then do:
            run inp/in3001d.p (input rowid(mov-ap),
                               input "elimina-movap").
            if  RETURN-VALUE = "NOK":U THEN
                next {1}.            
        end.
    end. 

    if  mov-ap.transacao = 3
    or  mov-ap.transacao = 4 then do:
        find che-emit exclusive-lock
            where che-emit.ep-codigo   = mov-ap.ep-codigo
            and   che-emit.portador    = mov-ap.portador
            and   che-emit.nr-cheque   = mov-ap.nr-cheque
            and   che-emit.cod-estabel = mov-ap.cod-estabel
            and   che-emit.cod-esp     = mov-ap.cod-esp
            and   che-emit.serie       = mov-ap.serie
            and   che-emit.cod-fornec  = mov-ap.cod-fornec
            and   che-emit.nr-docto    = mov-ap.nr-docto
            and   che-emit.parcela     = mov-ap.parcela no-error.
        if  avail che-emit then
            assign che-emit.cancelado = yes.
    end.
    
    {app/ap9100.i2}
    assign tt-integ-ap.tt-row-mov-ap  = rowid(mov-ap)
           tt-integ-ap.tt-cb0201a     = yes
           tt-integ-ap.tt-cb1202a     = yes
           tt-integ-ap.tt-op-cb0201a  = 6   /*Elimina*/
           tt-integ-ap.tt-op-cb1202a  = 22. /*Elimina Movto*/
    raw-transfer tt-integ-ap to raw-integracao.
    run app/ap9100.p (input raw-integracao, input-output table tt-erro).
    run pi-cria-tt-dados-mov-ap.
    
    delete mov-ap.  
end.

create tt-titulo.
assign tt-titulo.ep-codigo   = tit-ap.ep-codigo
       tt-titulo.cod-estabel = tit-ap.cod-estabel
       tt-titulo.cod-esp     = tit-ap.cod-esp
       tt-titulo.serie       = tit-ap.serie
       tt-titulo.nr-docto    = tit-ap.nr-docto
       tt-titulo.parcela     = tit-ap.parcela
       tt-titulo.cod-fornec  = tit-ap.cod-fornec
       tt-titulo.vl-original = tit-ap.vl-original
       tt-titulo.valor-saldo = tit-ap.valor-saldo.

/*---- Elimina Impostos do T¡tulo ----*/
for each impto-tit-ap exclusive-lock
    where impto-tit-ap.ep-codigo   = tit-ap.ep-codigo
    and   impto-tit-ap.cod-estabel = tit-ap.cod-estabel
    and   impto-tit-ap.cod-fornec  = tit-ap.cod-fornec
    and   impto-tit-ap.serie       = tit-ap.serie
    and   impto-tit-ap.cod-esp     = tit-ap.cod-esp
    and   impto-tit-ap.nr-docto    = tit-ap.nr-docto
    and   impto-tit-ap.parcela     = tit-ap.parcela:
    
    delete impto-tit-ap validate (true,"").
end.
    
/*---- Elimina Autoriza‡äes Pagamento ---*/
for each usuar-autoriza-tit use-index codigo
    where usuar-autoriza-tit.ep-codigo    = tit-ap.ep-codigo
    and   usuar-autoriza-tit.nr-bordero   = 0
    and   usuar-autoriza-tit.cod-portador = 0
    and   usuar-autoriza-tit.cod-estabel  = tit-ap.cod-estabel
    and   usuar-autoriza-tit.cod-fornec   = tit-ap.cod-fornec
    and   usuar-autoriza-tit.cod-esp      = tit-ap.cod-esp
    and   usuar-autoriza-tit.serie        = tit-ap.serie
    and   usuar-autoriza-tit.nr-docto     = tit-ap.nr-docto
    and   usuar-autoriza-tit.parcela      = tit-ap.parcela exclusive-lock:
    
    delete usuar-autoriza-tit validate (true,"").
end.

delete tit-ap.

/* app/apapi020.i2 */
