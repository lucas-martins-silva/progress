/***************************************************************************
***
*** app/ap6001.i1 - Cria TempTableïs utilizadas pelo Bloqueio.
***
***************************************************************************/

if  ({4} <> ? and {4} <> 0) then do:
    
    find first tt-consiste-bloqueio-ap no-lock
         where tt-consiste-bloqueio-ap.num-id-mov-ap = {4} 
         no-error.
    
    if  not avail tt-consiste-bloqueio-ap then do:
        CREATE tt-consiste-bloqueio-ap.
        ASSIGN tt-consiste-bloqueio-ap.ep-codigo      = {1}.ep-codigo  
               tt-consiste-bloqueio-ap.cod-estabel    = {1}.cod-estabel
               tt-consiste-bloqueio-ap.cod-fornec     = {1}.cod-fornec 
               tt-consiste-bloqueio-ap.cod-esp        = {1}.cod-esp    
               tt-consiste-bloqueio-ap.serie          = {1}.serie      
               tt-consiste-bloqueio-ap.nr-docto       = {1}.nr-docto   
               tt-consiste-bloqueio-ap.parcela        = {1}.parcela    
               tt-consiste-bloqueio-ap.referencia     = {2}
               tt-consiste-bloqueio-ap.dt-transacao   = {3}
               tt-consiste-bloqueio-ap.num-id-mov-ap  = {4}.    
    end.     
end.
else do:
    find first tt-consiste-bloqueio-ap no-lock
         where tt-consiste-bloqueio-ap.ep-codigo      = {1}.ep-codigo  
         and   tt-consiste-bloqueio-ap.cod-estabel    = {1}.cod-estabel
         and   tt-consiste-bloqueio-ap.cod-fornec     = {1}.cod-fornec 
         and   tt-consiste-bloqueio-ap.cod-esp        = {1}.cod-esp    
         and   tt-consiste-bloqueio-ap.serie          = {1}.serie      
         and   tt-consiste-bloqueio-ap.nr-docto       = {1}.nr-docto   
         and   tt-consiste-bloqueio-ap.parcela        = {1}.parcela    
         no-error.

    if  not avail tt-consiste-bloqueio-ap then do:
    
        CREATE tt-consiste-bloqueio-ap.
        ASSIGN tt-consiste-bloqueio-ap.ep-codigo      = {1}.ep-codigo  
               tt-consiste-bloqueio-ap.cod-estabel    = {1}.cod-estabel
               tt-consiste-bloqueio-ap.cod-fornec     = {1}.cod-fornec 
               tt-consiste-bloqueio-ap.cod-esp        = {1}.cod-esp    
               tt-consiste-bloqueio-ap.serie          = {1}.serie      
               tt-consiste-bloqueio-ap.nr-docto       = {1}.nr-docto   
               tt-consiste-bloqueio-ap.parcela        = {1}.parcela    
               tt-consiste-bloqueio-ap.referencia     = {2}
               tt-consiste-bloqueio-ap.dt-transacao   = {3}
               tt-consiste-bloqueio-ap.num-id-mov-ap  = {4}.
    end.
end.

/* Fim Include */

