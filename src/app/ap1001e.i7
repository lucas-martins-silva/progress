/*****************************************************************************
**
**  ap1001e.i7 - agrupa codigo de barras pela leitora
**
*****************************************************************************/
            assign ita-banco = int(substr(string(c-cod-barras,"999"),1,3))
                   ita-c1    = substr(string(c-cod-barras),1,4)
                               + substr(string(c-cod-barras),20,5).
            run app/ap1001e5.p (input string(ita-c1), output i-digito).

            assign ita-c1 = string(ita-c1) + string(i-digito)
                   ita-c2 = substr(string(c-cod-barras),25,10).
            run app/ap1001e5.p (input string(ita-c2), output i-digito).
            
            assign ita-c2 = string(ita-c2) + string(i-digito)
                   ita-c3 = substr(string(c-cod-barras),35,10).
            run app/ap1001e5.p (input string(ita-c3), output i-digito).

            assign ita-c3   = string(ita-c3) + string(i-digito)
                   c-dac    = substring(string(c-cod-barras),1,4)
                            + substring(string(c-cod-barras),6,39).
            run app/ap1001e6.p (input string(c-dac), output i-digito).

            assign ita-dvg = int(substr(c-cod-barras,5,1)).
                   ita-c5 = substr(c-cod-barras,8,12).
                   
 
/* fim */
