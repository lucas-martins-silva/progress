/*****************************************************************************
***
*** app/apapi020b.i1 - Variaveis, Form's, etc...
*** 
*****************************************************************************/

def var c-des-mensagem  as char format "x(40)"    no-undo.
def var c-parametro     as char format "x(12)":U  no-undo.
def var c-selecao       as char                   no-undo.
def var l-erro          as logical                no-undo. 
def var c-impressao     as char format "x(12)":U  no-undo.
def var c-destino       as char                   no-undo.
def var c-titulo        as char                   no-undo.
def var c-reg-proc      as char                   no-undo.
def var i-cant          as integer                no-undo.
def var i-num-seq       as int  init 0            no-undo.
def var i-tipo-movto    as int                    no-undo.

form
   tt-titulo.ep-codigo   
   tt-titulo.cod-estabel 
   tt-titulo.cod-esp     
   tt-titulo.serie       
   tt-titulo.nr-docto   
   tt-titulo.parcela
   tt-titulo.cod-fornec
   tt-titulo.vl-original
   tt-titulo.valor-saldo
   with down width 132 no-box stream-io frame f-titulo.

form
   tt-erro-retorno.ep-codigo
   tt-erro-retorno.cod-estabel 
   tt-erro-retorno.cod-esp     
   tt-erro-retorno.serie       
   tt-erro-retorno.nr-docto   
   tt-erro-retorno.parcela
   tt-erro-retorno.cod-fornec 
   tt-erro-retorno.cod-erro   
   tt-erro-retorno.desc-erro format "x(57)" view-as editor max-chars 2000 
                                 scrollbar-vertical size 50 by 4
   with stream-io no-box no-attr-space width 300 down frame f-erro.

form 
   c-selecao                    no-label    at 01 skip(1)
   tt-param.serie-ini                    colon 32 space(12) "|> <|"     
   tt-param.serie-fim           no-label colon 63 skip 
   tt-param.docto-ini                    colon 32 space(1)  "|> <|"    
   tt-param.docto-fim           no-label colon 63 skip
   tt-param.parc-ini                     colon 32 space(15) "|> <|"
   tt-param.parc-fim            no-label colon 63 skip
   tt-param.forn-ini format ">>>>>>>>9"  colon 32 space(08) "|> <|"
   tt-param.forn-fim format ">>>>>>>>9"  no-label colon 63 skip
   tt-param.ref-ini                      colon 32   "|> <|"
   tt-param.ref-fim             no-label colon 63 skip
   tt-param.emis-ini                     colon 32   "|> <|"
   tt-param.emis-fim            no-label colon 63 skip
   tt-param.trans-ini                    colon 32   "|> <|"
   tt-param.trans-fim           no-label colon 63 skip
   tt-param.venc-ini                     colon 32   "|> <|"
   tt-param.venc-fim            no-label colon 63 skip(1)
   c-parametro                  no-label    at 01 skip(1)   
   tt-param.estabel                      colon 32 skip
   tt-param.espec                        colon 32 skip
   tt-param.prev-com-saldo               colon 32 skip
   tt-param.prev-sem-saldo               colon 32 skip
   tt-param.prev-pefs                    colon 32 skip(1)
   c-impressao                  no-label    at 01 skip(1) 
   c-destino                             colon 32
   " - " 
   tt-param.arquivo             no-label format "x(60)":U skip
   tt-param.usuario                      colon 32 skip(2)
   with stream-io side-labels no-box width 132 frame f-selecao.

run utp/ut-trfrrp.p (input frame f-titulo:handle).
run utp/ut-trfrrp.p (input frame f-erro:handle).
run utp/ut-trfrrp.p (input frame f-selecao:handle).

{utp/ut-liter.i Sele‡Æo * C}
assign c-selecao = trim(return-value).

{utp/ut-liter.i S‚rie * C}  
assign tt-param.serie-ini:label in frame f-selecao = return-value.

{utp/ut-liter.i Documento * C}  
assign tt-param.docto-ini:label in frame f-selecao = return-value.

{utp/ut-liter.i Parcela * C}  
assign tt-param.parc-ini:label in frame f-selecao = return-value. 

{utp/ut-liter.i Fornecedor * C}  
assign tt-param.forn-ini:label in frame f-selecao = return-value.

{utp/ut-liter.i Referˆncia * C}  
assign tt-param.ref-ini:label in frame f-selecao = return-value.

{utp/ut-liter.i Dt_EmissÆo * C}  
assign tt-param.emis-ini:label in frame f-selecao = return-value.

{utp/ut-liter.i Dt_Transa‡Æo * C}  
assign tt-param.trans-ini:label in frame f-selecao = return-value.

{utp/ut-liter.i Dt_Vencimento * C}  
assign tt-param.venc-ini:label in frame f-selecao = return-value.

{utp/ut-liter.i Parƒmetros * C}
assign c-parametro = trim(return-value).     

{utp/ut-liter.i Estabel * C}
assign tt-param.estabel:label in frame f-selecao = return-value.

{utp/ut-liter.i Esp‚cie * C}  
assign tt-param.espec:label in frame f-selecao = return-value.

{utp/ut-liter.i Elim_Prev_com_Saldo * C}  
assign tt-param.prev-com-saldo:label in frame f-selecao = return-value.

{utp/ut-liter.i Elim_Prev_sem_Saldo * C}  
assign tt-param.prev-sem-saldo:label in frame f-selecao = return-value.

{utp/ut-liter.i Elim_Prev_Utilizadas_em_PEFïs * C}  
assign tt-param.prev-pefs:label in frame f-selecao = trim(return-value).

{utp/ut-liter.i ImpressÆo * C}
assign c-impressao = trim(return-value).                  

{utp/ut-liter.i Destino * C}
assign c-destino:label in frame f-selecao = trim(return-value).

{utp/ut-liter.i Registros_processados * C}
assign c-reg-proc = trim (return-value) + ": ".

{utp/ut-liter.i Cod_Erro * C}
assign tt-erro-retorno.cod-erro:label = trim (trim(return-value)).

{utp/ut-liter.i Descri‡Æo * C}
assign tt-erro-retorno.desc-erro:label = trim (trim(return-value)).

/* Fim de Include */


