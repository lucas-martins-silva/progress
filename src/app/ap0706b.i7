/****************************************************************************
***
*** app/ap0706b.i7 - pi-classif4-moeda1.
***
****************************************************************************/

class-block:
do  on error  undo class-block, return error
    on endkey undo class-block, return error
    on stop   undo class-block, return error:

    {app/ap0706.i8}

    tit-block:
    for each emitente
        where emitente.cod-emitente >= tt-param.fornec-ini
        and   emitente.cod-emitente <= tt-param.fornec-fim
        and   emitente.cod-gr-for   >= tt-param.grp-forn-ini
        and   emitente.cod-gr-for   <= tt-param.grp-forn-fim
        and   emitente.identific    <> 1 no-lock,
        each tit-ap use-index codigo no-lock
            where tit-ap.ep-codigo    = i-ep-codigo-usuario
            and   tit-ap.cod-fornec   = emitente.cod-emitente
            and   tit-ap.cod-estabel >= tt-param.estab-ini
            and   tit-ap.cod-estabel <= tt-param.estab-fim
            and   tit-ap.cod-esp     >= tt-param.espec-ini
            and   tit-ap.cod-esp     <= tt-param.espec-fim
            and  (tit-ap.tipo        <> 7
            or    tt-param.l-lista-op)
            break by tit-ap.cod-esp
                  by tit-ap.cod-fornec
                  by tit-ap.cod-estabel
                  by tit-ap.serie
                  by tit-ap.nr-docto
                  by tit-ap.parcela:

            find espec-ap
                where espec-ap.cod-esp = tit-ap.cod-esp no-lock no-error.
            if  not avail espec-ap
            or (avail espec-ap and espec-ap.contabiliza = no and tt-param.l-espec-ctbl = yes) then
                next tit-block.

            assign i-tipo-esp = if  avail espec-ap then espec-ap.tipo else 0.

            if  (i-tipo-esp = 3 or i-tipo-esp = 10) and tt-param.l-prev-saldo = no then
                next tit-block.

            if  first-of(tit-ap.cod-esp) then do:
                disp espec-ap.cod-esp @ mov-ap.cod-esp
                     espec-ap.descricao with frame f-espec.

                assign i-prazo      = if  de-pr-total <> 0 then
                                          de-prazo / de-pr-total
                                      else 0
                       i-atraso     = if  de-at-total <> 0 then
                                          de-atraso / de-at-total
                                      else 0
                       de-tot-atual = de-tot-atual + de-total-cr - de-total-db
                       de-at-geral  = de-at-geral + de-at-total
                       de-pr-geral  = de-pr-geral + de-pr-total
                       de-at-data   = de-at-data  + de-atraso
                       de-pr-data   = de-pr-data  + de-prazo
                       de-pr-total  = 0
                       de-at-total  = 0
                       de-atraso    = 0
                       de-prazo     = 0
                       de-tot-cr    = 0
                       de-tot-db    = 0
                       de-total-cr  = 0
                       de-total-db  = 0
                       de-tot-saldo = 0
                       de-tot-atual = 0
                       de-sal-esp   = 0
                       de-tot-esp   = 0.
            end.

            if  first-of(tit-ap.cod-fornec) then do:
                assign l-fornec       = yes
                       l-existe-movto = no.
                run pi-acompanhar in h-acomp (input (c-text-acomp + string(tit-ap.cod-fornec))).
            end.

            mov-block:
            for each mov-ap no-lock
                where mov-ap.ep-codigo     = tit-ap.ep-codigo
                and   mov-ap.cod-fornec    = tit-ap.cod-fornec
                and   mov-ap.cod-estabel   = tit-ap.cod-estabel
                and   mov-ap.cod-esp       = tit-ap.cod-esp
                and   mov-ap.serie         = tit-ap.serie
                and   mov-ap.nr-docto      = tit-ap.nr-docto
                and   mov-ap.parcela       = tit-ap.parcela
                and   mov-ap.dt-transacao >= tt-param.dt-transac-ini
                and   mov-ap.dt-transacao <= tt-param.dt-transac-fim
                and  (mov-ap.transacao <> 7
                and   mov-ap.transacao <> 8
                and   mov-ap.transacao <> 9
                and   mov-ap.transacao <> 10
                and   mov-ap.transacao <> 11
                and   mov-ap.transacao <> 12
                and   mov-ap.transacao <> 13
                and   mov-ap.transacao <> 14
                and   mov-ap.transacao <> 15)
                and   mov-ap.tipo      <> 4
                and   mov-ap.tipo      <> 5:
                    
                if mov-ap.transacao = 5 and mov-ap.tipo = 10 and mov-ap.contabiliza = false then
                    next.

                {app/ap9999.i2 mov-ap tt-param.moeda tit-ap}
                    
                assign l-movto = yes.

                if  (mov-ap.transacao = 1 and i-tipo-esp <> 2)
                or  (mov-ap.transacao = 5 and mov-ap.lancamento = 1)
                or  (mov-ap.transacao = 6 and mov-ap.lancamento = 2)
                or  (mov-ap.transacao = 3 and i-tipo-esp = 2)
                or   mov-ap.transacao = 4 then do:
                    if  i-tipo-esp = 3 or i-tipo-esp = 10 then do:
                        assign de-converte       = de-calc-valor-mov 
                               de-total-cr       = de-total-cr       + de-converte
                               de-total-geral-cr = de-total-geral-cr + de-converte
                               de-fornec-cr      = de-fornec-cr      + de-converte
                               c-tipo            = {adinc/i01ad059.i 04 2}
                               c-tp-forn         = {adinc/i01ad059.i 04 2}.
                    end.
                    else do:
                        if  i-tipo-esp = 2 and mov-ap.transacao = 3 then do:
                            assign de-total-cr       = de-total-cr       + de-calc-vl-antecip
                                   de-total-geral-cr = de-total-geral-cr + de-calc-vl-antecip
                                   de-fornec-cr      = de-fornec-cr      + de-calc-vl-antecip
                                   c-tipo            = {adinc/i01ad059.i 04 2}
                                   c-tp-forn         = {adinc/i01ad059.i 04 2}.
                        end.
                        else do:
                            if  mov-ap.transacao <> 4 then do:
                                assign de-total-cr       = de-total-cr       + de-calc-valor-mov
                                       de-total-geral-cr = de-total-geral-cr + de-calc-valor-mov
                                       de-fornec-cr      = de-fornec-cr      + de-calc-valor-mov
                                       c-tipo            = {adinc/i01ad059.i 04 2}
                                       c-tp-forn         = {adinc/i01ad059.i 04 2}.
                            end.
                        end.
                    end.
                end.

                if  (mov-ap.transacao = 1 and i-tipo-esp = 2)
                or  (mov-ap.transacao = 5 and mov-ap.lancamento = 2)
                or  (mov-ap.transacao = 6 and mov-ap.lancamento = 1)
                or  (mov-ap.transacao = 3 and i-tipo-esp <> 2 and tt-param.l-prev-saldo = yes)
                or  mov-ap.transacao  = 2 then do:
                    assign de-total-db       = de-total-db       + de-calc-valor-mov
                           de-total-geral-db = de-total-geral-db + de-calc-valor-mov
                           de-fornec-db      = de-fornec-db      + de-calc-valor-mov
                           c-tipo            = {adinc/i01ad059.i 04 1}
                           c-tp-forn         = {adinc/i01ad059.i 04 1}.
                end.

                if  mov-ap.transacao  = 3
                and tt-param.l-prev-saldo = no and i-tipo-esp <> 2 then do:
                    assign c-tipo    = {adinc/i01ad059.i 04 1}
                           c-tp-forn = {adinc/i01ad059.i 04 1}.
                end.

                if  mov-ap.transacao = 1 and i-tipo-esp <> 2
                and ((i-tipo-esp <> 3 and i-tipo-esp <> 10) or tt-param.l-prev-perfil = yes) then do:
                    {app/ap0706.i2}
                end.

                if  mov-ap.transacao = 2
                and (mov-ap.dt-transacao > mov-ap.dt-vencimen or tt-param.atraso-medio = 1) then do:
                    assign i-data         = mov-ap.dt-transacao - mov-ap.dt-vencimen
                           de-atraso      = fn_ajust_dec((de-atraso + (i-data * de-calc-valor-mov)),tt-param.moeda)
                           de-at-total    = de-at-total + de-calc-valor-mov.
                end.

                if  l-fornec = yes then do:
                    if  mov-ap.cod-fornec = 0 then do:
                        {utp/ut-liter.i Desconhecido * R}
                        disp mov-ap.cod-fornec
                             trim(return-value) @ emitente.nome-emit
                             with frame f-resumo.
                    end.
                    else
                        disp mov-ap.cod-fornec
                             emitente.nome-emit
                             with frame f-resumo.

                    assign l-fornec = no.
                end.

                if  (mov-ap.transacao = 3 or  mov-ap.transacao  = 4) then do:
                    assign de-tot-pef = de-tot-pef + if mov-ap.transacao = 4
                                        then de-calc-valor-mov else (- de-calc-valor-mov).
                end.

                if  mov-ap.transacao  = 4 and i-tipo-esp <> 2 then
                    assign c-tipo = {adinc/i01ad059.i 04 2}.

                assign l-existe-movto = yes.
            end.

            mov-block:
            for each mov-ap use-index ch-antecip no-lock
                where mov-ap.ep-codigo    = tit-ap.ep-codigo
                and   mov-ap.fornec-ant   = tit-ap.cod-fornec
                and   mov-ap.cod-estabel  = tit-ap.cod-estabel
                and   mov-ap.esp-ant      = tit-ap.cod-esp
                and   mov-ap.serie-ant    = tit-ap.serie
                and   mov-ap.docto-ant    = tit-ap.nr-docto
                and   mov-ap.parc-ant     = tit-ap.parcela
                and   mov-ap.dt-transacao >= tt-param.dt-transac-ini
                and   mov-ap.dt-transacao <= tt-param.dt-transac-fim
                and   mov-ap.transacao     = 2
                and   mov-ap.tipo         <> 4
                and   mov-ap.tipo         <> 5
                by mov-ap.dt-transacao:
                            
                {app/ap9999.i2 mov-ap tt-param.moeda tit-ap}
                            
                assign de-converte       = de-calc-valor-mov
                       de-fornec-cr      = de-fornec-cr + de-converte
                       de-at-total       = de-at-total  + de-converte
                       i-data            = mov-ap.dt-transacao - mov-ap.dt-vencimen
                       de-atraso         = de-atraso         + (i-data * de-calc-valor-mov)
                       de-total-cr       = de-total-cr       + de-calc-vl-antecip
                       de-total-geral-cr = de-total-geral-cr + de-calc-vl-antecip
                       de-fornec-cr      = de-fornec-cr      + de-calc-vl-antecip
                       c-tipo            = {adinc/i01ad059.i 04 2}
                       c-tp-forn         = {adinc/i01ad059.i 04 2}
                       l-existe-movto    = yes.

                if  l-fornec = yes then do:
                    if  mov-ap.cod-fornec = 0 then do:
                        {utp/ut-liter.i Desconhecido * R}
                        disp mov-ap.cod-fornec
                             trim(return-value) @ emitente.nome-emit
                             with frame f-resumo.
                    end.
                    else
                        disp mov-ap.cod-fornec
                             emitente.nome-emit
                             with frame f-resumo.

                    assign l-fornec = no.
                end.
            end.

            if  last-of(tit-ap.cod-fornec) then do:
                mov-block:
                for each mov-ap use-index codigo
                    where mov-ap.ep-codigo     = i-ep-codigo-usuario
                    and   mov-ap.cod-estabel   = tt-param.estab-fim
                    and   mov-ap.cod-esp       = tit-ap.cod-esp
                    and   mov-ap.cod-fornec    = tit-ap.cod-fornec
                    and   mov-ap.dt-transacao  = tt-param.dt-transac-fim
                    and   mov-ap.transacao     = 7 
                    and   mov-ap.tipo         <> 4
                    and   mov-ap.tipo         <> 5 no-lock:

                    /* OBS: Para a transaá∆o 7 sempre o valor do movimento ser† gravado
                            na moeda de seleá∆o do relat¢rio, n∆o Ç necess†rio fazer
                            a convers∆o dos valores abaixo (mov-ap.valor-mov). */

                    assign de-tot-atual = de-tot-atual + mov-ap.valor-mov
                           de-tot-saldo = de-tot-saldo + mov-ap.valor-mov
                           de-sal-esp   = de-sal-esp   + mov-ap.valor-mov
                           de-tot-esp   = de-tot-esp   + mov-ap.valor-mov.
                end.

                assign i-prazo  = if  de-pr-total <> 0 then de-prazo  / de-pr-total else 0
                       i-atraso = if  de-at-total <> 0 then de-atraso / de-at-total else 0
                       de-tot-atual = de-tot-atual + de-total-cr - de-total-db
                       de-tot-esp   = de-tot-esp   + de-total-cr - de-total-db.

                do  with frame f-resumo:
                    if  l-existe-movto = no and l-movto = no
                    and (de-tot-atual <> 0 or de-tot-saldo <> 0) then do:
                        if  l-fornec = yes then do:
                            disp emitente.cod-emit @ mov-ap.cod-fornec
                                 emitente.nome-emit
                                 with frame f-resumo.
                            assign l-fornec = no.
                        end.
                    end.

                    assign l-movto = no.

                    if  de-tot-saldo >= 0 then do:
                        if  l-existe-movto = yes or de-tot-atual <> 0 then
                            disp {adinc/i01ad059.i 04 2} @ c-tipo.
                        assign de-ger-saldo-cr = de-ger-saldo-cr + de-tot-saldo.
                    end.
                    else do:
                        if  l-existe-movto = yes or de-tot-atual <> 0 then
                            disp {adinc/i01ad059.i 04 1} @ c-tipo.
                        assign de-tot-saldo = de-tot-saldo * (- 1)
                               de-ger-saldo-db = de-ger-saldo-db + de-tot-saldo.
                    end.

                    if  de-tot-atual >= 0 then do:
                        if  l-existe-movto = yes or de-tot-atual <> 0 then
                            disp {adinc/i01ad059.i 04 2} @ c-lancto.
                        assign de-ger-atual-cr = de-ger-atual-cr + de-tot-atual.
                    end.
                    else do:
                        if  l-existe-movto = yes or de-tot-atual <> 0 then
                            disp {adinc/i01ad059.i 04 1} @ c-lancto.
                        assign de-tot-atual = de-tot-atual * (- 1)
                               de-ger-atual-db = de-ger-atual-db + de-tot-atual.
                    end.

                    if  l-existe-movto = yes or de-tot-atual <> 0 then do:
                        disp i-prazo
                             de-tot-saldo
                             i-atraso
                             de-tot-atual.
                        down with frame f-resumo.
                    end.
                end.

                assign de-at-geral    = de-at-geral + de-at-total
                       de-pr-geral    = de-pr-geral + de-pr-total
                       de-at-data     = de-at-data  + de-atraso
                       de-pr-data     = de-pr-data  + de-prazo
                       de-pr-total    = 0
                       de-at-total    = 0
                       de-atraso      = 0
                       de-prazo       = 0
                       de-tot-cr      = 0
                       de-tot-db      = 0
                       de-total-cr    = 0
                       de-total-db    = 0
                       de-tot-saldo   = 0
                       de-tot-atual   = 0
                       l-existe-movto = no.
                if  tt-param.l-ficha = yes then page.
            end.

            if  last-of(tit-ap.cod-esp) then do:
                if  de-sal-esp = 0 and de-tot-esp = 0 then
                    put skip(1).
                else do with frame f-tot-espec:
                    if  de-sal-esp < 0 then do:
                        disp {adinc/i01ad059.i 04 1} @ c-tipo.
                        assign de-sal-esp = de-sal-esp * (-1).
                    end.
                    else
                        disp {adinc/i01ad059.i 04 2} @ c-tipo.

                    if  de-tot-esp < 0 then do:
                        disp {adinc/i01ad059.i 04 1} @ c-lancto.
                        assign de-tot-esp = de-tot-esp * (-1).
                    end.
                    else
                        disp {adinc/i01ad059.i 04 2} @ c-lancto.

                    disp de-sal-esp
                         de-tot-esp.
                end.
            end.
    end.

    do  with frame f-geral:
        if  de-ger-saldo-cr >= de-ger-saldo-db then do:
            assign de-diferenca = de-ger-saldo-cr - de-ger-saldo-db.
            disp de-diferenca @ de-ger-saldo
                 {adinc/i01ad059.i 04 2} @ c-tipo.
        end.
        else do:
            assign de-diferenca = de-ger-saldo-db - de-ger-saldo-cr.
            disp de-diferenca @ de-ger-saldo
                 {adinc/i01ad059.i 04 1} @ c-tipo.
        end.

        if  de-ger-atual-cr >= de-ger-atual-db  then do:
            assign de-diferenca = de-ger-atual-cr - de-ger-atual-db.
            disp de-diferenca @ de-ger-atual
                 {adinc/i01ad059.i 04 2} @ c-lancto.
        end.
        else do:
            assign de-diferenca = de-ger-atual-db - de-ger-atual-cr.
            disp de-diferenca @ de-ger-atual
                 {adinc/i01ad059.i 04 1} @ c-lancto.
        end.

        if  de-tot-pef < 0 then
            assign de-tot-pef = de-tot-pef * -1
                   c-db-cr    = {adinc/i01ad059.i 04 1}.
        else
            assign c-db-cr = {adinc/i01ad059.i 04 2}.

        disp de-total-geral-cr
             de-total-geral-db
             de-tot-pef
             c-db-cr.
    end.
end.

/* Fim de Include */
