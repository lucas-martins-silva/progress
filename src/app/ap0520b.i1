/******************************************************************************
***       
*** app/ap0520b.i1 - Consistàncias para criar a DIRF (IR).
***
******************************************************************************/

IF  tit-ap.cod-ret = 0 AND tt-param.l-cod-zero = NO THEN 
    NEXT dirf_block.

FIND FIRST emitente NO-LOCK
     WHERE emitente.cod-emitente = tit-ap.cod-fornec NO-ERROR.

IF  AVAIL emitente THEN DO:
    IF  emitente.cod-gr-forn < tt-param.i-grupo-ini or
        emitente.cod-gr-forn > tt-param.i-grupo-fim THEN
        NEXT dirf_block.
END.
ELSE 
    NEXT dirf_block.

IF  emitente.natureza = 1
OR  emitente.natureza = 4 THEN 
    NEXT dirf_block.

IF  tt-param.l-estrangeiro = NO 
AND emitente.natureza = 3 THEN 
    NEXT dirf_block.

/* Somente se for a seleá∆o Normal */
if  l-normal = yes then do:

    find FIRST espec-ap where espec-ap.cod-esp = tit-ap.cod-esp no-lock no-error.
    if  not avail espec-ap THEN
        NEXT dirf_block.

    if  avail espec-ap and espec-ap.log-1 = yes THEN
        NEXT dirf_block.
end.

ASSIGN i-fornec = tit-ap.cod-fornec.

/* Somente ser for a seleá∆o para IR (Retená‰es) */
if  l-retencao = yes then do:

    find first mov-ap no-lock
         where mov-ap.ep-codigo     = tit-ap.ep-codigo
         and   mov-ap.cod-fornec    = tit-ap.cod-fornec
         and   mov-ap.cod-estabel   = tit-ap.cod-estabel
         and   mov-ap.serie         = tit-ap.serie
         and   mov-ap.cod-esp       = tit-ap.cod-esp
         and   mov-ap.nr-docto      = tit-ap.nr-docto
         and   mov-ap.parcela       = tit-ap.parcela
         and   mov-ap.transacao     = 1 
         no-error.

    if  avail mov-ap AND mov-ap.fornec-ant <> 0 then
        assign i-fornec = mov-ap.fornec-ant.
end.

find first dirf-ap
     where dirf-ap.ep-codigo  = tit-ap.ep-codigo
     and   dirf-ap.cod-fornec = i-fornec
     and   dirf-ap.cod-estab  = tit-ap.cod-estab
     and   dirf-ap.cod-esp    = tit-ap.cod-esp
     and   dirf-ap.serie      = tit-ap.serie
     and   dirf-ap.nr-docto   = tit-ap.nr-docto
     and   dirf-ap.parcela    = tit-ap.parcela
     no-lock no-error.

if  avail dirf-ap then
    next. 

/* Se a seleá∆o for de ANÔs ou Normais e j† existir impostos
   n∆o deve prosseguir */

if (l-normal = yes or l-antecipacao = yes) then do:

    /* Se o documento tiver imposto o mesmo j† ser† gerado para a DIRF,
       ent∆o, os documentos n∆o poder∆o ir para n∆o haver duplicidade */

    FIND FIRST mov-ap NO-LOCK
         where mov-ap.ep-codigo  = tit-ap.ep-codigo
         and   mov-ap.cod-estab  = tit-ap.cod-estab
         and   mov-ap.docto-ant  = tit-ap.nr-docto
         and   mov-ap.parc-ant   = tit-ap.parcela
         and   mov-ap.esp-ant    = tit-ap.cod-esp 
         and   mov-ap.fornec-ant = tit-ap.cod-fornec
         and   mov-ap.serie-ant  = tit-ap.serie
         and   mov-ap.transacao  = 1
         AND   mov-ap.tipo       = 8
         NO-ERROR.

    IF  AVAIL mov-ap THEN
        NEXT dirf_block.
end.

/* fim de Include */

