/*****************************************************************************
**
**   AP1002.I5
**   Objetivo:  Atualizacao do Movimento Pendente
**
******************************************************************************/
if l-suspenso = no then do:

    find first doc-b-ap
         where doc-b-ap.ep-codigo  = tt-param.i-empresa
         and   doc-b-ap.referencia = tt-param.c-referencia 
         exclusive-lock no-error.

    if  avail doc-b-ap then do:
        assign doc-b-ap.total-movto  = de-tot-baixa
               doc-b-ap.data-movto   = da-data
               doc-b-ap.cod-esp      = c-cod-esp
               doc-b-ap.cod-estabel  = c-cod-estabel
               doc-b-ap.log-2        = no
               r-registro            = rowid(doc-b-ap).                

        for each tt-retorno-lin-b-ap exclusive-lock:
            delete tt-retorno-lin-b-ap.
        end.       

        run app/ap0505j.p (input r-registro,
                           output table tt-retorno-lin-b-ap,
                           input 2).

        /*--- Erros Integra‡äes ---*/
        find first tt-erro no-error.
        if  avail tt-erro then do:

            page.
            put skip(1).

            {utp/ut-liter.i ERROS_NAS_INTEGRA€åES_DURANTE_ATUALIZA€ÇO}
            assign c-integracao = trim(return-value).

            disp c-integracao with width 132 no-box no-label stream-io frame f-consistencia.
            put skip(2).

            for each tt-erro:

                assign c-mensagem-cb = tt-erro.mensagem.

                disp tt-erro.cd-erro
                     c-mensagem-cb
                     with frame f-consiste.
                down with frame f-consiste.

                delete tt-erro.

            end.        
        end.

        find first tt-retorno-lin-b-ap no-lock no-error.
        if  avail tt-retorno-lin-b-ap then do:

            page.

            for each tt-retorno-lin-b-ap
                    by entry(1, tt-retorno-lin-b-ap.cod-chave, ",")
                    by entry(2, tt-retorno-lin-b-ap.cod-chave, ","):
                    disp entry(1, tt-retorno-lin-b-ap.cod-chave, ",") @ lin-b-ap.referencia
                         entry(2, tt-retorno-lin-b-ap.cod-chave, ",") @ lin-b-ap.sequencia
                         entry(4, tt-retorno-lin-b-ap.cod-chave, ",") @ lin-b-ap.cod-estabel
                         entry(5, tt-retorno-lin-b-ap.cod-chave, ",") @ lin-b-ap.cod-esp
                         entry(6, tt-retorno-lin-b-ap.cod-chave, ",") @ lin-b-ap.serie
                         entry(7, tt-retorno-lin-b-ap.cod-chave, ",") @ lin-b-ap.nr-docto
                         entry(8, tt-retorno-lin-b-ap.cod-chave, ",") @ lin-b-ap.parcela
                         entry(9, tt-retorno-lin-b-ap.cod-chave, ",") @ lin-b-ap.cod-fornec
                         tt-retorno-lin-b-ap.cod-erro
                         tt-retorno-lin-b-ap.desc-erro
                         with frame f-retorno.
                    down with frame f-retorno.
            end.

            run utp/ut-msgs.p (input "msg",
                               input 8216,
                               input "").

            assign c-msg-atual = return-value + "!".
            disp c-msg-atual with frame f-erro-atual.


            for each lin-b-ap of doc-b-ap exclusive-lock :
                if avail tt-param
                and  tt-param.l-mant-refer = no then
                    delete lin-b-ap.
            end.                
            if avail tt-param 
            and tt-param.l-mant-refer = no then
                delete doc-b-ap.
        end.            
    end.
end.
else do:

       run utp/ut-msgs.p (input "msg",
                               input 30225,
                               input lin-b-ap.referencia).


            assign c-msg-atual = "Erro 30225" + " " + return-value.
            disp c-msg-atual with frame f-erro-atual.
end.            


/* Fim de Include */

