/*******************************************************************************
**
**  Include.: AP0706.I4
**  Objetivo: ImpressÆo da parametriza‡Æo utilizada no relat¢rio
**
*******************************************************************************/

{app/ap0501.i}   /* Miniflexibiliza‡Æo */

{utp/ut-liter.i SELE€ÇO * R}
assign c-text-6 = trim(return-value).
{utp/ut-liter.i CLASSIFICA€ÇO * R}
assign c-text-7 = trim(return-value).
{utp/ut-liter.i PAR¶METROS * R}
assign c-text-8 = trim(return-value).
{utp/ut-liter.i IMPRESSÇO * R}
assign c-text-9 = trim(return-value).

{utp/ut-field.i mgadm mov-ap cod-estabel 1}
assign tt-param.estab-ini:label in frame f-parametros = return-value.
{utp/ut-field.i mgadm mov-ap cod-esp 1}
assign tt-param.espec-ini:label in frame f-parametros = return-value.
{utp/ut-field.i mgadm emitente cod-gr-forn 1}
assign tt-param.grp-forn-ini:label in frame f-parametros = return-value.
{utp/ut-field.i mgadm mov-ap cod-fornec 1}
assign tt-param.fornec-ini:label in frame f-parametros = return-value.
{utp/ut-field.i mgadm tit-ap matriz 1}
assign tt-param.matriz-ini:label in frame f-parametros = return-value.
{utp/ut-field.i mgadm mov-ap dt-transacao 1}
assign tt-param.dt-transac-ini:label in frame f-parametros = return-value.
{utp/ut-liter.i Data_ConversÆo * L}
assign tt-param.da-conversao:label in frame f-parametros = trim(return-value).
/* Carlos - src12112 - Controle de VersÆo - Tratamento de Provisäes */
if l-provisao then do:
    {utp/ut-liter.i Previsäes_/_Provisäes_para_Perfil_de_Compras * L}
    assign tt-param.l-prev-perfil:label in frame f-parametros = trim(return-value).
    {utp/ut-liter.i Previsäes_/_Provisäes_nos_Saldos * L}
    assign tt-param.l-prev-saldo:label in frame f-parametros = trim(return-value).
end.
else do:
    {utp/ut-liter.i Previsäes_para_Perfil_de_Compras * L}
    assign tt-param.l-prev-perfil:label in frame f-parametros = trim(return-value).
    {utp/ut-liter.i Previsäes_nos_Saldos * L}
    assign tt-param.l-prev-saldo:label in frame f-parametros = trim(return-value).
end.
/* ---------------------------------------------------------------- */
{utp/ut-liter.i RazÆo_em_Fichas * L}
assign tt-param.l-ficha:label in frame f-parametros = trim(return-value).
{utp/ut-liter.i Somente_Esp‚cies_Cont beis * L}
assign tt-param.l-espec-ctbl:label in frame f-parametros = trim(return-value).
{utp/ut-liter.i Calc_Atraso_M‚dio * L}
assign c-atraso:label in frame f-parametros = trim(return-value).
{utp/ut-liter.i Tipo_Moeda * L}
assign c-moeda:label in frame f-parametros = trim(return-value).
{utp/ut-liter.i Tipo_EmissÆo * L}
assign c-tipo-rel:label in frame f-parametros = trim(return-value).

if  tt-param.atraso-medio = 1 then {utp/ut-liter.i Todos * L} else {utp/ut-liter.i Atrasados * L}.
assign c-atraso = trim(return-value).
if  tt-param.tp-moeda = 1 then {utp/ut-liter.i Normal * L} else {utp/ut-liter.i FASB * L}.
assign c-moeda = trim(return-value).
if  tt-param.tipo = 1 then {utp/ut-liter.i Detalhado * L} else {utp/ut-liter.i Resumido * L}.
assign c-tipo-rel = trim(return-value).

{utp/ut-liter.i Usu rio * L}
assign tt-param.usuario:label in frame f-parametros = trim(return-value).
{utp/ut-liter.i Destino * L}
assign c-destino:label in frame f-parametros = trim(return-value)
       c-destino = {varinc/var00002.i 04 tt-param.destino}.

if  page-number > 0 then page.
display c-text-6
        tt-param.estab-ini
        tt-param.estab-fim
        tt-param.espec-ini
        tt-param.espec-fim
        tt-param.grp-forn-ini
        tt-param.grp-forn-fim
        tt-param.fornec-ini
        tt-param.fornec-fim
        tt-param.matriz-ini
        tt-param.matriz-fim
        tt-param.dt-transac-ini
        tt-param.dt-transac-fim
        c-text-7
        tt-param.text-classif
        c-text-8
        tt-param.moeda
        tt-param.da-conversao
        c-atraso
        c-moeda
        c-tipo-rel
        c-text-9
        c-destino
        tt-param.arquivo
        tt-param.usuario
        with frame f-parametros.

do  with frame f-parametros:
    if  tt-param.l-prev-perfil = yes then {utp/ut-liter.i Sim * R} else {utp/ut-liter.i NÆo * R}.
    disp trim(return-value) @ tt-param.l-prev-perfil.
    if  tt-param.l-prev-saldo = yes then {utp/ut-liter.i Sim * R} else {utp/ut-liter.i NÆo * R}.
    disp trim(return-value) @ tt-param.l-prev-saldo.
    if  tt-param.l-ficha = yes then {utp/ut-liter.i Sim * R} else {utp/ut-liter.i NÆo * R}.
    disp trim(return-value) @ tt-param.l-ficha.
    if  tt-param.l-espec-ctbl = yes then {utp/ut-liter.i Sim * R} else {utp/ut-liter.i NÆo * R}.
    disp trim(return-value) @ tt-param.l-espec-ctbl.
end.

down with frame f-parametros.

/* AP0706.I4 */
