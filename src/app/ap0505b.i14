/****************************************************************************
***
*** app/ap0505b.i14 - Impostos de reten‡Æo de iva.
***
****************************************************************************/

if  avail tit-ap then do:
    for each  impto-tit-ap use-index codigo
        where impto-tit-ap.ep-codigo    = tit-ap.ep-codigo
        and   impto-tit-ap.cod-estabel  = tit-ap.cod-estabel
        and   impto-tit-ap.cod-esp      = tit-ap.cod-esp
        and   impto-tit-ap.serie        = tit-ap.serie
        and   impto-tit-ap.nr-docto     = tit-ap.nr-docto
        and   impto-tit-ap.parcela      = tit-ap.parcela
        and   impto-tit-ap.cod-fornec   = tit-ap.cod-fornec
        and   impto-tit-ap.origem-impto = 1 /* Implanta‡Æo */
        and   impto-tit-ap.tipo         = 2:
        
        find tipo-tax
            where tipo-tax.cod-tax = impto-tit-ap.cod-imposto
            no-lock no-error.
            
        if  not avail tipo-tax then
            next.
        
        if  tipo-tax.perc-retencao = 0 then
            next.
            
        if  tipo-tax.ind-data-base-ret = 2 /* retencao na implanta‡Æo */ then
            next.
                  
        assign de-vl-base = (impto-tit-ap.vl-base * lin-b-ap.vl-baixa)
                          /  tit-ap.vl-original.
                             
        create impto-tit-pend-ap.
        assign impto-tit-pend-ap.ep-codigo           = impto-tit-ap.ep-codigo
               impto-tit-pend-ap.cod-est             = impto-tit-ap.cod-est
               impto-tit-pend-ap.cod-esp             = impto-tit-ap.cod-esp
               impto-tit-pend-ap.serie               = impto-tit-ap.serie
               impto-tit-pend-ap.cod-fornec          = impto-tit-ap.cod-fornec
               impto-tit-pend-ap.nr-docto            = impto-tit-ap.nr-docto
               impto-tit-pend-ap.parcela             = impto-tit-ap.parcela
               impto-tit-pend-ap.cod-imposto         = impto-tit-ap.cod-imposto
               impto-tit-pend-ap.dt-emissao          = lin-b-ap.dt-baixa
               impto-tit-pend-ap.dt-transacao        = lin-b-ap.dt-baixa
               impto-tit-pend-ap.origem-impto        = {1}
               impto-tit-pend-ap.trans-impto-ap      = {2}
               impto-tit-pend-ap.tipo                = {3}
               impto-tit-pend-ap.cod-classificacao   = impto-tit-ap.cod-classificacao
               impto-tit-pend-ap.contabilizou        = no
               impto-tit-pend-ap.ind-data-base       = impto-tit-ap.ind-data-base
               impto-tit-pend-ap.lancamento          = {4}
               impto-tit-pend-ap.conta-retencao      = tipo-tax.conta-retencao
               impto-tit-pend-ap.perc-retencao       = tipo-tax.perc-retencao
               impto-tit-pend-ap.vl-base             = de-vl-base
               impto-tit-pend-ap.vl-base-me          = if  lin-b-ap.mo-codigo <> 0 then 
                                                           de-vl-base * lin-b-ap.cotacao-dia
                                                       else
                                                           de-vl-base.

        find last  b-impto-tit-pend-ap use-index codigo
             where b-impto-tit-pend-ap.ep-codigo     = tit-ap.ep-codigo
             and   b-impto-tit-pend-ap.cod-estabel   = tit-ap.cod-estabel
             and   b-impto-tit-pend-ap.cod-esp       = tit-ap.cod-esp
             and   b-impto-tit-pend-ap.serie         = tit-ap.serie
             and   b-impto-tit-pend-ap.nr-docto      = tit-ap.nr-docto
             and   b-impto-tit-pend-ap.parcela       = tit-ap.parcela
             and   b-impto-tit-pend-ap.cod-fornec    = tit-ap.cod-fornec
             no-error.                    

        if  avail b-impto-tit-pend-ap then do:
            assign impto-tit-pend-ap.num-seq-impto = b-impto-tit-pend-ap.num-seq-impto + 10.
        end.
        else do:
            assign impto-tit-pend-ap.num-seq-impto = 10.
        end.

        find conta-contab
            where conta-contab.ep-codigo      = impto-tit-ap.ep-codigo
            and   conta-contab.conta-contabil = tipo-tax.conta-retencao
            no-lock no-error.
            
        if  avail conta-contab then     
            assign impto-tit-pend-ap.ct-retencao = conta-contab.ct-codigo
                   impto-tit-pend-ap.sc-retencao = conta-contab.sc-codigo.
                   
        assign impto-tit-pend-ap.vl-retencao = (de-vl-base * tipo-tax.perc-retencao) 
                                             / 100.
  
        if  lin-b-ap.mo-codigo = 0 then
            assign impto-tit-pend-ap.vl-retencao-me = impto-tit-pend-ap.vl-retencao.
        else
            assign impto-tit-pend-ap.vl-retencao-me = impto-tit-pend-ap.vl-retencao * lin-b-ap.cotacao-dia.            

        assign lin-b-ap.dec-1 = lin-b-ap.dec-1 + impto-tit-pend-ap.vl-retencao
               lin-b-ap.dec-2 = lin-b-ap.dec-2 + impto-tit-pend-ap.vl-retencao-me.
    end.
end.
               
                  
        
