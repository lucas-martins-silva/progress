/**************************************************************************
**
**  Include.: AP0704.I5
**  Objetivo: Display dos titulos
**
*************************************************************************/

if  first-of(tit-ap.cod-estabel) then do:
    if  not first(tit-ap.cod-estabel)
    and tt-param.detal-resum = 1 then
        page.

    find estabelec
         where estabelec.cod-estabel = tit-ap.cod-estabel no-lock no-error.
    if  avail estabelec then
        if  tt-param.detal-resum = 1 then do:
            disp tit-ap.cod-estabel
                 estabelec.nome with frame f-estabel.
        end.                                      
end.

    if  tit-ap.tipo   <> 2 then do:   /*AN*/

        if  tt-param.data-faixa = 1 then do:

           mov-block:
           for each mov-ap use-index codigo
              where mov-ap.ep-codigo   = tit-ap.ep-codigo
                and mov-ap.cod-estabel = tit-ap.cod-estabel
                and mov-ap.cod-esp     = tit-ap.cod-esp
                and mov-ap.serie       = tit-ap.serie
                and mov-ap.nr-docto    = tit-ap.nr-docto
                and mov-ap.parcela     = tit-ap.parcela
                and mov-ap.cod-fornec  = tit-ap.cod-fornec no-lock:

                {app/ap9999.i2 "mov-ap"
                               "tt-param.moeda"
                               "tit-ap"}

                if  mov-ap.transacao <> 2 /*BND*/
                and mov-ap.transacao <> 3 /*PEF*/
                and mov-ap.transacao <> 5 /*AVA*/
                and mov-ap.transacao <> 6 /*SND*/
                and mov-ap.transacao <> 8 then /*GPF*/
                    next.

                if  mov-ap.transacao = 6 and mov-ap.lancamento <> 1 /*D*/ then
                    next.

                assign de-vl-mov-fasb = mov-ap.vl-mov-fasb.

                if  mov-ap.dt-transacao > tt-param.da-data then
                    if  mov-ap.transacao = 5 /*AVA*/ and mov-ap.lancamento = 1 then /*D*/
                        if  tt-param.normal-fasb = 1 then
                            assign de-saldo = de-saldo - de-calc-valor-mov.
                        else 
                            assign de-saldo = de-saldo - mov-ap.vl-mov-fasb.
                    else
                        if  mov-ap.transacao = 5 /*AVA*/ and mov-ap.lancamento = 2 then  /*C*/
                            if  tt-param.normal-fasb = 1 then
                                assign de-saldo = de-saldo + de-calc-valor-mov.
                            else 
                                assign de-saldo = de-saldo + mov-ap.vl-mov-fasb.
                        else
                            if  mov-ap.transacao = 8 then  /*GPF*/
                                if tt-param.normal-fasb = 2 then
                                   assign de-saldo = de-saldo + (mov-ap.valor-mov + mov-ap.valor-juros).
                                else
                                   assign de-saldo = de-saldo.
                            else
                                if  tt-param.normal-fasb = 1 then
                                    assign de-saldo = de-saldo + de-calc-valor-mov.
                                 else 
                                    assign de-saldo = de-saldo + de-vl-mov-fasb.
            end.
        end.

        if  de-saldo > 0 then do:
            if  tit-ap.tipo = 1 /*NO*/
            or  tit-ap.tipo = 8 then /*IR*/ do:
                if   (tt-param.desconto    = yes) 
                and  (tt-param.normal-fasb = 1) 
                and ((tit-ap.dt-desconto  >= tt-param.da-data 
                and   tt-param.data-faixa  = 1)
                or   (tit-ap.dt-desconto  >= tt-param.da-venc-fim 
                and   tt-param.data-faixa  = 2)) then do:

                    assign de-calc-vl-desconto = tit-ap.vl-desconto.

                    if  tt-param.moeda <> 0 then do:
                        if  tt-param.moeda = tit-ap.moeda then
                            assign de-calc-vl-desconto = tit-ap.vl-desconto-me.
                        else
                            assign de-calc-vl-desconto = tit-ap.vl-desconto.
                    end.

                    assign de-saldo = de-saldo - de-calc-vl-desconto.
                end.

                assign de-tot-nor  = de-tot-nor + de-original
                       de-tot-nor1 = de-tot-nor1 + de-saldo
                       c-tip       = c-credito
                       c-tip1      = c-credito.
            end.
            if  tit-ap.tipo = 3 then     /*PR*/
                assign de-tot-pre  = de-tot-pre + de-original
                       de-tot-pre1 = de-tot-pre1 + de-saldo
                       c-tpo       = c-credito
                       c-tpo1      = c-credito.

            /* Carlos - src12112 - Tratamento de Provisäes */
            if tit-ap.tipo = 10 then   /*PRO*/
                assign de-tot-pro  = de-tot-pro  + de-original
                       de-tot-pro1 = de-tot-pro1 + de-saldo
                       c-tpro      = c-credito
                       c-tpro1     = c-credito.
            /* ------------------------------------------- */

            assign c-dbcr     = c-credito
                   c-dbcr1    = c-credito
                   de-normal  = de-normal  + de-original
                   de-normal1 = de-normal1 + de-saldo.
        end.
    end.
    else do:
        if tt-param.data-faixa = 1 then do:
           mov-block:
           for each mov-ap use-index ch-antecip
              where mov-ap.ep-codigo    = tit-ap.ep-codigo
                and mov-ap.cod-estabel  = tit-ap.cod-estabel
                and mov-ap.esp-ant      = tit-ap.cod-esp
                and mov-ap.serie-ant    = tit-ap.serie
                and mov-ap.docto-ant    = tit-ap.nr-docto
                and mov-ap.parc-ant     = tit-ap.parcela
                and mov-ap.fornec-ant   = tit-ap.cod-fornec
                and ((mov-ap.vl-antecip > 0 and tt-param.normal-fasb = 1)
                or  (mov-ap.vl-ant-fasb > 0 and tt-param.normal-fasb = 2)) no-lock:


                {app/ap9999.i2 "mov-ap"
                               "tt-param.moeda"
                               "tit-ap"}

                if  mov-ap.transacao <> 2  /*BND*/
                and mov-ap.transacao <> 3  /*PEF*/
                and mov-ap.transacao <> 8 then next.   /*GPF*/

                assign de-vl-ant-fasb = mov-ap.vl-mov-fasb.
                if   mov-ap.dt-trans  > tt-param.da-data 
                and (mov-ap.transacao = 2 
                or   mov-ap.transacao = 3) then
                    if  tt-param.normal-fasb = 1 then
                        assign de-saldo = de-saldo + de-calc-vl-antecip.
                    else 
                        assign de-saldo = de-saldo + de-vl-ant-fasb.

                if  mov-ap.dt-trans      > tt-param.da-data
                and mov-ap.transacao     = 8   /*GPF*/ 
                and tt-param.normal-fasb = 2 then
                    assign de-saldo = de-saldo + (mov-ap.valor-mov + mov-ap.valor-juros).
            end.
            mov-block:
            for each mov-ap use-index codigo
              where mov-ap.ep-codigo  = tit-ap.ep-codigo
                and mov-ap.cod-est    = tit-ap.cod-est
                and mov-ap.cod-esp    = tit-ap.cod-esp
                and mov-ap.serie      = tit-ap.serie
                and mov-ap.nr-docto   = tit-ap.nr-docto
                and mov-ap.parcela    = tit-ap.parcela
                and mov-ap.cod-fornec = tit-ap.cod-fornec
                and (mov-ap.transacao = 5  /*AVA*/
                or  mov-ap.transacao  = 3  /*PEF*/
                or  mov-ap.transacao  = 8) no-lock:    /*GPF*/

                {app/ap9999.i2 "mov-ap"
                               "tt-param.moeda"
                               "tit-ap"}

                assign de-vl-ant-fasb = mov-ap.vl-mov-fasb.
                if  mov-ap.transacao = 5 
                and mov-ap.dt-trans  > tt-param.da-data then
                    if  mov-ap.lancamento = 1 then
                        if  tt-param.normal-fasb = 1 then
                            assign de-saldo = de-saldo + de-calc-valor-mov.
                        else 
                            assign de-saldo = de-saldo + de-vl-ant-fasb.
                    else   
                        if  tt-param.normal-fasb = 1 then
                            assign de-saldo = de-saldo - de-calc-valor-mov.
                        else 
                            assign de-saldo = de-saldo - de-vl-ant-fasb. 

                if  mov-ap.transacao = 3  /*PEF*/
                and mov-ap.dt-trans > tt-param.da-data and tt-param.normal-fasb = 2 then do:
                    assign de-vl-ant-fasb = mov-ap.vl-mov-fasb.
                    assign de-saldo = de-saldo + de-vl-ant-fasb.
                end.
                if   mov-ap.transacao = 8    /*GPF*/
                and  mov-ap.dt-trans > tt-param.da-data and  tt-param.normal-fasb = 2 then
                     assign de-saldo = de-saldo - (mov-ap.valor-mov + mov-ap.valor-juros).
            end.
        end.
        if  de-saldo > 0 then
            if  tit-ap.tipo = 2 then    /*AN*/
                assign c-dbcr      = c-debito
                       c-dbcr1     = c-debito
                       c-tp1       = c-debito
                       c-tp        = c-debito
                       de-antec    = de-antec    + de-original
                       de-antec1   = de-antec1   + de-saldo
                       de-tot-ant  = de-tot-ant  + de-original
                       de-tot-ant1 = de-tot-ant1 + de-saldo
                       de-gerant   = de-gerant   + de-original
                       de-gerant1  = de-gerant1  + de-saldo.
    end.

    /*-- Calcula RESUMO --*/
    if  de-saldo <> 0 then
       if tit-ap.tipo <> 2 then   
           {app/ap0704.i6 "+"}  /* Acumula totais - documentos normais */
      
    /* *************  187465 *******************
     *  else do:
     *     {app/ap0704.i6 "-"} /* Desconta as Antecipacoes */
     *  end.
     * *****************************************/

    if  de-saldo > 0 then do:
        assign l-emitiu = yes.
        if  tt-param.detal-resum = 1 then
            disp tit-ap.cod-fornec
                 tit-ap.nome-abrev
                 tit-ap.cod-estabel
                 tit-ap.referencia
                 tit-ap.cod-esp
                 tit-ap.serie
                 tit-ap.nr-docto
                 tit-ap.parcela
                 tit-ap.portador
                 tit-ap.dt-emissao
                 tit-ap.dt-vencimen
                 de-original
                 c-dbcr
                 de-saldo
                 c-dbcr1
                 tit-ap.estado when tit-ap.estado > 0
                 with frame f-item4.
        down with frame f-item4.
        if  (tt-param.lista-hist-prev and tit-ap.tipo = 3)  /*PR*/
        or  (tt-param.lista-hist-doctos and tit-ap.tipo <> 3)  /*PR*/
        or  (tt-param.lista-hist-prev and tt-param.lista-hist-doctos)
            then do:
            find first mov-ap use-index codigo
                where mov-ap.ep-codigo    = tit-ap.ep-codigo
                  and mov-ap.cod-estabel  = tit-ap.cod-estabel
                  and mov-ap.cod-esp      = tit-ap.cod-esp
                  and mov-ap.serie        = tit-ap.serie
                  and mov-ap.nr-docto     = tit-ap.nr-docto
                  and mov-ap.parcela      = tit-ap.parcela
                  and mov-ap.cod-fornec   = tit-ap.cod-fornec
                  and (mov-ap.transacao   = 1 or mov-ap.transacao = 6)   
                  no-lock no-error.
            if  avail mov-ap then
                if  mov-ap.historico <> "" then do:
                    if  tt-param.detal-resum = 1 then 
                        disp mov-ap.historico
                             with frame f-historico.
                end.
        end.
    end.
    if  last-of(tit-ap.cod-estabel)
    and l-emitiu = yes then do:
        assign l-emitiu = no.
        if  de-normal > de-antec then
            assign de-tot-mes  = de-normal - de-antec
                   de-tot-mes2 = de-tot-mes2 + de-tot-mes
                   c-tipo      = c-credito
                   c-tipo1     = c-credito.
        else
            if  de-normal < de-antec then
                assign de-tot-mes  = de-antec - de-normal
                       de-tot-mes2 = de-tot-mes2 + de-tot-mes
                       c-tipo      = c-debito
                       c-tipo1     = c-debito.
            else
                if  de-normal = de-antec then
                    assign de-tot-mes = 0
                           c-tipo     = ""
                           c-tipo1    = "".

        if  de-normal1 > de-antec1 then
            assign de-tot-mes1 = de-normal1 - de-antec1
                   de-tot-mes3 = de-tot-mes3 + de-tot-mes1
                   c-tipo      = c-credito
                   c-tipo1     = c-credito.
        else
            if  de-normal1 < de-antec1 then
                assign de-tot-mes1 = de-antec1 - de-normal1
                       de-tot-mes3 = de-tot-mes3 + de-tot-mes1
                       c-tipo      = c-debito
                       c-tipo1     = c-debito.
            else
                if  de-normal1 = de-antec1 then
                    assign de-tot-mes1 = 0
                           c-tipo      = ""
                           c-tipo1     = "".

        if  tt-param.detal-resum = 1 then 
            disp c-estabel   
                 de-tot-mes  
                 c-tipo
                 de-tot-mes1 
                 c-tipo1 
                 with frame f-tot-estabel.
        assign de-tot-mes   = 0
               de-tot-mes1  = 0
               de-normal    = 0
               de-normal1   = 0
               de-antec     = 0
               de-antec1    = 0
               de-pest-30   = if de-est-tot = 0 then 0 else
                              de-est-30  / de-est-tot * 100
               de-pest-60   = if de-est-tot = 0 then 0 else
                              de-est-60  / de-est-tot * 100
               de-pest-90   = if de-est-tot = 0 then 0 else
                              de-est-90  / de-est-tot * 100
               de-pest-120  = if de-est-tot = 0 then 0 else
                              de-est-120 / de-est-tot * 100
               de-pest-999  = if de-est-tot = 0 then 0 else
                              de-est-999 / de-est-tot * 100
               de-pest-tot  = 100
               de-pest1-30  = if de-est1-tot = 0 then 0 else
                              de-est1-30  / de-est1-tot * 100
               de-pest1-60  = if de-est1-tot = 0 then 0 else
                              de-est1-60  / de-est1-tot * 100
               de-pest1-90  = if de-est1-tot = 0 then 0 else
                              de-est1-90  / de-est1-tot * 100
               de-pest1-120 = if de-est1-tot = 0 then 0 else
                              de-est1-120 / de-est1-tot * 100
               de-pest1-999 = if de-est1-tot = 0 then 0 else
                              de-est1-999 / de-est1-tot * 100
               de-pest1-tot = 100.
/*este trecho foi transferido para o ap0704rp.p*/
        /*if  tt-param.detal-resum = 1 then do:
            page.
            put skip (5).
            if de-est-30 < 0 and de-est-tot < 0 then
               assign de-est-30   = de-est-30   * (-1)
                      de-est-tot  = de-est-tot  * (-1).
            disp c-vencidos01
                 c-vencidos02
                 c-vencidos03
                 c-vencidos04
                 c-vencidos05
                 c-vencidos06
                 c-vencidos07
                 de-est-30
                 de-est-60
                 de-est-90
                 de-est-120
                 de-est-999
                 de-est-tot
                 de-pest-30
                 de-pest-60
                 de-pest-90
                 de-pest-120
                 de-pest-999
                 de-est-tot
                 de-pest-tot
                 with frame f-venc-est.
            put skip(8).
            disp c-vencer01
                 c-vencidos02
                 c-vencidos03
                 c-vencidos04
                 c-vencidos05
                 c-vencidos06
                 c-vencidos07
                 de-est1-30
                 de-est1-60
                 de-est1-90
                 de-est1-120
                 de-est1-999
                 de-est1-tot
                 de-pest1-30
                 de-pest1-60
                 de-pest1-90
                 de-pest1-120
                 de-pest1-999
                 de-pest1-tot
                 with frame f-vencer-est.
        end.
        assign de-est-30    = 0
               de-est-60    = 0
               de-est-90    = 0
               de-est-120   = 0
               de-est-999   = 0
               de-est-tot   = 0
               de-est1-30   = 0
               de-est1-60   = 0
               de-est1-90   = 0
               de-est1-120  = 0
               de-est1-999  = 0
               de-est1-tot  = 0
               de-pest-30   = 0
               de-pest-60   = 0
               de-pest-90   = 0
               de-pest-120  = 0
               de-pest-999  = 0
               de-pest-tot  = 0
               de-pest1-30  = 0
               de-pest1-60  = 0
               de-pest1-90  = 0
               de-pest1-120 = 0
               de-pest1-999 = 0
               de-pest1-tot = 0.
        if  tt-param.detal-resum = 1 then
            page.*/
    end.

/* AP0704.I5 */
