/******************************************************************************
***
*** app/ap0001.i2 - Atualiza num-id tabela usuar-autoriza-tit.
***
******************************************************************************/

assign i-sequencia = 1.

repeat:
    find first b-usuar-autoriza-tit use-index codigo
         where b-usuar-autoriza-tit.ep-codigo        = usuar-autoriza-tit.ep-codigo
         and   b-usuar-autoriza-tit.nr-bordero       = 0
         and   b-usuar-autoriza-tit.cod-portador     = 0
         and   b-usuar-autoriza-tit.cod-estabel      = usuar-autoriza-tit.cod-estabel
         and   b-usuar-autoriza-tit.cod-fornec       = usuar-autoriza-tit.cod-fornec
         and   b-usuar-autoriza-tit.cod-esp          = usuar-autoriza-tit.cod-esp
         and   b-usuar-autoriza-tit.serie            = usuar-autoriza-tit.serie
         and   b-usuar-autoriza-tit.nr-docto         = usuar-autoriza-tit.nr-docto
         and   b-usuar-autoriza-tit.parcela          = usuar-autoriza-tit.parcela
         and   b-usuar-autoriza-tit.num-id-autoriza  = i-sequencia
         no-lock no-error.
        
    if  avail b-usuar-autoriza-tit then
        assign i-sequencia = i-sequencia + 1.
    else 
        leave.
        
end.

assign usuar-autoriza-tit.num-id-autoriza = i-sequencia.

/* Fim de Include */


