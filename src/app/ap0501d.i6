/******************************************************************************
***
***  app/ap0501d.i6 - Valida‡Æo Casas Decimais Moeda - l-pre-ap.
***
******************************************************************************/

/* Verifica Decimais para vl-previsao */
assign l-rejeita-dec  = no.
assign de-tt-valor-valida = fn_vld_ajust_dec(l-pre-ap.vl-previsao,0).
if  l-rejeita-dec then do:
    {utp/ut-field.i mgadm l-pre-ap vl-previsao 1}
    run utp/ut-msgs.p(input "help", 
                      input 18130, 
                      input trim(return-value)).
    assign l-situacao = no
           i-num-erro = 18130
           c-cod-msg  = string(lin-i-ap.ep-codigo)  + " , " +
                        string(lin-i-ap.referencia) + " , " +
                        string(lin-i-ap.sequencia)  + " , " +
                        string(lin-i-ap.seq-import).       
    {app/ap0501d.i "18130"}
end.

/* Verifica Decimais para vl-previsao-me */
assign l-rejeita-dec  = no.
assign de-tt-valor-valida = fn_vld_ajust_dec(l-pre-ap.vl-previsao-me, l-pre-ap.moeda-pre).
if  l-rejeita-dec then do:
    {utp/ut-field.i mgadm l-pre-ap vl-previsao-me 1}
    run utp/ut-msgs.p(input "help", 
                      input 18130, 
                      input trim(return-value)).
    assign l-situacao = no
           i-num-erro = 18130
           c-cod-msg  = string(lin-i-ap.ep-codigo)  + " , " +
                        string(lin-i-ap.referencia) + " , " +
                        string(lin-i-ap.sequencia)  + " , " +
                        string(lin-i-ap.seq-import).       
    {app/ap0501d.i "18130"}
end.
