/******************************************************************************
*** 
*** app/ap0504c.i2 - pi-cria-nota-dup.
*** 
******************************************************************************/

for each tt-duplicata no-lock:              
    create nota-dup.
    assign nota-dup.ep-codigo-n     = tt-digita-escolhe.tt-ep-codigo
           nota-dup.cod-estabel-n   = tt-digita-escolhe.tt-cod-est
           nota-dup.serie-n         = tt-digita-escolhe.tt-serie
           nota-dup.cod-esp-n       = tt-digita-escolhe.tt-cod-esp
           nota-dup.nr-docto-n      = tt-digita-escolhe.tt-nr-docto
           nota-dup.parcela-n       = tt-digita-escolhe.tt-parcela
           nota-dup.cod-fornec      = tt-digita-escolhe.tt-cod-fornec
           nota-dup.referencia      = c-referencia
           nota-dup.dt-transacao    = da-dt-transacao
           nota-dup.cod-estabel-d   = tt-duplicata.tt-dup-cod-est
           nota-dup.serie-d         = tt-duplicata.tt-dup-serie
           nota-dup.cod-esp-d       = tt-duplicata.tt-dup-cod-esp
           nota-dup.nr-docto-d      = tt-duplicata.tt-dup-nr-docto
           nota-dup.parcela-d       = tt-duplicata.tt-dup-parcela
           nota-dup.fornec-dup      = tt-duplicata.tt-dup-cod-fornec.
    assign nota-dup.dec-1           = fn_ajust_dec(tt-digita-escolhe.tt-vl-saldo, fi-mo-codigo).          

    /*********** Multiplanta **************/  
    run pi-cria-tt-dados-nota (input 1).
    /**************************************/

end.

/* Fim de Include */
