/****************************************************************************
***
*** app/ap0586.i4 - Estorno Impostos referente Desconto/Juros.
***
*****************************************************************************/

for each impto-tit-ap use-index codigo
   where impto-tit-ap.ep-codigo    = tit-ap.ep-codigo
     and impto-tit-ap.cod-estabel  = tit-ap.cod-estabel
     and impto-tit-ap.cod-esp      = tit-ap.cod-esp
     and impto-tit-ap.serie        = tit-ap.serie
     and impto-tit-ap.nr-docto     = tit-ap.nr-docto
     and impto-tit-ap.parcela      = tit-ap.parcela
     and impto-tit-ap.cod-fornec   = tit-ap.cod-fornec
     and impto-tit-ap.origem-impto = 1 /* Implanta‡Æo */
     and impto-tit-ap.tipo         = 2:
          
    create impto-tit-pend-ap.
    assign impto-tit-pend-ap.ep-codigo           = impto-tit-ap.ep-codigo
           impto-tit-pend-ap.cod-est             = impto-tit-ap.cod-est
           impto-tit-pend-ap.cod-esp             = impto-tit-ap.cod-esp
           impto-tit-pend-ap.serie               = impto-tit-ap.serie
           impto-tit-pend-ap.cod-fornec          = impto-tit-ap.cod-fornec
           impto-tit-pend-ap.nr-docto            = impto-tit-ap.nr-docto
           impto-tit-pend-ap.parcela             = impto-tit-ap.parcela
           impto-tit-pend-ap.dt-emissao          = tt-param.dt-ref
           impto-tit-pend-ap.dt-transacao        = tt-param.dt-ref
           impto-tit-pend-ap.origem-impto        = {5}
           impto-tit-pend-ap.trans-impto-ap      = 2
           impto-tit-pend-ap.tipo                = 2
           impto-tit-pend-ap.contabilizou        = no
           impto-tit-pend-ap.ind-data-base       = impto-tit-ap.ind-data-base
           impto-tit-pend-ap.lancamento          = {1}
           impto-tit-pend-ap.conta-imposto       = impto-tit-ap.conta-imposto
           impto-tit-pend-ap.ct-imposto          = impto-tit-ap.ct-imposto
           impto-tit-pend-ap.sc-imposto          = impto-tit-ap.sc-imposto
           impto-tit-pend-ap.conta-percepcao     = impto-tit-ap.conta-percepcao
           impto-tit-pend-ap.ct-percepcao        = impto-tit-ap.ct-percepcao
           impto-tit-pend-ap.sc-percepcao        = impto-tit-ap.sc-percepcao
           impto-tit-pend-ap.conta-retencao      = impto-tit-ap.conta-retencao
           impto-tit-pend-ap.ct-retencao         = impto-tit-ap.ct-retencao
           impto-tit-pend-ap.sc-retencao         = impto-tit-ap.sc-retencao
           impto-tit-pend-ap.conta-iva-liberado  = impto-tit-ap.conta-iva-liberado
           impto-tit-pend-ap.ct-iva-liberado     = impto-tit-ap.ct-iva-liberado
           impto-tit-pend-ap.sc-iva-liberado     = impto-tit-ap.sc-iva-liberado.
                
    find last b-impto-tit-pend-ap use-index codigo
       where b-impto-tit-pend-ap.ep-codigo     = tit-ap.ep-codigo
         and b-impto-tit-pend-ap.cod-estabel   = tit-ap.cod-estabel
         and b-impto-tit-pend-ap.cod-esp       = tit-ap.cod-esp
         and b-impto-tit-pend-ap.serie         = tit-ap.serie
         and b-impto-tit-pend-ap.nr-docto      = tit-ap.nr-docto
         and b-impto-tit-pend-ap.parcela       = tit-ap.parcela
         and b-impto-tit-pend-ap.cod-fornec    = tit-ap.cod-fornec
       no-error.
                    
    if  avail b-impto-tit-pend-ap then do:
        assign impto-tit-pend-ap.num-seq-impto = b-impto-tit-pend-ap.num-seq-impto + 10.
    end.
    else do:
        assign impto-tit-pend-ap.num-seq-impto = 10.
    end.
                    
    assign impto-tit-pend-ap.mo-codigo           = impto-tit-ap.mo-codigo
           impto-tit-pend-ap.cotacao-dia         = impto-tit-ap.cotacao-dia
           impto-tit-pend-ap.cod-imposto         = impto-tit-ap.cod-imposto
           impto-tit-pend-ap.perc-imposto        = impto-tit-ap.perc-imposto
           impto-tit-pend-ap.perc-percepcao      = impto-tit-ap.perc-percepcao
           impto-tit-pend-ap.perc-retencao       = impto-tit-ap.perc-retencao
           impto-tit-pend-ap.perc-iva-liberado   = impto-tit-ap.perc-iva-liberado.
                 
    if  impto-tit-ap.mo-codigo = 0 then do:
        assign impto-tit-pend-ap.vl-base             = {2}
               impto-tit-pend-ap.vl-imposto          = ({2} * impto-tit-ap.perc-imposto) / 100
               impto-tit-pend-ap.vl-saldo-imposto    =  impto-tit-pend-ap.vl-imposto
               impto-tit-pend-ap.vl-percepcao        = (impto-tit-pend-ap.vl-imposto * (impto-tit-pend-ap.perc-percepcao / 100))
               impto-tit-pend-ap.vl-retencao         = (impto-tit-pend-ap.vl-imposto * (impto-tit-pend-ap.perc-retencao  / 100))
               impto-tit-pend-ap.vl-base-me          =  impto-tit-pend-ap.vl-base
               impto-tit-pend-ap.vl-imposto-me       =  impto-tit-pend-ap.vl-imposto
               impto-tit-pend-ap.vl-saldo-imposto-me =  impto-tit-pend-ap.vl-saldo-imposto
               impto-tit-pend-ap.vl-percepcao-me     =  impto-tit-pend-ap.vl-percepcao
               impto-tit-pend-ap.vl-retencao-me      =  impto-tit-pend-ap.vl-retencao
               impto-tit-pend-ap.vl-iva-liberado-me  =  impto-tit-pend-ap.vl-iva-liberado.
    end.
    else do:
        assign impto-tit-pend-ap.vl-base-me          =  {3}
               impto-tit-pend-ap.vl-imposto-me       =  ({3} * impto-tit-ap.perc-imposto) / 100
               impto-tit-pend-ap.vl-saldo-imposto-me =  impto-tit-pend-ap.vl-imposto-me
               impto-tit-pend-ap.vl-percepcao-me     = (impto-tit-pend-ap.vl-imposto-me       * (impto-tit-pend-ap.perc-percepcao / 100))
               impto-tit-pend-ap.vl-retencao-me      = (impto-tit-pend-ap.vl-imposto-me       * (impto-tit-pend-ap.perc-retencao  / 100))
               impto-tit-pend-ap.vl-iva-liberado     = (impto-tit-pend-ap.vl-iva-liberado     * (impto-tit-pend-ap.perc-iva-liberado / 100))
               impto-tit-pend-ap.vl-base             =  impto-tit-pend-ap.vl-base-me          *  impto-tit-ap.cotacao-dia
               impto-tit-pend-ap.vl-imposto          =  impto-tit-pend-ap.vl-imposto-me       *  impto-tit-ap.cotacao-dia
               impto-tit-pend-ap.vl-saldo-imposto    =  impto-tit-pend-ap.vl-saldo-imposto-me *  impto-tit-ap.cotacao-dia
               impto-tit-pend-ap.vl-percepcao        =  impto-tit-pend-ap.vl-percepcao-me     *  impto-tit-ap.cotacao-dia
               impto-tit-pend-ap.vl-retencao         =  impto-tit-pend-ap.vl-retencao-me      *  impto-tit-ap.cotacao-dia
               impto-tit-pend-ap.vl-iva-liberado     =  impto-tit-pend-ap.vl-iva-liberado     *  impto-tit-ap.cotacao-dia.
                        
       /* /*------ C lculo da Varia‡Æo Monet ria -------*/
 *         {app/ap0586.i5 {4}}*/
            
    end.
            
    assign impto-tit-pend-ap.obs = c-observacao.
                    
end.

/* Fim de Include */
