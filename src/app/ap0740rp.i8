/*******************************************************************************
***
*** app/ap0740rp.i8 - last-of(tt-tit-ap.moeda).
***
*******************************************************************************/

if  last-of(tt-tit-ap.moeda) then do:

    run pi-totais.

    run pi-tratar-resumo-total-geral.
        
    for each tt-resumo exclusive-lock:
        delete tt-resumo.
    end.

    assign de-tot-esp-saldo   = 0
           de-tot-esp-orig    = 0
           de-tot-ante-saldo  = 0
           de-tot-ante-orig   = 0
           de-tot-prev-saldo  = 0
           de-tot-prev-orig   = 0
           de-tot-prov-saldo  = 0
           de-tot-prov-orig   = 0
           de-tot-norm-saldo  = 0
           de-tot-norm-orig   = 0
           de-tot-mes-saldo   = 0
           de-tot-mes-orig    = 0
           de-tot-forn-saldo  = 0
           de-tot-forn-orig   = 0
           de-tot-geral-saldo = 0
           de-tot-geral-orig  = 0.
    
    page.
                        
end.

/* Fim de Include */
