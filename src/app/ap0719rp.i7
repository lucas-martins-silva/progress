
PROCEDURE pi-acumulado:
    do  i-mes = 1 to 12:
         assign t-dirf.rend-trib[i-mes] = t-dirf.rend-trib[i-mes]
                                        + dirf-apf.base-bruta[i-mes].
        if trim(dirf-apf.char-1) <> "" then do:
           assign t-dirf.rend-trib[i-mes] = t-dirf.rend-trib[i-mes]
                                          - dec(entry(i-mes,dirf-apf.char-1,";")).
        end.

        assign t-dirf.deducoes[i-mes]  = t-dirf.deducoes[i-mes]
                                       + (dirf-apf.ded-depend[i-mes]
                                       + dirf-apf.ded-pensao[i-mes]
                                       + dirf-apf.ded-inss[i-mes])
               t-dirf.imp-ret[i-mes]   = t-dirf.imp-ret[i-mes]
                                       + dirf-apf.valor-irrf[i-mes].
        if trim(dirf-apf.char-2) <> "" then do:
          assign  t-dirf.deducoes[i-mes] =  t-dirf.deducoes[i-mes]
                                       + dec(entry(i-mes,dirf-apf.char-2,";")).
        end.
        
        find t-dirf-deduc
             where t-dirf-deduc.cgc-decl    = t-dirf.cgc-decl    
             and   t-dirf-deduc.cod-ret     = t-dirf.cod-ret     
             and   t-dirf-deduc.esp-ben     = t-dirf.esp-ben     
             and   t-dirf-deduc.cgc-cpf-ben = t-dirf.cgc-cpf-ben 
             exclusive-lock no-error.
        
        if  not avail t-dirf-deduc then do:
            create t-dirf-deduc.
            assign t-dirf-deduc.cgc-decl    = t-dirf.cgc-decl    
                   t-dirf-deduc.cod-ret     = t-dirf.cod-ret     
                   t-dirf-deduc.esp-ben     = t-dirf.esp-ben     
                   t-dirf-deduc.cgc-cpf-ben = t-dirf.cgc-cpf-ben 
                   t-dirf-deduc.nome-ben    = t-dirf.nome-ben.
        end.    
        
        assign t-dirf-deduc.ded-prev[i-mes]   = t-dirf-deduc.ded-prev[i-mes] + dirf-apf.ded-inss[i-mes]
               t-dirf-deduc.ded-pensao[i-mes] = t-dirf-deduc.ded-pensao[i-mes] + dirf-apf.ded-pensao[i-mes]
               t-dirf-deduc.ded-depend[i-mes] = t-dirf-deduc.ded-depend[i-mes] + dirf-apf.ded-depend[i-mes].
    end.
END PROCEDURE.

PROCEDURE pi-normal:
    {app/ap0719rp.i8 tt-emitente}
    do  i-mes = 1 to 12:
        if  i-rend-tributavel = 40      /* considera apenas 40% ou 60% como */
        or  i-rend-tributavel = 60 then /* rendimento tributavel */ 
            assign de-rend-fornec          = (dirf-apf.base-bruta[i-mes] * i-rend-tributavel) / 100     
                   t-dirf.rend-trib[i-mes] = t-dirf.rend-trib[i-mes] + de-rend-fornec.
        else
            assign t-dirf.rend-trib[i-mes] = t-dirf.rend-trib[i-mes]
                                        + dirf-apf.base-bruta[i-mes].

        assign t-dirf.deducoes[i-mes]  = t-dirf.deducoes[i-mes]
                                     + (dirf-apf.ded-depend[i-mes]
                                     + dirf-apf.ded-pensao[i-mes]
                                     + dirf-apf.ded-inss[i-mes])
               t-dirf.imp-ret[i-mes]   = t-dirf.imp-ret[i-mes]
                                     + dirf-apf.valor-irrf[i-mes].
        
        find t-dirf-deduc
             where t-dirf-deduc.cgc-decl    = t-dirf.cgc-decl    
             and   t-dirf-deduc.cod-ret     = t-dirf.cod-ret     
             and   t-dirf-deduc.esp-ben     = t-dirf.esp-ben     
             and   t-dirf-deduc.cgc-cpf-ben = t-dirf.cgc-cpf-ben 
             exclusive-lock no-error.
        
        if  not avail t-dirf-deduc then do:
            create t-dirf-deduc.
            assign t-dirf-deduc.cgc-decl    = t-dirf.cgc-decl    
                   t-dirf-deduc.cod-ret     = t-dirf.cod-ret     
                   t-dirf-deduc.esp-ben     = t-dirf.esp-ben     
                   t-dirf-deduc.cgc-cpf-ben = t-dirf.cgc-cpf-ben 
                   t-dirf-deduc.nome-ben    = t-dirf.nome-ben.
        end.    
        
        assign t-dirf-deduc.ded-prev[i-mes]   = t-dirf-deduc.ded-prev[i-mes] + dirf-apf.ded-inss[i-mes]
               t-dirf-deduc.ded-pensao[i-mes] = t-dirf-deduc.ded-pensao[i-mes] + dirf-apf.ded-pensao[i-mes]
               t-dirf-deduc.ded-depend[i-mes] = t-dirf-deduc.ded-depend[i-mes] + dirf-apf.ded-depend[i-mes].                                      
    end.
END PROCEDURE.

