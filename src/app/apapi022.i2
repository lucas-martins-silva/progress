/********************************************************************************
***
*** app/apapi022.i2 - Cria Log Erros API Antecipa‡Æo Contas a Pagar.1
***
********************************************************************************/

def input param p-cod-msg   as int  no-undo.
def input param p-mensagem  as char no-undo.
def input param p-tipo-erro as int  no-undo. /* 1 - ERRO ; 2 - ADV */
        
create tt-log-tit-ap.
assign tt-log-tit-ap.cod-chave   = string(tt-antecip.ep-codigo)  + "," + 
                                   tt-antecip.cod-estabel        + "," + 
                                   string(tt-antecip.cod-fornec) + "," +                                   
                                   tt-antecip.cod-esp            + "," +
                                   tt-antecip.serie              + "," +
                                   tt-antecip.nr-docto           + "," +
                                   tt-antecip.parcela
       tt-log-tit-ap.cod-erro    = p-cod-msg
       tt-log-tit-ap.tipo-erro   = p-tipo-erro
       tt-log-tit-ap.descricao   = p-mensagem.

/* Fim de Include app/apapi022.i2 */
