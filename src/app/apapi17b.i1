/*******************************************************************************
***
*** app/apapi17b.i1 - Gera Nota D‚bito/Cr‚dito.
***
***  ===========>>>>> ATEN€ÇO: Se a API foi chamada pelo programa ap0591 o 
***                            tit-ap ‚ criado naquele programa, caso 
***                            contr ria o mesmo dever  ser criado por este
***                            programa.
***
*******************************************************************************/

find first tit-ap exclusive-lock
     where tit-ap.ep-codigo     = tt-nota-debito-credito.ep-codigo
     and   tit-ap.cod-estabel   = tt-nota-debito-credito.cod-estabel
     and   tit-ap.cod-esp       = tt-nota-debito-credito.cod-esp
     and   tit-ap.serie         = tt-nota-debito-credito.serie
     and   tit-ap.cod-fornec    = tt-nota-debito-credito.cod-fornec
     and   tit-ap.nr-docto      = tt-nota-debito-credito.nr-docto
     and   tit-ap.parcela       = tt-nota-debito-credito.parcela
     no-error.

if  not avail tit-ap then do:
    create tit-ap.
    assign tit-ap.ep-codigo     = tt-nota-debito-credito.ep-codigo
           tit-ap.cod-estabel   = tt-nota-debito-credito.cod-estabel
           tit-ap.cod-esp       = tt-nota-debito-credito.cod-esp
           tit-ap.serie         = tt-nota-debito-credito.serie
           tit-ap.cod-fornec    = tt-nota-debito-credito.cod-fornec
           tit-ap.nr-docto      = tt-nota-debito-credito.nr-docto
           tit-ap.parcela       = tt-nota-debito-credito.parcela.
end.       

assign tit-ap.referencia        = tt-nota-debito-credito.referencia
       tit-ap.dt-emissao        = tt-nota-debito-credito.dt-emissao
       tit-ap.dt-transacao      = tt-nota-debito-credito.dt-transacao
       tit-ap.portador          = tt-nota-debito-credito.portador
       tit-ap.tp-codigo         = tt-nota-debito-credito.tp-codigo
       tit-ap.moeda             = tt-nota-debito-credito.moeda
       tit-ap.cotacao-dia       = tt-nota-debito-credito.cotacao-dia.
assign tit-ap.vl-orig-me        = fn_ajust_dec(tt-nota-debito-credito.vl-orig-me, tt-nota-debito-credito.moeda)
       tit-ap.diversos-me       = fn_ajust_dec(tt-nota-debito-credito.diversos-me, tt-nota-debito-credito.moeda)
       tit-ap.frete-me          = fn_ajust_dec(tt-nota-debito-credito.frete-me, tt-nota-debito-credito.moeda)
       tit-ap.observacao        = tt-nota-debito-credito.observacao
       tit-ap.transacao         = 1
       tit-ap.dt-vencimen       = tit-ap.dt-emissao
       tit-ap.dt-prev-pag       = tit-ap.dt-emissao
       tit-ap.dt-fluxo          = tit-ap.dt-emissao.

/*--- Saldo sempre ser  zero da ND/NC ---*/
assign tit-ap.valor-saldo = 0
       tit-ap.vl-saldo-me = 0.

/*--- Atualiza‡Æo Valores ---*/
if  tit-ap.moeda = 0 then do:
    assign tit-ap.vl-original = fn_ajust_dec(tit-ap.vl-orig-me, tit-ap.moeda)
           tit-ap.diversos    = fn_ajust_dec(tit-ap.diversos-me, tit-ap.moeda)
           tit-ap.frete       = fn_ajust_dec(tit-ap.frete-me, tit-ap.moeda).
end.
else do:
    /*** DivisÆo do assign  para evitar erros no Progress 9 ***/
    assign tit-ap.vl-original = fn_ajust_dec(fn_conv_moedas(tit-ap.vl-orig-me, 
                                                            tit-ap.cotacao-dia,
                                                            tit-ap.moeda,
                                                            0),0).
    assign tit-ap.diversos    = fn_ajust_dec(fn_conv_moedas(tit-ap.diversos-me, 
                                                            tit-ap.cotacao-dia,
                                                            tit-ap.moeda,
                                                            0),0).
    assign tit-ap.frete       = fn_ajust_dec(fn_conv_moedas(tit-ap.frete-me, 
                                                            tit-ap.cotacao-dia,
                                                            tit-ap.moeda,
                                                            0),0).
end.
if  i-pais-impto-usuario = 4 then do:
    for each tt-imposto:
        find first tipo-tax no-lock
            where tipo-tax.cod-tax = tt-imposto.cod-imposto no-error.
        if avail tipo-tax then do:
           if tipo-tax.tipo = 1 then
              assign tit-ap.vl-original = fn_ajust_dec((tit-ap.vl-original - tt-imposto.vl-imposto), tit-ap.moeda)
                     tit-ap.vl-orig-me  = fn_ajust_dec((tit-ap.vl-orig-me  - tt-imposto.vl-imposto-me), tit-ap.moeda).
           else
              assign tit-ap.vl-original = fn_ajust_dec((tit-ap.vl-original + tt-imposto.vl-imposto), tit-ap.moeda)
                     tit-ap.vl-orig-me  = fn_ajust_dec((tit-ap.vl-orig-me + tt-imposto.vl-imposto-me), tit-ap.moeda).
        end.
    end.
end.

/*--- Atualiza Tipo da Esp‚cie ---*/
find first espec-ap no-lock
     where espec-ap.cod-esp = tit-ap.cod-esp no-error.

if  avail espec-ap then do:
    assign tit-ap.tipo = espec-ap.tipo.
end.

/*--- Atualiza Nome Abreviado ---*/
find first emitente no-lock
     where emitente.cod-emitente = tit-ap.cod-fornec
     and   emitente.identific   <> 1 no-error.

if  avail emitente then do:
    assign tit-ap.nome-abrev = emitente.nome-abrev.
end.    

/*--- Atualiza Matriz do Fornecedor ---*/
find first b-emitente no-lock
     where b-emitente.nome-abrev = emitente.nome-matriz
     and   b-emitente.identific <> 1 no-error.

if  avail b-emitente then do:
    assign tit-ap.matriz = b-emitente.cod-emitente.
end.

/*--- Atualiza Conta D‚bito ---*/
find first conta-contab no-lock
     where conta-contab.ep-codigo      = tt-nota-debito-credito.ep-codigo
     and   conta-contab.conta-contabil = tt-nota-debito-credito.conta-debito no-error.

if  avail conta-contab then do:
    assign tit-ap.conta-debito = conta-contab.conta-contabil
           tit-ap.ct-conta-db  = conta-contab.ct-codigo 
           tit-ap.sc-conta-db  = conta-contab.sc-codigo.
end.

/* Fim de Include */

