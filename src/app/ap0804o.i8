RUN pi-criar-tt-documento-ndnc.

if can-find(first tt-documento) then do:
    disp c-div-ndnc 
         with frame f-div-ndnc.
end.

for each tt-documento exclusive-lock:
    disp tt-documento.cod-estabel
         tt-documento.cod-fornec
         tt-documento.nome-abrev
         tt-documento.cod-esp
         tt-documento.nr-docto
         tt-documento.parcela
         tt-documento.serie
         tt-documento.vl-original
         tt-documento.dt-emissao
         tt-documento.c-tipo
         with frame f-ndnc.
    down with frame f-ndnc.
end.
