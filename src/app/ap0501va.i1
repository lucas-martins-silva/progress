create tt_xml_input_1.
assign tt_xml_input_1.tt_cod_label       = "Funcao"
       tt_xml_input_1.tt_des_conteudo    = "{1}" /* "Verifica e Atualiza" */
       tt_xml_input_1.tt_num_seq_1_xml   = v_sequencia
       tt_xml_input_1.tt_num_seq_2_xml   = 1.

create tt_xml_input_1.
assign tt_xml_input_1.tt_cod_label       = "Empresa"
       tt_xml_input_1.tt_des_conteudo    = string(i-ep-codigo-usuario)
       tt_xml_input_1.tt_num_seq_1_xml   = v_sequencia
       tt_xml_input_1.tt_num_seq_2_xml   = 1.
        
find conta-contab
     where conta-contab.ep-codigo      = b-lin-i-ap.ep-codigo and
           conta-contab.conta-contabil = INPUT FRAME {&FRAME-NAME} lin-conta-ap.conta-debito
           no-lock no-error.
        
create tt_xml_input_1.
assign tt_xml_input_1.tt_cod_label       = "Conta Contabil"
       tt_xml_input_1.tt_des_conteudo    = string(conta-contab.ct-codigo) + ',' +
                                           string(conta-contab.sc-codigo)
       tt_xml_input_1.tt_num_seq_1_xml   = v_sequencia
       tt_xml_input_1.tt_num_seq_2_xml   = 1.

create tt_xml_input_1.
assign tt_xml_input_1.tt_cod_label       = "Estabelecimento"
       tt_xml_input_1.tt_des_conteudo    = b-lin-i-ap.cod-estabel
       tt_xml_input_1.tt_num_seq_1_xml   = v_sequencia
       tt_xml_input_1.tt_num_seq_2_xml   = 1.

create tt_xml_input_1.
assign tt_xml_input_1.tt_cod_label       = "Data Movimentacao"
       tt_xml_input_1.tt_des_conteudo    = string(doc-i-ap.data-movto)
       tt_xml_input_1.tt_num_seq_1_xml   = v_sequencia
       tt_xml_input_1.tt_num_seq_2_xml   = 1.

create tt_xml_input_1.
assign tt_xml_input_1.tt_cod_label       = "Finalidade Economica"
       tt_xml_input_1.tt_des_conteudo    = string(b-lin-i-ap.mo-codigo)
       tt_xml_input_1.tt_num_seq_1_xml   = v_sequencia
       tt_xml_input_1.tt_num_seq_2_xml   = 1.

create tt_xml_input_1.
assign tt_xml_input_1.tt_cod_label       = "Valor Movimento"
       tt_xml_input_1.tt_des_conteudo    = string(input frame {&frame-name} lin-conta-ap.vl-movto-me)
       tt_xml_input_1.tt_num_seq_1_xml   = v_sequencia
       tt_xml_input_1.tt_num_seq_2_xml   = 1.

create tt_xml_input_1.
assign tt_xml_input_1.tt_cod_label       = "Origem Movimento"
       tt_xml_input_1.tt_des_conteudo    = "04" /* AP EMS2 Pendente */
       tt_xml_input_1.tt_num_seq_1_xml   = v_sequencia
       tt_xml_input_1.tt_num_seq_2_xml   = 1.

create tt_xml_input_1.
assign tt_xml_input_1.tt_cod_label       = "ID Movimento"
       tt_xml_input_1.tt_des_conteudo    = string(b-lin-i-ap.ep-codigo)   +  chr(10) +
                                           string(b-lin-i-ap.cod-estabel) +  chr(10) + 
                                           string(b-lin-i-ap.cod-esp)     +  chr(10) +
                                           string(b-lin-i-ap.serie)       +  chr(10) +
                                           string(b-lin-i-ap.nr-docto)    +  chr(10) +
                                           string(b-lin-i-ap.parcela)     +  chr(10) +
                                           string(b-lin-i-ap.cod-fornec)  +  chr(10) +
                                           string(input frame {&frame-name} lin-conta-ap.conta-debito)
       tt_xml_input_1.tt_num_seq_1_xml   = v_sequencia
       tt_xml_input_1.tt_num_seq_2_xml   = 1.
        
