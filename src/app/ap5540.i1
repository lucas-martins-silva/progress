/******************************************************************************
***
*** app/ap5540.i1 - Valida‡äes Permissäes Usu rio.
***
***                 ATEN€ÇO: Cuidado ao alterar esta include, qualquer altera‡Æo
***                          tamb‚m dever  ser fetia em outros programas
***                          ap5540/ap5541/ap5542.
***                                 
***                          Esta include deve ser chamada atrav‚s de
***                          uma procedure interna.
***                             
******************************************************************************/
            
find first param-ap where param-ap.ep-codigo = i-ep-codigo-usuario no-lock no-error.
            
if  avail param-ap then do:
    if  param-ap.considera-niveis = yes then do:
                
        find first estabelec no-lock
             where estabelec.cod-estabel = tit-ap.cod-estabel no-error.
        if  avail estabelec then do:
            &if "{&mgadm_version}" < "2.02" &then             
                if  tit-ap.tp-pagto = 0 or
                    tit-ap.tp-pagto > 5 then do:
                    run utp/ut-msgs.p (input "show",
                                       input 15828,
                                       input "").
                    return 'NOK'.
                end.
                else do:
                    assign i-nr-autoriz = 0.
                            
                    case tit-ap.tp-pagto:
                         when 1 then do:
                              /*--- DOC ---*/
                              assign i-nr-autoriz = int(substring(estabelec.char-2, 01, 02)).
                         end.
                         when 2 then do:
                              /*--- CRDITO CONTA CORRENTE ---*/
                              assign i-nr-autoriz = int(substring(estabelec.char-2, 03, 02)).
                         end.
                         when 3 then do:
                              /*--- CHEQUE ADMINISTRATIVO ---*/
                              assign i-nr-autoriz = int(substring(estabelec.char-2, 05, 02)).
                         end.
                         when 4 then do:
                              /*--- COBRAN€A ---*/
                              assign i-nr-autoriz = int(substring(estabelec.char-2, 07, 02)).
                         end.
                         when 5 then do:
                              /*--- CHEQUE NOMINAL ---*/
                              assign i-nr-autoriz = int(substring(estabelec.char-2, 09, 02)).
                         end.
                    end case.
                            
                    if  i-nr-autoriz > 0 then do:
                        find first usuar-permissao-ap 
                             where usuar-permissao-ap.usuario   = c-seg-usuario
                             and   usuar-permissao-ap.ep-codigo = i-ep-codigo-usuario
                             no-lock no-error.
                                        
                        if  avail usuar-permissao-ap then do:
                            if  usuar-permissao-ap.autoriza = yes then do:
                                        
                                find first usuar-autoriza-tit
                                     where usuar-autoriza-tit.ep-codigo    = tit-ap.ep-codigo
                                     and   usuar-autoriza-tit.nr-bordero   = 0
                                     and   usuar-autoriza-tit.cod-portador = 0                                     
                                     and   usuar-autoriza-tit.cod-estabel  = tit-ap.cod-estabel
                                     and   usuar-autoriza-tit.cod-esp      = tit-ap.cod-esp
                                     and   usuar-autoriza-tit.cod-fornec   = tit-ap.cod-fornec
                                     and   usuar-autoriza-tit.nr-docto     = tit-ap.nr-docto
                                     and   usuar-autoriza-tit.parcela      = tit-ap.parcela
                                     and   usuar-autoriza-tit.serie        = tit-ap.serie
                                     and   usuar-autoriza-tit.int-1        = tit-ap.tp-pagto
                                     and   usuar-autoriza-tit.autorizou    = yes
                                     and   usuar-autoriza-tit.usuario      = c-seg-usuario no-error.
                                            
                                if  avail usuar-autoriza-tit then do:
                                    run utp/ut-msgs.p (input "show",
                                                       input 15471,
                                                       input trim(c-seg-usuario)).
                                    return 'NOK'.
                                end.
                                            
                                assign i-permissao = 0.
                                            
                                for each  usuar-autoriza-tit no-lock
                                    where usuar-autoriza-tit.ep-codigo    = tit-ap.ep-codigo
                                    and   usuar-autoriza-tit.nr-bordero   = 0
                                    and   usuar-autoriza-tit.cod-portador = 0                                     
                                    and   usuar-autoriza-tit.cod-estabel  = tit-ap.cod-estabel
                                    and   usuar-autoriza-tit.cod-esp      = tit-ap.cod-esp
                                    and   usuar-autoriza-tit.cod-fornec   = tit-ap.cod-fornec
                                    and   usuar-autoriza-tit.nr-docto     = tit-ap.nr-docto
                                    and   usuar-autoriza-tit.parcela      = tit-ap.parcela
                                    and   usuar-autoriza-tit.serie        = tit-ap.serie
                                    and   usuar-autoriza-tit.int-1        = tit-ap.tp-pagto
                                    and   usuar-autoriza-tit.autorizou    = yes
                                    and   usuar-autoriza-tit.usuario     <> c-seg-usuario:
                                    assign i-permissao = i-permissao + 1.
                                end.
                                        
                                if  i-permissao >= i-nr-autoriz then do:
                                    run utp/ut-msgs.p (input "show",
                                                       input 15470,
                                                       input "").
                                    return 'NOK'.
                                end.
                                                
                                find first usuar-autoriza-tit no-lock
                                     where usuar-autoriza-tit.ep-codigo    = tit-ap.ep-codigo
                                     and   usuar-autoriza-tit.nr-bordero   = 0
                                     and   usuar-autoriza-tit.cod-portador = 0                                     
                                     and   usuar-autoriza-tit.cod-estabel  = tit-ap.cod-estabel
                                     and   usuar-autoriza-tit.cod-esp      = tit-ap.cod-esp
                                     and   usuar-autoriza-tit.cod-fornec   = tit-ap.cod-fornec
                                     and   usuar-autoriza-tit.nr-docto     = tit-ap.nr-docto
                                     and   usuar-autoriza-tit.parcela      = tit-ap.parcela
                                     and   usuar-autoriza-tit.serie        = tit-ap.serie
                                     and   usuar-autoriza-tit.int-1        = tit-ap.tp-pagto
                                     and   usuar-autoriza-tit.autorizou    = no
                                     and   usuar-autoriza-tit.usuario      = c-seg-usuario no-error.
                                                        
                                if  avail usuar-autoriza-tit then do:
                                    run utp/ut-msgs.p (input "show",
                                                       input 15469,
                                                       input trim(usuar-autoriza-tit.usuario) + "~~" +
                                                             string(usuar-autoriza-tit.dt-today, "99/99/9999") + "~~" +
                                                             string(usuar-autoriza-tit.c-time)).
                                            
                                    if  return-value <> 'yes' then
                                        return 'NOK'.
                                end.
                                
                            end.        
                            else do:
                                run utp/ut-msgs.p (input "show",
                                                   input 8382,
                                                   input "").
                                return 'NOK'.
                            end.
                        end.  
                        else do:
                            run utp/ut-msgs.p (input "show",
                                               input 15461,
                                               input trim(c-seg-usuario)).
                            return 'NOK'.
                        end.
                    end.
                    else do:
                        assign c-msg = {adinc/i22ad098.i 04 tit-ap.tp-pagto}.
                        run utp/ut-msgs.p (input "show",
                                           input 15826,
                                           input tit-ap.cod-estabel + "~~" + trim(c-msg)).
                        return 'NOK'.
                    end.
                end.
            &endif.
            &if "{&mgadm_version}" >= "2.02" &then             
                if  tit-ap.tp-pagto = 0 or
                    tit-ap.tp-pagto > 8 then do:
                    run utp/ut-msgs.p (input "show",
                                       input 15828,
                                       input "").
                    return 'NOK'.
                end. 
                else do:

                    assign i-nr-autoriz = 0.
                            
                    case tit-ap.tp-pagto:
                         when 1 then do:
                              /*--- DOC ---*/
                              assign i-nr-autoriz = int(substring(estabelec.char-2, 01, 02)).
                         end.
                         when 2 then do:
                              /*--- CRDITO CONTA CORRENTE ---*/
                              assign i-nr-autoriz = int(substring(estabelec.char-2, 03, 02)).
                         end.
                         when 3 then do:
                              /*--- CHEQUE ADMINISTRATIVO ---*/
                              assign i-nr-autoriz = int(substring(estabelec.char-2, 05, 02)).
                         end.
                         when 4 then do:
                              /*--- COBRAN€A ---*/
                              assign i-nr-autoriz = int(substring(estabelec.char-2, 07, 02)).
                         end.
                         when 5 then do:
                              /*--- CHEQUE NOMINAL ---*/
                              assign i-nr-autoriz = int(substring(estabelec.char-2, 09, 02)).
                         end.
                         when 6 then do:
                             /*--- CARTÇO DE CRDITO ---*/
                             assign i-nr-autoriz  = int(substring(estabelec.char-2, 11, 02)).
                         end.
                         when 7 then do:
                            /*--- DBITO EM CONTA CORRENTE ---*/    
                            assign i-nr-autoriz   = int(substring(estabelec.char-2, 13, 02)).
                         end.
                         when 8 then do:
                           /*--- AGENDAMENTO ELETRâNICO ---*/    
                           assign i-nr-autoriz    = int(substring(estabelec.char-2, 15, 02)).
                         end.  
                    end case.
                            
                    if  i-nr-autoriz > 0 then do:
                        find first usuar-permissao-ap 
                             where usuar-permissao-ap.usuario   = c-seg-usuario
                             and   usuar-permissao-ap.ep-codigo = i-ep-codigo-usuario
                             no-lock no-error.
                                        
                        if  avail usuar-permissao-ap then do:
                            if  usuar-permissao-ap.autoriza = yes then do:
                                        
                                find first usuar-autoriza-tit
                                     where usuar-autoriza-tit.ep-codigo    = tit-ap.ep-codigo
                                     and   usuar-autoriza-tit.nr-bordero   = 0
                                     and   usuar-autoriza-tit.cod-portador = 0                                     
                                     and   usuar-autoriza-tit.cod-estabel  = tit-ap.cod-estabel
                                     and   usuar-autoriza-tit.cod-esp      = tit-ap.cod-esp
                                     and   usuar-autoriza-tit.cod-fornec   = tit-ap.cod-fornec
                                     and   usuar-autoriza-tit.nr-docto     = tit-ap.nr-docto
                                     and   usuar-autoriza-tit.parcela      = tit-ap.parcela
                                     and   usuar-autoriza-tit.serie        = tit-ap.serie
                                     and   usuar-autoriza-tit.int-1        = tit-ap.tp-pagto
                                     and   usuar-autoriza-tit.autorizou    = yes
                                     and   usuar-autoriza-tit.usuario      = c-seg-usuario no-error.
                                            
                                if  avail usuar-autoriza-tit then do:
                                    run utp/ut-msgs.p (input "show",
                                                       input 15471,
                                                       input trim(c-seg-usuario)).
                                    return 'NOK'.
                                end.
                                            
                                assign i-permissao = 0.
                                            
                                for each  usuar-autoriza-tit no-lock
                                    where usuar-autoriza-tit.ep-codigo    = tit-ap.ep-codigo
                                    and   usuar-autoriza-tit.nr-bordero   = 0
                                    and   usuar-autoriza-tit.cod-portador = 0                                     
                                    and   usuar-autoriza-tit.cod-estabel  = tit-ap.cod-estabel
                                    and   usuar-autoriza-tit.cod-esp      = tit-ap.cod-esp
                                    and   usuar-autoriza-tit.cod-fornec   = tit-ap.cod-fornec
                                    and   usuar-autoriza-tit.nr-docto     = tit-ap.nr-docto
                                    and   usuar-autoriza-tit.parcela      = tit-ap.parcela
                                    and   usuar-autoriza-tit.serie        = tit-ap.serie
                                    and   usuar-autoriza-tit.int-1        = tit-ap.tp-pagto
                                    and   usuar-autoriza-tit.autorizou    = yes
                                    and   usuar-autoriza-tit.usuario     <> c-seg-usuario:
                                    assign i-permissao = i-permissao + 1.
                                end.
                                        
                                if  i-permissao >= i-nr-autoriz then do:
                                    run utp/ut-msgs.p (input "show",
                                                       input 15470,
                                                       input "").
                                    return 'NOK'.
                                end.
                                                
                                find first usuar-autoriza-tit no-lock
                                     where usuar-autoriza-tit.ep-codigo    = tit-ap.ep-codigo
                                     and   usuar-autoriza-tit.nr-bordero   = 0
                                     and   usuar-autoriza-tit.cod-portador = 0                                     
                                     and   usuar-autoriza-tit.cod-estabel  = tit-ap.cod-estabel
                                     and   usuar-autoriza-tit.cod-esp      = tit-ap.cod-esp
                                     and   usuar-autoriza-tit.cod-fornec   = tit-ap.cod-fornec
                                     and   usuar-autoriza-tit.nr-docto     = tit-ap.nr-docto
                                     and   usuar-autoriza-tit.parcela      = tit-ap.parcela
                                     and   usuar-autoriza-tit.serie        = tit-ap.serie
                                     and   usuar-autoriza-tit.int-1        = tit-ap.tp-pagto
                                     and   usuar-autoriza-tit.autorizou    = no
                                     and   usuar-autoriza-tit.usuario      = c-seg-usuario no-error.
                                                        
                                if  avail usuar-autoriza-tit then do:
                                    run utp/ut-msgs.p (input "show",
                                                       input 15469,
                                                       input trim(usuar-autoriza-tit.usuario) + "~~" +
                                                             string(usuar-autoriza-tit.dt-today, "99/99/9999") + "~~" +
                                                             string(usuar-autoriza-tit.c-time)).
                                            
                                    if  return-value <> 'yes' then
                                        return 'NOK'.
                                end.
                                
                            end.        
                            else do:
                                run utp/ut-msgs.p (input "show",
                                                   input 8382,
                                                   input "").
                                return 'NOK'.
                            end.
                        end.  
                        else do:
                            run utp/ut-msgs.p (input "show",
                                               input 15461,
                                               input trim(c-seg-usuario)).
                            return 'NOK'.
                        end.
                    end.
                    else do:
                        assign c-msg = {adinc/i22ad098.i 04 tit-ap.tp-pagto}.
                        run utp/ut-msgs.p (input "show",
                                           input 15826,
                                           input tit-ap.cod-estabel + "~~" + trim(c-msg)).
                        return 'NOK'.
                    end.
                end.
            &endif.
               
        end.
        else do:
            run utp/ut-msgs.p (input "show",
                               input 777,
                               input tit-ap.cod-estabel).
            return 'NOK'.
        end.
    end.
    else do:
        run utp/ut-msgs.p (input "show",
                           input 15468,
                           input "").
        return 'NOK'.
    end.
end.
else do:
    run utp/ut-msgs.p (input "show",
                       input 28,
                       input "").
    return 'NOK'.
end.

return 'OK'.
        
/* Fim de Include */

