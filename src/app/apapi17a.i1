/*******************************************************************************
***
*** app/apapi17a.i1 - Valida‡äes tt-nota-debito-credito.
***
*******************************************************************************/

{utp/ut-liter.i Nota_D‚bito/Cr‚dito}
assign c-identificacao = trim(return-value).

/*---- Valida parƒmetros do m¢dulo Contas a Pagar ----*/
find first param-ap no-lock
     where param-ap.ep-codigo = tt-nota-debito-credito.ep-codigo no-error.

if  not avail param-ap then do:
    run utp/ut-msgs.p (input "msg",
                       input 28,
                       input "").
    run pi-gerar-erro-retorno (input 28, input return-value).
end.

/*---- Valida empresa do usu rio ----*/
find first empresa no-lock 
     where empresa.ep-codigo = tt-nota-debito-credito.ep-codigo no-error.

if  not avail empresa then do:
    run utp/ut-msgs.p (input "msg",
                       input 12,
                       input string(tt-nota-debito-credito.ep-codigo)).
    run pi-gerar-erro-retorno (input 12, input return-value).
end.    

/*--- Valida Estabelecimento ---*/
find first estabelec no-lock
     where estabelec.cod-estabel = tt-nota-debito-credito.cod-estabel no-error.

if  not avail estabelec then do:
    run utp/ut-msgs.p (input "msg",
                       input 13,
                       input string(tt-nota-debito-credito.cod-estabel)).
    run pi-gerar-erro-retorno (input 13, input return-value).
end.    

/*--- Valida Fornecedor ---*/
find first emitente no-lock
     where emitente.cod-emitente  = tt-nota-debito-credito.cod-fornec
     and   emitente.identific    <> 1 no-error.

if  not avail emitente then do:
    run utp/ut-msgs.p (input "msg",
                       input 91,
                       input string(tt-nota-debito-credito.cod-fornec)).
    run pi-gerar-erro-retorno (input 91, input return-value).
end.    

/*----- Valida esp‚cie de documento -----*/
find espec-ap no-lock
     where espec-ap.cod-esp = tt-nota-debito-credito.cod-esp no-error.

if  not avail espec-ap then do:
    run utp/ut-msgs.p (input "msg",
                       input 15,
                       input tt-nota-debito-credito.cod-esp).
    run pi-gerar-erro-retorno (input 15, input return-value).
end.             
else do:

    /*--- Tipo dever  ser ND ou  NC ---*/
    if  espec-ap.tipo <> 4 and
        espec-ap.tipo <> 5 then do:
        run utp/ut-msgs.p (input "help",
                           input 15675,
                           input "").
        run pi-gerar-erro-retorno (input 15675, input return-value).
    end.             

    /*--- Valida Esp‚cie de Liga‡Æo ---*/
    find first b-espec-ap no-lock
         where b-espec-ap.cod-esp = espec-ap.esp-ligacao no-error.

    if  espec-ap.tipo = 4 then do:
        if  not avail b-espec-ap or (avail b-espec-ap and b-espec-ap.tipo <> 1) then do:
            {utp/ut-liter.i Normal}
            run utp/ut-msgs.p (input "help",
                               input 15686,
                               input espec-ap.cod-esp + "~~" + trim(return-value)).
            run pi-gerar-erro-retorno (input 15686, input return-value).
        end.             
    end.

    if  espec-ap.tipo = 5 then do:
        if  not avail b-espec-ap or (avail b-espec-ap and b-espec-ap.tipo <> 2) then do:
            {utp/ut-liter.i Antecipa‡Æo}
            run utp/ut-msgs.p (input "help",
                               input 15686,
                               input espec-ap.cod-esp + "~~" + trim(return-value)).
            run pi-gerar-erro-retorno (input 15686, input return-value).
        end.                     
    end.
end.

/*--- Valida Conta de Saldo do Fornecedor ---*/
if  avail emitente and avail b-espec-ap then do:
    find first conta-ap
         where conta-ap.ep-codigo   = tt-nota-debito-credito.ep-codigo
         and   conta-ap.cod-estabel = tt-nota-debito-credito.cod-estabel
         and   conta-ap.cod-esp     = b-espec-ap.cod-esp
         and   conta-ap.cod-grupo   = emitente.cod-gr-forn 
         no-lock no-error.

    if  not avail conta-ap then do:
        run utp/ut-msgs.p (input "help",
                           input 15809,
                           input string(tt-nota-debito-credito.ep-codigo) + "~~" +
                                 string(tt-nota-debito-credito.cod-estabel) + "~~" +
                                 string(b-espec-ap.cod-esp) + "~~" +
                                 string(emitente.cod-gr-forn)).
        run pi-gerar-erro-retorno (input 15809, input return-value).
    end.
end.    

/* Nao validar a serie como ja faz a implantacao de t¡tulos        
/*----- Valida s‚rie do documento -----*/
if  tt-nota-debito-credito.serie <> "" then do:
    find first serie no-lock
         where serie.serie = tt-nota-debito-credito.serie no-error.

    if  not avail serie then do:
        run utp/ut-msgs.p (input "msg",
                           input 1116,
                           input tt-nota-debito-credito.serie).
        run pi-gerar-erro-retorno (input 1116, input return-value).
    end.             
end.
*/

/*--- Verifica se j  existe documento cadastrado com mesma chave ---*/    
if  tt-nota-debito-credito.cod-programa <> "AP0591" then do:
    find first tit-ap no-lock
         where tit-ap.ep-codigo   = tt-nota-debito-credito.ep-codigo
         and   tit-ap.cod-estabel = tt-nota-debito-credito.cod-estabel
         and   tit-ap.cod-esp     = tt-nota-debito-credito.cod-esp
         and   tit-ap.cod-fornec  = tt-nota-debito-credito.cod-fornec
         and   tit-ap.serie       = tt-nota-debito-credito.serie
         and   tit-ap.nr-docto    = tt-nota-debito-credito.nr-docto
         and   tit-ap.parcela     = tt-nota-debito-credito.parcela no-error.

    if  avail tit-ap then do: 
        run utp/ut-msgs.p (input "help",
                           input 15996,
                           input string(tt-nota-debito-credito.cod-estabel) + "~~" +
                                 string(tt-nota-debito-credito.cod-esp) + "~~" +
                                 string(tt-nota-debito-credito.serie) + "~~" +
                                 string(tt-nota-debito-credito.nr-docto) + "~~" +
                                 string(tt-nota-debito-credito.parcela) + "~~" +
                                 string(tt-nota-debito-credito.cod-fornec)).
        run pi-gerar-erro-retorno (input 15996, input return-value).
    end.             
end.

/*--- BANCOS HISTàRICOS ---*/
if l-funcao-banc-hist-adm then do:
    if  can-find (first his-tit-ap no-lock
                  where his-tit-ap.ep-codigo   = tt-nota-debito-credito.ep-codigo
                  and   his-tit-ap.cod-estabel = tt-nota-debito-credito.cod-estabel
                  and   his-tit-ap.cod-fornec  = tt-nota-debito-credito.cod-fornec
                  and   his-tit-ap.serie       = tt-nota-debito-credito.serie
                  and   his-tit-ap.cod-esp     = tt-nota-debito-credito.cod-esp
                  and   his-tit-ap.nr-docto    = tt-nota-debito-credito.nr-docto
                  and   his-tit-ap.parcela     = tt-nota-debito-credito.parcela)  then do:
        run utp/ut-msgs.p(input "help",
                          input 25578,
                          input string(tt-nota-debito-credito.ep-codigo) + "~~" +
                                tt-nota-debito-credito.cod-estabel       + "~~" +
                                string(tt-nota-debito-credito.cod-fornec)+ "~~" +
                                tt-nota-debito-credito.cod-esp           + "~~" +
                                tt-nota-debito-credito.serie             + "~~" +
                                tt-nota-debito-credito.nr-docto          + "~~" +
                                tt-nota-debito-credito.parcela).
        run pi-gerar-erro-retorno (input 25578, input return-value).
    end.
end. /*--- fim param-global ---*/
/*--- FIM BANCOS HISTàRICOS ---*/


{app/ap0020.i}

/*--- Valida data de Transa‡Æo ---*/
if  avail param-ap then do:
    if  tt-nota-debito-credito.dt-transacao < da-ini-validac or
        tt-nota-debito-credito.dt-transacao > da-fim-validac then do:
        run utp/ut-msgs.p (input "help",
                           input 17319,
                           input string(param-ap.dt-ult-fec, "99/99/9999") + "~~" +
                                 string(da-ini-validac, "99/99/9999") + "~~" + 
                                 string(da-fim-validac, "99/99/9999")).
        run pi-gerar-erro-retorno (input 17319, input return-value).
    end.             
end.

if  tt-nota-debito-credito.dt-transacao < 
    tt-nota-debito-credito.dt-emissao then do:
    run utp/ut-msgs.p (input "help",
                       input 15692,
                       input string(tt-nota-debito-credito.dt-transacao, "99/99/9999") + "~~" +
                             string(tt-nota-debito-credito.dt-emissao, "99/99/9999")).
    run pi-gerar-erro-retorno (input 15692, input return-value).
end.             

/*--- Data Transa‡Æo deve ser maior que £ltimo fechamento ---*/
if  avail param-ap then do:
    if  tt-nota-debito-credito.dt-trans < param-ap.dt-ult-fec then do:
        run utp/ut-msgs.p (input "help", 
                           input 15676, 
                           input string(tt-nota-debito-credito.dt-transacao, "99/99/9999") + "~~" +
                                 string(param-ap.dt-ult-fec, "99/99/9999")).
        run pi-gerar-erro-retorno (input 15676, input return-value).
    end.             
end.

/*--- Valida Moeda ---*/
find first moeda no-lock
     where moeda.mo-codigo = tt-nota-debito-credito.moeda no-error.

if  not avail moeda then do:
    run utp/ut-msgs.p (input "msg", 
                       input 151, 
                       input "").
    run pi-gerar-erro-retorno (input 151, input return-value).
end.                         

/*--- Valida Cota‡Æo ---*/
if  tt-nota-debito-credito.moeda <> 0 then do:
    find first cotacao
         where cotacao.mo-codigo   = tt-nota-debito-credito.moeda
         and   cotacao.ano-periodo = string(year(tt-nota-debito-credito.dt-emissao)) + string(month(tt-nota-debito-credito.dt-emissao),"99")
         and   cotacao.cotacao[int(day(tt-nota-debito-credito.dt-emissao))] <> 0 no-lock no-error.

    if  not avail cotacao then do:
        run utp/ut-msgs.p (input "msg",
                           input 1175,
                           input string(tt-nota-debito-credito.moeda) + "~~" + 
                                 string(tt-nota-debito-credito.dt-emissao, "99/99/9999")).
        run pi-gerar-erro-retorno (input 1175, input return-value).
    end.
end.

/*--- Valida valor Original ---*/
if (tt-nota-debito-credito.diversos-me +
    tt-nota-debito-credito.frete-me) >
    tt-nota-debito-credito.vl-orig-me then do:
    run utp/ut-msgs.p (input "help", 
                       input 15677, 
                       input "").
    run pi-gerar-erro-retorno (input 15677, input return-value).
end.                         

assign l-varias-contas = no.       
find first tt-conta-debito
     where tt-conta-debito.ep-codigo   = tt-nota-debito-credito.ep-codigo
     and   tt-conta-debito.cod-estabel = tt-nota-debito-credito.cod-estabel
     and   tt-conta-debito.cod-fornec  = tt-nota-debito-credito.cod-fornec
     and   tt-conta-debito.cod-esp     = tt-nota-debito-credito.cod-esp
     and   tt-conta-debito.serie       = tt-nota-debito-credito.serie
     and   tt-conta-debito.nr-docto    = tt-nota-debito-credito.nr-docto
     and   tt-conta-debito.parcela     = tt-nota-debito-credito.parcela no-lock no-error.
if avail tt-conta-debito then do:     
   assign l-varias-contas = yes.       
end.   

if l-varias-contas = no then do:          
   /*--- Valida Conta Cont bil ---*/
   find first conta-contab no-lock
        where conta-contab.ep-codigo      = i-ep-codigo-usuario 
        and   conta-contab.conta-contabil = tt-nota-debito-credito.conta-debito no-error.

   if  not avail conta-contab then do:
       run utp/ut-msgs.p (input "msg", 
                          input 19, 
                          input string(tt-nota-debito-credito.conta-debito, param-global.formato-conta-contabil)).
       run pi-gerar-erro-retorno (input 19, input return-value).
   end.                         
   else do: 
       /*--- Conta ‚ de T¡tulo ---*/
       if  conta-contab.tipo = 6 then do:
           run utp/ut-msgs.p (input "msg", 
                              input 1061, 
                              input string(tt-nota-debito-credito.conta-debito, param-global.formato-conta-contabil)).
           run pi-gerar-erro-retorno (input 1061, input return-value).
       end.                         

       /*--- Conta deve ser de Sistema ---*/
       if  conta-contab.estado <> 3 then do:
           run utp/ut-msgs.p (input "msg", 
                              input 912, 
                              input "").
           run pi-gerar-erro-retorno (input 912, input return-value).
       end.                         

       /*--- Conta nÆo pode receber lan‡tos no AP ---*/
       if  conta-contab.contas-pagar = 1 then do:
           run utp/ut-msgs.p (input "msg", 
                              input 460, 
                              input "").
           run pi-gerar-erro-retorno (input 460, input return-value).
       end.                         

       /*--- Conta nÆo pode ser de saldo ---*/
       if  conta-contab.contas-pagar = 3 then do:
           run utp/ut-msgs.p (input "msg", 
                              input 6276, 
                              input string(tt-nota-debito-credito.conta-debito, param-global.formato-conta-contabil)).
           run pi-gerar-erro-retorno (input 6276, input return-value).
       end.                         

       /*--- Conta nÆo pode ser de saldo do caixa e bancos ---*/
       if  conta-contab.caixa-bancos = 3 then do:
           run utp/ut-msgs.p (input "msg", 
                              input 6276, 
                              input string(tt-nota-debito-credito.conta-debito, param-global.formato-conta-contabil)).
           run pi-gerar-erro-retorno (input 6276, input return-value).
       end.                         
   end.    
end.   


if  tt-nota-debito-credito.portador <> 0 then do:
    find first portador
         where portador.ep-codigo    = tt-nota-debito-credito.ep-codigo
         and   portador.cod-portador = tt-nota-debito-credito.portador
         and   portador.modalidade   = 1 no-lock no-error.

    if  not avail portador then do:
        run utp/ut-msgs.p (input "help", 
                           input 152, 
                           input string(tt-nota-debito-credito.portador)).
        run pi-gerar-erro-retorno (input 152, input return-value).
    end.
    else do:

        if  portador.mo-codigo <> tt-nota-debito-credito.moeda then do:
            run utp/ut-msgs.p (input "help", 
                               input 6491, 
                               input string(portador.cod-portador) + "~~" +
                                     string(portador.mo-codigo) + "~~" +
                                     string(tt-nota-debito-credito.moeda)).
            run pi-gerar-erro-retorno (input 6491, input return-value).
        end.

        find first cta-corrente
             where cta-corrente.cod-banco    = portador.cod-banco
             and   cta-corrente.agencia      = portador.agencia
             and   cta-corrente.conta-corren = portador.conta-corren
             no-lock no-error.

        if  not avail cta-corrente then do:
            run utp/ut-msgs.p (input "help", 
                               input 260, 
                               input string(tt-nota-debito-credito.portador)).
            run pi-gerar-erro-retorno (input 260, input return-value).
        end.

        find first conta-contab no-lock
             where conta-contab.ep-codigo      = tt-nota-debito-credito.ep-codigo
             and   conta-contab.conta-contabil = cta-corrente.conta-saldo no-error.

        if  not avail conta-contab then do:
            run utp/ut-msgs.p (input "help", 
                               input 8884, 
                               input string(cta-corrente.conta-saldo) + "~~" +
                                     string(tt-nota-debito-credito.portador)).
            run pi-gerar-erro-retorno (input 8884, input return-value).
        end.
    end.
end.   

/* Fim de Include */
