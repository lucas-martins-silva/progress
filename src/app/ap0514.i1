Def var l-verif-antec as logical initial no no-undo.

&IF DEFINED(BF_FIN_VERIF_ANT) &THEN
    assign l-verif-antec = yes.
&ELSE
    if can-find(first funcao where 
                      funcao.cd-funcao = "spp-verif_ant" and
                      funcao.ativo     = yes) then
       assign l-verif-antec = yes.
&ENDIF
