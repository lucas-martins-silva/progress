/******************************************************************************
**  Include: AP0512.I2
**
**  Objetivo: Imprimir listagem de consistencia da antecipacao
**
******************************************************************************/

disp b-tit-ap.cod-forn @ tit-ap.cod-forn
     b-tit-ap.cod-est  @ tit-ap.cod-est
     b-tit-ap.serie    @ tit-ap.serie
     b-tit-ap.cod-esp  @ tit-ap.cod-esp
     b-tit-ap.nr-docto @ tit-ap.nr-docto
     b-tit-ap.parcela  @ tit-ap.parcela
     {1} @ c-erro-ap
     with frame f-nao-eli.
down with frame f-nao-eli.

/* AP0512.I2 */
