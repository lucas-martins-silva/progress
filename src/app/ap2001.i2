/*****************************************************************************
**
**  AP2001.i2
**  Objetivo: Definicao de frames e abertura dos Arquivos de Saida,Impressao.
**
******************************************************************************/

def var c-cgc-emp      as char      no-undo.
def var c-cgc-estab    as char      no-undo.
def var i-cont         as integer   no-undo.
def var i-tot-reg      as integer   no-undo.
def var i-tot-lotes    as integer   no-undo.
def var i-tot-reg-lote as integer   no-undo.
def var de-tot-val     as decimal   no-undo.

def stream relat.

assign i-tot-reg      = 0
       i-tot-lotes    = 0
       de-tot-val     = 0
       i-tot-reg-lote = 0.

output stream relat to value(tt-param.c-arquivo-remessa) page-size 0.



