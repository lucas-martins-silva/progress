/*************************************************************************
***                                                                    ***
***            Definicio tt-param - Situacao Contas a Pagar            ***
***                                                                    ***
*************************************************************************/

define temp-table tt-param
    field destino           as integer
    field arquivo           as char format "x(50)"
    field usuario           as char format "x(12)"
    field data-exec         as date
    field hora-exec         as integer
    field classifica        as integer
    field desc-classifica   as char format "x(40)"
    field i-empresa         like empresa.ep-codigo
    field c-cod-estabel-ini like tit-ap.cod-estabel
    field c-cod-estabel-fim like tit-ap.cod-estabel
    field c-cod-esp-ini     like tit-ap.cod-esp
    field c-cod-esp-fim     like tit-ap.cod-esp
    field c-serie-ini       like tit-ap.serie
    field c-serie-fim       like tit-ap.serie
/*
    field i-fornec          like tit-ap.cod-fornec
*/
    field i-grp-ini         like grupo-fornec.cod-gr-forn
    field i-grp-fim         like grupo-fornec.cod-gr-forn
    field i-forn-ini        like tit-ap.cod-fornec
    field i-forn-fim        like tit-ap.cod-fornec
/* */
    field i-tipo-rel        as integer
    field i-moeda           like tit-ap.moeda
    field i-tipo-moeda      as integer
    field l-normal          as logical
    field l-previsao        as logical
    field l-antecip         as logical
    field da-data-refer     as date format 99/99/9999
    field c-desc-fornec     as char  format "x(30)"
    field c-desc-moeda      as char  format "x(30)".

/* ap0793.i */
