/*************************************************************************************
***
***   AP1002.i12
***   Objetivo:  Grava movimento como nÆo enviado para pagamento parcial de Border“.
***
**************************************************************************************/

&if "{&mgadm_version}" >= "2.02" &then 
                
    if avail tit-ap then do:       
        if  tit-ap.vl-saldo-me > 0 then do:
            assign tit-ap.atualiza-bor  = no
                   tit-ap.enviado       = no
                   tit-ap.arq-remessa   = " ".
                
            for each mov-ap use-index codigo 
                where mov-ap.ep-codigo   = tit-ap.ep-codigo and
                      mov-ap.cod-fornec  = tit-ap.cod-fornec and   
                      mov-ap.cod-estabel = tit-ap.cod-estabel and
                      mov-ap.cod-esp     = tit-ap.cod-esp and
                      mov-ap.serie       = tit-ap.serie and
                      mov-ap.nr-docto    = tit-ap.nr-docto and
                      mov-ap.parcela     = tit-ap.parcela
                      exclusive-lock:
                assign mov-ap.emit-fita = no.
            end.                             
            if  tit-ap.arq-remessa <> "" then do:
                assign i-sequencia = 1.
                find last  his-d-ap
                    where his-d-ap.ep-codigo    = tit-ap.ep-codigo
                     and  his-d-ap.cod-estabel  = tit-ap.cod-estabel
                     and  his-d-ap.cod-esp      = tit-ap.cod-esp
                     and  his-d-ap.nr-docto     = tit-ap.nr-docto
                     and  his-d-ap.parcela      = tit-ap.parcela
                     and  his-d-ap.serie        = tit-ap.serie
                     and  his-d-ap.cod-fornec   = tit-ap.cod-fornec
                     and  his-d-ap.dt-his-doc   = today no-lock no-error.
                              
                   if  avail his-d-ap then
                       assign i-sequencia = his-d-ap.sequencia + 1.

                    create his-d-ap. 
                    assign his-d-ap.ep-codigo    = tit-ap.ep-codigo
                           his-d-ap.cod-estabel  = tit-ap.cod-estabel
                           his-d-ap.cod-esp      = tit-ap.cod-esp
                           his-d-ap.nr-docto     = tit-ap.nr-docto
                           his-d-ap.parcela      = tit-ap.parcela
                           his-d-ap.serie        = tit-ap.serie
                           his-d-ap.cod-fornec   = tit-ap.cod-fornec
                           his-d-ap.dt-his-doc   = today
                           his-d-ap.sequencia    = i-sequencia.
            end.
        end. 
    end.
&endif.

/*Fim de include*/
