/**********************************************************************************
**
**    Include apapi022.i13
**    Data: 29/07/2000
**
**    Objetivo: Verificar se a apapi022 estÿ dispon­vel para este cliente ou
**              vers’o 2.04.
**
***********************************************************************************/

DEF VAR l-usa-api AS LOGICAL INITIAL NO NO-UNDO.

&IF DEFINED(BF_FIN_204) &THEN
    ASSIGN l-usa-api = yes.
&ELSE
    IF  CAN-FIND(FIRST funcao WHERE
                       funcao.cd-funcao = "spp-apiantbord" AND
                       funcao.ativo     = yes) THEN
        ASSIGN l-usa-api = yes.
&ENDIF.

