/**************************************************************************************
***
*** app/ap0505b.i8 - Impostos referente desconto concedido.
***
**************************************************************************************/

{cdp/cdcfgfin.i}

find first tit-ap use-index codigo
   where tit-ap.ep-codigo   = lin-b-ap.ep-codigo
     and tit-ap.cod-estabel = lin-b-ap.cod-estabel
     and tit-ap.cod-esp     = lin-b-ap.cod-esp
     and tit-ap.serie       = lin-b-ap.serie
     and tit-ap.nr-docto    = lin-b-ap.nr-docto
     and tit-ap.parcela     = lin-b-ap.parcela
     and tit-ap.cod-fornec  = lin-b-ap.cod-fornec
   no-error.
            
if  avail tit-ap then do:            
    find first impto-tit-ap use-index codigo
       where impto-tit-ap.ep-codigo    = tit-ap.ep-codigo
         and impto-tit-ap.cod-estabel  = tit-ap.cod-estabel
         and impto-tit-ap.cod-esp      = tit-ap.cod-esp
         and impto-tit-ap.serie        = tit-ap.serie
         and impto-tit-ap.nr-docto     = tit-ap.nr-docto
         and impto-tit-ap.parcela      = tit-ap.parcela
         and impto-tit-ap.cod-fornec   = tit-ap.cod-fornec
         and impto-tit-ap.tipo         = 2 
         and impto-tit-ap.origem-impto = 1  /* Implanta‡Æo */
         no-lock no-error.                 
    if  avail impto-tit-ap then do:                   
        assign l-desconto = no
               l-juros    = no
               &if defined(BF_FIN_MULTA_ABATIMENTO) &then
               l-abatimento = no
               l-multa    = no
               &endif
               .
        if  v-incluir-modificar = 'Incluir':U then do:
            if  lin-b-ap.vl-desconto > 0 then do:
                {app/ap0505b.i11}
            end. /* if v-incluir-modificar ... */                              
            if  lin-b-ap.vl-juros > 0 then do:
                {app/ap0505b.i12}
            end. /* if lin-b-ap ... */
            
        end. /* if lin-b-ap ... */
        else do:
            find first b-impto-tit-pend-ap use-index codigo
                 where b-impto-tit-pend-ap.ep-codigo    = tit-ap.ep-codigo
                 and   b-impto-tit-pend-ap.cod-estabel  = tit-ap.cod-estabel
                 and   b-impto-tit-pend-ap.cod-esp      = tit-ap.cod-esp
                 and   b-impto-tit-pend-ap.serie        = tit-ap.serie
                 and   b-impto-tit-pend-ap.nr-docto     = tit-ap.nr-docto
                 and   b-impto-tit-pend-ap.parcela      = tit-ap.parcela
                 and   b-impto-tit-pend-ap.cod-fornec   = tit-ap.cod-fornec
                 and   b-impto-tit-pend-ap.tipo         = 2              
                 no-lock no-error.         
            if  avail b-impto-tit-pend-ap then do:                            
                if (lin-b-ap.vl-desconto   <> de-vl-desc-impto)       or
                   &if defined(BF_FIN_MULTA_ABATIMENTO) &then
                   (lin-b-ap.vl-abatimento  <> de-vl-abatimento-impto) or
                   (lin-b-ap.vl-multa       <> de-vl-multa-impto)      or
                   &endif
                   (lin-b-ap.vl-juros      <> de-vl-juros-impto)
                    then do:
                    run utp/ut-msgs.p (input "show",
                                       input 6811,
                                       input "").                                    
                    if  return-value = 'yes':U then do:                        
                        for each  impto-tit-pend-ap use-index codigo
                            where impto-tit-pend-ap.ep-codigo    = tit-ap.ep-codigo
                            and   impto-tit-pend-ap.cod-estabel  = tit-ap.cod-estabel
                            and   impto-tit-pend-ap.cod-esp      = tit-ap.cod-esp
                            and   impto-tit-pend-ap.serie        = tit-ap.serie
                            and   impto-tit-pend-ap.nr-docto     = tit-ap.nr-docto
                            and   impto-tit-pend-ap.parcela      = tit-ap.parcela
                            and   impto-tit-pend-ap.cod-fornec   = tit-ap.cod-fornec
                            and   impto-tit-pend-ap.tipo         = 2                             
                            exclusive-lock:
                            delete impto-tit-pend-ap.
                        end. /* for each ... */
                        if  lin-b-ap.vl-desconto > 0 then do:
                            {app/ap0505b.i11}
                        end. /* if lin-b-ap ... */                        
                        if  lin-b-ap.vl-juros > 0 then do: 
                            {app/ap0505b.i12}
                        end. /* if lin-b-ap ... */
                    end. /* if return-value ... */                                
                end. /* if lin-b-ap ... */
            end. /* if avail b-impto-tit ... */
            else do:
                if  lin-b-ap.vl-desconto > 0 then do:
                    {app/ap0505b.i11}
                end. /* if lin-b-ap ... */                              
                if  lin-b-ap.vl-juros > 0 then do:
                    {app/ap0505b.i12}
                end. /* if lin-b-ap ... */
            end. /* else do */
        end. /* else do */                 
    end. /* if avail impto-tit-ap ... */
end. /* if avail tit-ap ... */

/* fim da include */
