/**************************************************************************
**
** AP1001K.I1
** Objetivo : Registros header do banco SAFRA
**
**************************************************************************/

find first empresa where empresa.ep-codigo   = i-empresa no-lock no-error.
find first portador where portador.ep-codigo = i-empresa and
           portador.cod-portador = i-portador no-lock no-error.
find first cta-corrente
     where cta-corrente.cod-banco    = portador.cod-banco
     and   cta-corrente.agencia      = portador.agencia
     and   cta-corrente.conta-corren = portador.conta-corren
     no-lock no-error.
find banco where banco.cod-banco = portador.cod-banco no-lock no-error.

assign c-cgc-emp = "".

do i-cont = 1 to 19:
   if  substr(empresa.cgc,i-cont,1) >= "0" 
   and substr(empresa.cgc,i-cont,1) <= "9" then
       assign c-cgc-emp = c-cgc-emp + substr(empresa.cgc,i-cont,1).
end.

put stream relat
    "0"                                                          at 001
    "1"                                                          at 002
    "REMESSA"                                                    at 003
    "11"                                                         at 010
    "PAGTOS FORNECED"                                            at 012
    dec(substr(cta-corren.conta-corren-ext,4,8))  format "99999999" at 027
    int(substr(cta-corrente.agencia-extrato,1,7)) format "9999999"  at 038
    fn-free-accent(caps(empresa.razao-social)) format "x(30)"    at 047
    "422"                                                        at 077
    "BANCO SAFRA S/A"                                            at 080
    day(today)                                 format "99"       at 095
    month(today)                               format "99"       at 097
    substr(string(year(today),"9999"),3,2)     format "99"       at 099
    "000"                                      format "999"      at 101
    "N"                                                          at 388
    time                                       format "999999"   at 389
    "000001"                                   format "999999"   at 395
    skip.

/* ap1001k.i1 */
