/**************************************************************************
**
**  Include.: AP0704.I2
**  Objetivo: Display dos titulos
**
*************************************************************************/

    if  tit-ap.tipo <> 2 then do:    /*AN*/

        if  tt-param.data-faixa = 1 then do:
           mov-block:
           for each mov-ap use-index codigo
               where mov-ap.ep-codigo   = tit-ap.ep-codigo
               and   mov-ap.cod-estabel = tit-ap.cod-estabel
               and   mov-ap.cod-esp     = tit-ap.cod-esp
               and   mov-ap.serie       = tit-ap.serie
               and   mov-ap.nr-docto    = tit-ap.nr-docto
               and   mov-ap.parcela     = tit-ap.parcela
               and   mov-ap.cod-fornec  = tit-ap.cod-fornec no-lock:

               {app/ap9999.i2 "mov-ap"
                              "tt-param.moeda"
                              "tit-ap"}

               if  mov-ap.transacao <> 2 /*BND*/
               and mov-ap.transacao <> 3 /*PEF*/
               and mov-ap.transacao <> 5 /*AVA*/
               and mov-ap.transacao <> 6 /*SND*/
               and mov-ap.transacao <> 8 then /*GPF*/
                   next.

                if  mov-ap.transacao   = 6 
                and mov-ap.lancamento <> 1 /*D*/ then
                    next.

                assign de-vl-mov-fasb = mov-ap.vl-mov-fasb.



                if  mov-ap.dt-transacao > tt-param.da-data then do:
                   if  mov-ap.transacao  = 5 
                   and mov-ap.lancamento = 1 then
                       if  tt-param.normal-fasb = 1 then
                           assign de-saldo = de-saldo - de-calc-valor-mov.
                       else 
                           assign de-saldo = de-saldo - mov-ap.vl-mov-fasb.

                   if  mov-ap.transacao = 5 
                   and mov-ap.lancamento = 2 then
                       if  tt-param.normal-fasb = 1 then
                           assign de-saldo = de-saldo + de-calc-valor-mov.
                       else 
                           assign de-saldo = de-saldo + mov-ap.vl-mov-fasb.

                   if  mov-ap.transacao = 8 
                   and tt-param.normal-fasb = 2 then
                       assign de-saldo = de-saldo + mov-ap.valor-mov + mov-ap.valor-juros.

                   if (mov-ap.transacao = 2
                   or  mov-ap.transacao = 3
                   or  mov-ap.transacao = 6) then
                       if  tt-param.normal-fasb = 1 then 
                           assign de-saldo = de-saldo + de-calc-valor-mov.
                       else 
                           assign de-saldo = de-saldo + de-vl-mov-fasb.
                end.                
            end.
        end.    

        if  de-saldo > 0 then do:
            if  tit-ap.tipo = 1  /*NO*/ or  tit-ap.tipo = 8 then /*IR*/  do:
                if   (tt-param.desconto    = yes) 
                and  (tt-param.normal-fasb = 1) 
                and ((tit-ap.dt-desconto  >= tt-param.da-data 
                and   tt-param.data-faixa = 1)
                or   (tit-ap.dt-desconto  >= tt-param.da-venc-fim 
                and   tt-param.data-faixa = 2)) then do:

                    assign de-calc-vl-desconto = tit-ap.vl-desconto.

                    if  tt-param.moeda <> 0 then do:
                        if  tt-param.moeda = tit-ap.moeda then
                            assign de-calc-vl-desconto = tit-ap.vl-desconto-me.
                        else
                            assign de-calc-vl-desconto = tit-ap.vl-desconto.
                    end.

                    assign de-saldo = de-saldo - de-calc-vl-desconto.
                end.

                assign de-tot-nor  = de-tot-nor + de-original
                       de-tot-nor1 = de-tot-nor1 + de-saldo
                       c-tip       = c-credito
                       c-tip1      = c-credito.
            end.
            if  tit-ap.tipo = 3 then   /*PR*/
                assign de-tot-pre  = de-tot-pre + de-original
                       de-tot-pre1 = de-tot-pre1 + de-saldo
                       c-tpo       = c-credito
                       c-tpo1      = c-credito.

            /* Carlos - src12112 - Tratamento de Provisäes */
            if tit-ap.tipo = 10 then   /*PRO*/
                assign de-tot-pro  = de-tot-pro  + de-original
                       de-tot-pro1 = de-tot-pro1 + de-saldo
                       c-tpro      = c-credito
                       c-tpro1     = c-credito.
            /* ------------------------------------------- */

            assign c-dbcr        = c-credito
                   c-dbcr1       = c-credito
                   de-normal     = de-normal  + de-original
                   de-normal1    = de-normal1 + de-saldo
                   de-orig-forn  = de-orig-forn + de-original
                   de-saldo-forn = de-saldo-forn + de-saldo.

            if  tit-ap.dt-vencimen <= tt-param.da-calc-venc then do:
                assign nr-dias = tt-param.da-calc-venc - tit-ap.dt-vencimen.
                if  nr-dias <= 30 then
                    assign de-ven-30 = de-ven-30 + de-saldo
                           de-total  = de-total  + de-saldo.
                else
                if  nr-dias > 30 and nr-dias <= 60 then
                    assign de-ven-60 = de-ven-60 + de-saldo
                           de-total  = de-total  + de-saldo.
                else
                if  nr-dias > 60 and nr-dias <= 90 then
                    assign de-ven-90 = de-ven-90 + de-saldo
                           de-total  = de-total  + de-saldo.
                else
                if  nr-dias > 90 and nr-dias <= 120 then
                    assign de-ven-120 = de-ven-120 + de-saldo
                           de-total   = de-total   + de-saldo.
                else
                if  nr-dias > 120 then
                    assign de-ven-999 = de-ven-999 + de-saldo
                           de-total   = de-total   + de-saldo.
            end.
            else do:
                assign nr-dias = tit-ap.dt-vencimen - tt-param.da-calc-venc.
                if  nr-dias <= 30 then
                    assign de-ven1-30 = de-ven1-30 + de-saldo
                           de-total1  = de-total1  + de-saldo.
                else
                if  nr-dias > 30 and nr-dias <= 60 then
                    assign de-ven1-60 = de-ven1-60 + de-saldo
                           de-total1  = de-total1  + de-saldo.
                else
                if  nr-dias > 60 and nr-dias <= 90 then
                    assign de-ven1-90 = de-ven1-90 + de-saldo
                           de-total1  = de-total1  + de-saldo.
                else
                if  nr-dias > 90 and nr-dias <= 120 then
                    assign de-ven1-120 = de-ven1-120 + de-saldo
                           de-total1   = de-total1   + de-saldo.
                else
                if  nr-dias > 120 then
                    assign de-ven1-999 = de-ven1-999 + de-saldo
                           de-total1   = de-total1   + de-saldo.
            end.
        end.
    end.
    else do:                                        

        if  tt-param.data-faixa = 1 then do:
            mov-block:
            for each mov-ap use-index ch-antecip
              where mov-ap.ep-codigo    = tit-ap.ep-codigo
                and mov-ap.cod-estabel  = tit-ap.cod-estabel
                and mov-ap.esp-ant      = tit-ap.cod-esp
                and mov-ap.serie-ant    = tit-ap.serie
                and mov-ap.docto-ant    = tit-ap.nr-docto
                and mov-ap.parc-ant     = tit-ap.parcela
                and mov-ap.fornec-ant   = tit-ap.cod-fornec
                and ((mov-ap.vl-antecip > 0 and tt-param.normal-fasb = 1)
                or  (mov-ap.vl-ant-fasb > 0 and tt-param.normal-fasb = 2))no-lock:

               {app/ap9999.i2 "mov-ap"
                              "tt-param.moeda"
                              "tit-ap"}

                if  mov-ap.transacao <> 2  /*BND*/
                and mov-ap.transacao <> 3  /*PEF*/
                and mov-ap.transacao <> 8 then next.   /*GPF*/


                if  mov-ap.dt-trans > tt-param.da-da
                and (mov-ap.transacao = 2 or  mov-ap.transacao = 3) then do:
                    assign de-vl-ant-fasb = mov-ap.vl-mov-fasb.
                    if  tt-param.normal-fasb = 1 then
                        assign de-saldo = de-saldo + de-calc-vl-antecip.
                    else  
                        assign de-saldo = de-saldo + de-vl-ant-fasb.
                end.


                if  mov-ap.dt-trans      > tt-param.da-data
                and mov-ap.transacao     = 8 
                and tt-param.normal-fasb = 2 then
                    assign de-saldo = de-saldo + (mov-ap.valor-mov + mov-ap.valor-juros).

            end.
            mov-block:
            for each mov-ap use-index codigo
                where mov-ap.ep-codigo  = tit-ap.ep-codigo
                and   mov-ap.cod-est    = tit-ap.cod-est
                and   mov-ap.cod-esp    = tit-ap.cod-esp
                and   mov-ap.serie      = tit-ap.serie
                and   mov-ap.nr-docto   = tit-ap.nr-docto
                and   mov-ap.parcela    = tit-ap.parcela
                and   mov-ap.cod-fornec = tit-ap.cod-fornec
                and  (mov-ap.transacao  = 5 /*AVA*/
                or    mov-ap.transacao  = 3 /*PEF*/
                or    mov-ap.transacao  = 8) no-lock:   /*GPF*/

               {app/ap9999.i2 "mov-ap"
                              "tt-param.moeda"
                              "tit-ap"}

                assign de-vl-ant-fasb = mov-ap.vl-mov-fasb.

                if  mov-ap.transacao = 5 and mov-ap.dt-trans > tt-param.da-data then
                    if  mov-ap.lancamento = 1 then 
                       if  tt-param.normal-fasb = 1 then                 
                            assign de-saldo = de-saldo + de-calc-valor-mov.
                       else 
                            assign de-saldo = de-saldo + de-vl-ant-fasb.
                    else
                        if  tt-param.normal-fasb = 1 then
                            assign de-saldo = de-saldo - de-calc-valor-mov.
                        else 
                            assign de-saldo = de-saldo - de-vl-ant-fasb.

                if  mov-ap.transacao     = 3 
                and mov-ap.dt-trans      > tt-param.da-data 
                and tt-param.normal-fasb = 2 then do:
                    assign de-vl-ant-fasb = mov-ap.vl-mov-fasb.
                    assign de-saldo       = de-saldo + de-vl-ant-fasb.
                end.

                if   mov-ap.transacao     = 8 /*GPF*/ 
                and  mov-ap.dt-trans      > tt-param.da-data 
                and  tt-param.normal-fasb = 2 then
                     assign de-saldo = de-saldo - (mov-ap.valor-mov + mov-ap.valor-juros).
            end.
        end.

        if  de-saldo > 0 then
            if  tit-ap.tipo = 2 then    /*AN*/
                assign c-dbcr        = c-debito
                       c-dbcr1       = c-debito
                       c-tp1         = c-debito
                       c-tp          = c-debito
                       de-antec      = de-antec      + de-original
                       de-antec1     = de-antec1     + de-saldo
                       de-ante-forn  = de-ante-forn  + de-original
                       de-ante1-forn = de-ante1-forn + de-saldo
                       de-tot-ant    = de-tot-ant    + de-original
                       de-tot-ant1   = de-tot-ant1   + de-saldo
                       de-gerant     = de-gerant     + de-original
                       de-gerant1    = de-gerant1    + de-saldo.

       /* *********** 187465 **************** 
        * /*-- Calcula RESUMO --*/
        * if  de-saldo <> 0 then
        *    if tit-ap.tipo <> 2 then do:    /*AN*/
        *        {app/ap0704.i6 "+"}  /* Acumula totais - documentos normais */
        *    end.
        *    else do:
        *       {app/ap0704.i6 "-"} /* Desconta as Antecipacoes */
        *    end.
        * ***********************************/
    end.

    if  de-saldo > 0 then do:
        assign l-emitiu = yes.
        if  tt-param.detal-resum = 1 then do:
            disp tit-ap.cod-fornec
                 tit-ap.nome-abrev
                 tit-ap.referencia
                 tit-ap.cod-estabel
                 tit-ap.cod-esp
                 tit-ap.serie
                 tit-ap.nr-docto
                 tit-ap.parcela
                 tit-ap.portador
                 tit-ap.dt-emissao
                 tit-ap.dt-vencimen
                 de-original
                 c-dbcr
                 de-saldo
                 c-dbcr1
                 tit-ap.estado when tit-ap.estado > 0
                 with frame f-item.
            down with frame f-item.
        end.
        if  (tt-param.lista-hist-prev   and tit-ap.tipo  = 3) /*PR*/
        or  (tt-param.lista-hist-doctos and tit-ap.tipo <> 3) /*PR*/
        or  (tt-param.lista-hist-prev   and tt-param.lista-hist-doctos) then do:
            find first mov-ap  use-index codigo
                 where mov-ap.ep-codigo   = tit-ap.ep-codigo
                 and   mov-ap.cod-estabel = tit-ap.cod-estabel
                 and   mov-ap.cod-esp     = tit-ap.cod-esp
                 and   mov-ap.serie       = tit-ap.serie
                 and   mov-ap.nr-docto    = tit-ap.nr-docto
                 and   mov-ap.parcela     = tit-ap.parcela
                 and   mov-ap.cod-fornec  = tit-ap.cod-fornec
                 and   (mov-ap.transacao  = 1 or mov-ap.transacao = 6  ) 
                 no-lock no-error.

            if  avail mov-ap then
                if  mov-ap.historico <> "" then do:
                    if  tt-param.detal-resum = 1 then
                        disp mov-ap.historico
                             with frame f-historico. 
                end.
        end.
    end.
    if  last-of(tit-ap.cod-fornec) AND tt-param.l-tot-forn then do:
        assign de-tot-for-ori = if  de-orig-forn >= de-ante-forn then
                                    de-orig-forn - de-ante-forn
                                else de-ante-forn - de-orig-forn
               c-tipo-for     = if  de-orig-forn >= de-ante-forn then c-credito
                                else c-debito
               de-tot-for-sal = if  de-saldo-forn >= de-ante1-forn then
                                    de-saldo-forn - de-ante1-forn
                                else de-ante1-forn - de-saldo-forn
               c-tipo-for1    = if  de-saldo-forn >= de-ante1-forn then c-credito
                                else c-debito.

        if  de-tot-for-ori > 0
        or  de-tot-for-sal > 0 then
            if  tt-param.detal-resum = 1 then
                disp c-tot-forn    
                     de-tot-for-ori
                     c-tipo-for
                     de-tot-for-sal
                     c-tipo-for1 with frame f-tot-forn.
        assign de-tot-for-ori = 0
               de-tot-for-sal = 0
               de-orig-forn   = 0
               de-ante-forn   = 0
               de-saldo-forn  = 0
               de-ante1-forn  = 0.
    end.  /*if last-of cod-fornec */
    if  last-of(day(tit-ap.dt-vencimen))
    and l-emitiu = yes then do:
        assign l-emitiu = no
               de-tot-mes  = de-normal   - de-antec
               de-tot-mes2 = de-tot-mes2 + de-tot-mes
               de-tot-mes1 = de-normal1  - de-antec1
               de-tot-mes3 = de-tot-mes3 + de-tot-mes1
               c-tipo      = (if  de-tot-mes < 0 then c-debito 
                              else c-credito)
               c-tipo1     = (if  de-tot-mes1 < 0 then c-debito
                              else c-credito)
               de-tot-mes  = de-tot-mes * (if  de-tot-mes < 0 then -1
                                           else 1)
               de-tot-mes1 = de-tot-mes1 * (if  de-tot-mes1 < 0 then -1
                                            else 1).
        if  tt-param.detal-resum = 1 then 
            disp c-mes-01    
                 de-tot-mes  
                 c-tipo
                 de-tot-mes1 
                 c-tipo1     
                 with frame f-mes.   

        assign de-tot-mes  = 0
               de-tot-mes1 = 0
               de-normal   = 0
               de-normal1  = 0
               de-antec    = 0
               de-antec1   = 0.
    end.

    if  last-of (month(tit-ap.dt-vencimen)) then do:
        if  de-tot-mes2 <> 0
        or  de-tot-mes3 <> 0 then do:
            assign c-tipo      = (if  de-tot-mes2 < 0 then c-debito
                                  else c-credito)
                   c-tipo1     = (if  de-tot-mes3 < 0 then c-debito
                                  else c-credito)
                   de-tot-mes2 = de-tot-mes2 * (if  de-tot-mes2 < 0 then -1
                                                else 1)
                   de-tot-mes3 = de-tot-mes3 * (if  de-tot-mes3 < 0 then -1
                                                else 1).
            if  tt-param.detal-resum = 1 then 
                disp c-mes1-01   
                     de-tot-mes2  
                     c-tipo
                     de-tot-mes3  
                     c-tipo1 
                     with frame f-mes1.

            assign de-tot-mes2 = 0
                   de-tot-mes3 = 0.
        end.
    end.

/* AP0704.I2 */
