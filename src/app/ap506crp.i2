/********************************************************************************
***
*** app/ap506crp.i2 - Defini‡Æo Form's.
***
********************************************************************************/

form
    mov-ap.cod-estabel
    mov-ap.cod-esp
    mov-ap.serie
    mov-ap.nr-docto
    mov-ap.parcela
    mov-ap.cod-fornec
    emitente.nome-abrev no-label
    mov-ap.portador
    mov-ap.nr-cheque
    mov-ap.dt-transacao
    mov-ap.conta-contabil
    mov-ap.valor-mov FORMAT "->>>,>>>,>>>,>>9.99"
    with side-labels no-box row 6 stream-io frame f-mov-ap.

form
   mov-ap.ep-codigo
   mov-ap.cod-estabel
   mov-ap.cod-esp
   mov-ap.serie
   mov-ap.nr-docto
   mov-ap.parcela
   mov-ap.cod-fornec
   mov-ap.dt-transacao
   mov-ap.nr-cheque
   mov-ap.portador
   mov-ap.valor-mov FORMAT "->>>,>>>,>>>,>>9.99"
   c-conta
   c-des-mensagem  at 75
   header ""
   with stream-io no-box  no-attr-space width 132 down frame f-detalhe .

{utp/ut-liter.i Conta_Cont bil}
assign c-conta:label in frame f-detalhe = trim(return-value).

{utp/ut-liter.i Mensagem_Erro}
assign c-des-mensagem:label in frame f-detalhe = trim(return-value).

form
   c-text-6 no-label at 01 skip(01)
   tt-param.cod-estabel       colon 30 skip
   tt-param.cod-esp           colon 30 skip
   tt-param.serie             colon 30 skip
   tt-param.nr-docto          colon 30 skip
   tt-param.parcela           colon 30 skip
   tt-param.cod-fornec        colon 30 skip
   tt-param.portador          colon 30 skip
   tt-param.dt-transacao      colon 30 skip
   tt-param.conta-contabil    colon 30 skip
   tt-param.nr-cheque         colon 30 skip
   tt-param.valor-mov  FORMAT "->>>,>>>,>>>,>>9.99" colon 30 skip(01)
   c-text-9    no-label at 01 skip(01)
   c-destino                  colon 30
   " - ":U
   tt-param.arquivo  no-label format "x(60)":U skip
   tt-param.usuario           colon 30 skip(2)
   with stream-io side-labels no-box width 132 frame f-parametros.
run utp/ut-trfrrp.p (input frame f-mov-ap:handle).
run utp/ut-trfrrp.p (input frame f-detalhe:handle).
run utp/ut-trfrrp.p (input frame f-parametros:handle).

/* Fim de Include */


