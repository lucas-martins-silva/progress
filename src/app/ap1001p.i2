/***************************************************************************
**
** ap1001p.i2 - Gerar detalhe Unibanco
**
***************************************************************************/

if  l-antecipacao = no then do:
    
    if  mov-ap.transacao = 15 then
        assign i-tipo-mov = 02
               c-cod-mov  = "19".
    
    if  mov-ap.transacao = 10 
    or  mov-ap.transacao = 11 
    or  mov-ap.transacao = 12 then
        assign i-tipo-mov = 03
                c-cod-mov = "99".
    
    if  mov-ap.transacao = 1 
    or  mov-ap.transacao = 6 then
        assign i-tipo-mov = 01
               c-cod-mov  = "00".
    
    &if defined(BF_FIN_MULTA_ABATIMENTO) &then
        assign de-desconto = tit-ap.vl-isr * 100
               de-abatimen = tit-ap.vl-abatimento-tot * 100
               de-juros    = tit-ap.dec-2 * 100
               de-multa    = tit-ap.vl-multa-tot * 100.
    &else
        assign de-desconto = tit-ap.vl-isr * 100
               de-juros    = tit-ap.dec-2  * 100.
    &endif

    {app/ap1001p.i3 "tit-ap.dt-vencimen"
                    "tit-ap.titulo-banco"
                    "(tit-ap.valor-saldo - vl-tot-impto)"
                    "tit-ap.cod-fornec"
                    "mov-ap.num-id-mov-ap"}
end.
else do:
    assign de-desconto = 0
           de-juros    = 0
           i-tipo-mov  = 01
           c-cod-mov   = "00".
    
    /*--- O tratamento abaixo refere-se … integra‡Æo APP x Investimentos ---*/
&if "{&mgadm_version}" >= "2.02" &then
    {app/ap1001p.i3 "bordero-ap.dt-vencto"
                    "bordero-ap.titulo-banco"
                    "(bordero-ap.vl-docto - vl-tot-impto)"
                    "bordero-ap.cod-fornec"
                    "bordero-ap.char-2"}
&else
    {app/ap1001p.i3 "bordero-ap.dt-vencto"
                    "bordero-ap.pedido"
                    "(bordero-ap.vl-docto - vl-tot-impto)"
                    "bordero-ap.cod-fornec"
                    "bordero-ap.char-2"}
&endif

end.

/* Fim ap1001p.i2 */
