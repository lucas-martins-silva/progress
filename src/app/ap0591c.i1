/********************************************************************************
***
*** app/ap0591c.i1 - Gera AVA a Maior no Documento Original.
***
********************************************************************************/

def var vl-movto-i1 like tt-conta-debito.vl-movto no-undo.

def buffer b-mov-ap-cb for mov-ap.

assign vl-movto-i1 = 0.

/*---- INTEGRA€åES - ELIMINA€ÇO ----*/     
{app/ap9100.i2}
assign tt-integ-ap.tt-row-tit-ap  = rowid(b-tit-ap-orig)
       tt-integ-ap.tt-ge0102b     = yes
       tt-integ-ap.tt-ge0102g     = yes
       tt-integ-ap.tt-cb0110a     = yes
       tt-integ-ap.tt-cb1202a     = yes
       tt-integ-ap.tt-op-ge0102b  = 6
       tt-integ-ap.tt-op-ge0102g  = 6
       tt-integ-ap.tt-op-cb0110a  = 6
       tt-integ-ap.tt-op-cb1202a  = 6.
raw-transfer tt-integ-ap to raw-integracao.
run app/ap9100.p (Input raw-integracao, input-output table tt-erro).
for each  b-mov-ap-cb
    where b-mov-ap-cb.ep-codigo = b-tit-ap-orig.ep-codigo
    and   b-mov-ap-cb.cod-est   = b-tit-ap-orig.cod-est
    and   b-mov-ap-cb.cod-esp   = b-tit-ap-orig.cod-esp
    and   b-mov-ap-cb.serie     = b-tit-ap-orig.serie
    and   b-mov-ap-cb.nr-docto  = b-tit-ap-orig.nr-docto
    and   b-mov-ap-cb.parcela   = b-tit-ap-orig.parcela
    and   b-mov-ap-cb.cod-forn  = b-tit-ap-orig.cod-fornec
    and  (b-mov-ap-cb.transacao = 5
    or    b-mov-ap-cb.transacao = 2) no-lock:
    /*---- INTEGRA€åES ----*/     
    {app/ap9100.i2}
    assign tt-integ-ap.tt-row-tit-ap = rowid(b-tit-ap-orig)
           tt-integ-ap.tt-row-mov-ap = rowid(b-mov-ap-cb)
           tt-integ-ap.tt-cb1202a    = yes
           tt-integ-ap.tt-op-cb1202a = 22.
    raw-transfer tt-integ-ap to raw-integracao.
    run app/ap9100.p (Input raw-integracao, input-output table tt-erro).
end.
/*---- INTEGRA€åES - FIM ELIMINA€ÇO ----*/ 

find first tt-conta-debito
     where tt-conta-debito.ep-codigo   = tit-ap.ep-codigo
     and   tt-conta-debito.cod-estabel = tit-ap.cod-estabel
     and   tt-conta-debito.cod-fornec  = tit-ap.cod-fornec
     and   tt-conta-debito.cod-esp     = tit-ap.cod-esp
     and   tt-conta-debito.serie       = tit-ap.serie
     and   tt-conta-debito.nr-docto    = tit-ap.nr-docto
     and   tt-conta-debito.parcela     = tit-ap.parcela
     no-error.

if  avail tt-conta-debito then do:
    for each  tt-conta-debito
        where tt-conta-debito.ep-codigo   = tit-ap.ep-codigo
        and   tt-conta-debito.cod-estabel = tit-ap.cod-estabel
        and   tt-conta-debito.cod-fornec  = tit-ap.cod-fornec
        and   tt-conta-debito.cod-esp     = tit-ap.cod-esp
        and   tt-conta-debito.serie       = tit-ap.serie
        and   tt-conta-debito.nr-docto    = tit-ap.nr-docto
        and   tt-conta-debito.parcela     = tit-ap.parcela:

        find first conta-contab no-lock 
             where conta-contab.ep-codigo      = i-ep-codigo-usuario
             and   conta-contab.conta-contabil = tt-conta-debito.conta-debito no-error.

        if  avail conta-contab then do:
            /*--- Var.Momet ria ---*/
            for each tt-variacao-monetaria:
                delete tt-variacao-monetaria.
            end.

            run app/ap0570b.p (input rowid(b-tit-ap-orig),
                               input tit-ap.dt-emissao,
                               input 0,
                               output table tt-variacao-monetaria). 

            run app/ap0570c.p (input rowid(b-tit-ap-orig),
                               input table tt-variacao-monetaria). 

            assign vl-movto-i1 = fn_ajust_dec(fn_conv_moedas (
                                                tt-conta-debito.vl-movto,
                                                tit-ap.cotacao-dia,
                                                tit-ap.moeda,
                                                0),0).

            if i-pais-impto-usuario <> 4 then do:
            /*--- Gera AVA ---*/
            {app/ap0591c.i5 "b-tit-ap-orig"
                            "tit-ap"
                            "1"
                            "conta-contab.conta-contabil"
                            "conta-contab.ct-codigo"
                            "conta-contab.sc-codigo"
                            "vl-movto-i1"
                            "tt-conta-debito.vl-movto"
                            "5"}
            
            /*********** MULTIPLANTA ************/
            run pi-cria-tt-dados-mov-ap (input 1).
            /************************************/       

            assign de-saldo-ant              = b-tit-ap-orig.valor-saldo
                   b-tit-ap-orig.valor-saldo = b-tit-ap-orig.valor-saldo + mov-ap.valor-mov
                   b-tit-ap-orig.vl-saldo-me = b-tit-ap-orig.vl-saldo-me + mov-ap.valor-mov-me.

            /*--- Estorno Impostos ---*/
            if i-pais-impto-usuario <> 2 then do: /* Na Localizacao o estorno e diferente */      
            
               {app/ap0004.i "10"
                             "01"
                             "05"
                             "mov-ap.dt-emissao"
                             "mov-ap.dt-transacao"
                             "de-saldo-ant"
                             "b-tit-ap-orig.valor-saldo"
                             "b-tit-ap-orig.ep-codigo"
                             "b-tit-ap-orig.cod-estabel"
                             "b-tit-ap-orig.cod-fornec"
                             "b-tit-ap-orig.cod-esp"
                             "b-tit-ap-orig.serie"
                             "b-tit-ap-orig.nr-docto"
                             "b-tit-ap-orig.parcela"
                             "mov-ap.num-id-mov-ap"
                             "no"}
            end.                 
            
            end. /* robson if do pais = 4 */
        end.                
    end.
    if i-pais-impto-usuario = 4 then do:

       find first tt-conta-debito
             where tt-conta-debito.ep-codigo   = tit-ap.ep-codigo
             and   tt-conta-debito.cod-estabel = tit-ap.cod-estabel
             and   tt-conta-debito.cod-fornec  = tit-ap.cod-fornec
             and   tt-conta-debito.cod-esp     = tit-ap.cod-esp
             and   tt-conta-debito.serie       = tit-ap.serie
             and   tt-conta-debito.nr-docto    = tit-ap.nr-docto
             and   tt-conta-debito.parcela     = tit-ap.parcela
             no-error.
        
       if  avail tt-conta-debito then do:

       find first conta-contab no-lock 
             where conta-contab.ep-codigo      = i-ep-codigo-usuario
             and   conta-contab.conta-contabil = tt-conta-debito.conta-debito no-error.
       if avail conta-contab then do:
            
            /*--- Gera AVA ---*/
            {app/ap0591c.i5 "b-tit-ap-orig"
                            "tit-ap"
                            "1"
                            "conta-contab.conta-contabil"
                            "conta-contab.ct-codigo"
                            "conta-contab.sc-codigo"
                            "tit-ap.vl-original"
                            "tit-ap.vl-orig-me"
                            "5"}
            /*********** MULTIPLANTA ************/
            run pi-cria-tt-dados-mov-ap (input 1).
            /************************************/     
            
            assign de-saldo-ant              = b-tit-ap-orig.valor-saldo
                   b-tit-ap-orig.valor-saldo = b-tit-ap-orig.valor-saldo + mov-ap.valor-mov
                   b-tit-ap-orig.vl-saldo-me = b-tit-ap-orig.vl-saldo-me + mov-ap.valor-mov-me.

            /*--- Estorno Impostos ---*/
            if i-pais-impto-usuario <> 2 then do: /* Na Localizacao o estorno e diferente */      
            
               {app/ap0004.i "10"
                             "01"
                             "05"
                             "mov-ap.dt-emissao"
                             "mov-ap.dt-transacao"
                             "de-saldo-ant"
                             "b-tit-ap-orig.valor-saldo"
                             "b-tit-ap-orig.ep-codigo"
                             "b-tit-ap-orig.cod-estabel"
                             "b-tit-ap-orig.cod-fornec"
                             "b-tit-ap-orig.cod-esp"
                             "b-tit-ap-orig.serie"
                             "b-tit-ap-orig.nr-docto"
                             "b-tit-ap-orig.parcela"
                             "mov-ap.num-id-mov-ap"
                             "no"}
              
            end.                

            
               for each  impto-tit-ap exclusive-lock
                   where impto-tit-ap.ep-codigo   = tit-ap.ep-codigo
                   and   impto-tit-ap.cod-estabel = tit-ap.cod-estabel
                   and   impto-tit-ap.cod-fornec  = tit-ap.cod-fornec
                   and   impto-tit-ap.cod-esp     = tit-ap.cod-esp
                   and   impto-tit-ap.serie       = tit-ap.serie
                   and   impto-tit-ap.nr-docto    = tit-ap.nr-docto
                   and   impto-tit-ap.parcela     = tit-ap.parcela:
        
                        
                   create tit-conta-ap. /* cria imposto */
                   assign tit-conta-ap.ep-codigo             = b-tit-ap-orig.ep-codigo
                          tit-conta-ap.cod-estabel           = b-tit-ap-orig.cod-estabel
                          tit-conta-ap.cod-esp               = b-tit-ap-orig.cod-esp
                          tit-conta-ap.serie                 = b-tit-ap-orig.serie
                          tit-conta-ap.cod-fornec            = b-tit-ap-orig.cod-fornec
                          tit-conta-ap.nr-docto              = b-tit-ap-orig.nr-docto
                          tit-conta-ap.parcela               = b-tit-ap-orig.parcela
                          tit-conta-ap.conta-debito          = impto-tit-ap.conta-imposto
                          tit-conta-ap.ct-codigo             = impto-tit-ap.ct-imposto
                          tit-conta-ap.sc-codigo             = impto-tit-ap.sc-imposto
                          tit-conta-ap.vl-movto              = impto-tit-ap.vl-imposto
                          tit-conta-ap.vl-movto-me           = impto-tit-ap.vl-imposto-me
                          substr(tit-conta-ap.char-1,1,2)    = b-tit-ap-orig.cod-esp
                          substr(tit-conta-ap.char-1,3,5)    = b-tit-ap-orig.serie
                          substr(tit-conta-ap.char-1,8,16)   = b-tit-ap-orig.nr-docto
                          substr(tit-conta-ap.char-1,24,2)   = b-tit-ap-orig.parcela.
                   &if DEFINED (BF_FIN_206) &then
                       assign tit-conta-ap.tipo-impto = impto-tit-ap.tipo.
                   &else
                       assign tit-conta-ap.int-2      = impto-tit-ap.tipo.
                   &endif
                   &if DEFINED (BF_FIN_206b) &then
                       assign tit-conta-ap.num-id-mov-ap = mov-ap.num-id-mov-ap.
                   &else
                       assign substr(tit-conta-ap.char-2,1,9) = string(mov-ap.num-id-mov-ap). /* AVA */
                   &endif
               end.
       end.        
       end.
        /* nova l¢gica robson */
            for each  tt-conta-debito
                where tt-conta-debito.ep-codigo   = tit-ap.ep-codigo
                and   tt-conta-debito.cod-estabel = tit-ap.cod-estabel
                and   tt-conta-debito.cod-fornec  = tit-ap.cod-fornec
                and   tt-conta-debito.cod-esp     = tit-ap.cod-esp
                and   tt-conta-debito.serie       = tit-ap.serie
                and   tt-conta-debito.nr-docto    = tit-ap.nr-docto
                and   tt-conta-debito.parcela     = tit-ap.parcela:
        
                    find first conta-contab no-lock 
                         where conta-contab.ep-codigo      = tit-ap.ep-codigo
                         and   conta-contab.conta-contabil = tt-conta-debito.conta-debito no-error.
                    
                
                    if  avail conta-contab then do:
                       create tit-conta-ap. /* cria despesa da nota */
                       assign tit-conta-ap.ep-codigo          = b-tit-ap-orig.ep-codigo
                              tit-conta-ap.cod-estabel        = b-tit-ap-orig.cod-estabel
                              tit-conta-ap.cod-esp            = b-tit-ap-orig.cod-esp
                              tit-conta-ap.serie              = b-tit-ap-orig.serie
                              tit-conta-ap.cod-fornec         = b-tit-ap-orig.cod-fornec
                              tit-conta-ap.nr-docto           = b-tit-ap-orig.nr-docto
                              tit-conta-ap.parcela            = b-tit-ap-orig.parcela
                              tit-conta-ap.conta-debito       = conta-contab.conta-contabil
                              tit-conta-ap.ct-codigo          = conta-contab.ct-codigo
                              tit-conta-ap.sc-codigo          = conta-contab.sc-codigo
                              tit-conta-ap.vl-movto           = tt-conta-debito.vl-movto 
                              tit-conta-ap.vl-movto-me        = tt-conta-debito.vl-movto.  
                              &if DEFINED (BF_FIN_206b) &then
                                  assign tit-conta-ap.num-id-mov-ap = mov-ap.num-id-mov-ap.
                              &else
                                  assign substr(tit-conta-ap.char-2,1,9) = string(mov-ap.num-id-mov-ap) /* AVA */.
                              &endif
                     end.         
        
            end.
    end.
end.
else do:
    /*--- Var.Momet ria ---*/
    for each tt-variacao-monetaria:
        delete tt-variacao-monetaria.
    end.

    run app/ap0570b.p (input rowid(b-tit-ap-orig),
                       input tit-ap.dt-emissao,
                       input 0,
                       output table tt-variacao-monetaria). 

    run app/ap0570c.p (input rowid(b-tit-ap-orig),
                       input table tt-variacao-monetaria). 

    /*--- Gera AVA ---*/
    {app/ap0591c.i5 "b-tit-ap-orig"
                    "tit-ap"
                    "1"
                    "tit-ap.conta-debito"
                    "tit-ap.ct-conta-db"
                    "tit-ap.sc-conta-db"
                    "tit-ap.vl-original"
                    "tit-ap.vl-orig-me"
                    "5"}

    if i-pais-impto-usuario = 4 then do:
        assign vl-nota    = tit-ap.vl-original       
               vl-nota-me = tit-ap.vl-orig-me.
       
       for each  impto-tit-ap exclusive-lock
           where impto-tit-ap.ep-codigo   = tit-ap.ep-codigo
           and   impto-tit-ap.cod-estabel = tit-ap.cod-estabel
           and   impto-tit-ap.cod-fornec  = tit-ap.cod-fornec
           and   impto-tit-ap.cod-esp     = tit-ap.cod-esp
           and   impto-tit-ap.serie       = tit-ap.serie
           and   impto-tit-ap.nr-docto    = tit-ap.nr-docto
           and   impto-tit-ap.parcela     = tit-ap.parcela
           and   impto-tit-ap.num-id-mov-ap <> mov-ap.num-id-mov-ap:
           
           create tit-conta-ap. /* cria imposto */
           assign tit-conta-ap.ep-codigo             = b-tit-ap-orig.ep-codigo
                  tit-conta-ap.cod-estabel           = b-tit-ap-orig.cod-estabel
                  tit-conta-ap.cod-esp               = b-tit-ap-orig.cod-esp
                  tit-conta-ap.serie                 = b-tit-ap-orig.serie
                  tit-conta-ap.cod-fornec            = b-tit-ap-orig.cod-fornec
                  tit-conta-ap.nr-docto              = b-tit-ap-orig.nr-docto
                  tit-conta-ap.parcela               = b-tit-ap-orig.parcela
                  tit-conta-ap.conta-debito          = impto-tit-ap.conta-imposto
                  tit-conta-ap.ct-codigo             = impto-tit-ap.ct-imposto
                  tit-conta-ap.sc-codigo             = impto-tit-ap.sc-imposto
                  tit-conta-ap.vl-movto              = impto-tit-ap.vl-imposto
                  tit-conta-ap.vl-movto-me           = impto-tit-ap.vl-imposto-me
                  substr(tit-conta-ap.char-1,1,2)    = b-tit-ap-orig.cod-esp
                  substr(tit-conta-ap.char-1,3,5)    = b-tit-ap-orig.serie
                  substr(tit-conta-ap.char-1,8,16)   = b-tit-ap-orig.nr-docto
                  substr(tit-conta-ap.char-1,24,2)   = b-tit-ap-orig.parcela.
           &if DEFINED (BF_FIN_206) &then
               assign tit-conta-ap.tipo-impto = impto-tit-ap.tipo.
           &else
               assign tit-conta-ap.int-2      = impto-tit-ap.tipo.
           &endif
           &if DEFINED (BF_FIN_206b) &then
               assign tit-conta-ap.num-id-mov-ap = mov-ap.num-id-mov-ap.
           &else
               assign substr(tit-conta-ap.char-2,1,9) = string(mov-ap.num-id-mov-ap) /* AVA */.
           &endif
           /*valor da nota de DB/CR*/
           if impto-tit-ap.tipo = 1 then 
              assign vl-nota    = vl-nota    + impto-tit-ap.vl-imposto             
                     vl-nota-me = vl-nota-me + impto-tit-ap.vl-imposto-me.
           else
              assign vl-nota    = vl-nota    - impto-tit-ap.vl-imposto             
                     vl-nota-me = vl-nota-me - impto-tit-ap.vl-imposto-me.       

       end.
               
       create tit-conta-ap. /* cria despesa da nota */
       assign tit-conta-ap.ep-codigo          = b-tit-ap-orig.ep-codigo
              tit-conta-ap.cod-estabel        = b-tit-ap-orig.cod-estabel
              tit-conta-ap.cod-esp            = b-tit-ap-orig.cod-esp
              tit-conta-ap.serie              = b-tit-ap-orig.serie
              tit-conta-ap.cod-fornec         = b-tit-ap-orig.cod-fornec
              tit-conta-ap.nr-docto           = b-tit-ap-orig.nr-docto
              tit-conta-ap.parcela            = b-tit-ap-orig.parcela
              tit-conta-ap.conta-debito       = tit-ap.conta-debito
              tit-conta-ap.ct-codigo          = tit-ap.ct-conta-db 
              tit-conta-ap.sc-codigo          = tit-ap.sc-conta-db 
              tit-conta-ap.vl-movto           = vl-nota    
              tit-conta-ap.vl-movto-me        = vl-nota-me.
                
              &if DEFINED (BF_FIN_206b) &then
                  assign tit-conta-ap.num-id-mov-ap = mov-ap.num-id-mov-ap.
              &else
                  assign substr(tit-conta-ap.char-2,1,9) = string(mov-ap.num-id-mov-ap) /* AVA */.
              &endif
              
    end.          

    /*********** MULTIPLANTA ************/
    run pi-cria-tt-dados-mov-ap (input 1).
    /************************************/       

    assign de-saldo-ant              = b-tit-ap-orig.valor-saldo
           b-tit-ap-orig.valor-saldo = b-tit-ap-orig.valor-saldo + mov-ap.valor-mov
           b-tit-ap-orig.vl-saldo-me = b-tit-ap-orig.vl-saldo-me + mov-ap.valor-mov-me.

    /*--- Estorno Impostos ---*/
    if i-pais-impto-usuario <> 2 then do: /* Na Localizacao o estorno e diferente */
       {app/ap0004.i "10"
                     "01"
                     "05"
                     "mov-ap.dt-emissao"
                     "mov-ap.dt-transacao"
                     "de-saldo-ant"
                     "b-tit-ap-orig.valor-saldo"
                     "b-tit-ap-orig.ep-codigo"
                     "b-tit-ap-orig.cod-estabel"
                     "b-tit-ap-orig.cod-fornec"
                     "b-tit-ap-orig.cod-esp"
                     "b-tit-ap-orig.serie"
                     "b-tit-ap-orig.nr-docto"
                     "b-tit-ap-orig.parcela"
                     "mov-ap.num-id-mov-ap"
                     "no"}
    end.                 

end.
/*************** MULTIPLANTA ***************/
run pi-cria-tt-dados-b-tit-ap-orig (input 2).
/*******************************************/

/*---- INTEGRA€åES - INCLUSÇO ----*/     
{app/ap9100.i2}
assign tt-integ-ap.tt-row-tit-ap  = rowid(b-tit-ap-orig)
       tt-integ-ap.tt-cb0110a     = yes
       tt-integ-ap.tt-ge0102b     = yes
       tt-integ-ap.tt-ge0102g     = yes
       tt-integ-ap.tt-op-cb0110a  = 16
       tt-integ-ap.tt-op-ge0102b  = 16
       tt-integ-ap.tt-op-ge0102g  = 16.
raw-transfer tt-integ-ap to raw-integracao.
run app/ap9100.p (Input raw-integracao, input-output table tt-erro).

{app/ap9100.i2}
assign tt-integ-ap.tt-row-tit-ap = rowid(b-tit-ap-orig)
       tt-integ-ap.tt-cb1202a    = yes
       tt-integ-ap.tt-op-cb1202a = 16.
raw-transfer tt-integ-ap to raw-integracao.
run app/ap9100.p (Input raw-integracao, input-output table tt-erro).

for each  b-mov-ap-cb
    where b-mov-ap-cb.ep-codigo = b-tit-ap-orig.ep-codigo
    and   b-mov-ap-cb.cod-est   = b-tit-ap-orig.cod-est
    and   b-mov-ap-cb.cod-esp   = b-tit-ap-orig.cod-esp
    and   b-mov-ap-cb.serie     = b-tit-ap-orig.serie
    and   b-mov-ap-cb.nr-docto  = b-tit-ap-orig.nr-docto
    and   b-mov-ap-cb.parcela   = b-tit-ap-orig.parcela
    and   b-mov-ap-cb.cod-forn  = b-tit-ap-orig.cod-fornec
    and  (b-mov-ap-cb.transacao = 5
    or    b-mov-ap-cb.transacao = 2) no-lock:
    /*---- INTEGRA€åES ----*/     
    {app/ap9100.i2}
    assign tt-integ-ap.tt-row-tit-ap = rowid(b-tit-ap-orig)
           tt-integ-ap.tt-row-mov-ap = rowid(b-mov-ap-cb)
           tt-integ-ap.tt-cb1202a    = yes
           tt-integ-ap.tt-op-cb1202a = 21.
    raw-transfer tt-integ-ap to raw-integracao.
    run app/ap9100.p (Input raw-integracao, input-output table tt-erro).
end.
/*---- INTEGRA€åES - FIM INCLUSÇO ----*/


/* Fim de Include */






