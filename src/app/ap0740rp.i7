/*******************************************************************************
***
*** app/ap0740rp.i7 - first-of(tt-tit-ap.moeda).
***
*******************************************************************************/

if  first-of(tt-tit-ap.moeda) then do:
    
    find first moeda where moeda.mo-codigo = tt-tit-ap.moeda no-lock no-error.

    put trim(c-moeda)
        " "
        tt-tit-ap.moeda
        " - "
        moeda.descricao skip.
end.

/* Fim de Include */
