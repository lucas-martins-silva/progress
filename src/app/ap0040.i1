/******************************************************************************
***
*** app/ap0040.i1 - Grava Hist¢rico das Altera‡äes.
***
******************************************************************************/
    
if  b-old-{1}.{2} <> {3} and 
    b-old-{1}.{2} <> {1}.{2} then do:
            
    if  his-d-ap.historico = "" then
        assign his-d-ap.historico = trim(string(caps("{4}") + " do " 
                                  + string(caps("{1}")) 
                                  + " foi alterado de: "
                                  + string(b-old-{1}.{2})
                                  + " para: " 
                                  + string({1}.{2}) 
                                  + " pelo Sr(a). " + caps(c-seg-usuario)
                                  + " em " + string(today, "99/99/9999")
                                  + " …s " + string(time, "HH:MM:SS")
                                  + " atrav‚s do programa "
                                  + program-name (2)
                                  + " ",
                                  "x(30000)"))
                                  no-error.
    else
        assign his-d-ap.historico = trim(string(his-d-ap.historico
                                  + caps("{4}") + " do " 
                                  + string(caps("{1}"))
                                  + " foi alterado de: "
                                  + string(b-old-{1}.{2})
                                  + " para: " 
                                  + string({1}.{2}) 
                                  + " pelo Sr(a). " + caps(c-seg-usuario)
                                  + " em " + string(today, "99/99/9999")
                                  + " …s " + string(time, "HH:MM:SS")
                                  + " atrav‚s do programa "
                                  + program-name (2)
                                  + " ",
                                  "x(30000)"))
                                  no-error.
            
end.

/* Fim de Include */

     
