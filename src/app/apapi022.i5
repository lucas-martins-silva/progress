PROCEDURE PI-CRIA-TT-DADOS-MOV-PREV:
    def input param i-tipo-movto as int   no-undo.
    def input param r-row-movto  as rowid no-undo.
    
    find b-mov-ap-prev where
         rowid(b-mov-ap-prev) = r-row-movto no-lock no-error.
         
    if  avail b-mov-ap-prev    and     
        param-global.modulo-mp and
        tt-replica-msg.log-replica-msg = yes then do: 
        create tt-mov-ap-aux.
        buffer-copy b-mov-ap-prev to tt-mov-ap-aux.
        create tt-dados-env.                  
        assign tt-dados-env.num-sequencia  = i-seq 
               tt-dados-env.cod-tipo-reg   = 44
               tt-dados-env.ind-tipo-movto = i-tipo-movto
               tt-dados-env.identif-msg    = string(b-mov-ap-prev.ep-codigo) + " , " +
                                             string(b-mov-ap-prev.cod-fornec) + " , " +
                                             string(b-mov-ap-prev.cod-estabel)+ " , " +
                                             string(b-mov-ap-prev.cod-esp) + " , " +
                                             string(b-mov-ap-prev.serie) + " , " +
                                             string(b-mov-ap-prev.nr-docto) + " , " +
                                             string(b-mov-ap-prev.parcela) + " , " +
                                             string(b-mov-ap-prev.dt-transacao).
        raw-transfer tt-mov-ap-aux to tt-dados-env.conteudo-msg. 
        assign i-seq = i-seq + 1.
     
    end.
END PROCEDURE.
