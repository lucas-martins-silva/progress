/*********************************************************************************
***
*** app/apapi022.i5 - Procedures Multiplanta.
***
*********************************************************************************/


PROCEDURE PI-CRIA-TT-DADOS-BOR:
    def input parameter i-tipo-movto as integer. 
     
    if  param-global.modulo-mp and tt-replica-msg.log-replica-msg = yes then do: 
     
        create tt-bordero-ap-aux.
        buffer-copy bordero-ap to tt-bordero-ap-aux.
     
        create tt-dados-env.                  
        assign tt-dados-env.num-sequencia  = i-seq 
               tt-dados-env.cod-tipo-reg   = 172
               tt-dados-env.ind-tipo-movto = i-tipo-movto
               tt-dados-env.identif-msg    = string(bordero-ap.ep-codigo)   + " , " +
                                             string(bordero-ap.cod-fornec)  + " , " +
                                             string(bordero-ap.cod-estabel) + " , " +
                                             string(bordero-ap.cod-esp)     + " , " +
                                             string(bordero-ap.serie)       + " , " +
                                             string(bordero-ap.nr-docto)    + " , " +
                                             string(bordero-ap.parcela).
        raw-transfer tt-bordero-ap-aux to tt-dados-env.conteudo-msg.
        assign i-seq = i-seq + 1.
    end.
END PROCEDURE.

