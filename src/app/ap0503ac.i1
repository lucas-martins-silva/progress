/********************************************************************************
***
*** app/ap0503ac.i1 - Cria t¡tulo de Imposto Renda.
***
********************************************************************************/

find first b-espec-ap no-lock
     where b-espec-ap.cod-esp = tt-ant-ir.c-cod-esp no-error.

create b-tit-ap.
assign b-tit-ap.ep-codigo    = tit-ap.ep-codigo        
       b-tit-ap.cod-estabel  = tit-ap.cod-estabel
       b-tit-ap.cod-fornec   = tit-ap.cod-fornec
       b-tit-ap.nome-abrev   = tit-ap.nome-abrev
       b-tit-ap.referencia   = tit-ap.referencia   
       b-tit-ap.serie        = tt-ant-ir.c-serie                          
       b-tit-ap.cod-esp      = tt-ant-ir.c-cod-esp
       b-tit-ap.nr-docto     = tt-ant-ir.c-nr-docto
       b-tit-ap.parcela      = tt-ant-ir.c-parcela                           
       b-tit-ap.tipo         = b-espec-ap.tipo
       b-tit-ap.portador     = tit-ap.portador  
       b-tit-ap.serie-ant    = tit-ap.serie
       b-tit-ap.esp-ant      = tit-ap.cod-esp
       b-tit-ap.docto-ant    = tit-ap.nr-docto
       b-tit-ap.parc-ant     = tit-ap.parcela
       b-tit-ap.matriz       = tit-ap.matriz
       b-tit-ap.dt-transacao = tit-ap.dt-transacao
       b-tit-ap.dt-emissao   = tit-ap.dt-emissao
       b-tit-ap.pedido       = tit-ap.pedido
       b-tit-ap.tp-pagto     = tit-ap.tp-pagto
       b-tit-ap.dt-vencimen  = tt-ant-ir.da-vencimento
       b-tit-ap.dt-fluxo     = tt-ant-ir.da-vencimento
       b-tit-ap.dt-prev-pag  = tt-ant-ir.da-vencimento
       b-tit-ap.cod-retencao = tt-ant-ir.i-cod-retencao
       b-tit-ap.tp-codigo    = tt-ant-ir.i-tp-codigo
       b-tit-ap.valor-ir     = tt-ant-ir.de-tributavel
       b-tit-ap.observacao   = tt-ant-ir.c-historico
       b-tit-ap.ir-antec     = yes.  /* Indica que eh uma antecipacao de IR */
       
assign b-tit-ap.vl-original  = tt-ant-ir.de-vl-impto
       b-tit-ap.vl-orig-me   = tt-ant-ir.de-vl-impto
       b-tit-ap.valor-saldo  = tt-ant-ir.de-vl-impto
       b-tit-ap.vl-saldo-me  = tt-ant-ir.de-vl-impto
       b-tit-ap.cod-impto-ret = tt-ant-ir.i-cod-imposto.

&IF DEFINED (BF_FIN_TAB_PROG_IR) &THEN
    /*--- O titulo atualizaou o tabela progressiva ---*/
    assign b-tit-ap.l-acum-ir = tit-ap.l-acum-ir.
&ENDIF

/*--- Atualiza‡Æo Conta D‚bito ---*/
find first conta-contab no-lock
     where conta-contab.ep-codigo      = tit-ap.ep-codigo
     and   conta-contab.conta-contabil = tt-ant-ir.c-conta-debito no-error.                                          

if  avail conta-contab then do:
    assign b-tit-ap.conta-debito = conta-contab.conta-contabil
           b-tit-ap.ct-conta-db  = conta-contab.ct-codigo
           b-tit-ap.sc-conta-db  = conta-contab.sc-codigo.
end.

/************* MULTIPLATA *************/
run pi-cria-tt-dados-b-tit-ap (input 1).
/**************************************/

/*--- Atualiza dados da Antecipa‡Æo ---*/
if  avail b-espec-ap and b-espec-ap.tipo = 8 then
    assign tit-ap.esp-ant       = b-tit-ap.cod-esp
           tit-ap.serie-ant     = b-tit-ap.serie
           tit-ap.docto-ant     = b-tit-ap.nr-docto
           tit-ap.parc-ant      = b-tit-ap.parcela
           tit-ap.valor-ir      = b-tit-ap.valor-ir
           tit-ap.vl-ir-antec   = b-tit-ap.vl-original
           tit-ap.valor-ir      = b-tit-ap.valor-ir.

if  avail b-espec-ap and b-espec-ap.tipo = 1 and b-espec-ap.log-1 then
    assign b-tit-ap.vl-ir-antec = b-tit-ap.vl-original.

/************ MULTIPLATA ************/
run pi-cria-tt-dados-tit-ap (input 2).
/************************************/

/* Fim de Include */
