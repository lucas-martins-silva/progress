assign i-reg = 0.
output to value(tt-param.diretorio-saida + caps("{2}") + ".d").
for each {1} no-lock:
    assign i-reg = i-reg + 1.
    if  i-reg modulo 10 = 0 then Do:
        {utp/ut-liter.i Exportando:_ *}
        run pi-acompanhar in h-acomp ( Return-value  + caps("{1}") + "-> " + string(i-reg)).
    End.
    export {1} except {1}.r-rowid.  
end.

