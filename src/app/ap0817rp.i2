/*************************************************************************
**
**   Include: ap0817rp.i2 
**
**   Gerar temp-table, para a opcao "Sintetico Dia", quando a
**   contabilizacao foi aberta ou diaria.
*************************************************************************/
conta-block:
for each conta-ap no-lock
    where conta-ap.ep-codigo    = i-ep-codigo-usuario
    and   conta-ap.conta-saldo >= tt-param.c-ini-conta
    and   conta-ap.conta-saldo <= tt-param.c-fim-conta
    break by conta-ap.conta-saldo:
    
    {utp/ut-liter.i Conta: * L}
    run pi-acompanhar in h-acomp (input return-value + " " + conta-ap.conta-saldo).
    
    if  first-of(conta-ap.conta-saldo) then do:
        
        /*Atualiza o t¡tulo da conta*/
        find first conta-contab where
                   conta-contab.ep-codigo      = i-ep-codigo-usuario and
                   conta-contab.conta-contabil = conta-ap.conta-saldo 
                   no-lock no-error.
        if avail conta-contab then
            assign c-titulo-conta = conta-contab.titulo.
        else
            assign c-titulo-conta = "".

        DO da-data = tt-param.dt-ini-period TO tt-param.dt-fim-period:

            for each movimento no-lock
                where movimento.ep-codigo    = conta-ap.ep-codigo
                  and movimento.ct-codigo    = conta-ap.ct-saldo
                  and movimento.sc-codigo    = conta-ap.sc-saldo
                  and movimento.data         = da-data
                break by movimento.data:
                
            case tt-param.moeda:
                when 1 then assign de-vl-moeda = movimento.valor.
                when 2 then assign de-vl-moeda = movimento.valor-fasb.
                when 3 then assign de-vl-moeda = movimento.valor-cmi.
                when 4 then assign de-vl-moeda = movimento.valor-presente.
            end.
                if  movimento.tipo = 1
                or  movimento.tipo = 3 then
                assign de-vl-debito-contab  = de-vl-debito-contab  + de-vl-moeda.
                else
                assign de-vl-credito-contab = de-vl-credito-contab + de-vl-moeda.
        
                if last-of(movimento.data) then do:
                    create tt-concil-ap.
                    assign tt-concil-ap.ct-conta       = movimento.ct-codigo
                           tt-concil-ap.sc-conta       = movimento.sc-codigo
                           tt-concil-ap.debito-contab  = de-vl-debito-contab
                           tt-concil-ap.credito-contab = de-vl-credito-contab
                           tt-concil-ap.dt-contab      = movimento.data
                           tt-concil-ap.refer          = if  c-forma-contab = "diario" then movimento.referencia 
                                                         else ""
                           tt-concil-ap.titulo         = c-titulo-conta.
                end.
            end /*block-movto*/.
    
            /* dados do modulo */
            for each t-diario-ap no-lock
                where t-diario-ap.ep-codigo    = conta-ap.ep-codigo
                and   t-diario-ap.ct-conta     = conta-ap.ct-saldo
                and   t-diario-ap.sc-conta     = conta-ap.sc-saldo
                and   t-diario-ap.dt-transacao = da-data
                break by t-diario-ap.dt-transacao:

                    case tt-param.moeda:
                    	   when 1 then assign de-vl-moeda = if t-diario-ap.lancamento = 1
                                               	         then t-diario-ap.vl-debito
                                               	         else t-diario-ap.vl-credito.
                        when 2 then assign de-vl-moeda = if t-diario-ap.lancamento = 1
                                                         then t-diario-ap.vl-deb-fasb
                                                         else t-diario-ap.vl-cred-fasb.
                        when 3 then assign de-vl-moeda = if t-diario-ap.lancamento = 1
                                                         then t-diario-ap.vl-deb-cmi
                                                         else t-diario-ap.vl-cred-cmi.
                        when 4 then assign de-vl-moeda = if t-diario-ap.lancamento = 1
                                                         then t-diario-ap.vl-deb-presente
                                                         else t-diario-ap.vl-cred-presente.
                    end.
                if  t-diario-ap.lancamento = 1 then
                        assign de-vl-debito-modulo  = de-vl-debito-modulo  + de-vl-moeda.
                else
                        assign de-vl-credito-modulo = de-vl-credito-modulo + de-vl-moeda.

                if  last-of(t-diario-ap.dt-transacao) then do:
                    if  de-vl-debito-contab  = 0
                    and de-vl-credito-contab = 0 then do:
                        create tt-concil-ap.
                        assign tt-concil-ap.ct-conta       = conta-ap.ct-saldo
                               tt-concil-ap.sc-conta       = conta-ap.sc-saldo
                               tt-concil-ap.dt-contab      = da-data
                               tt-concil-ap.titulo         = c-titulo-conta.
                    end.
                    assign tt-concil-ap.dt-modulo      = t-diario-ap.dt-transacao
                           tt-concil-ap.estab          = t-diario-ap.cod-estabel
                           tt-concil-ap.debito-modulo  = de-vl-debito-modulo
                           tt-concil-ap.credito-modulo = de-vl-credito-modulo.
                end.
            end /*block-diario*/.

            assign de-vl-debito-contab  = 0
                   de-vl-credito-contab = 0
                   de-vl-debito-modulo  = 0
                   de-vl-credito-modulo = 0.
        END.
    end.
end /*conta-block*/.
/* Fim de Include */
