/*******************************************************************************
***
*** app/ap0740rp.i11 - first-of(tt-tit-ap.cod-esp).
***
*******************************************************************************/

if  first-of(tt-tit-ap.cod-esp) then do:
    
    find first espec-ap where espec-ap.cod-esp = tt-tit-ap.cod-esp no-lock no-error.
    
    put trim(c-especie)
        " "
        tt-tit-ap.cod-esp
        " - "
        espec-ap.descricao
        skip.
end.

/* Fim de Include */
