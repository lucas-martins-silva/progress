/********************************************************************************
***
*** app/ap0591c.i5 - Cria Movimento.
***
********************************************************************************/




create mov-ap.
assign mov-ap.ep-codigo      = {1}.ep-codigo
       mov-ap.cod-estabel    = {1}.cod-estabel
       mov-ap.cod-esp        = {1}.cod-esp
       mov-ap.serie          = {1}.serie
       mov-ap.cod-fornec     = {1}.cod-fornec
       mov-ap.nome-abrev     = {1}.nome-abrev
       mov-ap.nr-docto       = {1}.nr-docto
       mov-ap.parcela        = {1}.parcela
       mov-ap.tipo           = {1}.tipo
       mov-ap.portador       = {1}.portador
       mov-ap.modalidade     = {1}.modalidade
       mov-ap.vl-original    = {1}.vl-original
       mov-ap.vl-orig-me     = {1}.vl-orig-me
       mov-ap.dt-emissao     = {2}.dt-emissao
       mov-ap.dt-vencimen    = {2}.dt-vencimen
       mov-ap.dt-transacao   = {2}.dt-transacao
       mov-ap.referencia     = {2}.referencia
       mov-ap.moeda          = {2}.moeda
       mov-ap.cotacao-dia    = {2}.cotacao-dia
       mov-ap.lancamento     = if i-pais-impto-usuario <> 4 then {3}
                               else if tit-ap.tipo = 4 then 1 else {3}
       mov-ap.conta-contabil = {4}
       mov-ap.ct-conta       = {5}
       mov-ap.sc-conta       = {6}
       mov-ap.valor-mov      = {7}
       mov-ap.valor-mov-me   = {8}
       mov-ap.transacao      = {9}
       mov-ap.contabilizou   = no
       mov-ap.usuario        = c-seg-usuario
       mov-ap.dt-today       = today
       mov-ap.c-time         = string(time,"HH:MM")
       mov-ap.tp-codigo      = tit-ap.tp-codigo.
       
  if  mov-ap.transacao  = 5
  and mov-ap.lancamento = 2 
  and mov-ap.tipo       = 1 then do:
      assign mov-ap.ind-tp-alter = 4 /*Devolu‡Æo*/.

      if param-global.modulo-fc = yes then do:
         assign r-movapfa = rowid(mov-ap)
         l-erro-cot-fasb = no.

         find first param-fasb where
                    param-fasb.ep-codigo = i-ep-codigo-usuario no-lock no-error.
         if avail param-fasb 
            and   param-fasb.moeda-fasb <> 0 then do:
            run fcp/fc1014a.p (input-output table tt-erro).
         end.
      end.
  end.   
  
find first b-mov-ap of tit-ap no-lock no-error.
if  avail b-mov-ap then do:
    assign mov-ap.fornec-ant     = b-mov-ap.cod-fornec
           mov-ap.esp-ant        = b-mov-ap.cod-esp
           mov-ap.serie-ant      = b-mov-ap.serie
           mov-ap.docto-ant      = b-mov-ap.nr-docto
           mov-ap.parc-ant       = b-mov-ap.parcela.
end.

{app/ap9100.i2}
assign tt-integ-ap.tt-row-mov-ap  = rowid(mov-ap)
       tt-integ-ap.tt-fc1014a     = yes
       tt-integ-ap.tt-fc1114a     = yes.
raw-transfer tt-integ-ap to raw-integracao.
run app/ap9100.p (input raw-integracao, input-output table tt-erro).

/* Fim de Include */

