/*******************************************************************************
***
*** app/ap0742rp.i2 - Defini‡Æo Literais.
***
*******************************************************************************/

if  tt-param.log-imp-param = yes then do:

    {utp/ut-liter.i SELE€ÇO * C}
    assign c-text-1 = trim(return-value).
        
    {utp/ut-liter.i PAR¶METROS * C}
    assign c-text-2 = trim(return-value).
        
    {utp/ut-liter.i IMPRESSÇO * C}
    assign c-text-3 = trim(return-value).
                    
    {utp/ut-liter.i CLASSIFICA€ÇO * C}
    assign c-text-4 = trim(return-value).
    
    {utp/ut-liter.i Estabelecimento}
    assign tt-param.cod-estabel-ini:label in frame f-parametros = trim(return-value).
    
    {utp/ut-liter.i Esp‚cie}
    assign tt-param.cod-esp-ini:label in frame f-parametros = trim(return-value).
    
    {utp/ut-liter.i S‚rie}
    assign tt-param.serie-ini:label in frame f-parametros = trim(return-value).
    
    {utp/ut-liter.i Documento}
    assign tt-param.docto-ini:label in frame f-parametros = trim(return-value).
    
    {utp/ut-liter.i Fornecedor}
    assign tt-param.cod-forn-ini:label in frame f-parametros = trim(return-value).
    
    {utp/ut-liter.i Grupo_Fornecedor}
    assign tt-param.grupo-ini:label in frame f-parametros = trim(return-value).
    
    {utp/ut-liter.i Data_C lculo}
    assign tt-param.dt-trans-ini:label in frame f-parametros = trim(return-value).
    
    {utp/ut-liter.i Moeda}
    assign tt-param.i-moeda:label in frame f-parametros = trim(return-value).
    
    {utp/ut-liter.i T¡tulos}
    assign tt-param.i-titulo-bxa:label in frame f-parametros = trim(return-value).
    
    {utp/ut-liter.i Varia‡äes_a_Considerar}
    assign tt-param.tipo-variacao:label in frame f-parametros = trim(return-value).
    
    {utp/ut-liter.i Arquivo}
    assign tt-param.arquivo:label in frame f-parametros = trim(return-value).
    
    {utp/ut-liter.i Usu rio}
    assign tt-param.usuario:label in frame f-parametros = trim(return-value).
    
    {utp/ut-liter.i Data_Execu‡Æo}
    assign tt-param.data-exec:label in frame f-parametros = trim(return-value).
    
    {utp/ut-liter.i Hora_Execu‡Æo}
    assign tt-param.hora-exec:label in frame f-parametros = trim(return-value).

end.


{utp/ut-liter.i Dt_EmissÆo}
assign tt-mov-ap.dt-emissao:label in frame f-detalhe = trim(return-value).
    
{utp/ut-liter.i Dt_Vencto}
assign tt-mov-ap.dt-vencimen:label in frame f-detalhe = trim(return-value).
                
{utp/ut-liter.i Saldo_Ant}
assign c-label = trim(return-value) + " " + caps(b-moeda.sigla).
    
{utp/ut-liter.i Saldo_Atual}
assign c-label = trim(return-value) + " " + caps(b-moeda.sigla)
       tt-mov-ap.saldo-atualiz-me:label in frame f-detalhe = fill(" ", 1) + trim(c-label).

{utp/ut-liter.i Saldo_Ant}
assign c-label = trim(return-value) + " " + caps(moeda.sigla)
       tt-mov-ap.saldo-anterior:label in frame f-detalhe = fill(" ", 2) + trim(c-label).

{utp/ut-liter.i Varia‡Æo}
assign c-label = trim(return-value) + " " + caps(moeda.sigla)
       tt-mov-ap.vl-variacao:label in frame f-detalhe = trim(c-label).

{utp/ut-liter.i Saldo_Atual}
assign c-label = trim(return-value) + " " + caps(moeda.sigla)
       tt-mov-ap.saldo-atualiz:label in frame f-detalhe = trim(c-label).

{utp/ut-liter.i Data_C lculo}
assign tt-mov-ap.dt-calculo:label in frame f-detalhe = trim(return-value).

{utp/ut-liter.i Var_Baixa}
assign tt-mov-ap.log-baixa:label in frame f-detalhe = trim(return-value).
    
{utp/ut-liter.i Data:}
assign c-data = trim(return-value).

{utp/ut-liter.i Fornecedor:}
assign c-fornecedor = trim(return-value).

{utp/ut-liter.i Grupo_Fornec:}
assign c-grupo = trim(return-value).

{utp/ut-liter.i Total_Dia * L}
assign c-total-dia = trim(return-value).

{utp/ut-liter.i Total_Fornec * L}
assign c-total-fornecedor = trim(return-value).

{utp/ut-liter.i Total_Grupo * L}
assign c-total-grupo = trim(return-value).

{utp/ut-liter.i Total_Geral * L}
assign c-total-geral = trim(return-value).

/* Fim de Include */
