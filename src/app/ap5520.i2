form header
    c-pg  at 121 page-number format ">>99"
    with stream-io no-label no-box no-attr page-bottom width 132 frame f-pagina.

{utp/ut-liter.i PµG}
assign c-pg  = trim(return-value) + ":" .

form
    c-empresa    at 1 empresa.razao-social
    c-endereco   at 1 empresa.endereco
    c-cidade     at 1 empresa.cidade "-" empresa.uf "-" empresa.cep
    c-cgc        at 1 empresa.cgc
    c-banco      at 1 portador.nome
    c-agencia    at 1 portador.agencia
    c-corrente   at 50 c-conta
    c-bordero    at 1 bord-rec.nr-bordero space(3) c-reemissao
    c-data       at 1 da-today format "99/99/9999"
    c-texto-mensag[1] colon 52
    c-texto-mensag[2] colon 52
    "+-------- Para uso do Banco -----------+" at 1
    c-texto-mensag[3] colon 52
    "|" at 1 "|" at 40
    c-texto-mensag[4] colon 52
    "|" at 1 "|" at 40
    c-texto-mensag[5] colon 52
    "|" at 1 "|" at 40
    "|" at 1 "|" at 40
    "|" at 1 "|" at 40
    "+--------------------------------------+" at 1
    "----------------------------------------" at 67 skip (03)
    "----------------------------------------" at 1
    "----------------------------------------" at 41
    "----------------------------------------" at 81
    "------------" at 121
    c-estab       at 1
    c-esp         at 5
    c-serie       at 9
    c-documento   at 16
    c-parc        at 32
    c-fornec      to 45
    c-emissao     at 48
    c-vencimento  at 59
    c-valor-doc   to 85
    c-juros       to 99   
    c-desconto    to 116   
    c-variacao    to 132   
    &IF DEFINED(BF_FIN_MULTA_ABATIMENTO) &THEN
        c-multa          AT 081
        c-abat           AT 096
        c-vl-liq         AT 120
    &ENDIF
    "CPF / CNPJ          " at 01
    c-razao                at 21
    c-praca                at 57
    c-nome-banc            at 78
    c-cont-corrent         at 100    
    &IF DEFINED(BF_FIN_MULTA_ABATIMENTO) &THEN
    &ELSE
        c-vl-liq         at 120
    &ENDIF
    "----------------------------------------" at 1
    "----------------------------------------" at 41
    "----------------------------------------" at 81
    "------------"  at 121
    with stream-io no-box no-label width 132 frame f-empresa.

