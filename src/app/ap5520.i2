form 
    tit-ap.cod-estabel  at 1
    tit-ap.cod-esp      at 5
    tit-ap.serie        at 9
    tit-ap.nr-docto     at 16
    "/"                 at 32
    tit-ap.parcela      at 33
    tit-ap.cod-fornec   to 45
    tit-ap.dt-emissao   at 48
    tit-ap.dt-vencimen  at 59
    tit-ap.valor-saldo  to 85  format ">>>>>>>>>,>>9.99" 
    tit-ap.jur-dia-fasb to 99  format ">>>,>>>,>>9.99"
    tit-ap.vl-desc-fasb to 116
    tit-ap.vl-var-monet to 132 format ">>>>>>>>>,>>9.99" skip
    &IF DEFINED(BF_FIN_MULTA_ABATIMENTO) &THEN
        mov-ap.vl-multa-fasb       TO 091
        mov-ap.vl-abatimento-fasb  TO 111
        de-liquido            format ">>>,>>>,>>9.99"    to 132 skip
    &ENDIF
    c-cgc-fornec            format "x(19)" space(1)
    emitente.nome-emit      format "x(35)"
    emitente.conta-corren format "9999999999-xx"
    &IF DEFINED(BF_FIN_MULTA_ABATIMENTO) &THEN
        skip
    &ELSE
        space(2)
        de-liquido            format ">>>,>>>,>>9.99" skip
    &ENDIF
