/********************************************************************************
***
*** app/ap506irp.i1 - Defini‡Æo Form's / Variaveis.
***
********************************************************************************/

def var c-mensagem     as char format "x(10)" no-undo.
def var c-selecao      as char format "x(10)" no-undo.
def var c-impressao    as char format "x(12)" no-undo.
def var c-destino      as char format "x(16)" no-undo.
def var c-obj-proces   as char                no-undo.
def var i-cont         as integer init 0      no-undo.
def var h-acomp        as handle              no-undo.

form
    che-emit.cod-estabel
    che-emit.cod-esp
    che-emit.serie
    che-emit.nr-docto
    space(0) "/":U space(0)
    che-emit.parcela
    che-emit.cod-fornec
    che-emit.portador
    che-emit.nr-cheque
    che-emit.dt-emissao
    che-emit.valor-docto
    c-mensagem
    with down no-box no-attr-space width 132 stream-io frame f-detalhe.

form 
    skip(1)
    c-selecao no-label skip (1)
    tt-param.portador       colon 45
    tt-param.nr-cheque      colon 45
    tt-param.dt-emissao     colon 45 skip(1)
    c-impressao no-label skip (1)
    c-destino colon 45
    " - "
    tt-param.arquivo no-label format "x(60)":U
    tt-param.usuario colon 45
    with stream-io side-labels no-box width 132 frame f-parametros.
run utp/ut-trfrrp.p (input frame f-detalhe:handle).
run utp/ut-trfrrp.p (input frame f-parametros:handle).

{utp/ut-liter.i Mensagem * L}
assign c-mensagem:label in frame f-detalhe = trim(return-value).

{utp/ut-liter.i OK * L}
assign c-mensagem = return-value.

{utp/ut-liter.i SELE€ÇO * R}
assign c-selecao = trim(return-value).

{utp/ut-liter.i IMPRESSÇO * R}
assign c-impressao = trim(return-value).

{utp/ut-liter.i Usu rio * L}
assign tt-param.usuario:label in frame f-parametros = trim(return-value).

{utp/ut-liter.i Destino * L}
assign c-destino:label in frame f-parametros = trim(return-value)
       c-destino = {varinc/var00002.i 04 tt-param.destino}.

{utp/ut-liter.i Contas_a_Pagar * C}
assign c-sistema = return-value.

{utp/ut-liter.i Cancelamento_de_Cheques_Cancelados * C}
assign c-titulo-relat = return-value.

{utp/ut-liter.i Cheques * R}
assign c-obj-proces = " " + trim(return-value).

assign c-programa = "AP/0506I"
       c-empresa  = empresa.razao-social.

/* Fim de Include */

