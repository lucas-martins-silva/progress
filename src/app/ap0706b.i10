/****************************************************************************
***
*** app/ap0706a.i10 - pi-classif5-moeda2.
***
****************************************************************************/

class-block:
do  on error  undo class-block, return error
    on endkey undo class-block, return error
    on stop   undo class-block, return error:

    {app/ap0706.i9}

    mov-block:
    for each mov-ap use-index codigo no-lock
        where mov-ap.ep-codigo     = i-ep-codigo-usuario
        and   mov-ap.cod-fornec   >= tt-param.fornec-ini
        and   mov-ap.cod-fornec   <= tt-param.fornec-fim
        and   mov-ap.cod-estabel  >= tt-param.estab-ini
        and   mov-ap.cod-estabel  <= tt-param.estab-fim
        and   mov-ap.cod-esp      >= tt-param.espec-ini
        and   mov-ap.cod-esp      <= tt-param.espec-fim
        and   mov-ap.dt-transacao >= tt-param.dt-transac-ini
        and   mov-ap.dt-transacao <= tt-param.dt-transac-fim
        and  (mov-ap.transacao <> 9
        and   mov-ap.transacao <> 10
        and   mov-ap.transacao <> 11
        and   mov-ap.transacao <> 12
        and   mov-ap.transacao <> 13
        and   mov-ap.transacao <> 14
        and   mov-ap.transacao <> 15)
        and   mov-ap.tipo      <> 4
        and   mov-ap.tipo      <> 5
        and  (mov-ap.tipo      <> 7
         or  tt-param.l-lista-op)
            break by mov-ap.cod-fornec
                  by mov-ap.cod-esp
                  by mov-ap.cod-estabel
                  by mov-ap.serie
                  by mov-ap.nr-docto
                  by mov-ap.parcela:

        if mov-ap.transacao = 5 and mov-ap.tipo = 10 and mov-ap.contabiliza = false then
            next.

        assign l-movto = yes.
        
        find first emitente
            where emitente.cod-emitente = mov-ap.cod-fornec
            and   emitente.identific <> 1 no-lock no-error.
        if   avail emitente
        and (emitente.cod-gr-forn < tt-param.grp-forn-ini
        or   emitente.cod-gr-forn > tt-param.grp-forn-fim) then
            next mov-block.

        find espec-ap
            where espec-ap.cod-esp = mov-ap.cod-esp no-lock no-error.
        assign i-tipo-esp = if  avail espec-ap then espec-ap.tipo else 0.

        if  first-of(mov-ap.cod-fornec) then do:
                assign l-prim-forn = yes
                       l-fornec = yes
                       l-existe-movto = no
                       l-prim = yes.
                run pi-acompanhar in h-acomp (input (c-text-acomp + string(mov-ap.cod-fornec))).
                assign i-prazo      = if  de-pr-total <> 0 then
                                          de-prazo / de-pr-total
                                      else 0
                       i-atraso     = if  de-at-total <> 0 then
                                          de-atraso / de-at-total
                                      else 0
                       de-at-geral  = de-at-geral + de-at-total
                       de-pr-geral  = de-pr-geral + de-pr-total
                       de-at-data   = de-at-data  + de-atraso
                       de-pr-data   = de-pr-data  + de-prazo
                       de-pr-total  = 0
                       de-at-total  = 0
                       de-atraso    = 0
                       de-prazo     = 0
                       de-tot-cr    = 0
                       de-tot-db    = 0
                       de-sal-esp   = 0
                       de-tot-esp   = 0.
            end.
        if  first-of(mov-ap.cod-esp) then do:
                assign l-prim-esp = yes
                       de-tot-saldo = 0
                       de-tot-atual = 0
                       de-total-cr  = 0
                       de-total-db  = 0.
        end.
            
        find first tit-ap of mov-ap no-lock no-error.
        if  avail tit-ap then do:
            {app/ap9999.i2 mov-ap tt-param.moeda tit-ap}
        end.
        else do:
            {app/ap9999.i2 mov-ap tt-param.moeda mov-ap}
        end.


        /* éltimo Fornecedor */
        if  i-cod-forn <> mov-ap.cod-fornec and i-cod-forn <> ? then do:
            assign i-prazo      = if  de-pr-total <> 0 then
                                      de-prazo / de-pr-total
                                  else 0
                   i-atraso     = if  de-at-total <> 0 then
                                      de-atraso / de-at-total
                                  else 0
                   i-cod-forn   = ?.
        end.

        /* Primeiro Fornecedor */
        if  (i-cod-forn = ? and mov-ap.cod-fornec <> 0)
        or  l-prim = yes then do:
            assign l-existe-movto = no
                   l-primeiro     = yes
                   l-prim         = no.
        end.


        if  tt-param.l-espec-ctbl = yes and mov-ap.transacao <> 7
        and mov-ap.transacao <> 3 and mov-ap.transacao <> 4 then
            if  not avail espec-ap or espec-ap.contabiliza = no then
                next mov-block.

        if  tt-param.l-prev-saldo = no and mov-ap.transacao = 1 and (i-tipo-esp = 3 or i-tipo-esp = 10) then do:
            next mov-block.
        end.

        /* Demais Registros */
        if  mov-ap.transacao = 7 then do:
            assign de-sal-esp        = de-sal-esp        + de-calc-valor-mov
                   de-tot-esp        = de-tot-esp        + de-calc-valor-mov
                   de-tot-saldo      = de-tot-saldo      + de-calc-valor-mov
                   de-tot-fornec     = de-tot-fornec     + mov-ap.vl-mov-fasb
                   de-tot-saldo-forn = de-tot-saldo-forn + mov-ap.vl-mov-fasb.
        end.
        else do:
            if (mov-ap.transacao = 1 and i-tipo-esp <> 2)
            or (mov-ap.transacao = 5 and mov-ap.lancamento = 1)
            or (mov-ap.transacao = 6 and mov-ap.lancamento = 2)
            or (mov-ap.transacao = 3 and i-tipo-esp = 2)
            or  mov-ap.transacao = 8 or mov-ap.transacao = 4 then do:
                if  i-tipo-esp = 3 then do:
                    assign de-total-cr = de-total-cr + mov-ap.vl-mov-fasb
                           de-total-geral-cr = de-total-geral-cr + mov-ap.vl-mov-fasb                           
                           de-fornec-cr      = de-fornec-cr + mov-ap.vl-mov-fasb.
                end.
                else do:
                    if  i-tipo-esp = 2 and mov-ap.transacao = 3 then do:
                        assign de-total-cr = de-total-cr + mov-ap.vl-ant-fasb
                               de-total-geral-cr = de-total-geral-cr + mov-ap.vl-ant-fasb
                               de-fornec-cr      = de-fornec-cr      + mov-ap.vl-ant-fasb.
                    end.
                    else do:
                        if  mov-ap.transacao <> 8 and mov-ap.transacao <> 4 then do:
                            assign de-total-cr = de-total-cr + mov-ap.vl-mov-fasb
                                   de-total-geral-cr = de-total-geral-cr + mov-ap.vl-mov-fasb
                                   de-fornec-cr      = de-fornec-cr      + mov-ap.vl-mov-fasb.
                        end.
                    end.
                end.
                assign c-tipo = {adinc/i01ad059.i 04 2}
                       c-tp-forn = {adinc/i01ad059.i 04 2}.

                if  mov-ap.transacao = 8 then do:
                    assign de-vl-movto = de-calc-valor-mov + de-calc-valor-juros.
                    if  de-vl-movto < 0 then
                        assign de-total-cr = de-total-cr + (de-vl-movto * -1)
                               de-total-geral-cr = de-total-geral-cr + (de-vl-movto * -1).
                    else
                        assign de-total-db = de-total-db + de-vl-movto
                               de-total-geral-db = de-total-geral-db + de-vl-movto.
                end.
            end.

            if (mov-ap.transacao = 1 and i-tipo-esp = 2)
            or (mov-ap.transacao = 5 and mov-ap.lancamento = 2)
            or (mov-ap.transacao = 6 and mov-ap.lancamento = 1)
            or (mov-ap.transacao = 3 and i-tipo-esp <> 2 and tt-param.l-prev-saldo = yes)
            or  mov-ap.transacao = 2 then do:
                assign de-total-db = de-total-db + mov-ap.vl-mov-fasb -
                                     if  mov-ap.esp-ant >= tt-param.espec-ini
                                     and mov-ap.esp-ant <= tt-param.espec-fim then
                                         mov-ap.vl-ant-fasb else 0
                       de-total-geral-db = de-total-geral-db + mov-ap.vl-mov-fasb -
                                           if  mov-ap.esp-ant >= tt-param.espec-ini
                                           and mov-ap.esp-ant <= tt-param.espec-fim then
                                               mov-ap.vl-ant-fasb else 0
                       c-tipo = {adinc/i01ad059.i 04 1}
                       de-fornec-db      = de-fornec-db      + mov-ap.vl-mov-fasb
                       c-tp-forn         = {adinc/i01ad059.i 04 1}.
            end.

            if  mov-ap.transacao = 3 
            and tt-param.l-prev-saldo = no 
            and i-tipo-esp <> 2 then
                assign c-tipo = {adinc/i01ad059.i 04 1}.

            if  mov-ap.transacao = 1 and i-tipo-esp <> 2
            and ((i-tipo-esp <> 3 and i-tipo-esp <> 10) or tt-param.l-prev-perfil = yes) then do:
                {app/ap0706.i2}
            end.

            if  mov-ap.transacao = 2
            and (mov-ap.dt-transacao > mov-ap.dt-vencimen or tt-param.atraso-medio = 1) then do:
                assign i-data      = mov-ap.dt-transacao - mov-ap.dt-vencimen
                       de-atraso   = de-atraso + (i-data * mov-ap.vl-mov-fasb)
                       de-at-total = de-at-total + mov-ap.vl-mov-fasb.
            end.

            assign c-trans = {adinc/i01ad165.i 04 mov-ap.transacao}
                   l-existe-movto = yes.

            if  (mov-ap.transacao = 3 or mov-ap.transacao = 4) then do:
                assign de-tot-pef = de-tot-pef + if  mov-ap.transacao = 4
                                                 then mov-ap.vl-mov-fasb
                                                 else (- mov-ap.vl-mov-fasb).
            end.

            if  mov-ap.transacao = 4 and i-tipo-esp <> 2 then
                assign c-tipo = {adinc/i01ad059.i 04 2}.

            if  l-prim-forn = yes then do:
                    find b-emitente
                    where b-emitente.cod-emitente = mov-ap.cod-fornec
                    and   b-emitente.identific <> 1 no-lock no-error.
                    disp mov-ap.cod-fornec
                        b-emitente.nome-emit @ emitente.nome-emit
                        with frame f-fornec.
                    assign l-prim-forn = no.
            end.

            if  l-prim-esp = yes then do:
                    disp mov-ap.cod-esp
                         espec-ap.descricao when avail espec-ap
                         with frame f-espec.
                    assign l-prim-esp = no.
            end.
                
            if  tt-param.l-pula-linha = yes then
                put skip(1).
               
        end.

        assign l-entrou = no.
        if  last-of(mov-ap.cod-esp) then do with frame f-tot-espec:                           
                
                assign de-tot-esp   = de-tot-esp   + de-total-cr - de-total-db
                       de-tot-atual = de-tot-saldo + de-total-cr - de-total-db.
                                    
                if  de-tot-saldo >= 0 then do:
                    if  l-existe-movto = yes or de-tot-atual <> 0 then
                        disp {adinc/i01ad059.i 04 2} @ c-tipo.
                    assign de-ger-saldo-cr = de-ger-saldo-cr + de-tot-saldo.
                end.
                else do:
                     if  l-existe-movto = yes or de-tot-atual <> 0 then
                         disp {adinc/i01ad059.i 04 1} @ c-tipo.
                     assign de-tot-saldo = de-tot-saldo * (- 1)
                            de-ger-saldo-db = de-ger-saldo-db + de-tot-saldo.
                end.
                if  de-tot-atual >= 0 then do:
                    if  l-existe-movto = yes or de-tot-atual <> 0 then
                        disp {adinc/i01ad059.i 04 2} @ c-lancto.
                    assign de-ger-atual-cr = de-ger-atual-cr + de-tot-atual.
                end.
                else do:
                     if  l-existe-movto = yes or de-tot-atual <> 0 then
                         disp {adinc/i01ad059.i 04 1} @ c-lancto.
                     assign de-tot-atual = de-tot-atual * (- 1)
                            de-ger-atual-db = de-ger-atual-db + de-tot-atual.
                end.
                            
                if  l-movto = yes then do:    
                    if  de-sal-esp < 0 then do:
                        disp {adinc/i01ad059.i 04 1} @ c-tipo.
                        assign de-sal-esp = de-sal-esp * (-1).
                    end.
                    else
                        disp {adinc/i01ad059.i 04 2} @ c-tipo.

                    if  de-tot-esp < 0 then do:
                        disp {adinc/i01ad059.i 04 1} @ c-lancto.
                        assign de-tot-esp = de-tot-esp * (-1).
                    end.
                    else
                        disp {adinc/i01ad059.i 04 2} @ c-lancto.

                        disp de-sal-esp
                             de-tot-esp
                             with frame f-tot-espec.
               end.
                
                assign de-sal-esp   = 0
                       de-tot-esp   = 0
                       de-tot-cr    = 0
                       de-tot-db    = 0
                       de-total-cr  = 0
                       de-total-db  = 0
                       l-movto      = no
                       l-prim-esp   = yes.
        end.

        if  last-of(mov-ap.cod-fornec) 
        and l-existe-movto = yes then do:
                assign de-tot-fornec = de-tot-fornec + de-fornec-cr - de-fornec-db.

                assign i-prazo      = if  de-pr-total <> 0 then 
                                          de-prazo / de-pr-total else 0
                       i-atraso     = if  de-at-total <> 0 then 
                                          de-atraso / de-at-total else 0.

                if  i-prazo = ? then
                    assign i-prazo = 0.
                    
                if  i-atraso = ? then
                    assign i-atraso = 0.
                    
                if  l-existe-movto = yes 
                or  de-tot-fornec <> 0 then
                    put skip(1).

                assign de-at-geral       = de-at-geral + de-at-total
                       de-pr-geral       = de-pr-geral + de-pr-total
                       de-at-data        = de-at-data  + de-atraso
                       de-pr-data        = de-pr-data  + de-prazo
                       de-fornec-cr      = 0
                       de-fornec-db      = 0
                       de-tot-fornec     = 0
                       de-tot-saldo-forn = 0
                       de-pr-total       = 0
                       de-at-total       = 0
                       de-atraso         = 0
                       de-prazo          = 0
                       l-prim-forn       = yes
                       l-existe-movto    = no.
                
                if  tt-param.l-ficha = yes then 
                    page.
        end.
    end.

    do  with frame f-geral:
                  
        if  de-ger-saldo-cr >= de-ger-saldo-db then do:
            assign de-diferenca = de-ger-saldo-cr - de-ger-saldo-db.
            disp de-diferenca @ de-ger-saldo
              {adinc/i01ad059.i 04 2} @ c-tipo.
        end.
        else do:
            assign de-diferenca = de-ger-saldo-db - de-ger-saldo-cr.
            disp de-diferenca @ de-ger-saldo
              {adinc/i01ad059.i 04 1} @ c-tipo.
        end.
              
         if  de-ger-atual-cr >= de-ger-atual-db then do:
            assign de-diferenca = de-ger-atual-cr - de-ger-atual-db.
            disp de-diferenca @ de-ger-atual
                 {adinc/i01ad059.i 04 2} @ c-lancto.
        end.
        else do:
            assign de-diferenca = de-ger-atual-db - de-ger-atual-cr.
            disp de-diferenca @ de-ger-atual
                 {adinc/i01ad059.i 04 1} @ c-lancto.
        end.
                
        if  de-tot-pef < 0 then
            assign de-tot-pef = de-tot-pef * -1
                   c-db-cr    = {adinc/i01ad059.i 04 1}.
        else
            assign c-db-cr = {adinc/i01ad059.i 04 2}.

        disp de-total-geral-cr
             de-total-geral-db
             de-tot-pef
             c-db-cr.
    end.
end.

/* Fim de Include */
