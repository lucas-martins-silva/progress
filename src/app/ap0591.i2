/******************************************************************************
***                         
*** app/ap0591.i2 - Include arredonda valor do IVA para moeda local 
***                 Somente para Portugal (país 35).
***                             
******************************************************************************/

Find param-fasb where param-fasb.ep-codigo = i-ep-codigo-usuario
                      no-lock no-error.
if  avail param-fasb and param-fasb.moeda-cmi <> 0 then do:
    if  {1}:screen-value in frame {&FRAME-NAME}  = string(param-fasb.moeda-cmi) then do:     
        {2}:screen-value in frame {&FRAME-NAME}  = string(round(input frame {&FRAME-NAME} {2},0)). 
    end.        
end.

/*** Fim da Include ***/    
