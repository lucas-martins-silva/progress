/******************************************************************************
**
** AP0505.I10 - criacao do titulo para pagamento centralizado
**
******************************************************************************/

find first emitente use-index codigo
     where emitente.cod-emitente = tit-ap.cod-fornec
     and   emitente.identific   <> 1 no-lock no-error.

find last c-tit-ap where
     c-tit-ap.ep-codigo   = tit-ap.ep-codigo and
     c-tit-ap.cod-estabel = substr(param-ap.char-1,1,3) and
     c-tit-ap.cod-esp     = param-ap.char-2 and
     c-tit-ap.serie       = tit-ap.serie and
     c-tit-ap.nr-docto    = tit-ap.nr-docto no-error.

find esp-doc where 
     esp-doc.cod-esp = param-ap.char-2 no-lock no-error.
     
if avail c-tit-ap then
   assign c-parcela = substring(c-tit-ap.parcela,1,1) +
                      string(integer(substring(c-tit-ap.parcela,2,1)) + 1).
else 
   assign c-parcela = substring(tit-ap.parcela,1,1) +
                      string(substring(tit-ap.parcela,2,1) + "1").

create d-tit-ap.

assign d-tit-ap.ep-codigo          = tit-ap.ep-codigo
       d-tit-ap.cod-estabel        = substr(param-ap.char-1,1,3)
       d-tit-ap.cod-esp            = param-ap.char-2
       d-tit-ap.serie              = tit-ap.serie
       d-tit-ap.nr-docto           = tit-ap.nr-docto
       d-tit-ap.parcela            = c-parcela
       d-tit-ap.cod-fornec         = tit-ap.cod-fornec
       d-tit-ap.transacao          = 1
       d-tit-ap.referencia         = tt-param.referencia
       d-tit-ap.dt-transacao       = today
       d-tit-ap.dt-emissao         = today
       d-tit-ap.dt-vencimen        = tit-ap.dt-vencimen
       d-tit-ap.vl-saldo           = 0
       d-tit-ap.dt-desconto        = tit-ap.dt-desconto
       d-tit-ap.vl-desconto        = tit-ap.vl-desconto
       d-tit-ap.vl-original        = tit-ap.vl-original
       d-tit-ap.portador           = tt-param.portador
       d-tit-ap.moeda              = 0
       d-tit-ap.origem             = tit-ap.origem
       d-tit-ap.tipo               = 1
       
       d-tit-ap.nr-cheque          = tit-ap.nr-cheque
       d-tit-ap.nome-abrev         = emitente.nome-abrev
       d-tit-ap.calcula-fasb       = if d-tit-ap.moeda = 0 
                                      then yes 
                                      else no
       d-tit-ap.calcula-cmi        = esp-doc.calc-var-cmi
       d-tit-ap.cgc                = emitente.cgc.
       
assign d-tit-ap.vl-juros-dia       = tit-ap.vl-juros-dia
       d-tit-ap.tp-codigo          = tit-ap.tp-codigo
       d-tit-ap.conta-debito       = tit-ap.conta-debito
       d-tit-ap.cotacao-dia        = tit-ap.cotacao-dia
       d-tit-ap.vl-dif-camb        = tit-ap.vl-dif-camb
       d-tit-ap.enviado            = tit-ap.enviado
       d-tit-ap.titulo-banco       = tit-ap.titulo-banco
       d-tit-ap.inst-banc          = tit-ap.inst-banc
       d-tit-ap.vl-liquido         = if d-tit-ap.vl-original > 0 then
                                      d-tit-ap.vl-original -
                                      d-tit-ap.vl-desconto +
                                      d-tit-ap.vl-juros-dia
                                   else 0
       d-tit-ap.vl-orig-me         = tit-ap.vl-orig-me
       d-tit-ap.vl-saldo-me        = 0
       d-tit-ap.vl-desconto-me     = d-tit-ap.vl-desconto-me
       d-tit-ap.vl-taxa-me         = d-tit-ap.vl-taxa-me
       d-tit-ap.vl-liquido-me      = d-tit-ap.vl-liquido-me                             
       d-tit-ap.vl-orig-me         = tit-ap.vl-orig-me
       d-tit-ap.vl-desconto-me     = tit-ap.vl-desconto-me
       d-tit-ap.check-sum          = tit-ap.check-sum.

assign c-matriz = emitente.nome-matriz.
find first emitente use-index codigo
     where emitente.nome-abrev = c-matriz
     and   emitente.identific <> 1 no-lock no-error.
if avail emitente then do:
   assign d-tit-ap.matriz = emitente.cod-emitente.
end.
       
create nota-dup.
assign nota-dup.ep-codigo-n    = tit-ap.ep-codigo
       nota-dup.cod-estabel-n  = tit-ap.cod-estabel
       nota-dup.cod-esp-n      = tit-ap.cod-esp
       nota-dup.serie-n        = tit-ap.serie
       nota-dup.nr-docto-n     = tit-ap.nr-docto
       nota-dup.parcela-n      = tit-ap.parcela
       nota-dup.cod-fornec     = tit-ap.cod-fornec
       nota-dup.cod-estabel-d  = d-tit-ap.cod-estabel
       nota-dup.cod-esp-d      = d-tit-ap.cod-esp
       nota-dup.serie-d        = d-tit-ap.serie
       nota-dup.nr-docto-d     = d-tit-ap.nr-docto
       nota-dup.parcela-d      = d-tit-ap.parcela
       nota-dup.fornec-dup     = d-tit-ap.cod-fornec
       nota-dup.dt-transacao   = today
       nota-dup.referencia     = d-tit-ap.referencia.
       
/** Criar historico **/

assign i-seq-hist = 1.

find last his-d-ap
     where his-d-ap.ep-codigo = d-tit-ap.ep-codigo
     and his-d-ap.cod-estabel = d-tit-ap.cod-estab
     and his-d-ap.cod-esp     = d-tit-ap.cod-esp
     and his-d-ap.serie       = d-tit-ap.serie
     and his-d-ap.nr-docto    = d-tit-ap.nr-docto
     and his-d-ap.parcela     = d-tit-ap.parcela
     and his-d-ap.dt-his-doc  = d-tit-ap.dt-emissao
     no-lock no-error.

if avail his-d-ap then 
   assign i-seq-hist = his-d-ap.sequencia + 1.
   
{utp/ut-liter.i Enviada_mensagem_n£mero MAP R}
create his-d-ap.
assign his-d-ap.ep-codigo   = d-tit-ap.ep-codigo
       his-d-ap.cod-estabel = d-tit-ap.cod-estab
       his-d-ap.cod-esp     = d-tit-ap.cod-esp
	his-d-ap.serie       = d-tit-ap.serie
	his-d-ap.nr-docto    = d-tit-ap.nr-docto
	his-d-ap.parcela     = d-tit-ap.parcela
	his-d-ap.cod-fornec  = d-tit-ap.cod-fornec
	his-d-ap.dt-his-doc  = d-tit-ap.dt-emissao
	his-d-ap.historico   = return-value.

/***** Impostos *****/
{app/ap0586.i12 "d-tit-ap"
                "ap0586"}

/* Fim include */
