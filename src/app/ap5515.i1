/*******************************************************************************
**
**   AP5515.i1 - Atualiza se o tipo de documento do bordero for um Pagamento
**               Extra Fornecedor.
**
*******************************************************************************/
create mov-ap.
assign mov-ap.ep-codigo    = bordero-ap.ep-codigo
       mov-ap.cod-estabel  = bordero-ap.cod-estabel
       mov-ap.cod-esp      = bordero-ap.cod-esp
       mov-ap.serie        = bordero-ap.serie
       mov-ap.nr-docto     = bordero-ap.nr-docto
       mov-ap.parcela      = bordero-ap.parcela
       mov-ap.cod-fornec   = bordero-ap.cod-fornec
       mov-ap.referencia   = bordero-ap.referencia
       mov-ap.transacao    = bordero-ap.transacao
       mov-ap.dt-emissao   = bord-ap.dt-emissao
       mov-ap.dt-vencimen  = bord-ap.dt-emissao
       mov-ap.dt-transacao = bord-ap.dt-emissao
       mov-ap.dt-pagamento = bord-ap.dt-emissao
       mov-ap.valor-mov    = bordero-ap.vl-docto
       mov-ap.portador     = bordero-ap.portador
       mov-ap.nr-cheque    = 0
       mov-ap.ct-conta     = bordero-ap.ct-codigo
       mov-ap.sc-conta     = bordero-ap.sc-codigo
       mov-ap.historico    = bordero-ap.historico
       mov-ap.nr-bordero   = bordero-ap.nr-bordero
       mov-ap.tp-codigo    = bordero-ap.tp-codigo
       mov-ap.dt-today     = today
       mov-ap.c-time       = string(time, "HH:MM")
       mov-ap.usuario      = c-seg-usuario
       l-antecip           = no.

find emitente
     where emitente.cod-emit = mov-ap.cod-fornec
     and   emitente.identific <> 1 no-lock no-error.
if  avail emitente then
    assign mov-ap.nome-abrev = emitente.nome-abrev.

find tit-ap
    where tit-ap.ep-codigo   = bordero-ap.ep-codigo
    and   tit-ap.cod-estabel = bordero-ap.cod-estabel
    and   tit-ap.cod-esp     = bordero-ap.cod-esp
    and   tit-ap.serie       = bordero-ap.serie
    and   tit-ap.nr-docto    = bordero-ap.nr-docto
    and   tit-ap.parcela     = bordero-ap.parcela
    and   tit-ap.cod-fornec  = bordero-ap.cod-fornec
    no-error.
if  avail tit-ap then do:
    assign de-valor-saldo = tit-ap.valor-saldo.
    if  tit-ap.tipo = 2 then do:
         /*-------- INTEGRA€åES ELIMINA ---------*/
       {app/ap9100.i2}
        assign  tt-integ-ap.tt-row-tit-ap  = rowid(tit-ap)
                tt-integ-ap.tt-row-mov-ap  = rowid(mov-ap)
                tt-integ-ap.tt-ge0102g     = yes
                tt-integ-ap.tt-cb1202a     = yes       
                tt-integ-ap.tt-op-ge0102g  = 6
                tt-integ-ap.tt-op-cb1202a  = 6.
        raw-transfer tt-integ-ap to raw-integracao.
        run app/ap9100.p (Input raw-integracao,
                          input-output table tt-erro).                    

        assign tit-ap.valor-saldo  = if  bordero-ap.transacao = 3 then
                                         tit-ap.valor-saldo
                                       - bordero-ap.vl-docto
                                     else
                                         tit-ap.valor-saldo
                                       + bordero-ap.vl-docto
               tit-ap.dt-ult-pagto = bord-ap.dt-emissao
               tit-ap.nr-bordero   = bordero-ap.nr-bordero
               mov-ap.esp-ant      = bordero-ap.cod-esp
               mov-ap.serie-ant    = bordero-ap.serie
               mov-ap.docto-ant    = bordero-ap.nr-docto
               mov-ap.parc-ant     = bordero-ap.parcela
               mov-ap.vl-antecip   = bordero-ap.vl-docto
               l-antecip           = yes.

         /*-------- INTEGRA€åES INCLUSÇO ---------*/
        {app/ap9100.i2}
        assign  tt-integ-ap.tt-row-tit-ap  = rowid(tit-ap)
                tt-integ-ap.tt-row-mov-ap  = rowid(mov-ap)
                tt-integ-ap.tt-ge0102g     = yes
                tt-integ-ap.tt-cb1202a     = yes       
                tt-integ-ap.tt-op-ge0102g  = 16
                tt-integ-ap.tt-op-cb1202a  = 16.
        raw-transfer tt-integ-ap to raw-integracao.
        run app/ap9100.p (Input raw-integracao,
                          input-output table tt-erro).                    
    end.
    else
        if  tit-ap.tipo = 3 then do:
            if  tit-ap.moeda = 0 then
                assign de-vl-bord-conv = bordero-ap.vl-docto.
            else do:
                {cdp/cd9600.i "tit-ap.moeda" "bord-ap.dt-emissao" "de-fator"}
                
                if  avail cotacao then
                    assign de-vl-bord-conv = bordero-ap.vl-docto / de-fator.
            end.
             /*-------- INTEGRA€åES ELIMINA ---------*/
            {app/ap9100.i2}
            assign   tt-integ-ap.tt-row-tit-ap  = rowid(tit-ap)
                     tt-integ-ap.tt-row-mov-ap  = rowid(mov-ap)
                     tt-integ-ap.tt-cb0110a     = yes
                     tt-integ-ap.tt-cb1202a     = yes
                     tt-integ-ap.tt-op-cb0110a  = 6
                     tt-integ-ap.tt-op-cb1202a  = 6.
            raw-transfer tt-integ-ap to raw-integracao.
            run app/ap9100.p (Input raw-integracao,
                              input-output table tt-erro).                    
            assign de-total = if bordero-ap.transacao = 3 then
                                 tit-ap.valor-saldo - de-vl-bord-conv
                              else tit-ap.valor-saldo + de-vl-bord-conv
                   tit-ap.valor-saldo = if de-total < 0 then 0
                                        else de-total.
          
            /*-------- INTEGRA€åES INCLUSÇO  ---------*/
            {app/ap9100.i2}
            assign   tt-integ-ap.tt-row-tit-ap  = rowid(tit-ap)
                     tt-integ-ap.tt-row-mov-ap  = rowid(mov-ap)
                     tt-integ-ap.tt-cb0110a     = yes
                     tt-integ-ap.tt-cb1202a     = yes
                     tt-integ-ap.tt-op-cb0110a  = 16
                     tt-integ-ap.tt-op-cb1202a  = 16.
            raw-transfer tt-integ-ap to raw-integracao.
            run app/ap9100.p (Input raw-integracao,
                              input-output table tt-erro).
 
        end.
        else
            if  bordero-ap.vl-docto >= tit-ap.valor-saldo then
                assign tit-ap.valor-saldo = 0.
    assign tit-ap.nr-bordero = bordero-ap.nr-bordero.
end.

/* Atualizacao de informacoes para gerencial */
  {app/ap9100.i2}
  assign   tt-integ-ap.tt-row-tit-ap  = rowid(tit-ap)
           tt-integ-ap.tt-row-mov-ap  = rowid(mov-ap)
           tt-integ-ap.tt-ge0102b     = yes
           tt-integ-ap.tt-cb1202a     = yes
           tt-integ-ap.tt-cb0201a     = yes
           tt-integ-ap.tt-fc1014a     = yes
           tt-integ-ap.tt-fc1114a     = yes
           tt-integ-ap.tt-op-ge0102b  = 2
           tt-integ-ap.tt-op-cb0201a  = 16
           tt-integ-ap.tt-op-cb1202a  = 21.

  raw-transfer tt-integ-ap to raw-integracao.
  run app/ap9100.p (Input raw-integracao,
                    input-output table tt-erro).
   


/* AP0517. I3 */

