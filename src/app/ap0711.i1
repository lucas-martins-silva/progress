/******************************************************************************
**
**  APP/AP0711.I1
**  Objetivo :   Dar display dos mov-ap's com quebra por fornecedor
**
*******************************************************************************/

{cdp/cdcfgfin.i}

assign l-primeiro = no
       l-ultimo = no.

do da-data-sel = {1} to {2}:
    mov-block:
    for each mov-ap use-index data 
        where mov-ap.ep-codigo     = tt-param.i-ep-codigo
        and   mov-ap.cod-fornec   >= tt-param.for-ini
        and   mov-ap.cod-fornec   <= tt-param.for-fim
        and   mov-ap.cod-estabel  >= tt-param.est-ini
        and   mov-ap.cod-estabel  <= tt-param.est-fim
        and   mov-ap.cod-esp      >= tt-param.esp-ini
        and   mov-ap.cod-esp      <= tt-param.esp-fim
        and   mov-ap.nr-cheque    >= tt-param.nr-cheque-ini
        and   mov-ap.nr-cheque    <= tt-param.nr-cheque-fim
        and   mov-ap.nr-bordero   >= tt-param.bordero-ini
        and   mov-ap.nr-bordero   <= tt-param.bordero-fim
        and   mov-ap.portador     >= tt-param.portador-ini
        and   mov-ap.portador     <= tt-param.portador-fim
        and   mov-ap.dt-transacao  = da-data-sel no-lock:
        
        if  mov-ap.cod-esp <> " " then do:        
            find first tit-ap
                 where tit-ap.ep-codigo   = mov-ap.ep-codigo
                 and   tit-ap.cod-estabel = mov-ap.cod-estabel
                 and   tit-ap.cod-esp     = mov-ap.cod-esp
                 and   tit-ap.serie       = mov-ap.serie
                 and   tit-ap.nr-docto    = mov-ap.nr-docto
                 and   tit-ap.parcela     = mov-ap.parcela
                 and   tit-ap.cod-fornec  = mov-ap.cod-fornec no-lock no-error.

            if  not avail tit-ap then
                next.
        end.

        {cdp/cd9600.i "tt-param.moeda"
                      "tt-param.dt-conversao"
                      "de-calc-cotacao"
                      "return error."}

        if  mov-ap.cod-esp <> " " then do:                
            {app/ap9999.i2 "mov-ap"
                           "tt-param.moeda"
                           "tit-ap"}
        end.
        else do:
            {app/ap9999.i2 "mov-ap"
                           "tt-param.moeda"
                           "mov-ap"}    
        end.

        find espec-ap
            where espec-ap.cod-esp = mov-ap.cod-esp no-lock no-error.
        assign i-tipo-esp = if  avail espec-ap then espec-ap.tipo else 0.

        if  mov-ap.transacao  = 5 
        and mov-ap.lancamento = 1 then
            next mov-block.
        
        if  i-tipo-esp = 2
        and tt-param.tipo <> 5
        and tt-param.tipo <> 4
        and tt-param.tipo <> 2 then
            next mov-block.

        if  (mov-ap.transacao   = 3 
        or   mov-ap.transacao   = 4)
        and  mov-ap.portador    > 0
        and  mov-ap.port-transf > 0
        and  tt-param.transf    = no then
            next mov-block.
        
        if  tt-param.acerto = yes then do:
            if  mov-ap.transacao <> {3}
            and mov-ap.transacao <> {4}
            and mov-ap.transacao <> {5}
            and mov-ap.transacao <> {6}
            and mov-ap.transacao <> {7} then
                next mov-block.
        end.
        else do:
            if  mov-ap.transacao <> {3}
            and mov-ap.transacao <> {4}
            and mov-ap.transacao <> {5}
            and mov-ap.transacao <> {6} then
                next mov-block.
        end.

        if  mov-ap.transacao = 3 
        and i-tipo-esp       = 2
        and mov-ap.portador  = 0 then
            next mov-block.
        
        if  mov-ap.transacao = 1 
        and i-tipo-esp       = 2 
        and mov-ap.portador  = 0 
        and mov-ap.referencia begins "TRAN" then 
            next.        

        if  tt-param.tipo = 1
        and mov-ap.referencia begins "BORD" then next mov-block.


        if  tt-param.tipo = 1 
        or  tt-param.tipo = 2 
        or  tt-param.tipo = 5 then do:
            if  mov-ap.transacao = 4 or mov-ap.transacao = 3 then
                assign de-valor-conv = de-calc-valor-mov. 
            else
                assign de-valor-conv = de-calc-valor-mov - de-calc-vl-antecip. 

           if  de-valor-conv = 0 then
               next mov-block.

        end.
        else
           assign de-valor-conv = de-calc-valor-mov.

        if (tt-param.tipo    = 4
        or (tt-param.tipo    = 5 
        and mov-ap.transacao = 1))
        and i-tipo-esp      <> 2 then
            next mov-block.

        find emitente
            where emitente.cod-emitente = mov-ap.cod-fornec
            and   emitente.identific   <> 1
            and   emitente.cod-gr-forn >= tt-param.grupo-ini
            and   emitente.cod-gr-forn <= tt-param.grupo-fim no-lock no-error.
        if  not avail emitente then 
            next.

        if  mov-ap.cod-esp <> "" and avail tit-ap then
            assign da-vencim = tit-ap.dt-vencimen.
        else
            assign da-vencim = mov-ap.dt-vencimen.

        find calen-coml
            where calen-coml.ep-codigo   = mov-ap.ep-codigo
            and   calen-coml.cod-estabel = mov-ap.cod-estabel
            and   calen-coml.data        = da-vencim
            no-lock no-error.
        if  avail calen-coml then do:
            assign i-semana = weekday(da-vencim).
            if  calen-coml.tipo-dia <> 1 then do:
                if  (i-semana = 7 and emitente.ven-sabado = 1)
                or  (i-semana = 1 and emitente.ven-domingo = 1)
                or  (i-semana > 1 and i-semana < 7
                and emitente.ven-feriado = 1) then repeat:
                    assign da-vencim = da-vencim + 1.
                    find calen-coml
                        where calen-coml.ep-codigo = mov-ap.ep-codigo
                        and   calen-coml.cod-estabel = mov-ap.cod-estabel
                        and   calen-coml.data  = da-vencim
                        no-lock no-error.
                    if  not avail calen-coml then do:
                        run utp/ut-msgs.p (input "help",
                                           input 1723,
                                           input string(mov-ap.ep-codigo) + "~~" +
                                                 string(mov-ap.cod-estabel) + "~~" + 
                                                 string(da-vencim)).
                        assign c-mensagem = return-value.
                        disp c-mensagem with frame f-mensagem.
                        leave.
                    end.
                    if  calen-coml.tipo = 1 then
                        leave.
                end.

                if  (i-semana = 7 and emitente.ven-sabado = 2)
                or  (i-semana = 1 and emitente.ven-domingo = 2)
                or  (i-semana > 1 and i-semana < 7
                and emitente.ven-feriado = 2) then repeat:
                    assign da-vencim = da-vencim - 1.
                    find calen-coml
                        where calen-coml.ep-codigo = mov-ap.ep-codigo
                        and   calen-coml.cod-estabel = mov-ap.cod-estabel
                        and   calen-coml.data  = da-vencim
                        no-lock no-error.
                    if  not avail calen-coml then do:
                        run utp/ut-msgs.p (input "help",
                                           input 1723,
                                           input string(mov-ap.ep-codigo) + "~~" +
                                                 string(mov-ap.cod-estabel) + "~~" +
                                                 string(da-vencim)).      
                        assign c-mensagem = return-value.
                        disp c-mensagem with frame f-mensagem.
                        leave.
                    end.
                    if  calen-coml.tipo-dia = 1 then
                        leave.
                end.
            end.
        end.

        if  da-vencim = mov-ap.dt-transacao then
            assign atraso = 0.
        else
            if  mov-ap.cod-esp <> "" and avail tit-ap then
                assign atraso = (mov-ap.dt-transacao - tit-ap.dt-vencimen).
            else
                assign atraso = (mov-ap.dt-transacao - mov-ap.dt-vencimen).

        assign de-juros-conv = de-calc-valor-juros
               de-desc-conv  = de-calc-vl-desconto
               &if defined(BF_FIN_MULTA_ABATIMENTO) &then
               de-multa-conv = de-calc-valor-multa
               de-abat-conv  = de-calc-valor-abat
               &endif
               c-docto       = fill(" ", 16 - length(mov-ap.nr-docto)) + mov-ap.nr-docto.


        if mov-ap.transacao = 4 then
           assign de-valor-conv = de-valor-conv * -1.

            create t-mov-ap.
            assign t-mov-ap.cod-estabel   = mov-ap.cod-estabel
                   t-mov-ap.cod-esp       = mov-ap.cod-esp
                   t-mov-ap.serie         = mov-ap.serie
                   t-mov-ap.c-docto       = c-docto
                   t-mov-ap.parcela       = mov-ap.parcela
                   t-mov-ap.nr-bordero    = mov-ap.nr-bordero
                   t-mov-ap.referencia    = mov-ap.referencia
                   t-mov-ap.portador      = mov-ap.portador
                   t-mov-ap.dt-vencimen   = if mov-ap.cod-esp <> "" and avail tit-ap then tit-ap.dt-vencimen else mov-ap.dt-vencimen
                   t-mov-ap.dt-transacao  = mov-ap.dt-transacao
                   t-mov-ap.de-valor-conv = de-valor-conv
                   t-mov-ap.de-juros-conv = de-juros-conv
                   t-mov-ap.de-desc-conv  = de-desc-conv
                   &if defined(BF_FIN_MULTA_ABATIMENTO) &then
                   t-mov-ap.de-multa-conv = de-multa-conv
                   t-mov-ap.de-abat-conv  = de-abat-conv
                   &endif
                   t-mov-ap.atraso        = atraso
                   t-mov-ap.nr-cheque     = mov-ap.nr-cheque
                   t-mov-ap.transacao     = mov-ap.transacao
                   t-mov-ap.cod-fornec    = mov-ap.cod-fornec
                   t-mov-ap.i-tipo-esp    = i-tipo-esp
                   t-mov-ap.historico     = mov-ap.historico.
    end.    
end.


view frame f-cab-mov.
for each t-mov-ap no-lock
    break by t-mov-ap.cod-fornec
          by t-mov-ap.dt-transacao:
    if first-of(t-mov-ap.cod-fornec) then do:
       find emitente
            where emitente.cod-emitente = t-mov-ap.cod-fornec
            and   emitente.identific   <> 1
            and   emitente.cod-gr-forn >= tt-param.grupo-ini
            and   emitente.cod-gr-forn <= tt-param.grupo-fim no-lock no-error.
       if  avail emitente then do:   
           disp c-emitente
                emitente.cod-emitente
                emitente.nome-emit
                emitente.cidade
                emitente.telefone[1] 
                with frame f-emitente.  
       end.
    end.

    if (t-mov-ap.transacao = 3 
    and t-mov-ap.i-tipo-esp       = 2) then do:
        assign de-ger-pagto = de-ger-pagto - t-mov-ap.de-valor-conv
               de-tot-pagto = de-tot-pagto - t-mov-ap.de-valor-conv
               de-ger-juros = de-ger-juros - t-mov-ap.de-juros-conv
               de-tot-juros = de-tot-juros - t-mov-ap.de-juros-conv
               de-ger-desc  = de-ger-desc  - t-mov-ap.de-desc-conv
               de-tot-desc  = de-tot-desc  - t-mov-ap.de-desc-conv.
        &if defined(BF_FIN_MULTA_ABATIMENTO) &then
        assign de-ger-multa = de-ger-multa - t-mov-ap.de-multa-conv
               de-tot-multa = de-tot-multa - t-mov-ap.de-multa-conv
               de-ger-abat  = de-ger-abat  - t-mov-ap.de-abat-conv
               de-tot-abat  = de-tot-abat  - t-mov-ap.de-abat-conv.
        &endif
    end.
    else do:
        assign de-ger-pagto = de-ger-pagto + t-mov-ap.de-valor-conv
               de-tot-pagto = de-tot-pagto + t-mov-ap.de-valor-conv
               de-ger-juros = de-ger-juros + t-mov-ap.de-juros-conv
               de-tot-juros = de-tot-juros + t-mov-ap.de-juros-conv
               de-ger-desc  = de-ger-desc  + t-mov-ap.de-desc-conv
               de-tot-desc  = de-tot-desc  + t-mov-ap.de-desc-conv.
        &if defined(BF_FIN_MULTA_ABATIMENTO) &then
        assign de-ger-multa = de-ger-multa + t-mov-ap.de-multa-conv
               de-tot-multa = de-tot-multa + t-mov-ap.de-multa-conv
               de-ger-abat  = de-ger-abat  + t-mov-ap.de-abat-conv
               de-tot-abat  = de-tot-abat  + t-mov-ap.de-abat-conv.
        &endif
    end.


       disp t-mov-ap.cod-estabel   @ mov-ap.cod-estabel
            t-mov-ap.cod-esp       @ mov-ap.cod-esp
            t-mov-ap.serie         @ mov-ap.serie
            t-mov-ap.c-docto       @ c-docto
            t-mov-ap.parcela       @ mov-ap.parcela
            t-mov-ap.nr-bordero    @ mov-ap.nr-bordero
            t-mov-ap.referencia    @ mov-ap.referencia
            t-mov-ap.portador      @ mov-ap.portador
            t-mov-ap.dt-vencimen   @ mov-ap.dt-vencimen
            t-mov-ap.dt-transacao  @ mov-ap.dt-transacao
            t-mov-ap.atraso        @ atraso
            t-mov-ap.nr-cheque     @ mov-ap.nr-cheque
            t-mov-ap.de-valor-conv @ de-valor-conv
            t-mov-ap.de-juros-conv @ de-juros-conv
            t-mov-ap.de-desc-conv  @ de-desc-conv
            &if defined(BF_FIN_MULTA_ABATIMENTO) &then
            t-mov-ap.de-multa-conv @ de-multa-conv
            t-mov-ap.de-abat-conv  @ de-abat-conv
            &endif
            with frame f-mov-impl2.
       down with frame f-mov-impl2.

    if  tt-param.lista    =  yes
    and (t-mov-ap.transacao = 3 or t-mov-ap.transacao = 4)
    and t-mov-ap.historico <> " " then do:
        disp t-mov-ap.historico @ mov-ap.historico
             with frame f-historico.
        down with frame f-historico.
    end.

    if last-of(t-mov-ap.cod-fornec) then do:
       disp c-total
            de-tot-pagto
            de-tot-juros space(1)
            de-tot-desc
            &if defined(BF_FIN_MULTA_ABATIMENTO) &then
            de-tot-multa
            de-tot-abat
            &endif
            with frame f-total.
       assign de-tot-pagto = 0
              de-tot-juros = 0
              de-tot-desc  = 0
              &if defined(BF_FIN_MULTA_ABATIMENTO) &then
              de-tot-multa = 0
              de-tot-abat  = 0
              &endif
              atraso     = 0
              l-ultimo     = no.
    end.    
end.               

hide frame f-cab-mov.

disp c-geral
    de-ger-pagto
    de-ger-juros space(1)
    de-ger-desc
    &if defined(BF_FIN_MULTA_ABATIMENTO) &then
    de-ger-multa
    de-ger-abat
    &endif
    with frame f-geral.

assign de-ger-pagto = 0
       de-ger-juros = 0
       de-ger-desc  = 0
       &if defined(BF_FIN_MULTA_ABATIMENTO) &then
       de-ger-multa = 0
       de-ger-abat  = 0
       &endif.

/*  AP0711.i1 */
