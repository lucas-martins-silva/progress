/*********************************************************************************
*
* Defini‡Æo de Temp-Tables.             
*
*
*********************************************************************************/

define temp-table tt-param
    field destino          as integer
    field arquivo          as char
    field usuario          as char format "x(12)"
    field data-exec        as date
    field hora-exec        as integer
    field classifica       as integer
    field desc-classifica  as char format "x(40)"
    field estab-ini        like tit-ap.cod-estabel
    field estab-fim        like tit-ap.cod-estabel
    field for-ini          like emite-ap.cod-fornec
    field for-fim          like emite-ap.cod-fornec
    field esp-ini          like tit-ap.cod-esp
    field esp-fim          like tit-ap.cod-esp
    field venc-ini         like emite-ap.dt-vencimen
    field venc-fim         like emite-ap.dt-vencimen
    field emis-ini         like emite-ap.dt-vencimen
    field emis-fim         like emite-ap.dt-vencimen
    field trans-ini        like tit-ap.dt-transacao 
    field trans-fim        like tit-ap.dt-transacao
    field serie-ini        like tit-ap.serie
    field serie-fim        like tit-ap.serie
    field i-ep-codigo      like empresa.ep-codigo
    field num-ini          as char format "x(16)"
    field num-fim          as char format "x(16)"
    field parc-ini         as char
    field parc-fim         as char
    field reemissao        as logical
    field considera        as logical
    field folha            as integer
    field log-pag-parametros   as logical.

define temp-table tt-digita
    field ep-codigo    like tit-ap.ep-codigo
    field cod-estabel  like tit-ap.cod-estabel
    field cod-esp      like tit-ap.cod-esp
    field serie        like tit-ap.serie
    field nr-docto     like tit-ap.nr-docto
    field parcela      like tit-ap.parcela
    field fornec       like tit-ap.cod-fornec
    field vl-saldo     like tit-ap.valor-saldo
    field nome-abrev   like tit-ap.nome-abrev
    field dt-vencto    like tit-ap.dt-vencimen
    field dt-emissao   like tit-ap.dt-emissao
    field dt-transacao like tit-ap.dt-transacao
    field marcado      as log
    field confirma     as log
    field rw-digita    as rowid
    index codigo ep-codigo
                 cod-estabel
                 cod-esp
                 serie
                 nr-docto
                 parcela
                 fornec.

