/****************************************************************************
**                                                                           
** AP0706.I6
** Objetivo: Calcular o saldo anterior, considerando ou nÆo previsao.
**
****************************************************************************/
assign de-tot-cr = 0
       de-tot-db = 0.
       
for each tit-ap use-index {2} no-lock
    where tit-ap.ep-codigo     = i-ep-codigo-usuario
    {1}
    and   tit-ap.cod-fornec   >=  tt-param.fornec-ini
    and   tit-ap.cod-fornec   <=  tt-param.fornec-fim
    and   tit-ap.dt-liq       >= tt-param.dt-transac-ini
    and   tit-ap.cod-estabel  >= tt-param.estab-ini
    and   tit-ap.cod-estabel  <= tt-param.estab-fim
    and   tit-ap.cod-esp      >= tt-param.espec-ini
    and   tit-ap.cod-esp      <= tt-param.espec-fim
    and   tit-ap.dt-transacao  < tt-param.dt-transac-ini
    and   tit-ap.tipo         <> 4
    and   tit-ap.tipo         <> 5
    and  (tit-ap.tipo         <> 7
    or    tt-param.l-lista-op)
    break by {3}
          by tit-ap.dt-transacao
          by tit-ap.cod-estabel
          by tit-ap.cod-esp
          by tit-ap.serie
          by tit-ap.nr-docto
          by tit-ap.parcela:
          
    {app/ap9999.i1 tit-ap tt-param.moeda}

    assign l-valido = yes.
    

    find espec-ap
        where espec-ap.cod-esp = tit-ap.cod-esp no-lock no-error.
        
    if  not avail espec-ap
    or (avail espec-ap and espec-ap.contabiliza = no and tt-param.l-espec-ctbl = yes) then
        assign l-valido = no.

    if  l-valido = yes then do:
                
        if  tit-ap.tipo <> 2 then do:
                                
            assign de-tot-cr = de-tot-cr + de-calc-valor-saldo.
                                
            if  tit-ap.valor-saldo <> tit-ap.vl-original then do:
                for each mov-ap use-index codigo
                    where mov-ap.ep-codigo     = tit-ap.ep-codigo
                    and   mov-ap.cod-fornec    = tit-ap.cod-fornec
                    and   mov-ap.cod-estabel   = tit-ap.cod-estabel
                    and   mov-ap.cod-esp       = tit-ap.cod-esp
                    and   mov-ap.serie         = tit-ap.serie
                    and   mov-ap.nr-docto      = tit-ap.nr-docto
                    and   mov-ap.parcela       = tit-ap.parcela
                    and   mov-ap.dt-transacao >= tt-param.dt-transac-ini
                    and  (mov-ap.transacao     = 2
                    or   (mov-ap.transacao     = 6 and mov-ap.lancamento = 1)
                    or    mov-ap.transacao     = 3
                    or    mov-ap.transacao     = 5) no-lock:
                        
                    {app/ap9999.i2 mov-ap tt-param.moeda tit-ap}
                        
                    assign de-tot-cr = if  mov-ap.transacao = 5 and mov-ap.lancamento = 1 then
                                           de-tot-cr - de-calc-valor-mov
                                       else 
                                           de-tot-cr + de-calc-valor-mov.
                                       
                end.
            end.
        end.
        else do:
        
            assign de-tot-db = de-tot-db + de-calc-valor-saldo.
                        
            for each mov-ap use-index ch-antecip
                where mov-ap.ep-codigo     = tit-ap.ep-codigo
                and   mov-ap.cod-estabel   = tit-ap.cod-estabel
                and   mov-ap.esp-ant       = tit-ap.cod-esp
                and   mov-ap.serie-ant     = tit-ap.serie
                and   mov-ap.docto-ant     = tit-ap.nr-docto
                and   mov-ap.parc-ant      = tit-ap.parcela
                and   mov-ap.fornec-ant    = tit-ap.cod-fornec
                and   mov-ap.dt-transacao >= tt-param.dt-transac-ini
                and  (mov-ap.transacao     = 2
                or    mov-ap.transacao     = 3) no-lock:
                    
                {app/ap9999.i2 mov-ap tt-param.moeda tit-ap}
                            
                assign de-tot-db = de-tot-db + de-calc-vl-antecip.
                    
            end.
    
            for each mov-ap use-index codigo
                where mov-ap.ep-codigo     = tit-ap.ep-codigo
                and   mov-ap.cod-fornec    = tit-ap.cod-fornec
                and   mov-ap.cod-estabel   = tit-ap.cod-estabel
                and   mov-ap.cod-esp       = tit-ap.cod-esp
                and   mov-ap.serie         = tit-ap.serie
                and   mov-ap.nr-docto      = tit-ap.nr-docto
                and   mov-ap.parcela       = tit-ap.parcela
                and   mov-ap.dt-transacao >= tt-param.dt-transac-ini
                and   mov-ap.transacao     = 5 no-lock:
    
                {app/ap9999.i2 mov-ap tt-param.moeda tit-ap}

                assign de-tot-db = if  mov-ap.lancamento = 1 then
                                       de-tot-db + de-calc-valor-mov
                                   else 
                                       de-tot-db - de-calc-valor-mov.
                                   
            end.
        end.
    end.
            
    if  last-of ( {3} ) and (de-tot-cr - de-tot-db) <> 0 then do transaction:
        create mov-ap.
        assign mov-ap.dt-transacao = tt-param.dt-transac-fim
               mov-ap.ep-codigo    = i-ep-codigo-usuario
               mov-ap.cod-estabel  = tt-param.estab-fim
               mov-ap.tp-codigo    = tit-ap.tp-codigo
               mov-ap.cod-esp      = tt-param.espec-fim
               mov-ap.cod-fornec   = {3}
               mov-ap.moeda        = tt-param.moeda
               mov-ap.valor-mov    = de-tot-cr - de-tot-db
               mov-ap.valor-mov-me = de-tot-cr - de-tot-db
               mov-ap.transacao    = 7
               de-tot-cr = 0
               de-tot-db = 0.
    end.
end.

/* fim */
