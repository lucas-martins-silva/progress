/**********************************************************************************
***
***  app/ap0591c.i11 - Gera dados para o multiplanta da ND/NC.
***
**********************************************************************************/

if  avail tit-ap and param-global.modulo-mp = yes then do:

    /********** MULTIPLANTA*************/
    run pi-cria-tt-dados-tit-ap (input 1).
    /***********************************/

    for each mov-ap of tit-ap no-lock:
        /********** MULTIPLANTA*************/
        run pi-cria-tt-dados-mov-ap (input 1).
        /***********************************/
    end.

    for each  tit-conta-ap no-lock
        where tit-conta-ap.ep-codigo   = tit-ap.ep-codigo
        and   tit-conta-ap.cod-estabel = tit-ap.cod-estabel
        and   tit-conta-ap.cod-esp     = tit-ap.cod-esp
        and   tit-conta-ap.serie       = tit-ap.serie
        and   tit-conta-ap.nr-docto    = tit-ap.nr-docto
        and   tit-conta-ap.parcela     = tit-ap.parcela
        and   tit-conta-ap.cod-fornec  = tit-ap.cod-fornec:
        /************* MULTIPLANTA ****************/
        run pi-cria-tt-dados-tit-conta-ap (input 1).
        /******************************************/            
    end.

    for each  impto-tit-ap no-lock
        where impto-tit-ap.ep-codigo   = tit-ap.ep-codigo
        and   impto-tit-ap.cod-estabel = tit-ap.cod-estabel
        and   impto-tit-ap.cod-fornec  = tit-ap.cod-fornec
        and   impto-tit-ap.cod-esp     = tit-ap.cod-esp
        and   impto-tit-ap.serie       = tit-ap.serie
        and   impto-tit-ap.nr-docto    = tit-ap.nr-docto
        and   impto-tit-ap.parcela     = tit-ap.parcela:
        /************* MULTIPLANTA ****************/
        run pi-cria-tt-dados-impto-tit-ap (input 1).
        /******************************************/         
    end.                           
end.

/* Fim de Include */

