/**************************************************************************
***
*** app/ap0501ed.i1 - Realiza a busca de todas as antecipaá‰es 
***                   vinculadas as titulo.
**************************************************************************/

for each tt-antecipado:
    delete tt-antecipado.
end.

/*--- Elimina as antecipaá‰es de IR ----*/
for each  l-ant-ap exclusive-lock
    where l-ant-ap.ep-codigo   = lin-i-ap.ep-codigo
    and   l-ant-ap.cod-estabel = lin-i-ap.cod-estabel
    and   l-ant-ap.cod-fornec  = lin-i-ap.cod-fornec
    and   l-ant-ap.cod-esp     = lin-i-ap.cod-esp
    and   l-ant-ap.serie       = lin-i-ap.serie
    and   l-ant-ap.nr-docto    = lin-i-ap.nr-docto
    and   l-ant-ap.parcela     = lin-i-ap.parcela
    and   l-ant-ap.antec-ir    = yes:
    
    /*---- Se o imposto estiver vinculado a AN n∆o eliminar† ----*/
    if  can-find(first tit-ap
        where tit-ap.ep-codigo   = l-ant-ap.ep-codigo
          and tit-ap.cod-estabel = l-ant-ap.cod-est-ant
          and tit-ap.cod-fornec  = l-ant-ap.fornec-ant
          and tit-ap.serie       = l-ant-ap.serie-ant
          and tit-ap.cod-esp     = l-ant-ap.cod-esp-ant
          and tit-ap.nr-docto    = l-ant-ap.nr-docto-ant
          and tit-ap.parcela     = l-ant-ap.parcela-ant) then
          NEXT.
    
    delete l-ant-ap.
end.

assign de-total-antecipado = 0.
if  can-find(first l-ant-ap
    where l-ant-ap.ep-codigo   = lin-i-ap.ep-codigo
    and   l-ant-ap.cod-estabel = lin-i-ap.cod-estabel
    and   l-ant-ap.cod-fornec  = lin-i-ap.cod-fornec
    and   l-ant-ap.cod-esp     = lin-i-ap.cod-esp
    and   l-ant-ap.serie       = lin-i-ap.serie
    and   l-ant-ap.nr-docto    = lin-i-ap.nr-docto
    and   l-ant-ap.parcela     = lin-i-ap.parcela
    and   l-ant-ap.antec-ir    = no) then do:

    for each  l-ant-ap
        where l-ant-ap.ep-codigo   = lin-i-ap.ep-codigo
        and   l-ant-ap.cod-estabel = lin-i-ap.cod-estabel
        and   l-ant-ap.cod-fornec  = lin-i-ap.cod-fornec
        and   l-ant-ap.cod-esp     = lin-i-ap.cod-esp
        and   l-ant-ap.serie       = lin-i-ap.serie
        and   l-ant-ap.nr-docto    = lin-i-ap.nr-docto
        and   l-ant-ap.parcela     = lin-i-ap.parcela
        and   l-ant-ap.antec-ir    = no
        no-lock :
       /*--- Acha o doucmento da antecipaá∆o ---*/
       find first tit-ap
            where tit-ap.ep-codigo   = lin-i-ap.ep-codigo
            and   tit-ap.cod-estabel = l-ant-ap.cod-est-ant
            and   tit-ap.cod-fornec  = l-ant-ap.fornec-ant
            and   tit-ap.serie       = l-ant-ap.serie-ant
            and   tit-ap.cod-esp     = l-ant-ap.cod-esp-ant
            and   tit-ap.nr-docto    = l-ant-ap.nr-docto-ant
            and   tit-ap.parcela     = l-ant-ap.parcela-ant
            no-lock no-error.
       if  avail tit-ap then do:
           if  tit-ap.l-acum-ir  then do:
               assign i-cod-retencao-ant = tit-ap.cod-retencao.
               find first b-tit-ap
                    where b-tit-ap.ep-codigo   = tit-ap.ep-codigo
                    and   b-tit-ap.cod-estabel = tit-ap.cod-estabel
                    and   b-tit-ap.cod-fornec  = tit-ap.cod-fornec
                    and   b-tit-ap.serie       = tit-ap.serie-ant
                    and   b-tit-ap.cod-esp     = tit-ap.esp-ant
                    and   b-tit-ap.nr-docto    = tit-ap.docto-ant
                    and   b-tit-ap.parcela     = tit-ap.parc-ant 
                    and   b-tit-ap.tipo        = 8
                    no-lock no-error.
               if avail b-tit-ap then
                  assign i-cod-retencao-ant = b-tit-ap.cod-retencao.

               find first tt-antecipado 
                    where tt-antecipado.i-cod-retencao = i-cod-retencao-ant
                    no-error.
               if  not avail tt-antecipado then do:
                   create tt-antecipado.
                   assign tt-antecipado.i-cod-retencao = i-cod-retencao-ant
                          tt-antecipado.de-antec-trib  =  tit-ap.valor-ir * l-ant-ap.vl-antecip    
                                                       / tit-ap.vl-original
                          tt-antecipado.c-cod-estab    = tit-ap.cod-estab
                          tt-antecipado.i-cod-fornec   = tit-ap.cod-fornec
                          tt-antecipado.c-cod-esp      = tit-ap.cod-esp
                          tt-antecipado.c-serie        = tit-ap.serie
                          tt-antecipado.c-nr-docto     = tit-ap.nr-docto
                          tt-antecipado.c-parcela      = tit-ap.parcela.
               end.
               else
                   assign  tt-antecipado.de-antec-trib  = tt-antecipado.de-antec-trib
                                                        + (tit-ap.valor-ir * l-ant-ap.vl-antecip    
                                                       / tit-ap.vl-original).

           end. /*--- tit-ap.l-acum-ir ---*/
       end. /*--- tit-ap --*/
       else  /*--- Total  do valor antecipado sem IR ---*/
           assign de-total-antecipado = de-total-antecipado + l-ant-ap.vl-antecip.
    end. /*--- FOR EACH ---*/
end. /*--- l-ant-ap ---*/

/*--- Fim include app0501ed.i1 ---*/
