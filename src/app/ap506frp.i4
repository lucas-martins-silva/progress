PROCEDURE pi-cria-tt-dados-nota-dup:
  
    def input parameter i-tipo-movto as integer no-undo.

    if  param-global.modulo-mp = yes and tt-replica-msg.log-replica-msg = yes and l-centraliz = no then do: 
  
    {cdp/cd0006c.i "AP"
                   "nota-dup.ep-codigo-n" 
                   "nota-dup.cod-estabel-n" 
                   "return"}
    
        
        create tt-nota-dup-aux.
        buffer-copy nota-dup to tt-nota-dup-aux no-error.
        
        create tt-dados-env.                  
        assign tt-dados-env.num-sequencia  = i-seq 
               tt-dados-env.cod-tipo-reg   = 176
               tt-dados-env.ind-tipo-movto = i-tipo-movto
               tt-dados-env.identif-msg    = string(nota-dup.ep-codigo-n)   + " , " +
                                             string(nota-dup.cod-fornec)    + " , " + 
                                             string(nota-dup.cod-estabel-n) + " , " +
                                             string(nota-dup.cod-esp-n)     + " , " +
                                             string(nota-dup.serie-n)       + " , " +
                                             string(nota-dup.nr-docto-n)    + " , " +
                                             string(nota-dup.parcela-n).
        raw-transfer tt-nota-dup-aux to tt-dados-env.conteudo-msg.                                     
        assign i-seq = i-seq + 1.                                    
    end. 
  
END PROCEDURE.

