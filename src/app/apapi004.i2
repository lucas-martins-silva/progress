/********************************************************************************
***
*** app/apapi004.i2 - Rotina Atualizaá∆o API Previs‰es Contas a Pagar.
***
********************************************************************************/

create tit-ap.
assign tit-ap.ep-codigo        = tt-tit-ap.ep-codigo
       tit-ap.cod-fornec       = tt-tit-ap.cod-fornec
       tit-ap.cod-estabel      = tt-tit-ap.cod-estabel
       tit-ap.cod-esp          = tt-tit-ap.cod-esp
       tit-ap.serie            = tt-tit-ap.serie
       tit-ap.nr-docto         = tt-tit-ap.nr-docto
       tit-ap.parcela          = tt-tit-ap.parcela
       tit-ap.referencia       = tt-tit-ap.referencia
       tit-ap.portador         = tt-tit-ap.portador
       tit-ap.modalidade       = tt-tit-ap.modalidade
       tit-ap.dt-emissao       = tt-tit-ap.dt-emissao
       tit-ap.dt-vencimen      = tt-tit-ap.dt-vencimen.
assign tit-ap.moeda            = tt-tit-ap.moeda 
       tit-ap.cotacao-dia      = tt-tit-ap.cotacao-dia
       tit-ap.vl-original      = fn_ajust_dec(tt-tit-ap.vl-original, tt-tit-ap.moeda)
       tit-ap.vl-orig-me       = fn_ajust_dec(tt-tit-ap.vl-orig-me, tt-tit-ap.moeda)
       tit-ap.valor-saldo      = fn_ajust_dec(tt-tit-ap.valor-saldo, tt-tit-ap.moeda).
assign tit-ap.vl-saldo-me      = fn_ajust_dec(tt-tit-ap.vl-saldo-me, tt-tit-ap.moeda)
       tit-ap.tp-pagto         = tt-tit-ap.tp-pagto
       tit-ap.tp-codigo        = tt-tit-ap.tp-codigo
       tit-ap.observacao       = tt-tit-ap.observacao
       tit-ap.transacao        = 1
       tit-ap.tipo             = 3
       tit-ap.dt-transacao     = tt-tit-ap.dt-emissao
       tit-ap.dt-prev-pag      = tt-tit-ap.dt-vencimen
       tit-ap.dt-fluxo         = tt-tit-ap.dt-vencimen.

if  tit-ap.moeda = 0 then do:
    assign tit-ap.cotacao-dia  = 1
           tit-ap.vl-orig-me   = fn_ajust_dec(tit-ap.vl-original, tit-ap.moeda)
           tit-ap.vl-saldo-me  = fn_ajust_dec(tit-ap.valor-saldo, tit-ap.moeda).
end.

if  tit-ap.tp-pagto = 0 then
    assign tit-ap.tp-pagto = 1.

find first emitente no-lock
     where emitente.cod-emitente = tit-ap.cod-fornec
     and   emitente.identific   <> 1 no-error.

if  avail emitente then do:

    /*--- Calcular Data de Fluxo ---*/
    {app/apapi004.i4}

    assign tit-ap.nome-abrev = emitente.nome-abrev.

    find first b-emitente
         where b-emitente.nome-abrev = emitente.nome-matriz
         and   b-emitente.identific <> 1 no-lock no-error.

    if  avail b-emitente then
        assign tit-ap.matriz = b-emitente.cod-emitente.

end.

create mov-ap.
assign mov-ap.ep-codigo    = tit-ap.ep-codigo
       mov-ap.cod-estabel  = tit-ap.cod-estabel
       mov-ap.cod-esp      = tit-ap.cod-esp
       mov-ap.serie        = tit-ap.serie
       mov-ap.cod-fornec   = tit-ap.cod-fornec
       mov-ap.nome-abrev   = tit-ap.nome-abrev
       mov-ap.nr-docto     = tit-ap.nr-docto
       mov-ap.parcela      = tit-ap.parcela
       mov-ap.transacao    = 1
       mov-ap.tipo         = 3
       mov-ap.dt-emissao   = tit-ap.dt-emissao
       mov-ap.dt-vencimen  = tit-ap.dt-vencimen
       mov-ap.dt-transacao = tit-ap.dt-transacao
       mov-ap.moeda        = tit-ap.moeda.
assign mov-ap.valor-mov    = fn_ajust_dec(tit-ap.vl-original, tit-ap.moeda)
       mov-ap.valor-mov-me = fn_ajust_dec(tit-ap.vl-orig-me, tit-ap.moeda)
       mov-ap.vl-original  = fn_ajust_dec(tit-ap.vl-original, tit-ap.moeda)
       mov-ap.vl-orig-me   = fn_ajust_dec(tit-ap.vl-orig-me, tit-ap.moeda)
       mov-ap.portador     = tit-ap.portador
       mov-ap.modalidade   = tit-ap.modalidade
       mov-ap.usuario      = tt-tit-ap.usuario
       mov-ap.dt-today     = today
       mov-ap.c-time       = string(time,"HH:MM":U)
       mov-ap.tp-codigo    = tit-ap.tp-codigo
       mov-ap.cotacao-dia  = tit-ap.cotacao-dia.

find first espec-ap no-lock where espec-ap.cod-esp = tit-ap.cod-esp no-error.

if  avail espec-ap then do:
    if  espec-ap.emite-ap = yes then do:
        find emite-ap exclusive-lock
            where emite-ap.ep-codigo   = tit-ap.ep-codigo
              and emite-ap.cod-estabel = tit-ap.cod-estabel
              and emite-ap.cod-esp     = tit-ap.cod-esp
              and emite-ap.serie       = tit-ap.serie
              and emite-ap.cod-fornec  = tit-ap.cod-fornec
              and emite-ap.nr-docto    = tit-ap.nr-docto
              and emite-ap.parcela     = tit-ap.parcela
              and emite-ap.transacao   = 1 no-error.

        if  not avail emite-ap then do:
            create emite-ap.
            assign emite-ap.ep-codigo   = tit-ap.ep-codigo
                   emite-ap.cod-estabel = tit-ap.cod-estabel
                   emite-ap.cod-esp     = tit-ap.cod-esp
                   emite-ap.serie       = tit-ap.serie
                   emite-ap.cod-fornec  = tit-ap.cod-fornec
                   emite-ap.nr-docto    = tit-ap.nr-docto
                   emite-ap.parcela     = tit-ap.parcela
                   emite-ap.transacao   = 1.
        end.

        assign emite-ap.dt-emissao  = tit-ap.dt-emissao
               emite-ap.dt-vencimen = tit-ap.dt-vencimen
               emite-ap.valor-ap    = fn_ajust_dec(tit-ap.vl-original, tit-ap.moeda)
               emite-ap.valor-saldo = fn_ajust_dec(tit-ap.vl-original, tit-ap.moeda).

    end.
end.

/*--- Integraá∆o Caixa Bancos ---*/    
{utp/ut-liter.i Atualizando_Caixa_e_Bancos * R}
run pi-acompanhar in h-acomp (input trim(return-value)
                                      + " - "
                                      + tt-tit-ap.nr-docto 
                                      + "/" 
                                      + tt-tit-ap.parcela).

{app/ap9100.i2}
assign tt-integ-ap.tt-row-tit-ap  = rowid(tit-ap)
       tt-integ-ap.tt-ge0102g     = yes
       tt-integ-ap.tt-cb0110a     = yes  
       tt-integ-ap.tt-cb1202a     = yes
       tt-integ-ap.tt-op-ge0102g  = 16   /* Inclus∆o */
       tt-integ-ap.tt-op-cb0110a  = 16   /* Inclus∆o */ 
       tt-integ-ap.tt-op-cb1202a  = 16.  /* Inclus∆o */
raw-transfer tt-integ-ap to raw-integracao.
run app/ap9100.p (input raw-integracao, input-output table tt-erro).

/* Fim de Include */
