/*******************************************************************************
***
*** app/ap0740rp.i20 - pi-imprimir-parametros.
***
*******************************************************************************/

{utp/ut-liter.i SELE€ÇO * C}
assign c-text-1 = trim(return-value).

{utp/ut-liter.i PAR¶METROS * C}
assign c-text-2 = trim(return-value).

{utp/ut-liter.i IMPRESSÇO * C}
assign c-text-3 = trim(return-value).
            
{utp/ut-liter.i CLASSIFICA€ÇO * C}
assign c-text-4 = trim(return-value).

{utp/ut-liter.i Dias * C}
assign c-dia       = trim(return-value)
       c-dia-um    = trim(return-value)
       c-dia-dois  = trim(return-value)
       c-dia-treis = trim(return-value)
       c-dia-quat  = trim(return-value).

{utp/ut-liter.i Usu rio * C}
assign tt-param.usuario:label in frame f-parametros2 = trim(return-value).

{utp/ut-liter.i Destino * C}
assign c-destino:label in frame f-parametros2 = trim(return-value).

{utp/ut-liter.i Vencidos_de * C}
assign tt-param.i-venc-31:label in frame f-parametros = trim(return-value).

{utp/ut-liter.i De * C}
assign tt-param.i-venc-61:label   in frame f-parametros = trim(return-value)
       tt-param.i-a-venc-61:label in frame f-parametros = trim(return-value)
       tt-param.i-a-venc-91:label in frame f-parametros = trim(return-value). 

{utp/ut-liter.i ·_Vencer_de * C}
assign tt-param.i-a-venc-31:label in frame f-parametros = trim(return-value).

{utp/ut-field.i mgadm tit-ap cod-estabel 1}
assign tt-param.cod-est-ini:label in frame f-parametros = return-value.
                                        
{utp/ut-field.i mgadm tit-ap moeda 1}
assign tt-param.cod-moeda-ini:label in frame f-parametros = return-value.

{utp/ut-field.i mgadm tit-ap cod-esp 1}
assign tt-param.cod-esp-ini:label in frame f-parametros = return-value.
    
{utp/ut-field.i mgadm tit-ap cod-fornec 1}
assign tt-param.cod-fornec-ini:label in frame f-parametros = return-value.
    
{utp/ut-liter.i Grupo_Fornecedor * C}
assign tt-param.cod-grupo-ini:label in frame f-parametros = return-value.

{utp/ut-liter.i Portador * C}
assign tt-param.cod-port-ini:label in frame f-parametros = trim(return-value).

{utp/ut-liter.i Matriz * C}
assign tt-param.cod-matriz-ini:label in frame f-parametros = trim(return-value).
    
{utp/ut-liter.i Tipo_Relat¢rio * C}
assign tt-param.des-tipo-rel:label in frame f-parametros = trim(return-value).

{utp/ut-liter.i Tipo_Resumo * C}
assign tt-param.des-tipo-resumo:label in frame f-parametros = trim(return-value).

{utp/ut-liter.i Data_de_Corte * C}
assign tt-param.da-corte:label in frame f-parametros = trim(return-value).
    
{utp/ut-liter.i Data_C lculo_Resumo * C}
assign tt-param.da-calc-resumo:label in frame f-parametros = trim(return-value).

{utp/ut-liter.i Moeda_Apresenta‡Æo * C}
assign tt-param.i-cod-moeda:label in frame f-parametros = trim(return-value).
    
{utp/ut-liter.i Data_ConversÆo * C}
assign tt-param.da-conversao:label in frame f-parametros = trim(return-value).

{utp/ut-liter.i Cota‡Æo_Utilizada * C}
assign tt-param.de-cotacao-dia:label in frame f-parametros = trim(return-value).

{utp/ut-liter.i Lista_Antecipa‡Æo * C}
assign tt-param.log-lis-antec:label in frame f-parametros = trim(return-value).

{utp/ut-liter.i Lista_PrevisÆo * C}
assign tt-param.log-lis-prev:label in frame f-parametros = trim(return-value).

{utp/ut-liter.i Lista_hist¢rico_para_previsäes * C}
assign tt-param.log-lis-hist-prev:label in frame f-parametros = trim(return-value).

{utp/ut-liter.i Lista_hist¢rico_para_documentos * C}
assign tt-param.log-lis-hist-docto:label in frame f-parametros = trim(return-value).

{utp/ut-liter.i Parametriza_prazos * C}
assign tt-param.log-param-prazo:label in frame f-parametros = trim(return-value).

{utp/ut-liter.i Considera_Moeda_Original * C}
assign tt-param.log-cons-mo-orig:label in frame f-parametros = trim(return-value).

{utp/ut-liter.i Data_Base * C}
assign tt-param.da-data-base:label in frame f-parametros = trim(return-value).

{utp/ut-liter.i Margens_de_Dias * C}
assign tt-param.i-margem-dias:label in frame f-parametros = trim(return-value).
    
{utp/ut-liter.i Lista_ProvisÆo * C}
assign tt-param.log-lis-prov:label in frame f-param-prov = trim(return-value).

if  page-number > 0 then 
    page. 
    
assign c-destino = {varinc/var00002.i 04 tt-param.destino}
                 + " - " 
                 + tt-param.arquivo.

disp c-text-1 
     tt-param.cod-est-ini      
     tt-param.cod-est-fim      
     tt-param.cod-esp-ini      
     tt-param.cod-esp-fim      
     tt-param.cod-fornec-ini   
     tt-param.cod-fornec-fim   
     tt-param.cod-grupo-ini    
     tt-param.cod-grupo-fim    
     tt-param.cod-port-ini     
     tt-param.cod-port-fim     
     tt-param.cod-matriz-ini   
     tt-param.cod-matriz-fim   
     tt-param.cod-moeda-ini
     tt-param.cod-moeda-fim
     tt-param.c-conta-ini
     tt-param.c-conta-fim
     c-text-4
     tt-param.desc-classifica
     c-text-2                  
     tt-param.des-tipo-rel
     tt-param.i-margem-dias     
     tt-param.da-data-base      
     tt-param.des-tipo-resumo
     tt-param.da-calc-resumo
     tt-param.log-param-prazo  
     tt-param.i-venc-31        
     tt-param.i-venc-60        
     c-dia                     
     tt-param.i-venc-61        
     tt-param.i-venc-90        
     c-dia-um                  
     tt-param.i-a-venc-31      
     tt-param.i-a-venc-60      
     c-dia-dois                
     tt-param.i-a-venc-61      
     tt-param.i-a-venc-90      
     c-dia-treis               
     tt-param.i-a-venc-91      
     tt-param.i-a-venc-120     
     c-dia-quat                
     tt-param.log-lis-antec    
     tt-param.log-lis-prev     
     tt-param.log-lis-hist-prev
     tt-param.log-lis-hist-docto
     tt-param.log-cons-mo-orig
     tt-param.da-corte         
     tt-param.i-cod-moeda
     tt-param.da-conversao
     tt-param.de-cotacao-dia      
     with frame f-parametros.

do  with frame f-parametros:
    if  tt-param.log-lis-antec = yes then {utp/ut-liter.i Sim * C} else {utp/ut-liter.i NÆo * C}.
    disp trim(return-value) @ tt-param.log-lis-antec.
    if  tt-param.log-lis-prev  = yes then {utp/ut-liter.i Sim * C} else {utp/ut-liter.i NÆo * C}.
    disp trim(return-value) @ tt-param.log-lis-prev.
    if  tt-param.log-lis-hist-prev  = yes then {utp/ut-liter.i Sim * C} else {utp/ut-liter.i NÆo * C}.
    disp trim(return-value) @ tt-param.log-lis-hist-prev.    
    if  tt-param.log-lis-hist-docto = yes then {utp/ut-liter.i Sim * C} else {utp/ut-liter.i NÆo * C}.
    disp trim(return-value) @ tt-param.log-lis-hist-docto.
    if  tt-param.log-param-prazo = yes then {utp/ut-liter.i Sim * C} else {utp/ut-liter.i NÆo * C}.
    disp trim(return-value) @ tt-param.log-param-prazo.
    if  tt-param.log-cons-mo-orig = yes then {utp/ut-liter.i Sim * C} else {utp/ut-liter.i NÆo * C}.
    disp trim(return-value) @ tt-param.log-cons-mo-orig.
end.

if l-provisao then do:
    disp tt-param.log-lis-prov
         with frame f-param-prov.

    do with frame f-param-prov:
        if  tt-param.log-lis-prov = yes then {utp/ut-liter.i Sim * C} else {utp/ut-liter.i NÆo * C}.
        disp trim(return-value) @ tt-param.log-lis-prov.
    end.
end.

disp c-text-3                   
     c-destino
     tt-param.usuario            
     with frame f-parametros2.

/*NÆo retirar a include abaixo, ela foi colocada nesse local para solucionar erro
que ocorre quando o relat¢rio ‚ rodado em RPW*/
{utp/ut-liter.i _}

/* Fim de Include */
