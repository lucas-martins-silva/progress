def var l-mantem-nr-cheque as logical initial no no-undo.

&IF  DEFINED(BF_FIN_MANT_NR_CHEQ) &THEN
     assign l-mantem-nr-cheque = yes.
&ELSE
     if  can-find(first funcao where
                        funcao.cd-funcao  = "spp-bf_fin_mant_nr_cheq" and
                        funcao.ativo     = yes) then
         assign l-mantem-nr-cheque = yes.
&ENDIF


