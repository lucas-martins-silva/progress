/********************************************************************************
***
*** app/ap0503ac.i2 - Gera Movimento de Implanta‡Æo do Documento.
***
********************************************************************************/
    
create mov-ap.
assign mov-ap.ep-codigo      = b-tit-ap.ep-codigo
       mov-ap.cod-estabel    = b-tit-ap.cod-estabel
       mov-ap.cod-esp        = b-tit-ap.cod-esp
       mov-ap.serie          = b-tit-ap.serie
       mov-ap.nr-docto       = b-tit-ap.nr-docto
       mov-ap.parcela        = b-tit-ap.parcela
       mov-ap.nome-abrev     = b-tit-ap.nome-abrev
       mov-ap.cod-fornec     = b-tit-ap.cod-fornec
       mov-ap.dt-emissao     = b-tit-ap.dt-emissao
       mov-ap.dt-vencimen    = b-tit-ap.dt-vencimen
       mov-ap.dt-transacao   = b-tit-ap.dt-transacao
       mov-ap.referencia     = b-tit-ap.referencia
       mov-ap.valor-mov      = b-tit-ap.vl-original
       mov-ap.valor-mov-me   = b-tit-ap.vl-original
       mov-ap.portador       = b-tit-ap.portador
       mov-ap.conta-contabil = b-tit-ap.conta-debito
       mov-ap.ct-conta       = b-tit-ap.ct-conta-db
       mov-ap.sc-conta       = b-tit-ap.sc-conta-db
       mov-ap.transacao      = 1
       mov-ap.serie-ant      = b-tit-ap.serie-ant
       mov-ap.esp-ant        = b-tit-ap.esp-ant
       mov-ap.fornec-ant     = b-tit-ap.cod-fornec
       mov-ap.docto-ant      = b-tit-ap.docto-ant
       mov-ap.parc-ant       = b-tit-ap.parc-ant
       mov-ap.tp-codigo      = b-tit-ap.tp-codigo
       mov-ap.dt-today       = today
       mov-ap.c-time         = string(time, "HH:MM")
       mov-ap.usuario        = c-seg-usuario
       mov-ap.hp-codigo      = tt-ant-ir.i-hp-codigo
       mov-ap.historico      = tt-ant-ir.c-historico.
        
/************ MULTIPLATA ************/
run pi-cria-tt-dados-mov-ap (input 1).
/************************************/
        
/*--- Atualiza Dados Movto Implanta‡Æo da AN ---*/
find first b-mov-ap exclusive-lock 
     where b-mov-ap.ep-codigo = tit-ap.ep-codigo
     and   b-mov-ap.cod-estab = tit-ap.cod-estab
     and   b-mov-ap.serie     = tit-ap.serie
     and   b-mov-ap.cod-forne = tit-ap.cod-fornec
     and   b-mov-ap.cod-esp   = tit-ap.cod-esp
     and   b-mov-ap.nr-docto  = tit-ap.nr-docto
     and   b-mov-ap.parcela   = tit-ap.parcela 
     and   b-mov-ap.transacao = 1 no-error.
            
if  avail b-mov-ap then do:        
            
    assign b-mov-ap.fornec-ant = tit-ap.cod-fornec
           b-mov-ap.esp-ant    = tit-ap.esp-ant  
           b-mov-ap.serie-ant  = tit-ap.serie-ant
           b-mov-ap.docto-ant  = tit-ap.docto-ant
           b-mov-ap.parc-ant   = tit-ap.parc-ant.
            
    /************* MULTIPLATA *************/
    run pi-cria-tt-dados-b-mov-ap (input 2).
    /**************************************/
            
end.
        
/* Fim de Include */
