/******************************************************************************
**
**   AP1002.I2
**   Objetivo: Definicao de Variaveis e frames.
**
******************************************************************************/

/* Miniflexibilizaá∆o EMS 2.03 */
{cdp/cdcfgfin.i}

def buffer b-bordero-ap for bordero-ap.

def var d-vl-total  like doc-b-ap.total-movto.

def var i-sequencia like lin-b-ap.sequencia   init 0.
def var i-seq       as integer init 0        no-undo.
def var i-data      as integer               no-undo.
def var i-dia-doc   as integer format "99"   no-undo.
def var i-mes-doc   as integer format "99"   no-undo.
def var i-ano-doc   as integer format "9999" no-undo.
def var i-dia-lin   as integer format "99"   no-undo.
def var i-mes-lin   as integer format "99"   no-undo.
def var i-ano-lin   as integer format "9999" no-undo.
def var i-fornec    like tit-ap.cod-fornec   no-undo.
def var i-tipo-pag  as integer.
def var i-identific as int init 0  no-undo.

def var de-total          like tit-ap.vl-original       init 0 no-undo.
def var de-valor          like tit-ap.vl-original       init 0 no-undo.
def var de-desconto       like tit-ap.vl-desconto       init 0 no-undo.
def var de-juros          like mov-ap.valor-juros       init 0 no-undo.
&if defined(BF_FIN_MULTA_ABATIMENTO) &then
def var de-abatimento     like mov-ap.vl-abatimento     init 0 no-undo.
def var de-multa          like mov-ap.vl-multa          init 0 no-undo.
def var de-abatimento-tot like tit-ap.vl-abatimento-tot init 0 no-undo.
def var de-multa-tot      like tit-ap.vl-multa-tot      init 0 no-undo.
&endif
def var de-tot-baixa       like tit-ap.vl-original       init 0 no-undo.
def var de-valor-liq       like tit-ap.vl-original       init 0 no-undo.
def var de-total-desconto  like tit-ap.vl-original       init 0 no-undo.
def var de-total-juros     like tit-ap.vl-original       init 0 no-undo.
def var da-data            like tit-ap.dt-vencimen       init ? no-undo.
def var da-data-aux        like tit-ap.dt-vencimen       init ? no-undo.
def var da-baixa           like mov-ap.dt-transacao      init ? no-undo.
def var de-total-rejeitado like tit-ap.vl-original       init 0 no-undo.

def var c-integracao      as   char format "x(80)"             no-undo.
def var c-identific       as   char                            no-undo.
def var i-num-char        as   int                             no-undo.
def var l-brasil          as   logical                 init no no-undo.
def var c-num-doc         like tit-ap.nr-docto                 no-undo.
def var c-status          as   character format "99" init " "  no-undo.
def var c-cod-esp         like mov-ap.cod-esp                  no-undo.
def var c-serie           like tit-ap.serie                    no-undo.
def var c-parcela         like tit-ap.parcela                  no-undo.
def var c-linha           as   character                       no-undo.
def var c-linha1          as   character format "x(200)"       no-undo.
def var c-linha2          like c-linha1                        no-undo.
def var c-header1         like c-linha1                        no-undo.
def var c-header2         like c-linha1                        no-undo.
def var c-arquivo         as   character format "x(20)" label "Nome do Arquivo"
    init "retorno1.ret".
def var c-transacao       as   character format "x(32)"          no-undo.
def var c-observacao      as   character format "x(75)" init " " no-undo.
def var c-observ2         as   character format "x(35)" init " " no-undo.
def var c-msg-atual       as   character format "x(70)" init " " no-undo.

def var l-header          as   logical init yes no-undo.
def var l-primeira        as   logical init yes no-undo.
def var l-antecipacao     as   logical          no-undo.
def var l-magnus          as   logical init no  no-undo.
def var l-ret-erro        as   logical          no-undo.
def var l-bordero         as   logical          no-undo.

/* Variaveis utilizadas para encontrar Documento no caso de Arquivo 
   Enviado pelo Magnus I.00 */
def var c-estabel-aux   like tit-ap.cod-estabel      no-undo.
def var i-fornec-aux    like tit-ap.cod-fornec       no-undo.
def var c-cod-esp-aux   like tit-ap.cod-esp          no-undo.
def var i-numero-aux    as integer format ">>>>>>>9" no-undo.
def var c-serie-aux     like tit-ap.serie            no-undo.
def var c-parcela-aux   like tit-ap.parcela          no-undo.
def var l-suspenso      as logical                   no-undo. 

def buffer b-mov-ap-impl for mov-ap.
def var i-nr-bordero like mov-ap.nr-bordero init 0  no-undo.
def var l-vl-saldo   as logical             init no no-undo.
def var add-lin-b-ap as logical             init no no-undo.
def new shared frame f-referencia with stream-io.
def new shared frame f-linha      with stream-io.
def new shared frame f-lis-tot    with stream-io.
def new shared frame f-total      with stream-io.

/* Usada pela API de baixa, definida somente para chamar o ap0505d.p */
def temp-table tt-retorno-lin-b-ap no-undo
    field cod-erro   as character format "x(10)"
    field desc-erro  as character format "x(60)"
                        view-as editor max-chars 2000 
                        scrollbar-vertical size 50 by 4
    field situacao   as logical
    field cod-chave  as character
    INDEX ch-codigo  IS PRIMARY cod-erro
                                cod-chave.

form
    "*------------------------  PARAMETROS  ------------------------*"  at 34
    skip(1)
    tt-param.i-empresa         label "Empresa"            colon 65
    tt-param.c-referencia      label "Referància"         colon 65
    tt-param.c-arquivo-entrada label "Arquivo de retorno" colon 65 format "x(50)"
    skip(1)
    with stream-io width 132 side-labels no-box frame f-cabec1.

form
    tit-ap.cod-fornec
    tit-ap.cod-estabel
    tit-ap.cod-esp
    tit-ap.serie
    tit-ap.nr-docto
    tit-ap.parcela 
    tit-ap.dt-emissao    column-label "Dt Emiss∆o"
    tit-ap.dt-vencimen   column-label "Vencimento"
    da-data              column-label "Data"
&if  "{&mgadm_version}" < "2.02" &then 
    de-valor             column-label "Vl Original" format ">>,>>>,>>9.99"
&endif
&if  "{&mgadm_version}" >= "2.02" &then
    de-valor             column-label "Vl Pagto"    format ">>,>>>,>>9.99"
&endif    
    tit-ap.nr-bordero 
    c-transacao          column-label "Transaá∆o"
    with stream-io width 132 down no-box no-attr frame f-detalhe1.

form
                                 skip(1)
    "Total  Liquidacoes:" at 51
    de-tot-baixa          at 73  skip(1)
    "Total de Descontos:" at 51
    de-total-desconto     at 73  skip(1)
    "Total de Juros....:" at 51
    de-total-juros        at 73  skip(1)
    "Total do Movimento:" at 51
    de-total              at 73  skip(1)
    "Total de Rejeicoes:" at 51
    de-total-rejeitado    at 73
    with stream-io width 132 no-labels no-box no-attr frame f-total-2.

/* Frames Erros */
form
     lin-b-ap.sequencia
     lin-b-ap.referencia
     lin-b-ap.cod-estabel
     lin-b-ap.cod-fornec
     lin-b-ap.cod-esp
     lin-b-ap.serie
     lin-b-ap.nr-docto
     lin-b-ap.parcela 
     tt-retorno-lin-b-ap.cod-erro 
     tt-retorno-lin-b-ap.desc-erro 
     with width 132 no-box down stream-io frame f-retorno.

form
    c-msg-atual
    with width 132 no-box no-label stream-io frame f-erro-atual.

form
    c-observacao label "OBSERVAÄ«O"
    with width 132 no-box side-labels stream-io frame f-obs.

run utp/ut-trfrrp.p (input frame f-cabec1:handle).
run utp/ut-trfrrp.p (input frame f-detalhe1:handle).    
run utp/ut-trfrrp.p (input frame f-total-2:handle).
run utp/ut-trfrrp.p (input frame f-retorno:handle).
run utp/ut-trfrrp.p (input frame f-erro-atual:handle).    
run utp/ut-trfrrp.p (input frame f-obs:handle).    
/* Fim ap1002.i2 */
