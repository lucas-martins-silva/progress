/*******************************************************************************
***
*** app/ap0741rp.i14 - Quebra por Fornecedor.
***
*******************************************************************************/

if  tt-param.log-cons-mo-orig = no then
    find first tt2-mov-ap no-lock use-index ch-pagto-escrit
         where tt2-mov-ap.ep-codigo    = tt-param.ep-codigo
         and   tt2-mov-ap.dt-transacao = tt-param.dt-trans-fim
         and   tt2-mov-ap.transacao    = 7 
         and   tt2-mov-ap.portador     = 0
         and   tt2-mov-ap.cod-fornec   = int(p-cod-chave)
         no-error.
else
    find first tt2-mov-ap no-lock use-index ch-pagto-escrit
         where tt2-mov-ap.ep-codigo    = tt-param.ep-codigo
         and   tt2-mov-ap.dt-transacao = tt-param.dt-trans-fim
         and   tt2-mov-ap.transacao    = 7
         and   tt2-mov-ap.portador     = 0 
         and   tt2-mov-ap.cod-fornec   = int(p-cod-chave)
         and   tt2-mov-ap.moeda        = p-moeda
         no-error.

if  avail tt2-mov-ap then
    assign de-tot-saldo = tt2-mov-ap.valor-mov.
    
assign de-tot-atual = de-tot-saldo 
                    + de-tot-cr
                    - de-tot-db.
                
assign de-ger-saldo = de-ger-saldo + de-tot-saldo
       de-ger-atual = de-ger-atual + de-tot-atual.

if  de-tot-saldo >= 0 then
    assign c-lancto1       = {adinc/i01ad059.i 04 2}
           de-ger-saldo-cr = de-ger-saldo-cr + de-tot-saldo.
else
    assign c-lancto1       = {adinc/i01ad059.i 04 1}
           de-tot-saldo    = de-tot-saldo * (- 1)
           de-ger-saldo-db = de-ger-saldo-db + de-tot-saldo.
            
if  de-tot-atual >= 0 then
    assign c-lancto2       = {adinc/i01ad059.i 04 2}
           de-ger-atual-cr = de-ger-atual-cr + de-tot-atual.
else
    assign c-lancto2       = {adinc/i01ad059.i 04 1}
           de-tot-atual    = de-tot-atual * (- 1)
           de-ger-atual-db = de-ger-atual-db + de-tot-atual.

/* Fim de Include */

