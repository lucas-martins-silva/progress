/*******************************************************************************
***
*** app/ap0740rp.i17 - pi-totalizar-resumo.
***
*******************************************************************************/
                
if  tt-param.ind-tipo-resumo = 1 then do:
    find first tt-resumo no-lock no-error.
    if  not avail tt-resumo then do:
        create tt-resumo.
        assign tt-resumo.cod-chave = 0.
    end.
end.
else do:
    find first tt-resumo where tt-resumo.cod-chave = tt-tit-ap.cod-gr-forn no-error.
    if  not avail tt-resumo then do:
        create tt-resumo.
        assign tt-resumo.cod-chave = tt-tit-ap.cod-gr-forn.
    end.
end.
        
if  tt-tit-ap.tipo = 2 then
    assign tt-resumo.ant-gr  = tt-resumo.ant-gr  + tt-tit-ap.vl-original
           tt-resumo.ant-gr1 = tt-resumo.ant-gr1 + tt-tit-ap.valor-saldo.
else
    if  tt-tit-ap.tipo = 3 then
        assign tt-resumo.pre-gr  = tt-resumo.pre-gr  + tt-tit-ap.vl-original
               tt-resumo.pre-gr1 = tt-resumo.pre-gr1 + tt-tit-ap.valor-saldo.
    else
        if tt-tit-ap.tipo = 10 then
            assign tt-resumo.pro-gr  = tt-resumo.pro-gr  + tt-tit-ap.vl-original
                   tt-resumo.pro-gr1 = tt-resumo.pro-gr1 + tt-tit-ap.valor-saldo.
        else
            assign tt-resumo.nor-gr  = tt-resumo.nor-gr  + tt-tit-ap.vl-original
                   tt-resumo.nor-gr1 = tt-resumo.nor-gr1 + tt-tit-ap.valor-saldo.

if  tt-tit-ap.tipo <> 2 then do:
    if  tt-tit-ap.dt-vencimen <= tt-param.da-calc-resumo then do:
                
        assign i-nr-dias = tt-param.da-calc-resumo - tt-tit-ap.dt-vencimen.
                  
        if  i-nr-dias < tt-param.i-venc-31 then
            assign tt-resumo.ven-30 = tt-resumo.ven-30 + tt-tit-ap.valor-saldo.
        else
            if  i-nr-dias >= tt-param.i-venc-31 and i-nr-dias <= tt-param.i-venc-60 then
                assign tt-resumo.ven-60 = tt-resumo.ven-60 + tt-tit-ap.valor-saldo.
            else
                if  i-nr-dias >= tt-param.i-venc-61 and i-nr-dias <= tt-param.i-venc-90 then
                    assign tt-resumo.ven-90 = tt-resumo.ven-90 + tt-tit-ap.valor-saldo.
                else
                    if  i-nr-dias > tt-param.i-venc-90 then
                        assign tt-resumo.ven-999 = tt-resumo.ven-999 + tt-tit-ap.valor-saldo.
            
        assign tt-resumo.tot = tt-resumo.tot + tt-tit-ap.valor-saldo.
                
    end.
    else do:
                
        assign i-nr-dias = tt-tit-ap.dt-vencimen - tt-param.da-calc-resumo.
            
        if  i-nr-dias < tt-param.i-a-venc-31 then
            assign tt-resumo.ven1-30 = tt-resumo.ven1-30 + tt-tit-ap.valor-saldo.
        else
            if  i-nr-dias >= tt-param.i-a-venc-31 and i-nr-dias <= tt-param.i-a-venc-60 then
                assign tt-resumo.ven1-60 = tt-resumo.ven1-60 + tt-tit-ap.valor-saldo.
            else
                if  i-nr-dias >= tt-param.i-a-venc-61 and i-nr-dias <= tt-param.i-a-venc-90 then
                    assign tt-resumo.ven1-90 = tt-resumo.ven1-90 + tt-tit-ap.valor-saldo.
                else
                    if  i-nr-dias >= tt-param.i-a-venc-91 and i-nr-dias <= tt-param.i-a-venc-120 then
                        assign tt-resumo.ven1-120 = tt-resumo.ven1-120 + tt-tit-ap.valor-saldo.
                    else
                        if  i-nr-dias > tt-param.i-a-venc-120 then
                            assign tt-resumo.ven1-999 = tt-resumo.ven1-999 + tt-tit-ap.valor-saldo.

        assign tt-resumo.tot1 = tt-resumo.tot1 + tt-tit-ap.valor-saldo.

    end.
end.
       
/* Fim de Include */
