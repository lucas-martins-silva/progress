/*******************************************************************************
**
** app/ap0501e.i13 - Procedure's MultiPlanta.
**
*******************************************************************************/      
    
PROCEDURE pi-cria-tt-dados-doc-i-ap:
            
    create tt-doc-i-ap-aux.
    buffer-copy doc-i-ap to tt-doc-i-ap-aux.
            
    create tt-dados-env.                  
    assign tt-dados-env.num-sequencia  = i-seq 
           tt-dados-env.cod-tipo-reg   = 186
           tt-dados-env.ind-tipo-movto = 1
           tt-dados-env.identif-msg    = string(doc-i-ap.ep-codigo) + " , " +
                                         string(doc-i-ap.referencia).
    raw-transfer tt-doc-i-ap-aux to tt-dados-env.conteudo-msg.                                     
    assign i-seq = i-seq + 1. 
            
END PROCEDURE.
    
PROCEDURE pi-cria-tt-dados-lin-i-ap:
                
    create tt-lin-i-ap-aux.
    buffer-copy lin-i-ap to tt-lin-i-ap-aux.
            
    create tt-dados-env.                  
    assign tt-dados-env.num-sequencia  = i-seq 
           tt-dados-env.cod-tipo-reg   = 183
           tt-dados-env.ind-tipo-movto = 1
           tt-dados-env.identif-msg    = string(lin-i-ap.ep-codigo)  + " , " +
                                         string(lin-i-ap.referencia) + " , " +
                                         string(lin-i-ap.sequencia)  + " , " +
                                         string(lin-i-ap.seq-import).
    raw-transfer tt-lin-i-ap-aux to tt-dados-env.conteudo-msg.                                     
    assign i-seq = i-seq + 1. 
            
END PROCEDURE.    
        
