/*******************************************************************************
**
** app/ap0501e.i16 - V rias Contas
**
*******************************************************************************/ 

/* Lin-conta-ap.char-1 = " " (branco) identifica que o rateio das contas do registro *
 * pertencem ao documento original.                                                  *
 * Lin-conta-ap.char-1 <> " ", refere-se ao rateio do valor de imposto.              */ 

/* Rateio em v rias contas para o Documento Original */
if i-pais-impto-usuario = 4 then do:
        assign i-qtde-contas = 0.
        for each  lin-conta-ap no-lock
            where lin-conta-ap.ep-codigo   = lin-i-ap.ep-codigo
            and   lin-conta-ap.cod-estabel = lin-i-ap.cod-estabel
            and   lin-conta-ap.cod-esp     = lin-i-ap.cod-esp
            and   lin-conta-ap.serie       = lin-i-ap.serie
            and   lin-conta-ap.nr-docto    = lin-i-ap.nr-docto
            and   lin-conta-ap.parcela     = lin-i-ap.parcela
            and   lin-conta-ap.cod-fornec  = lin-i-ap.cod-fornec
            and   lin-conta-ap.char-1      = " ":
            assign i-qtde-contas = i-qtde-contas + 1. 
        end.
end.  


/* Rateio em v rias contas para o Documento Original */
for each  lin-conta-ap exclusive-lock
    where lin-conta-ap.ep-codigo   = lin-i-ap.ep-codigo
    and   lin-conta-ap.cod-estabel = lin-i-ap.cod-estabel
    and   lin-conta-ap.cod-esp     = lin-i-ap.cod-esp
    and   lin-conta-ap.serie       = lin-i-ap.serie
    and   lin-conta-ap.nr-docto    = lin-i-ap.nr-docto
    and   lin-conta-ap.parcela     = lin-i-ap.parcela
    and   lin-conta-ap.cod-fornec  = lin-i-ap.cod-fornec
    and   lin-conta-ap.char-1      = " ":

    if  lin-conta-ap.vl-movto = 0 then
        next.
     
     create tit-conta-ap.
     assign tit-conta-ap.ep-codigo    = lin-conta-ap.ep-codigo
            tit-conta-ap.cod-estab    = lin-conta-ap.cod-estab
            tit-conta-ap.cod-esp      = lin-conta-ap.cod-esp
            tit-conta-ap.serie        = lin-conta-ap.serie
            tit-conta-ap.nr-docto     = lin-conta-ap.nr-docto
            tit-conta-ap.parcela      = lin-conta-ap.parcela
            tit-conta-ap.cod-forn     = lin-conta-ap.cod-forn
            tit-conta-ap.ct-codigo    = lin-conta-ap.ct-codigo
            tit-conta-ap.sc-codigo    = lin-conta-ap.sc-codigo
            tit-conta-ap.conta-debito = lin-conta-ap.conta-debito
            tit-conta-ap.vl-movto     = lin-conta-ap.vl-movto
            tit-conta-ap.vl-movto-me  = lin-conta-ap.vl-movto-me.
        
     if i-pais-impto-usuario = 4 then do:          
          if i-qtde-contas = 1 then
             assign tit-conta-ap.vl-movto     = lin-i-ap.vl-liquido 
                    tit-conta-ap.vl-movto-me  = lin-i-ap.vl-liquido-me.
          else do:
             assign tit-conta-ap.vl-movto     = lin-conta-ap.vl-movto
                    tit-conta-ap.vl-movto-me  = lin-conta-ap.vl-movto-me.
          end.
     end.
     else
        assign tit-conta-ap.vl-movto     = lin-conta-ap.vl-movto
               tit-conta-ap.vl-movto-me  = lin-conta-ap.vl-movto-me.
                                  
     
     if  c-nom-prog-upc-mg97  <> "" or  
         c-nom-prog-dpc-mg97  <> "" or
         c-nom-prog-appc-mg97 <> "" then do: 

         for each tt-epc 
         where tt-epc.cod-event = "atualiza-tit-conta-ap":
            delete tt-epc.
         end.          

         create tt-epc.
         assign tt-epc.cod-event = "atualiza-tit-conta-ap"
                tt-epc.cod-parameter    = "Alteracao"
                tt-epc.val-parameter    = string(rowid(lin-conta-ap)) + "," + string(rowid(tit-conta-ap)).

         {include/i-epc201.i "atualiza-tit-conta-ap"}
      end.

      /*--- Execu‡Æo Or‡ament ria - Varias Contas ---*/
      &if "{&mgadm_version}" >= "2.04" &then
          if  l-execucao-orcamentaria = yes then do:
          
              {cdp/cd1001.i3}
              IF  (v-log-ap-bgc-varias-ctas AND lin-i-ap.conta-debito = "") THEN DO:            
                   run pi-execucao-orcamentaria-varias in this-procedure.
              END.
          end.
      &endif 
               
      delete lin-conta-ap.
      

end.


/* Rateio em v rias contas para o Documento de Imposto */
for each  lin-conta-ap exclusive-lock
    where lin-conta-ap.ep-codigo   = lin-i-ap.ep-codigo
    and   lin-conta-ap.cod-estabel = lin-i-ap.cod-estabel
    and   lin-conta-ap.cod-esp     = lin-i-ap.cod-esp
    and   lin-conta-ap.serie       = lin-i-ap.serie
    and   lin-conta-ap.nr-docto    = lin-i-ap.nr-docto
    and   lin-conta-ap.parcela     = lin-i-ap.parcela
    and   lin-conta-ap.cod-fornec  = lin-i-ap.cod-fornec
    and   lin-conta-ap.char-1      <> " ":

    if  lin-conta-ap.vl-movto = 0 then
        next.

    create tit-conta-ap.
    assign tit-conta-ap.ep-codigo    = lin-conta-ap.ep-codigo
           tit-conta-ap.cod-estab    = lin-conta-ap.cod-estab
           tit-conta-ap.cod-esp      = trim(substr(lin-conta-ap.char-1,1,2))
           tit-conta-ap.serie        = trim(substr(lin-conta-ap.char-1,3,5))
           tit-conta-ap.nr-docto     = trim(substr(lin-conta-ap.char-1,8,16))
           tit-conta-ap.parcela      = trim(substr(lin-conta-ap.char-1,24,2))
           tit-conta-ap.cod-forn     = lin-conta-ap.cod-forn
           tit-conta-ap.ct-codigo    = lin-conta-ap.ct-codigo
           tit-conta-ap.sc-codigo    = lin-conta-ap.sc-codigo
           tit-conta-ap.conta-debito = lin-conta-ap.conta-debito
           tit-conta-ap.vl-movto     = lin-conta-ap.vl-movto
           tit-conta-ap.vl-movto-me  = lin-conta-ap.vl-movto-me. 
    if i-pais-impto-usuario = 4 then do:
         &if DEFINED (BF_FIN_206) &then
             ASSIGN tit-conta-ap.tipo-impto = lin-conta-ap.tipo-impto.
         &else
             ASSIGN tit-conta-ap.int-2      = lin-conta-ap.int-2.
         &endif
    end.
    
    delete lin-conta-ap.

end.
/* Fim Include */
