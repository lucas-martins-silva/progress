for each tt-impto-tit-pend-ap-aux:
   delete tt-impto-tit-pend-ap-aux.
end.
for each tt-doc-b-ap:
    delete tt-doc-b-ap.
end.
for each tt-lin-b-ap:
    delete tt-lin-b-ap.
end.
for each tt-l-ant-ap:
    delete tt-l-ant-ap.
end.
for each tt-l-pre-ap:
    delete tt-l-pre-ap.
end.
for each tt-retorno-lin-b-ap:
    delete tt-retorno-lin-b-ap.
end.

for each b-tt-documento
    where b-tt-documento.vl-saldo = 0:

    assign d-tot-impto = 0.
    for each impto-tit-pend-ap no-lock
       where impto-tit-pend-ap.ep-codigo  = b-tt-documento.ep-codigo
         and impto-tit-pend-ap.cod-estab  = b-tt-documento.cod-estabel
         and impto-tit-pend-ap.cod-esp    = b-tt-documento.cod-esp
         and impto-tit-pend-ap.serie      = b-tt-documento.serie
         and impto-tit-pend-ap.nr-docto   = b-tt-documento.nr-docto
         and impto-tit-pend-ap.parcela    = b-tt-documento.parcela
         and impto-tit-pend-ap.cod-fornec = b-tt-documento.cod-fornec
         and impto-tit-pend-ap.trans-impto-ap = 2:
         assign d-tot-impto = d-tot-impto + impto-tit-pend-ap.vl-imposto.
    end.

    assign d-tot-movto = d-tot-movto + d-tot-impto.
    
    if d-tot-movto > 0 then do:
        if not l-ch-apapi003 then do:
            do i-cont = 1 to 9999:
                find first lin-b-ap use-index codigo no-lock
                     where lin-b-ap.ep-codigo  = b-tt-documento.ep-codigo
                       and lin-b-ap.referencia = string(month(today),"99") + string(day(today)  ,"99") + substr(string(year(today),"9999"), 3,2) + string(i-cont) no-error.
                if avail lin-b-ap then
                    next.
    
                find first mov-ap use-index codigo no-lock
                     where mov-ap.ep-codigo   = b-tt-documento.ep-codigo
                       and mov-ap.cod-fornec  = b-tt-documento.cod-fornec
                       and mov-ap.cod-estabel = b-tt-documento.cod-estabel
                       and mov-ap.referencia  = string(month(today),"99") + string(day(today)  ,"99") + substr(string(year(today),"9999"), 3,2) + string(i-cont) no-error.
                if avail mov-ap then
                    next.
    
                assign c-seq-refer = string(month(today),"99") + string(day(today)  ,"99") + substr(string(year(today),"9999"), 3,2) + STRING(i-cont).
                leave.
            end.
    
            assign l-ch-apapi003 = yes.
    
            create tt-doc-b-ap.
            assign tt-doc-b-ap.ep-codigo                  = b-tt-documento.ep-codigo
                   tt-doc-b-ap.referencia                 = c-seq-refer
                   tt-doc-b-ap.cod-estabel                = b-tt-documento.cod-estabel
                   tt-doc-b-ap.cod-esp                    = b-tt-documento.cod-esp
                   tt-doc-b-ap.data-movto                 = tt-param.dt-transacao
                   tt-doc-b-ap.total-movto                = 0
                   tt-doc-b-ap.mo-codigo                  = 1
                   tt-doc-b-ap.ind-sit-lote-liquidacao-ap = 1
                   tt-doc-b-ap.cod-versao-integ           = 001
                   tt-doc-b-ap.ind-elimina-lote           = 1.
        end.
    
        find last tt-lin-b-ap use-index codigo
            where tt-lin-b-ap.ep-codigo      = b-tt-documento.ep-codigo
              and tt-lin-b-ap.referencia     = c-seq-refer no-error.
    
        if avail tt-lin-b-ap then
            assign i-cont = tt-lin-b-ap.sequencia + 10.
        else
            assign i-cont = 10.
    
        create tt-lin-b-ap.
        assign tt-lin-b-ap.ep-codigo         = b-tt-documento.ep-codigo
               tt-lin-b-ap.referencia        = c-seq-refer
               tt-lin-b-ap.sequencia         = i-cont
               tt-lin-b-ap.transacao         = 2
               tt-lin-b-ap.serie             = b-tt-documento.serie
               tt-lin-b-ap.nr-docto          = b-tt-documento.nr-docto
               tt-lin-b-ap.parcela           = b-tt-documento.parcela
               tt-lin-b-ap.nr-cheque         = 0
               tt-lin-b-ap.dt-baixa          = tt-param.dt-transacao
               tt-lin-b-ap.vl-baixa          = d-tot-impto
               tt-lin-b-ap.vl-desconto       = b-tt-documento.vl-desconto-conf
               tt-lin-b-ap.vl-juros          = b-tt-documento.vl-juros-conf
               &if defined(BF_FIN_MULTA_ABATIMENTO) &then
               tt-lin-b-ap.vl-abatimento    = b-tt-documento.vl-abatimento
               tt-lin-b-ap.vl-multa         = b-tt-documento.vl-multa
               tt-lin-b-ap.vl-abatimento-me = b-tt-documento.vl-abatimento-me
               tt-lin-b-ap.vl-multa-me      = b-tt-documento.vl-multa-me
               &endif                        
               tt-lin-b-ap.portador         = tt-param.i-portador
               tt-lin-b-ap.int-2            = 1
               tt-lin-b-ap.cod-esp          = b-tt-documento.cod-esp
               tt-lin-b-ap.cod-estabel      = b-tt-documento.cod-estabel
               tt-lin-b-ap.cod-fornec       = b-tt-documento.cod-fornec
               tt-lin-b-ap.origem           = 1
               tt-lin-b-ap.cotacao-dia      = 1
               tt-lin-b-ap.dt-vencimen      = b-tt-documento.dt-vencimen
               tt-lin-b-ap.mo-codigo        = 0
               tt-lin-b-ap.estado           = 1
               tt-lin-b-ap.vl-baixa-me      = d-tot-impto
               tt-lin-b-ap.vl-desconto-me   = b-tt-documento.vl-desconto-conf
               tt-lin-b-ap.vl-juros-me      = b-tt-documento.vl-juros-conf
               tt-lin-b-ap.ind-liberado-pag = yes.
    
        for each impto-tit-pend-ap exclusive-lock
           where impto-tit-pend-ap.ep-codigo  = b-tt-documento.ep-codigo
             and impto-tit-pend-ap.cod-estab  = b-tt-documento.cod-estabel
             and impto-tit-pend-ap.cod-esp    = b-tt-documento.cod-esp
             and impto-tit-pend-ap.serie      = b-tt-documento.serie
             and impto-tit-pend-ap.nr-docto   = b-tt-documento.nr-docto
             and impto-tit-pend-ap.parcela    = b-tt-documento.parcela
             and impto-tit-pend-ap.cod-fornec = b-tt-documento.cod-fornec:
    
            &if "{&mgadm_version}" >= "2.07" &then
                assign impto-tit-pend-ap.cod-refer-pagto = tt-lin-b-ap.referencia
                       impto-tit-pend-ap.num-seq-pagto  = tt-lin-b-ap.sequencia.
            &else
                assign substring(impto-tit-pend-ap.char-2,04,10) = string(tt-lin-b-ap.referencia)
                       substring(impto-tit-pend-ap.char-2,14,06) = string(tt-lin-b-ap.sequencia).
            &endif
        end.
    
        for each lin-b-ap exclusive-lock
            where lin-b-ap.ep-codigo   = b-tt-documento.ep-codigo
              and lin-b-ap.cod-fornec  = b-tt-documento.cod-fornec
              and lin-b-ap.cod-estabel = b-tt-documento.cod-estabel
              and lin-b-ap.cod-esp     = b-tt-documento.cod-esp
              and lin-b-ap.serie       = b-tt-documento.serie
              and lin-b-ap.nr-docto    = b-tt-documento.nr-docto
              and lin-b-ap.parcela     = b-tt-documento.parcela:
            delete lin-b-ap.
        end.
    
        find first tit-ap exclusive-lock
             where tit-ap.ep-codigo   = b-tt-documento.ep-codigo
             and   tit-ap.cod-estabel = b-tt-documento.cod-estabel
             and   tit-ap.cod-esp     = b-tt-documento.cod-esp
             and   tit-ap.serie       = b-tt-documento.serie
             and   tit-ap.cod-fornec  = b-tt-documento.cod-fornec
             and   tit-ap.nr-docto    = b-tt-documento.nr-docto
             and   tit-ap.parcela     = b-tt-documento.parcela no-error.
        if avail tit-ap then do:
            assign tit-ap.nr-bordero = 0.
    
            find first mov-ap exclusive-lock
                 where mov-ap.ep-codigo = tit-ap.ep-codigo
                   and mov-ap.cod-estab = tit-ap.cod-estab
                   and mov-ap.serie     = tit-ap.serie
                   and mov-ap.cod-forne = tit-ap.cod-fornec
                   and mov-ap.cod-esp   = tit-ap.cod-esp
                   and mov-ap.nr-docto  = tit-ap.nr-docto
                   and mov-ap.parcela   = tit-ap.parcela
                   and mov-ap.transacao = 1 no-error.
            if avail mov-ap then
                assign mov-ap.nr-bordero = 0.
        end.
           
        find first bord-rec exclusive-lock
             where bord-rec.ep-codigo  = b-tt-documento.ep-codigo
               and bord-rec.nr-bordero = b-tt-documento.nr-bordero no-error.
        if avail bord-rec then do:
            &if "{&mgadm_version}" >= "2.07" &then
                assign bord-rec.cod-refer-sem-desemb = c-seq-refer.
            &else
                assign substring(bord-rec.char-1,1,10) = c-seq-refer.
            &endif
        end.
    
        find first bord-tit exclusive-lock
             where bord-tit.ep-codigo   = b-tt-documento.ep-codigo  
               and bord-tit.nr-bordero  = b-tt-documento.nr-bordero 
               and bord-tit.portador    = b-tt-documento.portador   
               and bord-tit.cod-fornec  = b-tt-documento.cod-fornec 
               and bord-tit.cod-estabel = b-tt-documento.cod-estabel
               and bord-tit.cod-esp     = b-tt-documento.cod-esp    
               and bord-tit.serie       = b-tt-documento.serie      
               and bord-tit.nr-docto    = b-tt-documento.nr-docto   
               and bord-tit.parcela     = b-tt-documento.parcela no-error.
        if avail bord-tit then
            delete bord-tit.
    
        delete b-tt-documento.
    end.
end.
if l-ch-apapi003 then do:
       
    find first tt-doc-b-ap no-error.
    if avail tt-doc-b-ap then
        assign tt-doc-b-ap.total-movto = d-tot-movto.

    run app/apapi003a.p (input  table tt-doc-b-ap,
                         input  table tt-lin-b-ap,
                         input  table tt-l-ant-ap,
                         input  table tt-l-pre-ap,
                         input  table tt-impto-tit-pend-ap-aux,
                         output table tt-retorno-lin-b-ap).
end.
