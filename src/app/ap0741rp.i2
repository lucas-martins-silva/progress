/*******************************************************************************
***
*** app/ap0741rp.i2 - Form's.
***
*******************************************************************************/

form
   tt-mov-ap.cod-estabel
   tt-mov-ap.cod-esp
   tt-mov-ap.serie
   tt-mov-ap.nr-docto
   tt-mov-ap.parcela
   c-trans format "x(03)"
   tt-mov-ap.portador
   tt-mov-ap.modalidade
   tt-mov-ap.referencia
   tt-mov-ap.dt-transacao
   tt-mov-ap.dt-vencimen
   tt-mov-ap.valor-mov format "->>,>>>,>>>,>>9.99"
   tt-mov-ap.cod-lancto column-label "LC"
   with down no-box no-attr width 132 stream-io frame f-detalhe.

form c-text-1                    no-label at 01 skip(2)
     tt-param.cod-estabel-ini    colon 50 
     "|< >|"                     at 63
     tt-param.cod-estabel-fim    no-label colon 70 skip
     tt-param.cod-esp-ini        colon 50 
     "|< >|"                     at 63
     tt-param.cod-esp-fim        no-label colon 70 skip
     tt-param.grupo-ini          colon 50 
     "|< >|"                     at 63
     tt-param.grupo-fim          no-label colon 70 skip
     tt-param.cod-forn-ini       colon 50 format ">>>>>>>>9"
     "|< >|"                     at 63
     tt-param.cod-forn-fim       no-label format ">>>>>>>>9" colon 70 skip
     tt-param.matriz-ini         colon 50 format ">>>>>>>>9"
     "|< >|"                     at 63
     tt-param.matriz-fim         no-label format ">>>>>>>>9" colon 70
     tt-param.dt-trans-ini       colon 50 format "99/99/9999"
     "|< >|"                     at 63
     tt-param.dt-trans-fim       no-label format "99/99/9999" colon 70
     tt-param.moeda-ini          colon 50 
     "|< >|"                     at 63
     tt-param.moeda-fim          no-label colon 70 skip(2)
     c-text-4                    no-label at 01 skip(2)
     tt-param.desc-classif       colon 30 no-label skip(2)
     c-text-2                    no-label at 01 skip(2)  
     tt-param.des-tipo-emissao   colon 50 skip
     tt-param.des-cal-atraso     colon 50 skip
     tt-param.log-esp-ctbl       colon 50 skip
     tt-param.log-razao-ficha    colon 50 skip
     tt-param.log-vinculado      colon 50 skip
     tt-param.log-salt-linha     colon 50 skip

     tt-param.log-prev-saldo     colon 50 skip
     tt-param.log-prev-perfil    colon 50 skip
     tt-param.log-saldo-movto    colon 50 skip
     tt-param.log-cons-mo-orig   colon 50 skip
     tt-param.log-lista-variacao colon 50 skip
     tt-param.i-cod-moeda        colon 50 
     " - "
     tt-param.des-moeda          no-label skip
     tt-param.da-conversao       format "99/99/9999" colon 50 skip
     tt-param.de-cotacao-dia     colon 50 skip(2)
     c-text-3                    no-label at 01 skip(2)
     c-destino                   format "x(80)" colon 50 skip
     tt-param.usuario            colon 50 skip(02)
     with down no-box side-labels stream-io width 132 frame f-parametros .

form
    i-prazo       colon 50
    de-tot-saldo  colon 100 format "-zzz,zzz,zzz,zz9.99"
    c-lancto1     no-label
    i-atraso      colon 50
    de-tot-atual  colon 100 format "-zzz,zzz,zzz,zz9.99"
    c-lancto2     no-label skip(1)
    with side-labels width 132 stream-io frame f-medio.

form
    tt-mov-ap.cod-fornec   at 01
    tt-mov-ap.nome-emit    at 13
    de-tot-saldo           at 55 format "-zzz,zzz,zzz,zz9.99"
    c-lancto1              no-label
    de-tot-atual           at 80 format "-zzz,zzz,zzz,zz9.99"
    c-lancto2              no-label
    i-prazo                at 105
    i-atraso               at 120
    with down no-box no-attr-space width 132 stream-io frame f-resumo.
    
{utp/ut-liter.i Nome_Emitente}
assign tt-mov-ap.nome-emit:label in frame f-resumo = trim(return-value).

form
    de-tot-saldo           at 55 format "-zzz,zzz,zzz,zz9.99"
    c-lancto1              no-label
    de-tot-atual           at 80 format "-zzz,zzz,zzz,zz9.99"
    c-lancto2              no-label
    i-prazo                at 105
    i-atraso               at 120
    with down no-box no-attr-space width 132 stream-io frame f-resumo1.

form
    de-total-geral-db colon 50  format "-zzz,zzz,zzz,zz9.99":U
    de-ger-saldo      colon 100 format "-zzz,zzz,zzz,zz9.99":U
    c-lancto1         no-label  skip
    de-total-geral-cr colon 50  format "-zzz,zzz,zzz,zz9.99":U
    de-ger-atual      colon 100 format "-zzz,zzz,zzz,zz9.99":U
    c-lancto2         no-label skip
    de-tot-pef        colon 50 format "-zzz,zzz,zzz,zz9.99":U
    c-lancto3         no-label
    with side-labels width 132 stream-io frame f-geral.

form
    de-ger-saldo      colon 78 format "-zzz,zzz,zzz,zz9.99":U
    c-lancto1         no-label  skip
    de-ger-atual      colon 78 format "-zzz,zzz,zzz,zz9.99":U
    c-lancto2         no-label skip
    with side-labels width 132 stream-io frame f-geral1.

form
   c-vencto        at 20
   de-vencimen[1]  at 52
   de-percent[1]   at 73
   de-venc-acum[1] at 86
   de-perc-acum[1] at 107 skip(1)
   with down no-box no-attr-space no-labels width 132 stream-io frame f-perfil.

form
    skip(2)
    i-prazo  colon 65 skip(1)
    i-atraso colon 65
    with no-box no-attr-space side-labels width 132 stream-io frame f-pmc-amp.
run utp/ut-trfrrp.p (input frame f-detalhe:handle).
run utp/ut-trfrrp.p (input frame f-parametros:handle).
run utp/ut-trfrrp.p (input frame f-medio:handle).
run utp/ut-trfrrp.p (input frame f-resumo:handle).
run utp/ut-trfrrp.p (input frame f-resumo1:handle).
run utp/ut-trfrrp.p (input frame f-geral:handle).
run utp/ut-trfrrp.p (input frame f-geral1:handle).
run utp/ut-trfrrp.p (input frame f-perfil:handle).
run utp/ut-trfrrp.p (input frame f-pmc-amp:handle).

/* Fim de Include */
