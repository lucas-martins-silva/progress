/*******************************************************************************
***
*** app/ap0511.i6 - Defini‡Æo temp-table.
***
*******************************************************************************/

define {1} temp-table tt-param no-undo
    field destino          as integer
    field arquivo          as char
    field usuario          as char format "x(12)"
    field data-exec        as date
    field hora-exec        as integer
    field for-ini          like che-emit.cod-fornec
    field for-fim          like che-emit.cod-fornec
    field dat-ini          like che-emit.dt-emissao    
    field dat-fim          like emite-ap.dt-vencimen
    field num-ini          like che-emit.nr-docto
    field num-fim          like che-emit.nr-docto
    field reemissao        as logical
    field cheque-ini       like che-emit.nr-cheque
    field cheque-fim       like che-emit.nr-cheque
    field portador         like che-emit.portador
    field i-ep-codigo      like empresa.ep-codigo
    field banco            as integer 
    field formulario       as logical 
    field gerar            as logical 
    field imp-hist         as logical
    field copia            as char format "x(40)"
    field quant            as integer 
    field text-quant       as char format "x(40)"   
    field list-tipo        as integer
    field list-text        as char format "x(40)"
    field imp              as integer 
    field text-imp         as char format "x(40)"  
    field colum            as integer
    field text-colum       as char format "x(40)"
    field conf-favorec     as logical /*fun‡Æo conf-favorec*/
    .

define {1} temp-table tt-digita no-undo
    field ordem            as integer   format ">>>>9"
    field exemplo          as character format "x(30)"
    index id is primary unique
        ordem.

/* Fim de Include */
