/***************************************************************************
***
***  ap1001c.i2 
***  Objetivo: Gerar detalhe Segmentos A, J, K e L.
***
***************************************************************************/

if  l-antecipacao = no then
    find first emitente
         where emitente.cod-emitente = mov-ap.cod-fornec
         and   emitente.identific   <> 1 no-lock no-error.
else
    find first emitente
         where emitente.cod-emitente = bordero-ap.cod-fornec
         and   emitente.identific   <> 1 no-lock no-error.

if  not avail emitente then
    next.

assign i-num-reg       = i-num-reg + 1
       c-carteira      = tt-digita.ita-carteira
       l-aceite        = tt-digita.ita-aceite
       c-uso-banco-ita = tt-digita.ita-uso-banco.

if  l-antecipacao = no then do:
    &if defined(BF_FIN_MULTA_ABATIMENTO) &then
        assign de-desconto = tit-ap.vl-isr * 100
               de-abatimen = tit-ap.vl-abatimento-tot * 100
               de-juros    = tit-ap.dec-2 * 100
               de-multa    = tit-ap.vl-multa-tot * 100.

    &else
        assign de-desconto = tit-ap.vl-isr * 100
               de-juros    = tit-ap.dec-2  * 100.
    &endif
end.
else
    assign de-desconto = 0
           de-abatimen = 0
           de-juros    = 0
           de-multa    = 0.

if  tt-param.i-tipo-pag < 30 
or  tt-param.i-tipo-pag = 83 
or  tt-param.i-tipo-pag = 85 then do:
    assign i-lote = 1.

    /*--- Segmento A ---*/
    assign i-num-reg-arq = i-num-reg-arq + 1.
    put stream relat
        "399"                                                             at 001
        tt-param.i-sequencia                       format "9999"          at 004
        "3"                                                               at 008
        i-num-reg                                  format "99999"         at 009
        "A"                                                               at 014
        "0"                                                               at 015
        "00"                                                              at 016.

    if tt-param.i-tipo-pag = 83 
    or tt-param.i-tipo-pag = 85 then 
       put stream relat 
           "018"                                                          at 018. 
    else if tt-param.i-tipo-pag = 03 then
       put stream relat 
           "700"                                                          at 018.
    else
       put stream relat
           "   "                                                          at 018.

    put stream relat    
        fill("0",3 - length(trim(string(tt-digita.banco)))) + 
        trim(substr(string(tt-digita.banco),1,3))  format "999"   at 021
        substr(tt-digita.agencia,2,5)              format "99999"         at 024
        " "                                                               at 029
        fill("0",13 - length(trim(c-cc-forn))) + 
        trim(substr(c-cc-forn,1,13))               format "9999999999999" at 030
        " "                                                               at 043
        fn-free-accent(caps(emitente.nome-emit))   format "x(30)"         at 044.


    if  l-antecipacao = no then
        put stream relat    
            substr(string(year(today),"9999"),3,2) format "99"            at 074
	    month(today)                           format "99"            at 076
	    day(today)                             format "99"            at 078
            string(mov-ap.num-id-mov-ap)           format "x(10)"         at 080.
    else
        put stream relat    
            substr(string(year(today),"9999"),3,2) format "99"            at 074
            month(today)                           format "99"            at 076
            day(today)                             format "99"            at 078
            caps(bordero-ap.char-2)                format "x(10)"         at 080.      

    if  l-antecipacao = no then do:
        if  tit-ap.dt-vencimen < today then
            put stream relat
            day(tt-param.da-pagto)                                format "99" at 094
            month(tt-param.da-pagto)                              format "99" at 096
            substr(string(year(tt-param.da-pagto),"9999"),3,2)    format "99" at 098.
        else
            put stream relat
            day(tit-ap.dt-vencimen)                               format "99" at 094
            month(tit-ap.dt-vencimen)                             format "99" at 096
            substr(string(year(tit-ap.dt-vencimen),"9999"),3,2)   format "99" at 098.
    end.
    else do:
        if  bordero-ap.dt-vencto < today then
            put stream relat
            day(tt-param.da-pagto)                                format "99" at 094
            month(tt-param.da-pagto)                              format "99" at 096
            substr(string(year(tt-param.da-pagto),"9999"),3,2)    format "99" at 098.
        else
            put stream relat
            day(bordero-ap.dt-vencto)                               format "99" at 094
            month(bordero-ap.dt-vencto)                             format "99" at 096
            substr(string(year(bordero-ap.dt-vencto),"9999"),3,2)   format "99" at 098.
    end.

    put stream relat
        "R$ "                                                             at 100
        "                 "                                               at 103
        de-valor-pag                               format "9999999999999" at 120
        "                                         "                       at 133.

    if  l-antecipacao = no then
        put stream relat
            string(mov-ap.num-id-mov-ap)       format "x(20)"             at 174.
    else 
        put stream relat
            bordero-ap.char-2                  format "x(20)"             at 174.

    put stream relat
        "                    "                                            at 194
        "                "                                                at 214
        "0"                                                               at 230
        "          "                                                      at 231 
        skip.

    /*--- Segmento B ---*/
    assign i-num-reg-arq = i-num-reg-arq + 1
           i-num-reg     = i-num-reg     + 1.
    put stream relat
        "399"                                                             at 001
        tt-param.i-sequencia                      format "9999"           at 004
        "3"                                                               at 008
        i-num-reg                                 format "99999"          at 009
        "B"                                                               at 014
        "   "                                                             at 015.

    if emitente.natureza = 1 then
        put stream relat
            "1"                                                           at 018.
    else
        put stream relat
            "2"                                                           at 018.

    put stream relat
        de-inscric                                format "99999999999999" at 019
        c-endereco                                format "x(30)"          at 033
        c-bairro                                  format "x(15)"          at 083
        c-cidade                                  format "x(20)"          at 098
        i-cep                                     format "99999999"       at 118
        c-estado                                  format "x(02)"          at 126
        "                                      "                          at 128
        "                                      "                          at 166
        "                                     "                           at 204
        skip.
end.
else do:

    if  tt-digita.log-leitora = no then
        assign c-cod-barras = substring(tt-digita.c-cod-barras,01,04)
                            + substring(tt-digita.c-cod-barras, 33,01)
                            + string(dec(substring(tt-digita.c-cod-barras,34,14)), "99999999999999")
                            + substring(tt-digita.c-cod-barras, 05,05)
                            + substring(tt-digita.c-cod-barras, 11,10)
                            + substring(tt-digita.c-cod-barras, 22,10).
    else
        assign c-cod-barras = tt-digita.c-cod-barras.

    assign i-num-reg-arq = i-num-reg-arq + 1.

     put stream relat
         "399"                                                             at 001
         tt-param.i-sequencia                      format "9999"           at 004
         "3"                                                               at 008
         i-num-reg                                 format "99999"          at 009
         "J"                                                               at 014
         "0"                                                               at 015
         "00"                                                              at 016
         c-cod-barras                                      format "x(44)"  at 018         
         fn-free-accent(caps(emitente.nome-abrev))         format "x(30)"  at 062.

     if l-antecipacao = no then    
         put stream relat
             day(tit-ap.dt-vencimen)                              format "99"  at 092
             month(tit-ap.dt-vencimen)                            format "99"  at 094
             substr(string(year(tit-ap.dt-vencimen),"9999"),3,2)  format "99"  at 096.
     else
         put stream relat
             day(bordero-ap.dt-vencto)                              format "99"  at 092
             month(bordero-ap.dt-vencto)                            format "99"  at 094
             substr(string(year(bordero-ap.dt-vencto),"9999"),3,2)  format "99"  at 096.     

     put stream relat 
         ((de-valor-ori - vl-tot-impto) * 100)                      format "9999999999999"  at 102
         (de-abatimen + de-desconto)               format "9999999999999"  at 117
         (de-juros + de-multa)                     format "9999999999999"  at 132.

     if l-antecipacao = no then do:
        if  tit-ap.dt-vencimen < today then
            put stream relat 
                day(tt-param.da-pagto)                             format "99" at 145
                month(tt-param.da-pagto)                           format "99" at 147
                substr(string(year(tt-param.da-pagto),"9999"),3,2) format "99" at 149.
        else
            put stream relat
                day(tit-ap.dt-vencimen)                            format "99" at 145
                month(tit-ap.dt-vencimen)                          format "99" at 147
                substr(string(year(tit-ap.dt-vencimen),"9999"),3,2)format "99" at 149.         
     end.
     else do:
        if  bordero-ap.dt-vencto < today then
            put stream relat 
                day(tt-param.da-pagto)                             format "99" at 145
                month(tt-param.da-pagto)                           format "99" at 147
                substr(string(year(tt-param.da-pagto),"9999"),3,2) format "99" at 149.
        else
            put stream relat
                day(bordero-ap.dt-vencto)                            format "99" at 145
                month(bordero-ap.dt-vencto)                          format "99" at 147
                substr(string(year(bordero-ap.dt-vencto),"9999"),3,2)format "99" at 149.         
     end.             

     put stream relat
         de-valor-pag                              format "9999999999999"   at 155.

     if  l-antecipacao = no then
         put stream relat
             string(mov-ap.num-id-mov-ap)                 format "x(20)"          at 183.
     else 
         put stream relat
             bordero-ap.char-2                     format "x(20)"          at 183.


     put stream relat
         "                                      "                          at 203 skip.
end.

/* Fim ap1001c.i2 */

