/*******************************************************************************
**
**  Include.: AP0597.I1
**  Objetivo: Pular p gina quando exceder o numero de linhas no cheque
**
*******************************************************************************/

if  i-linha = 14
/*and not last-of(che-emit.cod-fornec)*/
and not last-of(che-emit.literal) then do:
    assign l-continua-cheque = yes.
    
    disp c-total 
         de-tot-orig    
         with frame f-imp-3.
    if tt-param.l-copia = yes then
       disp c-total 
            de-tot-orig    
            with frame f-imp-3.    

    disp fill("*",132) @ c-asterisco
         c-cancelado 
         c-cancelado2
         with frame f-teste-4.    

    if tt-param.l-copia = yes then do:
       disp stream s-copia
            c-total 
            with frame f-teste-3.
       
       disp stream s-copia
            c-cancelado
            c-cancelado2
            with frame f-teste-4.    
    end.    
    
 /*   do i-cont = 1 to 6:
       disp ""
            with frame f-branco.
       down with frame f-branco.
       if tt-param.l-copia = yes then do:
          disp stream s-copia
               ""
               with frame f-branco.
          down with frame f-branco.
       end.
    end.         */

    {utp/ut-liter.i Verifique_pr¢ximo_cheque * R}
    create b-che-emit.
    assign b-che-emit.ep-codigo     = che-emit.ep-codigo
           b-che-emit.portador      = che-emit.portador
           b-che-emit.nr-cheque     = che-emit.nr-cheque
           b-che-emit.cod-estabel   = che-emit.cod-estabel
           b-che-emit.cod-fornec    = che-emit.cod-fornec
           b-che-emit.cod-esp       = che-emit.cod-esp
           b-che-emit.serie         = " "
           b-che-emit.nr-docto      = " "
           b-che-emit.parcela       = " "
           b-che-emit.dt-emissao    = che-emit.dt-emissao
           b-che-emit.dt-vencto     = che-emit.dt-vencto
           b-che-emit.transacao     = 1
           b-che-emit.referencia    = " "
           b-che-emit.nominal       = che-emit.nominal
           b-che-emit.literal       = che-emit.literal
           b-che-emit.valor-docto   = 0
           b-che-emit.ct-conta      = " "
           b-che-emit.sc-conta      = " "
           b-che-emit.conta-debito  = " "
           b-che-emit.historico     = return-value
           b-che-emit.nr-talonario  = talonario.nr-talonario
           b-che-emit.emitiu        = yes
           b-che-emit.cancelado     = yes.

    assign i-linha  = 0
           talonario.ult-cheque = talonario.prox-cheque.

    if  talonario.ult-cheque = talonario.nr-cheque-fin then do:
        assign talonario.situacao = 3. /* Utilizado */
        leave code-block.
    end.
    else 
        assign talonario.prox-cheque = talonario.prox-cheque + 1.
    
    assign che-emit.nr-cheque = talonario.prox-cheque.
    disp che-emit.cod-fornec 
         che-emit.nr-cheque  
         with frame f-imp-1.
    if tt-param.l-copia = yes then 
       disp stream s-copia
            che-emit.cod-fornec 
            che-emit.nr-cheque  
            with frame f-imp-1.
end.

/* AP0597.I1 */
