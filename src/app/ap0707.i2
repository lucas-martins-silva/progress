/*************************************************************************
**
** Include: ap0707.i - Complemento do programa ap0707rp.p
**
*************************************************************************/

/* Impress∆o Termo de Encerramento */
if  i-pag-diario >= param-ap.ult-pg-diar 
and param-ap.ult-pg-diar <> 0
and l-termo-encerra = no then do:

    hide frame f-cab no-pause.
    assign l-view = no.
    page.

    find termo
        where termo.te-codigo = param-ap.te-ence-diar
        no-lock no-error.
     disp termo.descricao
          termo.texto with frame f-termo.
     assign i-pag-diario = param-ap.prim-pg-diar.
     page.

    /* Impress∆o Termo de Abertura */
    find termo
        where termo.te-codigo = param-ap.te-aber-diar
        no-lock no-error.
    disp termo.descricao
         termo.texto with frame f-termo.
    assign i-pag-diario = i-pag-diario + 1.
    page.
end.

