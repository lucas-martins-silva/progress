/******************************************************************************
**
** app/ap0501e.i11 - Gera t¡tulo para impostos taxados
**
******************************************************************************/

create b-tit-ap.
assign b-tit-ap.ep-codigo       = impto-tit-pend-ap.ep-codigo
       b-tit-ap.cod-estabel     = impto-tit-pend-ap.cod-estabel
       b-tit-ap.cod-esp         = impto-tit-pend-ap.cod-esp
       b-tit-ap.serie           = impto-tit-pend-ap.serie
       b-tit-ap.nr-docto        = impto-tit-pend-ap.nr-docto
       b-tit-ap.parcela         = impto-tit-pend-ap.parcela
       b-tit-ap.cod-fornec      = impto-tit-pend-ap.cod-fornec
       b-tit-ap.transacao       = 1 /*IMD*/
       b-tit-ap.portador        = tit-ap.portador
       b-tit-ap.dt-emissao      = impto-tit-pend-ap.dt-emissao
       b-tit-ap.dt-prev-pag     = impto-tit-pend-ap.dt-vencimen
       b-tit-ap.dt-vencimen     = impto-tit-pend-ap.dt-vencimen
       b-tit-ap.referencia      = lin-i-ap.referencia 
       b-tit-ap.conta-debito    = impto-tit-pend-ap.conta-imposto
       b-tit-ap.ct-conta-db     = impto-tit-pend-ap.ct-imposto
       b-tit-ap.sc-conta-db     = impto-tit-pend-ap.sc-imposto
       b-tit-ap.tipo            = 1  /*NO*/
       b-tit-ap.nome-abrev      = emitente.nome-abrev
       b-tit-ap.cgc             = emitente.cgc
       b-tit-ap.calcula-cmi     = espec-ap.calc-var-cmi
       b-tit-ap.moeda           = impto-tit-pend-ap.mo-codigo
       b-tit-ap.cotacao-dia     = impto-tit-pend-ap.cotacao-dia
       b-tit-ap.observacao      = impto-tit-pend-ap.historico
       b-tit-ap.vl-original     = impto-tit-pend-ap.vl-imposto
       b-tit-ap.vl-liquido      = impto-tit-pend-ap.vl-imposto
       b-tit-ap.valor-saldo        = impto-tit-pend-ap.vl-imposto
       b-tit-ap.vl-orig-me      = impto-tit-pend-ap.vl-imposto-me
       b-tit-ap.vl-liquido-me   = impto-tit-pend-ap.vl-imposto-me
       b-tit-ap.vl-saldo-me     = impto-tit-pend-ap.vl-imposto-me.       
       b-tit-ap.tp-codigo       = impto-tit-pend-ap.tp-codigo.

assign c-matriz = emitente.nome-matriz.
find first emitente use-index codigo
   where emitente.nome-abrev = c-matriz
     and emitente.identific <> 1 no-lock no-error.

if  avail emitente then do:
    assign b-tit-ap.matriz = emitente.cod-emitente.
end.

create mov-ap.
assign mov-ap.ep-codigo      = impto-tit-pend-ap.ep-codigo
       mov-ap.cod-estabel    = impto-tit-pend-ap.cod-estabel
       mov-ap.nr-docto       = impto-tit-pend-ap.nr-docto
       mov-ap.parcela        = impto-tit-pend-ap.parcela
       mov-ap.serie          = impto-tit-pend-ap.serie
       mov-ap.cod-esp        = impto-tit-pend-ap.cod-esp
       mov-ap.transacao      = 1  /*IMD*/
       mov-ap.tipo           = 1  /*NO*/
       mov-ap.conta-contabil = impto-tit-pend-ap.conta-imposto
       mov-ap.ct-conta       = impto-tit-pend-ap.ct-imposto
       mov-ap.sc-conta       = impto-tit-pend-ap.sc-imposto
       mov-ap.cod-fornec     = impto-tit-pend-ap.cod-fornec
       mov-ap.portador       = b-tit-ap.portador
       mov-ap.dt-emissao     = impto-tit-pend-ap.dt-emissao
       mov-ap.dt-transacao   = impto-tit-pend-ap.dt-emissao
       mov-ap.dt-vencimen    = impto-tit-pend-ap.dt-vencimen
       mov-ap.dt-today       = today
       mov-ap.referencia     = b-tit-ap.referencia
       mov-ap.contabilizou   = no
       mov-ap.usuario        = c-seg-usuario
       mov-ap.c-time         = string(time, "HH:MM")
       mov-ap.emit-fita      = no
       mov-ap.lancamento     = 2
       mov-ap.historico      = b-tit-ap.observacao
       mov-ap.vl-original    = b-tit-ap.vl-original
      /* mov-ap.vl-liquido     = b-tit-ap.vl-liquido*/
       mov-ap.moeda          = b-tit-ap.moeda
       mov-ap.cotacao-dia    = b-tit-ap.cotacao-dia
       mov-ap.vl-orig-me     = b-tit-ap.vl-orig-me
      /* mov-ap.vl-liquido-me  = b-tit-ap.vl-liquido-me*/
       mov-ap.tp-codigo      = b-tit-ap.tp-codigo.
     
       
/* Fim de Include */

