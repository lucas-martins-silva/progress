PROCEDURE pi-cria-tt-dados-talonario:
        
    def input parameter i-tipo-movto as integer no-undo.
            
    if  avail che-emit then do:
        {cdp/cd0006c.i "AP"
                       "che-emit.ep-codigo"  
                       "che-emit.cod-estabel" 
                       "return"}
    end.
    else 
        return.
    
    if  param-global.modulo-mp = yes and tt-replica-msg.log-replica-msg = yes and l-centraliz = no then do:
    
        create tt-talonario-aux.
        buffer-copy talonario to tt-talonario-aux no-error.
        
        create tt-dados-env.                  
        assign tt-dados-env.num-sequencia  = i-seq 
               tt-dados-env.cod-tipo-reg   = 215
               tt-dados-env.ind-tipo-movto = i-tipo-movto
               tt-dados-env.identif-msg    = string(talonario.ep-codigo)  + " , " +
                                             string(talonario.cod-port)   + " , " +
                                             string(talonario.nr-talonario).
        raw-transfer tt-talonario-aux to tt-dados-env.conteudo-msg.                                    
        assign i-seq = i-seq + 1.                                     
    end.
END PROCEDURE.

PROCEDURE pi-cria-tt-dados-cheque:
        
