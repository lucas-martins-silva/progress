/**************************************************************************
**   AP1001E.I1
**   Objetivo : Registros header do banco ITAU
**************************************************************************/
    
find first empresa where empresa.ep-codigo = i-empresa no-lock no-error.
    
find first portador where portador.ep-codigo = i-empresa and
           portador.cod-portador = i-portador no-lock no-error.
    
find first cta-corrente
     where cta-corrente.cod-banco    = portador.cod-banco
     and   cta-corrente.agencia      = portador.agencia
     and   cta-corrente.conta-corren = portador.conta-corren
     no-lock no-error.
        
find banco where banco.cod-banco = portador.cod-banco no-lock no-error.

assign c-cgc-emp = "".

do i-cont = 1 to 19:
   if  substr(empresa.cgc,i-cont,1) >= "0" 
   and substr(empresa.cgc,i-cont,1) <= "9" then
       assign c-cgc-emp = c-cgc-emp + substr(empresa.cgc,i-cont,1).
end.

put stream relat
    "341"                                                                at 001
    "0000"                                                               at 004
    "0"                                                                  at 008
    "080"                                                                at 015
    "2"                                                                  at 018
    c-cgc-emp                                    format "99999999999999" at 019
    substr(cta-corren.agencia-extrato, 02,05)    format "99999"          at 053
    "00"                                                                 at 059
    substr(cta-corrente.conta-corren-ext, 01,10) format "9999999999"     at 061
    substr(cta-corrente.conta-corren-ext, 11,01) format "9"              at 072
    fn-free-accent(caps(empresa.razao-social))   format "x(30)"          at 073
    fn-free-accent(caps(banco.nome-banco))       format "x(30)"          at 103
    "1"                                                                  at 143
    today                                        format "99999999"       at 144
    substr(string(time,"HH:MM:SS"),1,2)          format "99"             at 152
    substr(string(time,"HH:MM:SS"),4,2)          format "99"             at 154
    substr(string(time,"HH:MM:SS"),7,2)          format "99"             at 156
    "000000000"                                                          at 158
    "00000"                                                              at 167
    " "                                                                  at 240 skip.

/*--- Header do Lote ---*/

assign i-lote = 1.
if tt-param.i-tipo-pag < 30 
or tt-param.i-tipo-pag = 41
or tt-param.i-tipo-pag = 43 then
   put stream relat
        "341"                                                                 at 001
        i-lote                                                                at 004
        "1"                                                                   at 008
        "C"                                                                   at 009
        "20"                                                                  at 010
        tt-param.i-tipo-pag                          format "99"              at 012
        "031"                                                                 at 014
        "2"                                                                   at 018
        c-cgc-emp                                    format "99999999999999"  at 019
        substr(cta-corren.agencia-extrato, 02,05)    format "99999"           at 053
        "00"                                                                  at 059
        substr(cta-corrente.conta-corren-ext, 01,10) format "9999999999"      at 061
        substr(cta-corrente.conta-corren-ext, 11,01) format "9"               at 072
        fn-free-accent(caps(empresa.razao-social))   format "x(30)"           at 073
        fn-free-accent(caps(empresa.endereco))       format "x(30)"           at 143
        "00000"                                                               at 173
        fn-free-accent(caps(empresa.cidade))         format "x(20)"           at 193
        empresa.cep                                  format "99999999"        at 213
        empresa.uf                                   format "!!"              at 221
        " "                                                                   at 240 skip.
        
else
   put stream relat
        "341"                                                                at 001
        i-lote                                                               at 004
        "1"                                                                  at 008
        "C"                                                                  at 009
        "20"                                                                 at 010
        tt-param.i-tipo-pag                          format "99"             at 012
        "030"                                                                at 014
        "2"                                                                  at 018
        c-cgc-emp                                    format "99999999999999" at 019
        substr(cta-corren.agencia-extrato, 02,05)    format "99999"          at 053
        "00"                                                                 at 059
        substr(cta-corrente.conta-corren-ext, 01,10) format "9999999999"     at 061
        substr(cta-corrente.conta-corren-ext, 11,01) format "9"              at 072
        fn-free-accent(caps(empresa.razao-social))   format "x(30)"          at 073
        fn-free-accent(caps(empresa.endereco))       format "x(30)"          at 143
        "00000"                                                              at 173
        fn-free-accent(caps(empresa.cidade))         format "x(20)"          at 193
        empresa.cep                                  format "99999999"       at 213
        empresa.uf                                   format "!!"             at 221
        " "                                                                  at 240 skip.

