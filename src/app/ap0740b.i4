/*******************************************************************************
***
*** app/ap0740b.i4 - pi-documento-normal.
***
*******************************************************************************/

assign tt-tit-ap.lancamento  = c-credito
       tt-tit-ap.lancamento1 = c-credito.
        
find first mov-ap use-index codigo
     where mov-ap.ep-codigo   = tit-ap.ep-codigo
     and   mov-ap.cod-estabel = tit-ap.cod-estabel
     and   mov-ap.cod-esp     = tit-ap.cod-esp
     and   mov-ap.serie       = tit-ap.serie
     and   mov-ap.nr-docto    = tit-ap.nr-docto
     and   mov-ap.parcela     = tit-ap.parcela
     and   mov-ap.cod-fornec  = tit-ap.cod-fornec
     and  (mov-ap.transacao   = 2
     or    mov-ap.transacao   = 5
     or    mov-ap.transacao   = 3
     or   (mov-ap.transacao   = 6
     and   mov-ap.lancamento  = 1)) no-lock no-error.
        
if  avail mov-ap then do:
    for each  mov-ap use-index codigo
        where mov-ap.ep-codigo    = tit-ap.ep-codigo
        and   mov-ap.cod-estabel  = tit-ap.cod-estabel
        and   mov-ap.cod-esp      = tit-ap.cod-esp
        and   mov-ap.serie        = tit-ap.serie
        and   mov-ap.nr-docto     = tit-ap.nr-docto
        and   mov-ap.parcela      = tit-ap.parcela
        and   mov-ap.cod-fornec   = tit-ap.cod-fornec
        and   mov-ap.dt-transacao > tt-param.da-corte no-lock:
                        
        if  (mov-ap.transacao  = 2
        or   mov-ap.transacao  = 5
        or   mov-ap.transacao  = 3
        or  (mov-ap.transacao  = 6
        and  mov-ap.lancamento = 1)) then do:
            run pi-tratar-moeda-normal.
        end.
        
        if  mov-ap.transacao = 8 and tt-param.i-opcao-moeda = 2 then
            assign tt-tit-ap.valor-saldo = tt-tit-ap.valor-saldo
                                         + (mov-ap.valor-mov
                                         + mov-ap.valor-juros).
    
        if  mov-ap.transacao = 9 and tt-param.i-opcao-moeda = 3 then
            assign tt-tit-ap.valor-saldo = tt-tit-ap.valor-saldo
                                         + mov-ap.acerto-cmi.

    end.
end.

/* Fim de Include */

