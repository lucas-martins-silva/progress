/****************************************************************************
**
**  AP0794.I1 - Opcao Imprime do programa de cheques a serem emitidos.
**
***************************************************************************/
    if  che-emit.transacao = 2 or che-emit.transacao = 1 then
        find first mov-ap no-lock
            where mov-ap.ep-codigo    = che-emit.ep-codigo
            and   mov-ap.cod-fornec   = che-emit.cod-fornec
            and   mov-ap.cod-estabel  = che-emit.cod-estabel
            and   mov-ap.cod-esp      = che-emit.cod-esp
            and   mov-ap.serie        = che-emit.serie
            and   mov-ap.nr-docto     = che-emit.nr-docto
            and   mov-ap.parcela      = che-emit.parcela
            and   mov-ap.transacao    = che-emit.transacao
            and   mov-ap.portador     = che-emit.portador
            and   mov-ap.nr-cheque    = che-emit.nr-cheque
            and   mov-ap.dt-transacao = che-emit.dt-emissao no-error.
    else
        find first mov-ap no-lock
            where mov-ap.ep-codigo    = che-emit.ep-codigo
            and   mov-ap.cod-fornec   = che-emit.cod-fornec
            and   mov-ap.cod-estabel  = che-emit.cod-estabel
            and   mov-ap.cod-esp      = che-emit.cod-esp
            and   mov-ap.serie        = che-emit.serie
            and   mov-ap.nr-docto     = che-emit.nr-docto
            and   mov-ap.parcela      = che-emit.parcela
            and   mov-ap.dt-transacao = che-emit.dt-emissao
            and   mov-ap.portador     = che-emit.portador
            and   mov-ap.nr-cheque    = che-emit.nr-cheque
            and   mov-ap.ct-conta     = che-emit.ct-conta
            and   mov-ap.sc-conta     = che-emit.sc-conta
            and  (mov-ap.valor-mov   -
                  mov-ap.vl-desconto -
                  mov-ap.vl-antecip) = che-emit.valor-docto
            and   mov-ap.transacao   = che-emit.transacao no-error.

    find first tit-ap no-lock
        where tit-ap.ep-codigo   = che-emit.ep-codigo
        and   tit-ap.cod-fornec  = che-emit.cod-fornec
        and   tit-ap.cod-estabel = che-emit.cod-estabel
        and   tit-ap.cod-esp     = che-emit.cod-esp
        and   tit-ap.serie       = che-emit.serie
        and   tit-ap.nr-docto    = che-emit.nr-docto
        and   tit-ap.parcela     = che-emit.parcela  no-error.
    if  avail mov-ap then
       if  tt-param.detalhado = 2 then
           disp che-emit.cod-fornec 
                che-emit.cod-esp 
                che-emit.serie
                che-emit.nr-docto   
                che-emit.parcela
                mov-ap.dt-emissao
                (if  avail tit-ap then tit-ap.vl-original
                 else mov-ap.valor-mov) @ mov-ap.valor-mov
                mov-ap.vl-desconto   
                che-emit.valor-docto 
                che-emit.dt-emissao 
                with frame f-resumo.
           down with frame f-resumo.
 
    if  avail tit-ap or avail mov-ap then do:
        assign de-valor = de-valor + che-emit.valor-docto 
               de-caixa = de-caixa + che-emit.valor-docto 
               i-aux    = i-aux + 1.
        if  i-aux > 29 then
            assign i-aux = 0.
    end.

    if (last-of(che-emit.cod-fornec) and de-valor <> 0)
    or (last-of(che-emit.literal) and de-valor <> 0) then do:
        if  tt-param.detalhado = 2 then put skip(1).
        disp c-forn
             che-emit.literal format "x(35)" 
             c-che
             i-cheque
             c-val
             de-valor
             c-acum
             de-caixa
             skip(1)
             with frame f-acumulado.
        down with frame f-acumulado.  

        assign de-valor  = 0
               i-aux     = 0 
               i-fornec  = i-fornec + 1
               i-cheque  = i-cheque + 1.
    end.
    else
        if (last-of(che-emit.cod-fornec) and de-valor = 0)
        or (last-of(che-emit.literal) and de-valor = 0) then do:
            if tt-param.detalhado = 2 then put skip(1).
            disp c-forn
                 che-emit.literal format "x(35)"  
                 c-val
                 de-valor 
                 c-acum
                 de-caixa 
                 skip(1)
                 with frame f-acumula.
            down with frame f-acumula.

            assign de-valor  = 0
                   i-aux     = 0
                   i-fornec  = i-fornec  + 1.
        end.

/* AP0794.I1 */
