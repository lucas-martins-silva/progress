def temp-table tt-resumo NO-UNDO
    field cod-chave as integer format ">9" init 0
    field ven-30    as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field ven1-30   as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field ven-60    as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field ven1-60   as decimal format "->>>,>>>,>>>,>>9.99" init 0
