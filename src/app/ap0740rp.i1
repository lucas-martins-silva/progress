    field ven1-90   as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field ven-120   as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field ven1-120  as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field ven-999   as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field ven1-999  as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field tot       as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field tot1      as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field nor-gr    as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field nor-gr1   as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field pre-gr    as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field pre-gr1   as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field ant-gr    as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field ant-gr1   as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field pro-gr    as decimal format "->>>,>>>,>>>,>>9.99" init 0
    field pro-gr1   as decimal format "->>>,>>>,>>>,>>9.99" init 0
    INDEX chave  cod-chave.

