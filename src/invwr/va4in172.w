PROCEDURE pi-mostra-valor :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

def input parameter p-carga-op   as decimal.
def input parameter p-carga-plan as decimal.

assign de-carga-op   = p-carga-op
       de-carga-plan = p-carga-plan
       de-carga-tot  = p-carga-op + p-carga-plan.

display de-carga-op
        de-carga-plan
        de-carga-tot
        with frame {&frame-name}.

END PROCEDURE.

