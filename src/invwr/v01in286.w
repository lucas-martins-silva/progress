&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE pi-atualiza-param V-table-Win 
PROCEDURE pi-atualiza-param :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

find param-en exclusive-lock no-error.
if avail param-en then
   assign param-en.num-var-estrutura = int(i-var-estrut:screen-value in frame {&frame-name})
          param-en.num-var-operacao  = int(i-var-oper:screen-value   in frame {&frame-name}).

END PROCEDURE.

