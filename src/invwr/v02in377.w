&ANALYZE-RESUME




/* ************************  Control Triggers  ************************ */

&Scoped-define SELF-NAME c-referencia-mostra
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL c-referencia-mostra V-table-Win
ON F5 OF c-referencia-mostra IN FRAME f-main /* c-referencia-mostra */
DO:
  {include/zoomvar.i &prog-zoom="inzoom/z01in377.w"
                     &campo=c-referencia-mostra
                     &campozoom=cod-refer}
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL c-referencia-mostra V-table-Win
ON LEAVE OF c-referencia-mostra IN FRAME f-main /* c-referencia-mostra */
DO:
     RUN get-link-handle IN adm-broker-hdl
      (INPUT this-procedure ,
       INPUT "variavel-target" ,
       OUTPUT c-handle ).
      run set-attribute-list in widget-handle(c-handle) ("variavel_ref=" + c-referencia-mostra:screen-value).
      run pi-botao-ok in widget-handle(c-handle).       

END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL c-referencia-mostra V-table-Win
ON MOUSE-SELECT-DBLCLICK OF c-referencia-mostra IN FRAME f-main /* c-referencia-mostra */
DO:
  apply 'f5' to self.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL c-referencia-mostra V-table-Win
ON RETURN OF c-referencia-mostra IN FRAME f-main /* c-referencia-mostra */
DO:
  apply 'leave'    to self.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&UNDEFINE SELF-NAME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _MAIN-BLOCK V-table-Win 


/* ***************************  Main Block  *************************** */

  &IF DEFINED(UIB_IS_RUNNING) <> 0 &THEN          
    RUN dispatch IN THIS-PROCEDURE ('initialize':U).        
  &ENDIF         
  
  /************************ INTERNAL PROCEDURES ********************/

  {utp/ut-field.i mgind referencia cod-refer 1}
  assign c-referencia-mostra:label in frame {&frame-name} = return-value.
  if c-referencia-mostra:load-mouse-pointer ("image/lupa.cur") in frame {&frame-name} then.

