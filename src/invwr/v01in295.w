&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-row-available V-table-Win 
PROCEDURE local-row-available :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/
def var c-handle     as character no-undo.

  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'row-available':U ) .
  
  if  avail pedido-compr then
      assign gr-pedido-compr = rowid(pedido-compr).

  /* Code placed here will execute AFTER standard behavior.    */
  if  avail pedido-compr THEN DO:
      &IF "{&BF_MAT_VERSAO_EMS}" >= "2.062" &THEN
          FIND FIRST param-global NO-LOCK NO-ERROR.
          FIND FIRST emitente WHERE emitente.cod-emitente = pedido-compr.cod-emitente NO-LOCK NO-ERROR.
          IF CONNECTED("mgcex")           and
             param-global.modulo-07 = YES and
            (emitente.natureza = 3        OR
             emitente.natureza = 4)       THEN DO:
             IF valid-handle(h-principal) THEN DO:
                RUN pi-desabilita-botao IN h-principal (INPUT NO,
                                                        INPUT ROWID(pedido-compr)).
             END.
          END.
          ELSE DO:
               IF valid-handle(h-principal) THEN DO:
                  RUN pi-desabilita-botao IN h-principal (INPUT yes,
                                                          INPUT ROWID(pedido-compr)).
               END.
          END.
      &ENDIF
  END.

  if  avail pedido-compr and pedido-compr.cod-cond-pag = 0 then do:
      find first cond-especif
          where cond-especif.num-pedido = pedido-compr.num-pedido
          no-lock no-error.
      assign gr-cond-especif = rowid(cond-especif).
  end.
  RUN get-link-handle IN adm-broker-hdl
      (INPUT this-procedure, INPUT "Acha-wh1-Target", OUTPUT c-handle).
  if  valid-handle(widget-handle(c-handle)) then
      run pi-mostra-parcela in widget-handle(c-handle) (input rowid(pedido-compr)).

END PROCEDURE.

