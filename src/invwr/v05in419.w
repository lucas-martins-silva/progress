&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-display-fields V-table-Win 
PROCEDURE local-display-fields :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'display-fields':U ) .
  
  find first param-mi no-lock no-error.
  if  avail param-mi and param-mi.formato-cd-tag <> " " then do:
      assign c-tag:format in frame {&frame-name} = param-mi.formato-cd-tag.
  end.


  /* Code placed here will execute AFTER standard behavior.    */

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE pi-mostra-dados V-table-Win 
PROCEDURE pi-mostra-dados :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

assign c-tag = g-c-tag.

find tag where
     tag.cd-tag = g-c-tag
     no-lock no-error.

if  avail tag then
    assign c-descricao = tag.descricao.

disp c-tag
     c-descricao
     with frame {&frame-name}.

END PROCEDURE.

