&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-display-fields V-table-Win 
PROCEDURE local-display-fields :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'display-fields':U ) .

    if available ordem-compra then do:
        
        find contrato-for where
            contrato-for.nr-contrato = ordem-compra.nr-contrato
            no-lock no-error.
        assign c-desc-contrat:screen-value in frame {&frame-name} = 
            if available contrato-for then contrato-for.des-contrat
            else "":U.
            
        find estabelec where
            estabelec.cod-estabel = ordem-compra.cod-estabel
            no-lock no-error.
        assign c-desc-estabelec:screen-value in frame {&frame-name} =
            if available estabelec then estabelec.nome
            else "":U.
            
       find item where item.it-codigo = input frame {&frame-name}
                       ordem-compra.it-codigo no-lock no-error.
                                                   
       if item.tipo-contr = 4 and item.it-codigo = "" then do:
        find item-contrat where
            item-contrat.nr-contrato  = ordem-compra.nr-contrato and
            item-contrat.num-seq-item = ordem-compra.num-seq-item
            no-lock no-error.
        assign c-narrat-compra:screen-value in frame {&frame-name} =
            if available item-contrat then item-contrat.narrat-compra
            else "":U.
        end.
        else do:    
        assign c-narrat-compra:screen-value in frame {&frame-name} =
            if available item  then item.desc-item
            else "":U.
        end.           
            
    end.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


