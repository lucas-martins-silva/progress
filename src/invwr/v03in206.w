&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-display-fields V-table-Win 
PROCEDURE local-display-fields :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

    /* Code placed here will execute PRIOR to standard behavior. */

    /* Dispatch standard ADM method.                             */
    RUN dispatch IN THIS-PROCEDURE ( INPUT 'display-fields':U ) .

    FOR FIRST mi-plano-subor FIELDS(cd-manut cd-equipto val-fator log-utiliz-des)
        WHERE mi-plano-subor.cd-equipto      = man-equip.cd-equipto
        AND   mi-plano-subor.cod-manut-subor = man-equip.cd-manut NO-LOCK:

        ASSIGN c-cd-manut:SCREEN-VALUE IN FRAME f-main = STRING(mi-plano-subor.cd-manut)
               c-val-fator:SCREEN-VALUE IN FRAME f-main = STRING(mi-plano-subor.val-fator).
               l-log-utiliz-des:SCREEN-VALUE IN FRAME f-main = STRING(mi-plano-subor.log-utiliz-des).

        FOR FIRST bfman-equip FIELDS(descricao)
            WHERE bfman-equip.cd-equipto = mi-plano-subor.cd-equipto
            AND   bfman-equip.cd-manut   = mi-plano-subor.cd-manut NO-LOCK:
        
            ASSIGN c-descricao:SCREEN-VALUE IN FRAME f-main = bfman-equip.descricao.
    
        END.                                                                        
    END.

    /* Code placed here will execute AFTER standard behavior.    */

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

