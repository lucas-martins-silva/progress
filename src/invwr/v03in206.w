&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE pi-dado-inicial V-table-Win 
PROCEDURE pi-dado-inicial :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

DEFINE INPUT PARAMETER r-manut AS ROWID.  
FIND FIRST manut WHERE ROWID(manut) = r-manut NO-LOCK NO-ERROR.
IF AVAIL manut THEN
    FIND FIRST man-equip WHERE man-equip.cd-manut = manut.cd-manut NO-LOCK NO-ERROR.
                                                                              
IF AVAIL man-equip THEN DO:
    RUN local-display-fields IN THIS-PROCEDURE.
END.

END PROCEDURE.

