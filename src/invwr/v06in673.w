/* Definitions of the field level widgets                               */
DEFINE VARIABLE da-data-ult-con AS DATE FORMAT "99/99/9999" INITIAL 01/01/001 
     LABEL "Data éltima contagem":R24 
     VIEW-AS FILL-IN 
     SIZE 12.86 BY .88.

DEFINE VARIABLE de-variac-acum AS DECIMAL FORMAT "->>>>,>>9.9999" INITIAL 0 
     LABEL "Variac Acumul":R16 
     VIEW-AS FILL-IN 
     SIZE 17.43 BY .88.

DEFINE VARIABLE i-ciclo-contag AS INTEGER FORMAT "->,>>>,>>9" INITIAL 0 
     LABEL "Ciclo Contagem":R17 
     VIEW-AS FILL-IN 
     SIZE 4.86 BY .88.

DEFINE RECTANGLE rt-mold
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 87.29 BY 10.54.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME f-main
     i-ciclo-contag AT ROW 4.21 COL 35.43 COLON-ALIGNED
     da-data-ult-con AT ROW 5.21 COL 35.43 COLON-ALIGNED
     de-variac-acum AT ROW 6.21 COL 35.43 COLON-ALIGNED
     rt-mold AT ROW 1 COL 1
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
