&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE Pi-validate V-table-Win 
PROCEDURE Pi-validate :
/*------------------------------------------------------------------------------
  Purpose:Validar a viewer     
  Parameters:  <none>
  Notes: NÆo fazer assign aqui. Nesta procedure
  devem ser colocadas apenas valida‡äes, pois neste ponto do programa o registro 
  ainda nÆo foi criado.       
------------------------------------------------------------------------------*/
  {include/i-vldfrm.i} /* Valida‡Æo de dicion rio */
   
   /*Segue um exemplo de valida‡Æo de programa 
 *    find tabela where tabela.campo1 = c-variavel and
 *                      tabela.campo2 > i-variavel no-lock no-error.
 *    {include/i-vldprg.i} /* Este include deve ser colocado sempre antes do ut-msgs.p */                  
 *    run utp/ut-msgs.p (input "show":U, input 7, input return-value).
 *    return 'ADM-ERROR':U.*/
 
 if param-re.usuario:sensitive in frame {&frame-name} = yes then do:
    find param-re where 
         param-re.usuario = input frame {&frame-name} param-re.usuario no-lock no-error.
    if avail param-re then do:
       run utp/ut-msgs.p (input "show",
                          input 7896,
                          input "").
       return 'adm-error':U.
    end.
 end.                              
 
 find usuar_mestre where 
     usuar_mestre.cod_usuar = input frame {&frame-name} param-re.usuario no-lock no-error.
if not avail usuar_mestre then do:
     {utp/ut-field.i mgind param-re usuario 1}
     run utp/ut-msgs.p (input "show",
                        input 5773,
                        input return-value + "~~" + return-value).
     apply 'entry' to param-re.usuario in frame {&frame-name}.
     return "adm-error".
end. 

 
END PROCEDURE.

