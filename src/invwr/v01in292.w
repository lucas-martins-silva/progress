&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-add-record V-table-Win 
PROCEDURE local-add-record :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'add-record':U ) .

    find first b-param-re where b-param-re.usuario = c-seg-usuario no-lock no-error.
    if not available b-param-re then do:
        display c-seg-usuario @ param-re.usuario with frame {&frame-name}.
        find usuar_mestre where usuar_mestre.cod_usuario = c-seg-usuario no-lock no-error.
        display usuar_mestre.nom_usuario @ param-re.nome with frame {&frame-name}.
    end.        

  /* Code placed here will execute AFTER standard behavior.    */

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

