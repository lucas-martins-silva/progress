&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-display-fields V-table-Win 
PROCEDURE local-display-fields :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  if avail ord-manut THEN DO:
    RUN utp/ut-liter.p (INPUT {ininc/i01in271.i 04 ord-manut.estado},
                        INPUT "*",
                        INPUT "").
    ASSIGN c-estado = RETURN-VALUE.                                  
  END.
  ELSE DO: 
       RUN utp/ut-liter.p (INPUT {ininc/i01in271.i 04 1},
                        INPUT "*",
                        INPUT "").
    ASSIGN c-estado = RETURN-VALUE.   
  END.

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'display-fields':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-enable-fields V-table-Win 
PROCEDURE local-enable-fields :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  define variable c-handle as char no-undo.
  
  FIND FIRST ord-prod WHERE ord-prod.nr-ord-produ = ord-manut.nr-ord-produ no-lock no-error.
  
  if ord-prod.estado = 8 and ord-prod.valorizada then do:
      run utp/ut-msgs.p (input "show",
                         input 27400,
                         input "").  
      RUN Who-Is-The-Container IN adm-broker-hdl (INPUT this-procedure,
                                                  OUTPUT c-handle).
      run pi-cancelar in widget-handle(c-handle).
      return 'adm-error':u.	
  end.  
  /* Code placed here will execute PRIOR to standard behavior. */
  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'enable-fields':U ) .
 disable ord-manut.cd-equipto with frame {&frame-name}.
  /* Code placed here will execute AFTER standard behavior.    */
   if adm-new-record = yes then
  &if  defined(ADM-MODIFY-FIELDS) &then
      enable {&ADM-MODIFY-FIELDS} with frame {&frame-name}.
  &endif

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

