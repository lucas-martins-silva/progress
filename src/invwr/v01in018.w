&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-assign-record V-table-Win 
PROCEDURE local-assign-record :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

    /* Code placed here will execute PRIOR to standard behavior. */
    {include/i-valid.i}

    if adm-new-record then do:
        find first mla-usuar-aprov where
            mla-usuar-aprov.cod-usuar = input frame {&frame-name} mla-usuar-padrao.cod-usuar
            no-lock no-error.
        if not available mla-usuar-aprov then do:
            {utp/ut-table.i mgind mla-usuar-aprov 1}
            run utp/ut-msgs.p ("show",2,trim(return-value)).
            apply "entry" to mla-usuar-padrao.cod-usuar in frame {&frame-name}.
            return "adm-error".                    
        end.
    end.
    
    /* Ponha na pi-validate todas as valida‡äes */
    /* NÆo gravar nada no registro antes do dispatch do assign-record e 
       nem na PI-validate. */
    
    /* Dispatch standard ADM method.                             */
    RUN dispatch IN THIS-PROCEDURE ( INPUT 'assign-record':U ) .
    if RETURN-VALUE = 'ADM-ERROR':U then 
        return 'ADM-ERROR':U.

    if adm-new-record then do:
        create mla-log-reg.
        assign mla-log-reg.ep-codigo   = mla-usuar-padrao.ep-codigo
               mla-log-reg.cod-estabel = mla-usuar-padrao.cod-estabel
               mla-log-reg.cod-usuar   = c-seg-usuario
               mla-log-reg.cod-tabela  = 25
               mla-log-reg.chave-reg   = string(mla-usuar-padrao.cod-tip-aprov) + " | " +
                                         string(mla-usuar-padrao.cod-usuar)
               mla-log-reg.data-reg    = today
               mla-log-reg.hora-reg    = string(time,"hh:mm")
               mla-log-reg.tipo-reg    = 1
               mla-log-reg.log-reg     = entry(25,{ininc/i03in030.i 03}) + chr(13) + chr(13) +
                                         "Tipo Aprova‡Æo     : " + string(mla-usuar-padrao.cod-tip-aprov) + chr(13) + 
                                         "Usu rio            : " + string(mla-usuar-padrao.cod-usuar).              
    end.
    
    /* Todos os assignïs nÆo feitos pelo assign-record devem ser feitos aqui */  
    /* Code placed here will execute AFTER standard behavior.    */

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-create-record V-table-Win 
PROCEDURE local-create-record :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'create-record':U ) .

    find first mla-tipo-aprov where
        rowid(mla-tipo-aprov) = v-row-parent
        no-lock no-error.
    if available mla-tipo-aprov then
        assign mla-usuar-padrao.cod-tip-aprov = mla-tipo-aprov.cod-tip-aprov.

    assign mla-usuar-padrao.ep-codigo = g-empresa-aed
           mla-usuar-padrao.cod-estabel = gc-estabel-aed.

  /* Code placed here will execute AFTER standard behavior.    */

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-disable-fields V-table-Win 
PROCEDURE local-disable-fields :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/
    
    /* Code placed here will execute PRIOR to standard behavior. */
    
    /* Dispatch standard ADM method.                             */
    RUN dispatch IN THIS-PROCEDURE ( INPUT 'disable-fields':U ) .
    
    /* Code placed here will execute AFTER standard behavior.    */
    &if  defined(ADM-MODIFY-FIELDS) &then
    disable {&ADM-MODIFY-FIELDS} with frame {&frame-name}.
    &endif
    
