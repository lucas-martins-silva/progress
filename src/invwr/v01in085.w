&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-delete-record V-table-Win 
PROCEDURE local-delete-record :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
 /* Code placed here will execute PRIOR to standard behavior. */
  run pi-valida-eliminacao.
  if  return-value <> "OK":U THEN DO:
      return "ADM-ERROR".
  END.
  ELSE DO:
      {utp/ut-table.i mgind desenho 1}
      assign c-label = return-value.
      find first revisao where revisao.de-codigo = desenho.de-codigo no-lock no-error.
      if available revisao then do:
         {utp/ut-table.i mgind revisao 1}
         run utp/ut-msgs.p(input 'show',
                           input  968,
                           input c-label + "~~" + return-value).
         if return-value = "yes" then do:                  
            for each revisao where revisao.de-codigo = desenho.de-codigo exclusive-lock 
                  by revisao.rv-codigo descending:
                delete revisao.
            end.                         
         end.   
         else return "ADM-ERROR".   
      end.  
  END.

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'delete-record':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
